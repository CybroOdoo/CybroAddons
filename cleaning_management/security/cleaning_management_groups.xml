<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!--    Set a category selection field for users-->
        <record id="module_category_cleaning_management" model="ir.module.category">
            <field name="name">Cleaning Management</field>
            <field name="description">Cleaning management</field>
            <field name="sequence">5</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_cleaning">
            <field name="name">Cleaning Management</field>
            <field name="category_id" ref="cleaning_management.module_category_cleaning_management"/>
        </record>

        <!--    Action for user-->
        <record id="cleaning_management_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id"
                   ref="cleaning_management.res_groups_privilege_cleaning"/>
        </record>
        <!--    Action for manager-->
        <record id="cleaning_management_group_manager" model="res.groups">
            <field name="name">Cleaning Manager</field>
            <field name="privilege_id"
                   ref="cleaning_management.res_groups_privilege_cleaning"/>
            <field name="user_ids"
               eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="implied_ids"
                   eval="[(4, ref('cleaning_management_group_user'))]"/>
        </record>
    </data>
</odoo>
