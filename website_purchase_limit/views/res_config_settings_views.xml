<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Inherit the res_config_settings_view_form and add a field purchase limit-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.website.purchase.limit
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']"
                   position="inside">
                <setting id="purchase_limit_setting" string="Purchase Limit"
                         help="Set a minimum purchase limit for website orders">
                    <field name="enabled_limit"/>
                    <div class="content-group" invisible="not enabled_limit">
                        <div class="row mt16">
                            <label for="purchase_limit" class="col-lg-3 o_light_label"
                                   string="Purchase Limit"/>
                            <field name="purchase_limit"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
