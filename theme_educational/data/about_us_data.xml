<?xml version="1.0" encoding="utf-8"?>
<!-- About Us Website Menu Data -->
<odoo>
    <data>
        <!-- Record for adding About Us link to the website main navigation menu -->
        <record id="about_us_page_menu" model="website.menu">
            <field name="name">About Us</field>
            <field name="url">/about-us</field>
            <field name="parent_id" ref="website.main_menu"/>
        </record>
    </data>
</odoo>