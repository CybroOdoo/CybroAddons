<templates id="template" xml:space="preserve">
    <t t-name="theme_educational.awards_and_stuff_snippet">
         <section class="s_awards_and_stuff oe_snippet_body"
                 data-snippet="true"
                 data-name="Awards'N Stuff">
            <div class="container mt-5 mb-5">
                <div t-attf-id="awardsCarousel{{uniq}}" class="carousel slide" data-bs-ride="carousel">
                    <!-- Carousel Inner -->
                    <div class="carousel-inner">
                        <t t-foreach="award_chunks" t-as="chunk" t-key="chunk_index">
                            <div t-att-class="chunk.is_active ? 'carousel-item active' : 'carousel-item'">
                                <div class="row justify-content-center g-3">
                                    <t t-foreach="chunk" t-as="award" t-key="award.id">
                                        <div class="col-md-4 text-center">
                                            <a t-att-href="award.url">
                                                <img t-att-src="'data:image/png;base64,' + award.image"
                                                     t-att-alt="award.name"
                                                     class="award-img rounded-circle img-fluid"/>
                                                <h6 class="mt-2" t-esc="award.name"/>
                                            </a>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Carousel Controls -->
                    <button class="carousel-control-prev" type="button" t-att-data-bs-target="'#awardsCarousel' + uniq" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" t-att-data-bs-target="'#awardsCarousel' + uniq" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>

                    <!-- Carousel Indicators -->
                    <div class="carousel-indicators mt-4">
                        <t t-foreach="award_chunks" t-as="chunk" t-key="chunk_index">
                            <button type="button"
                                    t-att-data-bs-target="'#awardsCarousel' + uniq"
                                    t-att-data-bs-slide-to="chunk_index"
                                    t-att-class="chunk_index == 0 ? 'active' : ''"></button>
                        </t>
                    </div>

                </div>
            </div>
        </section>
    </t>
</templates>
