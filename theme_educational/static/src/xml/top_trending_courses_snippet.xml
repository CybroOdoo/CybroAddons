<?xml version="1.0" encoding="utf-8"?>
<!-- Top Trending Courses Carousel QWeb Template for Theme Educational -->
<templates id="template" xml:space="preserve">
    <!-- Template for rendering dynamic carousel of trending courses with rating, student count, and instructor details -->
    <t t-name="theme_educational.top_trending_courses_snippet">
        <div class="container mt-5 mb-5">

            <div class="text-center mb-5">
                <h2 class="fw-bold">Our Trending Courses</h2>
                <p class="text-muted">Check out the most popular courses in the market</p>
            </div>

            <div t-attf-id="trendingCoursesCarousel{{uniq}}" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <t t-foreach="product_chunks" t-as="chunk" t-key="chunk_index">
                        <div t-att-class="chunk.is_active ? 'carousel-item active' : 'carousel-item'">
                            <div class="row g-3">
                                <t t-foreach="chunk" t-as="product" t-key="product.id">
                                    <div class="col-md-4">
                                        <div class="card shadow-sm border-0 custom-course-card h-100 d-flex flex-column">
                                            <a t-att-href="product.url" class="text-decoration-none text-reset flex-grow-1">
                                                <t t-if="product.image_1920">
                                                    <img t-att-src="'data:image/png;base64,' + product.image_1920"
                                                         alt="Course Image" class="card-img-top"/>
                                                </t>
                                                <div class="card-body pb-0">
                                                    <h5 class="card-title fw-bold" t-esc="product.name"/>
                                                    <div class="d-flex align-items-center mb-2">
                                                        <span class="fw-bold text-warning me-1"><t t-esc="product.rating_last_value"/></span>
                                                        <i class="fa fa-star text-warning me-2"></i>
                                                        <span class="text-muted">(6500)</span>
                                                        <span class="text-muted course-students">Students (6500)</span>
                                                    </div>
                                                </div>
                                            </a>
                                            <div class="card-body pt-0 mt-auto">
                                                <div class="d-flex align-items-center justify-content-between mt-3 pt-2 border-top">
                                                    <div class="d-flex align-items-center">
                                                        <t t-if="product.vendor_image_1920">
                                                            <img t-att-src="'data:image/png;base64,' + product.vendor_image_1920"
                                                                 alt="Instructor" class="rounded-circle me-2"
                                                                 width="32" height="32"/>
                                                        </t>
                                                        <span class="small text-muted" t-if="product.vendor_name"><t t-esc="product.vendor_name"/></span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span t-if="product.price" class="fw-bold text-dark"><t t-esc="product.price"/></span>
                                                        <button type="button"
                                                                class="btn btn-sm text-white js_add_to_cart_btn"
                                                                t-att-data-product-id="product.product_variant_id"
                                                                t-att-data-product-template-id="product.id"
                                                                title="Add to Cart"
                                                                style="background-color: #F16623; border-color: #F16623; border-radius: 8px; font-weight: 600; font-size: 13px; padding: 5px 12px;">
                                                            <i class="fa fa-shopping-cart me-1" style="pointer-events: none;"/> Add to Cart
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="carousel-indicators mt-4">
                    <t t-foreach="product_chunks" t-as="chunk" t-key="chunk_index">
                        <button type="button"
                                t-att-data-bs-target="'#trendingCoursesCarousel' + uniq"
                                t-att-data-bs-slide-to="chunk_index"
                                t-att-class="chunk_index == 0 ? 'active' : ''"></button>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>


