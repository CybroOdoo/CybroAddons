<templates id="template" xml:space="preserve">
    <t t-name="theme_educational.top_trending_courses_snippet">
        <section class="s_top_trending_courses oe_snippet_body"
                 data-snippet="true"
                 data-name="Top Trending Courses">
            <div class="container mt-5 mb-5">

                <div class="text-center mb-5">
                    <h2 class="fw-bold">Our Trending Courses</h2>
                    <p class="text-muted">Check out the most popular courses in the market</p>
                </div>

                <div t-attf-id="trendingCoursesCarousel{{uniq}}" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <t t-foreach="product_chunks" t-as="chunk" t-key="chunk_index">
                            <div t-att-class="chunk.is_active ? 'carousel-item active' : 'carousel-item'">
                                <div class="row g-3">
                                    <t t-foreach="chunk" t-as="product" t-key="product.id">
                                        <div class="col-md-4">
                                            <a t-att-href="product.url" class="text-decoration-none text-reset">
                                                <div class="card shadow-sm border-0 custom-course-card">
                                                    <t t-if="product.image_1920">
                                                        <img t-att-src="'data:image/png;base64,' + product.image_1920"
                                                             alt="Course Image" class="card-img-top"/>
                                                    </t>
                                                    <div class="card-body">
                                                        <h5 class="card-title fw-bold" t-esc="product.name"/>
                                                        <div class="d-flex align-items-center mb-2">
                                                            <span class="fw-bold text-warning me-1"><t t-esc="product.rating_last_value"/></span>
                                                            <i class="fa fa-star text-warning me-2"></i>
                                                            <span class="text-muted">(6500)</span>
                                                            <span class="text-muted course-students">Students (6500)</span>
                                                        </div>
                                                        <div class="d-flex align-items-center justify-content-between mt-3">
                                                            <div class="d-flex align-items-center">
                                                                <img t-att-src="'data:image/png;base64,' + product.vendor_image_1920"
                                                                     alt="Instructor" class="rounded-circle me-2"
                                                                     width="40" height="40"/>
                                                                <span><t t-esc="product.vendor_name"/></span>
                                                            </div>
                                                            <span class="fw-bold text-success">Buy</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="carousel-indicators mt-4">
                        <t t-foreach="product_chunks" t-as="chunk" t-key="chunk_index">
                            <button type="button"
                                    t-att-data-bs-target="'#trendingCoursesCarousel' + uniq"
                                    t-att-data-bs-slide-to="chunk_index"
                                    t-att-class="chunk_index == 0 ? 'active' : ''"></button>
                        </t>
                    </div>
                </div>
            </div>
        </section>
    </t>
</templates>


