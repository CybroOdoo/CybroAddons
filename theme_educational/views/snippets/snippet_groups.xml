<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Snippet group theme module -->
    <template id="theme_educational_snippet_groups" inherit_id="website.snippets" name="Theme Educational Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               string="Educational"
               snippet-group="theme_educational"
               t-thumbnail="/theme_educational/static/description/icon.png"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_educational.choose_a_category_snippet" string="Choose a Category" group="theme_educational" label="Category"/>
            <t t-snippet="theme_educational.search_course_snippet" string="Search Course" group="theme_educational" label="Course"/>
            <t t-snippet="theme_educational.choose_a_plan_snippet" string="Choose a Plan" group="theme_educational" label="plan"/>
            <t t-snippet="theme_educational.faq_snippet" string="FAQ" group="theme_educational" label="FAQ"/>
        </xpath>
    </template>
</odoo>
