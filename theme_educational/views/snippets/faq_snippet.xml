<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- FAQ Snippet -->
    <template id="faq_snippet" name="FAQ">

        <!-- Unique ID -->
        <t t-set="uniq" t-value="datetime.datetime.now().microsecond"/>

        <section class="section-faq py-5 oe_structure" data-name="FAQ">
            <div class="container">

                <h2 class="text-center mb-5">
                    <b>Frequently Asked Questions</b>
                </h2>

                <!-- Accordion Wrapper -->
                <div t-attf-id="faqAccordion{{uniq}}" class="accordion">

                    <!-- FAQ 1 -->
                    <div class="accordion-item mb-3 position-relative z-1"
                         data-name="Accordion Item">

                        <button type="button"
                                t-attf-id="faq-button{{uniq}}_1"
                                class="accordion-header accordion-button justify-content-between gap-2 fw-bold text-decoration-none text-reset transition-none"
                                t-attf-data-bs-target="#faqCollapse{{uniq}}_1"
                                t-attf-aria-controls="faqCollapse{{uniq}}_1"
                                data-bs-toggle="collapse"
                                aria-expanded="true">

                            <span class="flex-grow-1 o_default_snippet_text">
                                How are courses selected for the plans?
                            </span>

                        </button>

                        <div t-attf-id="faqCollapse{{uniq}}_1"
                             class="accordion-collapse collapse show"
                             role="region"
                             t-attf-aria-labelledby="faq-button{{uniq}}_1"
                             t-attf-data-bs-parent="#faqAccordion{{uniq}}">

                            <div class="accordion-body">
                                <p class="mb-0 o_default_snippet_text">
                                    Lorem ipsum dolor sit amet, consectetur adipisicing elit,
                                    sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
                                </p>
                            </div>

                        </div>
                    </div>

                    <!-- FAQ 2 -->
                    <div class="accordion-item mb-3 position-relative z-1"
                         data-name="Accordion Item">

                        <button type="button"
                                t-attf-id="faq-button{{uniq}}_2"
                                class="accordion-header accordion-button collapsed justify-content-between gap-2 fw-bold text-decoration-none text-reset transition-none"
                                t-attf-data-bs-target="#faqCollapse{{uniq}}_2"
                                t-attf-aria-controls="faqCollapse{{uniq}}_2"
                                data-bs-toggle="collapse"
                                aria-expanded="false">

                            <span class="flex-grow-1 o_default_snippet_text">
                                How is Personal Plan different from buying a course?
                            </span>

                        </button>

                        <div t-attf-id="faqCollapse{{uniq}}_2"
                             class="accordion-collapse collapse"
                             role="region"
                             t-attf-aria-labelledby="faq-button{{uniq}}_2"
                             t-attf-data-bs-parent="#faqAccordion{{uniq}}">

                            <div class="accordion-body">
                                <p class="mb-0 o_default_snippet_text">
                                    Lorem ipsum dolor sit amet, consectetur adipisicing elit,
                                    sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
                                </p>
                            </div>

                        </div>
                    </div>

                    <!-- FAQ 3 -->
                    <div class="accordion-item position-relative z-1"
                         data-name="Accordion Item">

                        <button type="button"
                                t-attf-id="faq-button{{uniq}}_3"
                                class="accordion-header accordion-button collapsed justify-content-between gap-2 fw-bold text-decoration-none text-reset transition-none"
                                t-attf-data-bs-target="#faqCollapse{{uniq}}_3"
                                t-attf-aria-controls="faqCollapse{{uniq}}_3"
                                data-bs-toggle="collapse"
                                aria-expanded="false">

                            <span class="flex-grow-1 o_default_snippet_text">
                                What languages does Enterprise Plan have content for?
                            </span>

                        </button>

                        <div t-attf-id="faqCollapse{{uniq}}_3"
                             class="accordion-collapse collapse"
                             role="region"
                             t-attf-aria-labelledby="faq-button{{uniq}}_3"
                             t-attf-data-bs-parent="#faqAccordion{{uniq}}">

                            <div class="accordion-body">
                                <p class="mb-0 o_default_snippet_text">
                                    Lorem ipsum dolor sit amet, consectetur adipisicing elit,
                                    sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
                                </p>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </section>

    </template>

</odoo>