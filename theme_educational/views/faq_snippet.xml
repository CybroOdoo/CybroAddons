<?xml version="1.0" encoding="utf-8"?>
<!-- Frequently Asked Questions Building Block Snippet for Theme Educational -->
<odoo>
    <!-- Template for rendering collapsible FAQ accordion building block snippet -->
    <template id="faq_snippet" name="FAQ">
        <t t-set="uniq" t-value="datetime.datetime.now().microsecond"/>
        <section class="s_faq_collapse section-faq w-100 mt-5 pt32 pb32" data-snippet="s_faq_collapse" data-name="FAQ">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <h4 class="w-100 float-left text-center mb-5"><b>Frequently asked questions</b></h4>
                        <div id="myCollapse" class="accordion" role="tablist">
                            <div class="card bg-white mb-2" data-name="FAQ Item" role="presentation">
                                <a href="#"
                                   t-attf-data-bs-target="#myCollapseTab{{uniq}}_1"
                                   role="tab"
                                   t-attf-aria-controls="myCollapseTab{{uniq}}_1"
                                   data-bs-toggle="collapse"
                                   aria-expanded="true"
                                   class="card-header card-link text-dark d-block text-decoration-none">
                                    How are courses selected for the plans?
                                </a>
                                <div t-attf-id="myCollapseTab{{uniq}}_1"
                                     class="collapse show"
                                     data-bs-parent="#myCollapse"
                                     role="tabpanel">
                                    <div class="card-body">
                                        <p class="card-text">Courses included in our plans are hand-curated based on learner feedback, high student ratings (4.5+ stars), instructor expertise, and industry demand. Our curriculum specialists continuously review and update the collection to ensure content is fresh, relevant, and covers practical, in-demand skills.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="card bg-white mb-2" data-name="FAQ Item" role="presentation">
                                <a href="#"
                                   t-attf-data-bs-target="#myCollapseTab{{uniq}}_2"
                                   role="tab"
                                   t-attf-aria-controls="myCollapseTab{{uniq}}_2"
                                   data-bs-toggle="collapse"
                                   aria-expanded="false"
                                   class="collapsed card-header card-link text-dark d-block text-decoration-none">
                                    How is Personal Plan different from buying a course?
                                </a>
                                <div t-attf-id="myCollapseTab{{uniq}}_2"
                                     class="collapse"
                                     data-bs-parent="#myCollapse"
                                     role="tabpanel">
                                    <div class="card-body">
                                        <p class="card-text">Purchasing an individual course provides you with lifetime access to that single course. In contrast, the Personal Plan is a flexible subscription that grants you unlimited on-demand access to over 12,000+ top-rated courses across business, tech, and creative disciplines, including certification prep and interactive exercises, for as long as your subscription is active.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="card bg-white mb-2" data-name="FAQ Item" role="presentation">
                                <a href="#"
                                   t-attf-data-bs-target="#myCollapseTab{{uniq}}_3"
                                   role="tab"
                                   t-attf-aria-controls="myCollapseTab{{uniq}}_3"
                                   data-bs-toggle="collapse"
                                   aria-expanded="false"
                                   class="collapsed card-header card-link text-dark d-block text-decoration-none">
                                    What languages does Enterprise Plan have content for?
                                </a>
                                <div t-attf-id="myCollapseTab{{uniq}}_3"
                                     class="collapse"
                                     data-bs-parent="#myCollapse"
                                     role="tabpanel">
                                    <div class="card-body">
                                        <p class="card-text">The Enterprise Plan features localized content tailored for international teams. Courses and subtitles are available in multiple global languages, including English, Spanish, French, German, Japanese, Portuguese, Mandarin, and Arabic, allowing your global workforce to upskill in their preferred native language.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>