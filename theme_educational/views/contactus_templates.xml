                            </div>
                            <div class="col-lg-4 text-center">
                                <div class="address-container mt-3 float-left w-100">
                                    <h4 class="text-white">Customer Support</h4>
                                    <span>Chicago HQ Estica Cop. Macomb, MI 48042 </span><br/>
                                    <span>(423) 733-8222 </span><br/>
                                    <span> example@email.com</span>
                                </div>
                            </div>
                            <div class="col-lg-4 text-center">
                                <div class="address-container-2 mt-3 float-left w-100">
                                    <h4 class="text-dark">Contact Address</h4>
                                    <span>Chicago HQ Estica Cop. Macomb, MI 48042 </span><br/>
                                    <span>(423) 733-8222 </span><br/>
                                    <span> example@email.com</span>
                                </div>
