<?xml version="1.0" encoding="utf-8"?>
<!-- Popular Courses and Instructor CTA Templates for Theme Educational -->
<odoo>
    <!-- Deactivated legacy homepage inherited view (content moved to popular_courses_snippet) -->
    <template id="popular_courses" inherit_id="website.homepage" active="False">
        <xpath expr="//div[@id='wrap']" position="inside"/>
    </template>

    <!-- Building block snippet for Most Popular Courses with tag filtering tabs -->
    <template id="popular_courses_snippet" name="Most Popular Courses">
        <section class="o_popular_courses py-5 s_text_block" id="popular_courses_section" data-snippet="s_text_block" data-name="Popular Courses">
            <div class="container text-center">
                <h2 class="section-title">Most Popular Courses</h2>
                <p class="section-subtitle">
                    Choose from hundreds of courses from specialist organizations
                </p>

                <!-- Tabs -->
                <t t-set="course_tags" t-value="course_tags or request.env['slide.channel.tag'].sudo().search([])"/>
                <div class="course-tabs my-4" id="course_tabs">
                    <a href="#" data-tag="" class="course-tab active">All Courses</a>
                    <t t-foreach="course_tags" t-as="tag">
                        <a href="#" t-att-data-tag="tag.id" class="course-tab">
                            <t t-esc="tag.name"/>
                        </a>
                    </t>
                </div>

                <!-- Course Cards (AJAX replaces this) -->
                <t t-set="courses" t-value="courses or request.env['slide.channel'].sudo().search([], limit=50)"/>
                <div class="row g-4 justify-content-center" id="course_list">
                    <t t-call="theme_educational.popular_courses_cards">
                        <t t-set="courses" t-value="courses"/>
                    </t>
                </div>
            </div>
        </section>
    </template>

    <!-- Sub-template for rendering individual course cards inside the popular courses grid -->
    <template id="popular_courses_cards">
        <t t-foreach="courses" t-as="course">
            <!-- ✅ Responsive columns -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <!-- Make the whole card clickable -->
                <a t-att-href="'/slides/%s' % course.id" class="text-decoration-none">
                    <div class="course-card">
                        <img t-att-src="'/web/image/slide.channel/%s/image_1920' % course.id"
                             class="course-img"/>
                        <div class="course-body">
                            <h5 class="course-title"><t t-esc="course.name"/></h5>
                            <p class="course-subtitle">Proposal indulged no do sociable he throwing</p>
                        </div>
                    </div>
                </a>
            </div>
        </t>
    </template>

    <!-- Template inheriting website.homepage to render the 'Become an Instructor' call-to-action banner -->
    <template id="become_instructor_section" name="Become an Instructor Section" inherit_id="website.homepage" customize_show="True">
        <xpath expr="//div[@id='wrap']" position="inside">
            <div id="oe_structure_homepage_become_instructor" class="oe_structure">
                <section class="homepage-sections py-5 s_text_block" data-snippet="s_text_block" data-name="Become Instructor">
                    <div class="container">
                        <div class="o_instructor_cta d-flex flex-column flex-md-row justify-content-between align-items-center py-5 px-4"
                             style="background-color:#ff5500; color:#fff; border-radius:12px; min-height:200px;">
                            <div>
                                <h2 class="fw-bold mb-3">Become an Instructor!</h2>
                                <p class="mb-0">
                                    Speedily say has suitable disposal add boy. On forth doubt miles of child.
                                    Exercise joy man children rejoiced.
                                </p>
                            </div>
                            <div class="mt-3 mt-md-0">
                                <a href="/" class="btn btn-outline-light px-4 py-3 rounded-pill">
                                    Start Teaching Today
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
