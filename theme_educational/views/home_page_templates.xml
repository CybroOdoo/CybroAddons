<?xml version="1.0" encoding="utf-8"?>
<!-- Homepage Hero and Statistics Layout for Theme Educational -->
<odoo>
    <!-- Template inheriting website.homepage to render hero banner and statistics cards section -->
    <template id="custom_homepage_layout" name="Custom Homepage Layout" inherit_id="website.homepage" customize_show="True">
        <xpath expr="//div[@id='wrap']" position="inside">
            <div id="oe_structure_homepage_hero" class="oe_structure">
                <section class="homepage-sections py-5 s_text_block" data-snippet="s_text_block" data-name="Hero &amp; Statistics">
                    <div class="container">

                        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
                            <div class="hero-left">
                                <h1>
                                    Limitless learning at your
                                    <span class="highlighted-text">fingertips</span>
                                </h1>
                                <p>
                                    Online learning and teaching marketplace with 5K+ courses 10M students. Taught by experts to help you acquire new skills.
                                </p>
                                <a href="/slides" class="get-started-btn">Get Started</a>
                            </div>
                            <div class="hero-right text-center">
                                <img src="/theme_educational/static/src/images/education-banner-img.png" alt="Student" class="hero-img"/>
                                <div class="bulb-icon">💡</div>
                            </div>
                        </div>

                        <div class="stats-section d-flex flex-wrap justify-content-between gap-3 py-2">
                            <div class="stat-card card-yellow text-center flex-fill">
                                <img src="/theme_educational/static/src/images/icon-online-course.png" alt="Courses"/>
                                <h3>10K</h3>
                                <p>Online Courses</p>
                            </div>
                            <div class="stat-card card-blue text-center flex-fill">
                                <img src="/theme_educational/static/src/images/icon-expert-tutors.png" alt="Tutors"/>
                                <h3>200+</h3>
                                <p>Expert Tutors</p>
                            </div>
                            <div class="stat-card card-purple text-center flex-fill">
                                <img src="/theme_educational/static/src/images/icon-online-students.png" alt="Students"/>
                                <h3>60K</h3>
                                <p>Online Students</p>
                            </div>
                            <div class="stat-card card-cyan text-center flex-fill">
                                <img src="/theme_educational/static/src/images/icon-certified-courses.png" alt="Certified"/>
                                <h3>6K</h3>
                                <p>Certified Courses</p>
                            </div>
                        </div>

                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
