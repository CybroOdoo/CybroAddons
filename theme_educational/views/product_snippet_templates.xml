<?xml version="1.0" encoding="utf-8"?>
<!-- Product and Awards Building Block Snippets for Theme Educational -->
<odoo>
    <!-- Template for Top Trending Courses carousel placeholder snippet -->
    <template id="top_trending_courses" name="Top Trending Product Snippet">
        <section class="s_top_trending_courses" data-snippet="s_top_trending_courses" data-name="Top Trending Courses">
            <div class="container mt-5">
                <div class="alert alert-info">
                    <h4>Your Trending Courses snippet will be displayed here...
                        Please save to view the snippet
                    </h4>
                </div>
            </div>
        </section>
    </template>

    <!-- Template for Awards and Stuff carousel placeholder snippet -->
    <template id="awards_and_stuff" name="Awards and Stuff Snippet">
        <section class="s_awards_and_stuff" data-snippet="s_awards_and_stuff" data-name="Awards and Achievements">
            <div class="container mt-5">
                <div class="alert alert-info">
                    <h4>Your Awards and Achievements snippet will be displayed here...
                        Please save to view the snippet
                    </h4>
                </div>
            </div>
        </section>
    </template>

    <!-- Template inheriting website.snippets to register Top Trending Courses snippet in website editor panel -->
    <template id="category_highlight_snippet" inherit_id="website.snippets"
              name="Top Trending Product Snippet">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_educational.top_trending_courses" string="Top Trending Courses" t-thumbnail="/website_sale/static/src/img/snippets_thumbs/s_dynamic_products.svg"/>
        </xpath>
    </template>

    <!-- Template inheriting website.snippets to register Awards and Stuff snippet in website editor panel -->
    <template id="snippet_awards_and_stuff" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_educational.awards_and_stuff" string="Awards and Achievements" t-thumbnail="/website/static/src/img/snippets_thumbs/s_numbers.svg"/>
        </xpath>
    </template>
</odoo>
