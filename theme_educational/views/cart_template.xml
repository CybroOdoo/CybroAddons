<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="educational_header_cart_link" name="Educational Header Cart Link"
              inherit_id="website_sale.header_cart_link">
        <xpath expr="//sup" position="attributes">
            <attribute name="style">color:#ffffff;border-color:#F16623 !important;background-color:#F16623 !important;</attribute>
        </xpath>
    </template>

    <template id="educational_express_checkout_form" name="Educational Express Checkout Form"
              inherit_id="payment_demo.express_checkout_form">
        <xpath expr="//button" position="attributes">
            <attribute name="style">color:#ffffff;border-color:#F16623 !important;background-color:#F16623 !important;</attribute>
        </xpath>
    </template>

    <template id="educational_cart_lines" name="Educational Cart Lines" inherit_id="website_sale.cart_lines">
        <xpath expr="//h6[@t-field='line.name_short']" position="attributes">
            <attribute name="style">color:#F16623;</attribute>
        </xpath>
        <xpath expr="//a[hasclass('js_delete_product')]" position="attributes">
            <attribute name="style">color:#F16623;</attribute>
        </xpath>
    </template>
</odoo>