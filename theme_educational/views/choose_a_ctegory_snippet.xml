<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="choose_a_category_snippet" name="Choose a Category Snippet">
        <section class="section-category-area w-100 float-left">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-center mt-5">
                        <h2>
                            <b>Choose a Categories</b>
                        </h2>
                        <p>Perceived end knowledge certainly day sweetness why cordially</p>
                    </div>
                    <div class="container-choose-category float-left w-100 p-4">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-4 mb-4">
                                    <div class="category-box-1 w-100 text-center float-left">
                                        <img src="theme_educational/static/src/images/icon-data-science.png"/>
                                        <h4>Data Science</h4>
                                        <p>15 Courses</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-4">
                                    <div class="category-box-2 w-100 text-center float-left">
                                        <img src="theme_educational/static/src/images/icon-it-software.png"/>
                                        <h4>IT &amp; Software</h4>
                                        <p>15 Courses</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-4">
                                    <div class="category-box-3 w-100 text-center float-left">
                                        <img src="theme_educational/static/src/images/icon-engineering.png"/>
                                        <h4>Engineering</h4>
                                        <p>15 Courses</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-4">
                                    <div class="category-box-4 w-100 text-center float-left">
                                        <img src="theme_educational/static/src/images/icon-finance.png"/>
                                        <h4>Finance</h4>
                                        <p>15 Courses</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-4">
                                    <div class="category-box-5 w-100 text-center float-left">
                                        <img src="theme_educational/static/src/images/icon-medical.png"/>
                                        <h4>Medical</h4>
                                        <p>15 Courses</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-4">
                                    <div class="category-box-6 w-100 text-center float-left">
                                        <img src="theme_educational/static/src/images/icon-arts.png"/>
                                        <h4>Art &amp; Design</h4>
                                        <p>15 Courses</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-4">
                                    <div class="category-box-7 w-100 text-center float-left">
                                        <img src="theme_educational/static/src/images/icon-photography.png"/>
                                        <h4>Photography</h4>
                                        <p>15 Courses</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-4">
                                    <div class="category-box-8 w-100 text-center float-left">
                                        <img src="theme_educational/static/src/images/icon-music.png"/>
                                        <h4>Musics</h4>
                                        <p>15 Courses</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-4">
                                    <div class="category-box-9 w-100 text-center float-left">
                                        <img src="theme_educational/static/src/images/marketing-icon.png"/>
                                        <h4>Marketing</h4>
                                        <p>15 Courses</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="educational_snippets" inherit_id="website.snippets" priority="8">
        <xpath expr="//snippets[@id='snippet_content']//t[@t-snippet][last()]" position="after">
            <t t-snippet="theme_educational.choose_a_category_snippet"/>
            <t t-snippet="theme_educational.search_course_snippet"/>
            <t t-snippet="theme_educational.choose_a_plan_snippet"/>
            <t t-snippet="theme_educational.faq_snippet"/>
        </xpath>
    </template>
</odoo>
