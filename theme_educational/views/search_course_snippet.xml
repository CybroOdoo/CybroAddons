<?xml version="1.0" encoding="utf-8"?>
<!-- Course Search Building Block Snippet for Theme Educational -->
<odoo>
    <!-- Template for rendering course search banner building block snippet -->
    <template id="search_course_snippet" name="Search Course Snippet">
        <section class="section-choose-banner w-100 s_text_block" data-snippet="s_text_block" data-name="Search Course">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="banner-container">
                            <h2><b>What do you want to learn?</b></h2>
                            <p>Grow your skill with the most reliable online courses and certifications</p>
                            <form action="/slides/all" method="get" class="banner-search-form">
                                <input type="text" name="search" placeholder="Search courses" class="form-control" autocomplete="off"/>
                                <button type="submit">Search</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>