<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="top_trending_courses" name="Top Trending Product Snippet">
        <section class="s_top_trending_courses">
            <div class="container mt-5">
                <div class="alert alert-info">
                    <h4>Your Trending Courses snippet will be displayed here...
                        Please save to view the snippet
                    </h4>
                </div>
            </div>
        </section>
    </template>

    <!-- Placeholder template (shown in editor before save) -->
    <template id="awards_and_stuff" name="Awards and Stuff Snippet">
        <section class="s_awards_and_stuff">
            <div class="container mt-5">
                <div class="alert alert-info">
                    <h4>Your Trending Courses snippet will be displayed here...
                        Please save to view the snippet
                    </h4>
                </div>
            </div>
        </section>
    </template>

    <!-- Register snippet into website builder -->
    <template id="category_highlight_snippet" inherit_id="website.snippets"
              name="Top Trending Product Snippet">
        <xpath expr="//snippets[@id='snippet_content']//t[@t-snippet][last()]" position="after">
            <t t-snippet="theme_educational.top_trending_courses"/>
        </xpath>
    </template>

    <template id="snippet_awards_and_stuff" inherit_id="website.snippets">
        <xpath expr="//snippets[@id='snippet_content']//t[@t-snippet][last()]" position="before">
            <t t-snippet="theme_educational.awards_and_stuff"/>
        </xpath>
    </template>

    <template id="homepage_with_awards" inherit_id="website.homepage" name="Homepage with Awards">
            <xpath expr="//div[@id='wrap']" position="inside">
                <t t-snippet="theme_educational.top_trending_courses_snippet"
                   data-oe-upshift="true"/>
            </xpath>
    </template>

    <template id="homepage_with_awards_and_stuff" inherit_id="website.homepage" name="Awards N Stuff">
            <xpath expr="//div[@id='wrap']" position="inside">
                <t t-snippet="theme_educational.awards_and_stuff_snippet"
                   data-oe-upshift="true"/>
            </xpath>
    </template>

</odoo>
