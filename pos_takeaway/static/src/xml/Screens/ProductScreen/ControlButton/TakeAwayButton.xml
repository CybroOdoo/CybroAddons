<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_takeaway.TakeAwayButton" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <t t-if="!props.showRemainingButtons and this.pos.config.module_pos_restaurant and this.pos.config.is_pos_takeaway">
                <button class="control-button pos_takeaway_button btn rounded-0 fw-bolder"
                        t-att-class="takeAwayButtonClass"
                        t-on-click="() => this.onClickTakeAway()">
                    <i class="fa fa-shopping-basket"/> Take Away
                </button>
            </t>
        </xpath>
    </t>
</templates>
