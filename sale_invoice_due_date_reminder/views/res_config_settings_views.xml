<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale order due reminder in the Sales settings -->
    <record id="res_config_settings_view_form_sale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.invoice.due.date.reminder.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_setting_container']" position="after">
                <block title="Order Due Reminder" name="sale_order_due_reminder_container">
                    <setting id="order_due_reminder"
                             help="Email the customers of the sale orders that are not fully invoiced or paid before their due date.">
                        <field name="reminder_sales"/>
                        <div class="mt8" invisible="not reminder_sales">
                            <field name="set_date_sales" class="oe_inline"/>
                            <span> days before the due date</span>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
    <!-- Invoice due reminder in the Invoicing settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.invoice.due.date.reminder.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Invoice Due Reminder" name="invoice_due_reminder_container">
                    <setting id="invoice_due_reminder"
                             help="Email the customers of the unpaid customer invoices before their due date.">
                        <field name="reminder_invoicing"/>
                        <div class="mt8" invisible="not reminder_invoicing">
                            <field name="set_date_invoicing" class="oe_inline"/>
                            <span> days before the due date</span>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
