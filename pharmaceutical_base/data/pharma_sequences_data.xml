<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence for batch manufacturing record numbers. -->
    <record id="seq_pharma_bmr" model="ir.sequence">
        <field name="name">Batch Manufacturing Record</field>
        <field name="code">pharma.bmr</field>
        <field name="prefix">BMR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for QC test order numbers. -->
    <record id="seq_pharma_qc_order" model="ir.sequence">
        <field name="name">QC Test Order</field>
        <field name="code">pharma.qc.test.order</field>
        <field name="prefix">QC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for QC specification numbers. -->
    <record id="seq_pharma_qc_spec" model="ir.sequence">
        <field name="name">QC Specification</field>
        <field name="code">pharma.qc.spec</field>
        <field name="prefix"></field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for OOS investigation numbers. -->
    <record id="seq_pharma_oos" model="ir.sequence">
        <field name="name">OOS Investigation</field>
        <field name="code">pharma.oos.investigation</field>
        <field name="prefix">OOS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Certificate of Analysis sequence (seq_pharma_coa) lives in the optional pharma_traceability_coa module. -->

    <!-- Vendor Qualification sequence (seq_pharma_vendor_qual) lives in the separately-installable pharma_vendor_qualification module. -->

    <!-- Standard Operating Procedure sequence (seq_pharma_sop) lives in the separately-installable pharma_sop_training module. -->

    <!-- QA Release Queue sequence (seq_pharma_qa_release) lives in the optional pharma_traceability_coa module. -->

    <!-- Fills the lot sequence on tracked products that were created without one. -->
    <function model="product.template" name="_backfill_lot_sequences"/>

</odoo>
