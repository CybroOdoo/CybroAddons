<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- App switcher grid rendered by the pharmaceutical_base.homemenus action. -->
    <t t-name="pharmaceutical_base.home_menus">
        <section class="app_container pharma_app_container">
            <div class="container">
                <div class="wrapper">
                    <div class="app_list">
                        <t t-foreach="this.menu.getApps()" t-as="app" t-key="app.id">
                            <a class="app_wrapp"
                               role="menuitem"
                               t-attf-href="#menu_id={{app.id}}"
                               t-att-data-menu-id="app.menuID"
                               t-att-data-menu-xmlid="app.xmlID"
                               t-att-data-action-id="app.actionID"
                               t-on-click="() => this.onAppClick(app)">
                                <div class="app">
                                    <t t-if="app.webIconData">
                                        <img t-att-src="app.webIconData"
                                             t-att-title="app.name"
                                             class="app-icon"/>
                                    </t>
                                    <t t-else="">
                                        <i t-attf-class="bi bi-#{this.getIconClass(app.name)}"/>
                                    </t>
                                </div>
                                <span class="a_app_menu_title" t-out="app.name"/>
                            </a>
                        </t>
                    </div>
                </div>
            </div>
        </section>
    </t>
</templates>
