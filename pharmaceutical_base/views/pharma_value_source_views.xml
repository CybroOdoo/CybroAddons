<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Editable list of registered measurement sources. -->
    <record id="pharma_value_source_list" model="ir.ui.view">
        <field name="name">pharma.value.source.list</field>
        <field name="model">pharma.value.source</field>
        <field name="arch" type="xml">
            <list string="Measurement Sources" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="source_type"/>
            </list>
        </field>
    </record>
    <!-- Action opening registered measurement sources. -->
    <record id="pharma_value_source_action" model="ir.actions.act_window">
        <field name="name">Measurement Sources</field>
        <field name="res_model">pharma.value.source</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No measurement sources registered yet.
            </p>
            <p>
                Register a balance, instrument or sensor here. Values it
                captures are marked "Captured from a Device"; everything else
                is marked "Entered by a Person".
            </p>
        </field>
    </record>
</odoo>
