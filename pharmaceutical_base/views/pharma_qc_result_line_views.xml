<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Editable list view for QC result lines. -->
    <record id="pharma_qc_result_line_view_list" model="ir.ui.view">
        <field name="name">pharma.qc.result.line.list</field>
        <field name="model">pharma.qc.result.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="result_entered" column_invisible="True"/>
                <field name="test_status" column_invisible="True"/>
                <field name="has_min" column_invisible="True"/>
                <field name="has_max" column_invisible="True"/>
                <field name="parameter_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                <field name="expected_min" readonly="1" force_save="1"/>
                <field name="expected_max" readonly="1" force_save="1"/>
                <field name="actual_value" readonly="test_status != 'in_progress'"/>
                <field name="uom" readonly="1" force_save="1"/>
                <field name="is_oos" widget="boolean_toggle" readonly="1"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'pass'"
                       decoration-danger="status == 'oos'"/>
            </list>
        </field>
    </record>
</odoo>
