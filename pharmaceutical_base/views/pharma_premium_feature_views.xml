<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dialog describing a premium add-on and leading to its Apps page. -->
    <record id="pharma_premium_feature_view_form" model="ir.ui.view">
        <field name="name">pharma.premium.feature.view.form</field>
        <field name="model">pharma.premium.feature</field>
        <field name="arch" type="xml">
            <form string="Premium Add-on" create="0" edit="0" delete="0"
                  class="o_pharma_premium_dialog">
                <sheet>
                    <field name="module_state" invisible="1"/>
                    <field name="is_installed" invisible="1"/>
                    <div class="oe_title">
                        <span class="o_pharma_premium_tag"><i class="fa fa-star me-1"/>Premium</span>
                        <h1><field name="name"/></h1>
                        <field name="summary"/>
                    </div>
                    <div class="alert alert-warning o_pharma_premium_paid" role="alert"
                         invisible="is_installed">
                        <i class="fa fa-lock me-1"/>
                        <strong>Premium add-on.</strong> It is sold separately on
                        the Odoo Apps Store. Once its module is on your server,
                        switch it on in Settings to install it.
                    </div>
                    <field name="description" nolabel="1"/>
                    <div class="alert alert-success mb-0" role="status"
                         invisible="not is_installed">
                        The <field name="module_name" class="oe_inline"/> add-on
                        is installed.
                    </div>
                </sheet>
                <footer>
                    <button name="action_open_purchase" type="object"
                            string="Buy on Odoo Apps" class="btn-primary"
                            invisible="is_installed"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
