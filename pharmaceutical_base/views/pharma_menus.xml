<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root menu of the Pharmaceutical ERP app. -->
    <menuitem
            id="menu_pharma_quality_root"
            name="Pharmaceutical ERP"
            sequence="50"
            groups="pharmaceutical_base.group_pharma_user"
            web_icon="pharmaceutical_base,static/description/icon.png"
    />

    <!-- Client action opening the pharma overview. -->
    <record id="action_pharma_dashboard" model="ir.actions.client">
        <field name="name">Overview</field>
        <field name="tag">pharma_dashboard_action</field>
    </record>

    <!-- Menu for the pharma overview dashboard. -->
    <menuitem id="menu_pharma_dashboard" name="Overview"
              parent="menu_pharma_quality_root" action="action_pharma_dashboard"
              groups="pharmaceutical_base.group_pharma_user" sequence="5"/>

    <!-- Parent menu for quality control. -->
    <menuitem id="menu_pharma_quality" name="Quality Control"
              parent="menu_pharma_quality_root" groups="pharmaceutical_base.group_pharma_user" sequence="20"/>

    <!-- Menu for QC specifications. -->
    <menuitem id="menu_pharma_qc_specs" name="QC Specifications"
              parent="menu_pharma_quality"
              action="pharmaceutical_base.pharma_qc_spec_action"
              groups="pharmaceutical_base.group_pharma_user" sequence="10"/>

    <!-- Menu for QC test orders. -->
    <menuitem id="menu_pharma_qc_test_order" name="QC Test Orders"
              parent="menu_pharma_quality"
              action="pharmaceutical_base.pharma_qc_test_order"
              groups="pharmaceutical_base.group_pharma_operator"
              sequence="20"/>

    <!-- Menu for the quarantine queue. -->
    <menuitem id="menu_pharma_quarantine" name="Quarantine Queue"
              parent="menu_pharma_quality"
              action="pharmaceutical_base.pharma_quarantine_queue_action"
              groups="pharmaceutical_base.group_pharma_user" sequence="30"/>

    <!-- Menu for OOS investigations. -->
    <menuitem id="menu_pharma_oos_investigation" name="OOS Investigations"
              parent="menu_pharma_quality"
              action="pharmaceutical_base.pharma_oos_investigation_action"
              groups="pharmaceutical_base.group_pharma_qc_analyst"
              sequence="40"/>

    <!-- Parent menu for pharma configuration. -->
    <menuitem id="menu_pharma_configuration" name="Configuration"
              parent="menu_pharma_quality_root"
              groups="pharmaceutical_base.group_pharma_role_admin" sequence="100"/>

    <!-- Menu for pharma settings. -->
    <menuitem id="menu_pharma_settings" name="Settings"
              parent="menu_pharma_configuration"
              action="pharmaceutical_base.pharma_config_settings_action"
              groups="pharmaceutical_base.group_pharma_role_admin" sequence="10"/>

    <!-- Menu for registered measurement sources (devices). -->
    <menuitem id="menu_pharma_value_source" name="Measurement Sources"
              parent="menu_pharma_configuration"
              action="pharmaceutical_base.pharma_value_source_action"
              groups="pharmaceutical_base.group_pharma_role_admin" sequence="20"/>

    <!-- Parent menu for batch records under Manufacturing. -->
    <menuitem id="menu_pharma_batch_records" name="Batch Records"
              parent="mrp.menu_mrp_root"
              groups="pharmaceutical_base.group_pharma_user" sequence="5"/>

    <!-- Menu for batch manufacturing records. -->
    <menuitem id="menu_pharma_bmr" name="Batch Manufacturing Records"
              parent="menu_pharma_batch_records"
              action="pharmaceutical_base.pharma_bmr_action"
              groups="pharmaceutical_base.group_pharma_user" sequence="10"/>

    <!-- Menu for IPQC checks. -->
    <menuitem id="menu_pharma_ipqc" name="IPQC Checks"
              parent="menu_pharma_batch_records"
              action="pharmaceutical_base.pharma_ipqc_result_action"
              groups="pharmaceutical_base.group_pharma_user" sequence="20"/>
</odoo>
