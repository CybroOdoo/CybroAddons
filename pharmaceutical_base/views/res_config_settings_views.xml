<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds the pharma block to general settings. -->
    <record id="res_config_settings_view_form_pharmaceutical_base" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pharmaceutical.erp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Pharmaceutical ERP"
                     string="Pharmaceutical ERP"
                     name="pharmaceutical_base"
                     logo="/pharmaceutical_base/static/description/icon.png">

                    <block title="Vendor Management" name="pharmaceutical_base_vendor_settings">
                        <setting id="pharmaceutical_base_module_vendor_qualification"
                                 string="Enable Vendor Qualification"
                                 help="Manage Approved Vendor Lists (AVL), questionnaire portal, and PO enforcement.">
                            <field name="module_pharma_vendor_qualification"/>
                        </setting>
                        <setting id="pharmaceutical_base_vendor_approval_percentage"
                                 string="Vendor Qualification Approval (%)"
                                 help="Minimum audit score (%) required for vendor approval."
                                 invisible="not module_pharma_vendor_qualification">
                            <field name="pharma_vendor_approval_percentage"
                                   required="module_pharma_vendor_qualification"/>
                        </setting>
                    </block>

                    <block title="Quality Assurance" name="pharmaceutical_base_quality_settings">
                        <setting id="pharmaceutical_base_module_capa_deviation"
                                 string="Enable CAPA &amp; Deviation Management"
                                 help="Manage CAPA and deviations linked with quality and manufacturing workflows.">
                            <field name="module_pharma_capa_deviation"/>
                        </setting>
                    </block>

                    <block title="SOP &amp; Training" name="pharmaceutical_base_sop_settings">
                        <setting id="pharmaceutical_base_module_sop_training"
                                 string="Enable SOP &amp; Training Management"
                                 help="Track SOP lifecycles, training records, and training-gated BMR step sign-offs.">
                            <field name="module_pharma_sop_training"/>
                        </setting>
                        <setting id="pharmaceutical_base_training_passing_score"
                                 string="SOP Training Passing Score (%)"
                                 help="Minimum assessment score (%) required to pass SOP training."
                                 invisible="not module_pharma_sop_training">
                            <field name="pharma_training_passing_score"
                                   required="module_pharma_sop_training"/>
                        </setting>
                    </block>

                    <block title="Traceability &amp; Certification" name="pharmaceutical_base_traceability_settings">
                        <setting id="pharmaceutical_base_module_traceability_coa"
                                 string="Enable Traceability, CoA &amp; Audit Trail"
                                 help="Enable Certificate of Analysis (CoA), batch genealogy, and audit trail.">
                            <field name="module_pharma_traceability_coa"/>
                        </setting>
                    </block>

                    <block title="Inventory &amp; Quality Locations" name="pharmaceutical_base_location_settings">
                        <setting id="pharmaceutical_base_rejected_location"
                                 string="Rejected Location"
                                 help="Location where QC-rejected material is automatically moved.">
                            <field name="pharma_rejected_location_id"/>
                        </setting>
                        <setting id="pharmaceutical_base_enforce_storage_class"
                                 string="Enforce Storage Class"
                                 help="Restrict material transfers to locations matching their assigned Storage Class.">
                            <field name="pharma_enforce_storage_class"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <!-- Action opening pharma settings. -->
    <record id="pharma_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'pharmaceutical_base', 'bin_size': False}</field>
    </record>
</odoo>
