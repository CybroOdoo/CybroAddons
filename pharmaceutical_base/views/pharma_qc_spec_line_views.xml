<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Editable list view for QC specification lines. -->
    <record id="pharma_qc_spec_line_view_list" model="ir.ui.view">
        <field name="name">pharma.qc.spec.line.list</field>
        <field name="model">pharma.qc.spec.line</field>
        <field name="arch" type="xml">
            <list string="Parameters" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="parameter_name" required="1"/>
                <field name="test_method"/>
                <field name="uom_id" string="Unit"/>
                <field name="min_value"/>
                <field name="max_value"/>
                <field name="acceptance_criteria"
                       placeholder="Qualitative criteria…"/>

                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>
</odoo>
