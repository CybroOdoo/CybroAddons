<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Issue List View: Displays synchronized GitHub issues with status and task links. -->
    <record id="view_github_issue_list" model="ir.ui.view">
        <field name="name">github.issue.list</field>
        <field name="model">github.issue</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'open'"
                  decoration-muted="state == 'closed'">
                <field name="number"/>
                <field name="title"/>
                <field name="repository_id"/>
                <field name="assignee"/>
                <field name="labels"/>
                <field name="state" widget="badge" decoration-success="state == 'open'" decoration-muted="state == 'closed'"/>
                <field name="created_at"/>
                <field name="issue_age_days" string="Age (Days)"/>
                <field name="task_ids" widget="many2many_tags"/>
                <button name="action_create_task" string="Create Task" type="object" icon="fa-tasks"/>
                <button name="action_view_github_issue" string="GitHub" type="object" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <!-- Issue Form View: Detailed view for managing a GitHub issue and converting to project tasks. -->
    <record id="view_github_issue_form" model="ir.ui.view">
        <field name="name">github.issue.form</field>
        <field name="model">github.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_task" type="object" string="Create Task" class="btn-primary"/>
                    <button name="action_export_to_github" type="object" string="Export to GitHub" class="btn-secondary" invisible="github_id"/>
                    <button name="action_view_github_issue" type="object" string="Open in GitHub" class="btn-secondary" invisible="not github_url"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="number" readonly="1" invisible="not number"/></h2>
                        <label for="title"/>
                        <h1>
                            <field name="title" placeholder="Issue Title"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Repository &amp; Assignment">
                            <field name="repository_id"/>
                            <field name="project_ids" widget="many2many_tags"/>
                            <field name="assignee"/>
                            <field name="labels"/>
                        </group>
                        <group string="Issue Timeline">
                            <field name="github_id" invisible="not github_id"/>
                            <field name="created_at"/>
                            <field name="updated_at"/>
                            <field name="closed_at" invisible="state != 'closed'"/>
                            <field name="issue_age_days"/>
                            <field name="github_url" widget="url" invisible="not github_url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="body" widget="html"/>
                        </page>
                        <page string="Linked Tasks" name="tasks">
                            <field name="task_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="stage_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Issue Search View -->
    <record id="view_github_issue_search" model="ir.ui.view">
        <field name="name">github.issue.search</field>
        <field name="model">github.issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="number"/>
                <field name="assignee"/>
                <field name="labels"/>
                <field name="repository_id"/>
                <filter string="Open" name="filter_open" domain="[('state', '=', 'open')]"/>
                <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Linked to Tasks" name="filter_linked_tasks" domain="[('task_ids', '!=', False)]"/>
                <filter string="Unlinked" name="filter_unlinked_tasks" domain="[('task_ids', '=', False)]"/>
                <group>
                    <filter string="Repository" name="group_by_repository" context="{'group_by': 'repository_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Assignee" name="group_by_assignee" context="{'group_by': 'assignee'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Issue Action -->
    <record id="action_github_issue" model="ir.actions.act_window">
        <field name="name">Issues</field>
        <field name="res_model">github.issue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_github_issue_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No GitHub issues found!
            </p>
            <p>
                Sync your repositories to fetch issues and convert them into project tasks.
            </p>
        </field>
    </record>
</odoo>
