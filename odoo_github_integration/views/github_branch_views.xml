<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branch List View: Displays synchronized branches with status indicators. -->
    <record id="view_github_branch_list" model="ir.ui.view">
        <field name="name">github.branch.list</field>
        <field name="model">github.branch</field>
        <field name="arch" type="xml">
            <list decoration-success="sync_status == 'success'"
                  decoration-danger="sync_status == 'error'"
                  decoration-warning="sync_status == 'syncing'">
                <field name="name"/>
                <field name="repository_id"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="is_protected" widget="boolean_toggle"/>
                <field name="commits_count"/>
                <field name="pull_request_count"/>
                <field name="ahead_count"/>
                <field name="behind_count"/>
                <field name="last_commit_date"/>
                <field name="last_commit_author"/>
                <field name="sync_status"/>
                <button name="action_sync_branch" type="object" string="Sync" icon="fa-refresh" invisible="sync_status == 'syncing'"/>
                <button name="action_create_pull_request" type="object" string="Create PR" icon="fa-plus" invisible="is_default"/>
            </list>
        </field>
    </record>

    <!-- Branch Form View: Detailed view for managing a specific branch and its commits/PRs. -->
    <record id="view_github_branch_form" model="ir.ui.view">
        <field name="name">github.branch.form</field>
        <field name="model">github.branch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_branch" type="object" string="Sync Branch" class="btn-primary" invisible="sync_status == 'syncing'"/>
                    <button name="action_create_pull_request" type="object" string="Create Pull Request" class="btn-secondary" invisible="is_default"/>
                    <button name="action_delete_branch" type="object" string="Delete Branch" class="btn-secondary" confirm="Are you sure you want to delete this branch from GitHub? This cannot be undone." invisible="is_default or is_protected"/>
                    <field name="sync_status" widget="statusbar" statusbar_visible="never,syncing,success,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_commits" type="object" class="oe_stat_button" icon="fa-code-fork">
                            <field name="commits_count" widget="statinfo" string="Commits"/>
                        </button>
                        <button name="action_view_pull_requests" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="pull_request_count" widget="statinfo" string="Pull Requests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Branch Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Branch Details">
                            <field name="repository_id"/>
                            <field name="is_default"/>
                            <field name="is_protected"/>
                            <field name="sha" string="Latest Commit SHA"/>
                        </group>
                        <group string="Sync Information">
                            <field name="ahead_count"/>
                            <field name="behind_count"/>
                            <field name="last_sync"/>
                            <field name="sync_error" invisible="not sync_error"/>
                        </group>
                    </group>
                    <group string="Last Commit">
                        <group>
                            <field name="last_commit_author"/>
                            <field name="last_commit_date"/>
                        </group>
                        <group>
                            <field name="last_commit_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commits" name="commits">
                            <field name="commit_ids" readonly="1">
                                <list>
                                    <field name="sha" string="ID"/>
                                    <field name="author_name" string="Author"/>
                                    <field name="message" string="Message"/>
                                    <field name="committed_date" string="Date"/>
                                    <button name="action_view_github_commit" string="GitHub" type="object" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pull Requests (Source)" name="prs_source">
                            <field name="pull_request_source_ids" readonly="1">
                                <list>
                                    <field name="number"/>
                                    <field name="title"/>
                                    <field name="base_branch"/>
                                    <field name="state"/>
                                    <field name="review_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pull Requests (Target)" name="prs_target">
                            <field name="pull_request_target_ids" readonly="1">
                                <list>
                                    <field name="number"/>
                                    <field name="title"/>
                                    <field name="head_branch"/>
                                    <field name="state"/>
                                    <field name="review_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="GitHub Links" name="links">
                            <group>
                                <field name="github_url" widget="url"/>
                                <field name="compare_url" widget="url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Branch Search View -->
    <record id="view_github_branch_search" model="ir.ui.view">
        <field name="name">github.branch.search</field>
        <field name="model">github.branch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="repository_id"/>
                <field name="last_commit_author"/>
                <filter string="Default Branches" name="filter_default" domain="[('is_default', '=', True)]"/>
                <filter string="Protected Branches" name="filter_protected" domain="[('is_protected', '=', True)]"/>
                <group>
                    <filter string="Repository" name="group_by_repository" context="{'group_by': 'repository_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Branch Action -->
    <record id="action_github_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">github.branch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_github_branch_search"/>
        <field name="context">{'search_default_group_by_repository': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No branches found!
            </p>
            <p>
                Sync your repositories to view branches, commits, and pull requests.
            </p>
        </field>
    </record>
</odoo>
