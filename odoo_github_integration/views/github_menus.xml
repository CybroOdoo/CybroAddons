<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main GitHub Menu -->
    <menuitem id="menu_github_root"
              name="GitHub Integration"
              web_icon="odoo_github_integration,static/description/icon.png"
              sequence="100"/>

    <menuitem id="menu_github_dashboard"
              name="Dashboard"
              parent="menu_github_root"
              action="github_dashboard_action"
              sequence="1"/>

    <menuitem id="menu_github_repository"
              name="Repositories"
              parent="menu_github_root"
              action="action_github_repository"
              sequence="2"/>

    <menuitem id="menu_github_branch"
              name="Branches"
              parent="menu_github_root"
              action="action_github_branch"
              sequence="3"/>

    <menuitem id="menu_github_issue"
              name="Issues"
              parent="menu_github_root"
              action="action_github_issue"
              sequence="4"/>

    <menuitem id="menu_github_pull_request"
              name="Pull Requests"
              parent="menu_github_root"
              action="action_github_pull_request"
              sequence="5"/>

    <menuitem id="menu_github_commit"
              name="Commits"
              parent="menu_github_root"
              action="action_github_commit"
              sequence="6"/>

    <menuitem id="menu_github_config_root"
              name="Configuration"
              parent="menu_github_root"
              action="action_github_config_final"
              groups="base.group_system"
              sequence="10"/>
</odoo>
