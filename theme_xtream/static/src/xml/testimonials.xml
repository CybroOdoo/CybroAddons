<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Testimonial Snippet -->
    <t t-name="theme_xtream.s_testimonials" name="Testimonials">

        <section class="testimonial_xtream s_block oe_snippet_body oe_structure">

            <div class="container mt32 mb32">

                <!-- Heading -->
                <div class="heading">
                    <h1 class="main">TESTIMONIALS</h1>
                </div>

                <div class="row">
                    <t t-if="testimonial_ids">
                        <div id="slider2" class="owl-carousel col-12">
                            <t t-foreach="testimonial_ids" t-as="testimonial" t-key="testimonial.id">

                                <div class="testimonial_content">

                                    <span class="fa fa-quote-right"/>
                                    <p class="pp">
                                        <t t-esc="testimonial.testimony"/>
                                    </p>

                                    <div class="img_test">
                                        <div class="wrapper">
                                            <img t-att-src="'/web/image?model=res.partner&amp;field=image_1920&amp;id=' + testimonial.partner_id.id"
                                                 class="img img-responsive img-fluid" loading="lazy"/>
                                        </div>
                                        <div class="name">
                                            <p><t t-esc="testimonial.partner_id.name"/></p>
                                        </div>
                                    </div>

                                </div>

                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <h4>No testimonials configured. Go to: Website → Configuration → Xtream Testimonials</h4>
                            </div>
                        </div>
                    </t>
                </div>

            </div>

        </section>

    </t>

</templates>
