<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- New Arrivals Snippet -->
    <t t-name="theme_xtream.s_new_arrivals" name="New Arrivals">

        <section class="arrivals s_block oe_snippet_body oe_structure">

            <div class="container mt32 mb32">

                <!-- Heading -->
                <div class="heading">
                    <h3 class="main">NEW ARRIVALS</h3>
                </div>

                <div class="row">
                    <t t-foreach="new_arrivals" t-as="product" t-key="product.id">

                        <!-- REMOVED text-center TO ALLOW LEFT ALIGN -->
                        <div class="col-lg-4 col-md-6 col-sm-6 col-12 mb-5">
                            <div class="feature_wrapper">

                                <a t-att-href="'/shop/product/' + product.id"
                                   class="product-link"
                                   style="text-decoration: none; color: inherit; display: block;">

                                    <!-- IMAGE -->
                                    <div class="img_wrapper">
                                        <img t-att-src="'/web/image?model=product.template&amp;field=image_1920&amp;id=' + product.id"
                                             class="img product-img img-responsive img-fluid"
                                             loading="lazy"/>
                                    </div>

                                    <!-- PRICE -->
                                    <p class="price-text mt-2">
                                        <t t-esc="product.currency_id.symbol"/>
                                        <t t-esc="product.list_price"/>
                                    </p>

                                    <!-- NAME -->
                                    <h6 class="name-text">
                                        <span t-esc="product.display_name"/>
                                    </h6>

                                    <!-- VIEW BUTTON -->
                                    <span class="view-btn">View Product</span>

                                </a>

                            </div>
                        </div>

                    </t>
                </div>

            </div>

        </section>

    </t>

</templates>
