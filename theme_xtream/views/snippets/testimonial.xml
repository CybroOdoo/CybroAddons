<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Snippet shown inside website snippet list -->
    <template id="s_testimonial" name="Testimonials" inherit_id="website.s_text_block">
        <xpath expr="//section" position="replace">
            <section class="testimonial_xtream" data-snippet="s_testimonial">
                <div class="container">
                    <div class="alert alert-info editable">
                        <h4>Save the page to load Testimonials...</h4>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

</odoo>
