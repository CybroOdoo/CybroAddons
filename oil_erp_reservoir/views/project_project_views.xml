<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the project project views. -->
    <record id="project_project_form_inherit_oil_reservoir" model="ir.ui.view">
        <field name="name">project.project.form.inherit.oil.reservoir</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_oil_gas_project']" position="after">
                <field name="reservoir_id"/>
                <field name="stage_id_domain" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="domain">stage_id_domain</attribute>
            </xpath>
        </field>
    </record>
</odoo>
