<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reservoir Tree View -->
    <record id="view_oil_reservoir_list" model="ir.ui.view">
        <field name="name">oil.reservoir.list</field>
        <field name="model">oil.reservoir</field>
        <field name="arch" type="xml">
            <list string="Reservoirs">
                <field name="name"/>
                <field name="code"/>
                <field name="location" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="fluid_type" optional="show"/>
                <field name="estimated_reserves" optional="hide"/>
                <field name="stage_id" optional="show"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Reservoir Form View -->
    <record id="view_oil_reservoir_form" model="ir.ui.view">
        <field name="name">oil.reservoir.form</field>
        <field name="model">oil.reservoir</field>
        <field name="arch" type="xml">
            <form string="Reservoir">
                <header>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1'}"
                           domain="[('is_oil_project_stage', '=', True)]"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_tasks" icon="fa-tasks">
                            <field string="Tasks" name="task_count"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Reservoir Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="general_info" string="General Information">
                            <field name="code"/>
                            <field name="location"/>
                            <field name="project_id"/>
                            <field name="task_ids"
                                   widget="many2many_tags"
                                   invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="reservoir_info"
                               string="Reservoir Assessment">
                            <field name="fluid_type"/>
                            <field name="estimated_reserves"/>
                            <field name="recovery_factor"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Geology &amp; Petrophysics" name="geology">
                            <group>
                                <group>
                                    <field name="formation"/>
                                    <field name="depth_ft"/>
                                </group>
                                <group>
                                    <field name="porosity"/>
                                    <field name="permeability"/>
                                </group>
                            </group>
                            <label for="notes" string="Geological Notes"/>
                            <field name="notes"
                                   placeholder="Detailed geological descriptions, sandstone/limestone parameters..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action for Reservoirs -->
    <record id="action_oil_reservoir" model="ir.actions.act_window">
        <field name="name">Reservoirs</field>
        <field name="res_model">oil.reservoir</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Reservoir!
            </p>
            <p>
                Track underground formations, primary fluids, geographical locations, and estimated reserves
                efficiently.
            </p>
        </field>
    </record>

    <!-- Top-level app menu if using standalone or under base -->
    <menuitem id="menu_oil_reservoir_records"
              name="Reservoirs"
              groups="oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"
              action="action_oil_reservoir"
              parent="oil_erp_base.menu_oil_upstream_root"
              sequence="1"/>
</odoo>
