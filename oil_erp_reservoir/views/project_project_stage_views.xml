<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- This file defines the project project stage views. -->
    <record id="project_project_stage_view_tree" model="ir.ui.view">
        <field name="name">project.project.stage.list.inherit</field>
        <field name="model">project.project.stage</field>
        <field name="inherit_id" ref="project.project_project_stage_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="before">
                <field name="is_oil_project_stage"/>
            </xpath>
        </field>
    </record>

    <record id="project_project_stage_view_form" model="ir.ui.view">
        <field name="name">project.project.stage.form.inherit</field>
        <field name="model">project.project.stage</field>
        <field name="inherit_id" ref="project.project_project_stage_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <field name="is_oil_project_stage"/>
            </xpath>
        </field>
    </record>

    <record id="project_project_stage_configure_oil" model="ir.actions.act_window">
        <field name="name">Project Stages</field>
        <field name="res_model">project.project.stage</field>
        <field name="path">project-stages-oil</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_oil_project_stage', '=', True)]</field>
        <field name="context">{'default_is_oil_project_stage': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stages found. Let's create one!
            </p>
            <p>
                Define the steps your projects move through from creation to completion.
            </p>
        </field>
    </record>

    <menuitem id="menu_oil_project_task_stages"
              name="Project Stages"
              parent="oil_erp_base.menu_oil_config_upstream"
              action="project_project_stage_configure_oil"
              sequence="10"/>
</odoo>
