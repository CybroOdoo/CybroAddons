<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file loads the reservoir project stage data. -->
    <data noupdate="1">
        <!-- Oil & Gas Project Stages (project.project.stage) -->
        <record id="project_stage_exploration" model="project.project.stage">
            <field name="name">Exploration &amp; Appraisal</field>
            <field name="sequence">1</field>
            <field name="is_oil_project_stage" eval="True"/>
        </record>
        <record id="project_stage_under_development" model="project.project.stage">
            <field name="name">Under Development</field>
            <field name="sequence">2</field>
            <field name="is_oil_project_stage" eval="True"/>
        </record>
        <record id="project_stage_producing" model="project.project.stage">
            <field name="name">Producing/Active</field>
            <field name="sequence">3</field>
            <field name="is_oil_project_stage" eval="True"/>
        </record>
        <record id="project_stage_depleted" model="project.project.stage">
            <field name="name">Depleted</field>
            <field name="sequence">4</field>
            <field name="fold" eval="True"/>
            <field name="is_oil_project_stage" eval="True"/>
        </record>
        <record id="project_stage_abandoned" model="project.project.stage">
            <field name="name">Abandoned</field>
            <field name="sequence">5</field>
            <field name="fold" eval="True"/>
            <field name="is_oil_project_stage" eval="True"/>
        </record>
    </data>
</odoo>
