<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Description of sequence_data.xml XML view/template -->
    <data noupdate="1">
        <!-- Sequence for Appointments -->
        <record id="seq_medicare_appointment" model="ir.sequence">
            <field name="name">Medicare Appointment Sequence</field>
            <field name="code">medicare.appointment</field>
            <field name="prefix">APPT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
