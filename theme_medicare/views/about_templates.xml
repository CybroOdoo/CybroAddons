<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Templates extending the native website about us page. -->
    <data>
        <template id="aboutus_page" name="About Us">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <!-- PAGE HERO -->
                    <section class="page-hero">
                        <div class="container-fluid px-5">
                            <h1 class="page-hero-title">About Us</h1>
                            <nav class="breadcrumb-custom">
                                <a href="/">Home</a>
                                <span>›</span>
                                <span class="current">About Us</span>
                            </nav>
                        </div>
                    </section>

                    <!-- MISSION & VISION -->
                    <section class="section-pad">
                        <div class="container-fluid px-5">
                            <div class="row g-4 align-items-center">
                                <div class="col-lg-6">
                                    <div class="section-label mb-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                        Our Story
                                    </div>
                                    <h2 class="section-title mb-4">A Legacy of Healing Since 1974</h2>
                                    <p class="section-desc mb-4">Founded over 50 years ago with a single ward and a bold
                                        mission, MediCare has grown into one of the region's most trusted healthcare
                                        institutions. We combine the warmth of community care with the precision of
                                        world-class medicine.
                                    </p>
                                    <p class="section-desc mb-4">Our mission is simple: deliver compassionate,
                                        evidence-based healthcare that improves lives. From routine check-ups to complex
                                        surgeries, every patient receives the same unwavering commitment to excellence.
                                    </p>
                                    <div class="d-flex gap-3 flex-wrap">
                                        <div class="d-flex align-items-center gap-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                 viewBox="0 0 24 24" fill="none" stroke="#1a5fb4" stroke-width="2.5"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                                <path d="M22 4L12 14.01l-3-3"/>
                                            </svg>
                                            <span style="font-size:.95rem;font-weight:600;">Founded 1974</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                 viewBox="0 0 24 24" fill="none" stroke="#1a5fb4" stroke-width="2.5"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                                <path d="M22 4L12 14.01l-3-3"/>
                                            </svg>
                                            <span style="font-size:.95rem;font-weight:600;">50+ Years of Excellence
                                            </span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                 viewBox="0 0 24 24" fill="none" stroke="#1a5fb4" stroke-width="2.5"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                                <path d="M22 4L12 14.01l-3-3"/>
                                            </svg>
                                            <span style="font-size:.95rem;font-weight:600;">JCI Accredited</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="row g-3">
                                        <div class="col-12 col-sm-6">
                                            <div class="value-card">
                                                <div class="value-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <h6>Compassion</h6>
                                                    <p>We treat every patient with empathy, dignity, and genuine care.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <div class="value-card">
                                                <div class="value-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <h6>Excellence</h6>
                                                    <p>We hold ourselves to the highest standards in clinical
                                                        outcomes.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <div class="value-card">
                                                <div class="value-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <circle cx="12" cy="12" r="10"/>
                                                        <path d="M12 8v4l3 3"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <h6>Innovation</h6>
                                                    <p>We embrace cutting-edge research and technology to lead in
                                                        medicine.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <div class="value-card">
                                                <div class="value-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <h6>Integrity</h6>
                                                    <p>Transparency and honesty guide every decision we make.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- STATISTICS -->
                    <section class="section-pad section-muted">
                        <div class="container-fluid px-5">
                            <div class="text-center mb-5">
                                <div class="section-label mx-auto mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M3 3v18h18"/>
                                        <path d="M18 17V9"/>
                                        <path d="M13 17V5"/>
                                        <path d="M8 17v-3"/>
                                    </svg>
                                    By the Numbers
                                </div>
                                <h2 class="section-title">MediCare at a Glance</h2>
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="stat-item text-center">
                                        <div class="stat-number">50+</div>
                                        <div class="stat-label">Years of Service</div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="stat-item text-center">
                                        <div class="stat-number">200+</div>
                                        <div class="stat-label">Specialist Doctors</div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="stat-item text-center">
                                        <div class="stat-number">1.2M+</div>
                                        <div class="stat-label">Patients Served</div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="stat-item text-center">
                                        <div class="stat-number">98%</div>
                                        <div class="stat-label">Patient Satisfaction</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- LEADERSHIP TEAM -->
                    <section class="section-pad">
                        <div class="container-fluid px-5">
                            <div class="text-center mb-5">
                                <div class="section-label mx-auto mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                    Our People
                                </div>
                                <h2 class="section-title">Leadership Team</h2>
                                <p class="section-desc mx-auto">Meet the dedicated physicians and administrators who
                                    guide MediCare's mission every day.
                                </p>
                            </div>
                            <div class="row g-3 justify-content-center">
                                <div class="col-md-4 col-lg-3">
                                    <div class="doctor-card">
                                        <div class="doctor-img-wrap">
                                            <img src="/theme_medicare/static/src/img/avatar-male-35-50-South-Asian-1.jpg"
                                                 alt="Dr. Raj Mehta" class="doctor-img"/>
                                            <span class="doctor-specialty-badge">Chief Medical Officer</span>
                                        </div>
                                        <div class="doctor-info">
                                            <h5 class="doctor-name">Dr. Raj Mehta</h5>
                                            <p class="doctor-exp">Cardiology · 22 Years Experience</p>
                                            <div class="doctor-rating mb-3">
                                                <span class="stars">★★★★★</span>
                                                <span class="rating-val">4.9</span>
                                            </div>
                                            <a href="/doctors" class="btn-doctor-book">View Profile</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 col-lg-3">
                                    <div class="doctor-card">
                                        <div class="doctor-img-wrap">
                                            <img src="/theme_medicare/static/src/img/avatar-female-35-50-North-American-4.jpg"
                                                 alt="Dr. Sarah Connors" class="doctor-img"/>
                                            <span class="doctor-specialty-badge">Chief of Surgery</span>
                                        </div>
                                        <div class="doctor-info">
                                            <h5 class="doctor-name">Dr. Sarah Connors</h5>
                                            <p class="doctor-exp">General Surgery · 18 Years Experience</p>
                                            <div class="doctor-rating mb-3">
                                                <span class="stars">★★★★★</span>
                                                <span class="rating-val">4.8</span>
                                            </div>
                                            <a href="/doctors" class="btn-doctor-book">View Profile</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 col-lg-3">
                                    <div class="doctor-card">
                                        <div class="doctor-img-wrap">
                                            <img src="/theme_medicare/static/src/img/avatar-male-35-50-African-3.jpg"
                                                 alt="Dr. Samuel Osei" class="doctor-img"/>
                                            <span class="doctor-specialty-badge">Head of Research</span>
                                        </div>
                                        <div class="doctor-info">
                                            <h5 class="doctor-name">Dr. Samuel Osei</h5>
                                            <p class="doctor-exp">Oncology · 15 Years Experience</p>
                                            <div class="doctor-rating mb-3">
                                                <span class="stars">★★★★★</span>
                                                <span class="rating-val">4.9</span>
                                            </div>
                                            <a href="/doctors" class="btn-doctor-book">View Profile</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ACCREDITATIONS -->
                    <section class="section-pad section-muted">
                        <div class="container-fluid px-5">
                            <div class="text-center mb-5">
                                <div class="section-label mx-auto mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                    </svg>
                                    Certifications
                                </div>
                                <h2 class="section-title">Accreditations &amp; Awards</h2>
                                <p class="section-desc mx-auto">Our quality is independently verified by the world's
                                    leading healthcare certification bodies.
                                </p>
                            </div>
                            <div class="row g-3">
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="accreditation-card">
                                        <div class="accreditation-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                            </svg>
                                        </div>
                                        <h6>JCI Accredited</h6>
                                        <p>Joint Commission International — Gold Seal of Approval</p>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="accreditation-card">
                                        <div class="accreditation-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                            </svg>
                                        </div>
