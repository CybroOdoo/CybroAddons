<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Templates extending the native website contact us page. -->
    <data>
        <template id="contactus_page" inherit_id="website.contactus" name="BuildCraft Contact Us"
                  priority="200">
            <xpath expr="//div[@id='wrap']" position="replace">
                <div id="wrap" class="oe_structure oe_empty">
                    <!-- PAGE HERO -->
                    <section class="page-hero">
                        <div class="container-fluid px-5">
                            <h1 class="page-hero-title">Contact Us</h1>
                            <nav class="breadcrumb-custom">
                                <a href="/">Home</a>
                                <span>›</span>
                                <span class="current">Contact</span>
                            </nav>
                        </div>
                    </section>

                    <!-- CONTACT FORM + INFO -->
                    <section class="section-pad">
                        <div class="container-fluid px-5">
                            <div class="row g-4">
                                <!-- Left: Contact Form -->
                                <div class="col-lg-7">
                                    <div class="appt-form-card">
                                        <div class="section-label mb-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="m22 7l-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/>
                                                <rect width="20" height="16" x="2" y="4" rx="2"/>
                                            </svg>
                                            Send a Message
                                        </div>
                                        <h2 class="section-title mb-1" style="font-size:1.6rem;">Get in Touch</h2>
                                        <p style="font: size 0.95rem;color:#6b7a96;margin-bottom:28px;">Fill out the
                                            form and a member of our team will respond within one business day.
                                        </p>

                                        <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                            <div class="container-fluid p-0">
                                                <form id="contactus_form" action="/website/form/" method="post"
                                                      enctype="multipart/form-data" class="o_mark_required"
                                                      data-mark="*" data-model_name="mail.mail"
                                                      data-success-mode="redirect"
                                                      data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                    <div class="s_website_form_rows row g-3 s_col_no_bgcolor">
                                                        <div class="col-md-6 s_website_form_field s_website_form_custom s_website_form_required"
                                                             data-type="char" data-name="Field">
                                                            <label class="s_website_form_label appt-label"
                                                                   for="contact1">Full Name *
                                                            </label>
                                                            <input id="contact1" type="text"
                                                                   class="form-control s_website_form_input appt-input"
                                                                   name="name" required="" placeholder="John Smith"
                                                                   data-fill-with="name"/>
                                                        </div>
                                                        <div class="col-md-6 s_website_form_field s_website_form_required s_website_form_model_required"
                                                             data-type="email" data-name="Field">
                                                            <label class="s_website_form_label appt-label"
                                                                   for="contact3">Email Address *
                                                            </label>
                                                            <input id="contact3" type="email"
                                                                   class="form-control s_website_form_input appt-input"
                                                                   name="email_from" required=""
                                                                   placeholder="john@example.com"
                                                                   data-fill-with="email"/>
                                                        </div>
                                                        <div class="col-md-6 s_website_form_field s_website_form_custom"
                                                             data-type="char" data-name="Field">
                                                            <label class="s_website_form_label appt-label"
                                                                   for="contact2">Phone Number
                                                            </label>
                                                            <input id="contact2" type="tel"
                                                                   class="form-control s_website_form_input appt-input"
                                                                   name="phone" placeholder="+1 (555) 000-0000"
                                                                   data-fill-with="phone"/>
                                                        </div>
                                                        <div class="col-md-6 s_website_form_field s_website_form_required s_website_form_model_required"
                                                             data-type="char" data-name="Field">
                                                            <label class="s_website_form_label appt-label"
                                                                   for="contact5">Subject *
                                                            </label>
                                                            <input id="contact5" type="text"
                                                                   class="form-control s_website_form_input appt-input"
                                                                   name="subject" required=""
                                                                   placeholder="e.g. Appointment Inquiry"/>
                                                        </div>
                                                        <div class="col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                             data-type="text" data-name="Field">
                                                            <label class="s_website_form_label appt-label"
                                                                   for="contact6">Message *
                                                            </label>
                                                            <textarea id="contact6"
                                                                      class="form-control s_website_form_input appt-input"
                                                                      name="description" required="" rows="5"
                                                                      placeholder="Please describe how we can help you…"
                                                                      style="resize:vertical;min-height:120px;"></textarea>
                                                        </div>
                                                        <div class="d-none s_website_form_field s_website_form_dnone">
                                                            <input id="contact7" type="hidden"
                                                                   class="form-control s_website_form_input"
                                                                   name="email_to"/>
                                                        </div>
                                                        <div class="col-12 s_website_form_submit s_website_form_no_submit_label text-start"
                                                             data-name="Submit Button">
                                                            <button type="submit" role="button"
                                                                    class="btn btn-primary-custom w-100 s_website_form_send"
                                                                    style="width:max-content !important;padding:13px;">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                     height="16" viewBox="0 0 24 24" fill="none"
                                                                     stroke="currentColor" stroke-width="2.5"
                                                                     stroke-linecap="round" stroke-linejoin="round">
                                                                    <path d="m22 2-7 20-4-9-9-4Z"/>
                                                                    <path d="M22 2 11 13"/>
                                                                </svg>
                                                                Send Message
                                                            </button>
                                                            <span id="s_website_form_result"></span>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </section>
                                    </div>
                                </div>

                                <!-- Right: Info Cards + Map -->
                                <div class="col-lg-5">
                                    <div class="section-label mb-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        Find Us
                                    </div>
                                    <h2 class="section-title mb-4" style="font-size:1.6rem;">Contact Information</h2>

                                    <div class="d-flex flex-column gap-3 mb-4">
                                        <!-- Address -->
                                        <div class="contact-info-card">
                                            <div class="contact-info-icon">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                                                    <circle cx="12" cy="10" r="3"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <h6>Address</h6>
                                                <p>1200 Medical Center Drive<br/>New York, NY 10001, USA
                                                </p>
                                            </div>
                                        </div>
                                        <!-- Phone -->
                                        <div class="contact-info-card">
                                            <div class="contact-info-icon">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <h6>Phone</h6>
                                                <p>Main: 1-800-MEDICARE<br/>Emergency: 911
                                                </p>
                                            </div>
                                        </div>
                                        <!-- Email -->
                                        <div class="contact-info-card">
                                            <div class="contact-info-icon">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="m22 7l-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/>
                                                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <h6>Email</h6>
                                                <p>General: info@medicare.com<br/>Appointments: appt@medicare.com
                                                </p>
                                            </div>
                                        </div>
                                        <!-- Hours -->
                                        <div class="contact-info-card">
                                            <div class="contact-info-icon">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M12 6v6l4 2"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <h6>Hours</h6>
                                                <p>Mon – Sat: 8:00 AM – 8:00 PM<br/>Emergency: 24 / 7
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Map Placeholder -->
                                    <div class="map-placeholder">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        <span>1200 Medical Center Drive, New York, NY 10001</span>
                                        <a href="https://maps.google.com" target="_blank" class="btn btn-primary-custom"
                                           style="font-size:.8rem;padding:8px 16px;margin-top:4px;">Open in Google Maps
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- DEPARTMENT CONTACTS -->
                    <section class="section-pad section-muted">
                        <div class="container-fluid px-5">
                            <div class="text-center mb-5">
                                <div class="section-label mx-auto mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384"/>
                                    </svg>
                                    Direct Lines
                                </div>
                                <h2 class="section-title">Department Contacts</h2>
                                <p class="section-desc mx-auto">Reach the right department directly for faster
                                    assistance.
                                </p>
                            </div>
                            <div class="row g-4">
                                <!-- Emergency -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="dept-contact-card">
                                        <div class="dept-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 3h6l2 9 2-6 2 6 2-9h6"/>
                                                <line x1="12" x2="12" y1="18" y2="21"/>
                                                <line x1="8" x2="16" y1="21" y2="21"/>
                                            </svg>
                                        </div>
                                        <h6>Emergency</h6>
                                        <div class="phone">911</div>
                                        <p>24 / 7 — Life-threatening emergencies</p>
                                    </div>
                                </div>
                                <!-- Appointments -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="dept-contact-card">
                                        <div class="dept-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M8 2v4m8-4v4"/>
                                                <rect width="18" height="18" x="3" y="4" rx="2"/>
                                                <path d="M3 10h18M9 16l2 2l4-4"/>
                                            </svg>
                                        </div>
                                        <h6>Appointments</h6>
                                        <div class="phone">+1 (800) 555-0101</div>
                                        <p>Mon – Sat, 7 AM – 7 PM</p>
                                    </div>
                                </div>
                                <!-- Medical Records -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="dept-contact-card">
                                        <div class="dept-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                                <polyline points="14 2 14 8 20 8"/>
                                            </svg>
                                        </div>
                                        <h6>Medical Records</h6>
                                        <div class="phone">+1 (800) 555-0202</div>
                                        <p>Mon – Fri, 8 AM – 5 PM</p>
                                    </div>
                                </div>
                                <!-- Billing -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="dept-contact-card">
                                        <div class="dept-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="20" height="14" x="2" y="5" rx="2"/>
                                                <line x1="2" x2="22" y1="10" y2="10"/>
                                            </svg>
                                        </div>
                                        <h6>Billing</h6>
                                        <div class="phone">+1 (800) 555-0303</div>
                                        <p>Mon – Fri, 8 AM – 6 PM</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
