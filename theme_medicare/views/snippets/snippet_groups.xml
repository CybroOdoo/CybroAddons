<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="medicare_snippets" inherit_id="website.snippets" name="Medicare Snippets">
            <xpath expr="//div[@id='snippet_structure']" position="after">
                <div id="medicare_panel" class="o_panel">
                    <div class="o_panel_header">Medicare Theme</div>
                    <div class="o_panel_body">
                        <t t-snippet="theme_medicare.s_medicare_hero" string="Medicare Hero" t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_stats" string="Medicare Stats" t-thumbnail="/website/static/src/img/snippets_thumbs/s_numbers.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_departments" string="Medical Services" t-thumbnail="/website/static/src/img/snippets_thumbs/s_features.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_doctors" string="Doctors Grid" t-thumbnail="/website/static/src/img/snippets_thumbs/s_dynamic_snippet_carousel.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_mission" string="Mission &amp; Values" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_patient_services" string="Patient Services" t-thumbnail="/website/static/src/img/snippets_thumbs/s_features_grid.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_research_areas" string="Research Areas" t-thumbnail="/website/static/src/img/snippets_thumbs/s_features.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_specialties_grid" string="Specialties Grid" t-thumbnail="/website/static/src/img/snippets_thumbs/s_dynamic_snippet.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_appointment" string="Appointment Form" t-thumbnail="/website/static/src/img/snippets_thumbs/s_form_builder.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_emergency" string="Emergency Banner" t-thumbnail="/website/static/src/img/snippets_thumbs/s_call_to_action.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_doctor_block" string="Doctor Block" t-thumbnail="/website/static/src/img/snippets_thumbs/s_image_text.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_testimonials" string="Testimonials" t-thumbnail="/website/static/src/img/snippets_thumbs/s_quotes.svg"/>
                        <t t-snippet="theme_medicare.s_medicare_articles" string="Articles" t-thumbnail="/website/static/src/img/snippets_thumbs/s_dynamic_snippet.svg"/>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
