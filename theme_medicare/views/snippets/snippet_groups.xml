<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Registration of custom Medicare snippet groups for the website builder. -->
    <data>
        <template id="medicare_snippets" inherit_id="website.snippets" name="Medicare Snippets">
            <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
                <t t-snippet="website.s_snippet_group" string="Medicare Theme" snippet-group="medicare_group"/>
            </xpath>
            <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
                <t t-snippet="theme_medicare.s_medicare_hero" string="Medicare Hero" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                <t t-snippet="theme_medicare.s_medicare_stats" string="Medicare Stats" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_numbers.svg"/>
                <t t-snippet="theme_medicare.s_medicare_departments" string="Medical Services" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_features.svg"/>
                <t t-snippet="theme_medicare.s_medicare_doctors" string="Doctors Grid" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_dynamic_snippet_carousel.svg"/>
                <t t-snippet="theme_medicare.s_medicare_mission" string="Mission &amp; Values" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
                <t t-snippet="theme_medicare.s_medicare_patient_services" string="Patient Services"
                   group="medicare_group" t-thumbnail="/website/static/src/img/snippets_thumbs/s_features_grid.svg"/>
                <t t-snippet="theme_medicare.s_medicare_research_areas" string="Research Areas" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_features.svg"/>
                <t t-snippet="theme_medicare.s_medicare_specialties_grid" string="Specialties Grid"
                   group="medicare_group" t-thumbnail="/website/static/src/img/snippets_thumbs/s_dynamic_snippet.svg"/>
                <t t-snippet="theme_medicare.s_medicare_appointment" string="Appointment Form" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_form_builder.svg"/>
                <t t-snippet="theme_medicare.s_medicare_emergency" string="Emergency Banner" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_call_to_action.svg"/>
                <t t-snippet="theme_medicare.s_medicare_doctor_block" string="Doctor Block" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_image_text.svg"/>
                <t t-snippet="theme_medicare.s_medicare_testimonials" string="Testimonials" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_quotes.svg"/>
                <t t-snippet="theme_medicare.s_medicare_articles" string="Articles" group="medicare_group"
                   t-thumbnail="/website/static/src/img/snippets_thumbs/s_dynamic_snippet.svg"/>
            </xpath>
        </template>
    </data>
</odoo>
