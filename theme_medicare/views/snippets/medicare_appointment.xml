<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet for embedding a quick appointment booking call-to-action. -->
    <data>
        <template id="s_medicare_appointment" name="Medicare Appointment">
            <section class="section-pad bg-white s_medicare_appointment" data-snippet="theme_medicare.s_medicare_appointment" data-name="Medicare Appointment">
                <div class="container-fluid px-5">
                    <div class="row g-4 align-items-start">
                        <!-- Left: Steps -->
                        <div class="col-lg-7">
                            <div class="section-label">Easy Process</div>
                            <h2 class="section-title">Book an Appointment<br/>in 3 Simple Steps</h2>
                            <p class="section-subtitle mb-5">No long waits, no complicated forms. Get the care you need, when you need it.</p>

                            <div class="appt-steps">
                                <div class="appt-step">
                                    <div class="appt-step-num">01</div>
                                    <div class="appt-step-content">
                                        <h5 class="appt-step-title">Find Your Specialist</h5>
                                        <p class="appt-step-desc">Search by name, condition, or department to find the right doctor for your needs.</p>
                                    </div>
                                </div>
                                <div class="appt-step">
                                    <div class="appt-step-num">02</div>
                                    <div class="appt-step-content">
                                        <h5 class="appt-step-title">Choose Date &amp; Time</h5>
                                        <p class="appt-step-desc">Pick a convenient date and time slot from the doctor's live availability calendar.</p>
                                    </div>
                                </div>
                                <div class="appt-step">
                                    <div class="appt-step-num">03</div>
                                    <div class="appt-step-content">
                                        <h5 class="appt-step-title">Get Confirmation</h5>
                                        <p class="appt-step-desc">Receive instant confirmation via SMS &amp; email with all appointment details.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-4 mt-5 pt-4 border-top">
                                <div class="trust-badge">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                                        <path d="m9 12l2 2l4-4" />
                                    </svg>
                                    HIPAA Compliant
                                </div>
                                <div class="trust-badge">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <rect width="18" height="11" x="3" y="11" rx="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                    Secure &amp; Private
                                </div>
                                <div class="trust-badge">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M10.268 21a2 2 0 0 0 3.464 0m-10.47-5.674A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" />
                                    </svg>
                                    Instant Confirmation
                                </div>
                            </div>
                        </div>

                        <!-- Right: Form -->
                        <div class="col-lg-5">
                            <div class="appt-form-card">
                                <h4 class="appt-form-title">Request an Appointment</h4>
                                <p class="appt-form-sub">Fill in the form and we'll get back to you within 2 business hours.</p>
                                <form action="/appointment/submit" method="post" class="mt-4">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label class="form-label-custom">Full Name</label>
                                        <div class="input-icon-wrap">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                                <circle cx="12" cy="7" r="4" />
                                            </svg>
                                            <input type="text" name="patient_name" class="form-control form-control-custom" placeholder="Enter your full name" required=""/>
                                        </div>
                                    </div>
                                    <div class="row g-3 mb-3">
                                        <div class="col-12 col-sm-6">
                                            <label class="form-label-custom">Phone</label>
                                            <div class="input-icon-wrap">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384" />
                                                </svg>
                                                <input type="tel" name="phone" class="form-control form-control-custom" placeholder="+1 (___) ___" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <label class="form-label-custom">Email</label>
                                            <div class="input-icon-wrap">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="m22 7l-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
                                                    <rect width="20" height="16" x="2" y="4" rx="2" />
                                                </svg>
                                                <input type="email" name="email" class="form-control form-control-custom" placeholder="you@email.com" required=""/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label-custom">Department</label>
                                        <select name="department_name" class="form-select form-control-custom">
                                            <option value="">Select specialty</option>
                                            <option value="Cardiology">Cardiology</option>
                                            <option value="Neurology">Neurology</option>
                                            <option value="Orthopedics">Orthopedics</option>
                                            <option value="Pediatrics">Pediatrics</option>
                                            <option value="Ophthalmology">Ophthalmology</option>
                                            <option value="Oncology">Oncology</option>
                                            <option value="Endocrinology">Endocrinology</option>
                                            <option value="Pulmonology">Pulmonology</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label-custom">Preferred Date</label>
                                        <div class="input-icon-wrap">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M8 2v4m8-4v4" />
                                                <rect width="18" height="18" x="3" y="4" rx="2" />
                                                <path d="M3 10h18" />
                                            </svg>
                                            <input type="date" name="date" class="form-control form-control-custom" required="" t-att-min="time.strftime('%Y-%m-%d')"/>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label-custom">Brief Note (optional)</label>
                                        <textarea name="notes" class="form-control form-control-custom" rows="3" placeholder="Describe your symptoms or concern..."></textarea>
                                    </div>
                                    <div class="text-start">
                                        <button type="submit" class="btn btn-primary-custom w-100 btn-lg">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M8 2v4m8-4v4" />
                                                <rect width="18" height="18" x="3" y="4" rx="2" />
                                                <path d="M3 10h18M9 16l2 2l4-4" />
                                            </svg>
                                            Request Appointment
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </section>
        </template>
    </data>
</odoo>
