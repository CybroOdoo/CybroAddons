<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet for patient testimonials and reviews. -->
    <data>
        <template id="s_medicare_testimonials" name="Medicare Testimonials">
            <div class="oe_structure oe_empty o_editable">
                <section class="section-pad bg-white s_medicare_testimonials"
                         data-snippet="theme_medicare.s_medicare_testimonials" data-name="Testimonials">
                    <div class="container-fluid px-5">
                        <div class="text-center mb-5">
                            <div class="section-label">Patient Stories</div>
                            <h2 class="section-title">What Our Patients Say</h2>
                            <p class="section-subtitle">Real stories from real patients who trusted us with their
                                health
                            </p>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="testimonial-card">
                                    <div class="testimonial-quote">"</div>
                                    <div class="d-flex mb-3">
                                        <span class="text-warning fs-6">★★★★★</span>
                                    </div>
                                    <p class="testimonial-text">"The cardiac team at MediCare was absolutely
                                        exceptional. Dr. Mitchell's skill and compassion made a terrifying experience
                                        feel manageable. I'm fully recovered and grateful every day."
                                    </p>
                                    <div class="testimonial-author">
                                        <img src="/theme_medicare/static/src/img/avatar-female-35-50-North-American-4.jpg"
                                             alt="Linda Foster" class="testimonial-avatar"/>
                                        <div>
                                            <div class="testimonial-name">Linda Foster</div>
                                            <div class="testimonial-role">Cardiac Surgery Patient</div>
                                        </div>
                                        <span class="ms-auto testimonial-verified">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                                                 viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77a4 4 0 0 1 6.74 0a4 4 0 0 1 4.78 4.78a4 4 0 0 1 0 6.74a4 4 0 0 1-4.77 4.78a4 4 0 0 1-6.75 0a4 4 0 0 1-4.78-4.77a4 4 0 0 1 0-6.76"/>
                                                <path d="m9 12l2 2l4-4"/>
                                            </svg>
                                            Verified
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="testimonial-card">
                                    <div class="testimonial-quote">"</div>
                                    <div class="d-flex mb-3">
                                        <span class="text-warning fs-6">★★★★★</span>
                                    </div>
                                    <p class="testimonial-text">"After years of knee pain, Dr. Chen gave me my life
                                        back. The entire care team — from admission to physiotherapy — was professional,
                                        warm, and thorough. World-class facility."
                                    </p>
                                    <div class="testimonial-author">
                                        <img src="/theme_medicare/static/src/img/avatar-male-35-50-African-5.jpg"
                                             alt="James Okoro" class="testimonial-avatar"/>
                                        <div>
                                            <div class="testimonial-name">James Okoro</div>
                                            <div class="testimonial-role">Orthopedic Patient</div>
                                        </div>
                                        <span class="ms-auto testimonial-verified">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                                                 viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77a4 4 0 0 1 6.74 0a4 4 0 0 1 4.78 4.78a4 4 0 0 1 0 6.74a4 4 0 0 1-4.77 4.78a4 4 0 0 1-6.75 0a4 4 0 0 1-4.78-4.77a4 4 0 0 1 0-6.76"/>
                                                <path d="m9 12l2 2l4-4"/>
                                            </svg>
                                            Verified
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="testimonial-card">
                                    <div class="testimonial-quote">"</div>
                                    <div class="d-flex mb-3">
                                        <span class="text-warning fs-6">★★★★★</span>
                                    </div>
                                    <p class="testimonial-text">"The neurology department diagnosed my condition quickly
                                        when others missed it for years. I can't overstate how this team changed my
                                        life. Exceptional, empathetic, expert care."
                                    </p>
                                    <div class="testimonial-author">
                                        <img src="/theme_medicare/static/src/img/avatar-female-35-50-North-American-0.jpg"
                                             alt="Sarah Mitchell" class="testimonial-avatar"/>
                                        <div>
                                            <div class="testimonial-name">Sarah Mitchell</div>
                                            <div class="testimonial-role">Neurology Patient</div>
                                        </div>
                                        <span class="ms-auto testimonial-verified">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                                                 viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77a4 4 0 0 1 6.74 0a4 4 0 0 1 4.78 4.78a4 4 0 0 1 0 6.74a4 4 0 0 1-4.77 4.78a4 4 0 0 1-6.75 0a4 4 0 0 1-4.78-4.77a4 4 0 0 1 0-6.76"/>
                                                <path d="m9 12l2 2l4-4"/>
                                            </svg>
                                            Verified
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </template>
    </data>
</odoo>
