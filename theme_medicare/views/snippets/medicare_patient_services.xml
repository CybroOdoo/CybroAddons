<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="s_medicare_patient_services" name="Medicare Patient Services">
            <div class="oe_structure oe_empty o_editable">
                <section class="section-pad s_medicare_patient_services o_colored_level"
                         data-snippet="theme_medicare.s_medicare_patient_services" data-name="Patient Services">
                    <div class="container-fluid px-5">
                        <div class="text-center mb-5">
                            <div class="section-label mx-auto mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                </svg>
                                What We Offer
                            </div>
                            <h2 class="section-title">Everything You Need, Under One Roof</h2>
                            <p class="section-desc mx-auto">From your first appointment to discharge and beyond, our
                                patient services team is with you every step of the way.
                            </p>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="service-info-card">
                                    <div class="service-info-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="18" height="18" x="3" y="3" rx="2"/>
                                            <path d="M3 9h18M9 21V9"/>
                                        </svg>
                                    </div>
                                    <h5>Patient Portal</h5>
                                    <p>Access your health records, lab results, appointment history, and communicate
                                        securely with your care team — anytime, anywhere via our online portal.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="service-info-card">
                                    <div class="service-info-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="20" height="14" x="2" y="5" rx="2"/>
                                            <line x1="2" x2="22" y1="10" y2="10"/>
                                        </svg>
                                    </div>
                                    <h5>Insurance &amp; Billing</h5>
                                    <p>We accept over 50 insurance plans. Our billing specialists verify coverage,
                                        handle claims, and offer flexible payment plans so finances never delay your
                                        care.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="service-info-card">
                                    <div class="service-info-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                            <polyline points="14 2 14 8 20 8"/>
                                            <line x1="16" x2="8" y1="13" y2="13"/>
                                            <line x1="16" x2="8" y1="17" y2="17"/>
                                            <polyline points="10 9 9 9 8 9"/>
                                        </svg>
                                    </div>
                                    <h5>Medical Records</h5>
                                    <p>Request copies of your medical records, imaging reports, and referral letters
                                        within 24 hours. We support digital and printed formats for your convenience.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="service-info-card">
                                    <div class="service-info-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m9 3-6 6h4l5-5-3-1z"/>
                                            <path d="m21 3-6 6h4l-5-5 7-1z"/>
                                            <path d="M5 12h14"/>
                                            <path d="M12 5v14"/>
                                        </svg>
                                    </div>
                                    <h5>Pharmacy</h5>
                                    <p>Our in-house pharmacy is open 7 days a week. Prescriptions are filled within
                                        minutes and home delivery is available for ongoing medications.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="service-info-card">
                                    <div class="service-info-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M15 10l4.553-2.069A1 1 0 0 1 21 8.845v6.31a1 1 0 0 1-1.447.894L15 14M5 18h8a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2z"/>
                                        </svg>
                                    </div>
                                    <h5>Telemedicine</h5>
                                    <p>Consult with our doctors from the comfort of your home via secure video
                                        appointments. Available for follow-ups, prescription refills, and non-emergency
                                        care.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="service-info-card">
                                    <div class="service-info-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                        </svg>
                                    </div>
                                    <h5>Support Services</h5>
                                    <p>Our social workers, chaplains, and patient advocates provide emotional,
                                        logistical, and spiritual support throughout your hospital journey.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </template>
    </data>
</odoo>
