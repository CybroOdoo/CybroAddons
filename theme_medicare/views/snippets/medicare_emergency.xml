<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet for emergency contact information and quick links. -->
    <data>
        <template id="s_medicare_emergency" name="Medicare Emergency">
            <div class="oe_structure oe_empty o_editable">
                <section class="emergency-section s_medicare_emergency"
                         data-snippet="theme_medicare.s_medicare_emergency" data-name="Medicare Emergency">
                    <div class="container-fluid px-5">
                        <div class="emergency-banner">
                            <div class="emergency-glow-orb"></div>
                            <div class="row align-items-center g-4 position-relative" style="z-index:2;">
                                <div class="col-auto">
                                    <div class="emergency-icon-box">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36"
                                             viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M7 18v-6a5 5 0 1 1 10 0v6M5 21a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-1a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2zm16-9h1m-3.5-7.5L18 5M2 12h1m9-10v1M4.929 4.929l.707.707M12 12v6"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="emergency-pulse"></span>
                                        <span class="emergency-label">Always Open</span>
                                    </div>
                                    <h3 class="emergency-title">24/7 Emergency Care</h3>
                                    <p class="emergency-desc">Our ER is always open — no appointment needed. Immediate
                                        triage on arrival.
                                    </p>
                                </div>
                                <div class="col-auto d-none d-lg-flex gap-5">
                                    <div class="text-center">
                                        <div class="emergency-stat-val">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                 viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2.5"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="M12 6v6l4 2"/>
                                            </svg>
                                            &lt; 8 min
                                        </div>
                                        <div class="emergency-stat-label">Avg. Wait Time</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="emergency-stat-val">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                 viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2.5"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M10 10H6m8 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2m14 0h2a1 1 0 0 0 1-1v-3.28a1 1 0 0 0-.684-.948l-1.923-.641a1 1 0 0 1-.578-.502l-1.539-3.076A1 1 0 0 0 16.382 8H14M8 8v4m1 6h6"/>
                                                <circle cx="17" cy="18" r="2"/>
                                                <circle cx="7" cy="18" r="2"/>
                                            </svg>
                                            3 min
                                        </div>
                                        <div class="emergency-stat-label">Ambulance Response</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="emergency-stat-val">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                 viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2.5"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M2 4v16M2 8h18a2 2 0 0 1 2 2v10M2 17h20M6 8v9"/>
                                            </svg>
                                            80 Beds
                                        </div>
                                        <div class="emergency-stat-label">Emergency Beds</div>
                                    </div>
                                </div>
                                <div class="col-auto d-flex gap-2">
                                    <a href="tel:911" class="btn btn-emergency">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                                             viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384"/>
                                        </svg>
                                        Emergency: 911
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </template>
    </data>
</odoo>
