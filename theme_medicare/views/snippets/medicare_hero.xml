<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="s_medicare_hero" name="Medicare Hero">
            <div class="oe_structure oe_empty o_editable">
                <section class="hero-section s_medicare_hero pb8 pt8" data-snippet="theme_medicare.s_medicare_hero"
                         data-name="Medicare Hero">
                    <div class="hero-overlay"/>
                    <div class="hero-overlay-bottom"/>
                    <div class="container-fluid px-5 h-100 position-relative" style="z-index:2;">
                        <div class="row h-100 align-items-center">
                            <div class="col-lg-7 py-5"
                                 style="padding-top: 6rem !important; padding-bottom: 5rem !important;">
                                <div class="hero-badge mb-4">
                                    <span class="badge-dot"/>
                                    World-Class Healthcare
                                </div>
                                <h1 class="hero-title mb-4">
                                    Exceptional Care
                                    <br/>
                                    <span class="hero-title-gradient">Trusted by Families</span>
                                </h1>
                                <p class="hero-subtitle mb-5">
                                    Exceptional medical care delivered with compassion. Our team of 200+ specialists is
                                    here for every step of your health journey.
                                </p>
                                <div class="d-flex flex-wrap gap-3 mb-5">
                                    <a href="/appointment" class="btn btn-hero-primary">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M8 2v4m8-4v4"/>
                                            <rect width="18" height="18" x="3" y="4" rx="2"/>
                                            <path d="M3 10h18M9 16l2 2l4-4"/>
                                        </svg>
                                        Book Appointment
                                    </a>
                                    <a href="/doctors" class="btn btn-hero-outline">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m21 21l-4.34-4.34"/>
                                            <circle cx="11" cy="11" r="8"/>
                                        </svg>
                                        Find a Doctor
                                    </a>
                                </div>
                                <div class="d-flex flex-wrap gap-4">
                                    <div class="hero-badge-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round" class="text-accent">
                                            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                                            <path d="m9 12l2 2l4-4"/>
                                        </svg>
                                        JCI Accredited
                                    </div>
                                    <div class="hero-badge-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round" class="text-accent">
                                            <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77a4 4 0 0 1 6.74 0a4 4 0 0 1 4.78 4.78a4 4 0 0 1 0 6.74a4 4 0 0 1-4.77 4.78a4 4 0 0 1-6.75 0a4 4 0 0 1-4.78-4.77a4 4 0 0 1 0-6.76"/>
                                            <path d="m9 12l2 2l4-4"/>
                                        </svg>
                                        NABH Certified
                                    </div>
                                    <div class="hero-badge-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round" class="text-accent">
                                            <path d="M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978m7-7.318v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978M18 9h1.5a1 1 0 0 0 0-5H18M4 22h16"/>
                                            <path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm0 0H4.5a1 1 0 0 1 0-5H6"/>
                                        </svg>
                                        Best Hospital 2024
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stats Strip -->
                    <div class="stats-strip">
                        <div class="container-fluid px-5">
                            <div class="row g-0 counter">
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="stat-item">
                                        <div class="stat-icon-box">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="m15.477 12.89l1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/>
                                                <circle cx="12" cy="8" r="6"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="stat-number">50+</div>
                                            <div class="stat-label">Years of Excellence</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="stat-item border-start-stat">
                                        <div class="stat-icon-box">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 2v2M5 2v2m0-1H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/>
                                                <path d="M8 15a6 6 0 0 0 12 0v-3"/>
                                                <circle cx="20" cy="10" r="2"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="stat-number">200+</div>
                                            <div class="stat-label">Expert Specialists</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="stat-item border-start-stat">
                                        <div class="stat-icon-box">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3.128a4 4 0 0 1 0 7.744M22 21v-2a4 4 0 0 0-3-3.87"/>
                                                <circle cx="9" cy="7" r="4"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="stat-number">1.2M+</div>
                                            <div class="stat-label">Patients Treated</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="stat-item border-start-stat">
                                        <div class="stat-icon-box">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.12 2.12 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.12 2.12 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.12 2.12 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.12 2.12 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.12 2.12 0 0 0 1.597-1.16z"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="stat-number">98%</div>
                                            <div class="stat-label">Patient Satisfaction</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </template>
    </data>
</odoo>
