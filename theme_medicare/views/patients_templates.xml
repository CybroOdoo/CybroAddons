<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Templates for the patient portal and services information page. -->
    <data>
        <template id="patients_page" name="Patients Page">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <!-- PAGE HERO -->
                    <section class="page-hero">
                        <div class="container-fluid px-5">
                            <h1 class="page-hero-title">Patient Services</h1>
                            <nav class="breadcrumb-custom">
                                <a href="/">Home</a>
                                <span>›</span>
                                <span class="current">Patients</span>
                            </nav>
                        </div>
                    </section>

                    <!-- SERVICES GRID -->
                    <section class="section-pad">
                        <div class="container-fluid px-5">
                            <div class="text-center mb-5">
                                <div class="section-label mx-auto mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                    What We Offer
                                </div>
                                <h2 class="section-title">Everything You Need, Under One Roof</h2>
                                <p class="section-desc mx-auto">From your first appointment to discharge and beyond, our
                                    patient services team is with you every step of the way.
                                </p>
                            </div>

                            <div class="row g-3">
                                <!-- Patient Portal -->
                                <div class="col-md-4">
                                    <div class="service-info-card">
                                        <div class="service-info-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="18" height="18" x="3" y="3" rx="2"/>
                                                <path d="M3 9h18M9 21V9"/>
                                            </svg>
                                        </div>
                                        <h5>Patient Portal</h5>
                                        <p>Access your health records, lab results, appointment history, and communicate
                                            securely with your care team — anytime, anywhere via our online portal.
                                        </p>
                                    </div>
                                </div>
                                <!-- Insurance & Billing -->
                                <div class="col-md-4">
                                    <div class="service-info-card">
                                        <div class="service-info-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="20" height="14" x="2" y="5" rx="2"/>
                                                <line x1="2" x2="22" y1="10" y2="10"/>
                                            </svg>
                                        </div>
                                        <h5>Insurance &amp; Billing</h5>
                                        <p>We accept over 50 insurance plans. Our billing specialists verify coverage,
                                            handle claims, and offer flexible payment plans so finances never delay your
                                            care.
                                        </p>
                                    </div>
                                </div>
                                <!-- Medical Records -->
                                <div class="col-md-4">
                                    <div class="service-info-card">
                                        <div class="service-info-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                                <polyline points="14 2 14 8 20 8"/>
                                                <line x1="16" x2="8" y1="13" y2="13"/>
                                                <line x1="16" x2="8" y1="17" y2="17"/>
                                                <polyline points="10 9 9 9 8 9"/>
                                            </svg>
                                        </div>
                                        <h5>Medical Records</h5>
                                        <p>Request copies of your medical records, imaging reports, and referral letters
                                            within 24 hours. We support digital and printed formats for your
                                            convenience.
                                        </p>
                                    </div>
                                </div>
                                <!-- Pharmacy -->
                                <div class="col-md-4">
                                    <div class="service-info-card">
                                        <div class="service-info-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="m9 3-6 6h4l5-5-3-1z"/>
                                                <path d="m21 3-6 6h4l-5-5 7-1z"/>
                                                <path d="M5 12h14"/>
                                                <path d="M12 5v14"/>
                                            </svg>
                                        </div>
                                        <h5>Pharmacy</h5>
                                        <p>Our in-house pharmacy is open 7 days a week. Prescriptions are filled within
                                            minutes and home delivery is available for ongoing medications.
                                        </p>
                                    </div>
                                </div>
                                <!-- Telemedicine -->
                                <div class="col-md-4">
                                    <div class="service-info-card">
                                        <div class="service-info-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M15 10l4.553-2.069A1 1 0 0 1 21 8.845v6.31a1 1 0 0 1-1.447.894L15 14M5 18h8a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2z"/>
                                            </svg>
                                        </div>
                                        <h5>Telemedicine</h5>
                                        <p>Consult with our doctors from the comfort of your home via secure video
                                            appointments. Available for follow-ups, prescription refills, and
                                            non-emergency care.
                                        </p>
                                    </div>
                                </div>
                                <!-- Support Services -->
                                <div class="col-md-4">
                                    <div class="service-info-card">
                                        <div class="service-info-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                            </svg>
                                        </div>
                                        <h5>Support Services</h5>
                                        <p>Our social workers, chaplains, and patient advocates provide emotional,
                                            logistical, and spiritual support throughout your hospital journey.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- HOW TO PREPARE -->
                    <section class="section-pad prepare-section">
                        <div class="container-fluid px-5">
                            <div class="row g-4">

                                <!-- Left: heading + tip box -->
                                <div class="col-lg-4 pt-3">
                                    <div class="section-label mb-3">Preparation Guide</div>
                                    <h2 class="section-title mb-3">How to Prepare<br/>for Your Visit
                                    </h2>
                                    <p class="section-subtitle mb-4">Follow these simple steps to make your appointment
                                        as smooth and productive as possible.
                                    </p>
                                    <div class="prepare-tip-box">
                                        <div class="prepare-tip-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="M12 16v-4m0-4h.01"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <p class="prepare-tip-title">Pro Tip</p>
                                            <p class="prepare-tip-text">Bring a written list of your questions —
                                                patients who prepare questions get 40% more out of their consultations.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right: steps timeline -->
                                <div class="col-lg-8">
                                    <div class="prepare-timeline">

                                        <div class="prepare-step">
                                            <div class="prepare-step-left">
                                                <div class="prepare-step-num">01</div>
                                                <div class="prepare-step-line"></div>
                                            </div>
                                            <div class="prepare-step-card">
                                                <div class="prepare-step-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M8 2v4m8-4v4"/>
                                                        <rect width="18" height="18" x="3" y="4" rx="2"/>
                                                        <path d="M3 10h18M9 16l2 2 4-4"/>
                                                    </svg>
                                                </div>
                                                <div class="prepare-step-body">
                                                    <h5 class="prepare-step-title">Schedule &amp; Confirm</h5>
                                                    <p class="prepare-step-desc">Book your appointment online or call
                                                        our scheduling line. You'll receive a confirmation email with
                                                        your appointment details, location, and doctor's name.
                                                    </p>
                                                    <div class="prepare-step-tags">
                                                        <span class="prepare-tag">Online Booking</span>
                                                        <span class="prepare-tag">SMS Reminder</span>
                                                        <span class="prepare-tag">Email Confirmation</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="prepare-step">
                                            <div class="prepare-step-left">
                                                <div class="prepare-step-num">02</div>
                                                <div class="prepare-step-line"></div>
                                            </div>
                                            <div class="prepare-step-card">
                                                <div class="prepare-step-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                                        <path d="M14 2v6h6M16 13H8m8 4H8m2-8H8"/>
                                                    </svg>
                                                </div>
                                                <div class="prepare-step-body">
                                                    <h5 class="prepare-step-title">Gather Your Documents</h5>
                                                    <p class="prepare-step-desc">Bring a valid photo ID, insurance card,
                                                        list of current medications, and any previous test results or
                                                        referral letters relevant to your visit.
                                                    </p>
                                                    <div class="prepare-step-tags">
                                                        <span class="prepare-tag">Photo ID</span>
                                                        <span class="prepare-tag">Insurance Card</span>
                                                        <span class="prepare-tag">Medical Records</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="prepare-step prepare-step-last">
                                            <div class="prepare-step-left">
                                                <div class="prepare-step-num">03</div>
                                            </div>
                                            <div class="prepare-step-card">
                                                <div class="prepare-step-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                                                        <circle cx="12" cy="10" r="3"/>
                                                    </svg>
                                                </div>
                                                <div class="prepare-step-body">
                                                    <h5 class="prepare-step-title">Arrive &amp; Check In</h5>
                                                    <p class="prepare-step-desc">Arrive 15 minutes early for check-in.
                                                        Our reception team will guide you through registration, vitals,
                                                        and getting you settled in a comfortable waiting area.
                                                    </p>
                                                    <div class="prepare-step-tags">
                                                        <span class="prepare-tag">15 min Early</span>
                                                        <span class="prepare-tag">Valet Parking</span>
                                                        <span class="prepare-tag">Digital Check-in</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>

                    <!-- FAQ ACCORDION -->
                    <section class="section-pad">
                        <div class="container-fluid px-5">
                            <div class="row justify-content-center">
                                <div class="col-lg-8">
                                    <div class="text-center mb-5">
                                        <div class="section-label mx-auto mb-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                                                <path d="M12 17h.01"/>
                                            </svg>
                                            FAQ
                                        </div>
                                        <h2 class="section-title">Frequently Asked Questions</h2>
                                    </div>

                                    <div class="accordion" id="faqAccordion">
                                        <div class="accordion-item border mb-3"
                                             style="border-radius:12px;overflow:hidden;">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button fw-600" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#faq1"
                                                        style="font-weight:600;font-size:1rem;">
                                                    How do I book an appointment?
                                                </button>
                                            </h2>
                                            <div id="faq1" class="accordion-collapse collapse show"
                                                 data-bs-parent="#faqAccordion">
                                                <div class="accordion-body"
                                                     style="font-size:1rem;color:#6b7a96;line-height:1.7;">
                                                    You can book an appointment online through our website, call us at
                                                    1-800-MEDICARE, or walk in to any of our reception desks. Online
                                                    booking is available 24/7 and usually confirms within minutes.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="accordion-item border mb-3"
                                             style="border-radius:12px;overflow:hidden;">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed fw-600" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#faq2"
                                                        style="font-weight:600;font-size:1rem;">
                                                    What insurance plans do you accept?
                                                </button>
                                            </h2>
                                            <div id="faq2" class="accordion-collapse collapse"
                                                 data-bs-parent="#faqAccordion">
                                                <div class="accordion-body"
                                                     style="font-size:1rem;color:#6b7a96;line-height:1.7;">
                                                    We accept over 50 major insurance plans including Medicare,
                                                    Medicaid, Blue Cross Blue Shield, Aetna, Cigna, and United
                                                    Healthcare. Please call our billing team before your visit to
                                                    confirm your specific plan is accepted.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="accordion-item border mb-3"
                                             style="border-radius:12px;overflow:hidden;">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed fw-600" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#faq3"
                                                        style="font-weight:600;font-size:1rem;">
                                                    Can I access my test results online?
                                                </button>
                                            </h2>
                                            <div id="faq3" class="accordion-collapse collapse"
                                                 data-bs-parent="#faqAccordion">
                                                <div class="accordion-body"
                                                     style="font-size:1rem;color:#6b7a96;line-height:1.7;">
                                                    Yes. All lab results, imaging reports, and clinical notes are
                                                    available in the Patient Portal within 24–48 hours. You'll receive
                                                    an email notification as soon as your results are ready.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="accordion-item border mb-3"
                                             style="border-radius:12px;overflow:hidden;">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed fw-600" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#faq4"
                                                        style="font-weight:600;font-size:1rem;">
                                                    Is telemedicine available for new patients?
                                                </button>
                                            </h2>
                                            <div id="faq4" class="accordion-collapse collapse"
                                                 data-bs-parent="#faqAccordion">
                                                <div class="accordion-body"
                                                     style="font-size:1rem;color:#6b7a96;line-height:1.7;">
                                                    Telemedicine is available for both new and existing patients for
                                                    certain specialties. New patients may need an initial in-person
                                                    visit for conditions requiring physical examination. Our scheduling
                                                    team will advise you on the best option.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="accordion-item border" style="border-radius:12px;overflow:hidden;">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed fw-600" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#faq5"
                                                        style="font-weight:600;font-size:1rem;">
                                                    What should I do in a medical emergency?
                                                </button>
                                            </h2>
                                            <div id="faq5" class="accordion-collapse collapse"
                                                 data-bs-parent="#faqAccordion">
                                                <div class="accordion-body"
                                                     style="font-size:1rem;color:#6b7a96;line-height:1.7;">
                                                    For life-threatening emergencies, call 911 immediately. Our
                                                    Emergency Department is open 24/7 and accepts walk-ins. If you are a
                                                    stable patient with urgent but non-life-threatening symptoms, you
                                                    can visit our Urgent Care clinic which operates from 7 AM to 11 PM
                                                    daily.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>
    </data>
</odoo>
