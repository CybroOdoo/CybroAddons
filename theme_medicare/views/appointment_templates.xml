<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Templates for the appointment booking system and success page. -->
    <data>
        <template id="appointment_page" name="Appointment Page">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <!-- PAGE HERO -->
                    <section class="page-hero">
                        <div class="container-fluid px-5">
                            <h1 class="page-hero-title">Book an Appointment</h1>
                            <nav class="breadcrumb-custom">
                                <a href="/">Home</a>
                                <span>›</span>
                                <span class="current">Book Appointment</span>
                            </nav>
                        </div>
                    </section>

                    <!-- BOOKING SECTION -->
                    <section class="section-pad appt-page-section">
                        <div class="container-fluid px-5">
                            <div class="row g-4 align-items-start">

                                <!-- LEFT: Form -->
                                <div class="col-lg-8">
                                    <div class="appt-page-card">

                                        <!-- Step indicator -->
                                        <div class="appt-steps-bar mb-5">
                                            <div class="appt-step-indicator active">
                                                <div class="appt-step-circle">1</div>
                                                <span>Patient Info</span>
                                            </div>
                                            <div class="appt-step-connector"></div>
                                            <div class="appt-step-indicator">
                                                <div class="appt-step-circle">2</div>
                                                <span>Choose Doctor</span>
                                            </div>
                                            <div class="appt-step-connector"></div>
                                            <div class="appt-step-indicator">
                                                <div class="appt-step-circle">3</div>
                                                <span>Date &amp; Time</span>
                                            </div>
                                            <div class="appt-step-connector"></div>
                                            <div class="appt-step-indicator">
                                                <div class="appt-step-circle">4</div>
                                                <span>Confirm</span>
                                            </div>
                                        </div>

                                        <form action="/appointment/submit" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <!-- Section: Personal Details -->
                                            <div class="appt-form-section mb-4">
                                                <div class="appt-form-section-header">
                                                    <div class="appt-form-section-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                             stroke-width="2.5" stroke-linecap="round"
                                                             stroke-linejoin="round">
                                                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                                            <circle cx="12" cy="7" r="4"/>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <h5 class="appt-form-section-title">Personal Information</h5>
                                                        <p class="appt-form-section-sub">Tell us about yourself so we
                                                            can serve you better.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="row g-3 mt-1">
                                                    <div class="col-md-6">
                                                        <label class="appt-label">First Name
                                                            <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="text" name="first_name" class="appt-input"
                                                               placeholder="John" required="required"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Last Name
                                                            <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="text" name="last_name" class="appt-input"
                                                               placeholder="Smith" required="required"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Date of Birth
                                                            <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="date" name="dob" class="appt-input"
                                                               required="required"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Gender</label>
                                                        <select name="gender" class="appt-input">
                                                            <option value="">Select gender</option>
                                                            <option>Male</option>
                                                            <option>Female</option>
                                                            <option>Prefer not to say</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Phone Number
                                                            <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="tel" name="phone" class="appt-input"
                                                               placeholder="+1 (555) 000-0000" required="required"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Email Address
                                                            <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="email" name="email" class="appt-input"
                                                               placeholder="john@example.com" required="required"/>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Section: Appointment Details -->
                                            <div class="appt-form-section mb-4">
                                                <div class="appt-form-section-header">
                                                    <div class="appt-form-section-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                             stroke-width="2.5" stroke-linecap="round"
                                                             stroke-linejoin="round">
                                                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                                                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <h5 class="appt-form-section-title">Appointment Details</h5>
                                                        <p class="appt-form-section-sub">Select the department and your
                                                            preferred doctor.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="row g-3 mt-1">
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Department
                                                            <span class="text-danger">*</span>
                                                        </label>
                                                        <select name="department_id" class="appt-input"
                                                                required="required">
                                                            <option value="">Select department</option>
                                                            <t t-if="departments">
                                                                <t t-foreach="departments" t-as="dept">
                                                                    <option t-att-value="dept.id"
                                                                            t-att-selected="dept.id == selected_department_id"
                                                                            t-esc="dept.name"/>
                                                                </t>
                                                            </t>
                                                            <t t-else="">
                                                                <option value="1">Cardiology</option>
                                                                <option value="2">Neurology</option>
                                                                <option value="3">Orthopedics</option>
                                                            </t>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Preferred Doctor</label>
                                                        <select name="doctor_id" class="appt-input">
                                                            <option value="">No preference</option>
                                                            <t t-if="doctors">
                                                                <t t-foreach="doctors" t-as="doc">
                                                                    <option t-att-value="doc.id"
                                                                            t-att-selected="doc.id == selected_doctor_id"
                                                                            t-att-data-department-id="doc.department_id.id"
                                                                            t-esc="doc.name"/>
                                                                </t>
                                                            </t>
                                                            <t t-else="">
                                                                <option value="1">Dr. Raj Mehta — Cardiology</option>
                                                                <option value="2">Dr. Sarah Connors — Surgery</option>
                                                            </t>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Appointment Type
                                                            <span class="text-danger">*</span>
                                                        </label>
                                                        <select name="appointment_type" class="appt-input"
                                                                required="required">
                                                            <option value="">Select type</option>
                                                            <option>New Patient Consultation</option>
                                                            <option>Follow-up Visit</option>
                                                            <option>Routine Check-up</option>
                                                            <option>Specialist Referral</option>
                                                            <option>Second Opinion</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Visit Mode
                                                            <span class="text-danger">*</span>
                                                        </label>
                                                        <div class="d-flex flex-column flex-sm-row gap-2 mt-1">
                                                            <label class="appt-radio-card">
                                                                <input type="radio" name="visit_mode" value="in-person"
                                                                       checked="checked"/>
                                                                <div class="appt-radio-body">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                         height="16" viewBox="0 0 24 24" fill="none"
                                                                         stroke="currentColor" stroke-width="2.5"
                                                                         stroke-linecap="round" stroke-linejoin="round">
                                                                        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                                                                        <circle cx="12" cy="10" r="3"/>
                                                                    </svg>
                                                                    In-Person
                                                                </div>
                                                            </label>
                                                            <label class="appt-radio-card">
                                                                <input type="radio" name="visit_mode"
                                                                       value="telemedicine"/>
                                                                <div class="appt-radio-body">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                         height="16" viewBox="0 0 24 24" fill="none"
                                                                         stroke="currentColor" stroke-width="2.5"
                                                                         stroke-linecap="round" stroke-linejoin="round">
                                                                        <path d="m22 8-6 4 6 4V8z"/>
                                                                        <rect width="14" height="12" x="2" y="6"
                                                                              rx="2"/>
                                                                    </svg>
                                                                    Telemedicine
                                                                </div>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Section: Schedule -->
                                            <div class="appt-form-section mb-4">
                                                <div class="appt-form-section-header">
                                                    <div class="appt-form-section-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                             stroke-width="2.5" stroke-linecap="round"
                                                             stroke-linejoin="round">
                                                            <path d="M8 2v4m8-4v4"/>
                                                            <rect width="18" height="18" x="3" y="4" rx="2"/>
                                                            <path d="M3 10h18M9 16l2 2l4-4"/>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <h5 class="appt-form-section-title">Preferred Schedule</h5>
                                                        <p class="appt-form-section-sub">Choose your preferred date and
                                                            time slot.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="row g-3 mt-1">
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Preferred Date
                                                            <span class="text-danger">*</span>
                                                        </label>
                                                        <input type="date" name="date" class="appt-input"
                                                               t-att-min="time.strftime('%Y-%m-%d')"
                                                               required="required"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Preferred Time</label>
                                                        <select name="time" class="appt-input">
                                                            <option value="">Any Time</option>
                                                            <option>Morning (8AM - 12PM)</option>
                                                            <option>Afternoon (12PM - 4PM)</option>
                                                            <option>Evening (4PM - 8PM)</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Section: Medical Notes -->
                                            <div class="appt-form-section mb-5">
                                                <div class="appt-form-section-header">
                                                    <div class="appt-form-section-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                             stroke-width="2.5" stroke-linecap="round"
                                                             stroke-linejoin="round">
                                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <h5 class="appt-form-section-title">Medical Notes</h5>
                                                        <p class="appt-form-section-sub">Help us prepare by sharing
                                                            relevant health information.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="row g-3 mt-1">
                                                    <div class="col-12">
                                                        <label class="appt-label">Chief Complaint / Reason for Visit
                                                        </label>
                                                        <textarea name="chief_complaint" class="appt-input" rows="3"
                                                                  placeholder="Describe your symptoms, concerns, or reason for this appointment..."></textarea>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Insurance Provider</label>
                                                        <input type="text" name="insurance_provider" class="appt-input"
                                                               placeholder="e.g. Blue Cross, Aetna"/>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="appt-label">Insurance ID / Member Number</label>
                                                        <input type="text" name="insurance_id" class="appt-input"
                                                               placeholder="Policy / Member ID"/>
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="appt-label">Current Medications (optional)</label>
                                                        <input type="text" name="current_medications" class="appt-input"
                                                               placeholder="List any current medications separated by commas"/>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Submit -->
                                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                                <button type="submit" class="btn btn-primary-custom btn-appt-submit">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M8 2v4m8-4v4"/>
                                                        <rect width="18" height="18" x="3" y="4" rx="2"/>
                                                        <path d="M3 10h18M9 16l2 2l4-4"/>
                                                    </svg>
                                                    Confirm Appointment
                                                </button>
                                                <p class="appt-submit-note mb-0">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                         viewBox="0 0 24 24" fill="none" stroke="#10b981"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <rect width="18" height="11" x="3" y="11" rx="2"/>
                                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                                    </svg>
                                                    Your data is secure &amp; HIPAA compliant. We'll confirm within 2
                                                    hours.
                                                </p>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                                <!-- RIGHT: Sidebar -->
                                <div class="col-lg-4">

                                    <!-- Why book with us -->
                                    <div class="appt-sidebar-card mb-4">
                                        <h6 class="appt-sidebar-title">Why Book With Us?</h6>
                                        <ul class="appt-why-list">
                                            <li>
                                                <div class="appt-why-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                                        <path d="M22 4 12 14.01l-3-3"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <strong>Same-day availability</strong>
                                                    <p>Urgent slots available for same-day or next-day visits.</p>
                                                </div>
                                            </li>
                                            <li>
                                                <div class="appt-why-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <strong>HIPAA Compliant</strong>
                                                    <p>All your personal and medical data is fully encrypted and
                                                        secure.
                                                    </p>
                                                </div>
                                            </li>
                                            <li>
                                                <div class="appt-why-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M10.268 21a2 2 0 0 0 3.464 0m-10.47-5.674A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <strong>Instant confirmation</strong>
                                                    <p>Receive SMS &amp; email confirmation within 2 business hours.</p>
                                                </div>
                                            </li>
                                            <li>
                                                <div class="appt-why-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.5" stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="m22 8-6 4 6 4V8z"/>
                                                        <rect width="14" height="12" x="2" y="6" rx="2"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <strong>Telemedicine available</strong>
                                                    <p>Consult from home via secure video for eligible appointments.</p>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Contact card -->
                                    <div class="appt-sidebar-card appt-sidebar-emergency mb-4">
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            <div class="appt-emergency-icon">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                     viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M7 18v-6a5 5 0 1 1 10 0v6M5 21a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-1a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2zm16-9h1m-3.5-7.5L18 5M2 12h1m9-10v1M4.929 4.929l.707.707M12 12v6"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="appt-emergency-label">Life-threatening emergency?</div>
                                                <a href="tel:911" class="appt-emergency-number">Call 911 immediately</a>
                                            </div>
                                        </div>
                                        <p class="appt-emergency-note">Do not use this form for emergencies. Go directly
                                            to our ER or call 911.
                                        </p>
                                    </div>

                                    <!-- Doctors preview -->
                                    <div class="appt-sidebar-card">
                                        <h6 class="appt-sidebar-title">Featured Specialists</h6>
                                        <div class="d-flex flex-column gap-3 mt-3">
                                            <t t-if="doctors">
                                                <t t-foreach="doctors[:3]" t-as="doctor">
                                                    <div class="appt-doctor-row">
                                                        <img t-if="doctor.image"
                                                             t-attf-src="data:image/png;base64,{{doctor.image.decode('utf-8')}}"
                                                             t-att-alt="doctor.name" class="appt-doctor-avatar"/>
                                                        <img t-else=""
                                                             src="/theme_medicare/static/src/img/avatar-male-35-50-South-Asian-1.jpg"
                                                             t-att-alt="doctor.name" class="appt-doctor-avatar"/>
                                                        <div>
                                                            <div class="appt-doctor-name" t-esc="doctor.name"/>
                                                            <div class="appt-doctor-spec"
                                                                 t-esc="doctor.specialization or doctor.department_id.name or 'Specialist'"/>
                                                        </div>
                                                        <span class="appt-avail-badge ms-auto">Available</span>
                                                    </div>
                                                </t>
                                            </t>
                                        </div>
                                        <a href="/doctors" class="appt-view-all-doctors mt-3 d-block">
                                            View all doctors
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M5 12h14m-7-7 7 7-7 7"/>
                                            </svg>
                                        </a>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>

        <template id="appointment_success_page" name="Appointment Success">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="section-pad text-center"
                             style="min-height: 60vh; display: flex; align-items: center; justify-content: center;">
                        <div class="container">
                            <div style="max-width: 600px; margin: 0 auto; background: #fff; padding: 50px; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05);">
                                <div style="width: 80px; height: 80px; background: #E8F5E9; color: #4CAF50; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 30px;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                </div>
                                <h2 style="font-weight: 700; color: #1a2a40; margin-bottom: 15px;">Appointment
                                    Requested!
                                </h2>
                                <p style="color: #64748b; font-size: 1.1rem; margin-bottom: 30px;">Thank you for booking
                                    with Medicare. Your appointment request has been successfully submitted and stored
                                    securely. Our reception team will review your details and contact you shortly to
                                    confirm your exact time slot.
                                </p>
                                <a href="/" class="btn btn-primary-custom"
                                   style="padding: 12px 30px; font-weight: 600;">Return to Homepage
                                </a>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>
    </data>
</odoo>
