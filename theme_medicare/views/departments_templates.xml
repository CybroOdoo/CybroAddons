<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="departments_page" name="Departments Page">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <!-- PAGE HERO -->
    <section class="page-hero">
        <div class="container-fluid px-5">
            <h1 class="page-hero-title">Our Departments</h1>
            <nav class="breadcrumb-custom">
                <a href="/">Home</a>
                <span>›</span>
                <span class="current">Departments</span>
            </nav>
        </div>
    </section>

    <!-- INTRO + SEARCH -->
    <section class="section-pad">
        <div class="container-fluid px-5">
            <div class="row align-items-center mb-5 g-4">
                <div class="col-lg-7">
                    <div class="section-label mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        Specialties
                    </div>
                    <h2 class="section-title">Comprehensive Medical Specialties</h2>
                    <p class="section-desc" style="max-width: 700px;">We offer fully staffed departments covering major medical specialties, equipped with state-of-the-art technology.</p>
                </div>
                <div class="col-lg-5">
                    <div class="filter-bar">
                        <label class="form-label fw-600" style="font-size:.85rem;font-weight:600;margin-bottom:8px;">Search Departments</label>
                        <form action="/departments" method="GET" class="d-flex gap-2">
                            <input type="text" name="search" class="form-control-custom" placeholder="e.g. Cardiology, Neurology…" t-att-value="search" />
                            <button type="submit" class="btn btn-primary-custom d-flex align-items-center gap-2" style="white-space:nowrap;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                Search
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- SPECIALTY GRID -->
            <div class="row g-3">
                <t t-if="departments">
                    <t t-foreach="departments" t-as="dept">
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="specialty-card">
                                <div class="specialty-icon">
                                    <img t-if="dept.icon" t-attf-src="data:image/png;base64,{{dept.icon.decode('utf-8')}}" style="width:28px;height:28px;object-fit:contain;"/>
                                    <svg t-else="" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                </div>
                                <h5 class="specialty-name" t-esc="dept.name"/>
                                <p class="specialty-desc" t-esc="dept.description"/>
                                <a href="/doctors" class="specialty-link">Explore
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </a>
                            </div>
                        </div>
                    </t>
                </t>
                <t t-if="total_departments == 0">
                    <!-- Cardiology -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="specialty-card">
                            <div class="specialty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                            </div>
                            <h5 class="specialty-name">Cardiology</h5>
                            <p class="specialty-desc">Heart &amp; vascular conditions, interventional procedures, and cardiac rehabilitation.</p>
                            <a href="/doctors" class="specialty-link">Explore
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Neurology -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="specialty-card">
                            <div class="specialty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/></svg>
                            </div>
                            <h5 class="specialty-name">Neurology</h5>
                            <p class="specialty-desc">Brain, spine and nervous system disorders including stroke, epilepsy, and Parkinson's.</p>
                            <a href="/doctors" class="specialty-link">Explore
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Orthopedics -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="specialty-card">
                            <div class="specialty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/></svg>
                            </div>
                            <h5 class="specialty-name">Orthopedics</h5>
                            <p class="specialty-desc">Bone, joint, and musculoskeletal care including joint replacements and sports injuries.</p>
                            <a href="/doctors" class="specialty-link">Explore
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Oncology -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="specialty-card">
                            <div class="specialty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
                            </div>
                            <h5 class="specialty-name">Oncology</h5>
                            <p class="specialty-desc">Comprehensive cancer care with chemotherapy, radiation, and surgical oncology.</p>
                            <a href="/doctors" class="specialty-link">Explore
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Pediatrics -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="specialty-card">
                            <div class="specialty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h.01M15 12h.01M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/></svg>
                            </div>
                            <h5 class="specialty-name">Pediatrics</h5>
                            <p class="specialty-desc">Dedicated child health services from newborn through adolescence with family support.</p>
                            <a href="/doctors" class="specialty-link">Explore
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Radiology -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="specialty-card">
                            <div class="specialty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            </div>
                            <h5 class="specialty-name">Radiology</h5>
                            <p class="specialty-desc">Advanced imaging: MRI, CT, PET, ultrasound, and interventional radiology services.</p>
                            <a href="/doctors" class="specialty-link">Explore
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Emergency Medicine -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="specialty-card">
                            <div class="specialty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h6l2 9 2-6 2 6 2-9h6"/><line x1="12" x2="12" y1="18" y2="21"/><line x1="8" x2="16" y1="21" y2="21"/></svg>
                            </div>
                            <h5 class="specialty-name">Emergency Medicine</h5>
                            <p class="specialty-desc">24/7 trauma-ready emergency department staffed by board-certified emergency physicians.</p>
                            <a href="/doctors" class="specialty-link">Explore
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Ophthalmology -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="specialty-card">
                            <div class="specialty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            </div>
                            <h5 class="specialty-name">Ophthalmology</h5>
                            <p class="specialty-desc">Eye health services including cataract surgery, LASIK, and retinal disease management.</p>
                            <a href="/doctors" class="specialty-link">Explore
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>
                </t>
                <t t-elif="not departments">
                    <div class="col-12 text-center py-5">
                        <div class="mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6b7a96" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                        </div>
                        <h4 class="text-dark fw-bold">No departments found</h4>
                        <p class="text-muted">We couldn't find any departments matching your search.</p>
                        <a href="/departments" class="btn btn-primary-custom mt-2">Clear Search</a>
                    </div>
                </t>
            </div>
        </div>
    </section>
                </div>
            </t>
        </template>
    </data>
</odoo>
