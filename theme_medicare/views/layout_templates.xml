<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Core layout overrides, including custom header and footer for the Medicare theme. -->
    <data>
        <!-- Header Template Inheritance -->
        <template id="custom_header" inherit_id="website.layout" name="Custom Header">
            <xpath expr="//header" position="replace">
                <header id="top" data-anchor="true" data-name="Header" class="o_header_standard">
                    <!-- TOP BAR -->
                    <div class="topbar oe_structure">
                        <div class="container-fluid px-5">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex gap-4">
                                    <span class="topbar-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"/>
                                            <path d="M12 6v6l4 2"/>
                                        </svg>
                                        Mon – Sat: 8:00 AM – 8:00 PM
                                    </span>
                                    <span class="topbar-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        1200 Medical Center Drive, New York, NY 10001
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-4">
                                    <span class="topbar-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M7 18v-6a5 5 0 1 1 10 0v6M5 21a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-1a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2zm16-9h1m-3.5-7.5L18 5M2 12h1m9-10v1M4.929 4.929l.707.707M12 12v6"/>
                                        </svg>
                                        Emergency: 911
                                    </span>
                                    <div class="topbar-divider"></div>
                                    <span class="topbar-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384"/>
                                        </svg>
                                        1-800-MEDICARE
                                    </span>
                                    <div class="topbar-divider"></div>
                                    <a href="#" class="topbar-link">Patient Portal</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- NAVBAR -->
                    <nav data-name="Navbar" class="navbar navbar-expand-lg main-navbar sticky-top oe_structure">
                        <div class="container-fluid px-5">
                            <a class="navbar-brand logo" href="/">
                                <img src="/theme_medicare/static/src/img/logo.png" alt="MediCare Logo" height="55"/>
                            </a>
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#mainNav">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                            <div class="collapse navbar-collapse justify-content-center" id="mainNav">
                                <!-- Standard Odoo Menu -->
                                <ul class="navbar-nav gap-1" id="top_menu">
                                    <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                        <t t-call="website.submenu">
                                            <t t-set="item_class" t-value="'nav-item'"/>
                                            <t t-set="link_class" t-value="'nav-link nav-link-custom'"/>
                                        </t>
                                    </t>
                                </ul>
                            </div>
                            <a href="/appointment" class="btn btn-primary-custom ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M8 2v4m8-4v4"/>
                                    <rect width="18" height="18" x="3" y="4" rx="2"/>
                                    <path d="M3 10h18M9 16l2 2l4-4"/>
                                </svg>
                                Book Appointment
                            </a>
                        </div>
                    </nav>
                </header>
            </xpath>

            <xpath expr="//footer" position="replace">
                <footer class="site-footer oe_structure" id="bottom" data-anchor="true">
                    <div class="container-fluid px-5">
                        <div class="row g-4 pb-5 border-bottom border-footer">
                            <div class="col-12 col-lg-4">
                                <img src="/theme_medicare/static/src/img/logo.png" alt="MediCare" height="48"
                                     class="mb-4 footer-logo"/>
                                <p class="footer-desc">Providing world-class healthcare with compassion and expertise
                                    since 1974. Your health is our highest priority.
                                </p>
                                <div class="d-flex gap-2 mt-4">
                                    <a href="#" class="footer-social">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                                        </svg>
                                    </a>
                                    <a href="#" class="footer-social">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
                                        </svg>
                                    </a>
                                    <a href="#" class="footer-social">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="20" height="20" x="2" y="2" rx="5"/>
                                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                                        </svg>
                                    </a>
                                    <a href="#" class="footer-social">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                                            <rect width="4" height="12" x="2" y="9"/>
                                            <circle cx="4" cy="4" r="2"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <h6 class="footer-heading">Hospital</h6>
                                <ul class="footer-links">
                                    <li>
                                        <a href="/about">About Us</a>
                                    </li>
                                    <li>
                                        <a href="#">Leadership</a>
                                    </li>
                                    <li>
                                        <a href="#">Accreditations</a>
                                    </li>
                                    <li>
                                        <a href="#">News &amp; Events</a>
                                    </li>
                                    <li>
                                        <a href="#">Careers</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <h6 class="footer-heading">Patient Care</h6>
                                <ul class="footer-links">
                                    <li>
                                        <a href="/doctors">Find a Doctor</a>
                                    </li>
                                    <li>
                                        <a href="/departments">Departments</a>
                                    </li>
                                    <li>
                                        <a href="/appointment">Book Appointment</a>
                                    </li>
                                    <li>
                                        <a href="#">Patient Portal</a>
                                    </li>
                                    <li>
                                        <a href="#">Insurance</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <h6 class="footer-heading">Services</h6>
                                <ul class="footer-links">
                                    <li>
                                        <a href="#">Emergency Care</a>
                                    </li>
                                    <li>
                                        <a href="#">Surgery</a>
                                    </li>
                                    <li>
                                        <a href="#">Diagnostics</a>
                                    </li>
                                    <li>
                                        <a href="#">Pharmacy</a>
                                    </li>
                                    <li>
                                        <a href="#">Telemedicine</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <h6 class="footer-heading">Contact</h6>
                                <ul class="footer-links">
                                    <li>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384"/>
                                        </svg>
                                        1-800-MEDICARE
                                    </li>
                                    <li>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m22 7l-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/>
                                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                                        </svg>
                                        <p style="overflow-wrap: anywhere;">info@medicare.com</p>
                                    </li>
                                    <li>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        1200 Medical Center Dr, NY
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="footer-bottom">
                            <span>© 2026 MediCare Hospital. All rights reserved.</span>
                            <div class="d-flex gap-4">
                                <a href="#">Privacy Policy</a>
                                <a href="#">Terms of Use</a>
                                <a href="#">Sitemap</a>
                            </div>
                        </div>
                    </div>
                </footer>
            </xpath>
        </template>
    </data>
</odoo>
