<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration options and styles for Medicare website snippets. -->
    <data>
        <template id="theme_medicare_snippet_options" inherit_id="website.snippet_options">
            <xpath expr="." position="inside">
                <!-- Hero Options -->
                <div data-js="medicare_hero" data-selector=".s_medicare_hero">
                    <we-select string="Hero Style">
                        <we-button data-select-class="">Default</we-button>
                        <we-button data-select-class="hero-style-light">Light Version</we-button>
                        <we-button data-select-class="hero-style-dark">Dark Version</we-button>
                    </we-select>
                    <we-checkbox string="Show Stats Strip" data-select-class="show-stats" data-no-preview="true"/>
                </div>

                <!-- Departments Options -->
                <div data-js="medicare_departments" data-selector=".s_medicare_departments">
                    <we-select string="Card Layout">
                        <we-button data-select-class="">Default Grid</we-button>
                        <we-button data-select-class="departments-list">List Layout</we-button>
                    </we-select>
                    <we-checkbox string="Add Shadow" data-select-class="shadow-sm"/>
                </div>

                <!-- Global Section Options -->
                <div data-js="medicare_section"
                     data-selector=".s_medicare_hero, .s_medicare_departments, .s_medicare_doctors, .s_medicare_appointment, .s_medicare_emergency">
                    <we-select string="Section Spacing">
                        <we-button data-select-class="">Default</we-button>
                        <we-button data-select-class="py-4">Compact</we-button>
                        <we-button data-select-class="py-6">Spacious</we-button>
                    </we-select>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
