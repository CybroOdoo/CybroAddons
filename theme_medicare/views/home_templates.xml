<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="theme_medicare_homepage" inherit_id="website.homepage" name="Medicare Homepage">
            <xpath expr="//div[@id='wrap']" position="replace">
                <div id="wrap">
                    <div class="oe_structure oe_empty o_editable">
                        <t t-call="theme_medicare.s_medicare_hero"/>
                        <t t-call="theme_medicare.s_medicare_patient_services"/>
                        <t t-call="theme_medicare.s_medicare_mission"/>
                        <t t-call="theme_medicare.s_medicare_departments"/>
                        <t t-call="theme_medicare.s_medicare_doctors"/>
                        <t t-call="theme_medicare.s_medicare_appointment"/>
                        <t t-call="theme_medicare.s_medicare_emergency"/>
                        <t t-call="theme_medicare.s_medicare_testimonials"/>
                        <t t-call="theme_medicare.s_medicare_articles"/>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>