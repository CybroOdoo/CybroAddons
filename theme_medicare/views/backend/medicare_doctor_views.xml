<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Doctor Form View -->
        <record id="view_medicare_doctor_form" model="ir.ui.view">
            <field name="name">medicare.doctor.form</field>
            <field name="model">medicare.doctor</field>
            <field name="arch" type="xml">
                <form string="Doctor">
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Doctor's Name..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="specialization"/>
                                <field name="department_id"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Biography">
                                <field name="biography" widget="html"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Doctor Tree View -->
        <record id="view_medicare_doctor_list" model="ir.ui.view">
            <field name="name">medicare.doctor.list</field>
            <field name="model">medicare.doctor</field>
            <field name="arch" type="xml">
                <tree string="Doctors">
                    <field name="name"/>
                    <field name="specialization"/>
                    <field name="department_id"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Doctor Action -->
        <record id="action_medicare_doctor" model="ir.actions.act_window">
            <field name="name">Doctors</field>
            <field name="res_model">medicare.doctor</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create your first doctor profile!
              </p>
            </field>
        </record>
    </data>
</odoo>
