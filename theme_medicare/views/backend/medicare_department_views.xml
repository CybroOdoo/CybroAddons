<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backend form and tree views for managing department records. -->
    <data>
        <!-- Department Form View -->
        <record id="view_medicare_department_form" model="ir.ui.view">
            <field name="name">medicare.department.form</field>
            <field name="model">medicare.department</field>
            <field name="arch" type="xml">
                <form string="Department">
                    <sheet>
                        <field name="icon" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Department Name..."/>
                            </h1>
                        </div>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" widget="html"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Department Tree View -->
        <record id="view_medicare_department_list" model="ir.ui.view">
            <field name="name">medicare.department.list</field>
            <field name="model">medicare.department</field>
            <field name="arch" type="xml">
                <list string="Departments">
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Department Action -->
        <record id="action_medicare_department" model="ir.actions.act_window">
            <field name="name">Departments</field>
            <field name="res_model">medicare.department</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new department!
              </p>
            </field>
        </record>
    </data>
</odoo>
