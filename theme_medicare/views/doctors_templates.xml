<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="doctors_page" name="Doctors Page">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <!-- PAGE HERO -->
    <section class="page-hero">
        <div class="container-fluid px-5">
            <h1 class="page-hero-title">Our Doctors</h1>
            <nav class="breadcrumb-custom">
                <a href="/">Home</a>
                <span>›</span>
                <span class="current">Doctors</span>
            </nav>
        </div>
    </section>

    <!-- FILTER BAR + DOCTORS GRID -->
    <section class="section-pad">
        <div class="container-fluid px-5">
            <!-- Filters -->
            <div class="filter-bar mb-5">
                <form action="/doctors" method="GET">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label" style="font-size:.95rem;font-weight:600;margin-bottom:6px;">Department</label>
                            <select name="department_id" class="form-control-custom" onchange="this.form.submit()">
                                <option value="">All Departments</option>
                                <t t-foreach="departments" t-as="dept">
                                    <option t-att-value="dept.id" t-att-selected="str(dept.id) == str(department_id)"><t t-esc="dept.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label" style="font-size:.95rem;font-weight:600;margin-bottom:6px;">Search by Name</label>
                            <div class="d-flex gap-2">
                                <input type="text" name="search" class="form-control-custom" placeholder="Doctor's name…" t-att-value="search" />
                                <button type="submit" class="btn btn-primary-custom d-flex align-items-center gap-2" style="padding:10px 18px;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                    Search
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Doctor Cards -->
            <div class="row g-3">
                <t t-if="total_doctors == 0">
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="doctor-card">
                            <div class="doctor-img-wrap">
                                <img src="/theme_medicare/static/src/img/avatar-male-35-50-South-Asian-1.jpg" alt="Dr. Raj Mehta" />
                            </div>
                            <div class="doctor-info">
                                <div class="doctor-spec">Cardiology</div>
                                <h5 class="doctor-name">Dr. Raj Mehta</h5>
                                <p class="doctor-exp">22 years experience</p>
                                <a href="/appointment" class="btn btn-primary-custom w-100 mt-2" style="font-size:.95rem;padding:10px 18px; width: max-content !important;">Book Appointment</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="doctor-card">
                            <div class="doctor-img-wrap">
                                <img src="/theme_medicare/static/src/img/avatar-female-35-50-North-American-4.jpg" alt="Dr. Sarah Connors" />
                            </div>
                            <div class="doctor-info">
                                <div class="doctor-spec">General Surgery</div>
                                <h5 class="doctor-name">Dr. Sarah Connors</h5>
                                <p class="doctor-exp">18 years experience</p>
                                <a href="/appointment" class="btn btn-primary-custom w-100 mt-2" style="font-size:.95rem;padding:10px 18px; width: max-content !important;">Book Appointment</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="doctor-card">
                            <div class="doctor-img-wrap">
                                <img src="/theme_medicare/static/src/img/avatar-female-35-50-East-Asian-2.jpg" alt="Dr. Mei Lin" />
                            </div>
                            <div class="doctor-info">
                                <div class="doctor-spec">Neurology</div>
                                <h5 class="doctor-name">Dr. Mei Lin</h5>
                                <p class="doctor-exp">14 years experience</p>
                                <a href="/appointment" class="btn btn-primary-custom w-100 mt-2" style="font-size:.95rem;padding:10px 18px; width: max-content !important;">Book Appointment</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="doctor-card">
                            <div class="doctor-img-wrap">
                                <img src="/theme_medicare/static/src/img/avatar-male-35-50-African-3.jpg" alt="Dr. Samuel Osei" />
                            </div>
                            <div class="doctor-info">
                                <div class="doctor-spec">Oncology</div>
                                <h5 class="doctor-name">Dr. Samuel Osei</h5>
                                <p class="doctor-exp">15 years experience</p>
                                <a href="/appointment" class="btn btn-primary-custom w-100 mt-2" style="font-size:.95rem;padding:10px 18px; width: max-content !important;">Book Appointment</a>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-elif="not doctors">
                    <div class="col-12 text-center py-5">
                        <div class="mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6b7a96" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        </div>
                        <h4 class="text-dark fw-bold">No doctors found</h4>
                        <p class="text-muted">We couldn't find any doctors matching your search criteria.</p>
                        <a href="/doctors" class="btn btn-primary-custom mt-2">Clear Filters</a>
                    </div>
                </t>
                <t t-else="">
                    <t t-foreach="doctors" t-as="doctor">
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="doctor-card">
                                <div class="doctor-img-wrap">
                                    <img t-if="doctor.image" t-attf-src="data:image/png;base64,{{doctor.image.decode('utf-8')}}" t-att-alt="doctor.name" />
                                    <img t-else="" src="/theme_medicare/static/src/img/avatar-male-35-50-South-Asian-1.jpg" t-att-alt="doctor.name" />
                                </div>
                                <div class="doctor-info">
                                    <div class="doctor-spec" t-esc="doctor.department_id.name if doctor.department_id else doctor.specialization"/>
                                    <h5 class="doctor-name" t-esc="doctor.name"/>
                                    <p class="doctor-exp" t-esc="doctor.specialization"/>
                                    <a t-attf-href="/appointment?doctor_id=#{doctor.id}" class="btn btn-primary-custom w-100 mt-2" style="font-size:.95rem;padding:10px 18px; width: max-content !important;">Book Appointment</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>

            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-center mt-5" t-if="pager.get('page_count', 1) > 1">
                <nav class="custom-pagination">
                    <a t-att-href="pager['page_previous']['url'] if pager['page']['num'] != 1 else '#'"
                       t-attf-class="page-btn page-btn-nav #{'disabled' if pager['page']['num'] == 1 else ''}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    </a>

                    <t t-foreach="pager['pages']" t-as="p">
                        <a t-att-href="p['url']" t-attf-class="page-btn #{'active' if p['num'] == pager['page']['num'] else ''}">
                            <t t-esc="p['num']"/>
                        </a>
                    </t>

                    <a t-att-href="pager['page_next']['url'] if pager['page']['num'] != pager['page_count'] else '#'"
                       t-attf-class="page-btn page-btn-nav #{'disabled' if pager['page']['num'] == pager['page_count'] else ''}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                </nav>
            </div>
        </div>
    </section>
                </div>
            </t>
        </template>
    </data>
</odoo>
