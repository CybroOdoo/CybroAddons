<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- This view was inherited to replace pos_categ_id field with pos_categ_ids -->
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.multi.pos.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_categ_id']" position="replace">
                <field name="pos_categ_ids" widget="many2many_tags" string="Pos Categories"/>
                <field name="pos_categ_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>