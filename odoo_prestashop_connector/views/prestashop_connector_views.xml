<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Action window -->
    <record id="prestashop_connector_action" model="ir.actions.act_window">
        <field name="name">Prestashop Connector</field>
        <field name="res_model">prestashop.connector</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record!
            </p>
        </field>
    </record>
    <!-- Tree View -->
    <record id="prestashop_connector_view_tree" model="ir.ui.view">
        <field name="name">prestashop.connector.view.tree</field>
        <field name="model">prestashop.connector</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="api_url"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'not_connected'"
                       decoration-success="state == 'connected'"/>

            </tree>
        </field>
    </record>
    <!-- Form View -->
    <record id="prestashop_connector_view_form" model="ir.ui.view">
        <field name="name">prestashop.connector.view.form</field>
        <field name="model">prestashop.connector</field>
        <field name="arch" type="xml">
            <form string="Prestashop Connector">
                <header>
                    <button name="action_connect" class="btn btn-primary"
                            string="Connect" type="object" invisible="state == 'connected'">

                    </button>
                    <field name="state" widget="statusbar"
                           statusbar_visible="not_connected,connected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Shop 1"/>
                        </h1>
                    </div>
                    <group string="INSTANCE DETAILS">
                        <field name="api_url"/>
                        <field name="api_key" password="True"/>
                    </group>
                    <notebook>
                        <page string="Products">
                            <group>
                                <group>
                                    <field name="import_products_button"/>
                                    <br/>
                                    <button string="Import Products"
                                            class="btn btn-primary"
                                            name="action_import_products"
                                            type="object"
                                            invisible="import_products_button == False">
                                        <i class="fa fa-fw o_button_icon fa-lg fa-refresh"/>
                                        Import Products
                                    </button>
                                </group>
                                <group>
                                    <field name="export_products_button"/>
                                    <br/>
                                    <button string="Export Products"
                                            class="btn btn-primary"
                                            name="action_export_products"
                                            type="object"
                                            invisible="export_products_button == False">
                                        <i class="fa fa-fw o_button_icon fa-lg fa-refresh"/>
                                        Export Products
                                    </button>
                                </group>
                            </group>
                        </page>
                        <page string="Contacts">
                            <group>
                                <group>
                                    <field name="import_contacts_button"/>
                                    <br/>
                                    <button string="Import Contacts"
                                            class="btn btn-primary"
                                            name="action_import_contacts"
                                            type="object"
                                            invisible="import_contacts_button == False">
                                        <i class="fa fa-fw o_button_icon fa-lg fa-refresh"/>
                                        Import Contacts
                                    </button>
                                </group>
                                <group>
                                    <field name="export_contacts_button"/>
                                    <br/>
                                    <button string="Export Contacts"
                                            class="btn btn-primary"
                                            name="action_export_contacts"
                                            type="object"
                                            invisible="export_contacts_button == False">
                                        <i class="fa fa-fw o_button_icon fa-lg fa-refresh"/>
                                        Export Contacts
                                    </button>
                                </group>
                            </group>
                        </page>
                        <page string="Orders">
                            <group>
                                <group>
                                    <field name="import_orders_button"/>
                                    <br/>
                                    <button string="Import Orders"
                                            class="btn btn-primary"
                                            name="action_import_orders"
                                            type="object"
                                            invisible="import_orders_button == False">
                                        <i class="fa fa-fw o_button_icon fa-lg fa-refresh"/>
                                        Import Orders
                                    </button>
                                </group>
                                <group>
                                    <field name="export_orders_button"/>
                                    <br/>
                                    <button string="Export Orders"
                                            class="btn btn-primary"
                                            name="action_export_orders"
                                            type="object"
                                            invisible="export_orders_button == False">
                                        <i class="fa fa-fw o_button_icon fa-lg fa-refresh"/>
                                        Export Orders
                                    </button>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
