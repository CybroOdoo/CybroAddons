<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Defines a QWeb text report action for generating ZPL output-->
    <record id="action_report_zpl_label_instance" model="ir.actions.report">
        <field name="name">ZPL Label</field>
        <field name="model">zpl.label.template</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">advanced_zpl_label_designer_print.report_zpl_view</field>
        <field name="report_file">advanced_zpl_label_designer_print.report_zpl_view</field>
        <field name="binding_model_id" ref="model_zpl_label_template"/>
        <field name="binding_type">report</field>
    </record>
    <!--Template for zpl label-->
    <template id="report_zpl_view">
        <t t-foreach="docs" t-as="doc">
            <t t-out="doc.zpl_content"/>
        </t>
    </template>
</odoo>
