<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--zpl.label.element list view -->
    <record id="view_zpl_label_element_tree" model="ir.ui.view">
        <field name="name">zpl.label.element.tree</field>
        <field name="model">zpl.label.element</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type"/>
                <field name="x_pos"/>
                <field name="y_pos"/>
                <field name="width"/>
                <field name="height"/>
                <field name="thickness"/>
                <field name="rounding"/>
                <field name="field_id"/>
                <field name="data_format"/>
            </list>
        </field>
    </record>
     <!--zpl.label.element form view -->
    <record id="view_zpl_label_element_form" model="ir.ui.view">
        <field name="name">zpl.label.element.form</field>
        <field name="model">zpl.label.element</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="sequence"/>
                        </group>
                        <group name="pos" string="Position &amp; Size">
                            <field name="x_pos"/>
                            <field name="y_pos"/>
                            <field name="width" invisible="type not in ['image', 'rect', 'line']"/>
                            <field name="height" invisible="type not in ['image', 'rect', 'line']"/>
                            <field name="thickness" invisible="type != 'rect'"/>
                            <field name="rounding" invisible="type != 'rect'"/>
                        </group>
                    </group>
                    <group string="Content &amp; Formatting">
                        <group>
                            <field name="model_id" invisible="1"/>
                            <field name="field_id" options="{'no_create': True}"/>
                            <field name="data_format" placeholder="e.g. Price: {{price}}"/>
                        </group>
                        <group>
                            <field name="font_size" invisible="type not in ['text', 'barcode', 'qrcode']"/>
                            <field name="rotation"/>
                            <field name="barcode_type" invisible="type != 'barcode'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
