<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherits the product label layout form view to add ZPL template field for the advanced ZPL label designer print -->
    <record id="product_label_layout_view_zpl_inherit" model="ir.ui.view">
        <field name="name">product.label.layout.view.zpl.inherit</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='print_format']" position="after">
                <field name="zpl_template_id"
                       options="{'no_create': True}"
                       invisible="print_format != 'zpl_label_designer'"
                       required="print_format == 'zpl_label_designer'"
                       domain="[('model_id.model', 'in', ['product.template', 'product.product'])]"/>
            </xpath>
        </field>
    </record>
</odoo>