<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Inherit product label layout -->
    <record id="product_label_layout_view_zpl_inherit" model="ir.ui.view">
        <field name="name">product.label.layout.view.zpl.inherit</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='print_format']" position="after">
                <field name="zpl_template_id"
                       options="{'no_create': True}"
                       invisible="print_format != 'advanced_zpl_label_designer_print'"
                       required="print_format == 'advanced_zpl_label_designer_print'"/>
            </xpath>
        </field>
    </record>
</odoo>
