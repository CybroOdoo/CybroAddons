<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Kitchen printer views records-->
    <record id="view_pos_kitchen_printer_form" model="ir.ui.view">
        <field name="name">pos.kitchen.printer.form</field>
        <field name="model">pos.kitchen.printer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="allowed_pos_category_ids" invisible="1"/>
                        <field name="name"/>
                        <field name="printer_id" options="{'no_create': True}"/>
                        <field name="pos_config_ids" widget="many2many_tags" required="1" domain="[('module_pos_restaurant', '=', True)]"/>
                        <field name="category_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_kitchen_printer_list" model="ir.ui.view">
        <field name="name">pos.kitchen.printer.list</field>
        <field name="model">pos.kitchen.printer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="printer_id"/>
            </list>
        </field>
    </record>

    <record id="action_pos_kitchen_printer" model="ir.actions.act_window">
        <field name="name">Kitchen Printers</field>
        <field name="res_model">pos.kitchen.printer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
