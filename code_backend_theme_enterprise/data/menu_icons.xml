<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Apply the theme icons to the root menus. A <function> outside a
        noupdate block runs on install and on every upgrade of this module,
        unlike the init hooks which only run on install.
    -->
    <function model="ir.ui.menu" name="_cbt_apply_theme_icons"/>
</odoo>
