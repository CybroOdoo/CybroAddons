<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="theme_perfume_snippets" inherit_id="website.snippets"
              name="theme eco food">
        <!--Added all the created perfume theme snippet to website at specific area inheriting website.snippets-->
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
             <t snippet-group="perfume_about" t-snippet="cts_theme_perfume.s_perfume_about"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/about-block.jpg"/>
            <t snippet-group="s_perfume_banner" t-snippet="cts_theme_perfume.s_perfume_banner"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/banner-block.jpg"/>
            <t snippet-group="s_perfume_images" t-snippet="cts_theme_perfume.s_perfume_images"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/gallery-block.jpg"/>
            <t snippet-group="s_perfume_show" t-snippet="cts_theme_perfume.s_perfume_show"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/perfume-items-block.jpg"/>
            <t snippet-group="s_perfume_video" t-snippet="cts_theme_perfume.s_perfume_video"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/video-block.jpg"/>
            <t snippet-group="s_perfume_shop_method" t-snippet="cts_theme_perfume.s_perfume_shop_method"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/shop-method.jpg"/>
        </xpath>
          <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="cts_theme_perfume.s_perfume_about" string="New Arrivals" group="perfume_about"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/about-block.jpg"/>
                 <t t-snippet="cts_theme_perfume.s_perfume_banner" group="s_perfume_banner"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/banner-block.jpg"/>
            <t t-snippet="cts_theme_perfume.s_perfume_images" group="s_perfume_images"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/gallery-block.jpg"/>
            <t t-snippet="cts_theme_perfume.s_perfume_show" group="s_perfume_show"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/perfume-items-block.jpg"/>
            <t t-snippet="cts_theme_perfume.s_perfume_video" group="s_perfume_video"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/video-block.jpg"/>
            <t t-snippet="cts_theme_perfume.s_perfume_shop_method" group="s_perfume_shop_method"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/shop-method.jpg"/>
        </xpath>    </template>
</odoo>