<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Added Arrival snippet in website snippet section-->
    <template id="new_arrival" inherit_id="website.snippets" name="New Arrivals">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="cts_new_arrival" t-snippet="cts_theme_perfume.cts_new_arrival"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/new-arrivals-block.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="cts_theme_perfume.cts_new_arrival" string="New Arrivals" group="cts_new_arrival"
               t-thumbnail="/cts_theme_perfume/static/src/img/snippets/new-arrivals-block.jpg"/>
        </xpath>
    </template>
    <!--    Snippet for newly arrival products-->
    <template id="cts_new_arrival" name="Arrival Snippet">
        <section class="oe_structure">
            <div class="banner_added cts-new-arrivals">
                <div class="dynamic-snippet-content oe_structure">
                    <div class="alert alert-info">
                        <h4>Your product Arrival snippet will be displayed here...
                            Please Save to view the snippet
                        </h4>
                    </div>
                </div>
                <hr/>
                 <div class="new_arrival_dynamic_section"/>
            </div>
        </section>
        <div class="oe_structure"/>
    </template>
</odoo>