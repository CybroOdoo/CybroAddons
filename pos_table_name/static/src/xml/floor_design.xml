<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_table_name.FloorDesign" t-inherit="pos_restaurant.floor_screen_element" t-inherit-mode="extension">
        <!-- Optimized Alias Presentation -->
        <xpath expr="//div[hasclass('o_fp_table_number')]" position="replace">
            <div class="o_fp_table_number label fs-4 fw-bolder" t-att-class="{'opacity-50': element.parent_id}" t-att-style="tableContentStyle">
                <span class="alias-designation">
                    <t t-out="element.record.table_alias || element.table_number"/>
                </span>
            </div>
        </xpath>
    </t>

    <t t-name="pos_table_name.EditTableProperties" t-inherit="pos_restaurant.floor_editor.edit_table_properties" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('mb-2') and contains(text(), 'Table Number')]" position="before">
            <div class="fs-4 fw-bold mb-2 mt-3">Table Name (Alias)</div>
            <input type="text" class="form-control form-control-lg" t-att-value="this.table.table_alias || ''" t-on-change="this.updateTableAlias"/>
        </xpath>
    </t>
</templates>


