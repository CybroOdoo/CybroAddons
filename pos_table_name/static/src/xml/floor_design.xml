<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_table_name.FloorDesign" t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <!-- Optimized Alias Presentation -->
        <xpath expr="//div[@class='label fw-bolder fs-4 position-absolute top-50 start-50 translate-middle']"
               position="replace">
            <div class="label fw-bolder fs-4 position-absolute top-50 start-50 translate-middle">
                <span class="alias-designation">
                    <t t-esc="table.table_alias || table.table_number"/>
                </span>
            </div>
        </xpath>

        <!-- Dynamic Control Bar Update -->
        <xpath expr="//span[contains(@class, 'mx-2') and contains(@class, 'align-self-center')]"
               position="replace">
            <span t-if="!ui.isSmall"
                  class="mx-2 align-self-center text-uppercase smaller fw-bolder">
                <i class="fa fa-bookmark-o me-1"/>
                <t t-esc="firstSelectedTable.table_alias || firstSelectedTable.table_number"/>
            </span>
        </xpath>
    </t>
</templates>
