<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_table_name.FloorScreen" t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('info')]/div[hasclass('label')]" position="replace">
            <div class="label fw-bolder fs-4 position-absolute top-50 start-50 translate-middle">
                <t t-esc="table.getName()"/>
            </div>
        </xpath>

        <xpath expr="//span[contains(@class, 'mx-2') and contains(@class, 'align-self-center')]" position="replace">
            <span t-if="!ui.isSmall" class="mx-2 align-self-center text-uppercase smaller fw-bolder">
                Table <t t-esc="firstSelectedTable.getName()"/>
            </span>
        </xpath>
    </t>
</templates>
