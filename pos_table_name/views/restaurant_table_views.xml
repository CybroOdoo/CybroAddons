<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherits the restaurant table form view to append the alphanumeric table alias field and make table number read-only -->
    <record id="view_restaurant_table_form_inherit" model="ir.ui.view">
        <field name="name">restaurant.table.form.inherit.pos_custom_alias</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_table_form"/>
        <field name="arch" type="xml">
            <field name="table_number" position="after">
            <field name="table_alias" placeholder="Optional Alphanumeric Alias"/>
            </field>
            <field name="table_number" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>

    <!-- Inherits the restaurant floor form view to insert the table alias column in the inline table sub-list and set the table number to read-only -->
    <record id="view_restaurant_floor_form_inherit" model="ir.ui.view">
        <field name="name">restaurant.floor.form.inherit.pos_custom_alias</field>
        <field name="model">restaurant.floor</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_floor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='table_ids']/list/field[@name='table_number']" position="after">
                <field name="table_alias" string="Table Name"/>
            </xpath>
            <xpath expr="//field[@name='table_ids']/list/field[@name='table_number']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
