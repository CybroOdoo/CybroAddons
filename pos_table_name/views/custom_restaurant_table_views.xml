<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Restaurant Table Form View -->
    <record id="view_restaurant_table_form_inherit" model="ir.ui.view">
        <field name="name">restaurant.table.form.inherit.pos.table.name</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_table_form"/>
        <field name="arch" type="xml">
            <field name="table_number" position="after">
                <field name="custom_table_name"
                       placeholder="e.g., A1, VIP-1, Table 101"/>
            </field>
            <field name="table_number" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>

    <record id="view_restaurant_floor_form_inherit" model="ir.ui.view">
        <field name="name">restaurant.floor.form.inherit.pos.table.name</field>
        <field name="model">restaurant.floor</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_floor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='table_ids']/list/field[@name='table_number']" position="after">
                <field name="custom_table_name" placeholder="e.g., A1, VIP-1"/>
            </xpath>
            <xpath expr="//field[@name='table_ids']/list/field[@name='table_number']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
