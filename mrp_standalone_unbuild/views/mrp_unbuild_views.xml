<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_unbuild_form_view" model="ir.ui.view">
        <field name="name">mrp.unbuild.view.form.inherit.mrp.standalone.unbuild</field>
        <field name="model">mrp.unbuild</field>
        <field name="inherit_id" ref="mrp.mrp_unbuild_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mo_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='mo_id']" position="before">
                <p class="text-muted mb-2" colspan="2" invisible="mo_id">
                    Manufacturing Order is optional.
                </p>
            </xpath>
            <xpath expr="//field[@name='mo_id']" position="after">
                <field name="allowed_lot_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="domain">[('product_id', '=', product_id), ('id', 'in', allowed_lot_ids)]</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Components" name="components" invisible="mo_id">
                        <field name="unbuild_line_ids" readonly="state == 'done'">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="lot_id" groups="stock.group_production_lot" optional="show"/>
                                <field name="qty"/>
                                <field name="uom_id" groups="uom.group_uom" optional="show"/>
                                <field name="qty_on_hand" readonly="1" optional="show"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
