<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Adding snippets by inheriting the template snippets-->
    <template id="snippets" inherit_id="website.snippets" name="Blast snippets">
<!--        Dynamic Snippets -->
        <xpath  expr="//snippets[@id='snippet_groups']"
               position="inside">
             <!--  Asked Questions-->
            <t snippet-group="asked_questions_group" t-snippet="theme_blast.asked_questions_template"
               t-thumbnail="/theme_blast/static/src/img/snippets/asked-question-snippet.png"/>
            <!--  Best product Carousel-->
            <t snippet-group="best_product_carousel_group" t-snippet="theme_blast.best_product_carousel"
               t-thumbnail="/theme_blast/static/src/img/snippets/best-product-carousel.png"/>
            <!--   Best deal-->
            <t snippet-group="best_deal_group" t-snippet="theme_blast.best_deal_snippet_template"
               t-thumbnail="/theme_blast/static/src/img/snippets/best-deal.png"/>
             <!--   Testimonial-->
            <t snippet-group="testimonial_group" t-snippet="theme_blast.testimonial"
               t-thumbnail="/theme_blast/static/src/img/snippets/testinomial-1.png"/>
        </xpath>
<!--        Structure snippet-->
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
            <!--  Features-->
            <t snippet-group="features_group" t-snippet="theme_blast.features"
               t-thumbnail="/theme_blast/static/src/img/snippets/s_features_grid.png"/>
            <!--  Subscribe-->
            <t snippet-group="subscribe_group" t-snippet="theme_blast.subscribe"
               t-thumbnail="/theme_blast/static/src/img/snippets/subscribe.png"/>
            <!--  Choose-->
            <t snippet-group="choose_group" t-snippet="theme_blast.choose"
               t-thumbnail="/theme_blast/static/src/img/snippets/Video.png"/>
            <!--  Cards-->
            <t snippet-group="cards_group" t-snippet="theme_blast.cards"
               t-thumbnail="/theme_blast/static/src/img/snippets/Portfolio.png"/>
            <!--  Banners-->
            <t snippet-group="banners_group" t-snippet="theme_blast.banners"
               t-thumbnail="/theme_blast/static/src/img/snippets/banner_section-1.png"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_blast.asked_questions_template" string="Asked Questions" group="asked_questions_group"/>
            <t t-snippet="theme_blast.best_product_carousel" string="Asked Questions" group="best_product_carousel_group"/>
            <t t-snippet="theme_blast.best_deal_snippet_template" string="Asked Questions" group="best_deal_group"/>
            <t t-snippet="theme_blast.testimonial" string="Asked Questions" group="testimonial_group"/>
            <t t-snippet="theme_blast.features" string="Asked Questions" group="features_group"/>
            <t t-snippet="theme_blast.subscribe" string="Asked Questions" group="subscribe_group"/>
            <t t-snippet="theme_blast.choose" string="Asked Questions" group="choose_group"/>
            <t t-snippet="theme_blast.cards" string="Asked Questions" group="cards_group"/>
            <t t-snippet="theme_blast.banners" string="Asked Questions" group="banners_group"/>
        </xpath>
    </template>
</odoo>
