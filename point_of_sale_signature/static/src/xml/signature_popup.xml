<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="point_of_sale_signature.SignaturePopup" owl="1">


        <!-- ===== SCOPED INLINE STYLES ===== -->
        <style>
            .pos-signature-popup-root {
                background: #ffffff;
                border-radius: 12px;
                padding: 16px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            }

            .pos-signature-popup {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .pos-signature-popup h3 {
                text-align: center;
                font-size: 18px;
                font-weight: 600;
                margin-bottom: 4px;
            }

            .pos-signature-canvas-wrapper {
                border: 2px dashed #bdbdbd;
                border-radius: 8px;
                background-color: #ffffff;
                padding: 8px;
            }

            .pos-signature-canvas {
                width: 100%;
                height: 180px;
                cursor: crosshair;
                touch-action: none;
            }

            .pos-signature-hint {
                text-align: center;
                font-size: 13px;
                color: #666;
            }

            .pos-signature-buttons {
                display: flex;
                gap: 8px;
                margin-top: 8px;
            }

            .pos-signature-buttons button {
                flex: 1;
                padding: 10px 12px;
                border-radius: 6px;
                font-size: 15px;
                font-weight: 500;
            }

            .pos-signature-clear {
                background-color: #f5f5f5;
                color: #444;
            }

            .pos-signature-cancel {
                background-color: #e0e0e0;
                color: #333;
            }

            .pos-signature-confirm {
                background-color: #875A7B;
                color: #ffffff;
            }
        </style>

        <!-- ===== POPUP CONTENT (SCOPED) ===== -->
        <div class="pos-signature-popup-root">
            <div class="pos-signature-popup">

                <h3>Customer Signature</h3>

                <div class="pos-signature-canvas-wrapper">
                    <canvas class="pos-signature-canvas"
                            t-ref="canvas"
                            width="500"
                            height="180"/>
                </div>

                <div class="pos-signature-hint">
                    Please sign above using your finger or mouse
                </div>

                <div class="pos-signature-buttons">
                    <button class="pos-signature-clear"
                            t-on-click="clearSignature">
                        Clear
                    </button>

                    <button class="pos-signature-cancel"
                            t-on-click="cancel">
                        Cancel
                    </button>

                    <button class="pos-signature-confirm"
                            t-on-click="confirm">
                        Confirm
                    </button>
                </div>

            </div>
        </div>

    </t>

</templates>


