<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Theme zen snippets inherits -->
    <template id="theme_zen_dark_snippets" inherit_id="website.snippets" name="Theme Zen snippets">
        <!-- Create snippet groups -->
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/about-1.png" 
               string="Zen About" 
               snippet-group="zen_about"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/banner_section-1.png" 
               string="Zen Banner" 
               snippet-group="zen_banner"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/client-1.png" 
               string="Zen Client" 
               snippet-group="zen_client"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/recent-1.png" 
               string="Zen Recent" 
               snippet-group="zen_recent"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/testimonial-1.png" 
               string="Zen Members" 
               snippet-group="zen_members"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/Video.png" 
               string="Zen Video" 
               snippet-group="zen_video"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/about-1.png" 
               string="Zen Headings" 
               snippet-group="zen_headings"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/Portfolio.png" 
               string="Zen Portfolio" 
               snippet-group="zen_portfolio"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/service_page.png" 
               string="Zen Services" 
               snippet-group="zen_services"/>
        </xpath>
        
        <!-- Add snippets to structure -->
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_zen_dark.index_about" 
               string="Zen About" 
               group="zen_about" 
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/about-1.png"/>
            <t t-snippet="theme_zen_dark.banner" 
               string="Zen Banner" 
               group="zen_banner" 
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/banner_section-1.png"/>
            <t t-snippet="theme_zen_dark.zen_client" 
               string="Zen Client" 
               group="zen_client" 
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/client-1.png"/>
            <t t-snippet="theme_zen_dark.zen_recent" 
               string="Zen Recent" 
               group="zen_recent" 
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/recent-1.png"/>
            <t t-snippet="theme_zen_dark.zen_members" 
               string="Zen Members" 
               group="zen_members" 
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/testimonial-1.png"/>
            <t t-snippet="theme_zen_dark.zen_video" 
               string="Zen Video" 
               group="zen_video" 
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/Video.png"/>
            <t t-snippet="theme_zen_dark.headings" 
               string="Zen Headings" 
               group="zen_headings" 
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/about-1.png"/>
            <t t-snippet="theme_zen_dark.portfolio_banner" 
               string="Zen Portfolio" 
               group="zen_portfolio" 
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/Portfolio.png"/>
            <t t-snippet="theme_zen_dark.services" 
               string="Zen Services" 
               group="zen_services" 
               t-thumbnail="/theme_zen_dark/static/src/img/snippets/service_page.png"/>
        </xpath>
    </template>
</odoo>