<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Index Banner snippet template -->
    <template id="banner" name="Index Banner Snippet">
        <section class="main_body banner_snippet_dark s_carousel_wrapper" id="section02" data-vxml="001">
            <t t-set="uniq" t-value="datetime.datetime.now().microsecond"/>
            <div t-attf-id="myCarousel{{uniq}}" class="s_carousel s_carousel_default carousel slide"
                 data-bs-interval="10000" data-bs-ride="carousel" data-ride="carousel" data-interval="10000">
                <section class="header">
                    <div class="container-fluid p-0">
                        <div class="wrapper">
                            <div class="owl-carousel">
                                <!-- Indicators -->
                                <div class="carousel-indicators owl-dots" style="bottom: 20px; right: 20px; left: auto; margin: 0; width: auto; justify-content: flex-end; background-color: rgba(0, 0, 0, 0.5); border-radius: 50px; padding: 5px 10px;">
                                    <button type="button" t-attf-data-bs-target="#myCarousel{{uniq}}" data-bs-slide-to="0" class="active owl-dot" aria-current="true" aria-label="Slide 1">
                                        <span/>
                                    </button>
                                    <button type="button" t-attf-data-bs-target="#myCarousel{{uniq}}" data-bs-slide-to="1" class="owl-dot" aria-label="Slide 2">
                                        <span/>
                                    </button>
                                    <button type="button" t-attf-data-bs-target="#myCarousel{{uniq}}" data-bs-slide-to="2" class="owl-dot" aria-label="Slide 3">
                                        <span/>
                                    </button>
                                </div>

                                <div id="banner" class="carousel-inner">
                                    <div class="carousel-item active" data-name="Slide" style="min-height: fit-content !important;">
                                        <div>
                                            <div class="banner_index">
                                                <div class="default">
                                                    <div class="row p-0 m-0">
                                                        <div class="col-lg-6 col-12 p-0 m-0">
                                                            <div class="banner_bg">
                                                                <img src="/theme_zen_dark/static/src/img/banner/bg1.jpg" class="img img-fluid w-100" style="object-fit: cover;"/>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-6 col-12 p-0 m-0">
                                                            <div class="banner_left ">
                                                                <div class="card w-75">
                                                                    <div class="card-body">
                                                                        <p class="card-title first">WELCOME zen</p>
                                                                        <p class="card-text second" id="demo">
                                                                            best solutions
                                                                            <br/>
                                                                            ideas for your Business
                                                                        </p>
                                                                        <p class="text-bottom third">Li Europan lingues es
                                                                            membres
                                                                            del sam familie.
                                                                        </p>
                                                                        <a href="/about_theme_zen_dark" class="btn btn-primary_b fourth">READ
                                                                            MORE
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="carousel-item" data-name="Slide" style="min-height: fit-content !important;">
                                        <div>
                                            <div class="banner_index">
                                                <div class="row p-0 m-0">
                                                    <div class="col-lg-6 col-12 p-0 m-0">
                                                        <div class="banner_bg">
                                                            <img src="/theme_zen_dark/static/src/img/banner/bg2.jpg" class="img img-fluid w-100" style="object-fit: cover;"/>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6 col-12 p-0 m-0">
                                                        <div class="banner_left">
                                                            <div class="card w-75">
                                                                <div class="card-body">
                                                                    <h5 class="card-title">WELCOME zen</h5>
                                                                    <p class="card-text">
                                                                        best solutions
                                                                        <br/>
                                                                        ideas for your Business
                                                                    </p>
                                                                    <p class="text-bottom">Li Europan lingues es membres del
                                                                        sam
                                                                        familie.
                                                                    </p>
                                                                    <a href="/shop" class="btn btn-primary_b">Shop Now</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="carousel-item" data-name="Slide" style="min-height: fit-content !important;">
                                        <div>
                                            <div class="banner_index">
                                                <div class="row p-0 m-0">
                                                    <div class="col-lg-6 col-12 p-0 m-0">
                                                        <div class="banner_bg">
                                                            <img src="/theme_zen_dark/static/src/img/banner/bg3.jpg" class="img img-fluid w-100" style="object-fit: cover;"/>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6 col-12 p-0 m-0">
                                                        <div class="banner_left">
                                                            <div class="card w-75">
                                                                <div class="card-body">
                                                                    <h5 class="card-title">WELCOME zen</h5>
                                                                    <p class="card-text">
                                                                        best solutions
                                                                        <br/>
                                                                        ideas for your Business
                                                                    </p>
                                                                    <p class="text-bottom">Li Europan lingues es membres del
                                                                        sam
                                                                        familie.
                                                                    </p>
                                                                    <a href="/shop" class="btn btn-primary_b">Shop Now</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Controls -->
                                <div class="owl-nav">
                                    <div class="carousel-control-prev o_not_editable nav-prev owl-prev" t-attf-data-bs-target="#myCarousel{{uniq}}"
                                         data-bs-slide="prev" role="button" aria-label="Previous" title="Previous">
                                        <i class="fa fa-angle-left"/>
                                        <span class="visually-hidden">Previous</span>
                                    </div>
                                    <div class="carousel-control-next o_not_editable nav-next owl-next" t-attf-data-bs-target="#myCarousel{{uniq}}"
                                         data-bs-slide="next" role="button" aria-label="Next" title="Next">
                                        <i class="fa fa-angle-right"/>
                                        <span class="visually-hidden">Next</span>
                                    </div>
                                </div>
                            </div>
                            <!-- Remove scroll button as it can be distracting or broken in some contexts if not needed, or leave as is -->
                            <div class="b_wrapp">
                                <a href="#section02" class="btn btn-down">Scroll</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </section>
    </template>
</odoo>
