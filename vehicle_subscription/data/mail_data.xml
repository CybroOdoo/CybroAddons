<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!--Subscription cancellation mail template-->
        <record id="cancellation_request_mail" model="mail.template">
            <field name="name">Vehicle Cancellation - Payment Required</field>
            <field name="model_id"
                   ref="vehicle_subscription.model_cancellation_request"/>
            <field name="subject">Subscription Cancellation - Payment Required</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>
                        Dear <t t-out="object.customer_id.name or 'Customer'"/>,
                        <br/><br/>
                        We have received your vehicle subscription cancellation request. Please note that an outstanding amount is due for vehicle usage up to the cancellation date.
                        <br/><br/>
                        Please find your invoice attached for settlement. Once payment is received, your subscription cancellation will be finalized.
                        <br/><br/>
                        Best regards,
                        <br/>
                        <t t-out="user.name"/>
                    </p>
                </div>
            </field>
        </record>
        <!-- Mail template for refund in subscription cancellation -->
        <record id="cancellation_request_refund_mail" model="mail.template">
            <field name="name">Vehicle Cancellation - Refund Notice</field>
            <field name="model_id"
                   ref="vehicle_subscription.model_cancellation_request"/>
            <field name="subject">Subscription Cancellation - Refund Notice</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>
                        Dear <t t-out="object.customer_id.name or 'Customer'"/>,
                        <br/><br/>
                        Your vehicle subscription cancellation request has been approved. A refund credit note has been generated for the remaining subscription period.
                        <br/><br/>
                        Please find the credit note document attached for your records. The refund will be processed to your account.
                        <br/><br/>
                        Best regards,
                        <br/>
                        <t t-out="user.name"/>
                    </p>
                </div>
            </field>
        </record>
        <!-- Mail template for approval of subscription cancellation -->
        <record id="cancellation_approved" model="mail.template">
            <field name="name">Vehicle Cancellation - Approved</field>
            <field name="model_id"
                   ref="vehicle_subscription.model_cancellation_request"/>
            <field name="subject">Subscription Cancellation Approved</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>
                        Dear <t t-out="object.customer_id.name or 'Customer'"/>,
                        <br/><br/>
                        Your request for vehicle subscription cancellation has been approved.
                        <br/><br/>
                        If you have any questions or require further assistance, please do not hesitate to contact us.
                        <br/><br/>
                        Best regards,
                        <br/>
                        <t t-out="user.name"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
