<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--Action of cancellation request-->
    <record id="cancellation_request_action" model="ir.actions.act_window">
        <field name="name">Cancellation Request</field>
        <field name="res_model">cancellation.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- List view of cancellation request -->
    <record id="cancellation_request_view_list" model="ir.ui.view">
        <field name="name">cancellation.request.view.list</field>
        <field name="model">cancellation.request</field>
        <field name="arch" type="xml">
            <list string="Cancellation Requests">
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="date"/>
                <field name="reason"/>
                <field name="state" widget="badge" decoration-info="state == 'to_approve'" decoration-success="state == 'approved'" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Form view of the cancellation request -->
    <record id="cancellation_request_view_form" model="ir.ui.view">
        <field name="name">cancellation.request.view.form</field>
        <field name="model">cancellation.request</field>
        <field name="arch" type="xml">
            <form string="Cancellation Request">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_request" class="oe_highlight"
                            string="Request"
                            invisible="state != 'draft'"
                            type="object"/>
                    <button name="action_approve" class="oe_highlight"
                            string="Approve"
                            type="object"
                            invisible="state in ('draft','approved')"
                            groups="vehicle_subscription.vehicle_subscription_group_manager"/>
                </header>
                <sheet>
                    <group>
                        <field name="customer_id" readonly="state == 'approved'"/>
                        <field name="vehicle_id" readonly="state == 'approved'"/>
                        <field name="date" readonly="state == 'approved'"/>
                        <field name="reason" readonly="state == 'approved'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--Menu item of cancellation-->
    <menuitem id="cancellation_request_menu_action"
              name="Cancellation Request"
              parent="fleet.fleet_configuration"
              action="cancellation_request_action"
              sequence="7"/>
</odoo>
