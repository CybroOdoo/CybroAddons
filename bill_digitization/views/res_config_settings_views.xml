<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inheriting the view of res_config_setting -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bill.digitization</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']"
                   position="inside">
                <setting id="digitize_bill"
                         help="Digitize bill from scanned documents with .pdf, .jpg,
                            .jpeg or .png extension using OCR and Artificial
                            Intelligence">
                    <field name="digitize_bill"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
