<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Module Category -->
        <record id="module_category_queue_management" model="ir.module.category">
            <field name="name">Queue Management</field>
            <field name="description">Category for Queue Management</field>
            <field name="sequence">20</field>
        </record>

        <!-- Privilege -->
        <record id="res_groups_privilege_queue_management" model="res.groups.privilege">
            <field name="name">Queue Management</field>
            <field name="category_id" ref="module_category_queue_management"/>
            <field name="sequence">20</field>
        </record>

        <!-- Queue User Group -->
        <record id="group_queue_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_queue_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Queue Manager Group -->
        <record id="group_queue_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_queue_management"/>
            <field name="implied_ids" eval="[(4, ref('group_queue_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
