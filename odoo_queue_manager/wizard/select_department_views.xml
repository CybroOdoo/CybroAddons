<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for Departments -->
    <record id="select_department_view_form" model="ir.ui.view">
        <field name="name">select.department.view.form</field>
        <field name="model">select.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="counter_id"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_submit" string="Submit" type="object"
                                class="oe_highlight"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>