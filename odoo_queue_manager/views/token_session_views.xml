<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for Token Session -->
    <record id="token_session_view_form" model="ir.ui.view">
        <field name="name">token.session.view.form</field>
        <field name="model">token.session</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                     <h1>
                        <field name="reference_no"/>
                    </h1>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="opened_by"/>
                            <field name="opened_datetime"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view for Token Session -->
    <record id="token_session_view_tree" model="ir.ui.view">
        <field name="name">token.session.view.tree</field>
        <field name="model">token.session</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="reference_no"/>
                <field name="name"/>
                <field name="opened_by"/>
                <field name="opened_datetime"/>
            </tree>
        </field>
    </record>


    <!-- Window action for Token Session -->
    <record id="token_session_action" model="ir.actions.act_window">
        <field name="name">Session</field>
        <field name="res_model">token.session</field>
         <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Token Session is not created yet!
            </p>
        </field>
    </record>
</odoo>