<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for Queue Process -->
    <record id="queue_process_view_form" model="ir.ui.view">
        <field name="name">queue.process.view.form</field>
        <field name="model">queue.process</field>
        <field name="arch" type="xml">
            <form create="0">
               <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1>
                        <field name="reference_no"/>
                    </h1>
                    <group>
                        <group>
                            <field name="customer_name"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="counter_id"/>
                            <field name="user_id"/>
                            <field name="processed_datetime"/>
                            <field name="customer_query"/>
                            <field name="feedback"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view for Queue Process -->
    <record id="queue_process_view_list" model="ir.ui.view">
        <field name="name">queue.process.view.list</field>
        <field name="model">queue.process</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="reference_no"/>
                <field name="counter_id"/>
                <field name="user_id"/>
                <field name="processed_datetime"/>
                <field name="department_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Window action for Queue Process -->
    <record id="queue_process_action" model="ir.actions.act_window">
        <field name="name">Queue Process</field>
        <field name="res_model">queue.process</field>
         <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Queue Process is not created yet!
            </p>
        </field>
    </record>

</odoo>