<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root menu for Queue Manager module accessible to managers and users -->
    <menuitem id="odoo_queue_manager_root"
              name="Odoo Queue Manager"
              groups="odoo_queue_manager.group_queue_manager,odoo_queue_manager.group_queue_user"/>

    <!-- Parent menu for token-related operations -->
    <menuitem id="odoo_que_manager_first_menu"
              name="Token Interface"
              parent="odoo_queue_manager_root"
              groups="odoo_queue_manager.group_queue_manager,odoo_queue_manager.group_queue_user"/>

    <!-- Menu to access token interface screen -->
    <menuitem id="token_interface_menu"
              name="Token Interface"
              parent="odoo_que_manager_first_menu"
              action="token_interface_action"
              groups="odoo_queue_manager.group_queue_manager,odoo_queue_manager.group_queue_user"/>

    <!-- Dashboard -->
    <menuitem id="queue_manager_dashboard"
              name="Dashboard"
              parent="odoo_queue_manager_root"
              action="dashboard_action"
              sequence="0"
              groups="odoo_queue_manager.group_queue_manager"/>

    <!-- Department -->
    <menuitem id="department_menu"
              name="Department"
              parent="odoo_queue_manager_root"
              sequence="104"
              action="department_action"
              groups="odoo_queue_manager.group_queue_manager"/>

    <!-- Counter Parent -->
    <menuitem id="queue_counter_menu"
              name="Counter"
              parent="odoo_queue_manager_root"
              sequence="6"
              groups="odoo_queue_manager.group_queue_manager"/>

    <!-- Counter -->
    <menuitem id="queue_counter_menu1"
              name="Counter"
              parent="queue_counter_menu"
              sequence="1"
              action="queue_counter_action"
              groups="odoo_queue_manager.group_queue_manager"/>

    <!-- Queue Process -->
    <menuitem id="queue_process_menu"
              name="Queue Process"
              parent="queue_counter_menu"
              sequence="8"
              action="queue_process_action"
              groups="odoo_queue_manager.group_queue_manager"/>

    <!-- Session -->
    <menuitem id="sequence_odoo_queue_manager"
              name="Session"
              parent="odoo_que_manager_first_menu"
              sequence="100"
              action="token_session_action"
              groups="odoo_queue_manager.group_queue_manager"/>

    <!-- Menu to display public queue screen -->
    <menuitem id="queue_display_menu"
              name="Queue Display"
              parent="odoo_queue_manager_root"
              sequence="70"
              action="queue_display_action"
              groups="odoo_queue_manager.group_queue_manager,odoo_queue_manager.group_queue_user"/>

    <!-- Token -->
    <menuitem id="token_token_menu"
              name="Token"
              parent="odoo_que_manager_first_menu"
              sequence="107"
              action="token_token_action"
              groups="odoo_queue_manager.group_queue_manager,odoo_queue_manager.group_queue_user"/>

</odoo>
