<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for Departments -->
    <record id="department_view_form" model="ir.ui.view">
        <field name="name">department.view.form</field>
        <field name="model">department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="4">
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- List view for Departments -->
    <record id="department_view_list" model="ir.ui.view">
        <field name="name">department.view.list</field>
        <field name="model">department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Action to open department list and form views -->
    <record id="department_action" model="ir.actions.act_window">
        <field name="name">Department</field>
        <field name="res_model">department</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Departments are not created yet!
            </p>
        </field>
    </record>

</odoo>