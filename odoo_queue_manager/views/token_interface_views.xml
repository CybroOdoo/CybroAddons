<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for Token Interface -->
    <record id="token_interface_view_form" model="ir.ui.view">
        <field name="name">token.interface.view.form</field>
        <field name="model">token.interface</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="4">
                        <field name="name"/>
                        <field name="is_start_session"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- List view for Token Interface -->
    <record id="token_interface_view_list" model="ir.ui.view">
        <field name="name">token.interface.view.list</field>
        <field name="model">token.interface</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Kanban view for Token Interface -->
    <record id="token_interface_view_kanban" model="ir.ui.view">
        <field name="name">token.interface.view.kanban</field>
        <field name="model">token.interface</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <templates>
                    <t t-name="menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_view">
                                    <div>
                                        <a type="edit"
                                           class="oe_kanban_action oe_kanban_action_a">
                                            Configure
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span>
                                            <h3>
                                                <field name="name"/>
                                            </h3>
                                            <field name="is_start_session" invisible="1"/>
                                        </span>
                                    </strong>
                                    <br/>
                                    <br/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span>
                                        <button name="action_start_new_session"
                                                string="Start Session" type="object"
                                                class="btn-primary"
                                                style="width: inherit;"
                                                invisible="is_start_session == 1"/>
                                        <button name="action_resume_session"
                                                type="object"
                                                string="Resume"
                                                class="btn-success"
                                                invisible="not is_start_session"/>
                                        <button name="action_close_session"
                                                string="Close Session" type="object"
                                                class="btn-primary"
                                                style="width: inherit;"
                                                invisible="is_start_session == 0"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">

                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Window action for Token Interface -->
    <record id="token_interface_action" model="ir.actions.act_window">
        <field name="name">Token Interface</field>
        <field name="res_model">token.interface</field>
        <field name="view_mode">kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Token Interface is not created yet!
            </p>
        </field>
    </record>


</odoo>