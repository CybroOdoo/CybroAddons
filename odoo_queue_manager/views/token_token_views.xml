<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for Token -->
    <record id="token_token_view_form" model="ir.ui.view">
        <field name="name">token.token.view.form</field>
        <field name="model">token.token</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1>
                        <field name="reference_no"/>
                    </h1>
                    <group>
                        <group>
                            <field name="customer_name"/>
                            <field name="token"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="mobile"/>
                            <field name="token_datetime"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view for Token -->
    <record id="token_token_view_list" model="ir.ui.view">
        <field name="name">token.token.view.list</field>
        <field name="model">token.token</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="reference_no"/>
                <field name="token"/>
                <field name="customer_name"/>
                <field name="department_id"/>
                <field name="mobile"/>
            </list>
        </field>
    </record>

    <!-- Window action for Token -->
    <record id="token_token_action" model="ir.actions.act_window">
        <field name="name">Token</field>
        <field name="res_model">token.token</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tokens are not created yet!
            </p>
        </field>
    </record>

</odoo>