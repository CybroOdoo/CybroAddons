<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for Queue Counter -->
    <record id="queue_counter_view_form" model="ir.ui.view">
        <field name="name">queue.counter.view.form</field>
        <field name="model">queue.counter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view for Queue Counter -->
    <record id="queue_counter_view_list" model="ir.ui.view">
        <field name="name">queue.counter.view.list</field>
        <field name="model">queue.counter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Kanban view for Queue Counter -->
    <record id="queue_counter_view_kanban" model="ir.ui.view">
        <field name="name">queue.counter.view.kanban</field>
        <field name="model">queue.counter</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <templates>
                    <t t-name="menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_view">
                                    <div>
                                        <a type="edit"
                                           class="oe_kanban_action oe_kanban_action_a">
                                            Configure
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span>
                                            <h3> <field name="name"/></h3>

                                        </span>
                                    </strong><br/><br/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span>
                                       <button name="action_start_process" string="Start Processing" type="object" class="btn-primary" style="width: inherit;"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Window action for Queue Counter -->
    <record id="queue_counter_action" model="ir.actions.act_window">
        <field name="name">Queue counter</field>
        <field name="res_model">queue.counter</field>
         <field name="view_mode">kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Queue counter is not created yet!
            </p>
        </field>
    </record>

</odoo>