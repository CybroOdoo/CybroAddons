<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Record for creating sequence number-->
    <record id="token_token_sequence" model="ir.sequence">
        <field name="name">Token</field>
        <field name="code">token.token</field>
        <field name="prefix">TKN/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="token_session_sequence" model="ir.sequence">
        <field name="name">Token Session</field>
        <field name="code">token.session</field>
        <field name="prefix">TKN/SSN/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_queue_process" model="ir.sequence">
        <field name="name">Queue Process Sequence</field>
        <field name="code">queue.process</field>
        <field name="prefix">QP</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
