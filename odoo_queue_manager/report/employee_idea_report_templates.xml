<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report action for printing token details -->
    <record id="action_token_report" model="ir.actions.report">
        <field name="name">Token Receipt</field>
        <field name="model">token.token</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_queue_manager.token_report</field>
        <field name="report_file">odoo_queue_manager.token_report</field>
    </record>

    <!--template for the pdf report of employee ideas-->
    <template id="token_report">
        <!-- QWeb PDF template for printing token receipt -->
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <!-- Loop through tokens -->
                <t t-foreach="docs" t-as="doc">
                    <div class="page">

                        <div style="text-align:center;">

                            <!-- Card Container -->
                            <div style="
                            border:2px solid black;
                            border-radius:10px;
                            padding:20px;
                            width:400px;
                            margin:auto;
                        ">

                                <!-- Header -->
                                <div style="
                                background:#0d6efd;
                                color:white;
                                padding:10px;
                                font-size:22px;
                                font-weight:600;
                                border-radius:6px;
                            ">
                                    Token Receipt
                                </div>
                                <br/>
                                <!-- Token Number -->
                                <div style="font-size:28px; font-weight:700; color:#0d6efd;">
                                    <t t-esc="doc.department_id.code"/>-
                                    <t t-esc="doc.token"/>
                                </div>
                                <br/>
                                <!-- Customer Details -->
                                <div style="text-align:left; font-size:16px;">
                                    <p>
                                        <b>Name:</b>
                                        <t t-esc="doc.customer_name"/>
                                    </p>

                                    <p>
                                        <b>Department:</b>
                                        <t t-esc="doc.department_id.name"/>
                                    </p>

                                    <p>
                                        <b>Date:</b>
                                        <t t-esc="doc.token_datetime.strftime('%d-%m-%Y %H:%M')"/>
                                    </p>
                                </div>

                            </div>
                        </div>

                    </div>
                </t>

            </t>
        </t>
    </template>
</odoo>
