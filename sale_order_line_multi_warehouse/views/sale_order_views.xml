<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Sale order form view inherited -->
    <record id="view_order_form_inherit_sale_order_line_multi_warehouse" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sale.order.line.multi.warehouse</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//column[@name='product_and_description']"
                   position="after">
                <field name="product_warehouse_id"
                       options="{'no_create': True}"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
