<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_templated_ext" inherit_id="web.login" name="Login Ext">
        <xpath expr="//button[@type='submit'][not(@name)]" position="attributes">
            <attribute name="class" add="cybro-login-btn" separator=" "/>
        </xpath>
        <xpath expr="//button[@name='redirect']" position="attributes">
            <attribute name="class" add="cybro-super-btn" separator=" "/>
        </xpath>
    </template>
</odoo>
