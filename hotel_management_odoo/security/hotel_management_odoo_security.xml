<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--  MAINTENANCE RECORD RULE-->
    <record id="maintenance_request_rule_leader"
            model="ir.access">
        <field name="name">Record Rule for Maintenance team leader</field>
        <field ref="model_maintenance_request" name="model_id"/>
        <field name="group_id" ref="hotel_management_odoo.maintenance_team_group_leader"/>
        <field name="domain">[('team_head_id', '=', user.id)]</field>
        <field name="operation">crud</field>
    </record>
    <!--    Record Rule for Maintenance User-->
    <record id="maintenance_request_rule_user"
            model="ir.access">
        <field name="name">Record Rule for Maintenance User</field>
        <field ref="model_maintenance_request" name="model_id"/>
        <field name="group_id" ref="hotel_management_odoo.maintenance_team_group_user"/>
        <field name="domain">[('assigned_user_id', '=', user.id)]</field>
        <field name="operation">crud</field>
    </record>
    <!--    Record Rule for hotel Admin-->
    <record id="maintenance_request_rule_admin"
            model="ir.access">
        <field name="name">Record Rule for hotel Admin</field>
        <field ref="model_maintenance_request" name="model_id"/>
        <field name="group_id" ref="hotel_management_odoo.hotel_group_admin"/>
        <field name="domain">[(1,'=',1)]</field>
        <field name="operation">crud</field>
    </record>
    <!--    CLEANING HEAD RECORD RULE-->
    <record id="cleaning_request_rule_head" model="ir.access">
        <field name="name">Cleaning Head Record Rule</field>
        <field name="model_id" ref="model_cleaning_request"/>
        <field name="group_id" ref="hotel_management_odoo.cleaning_team_group_head"/>
        <field name="domain">[('team_id.team_head_id.id', '=', user.id)]</field>
        <field name="operation">crud</field>
    </record>
    <!--    CLEANING USER RECORD RULE-->
    <record id="cleaning_request_rule_user" model="ir.access">
        <field name="name">Cleaning User Record Rule</field>
        <field name="model_id" ref="model_cleaning_request"/>
        <field name="group_id" ref="hotel_management_odoo.cleaning_team_group_user"/>
        <field name="domain">[('assigned_id.id', '=', user.id)]</field>
        <field name="operation">crud</field>
    </record>
    <!--    CLEANING ADMIN RECORD RULE-->
    <record id="cleaning_request_rule_admin" model="ir.access">
        <field name="name">Cleaning Admin Record Rule</field>
        <field name="model_id" ref="model_cleaning_request"/>
        <field name="group_id" ref="hotel_management_odoo.hotel_group_admin"/>
        <field name="domain">[(1, '=', 1)]</field>
        <field name="operation">crud</field>
    </record>
</odoo>
