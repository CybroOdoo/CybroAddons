<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Sale Order Report Wizard-->
    <record id="sale_order_detail_view_form" model="ir.ui.view">
        <field name="name">sale.order.detail.view.form</field>
        <field name="model">sale.order.detail</field>
        <field name="arch" type="xml">
            <form string="Sale Order Report">
    <group col="4">
        <field name="checkin"/>
        <field name="checkout"/>
    </group>

    <separator string="FILTER BY STATE"/>

    <group col="2">
        <!-- Left Column -->
        <group>
            <field name="filter_draft"/>
            <field name="filter_check_in"/>
            <field name="filter_cancel"/>
        </group>

        <!-- Right Column -->
        <group>
            <field name="filter_reserved"/>
            <field name="filter_check_out"/>
            <field name="filter_done"/>
        </group>
    </group>

    <footer>
        <button name="action_sale_order_pdf"
                type="object"
                class="btn-primary">
            <i class="fa fa-download me-1"/>
            Download PDF
        </button>

        <button name="action_sale_order_excel"
                type="object"
                class="btn-primary">
            <i class="fa fa-download me-1"/>
            Download XLS
        </button>

        <button special="cancel"
                string="Cancel"
                class="btn-secondary"/>
    </footer>
</form>
        </field>
    </record>
    <!--    Sale Order Report Action-->
    <record id="sale_order_detail_action" model="ir.actions.act_window">
        <field name="name">Sale Order Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.detail</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale_order_detail_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
