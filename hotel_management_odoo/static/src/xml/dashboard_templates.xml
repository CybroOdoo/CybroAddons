<?xml version="1.0" encoding="UTF-8" ?>
<!--Dashboard template-->
<template>
    <t t-name="CustomDashBoard">
        <div class="oh_dashboards">
            <div class="container-fluid o_pj_dashboard">
                <t t-call="HotelOrder"/>
            </div>
        </div>
    </t>

    <t t-name="HotelOrder">
        <!-- ── Rooms Section ── -->
        <div class="dash-section-title">Rooms</div>
        <div class="dash-grid">

            <!-- Total Rooms -->
            <div class="dash-card" t-on-click="(e) => this.total_rooms(e)">
                <div class="dash-icon-bubble icon-blue">
                    <i class="oi" data-icon="bed"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.total_room"/></div>
                    <div class="dash-label">Total Rooms</div>
                </div>
            </div>

            <!-- Available Rooms -->
            <div class="dash-card" t-on-click="(e) => this.available_rooms(e)">
                <div class="dash-icon-bubble icon-green">
                    <i class="oi" data-icon="check_circle"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.available_room"/></div>
                    <div class="dash-label">Available Rooms</div>
                </div>
            </div>

            <!-- Check In -->
            <div class="dash-card" t-on-click="(e) => this.check_ins(e)">
                <div class="dash-icon-bubble icon-teal">
                    <i class="oi" data-icon="login"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.check_in"/></div>
                    <div class="dash-label">Check In</div>
                </div>
            </div>

            <!-- Today's Check Out -->
            <div class="dash-card" t-on-click="(e) => this.check_outs(e)">
                <div class="dash-icon-bubble icon-orange">
                    <i class="oi" data-icon="logout"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.check_out"/></div>
                    <div class="dash-label">Today's Check Out</div>
                </div>
            </div>

            <!-- Total Reservations -->
            <div class="dash-card" t-on-click="(e) => this.reservations(e)">
                <div class="dash-icon-bubble icon-purple">
                    <i class="oi" data-icon="bookmark"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.reservation"/></div>
                    <div class="dash-label">Total Reservations</div>
                </div>
            </div>

        </div>

        <!-- ── Staff and Fleet Section ── -->
        <div class="dash-section-title">Staff &amp; Fleet</div>
        <div class="dash-grid">

            <!-- Total Staff -->
            <div class="dash-card" t-on-click="(e) => this.fetch_total_staff(e)">
                <div class="dash-icon-bubble icon-indigo">
                    <i class="oi" data-icon="group"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.staff"/></div>
                    <div class="dash-label">Total Staff</div>
                </div>
            </div>

            <!-- Total Vehicles -->
            <div class="dash-card" t-on-click="(e) => this.fetch_total_vehicle(e)">
                <div class="dash-icon-bubble icon-slate">
                    <i class="oi" data-icon="directions_car"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.total_vehicle"/></div>
                    <div class="dash-label">Total Vehicles</div>
                </div>
            </div>

            <!-- Available Vehicles -->
            <div class="dash-card" t-on-click="(e) => this.fetch_available_vehicle(e)">
                <div class="dash-icon-bubble icon-lime">
                    <i class="oi" data-icon="directions_car"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.available_vehicle"/></div>
                    <div class="dash-label">Available Vehicles</div>
                </div>
            </div>

        </div>

        <!-- ── Events Section ── -->
        <div class="dash-section-title">Events</div>
        <div class="dash-grid">

            <!-- Total Events -->
            <div class="dash-card" t-on-click="(e) => this.view_total_events(e)">
                <div class="dash-icon-bubble icon-cyan">
                    <i class="oi" data-icon="event_available"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.total_event"/></div>
                    <div class="dash-label">Total Events</div>
                </div>
            </div>

            <!-- Today's Events -->
            <div class="dash-card" t-on-click="(e) => this.fetch_today_events(e)">
                <div class="dash-icon-bubble icon-yellow">
                    <i class="oi" data-icon="event_available"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.today_events"/></div>
                    <div class="dash-label">Today's Events</div>
                </div>
            </div>

            <!-- Pending Events -->
            <div class="dash-card" t-on-click="(e) => this.fetch_pending_events(e)">
                <div class="dash-icon-bubble icon-red">
                    <i class="oi" data-icon="warning"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.pending_events"/></div>
                    <div class="dash-label">Pending Events</div>
                </div>
            </div>

        </div>

        <!-- ── Food Section ── -->
        <div class="dash-section-title">Food</div>
        <div class="dash-grid">

            <!-- Food Items -->
            <div class="dash-card" t-on-click="(e) => this.fetch_food_item(e)">
                <div class="dash-icon-bubble icon-amber">
                    <i class="oi" data-icon="restaurant"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.food_items"/></div>
                    <div class="dash-label">Food Items</div>
                </div>
            </div>

            <!-- Food Orders -->
            <div class="dash-card" t-on-click="(e) => this.fetch_food_order(e)">
                <div class="dash-icon-bubble icon-rose">
                    <i class="oi" data-icon="shopping_cart"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.food_order"/></div>
                    <div class="dash-label">Food Orders</div>
                </div>
            </div>

        </div>

        <!-- ── Revenue Section ── -->
        <div class="dash-section-title">Revenue</div>
        <div class="dash-grid">

            <!-- Total Revenue -->
            <div class="dash-card">
                <div class="dash-icon-bubble icon-green">
                    <i class="oi" data-icon="monitoring"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.total_revenue"/></div>
                    <div class="dash-label">Total Revenue</div>
                </div>
            </div>

            <!-- Today's Revenue -->
            <div class="dash-card">
                <div class="dash-icon-bubble icon-teal">
                    <i class="oi" data-icon="payments"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.today_revenue"/></div>
                    <div class="dash-label">Today's Revenue</div>
                </div>
            </div>

            <!-- Pending Payment -->
            <div class="dash-card">
                <div class="dash-icon-bubble icon-pink">
                    <i class="oi" data-icon="credit_card"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-count"><t t-out="this.pending_payment"/></div>
                    <div class="dash-label">Pending Payment</div>
                </div>
            </div>

        </div>
    </t>
</template>
