<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Maintenance Request Form View-->
    <record id="maintenance_request_view_form" model="ir.ui.view">
        <field name="name">maintenance.request.view.form</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign_team" string="Assign To Team"
                            invisible="state != 'draft'"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_assign_user" string="Assign To User"
        invisible="state != 'team_leader_approve'"
        type="object"
        groups="hotel_management_odoo.maintenance_team_group_leader"
        class="btn-primary"/>
<button name="action_start" string="Accept &amp; Start"
        invisible="state != 'pending'"
        type="object"
        groups="hotel_management_odoo.maintenance_team_group_user"
        class="btn-primary"/>
<button name="action_complete" string="Complete"
        invisible="state != 'ongoing'"
        type="object"
        groups="hotel_management_odoo.maintenance_team_group_user"
        class="btn-primary"/>
<button name="action_verify" string="Verify" invisible="state != 'verify'"
        type="object"
        groups="hotel_management_odoo.maintenance_team_group_leader"
        class="btn-primary"/>
<button name="action_support" string="Request Support"
        type="object"
        invisible="support_team_ids != False and state != 'ongoing'"
        groups="hotel_management_odoo.maintenance_team_group_leader"
        class="btn-primary"/>
<button name="action_assign_support" string="Assign Support"
        groups="hotel_management_odoo.maintenance_team_group_leader"
        invisible="state != 'support'"
        type="object"
        class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ongoing,done"/>
                </header>
                <sheet>
                    <div>
                        <h2>
                            <field name="sequence"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="type"/>
                            <field name="room_maintenance_ids" invisible="type != 'room'" widget="many2many_tags"  domain="[('is_room','=',True)]"/>
                            <field name="vehicle_maintenance_id" invisible="type != 'vehicle'"/>
                            <field name="hotel_maintenance" invisible="type != 'hotel'"/>
                            <field name="cleaning_maintenance" invisible="type != 'cleaning'"/>
                            <field name="support_reason" invisible="state != 'ongoing'"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="team_head_id"/>
                            <field name="remarks" invisible="state != 'ongoing'"/>
                            <field name="support_team_ids" invisible="state != 'support'" widget="many2many_tags"  domain="[('id', 'in',domain_partner_ids),
                                   ('id', '!=', assigned_user_id)]"/>
                            <field name="assigned_user_id"
                                   invisible="state != 'team_leader_approve'"
                                   domain="[('id','in',domain_partner_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="domain_partner_ids" invisible="1"/>
                            <field name="is_hotel" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--    Maintenance Request Tree View-->
    <record id="maintenance_request_view_tree" model="ir.ui.view">
        <field name="name">maintenance.request.view.tree</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="date"/>
                <field name="type"/>
                <field name="team_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--    Maintenance Request Menu Action-->
    <record id="maintenance_request_action" model="ir.actions.act_window">
        <field name="name">Maintenance Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_hotel', '=', True)]</field>
        <field name="context">{'default_is_hotel': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('maintenance_request_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('maintenance_request_view_form')})]"/>
    </record>
    <!--    Maintenance Request Menu-->
    <menuitem id="maintenance_request_menu"
              name="Maintenance Request"
              parent="maintenance_menu"
              action="maintenance_request_action"/>
</odoo>
