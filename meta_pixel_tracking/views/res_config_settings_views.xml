<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Record for res_config_settings for adding pixel id input field.  -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.meta.pixel.tracking
        </field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='cdn_setting']" position="after">
                <setting id="meta_pixel_tracking_setting" string="Meta Pixel Tracking"
                         help="Enable Meta Pixel on your website to track visitor activity.">
                    <field name="meta_tracking"/>
                    <div class="content-group" invisible="not meta_tracking">
                        <div class="row mt16">
                            <label class="col-lg-3 o_light_label" string="Pixel ID" for="pixel_id"/>
                            <field name="pixel_id" placeholder="e.g. 123456789012345"
                                   required="meta_tracking"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
