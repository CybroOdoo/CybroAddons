<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit the Sales Order form view and apply the
        one2many_duplicate widget to order lines, allowing
        users to duplicate sale order line records directly
        from the One2many list.
    -->
    <record id="view_order_form_inherit_one2many_duplicate" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.one2many.duplicate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="widget">one2many_duplicate</attribute>
            </xpath>
        </field>
    </record>
</odoo>
