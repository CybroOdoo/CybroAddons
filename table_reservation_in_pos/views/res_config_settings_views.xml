<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Add the table reservation option to the POS settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.table.reservation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='restaurant_section']" position="inside">
                <setting id="table_reservation_setting"
                         string="Table Reservation"
                         help="Allow reserving tables from the floor plan editor."
                         invisible="not pos_module_pos_restaurant">
                    <field name="table_reservation"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
