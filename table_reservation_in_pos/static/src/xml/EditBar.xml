<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
<!-- Add the Reserve, View Info and Unreserve buttons to the floor plan editor and a reserved label to the tables. -->
    <t t-name="table_reservation_in_pos.Waiter_Table"
       t-inherit="pos_restaurant.floor_plan_editor"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_delete')]" position="after">
            <t t-if="this.isTableReservationEnabled and this.selectedElement?.isTable">
                <button class="btn btn-secondary text-uppercase"
                      t-on-click="() =>this.reserve()"  title="Reserve">
                      <i class="oi" data-icon="calendar_clock" aria-hidden="true"></i>
                </button>
                <button class="btn btn-secondary text-uppercase"
                      t-on-click="() =>this.viewInfo()" title="View Info">
                    <i class="oi" data-icon="info" aria-hidden="true"></i>
                </button>
                <button class="btn btn-secondary text-uppercase"
                      t-on-click="() =>this.unReserve()" title="Unreserve">
                     <i class="oi" data-icon="undo" aria-hidden="true"></i>
                </button>
            </t>
        </xpath>
    </t>

    <t t-name="table_reservation_in_pos.floor_screen_element"
       t-inherit="pos_restaurant.floor_screen_element"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@t-attf-class, 'o_fp_table')]" position="attributes">
            <attribute name="t-attf-title">#{table.reserved ? table.reservation_details : ''}</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'o_fp_table')]" position="inside">
            <div class="table-reserved mb-5">
                <span t-att-hidden="!table.reserved" class="reserved-label">
                    Reserved
                </span>
            </div>
        </xpath>
    </t>
</templates>