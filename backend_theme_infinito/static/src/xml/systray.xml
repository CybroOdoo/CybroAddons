<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!--
    Template for the Studio Systray widget in the backend theme.
    It provides options to open either the Simple Editor or the Advanced Editor.
    -->
    <t t-name="backend_theme_infinito.StudioSystray" owl="1">
        <div class="dropdown o-brush-infinito">
            <a href="#" class="-no-caret" t-on-click.prevent="this._onClickAdvancedEditor">
                <i class="infinito-classic-icon infinito-icon-brush" role="img" aria-label="Open Studio"/>
            </a>
            <div id="dropdown_infinito_mode" class="dropdown-menu">
                <a class="dropdown-item" href="#" t-on-click.prevent="this._onClickSimpleEditor">Simple Editor</a>
                <a class="dropdown-item" href="#" t-on-click.prevent="this._onClickAdvancedEditor">Advanced Editor</a>
            </div>
        </div>
    </t>
    <!--
    Template for the Advanced Systray widget in the backend theme.
    It provides an option to open advanced features.
    -->
    <t t-name="backend_theme_infinito.AdvSystray" owl="1">
        <div class="dropdown o-settings-infinito">
            <a href="#" class="-no-caret" t-on-click.prevent="this._onClick">
                <i class="infinito-classic-icon infinito-icon-settings" role="img" aria-label="Open Advanced Features"/>
            </a>
        </div>
    </t>
    <t t-inherit="mail.MessagingMenuInDropdown" t-inherit-mode="extension">
        <xpath expr="//i[@data-icon='forum']" position="replace">
            <i class="infinito-classic-icon infinito-icon-messages infinito-systray-icon" role="img" aria-label="Messages"/>
        </xpath>
    </t>
    <t t-inherit="mail.ActivityMenu" t-inherit-mode="extension">
        <xpath expr="//i[@data-icon='schedule']" position="replace">
            <i class="infinito-classic-icon infinito-icon-clock infinito-systray-icon" role="img" aria-label="Activities"/>
        </xpath>
    </t>
</templates>
