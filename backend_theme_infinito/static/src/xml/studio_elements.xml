<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!--
    This template defines a range input widget for the backend theme.
    It allows users to adjust a value within a specified range.
    -->
    <t t-name="backend_theme_infinito.range">
        <div class="optss infinito-remove">
            <div class="b_slider">
                <h6>
                    <t t-out="this.widget.displayName"/>
                </h6>
                <h6>
                    <t t-out="this.widget.unit"/>
                </h6>
            </div>
            <div class="b_width">
                <div class="sliderContainer">
                    <input type="range" t-att-name="this.widget.name" t-att-data-unit="this.widget.unit"
                           t-att-value="this.widget.default" t-att-min="this.widget.min" t-att-max="this.widget.max"
                           id="slider" t-att-data-alt="this.widget.alt"/>
                    <span id="output"/>
                </div>
            </div>
        </div>
    </t>
     <!--
    This template defines a color picker widget for the backend theme.
    It allows users to select a color using a color picker input.
    -->
    <t t-name="backend_theme_infinito.color">
        <div class="optss infinito-remove">
            <div class="bg_color">
                <h6 t-out="this.widget.displayName"/>
                <div class="color_picker">
                  <input class="favcolor" id="favcolor" type="color" t-att-name="this.widget.name" t-att-value="this.widget.default" property="color"
                         t-att-data-alt="this.widget.alt"/>
                </div>
            </div>
        </div>
    </t>
    <!--
    This template defines an input field widget for the backend theme.
    It allows users to input text values.
    -->
    <t t-name="backend_theme_infinito.input">
        <div class="optss">
            <div class="b_slider">
                <h6>
                    <t t-out="this.widget.displayName"/>
                </h6>
            </div>
            <ul class="b_style">
                <li>
                    <input type="text" id="text" t-att-name="this.widget.name"
                           t-att-value="this.widget.default" t-att-placeholder="this.widget.displayName"
                           t-att-data-alt="this.widget.alt"/>
                </li>
            </ul>
        </div>
    </t>
     <!--
    This template defines a select dropdown widget for the backend theme.
    It allows users to select options from a dropdown list.
    -->
    <t t-name="backend_theme_infinito.select">
        <h6 class="infinito-remove"><t t-out="this.widget.displayName"/></h6>
        <div class="optss infinito-remove">
            <div class="form-group">
                <select class="form-control" id="select" t-att-name="this.widget.name" aria-label="Default select example" t-att-data-alt="this.widget.alt">
                    <t t-foreach="this.widget.options" t-as="option">
                        <option t-att-value="option"><t t-out="option"/></option>
                    </t>
                </select>
            </div>
        </div>
    </t>
</templates>