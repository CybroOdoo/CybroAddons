<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="backend_theme_infinito.BlockUILoader" t-inherit="web.BlockUI" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_spinner')]/img" position="before">
            <span t-if="this.loaderClass and this.loaderClass != 'default'" t-att-class="this.loaderClass" role="status" aria-label="Loading..."/>
        </xpath>
        <xpath expr="//div[hasclass('o_spinner')]/img" position="attributes">
            <attribute name="t-if">!this.loaderClass || this.loaderClass === 'default'</attribute>
        </xpath>
    </t>
    <t t-name="backend_theme_infinito.ImportBlockUILoader" t-inherit="base_import.BlockUI" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_spinner')]/img" position="before">
            <span t-if="this.loaderClass and this.loaderClass != 'default'" t-att-class="this.loaderClass" role="status" aria-label="Loading..."/>
        </xpath>
        <xpath expr="//div[hasclass('o_spinner')]/img" position="attributes">
            <attribute name="t-if">!this.loaderClass || this.loaderClass === 'default'</attribute>
        </xpath>
    </t>
</templates>
