<?xml version="1.0" encoding="UTF-8"?>
<!--This XML template extends the web.ControlPanel template to add a bookmark button.-->
<templates id="template" xml:space="preserve">
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_navigation')]"
               position="inside">
            <button t-ref="this.bookmarkRef" t-if="this.bookmarkOn" type="button"
                    class="btn btn-bookmark d-inline-flex align-items-center justify-content-center"
                    title="Bookmark this page" aria-label="Bookmark this page"
                    t-att-aria-pressed="this.isBookmarked ? 'true' : 'false'"
                    t-att-class="{ active: this.isBookmarked }"
                    t-on-click="this.onBookmark"
                    >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                     viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M6 3h12v18l-6-4-6 4V3z"/>
                </svg>
            </button>
        </xpath>
    </t>
</templates>
