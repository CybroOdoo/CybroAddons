<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve">
    <t t-name="backend_theme_infinito.theme_editor_sidebar_advanced">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css"/>
        <div id="theme_editor_sidebar" class="main_sidebar" t-ref="this.panelRef">
                <div class="sidebar_wrapper">
                    <div class="sidebar_content">
                        <div class="button_properties">
                            <p>
                                <a class="btn btn-primary_style" data-bs-toggle="collapse" href="#advanced" role="button" aria-expanded="false" aria-controls="advanced">
                                    Advanced
                                </a>
                            </p>
                            <div class="collapse" id="advanced">
                                <div class="card card-body">
                                    <div class="sidebar_left">
                                        <div class="wrapper">
                                            <div class="sub_style" t-if="this.canManageTheme">
                                                <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Internal users can customize their own theme preferences when personal editing is enabled." title="" data-bs-original-title="Help">
                                                    User edit
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="userEditToggler" t-att-checked="this.state.settings.userEdit" t-on-change="(ev) => this.onSettingChange('userEdit', ev)"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                            <div>
                                                <h6 class="info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Choose the loading indicator shown while Odoo is busy." title="" data-bs-original-title="Help">
                                                    Loaders
                                                </h6>
                                                <div class="sub_style">
                                                <select class="form-select infinito-form-select" id="loader" t-on-change="this.onLoaderChange">
                                                <t t-foreach="this.state.loaders" t-as="load" t-key="load">
                                                    <option t-att-value="load" t-att-selected="load === this.state.settings.loaderClass"><t t-out="load"/></option>
                                                </t>
                                                </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="button_properties">
                            <p>
                                <a class="btn btn-primary_style" data-bs-toggle="collapse" href="#sidebar" role="button" aria-expanded="false" aria-controls="sidebar">
                                    Sidebar
                                </a>
                            </p>
                            <div class="collapse" id="sidebar">
                                <div class="card card-body">
                                    <div class="sidebar_left">
                                        <div class="wrapper">
                                            <div class="sub_style">
                                                <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Enables sidebar apps menu" title="" data-bs-original-title="Help">
                                                    Sidebar
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="sidebarToggler" t-on-change="this.onLayoutChange" t-att-checked="this.state.settings.sidebar"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                            <div class="sub_style">
                                                <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Show App icon in sidebar" title="" data-bs-original-title="Help">
                                                    Show Icon
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="sidebarIconToggler" t-att-checked="this.state.settings.sidebarIcon" t-on-change="(ev) => this.onSettingChange('sidebarIcon', ev)"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                            <div class="sub_style">
                                                <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Show App name in sidebar" title="" data-bs-original-title="Help">
                                                    Show Name
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="sidebarNameToggler" t-att-checked="this.state.settings.sidebarName" t-on-change="(ev) => this.onSettingChange('sidebarName', ev)"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                            <div class="sub_style">
                                                <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Show company logo in top of app sidebar" title="" data-bs-original-title="Help">
                                                    Company Logo
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="sidebarCompanyToggler" t-att-checked="this.state.settings.sidebarCompany" t-on-change="(ev) => this.onSettingChange('sidebarCompany', ev)"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                            <div class="sub_style">
                                                <div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Show User Menu in top of app sidebar" title="" data-bs-original-title="Help">
                                                    User Menu
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="sidebarUserToggler" t-att-checked="this.state.settings.sidebarUser" t-on-change="(ev) => this.onSettingChange('sidebarUser', ev)"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="button_properties">
                            <p>
                                <a class="btn btn-primary_style" data-bs-toggle="collapse" href="#navbar" role="button" aria-expanded="false" aria-controls="navbar">
                                    Navbar
                                </a>
                            </p>
                            <div class="collapse" id="navbar">
                                <div class="card card-body">
                                    <div class="sidebar_left">
                                        <div class="wrapper">
                                            <div class="sub_style">
                                                <div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Show the navigation bar when hovering near the top of the browser window." title="" data-bs-original-title="Help">
                                                    Navbar on Hover
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="navbarHoverToggler" t-att-checked="this.state.settings.fullscreen" t-on-change="(ev) => this.onSettingChange('fullscreen', ev)"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="button_properties">
                            <p>
                                <a class="btn btn-primary_style" data-bs-toggle="collapse" href="#dark" role="button" aria-expanded="false" aria-controls="dark">
                                    Dark mode
                                </a>
                            </p>
                            <div class="collapse" id="dark">
                                <div class="card card-body">
                                    <div class="sidebar_left">
                                        <div class="wrapper">
                                            <div class="sub_style">
                                                <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Enable dark mode." title="" data-bs-original-title="Help">
                                                    Dark Mode
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="navbarDarkToggler" t-att-checked="this.state.settings.infinitoDark" t-on-change="this._OnChangeDark"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                            <div class="dark_mode">
                                                <ul t-att-style="this.state.settings.infinitoDark ? 'display: flex' : 'display: none'" class="mode dark-switch" t-on-click="this.onChangeDarkMode">
                                                    <li t-att-class="{active: this.state.mode === 'all'}">
                                                        <a data-mode="all">
                                                            <i class="bi bi-brightness-high-fill"/>
                                                            <span>
                                                                All time
                                                            </span>
                                                        </a>
                                                    </li>
                                                    <li t-att-class="{active: this.state.mode === 'schedule'}">
                                                        <a data-mode="schedule">
                                                            <i class="bi bi-clock"/>
                                                            <span>
                                                                Schedule
                                                            </span>
                                                        </a>
                                                    </li>
                                                    <li t-att-class="{active: this.state.mode === 'auto'}">
                                                        <a data-mode="auto">
                                                            <i class="bi bi-arrow-repeat"/>
                                                            <span>
                                                                Automatic
                                                            </span>
                                                        </a>
                                                    </li>
                                                </ul>
                                                <div class="on_off dark-schedule" t-att-style="this.state.settings.infinitoDark &amp;&amp; this.state.mode === 'schedule' ? 'display: flex' : 'display: none'">
                                                    <ul>
                                                        <li class="d-flex">
                                                            <div class="left">Turn On</div>
                                                            <div class="right d-flex">
                                                                <span id="startSchedule"/>
                                                                <i class="schedule-input oi" data-icon="arrow_right" t-on-click="this.onClickSchedule"/>
                                                                <input type="time" id="time1" t-att-value="this.darkStart" t-on-change="this.onChangeTime"/>
                                                            </div>
                                                        </li>
                                                        <li class="d-flex">
                                                            <div class="left">Turn Off</div>
                                                            <div class="right d-flex">
                                                                <span id="endSchedule"/>
                                                                <i class="schedule-input oi" data-icon="arrow_right" t-on-click="this.onClickSchedule"/>
                                                                <input type="time" id="time2" t-att-value="this.darkEnd" t-on-change="this.onChangeTime2"/>
                                                            </div>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="button_properties">
                            <p>
                                <a class="btn btn-primary_style" data-bs-toggle="collapse" href="#other" role="button" aria-expanded="false" aria-controls="other">
                                    Other
                                </a>
                            </p>
                            <div class="collapse" id="other">
                                <div class="card card-body">
                                    <div class="sidebar_left">
                                        <div class="wrapper">
                                            <div class="sub_style">
                                                <div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Show recently used apps when hovering near the bottom of the browser window." title="" data-bs-original-title="Help">
                                                    Recent Apps
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="navbarRecentToggler" t-att-checked="this.state.settings.recentApps" t-on-change="(ev) => this.onSettingChange('recentApps', ev)"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                            <div class="sub_style">
                                                <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Enable Enterprise Like App menu" title="" data-bs-original-title="Help">
                                                    Full Screen App menu
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="navbarFullScreenAppToggler" t-on-change="this.onLayoutChange" t-att-checked="this.state.settings.fullScreenApp"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                            <div class="sub_style">
                                                <div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Save menus as favorites and access them by hovering near the right edge of the browser window." title="" data-bs-original-title="Help">
                                                    Menu Bookmark
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="navbarMenuBookmarkToggler" t-att-checked="this.state.settings.infinitoBookmark" t-on-change="(ev) => this.onSettingChange('infinitoBookmark', ev)"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                            <div class="sub_style">
                                                <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Enable RTL" title="" data-bs-original-title="Help">
                                                    RTL
                                                </div>
                                                <label class="switch">
                                                    <input type="checkbox" id="navbarRTLToggler" t-att-checked="this.state.settings.infinitoRtl" t-on-change="(ev) => this.onSettingChange('infinitoRtl', ev)"/>
                                                    <span class="slider round"/>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <div class="sidebar_footer">
                     <a href="#" class="btn btn-submit close_changes" t-on-click="this._Close_changes">Close
                    </a>

                    <a href="#" class="btn btn-submit js_save_changes" t-on-click="this._SaveChanges">Save Changes
                    </a>
                </div>
            </div>
        </t><!--
    Template for the theme editor in the backend theme.
    It consists of a header, a main body, and a preview area.
    -->
    <!--
   Template for the sidebar in the theme editor.
   It contains options to customize the theme elements.
   -->
    <!--
   Template for the advanced theme settings.
   This template contains options for adjusting various settings such as time, hours, minutes, and periods.
   -->
    <t t-name="backend_theme_infinito.saveChanges">
                <Dialog size="'md'" title="'Save Changes'">
        <div class="sidebar_left">
            <div class="wrapper">
                <div class="sub_style">
                    <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Styles applied to the selected element." title="" data-bs-original-title="Help">
                        Style
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="style" checked=""/>
                        <span class="slider round"/>
                    </label>
                </div>
                <div class="sub_style">
                    <div class=" t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Styles applied when hovering over the selected element." title="" data-bs-original-title="Help">
                        Hover
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="hover" checked="false"/>
                        <span class="slider round"/>
                    </label>
                </div>
            </div>
        </div>
                    <t t-set-slot="footer">
            <button class="btn" t-att-class="this.props.confirmClass" t-out="this.props.confirmLabel" t-on-click="this._onClickApply"/>
                        <button class="btn btn-secondary" t-out="this.props.cancelLabel" t-on-click="this.handleCloseDialog"/>
        </t>
    </Dialog>
    </t>
</templates>
