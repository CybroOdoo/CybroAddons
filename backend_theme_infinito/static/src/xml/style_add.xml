<?xml version="1.0" encoding="UTF-8" ?>
<templates>
     <!--
    Template for adding a style property in the backend theme.
    -->
    <t t-name="backend_theme_infinito.StyleAdd">
        <Dialog size="'md'" title="'Select Property'">
            <div class="form-group">
                <label>Search</label>
                <input type="text" class="form-control search_property"
                       t-on-keyup="this._onChange"/>
            </div>
            <br/>
            <div class="form-group">
                <select class="form-control">
                    <t t-foreach="this.props.tools.filter(tool => tool.name.includes(this.state.searchValue))" t-as="tool" t-key="tool.id or tool.name">
                      <option t-att-value="tool.name" t-out="tool.name"/>
                    </t>
                </select>
            </div>
            <t t-set-slot="footer">
                <button class="btn" t-att-class="this.props.confirmClass"
                      t-on-click="this.add"  t-out="this.props.confirmLabel"/>
            </t>
        </Dialog>
    </t>
</templates>