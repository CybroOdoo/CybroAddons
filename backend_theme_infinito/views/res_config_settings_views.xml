<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_infinito" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.infinito</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Infinito Theme" name="backend_theme_infinito" groups="base.group_system">
                    <block title="Theme editing">
                        <setting string="Allow personal theme preferences" help="Internal users can customize their own navigation and appearance. Global CSS remains restricted to Settings administrators.">
                            <field name="is_user_edit"/>
                        </setting>
                    </block>
                    <block title="Global navigation defaults">
                        <setting string="Sidebar"><field name="is_sidebar_enabled"/></setting>
                        <setting string="Sidebar icons"><field name="is_sidebar_icon"/></setting>
                        <setting string="Sidebar names"><field name="is_sidebar_name"/></setting>
                        <setting string="Sidebar company"><field name="is_sidebar_company"/></setting>
                        <setting string="Sidebar user"><field name="is_sidebar_user"/></setting>
                        <setting string="Navbar on hover"><field name="is_fullscreen_enabled"/></setting>
                        <setting string="Recent apps"><field name="is_recent_apps"/></setting>
                        <setting string="Full screen apps"><field name="is_fullscreen_app"/></setting>
                        <setting string="Menu bookmarks"><field name="is_menu_bookmark"/></setting>
                        <setting string="Right-to-left layout"><field name="is_rtl"/></setting>
                    </block>
                    <block title="Global appearance defaults">
                        <setting string="Dark mode">
                            <field name="is_dark"/>
                            <div class="content-group" invisible="not is_dark">
                                <field name="dark_mode"/>
                                <div invisible="dark_mode != 'schedule'">
                                    <label for="dark_start"/>
                                    <field name="dark_start" widget="float_time"/>
                                    <label for="dark_end"/>
                                    <field name="dark_end" widget="float_time"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Loader CSS class" help="Leave as default to use Odoo's standard loading indicator.">
                            <field name="loader_class"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
