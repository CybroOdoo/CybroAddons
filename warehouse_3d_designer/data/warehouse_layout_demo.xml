<?xml version="1.0" encoding="utf-8"?>
<!-- Demo data: warehouse.layout floor plans with placed locations -->
<odoo>
    <data noupdate="1">

        <!-- Layout Settings: Floor 0 -->
        <record id="demo_layout_main" model="warehouse.layout">
            <field name="name">Main Warehouse — Floor 1</field>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="canvas_width">40</field>
            <field name="canvas_height">30</field>
            <field name="grid_size">30</field>
            <field name="cell_size_cm">100</field>
            <field name="measurement_unit">m</field>
            <field name="notes">Demo layout for the default warehouse. Open the Designer to see locations placed on the grid.</field>
        </record>

        <!-- Placed Locations -->

        <!-- Map Objects (Decorations) -->
        <record id="demo_map_obj_1_1" model="warehouse.map.object">
            <field name="name">Room</field>
            <field name="object_type">room</field>
            <field name="pos_x">0</field>
            <field name="pos_y">17</field>
            <field name="size_x">4</field>
            <field name="size_y">9</field>
            <field name="icon">🚪</field>
            <field name="color">#7F8C8D</field>
            <field name="layout_id" ref="demo_layout_main"/>
        </record>
        <!-- Demo rooms on Floor 2 -->
