<?xml version="1.0" encoding="utf-8"?>
<!-- Security rules for Warehouse 3D Designer -->
<odoo>
    <!-- Security groups are inherited from stock module -->
    <!-- stock.group_stock_user: can view layouts and designer (read-only) -->
    <!-- stock.group_stock_manager: can create/edit/delete layouts and save positions -->

    <!-- Multi-company record rule for warehouse.layout -->
    <record id="warehouse_layout_comp_rule" model="ir.rule">
        <field name="name">Warehouse Layout: multi-company</field>
        <field name="model_id" ref="model_warehouse_layout"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
