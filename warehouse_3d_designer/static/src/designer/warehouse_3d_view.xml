<?xml version="1.0" encoding="UTF-8"?>
<!-- OWL template: Warehouse 3D WebGL view component -->
<templates xml:space="preserve">

    <t t-name="warehouse_3d_designer.Warehouse3DView">
        <div class="o_warehouse_3d_wrapper" style="position: relative; width: 100%; height: 100%;">
            <div t-ref="container3d" class="o_warehouse_3d_container"/>
            
            <!-- 3D On-Screen Controls -->
            <div class="o_3d_controls">
                <!-- Pan Controls -->
                <div class="o_3d_ctrl_group o_3d_pan" title="Pan Camera">
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('panUp')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-arrow-up"/></button>
                    <div class="o_3d_ctrl_row">
                        <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('panLeft')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-arrow-left"/></button>
                        <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('panRight')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-arrow-right"/></button>
                    </div>
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('panDown')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-arrow-down"/></button>
                </div>

                <!-- Orbit Controls -->
                <div class="o_3d_ctrl_group o_3d_orbit" title="Rotate Camera">
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('orbitUp')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-chevron-up"/></button>
                    <div class="o_3d_ctrl_row">
                        <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('orbitLeft')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-chevron-left"/></button>
                        <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('orbitRight')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-chevron-right"/></button>
                    </div>
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('orbitDown')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-chevron-down"/></button>
                </div>

                <!-- Zoom & Reset -->
                <div class="o_3d_ctrl_group o_3d_zoom" title="Zoom &amp; Reset">
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('zoomIn')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-plus"/></button>
                    <button class="btn btn-sm" t-on-click="uiResetCamera" title="Reset View"><i class="fa fa-repeat"/></button>
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('zoomOut')" t-on-pointerup="stopAction" t-on-pointerleave="stopAction"><i class="fa fa-minus"/></button>
                </div>
            </div>

            <!-- All Floors toggle (shown when multiple floors exist) -->
            <t t-if="props.siblingFloors and props.siblingFloors.length > 1">
                <div class="o_3d_floor_toggle">
                    <button class="btn btn-sm"
                            t-att-class="{'btn-info': props.showAllFloors, 'btn-outline-light': !props.showAllFloors}"
                            t-on-click="() => this.props.onToggleAllFloors()"
                            title="Show all floors stacked in 3D">
                        <i class="fa fa-building me-1"/>
                        <t t-if="props.showAllFloors">Hide Floors</t>
                        <t t-else="">All Floors</t>
                    </button>
                </div>
            </t>
        </div>
    </t>

</templates>
