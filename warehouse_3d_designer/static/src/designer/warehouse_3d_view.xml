<?xml version="1.0" encoding="UTF-8"?>
<!-- OWL template: Warehouse 3D WebGL view component -->
<templates xml:space="preserve">

    <t t-name="warehouse_3d_designer.Warehouse3DView">
        <div class="o_warehouse_3d_wrapper" style="position: relative; width: 100%; height: 100%;">
            <div t-ref="this.containerRef" class="o_warehouse_3d_container"/>

            <!-- 3D On-Screen Controls -->
            <div class="o_3d_controls">
                <!-- Pan Controls -->
                <div class="o_3d_ctrl_group o_3d_pan" title="Pan Camera">
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('panUp')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="arrow_upward"/></button>
                    <div class="o_3d_ctrl_row">
                        <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('panLeft')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="arrow_back"/></button>
                        <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('panRight')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="arrow_forward"/></button>
                    </div>
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('panDown')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="arrow_downward"/></button>
                </div>

                <!-- Orbit Controls -->
                <div class="o_3d_ctrl_group o_3d_orbit" title="Rotate Camera">
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('orbitUp')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="keyboard_arrow_up"/></button>
                    <div class="o_3d_ctrl_row">
                        <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('orbitLeft')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="keyboard_arrow_left"/></button>
                        <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('orbitRight')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="keyboard_arrow_right"/></button>
                    </div>
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('orbitDown')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="keyboard_arrow_down"/></button>
                </div>

                <!-- Zoom & Reset -->
                <div class="o_3d_ctrl_group o_3d_zoom" title="Zoom &amp; Reset">
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('zoomIn')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="add"/></button>
                    <button class="btn btn-sm" t-on-click="this.uiResetCamera" title="Reset View"><i class="oi" data-icon="rotate_right"/></button>
                    <button class="btn btn-sm" t-on-pointerdown="() => this.startAction('zoomOut')" t-on-pointerup="this.stopAction" t-on-pointerleave="this.stopAction"><i class="oi" data-icon="remove"/></button>
                </div>
            </div>

            <!-- All Floors toggle (shown when multiple floors exist) -->
            <t t-if="this.props.siblingFloors and this.props.siblingFloors.length > 1">
                <div class="o_3d_floor_toggle">
                    <button class="btn btn-sm"
                            t-att-class="{'btn-info': this.props.showAllFloors, 'btn-outline-light': !this.props.showAllFloors}"
                            t-on-click="() => this.props.onToggleAllFloors()"
                            title="Show all floors stacked in 3D">
                        <i class="oi me-1" data-icon="business"/>
                        <t t-if="this.props.showAllFloors">Hide Floors</t>
                        <t t-else="">All Floors</t>
                    </button>
                </div>
            </t>
        </div>
    </t>

</templates>
