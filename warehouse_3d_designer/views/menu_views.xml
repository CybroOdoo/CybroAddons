<?xml version="1.0" encoding="utf-8"?>
<!-- Client actions and menu items for Warehouse Designer -->
<odoo>

    <!-- Client Action: Warehouse Designer (admin — full editing) -->
    <record id="action_warehouse_designer" model="ir.actions.client">
        <field name="name">Warehouse Designer</field>
        <field name="tag">warehouse_designer</field>
    </record>

    <!-- Client Action: Warehouse Map (all users — read-only view) -->
    <record id="action_warehouse_map_viewer" model="ir.actions.client">
        <field name="name">Warehouse Map</field>
        <field name="tag">warehouse_map_viewer</field>
    </record>

    <!-- Menu: Under Inventory > Configuration > Warehouse Layouts (managers only) -->
    <menuitem id="menu_warehouse_layout"
        name="Warehouse Layouts"
        parent="stock.menu_warehouse_config"
        action="action_warehouse_layout"
        groups="stock.group_stock_manager"
        sequence="20"/>

    <!-- Menu: Under Inventory > Reporting > Warehouse Designer (managers only) -->
    <menuitem id="menu_warehouse_designer"
        name="Warehouse Designer"
        parent="stock.menu_warehouse_report"
        action="action_warehouse_designer"
        groups="stock.group_stock_manager"
        sequence="100"/>

    <!-- Menu: Under Inventory > Reporting > Warehouse Map (all stock users) -->
    <menuitem id="menu_warehouse_map_viewer"
        name="Warehouse Map"
        parent="stock.menu_warehouse_report"
        action="action_warehouse_map_viewer"
        groups="stock.group_stock_user"
        sequence="101"/>

</odoo>
