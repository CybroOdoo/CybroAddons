<?xml version="1.0" encoding="utf-8"?>
<!-- Inherited stock.location form: Designer placement fields -->
<odoo>

    <!-- Extend stock.location form: add Designer tab -->
    <record id="view_location_form_inherit_designer" model="ir.ui.view">
        <field name="name">stock.location.form.inherit.warehouse_3d_designer</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[last()]" position="after">
                <group string="Designer Placement" name="designer_placement" invisible="usage not in ('internal',)">
                    <group>
                        <field name="layout_id" options="{'no_create': True}"/>
                        <field name="location_shape"/>
                        <field name="shelf_rows" invisible="location_shape != 'shelf'"/>
                        <field name="location_color" widget="color"/>
                    </group>
                    <group>
                        <label for="pos_x" string="Position"/>
                        <div class="o_row">
                            <span>X:</span>
                            <field name="pos_x" nolabel="1" class="oe_inline" style="width: 50px;"/>
                            <span>Y:</span>
                            <field name="pos_y" nolabel="1" class="oe_inline" style="width: 50px;"/>
                        </div>
                        <label for="size_x" string="Size"/>
                        <div class="o_row">
                            <field name="size_x" nolabel="1" class="oe_inline" style="width: 50px;"/>
                            <span> × </span>
                            <field name="size_y" nolabel="1" class="oe_inline" style="width: 50px;"/>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
