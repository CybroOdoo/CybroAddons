<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Dedicated user list view used only by the Monday action-->
    <record id="res_users_monday_view_list" model="ir.ui.view">
        <field name="name">res.users.monday.view.list</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="export_xlsx">0</attribute>
            </xpath>
        </field>
    </record>
    <!--    Dedicated user form view used only by the Monday action-->
    <record id="res_users_monday_view_form" model="ir.ui.view">
        <field name="name">res.users.monday.view.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
        </field>
    </record>
    <!--    Monday Users menu action-->
    <record id="res_user_action" model="ir.actions.act_window">
        <field name="name">Monday Users</field>
        <field name="res_model">res.users</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('monday_reference', '!=', False)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('res_users_monday_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('res_users_monday_view_form')})]"/>
    </record>
    <!--    Users menu-->
    <menuitem
            id="res_user_menu"
            name="Users"
            parent="monday_imported_menu"
            action="res_user_action"
            sequence="4"/>
</odoo>
