<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- This file defines the inspection fail wizard view. -->
<record id="view_oil_inspection_fail_wizard_form" model="ir.ui.view">
        <field name="name">oil.inspection.fail.wizard.form</field>
        <field name="model">oil.inspection.fail.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Scrap Movement">
                <sheet>
                    <p class="oe_grey">
                        One or more checklist items have failed. To mark this
                        inspection as Failed,
                        you must move the production output to a scrap location.
                    </p>
                    <group>
                        <group name="inspection">
                            <field name="inspection_id" readonly="1"
                                   force_save="1"/>
                            <field name="product_id" readonly="1"
                                   force_save="1"/>
                        </group>
                        <group name="scrap">
                            <label for="scrap_qty" string="Quantity to Scrap"/>
                            <div class="o_row">
                                <field name="scrap_qty" class="oe_inline"/>
                                <span class="text-muted">/
                                    <field name="quantity" class="oe_inline"
                                           readonly="1"/>
                                </span>
                            </div>
                            <field name="scrap_location_id"
                                   options="{'no_create': True}"/>
                            <field name="scrap_reason"
                                   placeholder="e.g. Dimensions out of tolerance"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_scrap" string="Confirm &amp; Scrap"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
