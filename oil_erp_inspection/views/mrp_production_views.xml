<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the production inspection views. -->

    <record id="view_mrp_production_inspection" model="ir.ui.view">
        <field name="name">mrp.production.inspection</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Smart button: shows inspection count, visible once any exist -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_inspections"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-square-o"
                        invisible="inspection_count == 0">
                    <field name="inspection_count" widget="statinfo" string="Inspections"/>
                </button>
            </xpath>

            <!-- "Inspect" action button in the header — appears only when MO is done -->
            <xpath expr="//header/button[last()]" position="after">
                <button name="action_create_inspection"
                        string="Quality Check"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'done'"/>
            </xpath>


        </field>
    </record>

</odoo>
