<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Inspection Reporting -->
    <record id="view_oil_inspection_order_pivot" model="ir.ui.view">
        <field name="name">oil.inspection.order.pivot</field>
        <field name="model">oil.inspection.order</field>
        <field name="arch" type="xml">
            <pivot string="Inspection Analysis" display_quantity="1" sample="1">
                <field name="result" type="row"/>
                <field name="product_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_oil_inspection_order_graph" model="ir.ui.view">
        <field name="name">oil.inspection.order.graph</field>
        <field name="model">oil.inspection.order</field>
        <field name="arch" type="xml">
            <graph string="Inspection Analysis" type="pie" sample="1">
                <field name="result"/>
            </graph>
        </field>
    </record>

    <record id="action_oil_inspection_reporting" model="ir.actions.act_window">
        <field name="name">Inspection Pass/Fail Ratio</field>
        <field name="res_model">oil.inspection.order</field>
        <field name="view_mode">pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No inspections found for reporting.
            </p>
        </field>
    </record>

    <!-- 2. Work Orders (MOs) Reporting -->
    <record id="view_mrp_production_oil_pivot" model="ir.ui.view">
        <field name="name">mrp.production.oil.pivot</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <pivot string="Work Order Analysis" display_quantity="1" sample="1">
                <field name="state" type="row"/>
                <field name="product_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_mrp_production_oil_graph" model="ir.ui.view">
        <field name="name">mrp.production.oil.graph</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <graph string="Work Order Analysis" type="bar" sample="1">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="action_oil_mrp_reporting" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No work orders (manufacturing orders) found.
            </p>
        </field>
    </record>

    <!-- Menu Items in Reporting > Downstream -->
    <menuitem id="menu_oil_reporting_downstream_inspections"
              name="Inspection Pass/Fail Ratio"
              parent="oil_erp_base.menu_oil_reporting_downstream"
              action="action_oil_inspection_reporting"
              sequence="10"/>

    <menuitem id="menu_oil_reporting_downstream_mrp"
              name="Work Orders"
              parent="oil_erp_base.menu_oil_reporting_downstream"
              action="action_oil_mrp_reporting"
              sequence="20"/>
</odoo>
