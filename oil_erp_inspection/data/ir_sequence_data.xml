<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file loads the ir sequence data. -->
    <data noupdate="1">
        <record id="seq_oil_inspection_order" model="ir.sequence">
            <field name="name">Oil Inspection Order</field>
            <field name="code">oil.inspection.order</field>
            <field name="prefix">INSP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
