<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the oil inspection security rules and groups. -->
    <data noupdate="1">
        <record id="oil_inspection_point_rule_company" model="ir.rule">
            <field name="name">Oil Inspection Point: multi-company</field>
            <field name="model_id" ref="model_oil_inspection_point"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="oil_inspection_order_rule_company" model="ir.rule">
            <field name="name">Oil Inspection Order: multi-company</field>
            <field name="model_id" ref="model_oil_inspection_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
