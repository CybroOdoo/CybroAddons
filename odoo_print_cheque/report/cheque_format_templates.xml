<?xml version="1.0" encoding="utf-8" ?>
<odoo>   <!--Cheque print template-->
    <template id="cheque_print">
        <t t-call="web.html_container">
            <t t-foreach="pages" t-as="page">
                <t t-call="web.basic_layout">
                    <div t-attf-style="width:{{cheque_width}}px; height:{{cheque_height}}px; font-size:{{font_size}}px; page-break-after: always;">
                        <!--Account payee cheque format-->
                        <div t-if="is_account_payee">
                            <img src="odoo_print_cheque/static/src/img/accountpay.png"
                                 t-attf-style="margin-left:{{a_c_payee_left_margin}}px; margin-top:{{a_c_payee_top_margin}}px; width:{{a_c_payee_width}}px; height:{{a_c_payee_height}}px"/>
                        </div>
                        <!--Cheque sequence number format-->
                        <div t-attf-style="margin-left:{{cheque_no_lm}}px; margin-top:{{cheque_no_tm}}px;">
                            <t t-if="is_print_cheque_number">
                                <span>
                                    <t t-esc="page['check_number']"/>
                                </span>
                            </t>
                            <t t-else=""/>
                        </div>
                        <!--Cheque date format-->
                        <div t-attf-style="margin-left:{{date_left_margin}}px; margin-top:{{date_top_margin}}px; letter-spacing: {{date_letter_spacing}}em;">
                            <t t-esc="page['cheque_date']"/>
                        </div>
                        <!--Partner Name format-->
                        <div t-attf-style="margin-left:{{beneficiary_left_margin}}px; margin-top:{{beneficiary_top_margin}}px;">
                            <t t-esc="page['partner']"/>
                        </div>
                        <!-- Amount in words format-->
                        <div t-attf-style="margin-left:{{amount_word_lm}}px; margin-top:{{amount_word_tm}}px; letter-spacing: {{amount_word_ls}}em;">
                            <t t-esc="page['amount_in_words']"/>
                            Only
                        </div>
                        <!--Amount in digits format-->
                        <div t-attf-style="margin-left:{{amount_digit_lm}}px; margin-top:{{amount_digit_tm}}px; letter-spacing: {{amount_digit_ls}}em; font-size:{{amount_digit_size}}px;">
                            <t t-if="is_print_currency">
                                <t t-esc="currency_symbol"/>
                            </t>
                            <t t-esc="page['amount_in_digit']"/>/-
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!--Test cheque print template-->
    <template id="cheque_test_print">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div t-attf-style="border:1px solid black; width:{{cheque_width or 600}}px; height:{{cheque_height or 300}}px; font-size:{{font_size or 12}}px;">
                    <!-- Account payee cheque format -->
                    <div t-if="is_account_payee">
                        <img t-att-src="'/odoo_print_cheque/static/src/img/accountpay.png'"
                             t-attf-style="margin-left:{{a_c_payee_left_margin or 0}}px; margin-top:{{a_c_payee_top_margin or 0}}px;
                                       width:{{a_c_payee_width or 50}}px; height:{{a_c_payee_height or 20}}px"/>
                    </div>

                    <!-- Cheque sequence number -->
                    <span t-attf-style="margin-left:{{cheque_no_lm or 0}}px; margin-top:{{cheque_no_tm or 0}}px;">
                        <t t-if="is_print_cheque_number">
                            <span>0000001</span>
                        </t>
                    </span>

                    <!-- Cheque date -->
                    <span t-attf-style="margin-left:{{date_left_margin or 0}}px; margin-top:{{date_top_margin or 0}}px; letter-spacing:{{date_letter_spacing or 0}}em;">
                        <t t-if="is_date_remove_slashes">
                            30 08 2001
                        </t>
                        <t t-else="">
                            30/08/2001
                        </t>
                    </span>

                    <!-- Partner Name -->
                    <span t-attf-style="margin-left:{{beneficiary_left_margin or 0}}px; margin-top:{{beneficiary_top_margin or 0}}px;">
                        Test Customer
                    </span>

                    <!-- Amount in Words -->
                    <span t-attf-style="margin-left:{{amount_word_lm or 0}}px; margin-top:{{amount_word_tm or 0}}px; letter-spacing:{{amount_word_ls or 0}}em;">
                        One Million, Two Hundred And Forty Thousand, Six Hundred And Twelve Dollars
                    </span>

                    <!-- Amount in Digits -->
                    <span t-attf-style="margin-left:{{amount_digit_lm or 0}}px; margin-top:{{amount_digit_tm or 0}}px; letter-spacing:{{amount_digit_ls or 0}}em;
                                    font-size:{{amount_digit_size or 14}}px;">
                        <t t-if="is_print_currency">
                            <t t-esc="currency_symbol"/>
                        </t>
                        12,40,612 /-
                    </span>
                </div>
            </t>
        </t>
    </template>
</odoo>
