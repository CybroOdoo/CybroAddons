<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Show, hide and mark the address fields according to the module
         settings. The core address form is kept and only extended. -->
    <template id="address_form_fields"
              inherit_id="website_sale.address_form_fields">
        <xpath expr="//div[@id='div_name']" position="before">
            <t t-set="addr_cfg"
               t-value="request.env['res.config.settings'].sudo().get_address_field_config(address_type)"/>
        </xpath>
        <xpath expr="//div[@id='div_phone']" position="attributes">
            <attribute name="t-if">addr_cfg['phone']['visible']</attribute>
        </xpath>
        <xpath expr="//div[@id='div_street']" position="attributes">
            <attribute name="t-if">addr_cfg['street']['visible']</attribute>
        </xpath>
        <xpath expr="//div[@id='div_street2']" position="attributes">
            <attribute name="t-if">addr_cfg['street2']['visible']</attribute>
        </xpath>
        <xpath expr="//div[@id='div_city']" position="attributes">
            <attribute name="t-if">addr_cfg['city']['visible']</attribute>
        </xpath>
        <xpath expr="//t[@t-if='zip_before_city']/div[@id='div_zip']"
               position="attributes">
            <attribute name="t-if">addr_cfg['zip']['visible']</attribute>
        </xpath>
        <xpath expr="//t[@t-if='not zip_before_city']/div[@id='div_zip']"
               position="attributes">
            <attribute name="t-if">addr_cfg['zip']['visible']</attribute>
        </xpath>
    </template>
</odoo>
