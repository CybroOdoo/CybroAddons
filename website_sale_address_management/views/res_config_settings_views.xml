<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.sale.address.management</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_info_settings" position="after">
                <block title="eCommerce Billing Address" id="website_billing_address_settings">
                    <setting id="billing_phone_setting" string="Phone"
                             help="Show the phone field in the billing address form.">
                        <field name="is_billing_phone"/>
                        <div class="content-group mt8" invisible="not is_billing_phone">
                            <field name="is_billing_phone_is_required"/>
                            <label for="is_billing_phone_is_required" string="Required"/>
                        </div>
                    </setting>
                    <setting id="billing_street_setting" string="Street"
                             help="Show the street field in the billing address form.">
                        <field name="is_billing_street"/>
                        <div class="content-group mt8" invisible="not is_billing_street">
                            <field name="is_billing_street_is_required"/>
                            <label for="is_billing_street_is_required" string="Required"/>
                        </div>
                    </setting>
                    <setting id="billing_street2_setting" string="Street 2"
                             help="Show the street 2 field in the billing address form.">
                        <field name="is_billing_street2"/>
                    </setting>
                    <setting id="billing_city_setting" string="City"
                             help="Show the city field in the billing address form.">
                        <field name="is_billing_city"/>
                        <div class="content-group mt8" invisible="not is_billing_city">
                            <field name="is_billing_city_is_required"/>
                            <label for="is_billing_city_is_required" string="Required"/>
                        </div>
                    </setting>
                    <setting id="billing_zip_code_setting" string="ZIP Code"
                             help="Show the ZIP code field in the billing address form.">
                        <field name="is_billing_zip_code"/>
                        <div class="content-group mt8" invisible="not is_billing_zip_code">
                            <field name="is_billing_zip_code_is_required"/>
                            <label for="is_billing_zip_code_is_required" string="Required"/>
                        </div>
                    </setting>
                    <setting id="billing_country_setting" string="Default Country"
                             help="Country preselected in the billing address form.">
                        <field name="billing_country_id" options="{'no_create': True, 'no_open': True}"/>
                    </setting>
                </block>
                <block title="eCommerce Shipping Address" id="website_shipping_address_settings">
                    <setting id="shipping_phone_setting" string="Phone"
                             help="Show the phone field in the shipping address form.">
                        <field name="is_shipping_phone"/>
                        <div class="content-group mt8" invisible="not is_shipping_phone">
                            <field name="is_shipping_phone_is_required"/>
                            <label for="is_shipping_phone_is_required" string="Required"/>
                        </div>
                    </setting>
                    <setting id="shipping_street_setting" string="Street"
                             help="Show the street field in the shipping address form.">
                        <field name="is_shipping_street"/>
                        <div class="content-group mt8" invisible="not is_shipping_street">
                            <field name="is_shipping_street_is_required"/>
                            <label for="is_shipping_street_is_required" string="Required"/>
                        </div>
                    </setting>
                    <setting id="shipping_street2_setting" string="Street 2"
                             help="Show the street 2 field in the shipping address form.">
                        <field name="is_shipping_street2"/>
                    </setting>
                    <setting id="shipping_city_setting" string="City"
                             help="Show the city field in the shipping address form.">
                        <field name="is_shipping_city"/>
                        <div class="content-group mt8" invisible="not is_shipping_city">
                            <field name="is_shipping_city_is_required"/>
                            <label for="is_shipping_city_is_required" string="Required"/>
                        </div>
                    </setting>
                    <setting id="shipping_zip_code_setting" string="ZIP Code"
                             help="Show the ZIP code field in the shipping address form.">
                        <field name="is_shipping_zip_code"/>
                        <div class="content-group mt8" invisible="not is_shipping_zip_code">
                            <field name="is_shipping_zip_code_is_required"/>
                            <label for="is_shipping_zip_code_is_required" string="Required"/>
                        </div>
                    </setting>
                    <setting id="shipping_country_setting" string="Default Country"
                             help="Country preselected in the shipping address form.">
                        <field name="shipping_country_id" options="{'no_create': True, 'no_open': True}"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
