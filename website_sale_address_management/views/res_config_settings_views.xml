<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_website_sale_address_management" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.sale.address.management</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_info_settings" position="after">
                <block id="website_address_management_block">
                    <div class="card border rounded my-3 w-100 p-0 shadow-sm overflow-hidden">
                        <div class="card-header bg-light py-2 px-3 fw-bold text-dark border-bottom fs-6">
                            eCommerce Address
                        </div>
                        <div class="card-body p-4 bg-white">
                            <div class="row">
                                <!-- Billing Address Column -->
                                <div class="col-12 col-lg-6 pe-lg-4 border-end">
                                    <h5 class="fw-bold mb-4 text-dark">Billing Address</h5>

                                    <!-- Phone -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">Phone</span>
                                        </div>
                                        <div class="col-2">
                                            <field name="is_billing_phone" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                        <div class="col-3">
                                            <span class="text-dark text-nowrap">required</span>
                                        </div>
                                        <div class="col-3">
                                            <field name="is_billing_phone_is_required" widget="boolean_toggle" readonly="not is_billing_phone" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- Street -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">Street</span>
                                        </div>
                                        <div class="col-2">
                                            <field name="is_billing_street" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                        <div class="col-3">
                                            <span class="text-dark text-nowrap">required</span>
                                        </div>
                                        <div class="col-3">
                                            <field name="is_billing_street_is_required" widget="boolean_toggle" readonly="not is_billing_street" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- Street2 -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">Street2</span>
                                        </div>
                                        <div class="col-8">
                                            <field name="is_billing_street2" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- City -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">City</span>
                                        </div>
                                        <div class="col-2">
                                            <field name="is_billing_city" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                        <div class="col-3">
                                            <span class="text-dark text-nowrap">required</span>
                                        </div>
                                        <div class="col-3">
                                            <field name="is_billing_city_is_required" widget="boolean_toggle" readonly="not is_billing_city" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- Default Country -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">Default Country</span>
                                        </div>
                                        <div class="col-8">
                                            <field name="billing_country_id" options="{'no_create': True, 'no_open': True}" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- ZIP Code -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">ZIP Code</span>
                                        </div>
                                        <div class="col-2">
                                            <field name="is_billing_zip_code" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                        <div class="col-3">
                                            <span class="text-dark text-nowrap">required</span>
                                        </div>
                                        <div class="col-3">
                                            <field name="is_billing_zip_code_is_required" widget="boolean_toggle" readonly="not is_billing_zip_code" class="mb-0"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Shipping Address Column -->
                                <div class="col-12 col-lg-6 ps-lg-4">
                                    <h5 class="fw-bold mb-4 text-dark">Shipping Address</h5>

                                    <!-- Phone -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">Phone</span>
                                        </div>
                                        <div class="col-2">
                                            <field name="is_shipping_phone" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                        <div class="col-3">
                                            <span class="text-dark text-nowrap">required</span>
                                        </div>
                                        <div class="col-3">
                                            <field name="is_shipping_phone_is_required" widget="boolean_toggle" readonly="not is_shipping_phone" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- Street -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">Street</span>
                                        </div>
                                        <div class="col-2">
                                            <field name="is_shipping_street" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                        <div class="col-3">
                                            <span class="text-dark text-nowrap">required</span>
                                        </div>
                                        <div class="col-3">
                                            <field name="is_shipping_street_is_required" widget="boolean_toggle" readonly="not is_shipping_street" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- Street2 -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">Street2</span>
                                        </div>
                                        <div class="col-8">
                                            <field name="is_shipping_street2" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- City -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">City</span>
                                        </div>
                                        <div class="col-2">
                                            <field name="is_shipping_city" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                        <div class="col-3">
                                            <span class="text-dark text-nowrap">required</span>
                                        </div>
                                        <div class="col-3">
                                            <field name="is_shipping_city_is_required" widget="boolean_toggle" readonly="not is_shipping_city" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- Default Country -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">Default Country</span>
                                        </div>
                                        <div class="col-8">
                                            <field name="shipping_country_id" options="{'no_create': True, 'no_open': True}" class="mb-0"/>
                                        </div>
                                    </div>

                                    <!-- ZIP Code -->
                                    <div class="row align-items-center mb-3 gx-2">
                                        <div class="col-4">
                                            <span class="fw-semibold text-dark text-nowrap">ZIP Code</span>
                                        </div>
                                        <div class="col-2">
                                            <field name="is_shipping_zip_code" widget="boolean_toggle" class="mb-0"/>
                                        </div>
                                        <div class="col-3">
                                            <span class="text-dark text-nowrap">required</span>
                                        </div>
                                        <div class="col-3">
                                            <field name="is_shipping_zip_code_is_required" widget="boolean_toggle" readonly="not is_shipping_zip_code" class="mb-0"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </block>
            </block>
        </field>
    </record>
</odoo>
