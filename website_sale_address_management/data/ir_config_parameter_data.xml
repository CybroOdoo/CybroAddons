<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Default visibility: the standard address fields stay visible on a
         fresh install; the "required" flags stay off until configured. -->
    <record id="param_billing_phone" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_billing_phone</field>
        <field name="value">True</field>
    </record>
    <record id="param_billing_street" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_billing_street</field>
        <field name="value">True</field>
    </record>
    <record id="param_billing_street2" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_billing_street2</field>
        <field name="value">True</field>
    </record>
    <record id="param_billing_city" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_billing_city</field>
        <field name="value">True</field>
    </record>
    <record id="param_billing_zip_code" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_billing_zip_code</field>
        <field name="value">True</field>
    </record>
    <record id="param_shipping_phone" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_shipping_phone</field>
        <field name="value">True</field>
    </record>
    <record id="param_shipping_street" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_shipping_street</field>
        <field name="value">True</field>
    </record>
    <record id="param_shipping_street2" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_shipping_street2</field>
        <field name="value">True</field>
    </record>
    <record id="param_shipping_city" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_shipping_city</field>
        <field name="value">True</field>
    </record>
    <record id="param_shipping_zip_code" model="ir.config_parameter">
        <field name="key">website_sale_address_management.is_shipping_zip_code</field>
        <field name="value">True</field>
    </record>
</odoo>
