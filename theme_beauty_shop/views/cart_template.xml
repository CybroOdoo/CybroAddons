<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cart page customization for Beauty Shop Theme -->
    <template id="beauty_shop_cart" inherit_id="website_sale.cart" name="Beauty Shop Cart">
        <xpath expr="//t[@t-call='website_sale.checkout_layout']" position="replace">
            <t t-call="website.layout">
                <t t-set="additional_title">Shopping Cart</t>
                <div id="wrap" class="oe_website_sale js_sale">
                    <!-- Cart hero -->
                    <section class="cart-hero">
                        <div class="container">
                            <nav class="breadcrumb-nav" aria-label="breadcrumb">
                                <a href="/">Home</a>
                                <i class="bi bi-chevron-right"/>
                                <span>Shopping Cart</span>
                            </nav>
                            <div class="row align-items-end g-3">
                                <div class="col-md-8">
                                    <h1 class="cart-title">Your <em>cart</em></h1>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <span class="cart-count">
                                        <strong>
                                            <t t-out="website_sale_order.cart_quantity if website_sale_order else 0"/>
                                            items
                                        </strong> in your bag
                                    </span>
                                </div>
                            </div>
                            <!-- Progress steps -->
                            <ol class="cart-steps">
                                <li class="active">
                                    <span class="step-circle">1</span>
                                    <div><strong>Cart</strong><small>Review items</small></div>
                                </li>
                                <li>
                                    <span class="step-circle">2</span>
                                    <div><strong>Shipping</strong><small>Where to deliver</small></div>
                                </li>
                                <li>
                                    <span class="step-circle">3</span>
                                    <div><strong>Payment</strong><small>Secure checkout</small></div>
                                </li>
                                <li>
                                    <span class="step-circle"><i class="bi bi-check"/></span>
                                    <div><strong>Done</strong><small>Order confirmed</small></div>
                                </li>
                            </ol>
                        </div>
                    </section>
                    <!-- Cart main -->
                    <section class="cart-main" id="cart-main">
                        <div class="container">
                            <div class="row g-4 g-lg-5">
                                <!-- Items column -->
                                <div class="col-lg-8 cart-items-col oe_cart" id="shop_cart">
                                    <!-- Free shipping progress placeholder -->
                                    <div class="ship-progress">
                                        <div class="sp-text">
                                            <i class="bi bi-truck"/>
                                            <span>You're <strong>$6.00</strong> away from free shipping!</span>
                                        </div>
                                        <div class="sp-bar"><span style="width: 88%"/></div>
                                    </div>
                                    <t t-call="website_sale.cart_lines"/>
                                    <!-- Cart footer actions -->
                                    <div class="cart-foot">
                                        <a href="/shop" class="continue-link">
                                            <i class="bi bi-arrow-left"/> Continue shopping
                                        </a>
                                        <a href="/beauty/cart/clear" class="btn btn-link clear-cart text-muted">
                                            <i class="bi bi-trash"/> Clear cart
                                        </a>
                                    </div>
                                    <!-- Gift wrap toggle -->
                                    <div class="addon-card mt-4">
                                        <label class="addon-toggle">
                                            <input type="checkbox"/>
                                            <span class="addon-box">
                                                <i class="bi bi-gift"/>
                                                <div>
                                                    <strong>Add gift wrapping</strong>
                                                    <small>Recycled kraft box, ribbon &amp; handwritten note · $5.00</small>
                                                </div>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="oe_structure" id="oe_structure_website_sale_cart_1"/>
                                </div>
                                <!-- Summary sidebar -->
                                <aside class="col-lg-4">
                                    <div class="cart-summary" id="o_cart_summary">
                                        <h3 class="summary-title">Order summary</h3>
                                        <!-- Promo code (Odoo native) -->
                                        <div class="promo-row mb-3">
                                            <t t-call="website_sale.coupon_form"/>
                                        </div>
                                        <!-- Totals (Odoo native) -->
                                        <t t-call="website_sale.total"/>
                                        <!-- Checkout button -->
                                        <a href="/shop/checkout" class="btn-routine cart-checkout w-100 mt-4 d-flex justify-content-center align-items-center text-center text-decoration-none">
                                            <span>Secure Checkout</span>
                                            <span class="arrow-chip ms-2"><i class="bi bi-arrow-up-right"/></span>
                                        </a>
                                        <!-- Trust info -->
                                        <ul class="summary-trust mt-4">
                                            <li><i class="bi bi-shield-lock"/> 256-bit SSL secure checkout</li>
                                            <li><i class="bi bi-arrow-repeat"/> 30-day hassle-free returns</li>
                                            <li><i class="bi bi-truck"/> Tracked shipping on every order</li>
                                        </ul>
                                        <!-- Payment methods -->
                                        <div class="pay-row mt-3">
                                            <small>We accept</small>
                                            <div class="pay-icons">
                                                <span title="Visa"><i class="bi bi-credit-card-2-front"/></span>
                                                <span title="Mastercard"><i class="bi bi-credit-card"/></span>
                                                <span title="PayPal"><i class="bi bi-paypal"/></span>
                                                <span title="Apple Pay"><i class="bi bi-apple"/></span>
                                                <span title="Google Pay"><i class="bi bi-google"/></span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Help card -->
                                    <div class="help-card mt-4">
                                        <i class="bi bi-headset"/>
                                        <div>
                                            <strong>Need help with your order?</strong>
                                            <small>Chat with us 9am–6pm PT · <a href="/contactus">Contact us</a></small>
                                        </div>
                                    </div>
                                </aside>

                            </div>
                        </div>
                    </section>
                    <!-- Recommendations -->
                    <section class="cart-related">
                        <div class="container">
                            <div class="d-flex justify-content-between align-items-end mb-4">
                                <div>
                                    <span class="eyebrow">— Customers also bought</span>
                                    <h2 class="rel-title">Complete your <em>routine</em></h2>
                                </div>
                                <a href="/shop" class="btn-routine sm d-none d-md-inline-flex">
                                    <span>Shop all</span>
                                    <span class="arrow-chip"><i class="bi bi-arrow-up-right"/></span>
                                </a>
                            </div>
                            <div class="row g-3 g-md-4">
                                <t t-set="routine_products" t-value="request.env['product.template'].search([('website_published', '=', True)], limit=4)"/>
                                <t t-foreach="routine_products" t-as="r_product">
                                    <div class="col-6 col-md-3">
                                        <form action="/beauty/cart/update" method="post" class="product-card h-100"
                                              t-att-data-publish="r_product.website_published and 'on' or 'off'" itemscope="itemscope">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="product_id"
                                                   t-att-value="r_product.product_variant_ids[0].id if r_product.product_variant_ids else r_product.id"/>
                                            <div class="product-media tone-mint">
                                                <a t-att-href="r_product.website_url">
                                                    <span t-field="r_product.image_1920"
                                                          t-options="{'widget': 'image', 'class': 'product-img'}"/>
                                                </a>
                                                <button type="submit" class="quick-add">
                                                    <i class="bi bi-bag-plus me-2"/>Add to Cart
                                                </button>
                                            </div>
                                            <div class="product-body">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <small class="cat-label">
                                                        <t t-out="r_product.public_categ_ids[0].name if r_product.public_categ_ids else 'Shop'"/>
                                                    </small>
                                                </div>
                                                <h3 class="product-title">
                                                    <a t-att-href="r_product.website_url">
                                                        <t t-out="r_product.name"/>
                                                    </a>
                                                </h3>
                                                <div class="price">
                                                    <t t-set="r_combo" t-value="r_product._get_combination_info()"/>
                                                    <span t-out="r_combo['price']"
                                                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </section>
                    <div class="oe_structure" id="oe_structure_website_sale_cart_2"/>
                </div>
            </t>
        </xpath>
    </template>
    <!-- Override Cart Lines to match the Glowing design -->
    <template id="beauty_shop_cart_lines" inherit_id="website_sale.cart_lines" name="Beauty Shop Cart Lines">
        <!-- Replace the empty-cart alert -->
        <xpath expr="//div[hasclass('js_cart_lines') and not(@id='cart_products')]" position="replace">
            <div t-if="not website_sale_order or not website_sale_order.website_order_line"
                 class="js_cart_lines py-5 text-center w-100">
                <i class="bi bi-handbag" style="font-size:2.5rem;color:#999;"/>
                <h4 class="mt-3 mb-2">Your cart is empty!</h4>
                <p class="text-muted mb-4">Looks like you haven't added anything yet.</p>
                <a href="/shop" class="btn btn-dark rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"/> Start shopping
                </a>
            </div>
        </xpath>
        <!-- Replace the products container with Glowing-styled items -->
        <xpath expr="//div[@id='cart_products']" position="replace">
            <div id="cart_products"
                 class="cart-items js_cart_lines"
                 t-if="website_sale_order and website_sale_order.website_order_line">
                <t t-foreach="website_sale_order.website_order_line" t-as="line">
                    <t t-if="line.product_id">
                        <article class="cart-item o_cart_product"
                                 t-attf-data-product-id="#{line.product_id.id}">
                            <!-- Product image -->
                            <a t-att-href="line.product_id.website_url" class="ci-image">
                                <t t-if="line._is_not_sellable_line() and line.product_id.image_128">
                                    <img t-att-src="image_data_uri(line.product_id.image_128)"
                                         class="img-fluid"
                                         t-att-alt="line.name_short"/>
                                </t>
                                <t t-else="">
                                     <span t-field="line.product_id.image_128"
                                          t-options="{'widget': 'image', 'qweb_img_responsive': False}"/>
                                </t>
                            </a>
                            <!-- Details -->
                            <div class="ci-details">
                                <small class="ci-cat" t-if="line.product_id.public_categ_ids">
                                    <t t-out="line.product_id.public_categ_ids[0].name"/>
                                </small>
                                <h3 class="ci-title">
                                    <a t-att-href="line.product_id.website_url">
                                        <t t-out="line.name_short"/>
                                    </a>
                                </h3>
                                <!-- Variant / description lines -->
                                <t t-set="desc_lines" t-value="line.get_description_following_lines()"/>
                                <ul class="ci-variants" t-if="desc_lines">
                                    <t t-foreach="desc_lines" t-as="dl">
                                        <li t-if="dl"><t t-out="dl"/></li>
                                    </t>
                                </ul>
                                <ul class="ci-variants" t-if="line.product_id.default_code and not desc_lines">
                                    <li><span>SKU:</span> <t t-out="line.product_id.default_code"/></li>
                                </ul>

                                <div class="ci-actions" name="o_wsale_cart_line_button_container">
                                    <a href="#"
                                       class="ci-link js_delete_product"
                                       aria-label="Remove from cart"
                                       title="Remove from cart">
                                        <i class="bi bi-trash"/> Remove
                                    </a>
                                </div>
                            </div>
                            <!-- Quantity + Price -->
                            <div class="ci-end">
                                <div class="ci-qty css_quantity input-group"
                                     name="website_sale_cart_line_quantity">
                                    <t t-if="not line._is_not_sellable_line()">
                                        <a href="#"
                                           class="js_add_cart_json btn btn-link px-2"
                                           aria-label="Remove one" title="Remove one">
                                            <i class="fa-minus d-none"/>
                                            <i class="bi bi-dash"/>
                                        </a>
                                        <input type="text"
                                               class="js_quantity quantity form-control text-center border-0 bg-transparent"
                                               style="width:50px;outline:none;box-shadow:none;"
                                               t-att-data-line-id="line.id"
                                               t-att-data-product-id="line.product_id.id"
                                               t-att-value="line._get_displayed_quantity()"/>
                                        <a href="#"
                                           class="js_add_cart_json float_left btn btn-link px-2"
                                           aria-label="Add one" title="Add one">
                                            <i class="bi bi-plus"/>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <span class="px-3" style="font-size:.88rem;font-weight:600;">
                                            <t t-out="int(line.product_uom_qty)"/>
                                        </span>
                                        <input type="hidden"
                                               class="js_quantity quantity form-control"
                                               t-att-data-line-id="line.id"
                                               t-att-data-product-id="line.product_id.id"
                                               t-att-value="line._get_displayed_quantity()"/>
                                    </t>
                                </div>
                                <div class="ci-price" name="website_sale_cart_line_price">
                                    <t t-if="line.discount">
                                        <del style="font-size:.78rem;color:#999;display:block;">
                                            <span t-out="line._get_displayed_unit_price() * line.product_uom_qty"
                                                  t-options="{'widget':'monetary','display_currency':website.currency_id}"/>
                                        </del>
                                    </t>
                                    <strong>
                                        <t t-set="product_price" t-value="line._get_cart_display_price()"/>
                                        <t t-call="website_sale.cart_product_price"/>
                                    </strong>
                                    <small>per item</small>
                                </div>
                            </div>
                        </article>
                    </t>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
