<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Contact Thank You page-->
    <template id="beauty_shop_contact_thankyou" name="Beauty Shop — Contact Thank You">
        <t t-call="website.layout">
            <t t-set="head">
                <!-- Google Fonts matching the beauty shop aesthetic -->
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
                <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&amp;family=DM+Sans:wght@300;400;500&amp;display=swap"
                      rel="stylesheet"/>
                <link rel="stylesheet"
                      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
                <style>
                    /* ─── Design tokens ─────────────────────────────────────── */
                    :root {
                    --cream: #FAF7F2;
                    --blush: #F2E8E1;
                    --rose: #C8856A;
                    --rose-dark: #A5614A;
                    --ink: #1C1714;
                    --muted: #8A7F78;
                    --border: rgba(28,23,20,.10);
                    --font-serif: 'Cormorant Garamond', Georgia, serif;
                    --font-sans: 'DM Sans', sans-serif;
                    --radius: 16px;
                    --radius-sm: 8px;
                    }

                    /* ─── Page shell ────────────────────────────────────────── */
                    body { background: var(--cream); font-family: var(--font-sans); color: var(--ink); }

                    /* hide Odoo's default header/footer chrome for a focused moment */
                    #wrapwrap > header,
                    #wrapwrap > footer { display: none !important; }

                    /* ─── Full-viewport layout ──────────────────────────────── */
                    .ty-page {
                    min-height: 100vh;
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    overflow: hidden;
                    }

                    /* ─── Left decorative panel ─────────────────────────────── */
                    .ty-left {
                    position: relative;
                    background: var(--ink);
                    display: flex;
                    flex-direction: column;
                    justify-content: flex-end;
                    padding: 3rem;
                    overflow: hidden;
                    }
                    .ty-left::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background:
                    radial-gradient(ellipse 80% 60% at 30% 20%, rgba(200,133,106,.35) 0%, transparent 65%),
                    radial-gradient(ellipse 60% 80% at 80% 90%, rgba(200,133,106,.20) 0%, transparent 55%);
                    pointer-events: none;
                    }
                    .ty-left-img {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    opacity: .18;
                    mix-blend-mode: luminosity;
                    }
                    .ty-left-content { position: relative; z-index: 1; }
                    .ty-wordmark {
                    font-family: var(--font-serif);
                    font-size: 1.5rem;
                    font-weight: 300;
                    color: var(--cream);
                    letter-spacing: .08em;
                    text-decoration: none;
                    display: inline-block;
                    margin-bottom: auto;
                    }
                    .ty-left-top {
                    position: absolute;
                    top: 3rem; left: 3rem;
                    z-index: 1;
                    }
                    .ty-left-quote {
                    font-family: var(--font-serif);
                    font-size: clamp(2rem, 3.5vw, 3rem);
                    font-weight: 300;
                    font-style: italic;
                    color: var(--cream);
                    line-height: 1.25;
                    margin-bottom: 1.25rem;
                    }
                    .ty-left-quote em { color: var(--rose); font-style: normal; }
                    .ty-left-sub {
                    font-size: .8125rem;
                    color: rgba(250,247,242,.55);
                    letter-spacing: .04em;
                    }
                    .ty-orb {
                    position: absolute;
                    border-radius: 50%;
                    pointer-events: none;
                    }
                    .ty-orb-1 {
                    width: 320px; height: 320px;
                    top: -80px; right: -80px;
                    background: radial-gradient(circle, rgba(200,133,106,.25) 0%, transparent 70%);
                    }
                    .ty-orb-2 {
                    width: 200px; height: 200px;
                    bottom: 30%; left: -60px;
                    background: radial-gradient(circle, rgba(200,133,106,.15) 0%, transparent 70%);
                    }

                    /* ─── Right content panel ───────────────────────────────── */
                    .ty-right {
                    background: var(--cream);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 3rem 4rem;
                    }
                    .ty-card {
                    max-width: 480px;
                    width: 100%;
                    animation: ty-fadein .7s ease both;
                    }
                    @keyframes ty-fadein {
                    from { opacity: 0; transform: translateY(24px); }
                    to { opacity: 1; transform: translateY(0); }
                    }

                    /* success badge */
                    .ty-badge {
                    width: 56px; height: 56px;
                    background: var(--blush);
                    border-radius: 50%;
                    display: flex; align-items: center; justify-content: center;
                    margin-bottom: 1.75rem;
                    }
                    .ty-badge i { font-size: 1.5rem; color: var(--rose); }

                    /* eyebrow */
                    .eyebrow {
                    font-size: .6875rem;
                    font-weight: 500;
                    letter-spacing: .14em;
                    text-transform: uppercase;
                    color: var(--rose);
                    display: block;
                    margin-bottom: .75rem;
                    }

                    /* heading */
                    .ty-heading {
                    font-family: var(--font-serif);
                    font-size: clamp(2rem, 4vw, 3rem);
                    font-weight: 300;
                    line-height: 1.15;
                    margin-bottom: 1.25rem;
                    color: var(--ink);
                    }
                    .ty-heading em { color: var(--rose); font-style: italic; }

                    /* body copy */
                    .ty-body {
                    font-size: .9375rem;
                    line-height: 1.7;
                    color: var(--muted);
                    margin-bottom: 2.5rem;
                    }
                    .ty-body strong { color: var(--ink); font-weight: 500; }

                    /* info pills */
                    .ty-pills { display: flex; flex-wrap: wrap; gap: .625rem; margin-bottom: 2.5rem; }
                    .ty-pill {
                    display: inline-flex; align-items: center; gap: .4rem;
                    background: var(--blush);
                    border-radius: 100px;
                    padding: .4rem .9rem;
                    font-size: .8125rem;
                    color: var(--ink);
                    }
                    .ty-pill i { font-size: .875rem; color: var(--rose); }

                    /* divider */
                    .ty-divider {
                    border: none;
                    border-top: 1px solid var(--border);
                    margin: 2rem 0;
                    }

                    /* quick links */
                    .ty-links { list-style: none; padding: 0; margin: 0 0 2.5rem; }
                    .ty-links li + li { border-top: 1px solid var(--border); }
                    .ty-links a {
                    display: flex; align-items: center; justify-content: space-between;
                    padding: .75rem 0;
                    font-size: .9rem;
                    color: var(--ink);
                    text-decoration: none;
                    transition: color .2s;
                    }
                    .ty-links a:hover { color: var(--rose); }
                    .ty-links a i { font-size: .875rem; opacity: .5; transition: opacity .2s, transform .2s; }
                    .ty-links a:hover i { opacity: 1; transform: translate(2px,-2px); }

                    /* CTA button */
                    .btn-routine {
                    display: inline-flex; align-items: center; gap: .75rem;
                    background: var(--ink); color: var(--cream);
                    border: none; border-radius: 100px;
                    padding: .875rem 1.75rem;
                    font-family: var(--font-sans); font-size: .875rem; font-weight: 500;
                    letter-spacing: .02em; cursor: pointer;
                    text-decoration: none;
                    transition: background .2s, transform .15s;
                    }
                    .btn-routine:hover {
                    background: var(--rose-dark);
                    color: var(--cream);
                    transform: translateY(-1px);
                    }
                    .btn-routine .arrow-chip {
                    width: 28px; height: 28px;
                    background: var(--rose);
                    border-radius: 50%;
                    display: flex; align-items: center; justify-content: center;
                    font-size: .8rem;
                    }
                    .btn-ghost {
                    display: inline-flex; align-items: center; gap: .5rem;
                    background: transparent; color: var(--ink);
                    border: 1px solid var(--border); border-radius: 100px;
                    padding: .875rem 1.75rem;
                    font-family: var(--font-sans); font-size: .875rem; font-weight: 400;
                    letter-spacing: .02em; cursor: pointer;
                    text-decoration: none;
                    transition: border-color .2s, color .2s;
                    }
                    .btn-ghost:hover { border-color: var(--rose); color: var(--rose); }
                    .ty-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }

                    /* ─── Mobile ─────────────────────────────────────────────── */
                    @media (max-width: 767px) {
                    .ty-page { grid-template-columns: 1fr; }
                    .ty-left { min-height: 220px; padding: 2rem; justify-content: center; }
                    .ty-left-top { position: static; margin-bottom: 1.5rem; }
                    .ty-left-content { text-align: center; }
                    .ty-right { padding: 2.5rem 1.5rem; }
                    .ty-card { max-width: 100%; }
                    }
                </style>
            </t>
            <div class="ty-page">
                <!-- ─ Left decorative panel ── -->
                <div class="ty-left">
                    <div class="ty-orb ty-orb-1"/>
                    <div class="ty-orb ty-orb-2"/>
                    <img class="ty-left-img"
                         src="/theme_beauty_shop/static/src/img/routine-ritual.jpg"
                         alt="Studio atmosphere"/>
                    <div class="ty-left-top">
                        <a href="/" class="ty-wordmark">Glowing.</a>
                    </div>
                    <div class="ty-left-content">
                        <p class="ty-left-quote">
                            Good skin starts with
                            <br/>
                            <em>a conversation.</em>
                        </p>
                        <span class="ty-left-sub">— The Glowing Team</span>
                    </div>
                </div>
                <!-- ── Right content panel ── -->
                <div class="ty-right">
                    <div class="ty-card">
                        <!-- Success badge -->
                        <div class="ty-badge">
                            <i class="bi bi-check2"/>
                        </div>
                        <!-- Eyebrow + heading -->
                        <span class="eyebrow">— Message received</span>
                        <h1 class="ty-heading">
                            Thank you,
                            <em><t t-esc="contact_name"/>.
                            </em>
                        </h1>
                        <!-- Body copy -->
                        <p class="ty-body">
                            We've got your message about
                            <strong>
                                <t t-esc="contact_topic or 'your enquiry'"/>
                            </strong>
                            and we're already on it.
                            Expect a reply from a real human — usually Sofia or Maya — within
                            <strong>4 business hours</strong>, Monday to Friday.
                        </p>
                        <!-- Info pills -->
                        <div class="ty-pills">
                            <span class="ty-pill">
                                <i class="bi bi-clock"/>
                                Reply within 4 hours
                            </span>
                            <span class="ty-pill">
                                <i class="bi bi-person-check"/>
                                Real human response
                            </span>
                            <span class="ty-pill">
                                <i class="bi bi-envelope-check"/>
                                Confirmation sent
                            </span>
                        </div>
                        <hr class="ty-divider"/>
                        <!-- Quick links -->
                        <p class="eyebrow" style="margin-bottom:.75rem;">— While you wait</p>
                        <ul class="ty-links">
                            <li>
                                <a href="/shop">
                                    <span>Browse our skincare range</span>
                                    <i class="bi bi-arrow-up-right"/>
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <span>Read our skin-tip journal</span>
                                    <i class="bi bi-arrow-up-right"/>
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <span>Track your order</span>
                                    <i class="bi bi-arrow-up-right"/>
                                </a>
                            </li>
                        </ul>
                        <!-- Actions -->
                        <div class="ty-actions">
                            <a href="/" class="btn-routine">
                                <span>Back to home</span>
                                <span class="arrow-chip">
                                    <i class="bi bi-arrow-up-right"/>
                                </span>
                            </a>
                            <a href="/shop" class="btn-ghost">
                                Shop now
                                <i class="bi bi-arrow-right"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
