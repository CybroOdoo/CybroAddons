<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="wishlist_add_remove_button" inherit_id="website_sale.product_wishlist">
        <xpath expr="//div[hasclass('o_wishlist_item')]" position="inside">
            <button type="button"
                    class="btn btn-light o_wish_rm position-absolute top-0 end-0 m-2 z-3 rounded-pill lh-1"
                    title="Remove from wishlist">
                <i class="oi" data-icon="close" role="presentation"/>
            </button>
        </xpath>
    </template>
</odoo>