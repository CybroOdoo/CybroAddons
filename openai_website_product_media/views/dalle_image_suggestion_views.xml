<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Dalle Image Suggestion form view to add "Make as Media Image" button -->
    <record id="dalle_image_suggestion_view_form" model="ir.ui.view">
        <field name="name">dalle.image.suggestion.view.form.inherit.openai.website.product.media</field>
        <field name="model">dalle.image.suggestion</field>
        <field name="inherit_id" ref="openai_product_images.dalle_image_suggestion_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_make_as_media_image"
                        type="object"
                        string="Make as Media Image"/>
            </xpath>
        </field>
    </record>
</odoo>
