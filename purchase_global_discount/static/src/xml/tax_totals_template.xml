<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="TaxTotalsField" t-inherit="account.TaxTotalsField" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='totals.subtotals']" position="after">

            <tr t-if="props.record.resModel == 'purchase.order'">
                <td class="o_td_label">
                    <label class="o_form_label">Global Discount</label>
                </td>
                <td class="d-flex align-items-center gap-1">
                    <t t-if="['purchase','done', 'cancel'].includes(props.record.data.state)">
                        <input type="text"
                               t-model="props.record._values.global_discount"
                               class="o_input" readonly="1"/>
                    </t>
                    <t t-else="">
                        <input type="text"
                               t-model="props.record._values.global_discount"
                               class="o_input"/>
                    </t>
                    <span>%</span>
                </td>
            </tr>
            <tr t-if='props.record.resModel=="account.move" and props.record.data.move_type == "in_invoice"'>
                <td class="o_td_label">
                    <label class="o_form_label">Global Discount</label>
                </td>
                <td class="d-flex align-items-center gap-1">
                    <input type="text" t-model="props.record._values.global_discount" class="o_input" readonly="1"/>
                    <span>%</span>
                </td>
            </tr>
        </xpath>
    </t>
</templates>
