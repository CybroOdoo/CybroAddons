<?xml version="1.0" encoding="utf-8"?>
<templates id="import_dashboard_templates">
    <!--    Dashboard view -->
    <t t-name="import_dashboard.ImportDashBoard">
        <section class="import_dashboard_main_section" id="main_section_import_dashboard">
            <div class="main-container">
                <div class="start_msg" t-if="!state.hasAnyPermission">
                    <p class="o_view_nocontent_smiling_face">Empty Dashboard</p>
                    <p>Enable Settings To View Your Dashboard.</p>
                </div>
                
                <div class="import-dashboard-row" t-if="state.hasAnyPermission">
                    <!-- Sale Order -->
                    <div t-if="state.permissions.import_sale" class="import-card-wrapper" id="card_sale">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-purple">
                                    <i class="fa fa-line-chart"/>
                                </div>
                                <div class="card-info">
                                    <h3>Sale</h3>
                                    <p>Import Sale Order</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_sale">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Purchase Order -->
                    <div t-if="state.permissions.import_purchase" class="import-card-wrapper" id="card_purchase">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-orange">
                                    <i class="fa fa-credit-card"/>
                                </div>
                                <div class="card-info">
                                    <h3>Purchase</h3>
                                    <p>Import Purchase Order</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_purchase">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Invoice -->
                    <div t-if="state.permissions.import_invoice" class="import-card-wrapper" id="card_invoice">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-blue">
                                    <img src="/import_dashboard/static/images/icons8-invoice-64 .png" alt="Invoice"/>
                                </div>
                                <div class="card-info">
                                    <h3>Invoice</h3>
                                    <p>Import Invoice</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_invoice">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Partner -->
                    <div t-if="state.permissions.import_partner" class="import-card-wrapper" id="card_partner">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-teal">
                                    <img src="/import_dashboard/static/images/icons8-partner-64.png" alt="Partner"/>
                                </div>
                                <div class="card-info">
                                    <h3>Partner</h3>
                                    <p>Import Partner</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_partner">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Product Pricelist -->
                    <div t-if="state.permissions.import_pricelist" class="import-card-wrapper" id="card_pricelist">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-green">
                                    <img src="/import_dashboard/static/images/icons8-list-48.png" alt="Pricelist"/>
                                </div>
                                <div class="card-info">
                                    <h3>Pricelist</h3>
                                    <p>Import Product Pricelist</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_product_pricelist">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Bill of Material -->
                    <div t-if="state.permissions.bill_of_material" class="import-card-wrapper" id="card_bill_of_material">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-red">
                                    <img src="/import_dashboard/static/images/icons8-paid-bill-64.png" alt="BOM"/>
                                </div>
                                <div class="card-info">
                                    <h3>BoM</h3>
                                    <p>Import Bill of Material</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_bill_of_material">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- POS -->
                    <div t-if="state.permissions.pos" class="import-card-wrapper" id="card_pos">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-orange">
                                    <img src="/import_dashboard/static/images/payment-terminal.png" alt="POS"/>
                                </div>
                                <div class="card-info">
                                    <h3>POS</h3>
                                    <p>Import POS Orders</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_pos">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Attendance -->
                    <div t-if="state.permissions.import_attendance" class="import-card-wrapper" id="card_attendance">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-blue">
                                    <img src="/import_dashboard/static/images/calendar.png" alt="Attendance"/>
                                </div>
                                <div class="card-info">
                                    <h3>Attendance</h3>
                                    <p>Import Attendance</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_attendance">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Payment -->
                    <div t-if="state.permissions.import_payment" class="import-card-wrapper" id="card_payment">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-green">
                                    <img src="/import_dashboard/static/images/payment.png" alt="Payment"/>
                                </div>
                                <div class="card-info">
                                    <h3>Payment</h3>
                                    <p>Import Payment</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_payment">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Task -->
                    <div t-if="state.permissions.import_task" class="import-card-wrapper" id="card_task">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-purple">
                                    <img src="/import_dashboard/static/images/tasks.png" alt="Task"/>
                                </div>
                                <div class="card-info">
                                    <h3>Task</h3>
                                    <p>Import Project Task</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_task">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Product Template -->
                    <div t-if="state.permissions.import_product_template" class="import-card-wrapper" id="card_product">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-teal">
                                    <img src="/import_dashboard/static/images/cart.png" alt="Product"/>
                                </div>
                                <div class="card-info">
                                    <h3>Product</h3>
                                    <p>Import Product Template</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_product_template">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                    <!-- Vendor Pricelist -->
                    <div t-if="state.permissions.import_vendor_pricelist" class="import-card-wrapper" id="card_vendor_pricelist">
                        <div class="import-card">
                            <div class="card-top-content">
                                <div class="card-icon-container icon-bg-orange">
                                    <img src="/import_dashboard/static/images/icons8-vendor-64.png" alt="Vendor Pricelist"/>
                                </div>
                                <div class="card-info">
                                    <h3>Vendor Pricelist</h3>
                                    <p>Import Vendor Pricelist</p>
                                </div>
                            </div>
                            <button class="import_btn" type="object" t-on-click="import_vendor_pricelist">
                                <i class="fa fa-cloud-upload"/>
                                <span>Import</span>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </t>
</templates>
