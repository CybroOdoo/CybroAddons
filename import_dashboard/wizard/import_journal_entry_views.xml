<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Record for import journal entry view form  -->
    <record id="import_journal_entry_view_form" model="ir.ui.view">
        <field name="name">import.journal.entry.view.form</field>
        <field name="model">import.journal.entry</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="file_type" widget="radio"/>
                        <field name="type"/>
                        <field name="file"/>
                    </group>
                    <group>
                        <field name="import_product_by"/>
                        <field name="order_number" widget="radio"/>
                        <field name="update_posted"/>
                        <field name="auto_post" widget="boolean_toggle"/>
                    </group>
                </group>
                <footer>
                    <button string="Import" class="oe_highlight" type="object"
                            name="action_import_journal_entry" data-hotkey="i"/>
                    <button string="Cancel" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
