<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard to confirm the journal entry cancel -->
    <record id="account_move_cancel_reset_view_form" model="ir.ui.view">
        <field name="name">account.move.cancel.reset.view.form</field>
        <field name="model">account.move.cancel.reset</field>
        <field name="arch" type="xml">
            <form>
                <h4>
                    <span>Are you sure you want to cancel all the
                        selected journal entries?
                    </span>
                </h4>
                <footer>
                    <button name="action_mass_journal_entry_cancel"
                            string="Mass Cancel Journal Entry"
                            class="btn-primary" type="object"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Wizard to confirm the journal entry reset -->
    <record id="account_move_cancel_reset_reset_view_form" model="ir.ui.view">
        <field name="name">account.move.cancel.reset.reset.view.form</field>
        <field name="model">account.move.cancel.reset</field>
        <field name="arch" type="xml">
            <form>
                <h4>
                    <span>Are you sure you want to reset all the
                        selected journal entries to draft?
                    </span>
                </h4>
                <footer>
                    <button name="action_mass_journal_entry_reset"
                            string="Mass Reset Journal Entry"
                            class="btn-primary" type="object"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
