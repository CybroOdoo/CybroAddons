<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Task Checklist list view -->
    <record id="task_checklist_view_tree" model="ir.ui.view">
        <field name="name">task.checklist.view.list</field>
        <field name="model">task.checklist</field>
        <field name="arch" type="xml">
            <list string="Task Checklist">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Task Checklist form view -->
    <record id="task_checklist_view_form" model="ir.ui.view">
        <field name="name">task.checklist.view.form</field>
        <field name="model">task.checklist</field>
        <field name="arch" type="xml">
            <form string="Task Checklist">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <label for="checklist_ids" string="Checklist Items"/>
                    <field name="checklist_ids">
                        <list create="1" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" required="1"/>
                            <field name="description"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Checklist search view -->
    <record id="task_checklist_view_search" model="ir.ui.view">
        <field name="name">task.checklist.view.search</field>
        <field name="model">task.checklist</field>
        <field name="arch" type="xml">
            <search string="Task Checklist">
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <!-- Task Checklist window action -->
    <record id="task_checklist_action" model="ir.actions.act_window">
        <field name="name">Task Checklist</field>
        <field name="res_model">task.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="task_checklist_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a checklist
            </p>
        </field>
    </record>

    <!-- Checklist Menu Root -->
    <menuitem
            id="project_checklist_root"
            name="Checklist"
            parent="project.menu_project_config"
            sequence="6"/>

    <!-- Task Checklist Menu -->
    <menuitem
            parent="project_checklist_root"
            id="menu_task_checklist"
            name="Task Checklist"
            action="task_checklist_action"
            sequence="1"/>

    <!-- Checklist Items Menu -->
    <menuitem
            parent="project_checklist_root"
            id="menu_checklist_item"
            name="Checklist Items"
            action="checklist_item_action"
            sequence="2"/>
</odoo>
