<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- checklist item list view -->
    <record id="checklist_item_view_list" model="ir.ui.view">
        <field name="name">checklist.item.view.list</field>
        <field name="model">checklist.item</field>
        <field name="arch" type="xml">
            <list string="Checklist Items">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="checklist_id"/>
            </list>
        </field>
    </record>

    <!-- checklist item form view -->
    <record id="checklist_item_view_form" model="ir.ui.view">
        <field name="name">checklist.item.view.form</field>
        <field name="model">checklist.item</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="checklist_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- checklist item search view -->
    <record id="checklist_item_view_search" model="ir.ui.view">
        <field name="name">checklist.item.view.search</field>
        <field name="model">checklist.item</field>
        <field name="arch" type="xml">
            <search string="Checklist Items">
                <field name="name"/>
                <field name="description"/>
                <field name="checklist_id"/>
                <group>
                    <filter string="Checklist" name="group_by_checklist" context="{'group_by': 'checklist_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- checklist item action -->
    <record id="checklist_item_action" model="ir.actions.act_window">
        <field name="name">Checklist Items</field>
        <field name="res_model">checklist.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="checklist_item_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a checklist item
            </p>
        </field>
    </record>
</odoo>
