<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence: Consolidated Invoice -->
    <record id="seq_wm_consolidated_invoice" model="ir.sequence">
        <field name="name">Consolidated Invoice</field>
        <field name="code">wm.consolidated.invoice</field>
        <field name="prefix">CINV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">False</field>
    </record>

    <!-- Sequence: Billable Event -->
    <record id="seq_wm_billable_event" model="ir.sequence">
        <field name="name">Billable Event</field>
        <field name="code">wm.billable.event</field>
        <field name="prefix">BE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">False</field>
    </record>

    <!-- Sequence: Monthly Billing Run -->
    <record id="seq_wm_monthly_billing_run" model="ir.sequence">
        <field name="name">Monthly Billing Run</field>
        <field name="code">wm.monthly.billing.run</field>
        <field name="prefix">MBR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">False</field>
    </record>
</odoo>

