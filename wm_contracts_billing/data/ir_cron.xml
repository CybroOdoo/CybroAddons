<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <data noupdate="1">
         <!-- Cron: Waste Management: Auto-Expire Contracts -->
         <record id="ir_cron_expire_partner_contract" model="ir.cron">
             <field name="name">Waste Management: Auto-Expire Contracts</field>
             <field name="model_id" ref="model_wm_partner_contract"/>
             <field name="state">code</field>
             <field name="code">model._cron_expire_contracts()</field>
             <field name="interval_number">1</field>
             <field name="interval_type">days</field>
             <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
             <field name="active">True</field>
         </record>
          <!-- Cron: Waste Management: Generate Collection Orders -->
          <record id="ir_cron_generate_collection_orders" model="ir.cron">
              <field name="name">Waste Management: Generate Collection Orders</field>
              <field name="model_id" ref="model_wm_partner_contract"/>
              <field name="state">code</field>
              <field name="code">model._cron_generate_collection_orders()</field>
              <field name="interval_number">1</field>
              <field name="interval_type">days</field>
              <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=45, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
              <field name="active">True</field>
          </record>
          <!-- Cron: Waste Management: Contract Renewal Reminders -->
          <record id="ir_cron_contract_renewal_reminders" model="ir.cron">
              <field name="name">Waste Management: Contract Renewal Reminders</field>
              <field name="model_id" ref="model_wm_partner_contract"/>
              <field name="state">code</field>
              <field name="code">model._cron_contract_renewal_reminders()</field>
              <field name="interval_number">1</field>
              <field name="interval_type">days</field>
              <field name="nextcall" eval="(DateTime.now().replace(hour=9, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
              <field name="active">True</field>
          </record>

          <!-- Cron: Waste Management: Auto Run Monthly Billing -->
          <record id="ir_cron_monthly_billing_run" model="ir.cron">
              <field name="name">Waste Management: Auto Run Monthly Billing</field>
              <field name="model_id" ref="model_wm_monthly_billing_run"/>
              <field name="state">code</field>
              <field name="code">model._cron_run_monthly_billing()</field>
              <field name="interval_number">1</field>
              <field name="interval_type">months</field>
              <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=1, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
              <field name="active">True</field>
          </record>

          <!-- Cron: Waste Management: Generate Monthly Consolidated Invoices -->
          <record id="ir_cron_generate_monthly_invoices" model="ir.cron">
              <field name="name">Waste Management: Generate Monthly Consolidated Invoices</field>
              <field name="model_id" ref="model_wm_consolidated_invoice"/>
              <field name="state">code</field>
              <field name="code">model._cron_generate_monthly_invoices()</field>
              <field name="interval_number">1</field>
              <field name="interval_type">months</field>
              <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=2, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
              <field name="active">True</field>
          </record>
     </data>
</odoo>
