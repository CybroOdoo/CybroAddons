<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <data noupdate="1">
         <!-- Cron: Waste Management: Auto-Expire Contracts -->
         <record id="ir_cron_expire_partner_contract" model="ir.cron">
             <field name="name">Waste Management: Auto-Expire Contracts</field>
             <field name="model_id" ref="model_wm_partner_contract"/>
             <field name="state">code</field>
             <field name="code">model._cron_expire_contracts()</field>
             <field name="interval_number">1</field>
             <field name="interval_type">days</field>
             <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
             <field name="active">True</field>
         </record>
          <!-- Cron: Waste Management: Generate Collection Orders -->
          <record id="ir_cron_generate_collection_orders" model="ir.cron">
              <field name="name">Waste Management: Generate Collection Orders</field>
              <field name="model_id" ref="model_wm_partner_contract"/>
              <field name="state">code</field>
              <field name="code">model._cron_generate_collection_orders()</field>
              <field name="interval_number">1</field>
              <field name="interval_type">days</field>
              <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=45, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
              <field name="active">True</field>
          </record>
     </data>
</odoo>
