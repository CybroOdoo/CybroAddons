<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Monthly Billing: Generate Consolidated Invoices -->
        <record id="ir_cron_wm_monthly_billing" model="ir.cron">
            <field name="name">Monthly Billing: Generate Consolidated Invoices</field>
            <field name="model_id" ref="model_wm_monthly_billing_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_monthly_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: WM: Generate Monthly Invoices -->
        <record id="cron_wm_generate_monthly_invoices" model="ir.cron">
            <field name="name">WM: Generate Monthly Invoices</field>
            <field name="model_id" ref="model_wm_consolidated_invoice"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
