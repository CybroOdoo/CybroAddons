<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.monthly.billing.wizard - wm.monthly.billing.wizard.form (Form) -->
    <record id="view_wm_monthly_billing_wizard_form" model="ir.ui.view">
        <field name="name">wm.monthly.billing.wizard.form</field>
        <field name="model">wm.monthly.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Monthly Consolidated Billing">
                <group>
                    <group>
                        <field name="period_start"/>
                        <field name="period_end"/>
                    </group>
                </group>
                <group string="Filter by Customer (Optional)">
                    <field name="partner_ids" widget="many2many_tags" placeholder="All Monthly Customers"/>
                </group>
                <footer>
                    <button name="action_run_monthly_billing" string="Run Billing" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: Run Monthly Consolidated Billing -->
    <record id="action_wm_monthly_billing_wizard" model="ir.actions.act_window">
        <field name="name">Run Monthly Consolidated Billing</field>
        <field name="res_model">wm.monthly.billing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
