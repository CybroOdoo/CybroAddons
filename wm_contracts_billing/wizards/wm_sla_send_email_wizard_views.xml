<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_wm_sla_send_email_wizard_form" model="ir.ui.view">
        <field name="name">wm.sla.send.email.wizard.form</field>
        <field name="model">wm.sla.send.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Send SLA Breach Email">
                <sheet>
                    <group>
                        <field name="sla_id" invisible="1"/>
                        <field name="contract_id" domain="[('sla_id', '=', sla_id)]" options="{'no_create': True}"/>
                        <field name="reason" placeholder="Enter the reason for sending the breach notification email..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send_email" string="Send Email" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_wm_sla_send_email_wizard" model="ir.actions.act_window">
        <field name="name">Send SLA Breach Email</field>
        <field name="res_model">wm.sla.send.email.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
