<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.pricing.rule.summary.wizard - wm.pricing.rule.summary.wizard.form (Form) -->
    <record id="view_wm_pricing_rule_summary_wizard_form" model="ir.ui.view">
        <field name="name">wm.pricing.rule.summary.wizard.form</field>
        <field name="model">wm.pricing.rule.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Print / Export Pricing Rule Summary">
                <group>
                    <field name="output_type" widget="radio"/>
                    <field name="rule_ids" widget="many2many_tags" domain="[('active', '=', True)]"/>
                </group>
                <footer>
                    <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: Pricing Rule Summary -->
    <record id="action_wm_pricing_rule_summary_wizard" model="ir.actions.act_window">
        <field name="name">Pricing Rule Summary</field>
        <field name="res_model">wm.pricing.rule.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_wm_pricing_rule"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
