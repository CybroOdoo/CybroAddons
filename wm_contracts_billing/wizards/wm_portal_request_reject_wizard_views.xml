<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wm_portal_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">wm.portal.request.reject.wizard.form</field>
        <field name="model">wm.portal.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Service Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Explain why this request cannot be accepted..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject Request" type="object" class="btn-warning"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
