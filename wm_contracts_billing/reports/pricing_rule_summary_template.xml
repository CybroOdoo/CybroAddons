<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template: report_pricing_rule_summary_document -->
    <template id="report_pricing_rule_summary_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- HEADER -->
                    <div style="text-align:center; margin-bottom:20px; padding:16px 20px; background:linear-gradient(135deg,#005b1f 0%,#008c3a 100%); border-radius:6px;">
                        <div style="font-size:9px; letter-spacing:3px; text-transform:uppercase; color:#a8ffa8; margin-bottom:6px; font-weight:600;">Billing &amp; Tariff Management</div>
                        <h1 style="color:#ffffff; margin:0; font-size:20px; font-weight:bold; letter-spacing:0.5px;">PRICING RULE SUMMARY</h1>
                    </div>

                    <!-- PRICING RULES TABLE -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:20px; font-size:11px;">
                        <thead>
                            <tr>
                                <th style="background-color:#005b1f; color:#ffffff; padding:8px 10px; border:1px solid #004411; width:20%;">Category</th>
                                <th style="background-color:#005b1f; color:#ffffff; padding:8px 10px; border:1px solid #004411; width:22%;">Customer / Scope</th>
                                <th style="background-color:#005b1f; color:#ffffff; padding:8px 10px; border:1px solid #004411; width:14%; text-align:right;">Price / kg</th>
                                <th style="background-color:#005b1f; color:#ffffff; padding:8px 10px; border:1px solid #004411; width:14%; text-align:right;">Min Weight (kg)</th>
                                <th style="background-color:#005b1f; color:#ffffff; padding:8px 10px; border:1px solid #004411; width:14%; text-align:right;">Min Charge</th>
                                <th style="background-color:#005b1f; color:#ffffff; padding:8px 10px; border:1px solid #004411; width:16%; text-align:center;">Effective Dates</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs.sorted(key=lambda r: (r.waste_category_id.name or '', r.sequence))" t-as="rule">
                                <tr>
                                    <td style="padding:8px 10px; border:1px solid #dce6f5; font-weight:bold;"><span t-field="rule.waste_category_id.name"/></td>
                                    <td style="padding:8px 10px; border:1px solid #dce6f5;">
                                        <span t-if="rule.partner_id" t-field="rule.partner_id.name"/>
                                        <span t-if="not rule.partner_id" style="font-style:italic; color:#666666;">All Customers</span>
                                    </td>
                                    <td style="padding:8px 10px; border:1px solid #dce6f5; text-align:right;"><span t-field="rule.price_per_kg"/></td>
                                    <td style="padding:8px 10px; border:1px solid #dce6f5; text-align:right;"><span t-field="rule.min_weight"/></td>
                                    <td style="padding:8px 10px; border:1px solid #dce6f5; text-align:right;"><span t-field="rule.min_charge"/></td>
                                    <td style="padding:8px 10px; border:1px solid #dce6f5; text-align:center;">
                                        <span t-field="rule.effective_date"/>
                                        <t t-if="rule.expiry_date"> to <span t-field="rule.expiry_date"/></t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
