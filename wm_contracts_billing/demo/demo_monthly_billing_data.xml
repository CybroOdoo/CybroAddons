<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- DEMO CUSTOMERS FOR MONTHLY CONSOLIDATED BILLING                    -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <record id="demo_monthly_partner_ecocorp" model="res.partner">
            <field name="name">EcoCorp Industrial Services Ltd</field>
            <field name="is_company" eval="True"/>
            <field name="street">100 Green Energy Parkway</field>
            <field name="city">Eco City</field>
            <field name="zip">90210</field>
            <field name="email">billing@ecocorp-industrial.com</field>
            <field name="phone">+1 (555) 234-5678</field>
        </record>

        <!-- Record: wm.collection.point - EcoCorp Main Factory Gate 3 -->
        <record id="demo_collection_point_ecocorp" model="wm.collection.point">
            <field name="name">EcoCorp Main Factory Gate 3</field>
            <field name="partner_id" ref="demo_monthly_partner_ecocorp"/>
            <field name="street">100 Green Energy Parkway</field>
            <field name="city">Eco City</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- DEMO CATEGORY RATE CARDS (BILLING RULES)                          -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <record id="demo_billing_rule_ecocorp_ewaste" model="wm.category.billing.rule">
            <field name="category_id" ref="wm_base.wcat_ewaste"/>
            <field name="partner_id" ref="demo_monthly_partner_ecocorp"/>
            <field name="billing_basis">per_kg</field>
            <field name="price">2.50</field>
            <field name="min_weight">20.0</field>
            <field name="min_charge">50.00</field>
        </record>

        <!-- Record: wm.category.billing.rule (demo_billing_rule_ecocorp_industrial) -->
        <record id="demo_billing_rule_ecocorp_industrial" model="wm.category.billing.rule">
            <field name="category_id" ref="wm_base.wcat_industrial"/>
            <field name="partner_id" ref="demo_monthly_partner_ecocorp"/>
            <field name="billing_basis">per_kg</field>
            <field name="price">1.50</field>
            <field name="min_charge">30.00</field>
        </record>

        <!-- Record: wm.category.billing.rule (demo_billing_rule_generic_recycle) -->
        <record id="demo_billing_rule_generic_recycle" model="wm.category.billing.rule">
            <field name="category_id" ref="wm_base.waste_category_recycle"/>
            <field name="billing_basis">per_kg</field>
            <field name="price">0.80</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- DEMO COMPLETED COLLECTION ORDERS FOR MONTHLY BILLING               -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <record id="demo_col_order_ecocorp_01" model="wm.collection.order">
            <field name="name">DEMO-COL-M001</field>
            <field name="partner_id" ref="demo_monthly_partner_ecocorp"/>
            <field name="collection_point_id" ref="demo_collection_point_ecocorp"/>
            <field name="actual_start" eval="(datetime.now() - timedelta(days=10)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="actual_end" eval="(datetime.now() - timedelta(days=10)).strftime('%Y-%m-%d 10:30:00')"/>
            <field name="state">completed</field>
        </record>

        <!-- Record: wm.collection.order.line (demo_col_order_ecocorp_line_01) -->
        <record id="demo_col_order_ecocorp_line_01" model="wm.collection.order.line">
            <field name="order_id" ref="demo_col_order_ecocorp_01"/>
            <field name="category_id" ref="wm_base.wcat_ewaste"/>
            <field name="product_id" ref="wm_base.wmat_batteries"/>
            <field name="weight">45.0</field>
        </record>

        <!-- Record: wm.collection.order - DEMO-COL-M002 -->
        <record id="demo_col_order_ecocorp_02" model="wm.collection.order">
            <field name="name">DEMO-COL-M002</field>
            <field name="partner_id" ref="demo_monthly_partner_ecocorp"/>
            <field name="collection_point_id" ref="demo_collection_point_ecocorp"/>
            <field name="actual_start" eval="(datetime.now() - timedelta(days=5)).strftime('%Y-%m-%d 14:00:00')"/>
            <field name="actual_end" eval="(datetime.now() - timedelta(days=5)).strftime('%Y-%m-%d 15:15:00')"/>
            <field name="state">completed</field>
        </record>

        <!-- Record: wm.collection.order.line (demo_col_order_ecocorp_line_02) -->
        <record id="demo_col_order_ecocorp_line_02" model="wm.collection.order.line">
            <field name="order_id" ref="demo_col_order_ecocorp_02"/>
            <field name="category_id" ref="wm_base.wcat_industrial"/>
            <field name="product_id" ref="wm_base.wmat_metal_shavings"/>
            <field name="weight">85.0</field>
        </record>

        <!-- Record: wm.collection.order - DEMO-COL-M003 -->
        <record id="demo_col_order_ecocorp_03" model="wm.collection.order">
            <field name="name">DEMO-COL-M003</field>
            <field name="partner_id" ref="demo_monthly_partner_ecocorp"/>
            <field name="collection_point_id" ref="demo_collection_point_ecocorp"/>
            <field name="actual_start" eval="(datetime.now() - timedelta(days=2)).strftime('%Y-%m-%d 11:00:00')"/>
            <field name="actual_end" eval="(datetime.now() - timedelta(days=2)).strftime('%Y-%m-%d 12:00:00')"/>
            <field name="state">completed</field>
        </record>

        <!-- Record: wm.collection.order.line (demo_col_order_ecocorp_line_03) -->
        <record id="demo_col_order_ecocorp_line_03" model="wm.collection.order.line">
            <field name="order_id" ref="demo_col_order_ecocorp_03"/>
            <field name="category_id" ref="wm_base.wcat_ewaste"/>
            <field name="product_id" ref="wm_base.wmat_batteries"/>
            <field name="weight">30.0</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- DEMO MONTHLY BILLING RUN                                           -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <record id="demo_monthly_billing_run_sample" model="wm.monthly.billing.run">
            <field name="name">BR/2026/08</field>
            <field name="period_start" eval="datetime.now().replace(day=1).strftime('%Y-%m-%d')"/>
            <field name="period_end" eval="datetime.now().strftime('%Y-%m-%d')"/>
            <field name="state">draft</field>
        </record>

        <!-- Record: wm.monthly.billing.run - BR/2026/07 -->
        <record id="demo_monthly_billing_run_done" model="wm.monthly.billing.run">
            <field name="name">BR/2026/07</field>
            <field name="period_start">2026-07-01</field>
            <field name="period_end">2026-07-31</field>
            <field name="state">done</field>
            <field name="line_ids">
                <!-- Record: wm.monthly.billing.run.line (demo_billing_run_line_1) -->
                <record id="demo_billing_run_line_1" model="wm.monthly.billing.run.line">
                    <field name="partner_id" ref="demo_monthly_partner_ecocorp"/>
                    <field name="total_amount">525.00</field>
                    <field name="state">billed</field>
                    <field name="collection_order_ids" eval="[(6, 0, [ref('demo_col_order_ecocorp_01'), ref('demo_col_order_ecocorp_02')])]"/>
                </record>
                <!-- Record: wm.monthly.billing.run.line (demo_billing_run_line_2) -->
                <record id="demo_billing_run_line_2" model="wm.monthly.billing.run.line">
                    <field name="partner_id" ref="demo_res_partner_customer_1"/>
                    <field name="total_amount">380.00</field>
                    <field name="state">billed</field>
                </record>
            </field>
        </record>

    </data>
</odoo>
