<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit the wm.partner.contract form view to add a smart button
        linking back to the originating CRM opportunity.

        Visible only when originated_from_crm = True (i.e. crm_lead_id is set).
        The base form view XML ID is wm_contracts_billing.wm_partner_contract_form.
    -->
    <record id="view_wm_partner_contract_form_crm_inherit" model="ir.ui.view">
        <field name="name">wm.partner.contract.form.crm.inherit</field>
        <field name="model">wm.partner.contract</field>
        <field name="inherit_id" ref="wm_contracts_billing.wm_partner_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_source_lead"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-phone"
                        invisible="not originated_from_crm">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Source</span>
                        <span class="o_stat_text">Opportunity</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
