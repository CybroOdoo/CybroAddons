<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.pricing.rule - wm.pricing.rule.list (List) -->
    <record id="view_wm_pricing_rule_list" model="ir.ui.view">
        <field name="name">wm.pricing.rule.list</field>
        <field name="model">wm.pricing.rule</field>
        <field name="arch" type="xml">
            <list string="Pricing Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="waste_category_id"/>
                <field name="partner_id"/>
                <field name="price_per_kg"/>
                <field name="min_weight"/>
                <field name="min_charge"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- View: wm.pricing.rule - wm.pricing.rule.form (Form) -->
    <record id="view_wm_pricing_rule_form" model="ir.ui.view">
        <field name="name">wm.pricing.rule.form</field>
        <field name="model">wm.pricing.rule</field>
        <field name="arch" type="xml">
            <form string="Pricing Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="waste_category_id"/>
                            <field name="partner_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="price_per_kg"/>
                            <field name="min_weight"/>
                            <field name="min_charge"/>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Pricing Rules -->
    <record id="action_wm_pricing_rule" model="ir.actions.act_window">
        <field name="name">Pricing Rules</field>
        <field name="res_model">wm.pricing.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
