<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.operations.report - wm.operations.report.pivot (Pivot) -->
    <record id="view_wm_operations_report_pivot" model="ir.ui.view">
        <field name="name">wm.operations.report.pivot</field>
        <field name="model">wm.operations.report</field>
        <field name="arch" type="xml">
            <pivot string="Operations Overview" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="waste_category_id" type="col"/>
                <field name="weight_kg" type="measure"/>
                <field name="invoiced_amount" type="measure"/>
                <field name="order_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- View: wm.operations.report - wm.operations.report.graph (Graph) -->
    <record id="view_wm_operations_report_graph" model="ir.ui.view">
        <field name="name">wm.operations.report.graph</field>
        <field name="model">wm.operations.report</field>
        <field name="arch" type="xml">
            <graph string="Operations Overview" type="bar" sample="1">
                <field name="waste_category_id"/>
                <field name="invoiced_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- View: wm.operations.report - wm.operations.report.list (List) -->
    <record id="view_wm_operations_report_list" model="ir.ui.view">
        <field name="name">wm.operations.report.list</field>
        <field name="model">wm.operations.report</field>
        <field name="arch" type="xml">
            <list string="Operations Overview">
                <field name="date"/>
                <field name="waste_category_id"/>
                <field name="partner_id"/>
                <field name="collection_point_id"/>
                <field name="weight_kg"/>
                <field name="invoiced_amount"/>
                <field name="order_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- View: wm.operations.report - wm.operations.report.search (Search) -->
    <record id="view_wm_operations_report_search" model="ir.ui.view">
        <field name="name">wm.operations.report.search</field>
        <field name="model">wm.operations.report</field>
        <field name="arch" type="xml">
            <search string="Operations Overview">
                <field name="waste_category_id"/>
                <field name="partner_id"/>
                <field name="collection_point_id"/>
                <group>
                    <filter string="Waste Category" name="group_category" context="{'group_by':'waste_category_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Collection Point" name="group_point" context="{'group_by':'collection_point_id'}"/>
                    <filter string="Date (Month)" name="group_date_month" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Operations Overview -->
    <record id="action_wm_operations_report" model="ir.actions.act_window">
        <field name="name">Operations Overview</field>
        <field name="res_model">wm.operations.report</field>
        <field name="view_mode">graph,list,pivot</field>
    </record>
</odoo>
