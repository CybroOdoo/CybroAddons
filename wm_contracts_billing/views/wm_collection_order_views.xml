<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.collection.order - wm.collection.order.search.wm_billing (Field) -->
    <record id="view_wm_collection_order_search_wm_billing" model="ir.ui.view">
        <field name="name">wm.collection.order.search.wm_billing</field>
        <field name="model">wm.collection.order</field>
        <field name="inherit_id" ref="wm_collection.view_wm_collection_order_search"/>
        <field name="arch" type="xml">
            <field name="route_id" position="after">
                <field name="consolidated_invoice_id"/>
            </field>
            <xpath expr="//group" position="inside">
                <filter name="groupby_monthly_invoice" context="{'group_by': 'consolidated_invoice_id'}" string="Monthly Invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
