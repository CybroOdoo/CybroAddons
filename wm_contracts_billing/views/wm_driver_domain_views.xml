<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override Fleet Vehicle driver domain -->
    <record id="view_fleet_vehicle_form_inherit_wm_customer" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.wm.customer</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='driver_id']" position="attributes">
                <attribute name="domain">[('is_driver', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Override Change Driver Wizard driver domain -->
    <record id="view_wm_change_driver_wizard_form_inherit_wm_customer" model="ir.ui.view">
        <field name="name">wm.change.driver.wizard.form.inherit.wm.customer</field>
        <field name="model">wm.change.driver.wizard</field>
        <field name="inherit_id" ref="wm_collection.view_wm_change_driver_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='new_driver_id']" position="attributes">
                <attribute name="domain">[('is_driver', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
