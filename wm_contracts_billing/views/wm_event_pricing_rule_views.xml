<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Event Pricing Rule Form View -->
    <record id="view_wm_event_pricing_rule_form" model="ir.ui.view">
        <field name="name">wm.event.pricing.rule.form</field>
        <field name="model">wm.event.pricing.rule</field>
        <field name="arch" type="xml">
            <form string="Billable Event Pricing Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Rule Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Rule Criteria">
                            <field name="sequence"/>
                            <field name="event_type"/>
                            <field name="partner_id" placeholder="All Customers (General Rule)"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Pricing Details">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="price_unit" widget="monetary"/>
                            <field name="min_charge" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Validity Period">
                        <group>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Event Pricing Rule List View -->
    <record id="view_wm_event_pricing_rule_list" model="ir.ui.view">
        <field name="name">wm.event.pricing.rule.list</field>
        <field name="model">wm.event.pricing.rule</field>
        <field name="arch" type="xml">
            <list string="Billable Event Pricing Rules" default_order="sequence asc, id desc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="partner_id"/>
                <field name="price_unit" widget="monetary"/>
                <field name="min_charge" widget="monetary"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Event Pricing Rule Search View -->
    <record id="view_wm_event_pricing_rule_search" model="ir.ui.view">
        <field name="name">wm.event.pricing.rule.search</field>
        <field name="model">wm.event.pricing.rule</field>
        <field name="arch" type="xml">
            <search string="Search Pricing Rules">
                <field name="name"/>
                <field name="event_type"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Event Type" name="groupby_event_type" context="{'group_by': 'event_type'}"/>
                    <filter string="Customer" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Event Pricing Rule Action -->
    <record id="action_wm_event_pricing_rule" model="ir.actions.act_window">
        <field name="name">Event Pricing Rules</field>
        <field name="res_model">wm.event.pricing.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wm_event_pricing_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Billable Event Pricing Rule
            </p>
            <p>
                Define customer-specific or general rate structures for extra pickups, overweight loads, contamination fees, and emergency callouts.
            </p>
        </field>
    </record>
</odoo>
