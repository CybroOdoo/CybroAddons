<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Customization records: portal users can only see their own -->
    <record id="product_design_customization_rule_portal" model="ir.access">
        <field name="name">Product Design Customization: Portal Users</field>
        <field name="model_id" ref="model_product_design_customization"/>
        <field name="group_id" ref="base.group_portal"/>
        <field name="operation">cru</field>
        <field name="domain">[('partner_id', '=', user.partner_id.id)]</field>
    </record>

    <!-- Public users: allow access to records without a partner (guest designs) -->
    <record id="product_design_customization_rule_public" model="ir.access">
        <field name="name">Product Design Customization: Public Users</field>
        <field name="model_id" ref="model_product_design_customization"/>
        <field name="group_id" ref="base.group_public"/>
        <field name="operation">cru</field>
        <field name="domain">[('partner_id', '=', False)]</field>
    </record>

    <record id="product_design_customization_line_rule_portal" model="ir.access">
        <field name="name">Design Customization Line: Portal Users</field>
        <field name="model_id" ref="model_product_design_customization_line"/>
        <field name="group_id" ref="base.group_portal"/>
        <field name="operation">cru</field>
        <field name="domain">[('customization_id.partner_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="product_design_customization_line_rule_public" model="ir.access">
        <field name="name">Design Customization Line: Public Users</field>
        <field name="model_id" ref="model_product_design_customization_line"/>
        <field name="group_id" ref="base.group_public"/>
        <field name="operation">cru</field>
        <field name="domain">[('customization_id.partner_id', '=', False)]</field>
    </record>
</odoo>
