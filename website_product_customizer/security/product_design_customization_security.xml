<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Customization records: portal users can only see their own -->
    <record id="product_design_customization_rule_portal" model="ir.rule">
        <field name="name">Product Design Customization: Portal Users</field>
        <field name="model_id" ref="model_product_design_customization"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Public users: allow access to records without a partner (guest designs) -->
    <record id="product_design_customization_rule_public" model="ir.rule">
        <field name="name">Product Design Customization: Public Users</field>
        <field name="model_id" ref="model_product_design_customization"/>
        <field name="domain_force">[('partner_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
    </record>

    <record id="product_design_customization_line_rule_portal" model="ir.rule">
        <field name="name">Design Customization Line: Portal Users</field>
        <field name="model_id" ref="model_product_design_customization_line"/>
        <field name="domain_force">[('customization_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="product_design_customization_line_rule_public" model="ir.rule">
        <field name="name">Design Customization Line: Public Users</field>
        <field name="model_id" ref="model_product_design_customization_line"/>
        <field name="domain_force">[('customization_id.partner_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
    </record>
</odoo>
