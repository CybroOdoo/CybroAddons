<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Product Design Font Views -->
    <record id="product_design_font_view_tree" model="ir.ui.view">
        <field name="name">product.design.font.tree</field>
        <field name="model">product.design.font</field>
        <field name="arch" type="xml">
            <list string="Fonts">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="font_family_name"/>
                <field name="provider"/>
                <field name="google_url" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Product Design Font Form View -->
    <record id="product_design_font_view_form" model="ir.ui.view">
        <field name="name">product.design.font.form</field>
        <field name="model">product.design.font</field>
        <field name="arch" type="xml">
            <form string="Font">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. My Custom Font"/></h1>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="font_family_name" placeholder="e.g. MyFontFamily"/>
                    </group>
                    
                    <notebook>
                        <page string="Configuration">
                            <group>
                                <field name="provider" widget="radio" options="{'horizontal': true}"/>
                            </group>
                            
                            <!-- Google Fonts Section -->
                            <group string="Google Fonts Details" invisible="provider != 'google'">
                                <field name="google_url" invisible="provider != 'google'" required="provider == 'google'" 
                                       placeholder="e.g. https://fonts.googleapis.com/css2?family=Roboto&amp;display=swap"/>
                                <div class="text-muted" colspan="2" invisible="provider != 'google'">
                                    Enter the full URL from Google Fonts (Select 'Use on the web' > copy the href in the &lt;link&gt; tag).
                                </div>
                            </group>

                            <!-- Custom Upload Section -->
                            <group string="Upload File" invisible="provider != 'custom'">
                                <field name="font_filename" invisible="1"/>
                                <field name="font_file" filename="font_filename" 
                                       invisible="provider != 'custom'" required="provider == 'custom'"/>
                                <div class="text-muted" colspan="2" invisible="provider != 'custom'">
                                    Upload your .ttf, .otf, or .woff font file here.
                                </div>
                            </group>
                            
                            <!-- System Font Section -->
                            <group string="System Configuration" invisible="provider != 'system'">
                                <div class="text-muted" colspan="2">
                                    System fonts use the fonts already available on the user's device (e.g. Arial, Times New Roman).
                                    No file or URL is required, just ensure the 'Font Family' name above is correct.
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Product Design Font Action -->
    <record id="action_product_design_font" model="ir.actions.act_window">
        <field name="name">Fonts</field>
        <field name="res_model">product.design.font</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new font
            </p>
            <p>
                Manage fonts available in the product designer. 
                You can use Google Fonts or upload custom font files.
            </p>
        </field>
    </record>

    <!-- Product Design Font Search View -->
    <record id="view_product_design_font_search" model="ir.ui.view">
        <field name="name">product.design.font.search</field>
        <field name="model">product.design.font</field>
        <field name="arch" type="xml">
            <search string="Search Design Fonts">
                <field name="name"/>
                <field name="font_family_name"/>
                <field name="provider"/>
                <field name="active"/>


                <filter name="filter_active"
                        string="Active"
                        domain="[('active','=',True)]"/>

                <filter name="filter_inactive"
                        string="Archived"
                        domain="[('active','=',False)]"/>

                <separator/>


                <filter name="filter_google"
                        string="Google Fonts"
                        domain="[('provider','=','google')]"/>

                <filter name="filter_custom"
                        string="Custom Fonts"
                        domain="[('provider','=','custom')]"/>

                <filter name="filter_system"
                        string="System Fonts"
                        domain="[('provider','=','system')]"/>

                <separator/>


                <filter name="group_by_provider"
                        string="Provider"
                        context="{'group_by': 'provider'}"/>

                <filter name="group_by_active"
                        string="Active Status"
                        context="{'group_by': 'active'}"/>
            </search>
        </field>
    </record>
</odoo>
