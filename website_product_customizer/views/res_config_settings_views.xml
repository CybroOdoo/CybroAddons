<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Settings View — adds a "Product Designer" app section to Settings -->
    <record id="res_config_settings_view_form_designer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.designer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <form position="inside">
                <app data-string="Product Designer"
                     string="Product Designer"
                     name="website_product_customizer"
                     groups="base.group_system">
                    <block title="Upload Settings" name="upload_settings_block">
                        <setting
                            id="designer_upload_setting"
                            string="Max Upload Size"
                            help="Maximum file size for customer image uploads (in MB)"
                        >
                            <label for="designer_max_upload_size" class="o_light_label"/>
                            <field name="designer_max_upload_size" class="oe_inline"/>
                            <span class="text-muted ms-1">MB</span>
                        </setting>
                    </block>
                </app>
            </form>
        </field>
    </record>

    <!-- Action to open settings filtered to this module's section -->
    <record id="action_product_designer_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
        <field name="context">{'module': 'website_product_customizer'}</field>
    </record>
</odoo>
