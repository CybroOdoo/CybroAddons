<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Main Menu - Product Designer -->
    <menuitem id="website_product_customizer_menu"
              name="Product Designer"
              web_icon="website_product_customizer,static/description/icon.png"
              sequence="65"/>

    <!-- Customer Designs Menu -->
    <menuitem id="menu_designer_customizations"
              name="Customer Designs"
              parent="website_product_customizer_menu"
              action="product_design_customization_action"
              sequence="5"/>

    <!-- Catalog Menus -->
    <menuitem id="menu_designer_catalog"
              name="Catalog"
              parent="website_product_customizer_menu"
              sequence="10"/>


    <menuitem id="menu_designer_templates"
              name="Design Templates"
              parent="menu_designer_catalog"
              action="action_product_design_template"
              sequence="20"/>

     <!-- Configuration Menus -->
    <menuitem id="menu_designer_configuration"
              name="Configuration"
              parent="website_product_customizer_menu"
              sequence="20"/>

        <menuitem id="menu_designer_settings"
              name="Settings"
              parent="menu_designer_configuration"
              action="action_product_designer_settings"
              sequence="5"/>



    <menuitem id="menu_designer_fonts"
              name="Fonts"
              parent="menu_designer_configuration"
              action="action_product_design_font"
              sequence="40"/>

    <menuitem id="menu_designer_colors"
              name="Colors"
              parent="menu_designer_configuration"
              action="action_product_design_color"
              sequence="50"/>

    <!-- Product Menus -->
    <menuitem id="website_product_customizer_menu_products"
          name="Products"
          parent="website_product_customizer_menu"
          sequence="10"/>

    <menuitem id="menu_product_templ"
              name="Products"
              parent="website_product_customizer_menu_products"
              action="product.product_template_action"
              sequence="5"/>

    <menuitem id="menu_product_var"
              name="Product Variants"
              parent="website_product_customizer_menu_products"
              action="product.product_normal_action_sell"
              sequence="10"/>

    <menuitem id="menu_product_attr"
              name="Attributes"
              parent="website_product_customizer_menu_products"
              action="product.attribute_action"
              sequence="15"/>

    <menuitem id="menu_product_ecomm_categ"
              name="eCommerce Categories"
              parent="website_product_customizer_menu_products"
              action="website_sale.product_public_category_action"
              sequence="15"/>
</odoo>
