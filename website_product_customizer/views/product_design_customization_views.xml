<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Customer Design Customization Views -->
    <record id="product_design_customization_action" model="ir.actions.act_window">
        <field name="name">Customer Designs</field>
        <field name="res_model">product.design.customization</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customer designs yet
            </p>
            <p>Customer designs will appear here once they start customizing products.</p>
        </field>
    </record>

    <!-- Customer Designs Tree View -->
    <record id="product_design_customization_view_tree" model="ir.ui.view">
        <field name="name">product.design.customization.tree</field>
        <field name="model">product.design.customization</field>
        <field name="arch" type="xml">
            <list string="Customer Designs">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="state"/>
                <field name="quantity"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Customer Designs Form View -->
    <record id="product_design_customization_view_form" model="ir.ui.view">
        <field name="name">product.design.customization.form</field>
        <field name="model">product.design.customization</field>
        <field name="arch" type="xml">
            <form string="Customer Design">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,saved,ordered,approved,in_production,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="preview_image" widget="image" class="oe_avatar"/>
                        </group>
                        <group>
                            <field name="preview_image_back" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="product_id"/>
                            <field name="design_template_id"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="sale_order_line_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Design Elements">
                            <field name="customization_line_ids">
                                <list>

                                    <field name="custom_text"/>
                                    <field name="font_family"/>
                                    <field name="font_size"/>
                                    <field name="font_color"/>
                                    <field name="text_alignment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Design JSON">
                            <field name="design_json" widget="ace"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Customer Design Customization Search View -->
    <record id="product_design_customization_view_search" model="ir.ui.view">
        <field name="name">product.design.customization.search</field>
        <field name="model">product.design.customization</field>
        <field name="arch" type="xml">
            <search string="Search Design Customizations">

                <!-- Searchable Fields -->
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="design_template_id"/>
                <field name="state"/>
                <field name="sale_order_line_id"/>

                <!-- State Filters -->
                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state','=','draft')]"/>

                <filter name="filter_saved"
                        string="Saved"
                        domain="[('state','=','saved')]"/>

                <filter name="filter_ordered"
                        string="Ordered"
                        domain="[('state','=','ordered')]"/>

                <filter name="filter_in_production"
                        string="In Production"
                        domain="[('state','=','in_production')]"/>

                <filter name="filter_completed"
                        string="Completed"
                        domain="[('state','=','completed')]"/>

                <filter name="filter_cancelled"
                        string="Cancelled"
                        domain="[('state','=','cancelled')]"/>

                <separator/>

                <!-- Special Filters -->
                <filter name="filter_linked_sale"
                        string="Linked to Sale Order"
                        domain="[('sale_order_line_id','!=',False)]"/>

                <filter name="filter_guest"
                        string="Guest Designs"
                        domain="[('partner_id','=',False)]"/>

                <separator/>

                <!-- Group By -->
                <filter name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"/>

                <filter name="group_by_customer"
                        string="Customer"
                        context="{'group_by': 'partner_id'}"/>

                <filter name="group_by_product"
                        string="Product"
                        context="{'group_by': 'product_tmpl_id'}"/>

                <filter name="group_by_template"
                        string="Starting Template"
                        context="{'group_by': 'design_template_id'}"/>

                <filter name="group_by_date"
                        string="Creation Date"
                        context="{'group_by': 'create_date:day'}"/>

            </search>
        </field>
    </record>
</odoo>
