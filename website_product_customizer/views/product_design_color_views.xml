<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Product Design Color Views -->
    <record id="product_design_color_view_tree" model="ir.ui.view">
        <field name="name">product.design.color.tree</field>
        <field name="model">product.design.color</field>
        <field name="arch" type="xml">
            <list string="Design Colors" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color_code" widget="color"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form view for creating and editing product design colors. -->
    <record id="product_design_color_view_form" model="ir.ui.view">
        <field name="name">product.design.color.form</field>
        <field name="model">product.design.color</field>
        <field name="arch" type="xml">
            <form string="Design Color">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color_code" widget="color"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to access and manage product design colors. -->
    <record id="action_product_design_color" model="ir.actions.act_window">
        <field name="name">Design Colors</field>
        <field name="res_model">product.design.color</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new design color
            </p>
            <p>
                Manage colors that customers can use as background fills or text colors
                in the product designer.
            </p>
        </field>
    </record>
</odoo>
