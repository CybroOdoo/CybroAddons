<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Extend Sale Order Form View -->
    <record id="sale_order_form_view_designer" model="ir.ui.view">
        <field name="name">sale.order.form.designer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_designs" type="object"
                        class="oe_stat_button" icon="fa-paint-brush"
                        invisible="not has_design_products">
                    <field name="design_customization_count" string="Designs" widget="statbutton"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Extend Sale Order Line Tree View -->
    <record id="sale_order_line_tree_view_designer" model="ir.ui.view">
        <field name="name">sale.order.line.tree.designer</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_designed" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
