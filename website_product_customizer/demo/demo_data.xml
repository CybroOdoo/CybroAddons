<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <!-- ================================================================== -->
    <!--                      NATIVE PRODUCT ATTRIBUTES                     -->
    <!-- ================================================================== -->

    <record id="attr_size" model="product.attribute">
        <field name="name">Size</field>
        <field name="display_type">radio</field>
        <field name="create_variant">always</field>
    </record>

    <record id="attr_material" model="product.attribute">
        <field name="name">Material</field>
        <field name="display_type">radio</field>
        <field name="create_variant">always</field>
    </record>

    <!-- Generic Size Values -->
    <record id="val_size_small" model="product.attribute.value">
        <field name="name">Small</field>
        <field name="attribute_id" ref="attr_size"/>
    </record>
    <record id="val_size_medium" model="product.attribute.value">
        <field name="name">Medium</field>
        <field name="attribute_id" ref="attr_size"/>
    </record>
    <record id="val_size_large" model="product.attribute.value">
        <field name="name">Large</field>
        <field name="attribute_id" ref="attr_size"/>
    </record>

    <!-- Generic Material Values -->
    <record id="val_mat_standard" model="product.attribute.value">
        <field name="name">Standard</field>
        <field name="attribute_id" ref="attr_material"/>
    </record>
    <record id="val_mat_premium" model="product.attribute.value">
        <field name="name">Premium</field>
        <field name="attribute_id" ref="attr_material"/>
    </record>


    <!-- ================================================================== -->
    <!--                      BANNERS & SIGNS                               -->
    <!-- ================================================================== -->

    <record id="product_banner_outdoor" model="product.template">
        <field name="name">Custom Outdoor Banner</field>
        <field name="type">consu</field>
        <field name="list_price">29.99</field>
        <field name="sale_ok">True</field>
        <field name="is_published">True</field>
        <field name="is_designable">True</field>
        <field name="design_category_id" ref="design_category_banners"/>
        <field name="public_categ_ids" eval="[(6, 0, [ref('design_category_banners')])]"/>
        <field name="has_front_back">False</field>
        <field name="production_time_days">3</field>
        <field name="min_order_quantity">1</field>
        <field name="max_order_quantity">500</field>
        <field name="design_instruction">&lt;p&gt;Upload your artwork or use our designer to create a stunning outdoor banner. For best results, use high-resolution images (300 DPI).&lt;/p&gt;</field>
    </record>

    <record id="ptal_size_product_banner_outdoor" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="product_banner_outdoor"/>
        <field name="attribute_id" ref="attr_size"/>
        <field name="value_ids" eval="[(6, 0, [ref('val_size_small'), ref('val_size_medium'), ref('val_size_large')])]"/>
    </record>
    <record id="ptal_mat_product_banner_outdoor" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="product_banner_outdoor"/>
        <field name="attribute_id" ref="attr_material"/>
        <field name="value_ids" eval="[(6, 0, [ref('val_mat_standard'), ref('val_mat_premium')])]"/>
    </record>




