<?xml version="1.0" encoding="utf-8"?>
<!--
    views/contactus_templates.xml — Custom OdoNova Consultation Page
    Overrides the default website.contactus template with the branded
    split-layout design (left content + right form card).
-->
<odoo>

    <!-- Override the default Contact Us page template -->
    <template id="consultation_template"
              name="OdoNova — Consultation Page"
              key="theme_odonova.consultation_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Consultation Form Snippet -->
                <section class="s_odonova_consultation odonova-consultation-section o_colored_level" data-snippet="s_odonova_consultation" data-name="Consultation Form">
                    <div class="container">
                        <div class="odonova-consultation-grid">
                            
                            <!-- LEFT: Content -->
                            <div class="odonova-consultation-content animate-on-scroll">
                                <h1>Let's transform your operations.</h1>
                                <p>Book a free 30-minute discovery call with one of our Odoo experts and discover the power of integrated business management.</p>

                                <div class="odonova-benefits-list">
                                    <!-- Item 1 -->
                                    <div class="odonova-benefit-item">
                                        <div class="odonova-benefit-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                        </div>
                                        <div class="odonova-benefit-text">
                                            <h3>System Audit</h3>
                                            <p>Brief review of your existing tools and workflows to identify key areas for automation and improvement.</p>
                                        </div>
                                    </div>
                                    <!-- Item 2 -->
                                    <div class="odonova-benefit-item">
                                        <div class="odonova-benefit-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                                        </div>
                                        <div class="odonova-benefit-text">
                                            <h3>Strategic Roadmap</h3>
                                            <p>High-level discussion on how an integrated ERP ecosystem can unify your scattered processes.</p>
                                        </div>
                                    </div>
                                    <!-- Item 3 -->
                                    <div class="odonova-benefit-item">
                                        <div class="odonova-benefit-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                                        </div>
                                        <div class="odonova-benefit-text">
                                            <h3>ROI Estimation</h3>
                                            <p>Initial insights into the potential time and cost savings a tailored Odoo implementation could yield.</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Proof -->
                                <div class="odonova-proof">
                                    <div class="odonova-proof-avatars">
                                        <img src="/theme_odonova/static/src/img/about/mission_team.png" alt="Avatar"/>
                                        <img src="/theme_odonova/static/src/img/hero_dashboard.png" style="background-color: #8b5cf6;" alt="Avatar"/>
                                        <img src="/theme_odonova/static/src/img/about/mission_team.png" alt="Avatar"/>
                                    </div>
                                    <div class="odonova-proof-text">
                                        <div class="odonova-proof-title">Talk to certified architects</div>
                                        <div class="odonova-proof-subtitle">Over 250+ implementations completed</div>
                                    </div>
                                </div>
                            </div>

                            <!-- RIGHT: Form Card -->
                            <div class="odonova-form-card animate-on-scroll">
                                <h2>Schedule your call</h2>
                                <form id="contactus_form" action="/website/form/" method="post"
                                    enctype="multipart/form-data"
                                    class="o_mark_required s_website_form s_website_form_no_recaptcha"
                                    data-mark="*"
                                    data-model_name="crm.lead"
                                    data-success-mode="redirect"
                                    data-success-page="/contactus-thank-you"
                                    data-pre-fill="true">

                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <!-- Required: lead title (hidden) -->
                                    <input type="hidden" id="lead_name" name="name" value="Website Consultation Request"/>

                                    <div class="odonova-form-row">
                                        <div class="odonova-form-group s_website_form_field">
                                            <label for="fname">First Name</label>
                                            <input type="text" name="contact_name" placeholder="Jane"
                                                class="form-control s_website_form_input" required=""/>
                                        </div>
                                        <div class="odonova-form-group s_website_form_field">
                                            <label for="lname">Last Name</label>
                                            <input type="text" name="lastname" placeholder="Doe"
                                                class="form-control s_website_form_input"/>
                                        </div>
                                    </div>

                                    <div class="odonova-form-group s_website_form_field">
                                        <label for="email">Work Email</label>
                                        <input type="email" name="email_from" placeholder="jane@company.com"
                                            class="form-control s_website_form_input" required=""/>
                                    </div>

                                    <div class="odonova-form-group s_website_form_field">
                                        <label for="company">Company Name</label>
                                        <input type="text" id="company_field" name="partner_name" placeholder="Acme Corp"
                                            class="form-control s_website_form_input"/>
                                    </div>

                                    <div class="odonova-form-group s_website_form_field">
                                        <label for="goals">What are your primary goals?</label>
                                        <textarea name="description"
                                            placeholder="Tell us briefly about your current bottlenecks or what you are looking to achieve with Odoo..."
                                            rows="4" class="form-control s_website_form_input"></textarea>
                                    </div>

                                    <div class="s_website_form_submit">
                                        <button type="submit" class="odonova-btn-submit btn s_website_form_send">
                                            Request Consultation
                                        </button>
                                        <span id="s_website_form_result"></span>
                                    </div>

                                    <div class="odonova-form-disclaimer">
                                        By submitting this form, you agree to our <a href="/privacy">Privacy Policy</a>.
                                    </div>
                                </form>
                                    <script>
                                        document.addEventListener('DOMContentLoaded', function () {
                                            var btn = document.querySelector('#contactus_form .s_website_form_send');

                                            if (btn) {
                                                btn.addEventListener('click', function () {
                                                    var company = document.getElementById('company_field').value.trim();
                                                    var leadName = 'Website Consultation Request';

                                                    if (company) {
                                                        leadName += ' - ' + company;
                                                    }

                                                    document.getElementById('lead_name').value = leadName;
                                                    console.log('Final Lead Name:', leadName);
                                                });
                                            }
                                        });
                                    </script>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>




    <!-- About Page Record -->
    <data noupdate="1">
        <record id="consultation_page" model="website.page">
            <field name="name">OdoNova — Consultation Page</field>
            <field name="type">qweb</field>
            <field name="url">/consultation</field>
            <field name="view_id" ref="theme_odonova.consultation_template"/>
            <field name="key">theme_odonova.consultation_template</field>
            <field name="is_published">True</field>
        </record>
    </data>
</odoo>
