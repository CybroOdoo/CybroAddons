<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="odonova_contactus_override"
              inherit_id="website.contactus"
              name="OdoNova — Consultation Page"
              customize_show="False">

        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure odonova-contact-wrap">
                <section class="odonova-consultation-section o_colored_level">
                    <div class="container">
                        <div class="odonova-consultation-grid">

                            <!-- LEFT: Content -->
                            <div class="odonova-consultation-content animate-on-scroll">
                                <h1>Let's transform your operations.</h1>
                                <p>Book a free 30-minute discovery call with one of our
                                    Odoo experts and discover the power of integrated
                                    business management.
                                </p>

                                <div class="odonova-benefits-list">
                                    <div class="odonova-benefit-item">
                                        <div class="odonova-benefit-icon">
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2">
                                                <circle cx="11" cy="11" r="8"/>
                                                <path d="m21 21-4.3-4.3"/>
                                            </svg>
                                        </div>
                                        <div class="odonova-benefit-text">
                                            <h3>System Audit</h3>
                                            <p>Brief review of your existing tools and
                                                workflows to identify key areas for
                                                automation and improvement.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="odonova-benefit-item">
                                        <div class="odonova-benefit-icon">
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2">
                                                <rect width="7" height="7" x="3" y="3" rx="1"/>
                                                <rect width="7" height="7" x="14" y="3" rx="1"/>
                                                <rect width="7" height="7" x="14" y="14" rx="1"/>
                                                <rect width="7" height="7" x="3" y="14" rx="1"/>
                                            </svg>
                                        </div>
                                        <div class="odonova-benefit-text">
                                            <h3>Strategic Roadmap</h3>
                                            <p>High-level discussion on how an integrated
                                                ERP ecosystem can unify your scattered
                                                processes.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="odonova-benefit-item">
                                        <div class="odonova-benefit-icon">
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2">
                                                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                                            </svg>
                                        </div>
                                        <div class="odonova-benefit-text">
                                            <h3>ROI Estimation</h3>
                                            <p>Initial insights into the potential time
                                                and cost savings a tailored Odoo
                                                implementation could yield.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="odonova-proof">
                                    <div class="odonova-proof-avatars">
                                        <img src="/theme_odonova/static/src/img/about/mission_team.png"
                                             alt="Avatar"/>
                                        <img src="/theme_odonova/static/src/img/hero_dashboard.png"
                                             style="background-color: #8b5cf6;" alt="Avatar"/>
                                        <img src="/theme_odonova/static/src/img/about/mission_team.png"
                                             alt="Avatar"/>
                                    </div>
                                    <div class="odonova-proof-text">
                                        <div class="odonova-proof-title">
                                            Talk to certified architects
                                        </div>
                                        <div class="odonova-proof-subtitle">
                                            Over 250+ implementations completed
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- RIGHT: Form Card -->
                            <div class="odonova-form-card animate-on-scroll">
                                <h2>Schedule your call</h2>

                                <!--
                                    Plain POST to our own controller.
                                    No website_form_signature needed.
                                    No model whitelist needed.
                                    csrf=True on the route handles security.
                                -->
                                <form action="/odonova/contact/submit"
                                      method="post"
                                      enctype="multipart/form-data">

                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>

                                    <div class="odonova-form-row">
                                        <div class="odonova-form-group">
                                            <label for="fname">First Name</label>
                                            <input type="text"
                                                   name="fname"
                                                   id="fname"
                                                   placeholder="Jane"
                                                   class="form-control"
                                                   required="required"/>
                                        </div>
                                        <div class="odonova-form-group">
                                            <label for="lname">Last Name</label>
                                            <input type="text"
                                                   name="lname"
                                                   id="lname"
                                                   placeholder="Doe"
                                                   class="form-control"/>
                                        </div>
                                    </div>

                                    <div class="odonova-form-group">
                                        <label for="contact_email">
                                            Work Email
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input type="email"
                                               name="email_from"
                                               id="contact_email"
                                               placeholder="jane@company.com"
                                               class="form-control"
                                               required="required"/>
                                    </div>

                                    <div class="odonova-form-group">
                                        <label for="contact_company">Company Name</label>
                                        <input type="text"
                                               name="partner_name"
                                               id="contact_company"
                                               placeholder="Acme Corp"
                                               class="form-control"/>
                                    </div>

                                    <div class="odonova-form-group">
                                        <label for="contact_goals">
                                            What are your primary goals?
                                        </label>
                                        <textarea name="description"
                                                  id="contact_goals"
                                                  placeholder="Tell us briefly about your bottlenecks..."
                                                  rows="4"
                                                  class="form-control"></textarea>
                                    </div>

                                    <div class="odonova-form-submit-row">
                                        <button type="submit"
                                                class="odonova-btn-submit btn">
                                            Request Consultation
                                        </button>
                                    </div>

                                    <div class="odonova-form-disclaimer">
                                        By submitting this form, you agree to our
                                        <a href="/privacy">Privacy Policy</a>.
                                    </div>

                                </form>
                            </div>

                        </div>
                    </div>
                </section>
            </div>
            <div id="wrap" class="oe_structure oe_empty"/>
        </xpath>

    </template>
</odoo>
