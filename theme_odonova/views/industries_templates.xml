<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 2. Industries Page Template -->
    <template id="industries_template" name="Industries" key="theme_odonova.industries_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- 1. Industries Hero -->
                <section class="s_odonova_industries_hero odonova-industries-hero o_colored_level" data-snippet="s_odonova_industries_hero" data-name="Industries Hero">
                    <div class="container">
                        <h1 class="animate-on-scroll">Industries We Transform</h1>
                        <p class="animate-on-scroll">
                            Every sector has its unique challenges. We deliver purpose-built Odoo
                            ERP solutions engineered for the specific demands of your industry.
                        </p>
                    </div>
                </section>

                <!-- 3. Industries Featured -->
                <section class="s_odonova_industries_featured odonova-featured-industries o_colored_level" data-snippet="s_odonova_industries_featured" data-name="Industries Featured">
                    <div class="container">
                        <div class="odonova-featured-industry">
                            <div class="odonova-industry-content animate-on-scroll">
                                <span class="odonova-industry-badge">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                                        <path d="M9 3v18M15 3v18M3 9h18M3 15h18"/>
                                    </svg>
                                    Featured Industry
                                </span>
                                <h2>Manufacturing &amp; Production</h2>
                                <p>
                                    Streamline your entire production line with real-time tracking,
                                    automated quality control, and intelligent resource routing. Odoo
                                    adapts to discrete, process, or mixed-mode manufacturing
                                    effortlessly.
                                </p>
                                <div class="odonova-feature-list">
                                    <div class="odonova-feature-item">
                                        <div class="odonova-check">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                <path d="M20 6L9 17l-5-5"/>
                                            </svg>
                                        </div>
                                        Multi-level Bill of Materials (BOM) management
                                    </div>
                                    <div class="odonova-feature-item">
                                        <div class="odonova-check">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                <path d="M20 6L9 17l-5-5"/>
                                            </svg>
                                        </div>
                                        Work center scheduling and capacity planning
                                    </div>
                                    <div class="odonova-feature-item">
                                        <div class="odonova-check">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                <path d="M20 6L9 17l-5-5"/>
                                            </svg>
                                        </div>
                                        IoT Integration for machine monitoring
                                    </div>
                                </div>
                            </div>
                            <div class="odonova-industry-image animate-on-scroll">
                                <img src="/theme_odonova/static/src/img/industries/manufacturing.png" alt="Manufacturing &amp; Production" class="img-fluid"/>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 4. Industries Grid -->
                <section class="s_odonova_industries_grid odonova-industry-grid-section o_colored_level" data-snippet="s_odonova_industries_grid" data-name="Industries Grid">
                    <div class="container text-center">
                        <div class="odonova-section-header mx-auto">
                            <h2>Specialized Solutions for Every Sector</h2>
                            <p>
                                Beyond our featured industries, our certified experts have successfully implemented
                                Odoo across a wide spectrum of complex business environments.
                            </p>
                        </div>
                        <div class="odonova-industry-cards">
                            <!-- Logistics -->
                            <div class="odonova-industry-card animate-on-scroll">
                                <div class="odonova-icon-box">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                </div>
                                <h3>Logistics &amp; Supply Chain</h3>
                                <p>Optimize fleet management, multi-warehouse routing, advanced barcode scanning, and 3PL integrations for end-to-end supply chain visibility.</p>
                                <a href="#" class="odonova-learn-more">Learn more <i class="fa fa-arrow-right"/></a>
                            </div>

                            <!-- Professional Services -->
                            <div class="odonova-industry-card animate-on-scroll">
                                <div class="odonova-icon-box">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                        <path d="M3 9h18M9 21V9"/>
                                    </svg>
                                </div>
                                <h3>Professional Services</h3>
                                <p>Manage project lifecycles seamlessly. From resource scheduling and timesheets to automated recurring billing and profitability analysis.</p>
                                <a href="#" class="odonova-learn-more">Learn more <i class="fa fa-arrow-right"/></a>
                            </div>

                            <!-- Healthcare -->
                            <div class="odonova-industry-card animate-on-scroll">
                                <div class="odonova-icon-box">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                                    </svg>
                                </div>
                                <h3>Healthcare &amp; Life Sciences</h3>
                                <p>Ensure strict compliance, track medical supplies with lot/serial numbers, and manage patient data securely in a centralized ERP environment.</p>
                                <a href="#" class="odonova-learn-more">Learn more <i class="fa fa-arrow-right"/></a>
                            </div>

                            <!-- Construction -->
                            <div class="odonova-industry-card animate-on-scroll">
                                <div class="odonova-icon-box">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 21v-4a4 4 0 1 1 8 0v4"/>
                                        <path d="M13 21v-7a4 4 0 1 1 8 0v7"/>
                                        <path d="M21 21H3"/>
                                    </svg>
                                </div>
                                <h3>Construction &amp; Real Estate</h3>
                                <p>Handle project costing, subcontractor management, and equipment tracking with ease. Integrated mobile apps for site reports.</p>
                                <a href="#" class="odonova-learn-more">Learn more <i class="fa fa-arrow-right"/></a>
                            </div>

                            <!-- Food & Beverage -->
                            <div class="odonova-industry-card animate-on-scroll">
                                <div class="odonova-icon-box">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                                        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                                        <line x1="6" y1="1" x2="6" y2="4"/>
                                        <line x1="10" y1="1" x2="10" y2="4"/>
                                        <line x1="14" y1="1" x2="14" y2="4"/>
                                    </svg>
                                </div>
                                <h3>Food &amp; Beverage</h3>
                                <p>Manage perishable inventory, expiration dates, and complex recipes. Full traceability from farm to fork with integrated quality checks.</p>
                                <a href="#" class="odonova-learn-more">Learn more <i class="fa fa-arrow-right"/></a>
                            </div>

                            <!-- Wholesale -->
                            <div class="odonova-industry-card animate-on-scroll">
                                <div class="odonova-icon-box">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                                        <line x1="12" y1="22.08" x2="12" y2="12"/>
                                    </svg>
                                </div>
                                <h3>Wholesale &amp; Distribution</h3>
                                <p>Automate replenishment, optimize picking routes, and manage multi-channel sales from a single dashboard. Scale your volume effortlessly.</p>
                                <a href="#" class="odonova-learn-more">Learn more <i class="fa fa-arrow-right"/></a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 5. CTA Banner -->
                <section class="s_odonova_cta pt96 pb96 o_colored_level" data-snippet="s_odonova_cta" data-name="OdoNova CTA Banner" style="background: linear-gradient(135deg, #0b66ff, #004bbd); color: white;">
                    <div class="container position-relative">
                        <div class="row align-items-center">
                            <div class="col-lg-7 mb-4 mb-lg-0 pe-lg-5 text-center text-lg-start">
                                <h2 class="display-4 fw-bold mb-3 text-white">Join our journey.</h2>
                                <p class="lead mb-0 opacity-75">Ready to upgrade your operations? Book a free discovery call with our certified Odoo architects.</p>
                            </div>
                            <div class="col-lg-5 border-start border-light border-opacity-25 ps-lg-5 ms-md-auto text-center text-lg-start">
                                <div class="d-flex flex-column gap-3 align-items-center align-items-lg-start">
                                    <a href="/consultation" class="btn btn-light btn-lg rounded-pill px-5 fw-bold text-primary shadow" style="min-width: 250px;">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- 3. Industries Page Record -->
    <data noupdate="1">
        <record id="industries_page" model="website.page">
            <field name="name">Industries</field>
            <field name="type">qweb</field>
            <field name="url">/industries</field>
            <field name="view_id" ref="theme_odonova.industries_template"/>
            <field name="key">theme_odonova.industries_page</field>
            <field name="is_published">True</field>
        </record>
    </data>
</odoo>
