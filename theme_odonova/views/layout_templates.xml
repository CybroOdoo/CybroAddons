<?xml version="1.0" encoding="utf-8"?>
<!--
    views/layout_templates.xml — Odoo 19 safe QWeb overrides
-->
<odoo>

    <!-- 1. Google Fonts + meta theme-color into <head> -->
    <template id="theme_head_inject"
              inherit_id="website.layout"
              name="OdoNova ERP — Head Inject"
              customize_show="False">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap"
                  rel="stylesheet"/>
            <meta name="theme-color" content="#0b66ff"/>
        </xpath>
    </template>

    <!-- 2. Add data attribute and class to header for JS/CSS hooks -->
    <template id="theme_header_class"
              inherit_id="website.layout"
              name="OdoNova ERP — Header Class"
              customize_show="False">
        <xpath expr="//header" position="attributes">
            <attribute name="data-odonova-header">true</attribute>
            <attribute name="class" add="odonova-header" separator=" "/>
        </xpath>
    </template>

    <!-- 3. Custom Navbar Links (Services, Industries, Case Studies, About) -->
    <template id="theme_navbar_links"
              inherit_id="website.navbar_nav"
              name="OdoNova ERP — Nav Links"
              customize_show="False">
        <xpath expr="//ul" position="replace">
            <ul class="navbar-nav mx-auto odonova-navbar">
                <li class="nav-item">
                    <a href="/" class="nav-link">Home</a>
                </li>
                <li class="nav-item">
                    <a href="/#s_odonova_services" class="nav-link">Services</a>
                </li>
                <li class="nav-item">
                    <a href="/industries"
                       t-att-class="'nav-link' + (' active' if request.httprequest.path == '/industries' else '')">
                        Industries
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/case-studies"
                       t-att-class="'nav-link' + (' active' if request.httprequest.path == '/case-studies' else '')">
                        Case Studies
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/about"
                       t-att-class="'nav-link' + (' active' if request.httprequest.path == '/about' else '')">
                        About
                    </a>
                </li>
            </ul>
        </xpath>
    </template>

    <!-- 4. Log in link + Book Consultation button in navbar -->
    <template id="theme_header_cta"
              inherit_id="website.placeholder_header_call_to_action"
              name="OdoNova ERP — Header CTA"
              customize_show="False">
        <xpath expr="." position="inside">
            <li class="odonova-header-cta-item">
                <div class="odonova-header-cta d-none d-lg-flex align-items-center ms-3">
                    <a href="/consultation" class="odonova-btn-primary text-light odonova-book-cta">
                        Book Consultation
                    </a>
                </div>
            </li>
        </xpath>
    </template>

    <!-- Hide default Odoo footer -->
    <template id="theme_hide_default_footer"
              inherit_id="website.footer_custom"
              name="OdoNova ERP — Hide Default Footer"
              customize_show="False">
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="replace"/>
    </template>


    <!-- 4. Custom Footer -->
    <template id="theme_custom_footer"
              inherit_id="website.layout"
              name="OdoNova ERP — Footer"
              customize_show="False">
        <xpath expr="//footer" position="replace">
            <div class="odonova-footer-inner">
                <div class="container">
                    <div class="odonova-footer-grid">
                        <div class="odonova-footer-brand">
                            <a href="/" class="odonova-logo d-flex align-items-center gap-2">
                                <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                                    <rect width="28" height="28" rx="5" fill="#0b66ff"/>
                                    <path d="M7 9h5v10H7V9zm9 3h5v7h-5v-7z" fill="#fff"/>
                                </svg>
                                <span class="odonova-logo-text">OdoNova ERP</span>
                            </a>
                            <p class="mt-3">The leading Odoo implementation agency for ambitious enterprises.</p>
                        </div>
                        <div class="odonova-footer-col">
                            <h4>Services</h4>
                            <ul>
                                <li>
                                    <a href="javascript:void(0)">Implementation</a>
                                </li>
                                <li>
                                    <a href="javascript:void(0)">Customization</a>
                                </li>
                                <li>
                                    <a href="javascript:void(0)">Migration</a>
                                </li>
                                <li>
                                    <a href="javascript:void(0)">Training &amp; Support</a>
                                </li>
                            </ul>
                        </div>
                        <div class="odonova-footer-col">
                            <h4>Company</h4>
                            <ul>
                                <li>
                                    <a href="/about">About Us</a>
                                </li>
                                <li>
                                    <a href="/case-studies">Case Studies</a>
                                </li>
                                <li>
                                    <a href="javascript:void(0)">Careers</a>
                                </li>
                                <li>
                                    <a href="javascript:void(0)">Blog</a>
                                </li>
                            </ul>
                        </div>
                        <div class="odonova-footer-col">
                            <h4>Contact</h4>
                            <ul>
                                <li>
                                    <a href="mailto:hello@odonova.com">hello@odonova.com</a>
                                </li>
                                <li>
                                    <a href="tel:+15551234567">+1 (555) 123-4567</a>
                                </li>
                                <li>San Francisco, CA</li>
                            </ul>
                        </div>
                    </div>
                    <div class="odonova-footer-bottom">
                        <p class="odonova-footer-copyright">&#169; 2025 OdoNova. All rights reserved.</p>
                        <div class="odonova-footer-social">
                            <a href="#" aria-label="LinkedIn">
                                <svg viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M4.48 7H.68v11h3.8V7zm-.24-3.6C4.24 1.92 3.28 1 2.08 1S0 1.92 0 3.4s.92 2.4 2.08 2.4 2.16-.92 2.16-2.4zM20 11.6c0-3.12-1.68-4.56-3.92-4.56-1.8 0-2.6 1-3.08 1.72V7H9.2c.04 1.04 0 11 0 11h3.8v-6.16c0-.32.04-.64.16-.88.36-.64.92-1.32 2-1.32 1.44 0 2.04 1.08 2.04 2.68V18H21v-6.4h-.04.04z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>


</odoo>
