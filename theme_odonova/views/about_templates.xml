<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- About Page Template -->
    <template id="about_template" name="About Us | OdoNova" key="theme_odonova.about_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- 1. About Hero -->
                <section class="s_odonova_about_hero odonova-about-hero o_colored_level" data-snippet="s_odonova_about_hero" data-name="About Hero">
                    <div class="container">
                        <h1>We engineer operational excellence.</h1>
                        <p>OdoNova is a certified Odoo Gold Partner dedicated to transforming complex business challenges into streamlined, automated workflows.</p>
                    </div>
                </section>

                <!-- 2. Mission -->
                <section class="s_odonova_about_mission odonova-mission-section o_colored_level" data-snippet="s_odonova_about_mission" data-name="Mission">
                    <div class="container">
                        <div class="odonova-mission-grid">
                            <div class="odonova-mission-content">
                                <h2>Our Mission</h2>
                                <p>We believe that enterprise software shouldn't be a bottleneck. Our mission is to empower organizations with intuitive, scalable, and integrated ERP solutions that drive real business value. Since 2012, we've helped hundreds of companies transition from chaotic legacy systems to the unified ecosystem of Odoo.</p>
                                <div class="odonova-mission-stats">
                                    <div class="odonova-mission-stat">
                                        <div class="odonova-stat-num">12+</div>
                                        <div class="odonova-stat-lbl">Years of Experience</div>
                                    </div>
                                    <div class="odonova-mission-stat">
                                        <div class="odonova-stat-num">250+</div>
                                        <div class="odonova-stat-lbl">Successful Implementations</div>
                                    </div>
                                </div>
                            </div>
                            <div class="odonova-mission-img">
                                <img src="/theme_odonova/static/src/img/about/mission_team.png" alt="Our Mission Team" loading="lazy" class="img-fluid"/>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 3. Core Values -->
                <section class="s_odonova_about_values odonova-values-section o_colored_level" data-snippet="s_odonova_about_values" data-name="Core Values">
                    <div class="container text-center">
                        <h2>Our Core Values</h2>
                        <p class="text-muted">The principles that guide our work, our partnerships, and our team culture.</p>
                        <div class="odonova-values-grid text-start">
                            <div class="odonova-value-card">
                                <div class="odonova-value-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-linecap="round" stroke-linejoin="round"/>
                                        <polyline points="22 4 12 14.01 9 11.01" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </div>
                                <h3>Outcome-Driven</h3>
                                <p>We don't just implement software; we solve business problems. Our success is measured by the tangible ROI we deliver to our clients.</p>
                            </div>
                            <div class="odonova-value-card">
                                <div class="odonova-value-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                                    </svg>
                                </div>
                                <h3>Radical Transparency</h3>
                                <p>We believe in honest communication, realistic timelines, and no hidden costs. What you see is exactly what you get.</p>
                            </div>
                            <div class="odonova-value-card">
                                <div class="odonova-value-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                                        <polyline points="17 6 23 6 23 12"/>
                                    </svg>
                                </div>
                                <h3>Continuous Innovation</h3>
                                <p>The technology landscape evolves rapidly. We take proactive steps to integrate the latest Odoo features into your operations.</p>
                            </div>
                            <div class="odonova-value-card">
                                <div class="odonova-value-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </div>
                                <h3>Collaborative Partnership</h3>
                                <p>We consider ourselves an extension of your team. Our success is inextricably linked to yours.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 4. Team -->
                <section class="s_odonova_about_team odonova-team-section o_colored_level" data-snippet="s_odonova_about_team" data-name="Team">
                    <div class="container text-center">
                        <h2>Meet the Leadership</h2>
                        <p class="text-muted">Guided by industry veterans with deep expertise in ERP architecture.</p>
                        <div class="odonova-team-grid text-start">
                            <div class="odonova-team-member">
                                <div class="odonova-team-photo"><img src="/theme_odonova/static/src/img/about/mission_team.png" alt="Sarah Jenkins" loading="lazy" class="img-fluid"/></div>
                                <h3>Sarah Jenkins</h3>
                                <div class="odonova-role">CEO &amp; Founder</div>
                                <p class="odonova-bio">Former supply chain director who turned a passion for process optimization into OdoNova.</p>
                            </div>
                            <div class="odonova-team-member">
                                <div class="odonova-team-photo" style="background-color: #9333ea;"><img src="/theme_odonova/static/src/img/about/mission_team.png" alt="Marcus Weber" loading="lazy" style="opacity: 0.8;" class="img-fluid"/></div>
                                <h3>Marcus Weber</h3>
                                <div class="odonova-role">Chief Technology Officer</div>
                                <p class="odonova-bio">Odoo core contributor and master architect behind our most complex enterprise deployments.</p>
                            </div>
                            <div class="odonova-team-member">
                                <div class="odonova-team-photo"><img src="/theme_odonova/static/src/img/about/mission_team.png" alt="Elena Chen" loading="lazy" class="img-fluid"/></div>
                                <h3>Elena Chen</h3>
                                <div class="odonova-role">VP of Operations</div>
                                <p class="odonova-bio">Ensures smooth delivery of all projects, maintaining our 98% on-time track record.</p>
                            </div>
                            <div class="odonova-team-member">
                                <div class="odonova-team-photo"><img src="/theme_odonova/static/src/img/about/mission_team.png" alt="David Torres" loading="lazy" class="img-fluid"/></div>
                                <h3>David Torres</h3>
                                <div class="odonova-role">Director of Client Success</div>
                                <p class="odonova-bio">Dedicated to long-term adoption, training, and support for all OdoNova partners.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 5. CTA -->
                <section class="s_odonova_cta pt96 pb96 o_colored_level" data-snippet="s_odonova_cta" data-name="OdoNova CTA Banner" style="background: linear-gradient(135deg, #0b66ff, #004bbd); color: white;">
                    <div class="container text-center">
                        <h2 class="display-4 fw-bold mb-3 text-white">Join our journey.</h2>
                        <a href="/consultation" class="btn btn-light btn-lg rounded-pill px-5 fw-bold text-primary shadow">Contact Us</a>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- About Page Record -->
    <data noupdate="1">
        <record id="about_page" model="website.page">
            <field name="name">About Us | OdoNova</field>
            <field name="type">qweb</field>
            <field name="url">/about</field>
            <field name="view_id" ref="theme_odonova.about_template"/>
            <field name="key">theme_odonova.about_page</field>
            <field name="is_published">True</field>
        </record>
    </data>
</odoo>
