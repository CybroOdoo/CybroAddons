<?xml version="1.0" encoding="utf-8"?>
<!--
    views/assets.xml
    ─────────────────────────────────────────────────────────────────────────
    Injects OdoNova theme assets into the Odoo frontend asset bundle.

    NOTE: In Odoo 17+ you can also declare assets in __manifest__.py (which
    we do as well for redundancy). The ir.asset records here are the
    "classic" approach and remain fully supported.

    Priority values:
      • Lower  = loaded EARLIER  (use for variables/reset)
      • Higher = loaded LATER    (use for component overrides)
    The default Odoo theme assets have priority ~100.
    We use 5–15 so our variables load before Bootstrap compiles.
-->
<odoo>
    <!-- ── SCSS Variables (must load before Bootstrap) ───────────────────── -->
    <record id="theme_variables" model="ir.asset">
        <field name="name">OdoNova - SCSS Variables</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/variables.scss</field>
        <field name="sequence">5</field>
    </record>

    <!-- Bootstrap variable overrides (color palette, spacing, radii, etc.) -->
    <record id="theme_bootstrap_overrides" model="ir.asset">
        <field name="name">OdoNova - Bootstrap Overrides</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/bootstrap_overrides.scss</field>
        <field name="sequence">6</field>
    </record>

    <!-- ── Base / Reset ───────────────────────────────────────────────────── -->
    <record id="theme_base" model="ir.asset">
        <field name="name">OdoNova - Base Styles</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/base.scss</field>
        <field name="sequence">10</field>
    </record>

    <!-- ── Component stylesheets ─────────────────────────────────────────── -->
    <record id="theme_header" model="ir.asset">
        <field name="name">OdoNova - Header</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/header.scss</field>
        <field name="sequence">11</field>
    </record>

    <record id="theme_hero" model="ir.asset">
        <field name="name">OdoNova - Hero</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/hero.scss</field>
        <field name="sequence">12</field>
    </record>

    <record id="theme_services" model="ir.asset">
        <field name="name">OdoNova - Services</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/services.scss</field>
        <field name="sequence">13</field>
    </record>

    <record id="theme_modules_grid" model="ir.asset">
        <field name="name">OdoNova - Modules Grid</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/modules_grid.scss</field>
        <field name="sequence">14</field>
    </record>

    <record id="theme_cta" model="ir.asset">
        <field name="name">OdoNova - CTA</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/cta.scss</field>
        <field name="sequence">15</field>
    </record>

    <record id="theme_footer_asset" model="ir.asset">
        <field name="name">OdoNova - Footer</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/footer.scss</field>
        <field name="sequence">16</field>
    </record>

    <!-- Page-specific styles -->
    <record id="theme_about" model="ir.asset">
        <field name="name">OdoNova - About Page</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/about.scss</field>
        <field name="sequence">20</field>
    </record>

    <record id="theme_industries" model="ir.asset">
        <field name="name">OdoNova - Industries Page</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/industries.scss</field>
        <field name="sequence">21</field>
    </record>

    <record id="theme_case_studies" model="ir.asset">
        <field name="name">OdoNova - Case Studies Page</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/case_studies.scss</field>
        <field name="sequence">22</field>
    </record>

    <record id="theme_consultation" model="ir.asset">
        <field name="name">OdoNova - Consultation Page</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/consultation.scss</field>
        <field name="sequence">23</field>
    </record>

    <record id="theme_login" model="ir.asset">
        <field name="name">OdoNova - Login Page</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/login.scss</field>
        <field name="sequence">24</field>
    </record>

    <!-- Animations + responsive (load last so they can override) -->
    <record id="theme_animations" model="ir.asset">
        <field name="name">OdoNova - Animations</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/animations.scss</field>
        <field name="sequence">25</field>
    </record>

    <record id="theme_responsive" model="ir.asset">
        <field name="name">OdoNova - Responsive</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/scss/responsive.scss</field>
        <field name="sequence">26</field>
    </record>

    <!-- ── JavaScript ─────────────────────────────────────────────────────── -->
    <record id="theme_js" model="ir.asset">
        <field name="name">OdoNova - Theme JS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">theme_odonova/static/src/js/theme.js</field>
        <field name="sequence">30</field>
    </record>
</odoo>
