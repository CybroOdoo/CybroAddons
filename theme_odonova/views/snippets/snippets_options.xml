<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Register OdoNova snippets into the website builder ─── -->
    <template id="odonova_snippets" inherit_id="website.snippets" name="OdoNova Snippets">

        <!-- 1. Add 'OdoNova' snippet group/category in the sidebar -->
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t snippet-group="odonova" t-snippet="website.s_snippet_group" string="OdoNova"
               t-thumbnail="/theme_odonova/static/src/img/hero_dashboard.png"/>
        </xpath>

        <!-- 2. Register all OdoNova snippet blocks inside snippet_structure -->
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_odonova.s_odonova_hero" string="OdoNova Hero" group="odonova">
                <keywords>hero, banner, intro, cover, header, headline, odonova, erp, odoo, homepage, landing, showcase, splash</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_stats_clients" string="OdoNova Stats &amp; Clients" group="odonova">
                <keywords>stats, numbers, statistics, counter, clients, partners, logos, trusted, companies, metrics, KPI</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_clients_ticker" string="OdoNova Clients Ticker" group="odonova">
                <keywords>clients, logos, trusted, companies, brands, industry, ticker</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_services" string="OdoNova Services" group="odonova">
                <keywords>services, features, cards, implementation, development, support, customization, odoo, expertise</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_modules" string="OdoNova Modules Grid" group="odonova">
                <keywords>modules, grid, crm, accounting, inventory, ecommerce, project, manufacturing, hr, marketing, odoo, apps</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_cta" string="OdoNova CTA Banner" group="odonova">
                <keywords>cta, call to action, banner, contact, demo, schedule, consultation, button, promo, upgrade</keywords>
            </t>

            <!-- Industries Snippets -->
            <t t-snippet="theme_odonova.s_odonova_industries_hero" string="Industries Hero" group="odonova"/>
            <t t-snippet="theme_odonova.s_odonova_industries_featured" string="Industries Featured" group="odonova"/>
            <t t-snippet="theme_odonova.s_odonova_industries_grid" string="Industries Grid" group="odonova"/>

            <!-- Case Studies Snippets -->
            <t t-snippet="theme_odonova.s_odonova_cases_hero" string="Success Hero" group="odonova"/>
            <t t-snippet="theme_odonova.s_odonova_cases_featured" string="Case Featured" group="odonova"/>
            <t t-snippet="theme_odonova.s_odonova_cases_grid" string="Success Grid" group="odonova"/>

            <!-- About Us Snippets -->
            <t t-snippet="theme_odonova.s_odonova_about_hero" string="About Hero" group="odonova"/>
            <t t-snippet="theme_odonova.s_odonova_about_mission" string="Mission" group="odonova"/>
            <t t-snippet="theme_odonova.s_odonova_about_values" string="Core Values" group="odonova"/>
            <t t-snippet="theme_odonova.s_odonova_about_team" string="Our Team" group="odonova"/>

            <!-- Consultation Snippets -->
            <t t-snippet="theme_odonova.s_odonova_consultation" string="Consultation Form" group="odonova"/>
        </xpath>

    </template>

</odoo>
