<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Register OdoNova snippets into the website builder ─── -->
    <template id="odonova_snippets" inherit_id="website.snippets" name="OdoNova Snippets">

        <!-- Register all OdoNova snippet blocks inside the Structure panel. -->
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_odonova.s_odonova_hero" string="OdoNova Hero">
                <keywords>hero, banner, intro, cover, header, headline, odonova, erp, odoo, homepage, landing, showcase, splash</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_stats_clients" string="OdoNova Stats &amp; Clients">
                <keywords>stats, numbers, statistics, counter, clients, partners, logos, trusted, companies, metrics, KPI</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_clients_ticker" string="OdoNova Clients Ticker">
                <keywords>clients, logos, trusted, companies, brands, industry, ticker</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_services" string="OdoNova Services">
                <keywords>services, features, cards, implementation, development, support, customization, odoo, expertise</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_modules" string="OdoNova Modules Grid">
                <keywords>modules, grid, crm, accounting, inventory, ecommerce, project, manufacturing, hr, marketing, odoo, apps</keywords>
            </t>
            <t t-snippet="theme_odonova.s_odonova_cta" string="OdoNova CTA Banner">
                <keywords>cta, call to action, banner, contact, demo, schedule, consultation, button, promo, upgrade</keywords>
            </t>

            <!-- Industries Snippets -->
            <t t-snippet="theme_odonova.s_odonova_industries_hero" string="Industries Hero"/>
            <t t-snippet="theme_odonova.s_odonova_industries_featured" string="Industries Featured"/>
            <t t-snippet="theme_odonova.s_odonova_industries_grid" string="Industries Grid"/>

            <!-- Case Studies Snippets -->
            <t t-snippet="theme_odonova.s_odonova_cases_hero" string="Success Hero"/>
            <t t-snippet="theme_odonova.s_odonova_cases_featured" string="Case Featured"/>
            <t t-snippet="theme_odonova.s_odonova_cases_grid" string="Success Grid"/>

            <!-- About Us Snippets -->
            <t t-snippet="theme_odonova.s_odonova_about_hero" string="About Hero"/>
            <t t-snippet="theme_odonova.s_odonova_about_mission" string="Mission"/>
            <t t-snippet="theme_odonova.s_odonova_about_values" string="Core Values"/>
            <t t-snippet="theme_odonova.s_odonova_about_team" string="Our Team"/>

            <!-- Consultation Snippets -->
            <t t-snippet="theme_odonova.s_odonova_consultation" string="Consultation Form"/>
        </xpath>

    </template>

</odoo>
