<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 2. Case Studies Page Template -->
    <template id="case_studies_template" name="Case Studies" key="theme_odonova.case_studies_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- 1. Success Hero -->
                <section class="s_odonova_cases_hero odonova-casestudies-hero o_colored_level" data-snippet="s_odonova_cases_hero" data-name="Success Hero">
                    <div class="container">
                        <h1 class="animate-on-scroll">Success Stories</h1>
                        <p class="animate-on-scroll">
                            Discover how we've helped ambitious companies scale, optimize, and
                            transform their operations using Odoo ERP.
                        </p>
                    </div>
                </section>

                <!-- 3. Case Featured -->
                <section class="s_odonova_cases_featured odonova-featured-cases o_colored_level" data-snippet="s_odonova_cases_featured" data-name="Case Featured">
                    <div class="container">
                        <!-- Global Manufacturing Corp -->
                        <div class="odonova-featured-case">
                            <div class="odonova-case-content animate-on-scroll">
                                <div class="d-flex gap-2">
                                    <span class="odonova-case-tag">Manufacturing</span>
                                    <span class="odonova-case-tag">Supply Chain</span>
                                </div>
                                <h2>Global Manufacturing Corp</h2>
                                <p>
                                    Global Manufacturing Corp was struggling with disconnected
                                    systems and siloed data across their 3 international plants. We
                                    implemented Odoo to unify their supply chain and production lines,
                                    resulting in unprecedented visibility and efficiency.
                                </p>
                                <div class="odonova-case-stats">
                                    <div>
                                        <div class="odonova-cs-number">40%</div>
                                        <div class="odonova-cs-label">Production Efficiency</div>
                                    </div>
                                    <div>
                                        <div class="odonova-cs-number">2.5x</div>
                                        <div class="odonova-cs-label">Inventory Turnover</div>
                                    </div>
                                    <div>
                                        <div class="odonova-cs-number">100%</div>
                                        <div class="odonova-cs-label">Data Accuracy</div>
                                    </div>
                                </div>
                            </div>
                            <div class="odonova-case-image animate-on-scroll">
                                <img src="/theme_odonova/static/src/img/cases/global_mfg.png" alt="Global Manufacturing Corp" class="img-fluid"/>
                            </div>
                        </div>

                        <!-- EcoRetail Group -->
                        <div class="odonova-featured-case reversed">
                            <div class="odonova-case-content animate-on-scroll">
                                <div class="d-flex gap-2">
                                    <span class="odonova-case-tag">Retail</span>
                                    <span class="odonova-case-tag">E-Commerce</span>
                                </div>
                                <h2>EcoRetail Group</h2>
                                <p>
                                    Managing over 50 brick-and-mortar stores alongside a booming
                                    online presence, EcoRetail needed a robust omnichannel solution.
                                    We delivered an integrated Odoo POS and E-commerce platform
                                    that bridged the gap between physical and digital sales.
                                </p>
                                <div class="odonova-case-stats">
                                    <div>
                                        <div class="odonova-cs-number">35%</div>
                                        <div class="odonova-cs-label">Increase in online sales</div>
                                    </div>
                                    <div>
                                        <div class="odonova-cs-number">50k+</div>
                                        <div class="odonova-cs-label">Daily transactions processed</div>
                                    </div>
                                    <div>
                                        <div class="odonova-cs-number">0</div>
                                        <div class="odonova-cs-label">Revenue lost from inventory errors</div>
                                    </div>
                                </div>
                            </div>
                            <div class="odonova-case-image animate-on-scroll">
                                <img src="/theme_odonova/static/src/img/cases/retail.png" alt="EcoRetail Group" class="img-fluid"/>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 4. Success Grid -->
                <section class="s_odonova_cases_grid odonova-stories-section o_colored_level" data-snippet="s_odonova_cases_grid" data-name="Success Grid">
                    <div class="container text-center">
                        <div class="odonova-section-header mx-auto">
                            <h2>More Success Stories</h2>
                            <p>
                                Explore our diverse portfolio of successful Odoo implementations across
                                various industries and complex business models.
                            </p>
                        </div>
                        <div class="odonova-stories-grid">
                            <!-- FastTrack Logistics -->
                            <div class="odonova-story-card animate-on-scroll">
                                <div class="odonova-story-img">
                                    <img src="/theme_odonova/static/src/img/cases/global_mfg.png" alt="FastTrack Logistics" style="filter: hue-rotate(45deg);" class="img-fluid"/>
                                </div>
                                <div class="odonova-story-body text-start">
                                    <span class="odonova-case-tag" style="font-size: 10px; padding: 2px 8px;">Logistics</span>
                                    <h3>FastTrack Logistics</h3>
                                    <p>Optimized fleet management and multi-warehouse routing, cutting average delivery times by 25%.</p>
                                </div>
                            </div>

                            <!-- Medicare Health -->
                            <div class="odonova-story-card animate-on-scroll">
                                <div class="odonova-story-img">
                                    <img src="/theme_odonova/static/src/img/cases/retail.png" alt="Medicare Health" style="filter: grayscale(0.5) sepia(0.2);" class="img-fluid"/>
                                </div>
                                <div class="odonova-story-body text-start">
                                    <span class="odonova-case-tag" style="font-size: 10px; padding: 2px 8px;">Healthcare</span>
                                    <h3>Medicare Health</h3>
                                    <p>Implemented strict compliance tracking and centralized patient data management.</p>
                                </div>
                            </div>

                            <!-- BuildRight Group -->
                            <div class="odonova-story-card animate-on-scroll">
                                <div class="odonova-story-img">
                                    <img src="/theme_odonova/static/src/img/industries/manufacturing.png" alt="BuildRight Group" style="filter: brightness(0.8);" class="img-fluid"/>
                                </div>
                                <div class="odonova-story-body text-start">
                                    <span class="odonova-case-tag" style="font-size: 10px; padding: 2px 8px;">Construction</span>
                                    <h3>BuildRight Group</h3>
                                    <p>Consolidated multi-company accounting, bid tracking, and subcontractor management.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 5. CTA -->
                <section class="s_odonova_cta pt96 pb96 o_colored_level" data-snippet="s_odonova_cta" data-name="OdoNova CTA Banner" style="background: linear-gradient(135deg, #0b66ff, #004bbd); color: white;">
                    <div class="container text-center">
                        <h2 class="display-4 fw-bold mb-3 text-white">Scale your business today.</h2>
                        <a href="/consultation" class="btn btn-light btn-lg rounded-pill px-5 fw-bold text-primary shadow">Get Started</a>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- 3. Case Studies Page Record -->
    <data noupdate="1">
        <record id="case_studies_page" model="website.page">
            <field name="name">Case Studies</field>
            <field name="type">qweb</field>
            <field name="url">/case-studies</field>
            <field name="view_id" ref="theme_odonova.case_studies_template"/>
            <field name="key">theme_odonova.case_studies_page</field>
            <field name="is_published">True</field>
        </record>
    </data>
</odoo>
