<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Success Template -->
    <template id="contactus_thank_you_template" name="Contact Us Success | OdoNova" key="theme_odonova.contactus_thank_you_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_odonova_thanks pt128 pb128 bg-white d-flex align-items-center" style="min-height: 80vh;">
                    <div class="container text-center">
                        <div class="odonova-thanks-card mx-auto" style="max-width: 600px;">
                            <!-- Success Icon -->
                            <div class="odonova-thanks-icon mb-4" style="color: #6366f1;">
                                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="m22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                    <path d="m22 4-11 11.01-3-3"/>
                                </svg>
                            </div>
                            
                            <h1 class="display-3 fw-bold mb-3" style="color: #0f172a;">Thank you!</h1>
                            <p class="fs-4 text-muted mb-5">Your request has been received. Our Odoo experts will reach out to you within 24 hours to schedule your discovery call.</p>
                            
                            <div class="d-flex justify-content-center gap-3">
                                <a href="/" class="btn btn-primary btn-lg rounded-pill px-5">Back to Home</a>
                                <a href="/case-studies" class="btn btn-outline-secondary btn-lg rounded-pill px-5">Browse Success Stories</a>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- Extra OE Structure for custom blocks -->
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <!-- Success Page Record (noupdate="1" for better theme install compatibility) -->
    <data noupdate="1">
        <record id="contactus_thank_you_page" model="website.page">
            <field name="name">Thank You | OdoNova</field>
            <field name="type">qweb</field>
            <field name="url">/contactus-thank-you</field>
            <field name="view_id" ref="theme_odonova.contactus_thank_you_template"/>
            <field name="key">theme_odonova.contactus_thank_you_page</field>
            <field name="is_published">True</field>
        </record>
    </data>
</odoo>
