<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override the main login layout for the split-screen design -->
    <template id="theme_login_layout" inherit_id="web.login_layout" name="OdoNova — Login Layout" priority="30">
        <!-- Target the main t-call, replacing whatever website overrides applied -->
        <xpath expr="t[@t-call]" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="dict(html_data or {}, **{'class': 'odonova-login-page'})"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>

                <div class="odonova-login-layout">
                    <!-- Left Decorative Panel -->
                    <div class="odonova-login-left d-none d-lg-flex">
                        <div class="odonova-login-logo">
                            <svg width="32" height="32" viewBox="0 0 28 28" fill="none">
                                <rect width="28" height="28" rx="5" fill="#fff"/>
                                <path d="M7 9h5v10H7V9zm9 3h5v7h-5v-7z" fill="#0b66ff"/>
                            </svg>
                            <span>OdoNova</span>
                        </div>

                        <div class="odonova-login-quote">
                            <blockquote>
                                "OdoNova ERP transformed our fragmented systems into a single source of truth, increasing our operational efficiency by 40%."
                            </blockquote>
                            <div class="odonova-quote-author">
                                <span class="name">Sarah Jenkins</span>
                                <span class="title">CEO, Global Logistics Inc.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Form Panel -->
                    <div class="odonova-login-right">
                        <div class="odonova-login-form-wrap">
                            <a href="/" class="odonova-back-link">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                                </svg>
                                Back to website
                            </a>

                            <div class="odonova-login-header">
                                <h1 class="odonova-login-title">Welcome back</h1>
                                <p class="odonova-login-subtitle">Log in to your OdoNova account to continue.</p>
                            </div>

                            <div class="odonova-login-form-content">
                                <t t-out="0"/>
                            </div>

                            <div class="odonova-divider">
                                <span>Or continue with</span>
                            </div>

                            <div class="odonova-social-logins">
                                <button class="odonova-btn-social">
                                    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/></svg>
                                    Continue with Google
                                </button>
                                <button class="odonova-btn-social">
                                    <svg viewBox="0 0 23 23" fill="currentColor" width="20" height="20"><path d="M0 0h11v11H0z" fill="#f25022"/><path d="M12 0h11v11H12z" fill="#7fbb00"/><path d="M0 12h11v11H0z" fill="#00a1f1"/><path d="M12 12h11v11H12z" fill="#ffbb00"/></svg>
                                    Continue with Microsoft
                                </button>
                            </div>

                            <div class="odonova-login-footer">
                                Don't have an account? <a href="mailto:support@odonova.com">Contact Support</a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Wrap the login form itself to apply custom classes -->
    <template id="theme_login_form_wrap" inherit_id="web.login" name="OdoNova — Login Form Wrap">
        <xpath expr="//form" position="attributes">
            <attribute name="class" add="odonova-login-form" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]" position="attributes">
            <attribute name="class" add="odonova-form-group" separator=" "/>
        </xpath>
        <xpath expr="//div[input[@name='password']]" position="attributes">
            <attribute name="class" add="odonova-form-group odonova-pw-wrap" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="replace">
            <div class="odonova-form-options">
                <label class="odonova-remember">
                    <input type="checkbox" name="remember" id="remember" value="1"/>
                    <span>Remember me</span>
                </label>
                  <a href="/web/database/manager" class="odonova-forgot">Forgot password?</a>
            </div>
            <div class="oe_login_buttons text-center pt-3">
                <button type="submit" class="odonova-btn-login-submit">Log in</button>
            </div>
        </xpath>
    </template>
</odoo>
