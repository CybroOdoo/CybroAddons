<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds deviation links to the IPQC result form. -->
    <record id="pharma_ipqc_result_form_capa" model="ir.ui.view">
        <field name="name">pharma.ipqc.result.form.capa</field>
        <field name="model">pharma.ipqc.result</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_ipqc_result_form"/>
        <field name="arch" type="xml">
            <field name="signed_by" position="before">
                <field name="deviation_id" readonly="1"
                       invisible="result != 'fail'"/>
            </field>
        </field>
    </record>

    <!-- Adds deviation columns to the IPQC result list. -->
    <record id="pharma_ipqc_result_list_capa" model="ir.ui.view">
        <field name="name">pharma.ipqc.result.list.capa</field>
        <field name="model">pharma.ipqc.result</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_ipqc_result_list"/>
        <field name="arch" type="xml">
            <field name="signed_by" position="before">
                <field name="deviation_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
