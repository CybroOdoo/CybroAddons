<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds deviation links to the BMR form. -->
    <record id="pharma_bmr_form_capa" model="ir.ui.view">
        <field name="name">pharma.bmr.form.capa</field>
        <field name="model">pharma.bmr</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_bmr_form"/>
        <field name="arch" type="xml">

            <button name="action_view_ipqc" position="after">
                <button name="action_view_deviations" type="object"
                        class="oe_stat_button" icon="fa-warning"
                        invisible="deviation_count == 0">
                    <field name="deviation_count" widget="statinfo" string="Deviations"/>
                </button>
            </button>

            <xpath expr="//field[@name='ipqc_ids']//field[@name='signed_by']" position="before">
                <field name="deviation_id" optional="show" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>
