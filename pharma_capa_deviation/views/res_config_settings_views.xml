<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lists the Preventive Action add-on among the premium features. -->
    <record id="res_config_settings_view_form_pharma_capa_deviation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pharma.capa.deviation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pharmaceutical_base.res_config_settings_view_form_pharmaceutical_base"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='pharmaceutical_base_premium_settings']" position="inside">
                <setting id="pharma_capa_deviation_premium_capa_preventive" class="o_pharma_premium_setting"
                         string="Preventive Action"
                         help="Preventive CAPAs with a scope, a schedule of recurring checks and demonstrated effectiveness.">
                    <field name="module_pharma_capa_preventive"/>
                    <div class="o_pharma_premium_setting_footer">
                        <span class="o_pharma_premium_tag"><i class="fa fa-star me-1"/>Premium</span>
                        <widget name="pharma_premium_learn_more" feature="capa_preventive"
                                class_name="btn btn-sm o_pharma_premium_notice_btn"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
