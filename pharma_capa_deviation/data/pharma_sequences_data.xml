<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for deviation numbers. -->
    <record id="seq_pharma_deviation" model="ir.sequence">
        <field name="name">Pharma Deviation</field>
        <field name="code">pharma.deviation</field>
        <field name="prefix">DEV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for CAPA numbers. -->
    <record id="seq_pharma_capa" model="ir.sequence">
        <field name="name">Pharma CAPA</field>
        <field name="code">pharma.capa</field>
        <field name="prefix">CAPA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
