<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view for custom.stock.lot -->
    <record id="custom_stock_lot_view_list" model="ir.ui.view">
        <field name="name">custom.stock.lot.view.list</field>
        <field name="model">custom.stock.lot</field>
        <field name="arch" type="xml">
            <list string="Custom Stock Lots">
                <field name="name"/>
                <field name="line_id" context="{'display_order_name': True}"/>
            </list>
        </field>
    </record>

    <!-- Form view for custom.stock.lot -->
    <record id="custom_stock_lot_view_form" model="ir.ui.view">
        <field name="name">custom.stock.lot.view.form</field>
        <field name="model">custom.stock.lot</field>
        <field name="arch" type="xml">
            <form string="Custom Stock Lot">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="line_id" context="{'display_order_name': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view for custom.stock.lot -->
    <record id="custom_stock_lot_view_search" model="ir.ui.view">
        <field name="name">custom.stock.lot.view.search</field>
        <field name="model">custom.stock.lot</field>
        <field name="arch" type="xml">
            <search string="Search Custom Stock Lots">
                <field name="name"/>
                <field name="line_id"/>
            </search>
        </field>
    </record>

    <!-- Window Action for custom.stock.lot -->
    <record id="action_custom_stock_lot" model="ir.actions.act_window">
        <field name="name">Custom Stock Lots</field>
        <field name="res_model">custom.stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="custom_stock_lot_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new custom stock lot
            </p>
        </field>
    </record>

    <!-- Configuration Menu Item -->
    <menuitem id="menu_custom_stock_lot"
              name="Custom Stock Lots"
              parent="purchase.menu_purchase_config"
              action="action_custom_stock_lot"
              sequence="50"/>
</odoo>
