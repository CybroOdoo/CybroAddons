<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Inherited form view of the model purchase order-->
    <record id="purchase_order_form_inherit_purchase_auto_lot_creation" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.purchase.auto.lot.creation</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//column[@name='product_and_description']" position="after">
                <field name="is_lot_product" column_invisible="True"/>
                <field name="lot_id" readonly="not is_lot_product"/>
            </xpath>
        </field>
    </record>
</odoo>
