<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Inherited list, form and kanban view of project for adding progress
    bar-->
    <record id="view_project_card_inherit_project_progress_bar" model="ir.ui.view">
        <field name="name">project.project.view.card.inherit.project.progress.bar</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_card"/>
        <field name="priority">24</field>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="is_progress_bar" invisible="1"/>
                <field name="progressbar" widget="progressbar"
                       invisible="not is_progress_bar"/>
            </field>
        </field>
    </record>
    <record id="edit_project_inherit_project_progress_bar" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.project.progress.bar</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']/parent::div" position="after">
                <field name="is_progress_bar"/>
                <field name="progressbar"
                       widget="progressbar"
                       invisible="not is_progress_bar"/>
            </xpath>
        </field>
    </record>
    <record id="view_project_inherit_project_progress_bar" model="ir.ui.view">
        <field name="name">project.project.view.list.inherit.project.progress.bar</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="is_progress_bar"/>
                <field name="progressbar"
                       class="d-flex align-items-center ps-0 ps-lg-5"
                       widget="progressbar"
                       invisible="not is_progress_bar"/>
            </field>
        </field>
    </record>
</odoo>
