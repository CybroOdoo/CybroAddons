<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Add checkbox to select order lines for invoicing -->
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.invoice.bill.select.orderlines</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="qty_to_invoice" column_invisible="True"/>
                <field name="is_product_select" nolabel="1" invisible="qty_to_invoice == 0"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="before">
                <div class="d-flex flex-row my-2">
                    <!-- Select All -->
                    <button name="action_select_all"
                            class="btn btn-primary mx-2"
                            string="Select All"
                            type="object"
                            invisible="invoice_status != 'to invoice' or all_lines_selected"/>

                    <!-- Deselect All -->
                    <button name="action_deselect_all"
                            class="oe_highlight"
                            string="Deselect All"
                            type="object"
                            invisible="invoice_status != 'to invoice' or not any_line_selected"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
