<?xml version="1.0"?>
<odoo>
    <!--search views-->
    <record id='mail_activity_view_search'
            model='ir.ui.view'>
        <field name="name">mail.activity.view.search</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <search string="Activity">
                <group>
                    <filter name="groupby_sequence"
                            context="{'group_by' : 'res_model_id'}"
                            string="Document Model"/>
                    <filter name="groupby_state"
                            context="{'group_by' : 'state'}"
                            string="State"/>
                    <filter name="groupby_prioirity"
                            context="{'group_by' : 'priority'}"
                            string="Priority"/>
                </group>
                <!--filter views-->
                <filter string="My Activities"
                        name="assigned_to_me"
                        domain="[('user_id', '=', uid)]"/>
                <filter invisible="0" string="Late Activities"
                        name="activities_overdue"
                        domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                        help="Show all records which has next action date is before today"/>
                <filter invisible="0" string="Today Activities"
                        name="activities_today"
                        domain="[('date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter invisible="0" string="Future Activities"
                        name="activities_upcoming_all"
                        domain="[('date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))
                        ]"/>
            </search>
        </field>
    </record>

    <!--kanban views-->
    <record id="mail_activity_view_kanban" model="ir.ui.view">
        <field name="name">mail.activity.view.kanban</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <kanban default_order="state desc"
                    default_group_by="state"
                    group_create="false"
                    group_delete="false"
                    group_edit="false"
                    class="mail_activity_kanban_view" sample="1">
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable" role="menuitem">
                            <a class="dropdown-item" type="open">Edit</a>
                        </t>
                        <t t-if="widget.deletable">
                            <a role="menuitem" type="delete" class="dropdown-item">
                                Delete
                            </a>
                        </t>
                    </t>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong>
                                        <field name="summary"/>
                                    </strong>
                                </div>
                                <div>
                                    <field name="activity_type_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority"
                                               widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id"
                                               widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--
        Inherit the built-in mail activity list view (mail.mail_activity_view_tree)
        which already has bulk header buttons (Done, Cancel, Today, Tomorrow, Next Week)
        and per-row buttons (Reschedule, Done, Cancel).
        We add our custom fields (priority, state badge) on top of it.
    -->
    <record id="mail_activity_view_tree" model="ir.ui.view">
        <field name="name">mail.activity.view.list.inherit.activity.checklist</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_tree"/>
        <field name="arch" type="xml">
             <list position="attributes">
                 <attribute name="duplicate">false</attribute>
                <attribute name="decoration-danger">date_deadline &lt; current_date</attribute>
                <attribute name="decoration-success">date_deadline == current_date</attribute>
            </list>
            <!-- Add priority before the summary column -->
            <field name="summary" position="before">
                <field name="priority" widget="priority" class="mr-3"/>
            </field>
            <!-- Add state badge after date_deadline -->
            <field name="date_deadline" position="after">
                <field name="state"
                       decoration-success="state == 'planned' or state == 'done'"
                       decoration-info="state == 'today'"
                       decoration-danger="state == 'overdue'"
                       widget="badge"
                       optional="show"/>
            </field>
        </field>
    </record>

    <!--form view for mail activity-->
    <record id="mail_activity_view_form" model="ir.ui.view">
        <field name="name">mail.activity.view.form</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <form string="Activity" duplicate="0">
                <header>
                    <button name="action_done" type="object"
                            string="Mark As Done"  class="btn btn-primary"
                            invisible="state not in ('overdue','planned','today')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="today"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state not in ('overdue','planned','today')"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_origin"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-external-link"
                                string="Open Document"
                                invisible="not res_id or res_model == 'activity.general'"/>
                    </div>
                       <div class="mb-3">
                            <field name="activity_type_id"
                                   widget="selection_badge_icons"
                                   iconField="icon"
                                   nolabel="1"/>
                        </div>
                    <group>
                        <group>
                            <field name="priority" widget="priority"
                                   class="mr-3"/>
                            <field name="user_id" invisible="1"/>
                            <field name="summary"
                                   placeholder="e.g. Discuss proposal"/>
                            <field name="res_id" invisible="1"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_model_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_deadline"/>
                            <field name="recurring"/>
                            <field name="interval"
                                   invisible="recurring != True"
                                   required="recurring == True"/>
                            <field name="new_date"
                                   invisible="recurring != True"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Log a note..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!--action mail activity-->
    <record id="mail_activity_action" model="ir.actions.act_window">
        <field name="name">Activity</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context"
               eval="{'default_res_model_id': ref('activity_checklist.model_activity_general'),'search_default_groupby_state':1}"/>
        <field name="search_view_id"
               ref="activity_checklist.mail_activity_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your ToDo List
            </p>
        </field>
    </record>

    <!--Action to open the kanban view-->
    <record id="mail_activity_action_view_kanban"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="activity_checklist.mail_activity_view_kanban"/>
        <field name="act_window_id" ref="activity_checklist.mail_activity_action"/>
    </record>

    <!--
        Use the built-in mail activity list view for the list mode.
        Our inherit record above adds priority + state badge on top of it.
    -->
    <record id="mail_activity_action_view_tree"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mail.mail_activity_view_tree"/>
        <field name="act_window_id" ref="activity_checklist.mail_activity_action"/>
    </record>

    <!--Action to open the form view-->
    <record id="mail_activity_action_view_form"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="activity_checklist.mail_activity_view_form"/>
        <field name="act_window_id" ref="activity_checklist.mail_activity_action"/>
    </record>

    <!--Action to open the mail.activity.type model-->
    <record id="mail_activity_type_action"
            model="ir.actions.act_window">
        <field name="name">Activity Types</field>
        <field name="res_model">mail.activity.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--menuitems-->
    <menuitem id="mail_activity_menu_root" name="Activity Checklist" sequence="10"
              web_icon="activity_checklist,static/description/icon.png"/>
    <menuitem id="mail_activity_menu" name="Activities"
              parent="mail_activity_menu_root" sequence="5"/>
    <menuitem id="activity_menu" parent="mail_activity_menu_root"
              name="Activities" action="activity_checklist.mail_activity_action"
              sequence="6"/>
    <menuitem id="mail_activity_type_menu"
              name="Activity Types"
              parent="mail_activity_menu_root"
              action="activity_checklist.mail_activity_type_action"/>
</odoo>