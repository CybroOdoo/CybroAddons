<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="button_in_kanban.button" t-inherit="web.KanbanView"
       t-inherit-mode="primary">
        <xpath expr="//Layout" position="before">
            <div class="new_container toast">
                <div style="padding-top:25px; display:flex;">
                    <!-- Change Category Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_change_category"
                            t-on-click="_onChangeCategory">Change Category</button>
                    <!-- Customer Lead Time Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_customer_lead_time_products"
                            t-on-click="_onCustLeadTimeProducts">Customer Lead Time</button>
                    <!-- Archive Products Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_archive_products"
                            t-on-click="_onArchiveProducts">Archive Products</button>
                    <!-- Update Sales Price Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_update_price"
                            t-on-click="_onUpdatePrice">Update Sales Price</button>
                    <!-- Add Vendor Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_add_vendor"
                            t-on-click="_onAddVendor">Add Vendor</button>
                    <!-- Make Salable Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_make_salable"
                            t-on-click="_onMakeSalable">Make Salable</button>
                    <!-- Make Purchasable Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_make_purchasable"
                            t-on-click="_onMakePurchasable">Make Purchasable</button>
                    <!-- Delete Products Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_delete_products"
                            t-on-click="_onDeleteProducts">Delete Products</button>
                    <!-- Alternative Products Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_alternative_products"
                            t-on-click="_onAlternativeProducts">Alternative Products</button>
                    <!-- Accessory Products Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_accessory_products"
                            t-on-click="_onAccessoryProducts">Accessory Products</button>
                    <!-- Optional Products Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_optional_products"
                            t-on-click="_onOptionalProducts">Optional Products</button>
                    <!-- Publish Products Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_publish_products"
                            t-on-click="_onPublishProducts">Publish Products</button>
                    <!-- Edit Invoice Policy Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_edit_invoice_policy_products"
                            t-on-click="_onEditInvoicePolicyProducts">Edit Invoice Policy</button>
                    <!-- Change Customer Taxes Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_add_cust_tax_products"
                            t-on-click="_onAddCustomerTaxProducts">Change Customer Taxes</button>
                    <!-- Change Vendor Taxes Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_add_vendor_tax_products"
                            t-on-click="_onAddVendorTaxProducts">Change Vendor Taxes</button>
                    <!-- Change Website Category Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_change_web_category_products"
                            t-on-click="_onWebCategChangeProducts">Change Website Category</button>
                    <!-- Add Attributes & Variants Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_add_attribute_products"
                            t-on-click="_onAddAttributeProducts">Add Attributes &amp; Variants</button>
                    <!-- Change Product Tracking Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn on_change_tracking_products"
                            t-on-click="_onChangeTrackingProducts">Change Product Tracking</button>
                    <!-- Change Production Location Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn change_production_location_products"
                            t-on-click="_onChangeProductionLocation">Change Production Location</button>
                    <!-- Change Inventory Location Button -->
                    <button class="btn btn-secondary btn-sm pms_kanban_btn change_inventory_location_products"
                            t-on-click="_onChangeInventoryLocation">Change Inventory Location</button>
                </div>
            </div>
        </xpath>
    </t>
</templates>
