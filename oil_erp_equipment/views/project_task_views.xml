<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task form: smart button + equipment notebook page -->
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.form.inherit.equipment</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_equipment" type="object"
                        class="oe_stat_button" icon="fa-cogs"
                        invisible="not is_oil_gas_well">
                    <field name="equipment_count" widget="statinfo"
                           string="Equipment"/>
                </button>
            </xpath>
            <xpath expr="//notebook/page[@name='well_drilling']" position="after">
                <page string="Equipment" name="equipment"
                      invisible="not is_oil_gas_well">
                    <field name="equipment_ids"
                           context="{'default_is_oil_equipment': True}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="criticality"/>
                            <field name="location_type"/>
                            <button name="action_view_record"
                                    string="View"
                                    type="object"
                                    icon="fa-external-link"
                                    class="btn-primary "/>
                        </list>
                    </field>
                    <field name="available_equipment_ids" invisible="1"
                           widget="many2many_tags"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
