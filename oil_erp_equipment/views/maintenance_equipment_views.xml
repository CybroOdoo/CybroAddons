<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Equipment Search View -->
    <record id="maintenance_equipment_view_search_inherit_oil" model="ir.ui.view">
        <field name="name">maintenance.equipment.view.search.inherit.oil</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='category']" position="after">
                <filter string="Oil &amp; Gas Equipment" name="oil_equipment"
                        domain="[('is_oil_equipment', '=', True)]"/>
                <filter string="Criticality" name="group_by_criticality"
                        context="{'group_by': 'criticality'}"/>
                <filter string="Location Type" name="group_by_location_type"
                        context="{'group_by': 'location_type'}"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Equipment Form View -->
    <record id="maintenance_equipment_view_form_inherit_oil" model="ir.ui.view">
        <field name="name">maintenance.equipment.view.form.inherit.oil</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='service_info_group']" position="before">
                <group name="oil_equipment_toggle">
                    <field name="is_oil_equipment"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='service_info_group']" position="after">
                <group name="oil_field_info" invisible="not is_oil_equipment">
                    <group string="Oil &amp; Gas Details">
                        <field name="criticality"/>
                        <field name="location_type"/>
                        <field name="well_site_ids"
                               domain="[('is_oil_gas_well', '=', True), ('project_id.is_oil_gas_project', '=', True)]"
                               widget="many2many_tags"/>
                    </group>
                    <group string="Installation &amp; Certification">
                        <field name="installation_date"/>
                        <field name="last_inspection_date"/>
                        <field name="certification_number"/>
                        <field name="certification_expiry"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//page[@name='description']" position="after">
                <page name="operating_parameters" string="Operating Parameters"
                      invisible="not is_oil_equipment">
                    <group>
                        <group string="Pressure &amp; Temperature">
                            <field name="operating_pressure"/>
                            <field name="operating_temperature"/>
                        </group>
                        <group string="Capacity">
                            <field name="max_capacity"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend Equipment List View -->
    <record id="maintenance_equipment_view_list_inherit_oil" model="ir.ui.view">
        <field name="name">maintenance.equipment.view.list.inherit.oil</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_oil_equipment" column_invisible="True"/>
                <field name="criticality" optional="show"/>
                <field name="well_site_ids" optional="hide"
                       widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated action for Oil Equipment with domain and default -->
    <record id="action_oil_equipment" model="ir.actions.act_window">
        <field name="name">Oil Equipments</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_oil_equipment', '=', True)]</field>
        <field name="context">{'default_is_oil_equipment': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Oil &amp; Gas Equipment
            </p>
            <p>
                Track drilling rigs, pumps, compressors, separators and other
                oil field equipment.
            </p>
        </field>
    </record>

    <!-- Equipment menu under Oil ERP > Configuration > Upstream -->
    <menuitem id="menu_oil_equipment"
              name="Equipments"
              parent="oil_erp_base.menu_oil_config_upstream"
              action="action_oil_equipment"
              sequence="20"/>
</odoo>
