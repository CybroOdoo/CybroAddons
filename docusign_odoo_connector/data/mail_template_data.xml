<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email Template for Document Signing Reminder -->
        <record id="email_template_signing_reminder" model="mail.template">
            <field name="name">DocuSign: Signing Reminder</field>
            <field name="model_id" ref="docusign_odoo_connector.model_docusign_document_request"/>
            <field name="subject">Reminder: Document Signature Pending - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333; line-height: 1.6; margin: 0; padding: 20px;">
                    <p>Dear Customer,</p>
                    <p>
                        This is a gentle reminder that your signature is pending on the document(s) requested under reference
                        <strong><t t-out="object.name"/></strong>.
                    </p>
                    <p>
                        Please be aware that this document request will expire on 
                        <strong style="color: #d9534f;"><t t-out="object.expiry_date"/></strong>.
                    </p>
                    <p>
                        Please check your email inbox for the DocuSign invitation to review and sign your documents before the expiration date.
                    </p>
                    <br/>
                    <p>Thank you for your prompt attention,</p>
                    <p>
                        <strong><t t-out="object.company_id.name or user.company_id.name"/></strong>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
