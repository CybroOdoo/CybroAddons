<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled action to automatically send reminder emails before expiry -->
        <record id="ir_cron_docusign_signing_reminder" model="ir.cron">
            <field name="name">DocuSign: Automated Signing Reminder Before Expiry</field>
            <field name="model_id" ref="docusign_odoo_connector.model_docusign_document_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_signing_reminder()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Scheduled action to automatically check and update signing status -->
        <record id="ir_cron_docusign_auto_update_status" model="ir.cron">
            <field name="name">DocuSign: Auto Check and Update Signing Status</field>
            <field name="model_id" ref="docusign_odoo_connector.model_docusign_document_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_update_status()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">3</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
