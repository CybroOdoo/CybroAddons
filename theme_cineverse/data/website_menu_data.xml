<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Delete orphan website.menu entries created prior to theme.website.menu conversion or from previous themes -->
        <delete model="website.menu" search="[('url', 'in', ['/pricing', '/services', '/now-showing', '/showtimes', '/vip', '/gallery'])]"/>

        <record id="theme_menu_movies" model="theme.website.menu">
            <field name="name">Now Showing</field>
            <field name="url">/now-showing</field>
            <field name="use_main_menu_as_parent">True</field>
            <field name="sequence" type="int">20</field>
        </record>

        <record id="theme_menu_showtimes" model="theme.website.menu">
            <field name="name">Showtimes</field>
            <field name="url">/showtimes</field>
            <field name="use_main_menu_as_parent">True</field>
            <field name="sequence" type="int">30</field>
        </record>

        <record id="theme_menu_vip" model="theme.website.menu">
            <field name="name">VIP</field>
            <field name="url">/vip</field>
            <field name="use_main_menu_as_parent">True</field>
            <field name="sequence" type="int">40</field>
        </record>

        <record id="theme_menu_gallery" model="theme.website.menu">
            <field name="name">Gallery</field>
            <field name="url">/gallery</field>
            <field name="use_main_menu_as_parent">True</field>
            <field name="sequence" type="int">50</field>
        </record>
    </data>
</odoo>