<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Template: contact_templates.xml
        Purpose: Defines QWeb templates and snippets for the CineVerse theme.
    -->
    <template id="cineverse_contact_template_comp_0">
        <!-- PAGE HERO -->
    </template>

    <template id="cineverse_contact_template_comp_3">
        <section style="background:var(--ground-1);padding:clamp(44px,6vw,72px) 0;">
            <div class="container">
                <header class="section__head reveal"
                        style="text-align:left;margin-inline:0;margin-bottom:clamp(28px,4vw,44px);">
                    <p class="eyebrow">Getting Here</p>
                    <h2 style="font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.4rem);">By Any
                        <em>Route</em>
                    </h2>
                </header>
                <div class="reveal"
                     style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2px;">
                    <div style="background:var(--ground);padding:28px 24px;">
                        <span class="mono" style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">
                            ⊝
                        </span>
                        <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">Underground</h4>
                        <p style="color:var(--text-soft);font-size:.9rem;">Bond Street (Central, Jubilee) &#8212; 3 min
                            walk. Green Park (Jubilee, Victoria, Piccadilly) &#8212; 6 min walk.
                        </p>
                    </div>
                    <div style="background:var(--ground);padding:28px 24px;">
                        <span class="mono" style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">
                            ⊟
                        </span>
                        <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">Bus</h4>
                        <p style="color:var(--text-soft);font-size:.9rem;">Routes 2, 10, 16, 74, 137 stop on nearby
                            Oxford Street and Piccadilly.
                        </p>
                    </div>
                    <div style="background:var(--ground);padding:28px 24px;">
                        <span class="mono" style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">
                            ⊞
                        </span>
                        <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">By Car</h4>
                        <p style="color:var(--text-soft);font-size:.9rem;">NCP car parks on Grosvenor Square and Park
                            Lane. Gold Circle members receive a valet parking allocation.
                        </p>
                    </div>
                    <div style="background:var(--ground);padding:28px 24px;">
                        <span class="mono" style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">
                            ⊛
                        </span>
                        <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">Concierge
                            Transfer
                        </h4>
                        <p style="color:var(--text-soft);font-size:.9rem;">Platinum Reserve members can arrange a
                            chauffeur transfer through our dedicated concierge line.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="cineverse_contactus_inherit" inherit_id="website.contactus" name="CineVerse Contact Us">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <div class="oe_structure oe_empty" id="oe_structure_cineverse_contact_top"/>
                <section class="s_cineverse_contact_form" data-snippet="s_cineverse_contact_form"
                         data-name="Contact Form">
                    <!-- PAGE HERO -->
                    <div class="page-hero">
                        <p class="page-hero__eyebrow eyebrow">We'd Love to Hear From You</p>
                        <h1 class="page-hero__title">Get In
                            <em>Touch</em>
                        </h1>
                        <p class="page-hero__lead">Private hire, membership enquiries, or simply finding your way to
                            us.
                        </p>
                    </div>

                    <!-- CONTACT BODY -->
                    <section class="section" style="padding-top:clamp(44px,6vw,80px);">
                        <div class="container">
                            <div class="contact-grid reveal">

                                <!-- INFO COLUMN -->
                                <div class="contact-info">
                                    <div class="contact-block">
                                        <span class="mono eyebrow" style="font-size:.64rem;">Find Us</span>
                                        <address style="font-style:normal;margin-top:14px;">
                                            <p style="font-family:var(--font-display);font-size:1.25rem;line-height:1.4;">
                                                12 Marlowe Street<br/>Mayfair, London<br/>W1K 4BP
                                            </p>
                                        </address>
                                    </div>

                                    <div class="contact-block">
                                        <span class="mono eyebrow" style="font-size:.64rem;">Opening Hours</span>
                                        <table class="hours-table"
                                               style="margin-top:14px;border-collapse:collapse;width:100%;">
                                            <tbody>
                                                <tr>
                                                    <td class="mono"
                                                        style="font-size:.85rem;color:var(--text-soft);padding:5px 0;">
                                                        Monday &#8211; Thursday
                                                    </td>
                                                    <td class="mono"
                                                        style="font-size:.85rem;text-align:right;padding:5px 0;">
                                                        12:00 &#8211; 23:30
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="mono"
                                                        style="font-size:.85rem;color:var(--text-soft);padding:5px 0;">
                                                        Friday &#8211; Saturday
                                                    </td>
                                                    <td class="mono"
                                                        style="font-size:.85rem;text-align:right;padding:5px 0;">
                                                        11:00 &#8211; 01:00
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="mono"
                                                        style="font-size:.85rem;color:var(--text-soft);padding:5px 0;">
                                                        Sunday
                                                    </td>
                                                    <td class="mono"
                                                        style="font-size:.85rem;text-align:right;padding:5px 0;">
                                                        12:00 &#8211; 22:00
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="contact-block">
                                        <span class="mono eyebrow" style="font-size:.64rem;">Reach Us</span>
                                        <ul style="margin-top:14px;display:flex;flex-direction:column;gap:10px;">
                                            <li>
                                                <span class="mono"
                                                      style="font-size:.65rem;color:var(--text-mute);letter-spacing:.12em;display:block;margin-bottom:2px;">
                                                    TELEPHONE
                                                </span>
                                                <a href="tel:+442071234567"
                                                   style="font-size:1.05rem;color:var(--text);transition:color .2s;">
                                                    +44 (0)20 7123 4567
                                                </a>
                                            </li>
                                            <li>
                                                <span class="mono"
                                                      style="font-size:.65rem;color:var(--text-mute);letter-spacing:.12em;display:block;margin-bottom:2px;">
                                                    EMAIL
                                                </span>
                                                <a href="mailto:hello@cineverse.co.uk"
                                                   style="font-size:1.05rem;color:var(--text);transition:color .2s;">
                                                    hello@cineverse.co.uk
                                                </a>
                                            </li>
                                            <li>
                                                <span class="mono"
                                                      style="font-size:.65rem;color:var(--text-mute);letter-spacing:.12em;display:block;margin-bottom:2px;">
                                                    PRIVATE HIRE
                                                </span>
                                                <a href="mailto:events@cineverse.co.uk"
                                                   style="font-size:1.05rem;color:var(--text);transition:color .2s;">
                                                    events@cineverse.co.uk
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <!-- FORM COLUMN -->
                                <div class="contact-form-col">
                                    <p class="eyebrow" style="margin-bottom:14px;">Send a message</p>
                                    <h2 style="font-family:var(--font-display);font-size:clamp(1.5rem,3.5vw,2.6rem);line-height:1.15;margin-bottom:28px;">
                                        We reply within
                                        <em>one working day.</em>
                                    </h2>

                                    <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                        <div class="container-fluid px-0">
                                            <form class="contact-form o_mark_required" action="/website/form/"
                                                  method="post" data-model_name="mail.mail"
                                                  data-success-mode="redirect"
                                                  data-success-page="/contactus-thank-you" data-pre-fill="true"
                                                  data-mark="*" enctype="multipart/form-data">
                                                <div class="s_website_form_rows row s_col_no_bgcolor">

                                                    <!-- Email To (Hidden) -->
                                                    <div data-name="Field"
                                                         class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                                            <label class="col-form-label col-sm-auto s_website_form_label"
                                                                   style="width: 200px">
                                                                <span class="s_website_form_label_content"/>
                                                            </label>
                                                            <div class="col-sm">
                                                                <input type="hidden"
                                                                       class="form-control s_website_form_input"
                                                                       name="email_to"
                                                                       value="info@yourcompany.example.com"/>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Your Name -->
                                                    <div data-name="Field"
                                                         class="s_website_form_field mb-3 col-12 col-md-6 s_website_form_custom s_website_form_required"
                                                         data-type="char">
                                                        <div class="row s_col_no_resize s_col_no_bgcolor flex-column">
                                                            <label class="col-form-label col-sm-auto s_website_form_label form-label mono w-100"
                                                                   for="cName">
                                                                <span class="s_website_form_label_content">Your
                                                                    Name
                                                                </span>
                                                                <span class="s_website_form_mark">*</span>
                                                            </label>
                                                            <div class="col-sm-12">
                                                                <input class="form-control form-input s_website_form_input"
                                                                       type="text" name="name" required="1"
                                                                       data-fill-with="name" id="cName"
                                                                       placeholder="Jane Smith"/>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Email -->
                                                    <div data-name="Field"
                                                         class="s_website_form_field mb-3 col-12 col-md-6 s_website_form_model_required"
                                                         data-type="email">
                                                        <div class="row s_col_no_resize s_col_no_bgcolor flex-column">
                                                            <label class="col-form-label col-sm-auto s_website_form_label form-label mono w-100"
                                                                   for="cEmail">
                                                                <span class="s_website_form_label_content">Email
                                                                    Address
                                                                </span>
                                                                <span class="s_website_form_mark">*</span>
                                                            </label>
                                                            <div class="col-sm-12">
                                                                <input class="form-control form-input s_website_form_input"
                                                                       type="email" name="email_from" required=""
                                                                       data-fill-with="email" id="cEmail"
                                                                       placeholder="jane@example.com"/>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Subject -->
                                                    <div data-name="Field"
                                                         class="s_website_form_field mb-3 col-12 s_website_form_model_required"
                                                         data-type="char">
                                                        <div class="row s_col_no_resize s_col_no_bgcolor flex-column">
                                                            <label class="col-form-label col-sm-auto s_website_form_label form-label mono w-100"
                                                                   for="cSubject">
                                                                <span class="s_website_form_label_content">Subject
                                                                </span>
                                                                <span class="s_website_form_mark">*</span>
                                                            </label>
                                                            <div class="col-sm-12">
                                                                <input class="form-control form-input s_website_form_input"
                                                                       type="text" name="subject" required=""
                                                                       id="cSubject" placeholder="General Enquiry"/>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Message -->
                                                    <div data-name="Field"
                                                         class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required form-group--message"
                                                         data-type="text">
                                                        <div class="row s_col_no_resize s_col_no_bgcolor flex-column">
                                                            <label class="col-form-label col-sm-auto s_website_form_label form-label mono w-100"
                                                                   for="cMessage">
                                                                <span class="s_website_form_label_content">Message
                                                                </span>
                                                                <span class="s_website_form_mark">*</span>
                                                            </label>
                                                            <div class="col-sm-12">
                                                                <textarea
                                                                        class="form-control form-input form-textarea s_website_form_input"
                                                                        name="description" required="1"
                                                                        id="cMessage" rows="6"
                                                                        placeholder="Tell us what you have in mind..."/>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Submit Button -->
                                                    <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label"
                                                         data-name="Submit Button">
                                                        <div style="width: 200px;" class="s_website_form_label"/>
                                                        <span id="s_website_form_result"/>
                                                        <a href="#" role="button"
                                                           class="btn btn--gold btn--ripple s_website_form_send">
                                                            Send Message
                                                        </a>
                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </section>
                                </div>

                            </div>
                        </div>
                    </section>
                </section>
                <div class="oe_structure oe_empty" id="oe_structure_cineverse_contact_mid"/>
                <section class="s_cineverse_transport" data-snippet="s_cineverse_transport" data-name="Transport"
                         style="background:var(--ground-1);padding:clamp(44px,6vw,72px) 0;">
                    <div class="container">
                        <header class="section__head reveal"
                                style="text-align:left;margin-inline:0;margin-bottom:clamp(28px,4vw,44px);">
                            <p class="eyebrow">Getting Here</p>
                            <h2 style="font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.4rem);">By Any
                                <em>Route</em>
                            </h2>
                        </header>
                        <div class="reveal"
                             style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2px;">
                            <div style="background:var(--ground);padding:28px 24px;">
                                <span class="mono"
                                      style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">
                                    ⊝
                                </span>
                                <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">
                                    Underground
                                </h4>
                                <p style="color:var(--text-soft);font-size:.9rem;">Bond Street (Central, Jubilee)
                                    &#8212; 3 min
                                    walk. Green Park (Jubilee, Victoria, Piccadilly) &#8212; 6 min walk.
                                </p>
                            </div>
                            <div style="background:var(--ground);padding:28px 24px;">
                                <span class="mono"
                                      style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">
                                    ⊟
                                </span>
                                <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">
                                    Bus
                                </h4>
                                <p style="color:var(--text-soft);font-size:.9rem;">Routes 2, 10, 16, 74, 137 stop on
                                    nearby
                                    Oxford Street and Piccadilly.
                                </p>
                            </div>
                            <div style="background:var(--ground);padding:28px 24px;">
                                <span class="mono"
                                      style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">
                                    ⊞
                                </span>
                                <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">By
                                    Car
                                </h4>
                                <p style="color:var(--text-soft);font-size:.9rem;">NCP car parks on Grosvenor Square
                                    and Park
                                    Lane. Gold Circle members receive a valet parking allocation.
                                </p>
                            </div>
                            <div style="background:var(--ground);padding:28px 24px;">
                                <span class="mono"
                                      style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">
                                    ⊛
                                </span>
                                <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">
                                    Concierge
                                    Transfer
                                </h4>
                                <p style="color:var(--text-soft);font-size:.9rem;">Platinum Reserve members can
                                    arrange a
                                    chauffeur transfer through our dedicated concierge line.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty" id="oe_structure_cineverse_contact_bottom"/>
            </div>
        </xpath>
    </template>
</odoo>