<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Template: movies_templates.xml
        Purpose: Defines QWeb templates and snippets for the CineVerse theme.
    -->
    <template id="cineverse_movies_template_comp_0">
        <!-- PAGE HERO -->
    </template>

    <template id="cineverse_movies_template" name="Now Showing page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="oe_structure oe_empty" id="oe_structure_cineverse_movies_top"/>
                <section class="s_cineverse_hero hero" data-snippet="s_cineverse_hero" data-name="Hero" id="hero">
                    <div class="hero__beam" id="heroBeam" aria-hidden="true"></div>
                    <div class="hero__bg" id="heroBg">
                        <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&amp;fit=crop&amp;w=2000&amp;q=80"
                             alt="" aria-hidden="true"/>
                    </div>
                    <div class="hero__overlay" aria-hidden="true"></div>
                    <div class="hero__content">
                        <h1 class="hero__title">
                            Experience
                            <br/>
                            <em>Cinema</em>
                            <br/>Differently.
                        </h1>
                        <p class="hero__specs mono">4K LASER · DOLBY ATMOS · RECLINER SEATING · GOURMET DINING</p>
                        <div class="hero__actions">
                            <a href="/now-showing" class="btn btn--gold btn--ripple">Book Tickets</a>
                            <button class="btn btn--outline btn--ripple" id="trailerBtn">
                                <span class="play-dot" aria-hidden="true"></span>Watch Trailer
                            </button>
                        </div>
                    </div>
                    <div class="hero__footer" aria-hidden="true">
                        <span class="mono hero__reel">REEL 01 · FRAME 2026 · 2.39:1</span>
                        <a href="/now-showing" class="hero__scroll">
                            <span class="hero__scroll-line"></span>
                            <span class="mono">Explore</span>
                        </a>
                    </div>
                </section>

                <div class="oe_structure oe_empty" id="oe_structure_cineverse_movies_mid1"/>
                <section class="s_cineverse_film_strip section movies" data-snippet="s_cineverse_film_strip"
                         data-name="Film Strip" style="padding-top: clamp(44px,6vw,80px);">
                    <div class="container">
                        <header class="section__head reveal" style="text-align:left; margin-inline:0;">
                            <p class="eyebrow">Currently Playing</p>
                            <h2 class="section__title" style="font-size:clamp(1.8rem,3.5vw,2.8rem);">This Week's
                                Programme
                            </h2>
                        </header>
                    </div>
                    <div class="strip-outer">
                        <div class="film-strip" id="filmStrip" role="list">
                            <t t-set="cineverse_movies" t-value="env['cineverse.movie'].sudo().search([('active', '=', True)], order='sequence, id')"/>
                            <t t-if="cineverse_movies">
                                <t t-foreach="cineverse_movies" t-as="movie">
                                    <article class="film-card reveal" role="listitem">
                                        <div class="film-card__sprocket" aria-hidden="true"></div>
                                        <div class="film-card__poster">
                                            <img t-att-src="movie.get_poster_url()" t-att-alt="movie.name" loading="lazy"/>
                                            <span t-if="movie.badge" class="film-card__badge" t-esc="movie.badge"/>
                                        </div>
                                        <div class="film-card__body">
                                            <div class="film-card__meta">
                                                <span class="mono" t-out="'★ %.1f' % movie.rating if movie.rating else '★ 9.0'"/>
                                                <span class="film-card__dot"></span>
                                                <span class="mono" t-esc="movie.duration or ''"/>
                                            </div>
                                            <h3 class="film-card__title" t-esc="movie.name"/>
                                            <p class="film-card__genre" t-esc="movie.category"/>
                                            <a href="/showtimes" class="btn btn--gold btn--sm btn--ripple">Book Now</a>
                                        </div>
                                    </article>
                                </t>
                            </t>
                            <t t-else="">
                                <article class="film-card reveal" role="listitem">
                                    <div class="film-card__sprocket" aria-hidden="true"></div>
                                    <div class="film-card__poster">
                                        <img src="https://images.unsplash.com/photo-1635805737707-575885ab0820?auto=format&amp;fit=crop&amp;w=500&amp;q=80" alt="Celestial Drift" loading="lazy"/>
                                        <span class="film-card__badge">IMAX</span>
                                    </div>
                                    <div class="film-card__body">
                                        <div class="film-card__meta"><span class="mono">★ 9.1</span><span class="film-card__dot"></span><span class="mono">2h 18m</span></div>
                                        <h3 class="film-card__title">Celestial Drift</h3>
                                        <p class="film-card__genre">Sci-Fi</p>
                                        <a href="/showtimes" class="btn btn--gold btn--sm btn--ripple">Book Now</a>
                                    </div>
                                </article>
                                <article class="film-card reveal" role="listitem">
                                    <div class="film-card__sprocket" aria-hidden="true"></div>
                                    <div class="film-card__poster">
                                        <img src="https://images.unsplash.com/photo-1574267432553-4b4628081c31?auto=format&amp;fit=crop&amp;w=500&amp;q=80" alt="The Velvet Hour" loading="lazy"/>
                                        <span class="film-card__badge">PREMIERE</span>
                                    </div>
                                    <div class="film-card__body">
                                        <div class="film-card__meta"><span class="mono">★ 8.7</span><span class="film-card__dot"></span><span class="mono">1h 56m</span></div>
                                        <h3 class="film-card__title">The Velvet Hour</h3>
                                        <p class="film-card__genre">Drama</p>
                                        <a href="/showtimes" class="btn btn--gold btn--sm btn--ripple">Book Now</a>
                                    </div>
                                </article>
                            </t>
                        </div>
                        <p class="strip-hint mono" aria-hidden="true">← Drag to explore →</p>
                    </div>
                </section>

                <div class="oe_structure oe_empty" id="oe_structure_cineverse_movies_mid2"/>
                <section class="s_cineverse_upcoming_grid section" data-snippet="s_cineverse_upcoming_grid"
                         data-name="Upcoming Grid" style="background: var(--ground-1);">
                    <div class="container">
                        <header class="section__head reveal">
                            <p class="eyebrow">Coming Soon</p>
                            <h2 class="section__title">Upcoming
                                <em>Releases</em>
                            </h2>
                            <p class="section__lead">Reserve your seat before opening night &#8212; Gold Circle
                                members get priority access.
                            </p>
                        </header>
                        <div class="upcoming-grid">
                            <div class="upcoming-card reveal">
                                <div class="upcoming-card__img">
                                    <img src="https://images.unsplash.com/photo-1534809027769-b00d750a6bac?auto=format&amp;fit=crop&amp;w=400&amp;q=80"
                                         alt="Neon Requiem" loading="lazy"/>
                                </div>
                                <div class="upcoming-card__body">
                                    <h3 class="upcoming-card__title">Neon Requiem</h3>
                                    <p class="upcoming-card__when mono">FROM 28 JUL · SCREEN 2</p>
                                </div>
                            </div>
                            <div class="upcoming-card reveal">
                                <div class="upcoming-card__img">
                                    <img src="https://images.unsplash.com/photo-1518676590629-3dcbd9c5a5c9?auto=format&amp;fit=crop&amp;w=400&amp;q=80"
                                         alt="Pale Blue Silence" loading="lazy"/>
                                </div>
                                <div class="upcoming-card__body">
                                    <h3 class="upcoming-card__title">Pale Blue Silence</h3>
                                    <p class="upcoming-card__when mono">FROM 04 AUG · IMAX</p>
                                </div>
                            </div>
                            <div class="upcoming-card reveal">
                                <div class="upcoming-card__img">
                                    <img src="https://images.unsplash.com/photo-1509281373149-e957c6296406?auto=format&amp;fit=crop&amp;w=400&amp;q=80"
                                         alt="The Amber Hour" loading="lazy"/>
                                </div>
                                <div class="upcoming-card__body">
                                    <h3 class="upcoming-card__title">The Amber Hour</h3>
                                    <p class="upcoming-card__when mono">FROM 11 AUG · DOLBY</p>
                                </div>
                            </div>
                            <div class="upcoming-card reveal">
                                <div class="upcoming-card__img">
                                    <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&amp;fit=crop&amp;w=400&amp;q=80"
                                         alt="Kindred" loading="lazy"/>
                                </div>
                                <div class="upcoming-card__body">
                                    <h3 class="upcoming-card__title">Kindred</h3>
                                    <p class="upcoming-card__when mono">FROM 18 AUG · 4K LASER</p>
                                </div>
                            </div>
                            <div class="upcoming-card reveal">
                                <div class="upcoming-card__img">
                                    <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&amp;fit=crop&amp;w=400&amp;q=80"
                                         alt="The Glass Garden" loading="lazy"/>
                                </div>
                                <div class="upcoming-card__body">
                                    <h3 class="upcoming-card__title">The Glass Garden</h3>
                                    <p class="upcoming-card__when mono">FROM 25 AUG · PREMIERE</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty" id="oe_structure_cineverse_movies_bottom"/>
            </div>
        </t>
    </template>

    <record id="cineverse_movies_page" model="website.page">
        <field name="name">Now Showing</field>
        <field name="url">/now-showing</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="cineverse_movies_template"/>
        <field name="track">True</field>
        <field name="website_meta_title">Now Showing | CineVerse</field>
        <field name="website_meta_description">Discover the latest blockbuster hits and exclusive premiere screenings at CineVerse.</field>
        <field name="website_meta_keywords">cinema, movies, now showing, film, theater</field>
    </record>
</odoo>