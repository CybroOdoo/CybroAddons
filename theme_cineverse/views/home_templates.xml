<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cineverse_index_template" inherit_id="website.homepage" name="Home page">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- 1. Hero -->
                <section class="s_cineverse_hero hero" data-snippet="theme_cineverse.s_cineverse_hero" data-name="Hero" id="hero">
                    <div class="hero__beam" id="heroBeam" aria-hidden="true"/>
                    <div class="hero__bg" id="heroBg">
                        <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&amp;fit=crop&amp;w=2000&amp;q=80" alt="" aria-hidden="true"/>
                    </div>
                    <div class="hero__overlay" aria-hidden="true"/>
                    <div class="hero__content">
                        <h1 class="hero__title">
                            Experience<br/><em>Cinema</em><br/>Differently.
                        </h1>
                        <p class="hero__specs mono">4K LASER · DOLBY ATMOS · RECLINER SEATING · GOURMET DINING</p>
                        <div class="hero__actions">
                            <a href="/now-showing" class="btn btn--gold btn--ripple">Book Tickets</a>
                            <button class="btn btn--outline btn--ripple" id="trailerBtn">
                                <span class="play-dot" aria-hidden="true"/>Watch Trailer
                            </button>
                        </div>
                    </div>
                    <div class="hero__footer" aria-hidden="true">
                        <span class="mono hero__reel">REEL 01 · FRAME 2026 · 2.39:1</span>
                        <a href="/now-showing" class="hero__scroll">
                            <span class="hero__scroll-line"/>
                            <span class="mono">Explore</span>
                        </a>
                    </div>
                </section>

                <!-- 2. Experience -->
                <section class="s_cineverse_experience section experience" data-snippet="theme_cineverse.s_cineverse_experience" data-name="Experience" id="experience">
                    <div class="container">
                        <header class="section__head reveal">
                            <p class="eyebrow">The Experience</p>
                            <h2 class="section__title">Built for the<br/><em>Best Seat</em> in the House</h2>
                        </header>
                        <div class="xp-grid">
                            <article class="xp-card reveal">
                                <span class="xp-card__num mono">01</span>
                                <h3>Recliner Seating</h3>
                                <p>Hand-stitched leather recliners, heated lumbar support, and a private side table &#8212; per seat, every row.</p>
                            </article>
                            <article class="xp-card reveal">
                                <span class="xp-card__num mono">02</span>
                                <h3>Dolby Atmos</h3>
                                <p>64 discrete speakers that move sound around the room with three-dimensional precision. No sweet spot required.</p>
                            </article>
                            <article class="xp-card reveal">
                                <span class="xp-card__num mono">03</span>
                                <h3>4K Laser Projection</h3>
                                <p>Dual laser projectors. 22-metre screen. Infinite contrast and colour that makes standard HD look like a memory.</p>
                            </article>
                            <article class="xp-card reveal">
                                <span class="xp-card__num mono">04</span>
                                <h3>Gourmet Dining</h3>
                                <p>A seasonal menu by award-winning chefs. Served discreetly at your seat &#8212; before, during, and after.</p>
                            </article>
                            <article class="xp-card reveal">
                                <span class="xp-card__num mono">05</span>
                                <h3>VIP Lounge</h3>
                                <p>Arrive early. Members-only space with champagne service, skyline views, and private event access.</p>
                            </article>
                            <article class="xp-card reveal">
                                <span class="xp-card__num mono">06</span>
                                <h3>Concierge</h3>
                                <p>Valet parking, private screenings, bespoke events &#8212; handled before you think to ask.</p>
                            </article>
                        </div>
                    </div>
                </section>

                <!-- 3. Movies Teaser -->
                <section class="s_cineverse_movies_teaser section movies" data-snippet="theme_cineverse.s_cineverse_movies_teaser" data-name="Movies Teaser" id="movies-teaser">
                    <div class="container">
                        <header class="section__head reveal">
                            <p class="eyebrow">Now Showing</p>
                            <h2 class="section__title">On Our Screens</h2>
                        </header>
                    </div>
                    <div class="strip-outer">
                        <button class="strip-prev" id="stripPrev" aria-label="Previous films" disabled="disabled">&#8592;</button>
                        <div class="film-strip" id="filmStrip" role="list">
                            <article class="film-card reveal" role="listitem">
                                <div class="film-card__sprocket" aria-hidden="true"/>
                                <div class="film-card__poster">
                                    <img src="https://images.unsplash.com/photo-1635805737707-575885ab0820?auto=format&amp;fit=crop&amp;w=500&amp;q=80" alt="Celestial Drift" loading="lazy"/>
                                    <span class="film-card__badge">IMAX</span>
                                </div>
                                <div class="film-card__body">
                                    <div class="film-card__meta"><span class="mono">★ 9.1</span><span class="film-card__dot"/><span class="mono">2h 18m</span></div>
                                    <h3 class="film-card__title">Celestial Drift</h3>
                                    <p class="film-card__genre">Sci-Fi</p>
                                    <a href="/showtimes" class="btn btn--gold btn--sm btn--ripple">Book Now</a>
                                </div>
                            </article>
                            <article class="film-card reveal" role="listitem">
                                <div class="film-card__sprocket" aria-hidden="true"/>
                                <div class="film-card__poster">
                                    <img src="https://images.unsplash.com/photo-1574267432553-4b4628081c31?auto=format&amp;fit=crop&amp;w=500&amp;q=80" alt="The Velvet Hour" loading="lazy"/>
                                    <span class="film-card__badge">PREMIERE</span>
                                </div>
                                <div class="film-card__body">
                                    <div class="film-card__meta"><span class="mono">★ 8.7</span><span class="film-card__dot"/><span class="mono">1h 56m</span></div>
                                    <h3 class="film-card__title">The Velvet Hour</h3>
                                    <p class="film-card__genre">Drama</p>
                                    <a href="/showtimes" class="btn btn--gold btn--sm btn--ripple">Book Now</a>
                                </div>
                            </article>
                            <article class="film-card reveal" role="listitem">
                                <div class="film-card__sprocket" aria-hidden="true"/>
                                <div class="film-card__poster">
                                    <img src="https://images.unsplash.com/photo-1542204165-65bf26472b9b?auto=format&amp;fit=crop&amp;w=500&amp;q=80" alt="Midnight Sonata" loading="lazy"/>
                                    <span class="film-card__badge">DOLBY</span>
                                </div>
                                <div class="film-card__body">
                                    <div class="film-card__meta"><span class="mono">★ 9.4</span><span class="film-card__dot"/><span class="mono">2h 04m</span></div>
                                    <h3 class="film-card__title">Midnight Sonata</h3>
                                    <p class="film-card__genre">Thriller</p>
                                    <a href="/showtimes" class="btn btn--gold btn--sm btn--ripple">Book Now</a>
                                </div>
                            </article>
                            <article class="film-card reveal" role="listitem">
                                <div class="film-card__sprocket" aria-hidden="true"/>
                                <div class="film-card__poster">
                                    <img src="https://images.unsplash.com/photo-1626814026160-2237a95fc5a0?auto=format&amp;fit=crop&amp;w=500&amp;q=80" alt="Golden Empire" loading="lazy"/>
                                    <span class="film-card__badge">4K LASER</span>
                                </div>
                                <div class="film-card__body">
                                    <div class="film-card__meta"><span class="mono">★ 8.9</span><span class="film-card__dot"/><span class="mono">2h 31m</span></div>
                                    <h3 class="film-card__title">Golden Empire</h3>
                                    <p class="film-card__genre">Adventure</p>
                                    <a href="/showtimes" class="btn btn--gold btn--sm btn--ripple">Book Now</a>
                                </div>
                            </article>
                            <article class="film-card reveal" role="listitem">
                                <div class="film-card__sprocket" aria-hidden="true"/>
                                <div class="film-card__poster">
                                    <img src="https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&amp;fit=crop&amp;w=500&amp;q=80" alt="The Last Frame" loading="lazy"/>
                                    <span class="film-card__badge">DIRECTOR'S CUT</span>
                                </div>
                                <div class="film-card__body">
                                    <div class="film-card__meta"><span class="mono">★ 9.6</span><span class="film-card__dot"/><span class="mono">3h 02m</span></div>
                                    <h3 class="film-card__title">The Last Frame</h3>
                                    <p class="film-card__genre">Drama</p>
                                    <a href="/showtimes" class="btn btn--gold btn--sm btn--ripple">Book Now</a>
                                </div>
                            </article>
                        </div>
                        <button class="strip-next" id="stripNext" aria-label="Next films">&#8594;</button>
                    </div>
                    <div class="movie-preview-link reveal">
                        <a href="/now-showing" class="btn btn--outline btn--ripple">View All Films</a>
                    </div>
                </section>

                <!-- 4. Testimonials -->
                <section class="s_cineverse_testimonials section testimonials" data-snippet="theme_cineverse.s_cineverse_testimonials" data-name="Testimonials">
                    <div class="container">
                        <header class="section__head reveal">
                            <p class="eyebrow">Guest Stories</p>
                        </header>
                        <div class="carousel" id="carousel" aria-label="Guest testimonials">
                            <div class="carousel__track" id="carouselTrack">
                                <figure class="testimonial">
                                    <p class="testimonial__stars mono" aria-label="5 stars">★★★★★</p>
                                    <blockquote>"The most luxurious way to watch a film I've ever found. The recliners, the sound, the service &#8212; it's a private premiere every single time."</blockquote>
                                    <figcaption class="testimonial__credit">
                                        <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&amp;fit=crop&amp;w=120&amp;q=80" alt="Sophia Laurent"/>
                                        <div><strong>Sophia Laurent</strong><span class="mono">Gold Circle Member</span></div>
                                    </figcaption>
                                </figure>
                                <figure class="testimonial">
                                    <p class="testimonial__stars mono" aria-label="5 stars">★★★★★</p>
                                    <blockquote>"I've visited cinemas all over the world. CineVerse belongs in a different category entirely &#8212; the Dolby room is genuinely breathtaking."</blockquote>
                                    <figcaption class="testimonial__credit">
                                        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&amp;fit=crop&amp;w=120&amp;q=80" alt="James Whitmore"/>
                                        <div><strong>James Whitmore</strong><span class="mono">Film Critic, The Times</span></div>
                                    </figcaption>
                                </figure>
                                <figure class="testimonial">
                                    <p class="testimonial__stars mono" aria-label="5 stars">★★★★★</p>
                                    <blockquote>"We booked the VIP lounge for an anniversary. Concierge, dining, champagne on arrival &#8212; every detail handled before we thought to ask."</blockquote>
                                    <figcaption class="testimonial__credit">
                                        <img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&amp;fit=crop&amp;w=120&amp;q=80" alt="Amara Okafor"/>
                                        <div><strong>Amara Okafor</strong><span class="mono">VIP Guest</span></div>
                                    </figcaption>
                                </figure>
                            </div>
                            <div class="carousel__dots" id="carouselDots" role="tablist" aria-label="Select testimonial"/>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>