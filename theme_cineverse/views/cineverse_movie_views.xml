<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_cineverse_movie_tree" model="ir.ui.view">
        <field name="name">cineverse.movie.tree</field>
        <field name="model">cineverse.movie</field>
        <field name="arch" type="xml">
            <list string="CineVerse Movies">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="duration"/>
                <field name="rating"/>
                <field name="badge"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_cineverse_movie_form" model="ir.ui.view">
        <field name="name">cineverse.movie.form</field>
        <field name="model">cineverse.movie</field>
        <field name="arch" type="xml">
            <form string="CineVerse Movie">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Celestial Drift"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category" placeholder="e.g. Sci-Fi"/>
                            <field name="duration" placeholder="e.g. 2h 18m"/>
                            <field name="rating" placeholder="e.g. 9.1"/>
                        </group>
                        <group>
                            <field name="badge" placeholder="e.g. IMAX / PREMIERE"/>
                            <field name="showtimes" placeholder="e.g. 11:30, 14:15, 17:45, 21:00"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="image_url" placeholder="https://..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cineverse_movie" model="ir.actions.act_window">
        <field name="name">Movies</field>
        <field name="res_model">cineverse.movie</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new movie for CineVerse!
            </p>
            <p>
                Add movie title, poster image, rating, duration, category/genre, and format badges to show in website carousels.
            </p>
        </field>
    </record>

    <!-- Menu Item under Website -> Configuration or Main Menu -->
    <menuitem id="menu_cineverse_root" name="CineVerse" parent="website.menu_website_configuration" sequence="90"/>
    <menuitem id="menu_cineverse_movies" name="Movies" parent="menu_cineverse_root" action="action_cineverse_movie" sequence="10"/>
</odoo>
