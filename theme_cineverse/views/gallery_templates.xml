<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Template: gallery_templates.xml
        Purpose: Defines QWeb templates and snippets for the CineVerse theme.
    -->
    <template id="cineverse_gallery_template_comp_0">
        <!-- PAGE HERO -->
    </template>
    <template id="cineverse_gallery_template_comp_1">
        <section class="s_cineverse_gallery_intro" data-snippet="s_cineverse_gallery_intro" data-name="Gallery Intro">
            <div class="page-hero">
                <p class="page-hero__eyebrow eyebrow">Inside CineVerse</p>
                <h1 class="page-hero__title">The
                    <em>Atmosphere</em>
                </h1>
                <p class="page-hero__lead">Screens, lounges, events, and the details that set us apart.</p>
            </div>

            <!-- CINEMA TAPE -->
            <div class="cinema-tape" aria-hidden="true">
                <!-- Features row &#8212; scrolls left -->
                <div class="tape-row">
                    <div class="tape-track tape-track--fwd">
                        <span class="tape-item">4K Laser</span>
                        <span class="tape-item">Dolby Atmos</span>
                        <span class="tape-item">IMAX</span>
                        <span class="tape-item">Premiere Screen</span>
                        <span class="tape-item">Director's Cut</span>
                        <span class="tape-item">VIP Lounge</span>
                        <span class="tape-item">Gold Circle</span>
                        <span class="tape-item">Est. 1928</span>
                        <span class="tape-item">London</span>
                        <span class="tape-item">Private Screening</span>
                        <span class="tape-item">Film Festival</span>
                        <span class="tape-item">Recliner Seating</span>
                        <span class="tape-item">Gourmet Dining</span>
                        <!-- duplicate for seamless loop -->
                        <span class="tape-item">4K Laser</span>
                        <span class="tape-item">Dolby Atmos</span>
                        <span class="tape-item">IMAX</span>
                        <span class="tape-item">Premiere Screen</span>
                        <span class="tape-item">Director's Cut</span>
                        <span class="tape-item">VIP Lounge</span>
                        <span class="tape-item">Gold Circle</span>
                        <span class="tape-item">Est. 1928</span>
                        <span class="tape-item">London</span>
                        <span class="tape-item">Private Screening</span>
                        <span class="tape-item">Film Festival</span>
                        <span class="tape-item">Recliner Seating</span>
                        <span class="tape-item">Gourmet Dining</span>
                    </div>
                </div>
                <div class="tape-divider"/>
                <!-- Film titles row &#8212; scrolls right -->
                <div class="tape-row tape-row--titles">
                    <div class="tape-track tape-track--rev">
                        <span class="tape-title">Celestial Drift</span>
                        <span class="tape-title">The Velvet Hour</span>
                        <span class="tape-title">Midnight Sonata</span>
                        <span class="tape-title">Golden Empire</span>
                        <span class="tape-title">The Last Frame</span>
                        <span class="tape-title">Neon Requiem</span>
                        <span class="tape-title">Pale Blue Silence</span>
                        <span class="tape-title">The Amber Hour</span>
                        <span class="tape-title">Kindred</span>
                        <span class="tape-title">The Glass Garden</span>
                        <!-- duplicate for seamless loop -->
                        <span class="tape-title">Celestial Drift</span>
                        <span class="tape-title">The Velvet Hour</span>
                        <span class="tape-title">Midnight Sonata</span>
                        <span class="tape-title">Golden Empire</span>
                        <span class="tape-title">The Last Frame</span>
                        <span class="tape-title">Neon Requiem</span>
                        <span class="tape-title">Pale Blue Silence</span>
                        <span class="tape-title">The Amber Hour</span>
                        <span class="tape-title">Kindred</span>
                        <span class="tape-title">The Glass Garden</span>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="cineverse_gallery_template" name="Gallery page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="oe_structure oe_empty" id="oe_structure_cineverse_gallery_top"/>
                <section class="s_cineverse_gallery_intro" data-snippet="s_cineverse_gallery_intro"
                         data-name="Gallery Intro">
                    <div class="page-hero">
                        <p class="page-hero__eyebrow eyebrow">Inside CineVerse</p>
                        <h1 class="page-hero__title">The
                            <em>Atmosphere</em>
                        </h1>
                        <p class="page-hero__lead">Screens, lounges, events, and the details that set us apart.</p>
                    </div>

                    <!-- CINEMA TAPE -->
                    <div class="cinema-tape" aria-hidden="true">
                        <!-- Features row &#8212; scrolls left -->
                        <div class="tape-row">
                            <div class="tape-track tape-track--fwd">
                                <span class="tape-item">4K Laser</span>
                                <span class="tape-item">Dolby Atmos</span>
                                <span class="tape-item">IMAX</span>
                                <span class="tape-item">Premiere Screen</span>
                                <span class="tape-item">Director's Cut</span>
                                <span class="tape-item">VIP Lounge</span>
                                <span class="tape-item">Gold Circle</span>
                                <span class="tape-item">Est. 1928</span>
                                <span class="tape-item">London</span>
                                <span class="tape-item">Private Screening</span>
                                <span class="tape-item">Film Festival</span>
                                <span class="tape-item">Recliner Seating</span>
                                <span class="tape-item">Gourmet Dining</span>
                                <!-- duplicate for seamless loop -->
                                <span class="tape-item">4K Laser</span>
                                <span class="tape-item">Dolby Atmos</span>
                                <span class="tape-item">IMAX</span>
                                <span class="tape-item">Premiere Screen</span>
                                <span class="tape-item">Director's Cut</span>
                                <span class="tape-item">VIP Lounge</span>
                                <span class="tape-item">Gold Circle</span>
                                <span class="tape-item">Est. 1928</span>
                                <span class="tape-item">London</span>
                                <span class="tape-item">Private Screening</span>
                                <span class="tape-item">Film Festival</span>
                                <span class="tape-item">Recliner Seating</span>
                                <span class="tape-item">Gourmet Dining</span>
                            </div>
                        </div>
                        <div class="tape-divider"/>
                        <!-- Film titles row &#8212; scrolls right -->
                        <div class="tape-row tape-row--titles">
                            <div class="tape-track tape-track--rev">
                                <span class="tape-title">Celestial Drift</span>
                                <span class="tape-title">The Velvet Hour</span>
                                <span class="tape-title">Midnight Sonata</span>
                                <span class="tape-title">Golden Empire</span>
                                <span class="tape-title">The Last Frame</span>
                                <span class="tape-title">Neon Requiem</span>
                                <span class="tape-title">Pale Blue Silence</span>
                                <span class="tape-title">The Amber Hour</span>
                                <span class="tape-title">Kindred</span>
                                <span class="tape-title">The Glass Garden</span>
                                <!-- duplicate for seamless loop -->
                                <span class="tape-title">Celestial Drift</span>
                                <span class="tape-title">The Velvet Hour</span>
                                <span class="tape-title">Midnight Sonata</span>
                                <span class="tape-title">Golden Empire</span>
                                <span class="tape-title">The Last Frame</span>
                                <span class="tape-title">Neon Requiem</span>
                                <span class="tape-title">Pale Blue Silence</span>
                                <span class="tape-title">The Amber Hour</span>
                                <span class="tape-title">Kindred</span>
                                <span class="tape-title">The Glass Garden</span>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty" id="oe_structure_cineverse_gallery_mid"/>
                <section class="s_cineverse_gallery_tape section" data-snippet="s_cineverse_gallery_tape"
                         data-name="Gallery Tape" style="padding-top:clamp(44px,6vw,80px);">
                    <div class="container">
                        <header class="section__head reveal" style="text-align:left;margin-inline:0;">
                            <p class="eyebrow">Spaces &amp; Moments</p>
                            <h2 class="section__title" style="font-size:clamp(1.8rem,3.5vw,2.8rem);">Inside
                                <em>The Rooms</em>
                            </h2>
                        </header>
                        <div class="gal-grid reveal">

                            <!-- Row 1 &#8212; wide item + two -->
                            <div class="gal-grid-item gal-grid-item--wide" tabindex="0" role="button"
                                 aria-label="Open: IMAX auditorium" data-caption="IMAX Auditorium &#8212; Screen 1">
                                <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&amp;fit=crop&amp;w=900&amp;q=80"
                                     alt="IMAX auditorium interior" loading="lazy"/>
                            </div>
                            <div class="gal-grid-item" tabindex="0" role="button"
                                 aria-label="Open: Gold Circle lounge"
                                 data-caption="Gold Circle Lounge">
                                <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                     alt="VIP lounge" loading="lazy"/>
                            </div>

                            <!-- Row 2 &#8212; three equal -->
                            <div class="gal-grid-item" tabindex="0" role="button"
                                 aria-label="Open: champagne reception"
                                 data-caption="Pre-Screening Champagne Reception">
                                <img src="https://images.unsplash.com/photo-1578662996442-48f60103fc96?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                     alt="Champagne reception" loading="lazy"/>
                            </div>
                            <div class="gal-grid-item" tabindex="0" role="button"
                                 aria-label="Open: projection booth"
                                 data-caption="35mm Projection Booth">
                                <img src="https://images.unsplash.com/photo-1595769816263-9b910be24d5f?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                     alt="Projection booth" loading="lazy"/>
                            </div>
                            <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: premiere night"
                                 data-caption="UK Premiere &#8212; Neon Requiem">
                                <img src="https://images.unsplash.com/photo-1574267432553-4b4628081c31?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                     alt="Premiere night" loading="lazy"/>
                            </div>

                            <!-- Row 3 &#8212; one + wide -->
                            <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: entrance foyer"
                                 data-caption="Grand Entrance Foyer">
                                <img src="https://images.unsplash.com/photo-1542204165-65bf26472b9b?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                     alt="Entrance foyer" loading="lazy"/>
                            </div>
                            <div class="gal-grid-item gal-grid-item--wide" tabindex="0" role="button"
                                 aria-label="Open: director's table dinner"
                                 data-caption="Director's Table &#8212; Private Dining">
                                <img src="https://images.unsplash.com/photo-1635805737707-575885ab0820?auto=format&amp;fit=crop&amp;w=900&amp;q=80"
                                     alt="Director's table dinner" loading="lazy"/>
                            </div>

                            <!-- Row 4 &#8212; three equal -->
                            <div class="gal-grid-item" tabindex="0" role="button"
                                 aria-label="Open: bar and concessions"
                                 data-caption="Members' Bar">
                                <img src="https://images.unsplash.com/photo-1518676590629-3dcbd9c5a5c9?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                     alt="Members bar" loading="lazy"/>
                            </div>
                            <div class="gal-grid-item" tabindex="0" role="button"
                                 aria-label="Open: private screening room"
                                 data-caption="Private Screening Room &#8212; 40 Seats">
                                <img src="https://images.unsplash.com/photo-1626814026160-2237a95fc5a0?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                     alt="Private screening" loading="lazy"/>
                            </div>
                            <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: film festival"
                                 data-caption="Cannes Film Festival &#8212; Members' Trip">
                                <img src="https://images.unsplash.com/photo-1509281373149-e957c6296406?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                     alt="Film festival" loading="lazy"/>
                            </div>

                            <!-- Row 5 &#8212; wide + one -->
                            <div class="gal-grid-item gal-grid-item--wide" tabindex="0" role="button"
                                 aria-label="Open: auditorium seating"
                                 data-caption="Dolby Atmos Auditorium &#8212; Screen 3">
                                <img src="https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&amp;fit=crop&amp;w=900&amp;q=80"
                                     alt="Dolby auditorium" loading="lazy"/>
                            </div>
                            <div class="gal-grid-item" tabindex="0" role="button"
                                 aria-label="Open: curtains before screening"
                                 data-caption="Screen Curtains Before Curtain Up">
                                <img src="https://images.unsplash.com/photo-1534809027769-b00d750a6bac?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                     alt="Curtains" loading="lazy"/>
                            </div>

                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty" id="oe_structure_cineverse_gallery_bottom"/>
            </div>
        </t>
    </template>

    <record id="cineverse_gallery_page" model="website.page">
        <field name="name">Gallery</field>
        <field name="url">/gallery</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="cineverse_gallery_template"/>
        <field name="track">True</field>
        <field name="website_meta_title">Gallery | CineVerse</field>
        <field name="website_meta_description">Explore the CineVerse experience through our visual gallery of theater rooms and lounges.</field>
        <field name="website_meta_keywords">cinema gallery, luxury theater photos, movie theater images</field>
    </record>
</odoo>