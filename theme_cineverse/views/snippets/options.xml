<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Template: options.xml
        Purpose: Defines QWeb templates and snippets for the CineVerse theme.
    -->
    <template id="cineverse_snippet_options" inherit_id="website.snippet_options" name="CineVerse Snippet Options">
        <xpath expr="." position="inside">
            <div data-selector=".s_cineverse_hero, .s_cineverse_experience, .s_cineverse_movies_teaser, .s_cineverse_testimonials, .s_cineverse_page_hero, .s_cineverse_film_strip, .s_cineverse_upcoming_grid, .s_cineverse_showtimes_board, .s_cineverse_vip_upsell, .s_cineverse_vip_showcase, .s_cineverse_vip_benefits, .s_cineverse_vip_events, .s_cineverse_gallery_tape, .s_cineverse_gallery_grid, .s_cineverse_contact_form, .s_cineverse_transport">
                <we-colorpicker string="Background Color" data-select-class="bg-primary,bg-secondary,bg-dark,bg-light" data-css-property="background-color" data-color-prefix="bg-"/>
            </div>
        </xpath>
    </template>
</odoo>
