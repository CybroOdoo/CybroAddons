<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Template: s_cineverse_gallery_tape.xml
        Purpose: Defines QWeb templates and snippets for the CineVerse theme.
    -->
    <template id="s_cineverse_gallery_tape" name="Gallery Tape">
        <section class="s_cineverse_gallery_tape section" data-snippet="s_cineverse_gallery_tape" data-name="Gallery Tape" style="padding-top:clamp(44px,6vw,80px);">
      <div class="container">
        <header class="section__head reveal" style="text-align:left;margin-inline:0;">
          <p class="eyebrow">Spaces &amp; Moments</p>
          <h2 class="section__title" style="font-size:clamp(1.8rem,3.5vw,2.8rem);">Inside <em>The Rooms</em></h2>
        </header>
        <div class="gal-grid reveal">

          <!-- Row 1 &#8212; wide item + two -->
          <div class="gal-grid-item gal-grid-item--wide" tabindex="0" role="button" aria-label="Open: IMAX auditorium" data-caption="IMAX Auditorium &#8212; Screen 1">
            <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="IMAX auditorium interior" loading="lazy" />
          </div>
          <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: Gold Circle lounge" data-caption="Gold Circle Lounge">
            <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="VIP lounge" loading="lazy" />
          </div>

          <!-- Row 2 &#8212; three equal -->
          <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: champagne reception" data-caption="Pre-Screening Champagne Reception">
            <img src="https://images.unsplash.com/photo-1578662996442-48f60103fc96?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="Champagne reception" loading="lazy" />
          </div>
          <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: projection booth" data-caption="35mm Projection Booth">
            <img src="https://images.unsplash.com/photo-1595769816263-9b910be24d5f?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="Projection booth" loading="lazy" />
          </div>
          <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: premiere night" data-caption="UK Premiere &#8212; Neon Requiem">
            <img src="https://images.unsplash.com/photo-1574267432553-4b4628081c31?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="Premiere night" loading="lazy" />
          </div>

          <!-- Row 3 &#8212; one + wide -->
          <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: entrance foyer" data-caption="Grand Entrance Foyer">
            <img src="https://images.unsplash.com/photo-1542204165-65bf26472b9b?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="Entrance foyer" loading="lazy" />
          </div>
          <div class="gal-grid-item gal-grid-item--wide" tabindex="0" role="button" aria-label="Open: director's table dinner" data-caption="Director's Table &#8212; Private Dining">
            <img src="https://images.unsplash.com/photo-1635805737707-575885ab0820?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Director's table dinner" loading="lazy" />
          </div>

          <!-- Row 4 &#8212; three equal -->
          <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: bar and concessions" data-caption="Members' Bar">
            <img src="https://images.unsplash.com/photo-1518676590629-3dcbd9c5a5c9?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="Members bar" loading="lazy" />
          </div>
          <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: private screening room" data-caption="Private Screening Room &#8212; 40 Seats">
            <img src="https://images.unsplash.com/photo-1626814026160-2237a95fc5a0?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="Private screening" loading="lazy" />
          </div>
          <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: film festival" data-caption="Cannes Film Festival &#8212; Members' Trip">
            <img src="https://images.unsplash.com/photo-1509281373149-e957c6296406?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="Film festival" loading="lazy" />
          </div>

          <!-- Row 5 &#8212; wide + one -->
          <div class="gal-grid-item gal-grid-item--wide" tabindex="0" role="button" aria-label="Open: auditorium seating" data-caption="Dolby Atmos Auditorium &#8212; Screen 3">
            <img src="https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Dolby auditorium" loading="lazy" />
          </div>
          <div class="gal-grid-item" tabindex="0" role="button" aria-label="Open: curtains before screening" data-caption="Screen Curtains Before Curtain Up">
            <img src="https://images.unsplash.com/photo-1534809027769-b00d750a6bac?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="Curtains" loading="lazy" />
          </div>

        </div>
      </div>
    </section>
    </template>
</odoo>