<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Template: s_cineverse_transport.xml
        Purpose: Defines QWeb templates and snippets for the CineVerse theme.
    -->
    <template id="s_cineverse_transport" name="Transport">
        <section class="s_cineverse_transport" data-snippet="s_cineverse_transport" data-name="Transport" style="background:var(--ground-1);padding:clamp(44px,6vw,72px) 0;">
              <div class="container">
                <header class="section__head reveal" style="text-align:left;margin-inline:0;margin-bottom:clamp(28px,4vw,44px);">
                  <p class="eyebrow">Getting Here</p>
                  <h2 style="font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.4rem);">By Any <em>Route</em></h2>
                </header>
                <div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2px;">
                  <div style="background:var(--ground);padding:28px 24px;">
                    <span class="mono" style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">⊝</span>
                    <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">Underground</h4>
                    <p style="color:var(--text-soft);font-size:.9rem;">Bond Street (Central, Jubilee) &#8212; 3 min walk. Green Park (Jubilee, Victoria, Piccadilly) &#8212; 6 min walk.</p>
                  </div>
                  <div style="background:var(--ground);padding:28px 24px;">
                    <span class="mono" style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">⊟</span>
                    <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">Bus</h4>
                    <p style="color:var(--text-soft);font-size:.9rem;">Routes 2, 10, 16, 74, 137 stop on nearby Oxford Street and Piccadilly.</p>
                  </div>
                  <div style="background:var(--ground);padding:28px 24px;">
                    <span class="mono" style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">⊞</span>
                    <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">By Car</h4>
                    <p style="color:var(--text-soft);font-size:.9rem;">NCP car parks on Grosvenor Square and Park Lane. Gold Circle members receive a valet parking allocation.</p>
                  </div>
                  <div style="background:var(--ground);padding:28px 24px;">
                    <span class="mono" style="font-size:1.5rem;display:block;margin-bottom:12px;color:var(--gold);">⊛</span>
                    <h4 style="font-family:var(--font-display);font-size:1.1rem;margin-bottom:8px;">Concierge Transfer</h4>
                    <p style="color:var(--text-soft);font-size:.9rem;">Platinum Reserve members can arrange a chauffeur transfer through our dedicated concierge line.</p>
                  </div>
                </div>
              </div>
        </section>
    </template>
</odoo>