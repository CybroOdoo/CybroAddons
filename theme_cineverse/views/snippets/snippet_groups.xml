<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Template: snippet_groups.xml
        Purpose: Defines QWeb templates and snippets for the CineVerse theme.
    -->
    <template id="cineverse_snippet_groups" inherit_id="website.snippets" name="CineVerse Snippets">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_cineverse.s_cineverse_hero" string="Hero (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_experience" string="Experience (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_movies_teaser" string="Movies Teaser (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_testimonials" string="Testimonials (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_page_hero" string="Page Hero (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_film_strip" string="Film Strip (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_upcoming_grid" string="Upcoming Grid (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_showtimes_board" string="Showtimes (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_vip_showcase" string="VIP Showcase (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_vip_benefits" string="VIP Benefits (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_vip_events" string="VIP Events (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_gallery_tape" string="Gallery Tape (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_contact_form" string="Contact Form (CineVerse)"/>
            <t t-snippet="theme_cineverse.s_cineverse_transport" string="Transport (CineVerse)"/>
        </xpath>
    </template>
</odoo>