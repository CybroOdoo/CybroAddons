<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Template: snippet_groups.xml
        Purpose: Defines QWeb templates and snippets for the CineVerse theme.
    -->
    <template id="cineverse_snippet_groups" inherit_id="website.snippets" name="CineVerse Snippets">
        <!-- Add a new snippet category for CineVerse Theme -->
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="cineverse_theme" t-snippet="website.s_snippet_group" string="CineVerse Theme"/>
        </xpath>

        <!-- Append snippets to the structure and assign them to the new category -->
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_cineverse.s_cineverse_hero" string="Hero" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_experience" string="Experience" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_movies_teaser" string="Movies Teaser" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_testimonials" string="Testimonials" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_page_hero" string="Page Hero" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_film_strip" string="Film Strip" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_upcoming_grid" string="Upcoming Grid" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_showtimes_board" string="Showtimes" group="cineverse_theme"/>

            <t t-snippet="theme_cineverse.s_cineverse_vip_showcase" string="VIP Showcase" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_vip_benefits" string="VIP Benefits" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_vip_events" string="VIP Events" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_gallery_tape" string="Gallery Tape" group="cineverse_theme"/>

            <t t-snippet="theme_cineverse.s_cineverse_contact_form" string="Contact Form" group="cineverse_theme"/>
            <t t-snippet="theme_cineverse.s_cineverse_transport" string="Transport" group="cineverse_theme"/>
        </xpath>
    </template>
</odoo>