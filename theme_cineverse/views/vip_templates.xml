<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cineverse_vip_template" name="VIP page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Page Hero -->
                <section class="s_cineverse_page_hero page-hero" data-snippet="theme_cineverse.s_cineverse_page_hero" data-name="Page Hero">
                    <p class="page-hero__eyebrow eyebrow">The Gold Circle</p>
                    <h1 class="page-hero__title">Membership <em>Beyond</em> Film</h1>
                    <p class="page-hero__lead">Private lounges, premiere invitations, and bespoke cinema experiences.</p>
                </section>

                <!-- VIP Showcase -->
                <section class="s_cineverse_vip_showcase section" data-snippet="theme_cineverse.s_cineverse_vip_showcase" data-name="VIP Showcase" style="padding-top: clamp(44px,6vw,80px);">
                    <div class="container">
                        <div class="vip-showcase reveal">
                            <div class="ticket" aria-label="Sample Gold Circle membership ticket">
                                <div class="ticket__stub">
                                    <span class="mono ticket__stub-label">GOLD CIRCLE</span>
                                    <div class="ticket__stub-dots" aria-hidden="true"/>
                                    <span class="mono" style="writing-mode:vertical-rl;font-size:.68rem;color:var(--text-soft);letter-spacing:.1em;">CV</span>
                                </div>
                                <div class="ticket__tear" aria-hidden="true">
                                    <div class="ticket__notch ticket__notch--t" aria-hidden="true"/>
                                    <div class="ticket__notch ticket__notch--b" aria-hidden="true"/>
                                </div>
                                <div class="ticket__main">
                                    <div class="ticket__head">
                                        <span class="mono ticket__cinema">CINEVERSE</span>
                                        <span class="mono ticket__type" style="color:var(--gold);">GOLD CIRCLE</span>
                                    </div>
                                    <h2 class="ticket__title">Your Name<br /><em>Here</em></h2>
                                    <div class="ticket__info">
                                        <div><span class="mono" style="font-size:.65rem;color:var(--text-mute);display:block;">TIER</span><span class="mono">Platinum Reserve</span></div>
                                        <div><span class="mono" style="font-size:.65rem;color:var(--text-mute);display:block;">MEMBER SINCE</span><span class="mono">2024</span></div>
                                        <div><span class="mono" style="font-size:.65rem;color:var(--text-mute);display:block;">GUEST PASSES</span><span class="mono">4 / Year</span></div>
                                    </div>
                                    <div class="ticket__bar" aria-hidden="true"/>
                                </div>
                            </div>
                            <div>
                                <p class="eyebrow">Why join?</p>
                                <h2 style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3.2rem);line-height:1.1;margin: 14px 0 22px;">A different <em>kind</em> of membership</h2>
                                <p style="color:var(--text-soft);max-width:44ch;line-height:1.75;">Gold Circle is not a loyalty card. It is a standing invitation &#8212; to premieres before they open, to lounges that don't appear on our website, and to screenings we don't advertise.</p>
                                <p style="color:var(--text-soft);max-width:44ch;line-height:1.75;margin-top:14px;">Three tiers. One promise: you will never see cinema the same way again.</p>
                                <a href="/contactus" class="btn btn--gold btn--ripple" style="margin-top:28px;display:inline-block;">Apply for membership</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- VIP Benefits / Tiers -->
                <section class="s_cineverse_vip_benefits section" data-snippet="theme_cineverse.s_cineverse_vip_benefits" data-name="VIP Benefits" style="background:var(--ground-1);padding:clamp(56px,8vw,100px) 0;">
                    <div class="container">
                        <header class="section__head reveal">
                            <p class="eyebrow">Membership Tiers</p>
                            <h2 class="section__title">Choose Your <em>Circle</em></h2>
                        </header>
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2px;margin-top:clamp(32px,4vw,56px);">
                            <div class="reveal" style="background:var(--ground);padding:38px 32px;border-top:2px solid var(--gold-dim);display:flex;flex-direction:column;">
                                <p class="mono eyebrow" style="font-size:.64rem;">Tier 01</p>
                                <h3 style="font-family:var(--font-display);font-size:1.8rem;margin:12px 0;">Silver<br /><em style="color:var(--text-soft);">Screen</em></h3>
                                <p style="font-family:var(--font-display);font-size:2.4rem;font-weight:700;color:var(--text);margin-bottom:8px;">&#163;18<span style="font-size:1rem;font-weight:400;color:var(--text-soft);"> /mo</span></p>
                                <ul style="margin-top:20px;display:flex;flex-direction:column;gap:12px;flex:1;">
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">Unlimited standard screenings</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">10% concessions discount</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">Monthly members newsletter</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">Priority booking (48h advance)</span></li>
                                </ul>
                                <a href="/contactus" class="btn btn--outline btn--sm btn--ripple" style="margin-top:32px;display:inline-block;align-self:flex-start;">Join Silver</a>
                            </div>
                            <div class="reveal" style="background:var(--ground);padding:38px 32px;border-top:2px solid var(--gold);display:flex;flex-direction:column;">
                                <p class="mono eyebrow" style="font-size:.64rem;color:var(--gold);">Tier 02 · Most Popular</p>
                                <h3 style="font-family:var(--font-display);font-size:1.8rem;margin:12px 0;">Gold<br /><em style="color:var(--gold);">Circle</em></h3>
                                <p style="font-family:var(--font-display);font-size:2.4rem;font-weight:700;color:var(--gold);margin-bottom:8px;">&#163;36<span style="font-size:1rem;font-weight:400;color:var(--text-soft);"> /mo</span></p>
                                <ul style="margin-top:20px;display:flex;flex-direction:column;gap:12px;flex:1;">
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">All Silver benefits</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">VIP lounge access</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">2 guest passes per month</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">Premiere invitations</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">Complimentary champagne on arrival</span></li>
                                </ul>
                                <a href="/contactus" class="btn btn--gold btn--sm btn--ripple" style="margin-top:32px;display:inline-block;align-self:flex-start;">Join Gold Circle</a>
                            </div>
                            <div class="reveal" style="background:var(--ground);padding:38px 32px;border-top:2px solid var(--beam);display:flex;flex-direction:column;">
                                <p class="mono eyebrow" style="font-size:.64rem;">Tier 03</p>
                                <h3 style="font-family:var(--font-display);font-size:1.8rem;margin:12px 0;">Platinum<br /><em style="color:var(--beam);">Reserve</em></h3>
                                <p style="font-family:var(--font-display);font-size:2.4rem;font-weight:700;color:var(--text);margin-bottom:8px;">&#163;72<span style="font-size:1rem;font-weight:400;color:var(--text-soft);"> /mo</span></p>
                                <ul style="margin-top:20px;display:flex;flex-direction:column;gap:12px;flex:1;">
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">All Gold benefits</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">Reserved private booth (any screening)</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">4 guest passes per month</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">Private screening allocation</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">Dedicated concierge &amp; dining service</span></li>
                                    <li style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--gold);flex-shrink:0;">&#8212;</span><span style="color:var(--text-soft);font-size:.94rem;">Film festival travel packages</span></li>
                                </ul>
                                <a href="/contactus" class="btn btn--outline btn--sm btn--ripple" style="margin-top:32px;display:inline-block;align-self:flex-start;">Enquire</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- VIP Events -->
                <section class="s_cineverse_vip_events section" data-snippet="theme_cineverse.s_cineverse_vip_events" data-name="VIP Events">
                    <div class="container">
                        <header class="section__head reveal">
                            <p class="eyebrow">What You Get</p>
                            <h2 class="section__title">Every <em>Detail</em> Considered</h2>
                            <p class="section__lead">From the moment you arrive to the last frame, everything is arranged.</p>
                        </header>
                        <div class="benefits-grid">
                            <div class="benefit-card reveal">
                                <span class="mono benefit-card__num">01</span>
                                <h4 class="benefit-card__title">Premier Lounge</h4>
                                <p class="benefit-card__body">Access to our private bar and dining room, open two hours before and after every performance. Curated seasonal menus by our resident chef.</p>
                            </div>
                            <div class="benefit-card reveal">
                                <span class="mono benefit-card__num">02</span>
                                <h4 class="benefit-card__title">Priority Booking</h4>
                                <p class="benefit-card__body">Seats go live for members 72 hours before the general public. Your preferred seats can be saved to your profile for automatic hold.</p>
                            </div>
                            <div class="benefit-card reveal">
                                <span class="mono benefit-card__num">03</span>
                                <h4 class="benefit-card__title">Premiere Invitations</h4>
                                <p class="benefit-card__body">Gold Circle members receive invitations to UK premieres and press screenings. Selected events include a reception with the filmmakers.</p>
                            </div>
                            <div class="benefit-card reveal">
                                <span class="mono benefit-card__num">04</span>
                                <h4 class="benefit-card__title">Private Screenings</h4>
                                <p class="benefit-card__body">Reserve our boutique 40-seat auditorium for personal occasions. Film selection, catering, and staffing included in the arrangement.</p>
                            </div>
                            <div class="benefit-card reveal">
                                <span class="mono benefit-card__num">05</span>
                                <h4 class="benefit-card__title">Film Festival Access</h4>
                                <p class="benefit-card__body">Curated festival packages: Cannes, Venice, BFI London. Hotel, accreditation, and event attendance arranged by our concierge.</p>
                            </div>
                            <div class="benefit-card reveal">
                                <span class="mono benefit-card__num">06</span>
                                <h4 class="benefit-card__title">Director's Table</h4>
                                <p class="benefit-card__body">Quarterly intimate dinners with directors, cinematographers, and producers &#8212; before or after a private screening of their work.</p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="cineverse_vip_page" model="website.page">
        <field name="name">VIP</field>
        <field name="url">/vip</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="cineverse_vip_template"/>
        <field name="track">True</field>
        <field name="website_meta_title">VIP Membership | CineVerse</field>
        <field name="website_meta_description">Join the Gold Circle and experience cinema with private lounges, dining, and priority booking.</field>
        <field name="website_meta_keywords">VIP cinema, gold circle, cinema membership, luxury theater</field>
    </record>
</odoo>