<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        theme.website.menu records are TEMPLATES, not live menu entries.
        Odoo automatically copies these into real website.menu records
        when this theme is applied to a website, and automatically
        deletes those copies when the website switches to a different
        theme. Do not add website_id or parent_id pointing at
        website.main_menu here.

        IMPORTANT: Do not redeclare Home, Shop, Blog, or Contact us here
        - those are already created automatically by the base website,
        website_sale, and website_blog modules. Redeclaring them causes
        duplicates. Only list menu items that are unique to this theme.
    -->

    <record id="theme_converza_menu_services" model="theme.website.menu">
        <field name="name">Services</field>
        <field name="url">/services</field>
        <field name="sequence">30</field>
    </record>

    <record id="theme_converza_menu_result" model="theme.website.menu">
        <field name="name">Result</field>
        <field name="url">/result</field>
        <field name="sequence">40</field>
    </record>

    <record id="theme_converza_menu_case_studies" model="theme.website.menu">
        <field name="name">Case Studies</field>
        <field name="url">/case-studies</field>
        <field name="sequence">50</field>
    </record>

    <record id="theme_converza_menu_pricing" model="theme.website.menu">
        <field name="name">Pricing</field>
        <field name="url">/pricing</field>
        <field name="sequence">70</field>
    </record>
</odoo>