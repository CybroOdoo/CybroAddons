<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- This XML record defines a custom QWeb view for the "Feature" section of the website -->
    <record id="case_study" model="ir.ui.view">
        <field name="name">Case Study</field>
        <field name="type">qweb</field>
        <field name="key">theme_converza.case_study</field>
        <field name="arch" type="xml">
            <t name="Case study" t-name="theme_converza.case_study">
                <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="s_case_studies_hero py-5">
                        <div class="container">

                            <!-- Breadcrumb -->
                            <div class="text-center mb-4">
                                <span class="hero-breadcrumb">
                                    <a href="/">Home</a>
                                    <span class="mx-2">/</span>
                                    <span>Case Studies</span>
                                </span>
                            </div>

                            <!-- Title -->
                            <div class="row justify-content-center">
                                <div class="col-lg-8 text-center">
                                    <h1 class="hero-title">
                                        Real Companies,<br/>
                                        Real Growth
                                    </h1>

                                    <p class="hero-description mt-4">
                                        Deep-dives into the strategies, campaigns, and systems we built
                                        to help companies across industries achieve breakthrough results.
                                    </p>
                                </div>
                            </div>

                            <!-- Statistics -->
                            <div class="row text-center mt-5 g-4">

                                <div class="col-lg-3 col-md-6">
                                    <div class="hero-stat">
                                        <h2>
                                            200<span class="highlight">+</span>
                                        </h2>
                                        <p>Clients across 12 industries</p>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <div class="hero-stat">
                                        <h2>
                                            $50M<span class="highlight">+</span>
                                        </h2>
                                        <p>In paid media managed</p>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <div class="hero-stat">
                                        <h2>
                                            312<span class="highlight">%</span>
                                        </h2>
                                        <p>Average pipeline growth</p>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <div class="hero-stat">
                                        <h2>
                                            3<span class="highlight">yrs</span>
                                        </h2>
                                        <p>Average client tenure</p>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </section>
                    <section class="s_text_block case-studies-section" data-snippet="s_text_block" data-name="Text Block">
                        <div class="container">

                            <div class="case-header">
                                <span class="case-badge" style="display: inline-block !important; background: #f0ebff !important; color: #8b5cf6 !important; font-size: 13px !important; font-weight: 700 !important; padding: 6px 18px !important; border-radius: 30px !important; letter-spacing: 1px !important;">CASE STUDIES</span>

                                <h2>Stories behind the numbers</h2>

                                <p>
                                    Each case study shows the full picture the challenge, the strategy, the execution, and the measurable outcome.

                                </p>
                            </div>
                            <section class="s_case_filter py-4" id="b2b">
                                <div class="container">
                                    <div class="d-flex justify-content-center flex-wrap gap-3">

                                        <a href="#" class="case-filter-btn active">
                                            All Industries
                                        </a>

                                        <a href="#b2bc" class="case-filter-btn">
                                            B2B SaaS
                                        </a>

                                        <a href="#ecommerce" class="case-filter-btn">
                                            eCommerce
                                        </a>

                                        <a href="#healthcare" class="case-filter-btn">
                                            Healthcare
                                        </a>

                                        <a href="#enterprise" class="case-filter-btn">
                                            Enterprise
                                        </a>

                                        <a href="#startups" class="case-filter-btn">
                                            Startups
                                        </a>

                                    </div>
                                </div>
                            </section>

                            <div class="case-grid">

                                <!-- Card 1 -->
                                <div class="case-card" id="b2bc">
                                    <img src="/theme_converza/static/src/img/case-b2b-saas.jpg"
                                         alt="B2B SaaS"/>

                                    <div class="case-content">

                                        <span class="industry">B2B SAAS</span>

                                        <h3>312% pipeline growth in 6 months</h3>

                                        <p>
                                            Rebuilt messaging, launched ABM paid media,
                                            and created a lead-nurture system for enterprise buyers.
                                        </p>

                                        <div class="stats-row">
                                            <div>
                                                <h4>234%</h4>
                                                <span>Pipeline</span>
                                            </div>

                                            <div>
                                                <h4>30%</h4>
                                                <span>Shorter Sales Cycle</span>
                                            </div>

                                            <div>
                                                <h4>4.3x</h4>
                                                <span>ROAS</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- Card 2 -->
                                <div class="case-card" id="ecommerce">
                                    <img src="/theme_converza/static/src/img/case-ecommerce.jpg"
                                         alt="Ecommerce"/>

                                    <div class="case-content">

                                        <span class="industry">ECOMMERCE</span>

                                        <h3>58% higher repeat purchase rate</h3>

                                        <p>
                                            Designed segmented email retention flows and
                                            loyalty campaigns that increased repeat sales.
                                        </p>

                                        <div class="stats-row">
                                            <div>
                                                <h4>43%</h4>
                                                <span>Repeat Sales</span>
                                            </div>

                                            <div>
                                                <h4>2.4x</h4>
                                                <span>Email ROI</span>
                                            </div>

                                            <div>
                                                <h4>33%</h4>
                                                <span>Lower CAC</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- Card 3 -->
                                <div class="case-card" id="healthcare">
                                    <img src="/theme_converza/static/src/img/case-healthcare.jpg"
                                         alt="Healthcare"/>

                                    <div class="case-content">

                                        <span class="industry">HEALTHCARE</span>

                                        <h3>420% organic traffic in 8 months</h3>

                                        <p>
                                            Technical SEO overhaul and content strategy
                                            that ranked for hundreds of high-intent keywords.
                                        </p>

                                        <div class="stats-row">
                                            <div>
                                                <h4>315%</h4>
                                                <span>Traffic Growth</span>
                                            </div>

                                            <div>
                                                <h4>210+</h4>
                                                <span>Keywords Ranked</span>
                                            </div>

                                            <div>
                                                <h4>53%</h4>
                                                <span>More Leads</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- Card 4 -->
                                <div class="case-card" id="enterprise">
                                    <img src="/theme_converza/static/src/img/case-ecommerce.jpg"
                                         alt="Enterprise"/>

                                    <div class="case-content">

                                        <span class="industry">ENTERPRISE</span>

                                        <h3>$2.1M new revenue from account-based marketing</h3>

                                        <p>
                                            Targeted 50 high-value accounts with personalized
                                            content, leading to significant enterprise deal closures.
                                        </p>

                                        <div class="stats-row">
                                            <div>
                                                <h4>$2.1M</h4>
                                                <span>New Revenue</span>
                                            </div>

                                            <div>
                                                <h4>45%</h4>
                                                <span>Win Rate</span>
                                            </div>

                                            <div>
                                                <h4>2x</h4>
                                                <span>Deal Size</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- Card 5 -->
                                <div class="case-card" id="startups">
                                    <img src="/theme_converza/static/src/img/case-b2b-saas.jpg"
                                         alt="Startups"/>

                                    <div class="case-content">

                                        <span class="industry">STARTUPS</span>

                                        <h3>Scaled from Seed to Series A with agile paid media</h3>

                                        <p>
                                            Optimized paid acquisition channels and established
                                            a scalable growth engine for a fast-growing startup.
                                        </p>

                                        <div class="stats-row">
                                            <div>
                                                <h4>150%</h4>
                                                <span>User Growth</span>
                                            </div>

                                            <div>
                                                <h4>40%</h4>
                                                <span>Lower CPA</span>
                                            </div>

                                            <div>
                                                <h4>Series A</h4>
                                                <span>Funding</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- Card 6 -->
                                <div class="case-card" id="fintech">
                                    <img src="/theme_converza/static/src/img/case-healthcare.jpg"
                                         alt="Fintech"/>

                                    <div class="case-content">

                                        <span class="industry">FINTECH</span>

                                        <h3>Decreased customer acquisition cost by 62%</h3>

                                        <p>
                                            Revamped landing page experiences and refined
                                            audience targeting for a leading financial app.
                                        </p>

                                        <div class="stats-row">
                                            <div>
                                                <h4>62%</h4>
                                                <span>Lower CAC</span>
                                            </div>

                                            <div>
                                                <h4>3.5x</h4>
                                                <span>Conversion Rate</span>
                                            </div>

                                            <div>
                                                <h4>1M+</h4>
                                                <span>App Installs</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>

                        </div>
                    </section>
                        <section class="s_featured_case py-5">
                            <div class="container">

                                <!-- Heading -->
                                <div class="text-center mb-5">

                                    <span class="case-badge">
                                        FEATURED CASE STUDY
                                    </span>

                                    <h2 class="case-title mt-4">
                                        Apex Cloud 312% pipeline growth
                                    </h2>

                                    <p class="case-subtitle">
                                        A deep-dive into how we rebuilt a B2B SaaS company's
                                        entire go-to-market strategy and turned a stagnant
                                        pipeline into a predictable growth engine.
                                    </p>

                                </div>

                                <!-- Grid -->
                                <div class="bento">
                                    <div class="bc dark span2 rv d1">
                                        <div class="bc-icon"><iconify-icon icon="lucide:target"></iconify-icon></div>
                                        <h3>The challenge</h3>
                                        <p>Apex Cloud had a strong product but a weak marketing motion. Messaging was generic, paid campaigns
                                            were burning budget on unqualified traffic, and the sales team had no nurture system to work
                                            with. Pipeline had been flat for three quarters.</p>
                                        <ul class="feature-list" style="margin-top:16px">
                                            <li>Positioning was too broad appealing to everyone and converting no one</li>
                                            <li>Google Ads were generating clicks but only 1.2% to MQL conversion</li>
                                            <li>No email nurture sequences leads went cold after initial contact</li>
                                            <li>No content strategy zero blog presence, no search visibility</li>
                                        </ul>
                                    </div>
                                    <div class="bc rv d2">
                                        <div class="bc-icon"><iconify-icon icon="lucide:map"></iconify-icon></div>
                                        <h3>The strategy</h3>
                                        <p>We ran a 2-week discovery sprint, rebuilt the ICP and messaging framework, then launched a
                                            full-funnel ABM motion targeting enterprise IT buyers.</p>
                                    </div>
                                    <div class="bc teal rv d3">
                                        <div class="big-stat">6<span>wks</span></div>
                                        <div class="stat-sub">From kickoff to fully live campaigns</div>
                                    </div>
                                    <div class="bc blue rv d1">
                                        <div class="big-stat">312<span>%</span></div>
                                        <div class="stat-sub">Pipeline growth within 6 months</div>
                                    </div>
                                    <div class="bc rv d2">
                                        <div class="bc-icon"><iconify-icon icon="lucide:settings-2"></iconify-icon></div>
                                        <h3>The execution</h3>
                                        <p>Rebuilt Google Ads with SKAG structure, launched LinkedIn ABM to 3 target segments, wrote 12
                                            nurture emails, and published 8 SEO-targeted blog posts in the first 60 days.</p>
                                    </div>
                                    <div class="bc grad span2 rv d3">
                                        <div class="bc-icon"><iconify-icon icon="lucide:trending-up"></iconify-icon></div>
                                        <h3>The results — 6 months in</h3>
                                        <p>Pipeline grew 312%, ROAS hit 5.8x, and the sales team reported a 40% shorter close cycle due
                                            to warmer, better educated inbound leads coming through the new content and nurture system.</p>
                                        <div class="mini-bar-wrap">
                                            <div class="mini-bar-row">
                                                <div class="mini-bar-label"><span>Pipeline Growth</span><span>312%</span></div>
                                                <div class="mini-bar-track">
                                                    <div class="mini-bar-fill mf-blue" style="width:95%" data-width="95"></div>
                                                </div>
                                            </div>
                                            <div class="mini-bar-row">
                                                <div class="mini-bar-label"><span>Paid Media ROAS</span><span>5.8x</span></div>
                                                <div class="mini-bar-track">
                                                    <div class="mini-bar-fill mf-teal" style="width:88%" data-width="88"></div>
                                                </div>
                                            </div>
                                            <div class="mini-bar-row">
                                                <div class="mini-bar-label"><span>Sales Cycle Reduction</span><span>40%</span></div>
                                                <div class="mini-bar-track">
                                                    <div class="mini-bar-fill mf-purple" style="width:72%" data-width="72"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </section>
                    <section class="s_case_statistics py-5">
                        <div class="container">

                            <div class="text-center mb-5">

                                <span class="stats-badge">
                                    ACROSS ALL CLIENTS
                                </span>

                                <h2 class="stats-title mt-4">
                                    Consistent performance at scale
                                </h2>

                                <p class="stats-subtitle">
                                    These aren't cherry-picked outliers they represent the median
                                    results across our active client base.
                                </p>

                            </div>

                            <div class="row justify-content-center g-4">

                                <div class="col-lg-3 col-md-6">
                                    <div class="stats-card">
                                        <h3>312%</h3>
                                        <p>Average pipeline growth</p>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <div class="stats-card">
                                        <h3>6.4x</h3>
                                        <p>Average ROAS, paid media</p>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <div class="stats-card">
                                        <h3>62%</h3>
                                        <p>Reduction in cost per acquisition</p>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <div class="stats-card">
                                        <h3>200+</h3>
                                        <p>Active client campaigns</p>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </section>
                    <section class="s_case_testimonials py-5">
                        <div class="container">

                            <div class="text-center mb-5">
                                <span class="section-badge badge-teal">
                                    CLIENT VOICES
                                </span>

                                <h2 class="section-title">
                                    What our clients say
                                </h2>
                            </div>

                            <div class="row g-4">

                                <!-- Card -->
                                <div class="col-lg-4">
                                    <div class="testimonial-card">

                                        <div class="stars">
                                            ★★★★★
                                        </div>

                                        <p class="testimonial-text">
                                            "Converza gave us the first growth plan that our sales,
                                            product, and leadership teams could all rally around.
                                            Pipeline doubled in a quarter."
                                        </p>

                                        <div class="testimonial-user">

                                            <div class="avatar bg-info">
                                                AV
                                            </div>

                                            <div>
                                                <h5>Amelia Voss</h5>
                                                <span>CMO, Apex Cloud</span>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                                <!-- Highlight Card -->
                                <div class="col-lg-4">
                                    <div class="testimonial-card active">

                                        <div class="stars">
                                            ★★★★★
                                        </div>

                                        <p class="testimonial-text">
                                            "We'd tried two other agencies. Neither came close to
                                            the systematic, data-led approach Converza brings.
                                            The results speak for themselves."
                                        </p>

                                        <div class="testimonial-user">

                                            <div class="avatar bg-primary">
                                                JW
                                            </div>

                                            <div>
                                                <h5>James Whitfield</h5>
                                                <span>VP Marketing, Stratum Ops</span>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                                <!-- Card -->
                                <div class="col-lg-4">
                                    <div class="testimonial-card">

                                        <div class="stars">
                                            ★★★★★
                                        </div>

                                        <p class="testimonial-text">
                                            "Within two quarters our acquisition cost dropped 62%
                                            and our brand finally felt as premium as the product.
                                            Remarkable transformation."
                                        </p>

                                        <div class="testimonial-user">

                                            <div class="avatar bg-success">
                                                MZ
                                            </div>

                                            <div>
                                                <h5>Mei Zhang</h5>
                                                <span>CEO, Novum Studio</span>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                            </div>

                        </div>
                    </section>

                    <!-- CTA -->
                    <section class="s_case_cta">

                        <div class="container">

                            <div class="text-center">

                                <span class="section-badge badge-dark">
                                    YOUR TURN
                                </span>

                                <h2 class="cta-title">
                                    Ready to become our <br/>
                                    next case study?
                                </h2>

                                <p class="cta-description">
                                    Tell us about your business. We'll map the exact strategy
                                    that gets you results like these.
                                </p>

                                <div class="mt-5 d-flex justify-content-center flex-wrap gap-3">

                                    <a href="/contactus"
                                       class="btn cta-btn-primary d-flex align-items-center justify-content-center gap-2">
                                        <iconify-icon icon="lucide:arrow-right" width="20"></iconify-icon> Get Free Strategy Audit
                                    </a>

                                    <a href="/pricing"
                                       class="btn btn-ghost-white">
                                        View Pricing
                                    </a>

                                </div>

                            </div>

                        </div>

                    </section>



                </div>
            </t>
        </t>
        </field>
    </record>
    <record id="case_study_page" model="website.page">
        <field name="is_published">True</field>
        <field name="url">/case-studies</field>
        <field name="view_id" ref="case_study"/>
        <field name="track">True</field>
    </record>

</odoo>
