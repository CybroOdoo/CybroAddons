<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="dummy_cart_link" name="Dummy Cart Link"/>

        <template id="converza_header_layout"
                  inherit_id="website.layout"
                  name="Converza Header"
                  active="True">
            <xpath expr="//header" position="replace">
                <header class="cvz_header">
                    <div class="container-fluid cvz_header_inner">

                        <!-- LOGO -->
                        <a href="/" class="cvz_header_logo">

                            <div class="cvz_header_logo">
                                <img src="/theme_converza/static/description/images/logo.png" alt="Converza Logo" class="cvz_header_logo_image"/>
                            </div>
                        </a>

                        <!-- CENTER NAV (desktop) -->
                        <nav class="cvz_header_nav d-none d-lg-flex">
                            <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                <t t-if="submenu.is_visible">
                                    <a t-attf-class="cvz_nav_link #{submenu._is_active() and 'cvz_nav_active' or ''}"
                                       t-att-href="submenu._clean_url()">
                                        <span t-field="submenu.name"/>
                                    </a>
                                </t>
                            </t>
                        </nav>

                        <!-- RIGHT: CTAs + Cart + Auth + Mobile -->
                        <ul class="cvz_header_right list-unstyled mb-0">

                            <!-- CTA Buttons (desktop only) -->
                            <li class="cvz_header_ctas d-none d-lg-flex">
                                <a href="/contactus" class="cvz_btn_outline">Get Free Audit</a>
                                <a href="/contactus" class="cvz_btn_solid">Start Growing</a>
                            </li>

                            <!-- Cart -->
                            <t t-set="cart_link_template" t-value="'website_sale.header_cart_link' if request.env['ir.model.data']._xmlid_to_res_id('website_sale.header_cart_link') else 'theme_converza.dummy_cart_link'"/>
                            <t t-call="{{cart_link_template}}">
                                <t t-set="_icon" t-value="True"/>
                                <t t-set="_item_class" t-value="'nav-item'"/>
                            </t>

                            <!-- Sign In (desktop) -->
                            <t t-call="portal.placeholder_user_sign_in">
                                <t t-set="_item_class" t-value="'nav-item d-none d-lg-block ms-2'"/>
                                <t t-set="_link_class" t-value="'cvz_btn_outline'"/>
                            </t>
                            <t t-call="portal.user_dropdown">
                                <t t-set="_icon" t-value="true"/>
                                <t t-set="_item_class" t-value="'nav-item d-none d-lg-block'"/>
                            </t>

                            <!-- Mobile Hamburger + Offcanvas -->
                            <li class="d-block d-lg-none">
                            <t t-call="website.navbar">
                                <t t-set="_navbar_classes"
                                   t-valuef="o_header_mobile d-block d-lg-none px-0"/>
                                <t t-set="_navbar_expand_class" t-valuef="None"/>
                                <t t-set="_navbar_name" t-valuef="Mobile"/>

                                <div id="o_main_nav"
                                     t-att-id="None"
                                     class="o_main_nav d-flex align-items-center">

                                    <ul class="navbar-nav flex-row align-items-center mb-0">
                                        <li>
                                            <button class="cvz_hamburger_btn o_not_editable"
                                                    type="button"
                                                    data-bs-toggle="offcanvas"
                                                    data-bs-target="#cvz_mobile_menu"
                                                    aria-controls="cvz_mobile_menu"
                                                    aria-expanded="false"
                                                    aria-label="Toggle navigation">
                                                <span class="navbar-toggler-icon"/>
                                            </button>
                                        </li>
                                    </ul>

                                    <div class="offcanvas offcanvas-end o_navbar_mobile cvz_offcanvas"
                                         id="cvz_mobile_menu">
                                        <div class="offcanvas-header justify-content-between cvz_offcanvas_header o_not_editable">
                                            <a href="/" class="cvz_header_logo">
                                                <img src="/web/image/website.default_website-favicon"
                                                     alt="Converza"
                                                     style="height:32px; width:auto;"/>
                                                <span class="cvz_header_logo_name"
                                                      style="font-size:18px;">Converza</span>
                                            </a>
                                            <button type="button"
                                                    class="btn-close btn-close-white"
                                                    data-bs-dismiss="offcanvas"
                                                    aria-label="Close"/>
                                        </div>

                                        <div class="offcanvas-body d-flex flex-column justify-content-between">
                                            <ul class="navbar-nav cvz_mobile_nav">
                                                <t t-call="website.placeholder_header_search_box">
                                                    <t t-set="_classes" t-valuef="mb-3"/>
                                                    <t t-set="_input_classes"
                                                       t-valuef="rounded-start-pill text-bg-light ps-3"/>
                                                    <t t-set="_submit_classes"
                                                       t-valuef="rounded-end-pill pe-3"/>
                                                    <t t-set="limit" t-valuef="0"/>
                                                </t>
                                                <t t-call="website.navbar_nav">
                                                    <t t-set="_no_autohide_menu_mobile"
                                                       t-valuef="True"/>
                                                    <t t-set="is_mobile" t-value="True"/>
                                                    <t t-foreach="website.menu_id.child_id"
                                                       t-as="submenu">
                                                        <t t-call="website.submenu">
                                                            <t t-set="item_class"
                                                               t-valuef="nav-item"/>
                                                            <t t-set="link_class"
                                                               t-valuef="nav-link"/>
                                                            <t t-set="dropdown_toggler_classes"
                                                               t-valuef="d-flex justify-content-between align-items-center"/>
                                                            <t t-set="dropdown_menu_classes"
                                                               t-valuef="position-relative rounded-0 o_dropdown_without_offset"/>
                                                        </t>
                                                    </t>
                                                </t>
                                            </ul>

                                            <ul class="navbar-nav gap-2 mt-3 w-100">
                                                <li>
                                                    <a href="/free-audit"
                                                       class="cvz_btn_outline d-block text-center w-100">
                                                        Get Free Audit
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="/contact"
                                                       class="cvz_btn_solid d-block text-center w-100">
                                                        Start Growing
                                                    </a>
                                                </li>
                                                <t t-call="portal.placeholder_user_sign_in">
                                                    <t t-set="_link_class"
                                                       t-valuef="btn btn-outline-secondary w-100 mt-1"/>
                                                </t>
                                                <t t-call="portal.user_dropdown">
                                                    <t t-set="_icon" t-value="true"/>
                                                    <t t-set="_user_name" t-value="true"/>
                                                    <t t-set="_link_class"
                                                       t-valuef="btn-outline-secondary d-flex align-items-center border-0 px-2"/>
                                                    <t t-set="_item_class"
                                                       t-valuef="dropdown dropup"/>
                                                    <t t-set="_dropdown_menu_class"
                                                       t-valuef="w-100"/>
                                                </t>
                                            </ul>
                                        </div>

                                    </div>
                                </div>
                            </t>
                            </li>

                        </ul>
                    </div>

                </header>
            </xpath>
        </template>

    </data>
</odoo>