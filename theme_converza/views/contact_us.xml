<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- This XML template customizes the appearance of the Contact Us page in the website -->
    <template id="converza_contact_us" name="Converza Contact Us"
              inherit_id="website.contactus">

        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- HEADER -->
                <div id="header-target"></div>

                <div id="oe_structure_contact_us_custom">
                    <!-- PAGE HERO -->
                    <section class="s_text_block page-hero sec-dark" data-snippet="s_text_block" data-name="Text Block">
                        <div class="wrap">
                            <nav class="breadcrumb show">
                                <a href="./index.html">Home</a>
                                <span class="breadcrumb-sep">›</span>
                                <span>Contact</span>
                            </nav>
                            <div class="page-hero-inner rv show">
                                <h1>Let's Build Your<br /><span class="grad-text">Growth Plan</span></h1>
                                <p class="hero-sub">Tell us about your business and goals. We'll put together a custom strategy and
                                    free audit  no obligation, no fluff.</p>
                                <div class="page-hero-stats">
                                    <div class="ph-stat">
                                        <span class="ph-stat-num" data-count="48" data-suffix="h">0h</span>
                                        <span class="ph-stat-label">Response Time</span>
                                    </div>
                                    <div class="ph-stat">
                                        <span class="ph-stat-num" data-count="200" data-suffix="+">0+</span>
                                        <span class="ph-stat-label">Clients Served</span>
                                    </div>
                                    <div class="ph-stat">
                                        <span class="ph-stat-num" data-count="98" data-suffix="%">0%</span>
                                        <span class="ph-stat-label">Satisfaction Rate</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_text_block sec-white" data-snippet="s_text_block" data-name="Text Block">
                        <div class="wrap">
                            <div class="contact-card-grid rv">
                                <div class="contact-card">
                                    <div class="contact-card-icon" style="--ic:#1a5fb4">
                                        <iconify-icon icon="lucide:mail" width="28"></iconify-icon>
                                    </div>
                                    <h3>Email Us</h3>
                                    <p>Drop us a line any time we read every message.</p>
                                    <a class="cc-val" href="mailto:hello@converza.agency">hello@converza.agency</a>
                                    <a class="cc-val" href="mailto:support@converza.agency">support@converza.agency</a>
                                </div>
                                <div class="contact-card">
                                    <div class="contact-card-icon" style="--ic:#01b0a8">
                                        <iconify-icon icon="lucide:phone" width="28"></iconify-icon>
                                    </div>
                                    <h3>Call Us</h3>
                                    <p>Speak directly with a strategy consultant.</p>
                                    <a class="cc-val" href="tel:+18005551234">+1 (800) 555-1234</a>
                                    <span class="cc-val">Mon–Fri, 9am–6pm EST</span>
                                </div>
                                <div class="contact-card">
                                    <div class="contact-card-icon" style="--ic:#8b5cf6">
                                        <iconify-icon icon="lucide:map-pin" width="28"></iconify-icon>
                                    </div>
                                    <h3>Visit Us</h3>
                                    <p>Stop by our headquarters in New York.</p>
                                    <span class="cc-val">123 Madison Avenue, Suite 500</span>
                                    <span class="cc-val">New York, NY 10016</span>
                                </div>
                                <div class="contact-card">
                                    <div class="contact-card-icon" style="--ic:#f59e0b">
                                        <iconify-icon icon="lucide:calendar" width="28"></iconify-icon>
                                    </div>
                                    <h3>Book a Call</h3>
                                    <p>Schedule a 30-minute strategy session at your convenience.</p>
                                    <a class="btn btn-primary text-white fw-bold rounded-3 px-4 py-2 mt-3" href="#contact-form">Book Free Session</a>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_website_form sec-alt" data-vcss="001" data-snippet="s_website_form" data-name="Form" id="contact-form">
                        <div class="wrap">
                            <div class="two-col-form rv">
                                <div class="two-col-form-text">
                                    <span class="eyebrow">Get In Touch</span>
                                    <h2>Start Your Free<br /><span class="grad-text">Marketing Audit</span></h2>
                                    <p>Our team will analyze your current marketing performance and identify the highest-impact
                                        opportunities for growth completely free, no strings attached.</p>

                                    <div class="trust-list">
                                        <div class="trust-item">
                                            <iconify-icon icon="lucide:check-circle" style="color:var(--teal)" width="20"></iconify-icon>
                                            <span>Personalized strategy, not a template</span>
                                        </div>
                                        <div class="trust-item">
                                            <iconify-icon icon="lucide:check-circle" style="color:var(--teal)" width="20"></iconify-icon>
                                            <span>Response within 24–48 hours</span>
                                        </div>
                                        <div class="trust-item">
                                            <iconify-icon icon="lucide:check-circle" style="color:var(--teal)" width="20"></iconify-icon>
                                            <span>No commitment required</span>
                                        </div>
                                        <div class="trust-item">
                                            <iconify-icon icon="lucide:check-circle" style="color:var(--teal)" width="20"></iconify-icon>
                                            <span>Confidential your data stays private</span>
                                        </div>
                                    </div>
                                </div>
                                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required contact-form" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you" >
                                    <div class="s_website_form_rows">
                                        <div class="s_website_form_field s_website_form_dnone d-none" data-name="Field">
                                            <input type="hidden" class="s_website_form_input" name="email_to" value="info@yourcompany.example.com"/>
                                        </div>
                                        <div class="form-row">
                                            <div class="form-group s_website_form_field" data-type="char" data-name="Field">
                                                <label for="cf-fname">First Name <span class="req">*</span></label>
                                                <input id="cf-fname" name="First Name" type="text" class="s_website_form_input" placeholder="Jane" required="required" />
                                            </div>
                                            <div class="form-group s_website_form_field" data-type="char" data-name="Field">
                                                <label for="cf-lname">Last Name <span class="req">*</span></label>
                                                <input id="cf-lname" name="Last Name" type="text" class="s_website_form_input" placeholder="Smith" required="required" />
                                            </div>
                                        </div>
                                        <div class="form-group s_website_form_field" data-type="email" data-name="Field">
                                            <label for="cf-email">Work Email <span class="req">*</span></label>
                                            <input id="cf-email" name="Email" type="email" class="s_website_form_input" placeholder="jane@company.com" required="required" />
                                        </div>
                                        <div class="form-row">
                                            <div class="form-group s_website_form_field" data-type="char" data-name="Field">
                                                <label for="cf-company">Company Name</label>
                                                <input id="cf-company" name="Company" type="text" class="s_website_form_input" placeholder="Acme Inc." />
                                            </div>
                                            <div class="form-group s_website_form_field" data-type="url" data-name="Field">
                                                <label for="cf-website">Website URL</label>
                                                <input id="cf-website" name="Website" type="url" class="s_website_form_input" placeholder="https://yoursite.com" />
                                            </div>
                                        </div>
                                        <div class="form-group s_website_form_field" data-type="char" data-name="Field">
                                            <label for="cf-service">Primary Service Interest</label>
                                            <select id="cf-service" name="Service Interest" class="s_website_form_input">
                                                <option value="">Select a service…</option>
                                                <option>SEO Optimization</option>
                                                <option>PPC Advertising</option>
                                                <option>Social Media Marketing</option>
                                                <option>Content Marketing</option>
                                                <option>Email Marketing</option>
                                                <option>Conversion Rate Optimization</option>
                                                <option>Full-Service Package</option>
                                                <option>Not sure yet</option>
                                            </select>
                                        </div>
                                        <div class="form-group s_website_form_field" data-type="char" data-name="Field">
                                            <label for="cf-budget">Monthly Marketing Budget</label>
                                            <select id="cf-budget" name="Budget" class="s_website_form_input">
                                                <option value="">Select a range…</option>
                                                <option>Under $1,000</option>
                                                <option>$1,000 – $3,000</option>
                                                <option>$3,000 – $7,500</option>
                                                <option>$7,500 – $15,000</option>
                                                <option>$15,000+</option>
                                            </select>
                                        </div>
                                        <div class="form-group s_website_form_field" data-type="text" data-name="Field">
                                            <label for="cf-msg">Tell Us About Your Goals <span class="req">*</span></label>
                                            <textarea id="cf-msg" name="Goals" rows="4" class="s_website_form_input"
                                                      placeholder="What are you hoping to achieve? Any specific challenges we should know about?"
                                                      required="required"></textarea>
                                        </div>
                                        <div class="s_website_form_submit" data-name="Submit Button">
                                            <a href="#" role="button" class="btn btn-primary w-full s_website_form_send">
                                                <iconify-icon icon="lucide:send" width="18"></iconify-icon>
                                                Send My Free Audit Request
                                            </a>
                                            <span id="s_website_form_result"></span>
                                        </div>
                                        <p class="form-note">By submitting, you agree to our <a href="#">Privacy Policy</a>. We'll never
                                            share your information.</p>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </section>
                    <!-- FAQ -->

                    <section class="s_text_block sec-white" data-snippet="s_text_block" data-name="Text Block" style="padding: 60px 0;">
                        <div class="wrap">
                            <div class="sec-head rv">
                                <span class="eyebrow">FAQ</span>
                                <h2>Common Questions</h2>
                                <p>Everything you need to know before reaching out.</p>
                            </div>
                            <div class="faq-list rv">
                                <details class="faq-item">
                                    <summary>How quickly will I hear back after submitting?</summary>
                                    <div class="faq-body">
                                        <p>We respond to all inquiries within 24–48 business hours. For urgent matters, feel free to
                                            call us directly at +1 (800) 555-1234.</p>
                                    </div>
                                </details>
                                <details class="faq-item">
                                    <summary>What does the free audit include?</summary>
                                    <div class="faq-body">
                                        <p>Our free audit covers a full review of your current website SEO health, paid advertising
                                            efficiency, social media presence, and content gaps. You'll receive a prioritized action
                                            plan with estimated impact for each recommendation.</p>
                                    </div>
                                </details>
                                <details class="faq-item">
                                    <summary>Do I need to sign a long-term contract?</summary>
                                    <div class="faq-body">
                                        <p>No lock-ins. All our plans run month-to-month, though clients who commit to 6 or 12 months
                                            receive a discount. You can cancel or pause at any time with 30 days' notice.</p>
                                    </div>
                                </details>
                                <details class="faq-item">
                                    <summary>Which industries do you specialize in?</summary>
                                    <div class="faq-body">
                                        <p>We work with SaaS &amp; tech companies, eCommerce brands, healthcare providers, enterprise
                                            organizations, and B2B service firms. Our team has deep vertical expertise and dedicated
                                            specialists for each industry.</p>
                                    </div>
                                </details>
                                <details class="faq-item">
                                    <summary>Can you work with our existing marketing team?</summary>
                                    <div class="faq-body">
                                        <p>Absolutely. Many of our clients use us as an extension of their in-house team. We're happy
                                            to collaborate, fill specific gaps, or provide strategic oversight while your team executes
                                            day-to-day.</p>
                                    </div>
                                </details>
                            </div>
                        </div>
                    </section>

                    <!-- TRUST SIGNALS -->
                    <section class="s_text_block sec-dark" data-snippet="s_text_block" data-name="Text Block" style="padding: 60px 0;">
                        <div class="wrap">
                            <div class="sec-head rv">
                                <span class="eyebrow">Why Converza</span>
                                <h2>You're In Good Hands</h2>
                            </div>
                            <div class="bento rv">
                                <div class="bc dark">
                                    <iconify-icon icon="lucide:shield-check" width="36" style="color:var(--teal);margin-bottom:.75rem"></iconify-icon>
                                    <h3>Certified Experts</h3>
                                    <p>Google Premier Partner, Meta Business Partner, and HubSpot Platinum. Our team holds 40+
                                        certifications across all major platforms.</p>
                                </div>
                                <div class="bc span2 teal">
                                    <iconify-icon icon="lucide:trending-up" width="36" style="color:#fff;margin-bottom:.75rem"></iconify-icon>
                                    <h3>Proven ROI</h3>
                                    <p>Average client sees 312% increase in qualified leads within the first 6 months. We back every
                                        engagement with transparent reporting and clear KPIs.</p>
                                </div>
                                <div class="bc blue">
                                    <iconify-icon icon="lucide:users" width="36" style="color:#fff;margin-bottom:.75rem"></iconify-icon>
                                    <h3>Dedicated Team</h3>
                                    <p>You get a named strategist, not a rotating cast. One point of contact, always accountable.</p>
                                </div>
                                <div class="bc dark">
                                    <iconify-icon icon="lucide:bar-chart-2" width="36" style="color:var(--purple);margin-bottom:.75rem"></iconify-icon>
                                    <h3>Data-First</h3>
                                    <p>Every decision is backed by analytics. Weekly dashboards, monthly reviews, and quarterly
                                        strategy sessions keep you fully informed.</p>
                                </div>
                                <div class="bc grad">
                                    <iconify-icon icon="lucide:award" width="36" style="color:#fff;margin-bottom:.75rem"></iconify-icon>
                                    <h3>Award-Winning Work</h3>
                                    <p>Named Top Digital Agency by Clutch three years running. 98% client retention rate  our results
                                        speak louder than promises.</p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </xpath>
    </template>
</odoo>