<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="converza_footer_layout"
                  inherit_id="website.layout"
                  name="Converza Footer"
                  active="True">
            <xpath expr="//div[@id='footer']" position="replace">
                <section class="cvz_footer">
                    <div class="container">
                        <div class="cvz_footer_main">

                            <!-- COL 1: Logo + Description + Subscribe -->
                            <div class="cvz_footer_brand">
                                <!-- LOGO -->
                                <a href="/" class="cvz_header_logo">

                                    <div class="cvz_header_logo">
                                        <img src="/theme_converza/static/description/images/logo-white.png" alt="Converza Logo" class="cvz_header_logo_image"/>
                                    </div>
                                </a>

                                <p class="cvz_footer_desc">
                                    Premium digital marketing for startups,
                                    SaaS, eCommerce, and enterprises ready
                                    to lead their market.
                                </p>
                                <p class="cvz_footer_subscribe_label">Get weekly marketing insights:</p>
                                <t t-set="mailing_list" t-value="request.env['mailing.list'].sudo().search([('is_public', '=', True)], limit=1)"/>
                                <div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe" data-vxml="001" t-att-data-list-id="mailing_list.id if mailing_list else 1" data-name="Newsletter Form">
                                    <div class="js_subscribed_wrap d-none">
                                        <div class="alert alert-success mt-2 mb-0 px-3 py-2 text-center" role="alert" style="border-radius: 8px; font-size: 13.5px;">
                                            Subscribed successfully!
                                        </div>
                                    </div>
                                    <div class="js_subscribe_wrap">
                                        <div class="cvz_subscribe_form">
                                            <div class="m-0" style="flex: 1;">
                                                <input type="email" name="email"
                                                       placeholder="your@email.com"
                                                       class="cvz_subscribe_input js_subscribe_value" required="1"/>
                                            </div>
                                            <div class="m-0">
                                                <a href="#" role="button" class="cvz_subscribe_btn js_subscribe_btn">Subscribe</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- COL 2: Services -->
                            <div class="cvz_footer_col">
                                <h5 class="cvz_footer_heading">Services</h5>
                                <ul class="cvz_footer_links">
                                    <li><a href="/services/#seo">SEO Optimization</a></li>
                                    <li><a href="/services/#ppc">PPC Advertising</a></li>
                                    <li><a href="/services/#social">Social Media</a></li>
                                    <li><a href="/services/#content">Content Marketing</a></li>
                                    <li><a href="/services/#email">Email Marketing</a></li>
                                    <li><a href="/services/#cro">CRO</a></li>
                                </ul>
                            </div>

                            <!-- COL 3: Company -->
                            <div class="cvz_footer_col">
                                <h5 class="cvz_footer_heading">Company</h5>
                                <ul class="cvz_footer_links">
                                    <li><a href="/aboutus">About Us</a></li>
                                    <li><a href="/case-studies">Case Studies</a></li>
                                    <li><a href="/contactus">Careers</a></li>
                                    <li><a href="/blog">Blog</a></li>
                                    <li><a href="/pricing">Pricing</a></li>
                                    <li><a href="/contactus">Contact</a></li>
                                </ul>
                            </div>

                            <!-- COL 4: Industries -->
                            <div class="cvz_footer_col">
                                <h5 class="cvz_footer_heading">Industries</h5>
                                <ul class="cvz_footer_links">
                                    <li><a href="/case-studies#b2bc" >B2B SaaS</a></li>
                                    <li><a href="/case-studies/#ecommerce" >eCommerce</a></li>
                                    <li><a href="/case-studies/#healthcare" >Healthcare</a></li>
                                    <li><a href="/case-studies/#enterprise">Enterprise</a></li>
                                    <li><a href="/case-studies/#startups" >Startups</a></li>
                                </ul>
                            </div>

                        </div>
                    </div>

                    <!-- Bottom Bar -->
                    <div class="cvz_footer_bottom">
                        <div class="container cvz_footer_bottom_inner">
                            <span class="cvz_footer_copy">
                                © 2026 Converza Agency. All rights reserved.
                            </span>
                            <div class="cvz_footer_socials">
                                <a href="#" class="cvz_social_icon" aria-label="LinkedIn">
                                    <i class="fa fa-linkedin"/>
                                </a>
                                <a href="#" class="cvz_social_icon" aria-label="X">
                                    <i class="fa fa-twitter"/>
                                </a>
                                <a href="#" class="cvz_social_icon" aria-label="Instagram">
                                    <i class="fa fa-instagram"/>
                                </a>
                                <a href="#" class="cvz_social_icon" aria-label="YouTube">
                                    <i class="fa fa-youtube-play"/>
                                </a>
                            </div>
                        </div>
                    </div>

                </section>
            </xpath>
        </template>

        <!-- CSS Asset -->

    </data>
</odoo>