<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="converza_services" inherit_id="website.snippets" name="Services Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_converza.s_service_templates" string="Services Snippet" group="converza">
                <keywords>Snippet</keywords>
            </t>
        </xpath>
    </template>
    <template id="s_service_templates" name="Services Snippet">
        <section class="s_services_snippet cvz_services" data-snippet="theme_converza.s_service_templates" data-name="Services Snippet">
            <div class="container">
                <div class="sec-intro rv">
                <span class="badge badge-blue">Our Services</span>
                <h2>Everything you need to grow</h2>
                <p>From search to social, from content to conversion we cover every channel with strategy-first
                    thinking and performance obsessed execution.</p>
            </div>
            <div class="svc-bento">
                <div class="svc-card rv d1">
                    <div class="svc-icon-wrap ic-blue"><iconify-icon icon="lucide:search"></iconify-icon></div>
                    <h3>SEO Optimization</h3>
                    <p class="svc-desc">Dominate search rankings with technical SEO, content strategy, and link building
                        that compounds over time.</p>
                    <div class="svc-tags">
                        <span class="svc-tag">Technical SEO</span>
                        <span class="svc-tag">Link Building</span>
                        <span class="svc-tag">Local SEO</span>
                    </div>
                </div>
                <div class="svc-card rv d2">
                    <div class="svc-icon-wrap ic-orange"><iconify-icon icon="lucide:trending-up"></iconify-icon></div>
                    <h3>PPC Advertising</h3>
                    <p class="svc-desc">High-ROAS paid campaigns across Google, Meta, and LinkedIn managed to your
                        margin, not just clicks.</p>
                    <div class="svc-tags">
                        <span class="svc-tag">Google Ads</span>
                        <span class="svc-tag">Meta Ads</span>
                        <span class="svc-tag">Retargeting</span>
                    </div>
                </div>
                <div class="svc-card featured rv d3">
                    <div class="svc-icon-wrap ic-purple"><iconify-icon icon="lucide:smartphone"></iconify-icon></div>
                    <h3>Social Media Marketing</h3>
                    <p class="svc-desc">Build brand authority and an engaged community across every platform that
                        matters to your audience.</p>
                    <div class="svc-tags">
                        <span class="svc-tag">Instagram</span>
                        <span class="svc-tag">LinkedIn</span>
                        <span class="svc-tag">TikTok</span>
                    </div>
                </div>
                <div class="svc-card rv d1">
                    <div class="svc-icon-wrap ic-teal"><iconify-icon icon="lucide:pen-tool"></iconify-icon></div>
                    <h3>Content Marketing</h3>
                    <p class="svc-desc">SEO-led blogs, thought-leadership, video scripts, and whitepapers that attract
                        your ideal customers.</p>
                    <div class="svc-tags">
                        <span class="svc-tag">Blog Strategy</span>
                        <span class="svc-tag">Video Content</span>
                        <span class="svc-tag">Whitepapers</span>
                    </div>
                </div>
                <div class="svc-card rv d2">
                    <div class="svc-icon-wrap ic-pink"><iconify-icon icon="lucide:mail"></iconify-icon></div>
                    <h3>Email Marketing</h3>
                    <p class="svc-desc">Automated sequences, segmented campaigns, and lifecycle flows that turn
                        subscribers into paying customers.</p>
                    <div class="svc-tags">
                        <span class="svc-tag">Automation</span>
                        <span class="svc-tag">Segmentation</span>
                        <span class="svc-tag">Drip Campaigns</span>
                    </div>
                </div>
                <div class="svc-card rv d3">
                    <div class="svc-icon-wrap ic-green"><iconify-icon icon="lucide:zap"></iconify-icon></div>
                    <h3>Conversion Rate Optimization</h3>
                    <p class="svc-desc">A/B testing, heatmaps, UX improvements, and landing page design that turn more
                        visitors into buyers.</p>
                    <div class="svc-tags">
                        <span class="svc-tag">A/B Testing</span>
                        <span class="svc-tag">UX Audits</span>
                        <span class="svc-tag">Landing Pages</span>
                    </div>
                </div>
            </div>
            </div>
        </section>
    </template>
</odoo>