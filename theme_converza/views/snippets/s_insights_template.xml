<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="converza_insights" inherit_id="website.snippets" name="Insights Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_converza.s_insights_template" string="Insights Snippet" group="converza">
                <keywords>Snippet</keywords>
            </t>
        </xpath>
    </template>

    <template id="s_insights_template" name="Insights Snippet">
        <section class="s_insights_snippet cvz-insights-section pt96 pb96" data-snippet="theme_converza.s_insights_template" data-name="Insights Snippet">
            <div class="container">
                <div class="row text-center mb-5">
                    <div class="col-lg-8 offset-lg-2">
                        <span class="badge rounded-pill px-3 py-2 mb-3" style="background-color: #e0f2f1 !important; color: #00897b !important;">INSIGHTS</span>
                        <h2 class="fw-bold mb-3" style="font-size: 2.5rem; color: #111827;">Marketing intelligence you can use</h2>
                        <p class="text-muted" style="font-size: 1.1rem;">Practical guides, AI-powered tactics, and data-backed insights from our team published every week.</p>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Insight 1 -->
                    <div class="col-lg-4 col-md-6">
                        <div class="card p-0 h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                            <span class="badge rounded-pill position-absolute" style="top: 15px; left: 15px; background-color: #8b5cf6 !important; z-index: 10;">AI MARKETING</span>
                            <img src="/theme_converza/static/src/img/blog-ai-marketing.jpg" class="card-img-top position-relative" alt="AI Marketing" style="height: 200px; object-fit: cover;"/>
                            <div class="card-body p-4">
                                <div class="text-muted small mb-2">June 8, 2026 <span class="mx-2">•</span> 7 min read</div>
                                <h5 class="card-title fw-bold mb-3">How AI is Changing Paid Media Optimization in 2026</h5>
                                <p class="card-text text-muted mb-4">From predictive bidding to creative generation, AI tools are reshaping how performance marketers manage campaigns at scale.</p>
                                <a href="#" class="text-decoration-none fw-bold" style="color: #2563eb;">Read article</a>
                            </div>
                        </div>
                    </div>

                    <!-- Insight 2 -->
                    <div class="col-lg-4 col-md-6">
                        <div class="card p-0 h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                            <span class="badge rounded-pill position-absolute" style="top: 15px; left: 15px; background-color: #3b82f6 !important; z-index: 10;">SEO</span>
                            <img src="/theme_converza/static/src/img/blog-seo.jpg" class="card-img-top position-relative" alt="SEO" style="height: 200px; object-fit: cover;"/>
                            <div class="card-body p-4">
                                <div class="text-muted small mb-2">June 3, 2026 <span class="mx-2">•</span> 12 min read</div>
                                <h5 class="card-title fw-bold mb-3">The Complete Technical SEO Checklist for SaaS in 2026</h5>
                                <p class="card-text text-muted mb-4">Core Web Vitals, schema markup, crawlability, and the AI-search factors that now determine whether your content gets seen.</p>
                                <a href="#" class="text-decoration-none fw-bold" style="color: #2563eb;">Read article</a>
                            </div>
                        </div>
                    </div>

                    <!-- Insight 3 -->
                    <div class="col-lg-4 col-md-6">
                        <div class="card p-0 h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                            <span class="badge rounded-pill position-absolute" style="top: 15px; left: 15px; background-color: #10b981 !important; z-index: 10;">SOCIAL MEDIA</span>
                            <img src="/theme_converza/static/src/img/blog-social.jpg" class="card-img-top position-relative" alt="Social Media" style="height: 200px; object-fit: cover;"/>
                            <div class="card-body p-4">
                                <div class="text-muted small mb-2">May 28, 2026 <span class="mx-2">•</span> 9 min read</div>
                                <h5 class="card-title fw-bold mb-3">B2B LinkedIn Strategy: 0 to 50K Followers in 90 Days</h5>
                                <p class="card-text text-muted mb-4">The exact posting cadence, content formats, and engagement tactics that built three of our clients' LinkedIn audiences fast.</p>
                                <a href="#" class="text-decoration-none fw-bold" style="color: #2563eb;">Read article</a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </template>
</odoo>
