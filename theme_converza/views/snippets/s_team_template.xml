<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="converza_team" inherit_id="website.snippets" name="Team Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_converza.s_team_template" string="Team Snippet" group="converza">
                <keywords>Snippet</keywords>
            </t>
        </xpath>
    </template>
    
    <template id="s_team_template" name="Team Snippet">
        <section class="s_team_snippet cvz-team-section pt96 pb96" data-snippet="theme_converza.s_team_template" data-name="Team Snippet">
            <div class="container">
                <div class="row text-center mb-5">
                    <div class="col-lg-8 offset-lg-2">
                        <span class="badge rounded-pill px-3 py-2 mb-3" style="background-color: #f0e6ff !important; color: #6b46c1 !important;">OUR TEAM</span>
                        <h2 class="fw-bold mb-3" style="font-size: 2.5rem; color: #111827;">Marketing experts, not generalists</h2>
                        <p class="text-muted" style="font-size: 1.1rem;">Every specialist on your account has deep expertise in their channel not a jack-of-all-trades who dabbles in everything.</p>
                    </div>
                </div>
                
                <div class="row g-4">
                    <!-- Team Member 1 -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden cvz-team-card">
                            <img src="/theme_converza/static/src/img/team-james.jpg" class="card-img-top" alt="James Sullivan" style="height: 300px; object-fit: cover;"/>
                            <div class="card-body p-4 text-start">
                                <h5 class="card-title fw-bold mb-1">James Sullivan</h5>
                                <p class="card-text text-muted small mb-3">CEO &amp; Head of Strategy</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="cvz-team-badge">Strategy</span>
                                    <span class="cvz-team-badge">Growth</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Team Member 2 -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden cvz-team-card">
                            <img src="/theme_converza/static/src/img/team-sofia.jpg" class="card-img-top" alt="Sofia Andersen" style="height: 300px; object-fit: cover;"/>
                            <div class="card-body p-4 text-start">
                                <h5 class="card-title fw-bold mb-1">Sofia Andersen</h5>
                                <p class="card-text text-muted small mb-3">Head of Paid Media</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="cvz-team-badge">Google Ads</span>
                                    <span class="cvz-team-badge">Meta</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Team Member 3 -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden cvz-team-card">
                            <img src="/theme_converza/static/src/img/team-marcus.jpg" class="card-img-top" alt="Marcus Reyes" style="height: 300px; object-fit: cover;"/>
                            <div class="card-body p-4 text-start">
                                <h5 class="card-title fw-bold mb-1">Marcus Reyes</h5>
                                <p class="card-text text-muted small mb-3">SEO Director</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="cvz-team-badge">Technical SEO</span>
                                    <span class="cvz-team-badge">Content</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Team Member 4 -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden cvz-team-card">
                            <img src="/theme_converza/static/src/img/team-layla.jpg" class="card-img-top" alt="Layla Khan" style="height: 300px; object-fit: cover;"/>
                            <div class="card-body p-4 text-start">
                                <h5 class="card-title fw-bold mb-1">Layla Khan</h5>
                                <p class="card-text text-muted small mb-3">Content &amp; Email Lead</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="cvz-team-badge">Copywriting</span>
                                    <span class="cvz-team-badge">Email</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </section>
    </template>
</odoo>
