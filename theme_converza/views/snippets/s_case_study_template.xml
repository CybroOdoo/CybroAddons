<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="converza_case_study" inherit_id="website.snippets" name="Case study Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_converza.s_case_study_template" string="Case study Snippet" group="converza">
                <keywords>Snippet</keywords>
            </t>
        </xpath>
    </template>
    <template id="s_case_study_template" name="Case study Snippet">
        <section class="s_case_study case-studies-section sec-white" data-snippet="theme_converza.s_case_study_template" data-name="Case Study Snippet">
            <div class="container">
                <div class="sec-intro rv">
                <span class="badge badge-purple">Case Studies</span>
                <h2>Real results, real companies</h2>
                <p>See how we've helped businesses across industries achieve breakthrough growth with focused, strategic
                    marketing.</p>
            </div>
            <div class="case-grid">
                <article class="case-card rv d1">
                    <div class="case-img">
                        <img src="/theme_converza/static/src/img/case-b2b-saas.jpg" alt="B2B SaaS campaign" loading="lazy" />
                        <div class="case-img-overlay"></div>
                    </div>
                    <div class="case-body">
                        <span class="case-industry">B2B SaaS</span>
                        <h3>312% pipeline growth in 6 months</h3>
                        <p>Rebuilt messaging, launched ABM paid media, and created a lead-nurture system for enterprise
                            buyers that cut sales cycles by 40%.</p>
                        <div class="case-stats">
                            <div class="cs">
                                <div class="cs-val" data-count="312" data-suffix="%">312%</div>
                                <div class="cs-key">Pipeline</div>
                            </div>
                            <div class="cs">
                                <div class="cs-val" data-count="40" data-suffix="%">40%</div>
                                <div class="cs-key">Shorter Sales Cycle</div>
                            </div>
                            <div class="cs">
                                <div class="cs-val" data-count="5.8" data-suffix="x">5.8x</div>
                                <div class="cs-key">ROAS</div>
                            </div>
                        </div>
                    </div>
                </article>
                <article class="case-card rv d2">
                    <div class="case-img">
                        <img src="/theme_converza/static/src/img/case-ecommerce.jpg" alt="eCommerce growth" loading="lazy" />
                        <div class="case-img-overlay"></div>
                    </div>
                    <div class="case-body">
                        <span class="case-industry">eCommerce</span>
                        <h3>58% higher repeat purchase rate</h3>
                        <p>Designed segmented email retention flows, seasonal campaign creative, and a loyalty content
                            calendar that drove repeat buyers.</p>
                        <div class="case-stats">
                            <div class="cs">
                                <div class="cs-val" data-count="58" data-suffix="%">58%</div>
                                <div class="cs-key">Repeat Sales</div>
                            </div>
                            <div class="cs">
                                <div class="cs-val" data-count="3.2" data-suffix="x">3.2x</div>
                                <div class="cs-key">Email ROI</div>
                            </div>
                            <div class="cs">
                                <div class="cs-val" data-count="44" data-suffix="%">44%</div>
                                <div class="cs-key">Lower CAC</div>
                            </div>
                        </div>
                    </div>
                </article>
                <article class="case-card rv d3">
                    <div class="case-img">
                        <img src="/theme_converza/static/src/img/case-healthcare.jpg" alt="Healthcare marketing" loading="lazy" />
                        <div class="case-img-overlay"></div>
                    </div>
                    <div class="case-body">
                        <span class="case-industry">Healthcare</span>
                        <h3>420% organic traffic in 8 months</h3>
                        <p>Technical SEO overhaul, YMYL-compliant content strategy, and local SEO campaign that ranked
                            for 280 high-intent keywords.</p>
                        <div class="case-stats">
                            <div class="cs">
                                <div class="cs-val" data-count="420" data-suffix="%">420%</div>
                                <div class="cs-key">Traffic Growth</div>
                            </div>
                            <div class="cs">
                                <div class="cs-val" data-count="280" data-suffix="+">280+</div>
                                <div class="cs-key">Keywords Ranked</div>
                            </div>
                            <div class="cs">
                                <div class="cs-val" data-count="71" data-suffix="%">71%</div>
                                <div class="cs-key">More Leads</div>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
            </div>
        </section>
    </template>
</odoo>