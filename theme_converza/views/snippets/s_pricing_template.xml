<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="converza_pricing" inherit_id="website.snippets" name="Pricing Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_converza.s_pricing_template" string="Pricing Snippet" group="converza">
                <keywords>Snippet</keywords>
            </t>
        </xpath>
    </template>
    <template id="s_pricing_template" name="Pricing Snippet">
        <section class="s_pricing_snippet pricing-section" data-snippet="theme_converza.s_pricing_template" data-name="Pricing Snippet">
            <div class="container">
                <div class="sec-intro rv">
                <span class="badge badge-blue">Pricing</span>
                <h2>Simple, transparent pricing</h2>
                <p>No hidden fees. No lock-in contracts. Pause or cancel anytime. Pay only for the services that drive
                    your growth.</p>
            </div>
            <div class="pricing-grid">
                <!-- Starter -->
                <div class="price-card rv d1">
                    <div class="price-plan">Starter</div>
                    <div class="price-name">Foundation</div>
                    <div class="price-desc">Perfect for early-stage startups building their first marketing foundation.
                    </div>
                    <div class="price-amount">
                        <span class="price-cur">$</span>
                        <span class="price-num">1,499</span>
                        <span class="price-period">/mo</span>
                    </div>
                    <hr class="price-divider" />
                    <ul class="price-feats">
                        <li class="price-feat">SEO audit &amp; on-page optimization</li>
                        <li class="price-feat">Google Ads setup &amp; management</li>
                        <li class="price-feat">4 blog posts per month</li>
                        <li class="price-feat">Monthly performance report</li>
                        <li class="price-feat">Email support</li>
                        <li class="price-feat no">Social media management</li>
                        <li class="price-feat no">CRO testing</li>
                        <li class="price-feat no">Dedicated account manager</li>
                    </ul>
                    <a class="btn btn-outline" href="#contact" style="width:100%;justify-content:center">Get Started</a>
                </div>
                <!-- Growth (Popular) -->
                <div class="price-card popular rv d2">
                    <div class="popular-badge"><iconify-icon icon="lucide:star" width="11"></iconify-icon> Most Popular
                    </div>
                    <div class="price-plan">Growth</div>
                    <div class="price-name">Scale</div>
                    <div class="price-desc">For growing companies ready to scale across multiple channels.</div>
                    <div class="price-amount">
                        <span class="price-cur">$</span>
                        <span class="price-num">3,999</span>
                        <span class="price-period">/mo</span>
                    </div>
                    <hr class="price-divider" />
                    <ul class="price-feats">
                        <li class="price-feat">Full SEO strategy &amp; link building</li>
                        <li class="price-feat">Google + Meta + LinkedIn Ads</li>
                        <li class="price-feat">10 blog posts &amp; social content</li>
                        <li class="price-feat">Email automation setup</li>
                        <li class="price-feat">Weekly performance reviews</li>
                        <li class="price-feat">Social media management</li>
                        <li class="price-feat">CRO testing &amp; landing pages</li>
                        <li class="price-feat">Dedicated account manager</li>
                    </ul>
                    <a class="btn btn-teal" href="#contact" style="width:100%;justify-content:center">Start Growing</a>
                </div>
                <!-- Enterprise -->
                <div class="price-card rv d3">
                    <div class="price-plan">Enterprise</div>
                    <div class="price-name">Authority</div>
                    <div class="price-desc">For established businesses that want to dominate their market.</div>
                    <div class="price-amount">
                        <span class="price-cur">$</span>
                        <span class="price-num">8,999</span>
                        <span class="price-period">/mo</span>
                    </div>
                    <hr class="price-divider" />
                    <ul class="price-feats">
                        <li class="price-feat">Everything in Growth plan</li>
                        <li class="price-feat">Custom marketing strategy</li>
                        <li class="price-feat">Unlimited content production</li>
                        <li class="price-feat">PR &amp; thought leadership</li>
                        <li class="price-feat">Advanced analytics &amp; BI</li>
                        <li class="price-feat">24/7 priority support</li>
                        <li class="price-feat">Fractional CMO access</li>
                        <li class="price-feat">Custom SLA &amp; onboarding</li>
                    </ul>
                    <a class="btn btn-primary" href="#contact" style="width:100%;justify-content:center">Contact
                        Sales</a>
                </div>
            </div>
            </div>
        </section>
    </template>
</odoo>