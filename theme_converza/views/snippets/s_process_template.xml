<?xml version="1.0" encoding="UTF-8" ?>
<odoo><template id="converza_process" inherit_id="website.snippets" name="Process Snippet">
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
        <t t-snippet="theme_converza.s_process_template" string="Process Snippet" group="converza">
            <keywords>Snippet</keywords>
        </t>
    </xpath>
</template>
<template id="s_process_template" name="Process Snippet">
    <section class="s_process_snippet process-section" data-snippet="theme_converza.s_process_template" data-name="Process Snippet">
        <div class="container">

            <div class="process-header">
                <span class="process-badge">OUR PROCESS</span>

                <h2>From discovery to growth systematically</h2>

                <p>
                    A proven 5-step framework that transforms your marketing
                    from guesswork into a predictable growth engine.
                </p>
            </div>

            <div class="process-timeline">

                <div class="process-step">
                    <div class="step-icon">
                        <span class="step-number">1</span>
                        <i class="fa fa-compass"/>
                    </div>

                    <h4>Discovery</h4>

                    <p>
                        Deep audit of your market, competitors, audience,
                        and current performance across every channel.
                    </p>
                </div>

                <div class="timeline-line"></div>

                <div class="process-step">
                    <div class="step-icon">
                        <span class="step-number">2</span>
                        <i class="fa fa-map-o"/>
                    </div>

                    <h4>Strategy</h4>

                    <p>
                        Custom 90-day growth roadmap with channel priorities,
                        budget allocation, and KPI targets.
                    </p>
                </div>

                <div class="timeline-line"></div>

                <div class="process-step">
                    <div class="step-icon">
                        <span class="step-number">3</span>
                        <i class="fa fa-sliders"/>
                    </div>

                    <h4>Execution</h4>

                    <p>
                        Full-stack campaign launch across ads, content,
                        SEO, email, and landing pages.
                    </p>
                </div>

                <div class="timeline-line"></div>

                <div class="process-step">
                    <div class="step-icon">
                        <span class="step-number">4</span>
                        <i class="fa fa-flask"/>
                    </div>

                    <h4>Optimization</h4>

                    <p>
                        Weekly testing, creative iteration,
                        and bid management to improve results.
                    </p>
                </div>

                <div class="timeline-line"></div>

                <div class="process-step">
                    <div class="step-icon">
                        <span class="step-number">5</span>
                        <i class="fa fa-line-chart"/>
                    </div>

                    <h4>Growth</h4>

                    <p>
                        Scale proven winners, unlock new channels,
                        and build systems that grow with your business.
                    </p>
                </div>

            </div>

        </div>
    </section>
</template>
</odoo>