<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="converza_snippet_category" inherit_id="website.snippets" name="Converza Category">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="converza" t-snippet="website.s_snippet_group" string="Converza"
               t-thumbnail="/theme_converza/static/description/images/thumbnail.jpg"/>
        </xpath>
    </template>
</odoo>
