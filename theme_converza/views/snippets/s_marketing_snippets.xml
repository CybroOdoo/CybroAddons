<?xml version="1.0" encoding="UTF-8" ?>
<odoo><template id="converza_marketing" inherit_id="website.snippets" name="Marketing Snippet">
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
        <t t-snippet="theme_converza.s_marketing_snippets" string="Marketing Snippet" group="converza">
            <keywords>Snippet</keywords>
        </t>
    </xpath>
</template>
<template id="s_marketing_snippets" name="Marketing Snippet">
<section class="s_marketing_snippet cvz_hero" data-snippet="theme_converza.s_marketing_snippets" data-name="Marketing Snippet">
    <div class="container cvz_hero_inner">

        <!-- LEFT CONTENT -->
        <div class="cvz_hero_content">

            <!-- Badge -->
            <div class="hero-badge rv show pb-3">
                <span class="badge rounded-pill px-3 py-2 text-uppercase d-inline-flex align-items-center gap-2 text-white" style="background-color: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); letter-spacing: 0.05em; color: rgba(255, 255, 255, 0.9) !important;">
                    <iconify-icon icon="lucide:rocket" width="14"></iconify-icon>
                    Trusted by 200+ fast-growing brands
                </span>
            </div>

            <!-- Headline -->
            <h1 class="rv show d1 text-white fw-bold mb-4" style="font-size: 50px;">
                Marketing designed<br /> To maximize <span class="hl">Potential</span>
            </h1>

            <!-- Subtext -->
            <p class="hero-desc rv show d2">
                We build data-driven marketing systems for startups, SaaS companies,
                and eCommerce brands ready to scale. Strategy, execution, and optimization all under one roof.
            </p>

            <!-- CTA Buttons -->
            <div class="hero-btns rv show d3">
                <a class="btn btn-primary" href="/free-strategy-call">
                    <iconify-icon icon="lucide:arrow-right" width="18"></iconify-icon>
                    Get Free Strategy Call
                </a>
                <a class="btn btn-ghost-white" href="/case-studies">View Case Studies</a>
            </div>

        </div>

        <!-- RIGHT IMAGE -->
        <div class="cvz_hero_image">
            <img src="/theme_converza/static/src/img/img-1.png"
                 alt="Marketing Hero"
                 class="cvz_hero_img"/>
        </div>

    </div>
</section>
</template>
</odoo>