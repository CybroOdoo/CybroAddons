<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="converza_result_analytics" inherit_id="website.snippets" name="Analytics Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_converza.s_result_analytics" string="Analytics Snippet" group="converza">
                <keywords>Snippet</keywords>
            </t>
        </xpath>
    </template>
    <template id="s_result_analytics" name="Analytics Snippet">
        <section class="s_result_analytics analytics-section sec-dark" data-snippet="theme_converza.s_result_analytics" data-name="Analytic Snippet">
            <div class="container">
                <div class="sec-intro rv">
                <span class="badge badge-white">Results &amp; Analytics</span>
                <h2>Numbers that speak for themselves</h2>
                <p>Real results from real campaigns across 200+ clients in 12 industries over the last 3 years.</p>
            </div>
            <div class="results-grid">
                <div class="r-card rv d1">
                    <h4>Revenue Growth — 12 months</h4>
                    <div class="bar-chart">
                        <div class="bc-bar"></div>
                        <div class="bc-bar"></div>
                        <div class="bc-bar"></div>
                        <div class="bc-bar alt"></div>
                        <div class="bc-bar"></div>
                        <div class="bc-bar"></div>
                    </div>
                    <div style="display:flex;justify-content:space-between;margin-top:8px">
                        <span style="font-size:11px;color:rgba(255,255,255,.35)">Jan</span>
                        <span style="font-size:11px;color:rgba(255,255,255,.35)">Mar</span>
                        <span style="font-size:11px;color:rgba(255,255,255,.35)">Jun</span>
                        <span style="font-size:11px;color:rgba(255,255,255,.35)">Sep</span>
                        <span style="font-size:11px;color:rgba(255,255,255,.35)">Nov</span>
                        <span style="font-size:11px;color:rgba(255,255,255,.35)">Dec</span>
                    </div>
                </div>
                <div class="r-card rv d2">
                    <h4>Traffic Channel Breakdown</h4>
                    <div class="donut-wrap" style="margin-top:10px">
                        <svg class="donut-svg" viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="38" fill="none" stroke="rgba(255,255,255,.06)"
                                stroke-width="14" />
                            <circle cx="50" cy="50" r="38" fill="none" stroke="#1A5FB4" stroke-width="14"
                                stroke-dasharray="90 148" stroke-dashoffset="0" transform="rotate(-90 50 50)" />
                            <circle cx="50" cy="50" r="38" fill="none" stroke="#01B0A8" stroke-width="14"
                                stroke-dasharray="50 188" stroke-dashoffset="-90" transform="rotate(-90 50 50)" />
                            <circle cx="50" cy="50" r="38" fill="none" stroke="#8B5CF6" stroke-width="14"
                                stroke-dasharray="38 200" stroke-dashoffset="-140" transform="rotate(-90 50 50)" />
                            <circle cx="50" cy="50" r="38" fill="none" stroke="#f59e0b" stroke-width="14"
                                stroke-dasharray="22 216" stroke-dashoffset="-178" transform="rotate(-90 50 50)" />
                        </svg>
                        <div class="donut-legend">
                            <div class="dl-row">
                                <div class="dl-dot" style="background:#1A5FB4"></div>Organic SEO — 38%
                            </div>
                            <div class="dl-row">
                                <div class="dl-dot" style="background:#01B0A8"></div>Paid Search — 21%
                            </div>
                            <div class="dl-row">
                                <div class="dl-dot" style="background:#8B5CF6"></div>Social Media — 16%
                            </div>
                            <div class="dl-row">
                                <div class="dl-dot" style="background:#f59e0b"></div>Email — 9%
                            </div>
                            <div class="dl-row">
                                <div class="dl-dot" style="background:rgba(255,255,255,.2)"></div>Direct — 16%
                            </div>
                        </div>
                    </div>
                </div>
                <div class="r-card rv d1">
                    <h4>Organic Traffic Growth</h4>
                    <svg class="line-svg" viewBox="0 0 300 100" preserveAspectRatio="none">
                        <defs>
                            <linearGradient id="lg1" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#1A5FB4" stop-opacity=".4" />
                                <stop offset="100%" stop-color="#1A5FB4" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <path d="M0,80 C30,75 50,65 80,55 S130,35 160,28 S220,18 260,12 S285,8 300,6" fill="none"
                            stroke="#1A5FB4" stroke-width="2" />
                        <path d="M0,80 C30,75 50,65 80,55 S130,35 160,28 S220,18 260,12 S285,8 300,6 L300,100 L0,100 Z"
                            fill="url(#lg1)" />
                        <circle cx="300" cy="6" r="4" fill="#1A5FB4" />
                    </svg>
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:6px">
                        <span style="font-size:12px;color:rgba(255,255,255,.4)">6 months ago</span>
                        <span style="font-size:13px;font-weight:700;color:#22c55e">+284% total growth</span>
                        <span style="font-size:12px;color:rgba(255,255,255,.4)">Today</span>
                    </div>
                </div>
                <div class="r-card rv d2">
                    <h4>Conversion Rate by Channel</h4>
                    <div style="display:flex;flex-direction:column;gap:10px;margin-top:8px">
                        <div>
                            <div
                                style="display:flex;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.55);margin-bottom:5px">
                                <span>Email campaigns</span><span>8.4%</span>
                            </div>
                            <div style="height:6px;background:rgba(255,255,255,.08);border-radius:4px">
                                <div
                                    style="width:84%;height:100%;border-radius:4px;background:linear-gradient(90deg,#01B0A8,#1A5FB4)">
                                </div>
                            </div>
                        </div>
                        <div>
                            <div
                                style="display:flex;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.55);margin-bottom:5px">
                                <span>PPC Landing Pages</span><span>7.1%</span>
                            </div>
                            <div style="height:6px;background:rgba(255,255,255,.08);border-radius:4px">
                                <div
                                    style="width:71%;height:100%;border-radius:4px;background:linear-gradient(90deg,#8B5CF6,#1A5FB4)">
                                </div>
                            </div>
                        </div>
                        <div>
                            <div
                                style="display:flex;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.55);margin-bottom:5px">
                                <span>Organic SEO</span><span>5.3%</span>
                            </div>
                            <div style="height:6px;background:rgba(255,255,255,.08);border-radius:4px">
                                <div
                                    style="width:53%;height:100%;border-radius:4px;background:linear-gradient(90deg,#1A5FB4,#01B0A8)">
                                </div>
                            </div>
                        </div>
                        <div>
                            <div
                                style="display:flex;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.55);margin-bottom:5px">
                                <span>Social Ads</span><span>4.8%</span>
                            </div>
                            <div style="height:6px;background:rgba(255,255,255,.08);border-radius:4px">
                                <div
                                    style="width:48%;height:100%;border-radius:4px;background:linear-gradient(90deg,#f59e0b,#ef4444)">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="roi-grid">
                <div class="roi-card rv d1">
                    <div class="roi-num" data-count="312" data-suffix="%">312%</div>
                    <div class="roi-label">Average pipeline growth</div>
                </div>
                <div class="roi-card rv d2">
                    <div class="roi-num" data-count="6.4" data-suffix="x">6.4x</div>
                    <div class="roi-label">Average ROAS, paid media</div>
                </div>
                <div class="roi-card rv d3">
                    <div class="roi-num" data-count="62" data-suffix="%">62%</div>
                    <div class="roi-label">Reduction in cost per acquisition</div>
                </div>
                <div class="roi-card rv d4">
                    <div class="roi-num" data-count="200" data-suffix="+">200+</div>
                    <div class="roi-label">Active client campaigns</div>
                </div>
            </div>
            </div>
        </section>
    </template>
</odoo>