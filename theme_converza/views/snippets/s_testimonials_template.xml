<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="converza_testimonial" inherit_id="website.snippets" name="Testimonial Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_converza.s_testimonials_template" string="Testimonial Snippet" group="converza">
                <keywords>Snippet</keywords>
            </t>
        </xpath>
    </template>
    <template id="s_testimonials_template" name="Testimonial Snippet">
        <section class="s_testimonial_snippet testimonial-section" data-snippet="theme_converza.s_testimonials_template" data-name="Testimonial Snippet">
            <div class="container">
                <div class="sec-intro rv">
                <span class="badge badge-teal">Testimonials</span>
                <h2>What our clients say</h2>
                <p>200+ brands trust Converza to grow their pipeline, reduce acquisition costs, and build marketing that
                    compounds.</p>
            </div>
            <div class="testi-grid">
                <article class="testi-card rv d1">
                    <div class="stars">
                        <div class="star"></div>
                        <div class="star"></div>
                        <div class="star"></div>
                        <div class="star"></div>
                        <div class="star"></div>
                    </div>
                    <p class="testi-text">"Converza gave us the first growth plan that our sales, product, and
                        leadership
                        teams could all rally around. Pipeline doubled in a quarter."</p>
                    <div class="testi-author">
                        <div class="testi-av" style="background:linear-gradient(135deg,#1A5FB4,#01B0A8)">AV</div>
                        <div>
                            <div class="testi-name">Amelia Voss</div>
                            <div class="testi-role">CMO, Apex Cloud</div>

                        </div>
                    </div>
                </article>
                <article class="testi-card highlight rv d2">
                    <div class="stars">
                        <div class="star"></div>
                        <div class="star"></div>
                        <div class="star"></div>
                        <div class="star"></div>
                        <div class="star"></div>
                    </div>
                    <p class="testi-text">"The creative quality is exceptional, but what really sets Converza apart is
                        the
                        discipline behind the testing. Every decision is data-backed."</p>
                    <div class="testi-author">
                        <div class="testi-av" style="background:linear-gradient(135deg,#8B5CF6,#1A5FB4)">RM</div>
                        <div>
                            <div class="testi-name">Rohan Mehta</div>
                            <div class="testi-role">Founder, Grove Wellness</div>
                        </div>
                    </div>
                </article>
                <article class="testi-card rv d3">
                    <div class="stars">
                        <div class="star"></div>
                        <div class="star"></div>
                        <div class="star"></div>
                        <div class="star"></div>
                        <div class="star"></div>
                    </div>
                    <p class="testi-text">"Within two quarters our acquisition cost dropped 62% and our brand finally
                        felt as premium as the product. Remarkable transformation."</p>
                    <div class="testi-author">
                        <div class="testi-av" style="background:linear-gradient(135deg,#01B0A8,#065f46)">MZ</div>
                        <div>
                            <div class="testi-name">Mei Zhang</div>
                            <div class="testi-role">CEO, Novum Studio</div>
                        </div>
                    </div>
                </article>
            </div>
            </div>
        </section>
    </template>
</odoo>