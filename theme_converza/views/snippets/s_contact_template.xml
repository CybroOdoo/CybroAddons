<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="converza_contact" inherit_id="website.snippets" name="Contact Snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_converza.s_contact_template" string="Contact Snippet" group="converza">
                <keywords>Snippet</keywords>
            </t>
        </xpath>
    </template>

    <template id="s_contact_template" name="Contact Snippet">
        <section class="s_contact_snippet cvz-contact-section pt96 pb96" style="background-color: #111827; color: #ffffff;" data-snippet="theme_converza.s_contact_template" data-name="Contact Snippet">
            <div class="container">
                <div class="row align-items-center g-5">
                    
                    <!-- Left Column -->
                    <div class="col-lg-6">
                        <span class="badge rounded-pill px-3 py-2 mb-4" style="background-color: rgba(255,255,255,0.1); color: #9ca3af;">GET IN TOUCH</span>
                        <h1 class="fw-bold mb-4" style="font-size: 3.5rem; letter-spacing: -1px;">Ready to grow?<br/>Let's build your plan.</h1>
                        <p class="mb-5 text-light opacity-75" style="font-size: 1.15rem; line-height: 1.7;">
                            Tell us where your marketing is stuck. We'll audit your current performance, map your highest-value opportunities, and show you a clear 90 day roadmap completely free.
                        </p>
                        
                        <div class="d-flex flex-column gap-3">
                            <div class="d-flex align-items-center p-4 rounded-4" style="background-color: rgba(255,255,255,0.05);">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 54px; height: 54px; background-color: rgba(255,255,255,0.1);">
                                    <i class="fa fa-envelope text-white fs-5"></i>
                                </div>
                                <div>
                                    <div class="text-light opacity-75 small mb-1">Email us anytime</div>
                                    <div class="fw-bold fs-5">hello@Converza.agency</div>
                                </div>
                            </div>
                            
                            <div class="d-flex align-items-center p-4 rounded-4" style="background-color: rgba(255,255,255,0.05);">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 54px; height: 54px; background-color: rgba(20, 184, 166, 0.2);">
                                    <i class="fa fa-phone fs-5" style="color: #14b8a6;"></i>
                                </div>
                                <div>
                                    <div class="text-light opacity-75 small mb-1">Call our team</div>
                                    <div class="fw-bold fs-5">+1 555 014 3920</div>
                                </div>
                            </div>
                            
                            <div class="d-flex align-items-center p-4 rounded-4" style="background-color: rgba(255,255,255,0.05);">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 54px; height: 54px; background-color: rgba(139, 92, 246, 0.2);">
                                    <i class="fa fa-map-marker fs-5" style="color: #8b5cf6;"></i>
                                </div>
                                <div>
                                    <div class="text-light opacity-75 small mb-1">Headquarters</div>
                                    <div class="fw-bold fs-5">San Francisco, CA</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Right Column (Form) -->
                    <div class="col-lg-6 ps-lg-5">
                        <div class="bg-white rounded-4 p-5 shadow-lg" style="color: #1f2937;">
                            <h3 class="fw-bold mb-2">Get your free strategy audit</h3>
                            <p class="text-muted mb-4">We'll review your marketing and send a personalised growth roadmap within 48 hours.</p>
                            
                            <div class="s_website_form" data-snippet="s_website_form">
                                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                                <div class="s_website_form_field s_website_form_dnone d-none" data-name="Field">
                                    <input type="hidden" class="s_website_form_input" name="email_to" t-att-value="res_company.email or 'info@yourcompany.example.com'"/>
                                </div>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6 s_website_form_field s_website_form_custom" data-type="char" data-name="First Name">
                                        <label class="form-label text-muted small fw-bold">FIRST NAME</label>
                                        <input type="text" class="form-control p-3 bg-light border-0 s_website_form_input" placeholder="Alex" name="first_name" required="1"/>
                                    </div>
                                    <div class="col-md-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Last Name">
                                        <label class="form-label text-muted small fw-bold">LAST NAME</label>
                                        <input type="text" class="form-control p-3 bg-light border-0 s_website_form_input" placeholder="Morgan" name="last_name" required="1"/>
                                    </div>
                                </div>

                                <div class="mb-3 s_website_form_field s_website_form_custom" data-type="email" data-name="Business Email">
                                    <label class="form-label text-muted small fw-bold">BUSINESS EMAIL</label>
                                    <input type="email" class="form-control p-3 bg-light border-0 s_website_form_input" placeholder="alex@company.com" name="business_email" required="1"/>
                                </div>

                                <div class="mb-3 s_website_form_field s_website_form_custom" data-type="char" data-name="Company Website">
                                    <label class="form-label text-muted small fw-bold">COMPANY &amp; WEBSITE</label>
                                    <input type="text" class="form-control p-3 bg-light border-0 s_website_form_input" placeholder="Acme Inc. — acme.com" name="company_website" required="1"/>
                                </div>

                                <div class="mb-3 s_website_form_field s_website_form_custom" data-type="char" data-name="Budget">
                                    <label class="form-label text-muted small fw-bold">MONTHLY MARKETING BUDGET</label>
                                    <select class="form-select p-3 bg-light border-0 s_website_form_input" name="budget" required="1">
                                        <option value="" disabled="disabled" selected="selected">Select budget</option>
                                        <option value="under_5k">Under $5,000</option>
                                        <option value="5k_10k">$5,000 - $10,000</option>
                                        <option value="10k_50k">$10,000 - $50,000</option>
                                        <option value="over_50k">Over $50,000</option>
                                    </select>
                                </div>

                                <div class="mb-4 s_website_form_field s_website_form_custom" data-type="text" data-name="Challenge">
                                    <label class="form-label text-muted small fw-bold">WHAT'S YOUR BIGGEST MARKETING CHALLENGE?</label>
                                    <textarea class="form-control p-3 bg-light border-0 s_website_form_input" rows="3" placeholder="Tell us about your goals, current channels, or what's not working..." name="challenge" required="1"></textarea>
                                </div>

                                <div class="s_website_form_submit" data-name="Submit Button">
                                    <button type="submit" class="btn w-100 text-white p-3 fw-bold rounded-3 shadow-sm s_website_form_send" style="background: linear-gradient(90deg, #0284c7 0%, #0d9488 100%); border: none;">
                                        Send My Free Audit Request
                                    </button>
                                    <span id="s_website_form_result"></span>
                                </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </section>
    </template>
</odoo>
