<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="pricing" model="ir.ui.view">
        <field name="name">Pricing</field>
        <field name="type">qweb</field>
        <field name="key">theme_converza.pricing</field>
        <field name="arch" type="xml">
            <t name="Pricing" t-name="theme_converza.pricing">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
<!-- ════════════════════ PAGE HERO ════════════════════ -->
    <section class="s_text_block page-hero" data-snippet="s_text_block" data-name="Text Block" id="top">
        <div class="wrap">
            <nav class="breadcrumb rv show">
                <a href="/">Home</a>
                <span class="breadcrumb-sep">/</span>
                <span>Pricing</span>
            </nav>
            <h1 class="rv show d1">Simple, Transparent<br/>Pricing</h1>
            <p class="hero-desc rv show d2">No hidden fees. No lock-in contracts. Pause or cancel anytime. Pay only for
                the services that drive your growth.</p>
            <div class="page-hero-stats rv show d3">
                <div class="ph-stat">
                    <div class="ph-stat-num">3</div>
                    <div class="ph-stat-label">Clear plans for every stage</div>
                </div>
                <div class="ph-stat">
                    <div class="ph-stat-num">0</div>
                    <div class="ph-stat-label">Lock-in contracts</div>
                </div>
                <div class="ph-stat">
                    <div class="ph-stat-num">48<span class="hl">h</span></div>
                    <div class="ph-stat-label">Strategy delivered</div>
                </div>
                <div class="ph-stat">
                    <div class="ph-stat-num">200<span class="hl">+</span></div>
                    <div class="ph-stat-label">Clients trust Converza</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════════════ PRICING CARDS ════════════════════ -->
    <section class="s_text_block sec sec-white" data-snippet="s_text_block" data-name="Text Block">
        <div class="wrap">
            <div class="sec-intro rv">
                <span class="badge badge-blue">Plans</span>
                <h2>Choose your growth plan</h2>
                <p>Every plan includes a dedicated account manager, monthly performance reviews, and full access to our
                    team of channel specialists.</p>
            </div>

            <div class="billing-toggle-wrap rv">
                <span class="billing-opt">Monthly</span>
                <label class="toggle-switch">
                    <input type="checkbox" id="billing-toggle"/>
                    <span class="toggle-track"></span>
                </label>
                <span class="billing-opt">Annual <span class="save-badge">Save 20%</span></span>
            </div>

            <div class="pricing-grid">
                <!-- Starter -->
                <div class="price-card rv d1">
                    <div class="price-plan">Starter</div>
                    <div class="price-name">Foundation</div>
                    <div class="price-desc">Perfect for early stage startups building their first marketing foundation.
                    </div>
                    <div class="price-amount">
                        <span class="price-cur">$</span>
                        <span class="price-num">1,499</span>
                        <span class="price-period billing-label">/mo</span>
                    </div>
                    <hr class="price-divider" />
                    <ul class="price-feats">
                        <li class="price-feat">SEO audit &amp; on-page optimization</li>
                        <li class="price-feat">Google Ads setup &amp; management</li>
                        <li class="price-feat">4 blog posts per month</li>
                        <li class="price-feat">Monthly performance report</li>
                        <li class="price-feat">Email support</li>
                        <li class="price-feat no">Social media management</li>
                        <li class="price-feat no">CRO testing</li>
                        <li class="price-feat no">Dedicated account manager</li>
                    </ul>
                    <a class="btn btn-outline" href="/contactus"
                        style="width:100%;justify-content:center">Get Started</a>
                </div>

                <!-- Growth (Popular) -->
                <div class="price-card popular rv d2">
                    <div class="popular-badge"><i class="fa fa-star"/> Most Popular
                    </div>
                    <div class="price-plan">Growth</div>
                    <div class="price-name">Scale</div>
                    <div class="price-desc">For growing companies ready to scale across multiple channels.</div>
                    <div class="price-amount">
                        <span class="price-cur">$</span>
                        <span class="price-num">3,999</span>
                        <span class="price-period billing-label">/mo</span>
                    </div>
                    <hr class="price-divider" />
                    <ul class="price-feats">
                        <li class="price-feat">Full SEO strategy &amp; link building</li>
                        <li class="price-feat">Google + Meta + LinkedIn Ads</li>
                        <li class="price-feat">10 blog posts &amp; social content</li>
                        <li class="price-feat">Email automation setup</li>
                        <li class="price-feat">Weekly performance reviews</li>
                        <li class="price-feat">Social media management</li>
                        <li class="price-feat">CRO testing &amp; landing pages</li>
                        <li class="price-feat">Dedicated account manager</li>
                    </ul>
                    <a class="btn btn-teal" href="/contactus"
                        style="width:100%;justify-content:center">Start Growing</a>
                </div>

                <!-- Enterprise -->
                <div class="price-card rv d3">
                    <div class="price-plan">Enterprise</div>
                    <div class="price-name">Authority</div>
                    <div class="price-desc">For established businesses that want to dominate their market.</div>
                    <div class="price-amount">
                        <span class="price-cur">$</span>
                        <span class="price-num">8,999</span>
                        <span class="price-period billing-label">/mo</span>
                    </div>
                    <hr class="price-divider" />
                    <ul class="price-feats">
                        <li class="price-feat">Everything in Growth plan</li>
                        <li class="price-feat">Custom marketing strategy</li>
                        <li class="price-feat">Unlimited content production</li>
                        <li class="price-feat">PR &amp; thought leadership</li>
                        <li class="price-feat">Advanced analytics &amp; BI</li>
                        <li class="price-feat">24/7 priority support</li>
                        <li class="price-feat">Fractional CMO access</li>
                        <li class="price-feat">Custom SLA &amp; onboarding</li>
                    </ul>
                    <a class="btn btn-primary" href="/contactus"
                        style="width:100%;justify-content:center">Contact Sales</a>
                </div>
            </div>
        </div>
    </section>

