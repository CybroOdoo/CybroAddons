                            <td>4</td>
                            <td class="popular-td">10</td>
                            <td>Unlimited</td>
                        </tr>
                        <tr>
                            <td class="feat-name">Social media management</td>
                            <td><iconify-icon icon="lucide:minus" style="color: var(--text-light); font-size: 1.2rem;"></iconify-icon></td>
                            <td class="popular-td"><iconify-icon icon="lucide:check" style="color: var(--teal); font-size: 1.2rem;"></iconify-icon></td>
                            <td><iconify-icon icon="lucide:check" style="color: var(--teal); font-size: 1.2rem;"></iconify-icon></td>
                        </tr>
                        <tr>
                            <td class="feat-name">Email automation setup</td>
                            <td><iconify-icon icon="lucide:minus" style="color: var(--text-light); font-size: 1.2rem;"></iconify-icon></td>
                            <td class="popular-td"><iconify-icon icon="lucide:check" style="color: var(--teal); font-size: 1.2rem;"></iconify-icon></td>
                            <td><iconify-icon icon="lucide:check" style="color: var(--teal); font-size: 1.2rem;"></iconify-icon></td>
                        </tr>
                        <tr>
                            <td class="feat-name">CRO testing &amp; landing pages</td>
                            <td><iconify-icon icon="lucide:minus" style="color: var(--text-light); font-size: 1.2rem;"></iconify-icon></td>
                            <td class="popular-td"><iconify-icon icon="lucide:check" style="color: var(--teal); font-size: 1.2rem;"></iconify-icon></td>
