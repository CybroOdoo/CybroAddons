                            <td><iconify-icon icon="lucide:check" style="color: var(--teal); font-size: 1.2rem;"></iconify-icon></td>
                        </tr>
                        <tr>
                            <td class="feat-name">Performance reporting</td>
                            <td>Monthly</td>
                            <td class="popular-td">Weekly</td>
                            <td>Real-time dashboard</td>
                        </tr>
                        <tr>
                            <td class="feat-name">PR &amp; thought leadership</td>
                            <td><iconify-icon icon="lucide:minus" style="color: var(--text-light); font-size: 1.2rem;"></iconify-icon></td>
                            <td class="popular-td"><iconify-icon icon="lucide:minus" style="color: var(--text-light); font-size: 1.2rem;"></iconify-icon></td>
                            <td><iconify-icon icon="lucide:check" style="color: var(--teal); font-size: 1.2rem;"></iconify-icon></td>
                        </tr>
                        <tr>
                            <td class="feat-name">Fractional CMO access</td>
                            <td><iconify-icon icon="lucide:minus" style="color: var(--text-light); font-size: 1.2rem;"></iconify-icon></td>
