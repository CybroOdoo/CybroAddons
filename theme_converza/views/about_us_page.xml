<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="about_us" model="ir.ui.view">
        <field name="name">About Us</field>
        <field name="type">qweb</field>
        <field name="key">theme_converza.about_us</field>
        <field name="arch" type="xml">
            <t name="About Us" t-name="theme_converza.about_us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_about_snippet about-performance-section" data-snippet="theme_converza.s_about_template" data-name="About Snippet">
            <div class="container">
                <div class="sec-intro rv">
                <span class="badge badge-teal">Why Converza</span>
                <h2>Built for performance, not promises</h2>
                <p>We don't chase vanity metrics. Every strategy we build is tied to revenue, pipeline, and business
                    outcomes that actually matter.</p>
            </div>
            <div class="bento">
                <div class="bc dark span2 rv d1">
                    <div class="bc-icon"><iconify-icon icon="lucide:rocket"></iconify-icon></div>
                    <h3>Revenue-first strategy</h3>
                    <p>Every campaign, every piece of content, and every ad dollar is tied to a clear revenue objective
                        not impressions.</p>
                    <ul class="feature-list">
                        <li>Full-funnel attribution modeling</li>
                        <li>Custom KPI dashboards for every client</li>
                        <li>Weekly performance reviews with your team</li>
                        <li>Clear ROI reporting from day one</li>
                    </ul>
                </div>
                <div class="bc teal rv d2">
                    <div class="big-stat">6.4<span>x</span></div>
                    <div class="stat-sub">Average ROAS across all paid campaigns</div>
                </div>
                <div class="bc rv d3">
                    <div class="bc-icon"><iconify-icon icon="ph:brain"></iconify-icon></div>
                    <h3>AI-powered insights</h3>
                    <p>We use machine learning to find patterns, predict churn, and optimize spend in real-time not
                        just monthly reports.</p>
                </div>
                <div class="bc blue rv d1">
                    <div class="big-stat">312<span>%</span></div>
                    <div class="stat-sub">Average pipeline increase, B2B clients</div>
                </div>
                <div class="bc grad span2 rv d2">
                    <div class="bc-icon"><iconify-icon icon="lucide:bar-chart-2"></iconify-icon></div>
                    <h3>Expertise across every channel</h3>
                    <p>Our team has run over $50M in paid media and built content programs that rank for hundreds of
                        competitive keywords.</p>
                    <div class="mini-bar-wrap">
                        <div class="mini-bar-row">
                            <div class="mini-bar-label"><span>SEO Performance</span><span>94%</span></div>
                            <div class="mini-bar-track">
                                <div class="mini-bar-fill mf-blue" style="width:94%" data-width="94"></div>
                            </div>
                        </div>
                        <div class="mini-bar-row">
                            <div class="mini-bar-label"><span>Paid Media ROAS</span><span>88%</span></div>
                            <div class="mini-bar-track">
                                <div class="mini-bar-fill mf-purple" style="width:88%" data-width="88"></div>
                            </div>
                        </div>
                        <div class="mini-bar-row">
                            <div class="mini-bar-label"><span>Email Deliverability</span><span>97%</span></div>
                            <div class="mini-bar-track">
                                <div class="mini-bar-fill mf-teal" style="width:97%" data-width="97"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bc rv d1">
                    <div class="bc-icon"><iconify-icon icon="lucide:zap"></iconify-icon></div>
                    <h3>Fast execution</h3>
                    <p>Strategy delivered in 48 hours. Campaigns live in one week. No bloated timelines.</p>
                </div>
            </div>
            </div>
        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="about_us_page" model="website.page">
        <field name="is_published">True</field>
        <field name="url">/aboutus</field>
        <field name="view_id" ref="about_us"/>
        <field name="track">True</field>
    </record>

</odoo>
