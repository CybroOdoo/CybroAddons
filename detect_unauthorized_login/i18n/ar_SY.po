#. module: detect_unauthorized_login
#: model:mail.template,body_html:detect_unauthorized_login.mail_template_wrong_password
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        Dear <t t-out=\"ctx.get('user')\"/>,\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Suspicious sign in attempt to your odoo portal was\n"
"                        detected.\n"
"                        <br/>\n"
"                    </p>\n"
"                    Regards,\n"
"                    <br/>\n"
"                    <t t-out=\"user.company_id.name\"/>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; الحشو: 0px;\">\n"
"                    <ص>\n"
"                        عزيزي <t t-out=\"ctx.get('user')\"/>،\n"
"                        <br/>\n"
"                        <br/>\n"
"                        كانت محاولة تسجيل الدخول المشبوهة إلى بوابة odoo الخاصة بك\n"
"                        تم الكشف عنها.\n"
"                        <br/>\n"
"                    </ص>\n"
"                    مع تحياتي،\n"
"                    <br/>\n"
"                    <t t-out=\"user.company_id.name\"/>\n"
"                </div>"

