<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email sent when unauthorized access is detected -->
        <record id="mail_template_wrong_password" model="mail.template">
            <field name="name">Detect Unauthorized Login:
                Suspicious sign in
            </field>
            <field name="model_id"
                   ref="detect_unauthorized_login.model_auto_capture"/>
            <field name="email_from">{{user.company_id.email}}</field>
            <field name="email_to">{{object.email}}</field>
            <field name="subject">Password Incorrect</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>
                        Dear <t t-out="ctx.get('user')"/>,
                        <br/>
                        <br/>
                        A suspicious sign-in attempt to your Odoo account was
                        detected.
                        <br/>
                    </p>
                    Regards,
                    <br/>
                    <t t-out="user.company_id.name"/>
                </div>
            </field>
        </record>
        <record id="mail_template_cant_access_camera" model="mail.template">
            <field name="name">Detect Unauthorized Login: Camera Error</field>
            <field name="model_id" ref="detect_unauthorized_login.model_auto_capture"/>
            <field name="email_from">{{user.company_id.email}}</field>
            <field name="email_to">{{object.email}}</field>
            <field name="subject">Password Incorrect (Camera Error)</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>
                        Dear <t t-out="ctx.get('user')"/>,
                        <br/>
                        <br/>
                        A suspicious sign-in attempt to your Odoo account was
                        detected.
                        <br/>
                        However, the system was unable to capture a photo of the unauthorized user because camera access failed.
                        <br/>
                    </p>
                    Regards,
                    <br/>
                    <t t-out="user.company_id.name"/>
                </div>
            </field>
        </record>
    </data>
</odoo>
