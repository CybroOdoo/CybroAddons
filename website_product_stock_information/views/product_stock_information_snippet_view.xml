<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Display stock status labels on product cards in the shop page -->
    <template id="product_stock_information"
              inherit_id="website_sale.products_item"
              name="Product Stock Information">

        <xpath expr="//form/div[1]"
               position="inside">
            <t t-if="stocks and stocks.get(product.id) == 'out_of_stock'">
                <div class="product_stock_info_label out_of_stock">
                    OUT OF STOCK
                </div>
            </t>

            <t t-if="stocks and stocks.get(product.id) == 'in_stock'">
                <div class="product_stock_info_label in_stock">
                    IN STOCK
                </div>
            </t>

        </xpath>

    </template>

</odoo>