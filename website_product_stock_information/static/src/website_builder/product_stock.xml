<templates xml:space="preserve">
    <!-- Adds a website builder checkbox option to enable or disable
    product stock information visibility on the webshop. -->
    <t t-inherit="website_sale.ProductHeaderCategoryOption"
       t-inherit-mode="extension">
        <xpath expr="//BuilderContext" position="after">
            <BuilderContext applyTo="'#o_wsale_products_grid'">
                <BuilderRow label.translate="Show Product Stock Info">
                    <BuilderCheckbox
                        action="'websiteConfig'"
                        actionParam="{views: ['website_product_stock_information.product_stock_information']}"/>
                </BuilderRow>
            </BuilderContext>
        </xpath>
    </t>

    <t t-inherit="website_sale.ProductHeaderShopOption"
       t-inherit-mode="extension">
        <xpath expr="//BuilderContext" position="after">
            <BuilderContext applyTo="'#o_wsale_products_grid'">
                <BuilderRow label.translate="Show Product Stock Info">
                    <BuilderCheckbox
                        action="'websiteConfig'"
                        actionParam="{views: ['website_product_stock_information.product_stock_information']}"/>
                </BuilderRow>
            </BuilderContext>
        </xpath>
    </t>
</templates>