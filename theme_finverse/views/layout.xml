<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add iconify to head -->
    <template id="theme_finverse_head_assets" inherit_id="website.layout" name="Finance Head Assets">
        <xpath expr="//head" position="inside">
            <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
        </xpath>
    </template>

    <!-- Header Override -->
    <template id="finance_header" inherit_id="website.layout" name="Finance Header">
        <xpath expr="//header" position="replace">
            <header class="header-container" style="position:relative; z-index:999;">
                <!-- Main Navbar -->
                <nav class="navbar" id="finance-navbar">
                    <!-- Brand Logo -->
                    <a href="/" class="logo">
                        <div class="logo-icon">
                            <iconify-icon icon="lucide:asterisk"></iconify-icon>
                        </div>
                        <span>Finverse</span>
                    </a>

                    <!-- Centre nav links (desktop only, excludes Insights & Contact) -->
                    <div class="nav-links d-none d-lg-flex">
                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                            <t t-if="submenu.url not in ['/insights', '/contactus', '/contact-us']">
                                <div class="nav-item">
                                    <a t-att-href="submenu.url" style="text-decoration:none;color:inherit;"
                                       t-esc="submenu.name"/>
                                </div>
                            </t>
                        </t>
                    </div>

                    <!-- Right actions (desktop only) -->
                    <div class="nav-actions d-none d-lg-flex align-items-center gap-2">
                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                            <t t-if="submenu.name == 'Insights'">
                                <a t-att-href="submenu.url" class="nav-pill glass" style="text-decoration:none;">
                                    <span t-esc="submenu.name"/>
                                </a>
                            </t>
                        </t>
                        <a href="/website/search" class="icon-btn glass" style="text-decoration: none;">
                            <iconify-icon icon="lucide:search" style="font-size:20px;color:inherit;"></iconify-icon>
                        </a>
                        <a href="/contactus" class="nav-pill primary text-decoration-none">Contact Us</a>

                        <!-- User Profile / Sign In (Desktop) -->
                        <t t-call="portal.placeholder_user_sign_in">
                            <t t-set="_link_class" t-value="'nav-pill glass text-decoration-none ms-2'"/>
                        </t>
                        <t t-call="portal.user_dropdown">
                            <t t-set="_icon" t-value="true"/>
                            <t t-set="_user_name" t-value="false"/>
                            <t t-set="_no_caret" t-value="true"/>
                            <t t-set="_item_class" t-value="'dropdown ms-2'"/>
                            <t t-set="_link_class"
                               t-value="'icon-btn glass d-flex align-items-center justify-content-center text-decoration-none text-reset border-0'"/>
                            <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end'"/>
                        </t>
                    </div>

                    <!-- Hamburger (mobile/tablet only) -->
                    <button class="hamburger-menu d-lg-none" id="hamburgerMenu"
                            aria-label="Toggle navigation menu"
                            aria-expanded="false" aria-controls="mobileMenu">
                        <span class="hamburger-line"></span>
                        <span class="hamburger-line"></span>
                        <span class="hamburger-line"></span>
                    </button>
                </nav>

                <!-- Mobile drawer — outside nav so it spans full viewport width -->
                <div class="mobile-menu" id="mobileMenu" role="dialog" aria-label="Navigation menu">
                    <!-- Backdrop for closing on tap-outside -->
                    <div class="mobile-menu-backdrop" id="mobileMenuBackdrop"></div>
                    <div class="mobile-menu-panel">
                        <!-- Mobile Header -->
                        <div class="mobile-menu-header">
                            <a href="/" class="logo">
                                <div class="logo-icon">
                                    <iconify-icon icon="lucide:asterisk"></iconify-icon>
                                </div>
                                <span>Finverse</span>
                            </a>
                            <button class="mobile-close-btn" id="mobileCloseBtn" aria-label="Close menu">
                                <iconify-icon icon="lucide:x" style="font-size:22px;"></iconify-icon>
                            </button>
                        </div>

                        <!-- Mobile Links -->
                        <div class="mobile-nav-links">
                            <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                <t t-if="submenu.url not in ['/contactus', '/contact-us']">
                                    <div class="nav-item">
                                        <a t-att-href="submenu.url"
                                           style="text-decoration:none;color:inherit;"
                                           t-esc="submenu.name"/>
                                    </div>
                                </t>
                            </t>
                        </div>

                        <!-- Mobile Actions -->
                        <div class="mobile-nav-actions d-flex flex-column gap-3 mt-4">
                            <a href="/contactus"
                               class="nav-pill primary text-decoration-none w-100"
                               style="display:flex;justify-content:center;">Contact Us
                            </a>
                            <div class="d-flex align-items-center gap-3">
                                <!-- User Profile / Sign In (Mobile) -->
                                <t t-call="portal.placeholder_user_sign_in">
                                    <t t-set="_link_class"
                                       t-value="'nav-pill glass text-decoration-none flex-grow-1 text-center'"/>
                                </t>
                                <t t-call="portal.user_dropdown">
                                    <t t-set="_icon" t-value="true"/>
                                    <t t-set="_user_name" t-value="true"/>
                                    <t t-set="_item_class" t-value="'dropdown w-100'"/>
                                    <t t-set="_link_class"
                                       t-value="'nav-pill glass text-decoration-none w-100 d-flex align-items-center justify-content-center text-reset border-0'"/>
                                    <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end w-100'"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
        </xpath>
    </template>

    <template id="finance_user_dropdown" inherit_id="portal.user_dropdown" name="Finance User Dropdown">
        <xpath expr="//a" position="replace">
            <a href="#" role="button" data-bs-toggle="dropdown"
               t-attf-class="#{'' if _no_caret else 'dropdown-toggle'} #{_link_class}">
                <t t-if="_avatar">
                    <t t-set="avatar_source" t-value="image_data_uri(user_id.avatar_256)" id="dropdown"/>
                    <img t-att-src="avatar_source" t-attf-class="rounded-circle o_object_fit_cover #{_avatar_class}"
                         width="24" height="24" alt="image" loading="eager"/>
                </t>
                <div t-if="_icon" t-attf-class="#{_icon_wrap_class}">
                    <i t-attf-class="fa fa-1x fa-fw fa-user #{_icon_class}"/>
                </div>
                <span t-if="_user_name" t-attf-class="#{_user_name_class}"
                      t-esc="user_id.name[:23] + '...' if user_id.name and len(user_id.name) &gt; 25 else user_id.name"/>
            </a>
        </xpath>
    </template>

    <!-- Footer Override -->
    <template id="finance_footer" inherit_id="website.layout" name="Finance Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <footer class="footer" id="footer">
                <div class="footer-top">
                    <h2>Ready to transform your<br/>financial future?
                    </h2>
                    <a href="/contactus" class="nav-pill primary text-decoration-none"
                       style="font-size: 18px; padding: 20px 40px; display: inline-flex; align-items: center; gap: 12px; cursor: pointer;">
                        Get Started Today
                        <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                            <iconify-icon icon="lucide:arrow-right" style="font-size: 24px"></iconify-icon>
                        </div>
                    </a>
                </div>
                <div class="footer-grid">
                    <div class="footer-brand">
                        <div class="logo" style="font-size: 28px; color: #ffffff">
                            <div class="logo-icon" style="width: 36px; height: 36px">
                                <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                    <iconify-icon icon="lucide:asterisk"
                                                  style="font-size: 24px; color: #ffffff"></iconify-icon>
                                </div>
                            </div>
                            <span style="font-weight: 600">Finverse</span>
                        </div>
                        <p>
                            Empowering businesses with strategic financial consulting and cutting-edge data analytics to
                            drive sustainable growth.
                        </p>
                    </div>
                    <div class="footer-links">
                        <h4>Company</h4>
                        <ul>
                            <li>
                                <a href="/about">About Us</a>
                            </li>
                            <li>
                                <a href="#">Careers</a>
                            </li>
                            <li>
                                <a href="#">Newsroom</a>
                            </li>
                            <li>
                                <a href="/contactus">Contact</a>
                            </li>
                        </ul>
                    </div>
                    <div class="footer-links">
                        <h4>Services</h4>
                        <ul>
                            <li>
                                <a href="/services">Wealth Management</a>
                            </li>
                            <li>
                                <a href="#">Data Analytics</a>
                            </li>
                            <li>
                                <a href="#">Corporate Finance</a>
                            </li>
                            <li>
                                <a href="#">Digital Transformation</a>
                            </li>
                        </ul>
                    </div>
                    <div class="footer-newsletter">
                        <h4 style="font-size: 18px; font-weight: 600; margin-bottom: 24px">Subscribe to Our Newsletter
                        </h4>
                        <p>Get the latest financial insights and industry news delivered to your inbox.</p>
                        <form class="newsletter-form position-relative d-flex" style="gap: 8px;">
                            <input type="email" placeholder="Email address" class="form-control" required="required"
                                   style="flex:1; border-radius:9999px; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); color:#fff; padding:12px 20px;"/>
                            <button class="nav-pill primary border-0">Subscribe</button>
                        </form>
                    </div>
                </div>
                <div class="footer-bottom">
                    <div>© 2026 Finverse Consulting. All rights reserved.</div>
                    <div class="social-links">
                        <a href="/website/social/linkedin" aria-label="LinkedIn"
                           style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer; color:inherit; text-decoration:none;">
                            <i class="fa fa-linkedin o_editable_media" style="font-size: 24px;"></i>
                        </a>
                        <a href="/website/social/twitter" aria-label="X"
                           style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer; color:inherit; text-decoration:none;">
                            <i class="fa fa-twitter o_editable_media" style="font-size: 24px;"></i>
                        </a>
                        <a href="/website/social/facebook" aria-label="Facebook"
                           style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer; color:inherit; text-decoration:none;">
                            <i class="fa fa-facebook o_editable_media" style="font-size: 24px;"></i>
                        </a>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
