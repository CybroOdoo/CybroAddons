                                <p class="form-desc">
                                    Ready to transform your financial strategy? Our experts are here to help you
                                    navigate challenges
                                    and seize opportunities.
                                </p>
                                <form action="/website/form/" method="post" enctype="multipart/form-data"
                                      class="o_mark_required s_website_form contact-form" data-mark="*"
                                      data-model_name="crm.lead" data-success-mode="redirect"
                                      data-success-page="/contactus-thank-you" data-success_page="/contactus-thank-you">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="name" value="Website Contact Form Submission (Home)"/>
                                    <div class="form-row">
                                        <div class="form-group s_website_form_field s_website_form_required"
                                             data-type="char" data-name="Field">
                                            <label for="firstName" class="form-label s_website_form_label">
                                                <span class="s_website_form_label_content">First Name</span>
                                                <span class="s_website_form_mark">*</span>
                                            </label>
                                            <input type="text" id="firstName" name="contact_name"
                                                   class="form-input s_website_form_input" placeholder="John"
                                                   required="required"/>
                                        </div>
                                        <div class="form-group s_website_form_field s_website_form_required"
                                             data-type="char" data-name="Field">
                                            <label for="lastName" class="form-label s_website_form_label">
                                                <span class="s_website_form_label_content">Last Name</span>
                                                <span class="s_website_form_mark">*</span>
                                            </label>
                                            <input type="text" id="lastName" name="partner_name"
                                                   class="form-input s_website_form_input" placeholder="Doe"
                                                   required="required"/>
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group s_website_form_field s_website_form_required"
                                             data-type="email" data-name="Field">
                                            <label for="email" class="form-label s_website_form_label">
                                                <span class="s_website_form_label_content">Email Address</span>
                                                <span class="s_website_form_mark">*</span>
                                            </label>
                                            <input type="email" id="email" name="email_from"
                                                   class="form-input s_website_form_input"
                                                   placeholder="john@company.com" required="required"/>
                                        </div>
                                        <div class="form-group s_website_form_field" data-type="tel" data-name="Field">
                                            <label for="phone" class="form-label s_website_form_label">
                                                <span class="s_website_form_label_content">Phone Number</span>
                                            </label>
                                            <input type="tel" id="phone" name="phone"
                                                   class="form-input s_website_form_input"
                                                   placeholder="+1 (555) 123-4567"/>
                                        </div>
                                    </div>
                                    <div class="form-group s_website_form_field" data-type="char" data-name="Field">
