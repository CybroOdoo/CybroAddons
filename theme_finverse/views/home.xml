                    <!-- CONTACT SECTION -->
                    <section id="contact" class="contact-section o_colored_level"
                             data-snippet="theme_finverse.s_contact">
                        <div class="contact-grid">
                            <div class="contact-form-container">
                                <div class="small-pill border-pill info-badge"
                                     style="width: fit-content; margin-bottom: 16px">
