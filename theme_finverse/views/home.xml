<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Home template -->
    <template id="finance_home_page" name="Finance Home Page" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <div class="page-container" style="padding-bottom: 0;">
                    <!-- HERO SECTION -->
                    <section class="hero-section" style="background-image: url('/theme_finverse/static/src/img/0de6f3cb-72b0-4095-ae3c-4cb67c5e98ce.jpg'); background-size: cover; background-position: center;" data-snippet="theme_finverse.hero">
                        <div class="hero-overlay" style="pointer-events: none;"></div>
                        <div class="hero-content" style="margin-top: 100px;">
                            <h1 class="hero-title">
                                Your Trusted
                                <span class="inline-line" aria-hidden="true"></span>
                                <br/>
                                Consulting Partner
                            </h1>
                            <p class="hero-description">
                                We provide strategic financial solutions and data-driven analytics
                                to help your business achieve extraordinary growth and resilience.
                            </p>
                            <div class="hero-cta">
                                <a href="/contactus" class="nav-pill primary cta-button" role="button"
                                   aria-label="Schedule a free consultation">
                                    Free Consultation
                                </a>
                                <a href="/services" class="icon-btn primary cta-button"
                                   aria-label="Learn more about our services">
                                    <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:arrow-up-right"
                                                      style="font-size: 24px; color: #000000"
                                                      aria-hidden="true"></iconify-icon>
                                    </div>
                                </a>
                            </div>
                        </div>


                    </section>

                    <!-- STATS SECTION -->
                    <section class="stats-section" data-snippet="theme_finverse.stats">
                        <div class="stat-item">
                            <div class="stat-number">$50B+</div>
                            <div class="stat-label">Assets Managed</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">25+</div>
                            <div class="stat-label">Years of Experience</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">150+</div>
                            <div class="stat-label">Industry Awards</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">10k+</div>
                            <div class="stat-label">Satisfied Clients</div>
                        </div>
                    </section>

                    <!-- HIGHLIGHTS SECTION -->
                    <section class="highlights-section" data-snippet="theme_finverse.highlights">
                        <div class="grid-3">
                            <!-- Card 1 -->
                            <div class="highlight-card muted-card">
                                <div class="card-header">
                                    <div class="small-pill border-pill">WHO WE ARE</div>
                                    <div class="icon-btn white-btn" data-media-type="banani-button">
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                            <iconify-icon icon="lucide:arrow-up-right"
                                                          style="font-size: 20px; color: #111827"></iconify-icon>
                                        </div>
                                    </div>
                                </div>
                                <h3 class="card-title">
                                    Leading Provider of Analytics and Financial Services
                                </h3>
                                <p style="color: var(--muted-foreground); font-size: 15px; margin-bottom: 32px; line-height: 1.6; max-width: 90%;">
                                    Our comprehensive suite of analytical tools empowers decision
                                    makers with actionable insights, reducing risk and accelerating
                                    sustainable growth.
                                </p>
                                <div class="card-image-wrapper">
                                    <img class="card-image"
                                         alt="Team working"
                                         src="/theme_finverse/static/src/img/a71c4dd4-4b26-41d9-a72b-a2262ad55ff5.jpg"/>
                                </div>
                            </div>

                            <!-- Card 2 -->
                            <div class="highlight-card primary-card">
                                <div class="primary-card-content">
                                    <div class="primary-image-area">
                                        <img alt="Handshake"
                                             src="/theme_finverse/static/src/img/3d94cb14-aeb6-4c32-ad3a-2c6ca0022ae3.jpg"/>
                                    </div>
                                    <div>
                                        <div class="small-pill border-pill dark-text">
                                            RECOGNITION
                                        </div>
                                    </div>
                                    <div class="primary-bottom-row">
                                        <h3 class="card-title" style="margin: 0">
                                            Finverse Consulting Named a Agentforce Partner
                                        </h3>
                                        <div class="icon-btn white-btn" data-media-type="banani-button"
                                             style="flex-shrink: 0">
                                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                                <iconify-icon icon="lucide:arrow-up-right"
                                                              style="font-size: 20px; color: #111827"></iconify-icon>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 3 -->
                            <div class="highlight-card muted-card">
                                <div class="card-header">
                                    <div class="small-pill border-pill">REPORT</div>
                                    <div class="icon-btn white-btn" data-media-type="banani-button">
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                            <iconify-icon icon="lucide:arrow-up-right"
                                                          style="font-size: 20px; color: #111827"></iconify-icon>
                                        </div>
                                    </div>
                                </div>
                                <h3 class="card-title">
                                    2026 Diversity, Equity, and Inclusion Report
                                </h3>
                                <p style="color: var(--muted-foreground); font-size: 15px; margin-bottom: 32px; line-height: 1.6; max-width: 90%;">
                                    Explore our ongoing commitment to fostering an inclusive
                                    workplace and driving equitable outcomes across the industry
                                    globally.
                                </p>
                                <div class="card-image-wrapper">
                                    <img class="card-image"
                                         alt="Report cover"
                                         src="/theme_finverse/static/src/img/8b4cfa71-6ee3-4d5c-b724-3319eef74b18.jpg"/>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- WHY CHOOSE US -->
                    <section class="why-section" data-snippet="theme_finverse.why">
                        <div class="why-content">
                            <div class="small-pill border-pill" style="margin-bottom: 24px">
                                WHY CHOOSE US
                            </div>
                            <h2>Transforming Challenges into Opportunities</h2>
                            <p>
                                With decades of combined experience, our team of experts provides
                                tailored strategies that align with your unique business goals. We
                                don't just advise; we partner with you for long-term success,
                                ensuring every decision is backed by robust data.
                            </p>
                            <a href="/about" class="nav-pill primary text-decoration-none"
                               style="padding: 14px 32px; font-size: 16px; display:inline-block;"
                               data-media-type="banani-button">
                                Discover Our Approach
                            </a>
                        </div>
                        <div class="features-list">
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <div style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:target" style="font-size: 28px"></iconify-icon>
                                    </div>
                                </div>
                                <div class="feature-text">
                                    <h4>Strategic Planning</h4>
                                    <p>Comprehensive roadmaps designed to navigate market complexities and drive
                                        sustainable growth for your enterprise.
                                    </p>
                                </div>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <div style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:shield-check" style="font-size: 28px"></iconify-icon>
                                    </div>
                                </div>
                                <div class="feature-text">
                                    <h4>Risk Management</h4>
                                    <p>Proactive identification and mitigation of financial risks to protect your assets
                                        and future-proof investments.
                                    </p>
                                </div>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <div style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:line-chart" style="font-size: 28px"></iconify-icon>
                                    </div>
                                </div>
                                <div class="feature-text">
                                    <h4>Market Analysis</h4>
                                    <p>In-depth data analytics providing actionable insights into emerging trends and
                                        hidden market opportunities.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- SERVICES SECTION -->
                    <section class="services-section" data-snippet="theme_finverse.services">
                        <div class="section-header">
                            <div class="small-pill border-pill center-pill" style="background: #ffffff">SERVICES</div>
                            <h2 class="section-title">We Champion the Bold to<br/>Achieve the Extraordinary
                            </h2>
                        </div>
                        <div class="row g-4">
                            <div class="col-lg-3 col-md-6">
                                <div class="service-card" data-media-type="banani-button">
                                    <img alt="Wealth Management"
                                         src="/theme_finverse/static/src/img/d338d13e-fbd5-4ca2-935c-dc637328b230.jpg"/>
                                    <div class="service-icon">
                                        <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                            <iconify-icon icon="lucide:circle-dollar-sign"
                                                          style="font-size: 24px; color: #000000"></iconify-icon>
                                        </div>
                                    </div>
                                    <div class="service-info">
                                        <h4>Wealth Management</h4>
                                        <p>Tailored investment strategies to protect and grow your wealth seamlessly.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="service-card" data-media-type="banani-button">
                                    <img alt="Data Analytics"
                                         src="/theme_finverse/static/src/img/e901a2ec-d4f8-4932-bb23-644981f37c02.jpg"/>
                                    <div class="service-icon">
                                        <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                            <iconify-icon icon="lucide:pie-chart"
                                                          style="font-size: 24px; color: #000000"></iconify-icon>
                                        </div>
                                    </div>
                                    <div class="service-info">
                                        <h4>Data Analytics</h4>
                                        <p>Transform raw business data into actionable financial intelligence and
                                            insights.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="service-card" data-media-type="banani-button">
                                    <img alt="Corporate Finance"
                                         src="/theme_finverse/static/src/img/74f218a2-6759-431d-bf8b-d6ad6b9278b2.jpg"/>
                                    <div class="service-icon">
                                        <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                            <iconify-icon icon="lucide:landmark"
                                                          style="font-size: 24px; color: #000000"></iconify-icon>
                                        </div>
                                    </div>
                                    <div class="service-info">
                                        <h4>Corporate Finance</h4>
                                        <p>Strategic financial structuring and capital raising for business expansion.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="service-card" data-media-type="banani-button">
                                    <img alt="Digital Transformation"
                                         src="/theme_finverse/static/src/img/0050aa65-2c19-4770-a320-3d21d6bb4dfe.jpg"/>
                                    <div class="service-icon">
                                        <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                            <iconify-icon icon="lucide:cpu"
                                                          style="font-size: 24px; color: #000000"></iconify-icon>
                                        </div>
                                    </div>
                                    <div class="service-info">
                                        <h4>Digital Transformation</h4>
                                        <p>Modernize your financial operations with cutting-edge technology solutions.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- TESTIMONIALS SECTION -->
                    <section class="testimonials-section" data-snippet="theme_finverse.testimonials">
                        <div class="section-header-left">
                            <div class="small-pill border-pill" style="margin-bottom: 16px">TESTIMONIALS</div>
                            <h2 class="section-title">What Our Clients Say</h2>
                        </div>
                        <div class="testimonial-grid">
                            <div class="testimonial-card">
                                <div class="stars" style="color: #f59e0b">
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                </div>
                                <p class="quote" style="color: var(--foreground)">
                                    "Finverse transformed our approach to wealth management. Their data-driven insights
                                    and strategic planning have been invaluable to our growth and long-term stability."
                                </p>
                                <div class="author">
                                    <img src="/theme_finverse/static/src/img/fac1.png" alt="Sarah Jenkins"/>
                                    <div class="author-info">
                                        <h5 style="color: var(--foreground)">Sarah Jenkins</h5>
                                        <span style="color: var(--muted-foreground)">CEO, TechVentures</span>
                                    </div>
                                </div>
                            </div>

                            <div class="testimonial-card primary-theme">
                                <div class="stars" style="color: var(--primary-foreground)">
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                </div>
                                <p class="quote" style="color: var(--primary-foreground); font-weight: 500">
                                    "The level of expertise and dedication the team brings is unmatched. They helped us
                                    navigate a complex merger with absolute confidence and clarity."
                                </p>
                                <div class="author">
                                    <img src="/theme_finverse/static/src/img/fac2.jpg" alt="Michael Chen"/>
                                    <div class="author-info">
                                        <h5 style="color: var(--primary-foreground)">Michael Chen</h5>
                                        <span style="color: rgba(255, 255, 255, 0.7)">CFO, Global Nexus</span>
                                    </div>
                                </div>
                            </div>

                            <div class="testimonial-card">
                                <div class="stars" style="color: #f59e0b">
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:star" style="font-size: 20px"></iconify-icon>
                                    </div>
                                </div>
                                <p class="quote" style="color: var(--foreground)">
                                    "Outstanding service and incredible attention to detail. Finverse's analytics team
                                    provided us with a clear picture of our operational inefficiencies."
                                </p>
                                <div class="author">
                                    <img src="/theme_finverse/static/src/img/fac3.png" alt="Elena Rodriguez"/>
                                    <div class="author-info">
                                        <h5 style="color: var(--foreground)">Elena Rodriguez</h5>
                                        <span style="color: var(--muted-foreground)">VP of Operations, NovaCorp</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- CONTACT SECTION -->
                    <section id="contact" class="contact-section o_colored_level"
                             data-snippet="theme_finverse.s_contact">
                        <div class="contact-grid">
                            <div class="contact-form-container">
                                <div class="small-pill border-pill info-badge"
                                     style="width: fit-content; margin-bottom: 16px">
                                    GET IN TOUCH
                                </div>
                                <h2 class="form-title">Let's Start Your Success Story</h2>
                                <p class="form-desc">
                                    Ready to transform your financial strategy? Our experts are here to help you
                                    navigate challenges
                                    and seize opportunities.
                                </p>
                                <form class="contact-form" id="contactForm">
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="firstName" class="form-label">First Name</label>
                                            <input type="text" id="firstName" name="firstName" class="form-input"
                                                   placeholder="John" required="1"/>
                                        </div>
                                        <div class="form-group">
                                            <label for="lastName" class="form-label">Last Name</label>
                                            <input type="text" id="lastName" name="lastName" class="form-input"
                                                   placeholder="Doe" required="1"/>
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="email" class="form-label">Email Address</label>
                                            <input type="email" id="email" name="email" class="form-input"
                                                   placeholder="john@company.com" required="1"/>
                                        </div>
                                        <div class="form-group">
                                            <label for="phone" class="form-label">Phone Number</label>
                                            <input type="tel" id="phone" name="phone" class="form-input"
                                                   placeholder="+1 (555) 123-4567"/>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="company" class="form-label">Company</label>
                                        <input type="text" id="company" name="company" class="form-input"
                                               placeholder="Your Company Name"/>
                                    </div>
                                    <div class="form-group">
                                        <label for="message" class="form-label">Message</label>
                                        <textarea id="message" name="message" class="form-input form-textarea"
                                                  placeholder="Tell us about your financial goals and challenges..."
                                                  required="1"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-full" id="submitBtn">
                                        <span id="btnText">Send Message</span>
                                        <div id="btnLoader"
                                             style="display: none; width: 20px; height: 20px; border: 2px solid #ffffff; border-top: 2px solid transparent; border-radius: 50%; animation: spin 1s linear infinite; margin-left: 8px;"></div>
                                    </button>
                                </form>
                            </div>
                            <div class="contact-info-container">
                                <div class="info-main-title">Why Choose Finverse?</div>
                                <p class="info-main-desc">
                                    With over 25 years of combined experience, we deliver personalized financial
                                    strategies that
                                    drive real results for businesses of all sizes.
                                </p>
                                <div class="info-blocks">
                                    <div class="info-block">
                                        <div class="info-icon">
                                            <iconify-icon icon="lucide:clock"
                                                          style="font-size: 24px; color: var(--primary)"></iconify-icon>
                                        </div>
                                        <div class="info-content">
                                            <h3>Quick Response</h3>
                                            <p>We respond to all inquiries within 24 hours</p>
                                        </div>
                                    </div>
                                    <div class="info-block">
                                        <div class="info-icon">
                                            <iconify-icon icon="lucide:shield-check"
                                                          style="font-size: 24px; color: var(--primary)"></iconify-icon>
                                        </div>
                                        <div class="info-content">
                                            <h3>Confidential &amp; Secure</h3>
                                            <p>Your information is protected with enterprise-grade security</p>
                                        </div>
                                    </div>
                                    <div class="info-block">
                                        <div class="info-icon">
                                            <iconify-icon icon="lucide:users"
                                                          style="font-size: 24px; color: var(--primary)"></iconify-icon>
                                        </div>
                                        <div class="info-content">
                                            <h3>Expert Team</h3>
                                            <p>Work directly with certified financial consultants</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
