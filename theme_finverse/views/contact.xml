<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override Odoo's default Contact Us page with the Finance theme design using snippets -->
    <template id="finance_contactus" inherit_id="website.contactus" name="Finance Contact Us">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap">
                <div class="oe_structure">
                    <t t-call="theme_finverse.contact_hero"/>
                </div>
                <div class="oe_structure">
                    <t t-call="theme_finverse.contact_form"/>
                </div>
                <div class="oe_structure">
                    <t t-call="theme_finverse.contact_faq"/>
                </div>
                <!-- Additional drop zone for user snippets -->
                <div class="oe_structure"/>
            </div>
        </xpath>
    </template>
</odoo>
