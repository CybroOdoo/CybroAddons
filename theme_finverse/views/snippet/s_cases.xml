<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cases Template -->
    <template id="cases" name="Cases">
        <section class="highlights-section" style="padding: 80px 48px;" data-snippet="theme_finverse.cases">
            <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:16px; margin-bottom: 48px;">
                <div>
                    <div class="small-pill border-pill" style="margin-bottom: 16px;">SUCCESS STORIES</div>
                    <h2 class="section-title" style="margin:0;">Proven Results in Action</h2>
                </div>
                <div class="nav-pill" style="border: 1px solid var(--border); color: var(--foreground);">View All
                    Cases
                </div>
            </div>
            <div class="row g-4 d-flex align-items-stretch">
                <div class="col-lg-6 col-md-6 d-flex" data-name="Card">
                    <div class="highlight-card muted-card w-100" style="padding:0; overflow:hidden;">
                        <img src="/theme_finverse/static/src/img/63235fb3-b856-4d8d-bda9-46d728283c26.jpg"
                             style="width:100%; height:320px; object-fit:cover;" alt="Case 1"/>
                        <div style="padding: 32px;">
                            <div style="display:flex; gap:8px; margin-bottom:16px;">
                                <span class="small-pill border-pill" style="font-size: 10px;">REAL ESTATE</span>
                                <span class="small-pill border-pill" style="font-size: 10px;">CORPORATE FINANCE</span>
                            </div>
                            <h3 class="card-title">Structuring a $400M Sustainable Infrastructure Fund</h3>
                            <p style="color: var(--muted-foreground); margin-bottom: 24px;">How we helped a leading real
                                estate developer optimize their capital stack and secure funding for nationwide
                                eco-friendly commercial projects.
                            </p>
                            <a href="#"
                               style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                Read Case Study
                                <span class="fa fa-arrow-right"></span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 d-flex" data-name="Card">
                    <div class="highlight-card muted-card w-100" style="padding:0; overflow:hidden;">
                        <img src="/theme_finverse/static/src/img/844b7754-38db-4922-8316-458b1cfd33d2.jpg"
                             style="width:100%; height:320px; object-fit:cover;" alt="Case 2"/>
                        <div style="padding: 32px;">
                            <div style="display:flex; gap:8px; margin-bottom:16px;">
                                <span class="small-pill border-pill" style="font-size: 10px;">TECHNOLOGY</span>
                                <span class="small-pill border-pill" style="font-size: 10px;">DATA ANALYTICS</span>
                            </div>
                            <h3 class="card-title">Driving 35% Revenue Growth Through Predictive Analytics</h3>
                            <p style="color: var(--muted-foreground); margin-bottom: 24px;">We implemented an advanced
                                machine learning financial model that allowed a global SaaS provider to accurately
                                forecast churn and maximize customer lifetime value.
                            </p>
                            <a href="#"
                               style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                Read Case Study
                                <span class="fa fa-arrow-right"></span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>


    </template>
</odoo>
