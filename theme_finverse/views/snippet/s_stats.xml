<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Snippet for Stats template -->
    <template id="stats" name="Stats">
        <section class="s_stats o_colored_level" data-snippet="theme_finverse.stats">
            <div class="stats-section">
                <div class="stat-item">
                    <div class="stat-number">$50B+</div>
                    <div class="stat-label">Assets Managed</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">25+</div>
                    <div class="stat-label">Years of Experience</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">150+</div>
                    <div class="stat-label">Industry Awards</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">10k+</div>
                    <div class="stat-label">Satisfied Clients</div>
                </div>
            </div>
        </section>
    </template>
</odoo>