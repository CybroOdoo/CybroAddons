<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- About Values Template-->
    <template id="about_values" name="About Values">
        <section class="s_about_values o_colored_level" data-snippet="theme_finverse.about_values">
            <div class="values-section">
                <div class="section-header" style="text-align: center; margin-bottom: 64px">
                    <div class="small-pill border-pill center-pill"
                         style="background: #ffffff; margin: 0 auto 24px auto">
                        CORE VALUES
                    </div>
                    <h2 class="section-title" style="font-size: 44px; font-weight: 500; line-height: 1.2">The Principles
                        That Guide Us
                    </h2>
                </div>
                <div class="container">
                    <div class="row gy-4">
                        <div class="col-lg-3 col-md-6 pt16 pb16" data-name="Column">
                            <div class="value-card h-100 s_card" data-name="Card">
                                <div class="value-icon">
                                    <iconify-icon icon="lucide:shield" style="font-size: 32px"/>
                                </div>
                                <h4>Integrity</h4>
                                <p>We operate with absolute transparency and uphold the highest ethical standards in all
                                    our
                                    dealings.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 pt16 pb16" data-name="Column">
                            <div class="value-card h-100 s_card" data-name="Card">
                                <div class="value-icon">
                                    <iconify-icon icon="lucide:lightbulb" style="font-size: 32px"/>
                                </div>
                                <h4>Innovation</h4>
                                <p>We continuously seek new ways to leverage data and technology to stay ahead of market
                                    trends.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 pt16 pb16" data-name="Column">
                            <div class="value-card h-100 s_card" data-name="Card">
                                <div class="value-icon">
                                    <iconify-icon icon="lucide:award" style="font-size: 32px"/>
                                </div>
                                <h4>Excellence</h4>
                                <p>We are committed to delivering outstanding quality and measurable results in
                                    everything we do.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 pt16 pb16" data-name="Column">
                            <div class="value-card h-100 s_card" data-name="Card">
                                <div class="value-icon">
                                    <iconify-icon icon="lucide:users" style="font-size: 32px"/>
                                </div>
                                <h4>Client First</h4>
                                <p>Your success is our priority. We uniquely tailor our strategies to perfectly meet
                                    your business
                                    needs.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </template>
</odoo>