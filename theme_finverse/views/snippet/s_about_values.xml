<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- About Values Template -->
    <template id="about_values" name="About Values">
        <section class="values-section" data-snippet="theme_finverse.about_values">
            <div class="section-header" style="text-align: center; margin-bottom: 64px">
                <div class="small-pill border-pill center-pill" style="background: #ffffff; margin: 0 auto 24px auto">
                    CORE VALUES
                </div>
                <h2 class="section-title" style="font-size: 44px; font-weight: 500; line-height: 1.2">The Principles
                    That Guide Us
                </h2>
            </div>
            <div class="row g-4 d-flex align-items-stretch">
                <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                    <div class="value-card w-100">
                        <div class="value-icon">
                            <span class="fa fa-shield" style="font-size: 32px"></span>
                        </div>
                        <h4>Integrity</h4>
                        <p>We operate with absolute transparency and uphold the highest ethical standards in all our
                            dealings.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                    <div class="value-card w-100">
                        <div class="value-icon">
                            <span class="fa fa-lightbulb-o" style="font-size: 32px"></span>
                        </div>
                        <h4>Innovation</h4>
                        <p>We continuously seek new ways to leverage data and technology to stay ahead of market
                            trends.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                    <div class="value-card w-100">
                        <div class="value-icon">
                            <span class="fa fa-trophy" style="font-size: 32px"></span>
                        </div>
                        <h4>Excellence</h4>
                        <p>We are committed to delivering outstanding quality and measurable results in everything we
                            do.
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                    <div class="value-card w-100">
                        <div class="value-icon">
                            <span class="fa fa-users" style="font-size: 32px"></span>
                        </div>
                        <h4>Client First</h4>
                        <p>Your success is our priority. We uniquely tailor our strategies to perfectly meet your
                            business needs.
                        </p>
                    </div>
                </div>
            </div>
        </section>


    </template>
</odoo>
