<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact FAQ Template -->
    <template id="contact_faq" name="Contact FAQ">
        <section class="o_colored_level"
                 style="padding: 80px 48px; background: var(--muted); border-radius: 40px; margin: 0 16px 64px 16px;"
                 data-snippet="theme_finverse.contact_faq">
            <div style="max-width: 800px; margin: 0 auto;">
                <div style="margin-bottom: 48px;">
                    <div class="small-pill border-pill" style="margin-bottom: 16px; display: inline-block;">FAQ</div>
                    <h2 class="section-title" style="font-size: 40px; font-weight: 500; margin: 0;">Common Questions
                    </h2>
                </div>
                <div class="finance-faq oe_structure">
                    <t t-call="theme_finverse.contact_faq_item">
                        <t t-set="question" t-value="'What are your typical engagement terms?'"/>
                        <t t-set="answer"
                           t-value="'Our typical engagement terms range from 3-12 months depending on project scope. We offer flexible arrangements including retainer-based consulting.'"/>
                        <t t-set="is_active" t-value="True"/>
                    </t>
                    <t t-call="theme_finverse.contact_faq_item">
                        <t t-set="question" t-value="'Do you offer services globally?'"/>
                        <t t-set="answer"
                           t-value="'Yes, we have offices in New York and London, and we work with clients worldwide.'"/>
                    </t>
                    <t t-call="theme_finverse.contact_faq_item">
                        <t t-set="question" t-value="'How long does a typical consulting project take?'"/>
                        <t t-set="answer"
                           t-value="'Project timelines vary based on complexity and scope. Simple advisory engagements may take 2-4 weeks.'"/>
                    </t>
                    <t t-call="theme_finverse.contact_faq_item">
                        <t t-set="question" t-value="'What industries do you specialize in?'"/>
                        <t t-set="answer"
                           t-value="'We specialize in financial services, technology, real estate, healthcare, and manufacturing.'"/>
                    </t>
                </div>
            </div>
        </section>
    </template>
</odoo>
