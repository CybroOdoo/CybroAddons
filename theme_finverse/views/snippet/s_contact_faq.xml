<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Snippet for Contact Faq template -->
    <template id="contact_faq" name="Contact FAQ">
        <section class="s_contact_faq o_colored_level" data-snippet="theme_finverse.contact_faq">
            <div class="o_colored_level"
                 style="padding: 80px 48px; background: var(--muted); border-radius: 40px; margin: 0 16px 64px 16px;">
                <div style="max-width: 800px; margin: 0 auto;">
                    <div style="margin-bottom: 48px;">
                        <div class="small-pill border-pill" style="margin-bottom: 16px; display: inline-block;">FAQ
                        </div>
                        <h2 class="section-title o_editable" style="font-size: 40px; font-weight: 500; margin: 0;">
                            Common Questions
                        </h2>
                    </div>
                    <div class="finance-faq">
                        <div class="faq-item active">
                            <div class="faq-question"
                                 style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding: 24px 0; border-bottom: 1px solid var(--border);">
                                <span class="o_editable" style="font-size: 17px; font-weight: 500;">What are your
                                    typical engagement terms?
                                </span>
                                <iconify-icon icon="lucide:chevron-up"
                                              style="font-size: 20px; color: var(--foreground); flex-shrink: 0;"/>
                            </div>
                            <div class="faq-answer"
                                 style="padding: 16px 0 24px 0; color: var(--muted-foreground); line-height: 1.7; display: block;">
                                <p class="o_editable" style="margin: 0;">Our typical engagement terms range from 3-12
                                    months depending on project scope. We offer flexible arrangements including
                                    retainer-based consulting.
                                </p>
                            </div>
                        </div>
                        <div class="faq-item">
                            <div class="faq-question"
                                 style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding: 24px 0; border-bottom: 1px solid var(--border);">
                                <span class="o_editable" style="font-size: 17px; font-weight: 500;">Do you offer
                                    services globally?
                                </span>
                                <iconify-icon icon="lucide:chevron-down"
                                              style="font-size: 20px; color: var(--foreground); flex-shrink: 0;"/>
                            </div>
                            <div class="faq-answer"
                                 style="padding: 16px 0 24px 0; color: var(--muted-foreground); line-height: 1.7; display: none;">
                                <p class="o_editable" style="margin: 0;">Yes, we have offices in New York and London,
                                    and we work with clients worldwide.
                                </p>
                            </div>
                        </div>
                        <div class="faq-item">
                            <div class="faq-question"
                                 style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding: 24px 0; border-bottom: 1px solid var(--border);">
                                <span class="o_editable" style="font-size: 17px; font-weight: 500;">How long does a
                                    typical consulting project take?
                                </span>
                                <iconify-icon icon="lucide:chevron-down"
                                              style="font-size: 20px; color: var(--foreground); flex-shrink: 0;"/>
                            </div>
                            <div class="faq-answer"
                                 style="padding: 16px 0 24px 0; color: var(--muted-foreground); line-height: 1.7; display: none;">
                                <p class="o_editable" style="margin: 0;">Project timelines vary based on complexity and
                                    scope. Simple advisory engagements may take 2-4 weeks.
                                </p>
                            </div>
                        </div>
                        <div class="faq-item">
                            <div class="faq-question"
                                 style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding: 24px 0; border-bottom: 1px solid var(--border);">
                                <span class="o_editable" style="font-size: 17px; font-weight: 500;">What industries do
                                    you specialize in?
                                </span>
                                <iconify-icon icon="lucide:chevron-down"
                                              style="font-size: 20px; color: var(--foreground); flex-shrink: 0;"/>
                            </div>
                            <div class="faq-answer"
                                 style="padding: 16px 0 24px 0; color: var(--muted-foreground); line-height: 1.7; display: none;">
                                <p class="o_editable" style="margin: 0;">We specialize in financial services,
                                    technology, real estate, healthcare, and manufacturing.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
