<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippets Value template  -->
    <template id="value" name="Value">
        <section class="value-section section-container" data-snippet="theme_finverse.value">
            <div class="value-header" style="margin-bottom: 48px;">
                <div class="small-pill border-pill pill-light" style="margin-bottom: 24px">CROSS-INDUSTRY EXPERTISE
                </div>
                <h2 class="section-title" style="margin-top: 0">A Universal Framework for Success</h2>
                <p class="value-desc">
                    While every industry has its unique nuances, our core methodology
                    relies on fundamental principles of robust financial engineering and
                    data analytics that drive success universally.
                </p>
            </div>
            <div class="row g-4 d-flex align-items-stretch">
                <div class="col-lg-6 col-md-6 d-flex" data-name="Card">
                    <div class="value-item w-100">
                        <div class="value-icon">
                            <div style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-line-chart" style="font-size: 32px; color: #2563eb"></span>
                            </div>
                        </div>
                        <div class="value-content">
                            <h3>Data-Driven Decision Making</h3>
                            <p>
                                We replace intuition with hard data, building complex predictive
                                models that give you visibility into future performance
                                regardless of your sector.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 d-flex" data-name="Card">
                    <div class="value-item w-100">
                        <div class="value-icon">
                            <div style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-shield" style="font-size: 32px; color: #2563eb"></span>
                            </div>
                        </div>
                        <div class="value-content">
                            <h3>Proactive Risk Mitigation</h3>
                            <p>
                                Our risk frameworks anticipate market shifts, regulatory
                                changes, and economic downturns to protect your bottom line from
                                unexpected volatility.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 d-flex" data-name="Card">
                    <div class="value-item w-100">
                        <div class="value-icon">
                            <div style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-sitemap" style="font-size: 32px; color: #2563eb"></span>
                            </div>
                        </div>
                        <div class="value-content">
                            <h3>Operational Efficiency</h3>
                            <p>
                                We identify capital bottlenecks and streamline financial
                                operations, freeing up valuable resources for innovation and
                                core business growth.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 d-flex" data-name="Card">
                    <div class="value-item w-100">
                        <div class="value-icon">
                            <div style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-lightbulb-o" style="font-size: 32px; color: #2563eb"></span>
                            </div>
                        </div>
                        <div class="value-content">
                            <h3>Strategic Capital Allocation</h3>
                            <p>
                                We help you deploy capital where it generates the highest ROI,
                                whether that's in new market entry, R&amp;D, or strategic
                                acquisitions.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </template>
</odoo>
