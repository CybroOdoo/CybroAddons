<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="finance_snippets" inherit_id="website.snippets" name="Finance Theme Snippet Groups">
        <!-- Add Custom Snippet Group Category -->
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t t-snippet="website.s_snippet_group" string="Finverse Sections" snippet-group="theme_finverse" t-thumbnail="/theme_finverse/static/src/img/logo.svg"/>
        </xpath>

        <!-- Register custom snippets with thumbnails in the structural snippets list -->
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_finverse.hero" string="Hero" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
            <t t-snippet="theme_finverse.stats" string="Stats" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_block.svg"/>
            <t t-snippet="theme_finverse.highlights" string="Highlights" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
            <t t-snippet="theme_finverse.why" string="Why" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
            <t t-snippet="theme_finverse.services" string="Services" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
            <t t-snippet="theme_finverse.testimonials" string="Testimonials" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_picture.svg"/>
            <t t-snippet="theme_finverse.s_contact" string="S Contact" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_website_form.svg"/>
            <t t-snippet="theme_finverse.about_hero" string="About Hero" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
            <t t-snippet="theme_finverse.about_story" string="About Story" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
            <t t-snippet="theme_finverse.about_values" string="About Values" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
            <t t-snippet="theme_finverse.team" string="Team" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_company_team.svg"/>
            <t t-snippet="theme_finverse.services_hero" string="Services Hero" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
            <t t-snippet="theme_finverse.services_list" string="Services List" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_media_list.svg"/>
            <t t-snippet="theme_finverse.approach" string="Approach" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
            <t t-snippet="theme_finverse.cases" string="Cases" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_picture.svg"/>
            <t t-snippet="theme_finverse.industries_hero" string="Industries Hero" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
            <t t-snippet="theme_finverse.industries_grid" string="Industries Grid" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
            <t t-snippet="theme_finverse.value" string="Value" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
            <t t-snippet="theme_finverse.insights_hero" string="Insights Hero" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
            <t t-snippet="theme_finverse.insights_list" string="Insights List" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_blog_posts.svg"/>
            <t t-snippet="theme_finverse.contact_hero" string="Contact Hero" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
            <t t-snippet="theme_finverse.contact_form" string="Contact Form" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_website_form.svg"/>
            <t t-snippet="theme_finverse.contact_faq" string="Contact FAQ" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_accordion.svg"/>
            <t t-snippet="theme_finverse.contact_faq_item" string="FAQ Item" group="theme_finverse" t-thumbnail="/website/static/src/img/snippets_thumbs/s_accordion.svg"/>
        </xpath>
    </template>
</odoo>
