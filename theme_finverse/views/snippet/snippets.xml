<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="finance_snippets" inherit_id="website.snippets" name="Finance Theme Snippet Groups">
        <!-- Add Custom Snippet Group Category (Odoo 17 Panel Style) -->
        <xpath expr="//div[@id='snippet_structure']" position="after">
            <div id="snippet_theme_finverse" class="o_panel">
                <div class="o_panel_header">Finverse Sections</div>
                <div class="o_panel_body">
                    <t t-snippet="theme_finverse.hero" string="Hero" t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                    <t t-snippet="theme_finverse.stats" string="Stats" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_block.svg"/>
                    <t t-snippet="theme_finverse.highlights" string="Highlights" t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
                    <t t-snippet="theme_finverse.why" string="Why" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
                    <t t-snippet="theme_finverse.services" string="Services" t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
                    <t t-snippet="theme_finverse.testimonials" string="Testimonials" t-thumbnail="/website/static/src/img/snippets_thumbs/s_picture.svg"/>
                    <t t-snippet="theme_finverse.s_contact" string="S Contact" t-thumbnail="/website/static/src/img/snippets_thumbs/s_website_form.svg"/>
                    <t t-snippet="theme_finverse.about_hero" string="About Hero" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
                    <t t-snippet="theme_finverse.about_story" string="About Story" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
                    <t t-snippet="theme_finverse.about_values" string="About Values" t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
                    <t t-snippet="theme_finverse.team" string="Team" t-thumbnail="/website/static/src/img/snippets_thumbs/s_company_team.svg"/>
                    <t t-snippet="theme_finverse.services_hero" string="Services Hero" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
                    <t t-snippet="theme_finverse.services_list" string="Services List" t-thumbnail="/website/static/src/img/snippets_thumbs/s_media_list.svg"/>
                    <t t-snippet="theme_finverse.approach" string="Approach" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
                    <t t-snippet="theme_finverse.cases" string="Cases" t-thumbnail="/website/static/src/img/snippets_thumbs/s_picture.svg"/>
                    <t t-snippet="theme_finverse.industries_hero" string="Industries Hero" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
                    <t t-snippet="theme_finverse.industries_grid" string="Industries Grid" t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
                    <t t-snippet="theme_finverse.value" string="Value" t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg"/>
                    <t t-snippet="theme_finverse.insights_hero" string="Insights Hero" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
                    <t t-snippet="theme_finverse.insights_list" string="Insights List" t-thumbnail="/website/static/src/img/snippets_thumbs/s_blog_posts.svg"/>
                    <t t-snippet="theme_finverse.contact_hero" string="Contact Hero" t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
                    <t t-snippet="theme_finverse.contact_form" string="Contact Form" t-thumbnail="/website/static/src/img/snippets_thumbs/s_website_form.svg"/>
                    <t t-snippet="theme_finverse.contact_faq" string="Contact FAQ" t-thumbnail="/website/static/src/img/snippets_thumbs/s_accordion.svg"/>
                    <t t-snippet="theme_finverse.contact_faq_item" string="FAQ Item" t-thumbnail="/website/static/src/img/snippets_thumbs/s_accordion.svg"/>
                </div>
            </div>
        </xpath>
    </template>

    <template id="finance_snippet_options" inherit_id="website.snippet_options" name="Finance Theme Snippet Options">
        <xpath expr="." position="inside">
            <!-- Selector options for the FAQ item itself (enables drag-and-drop, delete, duplicate, etc.) -->
            <div data-selector=".faq-item"
                 data-drop-in=".finance-faq"/>

            <!-- Selector options for the parent FAQ container (enables adding new items easily) -->
            <div data-selector=".finance-faq"
                 data-js="MultipleItems">
                <we-row string="FAQ Item">
                    <we-button data-add-item="" data-item=".faq-item:last" data-select-item="" data-no-preview="true" class="o_we_bg_brand_primary">
                        Add FAQ Item
                    </we-button>
                </we-row>
            </div>
        </xpath>
    </template>
</odoo>
