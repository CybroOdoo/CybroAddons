<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Approach  -->
    <template id="approach" name="Approach">
        <section class="why-section" style="background-color: var(--muted); border-radius: 40px; margin: 32px 16px;"
                 data-snippet="theme_finverse.approach">
            <div class="why-content">
                <div class="small-pill border-pill" style="margin-bottom: 24px; background: #fff;">OUR APPROACH</div>
                <h2>A Proven Methodology for Success</h2>
                <p>We believe in a structured, data-informed approach to solving complex financial challenges. Our
                    methodical process ensures measurable and sustained results.
                </p>
            </div>
            <div class="features-list">
                <div class="feature-item">
                    <div class="feature-icon" style="background:#fff;">
                        <span style="font-size: 20px; font-weight:700;">01</span>
                    </div>
                    <div class="feature-text">
                        <h4>Discovery</h4>
                        <p>We perform a deep dive into your current financial health, market positioning, and core
                            business objectives.
                        </p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon" style="background:#fff;">
                        <span style="font-size: 20px; font-weight:700;">02</span>
                    </div>
                    <div class="feature-text">
                        <h4>Strategy</h4>
                        <p>Our experts develop a comprehensive, custom-tailored financial plan aligned perfectly with
                            your goals.
                        </p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon" style="background:#fff;">
                        <span style="font-size: 20px; font-weight:700;">03</span>
                    </div>
                    <div class="feature-text">
                        <h4>Execution</h4>
                        <p>We work closely with your internal teams to deploy solutions seamlessly and effectively
                            across all operations.
                        </p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon" style="background:#fff;">
                        <span style="font-size: 20px; font-weight:700;">04</span>
                    </div>
                    <div class="feature-text">
                        <h4>Optimization</h4>
                        <p>Through continuous review and refinement, we ensure your strategies adapt and scale as your
                            business grows.
                        </p>
                    </div>
                </div>
            </div>
        </section>


    </template>
</odoo>
