<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet Hero template -->
    <template id="hero" name="Hero">
        <section class="hero-section oe_img_bg oe_custom_bg"
                 style="background-image: url('/theme_finverse/static/src/img/0de6f3cb-72b0-4095-ae3c-4cb67c5e98ce.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat;"
                 data-snippet="theme_finverse.hero">
            <div class="hero-overlay"/>
            <div class="hero-content" style="margin-top: 100px;">
                <h1 class="hero-title">
                    Your Trusted
                    <span class="inline-line" aria-hidden="true"/>
                    <br/>
                    Consulting Partner
                </h1>
                <p class="hero-description">
                    We provide strategic financial solutions and data-driven analytics
                    to help your business achieve extraordinary growth and resilience.
                </p>
                <div class="hero-cta">
                    <a href="/contactus" class="nav-pill primary cta-button" role="button"
                       aria-label="Schedule a free consultation">
                        Free Consultation
                    </a>
                    <a href="/services" class="icon-btn primary cta-button" aria-label="Learn more about our services">
                        <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                            <span class="fa fa-arrow-right" style="font-size: 24px; color: #000000"
                                  aria-hidden="true"></span>
                        </div>
                    </a>
                </div>
            </div>

            <div class="hero-pagination">
                <span>01</span>
                <div class="pagination-line">
                    <div class="pagination-progress"/>
                </div>
                <span>03</span>
            </div>
        </section>


    </template>
</odoo>
