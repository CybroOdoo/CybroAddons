<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet for Options template -->
    <template id="finverse_snippet_options" inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-selector=".value-card, .industry-card, .article-card, .team-card, .highlight-card, .testimonial-card" 
                 data-drop-in=".values-grid, .team-grid, .article-grid, .industries-grid, .grid-3, .testimonial-grid, .row"
                 data-drop-near=".value-card, .industry-card, .article-card, .team-card, .highlight-card, .testimonial-card">
            </div>
        </xpath>
    </template>
</odoo>
