<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet Testimonials template -->
    <template id="testimonials" name="Testimonials">
        <section class="testimonials-section" data-snippet="theme_finverse.testimonials">
            <div class="section-header-left">
                <div class="small-pill border-pill" style="margin-bottom: 16px">TESTIMONIALS</div>
                <h2 class="section-title">What Our Clients Say</h2>
            </div>
            <div class="row g-4 d-flex align-items-stretch">
                <div class="col-lg-4 col-md-6 d-flex" data-name="Card">
                    <div class="testimonial-card w-100 d-flex flex-column">
                        <div class="stars" style="color: #f59e0b">
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                        </div>
                        <p class="quote" style="color: var(--foreground)">
                            "Finverse transformed our approach to wealth management. Their data-driven insights and
                            strategic planning have been invaluable to our growth and long-term stability."
                        </p>
                        <div class="author mt-auto">
                            <img src="/theme_finverse/static/src/img/fac1.png" alt="Sarah Jenkins"/>
                            <div class="author-info">
                                <h5 style="color: var(--foreground)">Sarah Jenkins</h5>
                                <span style="color: var(--muted-foreground)">CEO, TechVentures</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 d-flex" data-name="Card">
                    <div class="testimonial-card primary-theme w-100 d-flex flex-column">
                        <div class="stars" style="color: var(--primary-foreground)">
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                        </div>
                        <p class="quote" style="color: var(--primary-foreground); font-weight: 500">
                            "The level of expertise and dedication the team brings is unmatched. They helped us navigate
                            a complex merger with absolute confidence and clarity."
                        </p>
                        <div class="author mt-auto">
                            <img src="/theme_finverse/static/src/img/fac2.jpg" alt="Michael Chen"/>
                            <div class="author-info">
                                <h5 style="color: var(--primary-foreground)">Michael Chen</h5>
                                <span style="color: rgba(255, 255, 255, 0.7)">CFO, Global Nexus</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 d-flex" data-name="Card">
                    <div class="testimonial-card w-100 d-flex flex-column">
                        <div class="stars" style="color: #f59e0b">
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-star" style="font-size: 20px"></span>
                            </div>
                        </div>
                        <p class="quote" style="color: var(--foreground)">
                            "Outstanding service and incredible attention to detail. Finverse's analytics team provided
                            us with a clear picture of our operational inefficiencies."
                        </p>
                        <div class="author mt-auto">
                            <img src="/theme_finverse/static/src/img/fac3.png" alt="Elena Rodriguez"/>
                            <div class="author-info">
                                <h5 style="color: var(--foreground)">Elena Rodriguez</h5>
                                <span style="color: var(--muted-foreground)">VP of Operations, NovaCorp</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
