<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Services List template -->
    <template id="services_list" name="Services List">
        <section class="s_services_list o_colored_level" data-snippet="theme_finverse.services_list">
            <div class="highlights-section" style="padding-top: 40px;">
                <div class="section-header-left" style="margin-bottom: 48px;">
                    <div class="small-pill border-pill" style="margin-bottom: 16px;">WHAT WE DO</div>
                    <h2 class="section-title">Expertise That Drives Growth</h2>
                </div>
                <div class="grid-3">
                    <div class="highlight-card muted-card s_card" data-name="Card" style="min-height: auto;">
                        <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                            <iconify-icon icon="lucide:pie-chart"/>
                        </div>
                        <h3 class="card-title" style="font-size: 22px;">Wealth Management</h3>
                        <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Tailored
                            investment
                            strategies to protect and grow your assets over the long term, adapting seamlessly to
                            changing
                            market conditions.
                        </p>
                        <a href="/contactus"
                           style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                            Learn more
                            <iconify-icon icon="lucide:arrow-right"/>
                        </a>
                    </div>

                    <div class="highlight-card muted-card s_card" data-name="Card" style="min-height: auto;">
                        <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                            <iconify-icon icon="lucide:briefcase"/>
                        </div>
                        <h3 class="card-title" style="font-size: 22px;">Corporate Finance</h3>
                        <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Comprehensive
                            advisory
                            services on capital structuring, mergers and acquisitions, and sustainable enterprise
                            valuation.
                        </p>
                        <a href="/contactus"
                           style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                            Learn more
                            <iconify-icon icon="lucide:arrow-right"/>
                        </a>
                    </div>

                    <div class="highlight-card muted-card s_card" data-name="Card" style="min-height: auto;">
                        <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                            <iconify-icon icon="lucide:bar-chart-2"/>
                        </div>
                        <h3 class="card-title" style="font-size: 22px;">Data Analytics</h3>
                        <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Unlock hidden
                            opportunities in your organization by leveraging predictive analytics and advanced financial
                            modeling techniques.
                        </p>
                        <a href="/contactus"
                           style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                            Learn more
                            <iconify-icon icon="lucide:arrow-right"/>
                        </a>
                    </div>

                    <div class="highlight-card muted-card s_card" data-name="Card" style="min-height: auto;">
                        <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                            <iconify-icon icon="lucide:shield-check"/>
                        </div>
                        <h3 class="card-title" style="font-size: 22px;">Risk Management</h3>
                        <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Identify,
                            evaluate,
                            and mitigate potential business risks before they impact your operational capabilities or
                            financial performance.
                        </p>
                        <a href="/contactus"
                           style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                            Learn more
                            <iconify-icon icon="lucide:arrow-right"/>
                        </a>
                    </div>

                    <div class="highlight-card muted-card s_card" data-name="Card" style="min-height: auto;">
                        <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                            <iconify-icon icon="lucide:cpu"/>
                        </div>
                        <h3 class="card-title" style="font-size: 22px;">Digital Transformation</h3>
                        <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Modernize your
                            legacy
                            financial systems by implementing cutting-edge, secure, and highly scalable cloud
                            architectures.
                        </p>
                        <a href="/contactus"
                           style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                            Learn more
                            <iconify-icon icon="lucide:arrow-right"/>
                        </a>
                    </div>

                    <div class="highlight-card muted-card s_card" data-name="Card" style="min-height: auto;">
                        <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                            <iconify-icon icon="lucide:compass"/>
                        </div>
                        <h3 class="card-title" style="font-size: 22px;">Strategy Consulting</h3>
                        <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Gain actionable
                            insights and long-term strategic roadmaps designed by industry veterans to navigate complex
