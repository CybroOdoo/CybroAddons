<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FAQ Item Template -->
    <template id="contact_faq_item" name="FAQ Item">
        <div t-attf-class="faq-item #{'active' if is_active else ''}" data-snippet="theme_finverse.contact_faq_item">
            <div class="faq-question"
                 style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding: 24px 0; border-bottom: 1px solid var(--border);">
                <span style="font-size: 17px; font-weight: 500;" t-out="question or 'Frequently Asked Question'"/>
                <span t-attf-class="fa #{'fa-chevron-up' if is_active else 'fa-chevron-down'}"
                      style="font-size: 20px; color: var(--foreground); flex-shrink: 0;"></span>
            </div>
            <div class="faq-answer" t-out="answer or 'Answer content goes here.'"/>
        </div>
    </template>
</odoo>
