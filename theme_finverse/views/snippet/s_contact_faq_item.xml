<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet for Contact Faq Item template -->
    <template id="contact_faq_item" name="FAQ Item">
        <div class="faq-item" data-snippet="theme_finverse.contact_faq_item">
            <div class="faq-question"
                 style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding: 24px 0; border-bottom: 1px solid var(--border);">
                <span class="o_editable" style="font-size: 17px; font-weight: 500;">Frequently Asked Question</span>
                <iconify-icon icon="lucide:chevron-down"
                              style="font-size: 20px; color: var(--foreground); flex-shrink: 0;"/>
            </div>
            <div class="faq-answer"
                 style="padding: 16px 0 24px 0; color: var(--muted-foreground); line-height: 1.7; display: none;">
                <p class="o_editable" style="margin: 0;">Answer content goes here.</p>
            </div>
        </div>
    </template>
</odoo>
