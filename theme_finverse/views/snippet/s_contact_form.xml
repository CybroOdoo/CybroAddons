<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Contact Form  -->
    <template id="contact_form" name="Contact Form">
        <section class="contact-section section-container o_colored_level"
                 style="padding: 80px 48px;"
                 data-snippet="theme_finverse.contact_form">

            <!-- Grid: 2 cols on lg+, stacked on mobile -->
            <div class="row g-4 g-lg-5 align-items-start">

                <!-- LEFT: Contact Info -->
                <div class="col-12 col-lg-6 contact-info-container">
                    <div class="small-pill border-pill info-badge"
                         style="width: fit-content; margin-bottom: 24px;">
                        CONTACT US
                    </div>
                    <h2 class="info-main-title"
                        style="font-size: clamp(24px, 4vw, 36px); font-weight: 500; margin-bottom: 16px; line-height: 1.2;">
                        Let's build something exceptional together.
                    </h2>
                    <p class="info-main-desc"
                       style="color: var(--muted-foreground); margin-bottom: 40px; line-height: 1.6;">
                        Whether you have a specific project in mind or just want to
                        explore possibilities, we're here to help you achieve your
                        financial goals.
                    </p>
                    <div class="info-blocks d-flex flex-column gap-3">
                        <div class="info-block d-flex align-items-start gap-3">
                            <div class="info-icon flex-shrink-0"
                                 style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-map-marker"
                                      style="font-size: 24px; color: var(--primary)"/>
                            </div>
                            <div class="info-content">
                                <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 4px;">Global Headquarters
                                </h3>
                                <p class="mb-0">1 World Trade Center, Suite 4500</p>
                                <p class="mb-0">New York, NY 10007</p>
                            </div>
                        </div>
                        <div class="info-block d-flex align-items-start gap-3">
                            <div class="info-icon flex-shrink-0"
                                 style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-map-marker"
                                      style="font-size: 24px; color: var(--primary)"/>
                            </div>
                            <div class="info-content">
                                <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 4px;">EMEA Office</h3>
                                <p class="mb-0">1 Canada Square, Canary Wharf</p>
                                <p class="mb-0">London E14 5AB, United Kingdom</p>
                            </div>
                        </div>
                        <div class="info-block d-flex align-items-start gap-3">
                            <div class="info-icon flex-shrink-0"
                                 style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                <span class="fa fa-phone"
                                      style="font-size: 24px; color: var(--primary)"/>
                            </div>
                            <div class="info-content">
                                <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 4px;">Direct Contact</h3>
                                <p class="mb-0">Toll Free: +1 (800) 123-4567</p>
                                <p class="mb-0">Local: +1 (212) 555-0198</p>
                                <a href="mailto:contact@finverse.com" style="color: var(--primary);">
                                    contact@finverse.com
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: Contact Form -->
                <div class="col-12 col-lg-6">
                    <div class="contact-form-container"
                         style="background: var(--muted); border-radius: 24px; padding: clamp(24px, 5vw, 48px);">
                        <h3 class="form-title"
                            style="font-size: clamp(18px, 3vw, 24px); font-weight: 600; margin-bottom: 8px;">
                            Send us a message
                        </h3>
                        <p class="form-desc" style="color: var(--muted-foreground); margin-bottom: 32px;">
                            Fill out the form below and we'll get back to you within 24 hours.
                        </p>
                        <form action="/website/form/" method="post" enctype="multipart/form-data"
                              class="o_mark_required s_website_form contact-form"
                              data-mark="*" data-model_name="crm.lead"
                              data-success-mode="redirect" data-success-page="/contactus-thank-you">

                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="name" value="Website Contact Form Submission"/>

                            <!-- Name -->
                            <div class="mb-3 s_website_form_field s_website_form_required"
                                 data-type="char" data-name="Field">
                                <label class="form-label s_website_form_label" for="cf_name">
                                    <span class="s_website_form_label_content">Name</span>
                                    <span class="s_website_form_mark">*</span>
                                </label>
                                <input type="text" id="cf_name" name="contact_name"
                                       class="form-control form-input s_website_form_input"
                                       placeholder="e.g. Jane" required="required"/>
                            </div>

                            <!-- Email + Phone: 2 cols on sm+, stacked on xs -->
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6 s_website_form_field s_website_form_required"
                                     data-type="email" data-name="Field">
                                    <label class="form-label s_website_form_label" for="cf_email">
                                        <span class="s_website_form_label_content">Work Email</span>
                                        <span class="s_website_form_mark">*</span>
                                    </label>
                                    <input type="email" id="cf_email" name="email_from"
                                           class="form-control form-input s_website_form_input"
                                           placeholder="jane@company.com" required="required"/>
                                </div>
                                <div class="col-12 col-sm-6 s_website_form_field"
                                     data-type="char" data-name="Field">
                                    <label class="form-label s_website_form_label" for="cf_phone">
                                        <span class="s_website_form_label_content">Phone Number</span>
                                    </label>
                                    <input type="tel" id="cf_phone" name="phone"
                                           class="form-control form-input s_website_form_input"
                                           placeholder="+1 (555) 000-0000"/>
                                </div>
                            </div>

                            <!-- Company -->
                            <div class="mb-3 s_website_form_field" data-type="char" data-name="Field">
                                <label class="form-label s_website_form_label" for="cf_company">
                                    <span class="s_website_form_label_content">Company</span>
                                </label>
                                <input type="text" id="cf_company" name="partner_name"
                                       class="form-control form-input s_website_form_input"
                                       placeholder="Your company name"/>
                            </div>

                            <!-- Message -->
                            <div class="mb-4 s_website_form_field s_website_form_required"
                                 data-type="text" data-name="Field">
                                <label class="form-label s_website_form_label" for="cf_message">
                                    <span class="s_website_form_label_content">How can we help?</span>
                                    <span class="s_website_form_mark">*</span>
                                </label>
                                <textarea id="cf_message" name="description"
                                          class="form-control form-input form-textarea s_website_form_input"
                                          placeholder="Tell us about your project or inquiry..."
                                          required="required" rows="5"/>
                            </div>

                            <!-- Submit -->
                            <div class="s_website_form_submit" data-name="Submit Button">
                                <a href="#" role="button"
                                   class="btn btn-primary w-100 s_website_form_send"
                                   style="text-align: center;">
                                    Send Message
                                </a>
                                <span id="s_website_form_result"/>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </section>
    </template>
</odoo>
