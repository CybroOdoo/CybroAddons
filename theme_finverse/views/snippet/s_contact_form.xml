<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet for Contact Form template -->
    <template id="contact_form" name="Contact Form">
        <section class="s_contact_form o_colored_level" data-snippet="theme_finverse.contact_form">
            <div class="contact-section section-container o_colored_level" style="padding: 80px 48px;">
                <div class="contact-grid">
                    <!-- Contact Info Left Column -->
                    <div class="contact-info-container">
                        <!-- Section Badge -->
                        <div class="small-pill border-pill info-badge" style="width: fit-content; margin-bottom: 24px;">
                            CONTACT US
                        </div>

                        <!-- Main Headline -->
                        <h2 class="info-main-title"
                            style="font-size: 36px; font-weight: 500; margin-bottom: 16px; line-height: 1.2;">
                            Let's build something exceptional together.
                        </h2>
                        <p class="info-main-desc"
                           style="color: var(--muted-foreground); margin-bottom: 40px; line-height: 1.6;">
                            Whether you have a specific project in mind or just want to
                            explore possibilities, we're here to help you achieve your
                            financial goals.
                        </p>

                        <!-- Contact Details Blocks -->
                        <div class="info-blocks">
                            <!-- Headquarters Info -->
                            <div class="info-block">
                                <div class="info-icon">
                                    <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:map-pin"
                                                      style="font-size: 24px; color: var(--primary)"/>
                                    </div>
                                </div>
                                <div class="info-content">
                                    <h3>Global Headquarters</h3>
                                    <p>1 World Trade Center, Suite 4500</p>
                                    <p>New York, NY 10007</p>
                                </div>
                            </div>

                            <!-- EMEA Office Info -->
                            <div class="info-block">
                                <div class="info-icon">
                                    <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:map-pin"
                                                      style="font-size: 24px; color: var(--primary)"/>
                                    </div>
                                </div>
                                <div class="info-content">
                                    <h3>EMEA Office</h3>
                                    <p>1 Canada Square, Canary Wharf</p>
                                    <p>London E14 5AB, United Kingdom</p>
                                </div>
                            </div>

                            <!-- Direct Contact Info -->
                            <div class="info-block">
                                <div class="info-icon">
                                    <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                        <iconify-icon icon="lucide:phone"
                                                      style="font-size: 24px; color: var(--primary)"/>
                                    </div>
                                </div>
                                <div class="info-content">
                                    <h3>Direct Contact</h3>
                                    <p>Toll Free: +1 (800) 123-4567</p>
                                    <a href="mailto:contact@finverse.com" style="color: var(--primary);">
                                        contact@finverse.com
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Form Right Column -->
                    <div class="contact-form-container"
                         style="background: var(--muted); border-radius: 24px; padding: 48px;">
                        <!-- Form Header -->
                        <h3 class="form-title" style="font-size: 24px; font-weight: 600; margin-bottom: 8px;">Send us a
                            message
                        </h3>
                        <p class="form-desc" style="color: var(--muted-foreground); margin-bottom: 32px;">
                            Fill out the form below and we'll get back to you within 24 hours.
                        </p>

                        <form class="s_website_form contact-form" action="/website/form/" method="post"
                              enctype="multipart/form-data" data-model_name="mail.mail"
                              data-success_page="/contactus-thank-you" id="contactForm">
                            <input type="hidden" name="email_to" value="info@finverse.com"/>
                            <input type="hidden" name="subject" value="New Contact Form Submission"/>
                            <div class="form-row">
                                <div class="form-group mb-4 s_website_form_field s_website_form_required s_website_form_custom"
                                     data-type="char" data-name="Field">
                                    <label class="form-label s_website_form_label" style="width: 200px"
                                           for="first_name">
                                        <span class="s_website_form_label_content">First Name</span>
                                    </label>
                                    <input type="text" id="first_name" name="first_name"
                                           class="form-input s_website_form_input"
                                           placeholder="e.g. Jane" required="1"/>
                                </div>
                                <div class="form-group mb-4 s_website_form_field s_website_form_required s_website_form_custom"
                                     data-type="char" data-name="Field">
                                    <label class="form-label s_website_form_label" style="width: 200px" for="last_name">
                                        <span class="s_website_form_label_content">Last Name</span>
                                    </label>
                                    <input type="text" id="last_name" name="last_name"
                                           class="form-input s_website_form_input"
                                           placeholder="e.g. Doe" required="1"/>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group mb-4 s_website_form_field s_website_form_model_required"
                                     data-type="email" data-name="Field">
                                    <label class="form-label s_website_form_label" style="width: 200px" for="email">
                                        <span class="s_website_form_label_content">Work Email</span>
                                    </label>
                                    <input type="email" id="email" name="email_from"
                                           class="form-input s_website_form_input"
                                           placeholder="jane@company.com" required="1"/>
                                </div>
                                <div class="form-group mb-4 s_website_form_field s_website_form_custom" data-type="char"
                                     data-name="Field">
                                    <label class="form-label s_website_form_label" style="width: 200px" for="phone">
                                        <span class="s_website_form_label_content">Phone Number</span>
                                    </label>
                                    <input type="tel" id="phone" name="phone" class="form-input s_website_form_input"
                                           placeholder="+1 (555) 000-0000"/>
                                </div>
                            </div>
                            <div class="form-group mb-4 s_website_form_field s_website_form_custom" data-type="char"
                                 data-name="Field">
                                <label class="form-label s_website_form_label" style="width: 200px" for="company">
                                    <span class="s_website_form_label_content">Company</span>
                                </label>
                                <input type="text" id="company" name="company" class="form-input s_website_form_input"
                                       placeholder="Your company name"/>
                            </div>
                            <div class="form-group mb-4 s_website_form_field s_website_form_required s_website_form_custom"
                                 data-type="text" data-name="Field">
                                <label class="form-label s_website_form_label" style="width: 200px" for="message">
                                    <span class="s_website_form_label_content">How can we help?</span>
                                </label>
                                <textarea id="message" name="description"
                                          class="form-input form-textarea s_website_form_input"
                                          placeholder="Tell us about your project or inquiry..."
                                          required="1"></textarea>
                            </div>
                            <button type="submit" class="nav-pill primary w-100 s_website_form_send" id="submitBtn"
                                    style="border: none;">
                                <span id="btnText">Send Message</span>
                                <div id="btnLoader"
                                     style="display: none; width: 20px; height: 20px; border: 2px solid #ffffff; border-top: 2px solid transparent; border-radius: 50%; animation: spin 1s linear infinite; margin-left: 8px;"></div>
                            </button>
                            <span id="s_website_form_result"></span>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
