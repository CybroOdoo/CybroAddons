<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact Form Template -->
    <template id="contact_form" name="Contact Form">
        <section class="contact-section section-container o_colored_level" style="padding: 80px 48px;"
                 data-snippet="theme_finverse.contact_form">
            <div class="contact-grid"
                 style="grid-template-columns: 1fr 1fr; display: grid; gap: 64px; align-items: start;">
                <!-- Contact Info Left -->
                <div class="contact-info-container">
                    <div class="small-pill border-pill info-badge" style="width: fit-content; margin-bottom: 24px;">
                        CONTACT US
                    </div>
                    <h2 class="info-main-title"
                        style="font-size: 36px; font-weight: 500; margin-bottom: 16px; line-height: 1.2;">
                        Let's build something exceptional together.
                    </h2>
                    <p class="info-main-desc"
                       style="color: var(--muted-foreground); margin-bottom: 40px; line-height: 1.6;">
                        Whether you have a specific project in mind or just want to
                        explore possibilities, we're here to help you achieve your
                        financial goals.
                    </p>
                    <div class="info-blocks">
                        <div class="info-block">
                            <div class="info-icon">
                                <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                    <span class="fa fa-map-marker"
                                          style="font-size: 24px; color: var(--primary)"></span>
                                </div>
                            </div>
                            <div class="info-content">
                                <h3>Global Headquarters</h3>
                                <p>1 World Trade Center, Suite 4500</p>
                                <p>New York, NY 10007</p>
                            </div>
                        </div>
                        <div class="info-block">
                            <div class="info-icon">
                                <div style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                    <span class="fa fa-phone" style="font-size: 24px; color: var(--primary)"></span>
                                </div>
                            </div>
                            <div class="info-content">
                                <h3>Direct Contact</h3>
                                <p>Toll Free: +1 (800) 123-4567</p>
                                <a href="mailto:contact@finverse.com" style="color: var(--primary);">
                                    contact@finverse.com
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Form Right -->
                <div class="contact-form-container"
                     style="background: var(--muted); border-radius: 24px; padding: 48px;">
                    <h3 class="form-title" style="font-size: 24px; font-weight: 600; margin-bottom: 8px;">Send us a
                        message
                    </h3>
                    <p class="form-desc" style="color: var(--muted-foreground); margin-bottom: 32px;">
                        Fill out the form below and we'll get back to you within 24 hours.
                    </p>
                    <form action="/website/form/" method="post" enctype="multipart/form-data"
                          class="o_mark_required s_website_form contact-form" data-mark="*" data-model_name="crm.lead"
                          data-success-mode="redirect" data-success-page="/contactus-thank-you">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="name" value="Website Contact Form Submission"/>
                        <div class="form-row">
                            <div class="form-group s_website_form_field s_website_form_required" data-type="char"
                                 data-name="Field">
                                <label class="form-label s_website_form_label" for="cf_name">
                                    <span class="s_website_form_label_content">Full Name</span>
                                    <span class="s_website_form_mark">*</span>
                                </label>
                                <input type="text" id="cf_name" name="contact_name"
                                       class="form-input s_website_form_input" placeholder="e.g. Jane Doe"
                                       required="required"/>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group s_website_form_field s_website_form_required" data-type="email"
                                 data-name="Field">
                                <label class="form-label s_website_form_label" for="cf_email">
                                    <span class="s_website_form_label_content">Work Email</span>
                                    <span class="s_website_form_mark">*</span>
                                </label>
                                <input type="email" id="cf_email" name="email_from"
                                       class="form-input s_website_form_input" placeholder="jane@company.com"
                                       required="required"/>
                            </div>
                        </div>
                        <div class="form-group s_website_form_field s_website_form_required" data-type="text"
                             data-name="Field">
                            <label class="form-label s_website_form_label" for="cf_message">
                                <span class="s_website_form_label_content">Message</span>
                                <span class="s_website_form_mark">*</span>
                            </label>
                            <textarea id="cf_message" name="description"
                                      class="form-input form-textarea s_website_form_input"
                                      placeholder="Tell us about your project..." required="required"/>
                        </div>
                        <div class="s_website_form_submit" data-name="Submit Button">
                            <a href="#" role="button" class="btn btn-primary btn-full s_website_form_send"
                               style="display: block; text-align: center; width: 100%;">Send Message
                            </a>
                            <span id="s_website_form_result"/>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </template>
</odoo>
