<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet team template -->
    <template id="team" name="Team">
        <section class="team-section" data-snippet="theme_finverse.team">
            <div class="team-header">
                <div>
                    <div class="small-pill border-pill" style="margin-bottom: 16px">LEADERSHIP</div>
                    <h2 class="section-title" style="font-size: 44px; font-weight: 500; line-height: 1.2; margin: 0;">
                        Meet Our Experts
                    </h2>
                </div>
                <a href="/jobs" class="outline-btn text-decoration-none text-dark" data-media-type="banani-button">Join
                    Our Team
                </a>
            </div>
            <div class="row g-4 d-flex align-items-stretch">

                <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                    <div class="team-card w-100 d-flex flex-column">
                        <img src="https://storage.googleapis.com/banani-avatars/avatar%2Fmale%2F50-65%2FEuropean%2F1"
                             class="team-image" alt="Jameson Clark"/>
                        <h4>Jameson Clark</h4>
                        <p class="team-role">Chief Executive Officer</p>
                        <div class="team-socials mt-auto">
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                 data-media-type="banani-button">
                                <span class="fa fa-linkedin" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                 data-media-type="banani-button">
                                <span class="fa fa-twitter" style="font-size: 20px"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                    <div class="team-card w-100 d-flex flex-column">
                        <img src="https://storage.googleapis.com/banani-avatars/avatar%2Ffemale%2F35-50%2FNorth%20American%2F2"
                             class="team-image" alt="Sarah Jenkins"/>
                        <h4>Sarah Jenkins</h4>
                        <p class="team-role">Chief Financial Officer</p>
                        <div class="team-socials mt-auto">
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                 data-media-type="banani-button">
                                <span class="fa fa-linkedin" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                 data-media-type="banani-button">
                                <span class="fa fa-twitter" style="font-size: 20px"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                    <div class="team-card w-100 d-flex flex-column">
                        <img src="https://storage.googleapis.com/banani-avatars/avatar%2Fmale%2F35-50%2FEast%20Asian%2F3"
                             class="team-image" alt="David Chen"/>
                        <h4>David Chen</h4>
                        <p class="team-role">Chief Operating Officer</p>
                        <div class="team-socials mt-auto">
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                 data-media-type="banani-button">
                                <span class="fa fa-linkedin" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                 data-media-type="banani-button">
                                <span class="fa fa-twitter" style="font-size: 20px"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                    <div class="team-card w-100 d-flex flex-column">
                        <img src="https://storage.googleapis.com/banani-avatars/avatar%2Ffemale%2F25-35%2FAfrican%2F4"
                             class="team-image" alt="Amara Okafor"/>
                        <h4>Amara Okafor</h4>
                        <p class="team-role">Head of Analytics</p>
                        <div class="team-socials mt-auto">
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                 data-media-type="banani-button">
                                <span class="fa fa-linkedin" style="font-size: 20px"></span>
                            </div>
                            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                 data-media-type="banani-button">
                                <span class="fa fa-twitter" style="font-size: 20px"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </template>
</odoo>
