<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Team Template -->
    <template id="team" name="Team">
        <section class="s_team o_colored_level" data-snippet="theme_finverse.team">
            <div class="team-section">
                <div class="team-header">
                    <div>
                        <div class="small-pill border-pill" style="margin-bottom: 16px">LEADERSHIP</div>
                        <h2 class="section-title"
                            style="font-size: 44px; font-weight: 500; line-height: 1.2; margin: 0;">
                            Meet Our Experts
                        </h2>
                    </div>
                    <a href="/jobs" class="outline-btn text-decoration-none text-dark" data-media-type="banani-button">
                        Join
                        Our Team
                    </a>
                </div>
                <div class="team-grid">

                    <div class="team-card s_card" data-name="Card">
                        <img src="https://storage.googleapis.com/banani-avatars/avatar%2Fmale%2F50-65%2FEuropean%2F1"
                             class="team-image" alt="Jameson Clark"/>
                        <h4>Jameson Clark</h4>
                        <p class="team-role">Chief Executive Officer</p>
                        <div class="team-socials">
                            <a href="/website/social/linkedin"
                               style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;"
                               target="_blank" aria-label="LinkedIn">
                                <i class="fa fa-linkedin o_editable_media" style="font-size: 20px;"/>
                            </a>
                            <a href="/website/social/twitter"
                               style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;"
                               target="_blank" aria-label="X">
                                <i class="fa fa-twitter o_editable_media" style="font-size: 20px;"/>
                            </a>
                        </div>
                    </div>

                    <div class="team-card s_card" data-name="Card">
                        <img src="https://storage.googleapis.com/banani-avatars/avatar%2Ffemale%2F35-50%2FNorth%20American%2F2"
                             class="team-image" alt="Sarah Jenkins"/>
                        <h4>Sarah Jenkins</h4>
                        <p class="team-role">Chief Financial Officer</p>
                        <div class="team-socials">
                            <a href="/website/social/linkedin"
                               style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;"
                               target="_blank" aria-label="LinkedIn">
                                <i class="fa fa-linkedin o_editable_media" style="font-size: 20px;"/>
                            </a>
                            <a href="/website/social/twitter"
                               style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;"
                               target="_blank" aria-label="X">
                                <i class="fa fa-twitter o_editable_media" style="font-size: 20px;"/>
                            </a>
                        </div>
                    </div>

                    <div class="team-card s_card" data-name="Card">
                        <img src="https://storage.googleapis.com/banani-avatars/avatar%2Fmale%2F35-50%2FEast%20Asian%2F3"
                             class="team-image" alt="David Chen"/>
                        <h4>David Chen</h4>
                        <p class="team-role">Chief Operating Officer</p>
                        <div class="team-socials">
                            <a href="/website/social/linkedin"
                               style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;"
                               target="_blank" aria-label="LinkedIn">
                                <i class="fa fa-linkedin o_editable_media" style="font-size: 20px;"/>
                            </a>
                            <a href="/website/social/twitter"
                               style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;"
                               target="_blank" aria-label="X">
                                <i class="fa fa-twitter o_editable_media" style="font-size: 20px;"/>
                            </a>
                        </div>
