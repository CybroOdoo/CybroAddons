<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Snippet for Contact template -->
    <template id="s_contact" name="S Contact">
        <section class="s_s_contact o_colored_level" data-snippet="theme_finverse.s_contact">
            <div id="contact" class="contact-section o_colored_level">
                <div class="contact-grid">
                    <div class="contact-form-container">
                        <div class="small-pill border-pill info-badge" style="width: fit-content; margin-bottom: 16px">
                            GET IN TOUCH
                        </div>
                        <h2 class="form-title">Let's Start Your Success Story</h2>
                        <p class="form-desc">
                            Ready to transform your financial strategy? Our experts are here to help you navigate
                            challenges
                            and seize opportunities.
                        </p>
                        <form class="contact-form" id="contactForm">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="firstName" class="form-label">First Name</label>
                                    <input type="text" id="firstName" name="firstName" class="form-input"
                                           placeholder="John" required="1"/>
                                </div>
                                <div class="form-group">
                                    <label for="lastName" class="form-label">Last Name</label>
                                    <input type="text" id="lastName" name="lastName" class="form-input"
                                           placeholder="Doe" required="1"/>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="email" class="form-label">Email Address</label>
                                    <input type="email" id="email" name="email" class="form-input"
                                           placeholder="john@company.com" required="1"/>
                                </div>
                                <div class="form-group">
                                    <label for="phone" class="form-label">Phone Number</label>
                                    <input type="tel" id="phone" name="phone" class="form-input"
                                           placeholder="+1 (555) 123-4567"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="company" class="form-label">Company</label>
                                <input type="text" id="company" name="company" class="form-input"
                                       placeholder="Your Company Name"/>
                            </div>
                            <div class="form-group">
                                <label for="message" class="form-label">Message</label>
                                <textarea id="message" name="message" class="form-input form-textarea"
                                          placeholder="Tell us about your financial goals and challenges..."
                                          required="1"/>
                            </div>
                            <button type="submit" class="btn btn-primary btn-full" id="submitBtn">
                                <span id="btnText">Send Message</span>
                                <div id="btnLoader"
                                     style="display: none; width: 20px; height: 20px; border: 2px solid #ffffff; border-top: 2px solid transparent; border-radius: 50%; animation: spin 1s linear infinite; margin-left: 8px;"/>
                            </button>
                        </form>
                    </div>
                    <div class="contact-info-container">
                        <div class="info-main-title">Why Choose Finverse?</div>
                        <p class="info-main-desc">
                            With over 25 years of combined experience, we deliver personalized financial strategies that
                            drive real results for businesses of all sizes.
                        </p>
                        <div class="info-blocks">
                            <div class="info-block">
                                <div class="info-icon">
                                    <iconify-icon icon="lucide:clock" style="font-size: 24px; color: var(--primary)"/>
                                </div>
                                <div class="info-content">
                                    <h3>Quick Response</h3>
                                    <p>We respond to all inquiries within 24 hours</p>
                                </div>
                            </div>
                            <div class="info-block">
                                <div class="info-icon">
                                    <iconify-icon icon="lucide:shield-check"
                                                  style="font-size: 24px; color: var(--primary)"/>
                                </div>
                                <div class="info-content">
                                    <h3>Confidential &amp; Secure</h3>
                                    <p>Your information is protected with enterprise-grade security</p>
                                </div>
                            </div>
                            <div class="info-block">
                                <div class="info-icon">
                                    <iconify-icon icon="lucide:users" style="font-size: 24px; color: var(--primary)"/>
                                </div>
                                <div class="info-content">
                                    <h3>Expert Team</h3>
                                    <p>Work directly with certified financial consultants</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </template>
</odoo>