<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Contact -->
    <template id="s_contact" name="S Contact">
        <section id="contact" class="contact-section o_colored_level" data-snippet="theme_finverse.s_contact">
            <div class="contact-grid">
                <div class="contact-form-container">
                    <div class="small-pill border-pill info-badge" style="width: fit-content; margin-bottom: 16px">
                        GET IN TOUCH
                    </div>
                    <h2 class="form-title">Let's Start Your Success Story</h2>
                    <p class="form-desc">
                        Ready to transform your financial strategy? Our experts are here to help you navigate challenges
                        and seize opportunities.
                    </p>
                    <form action="/website/form/" method="post" enctype="multipart/form-data"
                          class="o_mark_required s_website_form contact-form" data-mark="*" data-model_name="crm.lead"
                          data-success-mode="redirect" data-success-page="/contactus-thank-you"
                          data-success_page="/contactus-thank-you">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="name" value="Website Contact Form Submission (Quick Contact)"/>
                        <div class="form-row">
                            <div class="form-group s_website_form_field s_website_form_required" data-type="char"
                                 data-name="Field">
                                <label for="firstName" class="form-label s_website_form_label">
                                    <span class="s_website_form_label_content">First Name</span>
                                    <span class="s_website_form_mark">*</span>
                                </label>
                                <input type="text" id="firstName" name="contact_name"
                                       class="form-input s_website_form_input" placeholder="John" required="required"/>
                            </div>
                            <div class="form-group s_website_form_field s_website_form_required" data-type="char"
                                 data-name="Field">
                                <label for="lastName" class="form-label s_website_form_label">
                                    <span class="s_website_form_label_content">Last Name</span>
                                    <span class="s_website_form_mark">*</span>
                                </label>
                                <input type="text" id="lastName" name="partner_name"
                                       class="form-input s_website_form_input" placeholder="Doe" required="required"/>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group s_website_form_field s_website_form_required" data-type="email"
                                 data-name="Field">
                                <label for="email" class="form-label s_website_form_label">
                                    <span class="s_website_form_label_content">Email Address</span>
                                    <span class="s_website_form_mark">*</span>
                                </label>
                                <input type="email" id="email" name="email_from" class="form-input s_website_form_input"
                                       placeholder="john@company.com" required="required"/>
                            </div>
                            <div class="form-group s_website_form_field" data-type="tel" data-name="Field">
                                <label for="phone" class="form-label s_website_form_label">
                                    <span class="s_website_form_label_content">Phone Number</span>
                                </label>
                                <input type="tel" id="phone" name="phone" class="form-input s_website_form_input"
                                       placeholder="+1 (555) 123-4567"/>
                            </div>
                        </div>
                        <div class="form-group s_website_form_field" data-type="char" data-name="Field">
                            <label for="company" class="form-label s_website_form_label">
                                <span class="s_website_form_label_content">Company</span>
                            </label>
                            <input type="text" id="company" name="company_name" class="form-input s_website_form_input"
                                   placeholder="Your Company Name"/>
                        </div>
                        <div class="form-group s_website_form_field s_website_form_required" data-type="text"
                             data-name="Field">
                            <label for="message" class="form-label s_website_form_label">
                                <span class="s_website_form_label_content">Message</span>
                                <span class="s_website_form_mark">*</span>
                            </label>
                            <textarea id="message" name="description"
                                      class="form-input form-textarea s_website_form_input"
                                      placeholder="Tell us about your financial goals and challenges..."
                                      required="required"/>
                        </div>
                        <div class="s_website_form_submit" data-name="Submit Button">
                            <a href="#" role="button" class="btn btn-primary btn-full s_website_form_send"
                               style="display: block; text-align: center; width: 100%;">Send Message
                            </a>
                            <span id="s_website_form_result"/>
                        </div>
                    </form>
                </div>
                <div class="contact-info-container">
                    <div class="info-main-title">Why Choose Finverse?</div>
                    <p class="info-main-desc">
                        With over 25 years of combined experience, we deliver personalized financial strategies that
                        drive real results for businesses of all sizes.
                    </p>
                    <div class="info-blocks">
                        <div class="info-block">
                            <div class="info-icon">
                                <span class="fa fa-clock-o" style="font-size: 24px; color: var(--primary)"></span>
                            </div>
                            <div class="info-content">
                                <h3>Quick Response</h3>
                                <p>We respond to all inquiries within 24 hours</p>
                            </div>
                        </div>
                        <div class="info-block">
                            <div class="info-icon">
                                <span class="fa fa-shield" style="font-size: 24px; color: var(--primary)"></span>
                            </div>
                            <div class="info-content">
                                <h3>Confidential &amp; Secure</h3>
                                <p>Your information is protected with enterprise-grade security</p>
                            </div>
                        </div>
                        <div class="info-block">
                            <div class="info-icon">
                                <span class="fa fa-users" style="font-size: 24px; color: var(--primary)"></span>
                            </div>
                            <div class="info-content">
                                <h3>Expert Team</h3>
                                <p>Work directly with certified financial consultants</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </template>
</odoo>
