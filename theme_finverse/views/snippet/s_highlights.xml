<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet Highlights template -->
    <template id="highlights" name="Highlights">
        <section class="highlights-section" data-snippet="theme_finverse.highlights">
            <div class="row g-4 d-flex align-items-stretch">
                <div class="col-lg-4 col-md-6 d-flex" data-name="Card">
                    <div class="highlight-card muted-card w-100">
                        <div class="card-header">
                            <div class="small-pill border-pill">WHO WE ARE</div>
                            <div class="icon-btn white-btn" data-media-type="banani-button">
                                <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                    <span class="fa fa-arrow-right" style="font-size: 20px; color: #111827"></span>
                                </div>
                            </div>
                        </div>
                        <h3 class="card-title">
                            Leading Provider of Analytics and Financial Services
                        </h3>
                        <p style="color: var(--muted-foreground); font-size: 15px; margin-bottom: 32px; line-height: 1.6; max-width: 90%;">
                            Our comprehensive suite of analytical tools empowers decision
                            makers with actionable insights, reducing risk and accelerating
                            sustainable growth.
                        </p>
                        <div class="card-image-wrapper">
                            <img class="card-image" alt="Team working"
                                 src="/theme_finverse/static/src/img/a71c4dd4-4b26-41d9-a72b-a2262ad55ff5.jpg"/>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 d-flex" data-name="Card">
                    <div class="highlight-card primary-card w-100">
                        <div class="primary-card-content">
                            <div class="primary-image-area">
                                <img alt="Handshake"
                                     src="/theme_finverse/static/src/img/3d94cb14-aeb6-4c32-ad3a-2c6ca0022ae3.jpg"/>
                            </div>
                            <div>
                                <div class="small-pill border-pill dark-text">
                                    RECOGNITION
                                </div>
                            </div>
                            <div class="primary-bottom-row">
                                <h3 class="card-title" style="margin: 0">
                                    Finverse Consulting Named a Agentforce Partner
                                </h3>
                                <div class="icon-btn white-btn" data-media-type="banani-button" style="flex-shrink: 0">
                                    <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                        <span class="fa fa-arrow-right" style="font-size: 20px; color: #111827"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 d-flex" data-name="Card">
                    <div class="highlight-card muted-card w-100">
                        <div class="card-header">
                            <div class="small-pill border-pill">REPORT</div>
                            <div class="icon-btn white-btn" data-media-type="banani-button">
                                <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">
                                    <span class="fa fa-arrow-right" style="font-size: 20px; color: #111827"></span>
                                </div>
                            </div>
                        </div>
                        <h3 class="card-title">
                            2026 Diversity, Equity, and Inclusion Report
                        </h3>
                        <p style="color: var(--muted-foreground); font-size: 15px; margin-bottom: 32px; line-height: 1.6; max-width: 90%;">
                            Explore our ongoing commitment to fostering an inclusive
                            workplace and driving equitable outcomes across the industry
                            globally.
                        </p>
                        <div class="card-image-wrapper">
                            <img class="card-image" alt="Report cover"
                                 src="/theme_finverse/static/src/img/8b4cfa71-6ee3-4d5c-b724-3319eef74b18.jpg"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
