<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- template Services Page-->
    <template id="services_page_view" name="Services Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="page-container" style="padding-bottom: 0;">
                    <!-- HERO SECTION -->
                    <section class="hero-section"
                             style="height: 500px; background-image: url('/theme_finverse/static/src/img/8a64e569-3bde-482c-9af1-e505d850e140.jpg'); background-size: cover; background-position: center;"
                             data-snippet="theme_finverse.services_hero">
                        <div class="hero-overlay" style="pointer-events: none;"></div>
                        <div class="hero-content" style="margin-top: 100px">
                            <h1 class="hero-title">Our Services</h1>
                            <p style="color: rgba(255, 255, 255, 0.9); font-size: 20px; max-width: 600px; margin: 0; line-height: 1.6;">
                                Comprehensive financial strategies and data-driven solutions designed to accelerate your
                                business growth and secure your financial future.
                            </p>
                        </div>
                    </section>

                    <!-- MAIN SERVICES -->
                    <section class="highlights-section" style="padding-top: 40px;"
                             data-snippet="theme_finverse.services_list">
                        <div class="section-header-left" style="margin-bottom: 48px;">
                            <div class="small-pill border-pill" style="margin-bottom: 16px;">WHAT WE DO</div>
                            <h2 class="section-title">Expertise That Drives Growth</h2>
                        </div>

                        <div class="grid-3">
                            <div class="highlight-card muted-card" style="min-height: auto;">
                                <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                                    <iconify-icon icon="lucide:pie-chart"></iconify-icon>
                                </div>
                                <h3 class="card-title" style="font-size: 22px;">Wealth Management</h3>
                                <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Tailored
                                    investment strategies to protect and grow your assets over the long term, adapting
                                    seamlessly to changing market conditions.
                                </p>
                                <a href="/contactus"
                                   style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                    Learn more
                                    <iconify-icon icon="lucide:arrow-right"></iconify-icon>
                                </a>
                            </div>
                            <div class="highlight-card muted-card" style="min-height: auto;">
                                <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                                    <iconify-icon icon="lucide:briefcase"></iconify-icon>
                                </div>
                                <h3 class="card-title" style="font-size: 22px;">Corporate Finance</h3>
                                <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">
                                    Comprehensive advisory services on capital structuring, mergers and acquisitions,
                                    and sustainable enterprise valuation.
                                </p>
                                <a href="/contactus"
                                   style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                    Learn more
                                    <iconify-icon icon="lucide:arrow-right"></iconify-icon>
                                </a>
                            </div>
                            <div class="highlight-card muted-card" style="min-height: auto;">
                                <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                                    <iconify-icon icon="lucide:bar-chart-2"></iconify-icon>
                                </div>
                                <h3 class="card-title" style="font-size: 22px;">Data Analytics</h3>
                                <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Unlock
                                    hidden opportunities in your organization by leveraging predictive analytics and
                                    advanced financial modeling techniques.
                                </p>
                                <a href="/contactus"
                                   style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                    Learn more
                                    <iconify-icon icon="lucide:arrow-right"></iconify-icon>
                                </a>
                            </div>
                            <div class="highlight-card muted-card" style="min-height: auto;">
                                <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                                    <iconify-icon icon="lucide:shield-check"></iconify-icon>
                                </div>
                                <h3 class="card-title" style="font-size: 22px;">Risk Management</h3>
                                <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Identify,
                                    evaluate, and mitigate potential business risks before they impact your operational
                                    capabilities or financial performance.
                                </p>
                                <a href="/contactus"
                                   style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                    Learn more
                                    <iconify-icon icon="lucide:arrow-right"></iconify-icon>
                                </a>
                            </div>
                            <div class="highlight-card muted-card" style="min-height: auto;">
                                <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                                    <iconify-icon icon="lucide:cpu"></iconify-icon>
                                </div>
                                <h3 class="card-title" style="font-size: 22px;">Digital Transformation</h3>
                                <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Modernize
                                    your legacy financial systems by implementing cutting-edge, secure, and highly
                                    scalable cloud architectures.
                                </p>
                                <a href="/contactus"
                                   style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                    Learn more
                                    <iconify-icon icon="lucide:arrow-right"></iconify-icon>
                                </a>
                            </div>
                            <div class="highlight-card muted-card" style="min-height: auto;">
                                <div class="icon-btn primary" style="margin-bottom: 24px; font-size: 20px;">
                                    <iconify-icon icon="lucide:compass"></iconify-icon>
                                </div>
                                <h3 class="card-title" style="font-size: 22px;">Strategy Consulting</h3>
                                <p style="color: var(--muted-foreground); margin-bottom: 24px; flex-grow: 1;">Gain
                                    actionable insights and long-term strategic roadmaps designed by industry veterans
                                    to navigate complex market expansions.
                                </p>
                                <a href="/contactus"
                                   style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                    Learn more
                                    <iconify-icon icon="lucide:arrow-right"></iconify-icon>
                                </a>
                            </div>
                        </div>
                    </section>

                    <!-- OUR APPROACH -->
                    <section class="why-section"
                             style="background-color: var(--muted); border-radius: 40px; margin: 32px 16px;"
                             data-snippet="theme_finverse.approach">
                        <div class="why-content">
                            <div class="small-pill border-pill" style="margin-bottom: 24px; background: #fff;">OUR
                                APPROACH
                            </div>
                            <h2>A Proven Methodology for Success</h2>
                            <p>We believe in a structured, data-informed approach to solving complex financial
                                challenges. Our methodical process ensures measurable and sustained results.
                            </p>
                        </div>
                        <div class="features-list">
                            <div class="feature-item">
                                <div class="feature-icon" style="background:#fff;">
                                    <span style="font-size: 20px; font-weight:700;">01</span>
                                </div>
                                <div class="feature-text">
                                    <h4>Discovery</h4>
                                    <p>We perform a deep dive into your current financial health, market positioning,
                                        and core business objectives.
                                    </p>
                                </div>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon" style="background:#fff;">
                                    <span style="font-size: 20px; font-weight:700;">02</span>
                                </div>
                                <div class="feature-text">
                                    <h4>Strategy</h4>
                                    <p>Our experts develop a comprehensive, custom-tailored financial plan aligned
                                        perfectly with your goals.
                                    </p>
                                </div>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon" style="background:#fff;">
                                    <span style="font-size: 20px; font-weight:700;">03</span>
                                </div>
                                <div class="feature-text">
                                    <h4>Execution</h4>
                                    <p>We work closely with your internal teams to deploy solutions seamlessly and
                                        effectively across all operations.
                                    </p>
                                </div>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon" style="background:#fff;">
                                    <span style="font-size: 20px; font-weight:700;">04</span>
                                </div>
                                <div class="feature-text">
                                    <h4>Optimization</h4>
                                    <p>Through continuous review and refinement, we ensure your strategies adapt and
                                        scale as your business grows.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- CASES -->
                    <section class="highlights-section" style="padding: 80px 48px;" data-snippet="theme_finverse.cases">
                        <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:16px; margin-bottom: 48px;">
                            <div>
                                <div class="small-pill border-pill" style="margin-bottom: 16px;">SUCCESS STORIES</div>
                                <h2 class="section-title" style="margin:0;">Proven Results in Action</h2>
                            </div>
                            <div class="nav-pill" style="border: 1px solid var(--border); color: var(--foreground);">
                                View All Cases
                            </div>
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
                            <div class="highlight-card muted-card" style="padding:0; overflow:hidden;">
                                <img src="/theme_finverse/static/src/img/63235fb3-b856-4d8d-bda9-46d728283c26.jpg"
                                     style="width:100%; height:320px; object-fit:cover;" alt="Case 1"/>
                                <div style="padding: 32px;">
                                    <div style="display:flex; gap:8px; margin-bottom:16px;">
                                        <span class="small-pill border-pill" style="font-size: 10px;">REAL ESTATE</span>
                                        <span class="small-pill border-pill" style="font-size: 10px;">CORPORATE
                                            FINANCE
                                        </span>
                                    </div>
                                    <h3 class="card-title">Structuring a $400M Sustainable Infrastructure Fund</h3>
                                    <p style="color: var(--muted-foreground); margin-bottom: 24px;">How we helped a
                                        leading real estate developer optimize their capital stack and secure funding
                                        for nationwide eco-friendly commercial projects.
                                    </p>
                                    <a href="#"
                                       style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                        Read Case Study
                                        <iconify-icon icon="lucide:arrow-right"></iconify-icon>
                                    </a>
                                </div>
                            </div>
                            <div class="highlight-card muted-card" style="padding:0; overflow:hidden;">
                                <img src="/theme_finverse/static/src/img/844b7754-38db-4922-8316-458b1cfd33d2.jpg"
                                     style="width:100%; height:320px; object-fit:cover;" alt="Case 2"/>
                                <div style="padding: 32px;">
                                    <div style="display:flex; gap:8px; margin-bottom:16px;">
                                        <span class="small-pill border-pill" style="font-size: 10px;">TECHNOLOGY</span>
                                        <span class="small-pill border-pill" style="font-size: 10px;">DATA ANALYTICS
                                        </span>
                                    </div>
                                    <h3 class="card-title">Driving 35% Revenue Growth Through Predictive Analytics</h3>
                                    <p style="color: var(--muted-foreground); margin-bottom: 24px;">We implemented an
                                        advanced machine learning financial model that allowed a global SaaS provider to
                                        accurately forecast churn and maximize customer lifetime value.
                                    </p>
                                    <a href="#"
                                       style="color: var(--primary); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                        Read Case Study
                                        <iconify-icon icon="lucide:arrow-right"></iconify-icon>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>
            </div>
        </t>
    </template>

    <record id="services_page" model="theme.website.page">
        <field name="url">/services</field>
        <field name="view_id" ref="services_page_view"/>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
