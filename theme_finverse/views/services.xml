<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service Template -->
    <template id="services_page_template" name="Services Page">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">
                    <t t-call="theme_finverse.services_hero"/>
                </div>
                <div class="oe_structure">
                    <t t-call="theme_finverse.services_list"/>
                </div>
                <div class="oe_structure">
                    <t t-call="theme_finverse.approach"/>
                </div>
                <div class="oe_structure">
                    <section class="section-container o_colored_level"
                             style="background: var(--muted); padding: 100px 48px;">
                        <div class="section-header"
                             style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 64px;">
                            <div style="max-width: 600px;">
                                <div class="small-pill border-pill" style="margin-bottom: 16px;">SUCCESS STORIES</div>
                                <h2 class="section-title" style="margin:0;">Proven Results in Action</h2>
                            </div>
                            <a href="/insights" class="nav-pill text-decoration-none"
                               style="border: 1px solid var(--border); color: var(--foreground);">View All Cases
                            </a>
                        </div>
                        <div class="row g-4 d-flex align-items-stretch">
                            <div class="col-lg-6 col-md-6 d-flex" data-name="Card">
                                <div class="highlight-card muted-card w-100" style="padding:0; overflow:hidden;">
                                    <div style="position: relative; height: 240px;">
                                        <img src="/theme_finverse/static/src/img/fac1.png"
                                             style="width:100%; height:100%; object-fit:cover;" alt="Case 1"/>
                                        <div class="small-pill border-pill"
                                             style="position:absolute; top:20px; left:20px; background:rgba(255,255,255,0.9);">
                                            FINTECH
                                        </div>
                                    </div>
                                    <div style="padding: 32px;">
                                        <h3 style="font-size: 20px; font-weight: 600; margin-bottom: 12px;">Global
                                            Digital Transformation for NeoBank
                                        </h3>
                                        <p style="color: var(--muted-foreground); font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
                                            Helping a leading digital bank scale their operations across 12 new markets
                                            while maintain security.
                                        </p>
                                        <a href="#"
                                           style="color: var(--primary); text-decoration:none; font-weight:500; display:flex; align-items:center; gap:8px;">
                                            Read Case Study
                                            <span class="fa fa-arrow-right" style="font-size:18px;"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 d-flex" data-name="Card">
                                <div class="highlight-card muted-card w-100" style="padding:0; overflow:hidden;">
                                    <div style="position: relative; height: 240px;">
                                        <img src="/theme_finverse/static/src/img/fac2.jpg"
                                             style="width:100%; height:100%; object-fit:cover;" alt="Case 2"/>
                                        <div class="small-pill border-pill"
                                             style="position:absolute; top:20px; left:20px; background:rgba(255,255,255,0.9);">
                                            STRATEGY
                                        </div>
                                    </div>
                                    <div style="padding: 32px;">
                                        <h3 style="font-size: 20px; font-weight: 600; margin-bottom: 12px;">Sustainable
                                            Growth Strategy for Retail Giant
                                        </h3>
                                        <p style="color: var(--muted-foreground); font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
                                            Developed a 5-year roadmap focusing on operational efficiency and market
                                            expansion.
                                        </p>
                                        <a href="#"
                                           style="color: var(--primary); text-decoration:none; font-weight:500; display:flex; align-items:center; gap:8px;">
                                            Read Case Study
                                            <span class="fa fa-arrow-right" style="font-size:18px;"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="oe_structure">
                    <t t-call="theme_finverse.cases"/>
                </div>
            </div>
        </t>
    </template>

    <record id="services_page" model="theme.website.page">
        <field name="url">/services</field>
        <field name="view_id" ref="services_page_template"/>
        <field name="is_published">True</field>
    </record>
</odoo>
