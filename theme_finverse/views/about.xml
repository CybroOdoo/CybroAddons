<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme template for about template -->
    <template id="about" name="About Us">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="page-container" style="padding-bottom: 0;">
                    <!-- SUBPAGE HERO SECTION -->
                    <section class="hero-section oe_img_bg oe_custom_bg" style="height: 500px; background-image: url('/theme_finverse/static/src/img/a043d831-58e2-4bec-a972-48d9fe3f9d91.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat;" data-snippet="theme_finverse.about_hero">
                        <div class="hero-overlay"></div>

                        <div class="hero-content" style="margin-top: 100px">
                            <h1 class="hero-title">About Us</h1>
                            <p style="color: rgba(255, 255, 255, 0.9); font-size: 20px; max-width: 600px; margin: 0; line-height: 1.6;">
                                We are a collective of financial strategists, data scientists, and
                                industry experts dedicated to redefining how businesses grow and
                                thrive globally.
                            </p>
                        </div>
                    </section>

                    <!-- OUR STORY SECTION -->
                    <section class="story-section" data-snippet="theme_finverse.about_story">
                        <div class="story-image">
                            <img data-query="Diverse group of business professionals in a modern boardroom" data-aspect-ratio="4:3"
                                alt="Team working together"
                                src="/theme_finverse/static/src/img/1bba0dd8-a266-44a5-9135-5c1373f74cbb.jpg" />
                        </div>
                        <div class="story-content">
                            <div class="small-pill border-pill" style="margin-bottom: 24px">OUR STORY</div>
                            <h2>Pioneering Financial Excellence Since 1999</h2>
                            <p>
                                Founded on the principles of integrity and continuous innovation,
                                Finverse has evolved from a boutique advisory firm into a global
                                leader in comprehensive financial consulting and data analytics.
                            </p>
                            <div class="mission-vision-grid">
                                <div>
                                    <h4>Our Mission</h4>
                                    <p class="text-muted">
                                        To deliver unparalleled strategic insights that drive
                                        sustainable and scalable success.
                                    </p>
                                </div>
                                <div>
                                    <h4>Our Vision</h4>
                                    <p class="text-muted">
                                        To be the world's most trusted partner in meaningful business
                                        and financial transformation.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- STATS SECTION -->
                    <section class="stats-section" data-snippet="theme_finverse.stats">
                        <div class="stat-item">
                            <div class="stat-number">$50B+</div>
                            <div class="stat-label">Assets Managed</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">25+</div>
                            <div class="stat-label">Years of Experience</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">250+</div>
                            <div class="stat-label">Financial Experts</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">30+</div>
                            <div class="stat-label">Global Offices</div>
                        </div>
                    </section>

                    <!-- VALUES SECTION -->
                    <section class="values-section" data-snippet="theme_finverse.about_values">
                        <div class="section-header" style="text-align: center; margin-bottom: 64px">
                            <div class="small-pill border-pill center-pill" style="background: #ffffff; margin: 0 auto 24px auto">CORE VALUES</div>
                            <h2 class="section-title" style="font-size: 44px; font-weight: 500; line-height: 1.2">The Principles That Guide Us</h2>
                        </div>
                        <div class="row g-4 d-flex align-items-stretch">
                            <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                                <div class="value-card w-100">
                                    <div class="value-icon"><span class="fa fa-shield" style="font-size: 32px"></span></div>
                                    <h4>Integrity</h4>
                                    <p>We operate with absolute transparency and uphold the highest ethical standards in all our dealings.</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                                <div class="value-card w-100">
                                    <div class="value-icon"><span class="fa fa-lightbulb-o" style="font-size: 32px"></span></div>
                                    <h4>Innovation</h4>
                                    <p>We continuously seek new ways to leverage data and technology to stay ahead of market trends.</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                                <div class="value-card w-100">
                                    <div class="value-icon"><span class="fa fa-trophy" style="font-size: 32px"></span></div>
                                    <h4>Excellence</h4>
                                    <p>We are committed to delivering outstanding quality and measurable results in everything we do.</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                                <div class="value-card w-100">
                                    <div class="value-icon"><span class="fa fa-users" style="font-size: 32px"></span></div>
                                    <h4>Client First</h4>
                                    <p>Your success is our priority. We uniquely tailor our strategies to perfectly meet your business needs.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- TEAM SECTION -->
                    <section class="team-section" data-snippet="theme_finverse.team">
                        <div class="team-header">
                            <div>
                                <div class="small-pill border-pill" style="margin-bottom: 16px">LEADERSHIP</div>
                                <h2 class="section-title" style="font-size: 44px; font-weight: 500; line-height: 1.2; margin: 0;">Meet Our Experts</h2>
                            </div>
                            <a href="/jobs" class="outline-btn text-decoration-none text-dark" data-media-type="banani-button">Join Our Team</a>
                        </div>
                        <div class="row g-4 d-flex align-items-stretch">
                            <!-- Member 1 -->
                            <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                                <div class="team-card w-100 d-flex flex-column">
                                    <img src="https://storage.googleapis.com/banani-avatars/avatar%2Fmale%2F50-65%2FEuropean%2F1" class="team-image" alt="Jameson Clark" />
                                    <h4>Jameson Clark</h4>
                                    <p class="team-role">Chief Executive Officer</p>
                                    <div class="team-socials mt-auto">
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;" data-media-type="banani-button"><span class="fa fa-linkedin" style="font-size: 20px"></span></div>
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;" data-media-type="banani-button"><span class="fa fa-twitter" style="font-size: 20px"></span></div>
                                    </div>
                                </div>
                            </div>
                            <!-- Member 2 -->
                            <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                                <div class="team-card w-100 d-flex flex-column">
                                    <img src="https://storage.googleapis.com/banani-avatars/avatar%2Ffemale%2F35-50%2FNorth%20American%2F2" class="team-image" alt="Sarah Jenkins" />
                                    <h4>Sarah Jenkins</h4>
                                    <p class="team-role">Chief Financial Officer</p>
                                    <div class="team-socials mt-auto">
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;" data-media-type="banani-button"><span class="fa fa-linkedin" style="font-size: 20px"></span></div>
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;" data-media-type="banani-button"><span class="fa fa-twitter" style="font-size: 20px"></span></div>
                                    </div>
                                </div>
                            </div>
                            <!-- Member 3 -->
                            <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                                <div class="team-card w-100 d-flex flex-column">
                                    <img src="https://storage.googleapis.com/banani-avatars/avatar%2Fmale%2F35-50%2FEast%20Asian%2F3" class="team-image" alt="David Chen" />
                                    <h4>David Chen</h4>
                                    <p class="team-role">Chief Operating Officer</p>
                                    <div class="team-socials mt-auto">
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;" data-media-type="banani-button"><span class="fa fa-linkedin" style="font-size: 20px"></span></div>
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;" data-media-type="banani-button"><span class="fa fa-twitter" style="font-size: 20px"></span></div>
                                    </div>
                                </div>
                            </div>
                            <!-- Member 4 -->
                            <div class="col-lg-3 col-md-6 d-flex" data-name="Card">
                                <div class="team-card w-100 d-flex flex-column">
                                    <img src="https://storage.googleapis.com/banani-avatars/avatar%2Ffemale%2F25-35%2FAfrican%2F4" class="team-image" alt="Amara Okafor" />
                                    <h4>Amara Okafor</h4>
                                    <p class="team-role">Head of Analytics</p>
                                    <div class="team-socials mt-auto">
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;" data-media-type="banani-button"><span class="fa fa-linkedin" style="font-size: 20px"></span></div>
                                        <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer;" data-media-type="banani-button"><span class="fa fa-twitter" style="font-size: 20px"></span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </template>
    
    <record id="about_page" model="theme.website.page">
        <field name="url">/about</field>
        <field name="view_id" ref="about"/>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
