<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  template  Insights-->
    <template id="insights" name="Insights">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="page-container" style="padding-bottom: 0;">
                    <!-- HERO SECTION -->
                    <section class="hero-section"
                             style="height: 500px; background-image: url('/theme_finverse/static/src/img/03265cd0-7464-4a97-8229-71d0badc36a5.jpg'); background-size: cover; background-position: center;"
                             data-snippet="theme_finverse.insights_hero">
                        <div class="hero-overlay" style="pointer-events: none;"></div>
                        <div class="hero-content" style="margin-top: 100px">
                            <h1 class="hero-title">Our Insights</h1>
                            <p style="color: rgba(255, 255, 255, 0.9); font-size: 20px; max-width: 600px; margin: 0; line-height: 1.6;">
                                Expert analysis, industry trends, and strategic perspectives from
                                our financial consultants to help you stay ahead.
                            </p>
                        </div>
                    </section>

                    <!-- INSIGHTS SECTION -->
                    <section class="insights-section section-container" data-snippet="theme_finverse.insights_list">
                        <!-- Filters as Tabs -->
                        <ul class="filters nav" role="tablist"
                            style="margin-bottom: 32px; border-bottom: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; padding: 0;">
                            <li class="nav-item" role="presentation">
                                <a class="nav-link filter-btn active text-decoration-none" id="page-insights-all-tab"
                                   data-bs-toggle="tab" data-bs-target="#page-insights-all" role="tab"
                                   aria-controls="page-insights-all" aria-selected="true" style="cursor:pointer;">All
                                    Insights
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link filter-btn text-decoration-none" id="page-insights-market-tab"
                                   data-bs-toggle="tab" data-bs-target="#page-insights-market" role="tab"
                                   aria-controls="page-insights-market" aria-selected="false" style="cursor:pointer;">
                                    Market Analysis
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link filter-btn text-decoration-none" id="page-insights-wealth-tab"
                                   data-bs-toggle="tab" data-bs-target="#page-insights-wealth" role="tab"
                                   aria-controls="page-insights-wealth" aria-selected="false" style="cursor:pointer;">
                                    Wealth Management
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link filter-btn text-decoration-none" id="page-insights-strategy-tab"
                                   data-bs-toggle="tab" data-bs-target="#page-insights-strategy" role="tab"
                                   aria-controls="page-insights-strategy" aria-selected="false" style="cursor:pointer;">
                                    Corporate Strategy
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link filter-btn text-decoration-none" id="page-insights-innovation-tab"
                                   data-bs-toggle="tab" data-bs-target="#page-insights-innovation" role="tab"
                                   aria-controls="page-insights-innovation" aria-selected="false"
                                   style="cursor:pointer;">Innovation
                                </a>
                            </li>
                        </ul>

                        <div class="tab-content" id="page-insights-tab-content">
                            <!-- All Insights Tab -->
                            <div class="tab-pane fade show active" id="page-insights-all" role="tabpanel"
                                 aria-labelledby="page-insights-all-tab">
                                <!-- Featured Article -->
                                <article class="featured-article" data-media-type="banani-button">
                                    <div class="featured-image-wrapper">
                                        <img src="/theme_finverse/static/src/img/cdd6acb9-4ef3-490a-9743-385cb227cf67.jpg"
                                             alt="Professionals analyzing data" data-aspect-ratio="4:3"/>
                                    </div>
                                    <div class="featured-content">
                                        <div class="featured-meta-row">
                                            <span class="badge">Market Analysis</span>
                                            <span class="meta-text">Oct 24, 2026</span>
                                            <span class="meta-text">
                                                <div style="width: 14px; height: 14px; display: flex; align-items: center; justify-content: center;">
                                                    <iconify-icon icon="lucide:clock"
                                                                  style="font-size: 14px"></iconify-icon>
                                                </div>
                                                5 min read
                                            </span>
                                        </div>
                                        <h2 class="featured-title">Navigating the Changing Landscape of Global Markets
                                            in 2026
                                        </h2>
                                        <p class="featured-excerpt">
                                            An in-depth look at how emerging technologies and shifting
                                            geopolitical forces are reshaping global investment strategies
                                            for the upcoming year. Discover key trends that will define the
                                            financial future.
                                        </p>
                                        <div class="author-row">
                                            <img src="https://storage.googleapis.com/banani-avatars/avatar%2Fmale%2F35-50%2FNorth%20American%2F1"
                                                 alt="James Sterling" class="author-avatar"/>
                                            <div>
                                                <div class="author-name">James Sterling</div>
                                                <div class="author-title">Chief Market Strategist</div>
                                            </div>
                                        </div>
                                        <a href="/contactus" class="read-more-btn text-decoration-none">
                                            Read Full Article
                                            <div style="width: 14px; height: 14px; display: flex; align-items: center; justify-content: center;">
                                                <iconify-icon icon="lucide:arrow-right"
                                                              style="font-size: 14px; color: #2563eb"></iconify-icon>
                                            </div>
                                        </a>
                                    </div>
                                </article>

                                <!-- Article Grid -->
                                <div class="article-grid">
                                    <!-- Card 1 -->
                                    <article class="article-card" data-media-type="banani-button">
                                        <div class="card-image-wrapper">
                                            <img src="/theme_finverse/static/src/img/fac1.png"
                                                 alt="Sustainable Investing"
                                                 data-aspect-ratio="16:10"/>
                                        </div>
                                        <div class="card-meta-row">
                                            <span class="badge">Wealth Management</span>
                                            <span class="meta-text">
                                                <div style="width: 14px; height: 14px; display: flex; align-items: center; justify-content: center;">
                                                    <iconify-icon icon="lucide:calendar"
                                                                  style="font-size: 14px"></iconify-icon>
                                                </div>
                                                Oct 20, 2026
                                            </span>
                                        </div>
                                        <h3 class="card-title">Sustainable Investing: Aligning Wealth with Values</h3>
                                        <p class="card-excerpt">
                                            Discover how Environmental, Social, and Governance (ESG)
                                            criteria are becoming central to modern portfolio construction
                                            and long-term value generation.
                                        </p>
                                        <div class="card-author-row">
                                            <img src="https://storage.googleapis.com/banani-avatars/avatar%2Ffemale%2F25-35%2FNorth%20American%2F2"
                                                 alt="Sarah Jenkins" class="author-avatar"/>
                                            <div>
                                                <div class="author-name">Sarah Jenkins</div>
                                                <div class="author-title">Senior Wealth Advisor</div>
                                            </div>
                                        </div>
                                    </article>

                                    <!-- Card 2 -->
                                    <article class="article-card" data-media-type="banani-button">
                                        <div class="card-image-wrapper">
                                            <img src="/theme_finverse/static/src/img/fac2.jpg" alt="M&amp;A Trends"
                                                 data-aspect-ratio="16:10"/>
                                        </div>
                                        <div class="card-meta-row">
                                            <span class="badge">Corporate Strategy</span>
                                            <span class="meta-text">
                                                <div style="width: 14px; height: 14px; display: flex; align-items: center; justify-content: center;">
                                                    <iconify-icon icon="lucide:calendar"
                                                                  style="font-size: 14px"></iconify-icon>
                                                </div>
                                                Oct 18, 2026
                                            </span>
                                        </div>
                                        <h3 class="card-title">M&amp;A Trends: What to Expect in the Tech Sector</h3>
                                        <p class="card-excerpt">
                                            A comprehensive analysis of merger and acquisition activities
                                            driving tech industry consolidation and how companies can
                                            prepare for successful transitions.
                                        </p>
                                        <div class="card-author-row">
                                            <img src="https://storage.googleapis.com/banani-avatars/avatar%2Fmale%2F35-50%2FEast%20Asian%2F1"
                                                 alt="Michael Chang" class="author-avatar"/>
                                            <div>
                                                <div class="author-name">Michael Chang</div>
                                                <div class="author-title">Strategy Director</div>
                                            </div>
                                        </div>
                                    </article>

                                    <!-- Card 3 -->
                                    <article class="article-card" data-media-type="banani-button">
                                        <div class="card-image-wrapper">
                                            <img src="/theme_finverse/static/src/img/fac3.png" alt="AI in Finance"
                                                 data-aspect-ratio="16:10"/>
                                        </div>
                                        <div class="card-meta-row">
                                            <span class="badge">Innovation</span>
                                            <span class="meta-text">
                                                <div style="width: 14px; height: 14px; display: flex; align-items: center; justify-content: center;">
                                                    <iconify-icon icon="lucide:calendar"
                                                                  style="font-size: 14px"></iconify-icon>
                                                </div>
                                                Oct 15, 2026
                                            </span>
                                        </div>
                                        <h3 class="card-title">The Role of AI in Predictive Financial Modeling</h3>
                                        <p class="card-excerpt">
                                            Exploring how artificial intelligence and machine learning are
                                            revolutionizing the accuracy of financial forecasts and risk
                                            assessment models.
                                        </p>
                                        <div class="card-author-row">
                                            <img src="https://storage.googleapis.com/banani-avatars/avatar%2Ffemale%2F35-50%2FEuropean%2F3"
                                                 alt="Dr. Elena Rostova" class="author-avatar"/>
                                            <div>
                                                <div class="author-name">Dr. Elena Rostova</div>
                                                <div class="author-title">Head of Data Analytics</div>
                                            </div>
                                        </div>
                                    </article>
                                </div>

                                <!-- Load More -->
                                <div class="load-more-container" style="text-align: center; margin-top: 48px;">
                                    <a href="/contactus" class="load-more-btn text-decoration-none">
                                        <div style="width: 16px; height: 16px; display: flex; align-items: center; justify-content: center;">
                                            <iconify-icon icon="lucide:refresh-cw"
                                                          style="font-size: 16px"></iconify-icon>
                                        </div>
                                        Load More Articles
                                    </a>
                                </div>
                            </div>

                            <!-- Other Tabs -->
                            <div class="tab-pane fade" id="page-insights-market" role="tabpanel"
                                 aria-labelledby="page-insights-market-tab">
                                <div class="oe_structure oe_empty">
                                    <p class="text-center text-muted py-5">Add Market Analysis Content Here</p>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="page-insights-wealth" role="tabpanel"
                                 aria-labelledby="page-insights-wealth-tab">
                                <div class="oe_structure oe_empty">
                                    <p class="text-center text-muted py-5">Add Wealth Management Content Here</p>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="page-insights-strategy" role="tabpanel"
                                 aria-labelledby="page-insights-strategy-tab">
                                <div class="oe_structure oe_empty">
                                    <p class="text-center text-muted py-5">Add Corporate Strategy Content Here</p>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="page-insights-innovation" role="tabpanel"
                                 aria-labelledby="page-insights-innovation-tab">
                                <div class="oe_structure oe_empty">
                                    <p class="text-center text-muted py-5">Add Innovation Content Here</p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </template>

    <record id="insights_page" model="theme.website.page">
        <field name="url">/insights</field>
        <field name="view_id" ref="insights"/>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
