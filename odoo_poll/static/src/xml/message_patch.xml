<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Extend Discuss Thread Message -->
    <t t-name="odoo_poll.MessagePatch" t-inherit="mail.Message" t-inherit-mode="extension">

        <xpath expr="//div[contains(@class, 'o-mail-Message-content')]" position="replace">
            <t t-if="this.pollId">
                <PollMessage pollId="this.pollId"/>
            </t>
            <t t-else="">
                $0
            </t>
        </xpath>

    </t>

</templates>
