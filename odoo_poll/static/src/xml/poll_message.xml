<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_poll.PollMessage">
        <div class="o_poll_message" t-if="!state.accessDenied">
            <t t-if="state.loading">
                <div class="text-center p-4">
                    <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
                    <div class="mt-2 text-muted">Loading poll...</div>
                </div>
            </t>
            <t t-elif="state.error">
                <div class="card shadow-sm border-danger">
                    <div class="card-body p-3 text-center text-danger">
                        <i class="fa fa-exclamation-triangle fa-2x mb-2"/>
                        <div><t t-esc="state.error"/></div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="mb-1">
                                    <i class="fa fa-bar-chart text-primary me-2"/>
                                    <t t-esc="state.pollData.question"/>
                                </h5>
                                <small t-if="state.pollData.is_multiple_choice" class="text-muted">
                                    <i class="fa fa-check-square-o"/> Multiple choices allowed
                                </small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info">
                                    <t t-esc="state.pollData.total_votes"/> votes
                                </span>
                                <span t-if="state.pollData.is_closed" class="badge bg-danger ms-1">
                                    Closed
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <t t-foreach="state.pollData.options || []" t-as="option" t-key="option.id">

                            <div class="o_poll_option mb-3">
                                <div class="form-check mb-2">
                                    <input class="form-check-input"
                                           t-att-type="state.pollData.is_multiple_choice ? 'checkbox' : 'radio'"
                                           t-att-name="'poll_' + state.pollData.id"
                                           t-att-id="'option_' + option.id"
                                           t-att-checked="isOptionSelected(option.id)"
                                           t-att-disabled="state.pollData.is_closed"
                                           t-on-change="() => this.toggleOption(option.id)"/>
                                    <label class="form-check-label d-flex justify-content-between w-100"
                                           t-att-for="'option_' + option.id">
                                        <span><t t-esc="option.name"/></span>
                                        <span class="badge bg-secondary">
                                            <t t-esc="option.vote_count"/>
                                        </span>
                                    </label>
                                </div>
                                <div class="progress mb-1" style="height: 10px;">
                                    <div class="progress-bar"
                                         t-att-class="isOptionSelected(option.id) ? 'bg-success' : 'bg-primary'"
                                         role="progressbar"
                                         t-att-style="'width: ' + getBarWidth(option)"
                                         t-att-aria-valuenow="option.percentage">
                                    </div>
                                </div>
                                <small class="text-muted">
                                    <t t-esc="option.percentage"/>%
                                </small>
                            </div>
                        </t>
                    </div>
                    <div class="card-footer bg-light">
                        <div class="d-flex justify-content-between">
                            <div>
                                <button t-if="!state.pollData.is_closed"
                                        class="btn btn-sm btn-primary me-2"
                                        t-on-click="vote"
                                        t-att-disabled="state.selectedOptions.length === 0">
                                    <i class="fa fa-check"/> Vote
                                </button>
                                <button t-if="(state.pollData.user_votes || []).length > 0 and !state.pollData.is_closed"
                                        class="btn btn-sm btn-outline-secondary"
                                        t-on-click="removeVotes">
                                    <i class="fa fa-times"/> Remove Vote
                                </button>
                            </div>
                            <button t-if="state.pollData.is_author and !state.pollData.is_closed"
                                    class="btn btn-sm btn-outline-danger"
                                    t-on-click="closePoll">
                                <i class="fa fa-lock"/> Close Poll
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
