<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- Patch the Composer template to add Poll button -->
    <t t-name="mail.Composer" t-inherit="mail.Composer" t-inherit-mode="extension">

        <!-- Add Poll button outside the rounded input container -->
        <xpath expr="//div[hasclass('o-mail-Composer-inputContainer')]" position="inside">
            <button class="btn btn-link text-action o_poll_button align-self-center"
                    title="Create Poll"
                    t-on-click="onClickPollButton">
                <i class="fa fa-bar-chart"/>
            </button>
        </xpath>

    </t>

</templates>