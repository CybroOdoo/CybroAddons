<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="mail.Composer.actions" t-inherit-mode="extension">
        <xpath expr="//div[@t-ref='main-actions']" position="inside">
            <button
                class="btn border-0 rounded-circle p-0"
                title="Create Poll"
                t-on-click="onClickPollButton">
                <i class="fa fa-bar-chart"/>
            </button>
        </xpath>
    </t>

</templates>
