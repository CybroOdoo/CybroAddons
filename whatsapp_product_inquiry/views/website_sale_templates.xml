<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp Inquire button next to Add to Cart on the product page,
    shown when the website company has a WhatsApp number -->
    <template id="whatsapp_inquiry" name="Product WhatsApp Inquiry"
              inherit_id="website_sale.cta_wrapper">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="inside">
            <div id="whatsapp_inquiry_wrap"
                 class="d-inline-flex flex-grow-1 flex-lg-grow-0 align-items-center"
                 t-if="website.company_id.whatsapp_number">
                <a role="button" id="whatsapp_inquiry_link"
                   t-att-href="'/whatsapp/inquiry/%s' % (product_variant or product.product_variant_id).id"
                   class="btn o_whatsapp_inquiry_btn flex-grow-1"
                   target="_blank" rel="noopener">
                    <i class="oi me-2" data-icon="oi_whatsapp" aria-hidden="true"/>
                    Inquire
                </a>
            </div>
        </xpath>
    </template>
</odoo>
