<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!-- Lab Management Category -->
    <record model="ir.module.category" id="module_category_lab_management">
        <field name="name">Lab Management</field>
        <field name="sequence">100</field>
    </record>

    <!-- Lab Management Privilege -->
    <record model="res.groups.privilege" id="privilege_lab_management">
        <field name="name">Laboratory</field>
        <field name="category_id" ref="module_category_lab_management"/>
        <field name="placeholder">No access</field>
        <field name="sequence">10</field>
    </record>

    <!-- Lab Management User Group -->
    <record id="group_lab_management_user" model="res.groups">
        <field name="name">Lab User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_lab_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can manage patients, appointments and lab requests.</field>
    </record>

    <!-- Lab Management Manager Group -->
    <record id="group_lab_management_technician" model="res.groups">
        <field name="name">Lab Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_lab_management"/>
        <field name="implied_ids" eval="[(4, ref('group_lab_management_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access including lab configuration.</field>
    </record>

</data>
</odoo>
