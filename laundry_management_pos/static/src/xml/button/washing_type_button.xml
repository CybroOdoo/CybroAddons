<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Inherit POS Orderline to add buttons and Product image-->
    <t t-name="Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension" owl="1">
        <xpath expr="//li[hasclass('price-per-unit')]" position="inside">
            <span class="orderline-laundry" t-if="pos.config.orderline_washing_type">
                <i t-on-click="click" t-if="line.washingType and
                this.env.services.pos.orders[0].screen_data.value.name == 'ProductScreen'"
                   class="oe_link_icon fa fa-user oe_icon oe_green  text-success"
                   role="img"/>
                <i t-on-click="click" class="oe_link_icon fa fa-user-plus oe_icon oe_red text-danger"
                   t-if="!line.washingType and
                   this.env.services.pos.orders[0].screen_data.value.name == 'ProductScreen'"
                   role="img"/>
                <t t-esc="line.washingType"/>
                <i t-on-click="remove_laundry" class="oe_link_icon fa fa-remove oe_icon oe_red text-danger"
                   t-if="line.washingType and
                   this.env.services.pos.orders[0].screen_data.value.name == 'ProductScreen'"
                   role="img"/>
            </span>
        </xpath>
        <xpath expr="//div[hasclass('product-name')]/span" position="before">
            <span class="orderline-product-img">
                <img t-attf-src="/web/image?model=product.product&amp;field=image_128&amp;id={{line.product_id}}&amp;unique=1"
                     style="padding: 5px; height: 55px;"/>
            </span>
        </xpath>
    </t>
    <!--Laundry service button on Product Screen-->
    <t t-name="point_of_sale.WashingButton">
        <t t-log="pos.config"/>
        <button class="control-button btn btn-light rounded-0 fw-bolder"
                t-on-click="() => this.onClick()" t-if="pos.config.orderline_washing_type">
            <i class="fa fa-shopping-basket" role="img" aria-label="Laundry Service" title="Laundry Service"/>
            <span/>
            <span>Laundry Service</span>
        </button>
    </t>
</templates>
