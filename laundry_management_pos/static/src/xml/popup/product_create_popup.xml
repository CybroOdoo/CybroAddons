<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Popup dialog for creating a new product from POS -->
    <t t-name="CreateProductPopup" owl="1">
        <Dialog>
            <div class="popup product-line-popup" style="max-width: 684px; padding:1%;">
                <main class="body">
                    <form class="form-group">
                        <sheet class="bg-primary">
                            <h3>
                                <span>Create Product</span>
                                <i class="fa fa-times" style="float:right" t-on-click="cancel"/>
                                <hr/>
                            </h3>

                            <!-- Image preview area -->
                            <div class="product-img-create-popup" style="margin-bottom:15px;">
                                <t t-if="state.preview_image">
                                    <img t-att-src="state.preview_image"
                                         style="max-width:150px; max-height:150px; border:1px solid #ddd; padding:4px;"/>
                                </t>
                            </div>

                            <div class="field_div" style="display:flex; margin-bottom: 15px;">
                                <label for="img_field" class="field_label"
                                       style="margin-right:10px; margin-top: 10px; width: 120px;">Image</label>
                                <input type="file" id="img_field"
                                       t-on-change="(ev) => this._onChangeImgField(ev)"
                                       accept="image/*"
                                       class="field_input"/>
                            </div>

                            <div class="field_div" style="display:flex; margin-bottom: 15px;">
                                <label class="field_label" style="margin-right:10px; margin-top: 10px; width: 120px;">Name</label>
                                <input type="text" id="display_name" class="field_input"/>
                            </div>

                            <div class="field_type" style="display:flex; margin-bottom: 15px;">
                                <label class="field_label" style="margin-right:10px; margin-top: 10px; width: 120px;">Type</label>
                                <select id="type" class="field_input">
                                    <option value="consu">Consumable</option>
                                    <option value="service">Service</option>
                                    <option value="product">Storable Product</option>
                                    <option value="combo">Combo</option>
                                </select>
                            </div>

                            <div class="field_div" style="display:flex; margin-bottom: 15px;">
                                <label class="field_label" style="margin-right:10px; margin-top: 10px; width: 120px;">Price</label>
                                <input type="number" id="list_price" class="field_input"/>
                            </div>

                            <div class="field_div" style="display:flex; margin-bottom: 15px;">
                                <label class="field_label" style="margin-right:10px; margin-top: 10px; width: 120px;">Cost</label>
                                <input type="number" id="cost_price" class="field_input"/>
                            </div>

                            <div class="field_div" style="display:flex; margin-bottom: 15px;">
                                <label class="field_label" style="margin-right:10px; margin-top: 10px; width: 120px;">Barcode</label>
                                <input type="text" id="barcode" class="field_input"/>
                            </div>

                            <div class="field_div" style="display:flex; margin-bottom: 15px;">
                                <label class="field_label" style="margin-right:10px; margin-top: 10px; width: 120px;">Internal Reference</label>
                                <input type="text" id="default_code" class="field_input"/>
                            </div>

                            <div class="field_div" style="display:flex; margin-bottom: 15px;">
                                <label class="field_label" style="margin-right:10px; margin-top: 10px; width: 120px;">Category</label>
                                <select id="product_category" class="field_input">
                                    <t t-foreach="env.services.pos.models['pos.category'].getAll()" t-as="category" t-key="category.id">
                                        <option t-att-value="category.id">
                                            <t t-esc="category.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                        </sheet>
                    </form>
                </main>

                <footer class="footer cash-move">
                    <button class="btn btn-primary" t-on-click="(ev) => this.confirm(ev)">Confirm</button>
                    <button class="btn btn-secondary" t-on-click="cancel">Cancel</button>
                </footer>
            </div>
        </Dialog>
    </t>
</templates>
