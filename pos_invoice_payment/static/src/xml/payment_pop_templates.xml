<?xml version="1.0" encoding="UTF-8"?>
<!-- Popup template for creating a payment by entering amount and selecting a journal. -->
<templates id="template" xml:space="preserve">
   <!-- Template for Create Payment Popup -->
   <t t-name="pos_invoice_payment.CreatePaymentPopup">
       <!-- Popup container -->
        <Dialog size="'sm'" title="this.props.title || 'Create Payment'">
           <div class="popup" style="background-color: #7bcedb;">
               <!-- Popup title -->
            <header>
               <p class="title">
                   Create Payment
               </p>
            </header>
            <main>
               <!-- Amount input field -->
               <div class="field_div" style="display:flex; margin-bottom: 15px;">
                   <label for="amount" class="field_label" style="margin-right:10px; margin-top: 10px; width: 120px; display: inline-block; text-align: left;">Amount</label>
                   <input type="number" name="amount" class="field_input" id="amount" t-model.proxy="this.state.amount"/>
               </div>
               <!-- Journal selection field -->
               <div class="field_div" style="display:flex; margin-bottom: 15px;">
                   <label for="Journal" class="field_label" style="margin-right:10px; margin-top: 10px; width: 120px; display: inline-block; text-align: left;">Journal</label>
                   <select name="Journal" class="form-select" id="journal" t-model.proxy="this.state.journalId">
                       <!-- Iterate over journal options -->
                       <t t-foreach="this.props.journals || []" t-as="journal" t-key="journal.id">
                           <!-- Option for each journal -->
                           <option t-att-value="journal.id" t-att-title="journal.name">
                               <t t-out="journal.name"/>
                           </option>
                       </t>
                   </select>
               </div>
            </main>
               <!-- Popup footer -->
               <t t-set-slot="footer">
                    <!-- Confirm button -->
                    <button class="button highlight confirm" t-on-click="this.confirm">
                        Confirm
                    </button>

                    <!-- Cancel button -->
                    <button class="button cancel" t-on-click="this.cancel">
                        Cancel
                    </button>
                </t>

           </div>
        </Dialog>
   </t>
</templates>
