<?xml version="1.0" encoding="UTF-8"?>
<!--Template for category summary button-->
<templates id="template" xml:space="preserve">
    <t t-name="pos_invoice_payment.ControlButtons" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']/div/t[@name='o_pricelist_button']"
               position="before">
            <t t-call="point_of_sale.controlButton"
               icon="'view_list'"
               btnText.translate="Invoicing"
               btnClasses="'btn-secondary'"
               onClick="() => this.clickInvoicing()"/>
        </xpath>
    </t>
</templates>
