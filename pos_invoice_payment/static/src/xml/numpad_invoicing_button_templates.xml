<?xml version="1.0" encoding="UTF-8"?>
<!-- Adds a POS control button to open the invoicing screen -->
<templates id="template" xml:space="preserve">
   <t t-name="pos_invoice_payment.InvoicingButton" owl="1">
       <button class="control-button btn btn-light rounded-0 fw-bolder" t-on-click="() => this.onClick()">
           <i class="fa fa-list me-1" role="img" aria-label="Listview" title="Listview"/>
           Invoicing
       </button>
   </t>
</templates>
