<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
   <t t-name="pos_invoice_payment.CreatePaymentPopup" owl="1">
       <div class="popup" style="background-color: #00d0d2; color: #333; max-width: 400px; min-width: 350px;">
           <div class="modal-header drag-handle" style="background-color: #a8f0ef; padding: 15px; border-bottom: none;">
               <h4 class="modal-title title text-center w-100 m-0" style="color: #333; font-weight: bold;">
                   Create Payment
               </h4>
           </div>
           <main class="modal-body" style="padding: 20px;">
               <div class="field_div d-flex align-items-center mb-3" style="color: #fff; font-weight: bold;">
                   <label for="amount" class="field_label me-3" style="width: 80px; text-align: left;">Amount</label>
                   <input type="number" name="amount" class="field_input form-control form-control-sm" id="amount" style="width: 100%; border: none; padding: 10px; color: #333;"/>
               </div>
               <div class="field_div d-flex align-items-center mb-3" style="color: #fff; font-weight: bold;">
                   <label for="Journal" class="field_label me-3" style="width: 80px; text-align: left;">journal</label>
                    <select name="Journal" class="form-select form-select-sm dropdown" id="journal" style="width: 180px; border: none; padding: 8px 30px 8px 10px; color: #333; background-color: #fff; border-radius: 5px; -webkit-appearance: listbox;">
                        <t t-foreach="props.journal_length" t-as="index" t-key="index">
                            <option t-att-value="props.journals[index]['id']" t-att-title="props.journals[index]['name']">
                                <t t-esc="props.journals[index]['name']"/>
                            </option>
                        </t>
                    </select>
               </div>
           </main>
           <footer class="footer modal-footer d-flex justify-content-end" style="background-color: #00d0d2; border-top: 1px solid #fff; padding: 15px;">
               <div class="button cancel btn btn-sm" t-on-click="cancel" style="border: 1px solid #fff; background: transparent; color: #fff; margin-right: 10px; width: auto; padding: 5px 20px;">
                   Cancel
               </div>
               <div class="button confirm highlight btn btn-sm" t-on-click="confirm" style="background-color: #009688; border: none; color: #fff; width: auto; padding: 5px 20px;">
                   Confirm
               </div>
           </footer>
       </div>
   </t>
</templates>
