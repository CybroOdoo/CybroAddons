<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Form view for the note.color model.

        This view is used to configure note color intervals by defining:
        - Interval name
        - Color to apply
        - Start date of interval
        - End date of interval

        The configured intervals are used to dynamically assign
        colors to To-do notes based on their deadline dates.
    -->
    <record id="note_color_view_form" model="ir.ui.view">
        <field name="name">note.color.view.form</field>
        <field name="model">note.color</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"
                                   placeholder="e.g. Urgent, High Priority, Later"/>

                            <field name="color_note"/>
                        </group>

                        <group>
                            <group>

                                <field name="start_interval"
                                       options="{'min_date': 'today'}"/>

                                <field name="end_interval"
                                       options="{'min_date': 'today'}"/>

                            </group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--
        List view for displaying all configured note color intervals.

        Displays:
        - Interval name
        - Assigned color
        - Start interval date
        - End interval date
    -->
    <record id="note_color_view_list" model="ir.ui.view">
        <field name="name">note.color.view.list</field>
        <field name="model">note.color</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color_note"/>
                <field name="start_interval"/>
                <field name="end_interval"/>
            </list>
        </field>
    </record>

    <!--
        Window action for opening the note.color model views.

        Allows users to manage color interval configurations
        through list and form views.
    -->
    <record id="note_color_action" model="ir.actions.act_window">
        <field name="name">Color Interval</field>
        <field name="res_model">note.color</field>
        <field name="view_id" ref="note_color_view_list"/>
        <field name="view_mode">list,form</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the color sets
            </p>
        </field>
    </record>

</odoo>