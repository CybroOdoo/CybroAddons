<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Inherited settings view for configuring note colors
        used in the Magic Note module.

        Provides configuration options for:
        - Default note color
        - After deadline color
        - Color for notes outside configured intervals
    -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.magic.note</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project']" position="inside">
                <!-- Color configuration block -->
                <block title="Color Configuration"
                       id="color_configuration">

                    <!-- Default color applied when no deadline is set for the note -->
                    <setting id="default_note_color"
                             help="Color applied to notes without a deadline">
                        <field name="note_color_default"/>
                    </setting>

                    <!-- Color applied when task deadline is earlier than current date -->
                    <setting id="deadline_note_color"
                             help="Color applied to notes with a deadline date earlier than today">
                        <field name="after_deadline"/>
                    </setting>

                    <!-- Color applied when deadline does not match any date interval -->
                    <setting id="not_in_interval_color"
                             help="Color applied when the deadline date does not fall under any configured Date Interval">
                        <field name="not_in_interval"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>


    <!--
        Configuration menu for Magic Note interval management.
    -->
    <menuitem
            id="menu_magic_note_color_interval"
            name="Color Interval"
            sequence="50"
            parent="project.menu_project_config"
            action="magic_note.note_color_action"/>

</odoo>