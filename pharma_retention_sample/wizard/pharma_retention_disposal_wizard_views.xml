<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approved disposal wizard. -->
    <record id="pharma_retention_disposal_wizard_view_form" model="ir.ui.view">
        <field name="name">pharma.retention.disposal.wizard.form</field>
        <field name="model">pharma.retention.disposal.wizard</field>
        <field name="arch" type="xml">
            <form string="Dispose Retention Sample">
                <div class="alert alert-info" role="alert">
                    Disposal is recorded on the register. The retention sample record is kept.
                </div>
                <group>
                    <group>
                        <field name="sample_id"/>
                        <field name="disposal_due_date"/>
                        <label for="remaining_qty"/>
                        <div class="o_row">
                            <field name="remaining_qty"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                        </div>
                    </group>
                    <group>
                        <field name="disposal_method"/>
                        <field name="disposal_reference"/>
                    </group>
                </group>
                <field name="disposal_note" placeholder="Remarks (witness, destruction details)..."/>
                <footer>
                    <button name="action_confirm" string="Approve &amp; Dispose" type="object"
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
