<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retention flag and held-samples button on the location form. -->
    <record id="view_location_form_pharma_retention" model="ir.ui.view">
        <field name="name">stock.location.form.pharma.retention</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_retention_samples" type="object"
                        class="oe_stat_button" icon="fa-archive"
                        invisible="not pharma_is_retention_location"
                        groups="pharmaceutical_base.group_pharma_user">
                    <field name="retention_sample_count" widget="statinfo" string="Samples Held"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='usage']" position="after">
                <field name="pharma_is_retention_location" invisible="usage != 'internal'"/>
            </xpath>
        </field>
    </record>

    <!-- Retention locations list. -->
    <record id="view_location_list_pharma_retention" model="ir.ui.view">
        <field name="name">stock.location.list.pharma.retention</field>
        <field name="model">stock.location</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Retention Locations">
                <field name="complete_name" string="Location"/>
                <field name="storage_category_id" optional="show"
                       groups="stock.group_stock_multi_locations"/>
                <field name="retention_sample_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Stock locations marked for reserve samples; new ones are created marked. -->
    <record id="pharma_retention_location_action" model="ir.actions.act_window">
        <field name="name">Retention Locations</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pharma_is_retention_location', '=', True)]</field>
        <field name="context">{'default_pharma_is_retention_location': True, 'default_usage': 'internal'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_location_list_pharma_retention')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_location_form')})
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define where reserve samples are held.</p>
            <p>Retention locations are standard stock locations marked for reserve
                samples. Samples are recorded there, never held as stock, so they
                stay out of on-hand and valuation reports.</p>
        </field>
    </record>
</odoo>
