<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retain Sample button and smart button on the batch form. -->
    <record id="view_production_lot_form_pharma_retention" model="ir.ui.view">
        <field name="name">stock.lot.form.pharma.retention</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="show_retain_sample" invisible="1"/>
                    <button name="action_create_retention_sample" string="Retention Sample"
                            type="object" class="oe_highlight" icon="fa-archive"
                            invisible="not show_retain_sample"
                            groups="pharmaceutical_base.group_pharma_role_user,pharmaceutical_base.group_pharma_role_admin"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_retention_samples" type="object"
                        class="oe_stat_button" icon="fa-archive"
                        invisible="retention_sample_count == 0"
                        groups="pharmaceutical_base.group_pharma_user">
                    <field name="retention_sample_count" widget="statinfo" string="Reserve Sample"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Released batches with a retention rule but no reserve sample. -->
    <record id="pharma_retention_missing_action" model="ir.actions.act_window">
        <field name="name">Missing Reserve Samples</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('lot_status', '=', 'released'), ('product_id.retention_required', '=', True), ('retention_sample_ids', 'not any', [('state', '!=', 'draft')])]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Every released batch has its reserve sample.</p>
        </field>
    </record>
</odoo>
