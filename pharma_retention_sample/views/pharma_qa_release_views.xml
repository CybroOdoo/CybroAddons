<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retention Sample on the released QA record. -->
    <record id="pharma_qa_release_view_form_retention" model="ir.ui.view">
        <field name="name">pharma.qa.release.form.retention</field>
        <field name="model">pharma.qa.release</field>
        <field name="inherit_id" ref="pharma_traceability_coa.pharma_qa_release_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_view_genealogy']" position="before">
                <field name="show_retain_sample" invisible="1"/>
                <button name="action_create_retention_sample" string="Retention Sample"
                        type="object" class="oe_highlight" icon="fa-archive"
                        invisible="state != 'released' or not show_retain_sample"
                        groups="pharmaceutical_base.group_pharma_role_user,pharmaceutical_base.group_pharma_role_admin"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_retention_samples" type="object"
                        class="oe_stat_button" icon="fa-archive"
                        invisible="retention_sample_count == 0">
                    <field name="retention_sample_count" widget="statinfo" string="Reserve Sample"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
