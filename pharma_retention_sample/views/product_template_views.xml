<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds the retention rule to the product's Pharma tab. -->
    <record id="product_template_form_pharma_retention" model="ir.ui.view">
        <field name="name">product.template.form.pharma.retention</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="pharmaceutical_base.product_template_form_pharma"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pharma']/field[@name='qc_spec_ids']" position="after">
                <separator string="Retention Sample"/>
                <group name="pharma_retention">
                    <group>
                        <field name="retention_required"/>
                        <field name="retention_period_months" invisible="not retention_required"/>
                        <field name="retention_exam_interval_months" invisible="not retention_required"/>
                    </group>
                    <group invisible="not retention_required">
                        <field name="retention_container"/>
                        <field name="retention_location_id" options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
