<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default retention location, shown under the Retention Samples toggle. -->
    <record id="res_config_settings_view_form_pharma_retention" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pharma.retention</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pharmaceutical_base.res_config_settings_view_form_pharmaceutical_base"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pharmaceutical_base_module_retention_sample']" position="after">
                <setting id="pharma_retention_default_location"
                         string="Default Retention Location"
                         help="Internal location proposed for reserve samples when the product sets none."
                         invisible="not module_pharma_retention_sample">
                    <field name="pharma_retention_location_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
