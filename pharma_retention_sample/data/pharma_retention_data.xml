<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for retention sample register numbers. -->
    <record id="seq_pharma_retention_sample" model="ir.sequence">
        <field name="name">Retention Sample</field>
        <field name="code">pharma.retention.sample</field>
        <field name="prefix">RS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Default "Retention Samples" location per company (skips companies already set). -->
    <function model="res.company" name="_pharma_create_retention_locations"/>

    <!-- Reminder raised on a released batch that has no reserve sample. -->
    <record id="mail_activity_retain_sample" model="mail.activity.type">
        <field name="name">Retain Reserve Sample</field>
        <field name="summary">Record the reserve sample for this batch</field>
        <field name="icon">fa-archive</field>
        <field name="res_model">stock.lot</field>
        <field name="delay_count">0</field>
    </record>

    <!--
        Daily: raises a reminder on every released batch that carries a
        retention rule but has no reserve sample. Release itself is never
        held up; a missed sample is made visible instead.
    -->
    <record id="ir_cron_pharma_missing_retention" model="ir.cron">
        <field name="name">Pharma: Flag Released Batches Without Reserve Sample</field>
        <field name="model_id" ref="model_pharma_retention_sample"/>
        <field name="state">code</field>
        <field name="code">model._cron_pharma_missing_retention()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
