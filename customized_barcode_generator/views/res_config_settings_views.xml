<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited view form of res.config.settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.customized.barcode.generator</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Product Labels" name="product_labels_setting_container">
                    <setting id="require_standard_price_setting"
                             help="Print the product cost on labels, encoded with the active barcode code rule.">
                        <field name="require_standard_price"/>
                        <div class="mt8" invisible="not require_standard_price">
                            <button name="%(customized_barcode_generator.barcode_code_action)d"
                                    icon="oi-arrow-right" type="action"
                                    string="Barcode Code" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="require_ref_setting"
                             help="Print the product reference next to the cost code on labels.">
                        <field name="require_ref"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
