<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherited template of product barcode 2x7 labels -->
        <template id="report_template_inherit" inherit_id="product.barcode_2x7_label">
            <!-- Add cost_in_code after the reference block -->
            <xpath expr="//div[hasclass('o_label_reference_block')]" position="after">
                <div t-if="label.get('cost_in_code')" class="o_label_cost_code"
                     style="font-size: 10px; color: #555;">
                    <t t-if="label.get('cost_code_reference')">
                        <span t-out="label['cost_code_reference']"/>
                        <t> | </t>
                    </t>
                    <t t-out="label['cost_in_code']"/>
                </div>
            </xpath>
        </template>

        <!-- Inherited template for product barcode 4x7 labels -->
        <template id="report_template_inherit1" inherit_id="product.barcode_4x7_label">
            <!-- Add cost_in_code after the reference block -->
            <xpath expr="//div[hasclass('o_label_reference_block')]" position="after">
                <div t-if="label.get('cost_in_code')" class="o_label_cost_code"
                     style="font-size: 9px; color: #555;">
                    <t t-if="label.get('cost_code_reference')">
                        <span t-out="label['cost_code_reference']"/>
                        <t> | </t>
                    </t>
                    <t t-out="label['cost_in_code']"/>
                </div>
            </xpath>
        </template>

        <!-- Inherited template for product barcode 4x12 labels -->
        <template id="report_template_inherit3" inherit_id="product.barcode_4x12_label">
            <!-- Add cost_in_code after the reference block in footer -->
            <xpath expr="//div[hasclass('o_label_reference_block')]" position="after">
                <div t-if="label.get('cost_in_code')" class="o_label_cost_code"
                     style="font-size: 8px; color: #555;">
                    <t t-if="label.get('cost_code_reference')">
                        <span t-out="label['cost_code_reference']"/>
                        <t> | </t>
                    </t>
                    <t t-out="label['cost_in_code']"/>
                </div>
            </xpath>
        </template>

        <!-- Inherited template for product barcode dymo labels -->
        <template id="report_template_inherit2" inherit_id="product.barcode_dymo_label">
            <!-- Add cost_in_code after the reference block -->
            <xpath expr="//div[hasclass('o_label_reference_block')]" position="after">
                <div t-if="label.get('cost_in_code')" class="o_label_cost_code"
                     style="font-size: 10px; color: #555;">
                    <t t-if="label.get('cost_code_reference')">
                        <small class="text-nowrap" t-out="label['cost_code_reference']"/>
                        <t> | </t>
                    </t>
                    <t t-out="label['cost_in_code']"/>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
