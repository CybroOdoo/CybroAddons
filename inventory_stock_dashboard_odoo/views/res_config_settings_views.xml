<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings to enable the out-of-stock and dead stock graphs. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.inventory.stock.dashboard.odoo</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="production_lot_info" position="after">
                <block title="Dashboard" name="inventory_dashboard_setting_container">
                    <setting id="out_of_stock_setting"
                             string="Out of Stock"
                             help="Show the out-of-stock products graph in the dashboard.">
                        <field name="out_of_stock"/>
                        <div class="content-group" invisible="not out_of_stock">
                            <div class="row mt16">
                                <label for="out_of_stock_quantity" class="col-lg-4 o_light_label"/>
                                <field name="out_of_stock_quantity"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="dead_stock_setting"
                             string="Dead Stock"
                             help="Show the dead stock graph in the dashboard.">
                        <field name="dead_stock_bol"/>
                        <div class="content-group" invisible="not dead_stock_bol">
                            <div class="row mt16">
                                <label for="dead_stock" string="Duration" class="col-lg-4 o_light_label"/>
                                <field name="dead_stock"/>
                            </div>
                            <div class="row mt16">
                                <label for="dead_stock_type" class="col-lg-4 o_light_label"/>
                                <field name="dead_stock_type"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
