<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default thresholds for the out of stock and dead stock graphs. -->
    <record id="config_parameter_out_of_stock_quantity" model="ir.config_parameter">
        <field name="key">inventory_stock_dashboard_odoo.out_of_stock_quantity</field>
        <field name="value">0</field>
    </record>
    <record id="config_parameter_dead_stock" model="ir.config_parameter">
        <field name="key">inventory_stock_dashboard_odoo.dead_stock</field>
        <field name="value">30</field>
    </record>
    <record id="config_parameter_dead_stock_type" model="ir.config_parameter">
        <field name="key">inventory_stock_dashboard_odoo.dead_stock_type</field>
        <field name="value">day</field>
    </record>
</odoo>
