<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!--    expand/collapse button added in ListView control panel near New button-->
    <t t-name="expand_listview_groupby.expandButton"
       t-inherit="web.ListView" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="inside">
            <button id="expand_icon" style="height:25px !important;"
                    type="button"
                    t-attf-class="btn btn-secondary fa {{ isAllExpanded ? 'fa-compress' : 'fa-expand' }} oe-list-expand ms-1"
                    t-att-title="isAllExpanded ? 'Collapse All Groups' : 'Expand All Groups'"
                    aria-label="Expand/Collapse" t-on-click="onListExpandData"/>
        </xpath>
    </t>
</templates>
