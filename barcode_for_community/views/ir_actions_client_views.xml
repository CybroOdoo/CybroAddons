<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Adding action for the menu item-->
    <record id="custom_barcode_action" model="ir.actions.client">
        <field name="name">Barcode</field>
        <field name="tag">custom_barcode_tags</field>
        <field name="target">fullscreen</field>
    </record>
    <!--    adding menu item for the barcode-->
    <menuitem id="menu_barcode"
              name="Barcode"/>
    <menuitem id="menu_barcode_dashboard" parent="menu_barcode" action="custom_barcode_action"
              name="Dashboard"/>
</odoo>
