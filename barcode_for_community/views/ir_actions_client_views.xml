<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Client action that opens the custom barcode dashboard in fullscreen mode -->
    <record id="custom_barcode_action" model="ir.actions.client">
        <field name="name">Barcode</field>
        <field name="tag">custom_barcode_tags</field>
        <field name="target">fullscreen</field>
    </record>

    <!-- Top-level Barcode menu item -->
    <menuitem id="menu_barcode"
              name="Barcode"
              web_icon="barcode_for_community,static/description/icon.png"/>
    <!-- Dashboard sub-menu item that triggers the barcode client action -->
    <menuitem id="menu_barcode_dashboard" parent="menu_barcode" action="custom_barcode_action"
              name="Dashboard"/>
</odoo>
