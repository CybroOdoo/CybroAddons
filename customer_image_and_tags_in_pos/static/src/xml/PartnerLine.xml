<?xml version="1.0" encoding="UTF-8"?>
<!--Add image and tags field-->
<templates id="template" xml:space="preserve">
    <t t-name="PartnerLine" t-inherit="point_of_sale.PartnerLine"
       t-inherit-mode="extension">
       
        <xpath expr="//tr[@t-att-data-id='this.props.partner.id']/td[1]"
               position="before">
            <td style="width: 90px; min-width: 90px;">
                <div>
                    <img t-attf-src="/web/image/res.partner/{{this.props.partner.id}}/image_1920"
                         style="width: 80px; height: 80px; object-fit: contain;"
                         alt="Customer image"/>
                </div>
            </td>
        </xpath>

        <xpath expr="//tr[@t-att-data-id='this.props.partner.id']/td[2]"
               position="attributes">
            <attribute name="class">text-break</attribute>
            <attribute name="style">min-width: 150px;</attribute>
        </xpath>

        <xpath expr="//tr[@t-att-data-id='this.props.partner.id']/td[3]"
               position="attributes">
            <attribute name="class">text-break</attribute>
            <attribute name="style">min-width: 150px;</attribute>
        </xpath>

        <xpath expr="//tr[@t-att-data-id='this.props.partner.id']/td[3]"
               position="after">
            <td style="min-width: 120px;">
                <div>
                    <span t-out="this.props.partner.category_id ? this.props.partner.category_id.map(c => c.name || c).join(', ') : ''"/>
                </div>
            </td>
        </xpath>

        <xpath expr="//tr[@t-att-data-id='this.props.partner.id']/td[5]"
               position="attributes">
            <attribute name="class">partner-line-email</attribute>
            <attribute name="style">min-width: 150px;</attribute>
        </xpath>

    </t>
</templates>