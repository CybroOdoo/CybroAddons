<?xml version="1.0" encoding="UTF-8"?>
<!--Add image and tags field-->
<templates id="template" xml:space="preserve">
    <t t-name="PartnerLine" t-inherit="point_of_sale.PartnerLine"
       t-inherit-mode="extension">
        <xpath expr="//tr[@t-att-data-id='props.partner.id']/td[1]"
               position="before">
            <td style="width: 90px; min-width: 90px;">
                <div>
                    <img t-attf-src="/web/image/res.partner/{{props.partner.id}}/image_1920"
                         style="width: 80px; height: 80px; object-fit: contain;"
                         alt="Product image"/>
                </div>
            </td>
        </xpath>
        <xpath expr="//tr[@t-att-data-id='props.partner.id']/td[2]"
               position="attributes">
            <attribute name="style">white-space: nowrap; min-width: 120px;</attribute>
        </xpath>
        <xpath expr="//tr[@t-att-data-id='props.partner.id']/td[3]"
               position="after">
            <td>
                <div>Hello</div>
                <div>
                    <span t-esc="props.partner.category_id.map(c => c.name || c).join(', ')"/>
                </div>
            </td>
        </xpath>
    </t>
</templates>