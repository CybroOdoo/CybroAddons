<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="web.NavBar" t-inherit-mode="extension" owl="1">
        <xpath expr="//nav[hasclass('o_main_navbar')]" position="after">
            <t t-if="this.lockDialog.open">
                <div class="o_menu_lock_overlay">
                    <div class="o_menu_lock_modal" role="dialog" aria-modal="true" aria-labelledby="menu_lock_heading">
                        <h4 id="menu_lock_heading">Menu password</h4>
                        <div class="position-relative password-wrapper">
                            <input type="password"
                                   autocomplete="off"
                                   t-ref="this.lockPassword"
                                   class="password-input"
                                   aria-label="Menu password"
                                   placeholder="Enter password"/>

                            <button type="button" aria-label="Show or hide password" class="btn btn-link fa fa-eye toggle_eye"
                               t-on-click="() => this.showPassword()"/>
                        </div>
                        <div t-if="this.lockDialog.invalid" class="alert alert-danger" role="alert">
                            Incorrect password. Please try again.
                        </div>
                        <div class="mt-4 text-end">
                            <button class="btn btn-primary me-2"
                                    t-on-click="() => this.confirmMenuLock()">
                                Confirm
                            </button>

                            <button class="btn btn-secondary"
                                    t-on-click="() => this.cancelMenuLock()">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
