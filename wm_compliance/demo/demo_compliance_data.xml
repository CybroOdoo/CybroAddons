    <record id="demo_code_hw01" model="wm.compliance.code">
        <field name="name">HW-01: Flammable Spent Organic Solvents</field>
        <field name="manifest_type">hazardous</field>
        <field name="regulatory_body">EPA / RCRA Waste Category D001</field>
        <field name="jurisdiction">Federal &amp; State Level</field>
    </record>

    <!-- Record: wm.compliance.code - BMW-01: Contaminated Sharps & Infectious Needles -->
    <record id="demo_code_bmw01" model="wm.compliance.code">
