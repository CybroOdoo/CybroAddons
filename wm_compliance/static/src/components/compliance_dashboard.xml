<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="wm_compliance.Dashboard">
    <div class="wm_compliance_dashboard_root wm_dark_theme">

        <!-- ── HEADER COMMAND BAR ─────────────────────────────────── -->
        <div class="wm_cd_header">
            <div class="wm_cd_header_left">
                <div>
                    <h1 class="wm_cd_title">Compliance Control Center</h1>
                    <div class="wm_cd_subtitle"><t t-esc="state.data ? state.data.company_name : 'Environmental Regulations &amp; Target Monitoring'"/></div>
                </div>
                <div class="wm_cd_time_pills">
                    <button t-att-class="state.activeTimeframe === 'today' ? 'time_pill active' : 'time_pill'" t-on-click="() => this.selectTimeframe('today')">Today</button>
                    <button t-att-class="state.activeTimeframe === 'week' ? 'time_pill active' : 'time_pill'" t-on-click="() => this.selectTimeframe('week')">Week</button>
                    <button t-att-class="state.activeTimeframe === 'month' ? 'time_pill active' : 'time_pill'" t-on-click="() => this.selectTimeframe('month')">Month</button>
                </div>
            </div>
            <div class="wm_cd_header_right">
                <button t-if="state.data and state.data.can_access_report" class="wm_cd_btn_report" t-on-click="openReportWizard" title="Open Report Builder">
                    <i class="fa fa-file-text-o"/>
                    <span>Report Builder</span>
                </button>
                <div class="wm_cd_live_status">
                    <span class="live_dot"/>
                    <span>Live Audit</span>
                </div>
                <button class="wm_cd_btn_refresh" t-on-click="onRefresh" t-att-disabled="state.loading">
                    <i t-att-class="state.loading ? 'fa fa-spinner fa-spin' : 'fa fa-refresh'"/>
                    <span t-if="!state.loading"> Refresh</span>
                    <span t-if="state.loading"> Loading…</span>
                </button>
            </div>
        </div>

        <!-- ── LOADING STATE ──────────────────────────────────── -->
        <div t-if="state.loading &amp;&amp; !state.data" class="wm_cd_loader">
            <i class="fa fa-spinner fa-spin wm_cd_spinner"/>
            <p>Loading compliance data…</p>
        </div>

        <!-- ── MAIN CONTENT ───────────────────────────────────── -->
        <div t-if="state.data" class="wm_cd_content">

            <!-- ── ROW 1: TOP 4 KPI CARDS ──────────────────────── -->
            <div class="wm_cd_top_kpi_row">

                <!-- 1. Manifests -->
                <div class="wm_cd_kpi_card kpi_manifests" t-on-click="() => this.onManifestStateClick('')">
                    <div class="kpi_label">MANIFEST TRACKING (<t t-esc="state.activeTimeframe.toUpperCase()"/>)</div>
                    <div class="kpi_main_val_wrap">
                        <span class="kpi_val text_blue"><t t-esc="state.data.total_manifests"/></span>
                        <span class="kpi_unit text_muted_lg">manifests (<t t-esc="state.data.total_quantity_selected"/> kg)</span>
                    </div>
                    <div class="kpi_sub_info">
                        <span class="sub_item" t-on-click.stop="() => this.onManifestStateClick('disposed')" title="View disposed manifests"><strong class="text_teal"><t t-esc="state.data.manifest_disposed"/></strong> disposed</span>
                        <span class="sub_item" t-on-click.stop="() => this.onManifestStateClick('collected')" title="View in-transit manifests"><strong class="text_blue"><t t-esc="state.data.manifest_collected"/></strong> transit (<t t-esc="state.data.manifest_transit_qty"/> kg)</span>
                        <span class="sub_item" t-on-click.stop="() => this.onManifestStateClick('submitted')" title="View submitted manifests"><strong class="text_amber"><t t-esc="state.data.manifest_submitted"/></strong> submitted</span>
                    </div>
                    <div class="kpi_progress_bar">
                        <div class="bar_segment bg_teal" t-attf-style="width: #{manifestProgressStyle.disposed}" title="Disposed Manifests"/>
                        <div class="bar_segment bg_blue" t-attf-style="width: #{manifestProgressStyle.collected}" title="Collected / In Transit"/>
                        <div class="bar_segment bg_amber" t-attf-style="width: #{manifestProgressStyle.submitted}" title="Submitted Manifests"/>
                    </div>
                </div>

                <!-- 2. Permits & Licences (Vault) -->
                <div class="wm_cd_kpi_card kpi_vault" t-on-click="onAllDocsClick">
                    <div class="kpi_label">PERMIT &amp; LICENCE VAULT</div>
                    <div class="kpi_main_val_wrap">
                        <span class="kpi_val text_teal"><t t-esc="state.data.total_vault_docs"/></span>
                        <span class="kpi_unit text_muted_lg">documents</span>
                    </div>
                    <div class="kpi_sub_info">
                        <span class="sub_item" t-on-click.stop="onAllDocsClick"><strong class="text_teal"><t t-esc="state.data.active_valid_docs_count"/></strong> valid</span>
                        <span class="sub_item" t-on-click.stop="onExpiringDocsClick"><strong class="text_amber"><t t-esc="state.data.expiring_docs_count"/></strong> expiring</span>
                        <span class="sub_item" t-on-click.stop="onExpiredDocsClick"><strong class="text_red"><t t-esc="state.data.expired_docs_count"/></strong> expired</span>
                    </div>
                    <div class="kpi_progress_bar">
                        <div class="bar_segment bg_teal" t-attf-style="width: #{documentProgressStyle.valid}" title="Active Valid Documents"/>
                        <div class="bar_segment bg_amber" t-attf-style="width: #{documentProgressStyle.expiring}" title="Expiring within 30 Days"/>
                        <div class="bar_segment bg_red" t-attf-style="width: #{documentProgressStyle.expired}" title="Expired Documents"/>
                    </div>
                </div>

                <!-- 3. Overdue & Custody Alerts -->
                <div class="wm_cd_kpi_card kpi_alerts" t-on-click="onOverdueClick">
                    <div class="kpi_label">REGULATORY ALERTS</div>
                    <div class="kpi_main_val_wrap">
                        <span t-att-class="state.data.overdue_manifest_count + state.data.pending_custody_count &gt; 0 ? 'kpi_val text_red' : 'kpi_val text_teal'">
                            <t t-esc="state.data.overdue_manifest_count + state.data.pending_custody_count"/>
                        </span>
                        <span t-if="state.data.overdue_manifest_count + state.data.pending_custody_count &gt; 0" class="kpi_badge_alert">ACTION REQ</span>
                        <span t-else="" class="kpi_badge_new">CLEAR</span>
                    </div>
                    <div class="kpi_sub_info">
                        <span class="sub_item" t-on-click.stop="onOverdueClick"><strong class="text_red"><t t-esc="state.data.overdue_manifest_count"/></strong> overdue (&gt;7d)</span>
                        <span class="sub_item" t-on-click.stop="onPendingCustodyClick"><strong class="text_amber"><t t-esc="state.data.pending_custody_count"/></strong> no custody</span>
                    </div>
                    <div class="kpi_progress_bar">
                        <div class="bar_segment bg_red" t-attf-style="width: #{state.data.overdue_manifest_count ? '60%' : '0%'}" title="Overdue Manifests"/>
                        <div class="bar_segment bg_amber" t-attf-style="width: #{state.data.pending_custody_count ? '40%' : '0%'}" title="Pending Custody Steps"/>
                    </div>
                </div>

                <!-- 4. Target Compliance -->
                <div class="wm_cd_kpi_card kpi_targets" t-on-click="() => this.onTargetStateClick('')">
                    <div class="kpi_label">TARGET COMPLIANCE SCORE</div>
                    <div class="kpi_main_val_wrap">
                        <span t-att-class="state.data.avg_target_compliance &gt;= 80 ? 'kpi_val text_teal' : (state.data.avg_target_compliance &gt;= 50 ? 'kpi_val text_amber' : 'kpi_val text_red')">
                            <t t-esc="state.data.avg_target_compliance"/>%
                        </span>
                    </div>
                    <div class="kpi_sub_info">
                        <span class="sub_item" t-on-click.stop="() => this.onTargetStateClick('on_track')"><strong class="text_teal"><t t-esc="state.data.targets_on_track"/></strong> on track</span>
                        <span class="sub_item" t-on-click.stop="() => this.onTargetStateClick('at_risk')"><strong class="text_amber"><t t-esc="state.data.targets_at_risk"/></strong> at risk</span>
                        <span class="sub_item" t-on-click.stop="() => this.onTargetStateClick('breached')"><strong class="text_red"><t t-esc="state.data.targets_breached"/></strong> breached</span>
                    </div>
                    <div class="kpi_progress_bar">
                        <div class="bar_segment bg_teal" t-attf-style="width: #{targetProgressStyle.on_track}" title="Targets On Track"/>
                        <div class="bar_segment bg_amber" t-attf-style="width: #{targetProgressStyle.at_risk}" title="Targets At Risk"/>
                        <div class="bar_segment bg_red" t-attf-style="width: #{targetProgressStyle.breached}" title="Targets Breached"/>
                    </div>
                </div>

            </div>

            <!-- ── ROW 2: MAIN CHARTS (2/3 + 1/3) ────────────────── -->
            <div class="wm_cd_main_charts_grid">

                <!-- Left Column: Stream Breakdown Bar Chart -->
                <div class="wm_cd_chart_card chart_stream">
                    <div class="chart_card_header">
                        <div class="chart_title">Manifest Volume &amp; Quantity by Stream (<t t-esc="state.activeTimeframe"/>)</div>
                        <div class="chart_custom_legend">
                            <span class="legend_item"><span class="dot bg_teal"></span> Selected Period</span>
                            <span class="legend_item"><span class="dot bg_grey"></span> Prior Period</span>
                        </div>
                    </div>
                    <div class="chart_card_body">
                        <canvas t-ref="streamChart"/>
                    </div>
                </div>

                <!-- Right Column: 2 Stacked Donut Cards -->
                <div class="wm_cd_right_donuts_col">

                    <!-- Target Health Donut -->
                    <div class="wm_cd_chart_card donut_card">
                        <div class="chart_title mb-2">Environmental Target Health</div>
                        <div class="donut_wrapper">
                            <div class="donut_canvas_box">
                                <canvas t-ref="targetChart"/>
                                <div class="donut_center_text">
                                    <div t-attf-class="center_val #{targetHealthColorClass}"><t t-esc="state.data.targets_on_track"/>/<t t-esc="state.data.total_targets"/></div>
                                    <div class="center_lbl"><t t-esc="targetHealthLabel"/></div>
                                </div>
                            </div>
                            <div class="donut_custom_legend">
                                <div class="legend_line" t-on-click="() => this.onTargetStateClick('on_track')">
                                    <span class="sq bg_teal"></span> On Track · <t t-esc="state.data.targets_on_track"/>
                                </div>
                                <div class="legend_line" t-on-click="() => this.onTargetStateClick('at_risk')">
                                    <span class="sq bg_amber"></span> At Risk · <t t-esc="state.data.targets_at_risk"/>
                                </div>
                                <div class="legend_line" t-on-click="() => this.onTargetStateClick('breached')">
                                    <span class="sq bg_red"></span> Breached · <t t-esc="state.data.targets_breached"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Certificates & Signatures Donut -->
                    <div class="wm_cd_chart_card donut_card">
                        <div class="chart_title mb-2">Certificates &amp; Digital Signatures</div>
                        <div class="donut_wrapper">
                            <div class="donut_canvas_box">
                                <canvas t-ref="certificateChart"/>
                                <div class="donut_center_text">
                                    <div class="center_val text_teal"><t t-esc="state.data.certificates_issued"/></div>
                                    <div class="center_lbl">ISSUED</div>
                                </div>
                            </div>
                            <div class="donut_custom_legend">
                                <div class="legend_line" t-on-click="() => this.onCertificateStateClick('issued')" style="cursor: pointer;">
                                    <span class="sq bg_teal"></span> Signed &amp; Issued · <t t-esc="state.data.certificates_issued"/>
                                </div>
                                <div class="legend_line" t-on-click="() => this.onCertificateStateClick('draft')" style="cursor: pointer;">
                                    <span class="sq bg_grey"></span> Draft Pending · <t t-esc="state.data.certificates_draft"/>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <!-- ── ROW 3: BOTTOM 3 COLUMNS ────────────────────────── -->
            <div class="wm_cd_bottom_3col_grid">

                <!-- Col 1: Waste Stream Distribution -->
                <div class="wm_cd_chart_card bottom_card">
                    <div class="panel_header_with_badge">
                        <span class="chart_title">Stream distribution</span>
                        <span class="badge_pill bg_blue_pill"><t t-esc="state.data.total_stream_qty"/> kg TOTAL</span>
                    </div>
                    <t t-if="state.data.stream_data and state.data.stream_data.length &gt; 0">
                        <div class="donut_wrapper horizon">
                            <div class="donut_canvas_box_lg">
                                <canvas t-ref="streamShareChart"/>
                                <div class="donut_center_text">
                                    <div class="center_val text_white" style="font-size: 15px;"><t t-esc="state.data.total_stream_qty || 0"/></div>
                                    <div class="center_lbl">KG</div>
                                </div>
                            </div>
                            <div class="donut_grid_legend">
                                <t t-if="state.data.total_stream_qty &gt; 0">
                                    <t t-foreach="state.data.stream_data" t-as="stream" t-key="stream.code">
                                        <t t-if="stream.quantity &gt; 0">
                                            <div class="stream_leg_card" t-on-click="() => this.onStreamClick(stream.code, stream.name)" style="cursor: pointer;" t-att-title="stream.name + ': ' + stream.quantity + ' kg (' + stream.percentage + '%)'">
                                                <div class="stream_leg_header">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="sq" t-attf-style="background-color: #{stream.color} !important;"/>
                                                        <span class="stream_name_text"><t t-esc="stream.name"/></span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="stream_qty_text"><t t-esc="stream.quantity"/> kg</span>
                                                        <strong class="stream_pct_text" t-attf-style="color: #{stream.color} !important;"><t t-esc="stream.percentage"/>%</strong>
                                                    </div>
                                                </div>
                                                <div class="stream_progress_bg">
                                                    <div class="stream_progress_fill" t-attf-style="width: #{Math.max(stream.percentage, 2)}%; background-color: #{stream.color} !important;"/>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="empty_stream_card">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <i class="fa fa-info-circle text_muted"/>
                                            <span class="text_muted_sm" style="font-weight: 600; color: #94A3B8;">No stream collections for <t t-esc="state.activeTimeframe"/></span>
                                        </div>
                                        <div style="color: #64748B; font-size: 11px;">Select Week or Month to view accumulated manifest stream metrics.</div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="empty_text_dark d-flex align-items-center justify-content-center" style="flex: 1; min-height: 160px;">
                            No waste streams collected for this period.
                        </div>
                    </t>
                </div>

                <!-- Col 2: Expiring Permits & Licences (Vault) -->
                <div class="wm_cd_chart_card bottom_card">
                    <div class="panel_header_with_badge">
                        <div class="d-flex align-items-center gap-2">
                            <span class="chart_title">Permit Vault Alerts</span>
                            <span t-att-class="state.data.expiring_documents_list.length &gt; 0 ? 'badge_pill bg_amber_pill' : 'badge_pill bg_teal_pill'">
                                <t t-esc="state.data.expiring_documents_list.length"/> URGENT
                            </span>
                        </div>
                        <button class="btn_view_all_link" t-on-click="onAllDocsClick" title="View all permits and licences">
                            View all <i class="fa fa-arrow-right ms-1"/>
                        </button>
                    </div>
                    <div class="dark_list_container">
                        <t t-foreach="state.data.expiring_documents_list.slice(0, 5)" t-as="doc" t-key="doc.id">
                            <div class="dark_list_item" t-on-click="() => this.onDocumentClick(doc.id)">
                                <span t-att-class="doc.is_expired ? 'code_pill red_code_pill' : 'code_pill amber_code_pill'">
                                    <t t-esc="doc.type"/>
                                </span>
                                <div class="item_desc text_light_partner" t-att-title="doc.name"><t t-esc="doc.name"/></div>
                                <span t-att-class="doc.is_expired ? 'failed_code' : 'item_date'"><t t-esc="doc.status_label"/></span>
                            </div>
                        </t>
                        <t t-if="state.data.expiring_documents_list.length === 0">
                            <div class="empty_text_dark">All permits and licences are active and valid.</div>
                        </t>
                    </div>
                </div>

                <!-- Col 3: Urgent Overdue & Custody Manifests -->
                <div class="wm_cd_chart_card bottom_card">
                    <div class="panel_header_with_badge">
                        <div class="d-flex align-items-center gap-2">
                            <span class="chart_title">Custody &amp; Overdue Backlog</span>
                            <span t-att-class="state.data.urgent_manifests.length &gt; 0 ? 'badge_pill bg_red_pill' : 'badge_pill bg_teal_pill'">
                                <t t-esc="state.data.urgent_manifests.length"/> ATTENTION
                            </span>
                        </div>
                        <button class="btn_view_all_link" t-on-click="openAllManifests" title="View all compliance manifests">
                            View all <i class="fa fa-arrow-right ms-1"/>
                        </button>
                    </div>
                    <div class="dark_list_container">
                        <t t-foreach="state.data.urgent_manifests.slice(0, 5)" t-as="mnf" t-key="mnf.id">
                            <div class="dark_list_item" t-on-click="() => this.onManifestClick(mnf.id)">
                                <span t-att-class="mnf.issue === 'overdue' ? 'code_pill red_code_pill' : 'code_pill amber_code_pill'">
                                    <t t-esc="mnf.name"/>
                                </span>
                                <div class="item_desc text_light_partner" t-att-title="mnf.generator"><t t-esc="mnf.generator"/><t t-if="mnf.stream"> · <t t-esc="mnf.stream"/></t></div>
                                <span class="failed_code" t-if="mnf.issue === 'overdue'"><t t-esc="mnf.issue_label"/></span>
                                <span class="text_amber fw-bold" style="font-size: 11px;" t-else=""><t t-esc="mnf.issue_label"/></span>
                            </div>
                        </t>
                        <t t-if="state.data.urgent_manifests.length === 0">
                            <div class="empty_text_dark">No overdue manifests or missing custody logs.</div>
                        </t>
                    </div>
                </div>

            </div>

            <!-- ── QUICK ACTIONS COMMAND BAR ───────────────────────── -->
            <div class="wm_cd_nav_bar">
                <span class="wm_cd_nav_title">Compliance Quick Access:</span>
                <div class="wm_cd_nav_links">
                    <button class="btn_cd_quick_link" t-on-click="openAllManifests">
                        <i class="fa fa-truck me-1"/> All Manifests
                    </button>
                    <button class="btn_cd_quick_link" t-on-click="openAllCertificates">
                        <i class="fa fa-certificate me-1"/> Certificates
                    </button>
                    <button class="btn_cd_quick_link" t-on-click="onAllDocsClick">
                        <i class="fa fa-folder-open me-1"/> Permits &amp; Licences
                    </button>
                    <button class="btn_cd_quick_link" t-on-click="openAllTargets">
                        <i class="fa fa-bullseye me-1"/> Environmental Targets
                    </button>
                    <button t-if="state.data and state.data.can_access_facility" class="btn_cd_quick_link" t-on-click="openAllFacilities">
                        <i class="fa fa-building me-1"/> Disposal Facilities (<t t-esc="state.data.facility_count"/>)
                    </button>
                    <button t-if="state.data and state.data.can_access_report" class="btn_cd_quick_link highlight" t-on-click="openReportWizard">
                        <i class="fa fa-file-text-o me-1"/> Regulatory Report Builder
                    </button>
                </div>
            </div>

        </div>
    </div>
</t>

</templates>
