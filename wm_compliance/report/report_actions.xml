<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compliance Manifest PDF Report Action -->
    <record id="action_report_compliance_manifest" model="ir.actions.report">
        <field name="name">Compliance Manifest</field>
        <field name="model">wm.compliance.manifest</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wm_compliance.report_compliance_manifest_template</field>
        <field name="report_file">wm_compliance.report_compliance_manifest_template</field>
        <field name="binding_model_id" ref="model_wm_compliance_manifest"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Compliance Certificate PDF Report Action -->
    <record id="action_report_compliance_certificate" model="ir.actions.report">
        <field name="name">Compliance Certificate</field>
        <field name="model">wm.compliance.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wm_compliance.report_compliance_certificate_template</field>
        <field name="report_file">wm_compliance.report_compliance_certificate_template</field>
        <field name="binding_model_id" ref="model_wm_compliance_certificate"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
