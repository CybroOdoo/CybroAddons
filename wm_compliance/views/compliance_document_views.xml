<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Document Vault List View -->
    <record id="view_wm_compliance_document_list" model="ir.ui.view">
        <field name="name">wm.compliance.document.list</field>
        <field name="model">wm.compliance.document</field>
        <field name="arch" type="xml">
            <list string="Compliance Documents" decoration-danger="expiry_date &lt;= current_date">
                <field name="name"/>
                <field name="document_type"/>

                <field name="expiry_date"/>
                <field name="reminder_days"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Document Vault Form View -->
    <record id="view_wm_compliance_document_form" model="ir.ui.view">
        <field name="name">wm.compliance.document.form</field>
        <field name="model">wm.compliance.document</field>
        <field name="arch" type="xml">
            <form string="Compliance Licence / Permit">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Document Name"/>
                        <h1><field name="name" placeholder="e.g. EPA Handling Permit 2026"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="document_type"/>
                            <field name="attachment_file" filename="attachment_filename"/>
                            <field name="attachment_filename" invisible="1"/>
                        </group>
                        <group string="Expiry &amp; Notification Thresholds">
                            <field name="expiry_date"/>
                            <field name="reminder_days"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Document Vault Search View -->
    <record id="view_wm_compliance_document_search" model="ir.ui.view">
        <field name="name">wm.compliance.document.search</field>
        <field name="model">wm.compliance.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_type"/>
                <filter string="Expired" name="expired" domain="[('expiry_date', '&lt;=', context_today())]"/>
                <group>
                    <filter string="Responsible" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Document Type" name="group_by_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Expiry Date" name="group_by_expiry" context="{'group_by': 'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_wm_compliance_document" model="ir.actions.act_window">
        <field name="name">Permit &amp; Licence Vault</field>
        <field name="res_model">wm.compliance.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wm_compliance_document_search"/>
    </record>
</odoo>
