<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Regulatory Report Wizard Form View -->
    <record id="view_wm_compliance_report_form" model="ir.ui.view">
        <field name="name">wm.compliance.report.form</field>
        <field name="model">wm.compliance.report</field>
        <field name="arch" type="xml">
            <form string="Generate Compliance Report">
                <group>
                    <group string="Report Configuration">
                        <field name="report_type"/>
                        <field name="output_format"/>
                        <field name="facility_id"/>
                    </group>
                    <group string="Period &amp; Company">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate Report" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Report Wizard -->
    <record id="action_wm_compliance_report_wizard" model="ir.actions.act_window">
        <field name="name">Compliance Reports</field>
        <field name="res_model">wm.compliance.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wm_compliance_report_form"/>
        <field name="target">new</field>
    </record>

    <!-- Client Action that mounts the OWL compliance dashboard component -->
    <record id="action_wm_compliance_dashboard_client" model="ir.actions.client">
        <field name="name">Compliance Dashboard</field>
        <field name="tag">wm_compliance.Dashboard</field>
    </record>
</odoo>
