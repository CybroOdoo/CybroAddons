<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.digital.signature - List -->
    <record id="view_wm_digital_signature_list" model="ir.ui.view">
        <field name="name">wm.digital.signature.list</field>
        <field name="model">wm.digital.signature</field>
        <field name="arch" type="xml">
            <list string="Digital Signatures" create="0" edit="0">
                <field name="display_name" string="Signature Record"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="signer_id"/>
                <field name="signed_at"/>
                <field name="pdf_attachment_id"/>
                <field name="hash_verified" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- View: wm.digital.signature - Form -->
    <record id="view_wm_digital_signature_form" model="ir.ui.view">
        <field name="name">wm.digital.signature.form</field>
        <field name="model">wm.digital.signature</field>
        <field name="arch" type="xml">
            <form string="Digital Signature" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Signature Metadata">
                            <field name="signer_id" readonly="1"/>
                            <field name="signed_at" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Target Document">
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="pdf_attachment_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Tamper Evidence &amp; Verification">
                        <field name="pdf_hash" readonly="1"/>
                        <field name="hash_verified" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View: wm.digital.signature - Search -->
    <record id="view_wm_digital_signature_search" model="ir.ui.view">
        <field name="name">wm.digital.signature.search</field>
        <field name="model">wm.digital.signature</field>
        <field name="arch" type="xml">
            <search string="Search Digital Signatures">
                <field name="signer_id"/>
                <field name="res_model"/>
                <field name="pdf_hash"/>
                <group>
                    <filter string="Signer" name="group_signer" context="{'group_by': 'signer_id'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'res_model'}"/>
                    <filter string="Signed Date" name="group_date" context="{'group_by': 'signed_at'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Digital Signatures -->
    <record id="action_wm_digital_signature" model="ir.actions.act_window">
        <field name="name">Digital Signatures</field>
        <field name="res_model">wm.digital.signature</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wm_digital_signature_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No digital signatures recorded yet</p>
            <p>Cryptographic SHA-256 tamper-evident signatures captured on compliance certificates and manifests appear here.</p>
        </field>
    </record>
</odoo>
