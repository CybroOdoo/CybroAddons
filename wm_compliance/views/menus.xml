<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ROOT MENU -->
    <menuitem id="menu_wm_compliance_root"
              name="Compliance"
              web_icon="wm_compliance,static/description/icon.png"
              groups="wm_base.group_wm_compliance_officer,wm_base.group_wm_ops_manager,wm_base.group_wm_admin"
              sequence="50"/>

    <!-- LEVEL 1 SUBMENUS -->
    <menuitem id="menu_wm_compliance_operations"
              name="Operations"
              parent="menu_wm_compliance_root"
              groups="wm_base.group_wm_compliance_officer,wm_base.group_wm_ops_manager,wm_base.group_wm_admin"
              sequence="10"/>

    <!-- Menu: Reporting -->
    <menuitem id="menu_wm_compliance_reporting"
              name="Reporting"
              parent="menu_wm_compliance_root"
              groups="wm_base.group_wm_compliance_officer,wm_base.group_wm_ops_manager,wm_base.group_wm_admin"
              sequence="20"/>

    <!-- Menu: Configuration -->
    <menuitem id="menu_wm_compliance_configuration"
              name="Configuration"
              parent="menu_wm_compliance_root"
              groups="wm_base.group_wm_compliance_officer,wm_base.group_wm_ops_manager,wm_base.group_wm_admin"
              sequence="30"/>

    <!-- LEVEL 2: DASHBOARD (Kept at Root for easy access) -->
    <menuitem id="menu_wm_compliance_dashboard"
              name="Dashboard"
              parent="menu_wm_compliance_root"
              action="action_wm_compliance_dashboard_client"
              groups="wm_base.group_wm_compliance_officer,wm_base.group_wm_ops_manager,wm_base.group_wm_admin"
              sequence="5"/>

    <!-- LEVEL 2: OPERATIONS -->
    <menuitem id="menu_wm_compliance_manifest"
              name="Manifests"
              parent="menu_wm_compliance_operations"
              action="action_wm_compliance_manifest"
              sequence="10"/>

    <!-- Menu: Certificates -->
    <menuitem id="menu_wm_compliance_certificate"
              name="Certificates"
              parent="menu_wm_compliance_operations"
              action="action_wm_compliance_certificate"
              sequence="20"/>

    <!-- Menu: Permits & Licences -->
    <menuitem id="menu_wm_compliance_document"
              name="Permits &amp; Licences"
              parent="menu_wm_compliance_operations"
              action="action_wm_compliance_document"
              sequence="30"/>

    <!-- LEVEL 2: REPORTING -->
    <menuitem id="menu_wm_compliance_report_builder"
              name="Report Builder"
              parent="menu_wm_compliance_reporting"
              action="action_wm_compliance_report_wizard"
              groups="wm_base.group_wm_compliance_officer,wm_base.group_wm_ops_manager,wm_base.group_wm_admin"
              sequence="10"/>

    <!-- LEVEL 2: CONFIGURATION -->
    <menuitem id="menu_wm_compliance_target"
              name="Targets"
              parent="menu_wm_compliance_configuration"
              action="action_wm_compliance_target"
              sequence="10"/>

    <!-- Menu: Disposal Facilities -->
    <menuitem id="menu_wm_disposal_facility"
              name="Disposal Facilities"
              parent="menu_wm_compliance_configuration"
              action="action_wm_disposal_facility"
              groups="wm_base.group_wm_compliance_officer,wm_base.group_wm_ops_manager,wm_base.group_wm_admin"
              sequence="20"/>

    <!-- Menu: Compliance Codes -->
    <menuitem id="menu_wm_compliance_code"
              name="Compliance Codes"
              parent="menu_wm_compliance_configuration"
              action="wm_base.action_wm_compliance_code"
              sequence="30"/>

    <!-- Explicit replacement of group_ids to prevent additive XML group accumulation -->
    <record id="menu_wm_compliance_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('wm_base.group_wm_compliance_officer'), ref('wm_base.group_wm_ops_manager'), ref('wm_base.group_wm_admin')])]"/>
    </record>
    <record id="menu_wm_compliance_operations" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('wm_base.group_wm_compliance_officer'), ref('wm_base.group_wm_ops_manager'), ref('wm_base.group_wm_admin')])]"/>
    </record>
    <record id="menu_wm_compliance_reporting" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('wm_base.group_wm_compliance_officer'), ref('wm_base.group_wm_ops_manager'), ref('wm_base.group_wm_admin')])]"/>
    </record>
    <record id="menu_wm_compliance_report_builder" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('wm_base.group_wm_compliance_officer'), ref('wm_base.group_wm_ops_manager'), ref('wm_base.group_wm_admin')])]"/>
    </record>
</odoo>
