<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Multi-Company Rules -->
        <record id="rule_wm_disposal_facility_company" model="ir.rule">
            <field name="name">Disposal Facility Multi-Company Rule</field>
            <field name="model_id" ref="model_wm_disposal_facility"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

