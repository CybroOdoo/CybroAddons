<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inheriting purchase order template and adding the image feature -->
    <template id="report_purchaseorder_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <t t-if="o.show_product_image_setting">
                <th><strong>Image</strong></th>
            </t>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <t t-if="o.show_product_image_setting">
                <td style="width:40px;height:40px;">
                    <span t-field="line.order_line_image" t-options="{'widget': 'image'}"/>
                </td>
            </t>
        </xpath>
        <xpath expr="//td[@id='section']" position="attributes">
            <attribute name="t-att-colspan">6 if o.show_product_image_setting else 5</attribute>
        </xpath>
    </template>

    <!-- Inheriting purchase quotation (RFQ) template and adding the image feature -->
    <template id="report_purchasequotation_inherit" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <t t-if="o.show_product_image_setting">
                <th><strong>Image</strong></th>
            </t>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <t t-if="o.show_product_image_setting">
                <td style="width:40px;height:40px;">
                    <span t-field="order_line.order_line_image" t-options="{'widget': 'image'}"/>
                </td>
            </t>
        </xpath>
    </template>
</odoo>
