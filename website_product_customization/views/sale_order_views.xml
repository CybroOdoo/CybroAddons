<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Adds an "image" field called "product_design" after
         the "name" field in the tree view of the "sale.order" model. It allows
         displaying product design images in the order line view.-->
    <record id="view_order_form_inherit_website_product_customization" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.website.product.customization</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//column[@name='product_and_description']"
                   position="after">
                <field name="product_design" widget="image" class="oe_avatar" optional="show" string="Product Design"/>
                <field name="is_customized_product" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
