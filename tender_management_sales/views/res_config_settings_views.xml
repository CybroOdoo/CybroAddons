<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited configuration settings form view to enable the tender management feature -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tender.management.sales</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='proforma_configuration']" position="before">
                <setting id="manage_sale_agreements" help="Manage your sale agreements.">
                    <field name="is_tender_sales"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
