<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agreement sample data -->
    <data noupdate="1">
        <record id="seq_sale_tender" model="ir.sequence">
            <field name="name">Sale Tender</field>
            <field name="code">sale.tender.order</field>
            <field name="prefix">ST</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Default Agreement Types -->
        <record id="type_exclusive" model="sale.tender.type">
            <field name="name">Exclusive Agreement</field>
            <field name="exclusive">exclusive</field>
            <field name="quantity_copy">copy</field>
            <field name="line_copy">copy</field>
        </record>
        <record id="type_multiple" model="sale.tender.type">
            <field name="name">Non-Exclusive Agreement</field>
            <field name="exclusive">multiple</field>
            <field name="quantity_copy">none</field>
            <field name="line_copy">copy</field>
        </record>
    </data>
</odoo>
