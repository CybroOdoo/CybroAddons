<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Inherited Template for invoice document-->
    <template id="report_invoice_customized"
              inherit_id="account.report_invoice_document">
        <xpath expr="//span[@t-field='line.discount']" position="replace">
            <span t-out="'%.2f'%(line.discount)"/>
        </xpath>
        <xpath expr="//t[@t-call='account.document_tax_totals']"
               position="attributes">
            <attribute name="amt_discount">o.amount_discount</attribute>
        </xpath>
    </template>
    <!--amt_discount into the totals table-->
     <template id="sale_order_portal_totals_customized"
              inherit_id="sale.sale_order_portal_content_totals_table">
        <xpath expr="//t[@t-call]" position="attributes">
            <attribute name="amt_discount">sale_order.amount_discount</attribute>
        </xpath>
    </template>
    <template id="report_invoice_customized_subtotal"
              inherit_id="account.document_tax_totals_template">
        <xpath expr="//tr[hasclass('o_subtotal')]" position="after">
            <tr t-if="amt_discount and subtotal_first">
                <td>Discount</td>
                <td class="text-end">
                    <span t-out="amt_discount" t-options='{"widget": "monetary", "display_currency": currency}'/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>

