<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Inherited Template for sale order report-->
    <template id="report_saleorder_customized"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//span[@t-field='line.discount']" position="replace">
            <span t-out="'%.2f'%(line.discount)"/>
        </xpath>
        <xpath expr="//t[@t-call='sale.document_tax_totals']" position="attributes">
            <attribute name="amt_discount">doc.amount_discount</attribute>
        </xpath>
    </template>
</odoo>
