<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="portal_legal_case" model="portal.entry">
        <field name="name">Legal Case</field>
        <field name="description">Your case details</field>
        <field name="url">/my/legal/case</field>
        <field name="image" type="bytes" file="legal_case_management/static/description/case-round-svgrepo-com.svg"/>
        <field name="placeholder_count">case_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="60"/>
    </record>
</odoo>
