<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Warranty page in the product form -->
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.product.warranty.management.odoo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="Warranty" name="warranty">
                    <group>
                        <group>
                            <field name="is_warranty_available"/>
                            <field name="warranty_duration"
                                   invisible="not is_warranty_available"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
