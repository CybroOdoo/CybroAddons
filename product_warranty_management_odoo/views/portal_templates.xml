<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal list of the customer's warranty claims -->
    <template id="portal_warranty_claims" name="My Warranty Claims">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">
            <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True"
               title.translate="Warranty Claims"/>
            <div t-if="not claims" class="alert alert-warning" role="alert">
                There are currently no warranty claims for your account.
            </div>
            <t t-else="" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Sale Order</th>
                        <th>Product</th>
                        <th>Warranty Expiry Date</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="claims" t-as="claim">
                        <td><span t-field="claim.sale_order_id"/></td>
                        <td><span t-field="claim.product_id"/></td>
                        <td><span t-field="claim.product_expiry_date"/></td>
                        <td class="text-end">
                            <span t-field="claim.state"/>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>
    <!-- Breadcrumb entry of the warranty claims page -->
    <template id="portal_my_home_menu_claims"
              name="Portal layout: warranty claims menu entries"
              inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'warranty_claims'"
                class="breadcrumb-item active">
                Warranty Claims
            </li>
        </xpath>
    </template>
</odoo>
