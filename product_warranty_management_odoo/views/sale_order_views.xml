<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Warranty smart button in the sale order form -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.product.warranty.management.odoo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_warranty_check" invisible="1"/>
                <button name="action_open_warranty_details"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock-o"
                        string="Warranty"
                        invisible="not is_warranty_check"/>
            </xpath>
        </field>
    </record>
    <!-- Warranty details list of the sale order lines -->
    <record id="sale_order_line_view_list_warranty" model="ir.ui.view">
        <field name="name">sale.order.line.view.list.warranty</field>
        <field name="model">sale.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="warranty_duration"/>
                <field name="warranty_expiry_date"/>
            </list>
        </field>
    </record>
    <!-- Warranty details form of a sale order line -->
    <record id="sale_order_line_view_form_warranty" model="ir.ui.view">
        <field name="name">sale.order.line.view.form.warranty</field>
        <field name="model">sale.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="warranty_duration"/>
                        <field name="warranty_expiry_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
