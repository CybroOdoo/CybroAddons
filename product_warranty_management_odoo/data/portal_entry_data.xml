<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--    Portal card to open my claims-->
    <record id="portal_my_claims" model="portal.entry">
        <field name="name">My Claims</field>
        <field name="description">Follow your warranty claims</field>
        <field name="url">/my/claims</field>
        <field name="image" type="bytes"
               file="product_warranty_management_odoo/static/src/img/warranty_claim.svg"/>
        <field name="placeholder_count">claim_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="60"/>
    </record>
</odoo>
