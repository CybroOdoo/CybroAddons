<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_oil_tender" model="ir.sequence">
            <field name="name">Oil Tender Sequence</field>
            <field name="code">oil.tender</field>
            <field name="prefix">TND/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_oil_tender_bid" model="ir.sequence">
            <field name="name">Oil Tender Bid Sequence</field>
            <field name="code">oil.tender.bid</field>
            <field name="prefix">BID/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
