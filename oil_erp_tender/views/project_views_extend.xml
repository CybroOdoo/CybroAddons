<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_project_form_tender_inherit" model="ir.ui.view">
        <field name="name">project.project.form.tender.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- If the standard project.edit_project form has button_box -->
                <button class="oe_stat_button" type="action" 
                        name="%(oil_erp_tender.action_oil_tender)d" 
                        icon="fa-legal"
                        context="{'search_default_project_id': id, 'default_project_id': id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Tenders</span>
                    </div>
                </button>
                <button class="oe_stat_button" type="action" 
                        name="%(oil_erp_contract.action_oil_contract)d" 
                        icon="fa-file-text-o"
                        context="{'search_default_project_id': id, 'default_project_id': id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Contracts</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
