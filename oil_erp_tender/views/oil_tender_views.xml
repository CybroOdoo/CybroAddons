<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Master Tender Views -->
        <record id="view_oil_tender_form" model="ir.ui.view">
            <field name="name">oil.tender.form</field>
            <field name="model">oil.tender</field>
            <field name="arch" type="xml">
                <form string="Tender">
                    <header>
                        <button name="action_publish" string="Publish" type="object" class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="action_evaluate" string="Evaluate (Find Lowest)" type="object"
                                class="oe_highlight" invisible="state != 'published'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,published,evaluation,awarded"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_contract" type="object" class="oe_stat_button"
                                    icon="fa-file-text-o" invisible="not contract_id">
                                <span class="o_stat_text">Contract</span>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="issue_date" readonly="state == 'awarded'"/>
                                <field name="project_id" readonly="state == 'awarded'"
                                       domain="[('is_oil_gas_project', '=', True)]"/>
                                <field name="contract_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="deadline" readonly="state == 'awarded'"/>
                            </group>
                        </group>
                        <group string="Work Details">
                            <field name="description" nolabel="1" placeholder="Describe the work details here..."
                                   readonly="state == 'awarded'"/>
                        </group>
                        <notebook>
                            <page string="Bids Received">
                                <field name="bid_ids" readonly="state not in ('published', 'evaluation')">
                                    <list decoration-success="is_confirmed" decoration-warning="is_lowest">
                                        <field name="partner_id"/>
                                        <field name="bid_price"/>
                                        <field name="submission_date"/>
                                        <field name="stage_id" widget="badge"
                                               decoration-success="stage_id == 'confirmed'"
                                               decoration-danger="stage_id == 'rejected'"
                                               column_invisible="parent.state != 'awarded'"/>
                                        <field name="is_confirmed" column_invisible="True"/>
                                        <button name="action_confirm_bid" string="Confirm" type="object"
                                                class="oe_highlight" invisible="parent.state != 'evaluation'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_oil_tender_bid_form" model="ir.ui.view">
            <field name="name">oil.tender.bid.form</field>
            <field name="model">oil.tender.bid</field>
            <field name="arch" type="xml">
                <form string="Bids">
                    <sheet>
                        <group>
                            <field name="tender_id"/>
                            <field name="bid_price"/>
                            <field name="submission_date"/>
                            <field name="partner_id"/>
                            <field name="is_confirmed" invisible="1"/>
                            <field name="is_lowest" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_oil_tender_list" model="ir.ui.view">
            <field name="name">oil.tender.list</field>
            <field name="model">oil.tender</field>
            <field name="arch" type="xml">
                <list string="Tenders">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="deadline"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>


        <!-- Actions -->
        <record id="action_oil_tender" model="ir.actions.act_window">
            <field name="name">Tenders</field>
            <field name="res_model">oil.tender</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first tender.
                </p>
            </field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_oil_tender_tenders"
                  name="Tenders"
                  parent="oil_erp_base.menu_oil_procurement_root"
                  action="action_oil_tender"
                  sequence="10"/>

    </data>
</odoo>

