<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oil_contract_form_tender_inherit" model="ir.ui.view">
        <field name="name">oil.contract.form.tender.inherit</field>
        <field name="model">oil.contract</field>
        <field name="inherit_id" ref="oil_erp_contract.view_oil_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vendor_id']" position="after">
                <field name="tender_id"/>
            </xpath>
        </field>
    </record>
</odoo>
