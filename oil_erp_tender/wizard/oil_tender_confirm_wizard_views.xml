<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oil_tender_confirm_wizard_form" model="ir.ui.view">
        <field name="name">oil.tender.confirm.wizard.form</field>
        <field name="model">oil.tender.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Winning Bid">
                <sheet>
                    <group>
                        <field name="tender_id" readonly="1"/>
                        <field name="partner_id"/>
                        <field name="bid_price"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <p class="text-muted">
                        Confirming this bid will automatically create a contract and remove all other bids for this tender.
                    </p>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
