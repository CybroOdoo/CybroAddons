<?xml version="1.0" encoding="UTF-8"?>
<!--Template for adding the image that set from the config-->
<templates id="point_of_sale.template" xml:space="preserve">
    <t t-name="point_of_sale_logo.Navbar" t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-leftheader')]"
               position="before">
            <img class="h-10 ms-3 me-auto align-self-center"
                 t-if="this.pos.config.image"
                 t-attf-src="/web/image?model=pos.config&amp;field=image&amp;id={{ this.pos.config.id }}"
                 style="max-height:40px; object-fit:contain; padding-right:30px;"/>
        </xpath>
    </t>
</templates>
