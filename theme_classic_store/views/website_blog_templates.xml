<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="opt_blog_cover_post_fullwidth_design_classic"
              name="Blog Banner classic"
              inherit_id="website_blog.blog_post_short"
              active="True"
              priority="20">
        <xpath expr="//div[@id='o_wblog_blog_top']" position="before">
            <section t-if="not blog" class="banner_about">
                <div class="container">
                    <h3>Blog</h3>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
