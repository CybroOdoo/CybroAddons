<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="theme_classic_store_snippet_groups" inherit_id="website.snippets" name="Classic Store Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]"
               position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/about_us_block.jpg" string="Sections" snippet-group="cs_section"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/categories_block.jpg" string="Products" snippet-group="cs_products"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/packages_block.jpg" string="Classic Store Others" snippet-group="cs_others"/>
        </xpath>
    </template>
</odoo>