<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="s_classic_store_banner" name="Banner">
        <!-- the template defines a banner section with a card element displaying a message
        and a popular categories section with clickable buttons. -->
        <section class="banner">
            <div class="container">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Buy &amp; Sells Near You</h5>
                        <p class="card-text">Join the millions who buy and sell
                            from each other
                            <br/>
                            everyday in local communities around the world
                        </p>
                    </div>
                </div>
                <div class="populor text-center">
                    <h4>POPULAR CATEGORIES</h4>
                    <div class="populor-buttons">
                        <a href="" class="btn btn-pop">
                            <i class="oi" data-icon="bed" role="img"/>
                            Hotel
                        </a>
                        <a href="" class="btn btn-pop"><i class="oi" data-icon="oi_grav" role="img"/>Fitness
                        </a>
                        <a href="" class="btn btn-pop"><i class="oi" data-icon="directions_car" role="img"/>Car
                        </a>
                        <a href="" class="btn btn-pop"><i class="oi" data-icon="oi_android" role="img"/>Gadgets
                        </a>
                        <a href="" class="btn btn-pop"><i class="oi" data-icon="coffee" role="img"/>Cafe
                        </a>
                    </div>
                </div>
            </div>
        </section>
        <div class="oe_structure"/>
    </template>
</odoo>