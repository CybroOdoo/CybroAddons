<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="classic_store_snippets_content" inherit_id="website.snippets" name="Classic Store Snippets">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_classic_store.s_classic_store_about" string="About" group="cs_section"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/about_us_block.jpg"/>
            <t t-snippet="theme_classic_store.s_classic_store_banner" string="Banner" group="cs_section"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/banner_block.jpg"/>
            <t t-snippet="theme_classic_store.s_classic_store_categories" string="Categories" group="cs_products"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/categories_block.jpg"/>
            <t t-snippet="theme_classic_store.s_classic_store_package" string="Package" group="cs_others"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/packages_block.jpg"/>
            <t t-snippet="theme_classic_store.s_classic_store_team" string="Team" group="cs_others"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/team_members_block.jpg"/>
            <t t-snippet="theme_classic_store.s_classic_store_search" string="Search" group="cs_others"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/search_bar_block.jpg"/>
            <t t-snippet="theme_classic_store.s_classic_store_counter" string="Counter" group="cs_others"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/counter_block.jpg"/>
            <t t-snippet="theme_classic_store.s_classic_store_trending" string="Trending" group="cs_products"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/trending-products.jpg"/>
            <t t-snippet="theme_classic_store.s_classic_store_sub_header" string="Header" group="cs_others"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/sub_header_block.jpg"/>
            <t t-snippet="theme_classic_store.s_classic_store_listing" string="Listing" group="cs_products"
               t-thumbnail="/theme_classic_store/static/src/images/snippets/listing_block.jpg"/>
        </xpath>
    </template>
</odoo>
