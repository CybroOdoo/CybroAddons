<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="s_classic_store_listing" name="Listing">
        <!-- The template defines a section on a website called "Listing", which includes
        a call-to-action message and two buttons to add or browse listings. -->
        <section class="listing">
            <div class="container text-center">
                <div class="row mb-5">
                    <div class="col-12">
                        <h4 class="listing_title">Experience a Smarter Way to Shop</h4>
                    </div>
                </div>
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <div class="listing_item">
                            <i class="fa fa-check mb-3"></i>
                            <h5>Premium Products</h5>
                            <p>Handpicked quality for you.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="listing_item">
                            <i class="fa fa-truck mb-3"></i>
                            <h5>Worldwide Shipping</h5>
                            <p>Fast delivery to your door.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="listing_item">
                            <i class="fa fa-shield mb-3"></i>
                            <h5>Secure Payments</h5>
                            <p>100% safe transactions.</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 ct_buttons">
                        <a href="/shop" class="btn btn-cta">
                            Add Listing
                        </a>
                        <a href="/contactus" class="btn btn-ctb">
                            Browser Listing
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
