<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="snippet_banner_options" inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-js="background"
                 data-selector=".s_classic_store_banner"
                 data-drop-in=".row, .container"
                 data-drop-near=".s_classic_store_banner, section"/>
        </xpath>
    </template>
</odoo>