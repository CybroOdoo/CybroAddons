<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="classic_store_layout" inherit_id="website.layout"
              name="Footer Sample">
        <!-- The template inherits from "website.layout" and replaces the existing footer with a custom footer design that
        includes a logo, site pages and admin pages links, mobile app links, and social media links. The template also
        removes the default copyright information. -->
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer">
                <div class="footer_content">
                    <section class="footer">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-3 col-md-6">
                                    <div class="footer_logo">
                                        <a class="navbar-brand waves-effect"
                                           href="/">CLASSIC
                                            <span>STORE</span>
                                        </a>
                                        <p>
                                            Lorem ipsum dolor sit amet,
                                            consectetur adipisicing elit, sed do
                                            eiusmod
                                            tempor incididunt
                                            ut labore et dolore magna aliqua.
                                            Ut enim ad minim veniam, quis
                                            nostrud exercitation ullamco laboris
                                            nisi ut
                                            aliquip ex ea
                                            commodo consequat.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-2 offset-lg-1 offset-md-2 col-md-4">
                                    <div class="pages">
                                        <h4>Site Pages</h4>
                                        <div class="links">
                                            <a href="/">Home</a>
                                            <a href="/shop">Shop</a>
                                            <a href="/contactus">Contact Us</a>
                                            <a href="#">Article &amp; Tips</a>
                                            <a href="#">Terms &amp; Conditions
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-md-6">
                                    <div class="pages">
                                        <h4>Admin Pages</h4>
                                        <div class="links">
                                            <a href="#">Category</a>
                                            <a href="#">Single Page</a>
                                            <a href="#">Store Single</a>
                                            <a href="#">Single Post</a>
                                            <a href="#">Blog</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6">
                                    <div class="apps">
                                        <div class="mob_img">
                                            <div class="mob_icon">
                                                <img src="/theme_classic_store/static/src/images/footer/phone-icon.png"/>
                                            </div>
                                            <p>
                                                Get the Dealsy Mobile App and
                                                Save more
                                            </p>
                                        </div>
                                        <div class="buttons">
                                            <div class="wrapper_img">
                                                <a href="#">
                                                    <img src="/theme_classic_store/static/src/images/apps/apple-app-store.png"/>
                                                </a>
                                            </div>
                                            <div class="wrapper_img">
                                                <a href="#">
                                                    <img src="/theme_classic_store/static/src/images/apps/google-play-store.png"/>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="footer_bottom">
                            <div class="container">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-12">
                                        <div class="bottom_left">
                                            Copyright © 2020. All Rights
                                            Reserved, theme by
                                            <a href="#">
                                                Cybrosys.com
                                            </a>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-12">
                                        <div class="bottom-right">
                                            <ul class="d-flex">
                                                <a href="#">
                                                    <li>
                                                        <i class="oi oi_facebook" data-icon="oi_facebook" role="img"/>
                                                    </li>
                                                </a>
                                                <a href="#">
                                                    <li>
                                                        <i class="oi oi_twitter" data-icon="oi_twitter" role="img"/>
                                                    </li>
                                                </a>
                                                <a href="#">
                                                    <li>
                                                        <i class="oi oi_pinterest" data-icon="oi_pinterest" role="img"/>
                                                    </li>
                                                </a>
                                                <a href="#">
                                                    <li>
                                                        <i class="oi oi_vimeo" data-icon="oi_vimeo" role="img"/>
                                                    </li>
                                                </a>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@class='o_footer_copyright o_colored_level o_cc']"
               position="replace">
        </xpath>
        <xpath expr="//header" position="replace">
            <header>
                <section class="navigation">
                    <div class="container">
                        <nav class="navbar navbar-expand-lg navbar-dark">
                            <a class="navbar-brand waves-effect" href="/">
                                CLASSIC
                                <span>STORE</span>
                            </a>
                            <button class="navbar-toggler waves-effect"
                                    type="button" data-bs-toggle="collapse"
                                    data-bs-target="#main_nav">
                                <span class="navbar-toggler-icon"/>
                            </button>
                            <div class="collapse navbar-collapse" id="main_nav">
    <ul class="navbar-nav m-auto" id="top_menu">
        <t t-foreach="website.menu_id.child_id" t-as="menu_item">
            <t t-set="visible_children"
               t-value="menu_item.child_id.filtered(lambda m: m.is_visible)"/>
            <!-- simple link -->
            <li t-if="menu_item.is_visible and not visible_children and not menu_item.is_mega_menu"
                class="nav-item">
                <a t-attf-class="nav-link #{'active' if request.httprequest.path == menu_item.url else ''}"
                   t-att-href="menu_item.url"
                   role="menuitem"
                   t-att-target="'_blank' if menu_item.new_window else None">
                    <span t-field="menu_item.name"/>
                </a>
            </li>
            <!-- dropdown / mega menu -->
            <li t-if="menu_item.is_visible and (visible_children or menu_item.is_mega_menu)"
                t-attf-class="nav-item dropdown #{'position-static' if menu_item.is_mega_menu else ''}">
                <a class="nav-link dropdown-toggle" href="#"
                   data-bs-toggle="dropdown" role="button" aria-expanded="false">
                    <span t-field="menu_item.name"/>
                </a>
                <div t-if="menu_item.is_mega_menu"
                     t-attf-class="dropdown-menu o_mega_menu #{menu_item.mega_menu_classes}"
                     data-name="Mega Menu"
                     t-field="menu_item.mega_menu_content"/>
                <ul t-else="" class="dropdown-menu" role="menu">
                    <t t-foreach="visible_children" t-as="child">
                        <li>
                            <a class="dropdown-item" t-att-href="child.url"
                               t-att-target="'_blank' if child.new_window else None">
                                <span t-field="child.name"/>
                            </a>
                        </li>
                    </t>
                </ul>
            </li>
        </t>
    </ul>
</div>
                            <!-- WishList -->
                            <div class="classic-icon">
                                <t t-set="wishcount"
                                   t-value="len(request.env['product.wishlist'].current())"/>
                                <t t-set="show_wishes" t-value="True"/>
                                <li t-attf-class="o_wsale_my_wish #{not show_wishes and 'd-none'} #{_item_class}">
                                    <a href="/shop/wishlist"
                                       t-attf-class="#{_link_class}">
                                        <i class="oi oi-filled" data-icon="favorite" role="img"/>
                                        <span t-if="_text">Wishlist</span>
                                        <sup t-out="wishcount"
                                             t-attf-class="my_wish_quantity o_animate_blink badge bg-primary"/>
                                    </a>
                                </li>
                            </div>

                            <!-- Cart -->
                            <div class="classic-icon">
                                <!-- Use request.cart (Odoo 19 standard) -->
                                <t t-set="website_sale_order" t-value="request.cart"/>
                                <t t-set="show_cart" t-value="True"/>

                                <li t-attf-class="nav-item divider d-none"/>
                                <!-- My Cart Menu Item -->
                                <li t-attf-class="o_wsale_my_cart #{not show_cart and 'd-none'} nav-item">
                                    <a href="/shop/cart" class="nav-link">
                                        <i class="oi oi-filled" data-icon="shopping_cart" role="img"/>
                                        <span t-if="_text">My Cart</span>
                                        <sup class="my_cart_quantity badge bg-primary"
                                             t-out="website_sale_order.cart_quantity if website_sale_order else '0'"
                                             t-att-data-order-id="website_sale_order.id if website_sale_order else ''"/>
                                    </a>
                                </li>
                            </div>

                            <!-- navbar-collapse.// -->
                            <div class="login align-right">
    <a t-if="request.env.user._is_public()"
       class="nav-link fw-bold" href="/web/login">Sign in</a>
    <div t-else="" class="dropdown">
        <a href="#" class="nav-link fw-bold dropdown-toggle"
           data-bs-toggle="dropdown" role="button" aria-expanded="false">
            <span t-out="request.env.user.name"/>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/my">My Account</a></li>
            <li t-if="request.env.user._is_internal()">
                <a class="dropdown-item" href="/odoo">Backend</a>
            </li>
            <li>
                <form method="POST" action="/web/session/logout?redirect=/" class="m-0">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="dropdown-item">Log out</button>
                </form>
            </li>
        </ul>
    </div>
</div>
                            <!-- Language Selector -->
                            <t t-call="website.placeholder_header_language_selector"
                               _div_classes="'ms-2'"/>
                            <!-- Button -->
                            <div class="oe_structure oe_structure_solo"
                                 id="oe_structure_header_default_1"/>
                        </nav>
                    </div>
                </section>
            </header>
        </xpath>
    </template>
    <template id="submenu" name="Submenu">
        <!-- The above code defines a template for rendering a submenu item in a website's navigation menu.
        The submenu item can either be a regular dropdown or a mega menu. -->
        <t t-set="has_visible_submenu"
           t-value="(submenu.is_mega_menu and submenu.is_visible) or submenu.child_id.filtered(lambda menu: menu.is_visible)"/>
        <li t-if="submenu.is_visible and not has_visible_submenu"
            t-attf-class="#{item_class or ''}">
            <a t-att-href="submenu.clean_url()"
               t-attf-class="#{link_class or ''} #{'active' if submenu.clean_url() and unslug_url(request.httprequest.path) == unslug_url(submenu.clean_url()) else ''}"
               role="menuitem"
               t-ignore="true"
               t-att-target="'_blank' if submenu.new_window else None">
                <span t-field="submenu.name" id="arrow"/>
            </a>
        </li>
        <li t-if="has_visible_submenu" t-attf-class="#{item_class or ''} dropdown #{
                (submenu.clean_url() and submenu.clean_url() != '/' and any(request.httprequest.path == child.url for child in submenu.child_id if child.url) or
                 (submenu.clean_url() and request.httprequest.path == submenu.clean_url())) and 'active'
                } #{submenu.is_mega_menu and 'position-static'}">
            <a t-attf-class="#{link_class or ''} dropdown-toggle #{submenu.is_mega_menu and 'o_mega_menu_toggle'}"
               data-bs-toggle="dropdown" href="#">
                <span t-field="submenu.name" id="arrow"/>
            </a>
            <div t-if="submenu.is_mega_menu"
                 t-attf-class="dropdown-menu o_mega_menu #{submenu.mega_menu_classes}"
                 data-name="Mega Menu"
                 t-field="submenu.mega_menu_content"/>
            <ul t-else="" class="dropdown-menu" role="menu">
                <t t-foreach="submenu.child_id" t-as="submenu">
                    <t t-call="website.submenu"
                       item_class="None"
                       link_class="'dropdown-item'"
                       _item_class="None"
                       _link_class="'dropdown-item'"/>
                </t>
            </ul>
        </li>
    </template>
</odoo>