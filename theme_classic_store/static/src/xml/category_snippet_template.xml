<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
   <t t-name="theme_classic_store.s_classic_store_categories_snippet">
       <section class="categories_section">
           <div class="container">
               <h3 class="section_heading text-center mb-4">
                   Shop by Categories
               </h3>

               <!-- IMPORTANT: row wrapper -->
               <div class="row categories_wrapper">
                   <t t-foreach="result" t-as="category" t-key="category.main_category_id">
                       <div class="col-lg-4 col-md-6 col-12 mb-4">
                           <div class="c_wrapper h-100">
                               <div class="categories_single text-center p-3">
                                   <div class="c_img mb-3">
                                       <img
                                           t-attf-src="/web/image?model=product.public.category&amp;field=image_1920&amp;id=#{category.main_category_id}"
                                           class="img-fluid"/>
                                   </div>
                                   <h5 class="mb-2">
                                       <t t-esc="category.main_category"/>
                                   </h5>
                               </div>

                               <ul class="children list-unstyled px-3 pb-3">
                                   <t t-foreach="Object.entries(category.children)"
                                      t-as="child"
                                      t-key="child[0]">
                                       <li class="d-flex justify-content-between py-1">
                                           <span>
                                               <t t-esc="child[0]"/>
                                           </span>
                                           <span class="fw-semibold">
                                               <t t-esc="child[1]"/>
                                           </span>
                                       </li>
                                   </t>
                               </ul>
                           </div>
                       </div>
                   </t>
               </div>
           </div>
       </section>
   </t>
</templates>
