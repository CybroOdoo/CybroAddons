<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="theme_classic_store.s_classic_store_trending_snippet">
        <section class="trending_section">
            <div class="container">


                <!-- REQUIRED -->
                <div class="owl-carousel owl-theme">
                    <t t-foreach="products" t-as="product" t-key="product.id">
                        <div class="item">
                            <div class="card text-center p-3">
                                <img
                                    t-attf-src="/web/image?model=product.template&amp;field=image_1920&amp;id=#{product.id}"
                                    class="img-fluid mb-2"/>

                                <h6>
                                    <t t-esc="product.name"/>
                                </h6>

                                <span class="fw-bold">
                                    ₹ <t t-esc="product.list_price"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </div>

            </div>
        </section>
    </t>
</templates>
