<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Form view of the VAPI inbound call.-->
    <record id="vapi_inbound_call_form_view" model="ir.ui.view">
        <field name="name">VAPI.inbound.call.form.view</field>
        <field name="model">vapi.inbound.call</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_number" string="Set Number" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" text="Done" invisible="state not in 'done'"/>
                    <group>
                        <group string="Inbound call using Twilio">
                            <field name="phone_number" placeholder="+1 9876543210" readonly="state != 'draft'"/>
                            <field name="twilio_sid" readonly="state != 'draft'"/>
                            <field name="twilio_auth_token" readonly="state != 'draft'"/>
                            <field name="is_lang_switch"/>
                            <field name="assistant_name_id" invisible="is_lang_switch"/>
                            <field name="id_assistant" invisible="is_lang_switch"/>
                            <field name="squad_id" invisible="not is_lang_switch"/>
                            <field name="id_phone_number" readonly="true"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--    Action for the model VAPI inbound call. -->
    <record id="vapi_inbound_call_action" model="ir.actions.act_window">
        <field name="name">VAPI Inbound Call</field>
        <field name="res_model">vapi.inbound.call</field>
        <field name="view_mode">list,form</field>
    </record>
    <!--    Client Action Definition for Call Transcript-->
    <record id="call_transcript_client_action" model="ir.actions.client">
        <field name="name">Call Transcript</field>
        <field name="tag">action_call_transcript</field>
    </record>
</odoo>
