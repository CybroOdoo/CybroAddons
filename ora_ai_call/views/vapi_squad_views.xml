<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Form view of the model vapi squads.-->
    <record id="vapi_squad_form_view" model="ir.ui.view">
        <field name="name">VAPI.squad.form.view</field>
        <field name="model">vapi.squad</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_squad" string="Create Squad" type="object"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" text="Created" invisible="state not in 'done'"/>
                    <group>
                        <group string="Squads">
                            <field name="name"/>
                            <field name="assistant_id"/>
                            <field name="date"/>
                            <field name="id_squad"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members">
                            <field name="assistant_ids">
                                <list string="Squad Members Line"
                                      editable="bottom">
                                    <field name="assistant_id"/>
                                    <field name="language"/>
                                    <field name="transfer_modes"/>
                                    <field name="description"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--    Creating action for the model VAPI squads.-->
    <record id="vapi_squads_action" model="ir.actions.act_window">
        <field name="name">VAPI Squads</field>
        <field name="res_model">vapi.squad</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
