<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
<!--    Template defines the UI for a voice assistant-based phone dialer interface
    in the VAPI Voice Assistant module.-->
    <t t-name="ora_ai_base.voice_call" owl="1">
    <div class="message_container_div" t-ref="msg" style="color: black;height: 300px;margin: 0 auto;width: 50%;
                text-align: center;margin-top: 50px;padding: 150px;font-size:40px;">
        <div class="oe_structure"/>
        <div class="dial-pad">
            <div class="o_country_code">
            <select class="o_country_code_select">
                <option value="+1">🇺🇸 +1 (USA)</option>
                <option value="+44">🇬🇧 +44 (UK)</option>
                <option value="+91">🇮🇳 +91 (India)</option>
                <option value="+61">🇦🇺 +61 (Australia)</option>
                <option value="+81">🇯🇵 +81 (Japan)</option>
                <!-- Add more country codes as needed -->
            </select>
        </div>
            <input type="text" t-model="state.phoneNumber" id="phoneNumber" class="o_dialpad_input"/>
            <div class="buttons" t-on-click="dial_button">
                <button class="dial-button" data-value="1">1</button>
                <button class="dial-button" data-value="2">2</button>
                <button class="dial-button" data-value="3">3</button>
                <button class="dial-button" data-value="4">4</button>
                <button class="dial-button" data-value="5">5</button>
                <button class="dial-button" data-value="6">6</button>
                <button class="dial-button" data-value="7">7</button>
                <button class="dial-button" data-value="8">8</button>
                <button class="dial-button" data-value="9">9</button>
                <button class="dial-button" data-value="*">*</button>
                <button class="dial-button" data-value="0">0</button>
                <button class="dial-button" data-value="#">#</button>
            </div>
        </div>
    </div>
    </t>
</templates>
