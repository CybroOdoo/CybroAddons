<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
<!--    This OWL template renders a centered message container used during a phone call session
    in the VAPI voice assistant module-->
    <t t-name="ora_ai_base.phone_call" owl="1">
    <div class="message_container_div" t-ref="msg" style="color: black;height: 300px;margin: 0 auto;width: 50%;
                text-align: center;margin-top: 50px;padding: 150px;font-size:40px;" t-on-click="start_vapi"> <b>Calling
        <t t-out="state.duration"/></b>
    </div>
    </t>
</templates>
