<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="brand_model_view_form" model="ir.ui.view">
        <field name="name">brand.model.view.form</field>
        <field name="model">brand.model</field>
        <field name="arch" type="xml">
            <form string="Brand Model">
                <sheet>
                    <field name="image_medium" widget='image' class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="mobile_brand_name"/>
                            <field name="mobile_brand_models"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="brand_model_view_kanban" model="ir.ui.view">
        <field name="name">brand.model.view.kanban</field>
        <field name="model">brand.model</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="image_medium" widget="image" class="o_kanban_avatar"/>
                <field name="mobile_brand_name"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="image_medium" widget="image" class="o_image_64_contain o_kanban_avatar"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="mobile_brand_name"/>
                                </strong>
                            </div>
                            <p>
                                <field name="mobile_brand_models"/>
                            </p>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="brand_model_view_tree" model="ir.ui.view">
        <field name="name">brand.model.view.list</field>
        <field name="model">brand.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="mobile_brand_name"/>
                <field name="mobile_brand_models"/>
                <field name="image_medium" widget='image' class="o_mobile_part_image"/>
            </list>
        </field>
    </record>
    <record id="brand_model_action" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">brand.model</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Click to Create a New Record.
            </p>
        </field>
    </record>
    <menuitem action="brand_model_action" id="brand_model_menu"
              parent="mobile_service_menu_configuration"
              name="Models" sequence="2"/>
</odoo>
