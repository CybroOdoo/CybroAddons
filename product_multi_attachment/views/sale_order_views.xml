<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <!-- Inherit the sale_order form view to display attachment_ids
             as a visible column in the sale order lines list -->
        <field name="name">sale.order.view.form.inherit.product.multi.attachment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list[@name='sol_list']/column[@name='product_and_description']"
                   position="after">
                <field name="attachment_ids" widget="many2many_binary"
                       string="Attachments" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
