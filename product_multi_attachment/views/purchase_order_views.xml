<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <!-- Inherit the purchase_order form view to display attachment_ids
             inline in purchase order lines -->
        <field name="name">purchase.order.view.form.inherit.product.multi.attachment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']"
                   position="after">
                <field name="attachment_ids" widget="many2many_binary"
                       string="Attachments" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
