<?xml version="1.0" encoding="UTF-8"?>
<!--        adding templates to product snippet-->
<templates xml:space="preserve">
    <t t-name="special_product_snippet.SpecialProductOption">
        <BuilderRow label.translate="Product">
            <BuilderMany2One
                id="'product_opt'"
                model="'product.template'"
                action="'specialProductRecord'"
                preview="false"
            />
        </BuilderRow>
<!--        Different types of templates-->
        <BuilderRow label.translate="Template">
            <BuilderSelect id="'template_opt'" action="'specialProductTemplate'">
                <BuilderSelectItem actionValue="'special_product_snippet.first_dynamic_template'">
                    First
                </BuilderSelectItem>
                <BuilderSelectItem actionValue="'special_product_snippet.second_dynamic_template'">
                    Second
                </BuilderSelectItem>
                <BuilderSelectItem actionValue="'special_product_snippet.third_dynamic_template'">
                    Third
                </BuilderSelectItem>
                <BuilderSelectItem actionValue="'special_product_snippet.fourth_dynamic_template'">
                    Fourth
                </BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
    </t>
</templates>
