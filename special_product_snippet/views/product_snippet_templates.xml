<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Listing Product Snippet templates-->
    <template id="s_special_snippets" name="Special Snippet">
        <section class="s_special_products_options" data-template-key="special_product_snippet.first_dynamic_template">
            <div class="container">
                <div class="first-product-page">
                    <img src="/web/static/img/placeholder.png"
                         alt="Product Image"
                         class="product-image"/>
                    <div class="product-details">
                        <h1 class="product-name display_name">
                        </h1>
                        <p class="product-description">Description of the
                            product
                        </p>
                        <p class="product-price">Starting at <span></span>
                        </p>
                        <a href="#" class="third-cta-button cta-button">
                            View
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="first_dynamic_template" name="special snippet">
        <div class="first-product-page">
            <img t-att-src="image_url"
                 alt="Product Image"
                 class="product-image"/>
            <div class="product-details">
                <h1 class="product-name" t-esc="display_name">
                </h1>
                <p class="product-description">Description of the
                    product
                </p>
                <p class="product-price">Starting at
                    <t t-esc="list_price" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                </p>
                <a t-att-href="website_url" class="third-cta-button">
                    View
                </a>
            </div>
        </div>
    </template>

    <template id="second_dynamic_template" name="special snippet">
        <div class="second-product-page">
            <div class="d-flex justify-content-center">
                <img t-att-src="image_url"
                     alt="Product Image"
                     class="second-product-image"/>
            </div>
            <div class="second-product-details">
                <h1 class="second-product-name" t-esc="display_name">
                </h1>
                <p class="second-product-description"></p>
                <p class="second-product-price">Starting at
                    <t t-esc="list_price" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                </p>
                <a t-att-href="website_url" class="cta-button2">
                    View
                </a>
            </div>
        </div>
    </template>

    <template id="third_dynamic_template" name="special snippet">
        <div class="third-product-page">
            <div class="third-product-header">
                <h1 class="third-product-name" t-esc="display_name">
                </h1>
            </div>
            <div class="third-product-details">
                <img class="third-product-image" t-att-src="image_url"
                     alt="Product Image"/>
                <div class="third-product-description"></div>
                <div class="third-product-price">
                    <p>Starting at
                        <t t-esc="list_price" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    </p>
                    <a t-att-href="website_url" class="fourth-cta-button">View
                    </a>
                </div>
            </div>
        </div>
    </template>

    <template id="fourth_dynamic_template" name="special snippet">
        <div class="product-card-page">
            <div class="d-flex justify-content-center">
                <img t-att-src="image_url" class="fourth-product-image"
                     alt="Product Image"/>
            </div>
            <div class="fourth-product-details">
                <span class="fourth-product-price" t-esc="display_name"></span>
                <span class="product-price">
                    <t t-esc="list_price" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                </span>
                <a t-att-href="website_url" class="fourth-view-button">View</a>
            </div>
        </div>
    </template>

    <template id="unavailable" name="Special snippet - product unavailable">
        <div class="text-center text-muted p-4">
            <p>This product is no longer available.</p>
        </div>
    </template>
</odoo>
