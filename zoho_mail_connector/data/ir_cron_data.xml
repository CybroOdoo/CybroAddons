<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Scheduled action for synchronizing Zoho Mail emails -->
    <data>
        <!-- Cron Job for Syncing Emails from Zoho Mail API -->
        <record id="ir_cron_zoho_mail_sync" model="ir.cron">
            <field name="name">Zoho Mail Sync</field>
            <field name="model_id" ref="model_zoho_mail_account"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_emails()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
