<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited mail compose wizard to send mails using Zoho -->
    <record id="mail_compose_message_view_inherit" model="ir.ui.view">
        <field name="name">mail.compose.message.inherit.zoho.mail.connector</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='action_send_mail']" position="after">
                <button name="action_send_via_zoho"
                        string="Send via Zoho"
                        type="object"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
