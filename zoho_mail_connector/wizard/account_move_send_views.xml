<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Account Move Send wizard view to add Send via Zoho button in footer after Send & Print -->
    <record id="account_move_send_form_inherit_zoho" model="ir.ui.view">
        <field name="name">account.move.send.form.inherit.zoho.mail.connector</field>
        <field name="model">account.move.send</field>
        <field name="inherit_id" ref="account.account_move_send_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='action_send_and_print']" position="after">
                <button name="action_send_via_zoho"
                        string="Send via Zoho"
                        type="object"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
