<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form View of Zoho Account Configuration -->
    <record id="zoho_mail_account_view_form" model="ir.ui.view">
        <field name="name">zoho.mail.account.view.form</field>
        <field name="model">zoho.mail.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                    <button
                        name="action_connect"
                        type="object"
                        string="Connect Zoho"
                        class="btn-primary"
                        invisible="state == 'connected'"/>
                    <button
                        name="test_connection"
                        type="object"
                        string="Test Connection"
                        invisible="state != 'connected'"/>
                    <button name="action_sync_inbox"
                            type="object"
                            string="Sync Inbox"
                            invisible="state != 'connected'"
                            class="oe_highlight"/>
                    <button name="action_sync_sent"
                            type="object"
                            string="Sync Sent"
                            invisible="state != 'connected'"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="client_id"/>
                        <field name="client_secret" password="True"/>
                        <field name="redirect_uri" readonly="1"/>
                        <field name="zoho_region"/>
                    </group>
                    <group string="Connection">
                        <field name="email_address" readonly="1"/>
                        <field name="account_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View of Zoho Account Configuration -->
    <record id="zoho_mail_account_view_tree" model="ir.ui.view">
        <field name="name">zoho.mail.account.view.tree</field>
        <field name="model">zoho.mail.account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email_address"/>
                <field name="account_id"/>
            </tree>
        </field>
    </record>

    <!-- Action for Zoho Account Configuration menu -->
    <record id="zoho_mail_account_form" model="ir.actions.act_window">
        <field name="name">Zoho Account Configuration</field>
        <field name="res_model">zoho.mail.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_zoho_mail_root"
              name="Zoho Mail"/>
    <menuitem id="menu_zoho_mail_config"
        name="Configuration"
        parent="menu_zoho_mail_root"
        action="zoho_mail_account_form"
        sequence="2"/>
</odoo>
