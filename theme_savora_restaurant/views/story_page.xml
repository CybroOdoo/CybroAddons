<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Story Page -->
    <template id="savora_story_page" name="Our Story">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- ZENITH HERO -->
                <section class="menu-hero">
                    <div class="menu-hero-bg">
                        <img src="/theme_savora_restaurant/static/img/story_bg.jpg" alt="Savora Interior" />
                    </div>
                    <div class="container" style="z-index: 2; position: relative;">
                        <p class="sv-eyebrow reveal active" style="color: var(--sv-gold); letter-spacing: 0.3em;">ESTABLISHED 2024</p>
                        <h1 class="reveal active">Heritage Flame</h1>
                    </div>
                </section>
                <!-- THE ETHOS -->
                <section class="story-ethos">
                    <div class="container">
                        <div class="ethos-content">
                            <h2 class="ethos-quote">"Fire is the only language we speak."</h2>
                            <p class="ethos-subtext">At Savora, we've stripped away the noise of the modern steakhouse to focus on what truly matters: the primal alchemy of open flame, patient aging, and exceptional sourcing.</p>
                        </div>
                    </div>
                </section>
                <!-- STORY SECTIONS -->
                <main class="story-sections">
                    <!-- SECTION 1: THE FORGE -->
                    <section class="story-sec-row">
                        <div class="container">
                            <div class="story-sec-grid">
                                <div class="story-sec-img">
                                    <img src="/theme_savora_restaurant/static/img/story_chef.jpg" alt="The Forge" />
                                </div>
                                <div class="story-sec-text">
                                    <p class="sv-eyebrow">The Technique</p>
                                    <h3>Forged in the Forge</h3>
                                    <p>Our custom-built wood-fired grills are the heart of our kitchen. We use a curated blend of seasoned white oak and hickory to create a specific smoke profile that enhances, rather than masks, the natural richness of our cuts.</p>
                                    <p>Every steak is hand-finished over the coals, achieving a crust and depth of flavor that only open fire can provide.</p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- SECTION 2: THE PATIENCE (DRY AGING) -->
                    <section class="story-sec-row alt">
                        <div class="container">
                            <div class="story-sec-grid">
                                <div class="story-sec-text">
                                    <p class="sv-eyebrow">The Craft</p>
                                    <h3>The Art of Patience</h3>
                                    <p>True flavor takes time. Our beef undergoes a rigorous dry-aging process in Himalayan salt-lined chambers for a minimum of 45 days. This controlled environment allows the enzymes to transform the texture while concentrating the beef’s nutty, deep essence.</p>
                                    <p>We don't just source meat; we steward it to its absolute peak.</p>
                                </div>
                                <div class="story-sec-img">
                                    <img src="/theme_savora_restaurant/static/img/hero_food.jpg" alt="Salt Aging Room" />
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- THE PARTNERS -->
                    <section class="story-partners">
                        <div class="container">
                            <div class="partners-head">
                                <p class="sv-eyebrow">The Source</p>
                                <h2>Our Producers</h2>
                                <div class="line"/>
                            </div>
                            <div class="partners-grid">
                                <div class="partner-item">
                                    <h4>Silver Lake Wagyu</h4>
                                    <p>Pasture-raised, grain-finished prime beef from upstate New York.</p>
                                </div>
                                <div class="partner-item">
                                    <h4>Hudson Greens</h4>
                                    <p>Organic micro-herbs and heirloom vegetables harvested daily.</p>
                                </div>
                                <div class="partner-item">
                                    <h4>North Sea Salts</h4>
                                    <p>Hand-harvested sea salt flakes for the perfect finish.</p>
                                </div>
                                <div class="partner-item">
                                    <h4>Oland Grains</h4>
                                    <p>Traditional stone-milled flours for our signature sourdough.</p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- THE TEAM -->
                    <section class="story-team">
                        <div class="container">
                            <div class="team-head">
                                <p class="sv-eyebrow">The Visionaries</p>
                                <h2>Behind the Counter</h2>
                            </div>
                            <div class="team-grid">
                                <div class="team-member">
                                    <div class="team-img">
                                        <img src="https://images.unsplash.com/photo-1541544741938-0af808871cc0?q=80&amp;w=2000&amp;auto=format&amp;fit=crop" alt="Chef Michael Roan" />
                                    </div>
                                    <div class="team-info">
                                        <h4>Michael Roan</h4>
                                        <p class="team-role">Executive Chef &amp; Founder</p>
                                        <p class="team-bio">A veteran of New York's finest kitchens, Chef Roan's philosophy centers on open-fire mastery and minimalist plating.</p>
                                    </div>
                                </div>
                                <div class="team-member">
                                    <div class="team-img">
                                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&amp;w=2000&amp;auto=format&amp;fit=crop" alt="Elena Rossi" />
                                    </div>
                                    <div class="team-info">
                                        <h4>Elena Rossi</h4>
                                        <p class="team-role">Head Sommelier</p>
                                        <p class="team-bio">Expertly curating our 200-label cellar with a focus on bold reds and rare small-batch spirits.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </main>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
</odoo>
