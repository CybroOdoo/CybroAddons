<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ─── Checkout Layout Wrapper ─── -->
  <template id="restaurant_checkout_layout" inherit_id="website_sale.checkout_layout" name="Savora Checkout Layout" priority="99">
    <xpath expr="//div[@id='wrap']" position="attributes">
      <attribute name="class" add="sv-shop-wrapper" separator=" "/>
    </xpath>
  </template>
  <!-- ─── Thank You / Confirmation Page ─── -->
  <template id="restaurant_confirmation" inherit_id="website_sale.confirmation" name="Savora Confirmation" priority="99">
    <!-- Inject a gold thank-you banner -->
    <xpath expr="//div[hasclass('d-flex', 'justify-content-between', 'align-items-center')]" position="before">
      <div class="text-center py-5" style="background:var(--sv-surface-1); border-bottom:1px solid rgba(255,255,255,0.08); margin-bottom:48px;">
        <div style="width:72px; height:72px; border-radius:50%; border:2px solid var(--sv-gold); display:flex; align-items:center; justify-content:center; margin:0 auto 24px; font-size:28px; color:var(--sv-gold);">
          ✓
        </div>
        <h1 class="sv-section-title mb-3">Thank You for Your Order!</h1>
        <p style="color:var(--sv-muted); font-size:16px; max-width:480px; margin:0 auto;">We've received your order and will have it ready shortly. See you at Savora.</p>
        <div class="mt-4 d-flex gap-3 justify-content-center">
          <a href="/shop" class="sv-btn-gold">Back to Menu</a>
          <a href="/" class="sv-btn-outline">Go Home</a>
        </div>
      </div>
    </xpath>
  </template>
</odoo>
