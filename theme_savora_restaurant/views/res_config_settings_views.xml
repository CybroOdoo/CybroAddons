<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the Website Settings form to add reservation fields -->
    <record id="res_config_settings_view_form_inherit_restaurant"
            model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.restaurant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Restaurant Reservations"
                       id="restaurant_reservation_settings">
                    <setting string="Reservation Start Time"
                             help="Set the earliest time guests can reserve (e.g. 17:00 = 5:00 PM).">
                        <div class="content-group">
                            <field name="reservation_start_time"
                                   widget="float_time"/>
                        </div>
                    </setting>
                    <setting string="Reservation End Time"
                             help="Set the latest time guests can reserve (e.g. 23:00 = 11:00 PM).">
                        <div class="content-group">
                            <field name="reservation_end_time"
                                   widget="float_time"/>
                        </div>
                    </setting>
                    <setting string="Slot Interval (Minutes)"
                             help="Duration of each reservation slot in minutes.">
                        <div class="content-group">
                            <field name="reservation_slot_interval"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>