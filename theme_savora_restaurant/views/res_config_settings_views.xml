<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Inherit res.config.settings-->
    <record id="view_website_res_config_settings_restaurant"
            model="ir.ui.view">
        <field name="name">website.res.config.settings.restaurant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add after existing website setting -->
            <xpath expr="//block[@id='website_payment_block']"
           position="after">
                <block title="Restaurant Reservation"
                       id="restaurant_reservation_block">
                    <!-- Start Time -->
                    <setting
                        string="Reservation Start Time"
                        help="Opening time for reservations">
                        <field name="reservation_start_time"
                               widget="float_time"/>
                    </setting>
                    <!-- End Time -->
                    <setting
                        string="Reservation End Time"
                        help="Closing time for reservations">
                        <field name="reservation_end_time"
                               widget="float_time"/>
                    </setting>
                    <!-- Interval -->
                    <setting
                        string="Slot Interval"
                        help="Time interval between reservation slots">
                        <field name="reservation_slot_interval"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
