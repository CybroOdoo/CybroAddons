<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for managing restaurant reviews -->
    <record id="theme_restaurant_review_view_tree" model="ir.ui.view">
        <field name="name">theme.restaurant.review.view.tree</field>
        <field name="model">theme.restaurant.review</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="website_id"/>
                <field name="review_date"/>
                <field name="rating"/>
                <field name="is_published" string="Published" widget="boolean_toggle"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <!-- Form view for creating and editing restaurant reviews -->
    <record id="theme_restaurant_review_view_form" model="ir.ui.view">
        <field name="name">theme.restaurant.review.view.form</field>
        <field name="model">theme.restaurant.review</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Guest Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="website_id"/>
                            <field name="review_date"/>
                            <field name="rating"/>
                        </group>
                        <group>
                            <field name="is_published"/>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="avatar_url"/>
                        </group>
                    </group>
                    <group>
                        <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    </group>
                    <group string="Review Content">
                        <field name="review_text" nolabel="1" placeholder="Share the guest experience..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action to open the restaurant reviews list and form -->
    <record id="theme_restaurant_review_action" model="ir.actions.act_window">
        <field name="name">Guest Reviews</field>
        <field name="res_model">theme.restaurant.review</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!-- Menu item for Guest Reviews under Website configuration -->
    <menuitem id="theme_restaurant_review_menu"
              name="Guest Reviews"
              parent="website.menu_website_global_configuration"
              action="theme_restaurant_review_action"
              sequence="10"/>
</odoo>
