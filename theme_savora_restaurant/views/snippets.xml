<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Register snippets in Website Builder (Odoo 17 compatible) -->
  <template id="savora_snippets" inherit_id="website.snippets" name="Savora Snippets">
    <xpath expr="//div[@id='snippet_structure']" position="before">
      <div id="snippet_restaurant" class="o_panel">
        <div class="o_panel_header">Restaurant Theme</div>
        <div class="o_panel_body">
          <t t-snippet="theme_savora_restaurant.s_savora_hero" string="Savora Hero" t-thumbnail="/theme_restaurant/static/img/theme_restaurant_banner.png"/>
          <t t-snippet="theme_savora_restaurant.s_savora_story" string="Savora Story" t-thumbnail="/theme_restaurant/static/img/theme_restaurant_banner.png"/>
          <t t-snippet="theme_savora_restaurant.s_savora_menu" string="Savora Menu" t-thumbnail="/theme_restaurant/static/img/theme_restaurant_banner.png"/>
          <t t-snippet="theme_savora_restaurant.s_savora_gallery" string="Savora Gallery" t-thumbnail="/theme_restaurant/static/img/theme_restaurant_banner.png"/>
          <t t-snippet="theme_savora_restaurant.s_savora_reviews" string="Savora Reviews" t-thumbnail="/theme_restaurant/static/img/theme_restaurant_banner.png"/>
          <t t-snippet="theme_savora_restaurant.s_savora_features" string="Savora Features" t-thumbnail="/theme_restaurant/static/img/theme_restaurant_banner.png"/>
          <t t-snippet="theme_savora_restaurant.s_savora_newsletter" string="Savora Newsletter" t-thumbnail="/theme_restaurant/static/img/theme_restaurant_banner.png"/>
        </div>
      </div>
    </xpath>
  </template>
  <!-- ── Hero ── -->
  <template id="s_savora_hero" name="Savora Hero">
    <section class="s_savora_hero" data-snippet="s_savora_hero" data-name="Savora Hero"
             style="background:#0f0b09; padding:100px 0 0; min-height:100vh; display:flex; align-items:center;">
      <div class="container">
        <div class="row g-0 align-items-center">
          <div class="col-lg-6 pe-lg-5 pb-5 pb-lg-0" style="z-index:2;">
            <p class="sv-eyebrow mb-3" style="color: #c78b3a !important;">Modern Steakhouse / Fire-Led Dining</p>
            <h1 class="sv-hero-title mb-4" style="color: #efe6db !important;">Fire-led dining with a polished, late-night mood.</h1>
            <p class="sv-hero-desc mb-5" style="color: #efe6db !important; opacity: 1 !important;">Savora brings dry-aged steaks, glowing interiors, and sharp service together in a restaurant designed for memorable dinners, cocktails, and long conversations.</p>
            <div class="d-flex gap-3 flex-wrap mb-5">
              <a href="/reservations" class="sv-btn-gold">Book Your Table</a>
              <a href="/menu" class="sv-btn-outline">Explore Menu</a>
            </div>
            <div class="sv-hero-stats">
              <div><div class="sv-stat-lbl">Location</div><div class="sv-stat-val">10 Mercer Ave, New York</div></div>
              <div><div class="sv-stat-lbl">Dinner Hours</div><div class="sv-stat-val">Daily 5:00 PM – 11:30 PM</div></div>
              <div><div class="sv-stat-lbl">Signature</div><div class="sv-stat-val">Ribeye &amp; amber cocktails</div></div>
            </div>
          </div>
          <div class="col-lg-6 position-relative" style="min-height:600px;">
            <div class="sv-hero-img-wrap">
              <img src="/theme_savora_restaurant/static/img/hero_food.jpg" alt="Signature dish" class="w-100 h-100" style="object-fit:cover;"/>
              <div class="sv-hero-overlay">
                <p class="sv-eyebrow" style="color: var(--sv-gold) !important;">Tonight's Highlight</p>
                <p style="color: #efe6db !important;">Dry-aged wagyu burger, smoked cheddar, caramelized onion, herb brioche and house pepper glaze.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </template>
  <!-- ── Story ── -->
  <template id="s_savora_story" name="Savora Story">
    <section id="savora-story" class="s_savora_story" data-snippet="s_savora_story" data-name="Savora Story"
             style="background: linear-gradient(rgba(26,20,17,0.92), rgba(26,20,17,0.92)), url('/theme_savora_restaurant/static/img/story_bg.jpg') center/cover; padding:100px 0;">
      <div class="container">
        <div class="row align-items-center g-5">
          <div class="col-lg-5">
            <div style="aspect-ratio:4/5; overflow:hidden;">
              <img src="/theme_savora_restaurant/static/img/story_chef.jpg" alt="Chef at the grill" class="w-100 h-100" style="object-fit:cover;"/>
            </div>
          </div>
          <div class="col-lg-7">
            <p class="sv-eyebrow mb-3">Our Story</p>
            <h2 class="sv-section-title mb-4">A premium steakhouse built around fire, craft, and atmosphere.</h2>
            <div class="row g-4 mb-4">
              <div class="col-md-6">
                <p style="color:#efe6db !important; line-height:1.7; opacity: 0.85;">We created Savora for guests who love deep flavors, warm lighting, and refined service without excess. Every cut is selected carefully, grilled over open flame, and finished with modern restraint.</p>
              </div>
              <div class="col-md-6">
                <p style="color:#efe6db !important; line-height:1.7; opacity: 0.85;">From the first cocktail to the final dessert, the room is designed to feel intimate and polished — rich materials, soft shadows, and high-quality plating at every table.</p>
              </div>
            </div>
            <div class="d-flex gap-5 mb-5">
              <div><div class="sv-num">28</div><div class="sv-num-lbl">Day dry-aged program for house specialties</div></div>
              <div><div class="sv-num">14</div><div class="sv-num-lbl">Curated wine labels and signature cocktail pairings</div></div>
            </div>
            <a href="/story" class="sv-story-link">Read Our Full Story →</a>
          </div>
        </div>
      </div>
    </section>
  </template>
  <!-- ── Menu ── -->
  <template id="s_savora_menu" name="Savora Menu">
    <section class="s_savora_menu" data-snippet="s_savora_menu" data-name="Savora Menu"
             style="background: linear-gradient(rgba(15,11,9,0.9), rgba(15,11,9,0.9)), url('/theme_savora_restaurant/static/img/menu_bg.jpg') center/cover; padding:100px 0;">
      <div class="container">
        <t t-set="categories" t-value="request.env['product.public.category'].search([('parent_id', '=', False)], order='sequence')"/>
        <t t-set="menu_products"
           t-value="request.env['product.template'].with_context(website_id=request.env['website'].get_current_website().id).search([
               ('public_categ_ids', 'in', categories.ids),
               ('website_published','=',True),
               ('sale_ok','=',True)
           ], limit=16, order='website_sequence asc, id desc') if categories else []"/>
        <p class="sv-eyebrow mb-2">Selected Menu</p>
        <h2 class="sv-section-title mb-5" style="color: #efe6db !important;">Steakhouse favorites with modern presentation.</h2>
        <div class="sv-tabs mb-5">
          <button class="sv-tab active" data-filter="all">All</button>
          <t t-foreach="categories" t-as="cat">
            <button class="sv-tab" t-att-data-filter="cat.id" t-field="cat.name"/>
          </t>
        </div>
        <div class="row g-4" id="sv_mgrid">
          <t t-foreach="menu_products" t-as="product">
            <t t-set="display_price" t-value="product.product_variant_id.lst_price or product.list_price"/>
            <t t-set="p_categs" t-value="product.public_categ_ids.ids"/>
            <t t-set="filter_ids" t-value="' '.join([str(id) for id in p_categs])"/>
            <div t-attf-class="col-sm-6 col-lg-3 sv-mcard-col" t-att-data-filter="filter_ids">
              <a t-att-href="product.website_url" class="sv-mcard text-decoration-none d-block h-100">
                <div class="sv-mcard-img">
                  <img t-if="product.image_512" t-att-src="image_data_uri(product.image_512)" t-att-alt="product.name" class="w-100 h-100" style="object-fit:cover;"/>
                  <img t-else="" src="/theme_savora_restaurant/static/img/food_placeholder.jpg" t-att-alt="product.name" class="w-100 h-100" style="object-fit:cover;"/>
                </div>
                <div class="sv-mcard-body">
                  <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <span class="sv-mcard-name" t-field="product.name"/>
                    <span class="sv-mcard-price"
                          t-esc="display_price"
                          t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                  </div>
                  <p class="sv-mcard-desc text-truncate" t-field="product.description_sale"/>
                </div>
              </a>
            </div>
          </t>
          <t t-if="not menu_products">
            <div class="col-12 text-center py-5">
              <p style="color:rgba(239,230,219,0.5);">No products found in eCommerce categories.</p>
            </div>
          </t>
        </div>
      </div>
    </section>
  </template>
  <!-- ── Gallery ── -->
  <template id="s_savora_gallery" name="Savora Gallery">
    <section class="s_savora_gallery o_cc o_cc1" data-snippet="s_savora_gallery" data-name="Savora Gallery"
             style="background: linear-gradient(rgba(36,28,24,0.9), rgba(36,28,24,0.9)), url('/theme_savora_restaurant/static/img/gallery_bg.jpg') center/cover; padding:100px 0;">
      <div class="container">
        <div class="row align-items-center g-5">
          <div class="col-lg-5">
            <p class="sv-eyebrow mb-3">Gallery</p>
            <h2 class="sv-section-title mb-4">A dark, polished room with rich food imagery at the center.</h2>
            <p style="color:var(--sv-muted,#9b8f85); line-height:1.7; margin-bottom:2rem;">Inspired by premium steakhouse photography — glowing highlights, deep shadows, and plated dishes that feel indulgent.</p>
            <div class="d-flex gap-3 flex-wrap">
              <a href="/gallery" class="sv-btn-gold">View Full Gallery</a>
              <a href="/reservations" class="sv-btn-outline">Private Dining</a>
            </div>
          </div>
          <div class="col-lg-7">
            <div style="aspect-ratio:16/10; overflow:hidden;">
              <img src="/theme_savora_restaurant/static/img/gallery_dining.jpg" alt="Dining room atmosphere" class="w-100 h-100" style="object-fit:cover;"/>
            </div>
          </div>
        </div>
      </div>
    </section>
  </template>
  <!-- ── Reviews ── -->
  <template id="s_savora_reviews" name="Savora Reviews">
    <section id="savora-reviews" class="s_savora_reviews o_cc o_cc1" data-snippet="s_savora_reviews" data-name="Savora Reviews"
             style="background: linear-gradient(rgba(15,11,9,0.9), rgba(15,11,9,0.9)), url('/theme_savora_restaurant/static/img/reservation_bg.jpg') center/cover; padding:100px 0;">
      <div class="container">
        <div class="row g-5 align-items-start">
          <div class="col-lg-7">
            <p class="sv-eyebrow mb-3">Guest Reviews</p>
            <h2 class="sv-section-title mb-4">Loved for atmosphere, service, and fire-cooked flavor.</h2>
            <p style="color:var(--sv-muted,#9b8f85); margin-bottom:3rem;">Our guests come for premium cuts and return for the room, the pacing, and the warm modern mood.</p>
            <div class="sv-review-block mb-4">
              <div class="sv-stars mb-3">★★★★★</div>
              <p class="sv-review-q">"Exactly the kind of modern steakhouse New York needed — rich lighting, polished service, and one of the best ribeyes I've had this year."</p>
              <p class="sv-review-auth">Jordan Miles — Food Editor</p>
            </div>
            <div class="sv-review-block">
              <div class="sv-stars mb-3">★★★★★</div>
              <p class="sv-review-q">"The burger, the cocktails, the room — everything feels perfectly executed."</p>
              <p class="sv-review-auth">Alex Chen — Local Guide</p>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="sv-res-card">
              <p class="sv-eyebrow mb-2">Reservation</p>
              <h3 style="color:var(--sv-cream,#efe6db); font-size:1.5rem; margin-bottom:1rem;">Reserve for dinner, cocktails, or a private celebration.</h3>
              <p style="color:var(--sv-muted,#9b8f85); margin-bottom:1.5rem;">Secure your experience at Savora.</p>
              <a href="/reservations" class="sv-btn-gold d-block text-center">Book a Table</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </template>
  <!-- ── Features ── -->
  <template id="s_savora_features" name="Savora Features">
    <section class="s_savora_features o_cc o_cc1" data-snippet="s_savora_features" data-name="Savora Features"
             style="background:var(--sv-surface-1,#1a1411); padding:80px 0; border-top:1px solid rgba(255,255,255,0.06);">
      <div class="container">
        <div class="row g-4 text-center">
          <div class="col-md-4">
            <div class="sv-feature-icon mb-3">🍷</div>
            <h5 class="sv-feature-title">Curated Wine List</h5>
            <p class="sv-feature-desc">Over 40 labels spanning old-world classics to new-world discoveries.</p>
          </div>
          <div class="col-md-4">
            <div class="sv-feature-icon mb-3">🔥</div>
            <h5 class="sv-feature-title">Fire-Led Cooking</h5>
            <p class="sv-feature-desc">Every cut is grilled over an open flame — technique-first, always.</p>
          </div>
          <div class="col-md-4">
            <div class="sv-feature-icon mb-3">🌙</div>
            <h5 class="sv-feature-title">Late-Night Atmosphere</h5>
            <p class="sv-feature-desc">Low lighting, warm booths, and a mood that makes every evening feel special.</p>
          </div>
        </div>
      </div>
    </section>
  </template>
  <!-- ── Newsletter ── -->
  <template id="s_savora_newsletter" name="Savora Newsletter">
    <section class="s_savora_newsletter o_cc o_cc1" data-snippet="s_savora_newsletter" data-name="Savora Newsletter"
             style="background:var(--sv-surface-2,#241c18); padding:100px 0; text-align:center;">
      <div class="container">
        <p class="sv-eyebrow mb-3">Stay in the Know</p>
        <h2 class="sv-section-title mb-3">Exclusive access to new menus and events.</h2>
        <p style="color:var(--sv-muted,#9b8f85); max-width:520px; margin:0 auto 3rem; line-height:1.7;">Early access to seasonal menus, private dining events, and wine pairing evenings. No noise — just the good stuff.</p>
        <div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe"
             data-vxml="001"
             t-att-data-list-id="request.env.ref('theme_savora_restaurant.mailing_list_savora').id"
             style="max-width:520px; margin:0 auto;">
          <div class="js_subscribed_btn d-none" aria-live="polite">
            <p class="h4-fs text-center py-3" style="color:var(--sv-gold,#c78b3a);"><i class="fa fa-check-circle-o" role="img"/> Thanks for subscribing!</p>
          </div>
          <div class="js_subscribe_wrap d-flex flex-column flex-sm-row" style="border:1px solid rgba(255,255,255,0.15); overflow:hidden;">
            <input type="email" name="email" class="js_subscribe_value form-control w-100" placeholder="Enter your email address"
                   style="flex:1; border:none; padding:18px 24px; font-size:14px; outline:none; background:rgba(255,255,255,0.04); color:var(--sv-cream,#efe6db); min-height:56px;"/>
            <button class="js_subscribe_btn o_submit w-100 w-sm-auto"
                    style="background:var(--sv-gold,#c78b3a); color:#1b0f08; border:none; padding:18px 32px; font-size:14px; font-weight:600; cursor:pointer; text-transform:uppercase; letter-spacing:0.08em; min-height:56px;">Subscribe</button>
          </div>
        </div>
      </div>
    </section>
  </template>
</odoo>
