<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Starters -->
        <record id="product_beef_tartare" model="product.template">
            <field name="name">Beef Tartare</field>
            <field name="list_price">24.0</field>
            <field name="description_sale">Habanero tenderloin, cured yolk, shallot ash, mustard seed.</field>
            <field name="public_categ_ids" eval="[(4, ref('theme_savora_restaurant.category_starters'))]"/>
            <field name="website_published">True</field>
            <field name="sale_ok">True</field>
            <field name="image_1920" type="base64" file="theme_savora_restaurant/static/img/hero_food.jpg"/>
        </record>
        <!-- Charred Prawns -->
        <record id="product_charred_prawns" model="product.template">
            <field name="name">Charred Prawns</field>
            <field name="list_price">28.0</field>
            <field name="description_sale">Brown butter chili glaze, grilled lemon, fennel herb salad.</field>
            <field name="public_categ_ids" eval="[(4, ref('theme_savora_restaurant.category_starters'))]"/>
            <field name="website_published">True</field>
            <field name="sale_ok">True</field>
            <field name="image_1920" type="base64" file="theme_savora_restaurant/static/img/hero_food.jpg"/>
        </record>
        <!-- Main Course -->
        <record id="product_ribeye" model="product.template">
            <field name="name">Signature Ribeye</field>
            <field name="list_price">85.0</field>
            <field name="description_sale">Dry-aged 45 days, smoked garlic jus, crisp potatoes, herb butter.</field>
            <field name="public_categ_ids" eval="[(4, ref('theme_savora_restaurant.category_main_course'))]"/>
            <field name="website_published">True</field>
            <field name="sale_ok">True</field>
            <field name="image_1920" type="base64" file="theme_savora_restaurant/static/img/story_chef.jpg"/>
        </record>
        <!-- Wagyu Burger -->
        <record id="product_wagyu_burger" model="product.template">
            <field name="name">Wagyu Burger</field>
            <field name="list_price">32.0</field>
            <field name="description_sale">Smoked cheddar, caramelized onion, herb brioche, house pepper glaze.</field>
            <field name="public_categ_ids" eval="[(4, ref('theme_savora_restaurant.category_main_course'))]"/>
            <field name="website_published">True</field>
            <field name="sale_ok">True</field>
            <field name="image_1920" type="base64" file="theme_savora_restaurant/static/img/hero_food.jpg"/>
        </record>
        <!-- Desserts -->
        <record id="product_fondant" model="product.template">
            <field name="name">Chocolate Fondant</field>
            <field name="list_price">16.0</field>
            <field name="description_sale">Dark chocolate center, malt crumble, vanilla bean cream.</field>
            <field name="public_categ_ids" eval="[(4, ref('theme_savora_restaurant.category_desserts'))]"/>
            <field name="website_published">True</field>
            <field name="sale_ok">True</field>
            <field name="image_1920" type="base64" file="theme_savora_restaurant/static/img/story_bg.jpg"/>
        </record>
    </data>
</odoo>
