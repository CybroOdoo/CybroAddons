<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Public category for restaurant starters and appetizers -->
        <record id="category_starters" model="product.public.category">
            <field name="name">Starters</field>
            <field name="website_description" type="html">
                <p class="lead text-muted mx-auto" style="max-width: 600px;">Bold flavors to begin — house tartare, charred prawns, and fire-kissed appetizers.</p>
            </field>
        </record>
        <!-- Public category for main course dishes and signature cuts -->
        <record id="category_main_course" model="product.public.category">
            <field name="name">Main Course</field>
            <field name="website_description" type="html">
                <p class="lead text-muted mx-auto" style="max-width: 600px;">Signature cuts, dry-aged steaks, and fire-led mains — prepared with precision.</p>
            </field>
        </record>
        <!-- Public category for desserts and seasonal sweets -->
        <record id="category_desserts" model="product.public.category">
            <field name="name">Desserts</field>
            <field name="website_description" type="html">
                <p class="lead text-muted mx-auto" style="max-width: 600px;">A refined close — dark chocolate fondant, Basque cheesecake, and seasonal sweets.</p>
            </field>
        </record>
        <!-- Public category for beverages, wine, and cocktails -->
        <record id="category_beverages" model="product.public.category">
            <field name="name">Beverages</field>
            <field name="website_description" type="html">
                <p class="lead text-muted mx-auto" style="max-width: 600px;">Curated wine labels, amber cocktails, and artisan spirits — chosen to complement the menu.</p>
            </field>
        </record>
    </data>
</odoo>
