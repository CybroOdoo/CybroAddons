<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="easy_chatgpt_access.ChatGPTPromptDialogInherited"
     t-inherit="html_editor.ChatGPTTranslateDialog"
     t-inherit-mode="extension">
         <xpath expr="//button[@t-on-click='_confirm']" position="replace">
             <button t-if="state.messages.length and !state.messages[0].isError and props.systray.insert"
                class="btn btn-primary"
                t-att-disabled="state.translationInProgress"
                t-on-click="_confirm">Insert</button>
             <button t-if="state.messages.length and !state.messages[0].isError and !props.systray.insert"
                t-att-data-message-id="state.messages[0].id"
                class="btn btn-info"
                t-att-disabled="state.translationInProgress"
                t-on-click="copyMessage">Copy</button>
         </xpath>
    </t>
</templates>

