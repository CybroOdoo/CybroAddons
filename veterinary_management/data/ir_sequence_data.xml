<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Appointment IDs -->
        <record id="appointment_sequence_id" model="ir.sequence">
            <field name="name">Appointment Id</field>
            <field name="code">appointment.sequence</field>
            <field name="prefix">APN/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
        <!-- Sequence for Case IDs -->
        <record id="case_sequence_id" model="ir.sequence">
            <field name="name">Case Id</field>
            <field name="code">case.sequence</field>
            <field name="prefix">CS/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
        <!-- Sequence for Grooming IDs -->
        <record id="grooming_sequence_id" model="ir.sequence">
            <field name="name">Grooming Id</field>
            <field name="code">grooming.sequence</field>
            <field name="prefix">G/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
        <!-- Sequence for Training IDs -->
        <record id="training_sequence_id" model="ir.sequence">
            <field name="name">Training Id</field>
            <field name="code">training.sequence</field>
            <field name="prefix">T/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
        <!-- Sequence for Surgery IDs -->
        <record id="surgery_sequence_id" model="ir.sequence">
            <field name="name">Surgery Id</field>
            <field name="code">surgery.sequence</field>
            <field name="prefix">HPS/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
        <!-- Sequence for Prescription IDs -->
        <record id="prescription_sequence_id" model="ir.sequence">
            <field name="name">Prescription Id</field>
            <field name="code">prescription.sequence</field>
            <field name="prefix">MDPR/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
        <!-- Sequence for Maintenance IDs -->
        <record id="maintenance_sequence_id" model="ir.sequence">
            <field name="name">Maintenance Id</field>
            <field name="code">maintenance.sequence</field>
            <field name="prefix">HM/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
    </data>
</odoo>
