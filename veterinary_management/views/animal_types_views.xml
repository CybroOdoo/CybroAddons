<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view definition for animal.types model -->
    <record id="animal_types_view_tree" model="ir.ui.view">
        <field name="name">animal.types.view.tree</field>
        <field name="model">animal.types</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!-- Action to open animal.types model views -->
    <record id="animal_types_action" model="ir.actions.act_window">
        <field name="name">Animal Types</field>
        <field name="res_model">animal.types</field>
        <field name="view_mode">tree</field>
    </record>
    <!-- Menu items for the Configuration module -->
    <!-- Main menu item for Configurations -->
    <menuitem id="configuration_menu" name="Configurations" parent="veterinary_management_menu_root" sequence="12"/>
    <!-- Submenu for Configuration Types under Configurations -->
    <menuitem id="configuration_types_menu" name="Configuration Types" parent="configuration_menu"/>
    <!-- Submenu for Animal Types under Configuration Types -->
    <menuitem id="configuration_types" name="Animal Types" action="animal_types_action"
              parent="configuration_types_menu" sequence="1"/>
</odoo>
