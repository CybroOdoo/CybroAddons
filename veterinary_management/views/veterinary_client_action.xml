<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Action to open the Veterinary Dashboard -->
    <record id="veterinary_dashboard_action" model="ir.actions.client">
        <field name="name">Veterinary Dashboard</field>
        <field name="tag">veterinary_dashboard_tag</field>
    </record>
    <!-- Menu item for the Veterinary Dashboard -->
    <menuitem name="Dashboard" id="veterinary_dashboard" sequence="-1"
              action="veterinary_dashboard_action" parent="veterinary_management_menu_root"/>
</odoo>
