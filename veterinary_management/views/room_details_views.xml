<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Room Details -->
    <record id="room_details_view_tree" model="ir.ui.view">
        <field name="name">room.details.view.tree</field>
        <field name="model">room.details</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <!-- Fields displayed in the tree view -->
                <field name="name"/>
                <field name="charge"/>
            </tree>
        </field>
    </record>
    <!-- Action for Room Details -->
    <record id="room_details_action" model="ir.actions.act_window">
        <field name="name">Room Details</field>
        <field name="res_model">room.details</field>
        <field name="view_mode">tree</field>
    </record>
    <!-- Menu Item for Room Details -->
    <menuitem id="room_details_menu" name="Room Details" action="room_details_action"
              parent="medicine_details_menu" sequence="3"/>
</odoo>
