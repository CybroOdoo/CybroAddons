<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Modify Product Template Form View -->
    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.veterinary.management</field> <!-- View name for product template form -->
        <field name="model">product.template</field> <!-- Model associated with the view -->
        <field name="priority">5</field> <!-- Priority of this view customization -->
        <field name="inherit_id" ref="product.product_template_form_view"/> <!-- Inherit from existing view -->
        <field name="arch" type="xml">
            <!-- Insert inside the 'options' div of the inherited view -->
            <div name="options" position="inside">
                <!-- Field and label for 'grooming_product' -->
                <span class="d-inline-block">
                    <field name="grooming_product"/>
                    <label for="grooming_product"/>
                </span>
                <!-- Field and label for 'medicine_product' -->
                <span class="d-inline-block">
                    <field name="medicine_product"/>
                    <label for="medicine_product"/>
                </span>
                <!-- Field and label for 'medical_report' -->
                <span class="d-inline-block">
                    <field name="medical_report"/>
                    <label for="medical_report"/>
                </span>
            </div>
        </field>
    </record>
</odoo>
