<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="training_package_view_tree" model="ir.ui.view">
        <field name="name">training.package.view.tree</field>
        <field name="model">training.package</field>
        <field name="arch" type="xml">
            <tree string="Training package">
                <field name="name"/>
                <field name="pet_type_id"/>
                <field name="service_type"/>
                <field name="days"/>
                <field name="charge"/>
            </tree>
        </field>
    </record>
    <record id="training_package_view_form" model="ir.ui.view">
        <field name="name">training.package.view.form</field>
        <field name="model">training.package</field>
        <field name="arch" type="xml">
            <form string="Training package">
                <header>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="PACKAGE TRAINING DETAILS">
                        <group>
                            <field name="pet_type_id"/>
                            <field name="service_type" widget="radio"/>
                            <field name="inclusion_ids" widget="many2many_tags"
                                   options="{'color_field': 'color',
                               'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="days"/>
                            <field name="charge"/>
                            <field name="exclusion_ids" widget="many2many_tags"
                                   options="{'color_field': 'color',
                               'no_create_edit': True}"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="training_package_action" model="ir.actions.act_window">
        <field name="name">Training package</field>
        <field name="res_model">training.package</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="training_package_menu"
              action="training_package_action"
              name="Training Packages"
              parent="configuration_types_menu"
              sequence="7"/>
</odoo>
