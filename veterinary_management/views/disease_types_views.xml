<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view definition for disease.types model -->
    <record id="disease_types_view_tree" model="ir.ui.view">
        <field name="name">disease.types.view.tree</field>
        <field name="model">disease.types</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <!-- Field to be displayed in the tree view -->
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!-- Action to open disease.types model views -->
    <record id="disease_types_action" model="ir.actions.act_window">
        <field name="name">Disease Types</field>
        <field name="res_model">disease.types</field>
        <field name="view_mode">tree</field>
    </record>
    <!-- Action to open Medical Report Types for product.template model -->
    <record id="report_types_menu_action" model="ir.actions.act_window">
        <field name="name">Medical Report Types</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,kanban,form</field>
        <!-- Domain to filter for medical report types -->
        <field name="domain">[('detailed_type', '=', 'service'), ('medical_report', '=', True)]</field>
        <!-- Context for default values and permissions -->
        <field name="context">{'default_detailed_type': 'service', 'create': True, 'edit': True, 'delete': False, 'default_medical_report': True}</field>
    </record>
    <!-- Menu item for Disease Types under Configuration Types menu -->
    <menuitem id="disease_types_menu" action="disease_types_action" name="Disease Types"
              parent="configuration_types_menu" sequence="3"/>
    <!-- Menu item for Medical Report under Configuration Types menu -->
    <menuitem id="report_types_menu" action="report_types_menu_action" name="Medical Tests"
              parent="configuration_types_menu" sequence="4"/>
</odoo>
