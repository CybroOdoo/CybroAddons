<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- View for searching Surgery Appointments -->
    <record id="surgery_appointment_view_search" model="ir.ui.view">
        <field name="name">surgery_appointment_view_search</field>
        <field name="model">surgery.appointment</field>
        <field name="arch" type="xml">
            <search>
                <!-- Fields displayed in the search view -->
                <field name="patient_id"/>
                <field name="surgery_no"/>
                <field name="scheduled_date"/>
                <field name="state"/>
            </search>
        </field>
    </record>
    <!-- Tree View for Surgery Appointments -->
    <record id="surgery_appointment_view_tree" model="ir.ui.view">
        <field name="name">surgery.appointment.view.tree</field>
        <field name="model">surgery.appointment</field>
        <field name="arch" type="xml">
            <tree string="Animal">
                <!-- Fields displayed in the tree view -->
                <field name="patient_id"/>
                <field name="case_appointment_date"/>
                <field name="surgery_no"/>
                <field name="surgery_id"/>
                <field name="desc"/>
                <field name="scheduled_date"/>
                <field name="surgeon_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <!-- Form View for Surgery Appointments -->
    <record id="surgery_appointment_view_form" model="ir.ui.view">
        <field name="name">surgery.appointment.view.form</field>
        <field name="model">surgery.appointment</field>
        <field name="arch" type="xml">
            <form string="Surgery Appointment">
                <header>
                    <!-- Status bar for displaying and changing state -->
                    <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                </header>
                <sheet>
                    <!-- Fields displayed in the form view -->
                    <field name="surgery_no" readonly="True" style="font-size:50px;color:black;"/>
                    <group string="SURGERY DETAILS">
                        <group>
                            <field name="patient_id"/>
                            <field name="case_appointment_date"/>
                            <field name="surgery_id"/>
                            <field name="urgency"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="estimated_cost" widget="monetary"/>
                            <field name="desc"/>
                            <field name="agreement"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                        </group>
                    </group>
                    <group string="MEDICAL TEAM DETAILS">
                        <group>
                            <field name="surgeon_id" create="1"/>
                        </group>

                    </group>
                </sheet>
                <div class="oe_chatter">
                    <!-- Chatter for communication and following -->
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <!-- Action for Surgery Appointments -->
    <record id="surgery_appointment_action" model="ir.actions.act_window">
        <field name="name">Surgery</field>
        <field name="res_model">surgery.appointment</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!-- Menu Item for Surgery Appointments -->
    <menuitem id="surgery_appointment_menu" action="surgery_appointment_action" name="Surgery"
              parent="appointment_menu" sequence="4"/>
</odoo>
