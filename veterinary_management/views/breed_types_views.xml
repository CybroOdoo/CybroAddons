<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view definition for breed.types model -->
    <record id="breed_types_view_tree" model="ir.ui.view">
        <field name="name">breed.types.view.tree</field>
        <field name="model">breed.types</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <!-- Fields to be displayed in the tree view -->
                <field name="animal_type_id"/>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!-- Action to open breed.types model views -->
    <record id="breed_types_action" model="ir.actions.act_window">
        <field name="name">Breed Types</field>
        <field name="res_model">breed.types</field>
        <field name="view_mode">tree</field>
    </record>
    <!-- Menu item for Breed Types under Configuration Types menu -->
    <menuitem id="breed_types_menu" action="breed_types_action" name="Breed Types"
              parent="configuration_types_menu" sequence="2"/>
</odoo>
