<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to generate the Animal details in PDF format -->
    <record id="res_patient_report_action" model="ir.actions.report">
        <field name="name">Patient Report</field>
        <field name="model">res.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">veterinary_management.patient_details_template</field>
        <field name="report_file">veterinary_management.patient_details_template</field>
        <field name="binding_model_id" ref="model_res_patient"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
