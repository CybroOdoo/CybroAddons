<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to generate the Case Report in PDF format -->
    <record id="case_appointments_report_action" model="ir.actions.report">
        <field name="name">Case Report</field>
        <field name="model">case.appointments</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">veterinary_management.patient_report_template</field>
        <field name="report_file">veterinary_management.patient_report_template</field>
        <field name="binding_model_id" ref="model_case_appointments"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
