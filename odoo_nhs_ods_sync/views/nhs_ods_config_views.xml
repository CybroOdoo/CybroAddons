<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit and extend the general res.config.settings form to include NHS ODS API settings -->
    <record id="view_nhs_ods_res_config_settings_inherit" model="ir.ui.view">

        <field name="name">res.config.settings.nhs.ods.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app notApp="1" string="NHS ODS Sync" data-string="NHS ODS Sync"
                     name="odoo_nhs_ods_sync"
                     groups="odoo_nhs_trust_management.group_nhs_trust_admin">
                    <block title="ODS Sync Configuration" name="ods_sync_settings">
                        <setting string="ODS Contact Email"
                                 help="Included in HTTP User-Agent header so NHS Digital can identify your instance.">
                            <field name="nhs_ods_contact_email" placeholder="e.g. admin@nhstrust.nhs.uk"/>
                        </setting>
                        <setting string="Request Timeout (seconds)"
                                 help="Seconds to wait for a response from the Spine ORD API.">
                            <field name="nhs_ods_timeout"/>
                        </setting>
                        <setting string="Rate Limit (requests/sec)"
                                 help="Spine ORD recommends no more than 5 req/s.">
                            <field name="nhs_ods_rate_per_sec"/>
                        </setting>
                        <setting string="Default Sync Mode">
                            <field name="nhs_ods_default_mode"/>
                        </setting>
                        <setting string="Auto-resolve trivial diffs"
                                 help="Whitespace/casing-only differences are auto-resolved in favour of ODS.">
                            <field name="nhs_ods_auto_resolve_trivial"/>
                        </setting>
                        <setting string="Test Connection"
                                 help="Probe the ODS API endpoint before scheduling syncs.">
                            <button name="action_test_ods_connection" type="object"
                                    string="Test ODS Connection" class="btn-secondary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
