<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree/list view definition for ODS Role Mappings (nhs.ods.role.mapping) -->
    <record id="view_nhs_ods_role_mapping_list" model="ir.ui.view">
        <field name="name">nhs.ods.role.mapping.list</field>
        <field name="model">nhs.ods.role.mapping</field>
        <field name="arch" type="xml">
            <list string="ODS Role Mappings">
                <field name="sequence" widget="handle"/>
                <field name="role_code"/>
                <field name="role_name"/>
                <field name="trust_type_id"/>
                <field name="health_system"/>
                <field name="creates_trust" widget="boolean_toggle"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form view definition for ODS Role Mapping (nhs.ods.role.mapping) -->
    <record id="view_nhs_ods_role_mapping_form" model="ir.ui.view">
        <field name="name">nhs.ods.role.mapping.form</field>
        <field name="model">nhs.ods.role.mapping</field>
        <field name="arch" type="xml">
            <form string="ODS Role Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="role_code"/>
                            <field name="role_name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="trust_type_id"/>
                            <field name="health_system"/>
                            <field name="creates_trust" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view definition for ODS Role Mappings (nhs.ods.role.mapping) -->
    <record id="view_nhs_ods_role_mapping_search" model="ir.ui.view">
        <field name="name">nhs.ods.role.mapping.search</field>
        <field name="model">nhs.ods.role.mapping</field>
        <field name="arch" type="xml">
            <search string="Role Mappings">
                <field name="role_code"/>
                <field name="role_name"/>
                <separator/>
                <filter string="Creates Trust" name="creates_trust" domain="[('creates_trust','=',True)]"/>
                <filter string="Reference Only" name="ref_only" domain="[('creates_trust','=',False)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <group name="group_by">
                    <filter string="Health System" name="group_by_system" context="{'group_by': 'health_system'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action for accessing ODS Role Mappings -->
    <record id="action_nhs_ods_role_mappings" model="ir.actions.act_window">
        <field name="name">Role Mappings</field>
        <field name="res_model">nhs.ods.role.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nhs_ods_role_mapping_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No role mappings found.</p>
            <p>ODS role codes are mapped to NHS Trust types here. The module ships with defaults for all standard role codes.</p>
        </field>
    </record>
</odoo>
