<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ODS Sync root under Configuration -->
    <menuitem id="menu_nhs_ods_sync_root"
              name="ODS Sync"
              parent="odoo_nhs_trust_management.menu_nhs_trust_config"
              sequence="90"
              groups="odoo_nhs_trust_management.group_nhs_trust_manager"/>

    <!-- Menu item for Sync Runs log -->
    <menuitem id="menu_nhs_ods_sync_runs"
              name="Sync Runs"
              parent="menu_nhs_ods_sync_root"
              action="action_nhs_ods_sync_runs"
              sequence="10"/>

    <!-- Menu item for active ODS Conflicts -->
    <menuitem id="menu_nhs_ods_sync_conflicts"
              name="Conflicts"
              parent="menu_nhs_ods_sync_root"
              action="action_nhs_ods_sync_conflicts"
              sequence="20"/>

    <!-- Menu item for cached ODS Organisations -->
    <menuitem id="menu_nhs_ods_organisations"
              name="ODS Cache"
              parent="menu_nhs_ods_sync_root"
              action="action_nhs_ods_organisations"
              sequence="30"/>

    <!-- Menu item for ODS Field Provenance source tracking -->
    <menuitem id="menu_nhs_ods_field_provenance"
              name="Field Provenance"
              parent="menu_nhs_ods_sync_root"
              action="action_nhs_ods_field_provenance"
              sequence="40"/>

    <!-- Menu item for ODS Role Mappings -->
    <menuitem id="menu_nhs_ods_role_mappings"
              name="Role Mappings"
              parent="menu_nhs_ods_sync_root"
              action="action_nhs_ods_role_mappings"
              sequence="50"
              groups="odoo_nhs_ods_sync.group_nhs_ods_sync_operator"/>

    <!-- Menu item for triggering a manual ODS synchronization -->
    <menuitem id="menu_nhs_ods_run_sync_now"
              name="Run Sync Now…"
              parent="menu_nhs_ods_sync_root"
              action="action_nhs_ods_sync_wizard"
              sequence="60"
              groups="odoo_nhs_ods_sync.group_nhs_ods_sync_operator"/>
</odoo>
