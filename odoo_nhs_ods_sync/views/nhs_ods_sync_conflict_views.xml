<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban view definition for ODS Sync Conflicts (nhs.ods.sync.conflict) -->
    <record id="view_nhs_ods_sync_conflict_kanban" model="ir.ui.view">
        <field name="name">nhs.ods.sync.conflict.kanban</field>
        <field name="model">nhs.ods.sync.conflict</field>
        <field name="arch" type="xml">
            <kanban string="ODS Conflicts" default_group_by="conflict_type" create="false">
                <field name="id"/>
                <field name="trust_id"/>
                <field name="field_label"/>
                <field name="field_name"/>
                <field name="current_value"/>
                <field name="ods_value"/>
                <field name="conflict_type"/>
                <field name="state"/>
                <!-- Kanban card templates -->
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="trust_id"/></strong>
                            <div class="text-muted small">
                                <code><field name="field_name"/></code>
                                (<field name="field_label"/>)
                            </div>
                            <div class="mt-2">
                                <span class="badge bg-secondary">Current: <t t-out="record.current_value.value"/></span>
                                <span class="badge bg-primary ms-1">ODS: <t t-out="record.ods_value.value"/></span>
                            </div>
                            <div class="mt-2" t-if="record.state.value == 'pending'">
                                <button name="action_keep_local" type="object"
                                        class="btn btn-sm btn-outline-secondary me-1">Keep Local</button>
                                <button name="action_use_ods" type="object"
                                        class="btn btn-sm btn-outline-primary me-1">Accept ODS</button>
                                <button name="action_view_trust" type="object"
                                        class="btn btn-sm btn-outline-info">Trust</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree/list view definition for ODS Sync Conflicts (nhs.ods.sync.conflict) -->
    <record id="view_nhs_ods_sync_conflict_list" model="ir.ui.view">
        <field name="name">nhs.ods.sync.conflict.list</field>
        <field name="model">nhs.ods.sync.conflict</field>
        <field name="arch" type="xml">
            <list string="ODS Conflicts"
                  decoration-danger="conflict_type in ('disallowed_state_change','role_demotion')"
                  decoration-warning="conflict_type == 'field_diff'"
                  decoration-muted="state != 'pending'"
                  create="false">
                <field name="trust_id"/>
                <field name="conflict_type"/>
                <field name="field_label" string="Field"/>
                <field name="current_value"/>
                <field name="ods_value"/>
                <field name="create_date" string="Detected"/>
                <field name="state"/>
                <field name="resolved_by_id"/>
                <button name="action_keep_local" type="object" string="Keep Local"
                        invisible="state != 'pending'"/>
                <button name="action_use_ods" type="object" string="Accept ODS"
                        invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <!-- Form view definition for ODS Sync Conflict (nhs.ods.sync.conflict) -->
    <record id="view_nhs_ods_sync_conflict_form" model="ir.ui.view">
        <field name="name">nhs.ods.sync.conflict.form</field>
        <field name="model">nhs.ods.sync.conflict</field>
        <field name="arch" type="xml">
            <form string="ODS Conflict" create="false">
                <header>
                    <button name="action_keep_local" type="object" string="Keep Local"
                            class="btn-secondary" invisible="state != 'pending'"/>
                    <button name="action_use_ods" type="object" string="Accept ODS"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_view_trust" type="object" string="Open Trust" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,resolved_keep_local,resolved_use_ods,ignored"/>
                </header>
                <sheet>
                    <group>
                        <group string="Conflict Details">
                            <field name="trust_id"/>
                            <field name="field_name"/>
                            <field name="field_label"/>
                            <field name="conflict_type"/>
                        </group>
                        <group string="Values">
                            <field name="current_value"/>
                            <field name="ods_value"/>
                            <field name="ods_organisation_id"/>
                        </group>
                    </group>
                    <group string="Resolution" invisible="state == 'pending'">
                        <field name="resolved_by_id"/>
                        <field name="resolved_at"/>
                        <field name="resolution_note"/>
                    </group>
                    <group invisible="state != 'pending'">
                        <field name="resolution_note" string="Reason (required to ignore)"/>
                    </group>
                    <group string="Audit">
                        <field name="sync_run_id"/>
                        <field name="sync_detail_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view definition for ODS Sync Conflicts (nhs.ods.sync.conflict) -->
    <record id="view_nhs_ods_sync_conflict_search" model="ir.ui.view">
        <field name="name">nhs.ods.sync.conflict.search</field>
        <field name="model">nhs.ods.sync.conflict</field>
        <field name="arch" type="xml">
            <search string="ODS Conflicts">
                <field name="trust_id"/>
                <field name="field_name"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
                <filter string="Resolved" name="resolved"
                        domain="[('state','in',('resolved_keep_local','resolved_use_ods'))]"/>
                <filter string="Ignored" name="ignored" domain="[('state','=','ignored')]"/>
                <filter string="State Changes" name="state_change"
                        domain="[('conflict_type','=','disallowed_state_change')]"/>
                <group name="group_by">
                    <filter string="Trust" name="group_by_trust" context="{'group_by': 'trust_id'}"/>
                    <filter string="Conflict Type" name="group_by_type" context="{'group_by': 'conflict_type'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action for accessing ODS Sync Conflicts -->
    <record id="action_nhs_ods_sync_conflicts" model="ir.actions.act_window">
        <field name="name">ODS Conflicts</field>
        <field name="res_model">nhs.ods.sync.conflict</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state','=','pending')]</field>
        <field name="search_view_id" ref="view_nhs_ods_sync_conflict_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending conflicts — the register is in sync.</p>
        </field>
    </record>
</odoo>
