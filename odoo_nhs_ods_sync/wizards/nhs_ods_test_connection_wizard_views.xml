<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view definition for NHS ODS Test Connection Wizard (nhs.ods.test.connection.wizard) -->
    <record id="view_nhs_ods_test_connection_wizard_form" model="ir.ui.view">
        <field name="name">nhs.ods.test.connection.wizard.form</field>
        <field name="model">nhs.ods.test.connection.wizard</field>
        <field name="arch" type="xml">
            <form string="Test ODS Connection">
                <group>
                    <field name="probe_ods_code"/>
                </group>
                <group invisible="state == 'init'">
                    <field name="result_ok" readonly="1"/>
                    <field name="result_latency_ms" readonly="1"/>
                    <field name="result_message" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_test" type="object" string="Test Connection" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
