<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view definition for NHS ODS Conflict Resolve Wizard (nhs.ods.conflict.resolve.wizard) -->
    <record id="view_nhs_ods_conflict_resolve_wizard_form" model="ir.ui.view">
        <field name="name">nhs.ods.conflict.resolve.wizard.form</field>
        <field name="model">nhs.ods.conflict.resolve.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Resolve ODS Conflicts">
                <group>
                    <field name="conflict_ids" widget="many2many_tags" readonly="1"/>
                    <field name="resolution"/>
                    <field name="reason"
                           invisible="resolution != 'ignore'"
                           required="resolution == 'ignore'"/>
                    <field name="set_auto_update_false"
                           invisible="resolution != 'ignore'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Resolve" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window action for bulk resolving ODS sync conflicts -->
    <record id="action_nhs_ods_conflict_resolve_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Resolve Conflicts</field>
        <field name="res_model">nhs.ods.conflict.resolve.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_nhs_ods_sync_conflict"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
