<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view definition for NHS ODS Sync Run Wizard (nhs.ods.sync.run.wizard) -->
    <record id="view_nhs_ods_sync_run_wizard_form" model="ir.ui.view">
        <field name="name">nhs.ods.sync.run.wizard.form</field>
        <field name="model">nhs.ods.sync.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Run ODS Sync">
                <group>
                    <group string="Sync Settings">
                        <field name="mode"/>
                        <field name="scope"/>
                        <field name="role_mapping_id" invisible="scope != 'specific_role'"
                               required="scope == 'specific_role'"/>
                        <field name="ods_code" invisible="scope != 'specific_org'"
                               required="scope == 'specific_org'"
                               placeholder="e.g. RJ1"/>
                    </group>
                    <group string="Delta Options">
                        <field name="delta_since"
                               help="Leave empty for a full sweep. Set a date to only fetch changes since that date."/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Run Sync" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window action for opening the Run ODS Sync Wizard -->
    <record id="action_nhs_ods_sync_wizard" model="ir.actions.act_window">
        <field name="name">Run Sync Now…</field>
        <field name="res_model">nhs.ods.sync.run.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
