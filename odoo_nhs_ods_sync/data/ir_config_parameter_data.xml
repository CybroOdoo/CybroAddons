<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Configuration parameter for NHS ODS API base URL -->
        <record id="param_ods_base_url" model="ir.config_parameter">
            <field name="key">nhs_ods_sync.base_url</field>
            <field name="value">https://directory.spineservices.nhs.uk/ORD/2-0-0</field>
        </record>
        <!-- Configuration parameter for NHS ODS API request timeout duration -->
        <record id="param_ods_timeout" model="ir.config_parameter">
            <field name="key">nhs_ods_sync.timeout</field>
            <field name="value">30</field>
        </record>
        <!-- Configuration parameter for NHS ODS API rate limit per second -->
        <record id="param_ods_rate_per_sec" model="ir.config_parameter">
            <field name="key">nhs_ods_sync.rate_per_sec</field>
            <field name="value">5.0</field>
        </record>
        <!-- Configuration parameter for NHS ODS sync contact email -->
        <record id="param_ods_contact_email" model="ir.config_parameter">
            <field name="key">nhs_ods_sync.contact_email</field>
            <field name="value"></field>
        </record>
        <!-- Configuration parameter for default NHS ODS sync mode -->
        <record id="param_ods_default_mode" model="ir.config_parameter">
            <field name="key">nhs_ods_sync.default_mode</field>
            <field name="value">live</field>
        </record>
        <!-- Configuration parameter to enable or disable automatic resolution of trivial sync conflicts -->
        <record id="param_ods_auto_resolve_trivial" model="ir.config_parameter">
            <field name="key">nhs_ods_sync.auto_resolve_trivial</field>
            <field name="value">False</field>
        </record>
    </data>
</odoo>
