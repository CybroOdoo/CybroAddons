<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence configuration for generating unique NHS ODS sync run references -->
        <record id="seq_nhs_ods_sync_run" model="ir.sequence">
            <field name="name">NHS ODS Sync Run</field>
            <field name="code">nhs.ods.sync.run</field>
            <field name="prefix">SYNC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
