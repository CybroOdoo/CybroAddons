<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled cron job for running daily NHS ODS delta synchronization -->
        <record id="ir_cron_nhs_ods_delta_sync" model="ir.cron">
            <field name="name">NHS ODS: Daily delta sync</field>
            <field name="model_id" ref="model_nhs_ods_sync_run"/>
            <field name="state">code</field>
            <field name="code">model._run_scheduled_delta()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
        <!-- Scheduled cron job for running monthly NHS ODS full synchronization -->
        <record id="ir_cron_nhs_ods_full_sync" model="ir.cron">
            <field name="name">NHS ODS: Monthly full sync</field>
            <field name="model_id" ref="model_nhs_ods_sync_run"/>
            <field name="state">code</field>
            <field name="code">model._run_scheduled_full()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
