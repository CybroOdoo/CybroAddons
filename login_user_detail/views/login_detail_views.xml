<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view -->
    <record id="login_detail_view_form" model="ir.ui.view">
        <field name="name">login.detail.view.form</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="name"/>
                        <field name="date_time"/>
                        <field name="ip_address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Tree view -->
    <record id="login_detail_view_tree" model="ir.ui.view">
        <field name="name">login.detail.view.tree</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="date_time"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>
    <!-- Search view -->
    <record id="login_detail_view_search" model="ir.ui.view">
        <field name="name">login.detail.view.search</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="ip_address"/>
                <filter name="my_logins" string="My Logins"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="date_time" string="Login Date" date="date_time"/>
                <group>
                    <filter name="group_by_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_date" string="Login Date"
                            context="{'group_by': 'date_time'}"/>
                </group>
            </search>
        </field>
    </record>
    <!-- Action for Login Details menu item -->
    <record id="login_detail_action" model="ir.actions.act_window">
        <field name="name">Login Details</field>
        <field name="res_model">login.detail</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Login Details menu items -->
    <menuitem name="Login Details" id="login_detail_menu_root"
              web_icon="login_user_detail,static/description/icon.png"
              groups="login_user_detail.group_login_detail_user"
              sequence="100"/>
    <menuitem name="Login Details" id="login_user_detail.login_detail_menu"
              parent="login_detail_menu_root" action="login_detail_action"
              sequence="10"/>
</odoo>
