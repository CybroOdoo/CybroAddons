<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_home_contracts" name="My Contracts"
              customize_show="True" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="o_portal_index_card col-md-6 order-2">
                <a href="/my/contracts" title="My Contracts" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="alert-link">
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1 d-flex gap-2">
                            <t t-esc="contract_count"/>
                            <span class="d-none" data-placeholder_count="contract_count"/>
                            <span>My Contracts</span>
                        </div>
                        <div class="opacity-75">
                            Follow your subscription contracts
                        </div>
                    </div>
                </a>
            </div>
        </xpath>
    </template>

    <template id="tmp_contract_details" name="My Contracts">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Contracts</t>
            </t>
            <div class="oe_structure">
                <br/>
                <h3 class="text-center">My Contracts</h3>
                <br/>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="thead-light">
                            <tr>
                                <th>Contract Name</th>
                                <th>Customer Name</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th class="text-end">Total Amount</th> <th>Stage</th>
                                <th>Print</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="records" t-as="order">
                                <tr>
                                    <td>
                                        <a t-attf-href='/contracts/{{order.id}}/' t-esc="order.name"/>
                                    </td>
                                    <td><span t-field="order.partner_id.name"/></td>
                                    <td><span t-field="order.date_start"/></td>
                                    <td><span t-field="order.date_end"/></td>
                                    <td class="text-end"> <span t-field="order.amount_total"
                                              t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                    </td>
                                    <td><span t-field="order.state"/></td>
                                    <td>
                                        <a t-attf-class='btn btn-success' t-attf-href="/my/contracts/report/{{order.id}}">
                                            Report
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="contract_details" name="Subscription contract details">
        <t t-call="portal.portal_layout">
            <div class="container" style="margin-bottom: 50px; width: 100%">
                <div class="page">
                    <h2><t t-esc='records.name'/></h2>

                    <table class="table table-striped">
                        <tr>
                            <th>Customer:</th>
                            <td><t t-if="records.partner_id.name"><t t-esc="records.partner_id.name"/></t></td>
                            <th>Reference:</th>
                            <td><t t-if="records.reference"><t t-esc="records.reference"/></t></td>
                        </tr>
                        <tr>
                            <th>Recurring Period:</th>
                            <td>
                                <t t-if="records.recurring_period">
                                    <t t-esc="records.recurring_period"/>
                                    <span t-field="records.recurring_period_interval"/>
                                </t>
                            </td>
                            <th>Company:</th>
                            <td><t t-if="records.company_id"><t t-esc="records.company_id.name"/></t></td>
                        </tr>
                        <tr>
                            <th>Start Date:</th>
                            <td><t t-if="records.date_start"><t t-esc="records.date_start"/></t></td>
                            <th>End Date:</th>
                            <td><t t-if="records.date_end"><t t-esc="records.date_end"/></t></td>
                        </tr>
                    </table>

                    <h2>Contract Lines</h2>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th scope="col">Product</th>
                                <th scope="col">Description</th>
                                <th scope="col">Order Qty</th>
                                <th scope="col">Unit Price</th>
                                <th scope="col">Taxes</th> <th scope="col" class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="records.contract_line_ids" t-as='res'>
                                <tr>
                                    <td><t t-esc="res.product_id.name"/></td>
                                    <td><t t-esc="res.description"/></td>
                                    <td>
                                        <t t-esc="res.qty_ordered"/>
                                        <t t-esc='res.product_uom_id.name'/>
                                    </td>
                                    <td>
                                        <t t-esc="res.price_unit" t-options="{'widget': 'monetary', 'display_currency': res.currency_id}"/>
                                    </td>
                                    <td> <t t-foreach="res.tax_ids" t-as="tax">
                                            <span class="badge rounded-pill bg-info text-dark" t-esc="tax.name"/>
                                        </t>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="res.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': res.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="row justify-content-end">
                        <div class="col-4">
                            <table class="table table-sm table-borderless">
                                <tr class="border-black o_subtotal">
                                    <td><strong>Untaxed Amount</strong></td>
                                    <td class="text-end">
                                        <span t-field="records.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': records.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Taxes</td>
                                    <td class="text-end">
                                        <span t-field="records.amount_tax" t-options="{'widget': 'monetary', 'display_currency': records.currency_id}"/>
                                    </td>
                                </tr>
                                <tr class="border-black o_total">
                                    <td><strong>Total</strong></td>
                                    <td class="text-end">
                                        <span t-field="records.amount_total" t-options="{'widget': 'monetary', 'display_currency': records.currency_id}"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>