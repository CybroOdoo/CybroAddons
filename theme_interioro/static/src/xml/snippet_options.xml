<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="theme_interioro.productsCarouselOption">
        <BuilderRow label.translate="Product Cards" preview="false">
            <BuilderButton action="'addProductCard'"
                           classAction="'btn btn-sm btn-secondary me-1'">
                + Add Card
            </BuilderButton>
            <BuilderButton action="'removeProductCard'"
                           classAction="'btn btn-sm btn-secondary'">
                − Remove Card
            </BuilderButton>
        </BuilderRow>
    </t>

    <t t-name="theme_interioro.brandStripOption">
        <BuilderRow label.translate="Brand Logos" preview="false">
            <BuilderButton action="'addBrandLogo'"
                           classAction="'btn btn-sm btn-secondary me-1'">
                + Add Logo
            </BuilderButton>
            <BuilderButton action="'removeBrandLogo'"
                           classAction="'btn btn-sm btn-secondary'">
                − Remove Logo
            </BuilderButton>
        </BuilderRow>
    </t>

</templates>
