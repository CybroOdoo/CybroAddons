<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="products_page" name="Interioro Products">
        <t t-call="website.layout">
            <div id="wrap">

                <!-- Top editable zone: add snippets above the grid -->
                <div class="oe_structure"/>

                <!-- Breadcrumb -->
                <section class="interioro-breadcrumb o_colored_level"
                         data-snippet="theme_interioro.interioro_breadcrumb_banner"
                         data-name="Breadcrumb Banner">
                    <div class="cmpad">
                        <div class="breadcrmb">
                            <h3 class="o_editable">Products</h3>
                            <ul>
                                <li><a href="/">Home</a></li>
                                <li><a class="active">Products</a></li>
                            </ul>
                        </div>
                    </div>
                </section>

                <!-- Products Grid — dynamic, data from interioro.product model -->
                <section class="interioro-products-grid o_colored_level py-5 my-md-5">
                    <div class="cmpad">
                        <div class="row mb-5">
                            <div class="s_title">
                                <h2 class="mainhead o_editable">OUR <span class="span-clr">DESIGN</span><br/>PRODUCTS</h2>
                            </div>
                        </div>
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3">
                            <t t-foreach="products" t-as="product">
                                <div class="cols">
                                    <a t-attf-href="/products/#{product.slug}" class="pro-card d-block">
                                        <div class="pro-img">
                                            <t t-if="product.image">
                                                <img t-attf-src="/web/image/interioro.product/#{product.id}/image"
                                                     t-att-alt="product.name"/>
                                            </t>
                                            <t t-else="">
                                                <img src="/theme_interioro/static/src/img/products/pro1.jpg"
                                                     t-att-alt="product.name"/>
                                            </t>
                                        </div>
                                        <div class="pro-con">
                                            <div class="num">
                                                <t t-esc="'%02d' % (product_index + 1)"/>
                                            </div>
                                            <div class="pro-text">
                                                <h5><t t-esc="product.name"/></h5>
                                                <t t-if="product.short_desc">
                                                    <p class="para"><t t-esc="product.short_desc"/></p>
                                                </t>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- Bottom editable zone: add CTA, contact, etc. -->
                <div class="oe_structure"/>

            </div>
        </t>
    </template>
</odoo>
