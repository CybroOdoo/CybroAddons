<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_head_assets"
              inherit_id="website.layout"
              name="Interioro Head Assets">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Baskervville:ital,wght@0,400..700;1,400..700&amp;family=Bebas+Neue&amp;family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&amp;display=swap"
                  rel="stylesheet"/>
        </xpath>
    </template>

    <template id="interioro_header"
              inherit_id="website.layout"
              name="Interioro Header">
        <xpath expr="//header" position="replace">
            <header class="header" id="mainHeader">
                <div class="cmpad">
                    <div class="headmain">
                        <div class="logomain">
                            <a href="/">
                                <img src="/theme_interioro/static/src/img/logo/logo.svg" alt="Interioro"/>
                            </a>
                        </div>
                        <nav class="navmain desktop-nav">
                            <ul>
                                <li><a href="/">Home</a></li>
                                <li><a href="/about">About</a></li>
                                <li><a href="/products">Products</a></li>
                                <li><a href="/services">Services</a></li>
                                <li><a href="/contactus">Contact Us</a></li>
                            </ul>
                        </nav>

                        <div class="desktop-cta">
                            <ul class="navbar-nav interioro-user-nav">
                                <t t-call="portal.placeholder_user_sign_in">
                                    <t t-set="_link_class" t-valuef="btn interioro-sign-in-btn"/>
                                </t>
                                <t t-call="portal.user_dropdown">
                                    <t t-set="_user_name" t-value="True"/>
                                    <t t-set="_item_class" t-value="'nav-item dropdown'"/>
                                    <t t-set="_link_class" t-value="'btn interioro-sign-in-btn'"/>
                                </t>
                            </ul>
                            <a href="/contactus" class="btn">Get in Touch</a>
                        </div>

                        <div class="mobile-toggle" id="mobileToggle">
                            <span/>
                            <span/>
                            <span/>
                        </div>

                    </div>
                </div>

                <div class="mobile-menu" id="mobileMenu">
                    <div class="mobile-menu-header">
                        <a href="/" class="logomain">
                            <img src="/theme_interioro/static/src/img/logo/logo.svg" alt="Interioro" style="width:120px;"/>
                        </a>
                        <div class="mobile-close" id="mobileClose">
                            <span/>
                            <span/>
                        </div>
                    </div>
                    <nav class="mobile-nav">
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li><a href="/about">About</a></li>
                            <li><a href="/products">Products</a></li>
                            <li><a href="/services">Services</a></li>
                            <li><a href="/contactus">Contact Us</a></li>
                        </ul>
                    </nav>
                    <div class="mobile-cta">
                        <ul class="navbar-nav interioro-user-nav">
                            <t t-call="portal.placeholder_user_sign_in">
                                <t t-set="_link_class" t-valuef="btn interioro-sign-in-btn w-100"/>
                            </t>
                            <t t-call="portal.user_dropdown">
                                <t t-set="_user_name" t-value="True"/>
                                <t t-set="_item_class" t-value="'nav-item dropdown'"/>
                                <t t-set="_link_class" t-value="'btn interioro-sign-in-btn w-100'"/>
                            </t>
                        </ul>
                        <a href="/contactus" class="btn">Get in Touch</a>
                    </div>
                </div>

            </header>
        </xpath>
    </template>


    <template id="interioro_user_dropdown"
              inherit_id="portal.user_dropdown"
              name="Interioro User Dropdown">
        <xpath expr="//a" position="replace">
            <a href="#" role="button" data-bs-toggle="dropdown"
               t-attf-class="#{'' if _no_caret else 'dropdown-toggle'} btn #{_link_class}"
               id="HeaderUser">
                <t t-if="_avatar">
                    <t t-set="avatar_source" t-value="image_data_uri(user_id.avatar_256)" id="dropdown"/>
                    <img t-att-src="avatar_source"
                         t-attf-class="rounded-circle o_object_fit_cover #{_avatar_class}"
                         width="24" height="24" alt="image" loading="eager"/>
                </t>
                <div t-if="_icon" t-attf-class="#{_icon_wrap_class}">
                    <i t-attf-class="fa fa-1x fa-fw fa-user #{_icon_class}"/>
                </div>
                <span t-if="_user_name"
                      t-attf-class="#{_user_name_class}"
                      t-esc="user_id.name[:23] + '...' if user_id.name and len(user_id.name) &gt; 25 else user_id.name"/>
            </a>
        </xpath>
    </template>

    <template id="interioro_footer"
              inherit_id="website.layout"
              name="Interioro Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <footer id="footer" class="footer">
                <div class="container">
                    <div class="footer-content">
                        <div class="row">

                            <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                                <div class="footer-brand">
                                    <img src="/theme_interioro/static/src/img/logo/logo1.svg"
                                         alt="Interioro" style="width:200px;" class="mb-4"/>
                                    <p class="footer-description">
                                        At Interioro, we bridge the gap between imagination and
                                        modern interiors that balance sophistication with comfort.
                                    </p>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                                <h5 class="footer-title">Quick Links</h5>
                                <ul class="footer-links">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/about">About Us</a></li>
                                    <li><a href="/products">Products</a></li>
                                    <li><a href="/services">Services</a></li>
                                    <li><a href="/contactus">Contact Us</a></li>
                                </ul>
                            </div>

                            <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                                <h5 class="footer-title">Social Media</h5>
                                <ul class="footer-links">
                                    <li><a href="#">Instagram</a></li>
                                    <li><a href="#">Youtube</a></li>
                                    <li><a href="#">LinkedIn</a></li>
                                    <li><a href="#">Twitter</a></li>
                                    <li><a href="#">Facebook</a></li>
                                </ul>
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <h5 class="footer-title">Office</h5>
                                <div class="office-info">
                                    <p>Germany —</p>
                                    <p>785 15h Street, Office 47 Berlin,<br/>De 81566</p>
                                    <p><a href="mailto:interioro@gmail.com">interioro@gmail.com</a></p>
                                    <p><a href="tel:+18408412569">+1 840 841 25 69</a></p>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="footer-bottom">
                        <div class="copyright">© 2026 Interioro. All rights reserved.</div>
                        <ul class="footer-bottom-links">
                            <li><a href="#">Docs</a></li>
                            <li><a href="#">Help Center</a></li>
                            <li><a href="#">Privacy Policy</a></li>
                            <li><a href="#">Terms and Conditions</a></li>
                        </ul>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>

</odoo>
