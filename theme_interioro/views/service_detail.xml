<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="service_detail_page" name="Interioro Service Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">

                <!-- Breadcrumb -->
                <div class="cmpad">
                    <div class="breadcrmb">
                        <h3><t t-esc="service.name"/></h3>
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li><a href="/services">Services</a></li>
                            <li><a class="active"><t t-esc="service.name"/></a></li>
                        </ul>
                    </div>
                </div>

                <!-- Detail Content: matches service-details.html layout -->
                <div class="py-5 my-5">
                    <div class="cmpad">
                        <div class="row mb-3">
                            <h2 class="mainhead">
                                <t t-esc="service.name"/>
                            </h2>
                        </div>
                        <div class="detail-body">
                            <t t-if="service.image">
                                <div style="float: right;" class="mb-2 ps-md-3">
                                    <img t-attf-src="/web/image/interioro.service/#{service.id}/image"
                                         t-att-alt="service.name"
                                         class="imgfloat"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div style="float: right;" class="mb-2 ps-md-3">
                                    <img src="/theme_interioro/static/src/img/services/home.jpg"
                                         t-att-alt="service.name"
                                         class="imgfloat"/>
                                </div>
                            </t>
                            <div t-out="service.description" class="detail-desc"/>
                        </div>
                    </div>
                </div>

                <div class="oe_structure"/>

            </div>
        </t>
    </template>
</odoo>
