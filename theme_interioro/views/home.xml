<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit Odoo's built-in homepage so we reuse the existing Home menu
        and / route. The xpath replaces the wrap div with our full design.
    -->
    <template id="interioro_home_page" name="Interioro Home Page"
              inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">

                <!-- Hero Banner -->
                <section class="interioro-hero o_colored_level"
                         data-snippet="theme_interioro.interioro_hero_banner"
                         data-name="Hero Banner">
                    <div class="cmpad">
                            <!-- Clickable Image Pattern -->
                            <div class="slider">
                                <img src="/theme_interioro/static/src/img/banner/home_banner.jpg"
                                     class="o_we_image interioro-hero-img"
                                     alt="Interioro Interior Design"/>
                                <div class="slider-overlay"/>
                                <div class="slider-content">
                                    <h1 class="o_editable">WE DESIGN<br/>THE <span class="span-clr">FEELING</span> OF YOU</h1>
                                </div>
                            </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty"/>

                <!-- About Intro -->
                <section class="interioro-home-intro o_colored_level py-5 my-md-5"
                         data-snippet="theme_interioro.interioro_home_intro"
                         data-name="Home Intro">
                    <div class="cmpad">
                        <div class="row">
                            <div class="col-md-6 s_col_no_bgcolor" data-name="Left Column">
                                <div class="mb-4">
                                    <img src="/theme_interioro/static/src/img/banner/home2.jpg"
                                         class="o_we_image" alt="About Interioro"/>
                                </div>
                                <div class="s_title" data-name="Title">
                                    <h2 class="o_editable">Let's start the design, Call us</h2>
                                </div>
                                <div class="s_title" data-name="Phone">
                                    <h2 class="span-clr basker o_editable">+718 839 890</h2>
                                </div>
                            </div>
                            <div class="col-md-6 py-3 s_col_no_bgcolor" data-name="Right Column">
                                <div class="s_text_block" data-name="Subheading">
                                    <span class="subhead o_editable">WELCOME TO INTERIORO</span>
                                </div>
                                <div class="s_title" data-name="Main Heading">
                                    <h2 class="mainhead o_editable">
                                        WE HELPS YOU<br/>
                                        MAKE <span class="span-clr">MODERN</span><br/>
                                        INTERIOR
                                    </h2>
                                </div>
                                <div class="s_text_block" data-name="Description">
                                    <p class="para mb-3 o_editable">
                                        At Interioro, we bridge the gap between imagination and reality,
                                        crafting modern interiors that balance sophisticated aesthetics
                                        with everyday functionality.
                                    </p>
                                </div>
                                <a href="/contactus" class="btn">Get in Touch</a>
                                <div class="mt-5 float-end">
                                    <img src="/theme_interioro/static/src/img/banner/home1.jpg"
                                         class="o_we_image" alt="Interior detail"
                                         style="width:400px; max-width:100%;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty"/>

                <!-- Stats Counter -->
                <section class="interioro-stats-banner o_colored_level counter py-3"
                         data-snippet="theme_interioro.interioro_stats_banner"
                         data-name="Stats Banner">
                    <div class="cmpad">
                        <div class="row">
                            <div class="col-md-3 col-6 s_col_no_bgcolor" data-name="Stat 1">
                                <div class="s_title"><h2 class="o_editable">12k</h2></div>
                                <div class="s_title"><h3 class="o_editable">Interior Projects</h3></div>
                                <div class="s_text_block"><p class="o_editable">Completed with precision and style.</p></div>
                            </div>
                            <div class="col-md-3 col-6 s_col_no_bgcolor" data-name="Stat 2">
                                <div class="s_title"><h2 class="o_editable">23</h2></div>
                                <div class="s_title"><h3 class="o_editable">Years of Works</h3></div>
                                <div class="s_text_block"><p class="o_editable">Experience you can trust.</p></div>
                            </div>
                            <div class="col-md-3 col-6 s_col_no_bgcolor" data-name="Stat 3">
                                <div class="s_title"><h2 class="o_editable">34k</h2></div>
                                <div class="s_title"><h3 class="o_editable">Satisfied Clients</h3></div>
                                <div class="s_text_block"><p class="o_editable">Happy clients worldwide.</p></div>
                            </div>
                            <div class="col-md-3 col-6 s_col_no_bgcolor" data-name="Stat 4">
                                <div class="s_title"><h2 class="o_editable">99%</h2></div>
                                <div class="s_title"><h3 class="o_editable">Happy Rate</h3></div>
                                <div class="s_text_block"><p class="o_editable">Quality that delights consistently.</p></div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty"/>

                <!-- Products Carousel -->
                <section class="ipc-section o_colored_level py-5 mt-md-5"
                         data-snippet="theme_interioro.interioro_products_carousel"
                         data-name="Products Carousel">

                    <div class="cmpad">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                            <div class="s_title" data-name="Heading">
                                <h2 class="mainhead o_editable">
                                    WE ARE <span class="span-clr">HERE</span><br/>
                                    FOR YOUR NEED
                                </h2>
                            </div>
                            <div class="s_col_no_bgcolor" data-name="Intro Text">
                                <div class="s_text_block">
                                    <p class="para o_editable">
                                        We design stylish and functional interiors that reflect your lifestyle,
                                        combining creativity, comfort, and quality craftsmanship.
                                    </p>
                                </div>
                                <a href="/products" class="btn">Know More</a>
                            </div>
                        </div>
                    </div>

                    <!-- Fetch published products directly from DB — no controller needed -->
                    <t t-set="hp_products" t-value="env['interioro.product'].sudo().search([('is_published','=',True)], order='sequence asc')"/>

                    <div class="ipc-mask">
                            <div class="ipc-reel">
                                <!-- Dynamic cards from interioro.product -->
                                <t t-foreach="hp_products" t-as="hp_prod">
                                    <div class="ipc-card">
                                        <a t-attf-href="/products/#{hp_prod.slug}" class="pro-card d-block">
                                            <div class="pro-img">
                                                <t t-if="hp_prod.image">
                                                    <img t-attf-src="/web/image/interioro.product/#{hp_prod.id}/image"
                                                         t-att-alt="hp_prod.name"/>
                                                </t>
                                                <t t-else="">
                                                    <img src="/theme_interioro/static/src/img/products/pro1.jpg"
                                                         t-att-alt="hp_prod.name"/>
                                                </t>
                                            </div>
                                            <div class="pro-con">
                                                <div class="num">
                                                    <t t-esc="'0%d' % (hp_prod_index + 1) if hp_prod_index &lt; 9 else hp_prod_index + 1"/>
                                                </div>
                                                <div class="pro-text">
                                                    <h5 t-esc="hp_prod.name"/>
                                                    <p class="para" t-esc="hp_prod.short_desc"/>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                                <!-- Fallback: show static cards if no products in DB yet -->
                                <t t-if="not hp_products">
                                    <div class="ipc-card">
                                        <a href="/products" class="pro-card d-block">
                                            <div class="pro-img"><img src="/theme_interioro/static/src/img/products/pro1.jpg" alt="Sample Product"/></div>
                                            <div class="pro-con">
                                                <div class="num">01</div>
                                                <div class="pro-text"><h5>Sample Product</h5><p class="para">Add products from Website → Configuration → Interioro Products.</p></div>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                            </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty"/>

                <!-- FAQ Section -->
                <section class="interioro-faq o_colored_level py-5"
                         data-snippet="theme_interioro.interioro_faq"
                         data-name="FAQ">
                    <div class="cmpad">
                        <div class="row">
                            <div class="col-md-5 s_col_no_bgcolor" data-name="Heading Column">
                                <h2 class="mainhead o_editable">
                                    TOP <span class="span-clr">QUESTIONS</span><br/>
                                    ANSWERED
                                </h2>
                                <p class="para o_editable" style="margin-top:16px;">
                                    Find clear answers to the most common questions about
                                    our services, process, and design approach in detail.
                                </p>
                            </div>
                            <div class="col-md-7 s_col_no_bgcolor" data-name="Accordion Column">
                                <div class="itr-faq">
                                    <div class="itr-faq-item active">
                                        <div class="itr-faq-q">
                                            <span class="o_editable">What is the Interioro style?</span>
                                            <button class="itr-faq-btn" type="button" aria-expanded="true"><span class="itr-faq-icon"/></button>
                                        </div>
                                        <div class="itr-faq-a">
                                            <p class="o_editable">We specialize in Modern Organic — a blend of clean lines, natural textures, and a balance of Sage, Charcoal, and Gold.</p>
                                        </div>
                                    </div>
                                    <div class="itr-faq-item">
                                        <div class="itr-faq-q">
                                            <span class="o_editable">Where are you located?</span>
                                            <button class="itr-faq-btn" type="button" aria-expanded="false"><span class="itr-faq-icon"/></button>
                                        </div>
                                        <div class="itr-faq-a">
                                            <p class="o_editable">We are based locally and work with clients across multiple locations. Our team also offers remote consultations.</p>
                                        </div>
                                    </div>
                                    <div class="itr-faq-item">
                                        <div class="itr-faq-q">
                                            <span class="o_editable">Do you work on commercial spaces?</span>
                                            <button class="itr-faq-btn" type="button" aria-expanded="false"><span class="itr-faq-icon"/></button>
                                        </div>
                                        <div class="itr-faq-a">
                                            <p class="o_editable">Yes — offices, retail stores, cafes, and showrooms. We create functional, visually appealing commercial environments.</p>
                                        </div>
                                    </div>
                                    <div class="itr-faq-item">
                                        <div class="itr-faq-q">
                                            <span class="o_editable">Do you provide 3D visualizations?</span>
                                            <button class="itr-faq-btn" type="button" aria-expanded="false"><span class="itr-faq-icon"/></button>
                                        </div>
                                        <div class="itr-faq-a">
                                            <p class="o_editable">Yes — detailed 3D renders before execution so every layout, material, and finish aligns perfectly with your vision.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty"/>

                <!-- CTA Box -->
                <section class="interioro-cta o_colored_level py-5"
                         data-snippet="theme_interioro.interioro_cta_box"
                         data-name="CTA Box">
                    <div class="cmpad">
                        <div class="conbox">
                            <img src="/theme_interioro/static/src/img/banner/contact.jpg"
                                 class="o_we_image interioro-cta-img"
                                 alt="CTA Background"/>
                            <div class="conbox-overlay"/>
                            <div class="inner">
                                <div class="s_title" data-name="Heading">
                                    <h2 class="mainhead white mb-3 o_editable">
                                        "Your Dream Space is
                                        <span class="span-clr">Just a Click</span> Away."
                                    </h2>
                                </div>
                                <a href="/contactus" class="btn">Contact Us</a>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty"/>

                <!-- Brand Logo Strip -->
                <section class="interioro-brand-strip o_colored_level py-5 mt-md-5"
                         data-snippet="theme_interioro.interioro_brand_strip"
                         data-name="Brand Logo Strip">
                    <div class="ibs-viewport">
                        <div class="ibs-track">
                            <div class="ibs-logo"><img src="/theme_interioro/static/src/img/logo/logo2.png" class="o_we_custom_image brand-logo" alt="Brand"/></div>
                            <div class="ibs-logo"><img src="/theme_interioro/static/src/img/logo/logo3.png" class="o_we_custom_image brand-logo" alt="Brand"/></div>
                            <div class="ibs-logo"><img src="/theme_interioro/static/src/img/logo/logo4.png" class="o_we_custom_image brand-logo" alt="Brand"/></div>
                            <div class="ibs-logo"><img src="/theme_interioro/static/src/img/logo/logo5.png" class="o_we_custom_image brand-logo" alt="Brand"/></div>
                            <div class="ibs-logo"><img src="/theme_interioro/static/src/img/logo/logo6.png" class="o_we_custom_image brand-logo" alt="Brand"/></div>
                            <div class="ibs-logo"><img src="/theme_interioro/static/src/img/logo/logo7.png" class="o_we_custom_image brand-logo" alt="Brand"/></div>
                            <div class="ibs-logo"><img src="/theme_interioro/static/src/img/logo/logo9.png" class="o_we_custom_image brand-logo" alt="Brand"/></div>
                            <div class="ibs-logo"><img src="/theme_interioro/static/src/img/logo/logo10.png" class="o_we_custom_image brand-logo" alt="Brand"/></div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty"/>

            </div>
        </xpath>
    </template>
</odoo>
