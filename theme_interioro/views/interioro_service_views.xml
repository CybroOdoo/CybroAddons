<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_interioro_service_list" model="ir.ui.view">
        <field name="name">interioro.service.list</field>
        <field name="model">interioro.service</field>
        <field name="arch" type="xml">
            <list string="Services">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image"
                       options="{'size': [48, 48]}" optional="show"/>
                <field name="name"/>
                <field name="short_desc"/>
                <field name="slug"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_interioro_service_form" model="ir.ui.view">
        <field name="name">interioro.service.form</field>
        <field name="model">interioro.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_is_published"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-globe"
                                invisible="is_published == True">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text text-danger">Unpublished</span>
                            </div>
                        </button>
                        <button name="toggle_is_published"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-globe"
                                invisible="is_published == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text text-success">Published</span>
                            </div>
                        </button>
                    </div>

                    <field name="image" widget="image" class="oe_avatar"
                           options="{'size': [200, 150]}"/>

                    <div class="oe_title">
                        <label for="name" string="Service Name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Home Interior Design"
                                   required="True"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identity">
                            <field name="slug"
                                   placeholder="auto-generated from name"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Visibility">
                            <field name="is_published"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Card Summary">
                        <field name="short_desc" nolabel="1"
                               placeholder="One-line description shown on service cards"/>
                    </group>

                    <notebook>
                        <page string="Detail Page Description" name="description">
                            <field name="description" widget="html"
                                   placeholder="Full description shown on the service detail page."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_interioro_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">interioro.service</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_interioro_service_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first service!</p>
            <p>Each service gets its own page at <strong>/services/slug</strong>
               and appears on the Services listing page.</p>
        </field>
    </record>

</odoo>
