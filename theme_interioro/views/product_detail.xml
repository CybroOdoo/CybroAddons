<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_detail_page" name="Interioro Product Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">

                <!-- Breadcrumb -->
                <div class="cmpad">
                    <div class="breadcrmb">
                        <h3><t t-esc="product.name"/></h3>
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li><a href="/products">Products</a></li>
                            <li><a class="active"><t t-esc="product.name"/></a></li>
                        </ul>
                    </div>
                </div>

                <!-- Detail Content: matches product-details.html layout -->
                <div class="py-5 my-md-5">
                    <div class="cmpad">
                        <div class="row mb-3">
                            <h2 class="mainhead">
                                WE ARE <span class="span-clr">HERE</span><br/>
                                FOR YOUR NEED
                            </h2>
                        </div>
                        <div class="detail-body">
                            <!-- Image floated right, text wraps around it -->
                            <t t-if="product.image">
                                <div style="float: right;" class="mb-2 ps-md-3">
                                    <img t-attf-src="/web/image/interioro.product/#{product.id}/image"
                                         t-att-alt="product.name"
                                         class="imgfloat"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div style="float: right;" class="mb-2 ps-md-3">
                                    <img src="/theme_interioro/static/src/img/products/pro1.jpg"
                                         t-att-alt="product.name"
                                         class="imgfloat"/>
                                </div>
                            </t>
                            <!-- Rich text description from backend -->
                            <div t-out="product.description" class="detail-desc"/>
                        </div>
                    </div>
                </div>

                <!-- Bottom editable zone for extra snippets -->
                <div class="oe_structure"/>

            </div>
        </t>
    </template>
</odoo>
