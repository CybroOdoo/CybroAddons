<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_snippet_groups" inherit_id="website.snippets"
              name="Interioro Snippet Groups">
        <!--
            Odoo 17 does not provide the `website.s_snippet_group` helper used
            by the v18 theme. Keeping this record as a no-op lets a module
            upgrade overwrite the stale inherited view without crashing the
            snippets panel compilation.
        -->
    </template>
</odoo>
