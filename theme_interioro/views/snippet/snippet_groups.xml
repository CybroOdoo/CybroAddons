<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_snippet_groups" inherit_id="website.snippets"
              name="Interioro Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_interioro/static/src/img/thumb_sections.png"
               string="Interioro Sections"
               snippet-group="interioro_section"/>
        </xpath>
    </template>
</odoo>
