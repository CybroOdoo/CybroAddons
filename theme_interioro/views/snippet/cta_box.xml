<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Interioro CTA Box Snippet
        This snippet provides a call-to-action (CTA) section for the website,
        featuring an image and a contact form.
    -->
    <template id="interioro_cta_box" name="Interioro CTA Box">
        <section class="interioro-cta o_colored_level py-5"
                 data-snippet="theme_interioro.interioro_cta_box"
                 data-name="CTA Box">
            <div class="cmpad">
                <div class="conbox">
                    <!-- Clickable image -->
                    <img src="/theme_interioro/static/src/img/banner/contact.jpg"
                         class="o_we_image interioro-cta-img"
                         alt="CTA Background"/>
                    <div class="conbox-overlay"/>
                    <div class="inner">
                        <div class="s_title" data-name="Heading">
                            <h2 class="mainhead white mb-3 o_editable">
                                "Your Dream Space is
                                <span class="span-clr">Just a Click</span> Away."
                            </h2>
                        </div>
                        <a href="/contactus" class="btn">Contact Us</a>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="interioro_cta_box_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]"
               position="inside">
            <t t-snippet="theme_interioro.interioro_cta_box"
               string="CTA Box"
               t-thumbnail="/theme_interioro/static/src/img/thumb_sections.png"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
