<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Products Carousel — Pure CSS sliding carousel.

        HOW IT WORKS:
        .ipc-mask  = overflow:hidden window
        .ipc-reel  = flex row; CSS @keyframes slides it left continuously
        .ipc-card  = one product card (real, editable)
        .ipc-card[aria-hidden] = duplicate cards appended by BuilderAction
                                  for seamless loop; hidden from screen readers

        NO JavaScript. NO Bootstrap .carousel class (avoids Odoo's built-in
        CarouselOptionPlugin which crashes on non-standard carousel markup).
        CSS animation pauses in editor so user can click and edit each card.

        BuilderAction adds/removes from real cards only (:not([aria-hidden])).
        It also syncs the hidden duplicate set to keep the loop seamless.
    -->
    <template id="interioro_products_carousel" name="Interioro Products Carousel">
        <section class="ipc-section o_colored_level py-5"
                 data-snippet="theme_interioro.interioro_products_carousel"
                 data-name="Products Carousel">

            <div class="cmpad">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                    <div class="s_title">
                        <h2 class="mainhead o_editable">
                            WE ARE <span class="span-clr">HERE</span><br/>
                            FOR YOUR NEED
                        </h2>
                    </div>
                    <div class="s_col_no_bgcolor">
                        <p class="para o_editable">
                            We design stylish and functional interiors that reflect your lifestyle,
                            combining creativity, comfort, and quality craftsmanship.
                        </p>
                        <a href="/products" class="btn">Know More</a>
                    </div>
                </div>
            </div>

            <div class="ipc-mask">
                <div class="ipc-reel">

                    <!-- Real cards — image + title + description, all editable -->
                    <div class="ipc-card" data-name="Product Card">
                        <a href="/products" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/products/pro1.jpg"
                                     class="o_we_custom_image" alt="Modern Harmony Design"/>
                            </div>
                            <div class="pro-con">
                                <div class="num">01</div>
                                <div class="pro-text">
                                    <h5 class="o_editable">Modern Harmony Design</h5>
                                    <p class="para o_editable">Clean lines and balanced layouts create a calm, stylish space for modern living.</p>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="ipc-card" data-name="Product Card">
                        <a href="/products" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/products/pro2.jpg"
                                     class="o_we_custom_image" alt="Luxury Living Concept"/>
                            </div>
                            <div class="pro-con">
                                <div class="num">02</div>
                                <div class="pro-text">
                                    <h5 class="o_editable">Luxury Living Concept</h5>
                                    <p class="para o_editable">Premium materials and elegant details for a refined interior experience.</p>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="ipc-card" data-name="Product Card">
                        <a href="/products" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/products/pro3.jpg"
                                     class="o_we_custom_image" alt="Minimal Comfort Style"/>
                            </div>
                            <div class="pro-con">
                                <div class="num">03</div>
                                <div class="pro-text">
                                    <h5 class="o_editable">Minimal Comfort Style</h5>
                                    <p class="para o_editable">Simple forms and neutral tones deliver a warm, clutter-free interior design.</p>
                                </div>
                            </div>
                        </a>
                    </div>

                </div><!-- /.ipc-reel -->
            </div><!-- /.ipc-mask -->

        </section>
    </template>

    <template id="interioro_products_carousel_snippet"
              inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_products_carousel"
               string="Products Carousel"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
