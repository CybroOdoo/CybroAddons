<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_stats_banner" name="Interioro Stats Banner">
        <section class="interioro-stats-banner o_colored_level counter py-3"
                 data-snippet="theme_interioro.interioro_stats_banner"
                 data-name="Stats Banner">
            <div class="cmpad">
                <div class="row">
                    <div class="col-md-3 col-6 s_col_no_bgcolor" data-name="Stat 1">
                        <div class="s_title" data-name="Number">
                            <h2 class="o_editable">12k</h2>
                        </div>
                        <div class="s_title" data-name="Label">
                            <h3 class="o_editable">Interior Projects</h3>
                        </div>
                        <div class="s_text_block" data-name="Description">
                            <p class="o_editable">Completed with precision and style.</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 s_col_no_bgcolor" data-name="Stat 2">
                        <div class="s_title" data-name="Number">
                            <h2 class="o_editable">23</h2>
                        </div>
                        <div class="s_title" data-name="Label">
                            <h3 class="o_editable">Years of Works</h3>
                        </div>
                        <div class="s_text_block" data-name="Description">
                            <p class="o_editable">Experience you can trust.</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 s_col_no_bgcolor" data-name="Stat 3">
                        <div class="s_title" data-name="Number">
                            <h2 class="o_editable">34k</h2>
                        </div>
                        <div class="s_title" data-name="Label">
                            <h3 class="o_editable">Satisfied Clients</h3>
                        </div>
                        <div class="s_text_block" data-name="Description">
                            <p class="o_editable">Happy clients worldwide.</p>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 s_col_no_bgcolor" data-name="Stat 4">
                        <div class="s_title" data-name="Number">
                            <h2 class="o_editable">99%</h2>
                        </div>
                        <div class="s_title" data-name="Label">
                            <h3 class="o_editable">Happy Rate</h3>
                        </div>
                        <div class="s_text_block" data-name="Description">
                            <p class="o_editable">Quality that delights consistently.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="interioro_stats_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_stats_banner"
               string="Stats Banner"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
