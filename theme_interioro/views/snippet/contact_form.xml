<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_contact_form" name="Interioro Contact Form">
        <section class="interioro-contact-form o_colored_level py-5 my-5"
                 data-snippet="theme_interioro.interioro_contact_form"
                 data-name="Contact Form">
            <div class="cmpad">
                <div class="row">
                    <div class="col-md-6 s_col_no_bgcolor d-flex align-items-center justify-content-center" data-name="Illustration Column">
                        <img src="/theme_interioro/static/src/img/contact/contact.svg"
                             class="o_we_custom_image"
                             alt="Contact Us"
                             style="max-width:480px; width:100%; margin:auto;"/>
                    </div>
                    <div class="col-md-6 s_col_no_bgcolor d-flex justify-content-center flex-column" data-name="Form Column">
                        <div class="s_title" data-name="Heading">
                            <h2 class="mainhead o_editable">GET IN <span class="span-clr">TOUCH</span></h2>
                        </div>
                        <form action="/website/form/" method="post"
                              class="mt-3 s_website_form"
                              data-model_name="mail.mail"
                              data-success-page="/contactus-thank-you">
                            <input type="hidden" name="email_to" value="info@yourcompany.com"/>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <input type="text" name="name" placeholder="Name" required="required"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <input type="email" name="email_from" placeholder="Email" required="required"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <input type="text" name="phone" placeholder="Phone"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <input type="text" name="subject" placeholder="Subject"/>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <textarea name="body_html" placeholder="Message" rows="4"/>
                                </div>
                                <div class="col-md-12">
                                    <button type="submit" class="btn">Submit Message</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="interioro_contact_form_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_contact_form"
               string="Contact Form"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
