<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_faq" name="Interioro FAQ">
        <section class="interioro-faq o_colored_level py-5"
                 data-snippet="theme_interioro.interioro_faq"
                 data-name="FAQ">
            <div class="cmpad">
                <div class="row">
                    <div class="col-md-5 s_col_no_bgcolor" data-name="Heading Column">
                        <h2 class="mainhead o_editable">
                            TOP <span class="span-clr">QUESTIONS</span><br/>
                            ANSWERED
                        </h2>
                        <p class="para o_editable" style="margin-top:16px;">
                            Find clear answers to the most common questions about
                            our services, process, and design approach in detail.
                        </p>
                    </div>
                    <div class="col-md-7 s_col_no_bgcolor" data-name="Accordion Column">
                        <div class="itr-faq">

                            <div class="itr-faq-item active">
                                <div class="itr-faq-q">
                                    <span class="o_editable">What is the Interioro style?</span>
                                    <button class="itr-faq-btn" type="button" aria-expanded="true">
                                        <span class="itr-faq-icon"/>
                                    </button>
                                </div>
                                <div class="itr-faq-a">
                                    <p class="o_editable">
                                        We specialize in Modern Organic — a blend of clean lines,
                                        natural textures, and a balance of Sage, Charcoal, and Gold.
                                    </p>
                                </div>
                            </div>

                            <div class="itr-faq-item">
                                <div class="itr-faq-q">
                                    <span class="o_editable">Where are you located?</span>
                                    <button class="itr-faq-btn" type="button" aria-expanded="false">
                                        <span class="itr-faq-icon"/>
                                    </button>
                                </div>
                                <div class="itr-faq-a">
                                    <p class="o_editable">
                                        We are based locally and work with clients across multiple
                                        locations. Our team also offers remote consultations.
                                    </p>
                                </div>
                            </div>

                            <div class="itr-faq-item">
                                <div class="itr-faq-q">
                                    <span class="o_editable">Do you work on commercial spaces?</span>
                                    <button class="itr-faq-btn" type="button" aria-expanded="false">
                                        <span class="itr-faq-icon"/>
                                    </button>
                                </div>
                                <div class="itr-faq-a">
                                    <p class="o_editable">
                                        Yes — offices, retail stores, cafes, and showrooms.
                                        We create functional, visually appealing commercial environments.
                                    </p>
                                </div>
                            </div>

                            <div class="itr-faq-item">
                                <div class="itr-faq-q">
                                    <span class="o_editable">Do you provide 3D visualizations?</span>
                                    <button class="itr-faq-btn" type="button" aria-expanded="false">
                                        <span class="itr-faq-icon"/>
                                    </button>
                                </div>
                                <div class="itr-faq-a">
                                    <p class="o_editable">
                                        Yes — detailed 3D renders before execution so every layout,
                                        material, and finish aligns perfectly with your vision.
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="interioro_faq_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_faq"
               string="FAQ"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
