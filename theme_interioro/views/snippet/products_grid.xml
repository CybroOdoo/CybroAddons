<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_products_grid" name="Interioro Products Grid">
        <section class="interioro-products-grid o_colored_level py-5 my-md-5"
                 data-snippet="theme_interioro.interioro_products_grid"
                 data-name="Products Grid">
            <div class="cmpad">
                <div class="row mb-5" data-name="Section Heading">
                    <div class="s_title">
                        <h2 class="mainhead o_editable">
                            WE ARE <span class="span-clr">HERE</span><br/>
                            FOR YOUR NEED
                        </h2>
                    </div>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3">

                    <div class="cols" data-name="Product Card 1">
                        <a href="/products" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/products/pro1.jpg"
                                     class="o_we_custom_image"
                                     alt="Modern Harmony Design"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">01</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Modern Harmony Design</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Clean lines and balanced layouts create a calm, stylish space for modern living.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Product Card 2">
                        <a href="/products" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/products/pro2.jpg"
                                     class="o_we_custom_image"
                                     alt="Luxury Living Concept"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">02</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Luxury Living Concept</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Premium materials and elegant details for a refined interior experience.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Product Card 3">
                        <a href="/products" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/products/pro3.jpg"
                                     class="o_we_custom_image"
                                     alt="Minimal Comfort Style"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">03</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Minimal Comfort Style</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Simple forms and neutral tones deliver a warm, clutter-free interior design.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Product Card 4">
                        <a href="/products" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/products/pro1.jpg"
                                     class="o_we_custom_image"
                                     alt="Contemporary Chic Interior"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">04</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Contemporary Chic Interior</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">A perfect blend of modern aesthetics and functional design for everyday comfort.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Product Card 5">
                        <a href="/products" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/products/pro2.jpg"
                                     class="o_we_custom_image"
                                     alt="Elegant Urban Design"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">05</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Elegant Urban Design</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Sophisticated interiors crafted for stylish and practical city living.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Product Card 6">
                        <a href="/products" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/products/pro3.jpg"
                                     class="o_we_custom_image"
                                     alt="Nordic Minimal Space"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">06</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Nordic Minimal Space</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Simple forms and neutral tones deliver a warm, clutter-free interior design.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                </div>
            </div>
        </section>
    </template>

    <template id="interioro_products_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_products_grid"
               string="Products Grid"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
