<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_services_grid" name="Interioro Services Grid">
        <section class="interioro-services-grid o_colored_level py-5 my-md-5"
                 data-snippet="theme_interioro.interioro_services_grid"
                 data-name="Services Grid">
            <div class="cmpad">
                <div class="row mb-5" data-name="Section Heading">
                    <div class="s_title">
                        <h2 class="mainhead o_editable">
                            WHERE DESIGN<br/>
                            IDEAS <span class="span-clr">TURN</span> INTO<br/>
                            BEAUTIFUL
                        </h2>
                    </div>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3">

                    <div class="cols" data-name="Service Card 1">
                        <a href="/services" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/services/home.jpg"
                                     class="o_we_custom_image"
                                     alt="Home Interior Design"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">01</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Home Interior Design</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Clean lines and balanced layouts create a calm, stylish space for modern living.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Service Card 2">
                        <a href="/services" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/services/office.jpg"
                                     class="o_we_custom_image"
                                     alt="Office Interior Design"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">02</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Office Interior Design</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Premium materials and elegant details for a refined professional environment.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Service Card 3">
                        <a href="/services" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/services/bedroom.jpg"
                                     class="o_we_custom_image"
                                     alt="Bedroom Interior"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">03</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Bedroom Interior</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Simple forms and neutral tones deliver a warm, clutter-free interior design.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Service Card 4">
                        <a href="/services" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/services/living.jpg"
                                     class="o_we_custom_image"
                                     alt="Living Room Interior"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">04</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Living Room Interior</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">A perfect blend of modern aesthetics and functional design for everyday comfort.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Service Card 5">
                        <a href="/services" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/services/kitchen.jpg"
                                     class="o_we_custom_image"
                                     alt="Kitchen Interior"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">05</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Kitchen Interior</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Sophisticated interiors crafted for stylish and practical city living.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="cols" data-name="Service Card 6">
                        <a href="/services" class="pro-card d-block">
                            <div class="pro-img">
                                <img src="/theme_interioro/static/src/img/services/bathroom.jpg"
                                     class="o_we_custom_image"
                                     alt="Bathroom Interior"/>
                            </div>
                            <div class="pro-con">
                                <div class="num o_editable">06</div>
                                <div>
                                    <div class="s_title"><h5 class="o_editable">Bathroom Interior</h5></div>
                                    <div class="s_text_block"><p class="para o_editable">Clean and modern bathroom interiors focused on comfort and practicality.</p></div>
                                </div>
                            </div>
                        </a>
                    </div>

                </div>
            </div>
        </section>
    </template>

    <template id="interioro_services_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_services_grid"
               string="Services Grid"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
