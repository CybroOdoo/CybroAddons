<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_about_intro" name="Interioro About Intro">
        <section class="interioro-about-intro o_colored_level py-5 my-md-5"
                 data-snippet="theme_interioro.interioro_about_intro"
                 data-name="About Intro">
            <div class="cmpad">
                <div class="row">
                    <div class="col-md-6 s_col_no_bgcolor" data-name="Image Column">
                        <img src="/theme_interioro/static/src/img/about/abt1.jpg"
                             class="o_we_custom_image"
                             alt="About Interioro" style="width:100%;"/>
                    </div>
                    <div class="col-md-6 py-3 s_col_no_bgcolor d-flex flex-column justify-content-center"
                         data-name="Text Column">
                        <div class="s_text_block" data-name="Subheading">
                            <span class="subhead o_editable">WELCOME TO INTERIORO</span>
                        </div>
                        <div class="s_title" data-name="Main Heading">
                            <h2 class="mainhead o_editable">
                                WE HELP YOU<br/>
                                CREATE <span class="span-clr">MODERN</span><br/>
                                SPACES
                            </h2>
                        </div>
                        <div class="s_text_block" data-name="Paragraph 1">
                            <p class="para mb-3 o_editable">
                                We create modern interiors with clean lines, smart layouts, and a
                                timeless aesthetic that feels both functional and welcoming. Our
                                approach focuses on simplicity, comfort, and thoughtful details
                                that elevate everyday spaces.
                            </p>
                        </div>
                        <div class="s_text_block" data-name="Paragraph 2">
                            <p class="para mb-3 o_editable">
                                We design modern interiors that combine elegance and functionality,
                                delivering refined spaces crafted to suit your lifestyle. Every
                                interior is thoughtfully designed to reflect modern living,
                                balancing luxury finishes with practical comfort.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="interioro_about_intro_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_about_intro"
               string="About Intro"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
