<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="interioro_snippet_options" inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-js="interioro_brand_strip" data-selector=".interioro-brand-strip">
                <we-row string="Brand Logos">
                    <we-button data-add-brand-logo="true" class="o_we_bg_success">+ Add Logo</we-button>
                    <we-button data-remove-brand-logo="true" class="o_we_bg_danger">- Remove Logo</we-button>
                </we-row>
            </div>
            <div data-js="interioro_products_carousel" data-selector=".ipc-section">
                <we-row string="Product Cards">
                    <we-button data-add-product-card="true" class="o_we_bg_success">+ Add Card</we-button>
                    <we-button data-remove-product-card="true" class="o_we_bg_danger">- Remove Card</we-button>
                </we-row>
            </div>
        </xpath>
    </template>
</odoo>
