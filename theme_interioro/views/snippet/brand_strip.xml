<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Brand Logo Strip Snippet
        Saved HTML contains only real .ibs-logo items.
        The publicWidget (theme.js) appends duplicate logos at runtime
        for the seamless CSS animation loop, and removes them on destroy().
        The editor never sees or saves duplicates.
    -->
    <template id="interioro_brand_strip" name="Interioro Brand Logo Strip">
        <section class="interioro-brand-strip o_colored_level py-4"
                 data-snippet="theme_interioro.interioro_brand_strip"
                 data-name="Brand Logo Strip">
            <div class="ibs-viewport">
                <div class="ibs-track">
                    <div class="ibs-logo" data-name="Brand Logo">
                        <img src="/theme_interioro/static/src/img/logo/logo2.png"
                             class="o_we_custom_image" alt="Brand"/>
                    </div>
                    <div class="ibs-logo" data-name="Brand Logo">
                        <img src="/theme_interioro/static/src/img/logo/logo3.png"
                             class="o_we_custom_image" alt="Brand"/>
                    </div>
                    <div class="ibs-logo" data-name="Brand Logo">
                        <img src="/theme_interioro/static/src/img/logo/logo4.png"
                             class="o_we_custom_image" alt="Brand"/>
                    </div>
                    <div class="ibs-logo" data-name="Brand Logo">
                        <img src="/theme_interioro/static/src/img/logo/logo5.png"
                             class="o_we_custom_image" alt="Brand"/>
                    </div>
                    <div class="ibs-logo" data-name="Brand Logo">
                        <img src="/theme_interioro/static/src/img/logo/logo6.png"
                             class="o_we_custom_image" alt="Brand"/>
                    </div>
                    <div class="ibs-logo" data-name="Brand Logo">
                        <img src="/theme_interioro/static/src/img/logo/logo7.png"
                             class="o_we_custom_image" alt="Brand"/>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="interioro_brand_strip_snippet"
              inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_brand_strip"
               string="Brand Logo Strip"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
