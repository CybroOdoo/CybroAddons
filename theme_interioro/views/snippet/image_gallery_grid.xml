<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_image_gallery_grid" name="Interioro Image Gallery Grid">
        <section class="interioro-gallery-grid o_colored_level py-5 my-md-5"
                 data-snippet="theme_interioro.interioro_image_gallery_grid"
                 data-name="Image Gallery Grid">
            <div class="cmpad">
                <div class="image-grid">

                    <div class="image-panel panel-1" data-name="Panel 1">
                        <img src="/theme_interioro/static/src/img/products/pro1.jpg"
                             class="o_we_custom_image"
                             alt="Living Room"/>
                    </div>

                    <div data-name="Panel 2 with Overlay">
                        <div class="overlay-card" data-name="Overlay Card">
                            <h1 class="o_editable">Home Interior</h1>
                            <p class="o_editable">Thoughtfully designed home interiors that blend comfort, style, and functionality for everyday living.</p>
                        </div>
                        <div class="image-panel panel-2">
                            <img src="/theme_interioro/static/src/img/products/pro2.jpg"
                                 class="o_we_custom_image"
                                 alt="Modern Interior"/>
                        </div>
                    </div>

                    <div class="image-panel panel-3" data-name="Panel 3">
                        <img src="/theme_interioro/static/src/img/products/pro3.jpg"
                             class="o_we_custom_image"
                             alt="Bedroom"/>
                    </div>

                </div>
            </div>
        </section>
    </template>

    <template id="interioro_image_gallery_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_image_gallery_grid"
               string="Image Gallery Grid"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
