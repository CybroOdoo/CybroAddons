<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_detail_content_block" name="Interioro Detail Content Block">
        <section class="interioro-detail-content o_colored_level py-5 my-md-5"
                 data-snippet="theme_interioro.interioro_detail_content_block"
                 data-name="Detail Content Block">
            <div class="cmpad">
                <div class="row mb-3" data-name="Detail Heading">
                    <div class="s_title">
                        <h2 class="mainhead o_editable">
                            OUR <span class="span-clr">DESIGN</span> STORY
                        </h2>
                    </div>
                </div>
                <div class="detail-wrap" data-name="Detail Body">
                    <div style="float:right;" class="mb-2 ps-md-3" data-name="Float Image">
                        <img src="/theme_interioro/static/src/img/products/pro1.jpg"
                             class="o_we_custom_image imgfloat"
                             alt="Detail Image"/>
                    </div>
                    <div class="s_text_block" data-name="Paragraph 1">
                        <p class="o_editable">
                            Our Modern Harmony Design collection is built around the philosophy that beautiful
                            interiors should feel as good as they look. Every piece in this collection has
                            been carefully selected and curated to bring together clean lines, balanced
                            proportions, and a timeless aesthetic that adapts to any modern living space.
                        </p>
                    </div>
                    <div class="s_text_block" data-name="Paragraph 2">
                        <p class="o_editable">
                            We source materials from trusted suppliers who share our commitment to quality
                            and sustainability. From solid hardwoods and natural stone surfaces to premium
                            upholstery fabrics and hand-crafted finishes, each element is chosen to stand
                            the test of time both visually and functionally.
                        </p>
                    </div>
                    <div class="s_text_block" data-name="Paragraph 3">
                        <p class="o_editable">
                            The Modern Harmony Design range works equally well in residential and commercial
                            settings. Whether you are furnishing a family home, a boutique hotel lobby, or a
                            corporate reception area, these pieces bring a sense of calm sophistication.
                        </p>
                    </div>
                    <div class="s_text_block" data-name="Paragraph 4">
                        <p class="o_editable">
                            Every product in this range comes with a detailed care guide and a quality
                            guarantee. We believe that investing in great design is investing in your
                            wellbeing and productivity. That is the Interioro promise — spaces that
                            elevate everyday life through the power of great design.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="interioro_detail_content_block_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_detail_content_block"
               string="Detail Content Block"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
