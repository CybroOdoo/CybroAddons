<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_interior_types_grid" name="Interioro Interior Types Grid">
        <section class="interioro-interior-types o_colored_level py-md-5 my-md-5"
                 data-snippet="theme_interioro.interioro_interior_types_grid"
                 data-name="Interior Types Grid">
            <div class="cmpad">
                <div class="s_title" data-name="Section Heading">
                    <h2 class="mainhead text-center mb-5 o_editable">
                        We provide types of <span class="span-clr">interior</span> designs
                    </h2>
                </div>
                <div class="abtcontainer">

                    <div class="left-column" data-name="Left Service Cards">
                        <div class="service-card" data-name="Card 1">
                            <h2 class="o_editable">Home Interior</h2>
                            <p class="o_editable">Thoughtfully designed home interiors that blend comfort, style, and functionality for everyday living.</p>
                            <a href="/services" class="read-more o_editable">READ MORE</a>
                        </div>
                        <div class="service-card" data-name="Card 2">
                            <h2 class="o_editable">Office Interior</h2>
                            <p class="o_editable">Modern office interiors designed to enhance productivity, comfort, and professional appeal.</p>
                            <a href="/services" class="read-more o_editable">READ MORE</a>
                        </div>
                        <div class="service-card" data-name="Card 3">
                            <h2 class="o_editable">Bedroom Interior</h2>
                            <p class="o_editable">Calm and stylish bedroom interiors crafted for relaxation and personal comfort.</p>
                            <a href="/services" class="read-more o_editable">READ MORE</a>
                        </div>
                    </div>

                    <img src="/theme_interioro/static/src/img/about/abt2.png"
                         class="o_we_custom_image"
                         alt="Interior Center"
                         style="width:100%; height:100%; object-fit:cover; display:block;"/>

                    <div class="right-column" data-name="Right Service Cards">
                        <div class="service-card" data-name="Card 4">
                            <h2 class="o_editable">Living Room Interior</h2>
                            <p class="o_editable">Elegant living room interiors that create a welcoming and modern atmosphere.</p>
                            <a href="/services" class="read-more o_editable">READ MORE</a>
                        </div>
                        <div class="service-card" data-name="Card 5">
                            <h2 class="o_editable">Kitchen Interior</h2>
                            <p class="o_editable">Smart and functional kitchen interiors designed for efficiency and modern living.</p>
                            <a href="/services" class="read-more o_editable">READ MORE</a>
                        </div>
                        <div class="service-card" data-name="Card 6">
                            <h2 class="o_editable">Bathroom Interior</h2>
                            <p class="o_editable">Clean and modern bathroom interiors with a focus on comfort and practicality.</p>
                            <a href="/services" class="read-more o_editable">READ MORE</a>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </template>

    <template id="interioro_interior_types_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_interior_types_grid"
               string="Interior Types Grid"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
