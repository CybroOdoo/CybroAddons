<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="interioro_hero_banner" name="Interioro Hero Banner">
        <section class="interioro-hero o_colored_level" data-snippet="theme_interioro.interioro_hero_banner" data-name="Hero Banner">
            <div class="cmpad">
                <div class="slider">
                    <!-- The image itself — clickable in builder -->
                    <img src="/theme_interioro/static/src/img/banner/home_banner.jpg"
                         class="o_we_image interioro-hero-img"
                         alt="Interioro Interior Design"/>
                    <!-- Overlay and content layers (CSS will pass clicks through empty space) -->
                    <div class="slider-overlay"/>
                    <div class="slider-content">
                        <h1 class="o_editable">WE DESIGN<br/>THE <span class="span-clr">FEELING</span> OF YOU</h1>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="interioro_hero_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_interioro.interioro_hero_banner"
               string="Hero Banner"
               t-thumbnail="/theme_interioro/static/src/img/thumb_sections.png"
               group="interioro_section"/>
        </xpath>
    </template>
</odoo>
