<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="about_page" name="Interioro About">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="interioro-breadcrumb o_colored_level"
                         data-snippet="theme_interioro.interioro_breadcrumb_banner"
                         data-name="Breadcrumb Banner">
                    <div class="cmpad">
                        <div class="breadcrmb">
                            <h3 class="o_editable">About Us</h3>
                            <ul>
                                <li>
                                    <a href="/" class="o_editable">Home</a>
                                </li>
                                <li>
                                    <a class="active o_editable">About Us</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </section>

                <section class="interioro-about-intro o_colored_level py-5 my-md-5"
                         data-snippet="theme_interioro.interioro_about_intro"
                         data-name="About Intro">
                    <div class="cmpad">
                        <div class="row">
                            <div class="col-md-6 s_col_no_bgcolor" data-name="Image Column">
                                <img src="/theme_interioro/static/src/img/about/abt1.jpg"
                                     class="o_we_custom_image"
                                     alt="About Interioro" style="width:100%;"/>
                            </div>
                            <div class="col-md-6 py-3 s_col_no_bgcolor d-flex flex-column justify-content-center"
                                 data-name="Text Column">
                                <div class="s_text_block">
                                    <span class="subhead o_editable">WELCOME TO INTERIORO</span>
                                </div>
                                <div class="s_title">
                                    <h2 class="mainhead o_editable">WE HELP YOU<br/>CREATE
                                        <span class="span-clr">MODERN</span>
                                        <br/>SPACES
                                    </h2>
                                </div>
                                <div class="s_text_block">
                                    <p class="para mb-3 o_editable">We create modern interiors with clean lines, smart
                                        layouts, and a timeless aesthetic that feels both functional and welcoming. Our
                                        approach focuses on simplicity, comfort, and thoughtful details that elevate
                                        everyday spaces.
                                    </p>
                                </div>
                                <div class="s_text_block">
                                    <p class="para mb-3 o_editable">We design modern interiors that combine elegance and
                                        functionality, delivering refined spaces crafted to suit your lifestyle. Every
                                        interior is thoughtfully designed to reflect modern living, balancing luxury
                                        finishes with practical comfort.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="interioro-interior-types o_colored_level py-md-5 my-md-5"
                         data-snippet="theme_interioro.interioro_interior_types_grid"
                         data-name="Interior Types Grid">
                    <div class="cmpad">
                        <div class="s_title">
                            <h2 class="mainhead text-center mb-5 o_editable">We provide types of <span class="span-clr">
                                interior
                            </span> designs
                            </h2>
                        </div>
                        <div class="abtcontainer">
                            <div class="left-column">
                                <div class="service-card">
                                    <h2 class="o_editable">Home Interior</h2>
                                    <p class="o_editable">Thoughtfully designed home interiors that blend comfort,
                                        style, and functionality.
                                    </p>
                                    <a href="/services" class="read-more o_editable">READ MORE</a>
                                </div>
                                <div class="service-card">
                                    <h2 class="o_editable">Office Interior</h2>
                                    <p class="o_editable">Modern office interiors designed to enhance productivity,
                                        comfort, and professional appeal.
                                    </p>
                                    <a href="/services" class="read-more o_editable">READ MORE</a>
                                </div>
                                <div class="service-card">
                                    <h2 class="o_editable">Bedroom Interior</h2>
                                    <p class="o_editable">Calm and stylish bedroom interiors crafted for relaxation and
                                        personal comfort.
                                    </p>
                                    <a href="/services" class="read-more o_editable">READ MORE</a>
                                </div>
                            </div>
                            <img src="/theme_interioro/static/src/img/about/abt2.png" class="o_we_custom_image"
                                 alt="Interior Center"
                                 style="width:100%; height:100%; object-fit:cover; display:block;"/>
                            <div class="right-column">
                                <div class="service-card">
                                    <h2 class="o_editable">Living Room Interior</h2>
                                    <p class="o_editable">Elegant living room interiors that create a welcoming and
                                        modern atmosphere.
                                    </p>
                                    <a href="/services" class="read-more o_editable">READ MORE</a>
                                </div>
                                <div class="service-card">
                                    <h2 class="o_editable">Kitchen Interior</h2>
                                    <p class="o_editable">Smart and functional kitchen interiors designed for efficiency
                                        and modern living.
                                    </p>
                                    <a href="/services" class="read-more o_editable">READ MORE</a>
                                </div>
                                <div class="service-card">
                                    <h2 class="o_editable">Bathroom Interior</h2>
                                    <p class="o_editable">Clean and modern bathroom interiors with a focus on comfort
                                        and practicality.
                                    </p>
                                    <a href="/services" class="read-more o_editable">READ MORE</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="interioro-gallery-grid o_colored_level py-5 my-md-5"
                         data-snippet="theme_interioro.interioro_image_gallery_grid"
                         data-name="Image Gallery Grid">
                    <div class="cmpad">
                        <div class="image-grid">
                            <div class="image-panel panel-1">
                                <img src="/theme_interioro/static/src/img/about/abt3.jpg" class="o_we_custom_image"
                                     alt="Living Room"/>
                            </div>
                            <div>
                                <div class="overlay-card">
                                    <h1 class="o_editable">Home Interior</h1>
                                    <p class="o_editable">Thoughtfully designed home interiors that blend comfort,
                                        style, and functionality for everyday living.
                                    </p>
                                </div>
                                <div class="image-panel panel-2">
                                    <img src="/theme_interioro/static/src/img/about/abt4.jpg" class="o_we_custom_image"
                                         alt="Modern Interior"/>
                                </div>
                            </div>
                            <div class="image-panel panel-3">
                                <img src="/theme_interioro/static/src/img/about/abt5.jpg" class="o_we_custom_image"
                                     alt="Bedroom"/>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
