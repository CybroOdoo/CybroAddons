<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit Odoo's built-in Contact Us page (website.contactus).
        This reuses the existing "Contact Us" menu item at /contactus that
        Odoo creates automatically. The form uses Odoo's native
        /website/form/ handler with data-model_name="mail.mail" so that
        submissions are stored and the success redirect works without any
        custom controller.
    -->
    <template id="interioro_contact_page" name="Interioro Contact Us"
              inherit_id="website.contactus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">

                <!-- Breadcrumb -->
                <section class="interioro-breadcrumb o_colored_level"
                         data-snippet="theme_interioro.interioro_breadcrumb_banner"
                         data-name="Breadcrumb Banner">
                    <div class="cmpad">
                        <div class="breadcrmb">
                            <h3 class="o_editable">Contact Us</h3>
                            <ul>
                                <li><a href="/">Home</a></li>
                                <li><a class="active">Contact Us</a></li>
                            </ul>
                        </div>
                    </div>
                </section>

                <!-- Contact Form Section -->
                <section class="interioro-contact-form o_colored_level py-5 my-md-5"
                         data-snippet="theme_interioro.interioro_contact_form"
                         data-name="Contact Form">
                    <div class="cmpad">
                        <div class="row">
                            <!-- Left: image / info panel -->
                            <div class="col-md-5 s_col_no_bgcolor d-flex align-items-center justify-content-center">
                                <img src="/theme_interioro/static/src/img/contact/contact.svg"
                                     class="o_we_custom_image"
                                     alt="Contact Us"
                                     style="max-width:420px; width:100%; margin:auto;"/>
                            </div>

                            <!-- Right: Odoo native website form -->
                            <div class="col-md-7 s_col_no_bgcolor d-flex justify-content-center flex-column">
                                <div class="s_title mb-3">
                                    <h2 class="mainhead o_editable">GET IN <span class="span-clr">TOUCH</span></h2>
                                </div>

                                <!--
                                    Native Odoo website form.
                                    action="/website/form/"   → Odoo's WebsiteForm controller
                                    data-model_name           → stores submission as mail.mail
                                    data-success-mode         → redirect after success
                                    data-success-page         → Odoo's built-in thank-you page
                                -->
                                <section class="s_website_form"
                                         data-vcss="001"
                                         data-snippet="s_website_form">
                                    <div class="container p-0">
                                        <form id="contactus_form"
                                              action="/website/form/"
                                              method="post"
                                              enctype="multipart/form-data"
                                              class="o_mark_required"
                                              data-mark="*"
                                              data-model_name="mail.mail"
                                              data-success-mode="redirect"
                                              data-success-page="/contactus-thank-you"
                                              data-pre-fill="true">
                                            <div class="s_website_form_rows row s_col_no_bgcolor">

                                                <!-- Name -->
                                                <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="icontact_name">Name</label>
                                                        <input id="icontact_name"
                                                               type="text"
                                                               class="form-control s_website_form_input"
                                                               name="name"
                                                               required=""/>
                                                    </div>
                                                </div>

                                                <!-- Phone -->
                                                <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="icontact_phone">Phone</label>
                                                        <input id="icontact_phone"
                                                               type="tel"
                                                               class="form-control s_website_form_input"
                                                               name="phone"
                                                               data-fill-with="phone"/>
                                                    </div>
                                                </div>

                                                <!-- Email -->
                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                                     data-type="email" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="icontact_email">Email</label>
                                                        <input id="icontact_email"
                                                               type="email"
                                                               class="form-control s_website_form_input"
                                                               name="email_from"
                                                               required=""
                                                               data-fill-with="email"/>
                                                    </div>
                                                </div>

                                                <!-- Subject -->
                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="icontact_subject">Subject</label>
                                                        <input id="icontact_subject"
                                                               type="text"
                                                               class="form-control s_website_form_input"
                                                               name="subject"
                                                               required=""/>
                                                    </div>
                                                </div>

                                                <!-- Message -->
                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required"
                                                     data-type="text" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="icontact_msg">Message</label>
                                                        <textarea id="icontact_msg"
                                                                  class="form-control s_website_form_input"
                                                                  name="description"
                                                                  rows="5"
                                                                  required=""/>
                                                    </div>
                                                </div>

                                                <!-- Hidden email_to (filled by Odoo from company settings) -->
                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_dnone">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <input type="hidden"
                                                               class="form-control s_website_form_input"
                                                               name="email_to"/>
                                                    </div>
                                                </div>

                                                <!-- Submit -->
                                                <div class="mb-0 py-2 col-12 s_website_form_submit"
                                                     data-name="Submit Button">
                                                    <a href="#"
                                                       role="button"
                                                       class="btn s_website_form_send">
                                                        <span>Send Message</span>
                                                    </a>
                                                    <span id="s_website_form_result"/>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure"/>

            </div>
        </xpath>
    </template>

</odoo>
