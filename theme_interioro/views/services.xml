<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="services_page" name="Interioro Services">
        <t t-call="website.layout">
            <div id="wrap">

                <div class="oe_structure"/>

                <section class="interioro-breadcrumb o_colored_level"
                         data-snippet="theme_interioro.interioro_breadcrumb_banner"
                         data-name="Breadcrumb Banner">
                    <div class="cmpad">
                        <div class="breadcrmb">
                            <h3 class="o_editable">Services</h3>
                            <ul>
                                <li><a href="/">Home</a></li>
                                <li><a class="active">Services</a></li>
                            </ul>
                        </div>
                    </div>
                </section>

                <!-- Services Grid — dynamic from interioro.service model -->
                <section class="interioro-services-grid o_colored_level py-5 my-md-5">
                    <div class="cmpad">
                        <div class="row mb-5">
                            <div class="s_title">
                                <h2 class="mainhead o_editable">WHERE DESIGN<br/>IDEAS <span class="span-clr">TURN</span><br/>INTO BEAUTIFUL</h2>
                            </div>
                        </div>
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3">
                            <t t-foreach="services" t-as="service">
                                <div class="cols">
                                    <a t-attf-href="/services/#{service.slug}" class="pro-card d-block">
                                        <div class="pro-img">
                                            <t t-if="service.image">
                                                <img t-attf-src="/web/image/interioro.service/#{service.id}/image"
                                                     t-att-alt="service.name"/>
                                            </t>
                                            <t t-else="">
                                                <img src="/theme_interioro/static/src/img/services/home.jpg"
                                                     t-att-alt="service.name"/>
                                            </t>
                                        </div>
                                        <div class="pro-con">
                                            <div class="num">
                                                <t t-esc="'%02d' % (service_index + 1)"/>
                                            </div>
                                            <div class="pro-text">
                                                <h5><t t-esc="service.name"/></h5>
                                                <t t-if="service.short_desc">
                                                    <p class="para"><t t-esc="service.short_desc"/></p>
                                                </t>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <div class="oe_structure"/>

            </div>
        </t>
    </template>
</odoo>
