<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend POS Order Payment Lines to show multi-currency info -->
    <record id="view_pos_order_form_multi_currency" model="ir.ui.view">
        <field name="name">pos.order.form.multi.currency</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">

            <!-- Add Amount Currency and Foreign Currency columns to payment lines -->
            <xpath expr="//page[@name='payments']//list//field[@name='amount']" position="after">
                <field name="amount_currency" string="Amount cur..." optional="show"/>
                <field name="foreign_currency_id" string="currency" optional="show"/>
                <field name="currency_symbol" string="Currency Symbol" optional="hide"/>
            </xpath>

        </field>
    </record>

</odoo>
