<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard form view for generating and improving product images using AI -->
    <record id="view_product_ai_image_generator_form" model="ir.ui.view">
        <field name="name">product.ai.image.generator.form</field>
        <field name="model">smart.product.image.generator</field>
        <field name="arch" type="xml">
            <form string="Generate Product Image with AI">
                <sheet>

                    <!-- Info banner (draft state) -->
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="state != 'draft'">
                        <i class="fa fa-info-circle me-2"/>
                        Auto-generated prompt based on your product data.
                        Review and adjust if needed, then click Generate.
                    </div>

                    <!-- Success banner after generation -->
                    <div class="alert alert-success mb-3" role="alert"
                         invisible="state != 'generated'">
                        <i class="fa fa-check-circle me-2"/>
                        Images generated! Select the one you want to use.
                    </div>

                    <!-- Applied banner -->
                    <div class="alert alert-success mb-3" role="alert"
                         invisible="state != 'applied'">
                        <i class="fa fa-check-circle me-2"/>
                        Image applied successfully to the product!
                    </div>

                    <!-- Hidden fields -->
                    <field name="bulk_mode" invisible="1"/>
                    <field name="state" invisible="1"/>

                    <!-- Bulk mode: product list -->
                    <group invisible="not bulk_mode">
                        <group string="Bulk Generation">
                            <field name="bulk_product_ids"
                                   widget="many2many_tags"
                                   string="Products to Process"/>
                            <field name="bulk_skip_existing"/>
                        </group>
                    </group>

                    <!-- Single product link (hidden, used for context) -->
                    <group invisible="1">
                        <field name="product_id"/>
                    </group>

                    <!-- Improve existing image toggle -->
                    <group invisible="bulk_mode">
                        <field name="enhance_existing"
                               widget="boolean_toggle"
                               string="Improve Existing Image"/>
                    </group>

                    <!-- Enhance mode panel -->
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="not enhance_existing or bulk_mode">
                        <i class="fa fa-lightbulb-o me-2"/>
                        The AI will improve the current product image while
                        maintaining its essence. Describe below what you'd
                        like to enhance.
                    </div>

                    <group invisible="not enhance_existing or bulk_mode">
                        <group string="Enhancement">
                            <field name="current_image"
                                   widget="image"
                                   string="Current Image"
                                   options="{'size': [128, 128]}"
                                   readonly="1"/>
                            <field name="enhancement_description"
                                   placeholder="e.g. Better lighting, cleaner background, more professional look, add soft shadows..."
                                   string="Improvement Instructions"/>
                        </group>
                    </group>

                    <!-- Generation options -->
                    <group string="GENERATION OPTIONS">
                        <group>
                            <field name="ai_provider" string="AI Provider"/>
                            <field name="image_style" string="Image Style"/>
                        </group>
                        <group>
                            <field name="image_size" string="Image Size"/>
                            <field name="num_variants"
                                   string="Number of Variants"/>
                        </group>
                    </group>

                    <!-- AI Prompt -->
                    <group string="AI PROMPT"
                           invisible="state == 'generated'">
                        <field name="prompt"
                               nolabel="1"
                               widget="text"
                               style="min-height: 150px; font-family: monospace; font-size: 13px;"
                               placeholder="Auto-generating prompt from product data..."/>
                    </group>

                    <!-- Generated images -->
                    <group string="Generated Images"
                           invisible="state not in ['generated', 'applied']">
                        <field name="generated_image_ids"
                               nolabel="1"
                               mode="list">
                            <list string="Generated Images"
                                  create="false"
                                  delete="false">
                                <field name="image"
                                       widget="image"
                                       string="Preview"
                                       options="{'size': [128, 128]}"/>
                                <field name="provider_used"
                                       string="Provider"/>
                                <field name="style_used" string="Style"/>
                                <button name="action_apply_image_line"
                                        string="✓ Use This Image"
                                        type="object"
                                        class="btn btn-link text-success"/>
                            </list>
                        </field>
                    </group>

                    <!-- Bulk progress log -->
                    <group string="Progress"
                           invisible="not bulk_progress_log">
                        <field name="bulk_progress_log"
                               nolabel="1"
                               readonly="1"
                               widget="text"
                               style="font-family: monospace; font-size: 12px; min-height: 120px;"/>
                    </group>

                </sheet>

                <footer>
                    <!-- Generate (normal mode, not enhance) -->
                    <button name="action_generate_images"
                            string="✨ Generate Images"
                            type="object"
                            class="btn btn-primary"
                            invisible="state != 'draft' or bulk_mode or enhance_existing"/>

                    <!-- Improve (enhance mode) -->
                    <button name="action_generate_images"
                            string="✨ Improve Image"
                            type="object"
                            class="btn btn-primary"
                            invisible="state != 'draft' or bulk_mode or not enhance_existing"/>

                    <!-- Bulk generate -->
                    <button name="action_bulk_generate"
                            string="🚀 Generate All"
                            type="object"
                            class="btn btn-primary"
                            invisible="not bulk_mode"/>

                    <!-- Generate more (after results shown) -->
                    <button name="action_generate_more"
                            string="↺ Generate More"
                            type="object"
                            class="btn btn-secondary"
                            invisible="state != 'generated'"/>

                    <button special="cancel"
                            string="Cancel"
                            class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_product_ai_image_generator"
            model="ir.actions.act_window">
        <field name="name">Generate Product Image with AI</field>
        <field name="res_model">smart.product.image.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>