<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings view for configuring AI image generation providers and workflow -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.form.inherit.product.template.form.inherit.smart.product.image.generator
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Image Generator" name="smart_product_image_generator"
                     groups="base.group_system">

                    <block title="API Keys"
                           help="Enter your API key for at least one AI provider. Keys are stored securely as system parameters. You pay AI providers directly based on your usage.">
                        <setting string="OpenAI API Key (DALL-E 3)"
                                 help="Get your key at https://platform.openai.com/api-keys">
                            <field name="openai_api_key" password="True"
                                   placeholder="sk-..."/>
                        </setting>
                        <setting string="Stability AI API Key"
                                 help="Get your key at https://platform.stability.ai/account/keys">
                            <field name="stability_api_key" password="True"
                                   placeholder="sk-..."/>
                        </setting>
                        <setting string="Google Gemini API Key"
                                 help="Get your key at https://aistudio.google.com/app/apikey">
                            <field name="gemini_api_key" password="True"
                                   placeholder="AIza..."/>
                        </setting>
                    </block>

                    <block title="Brand Identity">
                        <setting string="Brand DNA / Visual Style Guide"
                                 help="Describe your brand visual identity. This is prepended to every AI prompt to ensure consistent imagery across your catalog.">
                            <field name="ai_brand_dna"
                                   widget="text"
                                   placeholder="e.g. Warm lighting, pastel earth tones, Scandinavian minimalist aesthetic, clean white background, soft natural shadows..."
                                   style="min-height: 80px; width: 100%;"/>
                        </setting>
                    </block>

                    <block title="Workflow">
                        <setting string="Require Manager Approval"
                                 help="When enabled, a manager must approve each AI-generated image before it is applied to the product.">
                            <field name="ai_approval_required"/>
                        </setting>
                        <setting string="Default Number of Variants"
                                 help="Default number of image variants to generate per request (max 4).">
                            <field name="ai_max_variants"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>
</odoo>