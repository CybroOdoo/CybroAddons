<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit product.template form view to add AI button -->
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.smart.product.image.generator</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class,'oe_title')]" position="before">
                <div class="o_product_ai_image_btn">
                    <button name="action_open_ai_image_wizard"
                            string="✨ Generate Image with AI"
                            type="object"
                            class="btn btn-primary btn-sm"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Action to view AI image generation log -->
    <record id="action_ai_image_generation_log" model="ir.actions.act_window">
        <field name="name">AI Generated Images</field>
        <field name="res_model">ai.image.generation.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI images generated yet.
            </p>
            <p>
                Open any product and click
                <strong>"✨ Generate Image with AI"</strong>
                to get started.
            </p>
        </field>
    </record>

    <!-- Menu item in Sales app -->
    <menuitem id="menu_ai_generated_images"
              name="AI Generated Images"
              parent="sale.sale_menu_root"
              action="action_ai_image_generation_log"
              sequence="99"
              groups="smart_product_image_generator.group_ai_image_user"/>

</odoo>