<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_ai_image_generation_log_list" model="ir.ui.view">
        <field name="name">ai.image.generation.log.list</field>
        <field name="model">ai.image.generation.log</field>
        <field name="arch" type="xml">
            <list string="AI Image Generation Log"
                  decoration-danger="status == 'failed'"
                  decoration-warning="status == 'pending_approval'"
                  decoration-success="status == 'success'">
                <field name="create_date" string="Generated At"/>
                <field name="product_id"/>
                <field name="user_id"/>
                <field name="ai_provider"/>
                <field name="image_style"/>
                <field name="image_size"/>
                <field name="num_variants_requested"/>
                <field name="enhance_mode"/>
                <field name="status" widget="badge"/>
                <field name="image_applied"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ai_image_generation_log_form" model="ir.ui.view">
        <field name="name">ai.image.generation.log.form</field>
        <field name="model">ai.image.generation.log</field>
        <field name="arch" type="xml">
            <form string="AI Image Generation Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Generation Info">
                            <field name="product_id"/>
                            <field name="user_id"/>
                            <field name="create_date" string="Generated At"/>
                            <field name="ai_provider"/>
                            <field name="image_style"/>
                            <field name="image_size"/>
                            <field name="num_variants_requested"/>
                            <field name="enhance_mode"/>
                        </group>

                        <group string="Result">
                            <field name="status" widget="badge"/>
                            <field name="image_applied"/>
                            <field name="image_generated"
                                   widget="image"
                                   options="{'size': [200, 200]}"
                                   invisible="not image_generated"/>
                        </group>
                    </group>

                    <group string="Prompt Used" invisible="not prompt">
                        <field name="prompt" nolabel="1" widget="text"/>
                    </group>

                    <group string="Error Details" invisible="not error_message">
                        <field name="error_message" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>