<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!--
        AI Image Lightbox Template

        Displays a full-screen preview of generated AI images and
        provides actions to apply, download, or close the preview.
    -->
    <t t-name="smart_product_image_generator.ImageLightbox">
        <div class="o_ai_lightbox_overlay" t-on-click.self="closeLightbox">
            <div class="o_ai_lightbox_dialog">
                <div class="o_ai_lightbox_header">
                    <span class="o_ai_lightbox_title">
                        <t t-if="props.provider">
                            <strong>Provider:</strong>
                            <t t-esc="props.provider"/>
                        </t>
                        <t t-if="props.style">
                            <strong> | Style:</strong>
                            <t t-esc="props.style"/>
                        </t>
                    </span>
                    <button class="btn-close" t-on-click="closeLightbox" aria-label="Close"/>
                </div>
                <div class="o_ai_lightbox_body">
                    <img t-att-src="props.imageUrl" class="o_ai_lightbox_img" alt="AI Generated Image"/>
                </div>
                <div class="o_ai_lightbox_footer">
                    <button class="btn btn-primary" t-on-click="useImage">Use This Image</button>
                    <button class="btn btn-secondary" t-on-click="downloadImage">Download</button>
                    <button class="btn btn-secondary" t-on-click="closeLightbox">Cancel</button>
                </div>
            </div>
        </div>
    </t>

</templates>