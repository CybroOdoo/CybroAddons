<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- AI Image Generator Privilege -->
        <record id="res_groups_privilege_ai_image" model="res.groups.privilege">
            <field name="name">AI Image Generator</field>
        </record>

        <!-- AI Image Generator Security Groups -->
        <record id="group_ai_image_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_ai_image"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Security group for users managing AI image generation settings and access -->
        <record id="group_ai_image_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_ai_image"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_image_user')), (4, ref('product.group_product_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>

</odoo>