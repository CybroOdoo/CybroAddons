<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- AI Image Generator Security Groups -->
        <record id="group_ai_image_user" model="res.groups">
            <field name="name">AI Image Generator User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Security group for users managing AI image generation settings and access -->
        <record id="group_ai_image_manager" model="res.groups">
            <field name="name">AI Image Generator Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_ai_image_user'))]"/>
        </record>

    </data>

</odoo>