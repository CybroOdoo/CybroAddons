<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    inheriting footer for replacing the existing footer  -->
    <template id="theme_autofly_footer" inherit_id="website.footer_custom"
              name="Autofly Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <section class="footer">
                <div class="wrapper">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-12">
                                <div class="footer_content">
                                    <div class="footer_heading footer_brand">
                                        AUTOFLY
                                    </div>
                                    <p class="footer_text">
                                        Lorem ipsum dolor sit amet,
                                        consectetur adipiscing elit, sed do
                                        eiusmod
                                        tempor
                                        incididunt ut labore et dolore magna
                                        aliqua. Ut enim ad minim veniam.
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-12">
                                <div class="footer_content">
                                    <div class="footer_heading footer_brand">
                                        Page
                                    </div>
                                    <ul class="footer_link">
                                        <li>
                                            <a href="/">Home</a>
                                        </li>
                                        <li>
                                            <a href="/about">About</a>
                                        </li>
                                        <li>
                                            <a href="/service">Services</a>
                                        </li>
                                        <li>
                                            <a href="/portfolio">Portfolio</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-12">
                                <div class="footer_content">
                                    <div class="footer_heading footer_brand">
                                        Company
                                    </div>
                                    <ul class="footer_link">
                                        <li>
                                            <a href="/team">Team</a>
                                        </li>
                                        <li>
                                            <a href="/blog">Blog</a>
                                        </li>
                                        <li>
                                            <a href="/contactus">Contact</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-12">
                                <div class="footer_content">
                                    <div class="footer_heading footer_brand">
                                        Legal
                                    </div>
                                    <ul class="footer_link">
                                        <li>
                                            <a href="/#">Privacy</a>
                                        </li>
                                        <li>
                                            <a href="/#">Refund Policy</a>
                                        </li>
                                        <li>
                                            <a href="/#">Cookie Policy</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-12">
                                <div class="footer_content">
                                    <div class="footer_heading footer_brand">
                                        Contact us
                                    </div>
                                    <ul class="footer_link">
                                        <li>
                                            <a href="#"><t t-esc="res_company.street"/><br/><t t-esc="res_company.street2"/></a>
                                        </li>
                                        <li>
                                            <a t-att-href="'tel:+' + res_company.phone"><t t-esc="res_company.phone"/></a>
                                        </li>
                                        <li>
                                            <a t-att-href="'mailto:' + res_company.email"><t t-esc="res_company.email"/></a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>