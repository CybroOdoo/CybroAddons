<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Portfolio website menu-->
    <record id="menu_portfolio" model="website.menu">
        <field name="name">Portfolio</field>
        <field name="url">/portfolio</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">31</field>
    </record>
    <!--    Portfolio page template  -->
    <template id="portfolio_page" name="Portfolio">
        <div id="wrap" class="oe_structure oe_empty o_editable">

        <!-- Removed <t t-call="website.layout"> wrapper here—content only! -->
        <section class="banner_sub banner_portfolio banner_service">
            <div class="container banner_content d-block">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/">Home</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Portfolio
                        </li>
                    </ol>
                </nav>
                <div class="row">
                    <div class="col-xl-5 col-lg-8 col-md-7 col-sm-8 col-12">
                        <div class="details">
                            <h3 class="banner_heading">Our Portfolio</h3>
                            <p>
                                Discover our exclusive collection of premium vehicles — a showcase of design excellence, unmatched performance, and innovative engineering that defines the future of driving.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Banner -->
        
        <!-- Portfolio Section -->
        <section class="portfolio">
            <div class="wrapper_p">
                <div class="portfolio_disc">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-7 col-md-6 col-12">
                                <div class="pd_left">
                                    <h1 class="pd_heading">
                                        Founded on passion, built on service, measured by
                                        <span>results</span>
                                    </h1>
                                    <p class="common_text">
                                        At Autofly, our journey began with a passion for cars and a commitment to delivering unmatched quality and service. Over the years, we’ve evolved into a trusted name in the automotive industry, offering a curated selection of high-performance and luxury vehicles. Our focus on innovation, design, and reliability ensures every car we present exceeds expectations.
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-5 col-md-6 col-12">
                                <div class="pd_right">
                                    <div class="year">
                                        <div class="yr">
                                            10+<br/>years
                                        </div>
                                        <p>
                                            Experience in<br/>Automotive Industry
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Our Garage Section -->
                <section class="car_garages future">
                    <div class="container">
                        <div class="common_p">
                            Future
                        </div>
                        <h5 class="common_heading">Our Garage</h5>
                        <div class="future_content">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="future_card">
                                        <a href="#">
                                            <div class="img_wrapper">
                                                <img src="/theme_autofly/static/src/assets/portfolio/image 11.png" alt="2024 Lamborghini Revuelto"/>
                                            </div>
                                            <p class="img_caption">2024 Lamborghini Revuelto</p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="future_card">
                                        <a href="#">
                                            <div class="img_wrapper">
                                                <img src="/theme_autofly/static/src/assets/portfolio/image 12.png" alt="2023 Novitec Ferrari 296 GTB"/>
                                            </div>
                                            <p class="img_caption">2023 Novitec Ferrari 296 GTB</p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="future_card">
                                        <a href="#">
                                            <div class="img_wrapper">
                                                <img src="/theme_autofly/static/src/assets/portfolio/image 13.png" alt="2024 Lamborghini Revuelto"/>
                                            </div>
                                            <p class="img_caption">2024 Lamborghini Revuelto</p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="future_card">
                                        <a href="#">
                                            <div class="img_wrapper">
                                                <img src="/theme_autofly/static/src/assets/portfolio/image 14.png" alt="2023 Porsche 911 Turbo S"/>
                                            </div>
                                            <p class="img_caption">2023 Porsche 911 Turbo S</p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="future_card">
                                        <a href="#">
                                            <div class="img_wrapper">
                                                <img src="/theme_autofly/static/src/assets/portfolio/image 15.png" alt="2024 McLaren Artura"/>
                                            </div>
                                            <p class="img_caption">2024 McLaren Artura</p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="future_card">
                                        <a href="#">
                                            <div class="img_wrapper">
                                                <img src="/theme_autofly/static/src/assets/portfolio/image 17.png" alt="2024 Aston Martin DB12"/>
                                            </div>
                                            <p class="img_caption">2024 Aston Martin DB12</p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="future_card">
                                        <a href="#">
                                            <div class="img_wrapper">
                                                <img src="/theme_autofly/static/src/assets/portfolio/image 18.png" alt="2024 BMW M8 Competition"/>
                                            </div>
                                            <p class="img_caption">2024 BMW M8 Competition</p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="future_card">
                                        <a href="#">
                                            <div class="img_wrapper">
                                                <img src="/theme_autofly/static/src/assets/portfolio/image 19.png" alt="2023 Mercedes AMG GT 63 S"/>
                                            </div>
                                            <p class="img_caption">2023 Mercedes AMG GT 63 S</p>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </section>
        </div>
        <!-- End of content -->
    </template>


    <template id="autofly_portfolio_page" name="Portfolio Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <t t-call="theme_autofly.portfolio_page"/>
            </div>
        </t>
    </template>
</odoo>