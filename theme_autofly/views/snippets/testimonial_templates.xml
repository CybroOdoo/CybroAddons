<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Testimonial snippet template -->
    <template id="client_testimonial" name="Client Testimonial">
        <section class="s_quotes_carousel_wrapper testimonial oe_structure pb-5" data-vxml="001" data-vcss="001">
            <t t-set="uniq" t-value="datetime.datetime.now().microsecond"/>
            <div t-attf-id="myQuoteCarousel{{uniq}}" 
                 class="s_quotes_carousel s_carousel_default carousel slide o_cc testimonial_carousel"
                 data-bs-interval="10000">
                <!-- Indicators -->
                <ol class="carousel-indicators">
                    <t t-set="testimonials" t-value="request.env['autofly.testimonial'].sudo().search([], order='id desc', limit=12)"/>
                    <t t-set="slide_count" t-value="(len(testimonials) + 2) // 3"/>
                    <t t-foreach="range(slide_count if slide_count > 0 else 1)" t-as="slide_index">
                        <li t-attf-data-bs-target="#myQuoteCarousel{{uniq}}" 
                            t-attf-data-bs-slide-to="{{slide_index}}"
                            t-attf-class="{{'' if slide_index else 'active'}}"/>
                    </t>
                </ol>
                
                <div class="carousel-inner wrapper">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="common_p">
                                    Why choose us
                                </div>
                                <h5 class="common_heading white_heading">
                                    Cheap prices with QUALITY CARS
                                </h5>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Check if testimonials exist -->
                    <t t-if="len(testimonials) > 0">
                        <!-- Generate slides dynamically -->
                        <t t-foreach="range(slide_count)" t-as="slide_num">
                            <div t-attf-class="carousel-item {{'' if slide_num else 'active'}} oe_img_bg o_bg_img_center pt80 pb80 slider_wrapper"
                                 data-name="Slide">
                                <div class="container owl-carousel" style="display:flex; overflow-x: hidden;">
                                    <!-- Get 3 testimonials for this slide -->
                                    <t t-set="slide_testimonials" t-value="testimonials[slide_num * 3:(slide_num + 1) * 3]"/>
                                    <t t-foreach="slide_testimonials" t-as="testimonial">
                                        <div class="col-12 col-sm-12 col-md-6 col-lg-4">
                                            <blockquote class="s_blockquote s_blockquote_classic blockquote mx-auto w-100 item"
                                                        data-name="Blockquote"
                                                        style="font-family: Inter sans-serif !important; font-style:normal;">
                                                <div class="item_wrapper">
                                                    <div class="media">
                                                        <img class="mr-3"
                                                             t-attf-src="/web/image/res.partner/#{testimonial.partner_id.id}/avatar_128"
                                                             alt=""/>
                                                        <div class="media-body">
                                                            <h5 class="mt-0">
                                                                <t t-esc="testimonial.partner_id.name"/>
                                                            </h5>
                                                            Customer
                                                        </div>
                                                    </div>
                                                    <p>
                                                        <t t-esc="testimonial.review"/>
                                                    </p>
                                                    <!-- UPDATED RATING SECTION -->
                                                    <div class="rating">
                                                        <span>
                                                            <t t-esc="testimonial.rating"/>.0
                                                        </span>
                                                        <ul>
                                                            <t t-foreach="range(int(testimonial.rating))" t-as="star">
                                                                <li>
                                                                    <a href="#">
                                                                        <img src="theme_autofly/static/src/assets/icons/Star.svg" alt=""/>
                                                                    </a>
                                                                </li>
                                                            </t>
                                                        </ul>
                                                    </div>
                                                    <!-- END RATING SECTION -->
                                                </div>
                                            </blockquote>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                    
                    <!-- Fallback if no testimonials -->
                    <t t-else="">
                        <div class="carousel-item active oe_img_bg o_bg_img_center pt80 pb80 slider_wrapper">
                            <div class="container">
                                <div class="alert alert-info text-center">
                                    <h4>No testimonials available. Please add testimonials in the backend.</h4>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                
                <!-- Controls -->
                <div class="carousel-control-prev o_not_editable"
                     t-attf-data-bs-target="#myQuoteCarousel{{uniq}}"
                     data-bs-slide="prev" role="img"
                     aria-label="Previous" title="Previous">
                    <span class="carousel-control-prev-icon"/>
                    <span class="visually-hidden">Previous</span>
                </div>
                <div class="carousel-control-next o_not_editable"
                     t-attf-data-bs-target="#myQuoteCarousel{{uniq}}"
                     data-bs-slide="next" role="img"
                     aria-label="Next" title="Next">
                    <span class="carousel-control-next-icon"/>
                    <span class="visually-hidden">Next</span>
                </div>
            </div>
        </section>

