<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="autofly_banner_snippet" inherit_id="website.snippets"
              name="Autofly banner">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]"
               position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="Autofly Banner" snippet-group="autofly_banner"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="Autofly Search" snippet-group="autofly_search"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="Partners" snippet-group="autofly_partners"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="Choose Us" snippet-group="choose_us"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="Client Testimonial" snippet-group="client_testimonial"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="Autofy Blog" snippet-group="autofly_blog"/>

        </xpath>
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]"
               position="after">

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="Find Car" snippet-group="find_car_snippet"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="View Service Products" snippet-group="view_service_product"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="View Garage" snippet-group="view_garage_page"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_autofly/static/description/img/banner-thumb.png" string="Popular Model" snippet-group="popular_modal"/>

        </xpath>

        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_autofly.banner" string="Autofly Banner" group="autofly_banner" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>
            <t t-snippet="theme_autofly.autofly_search" string="Autofly Snippet" group="autofly_search" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>
            <t t-snippet="theme_autofly.autofly_partners" string="Partners" group="autofly_partners" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>
            <t t-snippet="theme_autofly.choose_us" string="Choose Us" group="choose_us" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>
            <t t-snippet="theme_autofly.client_testimonial" string="Client Testimonial" group="client_testimonial" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>
            <t t-snippet="theme_autofly.autofly_blog" string="Autofly Blog" group="autofly_blog" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>
            <t t-snippet="theme_autofly.find_car_snippet" string="Find Car" group="find_car_snippet" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>
            <t t-snippet="theme_autofly.theme_autofly_service_product" string="View Services" group="view_service_product" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>
            <t t-snippet="theme_autofly.theme_autofly_car_garage_page" string="View Garage" group="view_garage_page" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>

            <t t-snippet="theme_autofly.product_tab_snippet" string="Popular Modal" group="popular_modal" t-thumbnail="/flynova/static/description/images/icons/about_banner.png"/>
        </xpath>
    </template>
</odoo>
