<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.minimal.backend.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="after">
                <div id="minimal_backend_theme">
                    <block title="Backend Theme" name="minimal_backend_theme_setting_container">
                        <setting id="minimal_theme_menu_layout" string="Menu Layout"
                                 help="Where app menus are shown: across the top bar, or in a sidebar on the left.">
                            <field name="minimal_theme_menu_layout" widget="radio" options="{'horizontal': true}" class="mt-2"/>
                        </setting>
                        <setting id="minimal_theme_dark_mode"
                                 help="Use the dark color scheme.">
                            <field name="minimal_theme_dark_mode"/>
                        </setting>
                        <setting id="minimal_theme_compact"
                                 help="Tighter rows and spacing in lists and forms.">
                            <field name="minimal_theme_compact"/>
                        </setting>
                        <setting id="minimal_theme_full_width"
                                 help="Forms use the whole screen width; on wide screens the chatter moves below the form.">
                            <field name="minimal_theme_full_width"/>
                        </setting>
                        <setting id="minimal_theme_search_model_ids" string="Record Search"
                                 help="Record types the top bar search finds, besides menus. Users only see records they have access to.">
                            <field name="minimal_theme_search_model_ids" widget="many2many_tags"
                                   options="{'no_create': True}" class="mt-2 w-100"
                                   placeholder="No record search"/>
                        </setting>
                    </block>
                    <div class="text-muted small px-3 pb-3">These options apply to all users, from their next page load. Administrators can also change them from Quick settings in the top bar.</div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
