<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Stock by location view in product.product model  -->
    <record id="product_product_normal_view_form" model="ir.ui.view">
        <field name="name">product.product.view.form.inherit.product.stock.details</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='inventory']" position="before">
                <separator string="Stock By Location"/>
                <button name="action_print_stock_details" type="object"
                        string="Print" class="btn btn-secondary my-2" icon="fa-print"/>
                <field name="product_stock_location_ids">
                    <list string="Stock By Location" edit="0" create="0" delete="0">
                        <field name="location_id"/>
                        <field name="available_quantity"/>
                        <field name="virtual_available"/>
                        <field name="incoming_qty"/>
                        <field name="outgoing_qty"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
