<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privilege used to group the login notification access group -->
    <record id="res_groups_privilege_login_notification"
            model="res.groups.privilege">
        <field name="name">Login Notification</field>
        <field name="sequence">100</field>
    </record>

    <!-- Receive login notification group -->
    <record id="receive_login_notification" model="res.groups">
        <field name="name">Receive Login Notification</field>
        <field name="privilege_id"
               ref="res_groups_privilege_login_notification"/>
    </record>
</odoo>
