<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide the Add to Cart button and quantity selector from public users -->
    <template id="product_hide" inherit_id="website_sale.cta_wrapper">
    <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="attributes">
        <attribute name="t-if">not request.env.user._is_public()</attribute>
    </xpath>
    <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
        <div class="alert alert-info" t-if="request.env.user._is_public()">
            <i class="fa fa-info-circle"/>
            <span>Please log in to see the buy options.</span>
        </div>
    </xpath>
    </template>
</odoo>
