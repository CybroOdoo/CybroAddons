<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--     It opens a window displaying the sales orders related to sample orders.-->
    <record id="sale_order_action" model="ir.actions.act_window">
        <field name="name">Sample Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['&amp;',('website_id', '!=',
            False),('is_sample_order','=',True)]
        </field>
        <field name="context">{'default_is_sample_order': True}</field>
    </record>
<!--    Added a new field in sale order-->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.website.sample.product.request</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']" position="after">
                <field name="is_sample_order"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="replace">
            <!-- Sample product: show if is_sample_order is True -->
            <field name="product_template_id"
                   string="Product"
                   domain="[('sale_ok', '=', True), ('is_sample_product', '=', True)]"
                   column_invisible="parent.is_sample_order == False"
                   context="{
                       'partner_id': parent.partner_id,
                       'quantity': product_uom_qty,
                       'pricelist': parent.pricelist_id,
                       'uom': product_uom,
                       'company_id': parent.company_id,
                       'default_list_price': price_unit,
                       'default_description_sale': name
                   }"
                   options="{'no_open': True}"
                   widget="sol_product_many2one"
                   placeholder="Type to find a sample product..."/>

            <!-- Regular product: show if is_sample_order is False -->
            <field name="product_template_id"
                   string="Product"
                   domain="[('sale_ok', '=', True), ('is_sample_product', '=', False)]"
                   column_invisible="parent.is_sample_order == True"
                   context="{
                       'partner_id': parent.partner_id,
                       'quantity': product_uom_qty,
                       'pricelist': parent.pricelist_id,
                       'uom': product_uom,
                       'company_id': parent.company_id,
                       'default_list_price': price_unit,
                       'default_description_sale': name
                   }"
                   options="{'no_open': True}"
                   widget="sol_product_many2one"
                   placeholder="Type to find a product..."/>
        </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="replace">
                        <field name="product_id"
                                            domain="[('sale_ok', '=', True), ('is_sample_product', '=', True)]"
                                            column_invisible="parent.is_sample_order == False"
                                            context="{'partner_id':parent.partner_id, 'quantity':product_uom_qty, 'pricelist':parent.pricelist_id, 'uom':product_uom, 'company_id': parent.company_id}"
                                            readonly="not product_updatable"
                                            required="not display_type"
                                            force_save="1"
                                            widget="many2one_barcode"/>
                        <field name="product_id"
                                            domain="[('sale_ok', '=', True), ('is_sample_product', '=', False)]"
                                            column_invisible="parent.is_sample_order == True"
                                            context="{'partner_id':parent.partner_id, 'quantity':product_uom_qty, 'pricelist':parent.pricelist_id, 'uom':product_uom, 'company_id': parent.company_id}"
                                            readonly="not product_updatable"
                                            required="not display_type"
                                            force_save="1"
                                            widget="many2one_barcode"/>
                </xpath>
        </field>
    </record>
</odoo>
