<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Light Theme -->
        <record id="dashboard_theme_light" model="dashboard.theme.group">
            <field name="name">Light</field>
            <field name="sequence">10</field>
            <field name="background_color">#F4F7F6</field>
            <field name="card_background_color">#FFFFFF</field>
            <field name="button_color">#2c4a6b</field>
            <field name="text_color">#333333</field>
            <field name="sidebar_toggle_color">#FFFFFF</field>
            <field name="navbar_color">#FFFFFF</field>
            <field name="dashboard_card_color">#FFFFFF</field>
            <field name="card_spacing">15</field>
        </record>


        <!-- Ocean Blue Theme -->
        <record id="dashboard_theme_ocean_blue" model="dashboard.theme.group">
            <field name="name">Ocean Blue</field>
            <field name="sequence">30</field>
            <field name="background_color">#E0F2F1</field>
            <field name="card_background_color">#FFFFFF</field>
            <field name="button_color">#00796B</field>
            <field name="text_color">#004D40</field>
            <field name="sidebar_toggle_color">#B2DFDB</field>
            <field name="navbar_color">#80CBC4</field>
            <field name="dashboard_card_color">#B2DFDB</field>
            <field name="card_spacing">20</field>
            <field name="is_gradient">True</field>
            <field name="gradient_color_1">#E0F2F1</field>
            <field name="gradient_color_2">#B2DFDB</field>
            <field name="gradient_degree">135</field>
        </record>

        <!-- Cyberpunk Theme -->
        <record id="dashboard_theme_cyberpunk" model="dashboard.theme.group">
            <field name="name">Cyberpunk</field>
            <field name="sequence">40</field>
            <field name="background_color">#050505</field>
            <field name="card_background_color">#0d0d0d</field>
            <field name="button_color">#00f3ff</field>
            <field name="text_color">#00f3ff</field>
            <field name="sidebar_toggle_color">#0d0d0d</field>
            <field name="navbar_color">#050505</field>
            <field name="dashboard_card_color">#0d0d0d</field>
            <field name="card_spacing">20</field>
        </record>
    </data>
</odoo>
