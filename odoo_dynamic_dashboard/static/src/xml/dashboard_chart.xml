<?xml version="1.0" encoding="utf-8"?>
<t t-name="DashboardChartTemplate" owl="1">

    <div class="grid-stack-item o_dynamic_dashboard_grid_item"
         t-att-gs-x="props.card.gs_x"
         t-att-gs-y="props.card.gs_y"
         t-att-gs-w="props.card.gs_w || 3" t-att-gs-h="props.card.gs_h || 2"
         t-att-id="props.card.id"
         t-att-style="props.style">

        <DashboardCardButtons
            card="props.card"
            dashboards="props.dashboards"
            colorGroups="props.colorGroups"
            t-if="props.dashboard"/>

        <div class="card h-100 grid-stack-item-content">
            <div class="dashboard-chart-component d-flex flex-column h-100 overflow-hidden">
                <div class="table-header-section px-3 pt-3">
                    <div class="header-text">
                        <h2 class="table-main-heading" t-if="props.card.name">
    <!--                        <i class="fa fa-chart-bar me-2"/>-->
                            <t t-esc="props.card.name"/>
                        </h2>

                        <p class="table-sub-heading" t-if="props.card.description">
                            <t t-esc="props.card.description"/>
                        </p>

                    </div>
                </div>

                <div class="flex-grow-1 position-relative" style="min-height: 0;">
                <t t-if="state.hasData">
                    <t t-if="!['funnel','radial','flower'].includes(props.card.chart_type)">
                        <div class="w-100 h-100 position-relative overflow-auto">
                            <div style="min-width: 250px; min-height: 220px; width: 100%; height: 100%;">
                                <canvas t-ref="ChartCanvas" class="chart_canvas p-2"/>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="w-100 h-100 position-relative overflow-auto">
                            <div style="min-width: 250px; min-height: 220px; width: 100%; height: 100%;">
                                <div t-ref="eChart" class="w-100 h-100"/>
                            </div>
                        </div>
                    </t>
                </t>

                 <!-- Empty State -->
                                <t t-else="">
                                    <div class="table-empty-state o_dashboard_empty_state" >
                                        <div class="empty-icon">
                                            <i class="fa fa-inbox fa-4x text-muted"/>
                                        </div>
                                        <h4 class="empty-title">No Records Found</h4>
                                        <p class="empty-message">
                                            There are no records matching the current filters.
                                        </p>
                                    </div>
                                </t>
<!--                <t t-else="">-->
<!--                    <div class="chart-empty-state">-->
<!--                        <div class="empty-icon">-->
<!--                            <i class="fa fa-inbox fa-4x text-muted"/>-->
<!--                        </div>-->
<!--                        <h4 class="empty-title">No Records Found</h4>-->
<!--                        <p class="empty-message">-->
<!--                            There are no records matching the current filters.-->
<!--                        </p>-->
<!--                    </div>-->
<!--                </t>-->
                </div>
            </div>

        </div>
    </div>

</t>
