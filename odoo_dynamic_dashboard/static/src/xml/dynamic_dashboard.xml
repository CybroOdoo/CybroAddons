<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="DynamicDashboardTemplate" owl="1">
        <div>
            <div class="ad_dashboard" t-if="dashboardId"
                 t-att-class="{'dark-mode': state.darkMode, 'ocean-breeze-mode': state.oceanBreezeMode, 'cyberpunk-mode': state.cyberpunkMode}">
                <!-- Unified single header -->
                <div class="dm-header" t-if="!state.GridEditMode">
                    <!-- Left: dashboard title -->
                    <div class="dm-header-left">
                        <t t-if="state.editMode">
                            <input type="text" class="dm-name-input" t-ref="nameInput"
                                   t-att-value="state.dashboard.dashboard_name || 'Dashboard'"/>
                            <i class="fa-solid fa-floppy-disk dm-hdr-icon" t-on-click="saveName" title="Save"/>
                            <i class="fa-solid fa-xmark dm-hdr-icon" t-on-click="cancelEdit" title="Discard"/>
                        </t>
                        <t t-else="">
                            <span class="dm-header-title" t-esc="state.dashboard.dashboard_name || 'Dashboard'"/>
                            <i class="fas fa-pen dm-hdr-icon" t-on-click="toggleEditMode" title="Edit Name"/>
                        </t>
                    </div>

                    <!-- Right: all actions in one row -->
                    <div class="dm-header-right">
                        <!-- Primary create actions -->
                        <button class="btn btn-primary-custom" t-on-click="onClickCreateBlockAI">
                            <t t-if="state.isLoading"><i class="fa fa-spinner fa-spin me-1"/>Generating…</t>
                            <t t-else=""><i class="fa fa-magic me-1"/>Generate</t>
                        </button>
                        <button class="btn btn-secondary-custom" t-on-click="onClickCreateBlock">
                            <i class="fa fa-plus me-1"/>Create New Block
                        </button>

                        <div class="dm-hdr-sep"/>

                        <!-- Dark mode toggle -->
                        <label class="premium-toggle" t-att-title="state.darkMode ? 'Light Mode' : 'Dark Mode'">
                            <input type="checkbox" t-on-change="toggleDarkMode" t-att-checked="state.darkMode"/>
                            <div class="toggle-track">
                                <div class="toggle-thumb">
                                    <i class="fas fa-sun sun-icon"/>
                                    <i class="fas fa-moon moon-icon"/>
                                </div>
                            </div>
                        </label>

                        <!-- Custom filter -->
                        <div class="dropdown">
                            <button class="btn btn-filter dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="fas fa-filter me-1"/>
                                <t t-esc="state.activeCustomFilter ? state.activeCustomFilter.name : 'Filter'"/>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li t-if="!state.customFilters or state.customFilters.length === 0">
                                    <span class="dropdown-item-text text-muted">No filters configured</span>
                                </li>
                                <t t-foreach="state.customFilters" t-as="filter" t-key="filter.id">
                                    <li>
                                        <a class="dropdown-item" href="#"
                                           t-on-click="() => this.applyBackendCustomFilter(filter)">
                                            <i class="fas fa-check me-2"
                                               t-if="state.activeCustomFilter and state.activeCustomFilter.id === filter.id"/>
                                            <i class="fas fa-filter me-2" t-else=""/>
                                            <t t-esc="filter.name"/>
                                        </a>
                                    </li>
                                </t>
                                <li t-if="state.customFilters and state.customFilters.length > 0 and state.activeCustomFilter">
                                    <hr class="dropdown-divider"/>
                                </li>
                                <li t-if="state.activeCustomFilter">
                                    <a class="dropdown-item text-danger" href="#"
                                       t-on-click="() => this.applyBackendCustomFilter(null)">
                                        <i class="fas fa-times me-2"/>Clear Filter
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Date filter -->
                        <div class="dropdown">
                            <button class="btn btn-filter dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="far fa-calendar-alt me-1"/>
                                <span t-esc="state.activeFilterLabel || 'Date'"/>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#" t-on-click="() => this.applyFilter('today')">Today</a></li>
                                <li><a class="dropdown-item" href="#" t-on-click="() => this.applyFilter('custom')">Custom Range</a></li>
                                <t t-if="state.advancedDateFilters and state.advancedDateFilters.length > 0">
                                    <li><hr class="dropdown-divider"/></li>
                                    <li class="dropdown-header text-muted px-3 py-1 small fw-bold text-uppercase">Advanced</li>
                                    <t t-foreach="state.advancedDateFilters" t-as="adv_filter" t-key="adv_filter.id">
                                        <li>
                                            <a class="dropdown-item" href="#"
                                               t-on-click="() => this.applyAdvancedFilter(adv_filter)">
                                                <i class="far fa-calendar-check me-2"/>
                                                <t t-esc="adv_filter.name"/>
                                            </a>
                                        </li>
                                    </t>
                                </t>
                                <li><hr class="dropdown-divider"/></li>
                                <li><a class="dropdown-item text-danger" href="#" t-on-click="() => this.applyFilter('all')"><i class="fas fa-times-circle me-2"/>Clear</a></li>
                            </ul>
                        </div>

                        <!-- Custom date range inputs -->
                        <div t-if="state.activeFilter === 'custom'" class="dm-date-range">
                            <input type="date" class="custom-date-input" t-model="state.customStartDate" t-on-change="onStartDateChange"/>
                            <span>–</span>
                            <input type="date" class="custom-date-input" t-model="state.customEndDate" t-on-change="onEndDateChange"/>
                        </div>

                        <div class="dm-hdr-sep"/>

                        <!-- Utility icon buttons -->
                        <button class="dm-hdr-icon-btn" title="Slideshow" t-on-click="onClickPlay"><i class="fas fa-play"/></button>
                        <button class="dm-hdr-icon-btn" title="Print" t-on-click="onClickPrint"><i class="fas fa-print"/></button>
                        <button class="dm-hdr-icon-btn" title="Send Mail" t-on-click="onClickSendMail"><i class="fas fa-envelope"/></button>

                        <!-- Settings dropdown -->
                        <div class="dropdown">
                            <button class="dm-hdr-icon-btn" data-bs-toggle="dropdown" title="More options"><i class="fas fa-ellipsis-v"/></button>
                            <ul class="dropdown-menu dropdown-menu-end dashboard-config-dropdown">
                                <li><a class="dropdown-item" href="#" t-on-click="onClickDashboardSettings"><i class="fas fa-cog me-2"/>Dashboard Settings</a></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li><a class="dropdown-item" href="#" t-on-click="onClickExportDashboard"><i class="fas fa-file-export me-2"/>Export</a></li>
                                <li><a class="dropdown-item" href="#" t-on-click="onClickImportDashboard"><i class="fas fa-file-import me-2"/>Import</a></li>
                                <li><a class="dropdown-item" href="#" t-on-click="onImportCard"><i class="fas fa-download me-2"/>Import Card</a></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li><a class="dropdown-item" href="#" t-on-click="onClickDuplicateDashboard"><i class="fas fa-copy me-2"/>Duplicate</a></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li><a class="dropdown-item" href="#" t-on-click="OnClickEdit"><i class="fas fa-pen me-2"/>Edit Layout</a></li>
                                <li><a class="dropdown-item" href="#" t-on-click="onFormatLayout"><i class="fas fa-refresh me-2"/>Format Layout</a></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item d-flex justify-content-between align-items-center theme-selection-item"
                                       href="#" t-on-click="onThemeClick">
                                        <span><i class="fas fa-palette me-2"/>Theme</span>
                                        <i t-attf-class="fas fa-chevron-left ms-2 #{state.showThemeSubmenu ? 'rotate-90' : ''}"/>
                                    </a>
                                    <ul t-attf-class="theme-custom-submenu #{state.showThemeSubmenu ? 'show' : ''}">
                                        <t t-if="state.themes and state.themes.length > 0">
                                            <t t-foreach="state.themes" t-as="theme" t-key="theme.id">
                                                <li class="submenu-item">
                                                    <a class="dropdown-item d-flex justify-content-between align-items-center"
                                                       href="#" t-on-click="() => this.selectTheme(theme.id)">
                                                        <t t-esc="theme.name"/>
                                                        <i class="fas fa-check text-success ms-2" t-if="state.theme_id === theme.id"/>
                                                    </a>
                                                </li>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <li class="submenu-item"><span class="dropdown-item text-muted">No themes found</span></li>
                                        </t>
                                    </ul>
                                </li>
                            </ul>
                        </div>

                        <!-- Hidden file inputs -->
                        <input type="file" t-ref="importCardInput" style="display:none" accept=".json" t-on-change="onFileChange"/>
                        <input type="file" t-ref="importDashboardInput" style="display:none" accept=".json" t-on-change="onDashboardFileChange"/>
                    </div>
                </div>

                <!-- Grid edit mode save/discard bar -->
                <div class="position-fixed top-0 end-0 m-3 mt-5" style="z-index: 1050;"
                     t-if="state.GridEditMode">
                    <div class="bg-white rounded-pill shadow-lg p-2 d-inline-flex gap-2">
                        <button class="btn btn-outline-success rounded-pill px-4 py-2" t-on-click="OnClickSave">
                            <i class="fas fa-save me-2"/>Save
                        </button>
                        <button class="btn btn-outline-danger rounded-pill px-4 py-2" t-on-click="cancelChanges">
                            <i class="fas fa-times me-2"/>Discard
                        </button>
                    </div>
                </div>
                <AiLoadingModal
                        visible="state.isLoading"
                        message="state.loadingMsg"
                        progress="state.progress"
                />
                <AiConfigModal
                    visible="state.showConfig"
                    models="state.availableModels"
                    onConfirm.bind="onConfigConfirm"
                    onCancel.bind="onConfigCancel"
                />
                <div t-if="state.cards.length === 0 and !state.isLoading" class="dm-empty-dashboard">
                    <div class="dm-empty-icon">
                        <i class="fas fa-th-large"/>
                    </div>
                    <h4>No blocks yet</h4>
                    <p>Click <strong>Generate</strong> to auto-create blocks with AI, or use <strong>Create New Block</strong> to build manually.</p>
                    <div class="dm-empty-actions">
                        <button class="btn btn-primary-custom" t-on-click="onClickCreateBlockAI">
                            <i class="fa fa-magic me-1"/> Generate with AI
                        </button>
                        <button class="btn btn-secondary-custom" t-on-click="onClickCreateBlock">
                            <i class="fa fa-plus me-1"/> Create New Block
                        </button>
                    </div>
                </div>

                <div class="grid-stack o_ad_dashboard" t-ref="gridStackContainer">
                    <DynamicDashboardCard t-foreach="state.cards" t-as="card" t-key="card.id"
                                          card="card" dashboards="state.dashboards"
                                          colorGroups="state.colorGroups" dashboard="true"
                                          activeFilter="state.activeFilter"
                                          customStartDate="state.customStartDate"
                                          customEndDate="state.customEndDate"
                                          customFilterDomain="state.activeBackendFilter ? state.activeBackendFilter.domain : false"
                                          customFilterModel="state.activeBackendFilter ? state.activeBackendFilter.model_id[0] : false"/>
                </div>

                <!-- Slideshow Overlay -->
                <div class="dashboard-slideshow-overlay" t-if="state.slideshowMode">
                    <div class="slideshow-header">
                        <h2 class="text-white mb-0" t-esc="state.dashboardName || 'Slideshow'"/>
                        <button class="btn btn-link text-white close-btn"
                                t-on-click="closeSlideshow">
                            <i class="fas fa-times fa-2x"/>
                        </button>
                    </div>

                    <div class="slideshow-content">
                        <button class="btn btn-link text-white nav-btn prev-btn"
                                t-on-click="prevSlide">
                            <i class="fas fa-chevron-left fa-3x"/>
                        </button>

                        <div class="slideshow-card-wrapper">
                            <t t-if="state.cards.length > 0">
                                <DynamicDashboardCard
                                        t-key="state.cards[state.currentSlideIndex].id"
                                        card="state.cards[state.currentSlideIndex]"

                                />
                            </t>
                        </div>

                        <button class="btn btn-link text-white nav-btn next-btn"
                                t-on-click="nextSlide">
                            <i class="fas fa-chevron-right fa-3x"/>
                        </button>
                    </div>

                    <div class="slideshow-controls">
                        <span class="text-white me-3">
                            <t t-esc="state.currentSlideIndex + 1"/>
                            /
                            <t t-esc="state.cards.length"/>
                        </span>
                        <button class="btn btn-outline-light rounded-pill px-4"
                                t-on-click="toggleAutoplay">
                            <i t-att-class="state.isAutoplay ? 'fas fa-pause' : 'fas fa-play'"/>
                            <span t-esc="state.isAutoplay ? ' Pause' : ' Play'"/>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>