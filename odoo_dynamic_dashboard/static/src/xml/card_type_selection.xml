<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_dynamic_dashboard.CardTypeSelection">
       <div class="selection-svg-widget-grid">
            <div t-foreach="options"
                 t-as="option"
                 t-key="option.value"
                 class="selection-svg-card"
                 t-att-class="{
                     'selected': isSelected(option.value),
                     'readonly': props.readonly
                 }"
                 t-on-click="() => this.selectOption(option.value)">
                <div class="selection-svg-card-icon">
                    <img t-att-src="getSvgPath(option.value)"
                         t-att-alt="option.label"/>
                </div>
                <div class="selection-svg-card-label" t-esc="option.label"/>
                <div class="selection-svg-card-indicator"
                     t-if="isSelected(option.value)"/>
            </div>
       </div>
    </t>
</templates>