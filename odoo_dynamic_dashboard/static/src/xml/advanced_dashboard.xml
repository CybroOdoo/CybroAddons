<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="AdvancedDashboardTemplate" owl="1">
        <div class="o_dashboard_list" t-if="state.allDashboards.length">
            <div class="container-fluid">
                <!-- Header Section -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="dashboard-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <h1 class="dashboard-list-title mb-2">My Dashboards</h1>
                                <p class="dashboard-list-subtitle text-muted mb-0">Manage and
                                    access all your dashboards
                                </p>
                            </div>
                            <button class="btn btn-primary" t-on-click="OnclickCreateDashboard">
                                <i class="fas fa-plus me-2"/>
                                Create New Dashboard
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Dashboard Cards Grid -->
                <div class="row g-4 pb-5">
                    <div class="col-12 col-md-6 col-lg-4" t-foreach="state.allDashboards"
                         t-as="dashboard" t-key="dashboard.id">
                        <div class="dashboard-card">
                            <div class="dashboard-card-header">
                                <div class="dashboard-icon"
                                    t-attf-style="background: linear-gradient({{dashboard.gradient_degree}}deg, {{dashboard.color_1}} 0%, {{dashboard.color_2}} 100%)">
                                    <i t-attf-class="fas {{dashboard.icon_class}}"/>
                                </div>
                                <div class="dashboard-actions">
                                    <button class="btn-icon" title="Edit" t-on-click="() => this.OnclickEditDashboard(dashboard.id)">
                                        <i class="fas fa-edit"/>
                                    </button>
                                    <button class="btn-icon" title="Delete" t-on-click="() => this.OnclickDeleteDashboard(dashboard.id, dashboard.menu_id)">
                                        <i class="fas fa-trash"/>
                                    </button>
                                </div>
                            </div>
                            <div class="dashboard-card-body">
                                <h3 class="dashboard-name" t-esc="dashboard.dashboard_name">Dashboard Name</h3>
                                <p class="dashboard-menu">Menu: <t t-esc="dashboard.menu_id[1]"/></p>
                                <p class="dashboard-description" t-esc="dashboard.description">Dashboard Description</p>
                            </div>
                            <div class="dashboard-card-footer">
                                <button class="btn btn-open-dashboard" t-on-click="() => this.OnclickOpenDashboard(dashboard.id)">
                                    <i class="fas fa-external-link-alt me-2"/>
                                    Open Dashboard
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="o_create_dashboard" t-else="">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-10 col-lg-8 col-xl-6">
                        <div class="empty-state-content">
                            <div class="empty-state-icon">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <h2 class="empty-state-title">No Dashboards Configured</h2>
                            <p class="empty-state-description">
                                You haven't created any dashboards yet. Get started by creating
                                your
                                first dashboard to visualize and analyze your data.
                            </p>
                            <button class="btn btn-primary" t-on-click="OnclickCreateDashboard">
                                <i class="fa fa-plus-circle me-2"/>
                                Create New Dashboard
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>