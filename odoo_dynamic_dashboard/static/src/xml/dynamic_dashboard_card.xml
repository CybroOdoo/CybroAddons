<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="DynamicDashboardCardTemplate" owl="1">
        <t t-if="state.card.type == 'block'">
            <DashboardTile card="state.card" dashboards="props.dashboards" colorGroups="props.colorGroups" dashboard="props.dashboard" />
        </t>
        <t t-elif="state.card.type == 'table'">
            <DashboardTable card="state.card" dashboards="props.dashboards"
                            colorGroups="props.colorGroups" dashboard="props.dashboard"
                            dateFilter="state.dateFilter"
                            customStartDate="props.customStartDate"
                            customEndDate="props.customEndDate"
                            customFilterDomain="props.customFilterDomain"
                            customFilterModel="props.customFilterModel"/>
        </t>
        <t t-elif="state.card.type == 'to-do'">
            <DashboardTodo card="state.card" dashboards="props.dashboards" colorGroups="props.colorGroups" dashboard="props.dashboard"/>
        </t>

        <t t-elif="state.card.type == 'views'">
    <DashboardView card="state.card" dashboards="props.dashboards"
                   colorGroups="props.colorGroups" dashboard="props.dashboard"
                   dateFilter="state.dateFilter"
                   customStartDate="props.customStartDate"
                   customEndDate="props.customEndDate"
                   customFilterDomain="props.customFilterDomain"
                   customFilterModel="props.customFilterModel"/>
</t>


        <t t-elif="state.card.type == 'activity'">
    <DashboardActivity card="state.card" dashboards="props.dashboards"
                   colorGroups="props.colorGroups" dashboard="props.dashboard"
                   dateFilter="state.dateFilter"
                   customStartDate="props.customStartDate"
                   customEndDate="props.customEndDate"
                   customFilterDomain="props.customFilterDomain"
                   customFilterModel="props.customFilterModel"/>
</t>
        



        <t t-else="">
            <DashboardChart card="state.card" dashboards="props.dashboards"
                            colorGroups="props.colorGroups" dashboard="props.dashboard"
                            dateFilter="state.dateFilter"
                            customStartDate="props.customStartDate"
                            customEndDate="props.customEndDate"
                            customFilterDomain="props.customFilterDomain"
                            customFilterModel="props.customFilterModel"/>
        </t>
    </t>
</templates>