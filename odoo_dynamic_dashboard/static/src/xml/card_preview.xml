<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="CardPreviewTemplate">
        <div class="o_dashboard_preview_container">
            <t t-if="state.card.type == 'block'">
                <PreviewTile card="state.card"/>
            </t>
            <t t-elif="state.card.type == 'chart'">
                <PreviewChart card="state.card"/>
            </t>
            <t t-elif="state.card.type == 'table'">
                <PreviewTable card="state.card"/>
            </t>
            <t t-elif="state.card.type == 'views'">
                <PreviewViews card="state.card" />
            </t>
            <t t-elif="state.card.type == 'to-do'">
                <PreviewTodo card="state.card" todos="state.todos" />
<!--                <div class="p-4 text-center">To Do List Preview</div>-->
            </t>

            <t t-elif="state.card.type == 'activity'">
                <PreviewActivity card="state.card" />
            </t>
        </div>
    </t>
</templates>