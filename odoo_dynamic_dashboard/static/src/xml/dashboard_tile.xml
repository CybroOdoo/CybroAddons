<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="DashboardTileTemplate" owl="1">
        <div class="grid-stack-item o_dynamic_dashboard_grid_item" t-att-gs-x="props.card.gs_x" t-att-gs-y="props.card.gs_y"
             t-att-gs-w="props.card.gs_w || 3" t-att-gs-h="props.card.gs_h || 2" t-att-id="props.card.id" t-att-style="props.style">
            <DashboardCardButtons card="props.card" dashboards="props.dashboards" colorGroups="props.colorGroups" t-if="props.dashboard"/>
            <div class="card h-100 grid-stack-item-content">
                <t t-if="props.card.icon_class">
                    <!-- With icon: flex layout driven by icon_layout -->
                    <div t-attf-class="card-body dashboard-card-layout dashboard-card-layout-{{props.card.icon_layout || 'top'}}">
                        <i t-attf-class="dashboard-card-icon dashboard-card-icon-{{props.card.icon_size || 'md'}} #{props.card.icon_class}"
                           t-attf-style="color: {{props.card.icon_color || '#6B7280'}};"/>
                        <div class="dashboard-card-content">
                            <h6 class="tile-label mb-2 text-uppercase fw-bold" t-esc="props.card.name">Label</h6>
                            <h2 class="tile-value mb-0 fw-bold" t-esc="props.card.block_value">0.00</h2>
                            <div class="tile-subtext mt-2 small opacity-75" t-if="props.card.measure_field_id">
                                <t t-esc="props.card.measure_field_id[1]"/>
                            </div>
                            <div class="tile-description mt-2 small opacity-75" t-if="props.card.description"
                                 t-esc="props.card.description"/>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <!-- No icon: original centered layout, unchanged -->
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">
                        <h6 class="tile-label mb-2 text-uppercase fw-bold" t-esc="props.card.name">Label</h6>
                        <h2 class="tile-value mb-0 fw-bold" t-esc="props.card.block_value">0.00</h2>
                        <div class="tile-subtext mt-2 small opacity-75" t-if="props.card.measure_field_id">
                            <t t-esc="props.card.measure_field_id[1]"/>
                        </div>
                        <div class="tile-description mt-2 small opacity-75" t-if="props.card.description"
                             t-esc="props.card.description"/>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>