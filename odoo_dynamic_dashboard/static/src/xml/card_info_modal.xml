<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="CardInfoModal" owl="1">
        <Dialog title="title" size="'md'" contentClass="contentClass">
            <div class="card-info-modal-body">

                <div class="ci-header">
                    <div class="ci-header-main">
                        <div class="ci-header-title" t-esc="card.name || 'Card'"/>
                        <div class="ci-header-meta">
                            <span class="ci-chip ci-chip-type text-capitalize" t-esc="card.type"/>
                            <span t-if="card.model_id" class="ci-chip ci-chip-model">
                                <i class="fa fa-cube"/>
                                <span t-esc="card.model_id[1]"/>
                            </span>
                        </div>
                    </div>
                </div>

                <div t-if="state.loading" class="ci-skeleton">
                    <div class="ci-skeleton-progress"/>
                    <div class="ci-skeleton-status">
                        <i class="fa fa-circle-o-notch fa-spin me-2"/>
                        <span>Analyzing card data…</span>
                    </div>
                    <div class="ci-skeleton-section">
                        <div class="ci-skeleton-heading"/>
                        <div class="ci-skeleton-line w-90"/>
                        <div class="ci-skeleton-line w-75"/>
                    </div>
                    <div class="ci-skeleton-section">
                        <div class="ci-skeleton-heading"/>
                        <div class="ci-skeleton-line w-85"/>
                        <div class="ci-skeleton-line w-65"/>
                        <div class="ci-skeleton-line w-80"/>
                    </div>
                    <div class="ci-skeleton-section">
                        <div class="ci-skeleton-heading"/>
                        <div class="ci-skeleton-line w-70"/>
                        <div class="ci-skeleton-line w-55"/>
                    </div>
                </div>

                <div t-elif="state.error" class="ci-error">
                    <div class="ci-error-icon">
                        <i class="fa fa-exclamation-circle"/>
                    </div>
                    <div class="ci-error-title">Couldn't analyze this card</div>
                    <div class="ci-error-text" t-esc="state.error"/>
                    <button class="btn btn-sm btn-outline-secondary mt-3" t-on-click="() => this.runAnalysis()">
                        <i class="fa fa-refresh me-1"/> Try again
                    </button>
                </div>

                <div t-else="" class="ci-result">
                    <t t-foreach="sections" t-as="section" t-key="section_index">
                        <div class="ci-section">
                            <div class="ci-section-head">
                                <i t-attf-class="fa #{sectionIcon(section.title)} ci-section-icon"/>
                                <span class="ci-section-title" t-esc="section.title"/>
                            </div>
                            <ul class="ci-bullets" t-if="section.body.some(l => isBullet(l))">
                                <t t-foreach="section.body" t-as="line" t-key="line_index">
                                    <li t-if="isBullet(line)" t-esc="cleanBullet(line)"/>
                                    <p t-else="" class="ci-para" t-esc="line"/>
                                </t>
                            </ul>
                            <t t-else="">
                                <p t-foreach="section.body" t-as="line" t-key="line_index"
                                   class="ci-para" t-esc="line"/>
                            </t>
                        </div>
                    </t>
                </div>

            </div>

            <t t-set-slot="footer">
                <button t-if="!state.loading and !state.error" class="btn btn-outline-secondary me-2"
                        t-on-click="() => this.runAnalysis()">
                    <i class="fa fa-refresh me-1"/> Refresh
                </button>
                <button class="btn btn-primary" t-on-click="() => this.props.close()">
                    Close
                </button>
            </t>
        </Dialog>
    </t>
</templates>
