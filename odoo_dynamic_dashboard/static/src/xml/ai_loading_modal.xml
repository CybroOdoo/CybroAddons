<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ai_loading_dashboard.AiLoadingModal">
        <div t-attf-class="ail-modal-overlay {{ props.visible ? 'ail-visible' : '' }}">
            <div class="ail-loading-card">

                <!-- Spinner + brain icon -->
                <div class="ail-icon-wrap">
                    <div class="ail-spinner-ring"/>
                    <div class="ail-brain"><i class="fa fa-magic"/></div>
                </div>

                <!-- Title -->
                <div class="ail-loading-title">AI is cooking…</div>

                <!-- Reactive status message -->
                <div class="ail-loading-sub" t-esc="props.message"/>

                <!-- Progress bar -->
                <div class="ail-bar-track">
                    <div
                        class="ail-bar-fill"
                        t-attf-style="width: {{ props.progress }}%"
                    />
                </div>

                <!-- Bouncing dots -->
                <div class="ail-dots">
                    <span/><span/><span/>
                </div>

            </div>
        </div>
    </t>

</templates>