<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_dynamic_dashboard.BlockAiAnalysisDialog">
        <Dialog size="'md'" title="this.title">
            <div class="o_dynamic_dashboard_ai_analysis d-flex flex-column gap-3">
                <div t-if="this.props.filterSummary" class="small text-muted">
                    <i class="oi me-1" data-icon="filter_alt"/>Analysis of the filtered data: <t t-out="this.props.filterSummary"/>
                </div>
                <div t-if="this.state.isLoading" class="d-flex flex-column align-items-center gap-2 text-muted py-4">
                    <i class="oi oi-spin oi-2x" data-icon="progress_activity"/>
                    <span>Analyzing the data of this block...</span>
                </div>
                <div t-elif="this.state.error" class="alert alert-warning mb-0 o_dynamic_dashboard_ai_analysis_error" role="alert">
                    <t t-out="this.state.error"/>
                </div>
                <t t-elif="this.state.analysis">
                    <t t-set="analysis" t-value="this.getAnalysis()"/>
                    <ul class="o_dynamic_dashboard_ai_analysis_points mb-0 ps-3 d-flex flex-column gap-2">
                        <li t-foreach="analysis.points" t-as="point" t-key="point_index" t-out="point"/>
                    </ul>
                    <div t-if="analysis.recommendation"
                         class="o_dynamic_dashboard_ai_analysis_recommendation d-flex gap-2 p-3 rounded">
                        <i class="oi oi-lg text-primary" data-icon="lightbulb"/>
                        <div>
                            <div class="fw-bold">Recommendation</div>
                            <div t-out="analysis.recommendation"/>
                        </div>
                    </div>
                    <div class="small text-muted">
                        Generated by AI from the figures of this block. Double-check before taking decisions.
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="() => this.props.close()">Close</button>
                <button class="btn btn-secondary o_dynamic_dashboard_ai_analysis_regenerate"
                        t-att-disabled="this.state.isLoading" t-on-click="() => this.analyze()">
                    <i class="oi me-1" data-icon="refresh"/>Regenerate
                </button>
                <button t-if="this.state.analysis and !this.state.isLoading" class="btn btn-secondary"
                        t-on-click="() => this.copy()">
                    <i class="oi me-1" data-icon="content_copy"/>Copy
                </button>
            </t>
        </Dialog>
    </t>

</templates>
