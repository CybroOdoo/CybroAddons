<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_dynamic_dashboard" model="res.groups.privilege">
        <field name="name">Dynamic Dashboard</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="odoo_dynamic_dashboard_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">User: Can build personal dashboards and view the shared ones.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dynamic_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="odoo_dynamic_dashboard_group_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator: Can manage every dashboard, shared or not.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dynamic_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('odoo_dynamic_dashboard_group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
