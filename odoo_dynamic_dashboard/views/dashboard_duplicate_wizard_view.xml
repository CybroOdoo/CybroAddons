<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="dashboard_duplicate_wizard_view_form" model="ir.ui.view">
        <field name="name">dashboard.duplicate.wizard.view.form</field>
        <field name="model">dashboard.duplicate.wizard</field>
        <field name="arch" type="xml">
            <form string="Duplicate Dashboard">
                <sheet>
                    <group>
                        <field name="dashboard_id" invisible="1"/>
                        <field name="new_name"/>
                        <field name="parent_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Duplicate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
