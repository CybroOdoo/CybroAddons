<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Group Form View -->
    <record id="view_dashboard_theme_group_form" model="ir.ui.view">
        <field name="name">dashboard.theme.group.form</field>
        <field name="model">dashboard.theme.group</field>
        <field name="arch" type="xml">
            <form string="Theme Group">
                <header>
                    <button name="action_analyse_from_company_logo"
                            string="Generate from Company Logo"
                            type="object"
                            class="btn-primary"
                            icon="fa-eyedropper"
                            confirm="This will extract the dominant colors from your company logo and overwrite this theme's color fields. Continue?"
                            help="Detect the dominant brand colors in your company logo and build a matching dashboard palette automatically"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Theme Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Configuration">
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
<!--                        <group string="Layout">-->
<!--                            <field name="card_spacing"/>-->
<!--                        </group>-->
                    </group>
                    <group>
                        <group string="Colors">
                            <field name="card_background_color" widget="color"/>
                            <field name="card_text_color" widget="color"/>
                            <field name="text_color" widget="color"/>
                            <field name="button_color" widget="color"/>
                            <field name="sidebar_toggle_color" widget="color"/>
                            <field name="navbar_color" widget="color"/>
                        </group>
                        <group string="Gradient Options" invisible="background_image">
<!--                            <field name="is_gradient"/>-->
                            <field name="gradient_color_1" widget="color"/>
                            <field name="gradient_color_2" widget="color"/>
                            <field name="gradient_degree"/>
                        </group>
                        <field name="is_default_theme" invisible="1"/>
                        <group string="Background Image" invisible="is_default_theme">
                            <field name="background_image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                            <field name="background_image_name" invisible="1"/>
                            <field name="background_size" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Theme Group Search View -->
    <record id="view_dashboard_theme_group_search" model="ir.ui.view">
        <field name="name">dashboard.theme.group.search</field>
        <field name="model">dashboard.theme.group</field>
        <field name="arch" type="xml">
            <search string="Search Theme">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Theme Group List View -->
    <record id="view_dashboard_theme_group_list" model="ir.ui.view">
        <field name="name">dashboard.theme.group.list</field>
        <field name="model">dashboard.theme.group</field>
        <field name="arch" type="xml">
            <list string="Theme Groups">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dashboard_theme_group" model="ir.actions.act_window">
        <field name="name">Theme Groups</field>
        <field name="res_model">dashboard.theme.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item under Configuration -->
    <menuitem id="menu_dashboard_theme_group"
              name="Theme Groups"
              parent="dashboard_menu_root"
              action="action_dashboard_theme_group"
              sequence="12"/>
</odoo>
