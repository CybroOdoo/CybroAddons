<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- List View -->
        <record id="dashboard_card_color_view_list" model="ir.ui.view">
            <field name="name">dashboard.card.color.list</field>
            <field name="model">dashboard.card.color</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color"/>
                    <field name="record_id"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
