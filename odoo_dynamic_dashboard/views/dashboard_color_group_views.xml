<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Color Group Form View -->
    <record id="view_dashboard_color_group_form" model="ir.ui.view">
        <field name="name">dashboard.color.group.form</field>
        <field name="model">dashboard.color.group</field>
        <field name="arch" type="xml">
            <form string="Color Group">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                    <notebook>
                        <page string="Colors">
                            <field name="color_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="hex_code" widget="color"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

     <!-- Color Group Tree View -->
    <record id="view_dashboard_color_group_list" model="ir.ui.view">
        <field name="name">dashboard.color.group.list</field>
        <field name="model">dashboard.color.group</field>
        <field name="arch" type="xml">
            <list string="Color Groups">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dashboard_color_group" model="ir.actions.act_window">
        <field name="name">Color Groups</field>
        <field name="res_model">dashboard.color.group</field>
        <field name="view_mode">list,form</field>
    </record>

        <!-- Menu Item -->
    <menuitem id="menu_dashboard_color_group"
              name="Color Groups"
              parent="dashboard_menu_root"
              action="action_dashboard_color_group"
              sequence="11"/>

</odoo>
