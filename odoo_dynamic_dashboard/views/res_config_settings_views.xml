<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="res_config_settings_view_form_dashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sentiment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Dynamic Ai Dashboard"
                     string="Dynamic Ai Dashboard"
                     name="odoo_dynamic_dashboard">
                    <block title="AI Configuration" name="dashboard_ai_settings">
                        <setting id="enable_external_ai"
                                 string="Use External AI services?">
                            <field name="enable_external_ai"/>
                        </setting>
                        <setting id="api_key"
                                 string="API Key"
                                 invisible="not enable_external_ai">
                            <div class="d-flex flex-column gap-2">
                                <field name="api_key" password="True"/>
                                <div class="mt-2">
                                    <button name="action_test_connection"
                                            type="object"
                                            string="Test Connection"
                                            class="btn btn-primary"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="ai_service_type"
                                 string="AI Service"
                                 invisible="not enable_external_ai">
                            <field name="ai_service_type"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_dashboard_res_config_settings"
            model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_dashboard"/>
        <field name="view_mode">form</field>
        <field name="context">
            {'module': 'odoo_dynamic_dashboard', 'bin_size': False }
        </field>
    </record>

    <menuitem id="customer_sentiment_settings_menu"
              name="Settings"
              parent="dashboard_menu_root"
              action="action_dashboard_res_config_settings"
              sequence="1"
    />

</odoo>
