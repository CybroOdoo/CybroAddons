<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_add_to_dashboard_wizard_form" model="ir.ui.view">
    <field name="name">add.to.dashboard.wizard.form</field>
    <field name="model">add.to.dashboard.wizard</field>
    <field name="arch" type="xml">
        <form string="Add to Dashboard">
            <group>
                <field name="card_name"/>
                <field name="dashboard_menu_id"/>
                <field name="res_model" invisible="1"/>
                <field name="view_type" invisible="1"/>
                <field name="domain" invisible="1"/>
            </group>
            <footer>
                <button name="action_add_to_dashboard" string="Add" type="object" class="btn-primary"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
</odoo>


