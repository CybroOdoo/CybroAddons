<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Extend web.NavBar to inject the liquid glass apps sidebar panel
        and its backdrop overlay.

        This sidebar is triggered by V20's built-in state
        `this.state.isAppMenuSidebarOpened` (used natively on mobile).
        On desktop the original Odoo apps grid (⊞) dropdown is preserved.

        OWL 2 rules:
          - Component properties require `this.` prefix.
          - t-on handlers must be arrow functions: () => this.method()
    -->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//header" position="after">

            <!-- Glass Sidebar Panel (mobile / small screen use) -->
            <div class="o_apps_sidebar"
                 t-att-class="{ 'o_sidebar_open': this.state.isAppMenuSidebarOpened }">
                <div class="o_sidebar_header mb-4 d-flex align-items-center justify-content-between">
                    <h3 class="m-0 fw-bold text-white"><t t-out="'Applications'"/></h3>
                    <button class="btn btn-link text-white p-0 o_sidebar_close"
                            t-on-click="() => this.closeSidebar()">
                        <i class="oi" data-icon="close"/>
                    </button>
                </div>
                <div class="o_sidebar_content">
                    <div class="row g-3">
                        <t t-foreach="this.menuService.getApps()" t-as="app" t-key="app.id">
                            <div class="col-6">
                                <a t-att-href="this.getMenuItemHref(app)"
                                   class="o_apps_sidebar_item d-flex flex-column align-items-center p-3 text-decoration-none"
                                   t-on-click.prevent="() => this.onNavBarAppClick(app)">
                                    <div class="o_app_icon_container mb-2">
                                        <img t-if="app.webIconData"
                                             t-att-src="app.webIconData"
                                             class="o_app_icon"
                                             style="width: 54px; height: 54px; object-fit: contain;"/>
                                        <div t-else=""
                                             class="o_app_icon_placeholder d-flex align-items-center justify-content-center">
                                            <i class="oi oi-2x" data-icon="apps"/>
                                        </div>
                                    </div>
                                    <span class="o_app_name text-center fw-medium text-white"
                                          t-esc="app.name"
                                          style="font-size: 13px;"/>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Backdrop overlay -->
            <div class="o_sidebar_overlay"
                 t-if="this.state.isAppMenuSidebarOpened"
                 t-on-click="() => this.closeSidebar()"
                 style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.3); backdrop-filter: blur(4px); z-index: 1040;"/>
        </xpath>
    </t>

    <!--
        NOTE: The web.NavBar.AppsMenu override has been intentionally removed.
        The original Odoo apps grid (⊞) button is preserved on desktop.
        On mobile, V20's built-in sidebar mechanism is used instead.
    -->

</templates>
