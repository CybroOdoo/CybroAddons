<?xml version="1.0" encoding="UTF-8" ?>
<!--Inherited the template ordersummary to add the field feedback in pos session-->
<templates id="template" xml:space="preserve">
    <t t-name="pos_customer_feedback.OrderSummary" t-inherit="point_of_sale.OrderSummary"
       t-inherit-mode="extension">
        <xpath expr="//OrderDisplay" position="after">
            <div class="customer-feedback-display mt-2">
                <span>Feedback:</span>
                <div class="stars-outer">
                      <div class="stars-inner"></div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
