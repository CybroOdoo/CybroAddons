<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_keyboard_shortcut.ShortcutPopup">
        <Dialog size="'md'" title="props.title or 'POS KEYBOARD SHORTCUTS'" header="true">
            <div class="table-container">
                <t t-set="shortcuts" t-value="this.pos.models['pos.keyboard.shortcut'].getAll()[0]" />
                <t t-if="shortcuts">
                    <!-- Product Screen Shortcuts -->
                    <div>
                        <p>Product Screen Shortcuts</p>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th><b>Key</b></th>
                                    <th><b>Description</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.customer_screen"/></td>
                                    <td>Customer Screen</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.select_discount"/></td>
                                    <td>Select Discount</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.select_price"/></td>
                                    <td>Select Price</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.select_qty"/></td>
                                    <td>Select Quantity</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.select_user"/></td>
                                    <td>Select User</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.close_pos"/></td>
                                    <td>Close Session</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.next_screen"/></td>
                                    <td>Payment Screen</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Payment Screen Shortcuts -->
                    <div>
                        <p>Payment Screen Shortcuts</p>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th><b>Key</b></th>
                                    <th><b>Description</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.select_invoice"/></td>
                                    <td>Select Invoice</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.validate_order"/></td>
                                    <td>Validate Order</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.resume_order"/></td>
                                    <td>Orders List (Resume)</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.back_screen"/></td>
                                    <td>Back</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Receipt Screen Shortcuts -->
                    <div>
                        <p>Receipt Screen Shortcuts</p>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th><b>Key</b></th>
                                    <th><b>Description</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.print_receipt"/></td>
                                    <td>Print Receipt</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.resume_order"/></td>
                                    <td>Resume Order / Orders List</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.sent_email"/></td>
                                    <td>Send Email</td>
                                </tr>
                                <tr>
                                    <td><t t-esc="shortcuts.next_screen_show"/></td>
                                    <td>Next Order</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- All Screen Shortcuts -->
                    <div>
                        <p>All Screen Shortcuts</p>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th><b>Key</b></th>
                                    <th><b>Description</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.click_cancel"/></td>
                                    <td>Cancel</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.click_ok"/></td>
                                    <td>Ok</td>
                                </tr>
                                <tr>
                                    <td>Ctrl + <t t-esc="shortcuts.select_user"/></td>
                                    <td>Select User</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary btn-lg" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
