<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
<t t-name="pos_keyboard_shortcut.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
    <xpath expr="//button[hasclass('more-btn')]" position="before">
        <t t-if="!props.showRemainingButtons &amp;&amp; this.pos.config.is_enable_keyboard_shortcuts">
            <button class="o_shortcut_button btn btn-light btn-lg lh-lg" t-on-click="() => this.clickShortcut()">
                <i class="fa fa-info-circle me-1" role="img" aria-label="Shortcuts" title="Shortcuts" />
                Shortcuts
            </button>
        </t>
    </xpath>
</t>
</templates>
