<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--  Project task view form -->
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">Project.task.view.form.inherit.project.resource</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="before">
                <field name="task_start_date" required="1"/>
                <field name="users_ids" invisible="1"/><!-- Required to filter free resources domain -->
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', users_ids)]</attribute>
                <attribute name="readonly">not task_start_date or not date_deadline</attribute>
                <attribute name="help">Please set the Start Date and Deadline first so that only free resources are shown as Assignees.</attribute>
            </xpath>
        </field>
    </record>
    <!-- Project task view list -->
    <record id="view_task_tree2_inherit_project_resource" model="ir.ui.view">
        <field name="name">project.task.view.list.inherit.project.resource</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="before">
                <field name="task_start_date" optional="show"/>
                <field name="users_ids" widget="many2many_tags" string="Free Resources" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', users_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
