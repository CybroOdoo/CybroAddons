<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_users_view_form" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.project.resource</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="project_allocated_ids" readonly="1"
                               clickable="0" style="pointer-events: none;"
                               mode="list" options="{'no_open': True}">
                            <list edit="0"
                                  style="pointer-events: none;">
                                <field name="name"/>
                                <field name="company_id" invisible="1"/>
                                <field name="project_id"/>
                                <field name="progress" widget="progressbar"
                                       style="width:100px;"/>
                                <field name="stage_id"/>
                                <field name="task_start_date"/>
                                <field name="date_deadline"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="res_users_view_list" model="ir.ui.view">
        <field name="name">res.users.view.list.inherit.project.resource</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>
