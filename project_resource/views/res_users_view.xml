<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    Display allocated project tasks in a read-only tab on the user form.-->
    <record id="res_users_view_form" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.project.resource</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Allocated Tasks" name="allocated_tasks">
                    <field name="project_allocated_ids" readonly="1"
                           options="{'no_open': True}">
                        <list edit="0">
                            <field name="name"/>
                            <field name="company_id" invisible="1"/><!-- Required for security rules -->
                            <field name="project_id"/>
                            <field name="stage_id"/>
                            <field name="task_start_date"/>
                            <field name="date_deadline"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
