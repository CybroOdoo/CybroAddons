<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view of Settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.automatic.payroll
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="hr_payroll_community.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='hr_payroll_community']"
                   position="inside">
                <block title="Automatic Payroll"
                       id="automatic_payroll_setting">
                    <setting id="automatic_payroll"
                             string="Automatic Payroll"
                             help="Automatic Generation of Payslips">
                        <field name="generate_payslip"/>
                        <div class="content-group"
                             invisible="not generate_payslip">
                            <div class="mt16">
                                <field name="option" class="o_light_label"
                                       widget="radio"
                                       required="generate_payslip"/>
                            </div>
                            <div class="text-muted"
                                 invisible="option in ['first', 'end']">
                                Note that each month has either 30 or 31 days,
                                except for February, which has 28 or 29 days.
                            </div>
                            <div class="mt8"
                                 invisible="option in ['first', 'end']">
                                <label for="generate_day" string="Day"/>
                                <field name="generate_day" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
