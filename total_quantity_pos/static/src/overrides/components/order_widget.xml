<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Extension for OrderDisplay Component -->
    <t t-name="total_quantity_pos.OrderDisplay"
       t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-summary')]" position="inside">
            <t t-if="this.order and (this.order.config_id?.pos_total_items or this.order.config?.pos_total_items)">
                <div class="fs-6 text-muted pt-1 mt-1">
                    <span>Item Count: </span>
                    <span class="value" t-out="this.itemCount"/>
                </div>
                <div class="fs-6 text-muted">
                    <span>Total Quantity: </span>
                    <span class="value" t-out="this.totalQuantity"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
