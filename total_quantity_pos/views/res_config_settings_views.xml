<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- PoS settings: screen toggle -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="total_items_setting" string="Total Items"
                         help="Show the total number of items and the total quantity of products in the POS screen.">
                    <field name="total_items"/>
                </setting>
            </xpath>
            <xpath expr="//block[@id='pos_bills_and_receipts_section']"
                   position="inside">
                <setting id="total_quantity_setting" string="Total Quantity"
                         help="Show the total number of items and the total quantity of products on the receipt.">
                    <field name="total_quantity"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
