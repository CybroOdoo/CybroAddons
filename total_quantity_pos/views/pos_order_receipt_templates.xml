<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template override for the POS Order Receipt -->
    <template id="pos_order_receipt_total_quantity" inherit_id="point_of_sale.pos_order_receipt">
        <xpath expr="//table[@name='total_item_count']" position="replace">
            <t t-if="config.get('pos_total_quantity') and extra_data['total_item_count']">
                <table class="w-100 text-large" name="total_item_count">
                    <tbody>
                        <tr>
                            <td class="text-start w-70">Total Items:</td>
                            <td class="text-end text-bold w-30 font-monospace" t-out="len(lines)"/>
                        </tr>
                        <tr>
                            <td class="text-start w-70">Total Quantity:</td>
                            <td class="text-end text-bold w-30 font-monospace" t-out="extra_data['total_item_count']"/>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
    </template>
</odoo>
