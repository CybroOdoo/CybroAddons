<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_web_map.MapController">
        <div t-att-class="props.className + ' h-100'" t-ref="root">
            <Layout className="'o_map_view h-100'" display="display">
                <t t-set-slot="layout-actions">
                    <SearchBar autofocus="firstLoad"/>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                <t t-component="searchBarToggler.component" t-props="searchBarToggler.props"/>
                </t>
                <t t-set-slot="control-panel-additional-actions">
                    <CogMenu/>
                </t>
                <t t-set-slot="control-panel-bottom-right">
                     <Pager t-props="pagerProps"/>
                </t>
                <MapRenderer records="model.records" metaData="model.metaData" archInfo="props.archInfo" openRecord.bind="openRecord"/>
            </Layout>
        </div>
    </t>

    <t t-name="odoo_web_map.MapRenderer">
        <div class="o_map_renderer h-100 w-100" t-ref="mapContainer">
            <!-- Leaflet map will be injected here -->
        </div>
    </t>

</templates>
