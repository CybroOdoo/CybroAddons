<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--       Map view of the model-->
    <record id="view_partner_map" model="ir.ui.view">
        <field name="name">res.partner.map.view</field>
        <field name="model">res.partner</field>
        <field name="type">map</field>
        <field name="arch" type="xml">
            <map>
                <field name="partner_latitude" string="Latitude"/>
                <field name="partner_longitude" string="Longitude"/>
                <field name="contact_address" string="Address"/>
            </map>
        </field>
    </record>

    <!--       Action of the inherited model-->
    <record id="base.action_partner_form" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,map</field>
    </record>
    
    <!--       Form view of the inherited model-->
    <record id="view_partner_form_geolocate" model="ir.ui.view">
        <field name="name">res.partner.form.geolocate.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                 <button name="action_geo_localize_nominatim" type="object"
                        class="oe_stat_button" icon="fa-map-marker"
                        string="Geolocate (Free)">
                </button>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="partner_latitude"/>
                <field name="partner_longitude"/>
                <field name="date_localization"/>
            </xpath>
        </field>
    </record>
</odoo>
