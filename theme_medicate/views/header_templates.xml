<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Theme Medicate: Header Templates Template -->
    <template id="menu_section" name="Menu Section" inherit_id="website.layout">
        <xpath expr="//header" position="replace">
            <header id="top" data-anchor="true" class="o_not_editable" style="position: sticky; top: 0; z-index: 1030; width: 100%; background-color: #024c80;">
                <section class="header-section w-100 float-left pt-3 pb-3 text-white">
                    <div class="container">
                        <div class="d-flex justify-content-between align-items-center flex-wrap">
                            
                            <div class="d-flex align-items-center flex-wrap">
                                <div class="call-section d-flex align-items-center">
                                    <img src="/theme_medicate/static/src/img/header-call-icon.png" alt="Call Icon"/>
                                    <span>+1800-001-658</span>
                                </div>
                                <div class="email-section d-flex align-items-center">
                                    <img src="/theme_medicate/static/src/img/header-email-icon.png" alt="Email Icon"/>
                                    <span>info@peacefulthemes.com</span>
                                </div>
                            </div>
                            
                            <div class="social-media-icons d-flex align-items-center">
                                <img src="/theme_medicate/static/src/img/header-insta-icon.png" alt="Instagram Icon"/>
                                <img src="/theme_medicate/static/src/img/header-fb-icon.png" alt="Facebook Icon"/>
                                <img src="/theme_medicate/static/src/img/header-tweet-icon.png" alt="Twitter Icon"/>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="menu-section w-100 o_not_editable" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1); background-color: #024c80;">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12">
                                <nav class="navbar navbar-expand-lg mt-2 mb-2 pr-0">
                                    <a class="navbar-brand" href="/">
                                        <img src="/theme_medicate/static/src/img/pharma-logo.png" alt="Pharma Logo"
                                             style="width: 160px;"/>
                                    </a>
                                    <button class="navbar-toggler" type="button" data-toggle="collapse"
                                            data-target="#navbarTogglerDemo02" aria-controls="navbarTogglerDemo02"
                                            aria-expanded="false" aria-label="Toggle navigation">
                                        <span class="navbar-toggler-icon" style="filter: invert(1);"/>
                                    </button>
                                    <div class="collapse navbar-collapse" id="navbarTogglerDemo02">
                                        <ul class="navbar-nav mt-lg-0 ml-auto">
                                            <!-- Dynamic website menu: renders all pages/menus from the backend -->
                                            <t t-foreach="website.menu_id.child_id" t-as="menu">
                                                <li t-attf-class="nav-item#{len(menu.child_id) > 0 and ' dropdown' or ''}">
                                                    <t t-if="len(menu.child_id) > 0">
                                                        <!-- Parent menu with children: render as dropdown -->
                                                        <a class="nav-link text-white text-uppercase font-weight-bold dropdown-toggle"
                                                           t-att-href="menu.url or '#'"
                                                           data-toggle="dropdown"
                                                           aria-haspopup="true"
                                                           aria-expanded="false"
                                                           t-out="menu.name"/>
                                                        <div class="dropdown-menu">
                                                            <t t-foreach="menu.child_id" t-as="child">
                                                                <a class="dropdown-item"
                                                                   t-att-href="child.url or '#'"
                                                                   t-out="child.name"/>
                                                            </t>
                                                        </div>
                                                    </t>
                                                    <t t-else="">
                                                        <!-- Leaf menu item -->
                                                        <a class="nav-link text-white text-uppercase font-weight-bold"
                                                           t-att-href="menu.url or '#'"
                                                           t-out="menu.name"/>
                                                    </t>
                                                </li>
                                            </t>
                                            <t t-call="portal.placeholder_user_sign_in">
                                                <t t-set="_item_class" t-valuef="nav-item"/>
                                                <t t-set="_link_class" t-valuef="nav-link text-white text-uppercase font-weight-bold"/>
                                            </t>
                                            <t t-call="portal.user_dropdown">
                                                <t t-set="_user_name" t-value="true"/>
                                                <t t-set="_icon" t-value="false"/>
                                                <t t-set="_avatar" t-value="false"/>
                                                <t t-set="_item_class" t-valuef="nav-item dropdown"/>
                                                <t t-set="_link_class" t-valuef="nav-link text-white text-uppercase font-weight-bold"/>
                                            </t>
                                        </ul>
                                        <div class="ml-lg-4 mt-3 mt-lg-0">
                                            <a href="/contactus" class="btn text-white text-uppercase font-weight-bold" style="background-color: #38bdf8; border-radius: 30px; padding: 10px 25px; font-size: 14px;">Book Appointment</a>
                                        </div>
                                    </div>
                                </nav>
                                
                                <script src="https://code.jquery.com/jquery-3.6.0.min.js"/>
                                
                                <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"/>
                            </div>
                        </div>
                    </div>
                </section>
            </header>
        </xpath>
    </template>
</odoo>
