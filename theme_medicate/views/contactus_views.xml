<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Theme Medicate: Contactus Views Template -->
    <template id="contactus_template" name="Contact us" inherit_id="website.contactus">
        <!-- Replace the entire #wrap so every section is a direct child of
             oe_structure oe_empty — the only structure Odoo's website editor
             recognises for selectable/deletable snippets. -->
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">

                <!-- Banner section -->
                <section class="o_colored_level s_contactus_banner sub-page-banner w-100 clearfix"
                         data-snippet="s_contactus_banner" data-name="Contact Us Banner">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="abouts-banner-content">
                                    <h3 class="text-white">Contact Us</h3>
                                    <p class="text-white">
                                        <a>Home</a>
                                        &gt; Contact Us
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Contact info cards section -->
                <section class="o_colored_level s_contactus_snippet section-contact-us mt-5 pt-5 w-100 clearfix"
                         data-snippet="s_contactus_snippet" data-name="Contact Info Cards">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="contact-us-container text-center">
                                    <img style="width: 54px;" class="mb-3"
                                         src="/theme_medicate/static/src/img/contact-us-location.png"/>
                                    <h3><b>Our Location</b></h3>
                                    <p>The Queen's Walk, Bishop's, London SE1 7PB, United Kingdom</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="contact-us-container text-center">
                                    <img style="width: 54px;" class="mb-3"
                                         src="/theme_medicate/static/src/img/contact-us-call.png"/>
                                    <h3><b>Our Contact</b></h3>
                                    <p>+ (567) 1234-567-8900<br/>+ (567) 1234-567-8901</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="contact-us-container text-center">
                                    <img style="width: 54px;" class="mb-3"
                                         src="/theme_medicate/static/src/img/contact-us-mail.png"/>
                                    <h3><b>Mail Us</b></h3>
                                    <p>info@peacefulthemes.com<br/>info2@peacefulthemes.com</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Get in Touch / Contact Form section -->
                <section class="o_colored_level s_contactus_snippet section-contact-us mt-5 pt-5 w-100 clearfix"
                         data-snippet="s_contactus_snippet" data-name="Get In Touch Form">
                    <div class="col-lg-12">
                        <div class="container-get-in-touch w-100 mt-5 pt-5 clearfix">
                            <h3 class="text-dark text-center font-weight-bold pb-3 pt-3">Get in Touch With Us</h3>
                            <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                <div class="contact-us-form-container p-5 w-100 clearfix">
                                    <form id="contactus_form"
                                          action="/website/form/"
                                          method="post"
                                          enctype="multipart/form-data"
                                          class="o_mark_required"
                                          data-mark="*"
                                          data-model_name="mail.mail"
                                          data-success-mode="redirect"
                                          data-success-page="/contactus-thank-you"
                                          data-pre-fill="true">
                                        <div class="row s_website_form_rows">
                                            <div class="mb-4 py-2 col-md-6 s_website_form_field s_website_form_custom s_website_form_required"
                                                 data-type="char" data-name="Field">
                                                <input type="text" placeholder="Enter your name" name="name" required="True"
                                                       style="background-color:#f5f6fa; border: none; outline: none; border-radius: 5px;"
                                                       class="w-100 p-3 form-control s_website_form_input" id="contact1"
                                                       data-fill-with="name"/>
                                            </div>
                                            <div class="mb-4 py-2 col-md-6 s_website_form_field s_website_form_custom s_website_form_required"
                                                 data-type="email" data-name="Field">
                                                <input type="email" placeholder="Enter your email"
                                                       style="background-color:#f5f6fa; border: none; outline: none; border-radius: 5px;"
                                                       class="w-100 p-3 form-control s_website_form_input"
                                                       name="email_from" required="True" data-fill-with="email"/>
                                            </div>
                                            <div class="mb-4 py-2 col-md-6 s_website_form_field s_website_form_custom"
                                                 data-type="char" data-name="Field">
                                                <input type="tel" placeholder="Enter your Phone Number"
                                                       style="background-color:#f5f6fa; border: none; outline: none; border-radius: 5px;"
                                                       class="w-100 p-3 form-control s_website_form_input" required="True"
                                                       id="phone-field"
                                                       pattern="[0-9]+"
                                                       title="Phone number must contain only digits"
                                                       oninput="this.value=this.value.replace(/[^0-9]/g,'');"
                                                       data-fill-with="phone" name="phone"/>
                                            </div>
                                            <div class="mb-4 py-2 col-md-6 s_website_form_field s_website_form_custom"
                                                 data-type="char" data-name="Field">
                                                <input type="text" placeholder="Subject"
                                                       style="background-color:#f5f6fa; border: none; outline: none; border-radius: 5px;"
                                                       class="w-100 p-3 form-control s_website_form_input" required="True"
                                                       name="subject"/>
                                            </div>
                                            <div class="d-none s_website_form_field s_website_form_dnone">
                                                <input id="contact7" type="hidden"
                                                       class="form-control s_website_form_input"
                                                       name="email_to"/>
                                            </div>
                                            <div class="mb-4 py-2 col-12 s_website_form_field s_website_form_custom"
                                                 data-type="text" data-name="Field">
                                                <textarea name="description" rows="5"
                                                          placeholder="Write your message"
                                                          style="background-color:#f5f6fa; border: none; outline: none; border-radius: 5px; resize: vertical;"
                                                          class="w-100 p-3 form-control s_website_form_input"/>
                                            </div>
                                            <div class="col-12 py-3 container-send-message-btn">
                                                <a href="#" class="btn btn-primary s_website_form_send text-white text-uppercase font-weight-bold px-4 py-2"
                                                   style="background-color: #38bdf8; border: none; border-radius: 5px;">
                                                    Send message
                                                </a>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </section>
                        </div>
                    </div>
                </section>

                <!-- Map section — direct child of oe_structure so the editor shows the delete handle -->
                <section class="o_colored_level s_contactus_map section-map w-100 clearfix"
                         data-snippet="s_contactus_map" data-name="Map">
                    <div class="google_map" style="width: 100%;height: 500px;">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15658.881983874671!2d75.87971722644363!3d11.134181973268767!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba651d1fb20b40b%3A0xd15c44b13dfe431c!2sThenhipalam%2C%20Kerala!5e0!3m2!1sen!2sin!4v1598930664895!5m2!1sen!2sin"
                                frameborder="0"
                                style="border:0;width: 100%; height: 100%;"
                                allowfullscreen="" aria-hidden="false" tabindex="0"/>
                    </div>
                </section>

            </div>
        </xpath>
    </template>
</odoo>
