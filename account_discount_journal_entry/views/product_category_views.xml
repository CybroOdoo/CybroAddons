<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_view_form" model="ir.ui.view">
        <field name="name">product.category.form.view.inherit.account.journal.discount</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="account.view_category_property_form"/>
        <field name="arch" type="xml">
            <group name="properties" position="after">
                <group string="Account Journal Properties"
                       name="journal_discount_property">
                    <field name="vendor_account_discount_id"/>
                    <field name="customer_account_discount_id"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
