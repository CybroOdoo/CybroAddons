<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="prebook_address" name="Website Pre-booking Guest Details">
        <t t-call="website.layout">
            <main class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-8 col-lg-6">
                        <h1 class="h3 mb-4">Your details</h1>
                        <form action="/prebook/address" method="post">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="product_id"
                                   t-att-value="product_id"/>
                            <input type="hidden" name="quantity"
                                   t-att-value="quantity"/>
                            <div class="mb-3">
                                <label class="form-label" for="prebook_name">Name</label>
                                <input id="prebook_name" class="form-control" type="text"
                                       name="name" required="required" autocomplete="name"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="prebook_email">Email</label>
                                <input id="prebook_email" class="form-control" type="email"
                                       name="email" required="required" autocomplete="email"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="prebook_phone">Phone</label>
                                <input id="prebook_phone" class="form-control" type="tel"
                                       name="phone" autocomplete="tel"/>
                            </div>
                            <button class="btn btn-primary" type="submit">Place pre-booking</button>
                        </form>
                    </div>
                </div>
            </main>
        </t>
    </template>

    <template id="pre_booking_done" name="Website Pre-booking Confirmation">
        <t t-call="website.layout">
            <main class="container text-center py-5">
                <h1 class="h3">Your pre-booking was created.</h1>
                <p t-if="ref" class="lead">Reference: <strong t-out="ref"/></p>
                <a class="btn btn-primary" href="/shop">Continue shopping</a>
                <a class="btn btn-outline-primary ms-2" href="/my/prebookings">
                    Track a booking
                </a>
                <a t-if="not request.env.website.is_public_user()"
                   class="btn btn-outline-primary ms-2" href="/my/pre_bookings">
                    View my pre-bookings
                </a>
            </main>
        </t>
    </template>

    <template id="pre_booking_failed" name="Website Pre-booking Unavailable">
        <t t-call="website.layout">
            <main class="container text-center py-5">
                <h1 class="h3">This quantity is no longer available for pre-booking.</h1>
                <a class="btn btn-primary mt-3" href="/shop">Return to the shop</a>
            </main>
        </t>
    </template>
</odoo>
