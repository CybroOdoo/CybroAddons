<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="product_quantity" inherit_id="website_sale.product" name="Website Pre-booking Button">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="before">
            <button t-if="product._is_pre_booking_available()" type="button"
                    class="btn btn-primary pre_booking mb-3"
                    t-att-data-url="'/my/prebook_request/%s' % slug(product)"
                    t-att-data-quantity="product.pre_max_quantity"
                    t-att-data-csrf-token="request.csrf_token()">
                Pre-book
            </button>
        </xpath>
    </template>
</odoo>
