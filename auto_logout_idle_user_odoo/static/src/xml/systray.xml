<?xml version="1.0" encoding="UTF-8" ?>
<!--adding new icon in the systray bar for displaying the idle time of user-->
<templates>
    <t t-name="auto_logout_idle_user_odoo.TimerSystray">
        <div class="o_idle_timer_systray" t-if="this.state.idle_time" title="Session Idle Timeout">
            <div class="o_idle_timer">
                <i class="fa fa-clock-o systray-icon" />
                <p style="margin: unset;" t-out="this.state.idle_time"/>
            </div>
        </div>
    </t>
</templates>


