<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="advanced_json_widget.JsonWidget">
        <div class="o_field_json position-relative d-inline-flex flex-wrap w-100"
             t-att-class="{'o_tags_input o_input': !this.props.readonly}"
             t-ref="this.jsonWidget"
             t-on-keydown="this.onWidgetKeydown">
            <div class="d-flex flex-wrap gap-1 align-items-center w-100 p-1 cursor-pointer"
                 t-on-click="this.openJsonEditor">
                <t t-foreach="this.jsonSummaryTags()" t-as="tag" t-key="tag.id">
                    <span t-att-class="'badge rounded-pill me-1 o_json_tag_badge o_tag_color_' + tag.colorIndex"
                          t-on-click.stop="tag.onClick">
                        <t t-esc="tag.text"/>
                    </span>
                </t>
                <t t-if="!this.state.entries or !this.state.entries.length">
                    <span class="text-muted ps-1">Click to add data</span>
                </t>
            </div>

            <!-- Popover JSON Editor -->
            <div class="json_widget_popup dropdown-menu o-dropdown--menu show rounded bg-white p-3 shadow position-absolute top-100 start-0 mt-1"
                 t-if="this.state.showDropdown"
                 t-ref="this.jsonDropdown">
                <div class="popover-header bg-white border-0 p-0 mb-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="fw-bold text-dark fs-5 mb-0">
                            JSON Data Editor
                        </div>
                        <button class="btn btn-link p-0 border-0 shadow-none text-decoration-none d-flex align-items-center justify-content-center o_btn_icon"
                                type="button"
                                t-on-click.stop="this.closeJsonEditor"
                                title="Close">
                            <svg width="18" height="18" viewBox="0 0 16 16" class="o_close_icon" xmlns="http://www.w3.org/2000/svg">
                                <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854z"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="table-container">
                    <table class="o_list_table table table-sm o_json_table mb-0 align-middle">
                        <colgroup>
                            <col class="col_key"/>
                            <col class="col_val"/>
                            <col class="col_action"/>
                        </colgroup>
                        <thead>
                            <tr class="border-bottom">
                                <th class="fw-bold text-dark border-0 pb-2 ps-1">Key</th>
                                <th class="fw-bold text-dark border-0 pb-2 ps-1">Value</th>
                                <th class="border-0 pb-2" aria-hidden="true"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="this.state.entries">
                                <tr t-foreach="this.state.entries"
                                    t-as="entry"
                                    t-key="entry.id"
                                    class="border-bottom">
                                    <td class="align-middle entry-key py-2 ps-1">
                                        <input type="text"
                                               class="form-control form-control-sm border-0 bg-transparent p-0 shadow-none text-dark fw-normal"
                                               t-att-value="entry.key"
                                               placeholder="Key"
                                               t-on-input="(ev) => this.onKeyInput(ev, entry)"/>
                                    </td>
                                    <td class="align-middle py-2 ps-1">
                                        <input type="text"
                                               class="form-control form-control-sm border-0 bg-transparent p-0 shadow-none text-dark fw-normal"
                                               t-att-value="entry.value"
                                               placeholder="Value"
                                               t-on-input="(ev) => this.onValueInput(ev, entry)"/>
                                    </td>
                                    <td class="align-middle text-end py-2 pe-1">
                                        <button class="btn btn-link p-0 border-0 shadow-none text-muted d-inline-flex align-items-center justify-content-center o_btn_icon"
                                                type="button"
                                                t-on-click.stop="() => this.deleteLine(entry)"
                                                title="Delete">
                                            <svg width="16" height="16" viewBox="0 0 16 16" class="o_delete_icon" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="!this.props.readonly">
                                <td colspan="3" class="pt-3 ps-1 border-0">
                                    <button class="btn btn-link p-0 border-0 text-decoration-none fw-bold o_btn_add_line"
                                            type="button"
                                            t-on-click.stop="() => this.addLine()"
                                            t-ref="this.addLineButton">
                                        Add a Line
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
