<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Information user group for regular internal collaborators. -->
    <record id="group_info_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">
            Can read workspace and shared articles, create and edit articles in
            workspaces they belong to, and manage their own content.
            Cannot create or delete workspaces.
        </field>
    </record>

    <!-- Information administrator group with complete module control. -->
    <record id="group_info_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('group_info_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">
            Full control over the info base. Can create, modify, and
            delete workspaces, manage all articles regardless of membership,
            and configure security settings.
        </field>
    </record>

    <!-- Shared-user group for users granted access to specific articles. -->
    <record id="group_info_shared_user" model="res.groups">
        <field name="name">Shared User</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="comment">
            Portal users with shared access to specific articles.
        </field>
    </record>

    <!-- Rule 1: Admins see and edit everything -->
    <record id="rule_info_article_admin" model="ir.rule">
        <field name="name">Information Article: Administrator Access</field>
        <field name="model_id" ref="model_info_hub_article"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_info_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Rule 2: Information Article: Read Access for Users -->
    <record id="rule_info_article_read_user" model="ir.rule">
        <field name="name">Information Article: Read Access</field>
        <field name="model_id" ref="model_info_hub_article"/>
        <field name="domain_force">[
            '|',
            ('create_uid', '=', user.id),
            '|',
            '&amp;',
            ('member_ids.partner_id', '=', user.partner_id.id),
            ('member_ids.permission', 'in', ['read', 'edit']),
            '&amp;',
            ('category', '!=', 'private'),
            '&amp;',
            ('visibility', '=', 'everyone'),
            '&amp;',
            ('default_access', 'in', ['read', 'edit']),
            ('id', 'not in', user._get_member_article_ids())
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule 3: Information Article: Write Access for Users -->
    <record id="rule_info_article_write_user" model="ir.rule">
        <field name="name">Information Article: Write Access</field>
        <field name="model_id" ref="model_info_hub_article"/>
        <field name="domain_force">[
            '|',
            ('create_uid', '=', user.id),
            '|','&amp;',
            ('member_ids.partner_id', '=', user.partner_id.id),
            ('member_ids.permission', '=', 'edit'),
            '&amp;',
            ('category', '!=', 'private'),
            '&amp;',
            ('visibility', '=', 'everyone'),
            '&amp;',
            ('default_access', '=', 'edit'),
            ('id', 'not in', user._get_member_article_ids())
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule for Member Access: Admins -->
    <record id="rule_info_article_member_admin" model="ir.rule">
        <field name="name">Information Article Member: Administrator Access</field>
        <field name="model_id" ref="model_info_hub_article_member"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_info_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Rule for Member Access: Users -->
    <record id="rule_info_article_member_user" model="ir.rule">
        <field name="name">Information Article Member: User Access</field>
        <field name="model_id" ref="model_info_hub_article_member"/>
        <field name="domain_force">[
            '|',
            ('article_id.create_uid', '=', user.id),
            '|','&amp;',
            ('article_id.member_ids.partner_id', '=', user.partner_id.id),
            ('article_id.member_ids.permission', '=', 'edit'),
            ('partner_id', '=', user.partner_id.id)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>



    <!-- Rule 6: Portal Users Article Read Access -->
    <record id="rule_info_article_portal_read" model="ir.rule">
        <field name="name">Information Article: Portal Read Access</field>
        <field name="model_id" ref="model_info_hub_article"/>
        <field name="domain_force">[
            '|',
            ('create_uid', '=', user.id),
            '|','&amp;',
            ('member_ids.partner_id', '=', user.partner_id.id),
            ('member_ids.permission', 'in', ['read', 'edit']),
            '&amp;',
            ('category', '!=', 'private'),
            '&amp;',
            ('visibility', '=', 'everyone'),
            '&amp;',
            ('is_published', '=', True),
            '&amp;',
            ('default_access', 'in', ['read', 'edit']),
            ('id', 'not in', user._get_member_article_ids())
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule 6b: Portal Users Article Write Access -->
    <record id="rule_info_article_portal_write" model="ir.rule">
        <field name="name">Information Article: Portal Write Access</field>
        <field name="model_id" ref="model_info_hub_article"/>
        <field name="domain_force">[
            '|',
            ('create_uid', '=', user.id),
            '&amp;',
            ('member_ids.partner_id', '=', user.partner_id.id),
            ('member_ids.permission', '=', 'edit')
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Rule 7: Portal Users Article Member Access -->
    <record id="rule_info_article_member_portal" model="ir.rule">
        <field name="name">Information Article Member: Portal Access</field>
        <field name="model_id" ref="model_info_hub_article_member"/>
        <field name="domain_force">[
            '|',
            ('article_id.create_uid', '=', user.id),
            ('partner_id', '=', user.partner_id.id)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Rule 8: Shared User Article Visibility -->
    <record id="info_article_shared_rule" model="ir.rule">
        <field name="name">Information Article: Shared User Access</field>
        <field name="model_id" ref="model_info_hub_article"/>
        <field name="domain_force">[
            '|',
            ('create_uid', '=', user.id),
            '|','&amp;',
            ('member_ids.partner_id', '=', user.partner_id.id),
            ('member_ids.permission', 'in', ['read', 'edit']),
            '&amp;',
            ('category', '!=', 'private'),
            '&amp;',
            ('visibility', '=', 'everyone'),
            '&amp;',
            ('is_published', '=', True),
            '&amp;',
            ('default_access', 'in', ['read', 'edit']),
            ('id', 'not in', user._get_member_article_ids())
        ]</field>
        <field name="groups" eval="[(4, ref('group_info_shared_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule 8b: Shared User Article Write Access -->
    <record id="info_article_shared_write_rule" model="ir.rule">
        <field name="name">Information Article: Shared User Write Access</field>
        <field name="model_id" ref="model_info_hub_article"/>
        <field name="domain_force">[
            '|',
            ('create_uid', '=', user.id),
            '&amp;',
            ('member_ids.partner_id', '=', user.partner_id.id),
            ('member_ids.permission', '=', 'edit')
        ]</field>
        <field name="groups" eval="[(4, ref('group_info_shared_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Rule 9: Published Articles Read Access (Allows reading any published article regardless of category) -->
    <record id="rule_info_article_published_read" model="ir.rule">
        <field name="name">Information Article: Published Read Access</field>
        <field name="model_id" ref="model_info_hub_article"/>
        <field name="domain_force">[('is_published', '=', True)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_portal'), ref('group_info_shared_user'), ref('base.group_user')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule 10: Published Articles Write Access for Internal Users -->
    <record id="rule_info_article_published_write" model="ir.rule">
        <field name="name">Information Article: Published Write Access</field>
        <field name="model_id" ref="model_info_hub_article"/>
        <field name="domain_force">[('is_published', '=', True), ('default_access', '=', 'edit')]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
        
</odoo>
