<?xml version="1.0" encoding="utf-8"?>
<!--
    Predefined template categories and default starter template articles (Business, Operations,
    Human Resources, Guides, Meeting Notes, Project Kickoff, etc.).
-->
<odoo>
    <data noupdate="1">

        <!-- TEMPLATE CATEGORIES                                                -->
        <record id="template_cat_business" model="info.hub.template.category">
            <field name="name">Business</field>
            <field name="sequence">10</field>
            <field name="icon">💼</field>
        </record>

        <record id="template_cat_operations" model="info.hub.template.category">
            <field name="name">Operations</field>
            <field name="sequence">20</field>
            <field name="icon">⚙️</field>
        </record>

        <record id="template_cat_hr" model="info.hub.template.category">
            <field name="name">Human Resources</field>
            <field name="sequence">30</field>
            <field name="icon">👥</field>
        </record>

        <record id="template_cat_guides" model="info.hub.template.category">
            <field name="name">Guides</field>
            <field name="sequence">40</field>
            <field name="icon">💡</field>
        </record>

        <!-- TEMPLATE ARTICLES                                                  -->

        <!-- 1. Meeting Notes -->
        <record id="template_meeting_notes" model="info.hub.article">
            <field name="name">Meeting Notes</field>
            <field name="icon">📝</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_business"/>
            <field name="template_description">Capture meeting agenda, decisions, notes, and action items.</field>
            <field name="template_sequence">10</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Date: [Date] | Facilitator: [Name] | Attendees: [Names]</p>
                <hr/>
                <h3>🎯 Agenda</h3>
                <ul>
                    <li><strong>Topic 1:</strong> Brief description and notes.</li>
                    <li><strong>Topic 2:</strong> Brief description and notes.</li>
                </ul>
                <h3>💡 Discussion Summary</h3>
                <p>Summarise key discussion points and alignment items here...</p>
                <h3>✅ Action Items</h3>
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Task</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Owner</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Due Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Action Item 1]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Owner]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Date]</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Action Item 2]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Owner]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Date]</td>
                        </tr>
                    </tbody>
                </table>
            ]]></field>
        </record>

        <!-- 2. SOP -->
        <record id="template_sop" model="info.hub.article">
            <field name="name">Standard Operating Procedure (SOP)</field>
            <field name="icon">📋</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_operations"/>
            <field name="template_description">Document a step-by-step process for operations and activities.</field>
            <field name="template_sequence">10</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Department: Operations | Version: 1.0 | Owner: [Name]</p>
                <hr/>
                <h3>🔍 Purpose</h3>
                <p>Explain the goal of this procedure and why it is important to the team or organisation.</p>
                <h3>🛡️ Scope</h3>
                <p>Define who and what this procedure applies to, and any exceptions.</p>
                <h3>👣 Step-by-Step Instructions</h3>
                <ol>
                    <li><strong>Preparation:</strong> Gather all necessary information, permissions, and tooling.</li>
                    <li><strong>Execution:</strong> Perform the primary steps of the procedure sequentially.</li>
                    <li><strong>Review:</strong> Verify the outputs meet quality standards and log completion.</li>
                </ol>
                <h3>⚠️ Troubleshooting</h3>
                <p>Common edge cases and how to handle them successfully.</p>
            ]]></field>
        </record>

        <!-- 3. How-To Guide -->
        <record id="template_howto" model="info.hub.article">
            <field name="name">How-To Guide</field>
            <field name="icon">💡</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_guides"/>
            <field name="template_description">Create a clear, educational tutorial or walk-through.</field>
            <field name="template_sequence">10</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Difficulty: Beginner | Est. Time: 15 mins</p>
                <hr/>
                <h3>🌟 Overview</h3>
                <p>A brief summary of what this guide will help you accomplish and what you will learn.</p>
                <h3>🛠️ Prerequisites</h3>
                <ul>
                    <li>Prerequisite item 1</li>
                    <li>Prerequisite item 2</li>
                </ul>
                <h3>📚 Instructions</h3>
                <h4>Step 1: Initial Setup</h4>
                <p>Describe the first step clearly. Include tips or warnings where appropriate.</p>
                <h4>Step 2: Configuration & Run</h4>
                <p>Explain how to perform the core task or configuration steps.</p>
                <h4>Step 3: Verification</h4>
                <p>Verify that the task was completed successfully.</p>
            ]]></field>
        </record>

        <!-- 4. Project Brief -->
        <record id="template_project_brief" model="info.hub.article">
            <field name="name">Project Brief</field>
            <field name="icon">🚀</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_business"/>
            <field name="template_description">Outline project goals, scope, key milestones, and team roles.</field>
            <field name="template_sequence">20</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Project Name: [Name] | Project Manager: [Name]</p>
                <hr/>
                <h3>🎯 Executive Summary</h3>
                <p>Provide a high-level overview of the project goal, business case, and key success metrics.</p>
                <h3>📋 Scope & Objectives</h3>
                <ul>
                    <li><strong>Objective 1:</strong> Description.</li>
                    <li><strong>Objective 2:</strong> Description.</li>
                </ul>
                <h3>📅 Milestones & Timeline</h3>
                <ul>
                    <li><strong>Milestone 1:</strong> Initial planning and scope agreement (Target: Date)</li>
                    <li><strong>Milestone 2:</strong> Development and internal validation (Target: Date)</li>
                    <li><strong>Milestone 3:</strong> Final release and transition (Target: Date)</li>
                </ul>
                <h3>👥 Team & Roles</h3>
                <ul>
                    <li><strong>Project Lead:</strong> [Name]</li>
                    <li><strong>Stakeholders:</strong> [Names]</li>
                </ul>
            ]]></field>
        </record>

        <!-- 5. Welcome Page for New Employees -->
        <record id="template_onboarding" model="info.hub.article">
            <field name="name">Welcome Page for New Employees</field>
            <field name="icon">🚀</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_hr"/>
            <field name="template_description">A welcoming page introducing new hires to the company, mission, values, and first-day overview.</field>
            <field name="template_sequence">10</field>
            <field name="body"><![CDATA[
                <div class="text-center py-4" style="background-color: #71639e10; border-radius: 8px; margin-bottom: 24px; padding: 20px;">
                    <h1 style="color: #71639e; margin-bottom: 8px;">Welcome to the Team! 🎉</h1>
                    <p class="lead text-muted" style="font-size: 18px;">We are thrilled to have you join us. This is the start of an exciting journey together!</p>
                </div>
                
                <hr/>
                
                <h3>🌟 Our Mission & Values</h3>
                <p>At <strong>[Company Name]</strong>, our goal is to build, innovate, and grow together. We hold ourselves to key values that define our culture:</p>
                <ul>
                    <li><strong>Innovation:</strong> Always seeking new perspectives and pushing boundaries.</li>
                    <li><strong>Collaboration:</strong> Working closely across teams to achieve shared success.</li>
                    <li><strong>Integrity:</strong> Acting with transparency and respect in everything we do.</li>
                </ul>

                <h3>🧭 Your First Day Overview</h3>
                <p>On your first day, we focus on helping you get comfortable, get connected, and meet your teammates:</p>
                <ul>
                    <li><strong>Morning (9:30 AM):</strong> Join our welcome standup to meet the immediate team.</li>
                    <li><strong>Midday:</strong> Lunch with your onboarding buddy/mentor to chat about company culture and ask questions.</li>
                    <li><strong>Afternoon:</strong> Set up your workspace, access credentials, and explore our internal documentation.</li>
                </ul>

                <h3>📞 Who to Reach Out To</h3>
                <p>If you have any questions or get stuck, please don't hesitate to reach out to:</p>
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse; margin-top: 15px;">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="padding: 10px; border: 1px solid #dee2e6;">Role</th>
                            <th style="padding: 10px; border: 1px solid #dee2e6;">Contact Person</th>
                            <th style="padding: 10px; border: 1px solid #dee2e6;">How to reach</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #dee2e6;"><strong>Your Manager</strong></td>
                            <td style="padding: 10px; border: 1px solid #dee2e6;">[Manager Name]</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6;">[Email / Chat]</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #dee2e6;"><strong>Onboarding Buddy</strong></td>
                            <td style="padding: 10px; border: 1px solid #dee2e6;">[Buddy Name]</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6;">[Email / Chat]</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #dee2e6;"><strong>IT Support</strong></td>
                            <td style="padding: 10px; border: 1px solid #dee2e6;">IT Helpdesk</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6;">[Slack/Teams Channel]</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #dee2e6;"><strong>HR & Admin</strong></td>
                            <td style="padding: 10px; border: 1px solid #dee2e6;">HR Team</td>
                            <td style="padding: 10px; border: 1px solid #dee2e6;">[Email / Room]</td>
                        </tr>
                    </tbody>
                </table>
            ]]></field>
        </record>

        <!-- 5b. Employee Onboarding Checklist -->
        <record id="template_employee_onboarding" model="info.hub.article">
            <field name="name">Employee Onboarding Checklist</field>
            <field name="icon">📋</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_hr"/>
            <field name="template_description">A checklist guide to help new employees track their completed tasks during onboarding.</field>
            <field name="template_sequence">11</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Onboarding Checklist | Track your progress here</p>
                <hr/>
                
                <h3>✅ First Day Tasks</h3>
                <ul class="o_checklist" style="list-style-type: none; padding-left: 0;">
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Complete direct deposit and tax forms</li>
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Configure password manager and multi-factor auth</li>
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Join the company-wide welcome channel</li>
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Complete workspace setup checklist</li>
                </ul>

                <h3>✅ First Week Tasks</h3>
                <ul class="o_checklist" style="list-style-type: none; padding-left: 0;">
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Read the company handbook and internal wiki</li>
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Attend the new hire orientation meeting</li>
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Complete initial code/process training modules</li>
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> First 1-on-1 check-in with your manager</li>
                </ul>

                <h3>✅ First Month Tasks</h3>
                <ul class="o_checklist" style="list-style-type: none; padding-left: 0;">
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Finish onboarding feedback survey</li>
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Take on your first independent task or project</li>
                    <li style="margin-bottom: 8px;"><input type="checkbox" style="margin-right: 8px;"/> Schedule a check-in with the HR team</li>
                </ul>
            ]]></field>
        </record>

        <!-- 6. PRD -->
        <record id="template_prd" model="info.hub.article">
            <field name="name">Product Requirements Document (PRD)</field>
            <field name="icon">🎯</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_business"/>
            <field name="template_description">Plan a new feature or product, detailing user stories, requirements, and design scopes.</field>
            <field name="template_sequence">30</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Author: [Name] | Date: [Date] | Status: Draft | Target Release: [Version]</p>
                <hr/>
                <h3>🎯 Executive Summary</h3>
                <p>Provide a high-level overview of the feature, target user, and key success metrics.</p>
                <h3>👥 User Stories & Persona</h3>
                <ul>
                    <li><strong>As a</strong> [User Type], <strong>I want to</strong> [Action], <strong>so that</strong> [Benefit].</li>
                </ul>
                <h3>📋 Functional Requirements</h3>
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="padding: 8px; border: 1px solid #dee2e6;">ID</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Requirement</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Priority</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">REQ-01</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Describe requirement...]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">P0</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">Proposed</td>
                        </tr>
                    </tbody>
                </table>
                <h3>🚫 Out of Scope</h3>
                <p>Explicitly list features or items that are not being addressed in this phase.</p>
            ]]></field>
        </record>

        <!-- 7. Incident Post-Mortem -->
        <record id="template_post_mortem" model="info.hub.article">
            <field name="name">Incident Post-Mortem (RCA)</field>
            <field name="icon">🚨</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_operations"/>
            <field name="template_description">Document production incidents, timeline, root cause, and follow-up actions.</field>
            <field name="template_sequence">20</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Incident Date: [Date] | Owner: [Name] | Severity: High | Affected System: [System Name]</p>
                <hr/>
                <h3>🔍 Executive Summary</h3>
                <p>Summarise what happened, how it affected our customers, and how it was resolved.</p>
                <h3>📅 Incident Timeline</h3>
                <ul>
                    <li><strong>[Time] UTC:</strong> Detection of the anomaly.</li>
                    <li><strong>[Time] UTC:</strong> Incident response team assembled.</li>
                    <li><strong>[Time] UTC:</strong> Mitigation patch deployed and service restored.</li>
                </ul>
                <h3>🧠 Root Cause Analysis</h3>
                <p>Detail the core technical issue (e.g., Five Whys analysis):</p>
                <ol>
                    <li>Why did the system go down? -> Database connection pool exhausted.</li>
                    <li>Why was it exhausted? -> ...</li>
                </ol>
                <h3>✅ Action Items</h3>
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Action Item</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Owner</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Due Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Describe action item...]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Owner]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Date]</td>
                        </tr>
                    </tbody>
                </table>
            ]]></field>
        </record>

        <!-- 8. Marketing Campaign Brief -->
        <record id="template_marketing_brief" model="info.hub.article">
            <field name="name">Marketing Campaign Brief</field>
            <field name="icon">📣</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_business"/>
            <field name="template_description">Design and launch marketing campaigns with target audience, key messaging, and budget metrics.</field>
            <field name="template_sequence">40</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Campaign Name: [Name] | Launch Date: [Date] | Owner: [Name]</p>
                <hr/>
                <h3>🎯 Campaign Goals & KPIs</h3>
                <p>Define primary marketing objectives and key metrics to measure success.</p>
                <h3>👥 Target Audience</h3>
                <p>Describe demographic, behavioral traits, and primary pain points of the target audience.</p>
                <h3>🎨 Key Messaging & Creative Assets</h3>
                <ul>
                    <li><strong>Key Message:</strong> Main concept to communicate.</li>
                    <li><strong>Required Assets:</strong> Copywriting, social media banners, blog post, newsletters.</li>
                </ul>
                <h3>💰 Budget Allocation</h3>
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Channel</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Allocation</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Expected Metrics</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[e.g. Social Ads]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[$ Amount]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[e.g. Clicks/Leads]</td>
                        </tr>
                    </tbody>
                </table>
            ]]></field>
        </record>

        <!-- 9. Employee Performance Review -->
        <record id="template_performance_review" model="info.hub.article">
            <field name="name">Employee Performance Review</field>
            <field name="icon">📈</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_hr"/>
            <field name="template_description">Structure employee self-assessments, manager evaluations, achievements, and goals.</field>
            <field name="template_sequence">20</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Employee: [Name] | Manager: [Name] | Review Period: [Year/Q]</p>
                <hr/>
                <h3>🏆 Achievements & Accomplishments</h3>
                <p>Detail key achievements, projects completed, and positive business impact during this period.</p>
                <h3>🛠️ Core Skills & Professional Growth</h3>
                <p>Reflect on key skills demonstrated, areas of expertise, and opportunities for development.</p>
                <h3>🎯 Future Goals & Objectives</h3>
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Goal</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Success Metric</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Support Needed</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Goal 1]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Metric]</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">[Support/Resources]</td>
                        </tr>
                    </tbody>
                </table>
            ]]></field>
        </record>

        <!-- 11. Customer Support Playbook -->
        <record id="template_support_playbook" model="info.hub.article">
            <field name="name">Customer Support Playbook</field>
            <field name="icon">📖</field>
            <field name="is_template" eval="True"/>
            <field name="template_category_id" ref="template_cat_guides"/>
            <field name="template_description">Establish clear protocols and template responses for common user questions or support cases.</field>
            <field name="template_sequence">20</field>
            <field name="body"><![CDATA[
                <p class="text-muted">Product/Service: [Name] | Owner: Support Team | Last Updated: [Date]</p>
                <hr/>
                <h3>🌟 Support Principles</h3>
                <p>Outline guiding values: fast resolution, empathetic tone, and clear communication.</p>
                <h3>💬 Common Scenarios & Canned Responses</h3>
                <p><strong>Scenario 1: Reset Password</strong></p>
                <p><em>Template Response:</em> "Hello [Name], to reset your password, please go to the login page and click 'Forgot Password'. Let us know if you need further help!"</p>
                <h3>📞 Escalation Paths</h3>
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f8f9fa;">
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Issue Type</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">Escalated To</th>
                            <th style="padding: 8px; border: 1px solid #dee2e6;">SLA Target</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">Billing / Refund</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">Finance Dept</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">24 hours</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">Technical Bug</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">Engineering Team</td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;">48 hours</td>
                        </tr>
                    </tbody>
                </table>
            ]]></field>
        </record>
    </data>
</odoo>
