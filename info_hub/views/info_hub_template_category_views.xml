<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category List View -->
    <record id="info_hub_template_category_view_list" model="ir.ui.view">
        <field name="name">info.hub.template.category.view.list</field>
        <field name="model">info.hub.template.category</field>
        <field name="arch" type="xml">
            <list string="Template Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon" string="Icon"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Category Form View -->
    <record id="info_hub_template_category_view_form" model="ir.ui.view">
        <field name="name">info.hub.template.category.view.form</field>
        <field name="model">info.hub.template.category</field>
        <field name="arch" type="xml">
            <form string="Template Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="icon" placeholder="📁"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Action -->
    <record id="action_info_template_category" model="ir.actions.act_window">
        <field name="name">Template Categories</field>
        <field name="res_model">info.hub.template.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first template category!
            </p>
            <p>
                Categories help organise templates in the template browser (e.g. HR, Development, Sales).
            </p>
        </field>
    </record>
</odoo>
