<?xml version="1.0" encoding="utf-8"?>
<!--
    Application menu hierarchy: Information root menu, Home, Articles, Templates, Configuration,
    Categories, Stages, Members, and Reading compliance tracking.
-->
<odoo>

    <record id="action_info_client" model="ir.actions.client">
        <field name="name">Information</field>
        <field name="tag">info_hub.InfoApp</field>
    </record>

    <!-- Root app menu — appears as an icon on the Odoo Home dashboard -->
    <menuitem
        id="menu_info_root"
        name="Information"
        sequence="100"
        web_icon="info_hub,static/description/icon.png"
        groups="info_hub.group_info_user"
        action="action_info_client"/>

    <!-- Home menu — opens the custom dashboard -->
    <menuitem
        id="menu_info_home"
        name="Home"
        parent="menu_info_root"
        sequence="5"
        action="action_info_client"
        groups="info_hub.group_info_user"/>

    <!-- Articles menu — opens the standard list view of articles -->
    <menuitem
        id="menu_info_articles"
        name="Articles"
        parent="menu_info_root"
        sequence="10"
        action="info_hub.action_info_article"
        groups="info_hub.group_info_user"/>

    <menuitem
        id="menu_info_config"
        name="Configuration"
        parent="menu_info_root"
        sequence="90"
        groups="info_hub.group_info_admin"/>


    <!-- Favourites: articles the user has starred -->
    <menuitem
        id="menu_info_favorites"
        name="Favourites"
        parent="menu_info_config"
        sequence="10"
        action="info_hub.action_info_article_favorites"
        groups="info_hub.group_info_admin"/>

    <!-- Members: all article member / permission records -->
    <menuitem
        id="menu_info_members"
        name="Members"
        parent="menu_info_config"
        sequence="12"
        action="info_hub.action_info_article_member"
        groups="info_hub.group_info_admin"/>

    <!-- Stages: Kanban stages created via /Kanban slash command -->
    <menuitem
        id="menu_info_stages"
        name="Stages"
        parent="menu_info_config"
        sequence="14"
        action="info_hub.action_info_article_stage"
        groups="info_hub.group_info_admin"/>

    <menuitem
        id="menu_info_templates_root"
        name="Templates"
        parent="menu_info_root"
        sequence="20"
        groups="info_hub.group_info_admin"/>

    <menuitem
        id="menu_info_templates"
        name="Templates"
        parent="menu_info_templates_root"
        sequence="10"
        action="info_hub.action_info_article_template"
        groups="info_hub.group_info_admin"/>

    <menuitem
        id="menu_info_template_categories"
        name="Template Categories"
        parent="menu_info_templates_root"
        sequence="20"
        action="info_hub.action_info_template_category"
        groups="info_hub.group_info_admin"/>

    <menuitem
        id="menu_info_trash"
        name="Trash"
        parent="menu_info_config"
        sequence="20"
        action="info_hub.action_info_article_trash"
        groups="info_hub.group_info_admin"/>

    <menuitem
        id="menu_info_article_reading"
        name="Mandatory Reading"
        parent="menu_info_config"
        sequence="50"
        action="info_hub.action_info_article_reading"/>

</odoo>