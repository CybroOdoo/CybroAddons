<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!-- Blueprint node inserted into the editor DOM by the plugin command. -->
    <t t-name="info_hub.EmbeddedCardViewBlueprint">
        <div t-att-data-embedded-props="embeddedProps"
             class="o_info_card_host d-flex flex-column my-3"
             data-embedded="info_card"
             data-oe-protected="true"
             contenteditable="false"/>
    </t>

    <!-- Runtime OWL template for EmbeddedCardViewComponent -->
    <t t-name="info_hub.EmbeddedCardView">
        <div class="o_info_embedded_cards position-relative border rounded overflow-hidden my-2"
             tabindex="-1"
             t-on-dragstart.stop="() => {}"
             t-on-dragover.stop="() => {}"
             t-on-dragenter.stop="() => {}"
             t-on-dragleave.stop="() => {}"
             t-on-drop.stop="() => {}"
             t-on-dragend.stop="() => {}">

            <!-- Error state -->
            <t t-if="state.error">
                <div class="d-flex flex-column align-items-center justify-content-center p-5 bg-light text-muted">
                    <i class="fa fa-exclamation-triangle fa-2x mb-2 text-warning"/>
                    <p class="mb-0 fw-bold">Could not load Cards view</p>
                    <p class="small">The view may not exist or you may lack access.</p>
                </div>
            </t>

            <!-- Loading state -->
            <t t-elif="!state.isLoaded">
                <div class="d-flex align-items-center justify-content-center p-4 bg-light text-muted">
                    <i class="fa fa-spinner fa-spin me-2"/>
                    <span>Loading Cards…</span>
                </div>
            </t>

            <!-- Loaded: render Odoo View component (Kanban view) -->
            <t t-else="">
                <View t-props="embeddedViewProps" t-key="state.reloadKey"/>
            </t>
        </div>
    </t>
    <!-- Custom Kanban view layout for embedded cards, defining the Actions dropdown menu next to the title -->
    <t t-name="info_hub.InfoEmbeddedCardsView">
        <div t-att-class="className" t-ref="root">
            <Layout className="model.useSampleModel ? 'o_view_sample_data' : ''" display="props.display">
                <!-- Top-Left Slot: New Button + Title -->
                <t t-set-slot="control-panel-create-button">
                    <div class="d-flex align-items-center gap-2">
                        <t t-if="canCreate and props.showButtons">
                            <button type="button" class="btn btn-primary o-kanban-button-new" accesskey="c" t-on-click="() => this.createRecord()" data-bounce-button="">
                                New
                            </button>
                        </t>
                    </div>
                </t>
                <t t-set-slot="layout-buttons">
                    <t t-call="{{ props.buttonTemplate }}"/>
                </t>
                <t t-set-slot="control-panel-always-buttons">
                    <t t-foreach="headerButtons" t-as="button" t-key="button.id" t-if="!evalViewModifier(button.invisible)">
                        <MultiRecordViewButton
                            t-if="button.display === 'always'"
                            list="model.root"
                            className="button.className"
                            clickParams="button.clickParams"
                            defaultRank="'btn-secondary'"
                            domain="props.domain"
                            icon="button.icon"
                            string="button.string"
                            title="button.title"
                            attrs="button.attrs"
                        />
                    </t>
                </t>
                <!-- Actions Slot: Gear icon next to it -->
                <t t-set-slot="control-panel-additional-actions">
                    <Dropdown menuClass="'lh-base'" position="'bottom-start'">
                        <button class="d-print-none btn lh-sm p-0 border-0 text-muted" data-tooltip="Actions">
                            <i class="fa fa-fw fa-cog"/>
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem class="'d-flex align-items-center gap-2 py-2'" onSelected="() => this.onOpenFullScreen()">
                                <i class="fa fa-external-link text-muted"/> Open
                            </DropdownItem>
                            <DropdownItem class="'d-flex align-items-center gap-2 py-2'" onSelected="() => this.onEditCardsName()">
                                <i class="fa fa-pencil text-muted"/> Edit
                            </DropdownItem>
                        </t>
                    </Dropdown>
                </t>

                <!-- Search/Filter slot -->
                <t t-set-slot="layout-actions">
                    <SearchBar toggler="searchBarToggler"/>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <t t-component="searchBarToggler.component" t-props="searchBarToggler.props"/>
                </t>

                <t t-component="props.Renderer"
                    list="model.root"
                    archInfo="props.archInfo"
                    Compiler="props.Compiler"
                    readonly="true"
                    forceGlobalClick="props.forceGlobalClick"
                    deleteRecord.bind="deleteRecord"
                    openRecord.bind="openRecord"
                    noContentHelp="props.info.noContentHelp"
                    scrollTop.bind="scrollTop"
                    canQuickCreate="canQuickCreate"
                    quickCreateState="quickCreateState"
                    progressBarState="progressBarState"
                />
            </Layout>
        </div>
    </t>
</templates>
