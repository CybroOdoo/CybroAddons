<?xml version="1.0" encoding="utf-8"?>
<!--
    Form view and action for the 'Add to Templates' wizard, allowing articles to be saved as reusable templates.
-->
<odoo>
    <record id="info_hub_add_to_template_wizard_view_form" model="ir.ui.view">
        <field name="name">info.hub.add.to.template.wizard.view.form</field>
        <field name="model">info.hub.add.to.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Add to Templates">
                <sheet>
                    <group>
                        <field name="article_id"/>
                        <field name="template_category_id"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_template" string="Create" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_info_hub_add_to_template_wizard" model="ir.actions.act_window">
        <field name="name">Add to Templates</field>
        <field name="res_model">info.hub.add.to.template.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
