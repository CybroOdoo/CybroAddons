<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            NOTE: noupdate="1" means these records are only written on first
            install. To refresh the model list after upgrading, either edit
            the records manually under Vibe Coding → Providers, or temporarily
            set noupdate="0" and re-run -u.
        -->

        <record id="provider_gemini" model="ai.provider">
            <field name="name">Google Gemini</field>
            <field name="code">gemini</field>
            <field name="default_model">gemini-2.5-flash</field>
            <field name="available_models">gemini-2.5-pro
gemini-2.5-flash
gemini-2.5-flash-lite
gemini-2.0-flash
gemini-2.0-flash-lite
gemini-1.5-pro
gemini-1.5-flash</field>
            <field name="api_base_url">https://generativelanguage.googleapis.com/v1beta</field>
            <field name="is_default" eval="True"/>
        </record>

        <record id="provider_claude" model="ai.provider">
            <field name="name">Anthropic Claude</field>
            <field name="code">claude</field>
            <field name="default_model">claude-sonnet-4-5</field>
            <field name="available_models">claude-opus-4-5
claude-sonnet-4-5
claude-haiku-4-5
claude-opus-4-1
claude-sonnet-4
claude-3-7-sonnet-latest
claude-3-5-sonnet-latest
claude-3-5-haiku-latest</field>
            <field name="api_base_url">https://api.anthropic.com/v1</field>
            <field name="is_default" eval="False"/>
        </record>

        <record id="provider_openai" model="ai.provider">
            <field name="name">OpenAI</field>
            <field name="code">openai</field>
            <field name="default_model">gpt-4o-mini</field>
            <field name="available_models">gpt-4o
gpt-4o-mini
gpt-4-turbo
gpt-4.1
gpt-4.1-mini
o1
o1-mini
o3-mini</field>
            <field name="api_base_url">https://api.openai.com/v1</field>
            <field name="is_default" eval="False"/>
        </record>

    </data>
</odoo>
