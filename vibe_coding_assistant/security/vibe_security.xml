<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ai.provider.user.config -->
        <record id="rule_ai_provider_user_config_own" model="ir.rule">
            <field name="name">User: own AI configs only</field>
            <field name="model_id" ref="model_ai_provider_user_config"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vibe_coder'))]"/>
        </record>

        <!-- vibe.conversation -->
        <record id="rule_vibe_conversation_own" model="ir.rule">
            <field name="name">User: own conversations only</field>
            <field name="model_id" ref="model_vibe_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vibe_coder'))]"/>
        </record>

        <!-- vibe.message -->
        <record id="rule_vibe_message_own" model="ir.rule">
            <field name="name">User: own messages only</field>
            <field name="model_id" ref="model_vibe_message"/>
            <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vibe_coder'))]"/>
        </record>

        <!-- vibe.generated.module -->
        <record id="rule_vibe_generated_module_own" model="ir.rule">
            <field name="name">User: own generated modules only</field>
            <field name="model_id" ref="model_vibe_generated_module"/>
            <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vibe_coder'))]"/>
        </record>

        <!-- vibe.generated.file -->
        <record id="rule_vibe_generated_file_own" model="ir.rule">
            <field name="name">User: own generated files only</field>
            <field name="model_id" ref="model_vibe_generated_file"/>
            <field name="domain_force">[('module_id.conversation_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vibe_coder'))]"/>
        </record>

    </data>
</odoo>
