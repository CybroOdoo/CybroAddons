<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Application category for Vibe Coding Assistant -->
    <record id="module_category_vibe_coding" model="ir.module.category">
        <field name="name">Vibe Coding Assistant</field>
        <field name="description">Access to the AI-powered Odoo module generator.</field>
        <field name="sequence">20</field>
    </record>

    <!-- User Group -->
    <record id="group_vibe_coder" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="vibe_coding_assistant.module_category_vibe_coding"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>
<!--      <record id="group_hubspot_manager" model="res.groups">-->
<!--        <field name="name">Hubspot Manager</field>-->
<!--        <field name="category_id"-->
<!--               ref="hubspot_odoo_connector.module_category_hubspot_manager"/>-->
<!--        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>-->
<!--    </record>-->

    <!-- Administrator Group -->
    <record id="group_vibe_coder_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_vibe_coding"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_vibe_coder')])]"/>
    </record>

</odoo>