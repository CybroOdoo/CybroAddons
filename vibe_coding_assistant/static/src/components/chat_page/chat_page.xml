<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="vibe_coding_assistant.ChatPage">
        <div class="o_vibe_chat_page o_view_controller">

            <!-- Left: conversation list -->
            <ConversationList/>

            <!-- Centre: thread + composer OR no-provider warning -->
            <div class="o_vibe_thread">
                <t t-if="!this.providerLoaded">
                    <!-- Still loading provider info — show a quiet spinner -->
                    <div class="o_vibe_empty_state">
                        <i class="oi mb-3 text-muted oi-spin" data-icon="autorenew"/>
                        <p class="text-muted">Loading…</p>
                    </div>
                </t>
                <t t-elif="!this.hasProvider">
                    <!-- No active provider configured -->
                    <div class="o_vibe_empty_state">
                        <div class="o_vibe_no_provider_card">
                            <div class="o_vibe_no_provider_icon">🔑</div>
                            <h4>No AI provider configured</h4>
                            <p class="text-muted">
                                You need to add an API key before you can generate modules.<br/>
                                A free Gemini key takes about 30 seconds to set up.
                            </p>
                            <div class="d-flex gap-2 justify-content-center mt-2">
                                <button class="btn btn-primary" t-on-click="this.goToSettings">
                                    <i class="oi me-1" data-icon="settings"/>Go to My AI Settings
                                </button>
                                <button class="btn btn-outline-secondary"
                                        t-on-click="this.recheckProvider"
                                        t-att-disabled="this.state.rechecking">
                                    <i t-att-class="this.state.rechecking ? 'oi oi-spin me-1' : 'oi me-1'" t-att-data-icon="this.state.rechecking ? 'autorenew' : 'refresh'"/>
                                    <t t-if="this.state.rechecking">Checking…</t>
                                    <t t-else="">Recheck</t>
                                </button>
                            </div>
                            <div class="mt-3 small text-muted">
                                Already activated a config? Click <strong>Recheck</strong>.<br/>
                                Get a free Gemini key at
                                <a href="https://aistudio.google.com/apikey" target="_blank">
                                    aistudio.google.com/apikey
                                </a>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <!-- Normal chat view -->
                    <MessageThread/>
                    <Composer/>
                </t>
            </div>

            <!-- Right: file preview panel -->
            <div class="o_vibe_preview_panel">
                <t t-if="this.vibeStore.state.activeModuleId">
                    <FileTree/>
                    <CodeViewer/>
                </t>
                <t t-else="">
                    <div class="o_vibe_preview_placeholder">
                        <div class="text-center text-muted p-4">
                            <i class="oi mb-2 d-block" data-icon="code"/>
                            <small>
                                Generate a module, then click<br/>
                                <strong>View Files</strong> to preview it here.
                            </small>
                        </div>
                    </div>
                </t>
            </div>

        </div>
    </t>

</templates>
