<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Dashboard form view ────────────────────────────────────────── -->
    <record id="view_vibe_dashboard_form" model="ir.ui.view">
        <field name="name">vibe.dashboard.form</field>
        <field name="model">vibe.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false" class="o_vibe_dashboard_form">
                <sheet>
                    <!-- ── Title row ─────────────────────────────────── -->
                    <div class="o_vibe_dash_title">
                        <div class="o_vibe_dash_icon">
                            <i class="fa fa-bar-chart"/>
                        </div>
                        <div>
                            <h1 class="mb-0">Vibe Coding Dashboard</h1>
                            <p class="text-muted mb-0">
                                Live aggregate stats across all users, providers, and generated modules.
                            </p>
                        </div>
                    </div>

                    <!-- ── Headline KPI row ──────────────────────────── -->
                    <div class="o_vibe_dash_kpi_row">

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_primary"
                             title="Click to view all conversations">
                            <button name="action_view_all_conversations"
                                    type="object" class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">Conversations</div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="total_conversations" readonly="True"/>
                                </div>
                                <div class="o_vibe_dash_kpi_sub">
                                    across <field name="total_users" readonly="True" class="d-inline"/> users
                                </div>
                            </button>
                        </div>

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_success"
                             title="Click to view all generated modules">
                            <button name="action_view_all_modules"
                                    type="object" class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">Modules Generated</div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="total_modules" readonly="True"/>
                                </div>
                                <div class="o_vibe_dash_kpi_sub">
                                    <field name="total_downloads" readonly="True" class="d-inline"/> downloads
                                </div>
                            </button>
                        </div>

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_warning">
                            <div class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">Total Tokens</div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="total_tokens" readonly="True"/>
                                </div>
                                <div class="o_vibe_dash_kpi_sub">
                                    <field name="total_input_tokens" readonly="True" class="d-inline"/> in
                                    /
                                    <field name="total_output_tokens" readonly="True" class="d-inline"/> out
                                </div>
                            </div>
                        </div>

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_info">
                            <div class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">Success Rate</div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="success_rate" readonly="True" widget="percentage"/>
                                </div>
                                <div class="o_vibe_dash_kpi_sub">
                                    of validated modules
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ── Validation breakdown row ──────────────────── -->
                    <div class="o_vibe_dash_section_title">
                        <i class="fa fa-check-circle me-2"/>Validation Status
                    </div>
                    <div class="o_vibe_dash_kpi_row o_vibe_dash_kpi_row_small">

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_small o_vibe_dash_kpi_valid">
                            <button name="action_view_valid_modules"
                                    type="object" class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">
                                    <i class="fa fa-check-circle me-1"/>Valid
                                </div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="valid_modules" readonly="True"/>
                                </div>
                            </button>
                        </div>

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_small o_vibe_dash_kpi_invalid">
                            <button name="action_view_invalid_modules"
                                    type="object" class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">
                                    <i class="fa fa-exclamation-triangle me-1"/>Invalid
                                </div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="invalid_modules" readonly="True"/>
                                </div>
                            </button>
                        </div>

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_small o_vibe_dash_kpi_pending">
                            <div class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">
                                    <i class="fa fa-clock-o me-1"/>Pending
                                </div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="pending_modules" readonly="True"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ── Recent activity row ───────────────────────── -->
                    <div class="o_vibe_dash_section_title">
                        <i class="fa fa-clock-o me-2"/>Recent Activity
                    </div>
                    <div class="o_vibe_dash_kpi_row o_vibe_dash_kpi_row_small">

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_small o_vibe_dash_kpi_recent">
                            <div class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">
                                    <i class="fa fa-bolt me-1"/>Last 24 Hours
                                </div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="modules_last_24h" readonly="True"/>
                                </div>
                                <div class="o_vibe_dash_kpi_sub">modules generated</div>
                            </div>
                        </div>

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_small o_vibe_dash_kpi_recent">
                            <div class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">
                                    <i class="fa fa-calendar me-1"/>Last 7 Days
                                </div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="modules_last_7d" readonly="True"/>
                                </div>
                                <div class="o_vibe_dash_kpi_sub">modules generated</div>
                            </div>
                        </div>

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_small o_vibe_dash_kpi_recent">
                            <div class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">
                                    <i class="fa fa-calendar-o me-1"/>Last 30 Days
                                </div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="modules_last_30d" readonly="True"/>
                                </div>
                                <div class="o_vibe_dash_kpi_sub">modules generated</div>
                            </div>
                        </div>

                        <div class="o_vibe_dash_kpi o_vibe_dash_kpi_small o_vibe_dash_kpi_efficiency">
                            <div class="o_vibe_dash_kpi_btn">
                                <div class="o_vibe_dash_kpi_label">
                                    <i class="fa fa-tachometer me-1"/>Avg Tokens / Module
                                </div>
                                <div class="o_vibe_dash_kpi_value">
                                    <field name="avg_tokens_per_module" readonly="True"/>
                                </div>
                                <div class="o_vibe_dash_kpi_sub">
                                    <field name="avg_messages_per_conversation" readonly="True" class="d-inline"/>
                                    msgs/chat
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ── Activity sparkline ────────────────────────── -->
                    <div class="o_vibe_dash_section_title">
                        <i class="fa fa-line-chart me-2"/>Module Generation Trend
                    </div>
                    <div class="o_vibe_dash_panel">
                        <field name="activity_sparkline_html" widget="html"
                               readonly="True" nolabel="True"/>
                    </div>

                    <!-- ── Two-column row: provider breakdown + top users ── -->
                    <div class="o_vibe_dash_two_col">
                        <div class="o_vibe_dash_panel">
                            <div class="o_vibe_dash_panel_title">
                                <i class="fa fa-pie-chart me-2"/>Provider Usage
                            </div>
                            <field name="provider_breakdown_html" widget="html"
                                   readonly="True" nolabel="True"/>
                        </div>
                        <div class="o_vibe_dash_panel">
                            <div class="o_vibe_dash_panel_title">
                                <i class="fa fa-trophy me-2"/>Top Users
                            </div>
                            <field name="top_users_html" widget="html"
                                   readonly="True" nolabel="True"/>
                        </div>
                    </div>

                    <!-- ── Inline guidance ──────────────────────────── -->
                    <div class="o_vibe_dash_footer">
                        <i class="fa fa-info-circle me-2 text-info"/>
                        For detailed views, use the menu items: <strong>Conversations</strong>
                        (pivot, graph, list) and <strong>Generated Modules</strong>
                        (graph, list). Refresh this page to recompute the stats.
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Dashboard action ────────────────────────────────────────────── -->
    <record id="action_vibe_dashboard" model="ir.actions.server">
        <field name="name">Vibe Coding Dashboard</field>
        <field name="model_id" ref="model_vibe_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

    <!-- ─────────────────────────────────────────────────────────────────
         Pivot + graph views on vibe.conversation (admin analytics)
         ───────────────────────────────────────────────────────────────── -->

    <record id="view_vibe_conversation_pivot" model="ir.ui.view">
        <field name="name">vibe.conversation.pivot</field>
        <field name="model">vibe.conversation</field>
        <field name="arch" type="xml">
            <pivot string="Token Usage by User × Provider">
                <field name="user_id" type="row"/>
                <field name="provider_config_id" type="col"/>
                <field name="tokens_total" type="measure"/>
                <field name="tokens_input_total" type="measure"/>
                <field name="tokens_output_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_vibe_conversation_graph" model="ir.ui.view">
        <field name="name">vibe.conversation.graph</field>
        <field name="model">vibe.conversation</field>
        <field name="arch" type="xml">
            <graph string="Token Usage Over Time" type="line">
                <field name="last_activity" interval="day" type="row"/>
                <field name="tokens_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ─────────────────────────────────────────────────────────────────
         Graph view on vibe.generated.module
         ───────────────────────────────────────────────────────────────── -->

    <record id="view_vibe_module_graph" model="ir.ui.view">
        <field name="name">vibe.generated.module.graph</field>
        <field name="model">vibe.generated.module</field>
        <field name="arch" type="xml">
            <graph string="Modules by Validation State" type="bar">
                <field name="validation_state" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_vibe_module_list" model="ir.ui.view">
        <field name="name">vibe.generated.module.list</field>
        <field name="model">vibe.generated.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Generated"/>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="conversation_id"/>
                <field name="validation_state"
                       widget="badge"
                       decoration-success="validation_state == 'valid'"
                       decoration-warning="validation_state == 'invalid'"
                       decoration-info="validation_state == 'pending'"/>
                <field name="download_count" string="Downloads" sum="Total"/>
            </list>
        </field>
    </record>

</odoo>
