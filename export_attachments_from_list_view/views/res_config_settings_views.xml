<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Creating a field to the general settings for creating an action-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.export.attachments.from.list.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="inside">
                <setting id="export_attachments_setting"
                         string="Create a Dynamic Action"
                         help="Configure dynamic actions to export attachments from list view">
                    <div class="mt8" groups="base.group_user">
                        <button name="%(export_attachments_from_list_view.export_attachment_action)d"
                                icon="fa-arrow-right"
                                type="action"
                                string="Export Attachment From List View"
                                class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
