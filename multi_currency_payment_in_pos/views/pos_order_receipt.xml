<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit pos order receipt to display foreign currency payment info -->
    <template id="pos_order_receipt_multicurrency" inherit_id="point_of_sale.pos_order_receipt">
        <xpath expr="//tr[hasclass('payment-line')]/td[hasclass('text-start')]" position="replace">
            <td class="text-start w-70">
                <span t-out="payment['payment_method_data']['name']"/>
                <t t-if="('currency_amount' in payment and payment['currency_amount']) and ('payment_currency' in payment and payment['payment_currency'])">
                    <span class="currency-info font-monospace ms-1">
                        (<t t-out="payment['currency_amount']"/> <t t-out="payment['payment_currency']"/>)
                    </span>
                </t>
            </td>
        </xpath>
    </template>
</odoo>
