<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_multi_currency_pricelist" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.multi.currency.pricelist</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_pricing_section']/setting[@id='multiple_prices_setting']" position="after">
                <setting
                    id="multi_currency_pricelist_setting"
                    string="Multi-Currency Pricelists"
                    help="Allow POS pricelists with different currencies and show the selected pricelist currency in POS."
                    invisible="not pos_use_pricelist"
                >
                    <field name="pos_enable_multi_currency_pricelist" readonly="pos_has_active_session"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
