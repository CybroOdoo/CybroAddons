<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Template of report with ID bom_usage_report-->
    <template id="stock_move_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">
                    <h2 align = "center">BOM Product Usage</h2>
                    <div class="col-xs-3">
                        <t t-if="from_date"><strong>Date from :</strong> <span t-esc="from_date"/><br/></t>
                        <t t-if="to_date"><strong>Date to :</strong> <span t-esc="to_date"/><br/></t>
                    </div>
                    <table class="table">
                        <thead>
                            <th class="text-start">Component Products<span style="margin-left:100px">Final Products</span></th>
                            <th class="text-center" >Quantity Used</th>
                            <th class="text-center" >Uom</th>
                        </thead>
                        <tbody>
                            <tr t-foreach="heading" t-as="bom">
                                <td colspan="3">
                                    <strong>
                                        <span t-esc="bom.get('child_product_name')"/>
                                    </strong>
                                </td>
                                <tr t-foreach="body" t-as="doc2">
                                    <t t-if="bom['child_product_name'] == doc2['child_product_name']">
                                        <td align="right">
                                            <span t-esc="doc2['parent_product_name']"/>
                                        </td>
                                        <td align="center">
                                            <span t-esc="doc2['child_quantity_used']"/>
                                        </td>
                                        <td align="center">
                                            <span t-esc="doc2['uom']"/>
                                        </td>
                                    </t>
                                </tr>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
