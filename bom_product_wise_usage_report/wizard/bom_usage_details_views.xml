<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Form view of model bom.usage.report-->
    <record id="bom_usage_report_view_form" model="ir.ui.view">
        <field name="name">BOM Usage Details</field>
        <field name="model">bom.usage.details</field>
        <field name="arch" type="xml">
            <form string="Stock Report">
                <group>
                    <group>
                        <field name="from_date"/>
                    </group>
                    <group>
                        <field name="to_date"/>
                    </group>
                    <group colspan="2" rowspan ="2">
                       <field name="product_ids" string="Products" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="un_build_orders" />
                    </group>
                </group>
                <footer>
                    <button name="action_get_report" string="Print PDF Report" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

<!--    Action of model bom.usage.report-->
    <record id="bom_usage_report_action" model="ir.actions.act_window">
        <field name="name">BOM Usage Details</field>
        <field name="res_model">bom.usage.details</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="bom_usage_report_view_form"/>
        <field name="target">new</field>
    </record>

<!--    MenuItem of model bom.usage.report-->
    <menuitem id="bom_usage_report_child_menu"
              name="BOM Usage Report"
              action="bom_usage_report_action"
              parent="mrp.menu_mrp_reporting"
              sequence="100"/>
</odoo>
