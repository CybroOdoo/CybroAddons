<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--To add the customer details in the pos receipt-->
    <template id="pos_order_receipt_header_inherit"
              inherit_id="point_of_sale.pos_order_receipt_header">
        <xpath expr="//div[@name='partner_info']" position="replace">
            <div t-if="partner" class="w-100 text-center">
                <div t-if="config.get('customer_name') and partner.get('name')">
                    Customer Name:
                    <t t-out="partner['name']"/>
                </div>
                    <div t-if="partner and config.get('customer_address')">
                <t t-if="partner.get('street')">
                    Customer Address:
                    <span t-out="partner['street']"/>
                    <t t-if="partner.get('zip') or partner.get('city')">
                        <span t-out="partner.get('zip', '')"/>
                        <span t-out="partner.get('city', '')"/>
                </t>
                </t>
                    </div>
                <t t-if="partner.get('zip') or partner.get('city')">
                <span t-out="partner.get('zip', '')"/>
                <span t-out="partner.get('city', '')"/>
                </t>
                <div t-if="config.get('customer_vat') and partner.get('vat')">
                    Customer VAT:
                    <t t-out="partner['vat']"/>
                </div>
                <div t-if="config.get('customer_mobile') and partner.get('mobile')">
                    Customer Mobile:
                    <t t-out="partner['mobile']"/>
                </div>
                <div t-if="config.get('customer_phone') and partner.get('phone')">
                    Customer Phone:
                    <t t-out="partner['phone']"/>
                </div>
                <div t-if="config.get('customer_email') and partner.get('email')">
                    Customer Email:
                    <t t-out="partner['email']"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>