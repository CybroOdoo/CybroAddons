<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="pos_order_receipt_inherit" inherit_id="point_of_sale.pos_order_receipt">
        <xpath expr="//div[@name='before-footer']" position="after">
            <br/>
            <br/>
            <div t-if="image.get('pos_barcode_src') or image.get('pos_barcode')" class="text-center mt-2 mb-2 w-100">
                <img class="pos-receipt-barcode"
                     t-att-src="image.get('pos_barcode_src') or ('/report/barcode/Code128/' + (image.get('pos_barcode') or ''))"
                     style="max-width: 80%; height: 50px;"
                     alt="Order Barcode"/>
                <div t-if="image.get('pos_barcode')" class="text-small text-center" t-out="image.get('pos_barcode')"/>
            </div>
        </xpath>
    </template>
</odoo>