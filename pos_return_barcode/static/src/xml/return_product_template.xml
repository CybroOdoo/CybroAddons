<?xml version="1.0" encoding="UTF-8"?>
<!--Adds the Return button to the POS control buttons-->
<templates id="template" xml:space="preserve">
    <t t-name="ReturnProduct" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']/div/t[@name='o_pricelist_button']"
               position="before">
            <t t-call="point_of_sale.controlButton"
               name="o_return_product_button"
               icon="'shopping_cart'"
               btnText.translate="Return Product"
               btnClasses="'o_return_product_button btn-secondary '"
               onClick="() => this.onClickReturn()">
            </t>
        </xpath>
    </t>
</templates>
