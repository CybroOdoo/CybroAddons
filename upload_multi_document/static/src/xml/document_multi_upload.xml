<?xml version="1.0" encoding="UTF-8"?>
<!--The templates are defining the buttons to be displayed on list view-->
<templates id="template" xml:space="preserve">
    <t t-name="upload_multi_document.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//Layout/t[@t-set-slot='control-panel-buttons']/t[1]" position="after">
            <button t-if="this.hasSelectedRecords"
                    name="upload_form_button"
                    class="btn btn-secondary ms-1"
                    type="button"
                    t-on-click="this._uploadMultiDocumentOnClickAttachment"
                    title="Upload Attachments">
                <i class="fa fa-paperclip" role="img" aria-label="Upload Attachments"/>
            </button>
        </xpath>
    </t>
</templates>
