<?xml version="1.0" encoding="UTF-8"?>
<!--The templates are defining the buttons to be displayed on list view-->
<templates id="template" xml:space="preserve">
    <t t-name="upload_multi_document.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="after">
            <t t-if="hasSelectedRecords">
                <button name="upload_form_button" multiple="multiple"
                        class="btn btn-secondary" type="button"
                        t-on-click="_onClickAttachment">
                    <i class="fa fa-paperclip"/>
                </button>
            </t>
        </xpath>
    </t>
</templates>
