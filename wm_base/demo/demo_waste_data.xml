<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WASTE CATEGORIES                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="wcat_ewaste" model="wm.waste.category">
        <field name="name">Electronic Waste (E-Waste)</field>
        <field name="code">EW</field>
        <field name="description">
            Discarded electrical and electronic equipment including computers,
            phones, batteries and circuit boards. Often contains hazardous
            materials requiring controlled processing.
        </field>
    </record>

    <!-- Record: wm.waste.category - Hazardous Chemical Waste -->
    <record id="wcat_hazardous" model="wm.waste.category">
        <field name="name">Hazardous Chemical Waste</field>
        <field name="code">HW</field>
        <field name="description">
            Liquids, solids and gases that are toxic, flammable, corrosive or
            reactive. Includes used oils, solvents, paints and chemical by-products.
            Requires licensed disposal or specialist treatment.
        </field>
    </record>

    <!-- Record: wm.waste.category - Construction & Demolition Waste -->
    <record id="wcat_construction" model="wm.waste.category">
        <field name="name">Construction &amp; Demolition Waste</field>
        <field name="code">CDW</field>
        <field name="description">
            Rubble, concrete, bricks, timber and mixed materials from
            construction sites and demolitions. Some streams (e.g. asbestos)
            are classified hazardous.
        </field>
    </record>

    <!-- Record: wm.waste.category - Biomedical Waste -->
    <record id="wcat_biomedical" model="wm.waste.category">
        <field name="name">Biomedical Waste</field>
        <field name="code">BMW</field>
        <field name="description">
            Waste generated by healthcare facilities: sharps, pathological
            waste, pharmaceutical waste and infectious materials. Strictly
            regulated and requires incineration or autoclaving.
        </field>
    </record>

    <!-- Record: wm.waste.category - Industrial Process Waste -->
    <record id="wcat_industrial" model="wm.waste.category">
        <field name="name">Industrial Process Waste</field>
        <field name="code">IW</field>
        <field name="description">
            By-products from manufacturing, fabrication and industrial
            processes: metal shavings, textile offcuts, rubber and
            packaging waste.
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WASTE MATERIALS — E-Waste                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="wmat_batteries" model="product.product">
        <field name="name">Used Batteries (Li-ion / Lead-Acid)</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_ewaste"/>
        <field name="hazardous" eval="True"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Lithium-ion, nickel-metal hydride and lead-acid batteries from
            consumer electronics and vehicles. Contain recoverable metals
            (cobalt, lithium, lead) but require specialist processing.
        </field>
    </record>

    <!-- Record: product.product - Printed Circuit Boards (PCBs) -->
    <record id="wmat_pcb" model="product.product">
        <field name="name">Printed Circuit Boards (PCBs)</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_ewaste"/>
        <field name="hazardous" eval="True"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            End-of-life circuit boards from computers, phones and appliances.
            Rich in gold, silver, copper and palladium recoverable via
            hydrometallurgical processes.
        </field>
    </record>

    <!-- Record: product.product - Cables & Electrical Wires -->
    <record id="wmat_cables" model="product.product">
        <field name="name">Cables &amp; Electrical Wires</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_ewaste"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Copper and aluminium cables from buildings, vehicles and
            appliances. Copper recovery rates typically 90%+ after
            shredding and separation.
        </field>
    </record>

    <!-- Record: product.product - End-of-Life Mobile Phones & Tablets -->
    <record id="wmat_mobile_phones" model="product.product">
        <field name="name">End-of-Life Mobile Phones &amp; Tablets</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_ewaste"/>
        <field name="hazardous" eval="True"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Decommissioned handsets and tablets. Contain glass, aluminium,
            copper, gold and rare-earth elements. Batteries must be removed
            before processing.
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WASTE MATERIALS — Hazardous Chemical                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="wmat_used_oil" model="product.product">
        <field name="name">Used Motor &amp; Lubricating Oil</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_hazard"/>
        <field name="hazardous" eval="True"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Waste engine and gear oils from workshops and industrial
            machinery. Can be re-refined into base oil or used as
            industrial fuel after treatment.
        </field>
    </record>

    <!-- Record: product.product - Spent Chemical Solvents -->
    <record id="wmat_solvents" model="product.product">
        <field name="name">Spent Chemical Solvents</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_hazard"/>
        <field name="hazardous" eval="True"/>
        <field name="recyclable" eval="False"/>
        <field name="description">
            Organic solvents (acetone, toluene, IPA) used in cleaning,
            painting and manufacturing. Require incineration at high
            temperature in licensed facilities.
        </field>
    </record>

    <!-- Record: product.product - Paint & Coating Waste -->
    <record id="wmat_paint_waste" model="product.product">
        <field name="name">Paint &amp; Coating Waste</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_hazard"/>
        <field name="hazardous" eval="True"/>
        <field name="recyclable" eval="False"/>
        <field name="description">
            Leftover paints, varnishes, lacquers and hardeners from
            industrial and construction operations. Contains VOCs and
            heavy metals.
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WASTE MATERIALS — Dry Recyclables                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="wmat_pet_plastic" model="product.product">
        <field name="name">PET Plastic Bottles &amp; Packaging</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_recycle"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Clear PET (Type 1) and HDPE (Type 2) plastic containers from
            beverages and household products. Baled and sold to plastic
            reprocessors for pellet production.
        </field>
    </record>

    <!-- Record: product.product - Cardboard & Mixed Paper -->
    <record id="wmat_cardboard" model="product.product">
        <field name="name">Cardboard &amp; Mixed Paper</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_recycle"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Corrugated cardboard, office paper and newspapers.
            Baled and sold to paper mills as recovered fibre.
            Must be dry and free of food contamination.
        </field>
    </record>

    <!-- Record: product.product - Aluminium Scrap & Cans -->
    <record id="wmat_aluminium" model="product.product">
        <field name="name">Aluminium Scrap &amp; Cans</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_recycle"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Aluminium beverage cans, foil, extrusions and sheet offcuts.
            One of the most valuable recyclables — melting requires only
            5% of the energy of primary smelting.
        </field>
    </record>

    <!-- Record: product.product - Steel & Ferrous Metal Scrap -->
    <record id="wmat_steel_scrap" model="product.product">
        <field name="name">Steel &amp; Ferrous Metal Scrap</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_recycle"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Steel cans, structural steel, machinery components and
            miscellaneous ferrous scrap. Sorted by grade and sold to
            steel mills or foundries.
        </field>
    </record>

    <!-- Record: product.product - Glass Bottles & Containers -->
    <record id="wmat_glass" model="product.product">
        <field name="name">Glass Bottles &amp; Containers</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_recycle"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Post-consumer glass bottles and jars, colour-sorted where
            possible. Crushed into cullet and sold to glass manufacturers
            as a replacement for raw silica.
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WASTE MATERIALS — Organic                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="wmat_food_waste" model="product.product">
        <field name="name">Food &amp; Kitchen Waste</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_organic"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Raw and cooked food scraps from restaurants, canteens and
            households. Composted to produce soil amendment or
            anaerobically digested for biogas and biofertiliser.
        </field>
    </record>

    <!-- Record: product.product - Garden & Green Waste -->
    <record id="wmat_garden_waste" model="product.product">
        <field name="name">Garden &amp; Green Waste</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="waste_category_organic"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Grass clippings, leaves, prunings and bark from gardens and
            parks. Chipped and composted; woody material used for
            biomass energy.
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WASTE MATERIALS — Construction &amp; Demolition                    -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="wmat_concrete_rubble" model="product.product">
        <field name="name">Concrete &amp; Masonry Rubble</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_construction"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Broken concrete, bricks, tiles and masonry from demolition
            sites. Crushed and screened to produce recycled aggregate
            for road base and fill applications.
        </field>
    </record>

    <!-- Record: product.product - Asbestos-Containing Materials (ACM) -->
    <record id="wmat_asbestos" model="product.product">
        <field name="name">Asbestos-Containing Materials (ACM)</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_construction"/>
        <field name="hazardous" eval="True"/>
        <field name="recyclable" eval="False"/>
        <field name="description">
            Friable and non-friable asbestos from older buildings.
            Strictly regulated — requires licensed removal, double-bagging
            and disposal at approved landfill cells only.
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WASTE MATERIALS — Biomedical                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="wmat_sharps" model="product.product">
        <field name="name">Sharps &amp; Needles</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_biomedical"/>
        <field name="hazardous" eval="True"/>
        <field name="recyclable" eval="False"/>
        <field name="description">
            Used hypodermic needles, lancets, scalpels and other sharp
            objects from medical and dental facilities. Collected in
            puncture-resistant containers and incinerated.
        </field>
    </record>

    <!-- Record: product.product - Expired Pharmaceutical Waste -->
    <record id="wmat_pharma_waste" model="product.product">
        <field name="name">Expired Pharmaceutical Waste</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_biomedical"/>
        <field name="hazardous" eval="True"/>
        <field name="recyclable" eval="False"/>
        <field name="description">
            Expired or unused medicines, vaccines and cytotoxic drugs
            from hospitals and pharmacies. Must not enter sewage systems —
            incinerated at controlled high temperature.
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WASTE MATERIALS — Industrial                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <record id="wmat_metal_shavings" model="product.product">
        <field name="name">Metal Turnings &amp; Machining Swarf</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_industrial"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Steel, aluminium and copper turnings from CNC machining and
            lathe operations. Sold by weight to metal recyclers after
            centrifuging out coolant oils.
        </field>
    </record>

    <!-- Record: product.product - Textile & Fabric Offcuts -->
    <record id="wmat_textile_waste" model="product.product">
        <field name="name">Textile &amp; Fabric Offcuts</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_industrial"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            Cotton, polyester and blended fabric offcuts from garment
            manufacturing. Sorted by fibre type for re-spinning,
            wiping rags or insulation filler.
        </field>
    </record>

    <!-- Record: product.product - Rubber & Tyre Waste -->
    <record id="wmat_rubber_waste" model="product.product">
        <field name="name">Rubber &amp; Tyre Waste</field>
        <field name="type">consu</field>
        <field name="is_waste_material" eval="True"/>
        <field name="wm_waste_category_id" ref="wcat_industrial"/>
        <field name="hazardous" eval="False"/>
        <field name="recyclable" eval="True"/>
        <field name="description">
            End-of-life tyres and rubber offcuts from manufacturing.
            Shredded into crumb rubber for playground surfaces, road
            asphalt additives and fuel (TDF).
        </field>
    </record>

</odoo>
