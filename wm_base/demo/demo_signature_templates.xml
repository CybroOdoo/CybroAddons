        <!-- SIGNATURE TEMPLATES -->
        <record id="demo_sig_template_1" model="wm.signature.template">
            <field name="name">Standard Collection Agreement</field>
            <field name="role_ids" eval="[(6, 0, [ref('demo_sig_template_role_1')])]"/>
        </record>
        <!-- Record: wm.signature.template - Hazardous Waste Manifest -->
        <record id="demo_sig_template_2" model="wm.signature.template">
