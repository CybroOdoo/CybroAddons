        <!-- SIGNATURE REQUESTS -->
        <record id="demo_sig_request_1" model="wm.signature.request">
            <field name="name">SIG/2026/00101</field>
            <field name="template_id" ref="demo_sig_template_1"/>
            <field name="state">signed</field>
            <field name="date_requested" eval="(DateTime.now() - relativedelta(days=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_signed" eval="(DateTime.now() - relativedelta(days=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="signer_ids">
                <!-- Record: wm.signature.request.signer (demo_sig_signer_1_1) -->
                <record id="demo_sig_signer_1_1" model="wm.signature.request.signer">
                    <field name="partner_id" ref="base.res_partner_1"/>
                    <field name="role_id" ref="demo_sig_template_role_1"/>
                    <field name="state">signed</field>
                    <field name="access_token">demo-token-signed-001</field>
                    <field name="signed_date" eval="(DateTime.now() - relativedelta(days=4)).strftime('%Y-%m-%d %H:%M:%S')"/>
                    <field name="ip_address">192.168.1.45</field>
                </record>
            </field>
        </record>

