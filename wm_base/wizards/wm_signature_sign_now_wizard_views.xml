<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.signature.sign.now.wizard - wm.signature.sign.now.wizard.form (Form) -->
    <record id="view_wm_signature_sign_now_wizard_form" model="ir.ui.view">
        <field name="name">wm.signature.sign.now.wizard.form</field>
        <field name="model">wm.signature.sign.now.wizard</field>
        <field name="arch" type="xml">
            <form string="Sign Now - Upload PDF">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Agreement or Contract"/>
                        <field name="document_filename" invisible="1"/>
                        <field name="document" filename="document_filename" widget="binary" string="Upload PDF Document"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_upload_and_design" string="Upload &amp; Design" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: Sign Now -->
    <record id="action_wm_signature_sign_now_wizard" model="ir.actions.act_window">
        <field name="name">Sign Now</field>
        <field name="res_model">wm.signature.sign.now.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
