<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Information dialog of the paid add-ons -->
    <record id="view_wm_premium_feature_wizard_form" model="ir.ui.view">
        <field name="name">wm.premium.feature.wizard.form</field>
        <field name="model">wm.premium.feature.wizard</field>
        <field name="arch" type="xml">
            <form string="Premium Add-on" create="false" edit="false">
                <div class="wm_premium_dialog">
                    <field name="feature" invisible="1"/>
                    <field name="module_name" invisible="1"/>
                    <span class="wm_premium_pill">
                        <i class="fa fa-star me-1"/>Premium
                    </span>
                    <h1 class="wm_premium_title"><field name="title" readonly="1" nolabel="1"/></h1>
                    <p class="wm_premium_summary"><field name="summary" readonly="1" nolabel="1"/></p>
                    <div class="wm_premium_notice">
                        <i class="fa fa-lock me-1" title="Locked"/>
                        <strong>This is a paid add-on.</strong>
                        It is not part of the free Waste Management modules. Once it is installed,
                        this menu opens the feature directly.
                    </div>
                    <div class="wm_premium_details">
                        <field name="details" readonly="1" nolabel="1"/>
                    </div>
                </div>
                <footer>
                    <button string="Get this add-on" type="object" name="action_get_addon"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Close" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wm_premium_subscription" model="ir.actions.act_window">
        <field name="name">Customer Subscriptions</field>
        <field name="res_model">wm.premium.feature.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_feature': 'subscription'}</field>
    </record>

    <record id="action_wm_premium_driver_app" model="ir.actions.act_window">
        <field name="name">Driver Mobile App</field>
        <field name="res_model">wm.premium.feature.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_feature': 'driver_app'}</field>
    </record>

    <record id="action_wm_premium_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">wm.premium.feature.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_feature': 'subscription_plan'}</field>
    </record>

</odoo>
