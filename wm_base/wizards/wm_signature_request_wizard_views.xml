<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.signature.request.wizard - wm.signature.request.wizard.form (Form) -->
    <record id="view_wm_signature_request_wizard_form" model="ir.ui.view">
        <field name="name">wm.signature.request.wizard.form</field>
        <field name="model">wm.signature.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Signature Request">
                <sheet>
                    <group>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="template_id" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Configure Signers" name="signers">
                            <field name="signer_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="role_id"/>
                                    <field name="partner_id"/>
                                    <field name="email" required="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Send Request" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: Send Signature Request -->
    <record id="action_wm_signature_request_wizard" model="ir.actions.act_window">
        <field name="name">Send Signature Request</field>
        <field name="res_model">wm.signature.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
