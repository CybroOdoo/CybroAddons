<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Mail Template: Signature Request: Invitation to Sign -->
        <record id="mail_template_signature_request" model="mail.template">
            <field name="name">Signature Request: Invitation to Sign</field>
            <field name="model_id" ref="wm_base.model_wm_signature_request"/>
            <field name="subject">Signature Request: {{ object.template_id.name }} (Ref: {{ object.name }})</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.5; color: #333333;">
                    <p>Hello,</p>
                    <p>You have been requested to sign the document: <strong><t t-out="object.template_id.name"/></strong> (Reference: <t t-out="object.name"/>).</p>
                    <p>Please click the button below to view the document and sign electronically:</p>
                    <p style="margin: 24px 0;">
                        <a t-att-href="object._get_signer_url(ctx.get('signer_id'))" 
                           style="background-color: #007bff; padding: 12px 24px; text-decoration: none; color: #ffffff; border-radius: 4px; font-weight: bold; display: inline-block;">
                            Review &amp; Sign
                        </a>
                    </p>
                    <p>If the button doesn't work, you can copy and paste the following link into your browser:</p>
                    <p>
                        <a t-att-href="object._get_signer_url(ctx.get('signer_id'))">
                            <t t-out="object._get_signer_url(ctx.get('signer_id'))"/>
                        </a>
                    </p>
                    <br/>
                    <p>Thank you,</p>
                    <p><strong><t t-out="object.create_uid.name"/></strong></p>
                </div>
            </field>
        </record>
    </data>
</odoo>
