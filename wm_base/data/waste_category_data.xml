<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record: wm.waste.category - General Waste -->
        <record id="waste_category_general" model="wm.waste.category">
            <field name="name">General Waste</field>
            <field name="code">GEN</field>
            <field name="warm_factor_co2">0.75</field>
        </record>
        <!-- Record: wm.waste.category - Recyclables -->
        <record id="waste_category_recycle" model="wm.waste.category">
            <field name="name">Recyclables</field>
            <field name="code">REC</field>
            <field name="warm_factor_co2">3.10</field>
            <field name="description">Clean, dry materials suitable for reprocessing: plastics, paper, cardboard, glass and metals. High recovery potential with proper sorting.</field>
        </record>
        <!-- Record: wm.waste.category - Organic Waste -->
        <record id="waste_category_organic" model="wm.waste.category">
            <field name="name">Organic Waste</field>
            <field name="code">ORG</field>
            <field name="warm_factor_co2">0.55</field>
            <field name="description">Food scraps, garden trimmings and other organic matter that can be composted or converted to biogas. Generally non-hazardous and high in volume.</field>
        </record>
        <!-- Record: wm.waste.category - Hazardous Waste -->
        <record id="waste_category_hazard" model="wm.waste.category">
            <field name="name">Hazardous Waste</field>
            <field name="code">HAZ</field>
            <field name="warm_factor_co2">2.80</field>
        </record>
    </data>
</odoo>
