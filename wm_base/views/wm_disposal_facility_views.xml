<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.disposal.facility - List -->
    <record id="view_wm_disposal_facility_list" model="ir.ui.view">
        <field name="name">wm.disposal.facility.list</field>
        <field name="model">wm.disposal.facility</field>
        <field name="arch" type="xml">
            <list string="Disposal Facilities">
                <field name="name"/>
                <field name="facility_type"/>
                <field name="license_no"/>
                <field name="license_authority"/>
                <field name="contact_email"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- View: wm.disposal.facility - Form -->
    <record id="view_wm_disposal_facility_form" model="ir.ui.view">
        <field name="name">wm.disposal.facility.form</field>
        <field name="model">wm.disposal.facility</field>
        <field name="arch" type="xml">
            <form string="Disposal Facility">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Facility Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="facility_type"/>
                            <field name="license_no"/>
                            <field name="license_authority"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="contact_email"/>
                            <field name="address"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View: wm.disposal.facility - Search -->
    <record id="view_wm_disposal_facility_search" model="ir.ui.view">
        <field name="name">wm.disposal.facility.search</field>
        <field name="model">wm.disposal.facility</field>
        <field name="arch" type="xml">
            <search string="Search Disposal Facilities">
                <field name="name"/>
                <field name="license_no"/>
                <field name="license_authority"/>
                <filter string="Landfill" name="landfill" domain="[('facility_type', '=', 'landfill')]"/>
                <filter string="Incineration" name="incineration" domain="[('facility_type', '=', 'incineration')]"/>
                <filter string="Recycling" name="recycling" domain="[('facility_type', '=', 'recycling')]"/>
                <filter string="Treatment" name="treatment" domain="[('facility_type', '=', 'treatment')]"/>
                <group>
                    <filter string="Facility Type" name="group_by_facility_type" context="{'group_by': 'facility_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Disposal Facilities -->
    <record id="action_wm_disposal_facility" model="ir.actions.act_window">
        <field name="name">Disposal Facilities</field>
        <field name="res_model">wm.disposal.facility</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new waste disposal or treatment facility.
            </p>
        </field>
    </record>

    <!-- Menu: Disposal Facilities -->
    <menuitem id="menu_wm_disposal_facility"
              name="Disposal Facilities"
              parent="menu_wm_master_data"
              action="action_wm_disposal_facility"
              sequence="50"/>
</odoo>
