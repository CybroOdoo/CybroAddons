<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.container.type - wm.container.type.list (List) -->
    <record id="view_wm_container_type_list" model="ir.ui.view">
        <field name="name">wm.container.type.list</field>
        <field name="model">wm.container.type</field>
        <field name="arch" type="xml">
            <list string="Container Types">
                <field name="name"/>
                <field name="code"/>
                <field name="capacity"/>
                <field name="default_tare_weight"/>
                <field name="capacity_weight" optional="hide"/>
                <field name="category_ids" widget="many2many_tags" optional="show"/>
                <field name="is_hazardous_suitable" optional="show" widget="boolean_toggle"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <!-- View: wm.container.type - wm.container.type.form (Form) -->
    <record id="view_wm_container_type_form" model="ir.ui.view">
        <field name="name">wm.container.type.form</field>
        <field name="model">wm.container.type</field>
        <field name="arch" type="xml">
            <form string="Container Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 240L Wheelie Bin"/></h1>
                    </div>
                    <group>
                        <group name="specs" string="Capacity &amp; Weight Specifications">
                            <field name="code"/>
                            <field name="capacity"/>
                            <field name="default_tare_weight"/>
                            <field name="capacity_weight"/>
                        </group>
                        <group name="suitability" string="Categories &amp; Suitability">
                            <field name="category_ids"
                                   widget="many2many_tags"
                                   string="Applicable Waste Categories"
                                   options="{'color_field': 'active'}"
                                   placeholder="Select applicable waste categories…"/>
                            <field name="is_hazardous_suitable" string="Suitable for Hazardous Waste"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Optional container description or handling instructions…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action: Container Types -->
    <record id="action_wm_container_type" model="ir.actions.act_window">
        <field name="name">Container Types</field>
        <field name="res_model">wm.container.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu: Container Types -->
    <menuitem id="menu_wm_container_type" name="Container Types" parent="wm_base.menu_wm_config" action="action_wm_container_type" sequence="20"/>
</odoo>
