<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: product.template - product.template.form.inherit.wm.base (Xpath) -->
    <record id="view_product_template_form_inherit_wm_base" model="ir.ui.view">
        <field name="name">product.template.form.inherit.wm.base</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_waste_material"/>
                    <label for="is_waste_material"/>
                </span>
            </xpath>
        </field>
    </record>

</odoo>
