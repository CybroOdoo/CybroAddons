<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.signature.template - wm.signature.template.list (List) -->
    <record id="view_wm_signature_template_list" model="ir.ui.view">
        <field name="name">wm.signature.template.list</field>
        <field name="model">wm.signature.template</field>
        <field name="arch" type="xml">
            <list string="Signature Templates">
                <field name="name"/>
                <field name="role_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- View: wm.signature.template - wm.signature.template.form (Form) -->
    <record id="view_wm_signature_template_form" model="ir.ui.view">
        <field name="name">wm.signature.template.form</field>
        <field name="model">wm.signature.template</field>
        <field name="arch" type="xml">
            <form string="Signature Template">
                <header>
                    <button name="action_design_template" string="Design Template" type="object" class="oe_highlight" icon="fa-pencil" invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Service Agreement"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_filename" invisible="1"/>
                            <field name="document" filename="document_filename" widget="binary"/>
                            <field name="role_ids" widget="many2many_tags" placeholder="Add required signer roles..."/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Describe what this template is used for..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action: Signature Templates -->
    <record id="action_wm_signature_template" model="ir.actions.act_window">
        <field name="name">Signature Templates</field>
        <field name="res_model">wm.signature.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
