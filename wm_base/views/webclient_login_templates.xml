<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template: web.login_layout -->
    <template id="wm_login_layout" inherit_id="web.login_layout" name="Waste Management Login Brand Mark">
        <xpath expr="//div[hasclass('text-center')][hasclass('border-bottom')]" position="replace">
            <div class="text-center pb-3 border-bottom mb-4 wm-login-brand-header">
                <div class="d-inline-flex align-items-center justify-content-center mb-2" style="width: 52px; height: 52px; background: #2E7D32; border-radius: 12px; box-shadow: 0 4px 10px rgba(46,125,50,0.3);">
                    <i class="fa fa-recycle text-white fs-2"/>
                </div>
                <h4 class="fw-bold m-0" style="color: #1F2235; font-size: 18px;">Waste Management</h4>
                <span class="text-muted small">Operations &amp; Management Suite</span>
            </div>
        </xpath>
    </template>
</odoo>
