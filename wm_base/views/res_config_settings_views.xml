<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: res.config.settings - res.config.settings.view.form.inherit.wm.base (Xpath) -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.wm.base</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Waste Management" string="Waste Management" name="wm_base">

                    <block title="Compliance Configuration" name="wm_compliance_setting_container">
                        <setting id="module_wm_compliance" string="Compliance Management" help="Install and enable regulatory tracking, hazardous waste manifests, chain of custody, and compliance certificates.">
                            <field name="module_wm_compliance"/>
                        </setting>
                        <setting string="Audit Trail" help="Enable immutable audit logging for all compliance records">
                            <field name="group_wm_audit_trail"/>
                        </setting>
                    </block>
                    <block title="Recycling Management" name="wm_recycling_setting_container">
                        <setting id="module_wm_recycling" string="Recycling" help="Install and enable recycling orders, material recovery tracking, and processing features.">
                            <field name="module_wm_recycling"/>
                        </setting>
                    </block>
                    <block title="Premium Features" name="wm_premium_setting_container">
                        <div class="wm_premium_cards">
                            <div class="wm_premium_card_wrap">
                                <field name="module_wm_subscription"/>
                                <div class="wm_premium_card">
                                    <div class="wm_premium_card_head">
                                        <span class="wm_premium_crown"><i class="fa fa-diamond"/></span>
                                        <div class="wm_premium_card_title">Subscriptions &amp; Recurring Billing</div>
                                    </div>
                                    <div class="wm_premium_card_text">Recurring customer plans with weight quotas, automatic cycle invoices and renewals.</div>
                                    <div class="wm_premium_card_foot">
                                        <span class="wm_premium_pill"><i class="fa fa-star me-1"/>Premium</span>
                                        <button name="%(wm_base.action_wm_premium_subscription)d" type="action" string="Learn more"
                                                class="wm_premium_learn" invisible="module_wm_subscription"/>
                                        <span class="wm_premium_installed_label" invisible="not module_wm_subscription">
                                            <i class="fa fa-check me-1"/>Installed
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="wm_premium_card_wrap">
                                <field name="module_wm_driver_app"/>
                                <div class="wm_premium_card">
                                    <div class="wm_premium_card_head">
                                        <span class="wm_premium_crown"><i class="fa fa-diamond"/></span>
                                        <div class="wm_premium_card_title">Driver Mobile App</div>
                                    </div>
                                    <div class="wm_premium_card_text">Offline-first app for drivers to log every stop, with GPS and automatic sync.</div>
                                    <div class="wm_premium_card_foot">
                                        <span class="wm_premium_pill"><i class="fa fa-star me-1"/>Premium</span>
                                        <button name="%(wm_base.action_wm_premium_driver_app)d" type="action" string="Learn more"
                                                class="wm_premium_learn" invisible="module_wm_driver_app"/>
                                        <span class="wm_premium_installed_label" invisible="not module_wm_driver_app">
                                            <i class="fa fa-check me-1"/>Installed
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    
    <!-- Action: Settings -->
    <record id="action_wm_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'wm_base', 'bin_size': False}</field>
    </record>
</odoo>
