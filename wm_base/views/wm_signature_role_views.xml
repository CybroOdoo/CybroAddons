<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.signature.role - wm.signature.role.list (List) -->
    <record id="view_wm_signature_role_list" model="ir.ui.view">
        <field name="name">wm.signature.role.list</field>
        <field name="model">wm.signature.role</field>
        <field name="arch" type="xml">
            <list string="Signature Roles" editable="bottom">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- View: wm.signature.role - wm.signature.role.form (Form) -->
    <record id="view_wm_signature_role_form" model="ir.ui.view">
        <field name="name">wm.signature.role.form</field>
        <field name="model">wm.signature.role</field>
        <field name="arch" type="xml">
            <form string="Signature Role">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Signature Roles -->
    <record id="action_wm_signature_role" model="ir.actions.act_window">
        <field name="name">Signature Roles</field>
        <field name="res_model">wm.signature.role</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
