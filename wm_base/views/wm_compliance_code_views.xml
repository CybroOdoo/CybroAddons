<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.compliance.code - wm.compliance.code.list (List) -->
    <record id="view_wm_compliance_code_list" model="ir.ui.view">
        <field name="name">wm.compliance.code.list</field>
        <field name="model">wm.compliance.code</field>
        <field name="arch" type="xml">
            <list string="Compliance Codes">
                <field name="name"/>
                <field name="manifest_type"/>
                <field name="regulatory_body"/>
            </list>
        </field>
    </record>

    <!-- View: wm.compliance.code - wm.compliance.code.form (Form) -->
    <record id="view_wm_compliance_code_form" model="ir.ui.view">
        <field name="name">wm.compliance.code.form</field>
        <field name="model">wm.compliance.code</field>
        <field name="arch" type="xml">
            <form string="Compliance Code">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Code Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="manifest_type"/>
                            <field name="regulatory_body"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action: Compliance Codes -->
    <record id="action_wm_compliance_code" model="ir.actions.act_window">
        <field name="name">Compliance Codes</field>
        <field name="res_model">wm.compliance.code</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
