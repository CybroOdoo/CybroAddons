<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: product.product - product.product.waste.list (List) -->
    <record id="view_wm_waste_material_list" model="ir.ui.view">
        <field name="name">product.product.waste.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Waste Materials">
                <field name="name"/>
                <field name="wm_waste_category_id"/>
                <field name="hazardous"/>
            </list>
        </field>
    </record>

    <!-- View: product.product - product.product.waste.form (Form) -->
    <record id="view_wm_waste_material_form" model="ir.ui.view">
        <field name="name">product.product.waste.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form string="Waste Material">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Material Name"/>
                        <h1><field name="name" placeholder="Material Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="wm_waste_category_id"/>
                        </group>
                        <group>
                            <field name="hazardous"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="type" invisible="1" readonly="0"/>
                            <field name="is_waste_material" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- View: product.product - product.product.waste.search (Search) -->
    <record id="view_wm_waste_material_search" model="ir.ui.view">
        <field name="name">product.product.waste.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Search Waste Materials">
                <field name="name"/>
                <field name="wm_waste_category_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- View: product.template - product.template.form.inherit.waste (Notebook) -->
    <record id="product_template_form_view_waste" model="ir.ui.view">
        <field name="name">product.template.form.inherit.waste</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Waste Management" name="waste_management" invisible="not is_waste_material">
                    <group>
                        <group>
                            <field name="wm_waste_category_id"/>
                        </group>
                        <group>
                            <field name="hazardous"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Action: Waste Materials -->
    <record id="action_wm_waste_material" model="ir.actions.act_window">
        <field name="name">Waste Materials</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_wm_waste_material_list"/>
        <field name="domain">[('is_waste_material', '=', True)]</field>
        <field name="context">{'default_is_waste_material': True, 'default_type': 'consu'}</field>
    </record>

    <!-- Menu: Waste Materials -->
    <menuitem id="menu_wm_waste_material" name="Waste Materials" parent="menu_wm_master_data" action="action_wm_waste_material" sequence="20"/>
</odoo>
