<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.category.billing.rule - List -->
    <record id="view_wm_category_billing_rule_list" model="ir.ui.view">
        <field name="name">wm.category.billing.rule.list</field>
        <field name="model">wm.category.billing.rule</field>
        <field name="arch" type="xml">
            <list string="Category Billing Rules">
                <field name="category_id"/>
                <field name="partner_id"/>
                <field name="billing_basis"/>
                <field name="price"/>
                <field name="min_weight"/>
                <field name="min_charge"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <!-- View: wm.category.billing.rule - Form -->
    <record id="view_wm_category_billing_rule_form" model="ir.ui.view">
        <field name="name">wm.category.billing.rule.form</field>
        <field name="model">wm.category.billing.rule</field>
        <field name="arch" type="xml">
            <form string="Category Billing Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="partner_id"/>
                            <field name="billing_basis"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="min_weight"/>
                            <field name="min_charge"/>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View: wm.category.billing.rule - Search -->
    <record id="view_wm_category_billing_rule_search" model="ir.ui.view">
        <field name="name">wm.category.billing.rule.search</field>
        <field name="model">wm.category.billing.rule</field>
        <field name="arch" type="xml">
            <search string="Search Billing Rules">
                <field name="category_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Per KG" name="per_kg" domain="[('billing_basis', '=', 'per_kg')]"/>
                <filter string="Flat per Collection" name="flat" domain="[('billing_basis', '=', 'flat_per_collection')]"/>
                <filter string="Per m³" name="per_m3" domain="[('billing_basis', '=', 'per_m3')]"/>
                <group>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Billing Basis" name="group_by_basis" context="{'group_by': 'billing_basis'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Category Billing Rules -->
    <record id="action_wm_category_billing_rule" model="ir.actions.act_window">
        <field name="name">Category Billing Rules</field>
        <field name="res_model">wm.category.billing.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new category billing rule.
            </p>
        </field>
    </record>

    <!-- Menu: Category Billing Rules -->
    <menuitem id="menu_wm_category_billing_rule"
              name="Category Billing Rules"
              parent="menu_wm_master_data"
              action="action_wm_category_billing_rule"
              sequence="60"/>
</odoo>
