<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.signature.request - wm.signature.request.list (List) -->
    <record id="view_wm_signature_request_list" model="ir.ui.view">
        <field name="name">wm.signature.request.list</field>
        <field name="model">wm.signature.request</field>
        <field name="arch" type="xml">
            <list string="Signature Requests" decoration-info="state == 'draft'" decoration-warning="state == 'sent'" decoration-success="state == 'signed'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="template_id"/>
                <field name="reference_doc"/>
                <field name="date_requested"/>
                <field name="date_signed"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'sent'" decoration-success="state == 'signed'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- View: wm.signature.request - wm.signature.request.form (Form) -->
    <record id="view_wm_signature_request_form" model="ir.ui.view">
        <field name="name">wm.signature.request.form</field>
        <field name="model">wm.signature.request</field>
        <field name="arch" type="xml">
            <form string="Signature Request">
                <header>
                    <button name="action_send" type="object" string="Send Request" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel Request" invisible="state in ('signed', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id" readonly="state != 'draft'"/>
                            <field name="reference_doc" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_requested"/>
                            <field name="date_signed" invisible="state != 'signed'"/>
                            <field name="signed_document_filename" invisible="1"/>
                            <field name="signed_document" filename="signed_document_filename" widget="binary" invisible="state != 'signed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Signers" name="signers">
                            <field name="signer_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="role_id"/>
                                    <field name="partner_id"/>
                                    <field name="email"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'sent'" decoration-success="state == 'signed'"/>
                                    <field name="signed_date" readonly="1"/>
                                    <field name="ip_address" readonly="1"/>
                                    <button name="action_sign_signer" type="object" string="Sign" class="btn-primary" invisible="state == 'signed'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- View: wm.signature.request.signer - wm.signature.request.signer.list (List) -->
    <record id="view_wm_signature_request_signer_list" model="ir.ui.view">
        <field name="name">wm.signature.request.signer.list</field>
        <field name="model">wm.signature.request.signer</field>
        <field name="arch" type="xml">
            <list string="Signers" create="false" edit="false">
                <field name="request_id"/>
                <field name="partner_id"/>
                <field name="role_id"/>
                <field name="email"/>
                <field name="state" widget="badge" decoration-warning="state == 'sent'" decoration-success="state == 'signed'"/>
                <field name="signed_date"/>
                <field name="ip_address"/>
                <button name="action_sign_signer" type="object" class="btn btn-primary" string="Sign Now" invisible="state == 'signed'"/>
            </list>
        </field>
    </record>

    <!-- View: wm.signature.request.signer - wm.signature.request.signer.form (Form) -->
    <record id="view_wm_signature_request_signer_form" model="ir.ui.view">
        <field name="name">wm.signature.request.signer.form</field>
        <field name="model">wm.signature.request.signer</field>
        <field name="arch" type="xml">
            <form string="Signer" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="partner_id"/>
                            <field name="role_id"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="state"/>
                            <field name="signed_date"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Signature Requests -->
    <record id="action_wm_signature_request" model="ir.actions.act_window">
        <field name="name">Signature Requests</field>
        <field name="res_model">wm.signature.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
