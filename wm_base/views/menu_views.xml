<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu -->
    <menuitem id="menu_wm_root" name="Waste Management" sequence="10" web_icon="wm_base,static/description/icon.png"/>

    <!-- Dashboard Menu -->
    <menuitem id="menu_wm_dashboard" name="Dashboard" parent="menu_wm_root" action="action_wm_dashboard" sequence="1"/>
    <record id="menu_wm_dashboard" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('wm_base.group_wm_dispatcher'),
            ref('wm_base.group_wm_finance'),
            ref('wm_base.group_wm_compliance_officer'),
            ref('wm_base.group_wm_ops_manager'),
            ref('wm_base.group_wm_admin'),
        ])]"/>
    </record>

    <!-- Operations Menu -->
    <menuitem id="menu_wm_operations" name="Operations" parent="menu_wm_root" sequence="10"/>

    <!-- Reporting Menu -->
    <menuitem id="menu_wm_reporting" name="Reporting" parent="menu_wm_root" sequence="90" groups="wm_base.group_wm_dispatcher,wm_base.group_wm_inventory_operator,wm_base.group_wm_finance,wm_base.group_wm_ops_manager,wm_base.group_wm_admin"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_wm_config" name="Configuration" parent="menu_wm_root" sequence="100"/>

    
    <!-- Waste Master Data -->
    <menuitem id="menu_wm_master_data" name="Master Data" parent="menu_wm_config" sequence="10" groups="wm_base.group_wm_ops_manager,wm_base.group_wm_admin"/>
    
    <!-- Settings Menu -->
    <menuitem id="menu_wm_settings" name="Settings" parent="menu_wm_config" action="action_wm_config_settings" sequence="1" groups="wm_base.group_wm_admin"/>
</odoo>
