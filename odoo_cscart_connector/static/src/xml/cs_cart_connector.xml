<templates xml:space="preserve">

<t t-name="odoo_cscart_connector.CsCartConnector">
    <div class="o_cs_cart_connector">

    <div class="o_cs_cart_header">
        <h1>CS-Cart Connector</h1>
        <p class="text-muted">
            Import and export data between Odoo and CS-Cart
        </p>
    </div>

        <div class="o_cs_cart_grid_wrapper">
            <div class="o_cs_cart_grid">

                <div class="o_cs_cart_card o_orders" t-on-click="importOrders">
                    <i class="fa fa-shopping-cart"/>
                    <h3>Import Orders</h3>
                    <span>Sync all CS-Cart orders into Odoo</span>
                </div>

                <div class="o_cs_cart_card o_products" t-on-click="importProducts">
                    <i class="fa fa-cubes"/>
                    <h3>Import Products</h3>
                    <span>Fetch products from CS-Cart</span>
                </div>

                <div class="o_cs_cart_card o_customers" t-on-click="importCustomers">
                    <i class="fa fa-users"/>
                    <h3>Import Customers</h3>
                    <span>Sync CS-Cart customers</span>
                </div>

                <div class="o_cs_cart_card o_vendors" t-on-click="importVendors">
                    <i class="fa fa-industry"/>
                    <h3>Import Vendors</h3>
                    <span>Fetch vendors from CS-Cart</span>
                </div>

            </div>
        </div>
    </div>
</t>

</templates>
