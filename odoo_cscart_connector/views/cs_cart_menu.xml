<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_cscart_root" name="CS-Cart" sequence="10"/>

    <!-- Instance Menu -->
    <menuitem id="menu_cscart_config" name="Instances" parent="menu_cscart_root" action="action_cs_cart_config" sequence="10"/>
    
    <!-- Import Batches Menu -->
    <menuitem id="menu_cscart_import_batch" name="Import Batches" parent="menu_cscart_root" action="action_cs_cart_import_batch" sequence="20"/>

    <!-- Synced Mappings Actions -->
    <record id="action_cscart_products" model="ir.actions.act_window">
        <field name="name">CS-Cart Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cs_cart_product_id', '!=', False)]</field>
    </record>

    <record id="action_cscart_orders" model="ir.actions.act_window">
        <field name="name">CS-Cart Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cs_cart_order_id', '!=', False)]</field>
    </record>

    <record id="action_cscart_customers" model="ir.actions.act_window">
        <field name="name">CS-Cart Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cs_cart_user_id', '!=', False)]</field>
    </record>

    <!-- Mappings Menu Category -->
    <menuitem id="menu_cscart_mappings" name="Synced Data" parent="menu_cscart_root" sequence="30"/>
    <menuitem id="menu_cscart_products" name="Products" parent="menu_cscart_mappings" action="action_cscart_products" sequence="10"/>
    <menuitem id="menu_cscart_orders" name="Orders" parent="menu_cscart_mappings" action="action_cscart_orders" sequence="20"/>
    <menuitem id="menu_cscart_customers" name="Customers" parent="menu_cscart_mappings" action="action_cscart_customers" sequence="30"/>
</odoo>
