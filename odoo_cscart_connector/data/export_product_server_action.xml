<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_export_product_template_to_cs_cart" model="ir.actions.server">
        <field name="name">Export to CS-Cart</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_export_to_cs_cart()
        </field>
    </record>
    <record id="action_export_product_product_to_cs_cart" model="ir.actions.server">
        <field name="name">Export to CS-Cart</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_export_to_cs_cart()
        </field>
    </record>
</odoo>
