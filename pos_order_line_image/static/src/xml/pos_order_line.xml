<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
<!--    Pass showImage=true to OrderSummary's Orderline to enable built-in product image display -->
    <t t-name="pos_order_line_image.OrderSummary" t-inherit="point_of_sale.OrderSummary"
       t-inherit-mode="extension">
        <xpath expr="//Orderline" position="attributes">
            <attribute name="showImage">true</attribute>
        </xpath>
    </t>
</templates>
