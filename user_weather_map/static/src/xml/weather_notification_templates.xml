<?xml version="1.0" encoding="UTF-8"?>
<templates id="template">
    <!-- Template for weather notification -->
    <t t-name="systrayWeatherMenu">
        <Dropdown>
            <button>
                <i class="oi oi-large" data-icon="cloud" role="img" aria-label="Weather" title="Weather"/>
            </button>
            <t t-set-slot="content">
                <div t-if="this.state.weather_data and this.state.weather_data.main" class="o_weather_card_wrap">
                    <!-- Weather card container -->
                    <div class="card">
                        <img class="px-1"
                             src="/user_weather_map/static/src/img/weather_card.jpg"
                             alt="Weather"/>
                        <div class="card-img-overlay o_weather_card_overlay">
                            <h3 class="card-title text-white mb-0">
                                <span t-out="this.state.weather_data.name"/>
                            </h3>
                            <small class="card-text text-white fw-light" t-if="this.state.weather_data.weather and this.state.weather_data.weather.length">
                                <span t-out="this.state.weather_data.weather[0].main"/>
                            </small>
                        </div>
                        <div class="card-body">
                            <!-- Temperature and description -->
                            <h2 class="fw-light text-info"
                                t-if="this.state.weather_data.main and this.state.weather_data.main.temp">
                                <span t-out="Math.round(this.state.weather_data.main.temp - 273.15)"/>°C
                            </h2>
                            <small t-if="this.state.weather_data.weather and this.state.weather_data.weather.length">
                                <span t-out="this.state.weather_data.weather[0].description"/>
                            </small>
                        </div>
                    </div>
                </div>
                <div t-else="" class="alert alert-warning o_weather_warning" role="alert">
                    <i class="oi oi-fw" data-icon="warning" role="img" aria-label="Warning" title="Warning"/>
                    <strong>Warning!</strong>
                    Please configure your API key and Location in the Weather
                    settings.
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
