<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Header nav (desktop + mobile overlay) is built dynamically in
             views/layout.xml from website.menu_id.child_id, so the menu
             order and URLs live here, not hardcoded in the template.
             website.menu is sorted by (sequence, id), so the gap-of-10
             sequence below is what fixes the header order:
             Home -> About -> Services -> Trainers -> Membership -> Contact -->

        <!-- Website already ships a default "Home" menu; just re-point its
             sequence so it stays first in this order. -->
        <record id="website.menu_home" model="website.menu">
            <field name="name">Home</field>
            <field name="url">/</field>
            <field name="sequence">10</field>
        </record>

        <record id="menu_about" model="website.menu">
            <field name="name">About</field>
            <field name="url">/aboutus</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
        </record>

        <record id="menu_services" model="website.menu">
            <field name="name">Services</field>
            <field name="url">/services</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">30</field>
        </record>

        <record id="menu_trainers" model="website.menu">
            <field name="name">Trainers</field>
            <field name="url">/trainers</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">40</field>
        </record>

        <record id="menu_membership" model="website.menu">
            <field name="name">Membership</field>
            <field name="url">/membership</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">50</field>
        </record>

        <!-- Website already ships a default "Contact us" menu; re-point it
             at PowerFit's own /contactus page/route, relabel it to match
             the header ("Contact"), and keep it last in the order. -->
        <record id="website.menu_contactus" model="website.menu">
            <field name="name">Contact</field>
            <field name="url">/contactus</field>
            <field name="sequence">60</field>
        </record>

    </data>
</odoo>
