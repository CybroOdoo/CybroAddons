<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="powerfit_trainers_page" name="Trainers">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
            <section class="page-banner page-banner--trainers o_colored_level oe_structure" data-snippet="theme_powerfit.s_powerfit_trainers_1" data-name="PowerFit Trainers 1">
               <div class="container oe_structure">
               <div class="eyebrow o_default_snippet_text">Meet the Team</div>
               <h1 class="page-banner-title o_default_snippet_text">Expert <span style="color:var(--accent)" class="o_default_snippet_text">Trainers</span></h1>
               <nav class="breadcrumb" aria-label="Breadcrumb">
                <a href="/" class="o_default_snippet_text">Home</a>
                <span class="o_default_snippet_text">/</span>
                <span class="breadcrumb-current o_default_snippet_text">Trainers</span>
               </nav>
               </div>
            </section>
             <section class="section " data-snippet="theme_powerfit.s_powerfit_trainers_2" data-name="PowerFit Trainers 2">
            <div class="container oe_structure">
             <div class="section-header reveal from-bottom">
              <div class="eyebrow">Our Coaches</div>
              <h2 class="section-title">World-Class <span>Expertise</span></h2>
              <p class="section-subtitle">Our certified trainers are dedicated to helping you achieve your fitness goals safely, effectively, and sustainably. Hover to discover each trainer's story.</p>
             </div>

             <!-- ══════════════════════════════════════════════════════
    STATIC ARCH — always the same fixed set of nodes so the website
    editor can reliably locate/remove/duplicate this and sibling
    sections. Real trainer data (if any) is fetched and swapped in
    client-side by PowerfitCore._fetchTrainers() in powerfit_core.js
    via GET /theme_powerfit/trainers/data. No t-if/t-foreach here.
                  ══════════════════════════════════════════════════════ -->
              <div class="trainers-grid" id="trainersGrid">
               <div class="trainer-card reveal from-bottom reveal-delay-1">
                <div class="trainer-img">
                 <img src="/theme_powerfit/static/src/img/snippets/trainer_default.png" alt="Alex Carter"/>
                 <div class="trainer-overlay"></div>
                 <div class="trainer-social">
                  <a href="https://instagram.com/" aria-label="Instagram"><iconify-icon icon="ph:instagram-logo-fill"></iconify-icon></a>
                  <a href="https://twitter.com/" aria-label="Twitter"><iconify-icon icon="ph:twitter-logo-fill"></iconify-icon></a>
                  <a href="https://linkedin.com/" aria-label="LinkedIn"><iconify-icon icon="ph:linkedin-logo-fill"></iconify-icon></a>
                 </div>
                 <div class="trainer-info">
                  <span class="trainer-tag">Strength &amp; Conditioning</span>
                  <h3 class="trainer-name">Alex Carter</h3>
                  <div class="trainer-details">
                   <p class="trainer-bio">Former pro athlete with 10+ years of coaching. Specialises in powerlifting, functional strength, and athletic performance.</p>
                   <div class="trainer-achievements">
                    <div class="trainer-ach"><div class="trainer-ach-num">10+</div><div class="trainer-ach-label">Years</div></div>
                    <div class="trainer-ach"><div class="trainer-ach-num">500+</div><div class="trainer-ach-label">Clients</div></div>
                    <div class="trainer-ach"><div class="trainer-ach-num">4.9★</div><div class="trainer-ach-label">Rating</div></div>
                   </div>
                  </div>
                 </div>
                </div>
               </div>
               <div class="trainer-card reveal from-bottom reveal-delay-2">
                <div class="trainer-img">
                 <img src="/theme_powerfit/static/src/img/snippets/bw.png" alt="Maya Johnson"/>
                 <div class="trainer-overlay"></div>
                 <div class="trainer-social">
                  <a href="https://instagram.com/" aria-label="Instagram"><iconify-icon icon="ph:instagram-logo-fill"></iconify-icon></a>
                  <a href="https://twitter.com/" aria-label="Twitter"><iconify-icon icon="ph:twitter-logo-fill"></iconify-icon></a>
                  <a href="https://linkedin.com/" aria-label="LinkedIn"><iconify-icon icon="ph:linkedin-logo-fill"></iconify-icon></a>
                 </div>
                 <div class="trainer-info">
                  <span class="trainer-tag">Yoga &amp; Wellness</span>
                  <h3 class="trainer-name">Maya Johnson</h3>
                  <div class="trainer-details">
                   <p class="trainer-bio">500-hour certified yoga instructor and wellness coach with a deep passion for mindfulness and holistic health transformation.</p>
                   <div class="trainer-achievements">
                    <div class="trainer-ach"><div class="trainer-ach-num">8+</div><div class="trainer-ach-label">Years</div></div>
                    <div class="trainer-ach"><div class="trainer-ach-num">350+</div><div class="trainer-ach-label">Clients</div></div>
                    <div class="trainer-ach"><div class="trainer-ach-num">5.0★</div><div class="trainer-ach-label">Rating</div></div>
                   </div>
                  </div>
                 </div>
                </div>
               </div>
               <div class="trainer-card reveal from-bottom reveal-delay-3">
                <div class="trainer-img">
                 <img src="/theme_powerfit/static/src/img/snippets/trainer2.png" alt="Marcus Lee"/>
                 <div class="trainer-overlay"></div>
                 <div class="trainer-social">
                  <a href="https://instagram.com/" aria-label="Instagram"><iconify-icon icon="ph:instagram-logo-fill"></iconify-icon></a>
                  <a href="https://twitter.com/" aria-label="Twitter"><iconify-icon icon="ph:twitter-logo-fill"></iconify-icon></a>
                  <a href="https://linkedin.com/" aria-label="LinkedIn"><iconify-icon icon="ph:linkedin-logo-fill"></iconify-icon></a>
                 </div>
                 <div class="trainer-info">
                  <span class="trainer-tag">HIIT &amp; Cardio</span>
                  <h3 class="trainer-name">Marcus Lee</h3>
                  <div class="trainer-details">
                   <p class="trainer-bio">Marathon runner and HIIT specialist who brings explosive energy to every session. Specialises in metabolic conditioning.</p>
                   <div class="trainer-achievements">
                    <div class="trainer-ach"><div class="trainer-ach-num">12+</div><div class="trainer-ach-label">Years</div></div>
                    <div class="trainer-ach"><div class="trainer-ach-num">700+</div><div class="trainer-ach-label">Clients</div></div>
                    <div class="trainer-ach"><div class="trainer-ach-num">4.8★</div><div class="trainer-ach-label">Rating</div></div>
                   </div>
                  </div>
                 </div>
                </div>
               </div>
              </div>

            </div>
           </section>
        <section class="final-cta oe_structure" style="min-height:50vh;" data-snippet="theme_powerfit.s_powerfit_trainers_3" data-name="PowerFit Trainers 3">
                 <div class="final-cta-bg">
                  <img src="/theme_powerfit/static/src/img/snippets/train.jpeg" alt="Trainer"/>
                 </div>
                 <div class="final-cta-content reveal from-bottom oe_structure">
                  <div class="final-cta-eyebrow">Work With the Best</div>
                  <h2 class="final-cta-headline" style="font-size:clamp(2.5rem,6vw,5rem);">Book Your <span class="line-accent">Trainer.</span></h2>
                  <p class="final-cta-sub">Get matched with the perfect coach for your goals. Your first consultation is on us.</p>
                  <a href="/contactus" class="btn btn-magnetic">Book a Free Consultation <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
                 </div>
        </section>
            </div>
        </t>
    </template>
</odoo>