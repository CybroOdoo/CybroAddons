<?xml version="1.0" encoding="utf-8"?>
<!-- Product Template Form View – PowerFit Gym Plan Fields -->
<odoo>
    <record id="product_template_view_form_powerfit" model="ir.ui.view">
        <field name="name">product.template.form.powerfit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- ── Add "Gym Plan" checkbox after the Sales span (beside Sales &amp; Purchase) ── -->
            <span name="sale_option" position="after">
                <span name="gym_plan_option" class="d-inline-flex ms-2">
                    <field name="is_gym_plan"/>
                    <label for="is_gym_plan" string="Gym Plan"/>
                </span>
            </span>

            <!-- ── Add dedicated "Membership Details" tab to notebook for Gym Plan products ── -->
            <xpath expr="//notebook" position="inside">
                <page string="Membership Details" name="membership_details_tab" invisible="not is_gym_plan">
                    <group>
                        <group string="Plan Configuration">
                            <field name="gym_plan_category" string="Plan Category"/>
                            <field name="gym_plan_description" placeholder="e.g. Perfect for beginners" string="Plan Description"/>
                        </group>
                    </group>
                    <group string="Membership Features / Details">
                        <field name="membership_details" placeholder="Enter membership details/features (one per line, e.g.:&#10;VIP 24/7 Access&#10;All Equipment &amp; Zones&#10;Unlimited Group Classes)"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
