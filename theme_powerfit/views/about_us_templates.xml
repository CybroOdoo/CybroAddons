<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="powerfit_about_us_page" name="About Us">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
<section class="page-banner page-banner--about" data-snippet="theme_powerfit.s_powerfit_about_1" data-name="PowerFit About 1">
         <div class="container oe_structure">
          <div class="eyebrow">Our Story</div>
          <h1 class="page-banner-title">About <span style="color:var(--accent)">Us</span></h1>
          <nav class="breadcrumb" aria-label="Breadcrumb">
           <a href="/">Home</a>
           <span>/</span>
           <span class="breadcrumb-current">About Us</span>
          </nav>
         </div>
        </section>
    <section class="section" data-snippet="theme_powerfit.s_powerfit_about" data-name="PowerFit About">
             <div class="container oe_structure" id="about">
              <div class="about-grid">
               <div class="about-visual reveal from-left">
                <div class="about-img-wrap">
                 <img src="/theme_powerfit/static/src/img/snippets/img_2.png" alt="PowerFit Gym Interior"/>
                </div>
                <div class="about-badge">
                 <div class="about-badge-num">15+</div>
                 <div class="about-badge-text">Years of Excellence</div>
                </div>
                <div class="about-award">
                 <iconify-icon icon="ph:medal-bold"></iconify-icon>
                 <div>
                  <div class="about-award-title">Award Winning</div>
                  <div class="about-award-sub">Best Gym 2024</div>
                 </div>
                </div>
               </div>
               <div class="about-content reveal from-right oe_structure">
                <div class="section-header section-header--left">
                 <div class="eyebrow">About PowerFit</div>
                 <h2 class="section-title">More Than a <span>Gym</span></h2>
                </div>
                <p class="about-desc">PowerFit was founded with a single mission: to create a space where everyone — from beginners to elite athletes — can push their limits and achieve extraordinary results. Our state-of-the-art facility spans over 20,000 sq ft and features the latest equipment, dedicated zones for every type of training, and an environment that motivates you to be your best self every single day.</p>
                <div class="about-features">
                 <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> Premium Equipment</div>
                 <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> Certified Trainers</div>
                 <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> 24/7 Access</div>
                 <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> Nutrition Guidance</div>
                 <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> Spa &amp; Recovery</div>
                 <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> Personal Programs</div>
                </div>
                <a href="/aboutus" class="btn btn-primary" style="display:inline-flex;">Learn More About Us <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
               </div>
              </div>
             </div>
            </section>
        <section class="section section--alt" data-snippet="theme_powerfit.s_powerfit_about_3" data-name="PowerFit About 3">
                 <div class="container oe_structure">
                  <div class="section-header reveal from-bottom">
                   <div class="eyebrow">Core Values</div>
                   <h2 class="section-title">What <span>Drives Us</span></h2>
                   <p class="section-subtitle">These aren't just words on a wall. These are the principles that dictate every decision, every session, and every interaction.</p>
                  </div>
                  <div class="services-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
                   <div class="service-card reveal from-bottom reveal-delay-1">
                    <div class="service-icon-wrap"><iconify-icon icon="ph:crown-bold"></iconify-icon></div>
                    <h3 class="service-title">Excellence</h3>
                    <p class="service-desc">We refuse to settle for average. From our equipment to our staff, we provide a premium, unparalleled experience.</p>
                   </div>
                   <div class="service-card reveal from-bottom reveal-delay-2">
                    <div class="service-icon-wrap"><iconify-icon icon="ph:users-three-bold"></iconify-icon></div>
                    <h3 class="service-title">Community</h3>
                    <p class="service-desc">When you join PowerFit, you join a family. We support, push, and celebrate each other's victories together.</p>
                   </div>
                   <div class="service-card reveal from-bottom reveal-delay-3">
                    <div class="service-num" style="opacity:0">03</div>
                    <div class="service-icon-wrap"><iconify-icon icon="ph:trend-up-bold"></iconify-icon></div>
                    <h3 class="service-title">Progression</h3>
                    <p class="service-desc">Complacency is the enemy of progress. We constantly evolve our methods to ensure you never hit a plateau.</p>
                   </div>
                  </div>
                 </div>
        </section>
<section class="final-cta" style="min-height:50vh;" data-snippet="theme_powerfit.s_powerfit_about_4" data-name="PowerFit About 4">
         <div class="final-cta-bg">
          <img src="/theme_powerfit/static/src/img/snippets/cycles.jpeg" alt="Training"/>
         </div>
         <div class="final-cta-content reveal from-bottom oe_structure">
          <div class="final-cta-eyebrow">Ready to Join?</div>
          <h2 class="final-cta-headline" style="font-size:clamp(2.5rem,6vw,5rem);">Become Part of <span class="line-accent">The Legacy.</span></h2>
          <p class="final-cta-sub">Your transformation starts the moment you walk through our doors. Take the first step today.</p>
          <a href="/contactus" class="btn btn-magnetic">Join The Community <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
         </div>
        </section>
            </div>
        </t>
    </template>
</odoo>