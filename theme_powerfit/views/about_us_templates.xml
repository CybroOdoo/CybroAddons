<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="powerfit_about_us_page" name="About Us">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
<section class="page-banner page-banner--about" data-snippet="theme_powerfit.s_powerfit_about_1" data-name="PowerFit About 1">
         <div class="container oe_structure">
          <div class="eyebrow">Our Story</div>
          <h1 class="o_editable page-banner-title">About <span class="o_editable" style="color:var(--accent)">PowerFit</span></h1>
          <nav class="breadcrumb" aria-label="Breadcrumb">
           <a class="o_editable" href="/">Home</a>
           <span class="o_editable">/</span>
           <span class="o_editable breadcrumb-current">About Us</span>
          </nav>
         </div>
        </section>
<section class="section" data-snippet="theme_powerfit.s_powerfit_about_2" data-name="PowerFit About 2">
         <div class="container oe_structure">
          <div class="about-grid">
           <div class="about-visual reveal from-left">
            <div class="about-img-wrap">
             <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=800&amp;q=80" alt="PowerFit Gym Interior"/>
            </div>
            <div class="about-badge">
             <div class="about-badge-num">15+</div>
             <div class="about-badge-text">Years of Excellence</div>
            </div>
           </div>
           <div class="about-content reveal from-right oe_structure">
            <div class="section-header section-header--left">
             <div class="eyebrow">Our Legacy</div>
             <h2 class="o_editable section-title">Built on <span class="o_editable">Passion</span> &amp; <span class="o_editable">Results</span></h2>
            </div>
            <p class="o_editable about-desc">Founded in 2009, PowerFit began with a simple mission: to create a space where elite training methodologies were accessible to everyone willing to put in the work.</p>
            <p class="o_editable about-desc">Over the past 15 years, we've grown from a single room of free weights into a state-of-the-art facility, but our core philosophy remains unchanged. We believe in the transformative power of fitness — not just for the body, but for the mind and spirit.</p>
            <div class="about-features" style="margin-top:32px;">
             <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> Uncompromising Quality</div>
             <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> Community First</div>
             <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> Science-Backed Methods</div>
             <div class="about-feature"><iconify-icon icon="ph:check-bold"></iconify-icon> Continuous Evolution</div>
            </div>
           </div>
          </div>
         </div>
        </section>
<section class="section section--alt" data-snippet="theme_powerfit.s_powerfit_about_3" data-name="PowerFit About 3">
         <div class="container oe_structure">
          <div class="section-header reveal from-bottom">
           <div class="eyebrow">Core Values</div>
           <h2 class="o_editable section-title">What <span class="o_editable">Drives Us</span></h2>
           <p class="o_editable section-subtitle">These aren't just words on a wall. These are the principles that dictate every decision, every session, and every interaction.</p>
          </div>
          <div class="services-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
           <div class="service-card reveal from-bottom reveal-delay-1">
            <div class="service-icon-wrap"><iconify-icon icon="ph:crown-bold"></iconify-icon></div>
            <h3 class="o_editable service-title">Excellence</h3>
            <p class="o_editable service-desc">We refuse to settle for average. From our equipment to our staff, we provide a premium, unparalleled experience.</p>
           </div>
           <div class="service-card reveal from-bottom reveal-delay-2">
            <div class="service-icon-wrap"><iconify-icon icon="ph:users-three-bold"></iconify-icon></div>
            <h3 class="o_editable service-title">Community</h3>
            <p class="o_editable service-desc">When you join PowerFit, you join a family. We support, push, and celebrate each other's victories together.</p>
           </div>
           <div class="service-card reveal from-bottom reveal-delay-3">
            <div class="service-num" style="opacity:0">03</div>
            <div class="service-icon-wrap"><iconify-icon icon="ph:trend-up-bold"></iconify-icon></div>
            <h3 class="o_editable service-title">Progression</h3>
            <p class="o_editable service-desc">Complacency is the enemy of progress. We constantly evolve our methods to ensure you never hit a plateau.</p>
           </div>
          </div>
         </div>
        </section>
<section class="final-cta" style="min-height:50vh;" data-snippet="theme_powerfit.s_powerfit_about_4" data-name="PowerFit About 4">
         <div class="final-cta-bg">
          <img src="https://images.unsplash.com/photo-1540497077202-7c8a3999166f?w=1600&amp;q=80" alt="Training"/>
         </div>
         <div class="final-cta-content reveal from-bottom oe_structure">
          <div class="final-cta-eyebrow">Ready to Join?</div>
          <h2 class="o_editable final-cta-headline" style="font-size:clamp(2.5rem,6vw,5rem);">Become Part of <span class="o_editable line-accent">The Legacy.</span></h2>
          <p class="o_editable final-cta-sub">Your transformation starts the moment you walk through our doors. Take the first step today.</p>
          <a href="/contactus" class="o_editable btn btn-magnetic">Join The Community <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
         </div>
        </section>
            </div>
        </t>
    </template>
</odoo>