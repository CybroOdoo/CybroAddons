<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Cta Template -->
<odoo>
  <template id="s_powerfit_cta" name="PowerFit Final CTA">
    <section class="final-cta" data-snippet="theme_powerfit.s_powerfit_cta" data-name="PowerFit Final CTA">
             <div class="final-cta-bg">
              <img src="theme_powerfit/static/src/img/snippets/dumbells.jpeg" alt="Athlete silhouette"/>
             </div>
             <canvas id="particle-canvas"></canvas>
             <div class="final-cta-content reveal from-bottom oe_structure">
              <div class="final-cta-eyebrow">The Time Is Now</div>
              <h2 class="o_editable final-cta-headline">
               Your Future Self<br/>
               <span class="o_editable line-accent">Is Waiting.</span>
              </h2>
              <p class="o_editable final-cta-sub">Stop waiting for the right moment. The only moment that matters is the one you decide to begin. Join PowerFit and become unstoppable.</p>
              <a href="/membership" class="o_editable btn btn-magnetic">
               Start Your Transformation <iconify-icon icon="ph:arrow-right-bold"></iconify-icon>
              </a>
              <div class="final-cta-mini-stats">
               <div class="mini-stat">
                <div class="mini-stat-num">5K+</div>
                <div class="mini-stat-label">Members</div>
               </div>
               <div class="mini-stat">
                <div class="mini-stat-num">50</div>
                <div class="mini-stat-label">Trainers</div>
               </div>
               <div class="mini-stat">
                <div class="mini-stat-num">15</div>
                <div class="mini-stat-label">Yrs Experience</div>
               </div>
               <div class="mini-stat">
                <div class="mini-stat-num">98%</div>
                <div class="mini-stat-label">Satisfaction</div>
               </div>
              </div>
             </div>
            </section>
  </template>
  
  <template id="s_powerfit_cta_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_cta" string="PowerFit Final CTA" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_cta.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>