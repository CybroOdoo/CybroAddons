<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Membership 3 Template -->
<odoo>
  <template id="s_powerfit_membership_3" name="PowerFit Membership 3">
    <section class="section testimonials-bg" data-snippet="theme_powerfit.s_powerfit_membership_3" data-name="PowerFit Membership 3">
         <div class="container oe_structure">
          <div class="section-header reveal from-bottom">
           <div class="eyebrow">Member Stories</div>
           <h2 class="o_editable section-title">Real <span class="o_editable">Results</span></h2>
          </div>
          <div class="testimonials-carousel reveal from-bottom">
           <div class="testimonials-track" id="testimonialsTrack">
            <div class="testimonial-card">
             <div class="testimonial-rating">
              <iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon>
             </div>
             <p class="o_editable testimonial-text">"PowerFit completely transformed how I see fitness. The Standard plan gave me everything I needed — unlimited classes and personal sessions that kept me accountable."</p>
             <div class="testimonial-author">
              <div class="testimonial-avatar"><img src="/theme_powerfit/static/src/img/snippets/user1.png" alt="James Wilson"/></div>
              <div>
               <div class="testimonial-name">James Wilson</div>
               <div class="testimonial-meta">Standard Member · 2 Years</div>
              </div>
             </div>
            </div>
            <div class="testimonial-card">
             <div class="testimonial-rating">
              <iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon>
             </div>
             <p class="o_editable testimonial-text">"The Premium membership is worth every penny. Having unlimited personal training and spa access changed my entire recovery routine. I perform better than ever."</p>
             <div class="testimonial-author">
              <div class="testimonial-avatar"><img src="/theme_powerfit/static/src/img/snippets/user2.png" alt="Sarah Chen"/></div>
              <div>
               <div class="testimonial-name">Sarah Chen</div>
               <div class="testimonial-meta">Premium Member · 1.5 Years</div>
              </div>
             </div>
            </div>
            <div class="testimonial-card">
             <div class="testimonial-rating">
              <iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon>
             </div>
             <p class="o_editable testimonial-text">"Started on Basic, moved to Standard, now Premium. Each upgrade pushed me further. PowerFit meets you where you are and takes you where you want to go."</p>
             <div class="testimonial-author">
              <div class="testimonial-avatar"><img src="/theme_powerfit/static/src/img/snippets/user3.png" alt="David Kumar"/></div>
              <div>
               <div class="testimonial-name">David Kumar</div>
               <div class="testimonial-meta">Premium Member · 3 Years</div>
              </div>
             </div>
            </div>
           </div>
           <div class="carousel-controls">
            <div class="carousel-dots" id="carouselDots">
             <button class="carousel-dot active" data-index="0"></button>
             <button class="carousel-dot" data-index="1"></button>
             <button class="carousel-dot" data-index="2"></button>
            </div>
            <div class="carousel-nav">
             <button class="carousel-btn" id="prevBtn"><iconify-icon icon="ph:arrow-left-bold"></iconify-icon></button>
             <button class="carousel-btn" id="nextBtn"><iconify-icon icon="ph:arrow-right-bold"></iconify-icon></button>
            </div>
           </div>
          </div>
         </div>
        </section>
  </template>
  
  <template id="s_powerfit_membership_3_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_membership_3" string="PowerFit Membership 3" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>