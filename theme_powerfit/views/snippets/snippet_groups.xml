<?xml version="1.0" encoding="utf-8"?>
<!-- Snippet Groups Template -->
<odoo>
    <template id="powerfit_snippet_groups" inherit_id="website.snippets" name="PowerFit Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group" string="PowerFit Sections" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" snippet-group="powerfit_group"/>
        </xpath>
    </template>
</odoo>