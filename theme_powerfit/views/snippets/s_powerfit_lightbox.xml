<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Lightbox Template -->
<odoo>
  <template id="s_powerfit_lightbox" name="PowerFit Lightbox">
    <div class="lightbox" id="lightbox" data-snippet="theme_powerfit.s_powerfit_lightbox" data-name="PowerFit Lightbox">
             <button class="lightbox-close" id="lightboxClose"><iconify-icon icon="ph:x-bold"></iconify-icon></button>
             <img src="" alt="" id="lightboxImg"/>
            </div>
  </template>
  
  <template id="s_powerfit_lightbox_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_lightbox" string="PowerFit Lightbox" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_lightbox.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>