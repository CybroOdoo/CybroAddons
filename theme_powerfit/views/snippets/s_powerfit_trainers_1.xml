<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Trainers 1 Template -->
<odoo>
  <template id="s_powerfit_trainers_1" name="PowerFit Trainers 1">
    <section class="page-banner page-banner--trainers" data-snippet="theme_powerfit.s_powerfit_trainers_1" data-name="PowerFit Trainers 1">
         <div class="container oe_structure">
          <div class="eyebrow">Meet the Team</div>
          <h1 class="o_editable page-banner-title">Expert <span class="o_editable" style="color:var(--accent)">Trainers</span></h1>
          <nav class="breadcrumb" aria-label="Breadcrumb">
           <a class="o_editable" href="/">Home</a>
           <span class="o_editable">/</span>
           <span class="o_editable breadcrumb-current">Trainers</span>
          </nav>
         </div>
        </section>
  </template>
  
  <template id="s_powerfit_trainers_1_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_trainers_1" string="PowerFit Trainers 1" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>