<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Testimonials Template -->
<odoo>
  <template id="s_powerfit_testimonials" name="PowerFit Testimonials">
    <section class="section testimonials-bg" data-snippet="theme_powerfit.s_powerfit_testimonials" data-name="PowerFit Testimonials">
             <div class="container oe_structure" id="testimonials">
              <div class="section-header reveal from-bottom">
               <div class="eyebrow">Success Stories</div>
               <h2 class="o_editable section-title">Real <span class="o_editable">Transformations</span></h2>
               <p class="o_editable section-subtitle">Don't take our word for it. Hear directly from members who changed their lives at PowerFit.</p>
              </div>
              <div class="testimonials-carousel reveal from-bottom">
               <div class="testimonials-track" id="testimonialsTrack">
                <div class="testimonial-card">
                 <div class="testimonial-rating">
                  <iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon>
                 </div>
                 <p class="o_editable testimonial-text">"PowerFit completely transformed how I see fitness. Within 6 months I lost 40 lbs and gained the confidence I never thought I'd have. The trainers here are on another level — they genuinely care about your progress."</p>
                 <div class="testimonial-author">
                  <div class="testimonial-avatar">
                   <img src="/theme_powerfit/static/src/img/snippets/user1.png" alt="James Wilson"/>
                  </div>
                  <div>
                   <div class="testimonial-name">James Wilson</div>
                   <div class="testimonial-meta">Member for 2 Years</div>
                  </div>
                 </div>
                 <div class="testimonial-transform">
                  <div class="transform-stat">
                   <div class="transform-stat-num">-40</div>
                   <div class="transform-stat-label">lbs lost</div>
                  </div>
                  <div class="transform-stat">
                   <div class="transform-stat-num">6</div>
                   <div class="transform-stat-label">months</div>
                  </div>
                  <div class="transform-stat">
                   <div class="transform-stat-num">+85%</div>
                   <div class="transform-stat-label">confidence</div>
                  </div>
                 </div>
                </div>
                <div class="testimonial-card">
                 <div class="testimonial-rating">
                  <iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon>
                 </div>
                 <p class="o_editable testimonial-text">"The yoga and nutrition program here is unlike anything I've experienced. Maya helped me rebuild my relationship with my body. I'm stronger, more flexible, and at peace with myself than ever before."</p>
                 <div class="testimonial-author">
                  <div class="testimonial-avatar">
                   <img src="/theme_powerfit/static/src/img/snippets/user2.png" alt="Sarah Chen"/>
                  </div>
                  <div>
                   <div class="testimonial-name">Sarah Chen</div>
                   <div class="testimonial-meta">Member for 1.5 Years</div>
                  </div>
                 </div>
                 <div class="testimonial-transform">
                  <div class="transform-stat">
                   <div class="transform-stat-num">+30</div>
                   <div class="transform-stat-label">lbs muscle</div>
                  </div>
                  <div class="transform-stat">
                   <div class="transform-stat-num">18</div>
                   <div class="transform-stat-label">months</div>
                  </div>
                  <div class="transform-stat">
                   <div class="transform-stat-num">-20%</div>
                   <div class="transform-stat-label">body fat</div>
                  </div>
                 </div>
                </div>
                <div class="testimonial-card">
                 <div class="testimonial-rating">
                  <iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon><iconify-icon icon="ph:star-fill"></iconify-icon>
                 </div>
                 <p class="o_editable testimonial-text">"Marcus pushed me beyond limits I didn't know I had. The HIIT program is brutal but the results speak for themselves. I ran my first marathon at 42 — something I thought was impossible."</p>
                 <div class="testimonial-author">
                  <div class="testimonial-avatar">
                   <img src="/theme_powerfit/static/src/img/snippets/user3.png" alt="David Kumar"/>
                  </div>
                  <div>
                   <div class="testimonial-name">David Kumar</div>
                   <div class="testimonial-meta">Member for 3 Years</div>
                  </div>
                 </div>
                 <div class="testimonial-transform">
                  <div class="transform-stat">
                   <div class="transform-stat-num">1st</div>
                   <div class="transform-stat-label">marathon</div>
                  </div>
                  <div class="transform-stat">
                   <div class="transform-stat-num">36</div>
                   <div class="transform-stat-label">months</div>
                  </div>
                  <div class="transform-stat">
                   <div class="transform-stat-num">-55</div>
                   <div class="transform-stat-label">lbs lost</div>
                  </div>
                 </div>
                </div>
               </div>
               <div class="carousel-controls">
                <div class="carousel-dots" id="carouselDots">
                 <button class="carousel-dot active" data-index="0"></button>
                 <button class="carousel-dot" data-index="1"></button>
                 <button class="carousel-dot" data-index="2"></button>
                </div>
                <div class="carousel-nav">
                 <button class="carousel-btn" id="prevBtn" aria-label="Previous"><iconify-icon icon="ph:arrow-left-bold"></iconify-icon></button>
                 <button class="carousel-btn" id="nextBtn" aria-label="Next"><iconify-icon icon="ph:arrow-right-bold"></iconify-icon></button>
                </div>
               </div>
              </div>
             </div>
            </section>
  </template>
  
  <template id="s_powerfit_testimonials_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_testimonials" string="PowerFit Testimonials" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_testimonials.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>