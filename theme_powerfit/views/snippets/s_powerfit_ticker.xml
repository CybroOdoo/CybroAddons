<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Ticker Template -->
<odoo>
  <template id="s_powerfit_ticker" name="PowerFit Ticker">
    <div class="ticker-strip" data-snippet="theme_powerfit.s_powerfit_ticker" data-name="PowerFit Ticker">
             <div class="ticker-inner">
              <span class="o_editable ticker-item"><iconify-icon icon="ph:barbell-bold"></iconify-icon> Strength Training</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:lightning-bold"></iconify-icon> HIIT Classes</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:heart-bold"></iconify-icon> Cardio Programs</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:flower-lotus-bold"></iconify-icon> Yoga &amp; Mindfulness</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:user-circle-check-bold"></iconify-icon> Personal Training</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:fork-knife-bold"></iconify-icon> Nutrition Coaching</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:trophy-bold"></iconify-icon> Premium Facilities</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:barbell-bold"></iconify-icon> Strength Training</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:lightning-bold"></iconify-icon> HIIT Classes</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:heart-bold"></iconify-icon> Cardio Programs</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:flower-lotus-bold"></iconify-icon> Yoga &amp; Mindfulness</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:user-circle-check-bold"></iconify-icon> Personal Training</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:fork-knife-bold"></iconify-icon> Nutrition Coaching</span>
              <span class="o_editable ticker-item"><iconify-icon icon="ph:trophy-bold"></iconify-icon> Premium Facilities</span>
             </div>
            </div>
  </template>
  
  <template id="s_powerfit_ticker_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_ticker" string="PowerFit Ticker" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_ticker.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>