<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Hero Template -->
<odoo>
  <template id="s_powerfit_hero" name="PowerFit Hero">
    <section class="hero" data-snippet="theme_powerfit.s_powerfit_hero" data-name="PowerFit Hero">
             <div class="hero-video-wrap">
              <video autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" poster="theme_powerfit/static/src/img/snippets/dumbells.jpeg">
               <source src="https://assets.mixkit.co/videos/preview/mixkit-athlete-running-on-a-treadmill-in-the-gym-32855-large.mp4" type="video/mp4"/>
              </video>
             </div>
             <div class="hero-stats">
              <div class="hero-stat-card">
               <div class="hero-stat-num" data-count="5000">0</div>
               <div class="hero-stat-label">Happy Members</div>
              </div>
              <div class="hero-stat-card">
               <div class="hero-stat-num" data-count="50">0</div>
               <div class="hero-stat-label">Expert Trainers</div>
              </div>
              <div class="hero-stat-card">
               <div class="hero-stat-num" data-count="15">0</div>
               <div class="hero-stat-label">Years Experience</div>
              </div>
              <div class="hero-stat-card">
               <div class="hero-stat-num" data-count="100">0</div>
               <div class="hero-stat-label">Weekly Classes</div>
              </div>
             </div>
             <div class="container oe_structure" id="home">
              <div class="hero-content oe_structure">
               <h1 class="o_editable hero-title">
                <span class="o_editable hero-title-line">Transform</span>
                <span class="o_editable hero-title-line">Your Body,</span>
                <span class="o_editable hero-title-line">Elevate Your Life</span>
               </h1>
               <p class="o_editable hero-subtitle">Where elite training meets luxury experience. Join thousands of members who have redefined their limits at PowerFit.</p>
               <div class="hero-actions">
                <a href="/membership" class="o_editable btn btn-primary">
                 Start Today <iconify-icon icon="ph:arrow-right-bold"></iconify-icon>
                </a>
                <a href="/services" class="o_editable btn btn-outline">
                 <iconify-icon icon="ph:play-fill"></iconify-icon> Our Programs
                </a>
               </div>
              </div>
             </div>
             <div class="hero-scroll">
              <span class="o_editable">Scroll</span>
              <div class="scroll-line"></div>
             </div>
            </section>
  </template>
  
  <template id="s_powerfit_hero_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_hero" string="PowerFit Hero" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>