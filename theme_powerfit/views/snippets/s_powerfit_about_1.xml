<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit About 1 Template -->
<odoo>
  <template id="s_powerfit_about_1" name="PowerFit About 1">
    <section class="page-banner page-banner--about" data-snippet="theme_powerfit.s_powerfit_about_1" data-name="PowerFit About 1">
         <div class="container oe_structure">
          <div class="eyebrow">Our Story</div>
          <h1 class="page-banner-title">About <span style="color:var(--accent)">PowerFit</span></h1>
          <nav class="breadcrumb" aria-label="Breadcrumb">
           <a href="/">Home</a>
           <span>/</span>
           <span class="breadcrumb-current">About Us</span>
          </nav>
         </div>
        </section>
  </template>
  
  <template id="s_powerfit_about_1_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_about_1" string="PowerFit About 1" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>