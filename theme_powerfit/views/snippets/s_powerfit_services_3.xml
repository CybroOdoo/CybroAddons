<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Services 3 Template -->
<odoo>
  <template id="s_powerfit_services_3" name="PowerFit Services 3">
    <section class="final-cta" style="min-height:50vh;" data-snippet="theme_powerfit.s_powerfit_services_3" data-name="PowerFit Services 3">
         <div class="final-cta-bg">
          <img src="/theme_powerfit/static/src/img/snippets/bw.png" alt="Training"/>
         </div>
         <div class="final-cta-content reveal from-bottom oe_structure">
          <div class="final-cta-eyebrow">Ready to Begin?</div>
          <h2 class="o_editable final-cta-headline" style="font-size:clamp(2.5rem,6vw,5rem);">Pick Your <span class="o_editable line-accent">Program.</span></h2>
          <p class="o_editable final-cta-sub">Not sure where to start? Our coaches will guide you to the perfect program for your goals.</p>
          <a href="/contactus" class="o_editable btn btn-magnetic">Talk to a Coach <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
         </div>
        </section>
  </template>
  
  <template id="s_powerfit_services_3_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_services_3" string="PowerFit Services 3" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>