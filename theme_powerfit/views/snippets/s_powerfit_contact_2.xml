<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Contact 2 Template -->
<odoo>
  <template id="s_powerfit_contact_2" name="PowerFit Contact 2">
    <section class="section contact-section" data-snippet="theme_powerfit.s_powerfit_contact_2" data-name="PowerFit Contact 2">
         <div class="container oe_structure">
          <div class="contact-grid">
           <!-- Info column -->
           <div class="reveal from-left">
            <h2 class="o_editable contact-info-title">Let's Start Your <span class="o_editable" style="color:var(--accent)">Journey</span></h2>
            <p class="o_editable contact-info-desc">Have a question, want to book a tour, or ready to start your transformation? Our team is here to help. Reach out and we'll get back to you within 24 hours.</p>
            <div class="contact-item">
             <div class="contact-icon"><iconify-icon icon="ph:map-pin-fill"></iconify-icon></div>
             <div>
              <div class="contact-item-title">Our Location</div>
              <div class="contact-item-info">123 Fitness Street, Gym District<br/>New York, NY 10001</div>
             </div>
            </div>
            <div class="contact-item">
             <div class="contact-icon"><iconify-icon icon="ph:phone-fill"></iconify-icon></div>
             <div>
              <div class="contact-item-title">Phone</div>
              <div class="contact-item-info">+1 (555) 123-4567</div>
             </div>
            </div>
            <div class="contact-item">
             <div class="contact-icon"><iconify-icon icon="ph:envelope-fill"></iconify-icon></div>
             <div>
              <div class="contact-item-title">Email</div>
              <div class="contact-item-info">hello@powerfit.com</div>
             </div>
            </div>
            <div class="contact-item">
             <div class="contact-icon"><iconify-icon icon="ph:clock-fill"></iconify-icon></div>
             <div>
              <div class="contact-item-title">Hours</div>
              <div class="contact-item-info">Mon–Fri: 5am–11pm<br/>Sat–Sun: 7am–9pm</div>
             </div>
            </div>
            <div class="contact-social">
             <a class="o_editable" href="https://instagram.com/" aria-label="Instagram"><iconify-icon icon="ph:instagram-logo-fill"></iconify-icon></a>
             <a class="o_editable" href="https://facebook.com/" aria-label="Facebook"><iconify-icon icon="ph:facebook-logo-fill"></iconify-icon></a>
             <a class="o_editable" href="https://twitter.com/" aria-label="Twitter"><iconify-icon icon="ph:twitter-logo-fill"></iconify-icon></a>
             <a class="o_editable" href="https://youtube.com/" aria-label="YouTube"><iconify-icon icon="ph:youtube-logo-fill"></iconify-icon></a>
             <a class="o_editable" href="https://tiktok.com/" aria-label="TikTok"><iconify-icon icon="ph:tiktok-logo-fill"></iconify-icon></a>
            </div>
           </div>

           <!-- Form column -->
           <div class="contact-form-wrap reveal from-right">
            <!-- Wrapping inside s_website_form section so Odoo builder detects it correctly -->
            <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
             <form id="contactForm" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus-thank-you">
                      <div class="s_website_form_rows row s_col_no_bgcolor">
               <!-- Hidden Email To Field -->
               <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                <div class="row s_col_no_resize s_col_no_bgcolor">
                 <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                  <span class="s_website_form_label_content"></span>
                 </label>
                 <div class="col-sm">
                  <input type="hidden" class="form-control s_website_form_input" name="email_to" value="info@yourcompany.example.com"/>
                 </div>
                </div>
               </div>

               <!-- Name (Half width) -->
               <div class="form-group col-lg-6 col-12 s_website_form_field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                <label class="form-label s_website_form_label" for="contact_name">
                 <span class="s_website_form_label_content">Your Name</span><span class="s_website_form_mark"> *</span>
                </label>
                <input class="form-input s_website_form_input" type="text" id="contact_name" name="name" placeholder="John Doe" required="1" data-fill-with="name"/>
               </div>

               <!-- Phone (Half width) -->
               <div class="form-group col-lg-6 col-12 s_website_form_field s_website_form_custom" data-type="tel" data-name="Field">
                <label class="form-label s_website_form_label" for="phone">
                 <span class="s_website_form_label_content">Phone Number</span>
                </label>
                <input class="form-input s_website_form_input" type="tel" id="phone" name="phone" placeholder="+1 (555) 000-0000" data-fill-with="phone"/>
               </div>
               
               <!-- Email (Full width) -->
               <div class="form-group col-12 s_website_form_field s_website_form_model_required" data-type="email" data-name="Field">
                <label class="form-label s_website_form_label" for="email_from">
                 <span class="s_website_form_label_content">Email Address</span><span class="s_website_form_mark"> *</span>
                </label>
                <input class="form-input s_website_form_input" type="email" id="email_from" name="email_from" placeholder="john@example.com" required="1" data-fill-with="email"/>
               </div>

               <!-- Required Subject field for Odoo CRM forms -->
               <div class="form-group col-12 s_website_form_field s_website_form_model_required" data-type="char" data-name="Field">
                <label class="form-label s_website_form_label" for="subject">
                 <span class="s_website_form_label_content">Subject</span><span class="s_website_form_mark"> *</span>
                </label>
                <input class="form-input s_website_form_input" type="text" id="subject" name="subject" placeholder="Enquiry" required="1"/>
               </div>

               <div class="form-group col-12 s_website_form_field s_website_form_custom s_website_form_required" data-type="text" data-name="Field">
                <label class="form-label s_website_form_label" for="description">
                 <span class="s_website_form_label_content">Message</span><span class="s_website_form_mark"> *</span>
                </label>
                <textarea class="form-textarea s_website_form_input" id="description" name="description" placeholder="Tell us about your goals…" required="1"></textarea>
               </div>
               
               <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label" data-name="Submit Button">
                   <div style="width: 200px;" class="s_website_form_label" />
                   <span id="s_website_form_result"/>
                   <a href="#" role="button" class="btn btn-primary s_website_form_send form-submit">
                      Send Message <iconify-icon icon="ph:arrow-right-bold"></iconify-icon>
                   </a>
               </div>
              </div>
             </form>
            </section>
           </div>
          </div>

          <!-- Map -->
          <div class="map-wrap reveal from-bottom" style="margin-top:80px;">
           <iframe
            title="PowerFit Gym Location"
            src="https://maps.google.com/maps?q=New+York+City&amp;t=&amp;z=13&amp;ie=UTF8&amp;iwloc=&amp;output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
           </iframe>
          </div>
         </div>
        </section>
  </template>
  
  <template id="s_powerfit_contact_2_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_contact_2" string="PowerFit Contact 2" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>