<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Gallery Template -->
<odoo>
  <template id="s_powerfit_gallery" name="PowerFit Gallery">
    <section class="section gallery-bg" data-snippet="theme_powerfit.s_powerfit_gallery" data-name="PowerFit Gallery">
             <div class="container oe_structure" id="gallery">
              <div class="section-header reveal from-bottom">
               <div class="eyebrow">The Experience</div>
               <h2 class="o_editable section-title">Inside <span class="o_editable">PowerFit</span></h2>
               <p class="o_editable section-subtitle">Peek inside our world-class facility and meet the community that makes it exceptional.</p>
              </div>
              <div class="gallery-masonry">
               <div class="gallery-item reveal from-bottom reveal-delay-1">
                <img src="/theme_powerfit/static/src/img/snippets/img_1.png" alt="Gym interior"/>
                <div class="gallery-overlay">
                 <div class="gallery-story">
                  <div class="gallery-story-name">Main Floor</div>
                  <div class="gallery-story-text">10,000 sq ft of premium equipment and open training space</div>
                 </div>
                </div>
               </div>
               <div class="gallery-item reveal from-bottom reveal-delay-2">
                <img src="/theme_powerfit/static/src/img/snippets/weight-room.png" alt="Weight room"/>
                <div class="gallery-overlay">
                 <div class="gallery-story">
                  <div class="gallery-story-name">Mike's Story</div>
                  <div class="gallery-story-text">Lost 60 lbs in 9 months with dedicated strength training</div>
                 </div>
                </div>
               </div>
               <div class="gallery-item reveal from-bottom reveal-delay-3">
                <img src="/theme_powerfit/static/src/img/snippets/yoga-studio.png" alt="Yoga studio"/>
                <div class="gallery-overlay">
                 <div class="gallery-story">
                  <div class="gallery-story-name">Zen Studio</div>
                  <div class="gallery-story-text">Award-winning yoga &amp; mindfulness space</div>
                 </div>
                </div>
               </div>
               <div class="gallery-item reveal from-bottom reveal-delay-1">
                <img src="/theme_powerfit/static/src/img/snippets/training-session.png" alt="Training session"/>
                <div class="gallery-overlay">
                 <div class="gallery-story">
                  <div class="gallery-story-name">Lisa's Victory</div>
                  <div class="gallery-story-text">Completed her first triathlon after 12 months at PowerFit</div>
                 </div>
                </div>
               </div>
               <div class="gallery-item reveal from-bottom reveal-delay-2">
                <img src="/theme_powerfit/static/src/img/snippets/cardio-zone.png" alt="Cardio zone"/>
                <div class="gallery-overlay">
                 <div class="gallery-story">
                  <div class="gallery-story-name">Cardio Zone</div>
                  <div class="gallery-story-text">Next-gen equipment with immersive screens and heart-rate tracking</div>
                 </div>
                </div>
               </div>
               <div class="gallery-item reveal from-bottom reveal-delay-3">
                <img src="/theme_powerfit/static/src/img/snippets/hit-class.png" alt="HIIT class"/>
                <div class="gallery-overlay">
                 <div class="gallery-story">
                  <div class="gallery-story-name">Group Energy</div>
                  <div class="gallery-story-text">Our HIIT classes fill up in minutes — join the waitlist</div>
                 </div>
                </div>
               </div>
              </div>
             </div>
            </section>
  </template>
  
  <template id="s_powerfit_gallery_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_gallery" string="PowerFit Gallery" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_gallery.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>