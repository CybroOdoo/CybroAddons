<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Services 2 Template -->
<odoo>
  <template id="s_powerfit_services_2" name="PowerFit Services 2">
     <section class="section" data-snippet="theme_powerfit.s_powerfit_services_2" data-name="PowerFit Services 2">
         <div class="container oe_structure">
          <div class="section-header reveal from-bottom">
           <div class="eyebrow">Elite Programs</div>
           <h2 class="section-title">Built for <span>Results</span></h2>
           <p class="section-subtitle">From high-intensity training to mindful recovery — every program is engineered for results that last.</p>
          </div>
          <div class="services-grid">
           <div class="service-card reveal from-bottom reveal-delay-1">
            <div class="service-num">01</div>
            <div class="service-icon-wrap"><iconify-icon icon="ph:user-circle-check-bold"></iconify-icon></div>
            <h3 class="service-title">Personal Training</h3>
            <p class="service-desc">One-on-one sessions with certified elite trainers who craft customised workout plans tailored to your unique goals, body type, and schedule.</p>
            <a href="/contactus" class="service-link">Book a Session <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
           </div>
           <div class="service-card reveal from-bottom reveal-delay-2">
            <div class="service-num">02</div>
            <div class="service-icon-wrap"><iconify-icon icon="ph:barbell-bold"></iconify-icon></div>
            <h3 class="service-title">Weight Training</h3>
            <p class="service-desc">Build strength and muscle with our extensive free-weight area, cable machines, and expert guidance on proper form and progressive overload.</p>
            <a href="/contactus" class="service-link">Learn More <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
           </div>
           <div class="service-card reveal from-bottom reveal-delay-3">
            <div class="service-num">03</div>
            <div class="service-icon-wrap"><iconify-icon icon="ph:heartbeat-bold"></iconify-icon></div>
            <h3 class="service-title">Cardio Programs</h3>
            <p class="service-desc">Improve endurance and burn calories with our high-energy cardio classes and next-generation cardio equipment with immersive screens.</p>
            <a href="/contactus" class="service-link">Learn More <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
           </div>
           <div class="service-card reveal from-bottom reveal-delay-1">
            <div class="service-num">04</div>
            <div class="service-icon-wrap"><iconify-icon icon="ph:flower-lotus-bold"></iconify-icon></div>
            <h3 class="service-title">Yoga &amp; Mindfulness</h3>
            <p class="service-desc">Find balance and inner peace with expert-led yoga and mindfulness sessions suited for all experience levels in our zen-inspired studio.</p>
            <a href="/contactus" class="service-link">Learn More <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
           </div>
           <div class="service-card reveal from-bottom reveal-delay-2">
            <div class="service-num">05</div>
            <div class="service-icon-wrap"><iconify-icon icon="ph:person-simple-run-bold"></iconify-icon></div>
            <h3 class="service-title">HIIT Classes</h3>
            <p class="service-desc">Torch calories and boost metabolism with high-intensity interval training scientifically designed for the afterburn effect. Max results, minimum time.</p>
            <a href="/contactus" class="service-link">Learn More <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
           </div>
           <div class="service-card reveal from-bottom reveal-delay-3">
            <div class="service-num">06</div>
            <div class="service-icon-wrap"><iconify-icon icon="ph:fork-knife-bold"></iconify-icon></div>
            <h3 class="service-title">Nutrition Coaching</h3>
            <p class="service-desc">Maximise your results with personalised nutrition plans created by certified sports dietitians. Fuel your training and recovery the right way.</p>
            <a href="/contactus" class="service-link">Learn More <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
           </div>
           <div class="service-card reveal from-bottom reveal-delay-1">
            <div class="service-num">07</div>
            <div class="service-icon-wrap"><iconify-icon icon="ph:hand-fist-bold"></iconify-icon></div>
            <h3 class="service-title">Boxing &amp; Combat</h3>
            <p class="service-desc">Build power, agility and mental toughness with expert-led boxing and combat fitness sessions designed for all skill levels.</p>
            <a href="/contactus" class="service-link">Learn More <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
           </div>
           <div class="service-card reveal from-bottom reveal-delay-2">
            <div class="service-num">08</div>
            <div class="service-icon-wrap"><iconify-icon icon="ph:bed-bold"></iconify-icon></div>
            <h3 class="service-title">Recovery &amp; Wellness</h3>
            <p class="service-desc">Dedicated stretch zones, foam rolling stations, and guided recovery sessions to keep your body performing at its absolute peak.</p>
            <a href="/contactus" class="service-link">Learn More <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
           </div>
          </div>
         </div>
        </section>
  </template>
  
  <template id="s_powerfit_services_2_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_services_2" string="PowerFit Services 2" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>