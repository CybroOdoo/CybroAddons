<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Transformation Template -->
<odoo>
  <template id="s_powerfit_transformation" name="PowerFit Impact">
    <section class="transformation" data-snippet="theme_powerfit.s_powerfit_transformation" data-name="PowerFit Impact">
             <div class="container oe_structure" id="transformation">
              <div class="transformation-header reveal from-bottom">
               <div class="eyebrow">The Numbers</div>
               <h2 class="o_editable section-title">Our <span class="o_editable">Impact</span> Speaks</h2>
               <p class="o_editable section-subtitle">Every rep, every session, every milestone — tracked and celebrated. This is what we've built together.</p>
              </div>
              <div class="transformation-grid">
               <div class="transformation-stats">
                <div class="transformation-stat-item">
                 <div class="t-stat-icon"><iconify-icon icon="ph:users-three-bold"></iconify-icon></div>
                 <div class="t-stat-content oe_structure">
                  <div class="t-stat-label">Active Members</div>
                  <div class="t-stat-num" data-count="5000" data-suffix="+">0</div>
                  <div class="progress-bar-wrap">
                   <div class="progress-bar-fill" data-width="92"></div>
                  </div>
                 </div>
                </div>
                <div class="transformation-stat-item">
                 <div class="t-stat-icon"><iconify-icon icon="ph:trophy-bold"></iconify-icon></div>
                 <div class="t-stat-content oe_structure">
                  <div class="t-stat-label">Goals Achieved</div>
                  <div class="t-stat-num" data-count="12500" data-suffix="+">0</div>
                  <div class="progress-bar-wrap">
                   <div class="progress-bar-fill" data-width="78"></div>
                  </div>
                 </div>
                </div>
                <div class="transformation-stat-item">
                 <div class="t-stat-icon"><iconify-icon icon="ph:barbell-bold"></iconify-icon></div>
                 <div class="t-stat-content oe_structure">
                  <div class="t-stat-label">Training Sessions</div>
                  <div class="t-stat-num" data-count="250000" data-suffix="+">0</div>
                  <div class="progress-bar-wrap">
                   <div class="progress-bar-fill" data-width="95"></div>
                  </div>
                 </div>
                </div>
                <div class="transformation-stat-item">
                 <div class="t-stat-icon"><iconify-icon icon="ph:star-fill"></iconify-icon></div>
                 <div class="t-stat-content oe_structure">
                  <div class="t-stat-label">Satisfaction Rate</div>
                  <div class="t-stat-num" data-count="98" data-suffix="%">0</div>
                  <div class="progress-bar-wrap">
                   <div class="progress-bar-fill" data-width="98"></div>
                  </div>
                 </div>
                </div>
               </div>
               <div class="transformation-quotes" id="quotesContainer">
                <div class="quote-item">
                 <p class="o_editable quote-text">"The only bad workout is the one that didn't happen."</p>
                 <span class="o_editable quote-attr">— PowerFit Philosophy</span>
                </div>
                <div class="quote-item">
                 <p class="o_editable quote-text">"Your body can stand almost anything. It's your mind you have to convince."</p>
                 <span class="o_editable quote-attr">— Every Member's Breakthrough</span>
                </div>
                <div class="quote-item">
                 <p class="o_editable quote-text">"We don't just build muscles. We build character, discipline, and unstoppable momentum."</p>
                 <span class="o_editable quote-attr">— PowerFit Training Team</span>
                </div>
                <div class="quote-item">
                 <p class="o_editable quote-text">"Transformation isn't just physical. It's waking up and knowing today you're stronger than yesterday."</p>
                 <span class="o_editable quote-attr">— 5,000+ Members Can Confirm</span>
                </div>
               </div>
              </div>
             </div>
            </section>
  </template>
  
  <template id="s_powerfit_transformation_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_transformation" string="PowerFit Impact" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_transformation.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>