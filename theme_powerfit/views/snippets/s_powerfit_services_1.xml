<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Services 1 Template -->
<odoo>
  <template id="s_powerfit_services_1" name="PowerFit Services 1">
    <section class="page-banner page-banner--services" data-snippet="theme_powerfit.s_powerfit_services_1" data-name="PowerFit Services 1">
         <div class="container oe_structure">
          <div class="eyebrow">What We Offer</div>
          <h1 class="page-banner-title">Our <span style="color:var(--accent)">Services</span></h1>
          <nav class="breadcrumb" aria-label="Breadcrumb">
           <a href="/">Home</a>
           <span>/</span>
           <span class="breadcrumb-current">Services</span>
          </nav>
         </div>
        </section>
  </template>
  
  <template id="s_powerfit_services_1_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_services_1" string="PowerFit Services 1" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>