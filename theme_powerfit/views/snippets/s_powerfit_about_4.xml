<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit About 4 Template -->
<odoo>
  <template id="s_powerfit_about_4" name="PowerFit About 4">
    <section class="final-cta" style="min-height:50vh;" data-snippet="theme_powerfit.s_powerfit_about_4" data-name="PowerFit About 4">
         <div class="final-cta-bg">
          <img src="/theme_powerfit/static/src/img/snippets/cycles.jpeg" alt="Training"/>
         </div>
         <div class="final-cta-content reveal from-bottom oe_structure">
          <div class="final-cta-eyebrow">Ready to Join?</div>
          <h2 class="o_editable final-cta-headline" style="font-size:clamp(2.5rem,6vw,5rem);">Become Part of <span class="o_editable line-accent">The Legacy.</span></h2>
          <p class="o_editable final-cta-sub">Your transformation starts the moment you walk through our doors. Take the first step today.</p>
          <a href="/contactus" class="o_editable btn btn-magnetic">Join The Community <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
         </div>
        </section>
  </template>
  
  <template id="s_powerfit_about_4_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_about_4" string="PowerFit About 4" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_hero.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>