<?xml version="1.0" encoding="utf-8"?>
<!-- S Powerfit Services Template -->
<odoo>
  <template id="s_powerfit_services" name="PowerFit Services">
    <section class="section services-bg" data-snippet="theme_powerfit.s_powerfit_services" data-name="PowerFit Services">
             <div class="container oe_structure" id="services">
              <div class="section-header reveal from-bottom">
               <div class="eyebrow">What We Offer</div>
               <h2 class="o_editable section-title">Elite <span class="o_editable">Programs</span></h2>
               <p class="o_editable section-subtitle">From high-intensity training to mindful recovery — every program is engineered for results.</p>
              </div>
              <div class="services-grid">
               <div class="service-card reveal from-bottom reveal-delay-1">
                <div class="service-num">01</div>
                <div class="service-icon-wrap"><iconify-icon icon="ph:user-circle-check-bold"></iconify-icon></div>
                <h3 class="o_editable service-title">Personal Training</h3>
                <p class="o_editable service-desc">One-on-one sessions with certified elite trainers. Your program, your pace, your transformation.</p>
                <a href="/services" class="o_editable service-link">Explore <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
               </div>
               <div class="service-card reveal from-bottom reveal-delay-2">
                <div class="service-num">02</div>
                <div class="service-icon-wrap"><iconify-icon icon="ph:barbell-bold"></iconify-icon></div>
                <h3 class="o_editable service-title">Weight Training</h3>
                <p class="o_editable service-desc">State-of-the-art free weights and machines. Build strength, power, and a physique you're proud of.</p>
                <a href="/services" class="o_editable service-link">Explore <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
               </div>
               <div class="service-card reveal from-bottom reveal-delay-3">
                <div class="service-num">03</div>
                <div class="service-icon-wrap"><iconify-icon icon="ph:heartbeat-bold"></iconify-icon></div>
                <h3 class="o_editable service-title">Cardio Programs</h3>
                <p class="o_editable service-desc">Advanced cardio zones with immersive tech. Burn more, recover faster, perform at your peak.</p>
                <a href="/services" class="o_editable service-link">Explore <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
               </div>
               <div class="service-card reveal from-bottom reveal-delay-1">
                <div class="service-num">04</div>
                <div class="service-icon-wrap"><iconify-icon icon="ph:flower-lotus-bold"></iconify-icon></div>
                <h3 class="o_editable service-title">Yoga &amp; Mindfulness</h3>
                <p class="o_editable service-desc">Restore balance and flexibility in our zen-inspired studio. Mind and body in perfect harmony.</p>
                <a href="/services" class="o_editable service-link">Explore <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
               </div>
               <div class="service-card reveal from-bottom reveal-delay-2">
                <div class="service-num">05</div>
                <div class="service-icon-wrap"><iconify-icon icon="ph:person-simple-run-bold"></iconify-icon></div>
                <h3 class="o_editable service-title">HIIT Classes</h3>
                <p class="o_editable service-desc">Maximum results in minimum time. Our HIIT classes are scientifically designed for afterburn.</p>
                <a href="/services" class="o_editable service-link">Explore <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
               </div>
               <div class="service-card reveal from-bottom reveal-delay-3">
                <div class="service-num">06</div>
                <div class="service-icon-wrap"><iconify-icon icon="ph:fork-knife-bold"></iconify-icon></div>
                <h3 class="o_editable service-title">Nutrition Coaching</h3>
                <p class="o_editable service-desc">Fuel your goals with personalized nutrition plans crafted by certified sports dietitians.</p>
                <a href="/services" class="o_editable service-link">Explore <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
               </div>
               <div class="service-card reveal from-bottom reveal-delay-1">
                <div class="service-num">07</div>
                <div class="service-icon-wrap"><iconify-icon icon="ph:hand-fist-bold"></iconify-icon></div>
                <h3 class="o_editable service-title">Boxing &amp; Combat</h3>
                <p class="o_editable service-desc">Build power, agility and mental toughness with expert-led boxing and combat fitness sessions.</p>
                <a href="/services" class="o_editable service-link">Explore <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
               </div>
               <div class="service-card reveal from-bottom reveal-delay-2">
                <div class="service-num">08</div>
                <div class="service-icon-wrap"><iconify-icon icon="ph:bed-bold"></iconify-icon></div>
                <h3 class="o_editable service-title">Recovery &amp; Wellness</h3>
                <p class="o_editable service-desc">Stretch zones, foam rolling, and guided recovery sessions to keep your body performing at its peak.</p>
                <a href="/services" class="o_editable service-link">Explore <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
               </div>
              </div>
              <div style="text-align:center;margin-top:48px;" class="reveal from-bottom">
               <a href="/services" class="o_editable btn btn-outline-dark">View All Services <iconify-icon icon="ph:arrow-right-bold"></iconify-icon></a>
              </div>
             </div>
            </section>
  </template>
  
  <template id="s_powerfit_services_reg" inherit_id="website.snippets" priority="16">
    <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
      <t t-snippet="theme_powerfit.s_powerfit_services" string="PowerFit Services" t-thumbnail="/theme_powerfit/static/src/img/snippets/s_powerfit_services.png" group="powerfit_group"/>
    </xpath>
  </template>
</odoo>