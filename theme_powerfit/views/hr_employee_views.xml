<?xml version="1.0" encoding="utf-8"?>
<!-- Employee Form View – PowerFit Trainer Information -->
<odoo>
    <record id="hr_employee_view_form_powerfit" model="ir.ui.view">
        <field name="name">hr.employee.form.powerfit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Add Gym Trainer checkbox in the Work tab, just below Department -->
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="is_gym_trainer" widget="boolean_toggle"/>
            </xpath>

            <!-- Add Trainer Information notebook page (visible only when Gym Trainer = True) -->
            <xpath expr="//notebook" position="inside">
                <page string="Trainer Information"
                      name="trainer_information"
                      invisible="not is_gym_trainer">
                    <group>
                        <group string="About">
                            <field name="trainer_short_description"
                                   placeholder="A short bio shown on the website trainer card…"
                                   nolabel="1"
                                   colspan="2"/>
                        </group>
                        <group string="Statistics">
                            <field name="trainer_experience"/>
                            <field name="trainer_clients"/>
                            <field name="trainer_rating"
                                   widget="float"
                                   digits="[3, 1]"/>
                        </group>
                    </group>
                    <group string="Social Media">
                        <field name="trainer_instagram"
                               placeholder="https://instagram.com/username"/>
                        <field name="trainer_twitter"
                               placeholder="https://twitter.com/username"/>
                        <field name="trainer_linkedin"
                               placeholder="https://linkedin.com/in/username"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
