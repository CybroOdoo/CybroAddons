<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the delivery carrier views. -->
    <record id="view_delivery_carrier_tree_inherit_oil_erp_pipeline" model="ir.ui.view">
        <field name="name">delivery.carrier.list.inherit.oil.erp.pipeline</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_tree"/>
        <field name="arch" type="xml">
            <field name="delivery_type" position="after">
                <field name="is_oil_gas_pipeline" optional="show"/>
                <field name="pipeline_operator" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_delivery_carrier_search_inherit_oil_erp_pipeline" model="ir.ui.view">
        <field name="name">delivery.carrier.search.inherit.oil.erp.pipeline</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_search"/>
        <field name="arch" type="xml">
            <field name="delivery_type" position="after">
                <field name="pipeline_operator"/>
            </field>
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter name="oil_gas_pipeline" string="Oil and Gas Pipeline"
                        domain="[('is_oil_gas_pipeline', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_delivery_carrier_form_inherit_oil_erp_pipeline" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.oil.erp.pipeline</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_details']" position="inside">
                <field name="is_oil_gas_pipeline"/>
                <field name="pipeline_operator"
                       invisible="not is_oil_gas_pipeline"
                       required="is_oil_gas_pipeline"/>
            </xpath>
        </field>
    </record>
</odoo>
