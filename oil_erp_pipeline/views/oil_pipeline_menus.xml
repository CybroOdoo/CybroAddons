<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the oil pipeline menus. -->
    <record id="action_oil_gas_pipeline_delivery_methods" model="ir.actions.act_window">
        <field name="name">Delivery Methods</field>
        <field name="res_model">delivery.carrier</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_oil_gas_pipeline', '=', True)]</field>
        <field name="context">{'default_is_oil_gas_pipeline': 1,
            'search_default_oil_gas_pipeline': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an oil and gas pipeline delivery method.</p>
            <p>Use this menu to manage pipeline-specific delivery methods and operators.</p>
        </field>
    </record>

    <menuitem id="menu_oil_midstream_dashboard"
              name="Dashboard"
              parent="oil_erp_base.menu_oil_midstream_root"
              action="oil_erp_base.action_oil_dashboard_midstream"
              sequence="0"/>

    <record id="menu_oil_midstream_dashboard" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem
            id="menu_oil_config_pipeline_delivery_methods"
            name="Pipeline Methods"
            parent="oil_erp_base.menu_oil_config_midstream"
            groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"
            action="action_oil_gas_pipeline_delivery_methods"
            sequence="20"/>
</odoo>
