<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="pos_pro_cross_selling.CrossProduct">
        <Dialog size="'lg'" title.translate="Cross Selling Products">
            <div class="mb-3 row">
                <t t-foreach="this.state.Products" t-as="product" t-key="product.id">
                    <div t-attf-class="col product position-relative p-2 rounded {{product.selected ? 'border border-2 border-primary bg-primary-subtle' : 'border'}}"
                         t-on-click="(event) => this._onClickOrder(event, product)"
                         style="cursor: pointer;">
                        <div class="text-center">
                            <t t-if="product.selected">
                                <div class="badge bg-primary position-absolute top-0 end-0 m-1">Selected</div>
                            </t>
                            <div class="product-img">
                                <img t-att-src="product.image" t-att-alt="product.name" style="max-height: 80px; object-fit: contain;"/>
                            </div>
                            <div class="product-content mt-2">
                                <div class="product-name fw-bold">
                                    <t t-esc="product.name"/>
                                </div>
                                <span class="cross-price-tag text-success fw-bold">
                                    <t t-esc="product.symbol"/>
                                    <t t-esc="product.price"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <div class="button confirm btn btn-lg btn-primary"
                     t-on-click="() => this.confirm()">
                    <t t-esc="this.props.confirmPopup"/>
                </div>
                <div class="button cancel btn btn-lg btn-secondary"
                     t-on-click="this.props.close">
                    <t t-esc="this.props.closePopup"/>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
