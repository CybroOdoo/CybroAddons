<?xml version="1.0" encoding="UTF-8"?>
<!-- Property List Dynamic Content Template -->
<templates xml:space="preserve">
    <t t-name="theme_livelo.property_card_item">
        <div class="col-lg-4 mb-4">
            <div class="container-featured-properties mt-3">
                <a t-att-href="property.website_url or '/shop'" class="text-decoration-none text-dark d-block">
                    <div class="img-building p-3">
                        <img class="w-100" t-att-src="'/web/image/product.template/' + property.id + '/image_1920'"
                             style="height: 240px; object-fit: cover; border-radius: 8px;"/>
                        <div class="img-features float-left w-100">
                            <t t-if="property.is_featured">
                                <span class="btn-featured text-white btn-primary">Featured</span>
                            </t>
                            <span class="btn-sale text-white"
                                  t-out="property.listing_type == 'sale' ? 'For Sale' : 'For Rent'"/>
                        </div>
                        <div class="img-location-note float-left">
                            <img src="/theme_livelo/static/src/images/location-img.png"/>
                            <span class="text-white"
                                  t-out="property.location or '145 Brooklyn Ave, Califonia, New York'"/>
                        </div>
                        <p class="mt-3">
                            <b>
                                <t t-out="property.name"/>
                            </b>
                        </p>
                        <div class="container-spec">
                            <img src="/theme_livelo/static/src/images/icon-bed.png" class="mr-2"/>
                            <span>Beds: <t t-out="property.bed or 0"/></span>
                            <img src="/theme_livelo/static/src/images/icon-baths.png" class="mr-2"/>
                            <span>Baths: <t t-out="property.bath or 0"/></span>
                            <img src="/theme_livelo/static/src/images/icon-sqft.png" class="mr-2"/>
                            <span class="mr-0">Sqft: <t t-out="property.squarefeet or 0"/></span>
                        </div>
                        <div class="container-admin-side float-left w-100 pt-2 pb-2">
                            <div class="w-50 float-left">
                                <img src="/theme_livelo/static/src/images/person.png" class="mr-2"/>
                                <span>Arlene McCoy</span>
                            </div>
                            <div class="w-50 float-left text-right">
                                <span>
                                    <b>$<t t-out="property.formatted_price or '0'"/></b>
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </t>
    <t t-name="theme_livelo.property_list_data">
        <section class="section-welcome-home-lengo section-discover-homelego float-left w-100 o_colored_level s_property_item">
            <div class="col-lg-12">
                <div class="heading-section mb-5 mt-5 w-100 float-left text-center">
                    <p class="m-0 p-0">Featured Properties</p>
                    <h2 class="font-weight-bold">Discover Home lengo’s<br/>Finest Properties for Your Dream Home</h2>
                </div>
            </div>
            <div class="col-lg-12 mb-4 float-left w-100">
                <ul class="nav nav-tabs">
                    <li class="mr-3">
                        <a data-bs-toggle="tab" class="text-dark active" href="#home">View all</a>
                    </li>
                    <li class="mr-3">
                        <a data-bs-toggle="tab" class="text-dark" href="#menu1">Apartment</a>
                    </li>
                    <li class="mr-3">
                        <a data-bs-toggle="tab" class="text-dark" href="#menu2">Villa</a>
                    </li>
                    <li class="mr-3">
                        <a data-bs-toggle="tab" class="text-dark" href="#menu3">Studio</a>
                    </li>
                    <li class="mr-3">
                        <a data-bs-toggle="tab" class="text-dark" href="#menu4">House</a>
                    </li>
                    <li>
                        <a data-bs-toggle="tab" class="text-dark" href="#menu5">Office</a>
                    </li>
                </ul>
            </div>
            <div class="container">
                <div class="tab-content float-left w-100">
                    <div class="tab-pane fade show active" id="home">
                        <div class="row">
                            <t t-foreach="categorized.all" t-as="property" t-key="property.id">
                                <t t-call="theme_livelo.property_card_item"/>
                            </t>
                            <t t-if="!categorized.all || categorized.all.length == 0">
                                <div class="col-12 text-center py-5">
                                    <p class="text-muted">No properties found.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="menu1">
                        <div class="row">
                            <t t-foreach="categorized.apartment" t-as="property" t-key="property.id">
                                <t t-call="theme_livelo.property_card_item"/>
                            </t>
                            <t t-if="!categorized.apartment || categorized.apartment.length == 0">
                                <div class="col-12 text-center py-5">
                                    <p class="text-muted">No apartments available.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="menu2">
                        <div class="row">
                            <t t-foreach="categorized.villa" t-as="property" t-key="property.id">
                                <t t-call="theme_livelo.property_card_item"/>
                            </t>
                            <t t-if="!categorized.villa || categorized.villa.length == 0">
                                <div class="col-12 text-center py-5">
                                    <p class="text-muted">No villas available.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="menu3">
                        <div class="row">
                            <t t-foreach="categorized.studio" t-as="property" t-key="property.id">
                                <t t-call="theme_livelo.property_card_item"/>
                            </t>
                            <t t-if="!categorized.studio || categorized.studio.length == 0">
                                <div class="col-12 text-center py-5">
                                    <p class="text-muted">No studios available.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="menu4">
                        <div class="row">
                            <t t-foreach="categorized.house" t-as="property" t-key="property.id">
                                <t t-call="theme_livelo.property_card_item"/>
                            </t>
                            <t t-if="!categorized.house || categorized.house.length == 0">
                                <div class="col-12 text-center py-5">
                                    <p class="text-muted">No houses available.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="menu5">
                        <div class="row">
                            <t t-foreach="categorized.office" t-as="property" t-key="property.id">
                                <t t-call="theme_livelo.property_card_item"/>
                            </t>
                            <t t-if="!categorized.office || categorized.office.length == 0">
                                <div class="col-12 text-center py-5">
                                    <p class="text-muted">No offices available.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-12 text-center">
                <a class="btn-learn-more-properties text-white btn-primary mt-5 w-25 mb-3 pl-5 pr-5 pt-3 pb-3 text-decoration-none text-center d-inline-block"
                   href="/shop">View all Properties
                </a>
            </div>
        </section>
    </t>
</templates>
