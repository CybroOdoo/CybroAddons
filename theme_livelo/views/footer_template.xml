<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template Docstring: Manages the Unknown template structure -->
    <template id="footer_inherit" inherit_id="website.layout">
        <xpath expr="//div[@id='footer']" position="replace">
            <footer class="section-footer" id="bottom">
                <div class="container"  id="footer">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="footer-logo pt-5 pb-5">
                                <img src="/theme_livelo/static/src/images/logo-footer.png"/>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="social-media-footer pt-5 pb-5">
                                <ul>
                                    <span class="text-white">
                                        <b>Follow Us:</b>
                                    </span>
                                    <li>
                                        <a href="#">
                                            <img src="/theme_livelo/static/src/images/icon-fb.png"/>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#">
                                            <img src="/theme_livelo/static/src/images/icon-linked-in.png"/>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#">
                                            <img src="/theme_livelo/static/src/images/icon-tw.png"/>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#">
                                            <img src="/theme_livelo/static/src/images/icon-print.png"/>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <hr class="hr-footer mt-0"/>
                        </div>
                        <div class="col-lg-3">
                            <div class="w-100 footer-address">
                                <p>Specializes in providing high-class tours for those in need.
                                    Contact Us
                                </p>
                                <ul class="pl-0">
                                    <li>
                                        <img src="/theme_livelo/static/src/images/footer-location-icon.png"/>
                                        <span class="">101 E 129th St, East Chicago, IN 46312, US</span>
                                    </li>
                                    <li>
                                        <img src="/theme_livelo/static/src/images/footer-call-icon.png"/>
                                        <span class="">1-333-345-6868</span>
                                    </li>
                                    <li>
                                        <img src="/theme_livelo/static/src/images/footer-email-icon.png"/>
                                        <span class="">user@gmail.com</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-6">
                            <div class="category-list">
                                <ul>
                                    <li class="text-white">
                                        <b>Categories</b>
                                    </li>
                                    <li>
                                        <a class="text-decoration-none" href="/pricing">Pricing Plans</a>
                                    </li>
                                    <li>
                                        <a class="text-decoration-none" href="/aboutus">Our Services</a>
                                    </li>
                                    <li>
                                        <a class="text-decoration-none" href="/aboutus">About Us</a>
                                    </li>
                                    <li>
                                        <a class="text-decoration-none" href="/contactus">Contact Us</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-6">
                            <div class="category-list">
                                <ul>
                                    <li class="text-white">
                                        <b>Our Company</b>
                                    </li>
                                    <li>
                                        <a class="text-decoration-none" href="/shop?listing=sale">Property For Sale</a>
                                    </li>
                                    <li>
                                        <a class="text-decoration-none" href="/shop?listing=rent">Property For Rent</a>
                                    </li>
                                    <li>
                                        <a class="text-decoration-none" href="/shop?listing=sale">Property For Buy</a>
                                    </li>
                                    <li>
                                        <a class="text-decoration-none" href="/aboutus">Our Agents</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <ul class="ul-newsletter pl-0">
                                <li class="text-white" style="list-style: none;">
                                    <b>Newsletter</b>
                                </li>
                                <li style="color: #C5C5C5; list-style: none;">Your Weekly/Monthly Dose of Knowledge
                                    and
                                    Inspiration
                                </li>
                            </ul>
                            <div class="container-email-form">
                                <form action="#" method="post" class="signin-form ">
                                    <div class="forms-gds ">
                                        <input type="email" name=""
                                               class="input-email-submit"
                                               placeholder="Your email Address" required=""/>
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <button class="btn-sub">
                                            <a href="#">
                                                <img src="/theme_livelo/static/src/images/arrow-footer.png"/>
                                            </a>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
            <!--            </section>-->
        </xpath>
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="replace">
            <hr class="hr-footer mt-0"/>
            <div class="footer_bottom pb-4 pt-3">
                <div class="container">
                    <div class="row">
                        <div class="col-md-6 text-md-start text-center text-white-50">
                            <span>© 2024 Livelo. All rights reserved.</span>
                        </div>
                        <div class="col-md-6 text-md-end text-center mt-2 mt-md-0">
                            <ul class="list-inline mb-0 pl-0">
                                <li class="list-inline-item"><a href="#" class="text-white-50 text-decoration-none me-3">Terms Of Services</a></li>
                                <li class="list-inline-item"><a href="#" class="text-white-50 text-decoration-none me-3">Privacy Policy</a></li>
                                <li class="list-inline-item"><a href="#" class="text-white-50 text-decoration-none">Cookie Policy</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
