<?xml version="1.0" encoding="utf-8"?>
<!--    This file extends the Product Template form view to manage property-related information-->
<odoo>
    <record id="view_product_template_form_inherit_property" model="ir.ui.view">
        <field name="name">product.template.form.inherit.property</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']" position="after">
                <page string="Property Details">
                    <group>
                        <group>
                            <field name="is_property" />
                            <field name="is_featured" />
                            <field name="listing_type" />
                            <field name="property_type" />
                            <field name="location" />
                        </group>
                        <group>
                            <field name="bed" />
                            <field name="bath"/>
                            <field name="squarefeet"/>
                            <field name="amenity_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_view_inherit_property_salesperson" model="ir.ui.view">
        <field name="name">product.template.form.inherit.property.salesperson</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="theme_livelo.view_product_template_form_inherit_property"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amenity_ids']" position="after">
                <field name="salesperson_id"/>
            </xpath>
        </field>
    </record>
</odoo>
