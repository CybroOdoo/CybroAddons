<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Header Template -->
    <!-- Template Docstring: Manages the Unknown template structure -->
    <template id="header_inherit" inherit_id="website.layout">
        <xpath expr="//header" position="replace">
            <header class="header-shadow sticky-top">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <!-- Universal Navbar -->
                            <nav class="navbar navbar-expand-lg">
                                <a class="navbar-brand" href="/">
                                    <img src="/theme_livelo/static/src/images/logo-black-header.png"/>
                                </a>
                                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#navbarTogglerDemo02" aria-controls="navbarTogglerDemo02"
                                        aria-expanded="false" aria-label="Toggle navigation">
                                    <span class="navbar-toggler-icon">
                                    </span>
                                </button>
                                <div class="collapse navbar-collapse" id="navbarTogglerDemo02">
                                    <ul class="navbar-nav ms-auto mt-2 mt-lg-0">
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{request.httprequest.path == '/' and 'active' or ''}" href="/">Home</a>
                                        </li>
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{request.httprequest.path.startswith('/aboutus') and 'active' or ''}" href="/aboutus">About Us</a>
                                        </li>
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{request.httprequest.path.startswith('/service') and 'active' or ''}" href="/service">Location</a>
                                        </li>
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{request.httprequest.path.startswith('/shop') and 'active' or ''}" href="/shop">Shop</a>
                                        </li>
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{request.httprequest.path.startswith('/pricing') and 'active' or ''}" href="/pricing">Pricing</a>
                                        </li>
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{request.httprequest.path.startswith('/contactus') and 'active' or ''}" href="/contactus">Contact Us</a>
                                        </li>
                                        <li class="nav-item" t-if="not request.session.uid">
                                            <a href="/web/login" class="btn btn-primary sign-in-btn text-white pt-2 pb-2 ps-4 pe-4 text-center" style="border-radius: 8px;">
                                                Sign in
                                            </a>
                                        </li>
                                        <li class="nav-item dropdown ms-lg-2" t-else="">
                                            <a class="nav-link dropdown-toggle text-dark fw-bold d-flex align-items-center" href="#" id="navbarUserDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <img t-att-src="'/web/image/res.users/%s/avatar_128' % request.env.user.id" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;"/>
                                                <t t-esc="request.env.user.name"/>
                                            </a>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="navbarUserDropdown" style="border-radius: 12px; min-width: 160px;">
                                                <li>
                                                    <a class="dropdown-item py-2 px-3" href="/my">My Account</a>
                                                </li>
                                                <li>
                                                    <hr class="dropdown-divider my-1"/>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item py-2 px-3 text-danger" href="/web/session/logout?redirect=/">Sign out</a>
                                                </li>
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </nav>
                        </div>
                    </div>
                </div>
            </header>
        </xpath>
    </template>
    <!-- Template Docstring: Manages the Unknown template structure -->
    <template id="header_head_inherit" inherit_id="website.layout">
		<xpath expr="//head" position="inside">
			<t t-if="request.httprequest.path == '/'">
				<link rel="stylesheet" href="/theme_livelo/static/src/css/home-style.css"/>
			</t>
			<t t-else="">
			</t>
		</xpath>
	</template>
</odoo>
