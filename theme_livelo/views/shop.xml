<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Template Docstring: Manages the Unknown template structure -->
    <template id="shop_inherit" inherit_id="website_sale.products_item">
		<xpath expr="//*[hasclass('o_wsale_products_item_title')]" position="after">
			<t t-foreach="products_data" t-as="data">
				<div class="property-details d-flex justify-content-between"  t-if="product.id == data['id']">
					<div>
						<strong>Beds:</strong>
						<span t-esc="data['bed']" style="margin-right: 25px;" />
					</div>
					<div>
						<strong>Bath:</strong>
						<span t-esc="data['bath']"  />
					</div>
				</div>
			</t>
		</xpath>
		<xpath expr="//*[hasclass('product_price')]" position="after">
			<t t-foreach="products_data" t-as="data">
				<div class="property-details" t-if="product.id == data['id']">
					<strong>Sqft:</strong>
					<span t-esc="data['squarefeet']" />
				</div>
			</t>
		</xpath>
	</template>
</odoo>
