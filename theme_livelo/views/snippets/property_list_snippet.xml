<?xml version="1.0" encoding="UTF-8" ?>
<!--   This file defines the Featured Properties dynamic snippet-->
<!--    for the Theme Livelo website.-->
<odoo>
    <template id="properties_list" name="Properties List">
        <section
                class="section-welcome-home-lengo main_section_levelo float-left w-100 oe_snippet_body o_colored_level s_property_item"
                data-snippet="properties_list" data-name="Featured Properties Grid">
            <div class="container">
                <div class="row s_nb_column_fixed">
                    <section
                            class="s_dynamic_snippet_title oe_unremovable oe_unmovable d-flex flex-column flex-md-row justify-content-between mb-lg-0 pb-3 pb-md-0">
                        <div>
                            <p class="lead">Featured Properties</p>
                            <h4>Our latest Discover Home lengo’s<br/>Finest Properties for Your Dream Homecontent
                            </h4>
                        </div>
                        <div>
                        </div>
                    </section>
                    <section class="s_dynamic_snippet_content oe_unremovable oe_unmovable o_not_editable col">
                        <div class="css_non_editable_mode_hidden">
                            <div class="missing_option_warning alert alert-info fade show d-none d-print-none rounded-0">
                                Your Dynamic Snippet will be displayed here... This message is displayed because you did
                                not provide both a filter and a template to use.
                                <br/>
                            </div>
                        </div>
                        <div class="dynamic_section"/>
                    </section>
                </div>
            </div>
        </section>
    </template>
    <template id="property_item" name="Featured Properties Grid">
        <t t-call="theme_livelo.properties_list"/>
    </template>
</odoo>
