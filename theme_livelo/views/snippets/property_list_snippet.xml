<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="property_card_template">
        <div class="col-lg-4 mb-4">
            <div class="container-featured-properties mt-3 position-relative">
                <a t-att-href="property.website_url" class="text-decoration-none text-dark d-block">
                    <div class="img-building p-3 position-relative">
                        <img class="w-100" t-att-src="'/web/image/product.template/%s/image_1920' % property.id" style="height: 240px; object-fit: cover; border-radius: 8px;"/>
                        <div class="img-features float-left w-100">
                            <span t-if="property.is_featured" class="btn-featured text-white theme-bg-primary">Featured</span>
                            <span class="btn-sale text-white" t-esc="'For Sale' if property.listing_type == 'sale' else 'For Rent'"/>
                        </div>
                        <div class="img-location-note float-left">
                            <img src="/theme_livelo/static/src/images/location-img.png"/>
                            <span class="text-white" t-esc="property.location or '145 Brooklyn Ave, California, New York'"/>
                        </div>
                        <p class="mt-3">
                            <b><t t-esc="property.name"/></b>
                        </p>
                        <div class="container-spec">
                            <img src="/theme_livelo/static/src/images/icon-bed.png" class="mr-2"/>
                            <span>Beds: <t t-esc="property.bed or 0"/></span>
                            <img src="/theme_livelo/static/src/images/icon-baths.png" class="mr-2"/>
                            <span>Baths: <t t-esc="property.bath or 0"/></span>
                            <img src="/theme_livelo/static/src/images/icon-sqft.png" class="mr-2"/>
                            <span class="mr-0">Sqft: <t t-esc="property.squarefeet or 0"/></span>
                        </div>
                        <div class="container-admin-side float-left w-100 pt-2 pb-2">
                            <div class="w-50 float-left">
                                <img src="/theme_livelo/static/src/images/person.png" class="mr-2"/>
                                <span><t t-esc="property.salesperson_id.name or property.create_uid.name or 'Agent'"/></span>
                            </div>
                            <div class="w-50 float-left text-right">
                                <span>
                                    <b>$<t t-esc="'{:,}'.format(int(property.list_price)) if property.list_price else 0"/></b>
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </template>

    <template id="property_tabs_content" name="Property Tabs Content">
        <div class="row s_property_tabs_row">
            <div class="col-lg-12">
                <ul class="nav nav-tabs gap-3 s_property_nav_tabs">
                    <li>
                        <a data-bs-toggle="tab" class="text-dark active" href="#prop_tab_all">View all</a>
                    </li>
                    <li>
                        <a data-bs-toggle="tab" class="text-dark" href="#prop_tab_apt">Apartment</a>
                    </li>
                    <li>
                        <a data-bs-toggle="tab" class="text-dark" href="#prop_tab_villa">Villa</a>
                    </li>
                    <li>
                        <a data-bs-toggle="tab" class="text-dark" href="#prop_tab_studio">Studio</a>
                    </li>
                    <li>
                        <a data-bs-toggle="tab" class="text-dark" href="#prop_tab_house">House</a>
                    </li>
                    <li>
                        <a data-bs-toggle="tab" class="text-dark" href="#prop_tab_office">Office</a>
                    </li>
                </ul>
                <div class="tab-content s_property_tab_content">
                    <!-- View All -->
                    <div id="prop_tab_all" class="tab-pane fade show active mt-4 pt-5">
                        <div class="row">
                            <t t-if="properties_all">
                                <t t-foreach="properties_all" t-as="property">
                                    <t t-call="theme_livelo.property_card_template"/>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-lg-12 text-center py-5">
                                    <p class="text-muted">No properties found.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <!-- Apartment -->
                    <div id="prop_tab_apt" class="tab-pane fade mt-4 pt-5">
                        <div class="row">
                            <t t-if="properties_apt">
                                <t t-foreach="properties_apt" t-as="property">
                                    <t t-call="theme_livelo.property_card_template"/>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-lg-12 text-center py-5">
                                    <p class="text-muted">No apartments found.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <!-- Villa -->
                    <div id="prop_tab_villa" class="tab-pane fade mt-4 pt-5">
                        <div class="row">
                            <t t-if="properties_villa">
                                <t t-foreach="properties_villa" t-as="property">
                                    <t t-call="theme_livelo.property_card_template"/>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-lg-12 text-center py-5">
                                    <p class="text-muted">No villas found.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <!-- Studio -->
                    <div id="prop_tab_studio" class="tab-pane fade mt-4 pt-5">
                        <div class="row">
                            <t t-if="properties_studio">
                                <t t-foreach="properties_studio" t-as="property">
                                    <t t-call="theme_livelo.property_card_template"/>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-lg-12 text-center py-5">
                                    <p class="text-muted">No studios found.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <!-- House -->
                    <div id="prop_tab_house" class="tab-pane fade mt-4 pt-5">
                        <div class="row">
                            <t t-if="properties_house">
                                <t t-foreach="properties_house" t-as="property">
                                    <t t-call="theme_livelo.property_card_template"/>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-lg-12 text-center py-5">
                                    <p class="text-muted">No houses found.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                    <!-- Office -->
                    <div id="prop_tab_office" class="tab-pane fade mt-4 pt-5">
                        <div class="row">
                            <t t-if="properties_office">
                                <t t-foreach="properties_office" t-as="property">
                                    <t t-call="theme_livelo.property_card_template"/>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-lg-12 text-center py-5">
                                    <p class="text-muted">No offices found.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="properties_list" name="Featured Properties Grid">
        <section class="section-discover-homelego w-100 o_colored_level s_properties_list" data-snippet="theme_livelo.properties_list" data-name="Featured Properties Grid">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="heading-section mb-5 mt-5 w-100 float-left text-center">
                            <p class="m-0 p-0">Featured Properties</p>
                            <h2 class="font-weight-bold">Discover Livelo's<br/>Finest Properties for Your Dream Home
                            </h2>
                        </div>
                    </div>
                </div>
                <div class="s_properties_list_container o_not_editable" contenteditable="false">
                    <!-- Static placeholder for edit mode so the snippet overlay doesn't break due to async DOM mutation -->
                    <div class="row s_property_tabs_row">
                        <div class="col-12 text-center p-5 border border-dashed rounded bg-light text-muted">
                            <i class="fa fa-spinner fa-spin fa-2x mb-3"></i>
                            <h4>Properties will load here dynamically</h4>
                            <p class="mb-0">This placeholder is shown in edit mode. The real properties and tabs will appear when you save and view the page.</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <a class="btn-learn-more-properties text-white btn-primary mt-5 w-25 mb-3 pl-5 pr-5 pt-3 pb-3 text-decoration-none text-center"
                           href="/shop">View all Properties
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>