<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="theme_livelo_custom_snippets" inherit_id="website.snippets">
        <!-- Add Theme Livelo category to Odoo Building Block Categories -->
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t snippet-group="theme_livelo" t-snippet="website.s_snippet_group" string="Theme Livelo"
               t-thumbnail="/theme_livelo/static/description/icon.png"/>
        </xpath>

        <!-- Add theme snippets to snippet_structure under the Theme Livelo group -->
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_livelo.main_banner" string="Main Hero Banner" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/banner-bg-image.png"/>
            <t t-snippet="theme_livelo.home_banner" string="Home Banner" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/buy-a-home-img.png"/>
            <t t-snippet="theme_livelo.properties_list" string="Featured Properties Grid" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/sell-a-home-img.png"/>
            <t t-snippet="theme_livelo.explore_cities" string="Explore Cities" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/city.png"/>
            <t t-snippet="theme_livelo.testimonial" string="Testimonials" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/customer-review.png"/>
            <t t-snippet="theme_livelo.benifits" string="Benefits" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/benefit.png"/>
            <t t-snippet="theme_livelo.agent" string="Agents" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/agent_icon.png"/>
            <t t-snippet="theme_livelo.blogs_snippet" string="Blogs" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/about-image.png"/>
            <t t-snippet="theme_livelo.contact_us" string="Contact Us" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/contacts.png"/>
            <t t-snippet="theme_livelo.questions" string="FAQs" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/question.png"/>
            <t t-snippet="theme_livelo.location" string="Location" group="theme_livelo" t-thumbnail="/theme_livelo/static/src/images/location.png"/>
        </xpath>
    </template>
</odoo>
