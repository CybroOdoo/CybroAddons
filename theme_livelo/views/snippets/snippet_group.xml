<?xml version="1.0" encoding="utf-8"?>
<!--This file extends the Odoo Website Builder snippets panel by adding-->
<!--    a dedicated "Theme Livelo Snippets" section.-->
<odoo>
    <template id="theme_livelo_custom_snippets" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_content']" position="before">
            <div id="snippet_livelo" class="o_panel">
                <div class="o_panel_header">Theme Livelo Snippets</div>
                <div class="o_panel_body">
                    <t t-snippet="theme_livelo.main_banner" string="Main Hero Banner" t-thumbnail="/theme_livelo/static/src/images/banner-bg-image.png"/>
                    <t t-snippet="theme_livelo.home_banner" string="Home Banner" t-thumbnail="/theme_livelo/static/src/images/buy-a-home-img.png"/>
                    <t t-snippet="theme_livelo.properties_list" string="Property List" t-thumbnail="/theme_livelo/static/src/images/search.png"/>
                    <t t-snippet="theme_livelo.explore_cities" string="Explore Cities" t-thumbnail="/theme_livelo/static/src/images/city.png"/>
                    <t t-snippet="theme_livelo.testimonial" string="Testimonial" t-thumbnail="/theme_livelo/static/src/images/customer-review.png"/>
                    <t t-snippet="theme_livelo.benifits" string="Benefits" t-thumbnail="/theme_livelo/static/src/images/benefit.png"/>
                    <t t-snippet="theme_livelo.agent" string="Agents" t-thumbnail="/theme_livelo/static/src/images/agent_icon.png"/>
                    <t t-snippet="theme_livelo.latest_blog_snippet" string="Blogs" t-thumbnail="/theme_livelo/static/src/images/about-image.png"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
