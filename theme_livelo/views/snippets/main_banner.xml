<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template for main hero banner snippet -->
    <template id="main_banner" name="Main Hero Banner">
        <section class="banner-section float-left w-100 oe_snippet_body" data-snippet="main_banner" data-name="Main Banner">
            <div class="oe_structure"/>
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="banner-content float-left w-100 text-white">
                            <h1 class="font-weight-bold">Indulge in Your Sanctuary Safe House</h1>
                            <p>Discover your private oasis at Homelengo, where every corner, from the spacious garden to the relaxing pool, is crafted for your comfort and enjoyment.</p>
                            <ul class="ps-0 d-flex flex-wrap gap-2">
                                <li class="d-flex align-items-center">
                                    <a href="/shop?type=house" class="text-white text-decoration-none d-flex align-items-center px-3 py-2">
                                        <img src="/theme_livelo/static/src/images/icon-house.png" />
                                        <span class="ms-1">Houses</span>
                                    </a>
                                </li>
                                <li class="d-flex align-items-center">
                                    <a href="/shop?type=villa" class="text-white text-decoration-none d-flex align-items-center px-3 py-2">
                                        <img src="/theme_livelo/static/src/images/icon-villa.png" />
                                        <span class="ms-1">Villa</span>
                                    </a>
                                </li>
                                <li class="d-flex align-items-center">
                                    <a href="/shop?type=office" class="text-white text-decoration-none d-flex align-items-center px-3 py-2">
                                        <img src="/theme_livelo/static/src/images/icon-office.png" />
                                        <span class="ms-1">Office</span>
                                    </a>
                                </li>
                                <li class="d-flex align-items-center">
                                    <a href="/shop?type=apartment" class="text-white text-decoration-none d-flex align-items-center px-3 py-2">
                                        <img src="/theme_livelo/static/src/images/icon-appartments.png" />
                                        <span class="ms-1">Apartments</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-6">
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
