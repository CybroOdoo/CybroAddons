<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template for home banner snippet (Our Services) -->
    <template id="home_banner" name="Home Banner">
        <section class="section-welcome-home-lengo w-100 o_colored_level s_home_banner" data-snippet="theme_livelo.home_banner" data-name="Home Banner">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="heading-section mb-5 w-100 text-center">
                            <p class="m-0 p-0">Our Services</p>
                            <h2 class="fw-bold">Welcome to Livelo</h2>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="home-section h-100 text-center p-4 d-flex flex-column justify-content-between shadow-sm">
                            <div>
                                <img src="/theme_livelo/static/src/images/img-buy-a-home.png" alt="Buy A New Home"/>
                                <h2 class="fw-bold pt-2">Buy A New Home</h2>
                                <p class="text-muted">Discover your dream home effortlessly.
                                    Explore diverse properties and expert
                                    guidance for a seamless buying experience.
                                </p>
                            </div>
                            <div>
                                <a class="btn-learn-more text-white btn-primary mt-4 d-inline-block px-5 py-3 text-decoration-none text-center"
                                   href="/shop?listing=sale">Learn More
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="home-section h-100 text-center p-4 d-flex flex-column justify-content-between shadow-sm">
                            <div>
                                <img src="/theme_livelo/static/src/images/img-sell-a-home.png" alt="Sell A Home"/>
                                <h2 class="fw-bold pt-2">Sell A Home</h2>
                                <p class="text-muted">Discover your dream home effortlessly.
                                    Explore diverse properties and expert
                                    guidance for a seamless buying experience.
                                </p>
                            </div>
                            <div>
                                <a class="btn-learn-more text-white btn-primary mt-4 d-inline-block px-5 py-3 text-decoration-none text-center"
                                   href="/shop">Learn More
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="home-section h-100 text-center p-4 d-flex flex-column justify-content-between shadow-sm">
                            <div>
                                <img src="/theme_livelo/static/src/images/img-rent-a-home.png" alt="Rent A Home"/>
                                <h2 class="fw-bold pt-2">Rent A Home</h2>
                                <p class="text-muted">Discover your dream home effortlessly.
                                    Explore diverse properties and expert
                                    guidance for a seamless buying experience.
                                </p>
                            </div>
                            <div>
                                <a class="btn-learn-more text-white btn-primary mt-4 d-inline-block px-5 py-3 text-decoration-none text-center"
                                   href="/shop?listing=rent">Learn More
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>