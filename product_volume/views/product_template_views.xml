<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit product.template form to add dimensions and volume UoM -->
    <record id="product_template_form_view_inherit_product_volume"
            model="ir.ui.view">
        <field name="name">
            product.template.view.form.inherit.product.volume
        </field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='volume']" position="after">
                <label for="length" string="Dimensions"/>
                <div class="o_row">
                    <field name="length"
                           class="oe_inline"
                           style="max-width: 7rem;"
                           placeholder="Length"/>
                    <field name="breadth"
                           class="oe_inline"
                           style="max-width: 7rem;"
                           placeholder="Breadth"/>
                    <field name="height"
                           class="oe_inline"
                           style="max-width: 7rem;"
                           placeholder="Height"/>
                    <field name="length_uom" class="oe_inline" style="max-width: 9rem;"/>
                </div>
                <label for="calc_volume"
                       string="Calculated Volume"
                       invisible="not length or not breadth or not height"/>
                <div class="o_row"
                     invisible="not length or not breadth or not height">
                    <field name="calc_volume"
                           class="oe_inline"
                           style="max-width: 7rem;"/>
                    <field name="volume_uom"
                           class="oe_inline"
                           style="max-width: 9rem;"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
