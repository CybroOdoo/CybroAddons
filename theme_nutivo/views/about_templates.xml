<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Nutivo Our Story page, built from the markup of the Nutivo snippets, inlined so the page body stays editable in the website builder.
-->
<odoo>
    <template id="about_page" name="Nutivo Our Story">
        <t t-call="website.layout">
            <t t-set="additional_title">Our Story</t>
            <t t-set="pageName" t-valuef="about"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="nv-s s_nutivo_page_hero nv-hero nv-hero--page" data-name="Page Hero" data-snippet="s_nutivo_page_hero">
                      <div class="nv-hero__media" aria-hidden="true">
                        <img src="/theme_nutivo/static/src/img/content/about-hero-wide.jpg" alt=""/>
                      </div>
                      <div class="nv-hero__frame" aria-hidden="true"/>
                      <div class="nv-container nv-hero__inner">
                        <div class="nv-hero__copy">
                          <nav class="nv-breadcrumb nv-breadcrumb--light nv-reveal" aria-label="Breadcrumb">
                            <ol><li><a href="/">Home</a></li><li aria-current="page">Our Story</li></ol>
                          </nav>
                          <p class="nv-eyebrow nv-eyebrow--gold nv-reveal">Our Story</p>
                          <h1 class="nv-hero__title nv-reveal">Rooted in Nature, <em>Crafted with Care.</em></h1>
                          <p class="nv-hero__lede nv-reveal">For more than a decade we have travelled to the world's finest orchards, so every handful you open tastes exactly as nature intended.</p>
                          <div class="nv-hero__actions nv-reveal">
                            <a href="/shop" class="nv-btn nv-btn--gold">Shop the Collection <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                            <a href="#origins" class="nv-btn nv-btn--ghost-light">Meet Our Origins</a>
                          </div>
                        </div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_about_intro nv-section nv-about-intro" data-name="Intro Statement" data-snippet="s_nutivo_about_intro">
                      <div class="nv-container nv-about-intro__grid">
                        <div class="nv-reveal">
                          <p class="nv-eyebrow">Since 2014</p>
                          <h2 class="nv-section-title">A handful of nuts should taste of the place it was grown.</h2>
                        </div>
                        <div class="nv-about-intro__body nv-reveal">
                          <p>Nutivo began with a small spice-market stall in Kochi and one stubborn belief: that the everyday snack deserved the same care as a fine wine or a single-estate tea. We started with almonds from a family farm in California, sold by the scoop and tasted before every sale.</p>
                          <p>Today we work directly with fourteen growers across six countries. We still taste every batch, still sort by hand, and still pack within days of roasting. No fillers, no shortcuts, just honest food with a story behind it.</p>
                          <div class="nv-signature">
                            <span class="nv-signature__mark" aria-hidden="true">M&amp;A</span>
                            <span><strong>Meera &amp; Arjun Nair</strong><small>Founders, Nutivo</small></span>
                          </div>
                        </div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_stats nv-container" aria-label="Nutivo in numbers" data-name="Stats Band" data-snippet="s_nutivo_stats">
                      <ul class="nv-stats-band nv-reveal">
                        <li><strong class="nv-stat__num">2014</strong><span>Year we began</span></li>
                        <li><strong class="nv-stat__num">14</strong><span>Partner farms</span></li>
                        <li><strong class="nv-stat__num">6</strong><span>Origin countries</span></li>
                        <li><strong class="nv-stat__num">12,400+</strong><span>Happy snackers</span></li>
                      </ul>
                    </section>
                <section class="nv-s s_nutivo_timeline nv-section" id="journey" data-name="Timeline" data-snippet="s_nutivo_timeline">
                      <div class="nv-container">
                        <div class="nv-section-head nv-section-head--center nv-reveal">
                          <p class="nv-eyebrow">Our Journey</p>
                          <h2 class="nv-section-title">Twelve years, one handful at a time</h2>
                        </div>
                        <ol class="nv-timeline">
                          <li class="nv-timeline__item nv-reveal">
                            <span class="nv-timeline__year">2014</span>
                            <h3>A stall in Kochi</h3>
                            <p>Meera and Arjun open a weekend stall at the spice market, selling California almonds by the scoop.</p>
                          </li>
                          <li class="nv-timeline__item nv-reveal">
                            <span class="nv-timeline__year">2016</span>
                            <h3>Our first farm partner</h3>
                            <p>A handshake with a family orchard in Kerman brings our first direct-trade pistachios home.</p>
                          </li>
                          <li class="nv-timeline__item nv-reveal">
                            <span class="nv-timeline__year">2019</span>
                            <h3>The Kochi atelier</h3>
                            <p>We open our own roastery and packing room, so every batch is roasted and sealed under one roof.</p>
                          </li>
                          <li class="nv-timeline__item nv-reveal">
                            <span class="nv-timeline__year">2022</span>
                            <h3>Gifting, reimagined</h3>
                            <p>Our keepsake hampers launch, and corporate gifting grows to more than 300 companies across India.</p>
                          </li>
                          <li class="nv-timeline__item nv-reveal">
                            <span class="nv-timeline__year">2026</span>
                            <h3>Fourteen growers strong</h3>
                            <p>Six countries, fourteen family farms and one promise that hasn't changed since the first scoop.</p>
                          </li>
                        </ol>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_process nv-section" id="process" data-name="Process" data-snippet="s_nutivo_process">
                      <div class="nv-container">
                        <div class="nv-section-head nv-section-head--split nv-reveal">
                          <div>
                            <p class="nv-eyebrow">How We Work</p>
                            <h2 class="nv-section-title">From Orchard to Your Table</h2>
                          </div>
                          <p class="nv-section-sub nv-section-sub--right">Four careful steps, never rushed, never outsourced. It is slower than the industry way, and that's exactly the point.</p>
                        </div>
                        <div class="nv-process-grid">
                          <article class="nv-process-card nv-reveal">
                            <div class="nv-process-card__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/process-sourced.jpg" alt="Rows of freshly harvested dates in amber and deep brown"/></div>
                            <span class="nv-process-card__num">01</span>
                            <h3>Sourced at origin</h3>
                            <p>We buy directly from growers we know by name, at fair prices agreed before harvest.</p>
                          </article>
                          <article class="nv-process-card nv-reveal">
                            <div class="nv-process-card__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/process-sorted.jpg" alt="Hands sorting black, red and golden raisins on a wooden tray"/></div>
                            <span class="nv-process-card__num">02</span>
                            <h3>Sorted by hand</h3>
                            <p>Every lot is graded by eye and hand. Only the top 8% of each harvest earns the Nutivo seal.</p>
                          </article>
                          <article class="nv-process-card nv-reveal">
                            <div class="nv-process-card__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/process-roasted.jpg" alt="A dark ceramic bowl of slow-roasted mixed nuts"/></div>
                            <span class="nv-process-card__num">03</span>
                            <h3>Slow roasted</h3>
                            <p>Small 12 kg batches at low heat caramelise natural sugars for deeper flavour, never bitterness.</p>
                          </article>
                          <article class="nv-process-card nv-reveal">
                            <div class="nv-process-card__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/process-packed.jpg" alt="Hands wrapping kraft-paper gifts with ribbon and twine"/></div>
                            <span class="nv-process-card__num">04</span>
                            <h3>Packed fresh</h3>
                            <p>Sealed within 72 hours of roasting in recyclable pouches, then dispatched straight to you.</p>
                          </article>
                        </div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_origins nv-section" id="origins" data-name="Origins" data-snippet="s_nutivo_origins">
                      <div class="nv-container">
                        <div class="nv-section-head nv-section-head--center nv-reveal">
                          <p class="nv-eyebrow">Our Origins</p>
                          <h2 class="nv-section-title">Where Our Harvests Grow</h2>
                          <p class="nv-section-sub">Each ingredient comes from the region that grows it best. Tap an origin to taste it.</p>
                        </div>
                        <div class="nv-origin-grid">
                          <a class="nv-origin nv-reveal" href="/shop?search=almonds">
                            <img loading="lazy" src="/theme_nutivo/static/src/img/content/almonds.jpg" alt="California almonds in a dark ceramic bowl"/>
                            <span class="nv-origin__body"><span class="nv-origin__place">California, USA</span><span class="nv-origin__name">Almonds</span></span>
                          </a>
                          <a class="nv-origin nv-reveal" href="/shop?search=pistachios">
                            <img loading="lazy" src="/theme_nutivo/static/src/img/content/pistachios.jpg" alt="Roasted pistachios from Kerman"/>
                            <span class="nv-origin__body"><span class="nv-origin__place">Kerman, Iran</span><span class="nv-origin__name">Pistachios</span></span>
                          </a>
                          <a class="nv-origin nv-reveal" href="/shop?search=medjool">
                            <img loading="lazy" src="/theme_nutivo/static/src/img/content/dates.jpg" alt="Medjool dates in a wooden bowl"/>
                            <span class="nv-origin__body"><span class="nv-origin__place">Jordan Valley</span><span class="nv-origin__name">Medjool Dates</span></span>
                          </a>
                          <a class="nv-origin nv-reveal" href="/shop?search=apricots">
                            <img loading="lazy" src="/theme_nutivo/static/src/img/content/dried-fruits.jpg" alt="Golden sun-dried apricots"/>
                            <span class="nv-origin__body"><span class="nv-origin__place">Malatya, Turkey</span><span class="nv-origin__name">Apricots</span></span>
                          </a>
                          <a class="nv-origin nv-reveal" href="/shop?search=walnuts">
                            <img loading="lazy" src="/theme_nutivo/static/src/img/content/walnuts.jpg" alt="Whole in-shell Kashmiri walnuts"/>
                            <span class="nv-origin__body"><span class="nv-origin__place">Kashmir, India</span><span class="nv-origin__name">Walnuts</span></span>
                          </a>
                          <a class="nv-origin nv-reveal" href="/shop?search=cashews">
                            <img loading="lazy" src="/theme_nutivo/static/src/img/content/cashews.jpg" alt="Whole W240 cashews from Goa"/>
                            <span class="nv-origin__body"><span class="nv-origin__place">Goa, India</span><span class="nv-origin__name">Cashews</span></span>
                          </a>
                        </div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_founder nv-section" data-name="Founder Note" data-snippet="s_nutivo_founder">
                      <div class="nv-container">
                        <figure class="nv-founder nv-reveal">
                          <div class="nv-founder__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/founder.jpg" alt="Medjool dates arranged on a rustic wood slice"/></div>
                          <div class="nv-founder__body">
                            <i class="nv-i nv-ph-quotes-light nv-founder__quote-icon" role="img" aria-hidden="true"/>
                            <h2 class="nv-sr-only">A note from our founders</h2>
                            <blockquote>We never set out to build the biggest dry-fruit brand. We wanted to build the one we'd trust to feed our own family, and to give the growers behind it the credit they deserve.</blockquote>
                            <figcaption><strong>Meera &amp; Arjun Nair</strong><span>Founders, Nutivo · Kochi</span></figcaption>
                          </div>
                        </figure>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_cta nv-container" data-name="Call to Action" data-snippet="s_nutivo_cta">
                      <div class="nv-about-cta nv-reveal">
                        <div class="nv-about-cta__copy">
                          <p class="nv-eyebrow nv-eyebrow--gold">Taste the Difference</p>
                          <h2 class="nv-about-cta__title">Bring the orchard home</h2>
                          <p>Explore our single-origin nuts, sun-dried fruits and hand-packed hampers, delivered fresh across India.</p>
                        </div>
                        <div class="nv-about-cta__actions">
                          <a href="/shop" class="nv-btn nv-btn--gold">Shop the Collection <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                          <a href="/#hampers" class="nv-btn nv-btn--ghost-light">Explore Gift Hampers</a>
                        </div>
                      </div>
                    </section>
            </div>
        </t>
    </template>

    <record id="about_page_page" model="theme.website.page">
        <field name="url">/about</field>
        <field name="view_id" ref="about_page"/>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
