<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Shop by category: round photos with a name and a count.
-->
<odoo>
    <template id="s_nutivo_categories" name="Nutivo Category Row">
        <section class="nv-s s_nutivo_categories nv-section nv-categories" data-name="Category Row">
              <div class="nv-container">
                <div class="nv-section-head nv-section-head--center nv-reveal">
                  <p class="nv-eyebrow">Shop by Category</p>
                  <h2 class="nv-section-title">Curated from the world's finest orchards</h2>
                </div>
                <ul class="nv-cat-row">
                  <li class="nv-reveal"><a href="nutivo_category_nuts" class="nv-cat">
                    <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/almonds.jpg" alt=""/></span>
                    <span class="nv-cat__name">Premium Nuts</span><span class="nv-cat__count">6 varieties</span></a></li>
                  <li class="nv-reveal"><a href="nutivo_category_dried" class="nv-cat">
                    <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/dates.jpg" alt=""/></span>
                    <span class="nv-cat__name">Medjool Dates</span><span class="nv-cat__count">Jordan &amp; Madinah</span></a></li>
                  <li class="nv-reveal"><a href="nutivo_category_dried" class="nv-cat">
                    <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/dried-fruits.jpg" alt=""/></span>
                    <span class="nv-cat__name">Dried Fruits</span><span class="nv-cat__count">Sun-dried</span></a></li>
                  <li class="nv-reveal"><a href="nutivo_category_mixes" class="nv-cat">
                    <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/trail-mix.jpg" alt=""/></span>
                    <span class="nv-cat__name">Trail Mixes</span><span class="nv-cat__count">Blended in-house</span></a></li>
                  <li class="nv-reveal"><a href="nutivo_category_hampers" class="nv-cat">
                    <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/hampers.jpg" alt=""/></span>
                    <span class="nv-cat__name">Gift Hampers</span><span class="nv-cat__count">Hand-packed</span></a></li>
                  <li class="nv-reveal"><a href="#festive" class="nv-cat">
                    <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/festive.jpg" alt=""/><span class="nv-cat__tag">New</span></span>
                    <span class="nv-cat__name">Festive Edit</span><span class="nv-cat__count">Limited season</span></a></li>
                </ul>
              </div>
            </section>
    </template>
</odoo>
