<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Goodness band: photo, counted-up figures and a link.
-->
<odoo>
    <template id="s_nutivo_goodness" name="Nutivo Goodness Band">
        <section class="nv-s s_nutivo_goodness nv-container" aria-label="Nutrition highlights" data-name="Goodness Band">
              <div class="nv-goodness nv-reveal">
                <div class="nv-goodness__img">
                  <img loading="lazy" src="/theme_nutivo/static/src/img/content/hero.jpg" alt="Small white bowls of dates, almonds, cashews, peanuts and pistachios"/>
                </div>
                <div class="nv-goodness__body">
                  <h2 class="nv-goodness__title">Goodness in Every Handful</h2>
                  <ul class="nv-goodness__stats">
                    <li><strong>6g</strong><span>Plant protein per 30g</span></li>
                    <li><strong>0</strong><span>Added preservatives</span></li>
                    <li><strong>14</strong><span>Origin farms</span></li>
                    <li><strong>100%</strong><span>Real ingredients</span></li>
                  </ul>
                </div>
                <a href="/about#promise" class="nv-btn nv-btn--ghost-light">Our Quality Promise</a>
              </div>
            </section>
    </template>
</odoo>
