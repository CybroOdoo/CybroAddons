<!--
    Dark call-to-action card with two buttons.
-->
<odoo>
    <template id="s_nutivo_cta" name="Nutivo Call to Action">
        <section class="nv-s s_nutivo_cta nv-container" data-name="Call to Action">
              <div class="nv-about-cta nv-reveal">
                <div class="nv-about-cta__copy">
                  <p class="nv-eyebrow nv-eyebrow--gold">Taste the Difference</p>
                  <h2 class="nv-about-cta__title">Bring the orchard home</h2>
                  <p>Explore our single-origin nuts, sun-dried fruits and hand-packed hampers, delivered fresh across India.</p>
                </div>
                <div class="nv-about-cta__actions">
                  <a href="/shop" class="nv-btn nv-btn--gold">Shop the Collection <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                  <a href="/#hampers" class="nv-btn nv-btn--ghost-light">Explore Gift Hampers</a>
                </div>
              </div>
            </section>
    </template>
</odoo>
