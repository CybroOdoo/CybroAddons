<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Founder quote beside a photo.
-->
<odoo>
    <template id="s_nutivo_founder" name="Nutivo Founder Note">
        <section class="nv-s s_nutivo_founder nv-section" data-name="Founder Note">
              <div class="nv-container">
                <figure class="nv-founder nv-reveal">
                  <div class="nv-founder__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/founder.jpg" alt="Medjool dates arranged on a rustic wood slice"/></div>
                  <div class="nv-founder__body">
                    <i class="nv-i nv-ph-quotes-light nv-founder__quote-icon" role="img" aria-hidden="true"/>
                    <h2 class="nv-sr-only">A note from our founders</h2>
                    <blockquote>We never set out to build the biggest dry-fruit brand. We wanted to build the one we'd trust to feed our own family, and to give the growers behind it the credit they deserve.</blockquote>
                    <figcaption><strong>Meera &amp; Arjun Nair</strong><span>Founders, Nutivo · Kochi</span></figcaption>
                  </div>
                </figure>
              </div>
            </section>
    </template>
</odoo>
