<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Four process cards with a photo and a number.
-->
<odoo>
    <template id="s_nutivo_process" name="Nutivo Process">
        <section class="nv-s s_nutivo_process nv-section" id="process" data-name="Process">
              <div class="nv-container">
                <div class="nv-section-head nv-section-head--split nv-reveal">
                  <div>
                    <p class="nv-eyebrow">How We Work</p>
                    <h2 class="nv-section-title">From Orchard to Your Table</h2>
                  </div>
                  <p class="nv-section-sub nv-section-sub--right">Four careful steps, never rushed, never outsourced. It is slower than the industry way, and that's exactly the point.</p>
                </div>
                <div class="nv-process-grid">
                  <article class="nv-process-card nv-reveal">
                    <div class="nv-process-card__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/process-sourced.jpg" alt="Rows of freshly harvested dates in amber and deep brown"/></div>
                    <span class="nv-process-card__num">01</span>
                    <h3>Sourced at origin</h3>
                    <p>We buy directly from growers we know by name, at fair prices agreed before harvest.</p>
                  </article>
                  <article class="nv-process-card nv-reveal">
                    <div class="nv-process-card__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/process-sorted.jpg" alt="Hands sorting black, red and golden raisins on a wooden tray"/></div>
                    <span class="nv-process-card__num">02</span>
                    <h3>Sorted by hand</h3>
                    <p>Every lot is graded by eye and hand. Only the top 8% of each harvest earns the Nutivo seal.</p>
                  </article>
                  <article class="nv-process-card nv-reveal">
                    <div class="nv-process-card__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/process-roasted.jpg" alt="A dark ceramic bowl of slow-roasted mixed nuts"/></div>
                    <span class="nv-process-card__num">03</span>
                    <h3>Slow roasted</h3>
                    <p>Small 12 kg batches at low heat caramelise natural sugars for deeper flavour, never bitterness.</p>
                  </article>
                  <article class="nv-process-card nv-reveal">
                    <div class="nv-process-card__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/process-packed.jpg" alt="Hands wrapping kraft-paper gifts with ribbon and twine"/></div>
                    <span class="nv-process-card__num">04</span>
                    <h3>Packed fresh</h3>
                    <p>Sealed within 72 hours of roasting in recyclable pouches, then dispatched straight to you.</p>
                  </article>
                </div>
              </div>
            </section>
    </template>
</odoo>
