<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Origin photo cards linking to the shop.
-->
<odoo>
    <template id="s_nutivo_origins" name="Nutivo Origins">
        <section class="nv-s s_nutivo_origins nv-section" id="origins" data-name="Origins">
              <div class="nv-container">
                <div class="nv-section-head nv-section-head--center nv-reveal">
                  <p class="nv-eyebrow">Our Origins</p>
                  <h2 class="nv-section-title">Where Our Harvests Grow</h2>
                  <p class="nv-section-sub">Each ingredient comes from the region that grows it best. Tap an origin to taste it.</p>
                </div>
                <div class="nv-origin-grid">
                  <a class="nv-origin nv-reveal" href="/shop?search=almonds">
                    <img loading="lazy" src="/theme_nutivo/static/src/img/content/almonds.jpg" alt="California almonds in a dark ceramic bowl"/>
                    <span class="nv-origin__body"><span class="nv-origin__place">California, USA</span><span class="nv-origin__name">Almonds</span></span>
                  </a>
                  <a class="nv-origin nv-reveal" href="/shop?search=pistachios">
                    <img loading="lazy" src="/theme_nutivo/static/src/img/content/pistachios.jpg" alt="Roasted pistachios from Kerman"/>
                    <span class="nv-origin__body"><span class="nv-origin__place">Kerman, Iran</span><span class="nv-origin__name">Pistachios</span></span>
                  </a>
                  <a class="nv-origin nv-reveal" href="/shop?search=medjool">
                    <img loading="lazy" src="/theme_nutivo/static/src/img/content/dates.jpg" alt="Medjool dates in a wooden bowl"/>
                    <span class="nv-origin__body"><span class="nv-origin__place">Jordan Valley</span><span class="nv-origin__name">Medjool Dates</span></span>
                  </a>
                  <a class="nv-origin nv-reveal" href="/shop?search=apricots">
                    <img loading="lazy" src="/theme_nutivo/static/src/img/content/dried-fruits.jpg" alt="Golden sun-dried apricots"/>
                    <span class="nv-origin__body"><span class="nv-origin__place">Malatya, Turkey</span><span class="nv-origin__name">Apricots</span></span>
                  </a>
                  <a class="nv-origin nv-reveal" href="/shop?search=walnuts">
                    <img loading="lazy" src="/theme_nutivo/static/src/img/content/walnuts.jpg" alt="Whole in-shell Kashmiri walnuts"/>
                    <span class="nv-origin__body"><span class="nv-origin__place">Kashmir, India</span><span class="nv-origin__name">Walnuts</span></span>
                  </a>
                  <a class="nv-origin nv-reveal" href="/shop?search=cashews">
                    <img loading="lazy" src="/theme_nutivo/static/src/img/content/cashews.jpg" alt="Whole W240 cashews from Goa"/>
                    <span class="nv-origin__body"><span class="nv-origin__place">Goa, India</span><span class="nv-origin__name">Cashews</span></span>
                  </a>
                </div>
              </div>
            </section>
    </template>
</odoo>
