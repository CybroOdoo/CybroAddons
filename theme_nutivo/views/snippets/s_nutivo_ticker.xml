<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Range ticker: words and round photos looping at a speed that follows the scroll.
-->
<odoo>
    <template id="s_nutivo_ticker" name="Nutivo Range Ticker">
        <section class="nv-s s_nutivo_ticker nv-ticker" aria-label="Our range: almonds, pistachios, Medjool dates, cashews, walnuts, apricots, cranberries and trail mixes" data-name="Range Ticker">
              <div class="nv-ticker__track">
                <div class="nv-ticker__group"><span class="nv-ticker__word">Almonds</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/almonds.jpg" alt="" loading="lazy"/><span class="nv-ticker__word nv-ticker__word--outline">Pistachios</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/pistachios.jpg" alt="" loading="lazy"/><span class="nv-ticker__word">Medjool Dates</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/dates.jpg" alt="" loading="lazy"/><span class="nv-ticker__word nv-ticker__word--outline">Cashews</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/cashews.jpg" alt="" loading="lazy"/><span class="nv-ticker__word">Walnuts</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/walnuts.jpg" alt="" loading="lazy"/><span class="nv-ticker__word nv-ticker__word--outline">Apricots</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/dried-fruits.jpg" alt="" loading="lazy"/><span class="nv-ticker__word">Cranberries</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/cranberries.jpg" alt="" loading="lazy"/><span class="nv-ticker__word nv-ticker__word--outline">Trail Mixes</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/trail-mix.jpg" alt="" loading="lazy"/></div>
                </div>
            </section>
    </template>
</odoo>
