<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Registers the Nutivo snippets in the website builder, in their own "Nutivo" group.
-->
<odoo>
    <template id="snippets" inherit_id="website.snippets" name="Nutivo Snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="nutivo" t-snippet="website.s_snippet_group" string="Nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_group.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_nutivo.s_nutivo_hero" string="Hero" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_hero.jpg">
                <keywords>hero, banner, cover, featured, home</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_ticker" string="Range Ticker" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_ticker.jpg">
                <keywords>ticker, marquee, range, scroll</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_categories" string="Category Row" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_categories.jpg">
                <keywords>categories, shop, round, row</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_goodness" string="Goodness Band" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_goodness.jpg">
                <keywords>nutrition, stats, band, highlights</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_bestsellers" string="Bestsellers" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_bestsellers.jpg">
                <keywords>products, bestsellers, shop, grid</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_hampers" string="Gift Hampers" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_hampers.jpg">
                <keywords>hampers, gifts, products, cards</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_festive" string="Festive Collections" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_festive.jpg">
                <keywords>festive, seasonal, cards, collections</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_testimonials" string="Testimonials" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_testimonials.jpg">
                <keywords>reviews, testimonials, quotes, slider</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_newsletter" string="Newsletter" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_newsletter.jpg">
                <keywords>newsletter, subscribe, email, circle</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_page_hero" string="Page Hero" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_page_hero.jpg">
                <keywords>page hero, title, breadcrumb, cover</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_about_intro" string="Intro Statement" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_about_intro.jpg">
                <keywords>about, intro, statement, signature</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_stats" string="Stats Band" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_stats.jpg">
                <keywords>stats, numbers, figures, count</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_timeline" string="Timeline" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_timeline.jpg">
                <keywords>timeline, journey, history, years</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_process" string="Process" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_process.jpg">
                <keywords>process, steps, how we work, cards</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_origins" string="Origins" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_origins.jpg">
                <keywords>origins, regions, images, grid</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_founder" string="Founder Note" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_founder.jpg">
                <keywords>founder, quote, note</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_cta" string="Call to Action" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_cta.jpg">
                <keywords>call to action, banner, cta</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_help" string="Help Cards" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_help.jpg">
                <keywords>help, teams, contact, cards</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_faq" string="FAQ" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_faq.jpg">
                <keywords>faq, questions, accordion</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_perks" string="Perks Strip" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_perks.jpg">
                <keywords>perks, shipping, benefits, strip</keywords>
            </t>
            <t t-snippet="theme_nutivo.s_nutivo_contact" string="Contact Panel" group="nutivo"
               t-thumbnail="/theme_nutivo/static/src/img/snippets/s_nutivo_contact.jpg">
                <keywords>contact, form, map, address</keywords>
            </t>
        </xpath>
    </template>
</odoo>
