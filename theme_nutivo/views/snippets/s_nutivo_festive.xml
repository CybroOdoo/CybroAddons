<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Seasonal collections: one tall and two wide photo cards revealed with a wipe.
-->
<odoo>
    <template id="s_nutivo_festive" name="Nutivo Festive Collections">
        <section class="nv-s s_nutivo_festive nv-section nv-festive-section" id="festive" data-name="Festive Collections">
              <div class="nv-container">
                <div class="nv-section-head nv-section-head--split nv-reveal">
                  <div>
                    <p class="nv-eyebrow">Seasonal &amp; Festive</p>
                    <h2 class="nv-section-title">Collections for Every Celebration</h2>
                  </div>
                  <p class="nv-section-sub nv-section-sub--right">Limited editions, released with the seasons and gone when the harvest ends.</p>
                </div>
                <div class="nv-festive-grid">
                  <article class="nv-festive-card nv-festive-card--tall nv-reveal">
                    <img loading="lazy" src="/theme_nutivo/static/src/img/content/festive-diwali.jpg" alt="Kraft gift boxes tied with red and white twine and a wax seal"/>
                    <div class="nv-festive-card__body">
                      <span class="nv-tag nv-tag--gold">Now Live</span>
                      <h3>The Diwali Edit</h3>
                      <p>Saffron-roasted cashews, rose-pistachio clusters and keepsake brass-lid boxes.</p>
                      <a href="nutivo_category_hampers" class="nv-link-arrow nv-link-arrow--light">Shop Diwali <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                    </div>
                  </article>
                  <article class="nv-festive-card nv-reveal">
                    <img loading="lazy" src="/theme_nutivo/static/src/img/content/festive-eid.jpg" alt="Two glass bowls of golden and dark dates beside prayer beads"/>
                    <div class="nv-festive-card__body">
                      <span class="nv-tag">Coming Soon</span>
                      <h3>Ramadan &amp; Eid</h3>
                      <p>Ajwa, Medjool and Kalmi dates in hand-tied tasting trays.</p>
                      <a href="/shop?search=dates" class="nv-link-arrow nv-link-arrow--light">Explore dates <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                    </div>
                  </article>
                  <article class="nv-festive-card nv-reveal">
                    <img loading="lazy" src="/theme_nutivo/static/src/img/content/festive-christmas.jpg" alt="Close-up of a fruitcake topped with whole almonds and walnuts"/>
                    <div class="nv-festive-card__body">
                      <span class="nv-tag">Winter</span>
                      <h3>The Christmas Pantry</h3>
                      <p>Plum-cake fruit soaks, candied pecans and walnut-studded gift jars.</p>
                      <a href="nutivo_category_mixes" class="nv-link-arrow nv-link-arrow--light">Preview <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                    </div>
                  </article>
                </div>
              </div>
            </section>
    </template>
</odoo>
