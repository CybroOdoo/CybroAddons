<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Customer reviews in a scroll-snapping slider with previous and next buttons.
-->
<odoo>
    <template id="s_nutivo_testimonials" name="Nutivo Testimonials">
        <section class="nv-s s_nutivo_testimonials nv-section nv-testimonials" data-name="Testimonials">
              <div class="nv-container">
                <div class="nv-section-head nv-section-head--split nv-reveal">
                  <div>
                    <p class="nv-eyebrow">Kind Words</p>
                    <h2 class="nv-section-title">What Our Customers Say</h2>
                  </div>
                  <div class="nv-slider-nav">
                    <button class="nv-icon-btn nv-icon-btn--ring" aria-label="Previous testimonials" data-nv-slide="prev"><i class="nv-i nv-ph-arrow-left-light" role="img" aria-hidden="true"/></button>
                    <button class="nv-icon-btn nv-icon-btn--ring" aria-label="Next testimonials" data-nv-slide="next"><i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></button>
                  </div>
                </div>
                <div class="nv-testi-track" tabindex="0" aria-label="Customer testimonials">
                  <figure class="nv-testi">
                    <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <blockquote>“The Medjool dates are unreal, soft as fudge and never sticky-sweet. I've stopped buying dates anywhere else.”</blockquote>
                    <figcaption><span class="nv-avatar" style="--nv-av:#A8B39A">AK</span><span><strong>Aisha K.</strong><small>Bengaluru · Verified buyer</small></span></figcaption>
                  </figure>
                  <figure class="nv-testi">
                    <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <blockquote>“We sent 140 hampers to clients this Diwali. Every single one arrived on time and the packaging drew compliments all week.”</blockquote>
                    <figcaption><span class="nv-avatar" style="--nv-av:#C5A46D">VM</span><span><strong>Vikram M.</strong><small>Head of HR, Mumbai</small></span></figcaption>
                  </figure>
                  <figure class="nv-testi">
                    <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <blockquote>“The Signature Trail Mix lives in my desk drawer. Fresh, crunchy, and you can actually taste that it's been roasted recently.”</blockquote>
                    <figcaption><span class="nv-avatar" style="--nv-av:#243B2F">PR</span><span><strong>Priya R.</strong><small>Kochi · Snack Club member</small></span></figcaption>
                  </figure>
                  <figure class="nv-testi">
                    <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <blockquote>“Built a custom box for my mother with her favourites and a note. She called me in tears. Thank you, Nutivo.”</blockquote>
                    <figcaption><span class="nv-avatar" style="--nv-av:#342A23">DS</span><span><strong>Daniel S.</strong><small>Pune · Verified buyer</small></span></figcaption>
                  </figure>
                  <figure class="nv-testi">
                    <div class="nv-testi__stars" aria-label="4 out of 5 stars">★★★★☆</div>
                    <blockquote>“Pistachios are huge and perfectly salted. Shipping took a day longer than expected, but worth every bit.”</blockquote>
                    <figcaption><span class="nv-avatar" style="--nv-av:#8C7A5B">NJ</span><span><strong>Neha J.</strong><small>Delhi · Verified buyer</small></span></figcaption>
                  </figure>
                  <figure class="nv-testi">
                    <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <blockquote>“Our café switched to Nutivo bulk almonds for our granola. Consistent quality, and the 15% tier makes the maths work.”</blockquote>
                    <figcaption><span class="nv-avatar" style="--nv-av:#6B7D5E">TC</span><span><strong>Tara C.</strong><small>Owner, Grain &amp; Co. Café</small></span></figcaption>
                  </figure>
                </div>
              </div>
            </section>
    </template>
</odoo>
