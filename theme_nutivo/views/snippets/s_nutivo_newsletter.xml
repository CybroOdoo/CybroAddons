<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Newsletter card subscribing visitors to a mailing list.
-->
<odoo>
    <template id="s_nutivo_newsletter" name="Nutivo Newsletter">
        <section class="nv-s s_nutivo_newsletter nv-container" id="subscribe" data-name="Newsletter">
              <div class="nv-newsletter nv-reveal">
                <div>
                  <h2 class="nv-newsletter__title">Join the Nutivo Circle</h2>
                  <p>Seasonal harvest notes, new recipes and early access to festive editions. Plus 10% off your first order.</p>
                </div>
                <div class="nv-newsletter__form js_subscribe" data-list-id="nutivo_mailing_list" data-name="Newsletter Form">
                  <label class="nv-sr-only">Email address</label>
                  <div class="js_subscribe_wrap"><div class="nv-newsletter__row">
                    <i class="nv-i nv-ph-envelope-simple-light" role="img" aria-hidden="true"/>
                    <input type="email" placeholder="Your email address" required="" autocomplete="email" name="email" class="js_subscribe_value"/>
                    <button class="nv-btn nv-btn--gold js_subscribe_btn" type="button">Subscribe</button>
                  </div>
                  </div><label class="nv-check"><input type="checkbox" required=""/> I agree to receive emails from Nutivo. Unsubscribe anytime.</label>
                  <p class="js_subscribed_wrap d-none nv-form-success">Thank you, you are on the list. Watch your inbox for the harvest notes.</p></div>
              </div>
            </section>
    </template>
</odoo>
