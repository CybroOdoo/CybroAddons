<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Contact panel: details, map and the website form of Odoo, laid out as the reference card.
-->
<odoo>
    <template id="s_nutivo_contact" name="Nutivo Contact Panel">
        <section class="nv-s s_nutivo_contact nv-section" id="contact" data-name="Contact Panel">
              <div class="nv-container">
                <div class="nv-contact nv-reveal">
                  <div class="nv-contact__panel">
                    <div>
                      <p class="nv-eyebrow nv-eyebrow--gold">Get in Touch</p>
                      <h2 class="nv-section-title nv-contact__title">We'd love to hear from you</h2>
                      <p class="nv-contact__lede">Questions about an order, a custom hamper or a bulk enquiry? Our team in Kochi replies within one business day.</p>
                    </div>
                    <ul class="nv-contact__list">
                      <li>
                        <span class="nv-contact__icon"><i class="nv-i nv-ph-map-pin-light" role="img" aria-hidden="true"/></span>
                        <div><span class="nv-contact__label">Visit the atelier</span><address>Nutivo Atelier, MG Road<br/>Kochi, Kerala 682016</address></div>
                      </li>
                      <li>
                        <span class="nv-contact__icon"><i class="nv-i nv-ph-phone-light" role="img" aria-hidden="true"/></span>
                        <div><span class="nv-contact__label">Call us</span><a href="tel:+914840000000">+91 484 000 0000</a></div>
                      </li>
                      <li>
                        <span class="nv-contact__icon"><i class="nv-i nv-ph-envelope-simple-light" role="img" aria-hidden="true"/></span>
                        <div><span class="nv-contact__label">Email</span><a href="mailto:hello@nutivo.example">hello@nutivo.example</a></div>
                      </li>
                      <li>
                        <span class="nv-contact__icon"><i class="nv-i nv-ph-whatsapp-logo-light" role="img" aria-hidden="true"/></span>
                        <div><span class="nv-contact__label">WhatsApp</span><a href="https://wa.me/914840000000" target="_blank" rel="noopener">Chat with our team</a></div>
                      </li>
                      <li>
                        <span class="nv-contact__icon"><i class="nv-i nv-ph-clock-light" role="img" aria-hidden="true"/></span>
                        <div><span class="nv-contact__label">Hours</span><span>Mon – Sat, 9:00 am – 7:00 pm IST</span></div>
                      </li>
                    </ul>
                    <div class="nv-contact__map">
                      <iframe title="Map showing Nutivo Atelier on MG Road, Kochi" src="https://maps.google.com/maps?q=MG%20Road%2C%20Kochi%2C%20Kerala&amp;z=14&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"/>
                    </div>
                  </div>
                  <section class="s_website_form nv-contact__form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_optional" data-mark="(optional)" data-model_name="mail.mail" data-success-mode="message" data-pre-fill="true">
                    <h3 class="nv-contact__form-title">Send us a message</h3>
                    <p class="nv-contact__form-sub"><i class="nv-i nv-ph-chat-circle-text-light" role="img" aria-hidden="true"/> We usually reply within 24 hours.</p>
                    <div class="s_website_form_rows nv-field-rows">
                        <div class="s_website_form_field nv-field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                            <label class="s_website_form_label" for="nv_contact_name"><span class="s_website_form_label_content">Full name</span></label>
                            <input id="nv_contact_name" type="text" class="form-control s_website_form_input" name="name" required="1" autocomplete="name" data-fill-with="name"/>
                        </div>
                        <div class="s_website_form_field nv-field s_website_form_model_required" data-type="email" data-name="Field">
                            <label class="s_website_form_label" for="nv_contact_email"><span class="s_website_form_label_content">Email</span></label>
                            <input id="nv_contact_email" type="email" class="form-control s_website_form_input" name="email_from" required="" autocomplete="email" data-fill-with="email"/>
                        </div>
                        <div class="s_website_form_field nv-field s_website_form_custom" data-type="tel" data-name="Field">
                            <label class="s_website_form_label" for="nv_contact_phone"><span class="s_website_form_label_content">Phone</span></label>
                            <input id="nv_contact_phone" type="tel" class="form-control s_website_form_input" name="phone" autocomplete="tel" placeholder="+91 98765 43210" data-fill-with="phone"/>
                        </div>
                        <div class="s_website_form_field nv-field s_website_form_model_required" data-type="char" data-name="Field">
                            <label class="s_website_form_label" for="nv_contact_topic"><span class="s_website_form_label_content">Topic</span></label>
                            <select id="nv_contact_topic" class="form-select s_website_form_input" name="subject" required="">
                                <option value="Order &amp; delivery">Order &amp; delivery</option>
                                <option value="Gift hampers &amp; corporate gifting">Gift hampers &amp; corporate gifting</option>
                                <option value="Bulk &amp; wholesale">Bulk &amp; wholesale</option>
                                <option value="Product questions">Product questions</option>
                                <option value="Press &amp; partnerships">Press &amp; partnerships</option>
                                <option value="Something else">Something else</option>
                            </select>
                        </div>
                        <div class="s_website_form_field nv-field nv-field--full s_website_form_custom" data-type="char" data-name="Field">
                            <label class="s_website_form_label" for="nv_contact_order"><span class="s_website_form_label_content">Order number</span></label>
                            <input id="nv_contact_order" type="text" class="form-control s_website_form_input" name="order_number" placeholder="e.g. S00042"/>
                        </div>
                        <div class="s_website_form_field nv-field nv-field--full s_website_form_model_required" data-type="text" data-name="Field">
                            <label class="s_website_form_label" for="nv_contact_message"><span class="s_website_form_label_content">Message</span></label>
                            <textarea id="nv_contact_message" class="form-control s_website_form_input" name="body_html" required="" rows="5" placeholder="How can we help?"/>
                        </div>
                        <div class="s_website_form_field s_website_form_dnone"><input type="hidden" class="form-control s_website_form_input" name="email_to" value="info@yourcompany.example.com"/></div>
                        <div class="s_website_form_submit nv-field--full" data-name="Submit Button">
                            <div class="s_website_form_label"/>
                            <a href="#" role="button" class="btn btn-primary s_website_form_send nv-btn nv-btn--primary">Send Message <i class="nv-i nv-ph-paper-plane-tilt-light" role="img" aria-hidden="true"/></a>
                            <span id="s_website_form_result"/>
                        </div>
                    </div>
                </form>
            </section></div>
              </div>
            </section>
    </template>
</odoo>
