<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Journey timeline.
-->
<odoo>
    <template id="s_nutivo_timeline" name="Nutivo Timeline">
        <section class="nv-s s_nutivo_timeline nv-section" id="journey" data-name="Timeline">
              <div class="nv-container">
                <div class="nv-section-head nv-section-head--center nv-reveal">
                  <p class="nv-eyebrow">Our Journey</p>
                  <h2 class="nv-section-title">Twelve years, one handful at a time</h2>
                </div>
                <ol class="nv-timeline">
                  <li class="nv-timeline__item nv-reveal">
                    <span class="nv-timeline__year">2014</span>
                    <h3>A stall in Kochi</h3>
                    <p>Meera and Arjun open a weekend stall at the spice market, selling California almonds by the scoop.</p>
                  </li>
                  <li class="nv-timeline__item nv-reveal">
                    <span class="nv-timeline__year">2016</span>
                    <h3>Our first farm partner</h3>
                    <p>A handshake with a family orchard in Kerman brings our first direct-trade pistachios home.</p>
                  </li>
                  <li class="nv-timeline__item nv-reveal">
                    <span class="nv-timeline__year">2019</span>
                    <h3>The Kochi atelier</h3>
                    <p>We open our own roastery and packing room, so every batch is roasted and sealed under one roof.</p>
                  </li>
                  <li class="nv-timeline__item nv-reveal">
                    <span class="nv-timeline__year">2022</span>
                    <h3>Gifting, reimagined</h3>
                    <p>Our keepsake hampers launch, and corporate gifting grows to more than 300 companies across India.</p>
                  </li>
                  <li class="nv-timeline__item nv-reveal">
                    <span class="nv-timeline__year">2026</span>
                    <h3>Fourteen growers strong</h3>
                    <p>Six countries, fourteen family farms and one promise that hasn't changed since the first scoop.</p>
                  </li>
                </ol>
              </div>
            </section>
    </template>
</odoo>
