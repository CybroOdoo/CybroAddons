<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Home hero: full-bleed photo, inset frame, headline revealed word by word and the featured pack card.
-->
<odoo>
    <template id="s_nutivo_hero" name="Nutivo Hero">
        <section class="nv-s s_nutivo_hero nv-hero" data-name="Hero">
              <div class="nv-hero__media" aria-hidden="true">
                <img src="/theme_nutivo/static/src/img/content/hero-wide.jpg" alt=""/>
              </div>
              <div class="nv-hero__frame" aria-hidden="true"/>
              <div class="nv-container nv-hero__inner">
                <div class="nv-hero__copy">
                  <p class="nv-hero__est nv-reveal"><span>Est. 2014</span><i aria-hidden="true">✦</i><span>Kochi, India</span></p>
                  <p class="nv-eyebrow nv-eyebrow--gold nv-reveal">A Finer Kind of Snacking</p>
                  <h1 class="nv-hero__title nv-reveal">Goodness, Gathered <em>Naturally.</em></h1>
                  <p class="nv-hero__lede nv-reveal">Discover exceptional nuts, delicious dried fruits, thoughtfully crafted snack mixes, and beautifully curated gifts for every occasion.</p>
                  <div class="nv-hero__actions nv-reveal">
                    <a href="/shop" class="nv-btn nv-btn--gold">Shop the Collection <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                    <a href="#hampers" class="nv-btn nv-btn--ghost-light">Explore Gift Hampers</a>
                  </div>
                </div>
                <aside class="nv-hero-feature nv-reveal" aria-label="Featured product: California Almonds">
                  <p class="nv-hero-feature__index"><span>No. 01</span><span class="nv-hero-feature__rule" aria-hidden="true"/><span>Signature Pack</span></p>
                  <div class="nv-hero-feature__media">
                    <svg class="nv-hero-feature__ring" viewBox="0 0 200 200" aria-hidden="true">
                      <defs><path id="featureRing" d="M100,100 m-88,0 a88,88 0 1,1 176,0 a88,88 0 1,1 -176,0"/></defs>
                      <circle cx="100" cy="100" r="99"/>
                      <text textLength="548" lengthAdjust="spacing"><textPath href="#featureRing">SINGLE ORIGIN ✦ HAND-SORTED ✦ SLOW ROASTED ✦ </textPath></text>
                    </svg>
                    <img src="/theme_nutivo/static/src/img/content/almonds.jpg" alt="California almonds in a dark ceramic bowl"/>
                  </div>
                  <h2 class="nv-hero-feature__name">California Almonds</h2>
                  <p class="nv-hero-feature__meta"><span class="nv-hero-feature__stars" aria-hidden="true">★★★★★</span> 4.9 · 412 reviews</p>
                  <div class="nv-hero-feature__foot">
                    <p class="nv-hero-feature__price">₹399 <small>/ 250 g</small></p>
                    <a class="nv-hero-feature__add" aria-label="Add California Almonds, 250g, to bag" href="/shop">
                      Add to bag <i class="nv-i nv-ph-plus-light" role="img" aria-hidden="true"/>
                    </a>
                  </div>
                </aside>
              </div>
            </section>
    </template>
</odoo>
