<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Strip of four shop perks.
-->
<odoo>
    <template id="s_nutivo_perks" name="Nutivo Perks Strip">
        <section class="nv-s s_nutivo_perks nv-perks" aria-label="Why shop with Nutivo" data-name="Perks Strip">
              <div class="nv-container nv-perks__row">
                <p><i class="nv-i nv-ph-truck-light" role="img" aria-hidden="true"/> Free shipping over ₹999</p>
                <p><i class="nv-i nv-ph-leaf-light" role="img" aria-hidden="true"/> Packed within 72 hrs of roasting</p>
                <p><i class="nv-i nv-ph-shield-check-light" role="img" aria-hidden="true"/> Freshness promise or full refund</p>
                <p><i class="nv-i nv-ph-gift-light" role="img" aria-hidden="true"/> Complimentary gift notes</p>
              </div>
            </section>
    </template>
</odoo>
