<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Nutivo contact page: page hero, contact panel with the website form, help cards and FAQ.
-->
<odoo>
    <template id="contactus" name="Nutivo Contact Us" inherit_id="website.contactus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="nv-s s_nutivo_page_hero nv-hero nv-hero--page" data-name="Page Hero" data-snippet="s_nutivo_page_hero">
                      <div class="nv-hero__media nv-hero__media--contact" aria-hidden="true">
                        <img src="/theme_nutivo/static/src/img/content/contact-hero-wide.jpg" alt=""/>
                      </div>
                      <div class="nv-hero__frame" aria-hidden="true"/>
                      <div class="nv-container nv-hero__inner">
                        <div class="nv-hero__copy">
                          <nav class="nv-breadcrumb nv-breadcrumb--light nv-reveal" aria-label="Breadcrumb">
                            <ol><li><a href="/">Home</a></li><li aria-current="page">Contact</li></ol>
                          </nav>
                          <p class="nv-eyebrow nv-eyebrow--gold nv-reveal">Contact Us</p>
                          <h1 class="nv-hero__title nv-reveal">We're Here <em>to Help.</em></h1>
                          <p class="nv-hero__lede nv-reveal">From order questions to bespoke gift hampers, our team in Kochi is only a message away.</p>
                          <div class="nv-hero__actions nv-reveal">
                            <a href="#contact" class="nv-btn nv-btn--gold">Send a Message <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                            <a href="#faq" class="nv-btn nv-btn--ghost-light">Read the FAQs</a>
                          </div>
                        </div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_contact nv-section" id="contact" data-name="Contact Panel" data-snippet="s_nutivo_contact">
                      <div class="nv-container">
                        <div class="nv-contact nv-reveal">
                          <div class="nv-contact__panel">
                            <div>
                              <p class="nv-eyebrow nv-eyebrow--gold">Get in Touch</p>
                              <h2 class="nv-section-title nv-contact__title">We'd love to hear from you</h2>
                              <p class="nv-contact__lede">Questions about an order, a custom hamper or a bulk enquiry? Our team in Kochi replies within one business day.</p>
                            </div>
                            <ul class="nv-contact__list">
                              <li>
                                <span class="nv-contact__icon"><i class="nv-i nv-ph-map-pin-light" role="img" aria-hidden="true"/></span>
                                <div><span class="nv-contact__label">Visit the atelier</span><address>Nutivo Atelier, MG Road<br/>Kochi, Kerala 682016</address></div>
                              </li>
                              <li>
                                <span class="nv-contact__icon"><i class="nv-i nv-ph-phone-light" role="img" aria-hidden="true"/></span>
                                <div><span class="nv-contact__label">Call us</span><a href="tel:+914840000000">+91 484 000 0000</a></div>
                              </li>
                              <li>
                                <span class="nv-contact__icon"><i class="nv-i nv-ph-envelope-simple-light" role="img" aria-hidden="true"/></span>
                                <div><span class="nv-contact__label">Email</span><a href="mailto:hello@nutivo.example">hello@nutivo.example</a></div>
                              </li>
                              <li>
                                <span class="nv-contact__icon"><i class="nv-i nv-ph-whatsapp-logo-light" role="img" aria-hidden="true"/></span>
                                <div><span class="nv-contact__label">WhatsApp</span><a href="https://wa.me/914840000000" target="_blank" rel="noopener">Chat with our team</a></div>
                              </li>
                              <li>
                                <span class="nv-contact__icon"><i class="nv-i nv-ph-clock-light" role="img" aria-hidden="true"/></span>
                                <div><span class="nv-contact__label">Hours</span><span>Mon – Sat, 9:00 am – 7:00 pm IST</span></div>
                              </li>
                            </ul>
                            <!-- The standard Map block: the address, zoom and type are options of the website builder. -->
                            <section class="s_map nv-contact__map" style="--GoogleMap-height: 190px" data-map-type="m" data-map-zoom="14" data-map-address="MG Road, Kochi, Kerala" data-name="Map" data-vxml="001">
                              <div class="map_container">
                                <div class="css_non_editable_mode_hidden">
                                  <div class="missing_option_warning alert alert-info rounded-0 fade show d-none d-print-none">An address must be specified for a map to be embedded</div>
                                </div>
                                <iframe class="s_map_embedded o_not_editable" src="https://maps.google.com/maps?q=MG%20Road%2C%20Kochi%2C%20Kerala&amp;t=m&amp;z=14&amp;ie=UTF8&amp;iwloc=&amp;output=embed" width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" aria-label="Map"/>
                                <div class="s_map_color_filter"/>
                              </div>
                            </section>
                          </div>
                          <section class="s_website_form nv-contact__form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                        <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_optional" data-mark="(optional)" data-model_name="mail.mail" data-success-mode="message" data-pre-fill="true">
                            <h3 class="nv-contact__form-title">Send us a message</h3>
                            <p class="nv-contact__form-sub"><i class="nv-i nv-ph-chat-circle-text-light" role="img" aria-hidden="true"/> We usually reply within 24 hours.</p>
                            <div class="s_website_form_rows nv-field-rows">
                                <div class="s_website_form_field nv-field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" for="nv_contact_name"><span class="s_website_form_label_content">Full name</span></label>
                                    <input id="nv_contact_name" type="text" class="form-control s_website_form_input" name="name" required="1" autocomplete="name" data-fill-with="name"/>
                                </div>
                                <div class="s_website_form_field nv-field s_website_form_model_required" data-type="email" data-name="Field">
                                    <label class="s_website_form_label" for="nv_contact_email"><span class="s_website_form_label_content">Email</span></label>
                                    <input id="nv_contact_email" type="email" class="form-control s_website_form_input" name="email_from" required="" autocomplete="email" data-fill-with="email"/>
                                </div>
                                <div class="s_website_form_field nv-field s_website_form_custom" data-type="tel" data-name="Field">
                                    <label class="s_website_form_label" for="nv_contact_phone"><span class="s_website_form_label_content">Phone</span></label>
                                    <input id="nv_contact_phone" type="tel" class="form-control s_website_form_input" name="phone" autocomplete="tel" placeholder="+91 98765 43210" data-fill-with="phone"/>
                                </div>
                                <div class="s_website_form_field nv-field s_website_form_model_required" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" for="nv_contact_topic"><span class="s_website_form_label_content">Topic</span></label>
                                    <select id="nv_contact_topic" class="form-select s_website_form_input" name="subject" required="">
                                        <option value="Order &amp; delivery">Order &amp; delivery</option>
                                        <option value="Gift hampers &amp; corporate gifting">Gift hampers &amp; corporate gifting</option>
                                        <option value="Bulk &amp; wholesale">Bulk &amp; wholesale</option>
                                        <option value="Product questions">Product questions</option>
                                        <option value="Press &amp; partnerships">Press &amp; partnerships</option>
                                        <option value="Something else">Something else</option>
                                    </select>
                                </div>
                                <div class="s_website_form_field nv-field nv-field--full s_website_form_custom" data-type="char" data-name="Field">
                                    <label class="s_website_form_label" for="nv_contact_order"><span class="s_website_form_label_content">Order number</span></label>
                                    <input id="nv_contact_order" type="text" class="form-control s_website_form_input" name="order_number" placeholder="e.g. S00042"/>
                                </div>
                                <div class="s_website_form_field nv-field nv-field--full s_website_form_model_required" data-type="text" data-name="Field">
                                    <label class="s_website_form_label" for="nv_contact_message"><span class="s_website_form_label_content">Message</span></label>
                                    <textarea id="nv_contact_message" class="form-control s_website_form_input" name="body_html" required="" rows="5" placeholder="How can we help?"/>
                                </div>
                                <div class="s_website_form_field s_website_form_dnone"><input type="hidden" class="form-control s_website_form_input" name="email_to" value="info@yourcompany.example.com"/></div>
                                <div class="s_website_form_submit nv-field--full" data-name="Submit Button">
                                    <div class="s_website_form_label"/>
                                    <a href="#" role="button" class="btn btn-primary s_website_form_send nv-btn nv-btn--primary">Send Message <i class="nv-i nv-ph-paper-plane-tilt-light" role="img" aria-hidden="true"/></a>
                                    <span id="s_website_form_result"/>
                                </div>
                            </div>
                        </form>
                    </section></div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_help nv-section" data-name="Help Cards" data-snippet="s_nutivo_help">
                      <div class="nv-container">
                        <div class="nv-section-head nv-section-head--center nv-reveal">
                          <p class="nv-eyebrow">Dedicated Teams</p>
                          <h2 class="nv-section-title">Other ways we can help</h2>
                        </div>
                        <div class="nv-help-grid">
                          <article class="nv-help-card nv-reveal">
                            <span class="nv-help-card__icon"><i class="nv-i nv-ph-gift-light" role="img" aria-hidden="true"/></span>
                            <h3>Corporate Gifting</h3>
                            <p>Custom-branded hampers from 25 units, multi-address dispatch and GST invoicing.</p>
                            <a class="nv-link-arrow" href="mailto:gifting@nutivo.example">gifting@nutivo.example <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                          </article>
                          <article class="nv-help-card nv-reveal">
                            <span class="nv-help-card__icon"><i class="nv-i nv-ph-package-light" role="img" aria-hidden="true"/></span>
                            <h3>Bulk &amp; Wholesale</h3>
                            <p>Tiered pricing for cafés, bakeries and celebrations, with an account manager from 25 kg.</p>
                            <a class="nv-link-arrow" href="mailto:wholesale@nutivo.example">wholesale@nutivo.example <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                          </article>
                          <article class="nv-help-card nv-reveal">
                            <span class="nv-help-card__icon"><i class="nv-i nv-ph-newspaper-light" role="img" aria-hidden="true"/></span>
                            <h3>Press &amp; Partnerships</h3>
                            <p>Stories, samples and collaborations with chefs, creators and like-minded brands.</p>
                            <a class="nv-link-arrow" href="mailto:press@nutivo.example">press@nutivo.example <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                          </article>
                        </div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_faq nv-section" id="faq" data-name="FAQ" data-snippet="s_nutivo_faq">
                      <div class="nv-container nv-faq">
                        <div class="nv-faq__intro nv-reveal">
                          <p class="nv-eyebrow">Quick Answers</p>
                          <h2 class="nv-section-title">Frequently asked questions</h2>
                          <p class="nv-section-sub">Can't find what you need? Send us a message above and we'll get back to you within a day.</p>
                        </div>
                        <div class="nv-faq__list nv-reveal">
                          <details class="nv-faq__item" open="">
                            <summary>How long does delivery take? <i class="nv-i nv-ph-plus-light" role="img" aria-hidden="true"/></summary>
                            <p>Orders ship from Kochi within 24 hours. Metro cities usually receive them in 2–3 days, and the rest of India in 3–6 days. Shipping is free above ₹999.</p>
                          </details>
                          <details class="nv-faq__item">
                            <summary>How fresh are the products? <i class="nv-i nv-ph-plus-light" role="img" aria-hidden="true"/></summary>
                            <p>Everything is roasted in small batches and sealed within 72 hours. Every pack carries its roast date, and most stay at their best for 4–6 months once opened and kept airtight.</p>
                          </details>
                          <details class="nv-faq__item">
                            <summary>Can I add a personal note to a hamper? <i class="nv-i nv-ph-plus-light" role="img" aria-hidden="true"/></summary>
                            <p>Yes. Add your message at checkout and we'll handwrite it on a linen card tucked inside the hamper. Gift notes are always free.</p>
                          </details>
                          <details class="nv-faq__item">
                            <summary>What if something arrives damaged? <i class="nv-i nv-ph-plus-light" role="img" aria-hidden="true"/></summary>
                            <p>Our freshness promise covers you. Send a photo within 7 days of delivery and we'll replace the item or refund it in full, no questions asked.</p>
                          </details>
                          <details class="nv-faq__item">
                            <summary>Do you deliver outside India? <i class="nv-i nv-ph-plus-light" role="img" aria-hidden="true"/></summary>
                            <p>We currently ship across India only. For international corporate orders, write to our gifting team and we'll arrange a quote.</p>
                          </details>
                        </div>
                      </div>
                    </section>
            </div>
        </xpath>
    </template>
</odoo>
