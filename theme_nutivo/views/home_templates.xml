<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Nutivo home page, built from the markup of the Nutivo snippets, inlined so the page body stays editable in the website builder.
-->
<odoo>
    <template id="homepage" name="Nutivo Home" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="nv-s s_nutivo_hero nv-hero" data-name="Hero" data-snippet="s_nutivo_hero">
                      <div class="nv-hero__media" aria-hidden="true">
                        <img src="/theme_nutivo/static/src/img/content/hero-wide.jpg" alt=""/>
                      </div>
                      <div class="nv-hero__frame" aria-hidden="true"/>
                      <div class="nv-container nv-hero__inner">
                        <div class="nv-hero__copy">
                          <p class="nv-hero__est nv-reveal"><span>Est. 2014</span><i aria-hidden="true">✦</i><span>Kochi, India</span></p>
                          <p class="nv-eyebrow nv-eyebrow--gold nv-reveal">A Finer Kind of Snacking</p>
                          <h1 class="nv-hero__title nv-reveal">Goodness, Gathered <em>Naturally.</em></h1>
                          <p class="nv-hero__lede nv-reveal">Discover exceptional nuts, delicious dried fruits, thoughtfully crafted snack mixes, and beautifully curated gifts for every occasion.</p>
                          <div class="nv-hero__actions nv-reveal">
                            <a href="/shop" class="nv-btn nv-btn--gold">Shop the Collection <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                            <a href="#hampers" class="nv-btn nv-btn--ghost-light">Explore Gift Hampers</a>
                          </div>
                        </div>
                        <aside class="nv-hero-feature nv-reveal" aria-label="Featured product: California Almonds">
                          <p class="nv-hero-feature__index"><span>No. 01</span><span class="nv-hero-feature__rule" aria-hidden="true"/><span>Signature Pack</span></p>
                          <div class="nv-hero-feature__media">
                            <svg class="nv-hero-feature__ring" viewBox="0 0 200 200" aria-hidden="true">
                              <defs><path id="featureRing" d="M100,100 m-88,0 a88,88 0 1,1 176,0 a88,88 0 1,1 -176,0"/></defs>
                              <circle cx="100" cy="100" r="99"/>
                              <text textLength="548" lengthAdjust="spacing"><textPath href="#featureRing">SINGLE ORIGIN ✦ HAND-SORTED ✦ SLOW ROASTED ✦ </textPath></text>
                            </svg>
                            <img src="/theme_nutivo/static/src/img/content/almonds.jpg" alt="California almonds in a dark ceramic bowl"/>
                          </div>
                          <h2 class="nv-hero-feature__name">California Almonds</h2>
                          <p class="nv-hero-feature__meta"><span class="nv-hero-feature__stars" aria-hidden="true">★★★★★</span> 4.9 · 412 reviews</p>
                          <div class="nv-hero-feature__foot">
                            <p class="nv-hero-feature__price">₹399 <small>/ 250 g</small></p>
                            <a class="nv-hero-feature__add" aria-label="Add California Almonds, 250g, to bag" href="/shop">
                              Add to bag <i class="nv-i nv-ph-plus-light" role="img" aria-hidden="true"/>
                            </a>
                          </div>
                        </aside>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_ticker nv-ticker" aria-label="Our range: almonds, pistachios, Medjool dates, cashews, walnuts, apricots, cranberries and trail mixes" data-name="Range Ticker" data-snippet="s_nutivo_ticker">
                      <div class="nv-ticker__track">
                        <div class="nv-ticker__group"><span class="nv-ticker__word">Almonds</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/almonds.jpg" alt="" loading="lazy"/><span class="nv-ticker__word nv-ticker__word--outline">Pistachios</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/pistachios.jpg" alt="" loading="lazy"/><span class="nv-ticker__word">Medjool Dates</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/dates.jpg" alt="" loading="lazy"/><span class="nv-ticker__word nv-ticker__word--outline">Cashews</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/cashews.jpg" alt="" loading="lazy"/><span class="nv-ticker__word">Walnuts</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/walnuts.jpg" alt="" loading="lazy"/><span class="nv-ticker__word nv-ticker__word--outline">Apricots</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/dried-fruits.jpg" alt="" loading="lazy"/><span class="nv-ticker__word">Cranberries</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/cranberries.jpg" alt="" loading="lazy"/><span class="nv-ticker__word nv-ticker__word--outline">Trail Mixes</span><img class="nv-ticker__img" src="/theme_nutivo/static/src/img/content/trail-mix.jpg" alt="" loading="lazy"/></div>
                        </div>
                    </section>
                <section class="nv-s s_nutivo_categories nv-section nv-categories" data-name="Category Row" data-snippet="s_nutivo_categories">
                      <div class="nv-container">
                        <div class="nv-section-head nv-section-head--center nv-reveal">
                          <p class="nv-eyebrow">Shop by Category</p>
                          <h2 class="nv-section-title">Curated from the world's finest orchards</h2>
                        </div>
                        <ul class="nv-cat-row">
                          <li class="nv-reveal"><a href="nutivo_category_nuts" class="nv-cat">
                            <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/almonds.jpg" alt=""/></span>
                            <span class="nv-cat__name">Premium Nuts</span><span class="nv-cat__count">6 varieties</span></a></li>
                          <li class="nv-reveal"><a href="nutivo_category_dried" class="nv-cat">
                            <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/dates.jpg" alt=""/></span>
                            <span class="nv-cat__name">Medjool Dates</span><span class="nv-cat__count">Jordan &amp; Madinah</span></a></li>
                          <li class="nv-reveal"><a href="nutivo_category_dried" class="nv-cat">
                            <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/dried-fruits.jpg" alt=""/></span>
                            <span class="nv-cat__name">Dried Fruits</span><span class="nv-cat__count">Sun-dried</span></a></li>
                          <li class="nv-reveal"><a href="nutivo_category_mixes" class="nv-cat">
                            <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/trail-mix.jpg" alt=""/></span>
                            <span class="nv-cat__name">Trail Mixes</span><span class="nv-cat__count">Blended in-house</span></a></li>
                          <li class="nv-reveal"><a href="nutivo_category_hampers" class="nv-cat">
                            <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/hampers.jpg" alt=""/></span>
                            <span class="nv-cat__name">Gift Hampers</span><span class="nv-cat__count">Hand-packed</span></a></li>
                          <li class="nv-reveal"><a href="#festive" class="nv-cat">
                            <span class="nv-cat__img"><img loading="lazy" src="/theme_nutivo/static/src/img/content/festive.jpg" alt=""/><span class="nv-cat__tag">New</span></span>
                            <span class="nv-cat__name">Festive Edit</span><span class="nv-cat__count">Limited season</span></a></li>
                        </ul>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_goodness nv-container" aria-label="Nutrition highlights" data-name="Goodness Band" data-snippet="s_nutivo_goodness">
                      <div class="nv-goodness nv-reveal">
                        <div class="nv-goodness__img">
                          <img loading="lazy" src="/theme_nutivo/static/src/img/content/hero.jpg" alt="Small white bowls of dates, almonds, cashews, peanuts and pistachios"/>
                        </div>
                        <div class="nv-goodness__body">
                          <h2 class="nv-goodness__title">Goodness in Every Handful</h2>
                          <ul class="nv-goodness__stats">
                            <li><strong>6g</strong><span>Plant protein per 30g</span></li>
                            <li><strong>0</strong><span>Added preservatives</span></li>
                            <li><strong>14</strong><span>Origin farms</span></li>
                            <li><strong>100%</strong><span>Real ingredients</span></li>
                          </ul>
                        </div>
                        <a href="/about#promise" class="nv-btn nv-btn--ghost-light">Our Quality Promise</a>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_bestsellers nv-section" id="bestsellers" data-limit="8" data-categories="5" data-card="product" data-name="Bestsellers" data-snippet="s_nutivo_bestsellers">
                      <div class="nv-container">
                        <div class="nv-section-head nv-section-head--split nv-reveal">
                          <div>
                            <p class="nv-eyebrow">Most Loved</p>
                            <h2 class="nv-section-title">Bestsellers</h2>
                          </div>
                          <div class="nv-toolbar nv-toolbar--compact">
                            <div class="nv-chips" role="tablist" aria-label="Filter bestsellers" data-nv-chips="1"/>
                            <label class="nv-select-wrap">
                              <span class="nv-sr-only">Sort bestsellers</span>
                              <select data-prefix="Sort" data-nv-sort="1">
                                <option value="featured">Featured</option>
                                <option value="price-asc">Price: Low to High</option>
                                <option value="price-desc">Price: High to Low</option>
                                <option value="rating">Top Rated</option>
                              </select>
                            </label>
                          </div>
                        </div>
                        <div class="nv-product-grid" aria-live="polite" data-nv-grid="1"/>
                        <div class="nv-center-cta nv-reveal"><a href="/shop" class="nv-btn nv-btn--outline">View the Full Collection <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a></div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_hampers nv-section" id="hampers" data-limit="3" data-card="hamper" data-category="hampers" data-name="Gift Hampers" data-snippet="s_nutivo_hampers">
                      <div class="nv-container">
                        <div class="nv-section-head nv-section-head--split nv-reveal">
                          <div>
                            <p class="nv-eyebrow">The Art of Gifting</p>
                            <h2 class="nv-section-title">Premium Gift Hampers</h2>
                          </div>
                          <a href="nutivo_category_hampers" class="nv-link-arrow">All hampers <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                        </div>
                        <div class="nv-hamper-grid" data-nv-grid="1"/>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_festive nv-section nv-festive-section" id="festive" data-name="Festive Collections" data-snippet="s_nutivo_festive">
                      <div class="nv-container">
                        <div class="nv-section-head nv-section-head--split nv-reveal">
                          <div>
                            <p class="nv-eyebrow">Seasonal &amp; Festive</p>
                            <h2 class="nv-section-title">Collections for Every Celebration</h2>
                          </div>
                          <p class="nv-section-sub nv-section-sub--right">Limited editions, released with the seasons and gone when the harvest ends.</p>
                        </div>
                        <div class="nv-festive-grid">
                          <article class="nv-festive-card nv-festive-card--tall nv-reveal">
                            <img loading="lazy" src="/theme_nutivo/static/src/img/content/festive-diwali.jpg" alt="Kraft gift boxes tied with red and white twine and a wax seal"/>
                            <div class="nv-festive-card__body">
                              <span class="nv-tag nv-tag--gold">Now Live</span>
                              <h3>The Diwali Edit</h3>
                              <p>Saffron-roasted cashews, rose-pistachio clusters and keepsake brass-lid boxes.</p>
                              <a href="nutivo_category_hampers" class="nv-link-arrow nv-link-arrow--light">Shop Diwali <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                            </div>
                          </article>
                          <article class="nv-festive-card nv-reveal">
                            <img loading="lazy" src="/theme_nutivo/static/src/img/content/festive-eid.jpg" alt="Two glass bowls of golden and dark dates beside prayer beads"/>
                            <div class="nv-festive-card__body">
                              <span class="nv-tag">Coming Soon</span>
                              <h3>Ramadan &amp; Eid</h3>
                              <p>Ajwa, Medjool and Kalmi dates in hand-tied tasting trays.</p>
                              <a href="/shop?search=dates" class="nv-link-arrow nv-link-arrow--light">Explore dates <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                            </div>
                          </article>
                          <article class="nv-festive-card nv-reveal">
                            <img loading="lazy" src="/theme_nutivo/static/src/img/content/festive-christmas.jpg" alt="Close-up of a fruitcake topped with whole almonds and walnuts"/>
                            <div class="nv-festive-card__body">
                              <span class="nv-tag">Winter</span>
                              <h3>The Christmas Pantry</h3>
                              <p>Plum-cake fruit soaks, candied pecans and walnut-studded gift jars.</p>
                              <a href="nutivo_category_mixes" class="nv-link-arrow nv-link-arrow--light">Preview <i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></a>
                            </div>
                          </article>
                        </div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_testimonials nv-section nv-testimonials" data-name="Testimonials" data-snippet="s_nutivo_testimonials">
                      <div class="nv-container">
                        <div class="nv-section-head nv-section-head--split nv-reveal">
                          <div>
                            <p class="nv-eyebrow">Kind Words</p>
                            <h2 class="nv-section-title">What Our Customers Say</h2>
                          </div>
                          <div class="nv-slider-nav">
                            <button class="nv-icon-btn nv-icon-btn--ring" aria-label="Previous testimonials" data-nv-slide="prev"><i class="nv-i nv-ph-arrow-left-light" role="img" aria-hidden="true"/></button>
                            <button class="nv-icon-btn nv-icon-btn--ring" aria-label="Next testimonials" data-nv-slide="next"><i class="nv-i nv-ph-arrow-right-light" role="img" aria-hidden="true"/></button>
                          </div>
                        </div>
                        <div class="nv-testi-track" tabindex="0" aria-label="Customer testimonials">
                          <figure class="nv-testi">
                            <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                            <blockquote>“The Medjool dates are unreal, soft as fudge and never sticky-sweet. I've stopped buying dates anywhere else.”</blockquote>
                            <figcaption><span class="nv-avatar" style="--nv-av:#A8B39A">AK</span><span><strong>Aisha K.</strong><small>Bengaluru · Verified buyer</small></span></figcaption>
                          </figure>
                          <figure class="nv-testi">
                            <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                            <blockquote>“We sent 140 hampers to clients this Diwali. Every single one arrived on time and the packaging drew compliments all week.”</blockquote>
                            <figcaption><span class="nv-avatar" style="--nv-av:#C5A46D">VM</span><span><strong>Vikram M.</strong><small>Head of HR, Mumbai</small></span></figcaption>
                          </figure>
                          <figure class="nv-testi">
                            <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                            <blockquote>“The Signature Trail Mix lives in my desk drawer. Fresh, crunchy, and you can actually taste that it's been roasted recently.”</blockquote>
                            <figcaption><span class="nv-avatar" style="--nv-av:#243B2F">PR</span><span><strong>Priya R.</strong><small>Kochi · Snack Club member</small></span></figcaption>
                          </figure>
                          <figure class="nv-testi">
                            <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                            <blockquote>“Built a custom box for my mother with her favourites and a note. She called me in tears. Thank you, Nutivo.”</blockquote>
                            <figcaption><span class="nv-avatar" style="--nv-av:#342A23">DS</span><span><strong>Daniel S.</strong><small>Pune · Verified buyer</small></span></figcaption>
                          </figure>
                          <figure class="nv-testi">
                            <div class="nv-testi__stars" aria-label="4 out of 5 stars">★★★★☆</div>
                            <blockquote>“Pistachios are huge and perfectly salted. Shipping took a day longer than expected, but worth every bit.”</blockquote>
                            <figcaption><span class="nv-avatar" style="--nv-av:#8C7A5B">NJ</span><span><strong>Neha J.</strong><small>Delhi · Verified buyer</small></span></figcaption>
                          </figure>
                          <figure class="nv-testi">
                            <div class="nv-testi__stars" aria-label="5 out of 5 stars">★★★★★</div>
                            <blockquote>“Our café switched to Nutivo bulk almonds for our granola. Consistent quality, and the 15% tier makes the maths work.”</blockquote>
                            <figcaption><span class="nv-avatar" style="--nv-av:#6B7D5E">TC</span><span><strong>Tara C.</strong><small>Owner, Grain &amp; Co. Café</small></span></figcaption>
                          </figure>
                        </div>
                      </div>
                    </section>
                <section class="nv-s s_nutivo_newsletter nv-container" id="subscribe" data-name="Newsletter" data-snippet="s_nutivo_newsletter">
                      <div class="nv-newsletter nv-reveal">
                        <div>
                          <h2 class="nv-newsletter__title">Join the Nutivo Circle</h2>
                          <p>Seasonal harvest notes, new recipes and early access to festive editions. Plus 10% off your first order.</p>
                        </div>
                        <div class="nv-newsletter__form js_subscribe" data-list-id="nutivo_mailing_list" data-name="Newsletter Form">
                          <label class="nv-sr-only">Email address</label>
                          <div class="js_subscribe_wrap"><div class="nv-newsletter__row">
                            <i class="nv-i nv-ph-envelope-simple-light" role="img" aria-hidden="true"/>
                            <input type="email" placeholder="Your email address" required="" autocomplete="email" name="email" class="js_subscribe_value"/>
                            <button class="nv-btn nv-btn--gold js_subscribe_btn" type="button">Subscribe</button>
                          </div>
                          </div><label class="nv-check"><input type="checkbox" required=""/> I agree to receive emails from Nutivo. Unsubscribe anytime.</label>
                          <p class="js_subscribed_wrap d-none nv-form-success">Thank you, you are on the list. Watch your inbox for the harvest notes.</p></div>
                      </div>
                    </section>
            </div>
        </xpath>
    </template>
</odoo>
