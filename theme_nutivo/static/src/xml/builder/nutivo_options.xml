<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Nutivo snippet options of the website builder. Each option writes a data
    attribute on the snippet, read by the Nutivo product grid interaction.
-->
<templates xml:space="preserve">

<t t-name="theme_nutivo.ProductGridOption">
    <BuilderRow label.translate="Products to Show">
        <BuilderNumberInput dataAttributeAction="'limit'" min="1" max="24" step="1" default="8"/>
    </BuilderRow>
</t>

<t t-name="theme_nutivo.BestsellersOption">
    <BuilderRow label.translate="Categories to Show">
        <BuilderNumberInput dataAttributeAction="'categories'" min="1" max="12" step="1" default="5"/>
    </BuilderRow>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <nutivo_product_grid_option template="theme_nutivo.ProductGridOption" selector=".s_nutivo_bestsellers, .s_nutivo_hampers"/>
        <nutivo_bestsellers_option template="theme_nutivo.BestsellersOption" selector=".s_nutivo_bestsellers"/>
    </xpath>
</t>

</templates>
