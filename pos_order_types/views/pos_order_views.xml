<?xml version="1.0" encoding="UTF-8" ?>
<!-- Inheriting POS order form to add order type field -->
<odoo>
     <!-- Extending POS order form view to include order type -->
    <record id="pos_order_line_views" model="ir.ui.view">
        <field name="name">pos.order.views</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="order_type_id"/>
            </field>
        </field>
    </record>
</odoo>
