<?xml version="1.0" encoding="UTF-8"?>
<!-- Defining POS order type list view and menu -->
<odoo>
    <!-- Defining list view for POS order types -->
    <record model="ir.ui.view" id="pos_order_type_list">
        <field name="name">order type list</field>
        <field name="model">pos.order.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <!-- Defining action window for POS order types -->
    <record model="ir.actions.act_window" id="pos_order_type_action_window">
        <field name="name">order_type</field>
        <field name="res_model">pos.order.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Defining menu items for POS order type management -->
    <menuitem
            id="order_type_root_menu"
            name="Order Type"
            action="pos_order_type_action_window"
            parent="point_of_sale.menu_point_config_product"/>
</odoo>
