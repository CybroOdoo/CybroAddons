<?xml version="1.0" encoding="UTF-8"?>
<!-- Extending POS receipt template to include order type details -->
<templates id="template" xml:space="preserve">
   <t t-name="pos_order_types.OrderReceipt"
      t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'pos-receipt-order-data')]" position="after">
            <t t-if="props.data.orderType">
               <div>Order Type:
                    <t t-esc='props.data.orderType'/>
               </div>
           </t>
       </xpath>
   </t>
</templates>
