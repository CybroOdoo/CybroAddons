<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Template proposed when replying to a ticket -->
        <record id="helpdesk_replay_email_template" model="mail.template">
            <field name="name">Helpdesk: Reply</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="subject">Re: {{ object.name }} {{ object.subject }}</field>
            <field name="partner_to">{{ object.customer_id.id }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Customer</t>,</p>
    <p><br/></p>
    <table style="border-collapse: collapse; margin: 16px 0px;">
        <tr>
            <td style="padding: 4px 12px 4px 0px;"><strong>Ticket</strong></td>
            <td t-out="object.name or ''">TKT00001</td>
        </tr>
        <tr t-if="object.assigned_user_id">
            <td style="padding: 4px 12px 4px 0px;"><strong>Assigned to</strong></td>
            <td t-out="object.assigned_user_id.name or ''">User</td>
        </tr>
        <tr t-if="object.team_id">
            <td style="padding: 4px 12px 4px 0px;"><strong>Team</strong></td>
            <td t-out="object.team_id.name or ''">Support</td>
        </tr>
    </table>
    <p style="margin: 16px 0px;">
        <a t-att-href="object.get_base_url() + object.get_portal_url()"
           style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; text-decoration: none; border-radius: 5px;">View Ticket</a>
    </p>
    <p>Best regards,<br/><t t-out="user.name or ''">User</t></p>
</div>
            </field>
        </record>
    </data>
</odoo>
