<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sent to the customer when a ticket is created -->
        <record id="ticket_created" model="mail.template">
            <field name="name">Helpdesk: Ticket Created</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="subject">Ticket {{ object.name }} created</field>
            <field name="partner_to">{{ object.customer_id.id }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Customer</t>,</p>
    <p>Your ticket <strong t-out="object.name or ''">TKT00001</strong>
        "<t t-out="object.subject or ''">Subject</t>" has been created.
        Our team will get back to you shortly.</p>
    <p style="margin: 16px 0px;">
        <a t-att-href="object.get_base_url() + object.get_portal_url()"
           style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; text-decoration: none; border-radius: 5px;">View Ticket</a>
    </p>
    <p>Best regards,<br/><t t-out="user.company_id.name or ''">Company</t></p>
</div>
            </field>
        </record>
        <!-- Sent to the customer when the ticket is closed, with the rating link -->
        <record id="helpdesk_rating" model="mail.template">
            <field name="name">Helpdesk: Ticket Closed</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="subject">Ticket {{ object.name }} closed</field>
            <field name="partner_to">{{ object.customer_id.id }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Customer</t>,</p>
    <p>Your ticket <strong t-out="object.name or ''">TKT00001</strong> is closed.
        Please tell us how we did.</p>
    <p style="margin: 16px 0px;">
        <a t-att-href="object.get_rating_url()"
           style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; text-decoration: none; border-radius: 5px;">Rate Now</a>
    </p>
    <p>Best regards,<br/><t t-out="user.company_id.name or ''">Company</t></p>
</div>
            </field>
        </record>
        <!-- Sent to the customer when a closed or canceled ticket is reopened -->
        <record id="ticket_reopened" model="mail.template">
            <field name="name">Helpdesk: Ticket Reopened</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="subject">Ticket {{ object.name }} reopened</field>
            <field name="partner_to">{{ object.customer_id.id }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Customer</t>,</p>
    <p>Your ticket <strong t-out="object.name or ''">TKT00001</strong> has been reopened.</p>
    <p style="margin: 16px 0px;">
        <a t-att-href="object.get_base_url() + object.get_portal_url()"
           style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; text-decoration: none; border-radius: 5px;">View Ticket</a>
    </p>
    <p>Best regards,<br/><t t-out="user.company_id.name or ''">Company</t></p>
</div>
            </field>
        </record>
        <!-- Sent to the customer when the ticket is done -->
        <record id="ticket_approved" model="mail.template">
            <field name="name">Helpdesk: Ticket Solved</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="subject">Ticket {{ object.name }} solved</field>
            <field name="partner_to">{{ object.customer_id.id }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Customer</t>,</p>
    <p>Your ticket <strong t-out="object.name or ''">TKT00001</strong> is solved.
        If the problem comes back, simply reply to this email.</p>
    <p style="margin: 16px 0px;">
        <a t-att-href="object.get_base_url() + object.get_portal_url()"
           style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; text-decoration: none; border-radius: 5px;">View Ticket</a>
    </p>
    <p>Best regards,<br/><t t-out="user.company_id.name or ''">Company</t></p>
</div>
            </field>
        </record>
        <!-- Sent to the customer when the ticket is canceled -->
        <record id="ticket_canceled" model="mail.template">
            <field name="name">Helpdesk: Ticket Canceled</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="subject">Ticket {{ object.name }} canceled</field>
            <field name="partner_to">{{ object.customer_id.id }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Customer</t>,</p>
    <p>Your ticket <strong t-out="object.name or ''">TKT00001</strong> has been canceled.</p>
    <p style="margin: 16px 0px;">
        <a t-att-href="object.get_base_url() + object.get_portal_url()"
           style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; text-decoration: none; border-radius: 5px;">View Ticket</a>
    </p>
    <p>Best regards,<br/><t t-out="user.company_id.name or ''">Company</t></p>
</div>
            </field>
        </record>
        <!-- Sent to the team leader when a team is given the ticket -->
        <record id="odoo_website_helpdesk_assign" model="mail.template">
            <field name="name">Helpdesk: Ticket Assigned to Team</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="subject">Ticket {{ object.name }} assigned to your team</field>
            <field name="email_to">{{ object.team_head_id.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.team_head_id.name or ''">Team Leader</t>,</p>
    <p>Your team <t t-out="object.team_id.name or ''">Support</t> has been given the ticket
        <strong t-out="object.name or ''">TKT00001</strong>.</p>
    <p><strong>Subject:</strong> <t t-out="object.subject or ''">Subject</t><br/>
        <strong>Customer:</strong> <t t-out="object.customer_id.name or ''">Customer</t><br/>
        <strong>Description:</strong> <t t-out="object.description or ''">Description</t></p>
    <p>Best regards,<br/><t t-out="user.company_id.name or ''">Company</t></p>
</div>
            </field>
        </record>
        <!-- Sent to the user assigned to the ticket -->
        <record id="odoo_website_helpdesk_assign_user" model="mail.template">
            <field name="name">Helpdesk: Ticket Assigned to User</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="subject">Ticket {{ object.name }} assigned to you</field>
            <field name="email_to">{{ object.assigned_user_id.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.assigned_user_id.name or ''">User</t>,</p>
    <p>The ticket <strong t-out="object.name or ''">TKT00001</strong> has been assigned to you.</p>
    <p><strong>Subject:</strong> <t t-out="object.subject or ''">Subject</t><br/>
        <strong>Customer:</strong> <t t-out="object.customer_id.name or ''">Customer</t><br/>
        <strong>Description:</strong> <t t-out="object.description or ''">Description</t></p>
    <p>Best regards,<br/><t t-out="user.company_id.name or ''">Company</t></p>
</div>
            </field>
        </record>
        <!-- Sent to the customer when a user is assigned to the ticket -->
        <record id="odoo_website_helpdesk_to_customer" model="mail.template">
            <field name="name">Helpdesk: Ticket Assigned (Customer)</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="subject">Ticket {{ object.name }} assigned</field>
            <field name="partner_to">{{ object.customer_id.id }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.customer_id.name or ''">Customer</t>,</p>
    <p>Your ticket <strong t-out="object.name or ''">TKT00001</strong> has been assigned to
        <t t-out="object.assigned_user_id.name or ''">User</t>.</p>
    <p style="margin: 16px 0px;">
        <a t-att-href="object.get_base_url() + object.get_portal_url()"
           style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; text-decoration: none; border-radius: 5px;">View Ticket</a>
    </p>
    <p>Best regards,<br/><t t-out="user.company_id.name or ''">Company</t></p>
</div>
            </field>
        </record>
    </data>
</odoo>
