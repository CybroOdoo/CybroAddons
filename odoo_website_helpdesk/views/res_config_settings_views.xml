<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Added fields in settings form view.-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo.website.helpdesk</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="15"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="odoo_website_helpdesk" string="Helpdesk"
                     data-string="Helpdesk">
                    <block title="Helpdesk" name="helpdesk_setting_container">
                        <setting string="Create Tasks"
                                 help="Create project tasks from the tickets">
                            <field name="show_create_task"/>
                        </setting>
                    </block>
                    <block title="Ticket Settings" name="ticket_setting_container">
                        <setting string="Category"
                                 help="Categorize the tickets">
                            <field name="group_show_category"/>
                        </setting>
                        <setting string="Helpdesk Menu"
                                 help="Show the Helpdesk page in the website menu">
                            <field name="helpdesk_menu_show"/>
                        </setting>
                        <setting string="Product On Website"
                                 help="Let the customers choose products in the website form">
                            <field name="product_website"/>
                        </setting>
                        <setting string="Auto Close Ticket"
                                 help="Close the open tickets after a number of days">
                            <field name="auto_close_ticket"/>
                            <div invisible="not auto_close_ticket">
                                <label for="no_of_days"/>
                                <field name="no_of_days"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Stages" name="stages_setting_container">
                        <setting string="Close Stage"
                                 help="Stage of the closed tickets">
                            <field name="closed_stage_id"/>
                        </setting>
                        <setting string="Reply Template"
                                 help="Template proposed when replying to a ticket">
                            <field name="reply_template_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <!--    Action for settings model.-->
    <record id="action_helpdesk_general_settings"
            model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'odoo_website_helpdesk'}</field>
    </record>
</odoo>