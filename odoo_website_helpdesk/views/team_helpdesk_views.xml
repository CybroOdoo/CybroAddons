<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Define the form view for the team helpdesk model -->
    <record id="team_helpdesk_view_form" model="ir.ui.view">
        <field name="name">team.helpdesk.view.form</field>
        <field name="model">team.helpdesk</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="team_lead_id"/>
                            <field name="project_id"/>
                            <field name="create_task"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members">
                            <field name="member_ids" widget="many2many_avatar_user"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Define the list view for the team helpdesk model -->
    <record id="team_helpdesk_view_list" model="ir.ui.view">
        <field name="name">team.helpdesk.view.list</field>
        <field name="model">team.helpdesk</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_lead_id"/>
            </list>
        </field>
    </record>
    <!-- Define the action for the Helpdesk team -->
    <record id="action_helpdesk_team" model="ir.actions.act_window">
        <field name="name">Helpdesk Team</field>
        <field name="res_model">team.helpdesk</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
