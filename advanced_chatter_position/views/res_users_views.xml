<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit user form view to add chatter position preference -->
    <record id="view_users_form" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="name">res.users.view.form.inherit.advanced.chatter.position</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <field name="notification_type" position="after">
                <field name="chatter_position" widget="radio" options="{'horizontal': true}"/>
            </field>
        </field>
    </record>
</odoo>
