<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t
        t-name="direct_print_pos.ReceiptScreenInherit"
        t-inherit="point_of_sale.ReceiptScreen"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[@t-on-click='() => doFullPrint.call()']"
               position="attributes">
            <attribute name="t-on-click">printReceipt</attribute>
        </xpath>
    </t>
    <t
        t-name="direct_print_pos.OrderReceiptInherit"
        t-inherit="point_of_sale.OrderReceipt"
        t-inherit-mode="extension"
    >
        <xpath expr="//img[@id='posqrcode']" position="replace"/>
    </t>
</templates>
