<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_pos_print" model="ir.ui.view">
        <field name="name">res.config.settings.pos.print</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting title="pos template" id="pos_template_enable">
                    <field name="enable_pos_templates" string="POS Template"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

