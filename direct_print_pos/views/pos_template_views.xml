<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_print_template_view_list" model="ir.ui.view">
        <field name="name">pos.print.template.list</field>
        <field name="model">pos.print.template</field>
        <field name="arch" type="xml">
            <list string="POS Receipt Templates">
                <field name="name"/>
                <field name="report_id"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="pos_print_template_view_form" model="ir.ui.view">
        <field name="name">pos.print.template.form</field>
        <field name="model">pos.print.template</field>
        <field name="arch" type="xml">
            <form string="POS Receipt Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Default POS Receipt"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="report_id"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_print_template_view_search" model="ir.ui.view">
        <field name="name">pos.print.template.search</field>
        <field name="model">pos.print.template</field>
        <field name="arch" type="xml">
            <search string="Search POS Receipt Templates">
                <field name="name"/>
                <field name="report_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pos_print_template" model="ir.actions.act_window">
        <field name="name">POS Receipt Templates</field>
        <field name="res_model">pos.print.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pos_print_template_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new POS Receipt Template
            </p>
        </field>
    </record>

    <menuitem id="menu_pos_print_template"
              name="POS Receipt Templates"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_print_template"
              sequence="50"
              groups="direct_print_pos.group_pos_print_template"/>
</odoo>
