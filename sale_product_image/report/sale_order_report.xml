<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add a product image column to the sale order report -->
    <template id="report_saleorder_inherit"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//thead//th[@name='th_description']" position="before">
            <th name="th_product_image" t-if="doc.is_image_true" class="text-start">
                <t t-set="colspan_count" t-value="colspan_count + 1"/>
                <strong>Image</strong>
            </th>
        </xpath>
        <xpath expr="//tbody//td[@name='td_product_name']" position="before">
            <td name="td_product_image" t-if="doc.is_image_true"
                class="text-start" style="width: 90px;">
                <img t-if="line.order_line_image"
                     t-att-src="image_data_uri(line.order_line_image)"
                     style="width: 70px; height: 70px; object-fit: contain; display: block;"
                     alt="Product Image"/>
            </td>
        </xpath>
    </template>
</odoo>
