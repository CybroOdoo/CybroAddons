<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. The snippet content -->
    <template id="about_banner" name="About Banner">
        <section class="main" id="pink">
            <section class="about_main">
                <!-- Section banner starts here -->
                <section class="banner">
                    <h2>Beauty Of Interior</h2>
                    <p>is The Symbol of Elegance</p>
                </section>
                <!-- Section banner ends here -->
            </section>
        </section>
    </template>
    <template id="archit_about_banner" inherit_id="website.snippets" name="About Banner Snippet">
        <xpath expr="//snippets[@id='snippet_groups']/*[1]" position="before">
            <t snippet-group="about_banner" t-snippet="website.s_snippet_group" string="About Banner"
            t-thumbnail="/theme_archit/static/src/img/snippet/header-block.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']/*[1]" position="before">
            <t t-snippet="theme_archit.about_banner" string="About Banner" group="about_banner"/>
        </xpath>
    </template>

