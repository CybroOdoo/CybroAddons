<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="archit_blog_banner" inherit_id="website.snippets" name="Blog Banner">
        <xpath expr="//snippets[@id='snippet_groups']/*[1]" position="before">
            <t snippet-group="blog_banner" t-snippet="website.s_snippet_group" string="Blog Banner"
            t-thumbnail="/theme_archit/static/src/img/snippet/header-block.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']/*[1]" position="before">
            <t t-snippet="theme_archit.blog_banner" string="Blog Banner" group="blog_banner"/>
        </xpath>
    </template>

    <template id="blog_banner" name="Blog Banner">
        <section class="main" id="pink">
            <section class="blog_main">
                <!-- Section banner starts here -->
                <section class="banner">
                    <h2>
                        Create Blog
                    </h2>
                    <p>Creative Ideas</p>
                </section>
                <!-- Section banner ends here -->
            </section>
        </section>
    </template>
</odoo>