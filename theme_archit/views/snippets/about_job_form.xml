<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Snippet content -->
    <template id="about_job_form" name="About Job Form">
        <section class="main" id="pink">
            <section class="about_main">
                <!-- Section recruitment starts here -->
                <section class="recruit">
                    <h2 class="wrapper-heading">Recruitments</h2>
                    <p>We're Always Hiring</p>
                </section>

                <section class="fill_form">
                    <div class="sub_heading">
                        <h3 class="wrapper-heading">Places to be fulfilled</h3>
                    </div>
                    <div class="wrapper">
                        <div class="container">

                            <!-- Job position 1 -->
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-12">
                                    <h4 class="position">Senior Designer</h4>
                                </div>
                                <div class="col-lg-8 col-md-8 col-12">
                                    <div class="fill_left">
                                        <p>Maecenas sed diam eget risus varius blandit sit amet non magna.
                                            Donec id elit non mi porta gravida at eget metus.
                                            Aenean lacinia bibendum nulla sed consectetur.
                                        </p>
                                        <ul>
                                            <h4>ELIGIBILITY</h4>
                                            <li>Sed posuere consectetur est at lobortis</li>
                                            <li>Non mi porta gravida at</li>
                                            <li>Posuere consectetur</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Job position 2 -->
                            <div class="row pt-5 mt-5">
                                <div class="col-lg-4 col-md-4 col-12">
                                    <h4 class="position">Photographer</h4>
                                </div>
                                <div class="col-lg-8 col-md-8 col-12">
                                    <div class="fill_left">
                                        <p>Maecenas sed diam eget risus varius blandit sit amet non magna.
                                            Donec id elit non mi porta gravida at eget metus.
                                            Aenean lacinia bibendum nulla sed consectetur.
                                        </p>
                                        <ul>
                                            <h4>ELIGIBILITY</h4>
                                            <li>Sed posuere consectetur est at lobortis</li>
                                            <li>Non mi porta gravida at</li>
                                            <li>Posuere consectetur</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Apply Form -->
                            <div class="row pt-5 mt-5">
                                <div class="col-lg-4 col-md-4 col-12">
                                    <h4 class="position">Apply for the job</h4>
                                </div>
                                <div class="col-lg-8 col-md-8 col-12">
                                    <div class="fill_left">

                                        <!-- Static position selector (display-only, not a real form) -->
                                        <div class="job_position_selector">
                                            <h5>Position *</h5>
                                            <div class="dropdownbox">
                                                <p>Designer</p>
                                            </div>
                                            <ul class="menu">
                                                <li>Gera</li>
                                                <li>Berlin</li>
                                                <li>Melbourne</li>
                                                <li>New York</li>
                                                <li>Dresden</li>
                                            </ul>
                                        </div>

                                        <!-- Real submission form -->
                                        <section class="s_website_form pt16 pb16"
                                                 data-vcss="001"
                                                 data-snippet="s_website_form">
                                            <form class="contact-form"
                                                  id="contactus_form"
                                                  action="/website/form/"
                                                  method="post"
                                                  enctype="multipart/form-data"
                                                  data-mark="*"
                                                  data-model_name="mail.mail"
                                                  data-pre-fill="true">

                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <div class="row s_website_form_multiple">
                                                    <div class="col-sm-6 s_website_form_field s_website_form_custom"
                                                         data-type="char"
                                                         data-name="subject">
                                                        <label class="s_website_form_label" for="first_name">First Name *</label>
                                                        <input type="text"
                                                               class="form-control s_website_form_input"
                                                               name="first_name"
                                                               id="first_name"
                                                               placeholder="First Name *"
                                                               required="required"/>
                                                    </div>
                                                    <div class="col-sm-6 s_website_form_field s_website_form_custom"
                                                         data-type="char"
                                                         data-name="last_name">
                                                        <label class="s_website_form_label" data-label="Last Name *">Last Name *</label>
                                                        <input type="text"
                                                               class="form-control s_website_form_input"
                                                               name="last_name"
                                                               placeholder="Last Name *"/>
                                                    </div>

                                                    <div class="col-sm-12 s_website_form_field"
                                                         data-type="email"
                                                         data-name="email_from">
                                                        <label class="s_website_form_label">Email *</label>
                                                        <input type="email"
                                                               class="form-control s_website_form_input"
                                                               name="email_from"
                                                               placeholder="Email *"
                                                               required="required"/>
                                                    </div>

                                                    <div class="col-sm-12 s_website_form_field s_website_form_custom"
                                                         data-type="char"
                                                         data-name="cover_letter">
                                                        <label class="s_website_form_label">Cover Letter *</label>
                                                        <input type="text"
                                                               class="form-control s_website_form_input"
                                                               name="cover_letter"
                                                               placeholder="Cover Letter *"
                                                               required="required"/>
                                                    </div>

                                                    <div class="col-sm-12 s_website_form_field s_website_form_custom"
                                                         data-type="text"
                                                         data-name="body">
                                                        <label class="s_website_form_label">Message *</label>
                                                        <textarea class="form-control s_website_form_input"
                                                                  name="body"
                                                                  placeholder="Drop your message here "
                                                                  required="required"></textarea>
                                                    </div>

                                                    <div class="col-12 s_website_form_submit" data-name="Submit Button">
                                                        <button class="btn btn-black btn-lg s_website_form_send"
                                                                type="submit">
                                                            Submit
                                                        </button>
                                                        <span id="s_website_form_result"/>
                                                    </div>
                                                </div>
                                            </form>
                                        </section>

                                    </div>
                                </div>
                            </div>
                            <!-- End Apply Form -->

                        </div>
                    </div>
                </section>
                <!-- Section recruitment ends here -->
            </section>
        </section>
    </template>

    <template id="archit_about_job_form" inherit_id="website.snippets" name="About Job Form Snippet">
        <xpath expr="//snippets[@id='snippet_groups']/*[1]" position="before">
            <t snippet-group="about_job_form" t-snippet="website.s_snippet_group" string="About Job Form"
            t-thumbnail="/theme_archit/static/src/img/snippet/job-form-block.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']/*[1]" position="before">
            <t t-snippet="theme_archit.about_job_form" string="About Job Form" group="about_job_form"/>
        </xpath>
    </template>

</odoo>