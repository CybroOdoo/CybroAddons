<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="archit_blank" inherit_id="website.snippets" name="Blank">
        <xpath expr="//snippets[@id='snippet_groups']/*[1]" position="before">
            <t snippet-group="blank" t-snippet="website.s_snippet_group" string="Blank"
            t-thumbnail="/theme_archit/static/src/img/snippet/blank-page-block.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']/*[1]" position="before">
            <t t-snippet="theme_archit.blank" string="Blank" group="blank"/>
        </xpath>
    </template>
    <template id="blank" name="Blank">
        <section class="main" id="pink">
            <!-- Section blank starts here -->
            <section class="blank">
                <div class="container">
                    <div class="wrapper">
                        <h2 class="wrapper-heading">
                            I'M BLANK
                        </h2>
                    </div>
                </div>
            </section>
        </section>
    </template>
</odoo>
