<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="archit_contact" inherit_id="website.snippets" name="Contact">
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
            <t t-snippet="theme_archit.contact"
               t-thumbnail="/theme_archit/static/src/img/snippet/contact-form-block.jpg"/>
        </xpath>
    </template>
    <template id="contact" name="Contact">
        <section class="main" id="pink">
            <section class="contact">
                <!-- Section recruitment starts here -->
                <section class="contact_content">
                    <div class="wrapper">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-5 col-md-6 col-12">
                                    <div class="address_wrapper">
                                        <div class="address">
                                            <h4>3646 Byers Lane</h4>
                                            <p>Mogi das Cruzes</p>
                                            <p>São Paulo 08735-030</p>
                                            <p>Cell:
                                                <a href="tel:+4733378901">
                                                    +47 333 78 901
                                                </a>
                                            </p>
                                        </div>
                                        <div class="address">
                                            <h4>422 Duncan Avenue</h4>
                                            <p>New Yorks</p>
                                            <p>NY New York 10016</p>
                                            <p>Cell:
                                                <a href="tel:+1 917-413-0508">
                                                    +1 917-413-0508
                                                </a>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="social">
                                        <h4>SOCIAL</h4>
                                        <div class="social_icon">
                                            <a href="#">
                                                <span class="fa fa-dribbble"/>
                                            </a>
                                            <a href="#">
                                                <span class="fa fa-google-plus"/>
                                            </a>
                                            <a href="#">
                                                <span class="fa fa-linkedin"/>
                                            </a>
                                            <a href="#">
                                                <span class="fa fa-twitter"/>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-7 col-md-6 col-12">
                                    <section
                                            class="s_website_form pt16 pb16"
                                            data-snippet="s_website_form"
                                            data-vcss="001">
                                        <div class="post_replay">
                                            <form class="contact-form"
                                                  id="contactus_form"
                                                  action="/website/form/"
                                                  method="post"
                                                  enctype="multipart/form-data"
                                                  data-mark="*"
                                                  data-model_name="mail.mail"
                                                  data-pre-fill="true">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <div class="row">
                                                    <div class="col-12">
                                                        <div class="input-block s_website_form_field form-group" data-type="char">
                                                            <label for="subject" class="s_website_form_label">Subject</label>
                                                            <input type="text"
                                                                   placeholder="SUBJECT"
                                                                   name="subject"
                                                                   data-name="Subject"
                                                                   id="contact-form-control"
                                                                   class="form-control s_website_form_input o_website_form_input"
                                                                   required="required"/>
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="input-block s_website_form_field form-group" data-type="char">
                                                            <label for="email" class="s_website_form_label">Email</label>
                                                            <input type="text"
                                                                   placeholder="EMAIL"
                                                                   name="email"
                                                                   data-name="Email"
                                                                   class="form-control s_website_form_input o_website_form_input"
                                                                   required="required"/>
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="input-block s_website_form_field form-group" data-type="char">
                                                            <label for="comment" class="s_website_form_label">Comment</label>
                                                            <textarea name=""
                                                                      class="txt"
                                                                      cols=""
                                                                      rows="10"
                                                                      style="width: 100%;"
                                                                      id="usr"
                                                                      placeholder=" COMMENT"/>
                                                        </div>
                                                    </div>
                                                    <button type="submit"
                                                            class="btn btn-black s_website_form_send col-12 s_website_form_submit"
                                                            data-name="Submit Button">
                                                        <div class="s_website_form_label"/>
                                                        SEND NOW
                                                    </button>
                                                    <span id="s_website_form_result"/>
                                                </div>
                                            </form>
                                        </div>
                                    </section>
                                </div>
                            </div>
                            <div class="map">
                                <t t-call="website.s_map"/>
                            </div>
                        </div>
                    </div>
                </section>
            </section>
        </section>
    </template>
</odoo>
