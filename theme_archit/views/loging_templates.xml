<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--     Loging page template-->
    <template id="inherit_login_page" inherit_id="web.login">
        <xpath expr="//form" position="replace">
            <section class="login loging_enter">
                <div class="container d-flex justify-center   h-full">
                    <div class="wrapper">
                        <div class="row">
                            <div class="col-12">
                                <form t-attf-class="oe_login_form o_login_form #{'' if login else 'd-none'}" role="form"
                                      t-attf-action="/web/login"
                                      method="post"
                                      onsubmit="this.action = '/web/login' + location.hash">
                                    <div class="login_form loging_template">
                                        <h3>Login with Rader</h3>
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="form-group"
                                                     t-if="databases and len(databases) &gt; 1">
                                                    <label for="db"
                                                           class="col-form-label">
                                                        Database
                                                    </label>
                                                    <div t-attf-class="input-group {{'input-group-sm' if form_small else ''}}">
                                                        <input type="text"
                                                               name="db"
                                                               t-att-value="request.db"
                                                               id="db"
                                                               t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                                               required="required"
                                                               readonly="readonly"/>
                                                        <a role="button"
                                                           href="/web/database/selector"
                                                           class="btn btn-secondary">
                                                            Select
                                                            <i class="fa fa-database"
                                                               role="img"
                                                               aria-label="Database"
                                                               title="Database"/>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="form-group">
                                                    <label for="login" class="form-label d-flex justify-content-between">Email</label>
                                                    <input type="text"
                                                           placeholder="Enter your email"
                                                           name="login"
                                                           t-att-value="login"
                                                           id="login"
                                                           t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                                           required="required"
                                                           autofocus="autofocus"
                                                           autocapitalize="off"/>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="form-group">
                                                    <label for="password" class="form-label d-flex justify-content-between">Password</label>
                                                    <input type="password"
                                                           placeholder="Enter your Password"
                                                           name="password"
                                                           id="password"
                                                           t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                                           required="required"
                                                           autocomplete="current-password"
                                                           t-att-autofocus="'autofocus' if login else None"
                                                           maxlength="4096"/>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="form-group">
                                                    <p class="alert alert-danger"
                                                       t-if="error"
                                                       role="alert">
                                                        <t t-esc="error"/>
                                                    </p>
                                                    <p class="alert alert-success"
                                                       t-if="message"
                                                       role="status">
                                                        <t t-esc="message"/>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between mb-2 px-0">
                                                <div class="form-check m-0 d-flex align-items-center">
                                                    <input class="form-check-input me-2" type="checkbox" value="" id="flexCheckDefault"/>
                                                    <label class="form-check-label m-0" for="flexCheckDefault">Remember Me</label>
                                                </div>
                                                <div class="oe_login_buttons o_login_buttons d-flex align-items-center m-0">
                                                    <button type="submit" class="btn btn-black px-4" style="width: fit-content;">Log in</button>
                                                    <div class="o_login_auth"/>
                                                </div>
                                            </div>
                                            <div class="justify-content-between mt-2 d-flex small">
                                                <a t-if="signup_enabled" t-attf-href="/web/signup?{{ keep_query() }}">
                                                    Don't have an account?
                                                </a>
                                                <a t-if="reset_password_enabled"
                                                   t-attf-href="/web/reset_password?{{ keep_query() }}">Reset Password
                                                </a>
                                            </div>
                                            <div class="col-12" style="left: 85px; padding-top: 10px;">
                                                <t t-if="debug">
                                                    <button type="submit"
                                                            name="redirect"
                                                            value="/web/become"
                                                            class="btn btn-link btn-sm">
                                                        Log in as superuser
                                                    </button>
                                                </t>
                                            </div>
                                            <input type="hidden" name="redirect"
                                                   t-att-value="redirect"/>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
