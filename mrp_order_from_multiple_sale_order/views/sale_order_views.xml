<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Sale order form: smart button and manufacturing orders field -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.mrp.order.from.multiple.sale.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="get_mrp"
                        icon="fa-wrench" invisible="mrp_count == 0"
                        groups="mrp.group_mrp_user">
                    <field string="Manufacturing Orders" name="mrp_count"
                           widget="statinfo"/>
                </button>
            </div>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="mrp_order_ids" widget="many2many_tags"
                       groups="mrp.group_mrp_user"/>
            </xpath>
        </field>
    </record>

    <!-- Sale orders list: manufacturing orders column -->
    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.mrp.order.from.multiple.sale.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="mrp_order_ids" widget="many2many_tags"
                       groups="mrp.group_mrp_user"/>
            </xpath>
        </field>
    </record>

    <!-- Quotations list: manufacturing orders column -->
    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="name">sale.order.quotation.list.inherit.mrp.order.from.multiple.sale.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="mrp_order_ids" widget="many2many_tags"
                       groups="mrp.group_mrp_user"/>
            </xpath>
        </field>
    </record>
</odoo>
