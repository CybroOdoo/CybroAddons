<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="website_settings_inherit_form" model="ir.ui.view">
        <field name="name">website.settings.inherit.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Product Recommendation" id="website_recommendation_settings">
                    <setting id="modelchoice" string="Recommendation Models"
                             help="Choose the AI model for product recommendations. “High Speed” is optimized for quick results, while “High Performance” provides more accurate recommendations."
                             documentation="https://www.example.com/">
                        <field name="model_choice" widget="radio"/>
                        <field name="nomic_token" invisible="model_choice != 'accurate'" placeholder = "Enter nomic token" style="width:80%"/>
                    </setting>
                    <setting id="productmetadata" string="Product Metadatas"
                             help="Select which product information will be used to generate embeddings for recommendations.">
                        <field name="product_metadata" widget="radio"/>
                    </setting>
                    <setting id="recommendationlimit" string="Recommendation Limit"
                             help="Set the number of recommended products to display on the shop page.">
                        <field name="recommendation_limit"/>
                    </setting>
                    <setting id="enable_reco_product" string="Recommendation Product View"
                             help="Does the recommended products needs to be displayed on the shop page.">
                        <field name="enable_recommendations"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>