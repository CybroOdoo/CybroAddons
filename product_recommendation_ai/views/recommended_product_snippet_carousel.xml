<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="recommended_products_shop"
              inherit_id="website_sale.products"
              name="Recommended Products JS Container">
        <xpath expr="//div[contains(@class, 'btn-toolbar')]" position="after">
                <t t-if="
                    request.website
                    and request.env.user
                    and request.env.user.id != request.website.user_id.id
                    and request.env.user.has_completed_order()
                    and request.env['ir.config_parameter'].sudo()
                        .get_param('product_recommendation_ai.enable_recommendations')
                ">
                <section class="container mt-4 mb-5">
                    <h4 class="mb-3">Recommended for You</h4>
                    <div class="position-relative">
                        <button id="reco-left"
                                class="btn btn-primary shadow-sm position-absolute"
                                style="top: 50%; left: -40px; transform: translateY(-50%);
                           width: 40px; height: 40px; border-radius: 50%;">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                        <button id="reco-right"
                                class="btn btn-primary shadow-sm position-absolute"
                                style="top: 50%; right: -40px; transform: translateY(-50%);
                           width: 40px; height: 40px; border-radius: 50%;">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                        <div id="reco-loading"
                             class="w-100 d-flex justify-content-center py-4">
                            <div class="spinner-border text-primary"
                                 role="status"
                                 style="width: 2.5rem; height: 2.5rem;">
                            </div>
                        </div>
                        <div id="reco-slider"
                             class="d-flex flex-row flex-nowrap py-2"
                             style="scroll-behavior: smooth; display:none; width:100%; overflow-x:hidden; overflow-y:visible;">
                        </div>
                    </div>
                </section>
                <hr/>
            </t>
        </xpath>
    </template>
</odoo>
