<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_customer_feedback.Calculator" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
       <button t-if="pos.config.is_active_calc" class="btn btn-secondary btn-lg lh-lg text-truncate w-auto" t-on-click="() => this.onClick()" t-ref="Feedback">
            <i class="fa fa-calculator me-1" />
            <span>Calculator</span>
        </button>
        </xpath>
    </t>
</templates>
