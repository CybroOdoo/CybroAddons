<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Age verification popup on the signup page -->
    <template id="web_age_signup_layout" name="Signup Age Verification"
              inherit_id="auth_signup.signup">
        <xpath expr="//form" position="after">
            <div class="o_age_verify" role="dialog" aria-modal="true"
                 aria-labelledby="o_age_verify_title">
                <div class="card o_age_verify_card">
                    <div class="row g-0 align-items-center">
                        <div class="col-lg-4 text-center p-4">
                            <img class="img-fluid"
                                 src="/age_verification_odoo/static/src/image/check-mark.png"
                                 alt="Age verification"/>
                        </div>
                        <div class="col-lg-8">
                            <div class="card-body text-center">
                                <h2 id="o_age_verify_title">Age Verification</h2>
                                <p>Please confirm your age.</p>
                                <p class="text-muted">You must be 18 or over to
                                    access this website.</p>
                                <label class="form-label"
                                       for="o_age_verify_date">Please enter your
                                    date of birth</label>
                                <input type="date" id="o_age_verify_date"
                                       class="form-control o_age_verify_date mb-3"
                                       t-att-max="datetime.date.today()"/>
                                <button type="button"
                                        class="btn btn-primary o_age_verify_submit">
                                    Submit
                                </button>
                                <p class="o_age_verify_invalid text-danger mt-3 d-none">
                                    Please enter a valid date of birth.
                                </p>
                                <p class="o_age_verify_denied text-danger mt-3 d-none">
                                    You don't have permission to access this
                                    website.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
