<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Credit limit report wizard form view -->
    <record id="credit_limit_report_view_form" model="ir.ui.view">
        <field name="name">credit.limit.report.view.form</field>
        <field name="model">credit.limit.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="customer_id"/>
                    </group>
                    <footer>
                        <button string="Print XLSX" name="action_print_report"
                                type="object" class="oe_highlight"
                                context="{'close_on_click': True}"/>
                        <button string="Discard" class="btn-default"
                                special="cancel"/>
                    </footer>
                    <group/>
                </group>
            </form>
        </field>
    </record>
    <!-- Action for credit limit report -->
    <record id="credit_limit_report_action" model="ir.actions.act_window">
        <field name="name">Credit Limit Analysis</field>
        <field name="res_model">credit.limit.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="credit_limit_report_view_form"/>
        <field name="target">new</field>
    </record>
    <!-- Menu item to access the Credit Limit Analysis -->
    <menuitem name="Credit Limit Analysis"
              id="credit_limit_report_xlsx_menu"
              action="credit_limit_report_action"
              parent="account.account_reports_management_menu"
              sequence="88"/>
</odoo>
