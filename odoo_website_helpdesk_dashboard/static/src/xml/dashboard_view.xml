<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_website_helpdesk_dashboard.HelpDeskDashBoard">
        <div class="o_helpdesk_dashboard h-100 overflow-auto p-3">
            <h2 class="o_helpdesk_dashboard_title mb-3">HelpDesk Dashboard</h2>
            <div class="row g-3 mb-3">
                <div t-foreach="this.cards" t-as="card" t-key="card.key"
                     class="col-sm-6 col-lg-3">
                    <div t-att-class="'card o_helpdesk_card h-100 o_helpdesk_card_' + card.key"
                         role="button" t-on-click="() => this.openCard(card)">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="oi oi-2x o_helpdesk_card_icon" t-att-data-icon="card.icon"/>
                            <div>
                                <div class="o_helpdesk_card_label" t-out="card.label"/>
                                <div class="o_helpdesk_card_count" t-out="card.count"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card o_helpdesk_review mb-3">
                <div class="card-body text-center">
                    <span class="fw-bold">Customer Satisfaction:</span>
                    <span class="ms-2">Reviews Received</span>
                    <span class="o_helpdesk_review_count ms-2 fw-bold"
                          t-out="this.state.data.review_count"/>
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header"><h3 class="mb-0">Ticket Priority</h3></div>
                        <div class="card-body o_helpdesk_priorities">
                            <div t-foreach="this.state.data.priorities" t-as="priority"
                                 t-key="priority.key"
                                 t-att-class="'mb-2 o_helpdesk_priority_' + priority.key">
                                <div class="d-flex justify-content-between">
                                    <span t-out="priority.label"/>
                                    <span class="o_helpdesk_priority_percent"
                                          t-out="priority.percent + '%'"/>
                                </div>
                                <progress class="o_helpdesk_priority_bar w-100" max="100"
                                          t-att-value="priority.percent"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header"><h3 class="mb-0">Ticket Status</h3></div>
                        <div class="card-body o_helpdesk_chart o_helpdesk_status_chart">
                            <canvas t-ref="this.statusChart.ref"/>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header"><h3 class="mb-0">Tickets per Team</h3></div>
                        <div class="card-body o_helpdesk_chart o_helpdesk_team_chart">
                            <canvas t-ref="this.teamChart.ref"/>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header"><h3 class="mb-0">Latest Tickets</h3></div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 o_helpdesk_tickets">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Ticket</th>
                                <th>Assigned To</th>
                                <th>Subject</th>
                                <th>Priority</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.state.data.tickets" t-as="ticket"
                                t-key="ticket.id" role="button"
                                t-on-click="() => this.openTicket(ticket)">
                                <td t-out="ticket.customer"/>
                                <td t-out="ticket.name"/>
                                <td t-out="ticket.assigned_to"/>
                                <td t-out="ticket.subject"/>
                                <td t-out="ticket.priority"/>
                            </tr>
                            <tr t-if="!this.state.data.tickets.length">
                                <td colspan="5" class="text-center text-muted">
                                    No tickets yet.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
