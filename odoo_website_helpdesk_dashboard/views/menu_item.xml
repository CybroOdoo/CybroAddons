<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Client action of the HelpDesk dashboard -->
    <record id="action_website_helpdesk_dashboard" model="ir.actions.client">
        <field name="name">HelpDesk Dashboard</field>
        <field name="tag">helpdesk_dashboard</field>
    </record>
    <!-- First menu of the HelpDesk app, so the app opens on the dashboard,
         for HelpDesk users and administrators -->
    <menuitem id="menu_helpdesk_dashboard_new" name="Dashboard"
              parent="odoo_website_helpdesk.menu_helpdesk" sequence="0"
              action="action_website_helpdesk_dashboard"
              groups="odoo_website_helpdesk.helpdesk_user,base.group_system"/>
</odoo>
