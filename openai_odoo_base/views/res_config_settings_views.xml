<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add new field OpenAI API Key in configuration settings.-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.openai.odoo.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="openai_setting_container" string="OpenAI" help="Add API key obtained from the OpenAI website" documentation="https://platform.openai.com/account/api-keys">
                    <field name="openai_api_key" password="True"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
