<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Extends the POS Payment Screen Due section.
        Adds dynamic font-size styling for the total amount
        using the configured CSS variable value from POS settings.
        The style is applied only on large screens.
    -->
    <t t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[contains(@class, 'total')]" position="attributes">
            <attribute name="t-att-style">!ui.isSmall? 'font-size: var(--pos-payment-total-font-size);' : ''</attribute>
        </xpath>
    </t>
    <!--Extends the POS Partner List dialog.
        Adds a custom CSS class to the dialog container
        for applying custom styling to the partner list screen.-->

    <t t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension" owl="1">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="contentClass">'h-100 pos-partner-list-screen'</attribute>
        </xpath>
    </t>
</templates>
