<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit POS settings view.
        Add font size configuration options for POS screens and elements.
    -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.font.size</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add POS font size settings block -->
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Font Size" id="pos_font_size_block">
                  <!-- Configure preset and global font scaling -->
                    <setting string="Font Size Preset" help="Quick presets to scale all POS fonts proportionally">
                        <div class="content-group">
                            <div class="row mt16">
                                <label string="Font Preset" for="pos_font_preset" class="col-lg-3 o_light_label"/>
                                <field name="pos_font_preset" widget="radio"/>
                            </div>
                            <div class="row mt16">
                                <label string="Global Scale (%)" for="pos_global_scale" class="col-lg-3 o_light_label"/>
                                <field name="pos_global_scale"/>
                            </div>
                        </div>
                    </setting>
                    <!-- Configure custom font sizes for POS UI -->
                    <setting string="Custom Font Sizes (pixels)" help="Set individual font sizes per area. 0 = use scaled default"
                             invisible="pos_font_preset != 'custom'">
                        <div class="content-group">
                            <div class="row mt16">
                                <div class="col-6">
                                    <div class="row">
                                        <label string="Product Card" for="pos_product_card_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_product_card_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Product Price" for="pos_product_price_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_product_price_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Categories" for="pos_categories_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_categories_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Numpad" for="pos_numpad_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_numpad_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Order Lines" for="pos_order_line_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_order_line_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Control Buttons" for="pos_control_buttons_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_control_buttons_font_size" class="col-lg-4"/>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="row">
                                        <label string="Payment Screen" for="pos_payment_screen_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_payment_screen_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Total Amount" for="pos_payment_total_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_payment_total_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Receipt Preview" for="pos_receipt_preview_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_receipt_preview_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Customer List" for="pos_customer_list_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_customer_list_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Navbar" for="pos_navbar_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_navbar_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Ticket Screen" for="pos_ticket_screen_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_ticket_screen_font_size" class="col-lg-4"/>
                                    </div>
                                    <div class="row mt8">
                                        <label string="Popups &amp; Dialogs" for="pos_popups_dialogs_font_size" class="col-lg-6 o_light_label"/>
                                        <field name="pos_popups_dialogs_font_size" class="col-lg-4"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
