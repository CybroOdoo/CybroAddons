<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Parent menu sits under the CRM app root -->
    <menuitem id="menu_crm_retention_root"
              name="Retention"
              parent="crm.crm_menu_root"
              sequence="20"
              groups="crm_churn_predictor.group_churn_user"/>

    <!-- Churn Predictor list/form dashboard -->
    <menuitem id="menu_churn_score_dashboard"
              name="Churn Predictor"
              parent="menu_crm_retention_root"
              action="action_churn_score_dashboard"
              sequence="10"
              groups="crm_churn_predictor.group_churn_user"/>

    <!-- Kanban board grouped by risk level -->
    <menuitem id="menu_churn_score_kanban"
              name="Risk Kanban Board"
              parent="menu_crm_retention_root"
              action="action_churn_score_kanban"
              sequence="20"
              groups="crm_churn_predictor.group_churn_user"/>

</odoo>
