<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_churn_score_daily" model="ir.cron">
        <field name="name">Churn Predictor: Daily Customer Scoring</field>
        <field name="model_id" ref="model_churn_score"/>
        <field name="state">code</field>
        <field name="code">model.cron_compute_all_scores()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="priority">10</field>
    </record>
</odoo>
