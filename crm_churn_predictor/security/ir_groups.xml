<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_category_churn" model="res.groups.privilege">
        <field name="name">CRM Churn Predictor</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_churn_user" model="res.groups">
        <field name="name">User: Own Customers</field>
        <field name="privilege_id" ref="privilege_category_churn"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view and manually recalculate churn scores for customers assigned to them.</field>
    </record>

    <record id="group_churn_manager" model="res.groups">
        <field name="name">Manager: All Customers</field>
        <field name="privilege_id" ref="privilege_category_churn"/>
        <field name="implied_ids" eval="[(4, ref('crm_churn_predictor.group_churn_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to all churn scores across all customers.</field>
    </record>
</odoo>
