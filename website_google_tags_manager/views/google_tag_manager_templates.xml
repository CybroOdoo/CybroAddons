<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!--        Add the container id to the head of the page-->
    <template id="google_tags_manager_template" inherit_id="web.layout"
              name="Tag Manager">
        <xpath expr="//head" position="after">
            <!-- Google Tag Manager -->
            <script t-if="website and website.google_tags_manager and website.container_name">
                (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                new Date().getTime(),event:'gtm.js'});var
                f=d.getElementsByTagName(s)[0],
                j=d.createElement(s),dl=l!='dataLayer'?'&amp;l='+l:'';j.async=true;j.src=
                'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                })(window,document,'script','dataLayer','<t
                    t-esc="website.container_name"/>');
            </script>
            <!-- End Google Tag Manager -->
        </xpath>

        <!--            Add container id to body of page-->
        <xpath expr="//body" position="after">
            <!--  Google Tag Manager (noscript)  -->
            <noscript
                    t-if="website and website.google_tags_manager and website.container_name">
                <iframe t-attf-src="https://www.googletagmanager.com/ns.html?id={{ website.container_name }}"
                        height="0" width="0"
                        style="display:none;visibility:hidden"/>
            </noscript>
            <!--  End Google Tag Manager (noscript)  -->
        </xpath>
    </template>
</odoo>
