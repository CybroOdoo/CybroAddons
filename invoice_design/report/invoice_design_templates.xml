<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template of the custom invoice report -->
    <template id="report_invoice_design">
        <t t-call="web.html_container">
            <t t-foreach="env['account.move'].browse(move_ids)" t-as="invoice">
                <div class="page">
                    <t t-call="{{key}}"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
