<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Option to enable the custom invoice in the configuration settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.invoice.design</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="custom_invoice_setting"
                         string="Custom Invoice"
                         help="Use a custom template for printing invoices">
                    <field name="is_custom_invoice"/>
                    <div class="content-group mt16"
                         invisible="not is_custom_invoice">
                        <span>Invoice Design:&amp;nbsp;</span>
                        <field name="invoice_design_id"
                               required="is_custom_invoice"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
