<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="instant_import.ImportAction" t-inherit="ImportAction" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-buttons']/t[@t-if='this.isPreviewing']" position="replace">
            <t t-if="this.isPreviewing">
                <button t-if="!this.state.isTest" type="button" class="btn btn-primary" t-on-click="() => this.handleTest()">Test</button>
                <button t-if="!this.state.isTest" type="button" class="btn btn-secondary" t-on-click="() => this.handleImport(false)">Import</button>
                <button t-if="this.state.isTest" type="button" class="btn btn-primary" t-on-click="() => this.handleImport(false)">Import</button>
                <button t-if="this.state.isTest" type="button" class="btn btn-secondary" t-on-click="() => this.handleTest()">Test</button>
            </t>
        </xpath>
    </t>
</templates>