<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categories (with images from jewelry assets) -->
    <record id="cat_rings" model="product.public.category">
        <field name="name">Rings</field>
        <field name="sequence">10</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/rings_1777448120321.png"/>
    </record>
<!--    Necklace-->
    <record id="cat_necklaces" model="product.public.category">
        <field name="name">Necklaces</field>
        <field name="sequence">20</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/necklaces_1777448088430.png"/>
    </record>
    <!-- Earrings -->
    <record id="cat_earrings" model="product.public.category">
        <field name="name">Earrings</field>
        <field name="sequence">30</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/product_2_1777448189229.png"/>
    </record>
    <!-- Bracelets -->
    <record id="cat_bracelets" model="product.public.category">
        <field name="name">Bracelets</field>
        <field name="sequence">40</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/product_1_1777448174198.png"/>
    </record>
    <!-- Product Templates with pricing, imagery and e-commerce descriptions -->
    <record id="product_ring_1" model="product.template">
        <field name="name">Solid Gold Band</field>
        <field name="list_price">450.00</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('cat_rings')])]"/>
        <field name="website_published">True</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/rings_1777448120321.png"/>
        <field name="description_ecommerce">A timeless 14k solid gold band, hand-polished to a mirror finish. Designed to be worn every day and cherished forever.</field>
    </record>
<!--    Diamond Solitaire Pendant-->
    <record id="product_necklace_1" model="product.template">
        <field name="name">Diamond Solitaire Pendant</field>
        <field name="list_price">1200.00</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('cat_necklaces')])]"/>
        <field name="website_published">True</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/necklaces_1777448088430.png"/>
        <field name="description_ecommerce">A brilliant-cut diamond suspended on a delicate gold chain. The epitome of understated elegance.</field>
    </record>
<!--    Sapphire Halo Ring-->
    <record id="product_ring_2" model="product.template">
        <field name="name">Sapphire Halo Ring</field>
        <field name="list_price">2100.00</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('cat_rings')])]"/>
        <field name="website_published">True</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/product_1_1777448174198.png"/>
        <field name="description_ecommerce">A vivid blue sapphire encircled by a halo of brilliant-cut diamonds, set in 18k white gold.</field>
    </record>
<!--Pearl Drop Earrings-->
    <record id="product_earring_1" model="product.template">
        <field name="name">Pearl Drop Earrings</field>
        <field name="list_price">850.00</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('cat_earrings')])]"/>
        <field name="website_published">True</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/product_2_1777448189229.png"/>
        <field name="description_ecommerce">Lustrous freshwater pearls suspended from delicate gold hooks. A timeless statement of feminine elegance.</field>
    </record>
<!--Vintage Chain Necklace-->
    <record id="product_necklace_2" model="product.template">
        <field name="name">Vintage Chain Necklace</field>
        <field name="list_price">680.00</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('cat_necklaces')])]"/>
        <field name="website_published">True</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/necklaces_1777448088430.png"/>
        <field name="description_ecommerce">A beautifully crafted vintage-inspired chain, hand-finished in 14k gold with antique detailing.</field>
    </record>
<!--    Aria Cuff Bracelet-->
    <record id="product_bracelet_1" model="product.template">
        <field name="name">Aria Cuff Bracelet</field>
        <field name="list_price">520.00</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('cat_bracelets')])]"/>
        <field name="website_published">True</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/product_1_1777448174198.png"/>
        <field name="description_ecommerce">A sculptural cuff bracelet in polished gold, designed to be stacked or worn solo as a statement piece.</field>
    </record>
<!--Classic Diamond Ring-->
    <record id="product_ring_3" model="product.template">
        <field name="name">Classic Diamond Ring</field>
        <field name="list_price">3400.00</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('cat_rings')])]"/>
        <field name="website_published">True</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/rings_1777448120321.png"/>
        <field name="description_ecommerce">A round brilliant diamond in a classic four-prong setting. The quintessential engagement ring.</field>
    </record>
<!--Gold Hoop Earrings-->
    <record id="product_earring_2" model="product.template">
        <field name="name">Gold Hoop Earrings</field>
        <field name="list_price">320.00</field>
        <field name="public_categ_ids" eval="[(6, 0, [ref('cat_earrings')])]"/>
        <field name="website_published">True</field>
        <field name="image_1920" type="base64" file="theme_lantero/static/src/img/product_2_1777448189229.png"/>
        <field name="description_ecommerce">Perfectly proportioned gold hoops, hand-polished to a high shine. An everyday essential.</field>
    </record>
    <!-- Custom Blog/Journal channel for posting editorial articles -->
    <record id="blog_journal" model="blog.blog">
        <field name="name">The Journal</field>
        <field name="subtitle">Stories of Craft and Connection</field>
    </record>
    <!-- Blog Posts showcasing craftsmanship and curation styling -->
    <record id="blog_post_1" model="blog.post">
        <field name="name">The quiet rise of timeless jewelry</field>
        <field name="blog_id" ref="blog_journal"/>
        <field name="subtitle">In a fast-fashion world, the heirloom returns.</field>
        <field name="author_id" ref="base.partner_admin"/>
        <field name="website_published">True</field>
        <field name="cover_properties">{"background-image": "url('/theme_lantero/static/src/img/hero_image_1777447769754.png')", "resize_class": "o_record_has_cover cover_auto"}</field>
        <field name="content" type="html">
            <section class="s_text_block pt40 pb40" data-snippet="s_text_block">
                <div class="container">
                    <p>As consumers turn away from disposable trends, a new generation is rediscovering the value of pieces designed to last a lifetime. We sat down with our head of design to talk about the slow-jewelry movement and why heirlooms are having a moment.</p>
                </div>
            </section>
        </field>
    </record>
<!--Inside the atelier where every piece begins-->
    <record id="blog_post_2" model="blog.post">
        <field name="name">Inside the atelier where every piece begins</field>
        <field name="blog_id" ref="blog_journal"/>
        <field name="subtitle">A morning with the master artisans whose hands shape the collection.</field>
        <field name="author_id" ref="base.partner_admin"/>
        <field name="website_published">True</field>
        <field name="cover_properties">{"background-image": "url('/theme_lantero/static/src/img/craftsman_1777447788481.png')", "resize_class": "o_record_has_cover cover_auto"}</field>
        <field name="content" type="html">
            <section class="s_text_block pt40 pb40" data-snippet="s_text_block">
                <div class="container">
                    <p>A morning with the twelve master artisans whose hands shape the collection — from the first sketch to the final polish.</p>
                </div>
            </section>
        </field>
    </record>
<!--Pearls, reimagined: the new wave of pearl jewelry-->
    <record id="blog_post_3" model="blog.post">
        <field name="name">Pearls, reimagined: the new wave of pearl jewelry</field>
        <field name="blog_id" ref="blog_journal"/>
        <field name="subtitle">Once your grandmother's signature, pearls are finding a fresh audience.</field>
        <field name="author_id" ref="base.partner_admin"/>
        <field name="website_published">True</field>
        <field name="cover_properties">{"background-image": "url('/theme_lantero/static/src/img/product_2_1777448189229.png')", "resize_class": "o_record_has_cover cover_auto"}</field>
        <field name="content" type="html">
            <section class="s_text_block pt40 pb40" data-snippet="s_text_block">
                <div class="container">
                    <p>Once your grandmother's signature, pearls are finding a fresh audience. Here's how to wear them now without feeling like a costume.</p>
                </div>
            </section>
        </field>
    </record>
    <!-- Custom About Menu item -->
    <record id="theme_lantero.theme_menu_about" model="theme.website.menu">
        <field name="name">About</field>
        <field name="url">/aboutus</field>
        <field name="use_main_menu_as_parent">True</field>
        <field name="sequence" type="int">20</field>
    </record>
    <!-- Custom Track Order Menu item -->
    <record id="theme_lantero.theme_menu_track" model="theme.website.menu">
        <field name="name">Track Order</field>
        <field name="url">/track-order</field>
        <field name="use_main_menu_as_parent">True</field>
        <field name="sequence" type="int">40</field>
    </record>
    <!-- Newsletter mass mailing list database record -->
    <record id="lantero_inner_circle_list" model="mailing.list">
        <field name="name">Lantero Inner Circle</field>
        <field name="is_public">True</field>
    </record>
</odoo>
