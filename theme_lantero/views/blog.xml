<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Blog / Journal Page View Template -->
    <template id="lantero_blog_page" name="Lantero Blog">
        <t t-call="website.layout">
            <t t-set="additional_title">Journal</t>
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Page Header Section -->
                <section class="page-header o_colored_level" data-name="Page Header">
                    <div class="container">
                        <span class="section-subtitle o_editable">The Journal</span>
                        <h1 class="page-title o_editable">Stories &amp; Inspiration</h1>
                        <p class="page-desc o_editable">Styling guides, conversations with our artisans, and the stories behind every collection — written for those who love jewelry as much as we do.</p>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Blog Content Grid -->
                <section class="blog-section o_colored_level" data-name="Blog Content">
                    <div class="container">
                        <!-- Featured Article spotlight -->
                        <article class="blog-featured">
                            <div class="row align-items-center">
                                <div class="col-lg-7 mb-4 mb-lg-0 pe-lg-5">
                                    <a href="#"><img src="/theme_lantero/static/src/img/hero_image_1777447769754.png" alt="Featured article" class="blog-featured-img img img-fluid o_we_custom_image"/></a>
                                </div>
                                <div class="col-lg-5">
                                    <span class="blog-meta o_editable">
                                        <span class="blog-category">Featured</span>
                                        <span>April 22, 2026 &amp;middot; 8 min read</span>
                                    </span>
                                    <h2 class="blog-featured-title o_editable"><a href="#" class="text-reset text-decoration-none">The quiet rise of timeless jewelry in a fast-fashion world</a></h2>
                                    <p class="blog-featured-excerpt o_editable">As consumers turn away from disposable trends, a new generation is rediscovering the value of pieces designed to last a lifetime. We sat down with our head of design to talk about the slow-jewelry movement and why heirlooms are having a moment.</p>
                                    <a href="#" class="blog-card-link">Read the article <i class="bi bi-arrow-right"/></a>
                                </div>
                            </div>
                        </article>
                        <!-- Recent Posts Section Header -->
                        <div class="d-flex justify-content-between align-items-end mb-5">
                            <div>
                                <span class="section-subtitle o_editable">Recent Stories</span>
                                <h2 class="related-title mt-2 mb-0 o_editable">Latest from the Journal</h2>
                            </div>
                            <a href="#" class="about-link d-none d-md-inline-block">View all <i class="bi bi-arrow-right ms-2"/></a>
                        </div>
                        <!-- Posts list layout grid -->
                        <div class="row">
                            <!-- Post Card 1 -->
                            <div class="col-lg-4 col-md-6 mb-4">
                                <a href="#" class="blog-card text-decoration-none">
                                    <div class="blog-card-img-wrapper">
                                        <img src="/theme_lantero/static/src/img/craftsman_1777447788481.png" alt="Inside the atelier" class="img img-fluid o_we_custom_image"/>
                                    </div>
                                    <span class="blog-meta o_editable">
                                        <span class="blog-category">Atelier</span>
                                        <span>April 14, 2026</span>
                                    </span>
                                    <h3 class="blog-card-title o_editable">Inside the Florence atelier where every LANTERO piece begins</h3>
                                    <p class="blog-card-excerpt o_editable">A morning with the twelve master artisans whose hands shape the collection — from the first sketch to the final polish.</p>
                                    <span class="blog-card-link">Read more <i class="bi bi-arrow-right"/></span>
                                </a>
                            </div>
                            <!-- Post Card 2 -->
                            <div class="col-lg-4 col-md-6 mb-4">
                                <a href="#" class="blog-card text-decoration-none">
                                    <div class="blog-card-img-wrapper">
                                        <img src="/theme_lantero/static/src/img/rings_1777448120321.png" alt="Choosing your ring" class="img img-fluid o_we_custom_image"/>
                                    </div>
                                    <span class="blog-meta o_editable">
                                        <span class="blog-category">Style Guide</span>
                                        <span>April 04, 2026</span>
                                    </span>
                                    <h3 class="blog-card-title o_editable">How to choose a ring that becomes the one you never take off</h3>
                                    <p class="blog-card-excerpt o_editable">Five questions to ask yourself before buying — and why the perfect everyday ring has more to do with you than with the stone.</p>
                                    <span class="blog-card-link">Read more <i class="bi bi-arrow-right"/></span>
                                </a>
                            </div>
                            <!-- Post Card 3 -->
                            <div class="col-lg-4 col-md-6 mb-4">
                                <a href="#" class="blog-card text-decoration-none">
                                    <div class="blog-card-img-wrapper">
                                        <img src="/theme_lantero/static/src/img/product_2_1777448189229.png" alt="Pearl trends" class="img img-fluid o_we_custom_image"/>
                                    </div>
                                    <span class="blog-meta o_editable">
                                        <span class="blog-category">Trends</span>
                                        <span>March 28, 2026</span>
                                    </span>
                                    <h3 class="blog-card-title o_editable">Pearls, reimagined: the new wave of pearl jewelry</h3>
                                    <p class="blog-card-excerpt o_editable">Once your grandmother's signature, pearls are finding a fresh audience. Here's how to wear them now without feeling like a costume.</p>
                                    <span class="blog-card-link">Read more <i class="bi bi-arrow-right"/></span>
                                </a>
                            </div>
                            <!-- Post Card 4 -->
                            <div class="col-lg-4 col-md-6 mb-4">
                                <a href="#" class="blog-card text-decoration-none">
                                    <div class="blog-card-img-wrapper">
                                        <img src="/theme_lantero/static/src/img/necklaces_1777448088430.png" alt="Layering necklaces" class="img img-fluid o_we_custom_image"/>
                                    </div>
                                    <span class="blog-meta o_editable">
                                        <span class="blog-category">Style Guide</span>
                                        <span>March 19, 2026</span>
                                    </span>
                                    <h3 class="blog-card-title o_editable">The art of layering: building a necklace stack that works</h3>
                                    <p class="blog-card-excerpt o_editable">Three lengths, two metals, one simple rule. A short guide to layering that doesn't tangle — literally or visually.</p>
                                    <span class="blog-card-link">Read more <i class="bi bi-arrow-right"/></span>
                                </a>
                            </div>
                            <!-- Post Card 5 -->
                            <div class="col-lg-4 col-md-6 mb-4">
                                <a href="#" class="blog-card text-decoration-none">
                                    <div class="blog-card-img-wrapper">
                                        <img src="/theme_lantero/static/src/img/product_1_1777448174198.png" alt="Caring for jewelry" class="img img-fluid o_we_custom_image"/>
                                    </div>
                                    <span class="blog-meta o_editable">
                                        <span class="blog-category">Care</span>
                                        <span>March 09, 2026</span>
                                    </span>
                                    <h3 class="blog-card-title o_editable">Caring for fine jewelry: simple habits that make pieces last</h3>
                                    <p class="blog-card-excerpt o_editable">A few small rituals — and a few common mistakes to avoid — that will keep your jewelry looking new for decades.</p>
                                    <span class="blog-card-link">Read more <i class="bi bi-arrow-right"/></span>
                                </a>
                            </div>
                            <!-- Post Card 6 -->
                            <div class="col-lg-4 col-md-6 mb-4">
                                <a href="#" class="blog-card text-decoration-none">
                                    <div class="blog-card-img-wrapper">
                                        <img src="/theme_lantero/static/src/img/hero_image_1777447769754.png" alt="Sustainable sourcing" class="img img-fluid o_we_custom_image"/>
                                    </div>
                                    <span class="blog-meta o_editable">
                                        <span class="blog-category">Sustainability</span>
                                        <span>February 26, 2026</span>
                                    </span>
                                    <h3 class="blog-card-title o_editable">Why we trace every gemstone — and how you can ask the right questions</h3>
                                    <p class="blog-card-excerpt o_editable">A look behind the supply chain of fine jewelry, what "ethical" actually means, and the small handful of questions worth asking your jeweler.</p>
                                    <span class="blog-card-link">Read more <i class="bi bi-arrow-right"/></span>
                                </a>
                            </div>
                        </div>
                        <!-- Grid Pagination nav -->
                        <nav class="mt-4" aria-label="Page navigation">e navigation">
                            <ul class="pagination justify-content-center">
                                <li class="page-item disabled">
                                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true"><i class="bi bi-chevron-left"/></a>
                                </li>
                                <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item">
                                    <a class="page-link" href="#"><i class="bi bi-chevron-right"/></a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
</odoo>
