<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inheriting Odoo's default contact view to replace with a tailored Lantero Contact design -->
    <template id="lantero_contact_page" name="Lantero Contact Us"
              inherit_id="website.contactus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Page Header Section -->
                <section class="page-header o_colored_level"
                         data-snippet="theme_lantero.s_contact_header"
                         data-name="Contact Header">
                    <div class="container">
                        <span class="section-subtitle o_editable">We'd Love to Hear From You</span>
                        <h1 class="page-title o_editable">Get in Touch</h1>
                        <p class="page-desc o_editable">Questions about a piece, a custom commission, or after-care for an existing one — reach out and a member of our concierge team will be with you within one business day.</p>
                    </div>
                </section>
                <!-- Contact Form + Showroom Info Section -->
                <section class="contact-section o_colored_level"
                         data-snippet="theme_lantero.s_contact_form"
                         data-name="Contact Form">
                    <div class="container">
                        <div class="row gx-lg-5">
                            <!-- Contact Message form column -->
                            <div class="col-lg-7 mb-5 mb-lg-0 pe-lg-5">
                                <span class="section-subtitle o_editable">Send a Message</span>
                                <h2 class="about-title mb-4 o_editable">Drop us a line</h2>
                                <section class="s_website_form contact-form"
                                         data-vcss="001"
                                         data-snippet="s_website_form">
                                    <div class="container p-0">
                                        <form id="lantero_contactus_form"
                                              action="/website/form/"
                                              method="post"
                                              enctype="multipart/form-data"
                                              class="o_mark_required"
                                              data-mark="*"
                                              data-model_name="mail.mail"
                                              data-success-mode="redirect"
                                              data-success-page="/contactus-thank-you"
                                              data-pre-fill="true">
                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field s_website_form_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="lc_fname">First Name</label>
                                                        <input id="lc_fname" type="text"
                                                               class="form-control s_website_form_input"
                                                               name="name" required=""/>
                                                    </div>
                                                </div>
                                                <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="lc_lname">Last Name</label>
                                                        <input id="lc_lname" type="text"
                                                               class="form-control s_website_form_input"
                                                               name="Last Name"/>
                                                    </div>
                                                </div>
                                                <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                                     data-type="email" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="lc_email">Email</label>
                                                        <input id="lc_email" type="email"
                                                               class="form-control s_website_form_input"
                                                               name="email_from" required=""
                                                               data-fill-with="email"/>
                                                    </div>
                                                </div>
                                                <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="lc_phone">Phone (optional)</label>
                                                        <input id="lc_phone" type="tel"
                                                               class="form-control s_website_form_input"
                                                               name="phone"
                                                               data-fill-with="phone"/>
                                                    </div>
                                                </div>
                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="lc_subject">Subject</label>
                                                        <input id="lc_subject" type="text"
                                                               class="form-control s_website_form_input"
                                                               name="subject" required=""/>
                                                    </div>
                                                </div>
                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required"
                                                     data-type="text" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                        <label for="lc_msg">Message</label>
                                                        <textarea id="lc_msg"
                                                                  class="form-control s_website_form_input"
                                                                  name="description" rows="5" required=""/>
                                                    </div>
                                                </div>
                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_dnone">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <input type="hidden"
                                                               class="form-control s_website_form_input"
                                                               name="email_to"/>
                                                    </div>
                                                </div>
                                                <div class="mb-0 py-2 col-12 s_website_form_submit" data-name="Submit Button">
                                                    <a href="#" role="button"
                                                       class="btn-primary-custom border-0 s_website_form_send">
                                                        <span>Send message</span>
                                                    </a>
                                                    <span id="s_website_form_result"/>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </section>
                            </div>
                            <!-- Showroom details column -->
                            <div class="col-lg-5">
                                <div class="contact-info-block">
                                    <span class="section-subtitle o_editable">Contact</span>
                                    <h3 class="about-title mb-4 o_editable">Visit or call us</h3>
                                    <div class="contact-info-item">
                                        <div class="contact-info-icon"><i class="bi bi-geo-alt"/></div>
                                        <div>
                                            <div class="contact-info-label">Atelier &amp; Showroom</div>
                                            <a href="#" class="contact-info-value o_editable">Via dei Gioiellieri 14<br/>50122 Florence, Italy</a>
                                        </div>
                                    </div>
                                    <div class="contact-info-item">
                                        <div class="contact-info-icon"><i class="bi bi-telephone"/></div>
                                        <div>
                                            <div class="contact-info-label">Phone</div>
                                            <a href="tel:+12345678900" class="contact-info-value o_editable">+1 (234) 567 8900</a>
                                        </div>
                                    </div>
                                    <div class="contact-info-item">
                                        <div class="contact-info-icon"><i class="bi bi-envelope"/></div>
                                        <div>
                                            <div class="contact-info-label">Email</div>
                                            <a href="mailto:hello@lantero.com" class="contact-info-value o_editable">hello@lantero.com</a>
                                        </div>
                                    </div>
                                    <div class="contact-info-item">
                                        <div class="contact-info-icon"><i class="bi bi-clock"/></div>
                                        <div>
                                            <div class="contact-info-label">Hours</div>
                                            <span class="contact-info-value o_editable">Mon – Fri  10:00 – 18:00<br/>Sat  11:00 – 17:00</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- FAQ Section -->
                <section class="contact-faq-section o_colored_level"
                         data-snippet="theme_lantero.s_contact_faq"
                         data-name="Contact FAQ">
                    <div class="container">
                        <div class="text-center mb-5">
                            <span class="section-subtitle o_editable">Quick Answers</span>
                            <h2 class="section-title o_editable">Frequently asked</h2>
                        </div>
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <!-- FAQ Accordion layout container -->
                                <div class="accordion accordion-flush" id="lanteroFaq">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#lf1">Do you offer custom commissions?</button></h2>
                                        <div id="lf1" class="accordion-collapse collapse" data-bs-parent="#lanteroFaq"><div class="accordion-body o_editable">Yes. Our atelier accepts a limited number of bespoke commissions each year. Use the form above with the subject "Custom commission" and our design team will be in touch.</div></div>
                                    </div>
                                    <div class="accordion-item">
                                        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#lf2">What is your return policy?</button></h2>
                                        <div id="lf2" class="accordion-collapse collapse" data-bs-parent="#lanteroFaq"><div class="accordion-body o_editable">Returns are accepted within 30 days of delivery in original, unworn condition. Custom and engraved pieces are final sale.</div></div>
                                    </div>
                                    <div class="accordion-item">
                                        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#lf3">Do you ship internationally?</button></h2>
                                        <div id="lf3" class="accordion-collapse collapse" data-bs-parent="#lanteroFaq"><div class="accordion-body o_editable">We ship to over 40 countries. Complimentary shipping is included on all orders over $200.</div></div>
                                    </div>
                                    <div class="accordion-item">
                                        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#lf4">How do I care for my piece?</button></h2>
                                        <div id="lf4" class="accordion-collapse collapse" data-bs-parent="#lanteroFaq"><div class="accordion-body o_editable">Store each piece in its provided pouch, keep it away from moisture and harsh chemicals, and clean gently with a soft cloth.</div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </xpath>
    </template>
</odoo>
