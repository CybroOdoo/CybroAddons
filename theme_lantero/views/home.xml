<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inheriting Odoo's default homepage view to replace with a tailored design layout -->
    <template id="lantero_home_page" name="Lantero Home Page"
              inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- Hero Banner Section -->
                <section class="hero-section o_colored_level"
                         data-snippet="theme_lantero.s_hero_banner"
                         data-name="Hero Banner">
                    <div class="hero-img-half d-none d-lg-block">
                        <img src="/theme_lantero/static/src/img/hero_image_1777447769754.png"
                             class="img img-fluid o_we_custom_image" alt="Woman wearing jewelry"/>
                    </div>
                    <div class="container z-1">
                        <div class="row">
                            <div class="col-lg-5 py-5 py-lg-0">
                                <h1 class="hero-title o_editable">Shaping the future with beautiful designs</h1>
                                <p class="hero-subtitle o_editable">Our pieces are crafted to inspire and elevate your everyday style, bringing a touch of timeless elegance to every moment.</p>
                                <a href="/shop" class="btn-primary-custom">Shop Collection</a>
                            </div>
                        </div>
                    </div>
                    <div class="d-lg-none w-100 mt-4 z-1">
                        <img src="/theme_lantero/static/src/img/hero_image_1777447769754.png"
                             class="img img-fluid w-100 o_we_custom_image" alt="Woman wearing jewelry"
                             style="height: 400px; object-fit: cover;"/>
                    </div>
                </section>
                <!-- Drag-and-drop structural placeholder slot -->
                <div class="oe_structure oe_empty"/>
                <!-- Features Section (USP indicators) -->
                <section class="features-section o_colored_level"
                         data-snippet="theme_lantero.s_features_section"
                         data-name="Features Section">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-4 mb-4 mb-md-0">
                                <div class="feature-icon"><i class="bi bi-gem"/></div>
                                <h3 class="feature-title o_editable">Curated design</h3>
                                <p class="feature-text o_editable">Hand-picked selections crafted with care.</p>
                            </div>
                            <div class="col-md-4 mb-4 mb-md-0 border-start border-end">
                                <div class="feature-icon"><i class="bi bi-shield-check"/></div>
                                <h3 class="feature-title o_editable">Lifelong Warranty</h3>
                                <p class="feature-text o_editable">We stand behind the quality of our pieces.</p>
                            </div>
                            <div class="col-md-4">
                                <div class="feature-icon"><i class="bi bi-truck"/></div>
                                <h3 class="feature-title o_editable">Free &amp; Fast Shipping</h3>
                                <p class="feature-text o_editable">Enjoy complimentary shipping on all orders.</p>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- About Section (Introductory story) -->
                <section class="about-section o_colored_level"
                         data-snippet="theme_lantero.s_about_section"
                         data-name="About Section">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-5 mb-5 mb-lg-0 pe-lg-5">
                                <h2 class="about-title o_editable">Crafting a true classic through emotional design</h2>
                                <p class="about-text o_editable">At the heart of every piece is a story waiting to be told. We pour passion and meticulous attention to detail into every creation, ensuring that what you wear is more than just jewelry—it's a reflection of your unique journey.</p>
                                <a href="/aboutus" class="about-link">Learn more <i class="bi bi-arrow-right ms-2"/></a>
                            </div>
                            <div class="col-lg-7">
                                <img src="/theme_lantero/static/src/img/craftsman_1777447788481.png"
                                     class="img img-fluid about-img o_we_custom_image" alt="Craftsman at work"/>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Categories Grid (Dynamic Category listing) -->
                <t t-call="theme_lantero.s_categories_grid"/>
                <div class="oe_structure oe_empty"/>
                <!-- Products Carousel (Dynamic Product slider) -->
                <t t-call="theme_lantero.s_products_carousel"/>
                <div class="oe_structure oe_empty"/>
                <!-- Statement Banner (Full width promotional spotlight) -->
                <section class="statement-section o_colored_level"
                         data-snippet="theme_lantero.s_statement_banner"
                         data-name="Statement Banner"
                         style="background-image: url('/theme_lantero/static/src/img/hero_image_1777447769754.png');">
                    <div class="container statement-content">
                        <i class="bi bi-gem statement-icon text-white"/>
                        <span class="statement-subtitle text-white">The Signature Collection</span>
                        <h2 class="statement-title o_editable">Make every look count with stunning statement pieces</h2>
                        <a href="/shop" class="btn-white mt-3">Shop all products</a>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Trends Grid (Dynamic Blog links combined with 2x2 grid) -->
                <t t-call="theme_lantero.s_trends_grid"/>
                <div class="oe_structure oe_empty"/>
                <!-- Testimonial / Quote Section -->
                <section class="testimonial-section o_colored_level"
                         data-snippet="theme_lantero.s_testimonial_section"
                         data-name="Testimonial Section">
                    <div class="container">
                        <i class="bi bi-quote testimonial-icon"/>
                        <p class="testimonial-text o_editable">"We believe everyone deserves to experience the love that comes with giving or receiving a beautiful piece of jewelry."</p>
                        <div class="d-flex flex-column align-items-center">
                            <i class="bi bi-gem text-dark-custom fs-3 mb-2"/>
                            <span class="fw-bold text-dark-custom" style="letter-spacing: 2px;">LANTERO</span>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Instagram Grid Feed Section -->
                <section class="instagram-wrapper o_colored_level"
                         data-snippet="theme_lantero.s_instagram_feed"
                         data-name="Instagram Feed">
                    <div class="instagram-header">
                        <h4 class="instagram-title text-dark-custom">Follow @lantero on IG</h4>
                        <a href="#" class="instagram-link">View Gallery</a>
                    </div>
                    <div class="instagram-feed">
                        <a href="#" class="instagram-post">
                            <img src="/theme_lantero/static/src/img/hero_image_1777447769754.png" class="img img-fluid o_we_custom_image" alt="Instagram post"/>
                            <div class="instagram-overlay"><i class="bi bi-instagram"/></div>
                        </a>
                        <a href="#" class="instagram-post">
                            <img src="/theme_lantero/static/src/img/product_2_1777448189229.png" class="img img-fluid o_we_custom_image" alt="Instagram post"/>
                            <div class="instagram-overlay"><i class="bi bi-instagram"/></div>
                        </a>
                        <a href="#" class="instagram-post">
                            <img src="/theme_lantero/static/src/img/craftsman_1777447788481.png" class="img img-fluid o_we_custom_image" alt="Instagram post"/>
                            <div class="instagram-overlay"><i class="bi bi-instagram"/></div>
                        </a>
                        <a href="#" class="instagram-post">
                            <img src="/theme_lantero/static/src/img/necklaces_1777448088430.png" class="img img-fluid o_we_custom_image" alt="Instagram post"/>
                            <div class="instagram-overlay"><i class="bi bi-instagram"/></div>
                        </a>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </xpath>
    </template>
</odoo>
