<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- About Page View Template -->
    <template id="lantero_about_page" name="Lantero About Us">
        <t t-call="website.layout">
            <t t-set="additional_title">About</t>
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Page Header Section -->
                <section class="page-header o_colored_level" data-name="Page Header">
                    <div class="container">
                        <span class="section-subtitle o_editable">Our Heritage</span>
                        <h1 class="page-title o_editable">A Legacy of Craft</h1>
                        <p class="page-desc o_editable">For over three decades LANTERO has been crafting jewelry that tells a story — pieces designed to be worn now and treasured for generations to come.</p>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Brand Story Section -->
                <section class="story-section o_colored_level" data-name="Brand Story">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-5">
                                <span class="section-subtitle o_editable">Our Story</span>
                                <h2 class="about-title o_editable">Crafted with intention. Worn with meaning.</h2>
                                <p class="about-text o_editable">LANTERO was founded on a simple belief: jewelry should be more than an accessory. It should mark a moment, carry a memory, and outlast the trends. Every piece we make begins with a single sketch and ends in the hands of a master artisan who has spent decades refining their craft.</p>
                                <p class="about-text o_editable">From our atelier in Florence to your everyday, we obsess over the details so you don't have to.</p>
                                <a href="/shop" class="btn-primary-custom mt-3">Shop the collection</a>
                            </div>
                            <div class="col-lg-6">
                                <img src="/theme_lantero/static/src/img/craftsman_1777447788481.png" alt="Master artisan at work" class="about-img img img-fluid o_we_custom_image"/>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Values Grid Section -->
                <section class="values-section o_colored_level" data-name="Values Section">
                    <div class="container">
                        <span class="section-subtitle o_editable">What We Stand For</span>
                        <h2 class="section-title o_editable">Our Values</h2>
                        <div class="row">
                            <div class="col-md-4 mb-4 mb-md-0">
                                <div class="value-card">
                                    <div class="feature-icon"><i class="bi bi-gem"/></div>
                                    <h3 class="feature-title o_editable">Considered Design</h3>
                                    <p class="feature-text o_editable">Every silhouette is drawn, refined and prototyped until it earns its place in the collection.</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4 mb-md-0">
                                <div class="value-card">
                                    <div class="feature-icon"><i class="bi bi-tree"/></div>
                                    <h3 class="feature-title o_editable">Responsible Sourcing</h3>
                                    <p class="feature-text o_editable">We work only with suppliers who share our standards for ethical mining and traceable gemstones.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="value-card">
                                    <div class="feature-icon"><i class="bi bi-shield-check"/></div>
                                    <h3 class="feature-title o_editable">Built to Last</h3>
                                    <p class="feature-text o_editable">Solid metals, secure settings and a lifetime warranty — because heirlooms shouldn't be disposable.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Atelier & Craftsmanship Section -->
                <section class="story-section o_colored_level" data-name="Craftsmanship">
                    <div class="container">
                        <div class="row align-items-center flex-lg-row-reverse">
                            <div class="col-lg-6 mb-5 mb-lg-0 ps-lg-5">
                                <span class="section-subtitle o_editable">The Atelier</span>
                                <h2 class="about-title o_editable">Where every piece begins.</h2>
                                <p class="about-text o_editable">Our atelier is small by design. Twelve artisans, hand-selected for their precision and patience, make every LANTERO piece from start to finish — from setting the smallest pavé diamond to polishing the final surface.</p>
                                <p class="about-text o_editable">Nothing leaves the bench until it has been quality-checked three times. It's slower. It's harder. And it's the only way we know how to make jewelry worth keeping.</p>
                                <a href="/blog" class="about-link">Read our journal <i class="bi bi-arrow-right ms-2"/></a>
                            </div>
                            <div class="col-lg-6">
                                <img src="/theme_lantero/static/src/img/hero_image_1777447769754.png" alt="Inside the LANTERO atelier" class="about-img img img-fluid o_we_custom_image"/>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Numerical Statistics Section -->
                <section class="stats-section o_colored_level" data-name="Stats Section">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-3 col-6 mb-4 mb-md-0">
                                <div class="stat-number o_editable">30+</div>
                                <div class="stat-label o_editable">Years of Craft</div>
                            </div>
                            <div class="col-md-3 col-6 mb-4 mb-md-0">
                                <div class="stat-number o_editable">12</div>
                                <div class="stat-label o_editable">Master Artisans</div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="stat-number o_editable">40+</div>
                                <div class="stat-label o_editable">Countries Shipped</div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="stat-number o_editable">100%</div>
                                <div class="stat-label o_editable">Ethically Sourced</div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
    <!-- Register the /aboutus page record in Odoo's website pages registry -->
    <record id="lantero_about_page_page" model="theme.website.page">
        <field name="url">/aboutus</field>
        <field name="view_id" ref="lantero_about_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>
