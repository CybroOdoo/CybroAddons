<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Snippet: Lookup Form ── -->
    <!-- Snippet: Lookup Form -->
    <template id="s_track_lookup" name="Track Order Lookup Form">
        <section class="s_track_lookup" data-snippet="theme_lantero.s_track_lookup" data-name="Track Order Lookup Form">
            <div class="container">
                <div class="track-lookup">
                    <h2 class="track-lookup-title o_editable">Find your order</h2>
                    <p class="track-lookup-desc o_editable">Your order number can be found on your confirmation email (e.g. <strong>SO001</strong>).</p>
                    <!-- Form submitting GET request to controllers /track-order route -->
                    <form class="row gy-3 align-items-end s_track_lookup_form" action="/track-order" method="get">
                        <!-- Order Number input field -->
                        <div class="col-md-5">
                            <label for="orderNumber" class="form-label fw-bold fs-sm text-uppercase letter-spacing-1 o_editable">Order number</label>
                            <input type="text" class="form-control" id="orderNumber" name="order_number" placeholder="SO001" required="required" t-att-value="order_number if order_number else None"/>
                        </div>
                        <!-- Email input field -->
                        <div class="col-md-5">
                            <label for="orderEmail" class="form-label fw-bold fs-sm text-uppercase letter-spacing-1 o_editable">Email</label>
                            <input type="email" class="form-control" id="orderEmail" name="email" placeholder="you@example.com" required="required" t-att-value="email if email else None"/>
                        </div>
                        <!-- Submit button action triggering the closest form submit -->
                        <div class="col-md-2">
                            <a href="/track-order" class="track-lookup-btn o_editable_link" onclick="event.preventDefault(); this.closest('form').submit();">Track</a>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </template>
    <!-- Registering the Track Lookup snippet under structure category -->
    <template id="s_track_lookup_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_track_lookup"
               string="Order Lookup Form"
               t-thumbnail="/theme_lantero/static/src/img/fav.png"
               group="lantero_section"/>
        </xpath>
    </template>
</odoo>
