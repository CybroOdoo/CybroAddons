<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Lantero Instagram Feed Snippet (Social proof grid) -->
    <template id="s_instagram_feed" name="Lantero Instagram Feed">
        <section class="instagram-wrapper s_instagram_feed" data-snippet="theme_lantero.s_instagram_feed" data-name="Instagram Feed">
            <!-- Header section with handle and link -->
            <div class="instagram-header">
                <h4 class="instagram-title text-dark-custom">Follow @lantero on IG</h4>
                <a href="#" class="instagram-link">View Gallery</a>
            </div>
            <!-- Grid displaying recent instagram posts with hover overlays -->
            <div class="instagram-feed">
                <a href="#" class="instagram-post">
                    <img src="/theme_lantero/static/src/img/hero_image_1777447769754.png" class="img img-fluid o_we_custom_image" alt="Instagram post"/>
                    <div class="instagram-overlay"><i class="bi bi-instagram"/></div>
                </a>
                <a href="#" class="instagram-post">
                    <img src="/theme_lantero/static/src/img/product_2_1777448189229.png" class="img img-fluid o_we_custom_image" alt="Instagram post"/>
                    <div class="instagram-overlay"><i class="bi bi-instagram"/></div>
                </a>
                <a href="#" class="instagram-post">
                    <img src="/theme_lantero/static/src/img/craftsman_1777447788481.png" class="img img-fluid o_we_custom_image" alt="Instagram post"/>
                    <div class="instagram-overlay"><i class="bi bi-instagram"/></div>
                </a>
                <a href="#" class="instagram-post">
                    <img src="/theme_lantero/static/src/img/necklaces_1777448088430.png" class="img img-fluid o_we_custom_image" alt="Instagram post"/>
                    <div class="instagram-overlay"><i class="bi bi-instagram"/></div>
                </a>
            </div>
        </section>
    </template>
    <!-- Registering the Instagram Feed snippet under structure category -->
    <template id="s_instagram_feed_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_instagram_feed"
               string="Instagram Feed"
               t-thumbnail="/theme_lantero/static/src/img/hero_image_1777447769754.png"
               group="lantero_section"/>
        </xpath>
    </template>
</odoo>
