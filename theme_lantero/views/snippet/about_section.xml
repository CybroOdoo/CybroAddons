<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Lantero About Section Snippet -->
    <template id="s_about_section" name="Lantero About Section">
        <section class="about-section s_about_section" data-snippet="theme_lantero.s_about_section" data-name="About Section">
            <div class="container">
                <div class="row align-items-center">
                    <!-- Left column: Text block and link to about page -->
                    <div class="col-lg-5 mb-5 mb-lg-0 pe-lg-5">
                        <h2 class="about-title o_editable">Crafting a true classic through emotional design</h2>
                        <p class="about-text o_editable">At the heart of every piece is a story waiting to be told. We pour passion and meticulous attention to detail into every creation, ensuring that what you wear is more than just jewelry—it's a reflection of your unique journey.</p>
                        <a href="/aboutus" class="about-link">Learn more <i class="bi bi-arrow-right ms-2"/></a>
                    </div>
                    <!-- Right column: Supporting imagery -->
                    <div class="col-lg-7">
                        <img src="/theme_lantero/static/src/img/craftsman_1777447788481.png" class="img img-fluid about-img o_we_custom_image" alt="Jewelry craftsman at work"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registering the About Section snippet under structure category -->
    <template id="s_about_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_about_section"
               string="About Section"
               t-thumbnail="/theme_lantero/static/src/img/craftsman_1777447788481.png"
               group="lantero_section"/>
        </xpath>
    </template>
</odoo>
