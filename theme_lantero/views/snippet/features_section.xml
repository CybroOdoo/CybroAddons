<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Lantero Features Section Snippet (USP / Key selling points) -->
    <template id="s_features_section" name="Lantero Features Section">
        <section class="features-section s_features_section" data-snippet="theme_lantero.s_features_section" data-name="Features Section">
            <div class="container">
                <div class="row">
                    <!-- Feature item: Curated Design -->
                    <div class="col-md-4 mb-4 mb-md-0">
                        <div class="feature-icon"><i class="bi bi-gem"/></div>
                        <h3 class="feature-title o_editable">Curated design</h3>
                        <p class="feature-text o_editable">Hand-picked selections crafted with care.</p>
                    </div>
                    <!-- Feature item: Lifelong Warranty -->
                    <div class="col-md-4 mb-4 mb-md-0 border-start border-end">
                        <div class="feature-icon"><i class="bi bi-shield-check"/></div>
                        <h3 class="feature-title o_editable">Lifelong Warranty</h3>
                        <p class="feature-text o_editable">We stand behind the quality of our pieces.</p>
                    </div>
                    <!-- Feature item: Free & Fast Shipping -->
                    <div class="col-md-4">
                        <div class="feature-icon"><i class="bi bi-truck"/></div>
                        <h3 class="feature-title o_editable">Free &amp; Fast Shipping</h3>
                        <p class="feature-text o_editable">Enjoy complimentary shipping on all orders.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registering the Features Section snippet under structure category -->
    <template id="s_features_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_features_section"
               string="Features Section"
               t-thumbnail="/theme_lantero/static/src/img/fav.png"
               group="lantero_section"/>
        </xpath>
    </template>
</odoo>
