<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact Page Header Snippet -->
    <template id="s_contact_header" name="Lantero Contact Header">
        <section class="page-header" data-snippet="theme_lantero.s_contact_header" data-name="Contact Header">
            <div class="container">
                <span class="section-subtitle o_editable">We'd Love to Hear From You</span>
                <h1 class="page-title o_editable">Get in Touch</h1>
                <p class="page-desc o_editable">Questions about a piece, a custom commission, or after-care for an existing one — reach out and a member of our concierge team will be with you within one business day.</p>
            </div>
        </section>
    </template>
    <!-- Registering the Contact Header snippet under structure category -->
    <template id="s_contact_header_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_contact_header"
               string="Contact Header"
               t-thumbnail="/theme_lantero/static/src/img/fav.png"
               group="lantero_section"/>
        </xpath>
    </template>
    <!-- Contact Form + Info Snippet -->
    <template id="s_contact_form" name="Lantero Contact Form">
        <section class="contact-section" data-snippet="theme_lantero.s_contact_form" data-name="Contact Form">
            <div class="container">
                <div class="row gx-lg-5">
                    <!-- Left column: Interactive contact form using Odoo's website_form mechanism -->
                    <div class="col-lg-7 mb-5 mb-lg-0 pe-lg-5">
                        <span class="section-subtitle o_editable">Send a Message</span>
                        <h2 class="about-title mb-4 o_editable">Drop us a line</h2>
                        <section class="s_website_form contact-form"
                                 data-vcss="001"
                                 data-snippet="s_website_form">
                            <div class="container p-0">
                                <form id="lantero_contactus_form"
                                      action="/website/form/"
                                      method="post"
                                      enctype="multipart/form-data"
                                      class="o_mark_required"
                                      data-mark="*"
                                      data-model_name="mail.mail"
                                      data-success-mode="redirect"
                                      data-success-page="/contactus-thank-you"
                                      data-pre-fill="true">
                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                        <!-- First Name input field -->
                                        <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field s_website_form_required"
                                             data-type="char" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="lcontact_fname">First Name</label>
                                                <input id="lcontact_fname" type="text"
                                                       class="form-control s_website_form_input"
                                                       name="name" required=""/>
                                            </div>
                                        </div>
                                        <!-- Last Name input field -->
                                        <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field"
                                             data-type="char" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="lcontact_lname">Last Name</label>
                                                <input id="lcontact_lname" type="text"
                                                       class="form-control s_website_form_input"
                                                       name="Last Name"/>
                                            </div>
                                        </div>
                                        <!-- Email input field -->
                                        <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                             data-type="email" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="lcontact_email">Email</label>
                                                <input id="lcontact_email" type="email"
                                                       class="form-control s_website_form_input"
                                                       name="email_from" required=""
                                                       data-fill-with="email"/>
                                            </div>
                                        </div>
                                        <!-- Phone input field -->
                                        <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field"
                                             data-type="char" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="lcontact_phone">Phone (optional)</label>
                                                <input id="lcontact_phone" type="tel"
                                                       class="form-control s_website_form_input"
                                                       name="phone"
                                                       data-fill-with="phone"/>
                                            </div>
                                        </div>
                                        <!-- Subject input field -->
                                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                             data-type="char" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="lcontact_subject">Subject</label>
                                                <input id="lcontact_subject" type="text"
                                                       class="form-control s_website_form_input"
                                                       name="subject" required=""/>
                                            </div>
                                        </div>
                                        <!-- Message textarea field -->
                                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required"
                                             data-type="text" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="lcontact_msg">Message</label>
                                                <textarea id="lcontact_msg"
                                                          class="form-control s_website_form_input"
                                                          name="description" rows="5" required=""/>
                                            </div>
                                        </div>
                                        <!-- Hidden email_to field -->
                                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_dnone">
                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                <input type="hidden"
                                                       class="form-control s_website_form_input"
                                                       name="email_to"/>
                                            </div>
                                        </div>
                                        <!-- Submit button and results container -->
                                        <div class="mb-0 py-2 col-12 s_website_form_submit" data-name="Submit Button">
                                            <a href="#" role="button"
                                               class="btn-primary-custom border-0 s_website_form_send">
                                                <span>Send message</span>
                                            </a>
                                            <span id="s_website_form_result"/>
                                        </div>

                                    </div>
                                </form>
                            </div>
                        </section>
                    </div>
                    <!-- Right column: Showroom location, phone, email, and hours info -->
                    <div class="col-lg-5">
                        <div class="contact-info-block">
                            <span class="section-subtitle o_editable">Contact</span>
                            <h3 class="about-title mb-4 o_editable">Visit or call us</h3>
                            <div class="contact-info-item">
                                <div class="contact-info-icon"><i class="bi bi-geo-alt"/></div>
                                <div>
                                    <div class="contact-info-label">Atelier &amp; Showroom</div>
                                    <a href="#" class="contact-info-value o_editable">Via dei Gioiellieri 14<br/>50122 Florence, Italy</a>
                                </div>
                            </div>
                            <div class="contact-info-item">
                                <div class="contact-info-icon"><i class="bi bi-telephone"/></div>
                                <div>
                                    <div class="contact-info-label">Phone</div>
                                    <a href="tel:+12345678900" class="contact-info-value o_editable">+1 (234) 567 8900</a>
                                </div>
                            </div>
                            <div class="contact-info-item">
                                <div class="contact-info-icon"><i class="bi bi-envelope"/></div>
                                <div>
                                    <div class="contact-info-label">Email</div>
                                    <a href="mailto:hello@lantero.com" class="contact-info-value o_editable">hello@lantero.com</a>
                                </div>
                            </div>
                            <div class="contact-info-item">
                                <div class="contact-info-icon"><i class="bi bi-clock"/></div>
                                <div>
                                    <div class="contact-info-label">Hours</div>
                                    <span class="contact-info-value o_editable">Mon – Fri  10:00 – 18:00<br/>Sat  11:00 – 17:00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registering the Contact Form snippet under structure category -->
    <template id="s_contact_form_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_contact_form"
               string="Contact Form"
               t-thumbnail="/theme_lantero/static/src/img/fav.png"
               group="lantero_section"/>
        </xpath>
    </template>
    <!-- Contact FAQ Snippet -->
    <template id="s_contact_faq" name="Lantero Contact FAQ">
        <section class="contact-faq-section" data-snippet="theme_lantero.s_contact_faq" data-name="Contact FAQ">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="section-subtitle o_editable">Quick Answers</span>
                    <h2 class="section-title o_editable">Frequently asked</h2>
                </div>
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <!-- Accordion for displaying FAQ items clearly -->
                        <div class="accordion accordion-flush" id="lanteroFaqAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#lfaq1">
                                        Do you offer custom commissions?
                                    </button>
                                </h2>
                                <div id="lfaq1" class="accordion-collapse collapse" data-bs-parent="#lanteroFaqAccordion">
                                    <div class="accordion-body o_editable">Yes. Our atelier accepts a limited number of bespoke commissions each year. Use the form above with the subject "Custom commission" and our design team will be in touch.</div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#lfaq2">
                                        What is your return policy?
                                    </button>
                                </h2>
                                <div id="lfaq2" class="accordion-collapse collapse" data-bs-parent="#lanteroFaqAccordion">
                                    <div class="accordion-body o_editable">Returns are accepted within 30 days of delivery in original, unworn condition. Custom and engraved pieces are final sale.</div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#lfaq3">
                                        Do you ship internationally?
                                    </button>
                                </h2>
                                <div id="lfaq3" class="accordion-collapse collapse" data-bs-parent="#lanteroFaqAccordion">
                                    <div class="accordion-body o_editable">We ship to over 40 countries. Complimentary shipping is included on all orders over $200. Duties and taxes are calculated at checkout.</div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#lfaq4">
                                        How do I care for my piece?
                                    </button>
                                </h2>
                                <div id="lfaq4" class="accordion-collapse collapse" data-bs-parent="#lanteroFaqAccordion">
                                    <div class="accordion-body o_editable">Store each piece in its provided pouch, keep it away from moisture and harsh chemicals, and clean gently with a soft cloth. We offer complimentary professional cleaning at our atelier.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registering the Contact FAQ snippet under structure category -->
    <template id="s_contact_faq_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_contact_faq"
               string="Contact FAQ"
               t-thumbnail="/theme_lantero/static/src/img/fav.png"
               group="lantero_section"/>
        </xpath>
    </template>
</odoo>
