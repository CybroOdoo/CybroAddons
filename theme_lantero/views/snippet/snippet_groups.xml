<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inheriting website snippets template to register a custom Lantero snippet group -->
    <template id="lantero_snippet_groups" inherit_id="website.snippets"
              name="Lantero Snippet Groups">
        <!-- Appending the custom Lantero Jewelry snippet group after the last group -->
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_lantero/static/src/img/fav.png"
               string="Lantero Jewelry"
               snippet-group="lantero_section"/>
        </xpath>
    </template>
</odoo>
