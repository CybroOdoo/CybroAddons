<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Snippet Groups -->
    <template id="lantero_snippet_groups" inherit_id="website.snippets"
              name="Lantero Snippet Groups" priority="5">
        <xpath expr="//div[@id='snippet_content']" position="after">
            <div id="snippet_lantero" class="o_panel">
                <div class="o_panel_header">Lantero Sections</div>
                <div class="o_panel_body">
                    <!-- Snippets are registered inside this container -->
                </div>
            </div>
        </xpath>
    </template>
</odoo>
