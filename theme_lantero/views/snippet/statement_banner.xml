<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Statement Banner -->
    <template id="s_statement_banner" name="Lantero Statement Banner">
        <section class="statement-section s_statement_banner" data-snippet="theme_lantero.s_statement_banner" data-name="Statement Banner" style="background-image: url('/theme_lantero/static/src/img/hero_image_1777447769754.png');">
            <div class="container statement-content">
                <i class="bi bi-gem statement-icon text-white"/>
                <span class="statement-subtitle text-white">The Signature Collection</span>
                <h2 class="statement-title o_editable">Make every look count with stunning statement pieces</h2>
                <a href="/shop" class="btn-white mt-3">Shop all products</a>
            </div>
        </section>
    </template>
    <!-- Statement Banner Snippet -->
    <template id="s_statement_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_statement_banner"
               string="Statement Banner"
               t-thumbnail="/theme_lantero/static/src/img/hero_image_1777447769754.png"
               group="lantero_section"/>
        </xpath>
    </template>
</odoo>
