<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Lantero Testimonial / Quote Section Snippet -->
    <template id="s_testimonial_section" name="Lantero Testimonial Section">
        <section class="testimonial-section s_testimonial_section" data-snippet="theme_lantero.s_testimonial_section" data-name="Testimonial Section">
            <div class="container">
                <i class="bi bi-quote testimonial-icon"/>
                <p class="testimonial-text o_editable">"We believe everyone deserves to experience the love that comes with giving or receiving a beautiful piece of jewelry."</p>
                <!-- Brand branding info below the quote -->
                <div class="d-flex flex-column align-items-center">
                    <i class="bi bi-gem text-dark-custom fs-3 mb-2"/>
                    <span class="fw-bold text-dark-custom" style="letter-spacing: 2px;">LANTERO</span>
                </div>
            </div>
        </section>
    </template>
    <!-- Registering the Testimonial Section snippet under structure category -->
    <template id="s_testimonial_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_testimonial_section"
               string="Testimonial Section"
               t-thumbnail="/theme_lantero/static/src/img/fav.png"
               group="lantero_section"/>
        </xpath>
    </template>
</odoo>
