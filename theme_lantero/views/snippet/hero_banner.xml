<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Lantero Hero Banner Snippet -->
    <template id="s_hero_banner" name="Lantero Hero Banner">
        <section class="hero-section s_hero_banner" data-snippet="theme_lantero.s_hero_banner" data-name="Hero Banner">
            <!-- Split layout image visible on larger displays -->
            <div class="hero-img-half d-none d-lg-block">
                <img src="/theme_lantero/static/src/img/hero_image_1777447769754.png" class="img img-fluid o_we_custom_image" alt="Woman wearing jewelry"/>
            </div>
            <div class="container z-1">
                <div class="row">
                    <div class="col-lg-5 py-5 py-lg-0">
                        <h1 class="hero-title o_editable">Shaping the future with beautiful designs</h1>
                        <p class="hero-subtitle o_editable">Our pieces are crafted to inspire and elevate your everyday style, bringing a touch of timeless elegance to every moment.</p>
                        <a href="/shop" class="btn-primary-custom">Shop Collection</a>
                    </div>
                </div>
            </div>
            <!-- Alternative layout image visible on mobile devices -->
            <div class="d-lg-none w-100 mt-4 z-1">
                <img src="/theme_lantero/static/src/img/hero_image_1777447769754.png" class="img img-fluid w-100 o_we_custom_image" alt="Woman wearing jewelry" style="height: 400px; object-fit: cover;"/>
            </div>
        </section>
    </template>
    <!-- Registering the Hero Banner snippet in Odoo's snippets menu -->
    <template id="s_hero_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lantero.s_hero_banner"
               string="Hero Banner"
               t-thumbnail="/theme_lantero/static/src/img/hero_image_1777447769754.png"
               group="lantero_section"/>
        </xpath>
    </template>
</odoo>
