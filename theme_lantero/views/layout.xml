<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Google Fonts + Bootstrap Icons (injected into <head>) -->
    <template id="lantero_head_assets"
              inherit_id="website.layout"
              name="Lantero Head Assets">
        <!-- Append external Google Fonts and Bootstrap icons to website head layout -->
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Inter:wght@300;400;500&amp;display=swap"
                  rel="stylesheet"/>
            <link rel="stylesheet"
                  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"/>
        </xpath>
    </template>
    <!-- Custom Header -->
    <template    id="lantero_header"
              inherit_id="website.layout"
              name="Lantero Header">
        <!-- Replace default header with custom premium Lantero navigation header -->
        <xpath expr="//header" position="replace">
            <header id="top" data-anchor="true" data-name="Header" class="o_header_standard">
                <nav class="navbar navbar-expand-lg sticky-top">
                    <div id="o_main_nav" class="container d-flex align-items-center">
                        <!-- Brand (Left) -->
                        <div class="d-flex flex-grow-1 flex-lg-grow-0">
                            <a class="navbar-brand me-lg-5" href="/">LANTERO</a>
                        </div>
                        <!-- Toggler -->
                        <button class="navbar-toggler border-0" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#top_menu_collapse">
                            <span class="navbar-toggler-icon"/>
                        </button>
                        <!-- Menu (Center) -->
                        <div class="collapse navbar-collapse justify-content-center flex-grow-1"
                             id="top_menu_collapse">
                            <t t-call="website.navbar_nav">
                                <t t-set="_nav_class" t-valuef="gap-lg-3"/>
                                <!-- Menu -->
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-call="website.submenu">
                                        <t t-set="item_class" t-valuef="nav-item"/>
                                        <t t-set="link_class" t-valuef="nav-link"/>
                                    </t>
                                </t>
                            </t>
                        </div>
                        <!-- Icons (Right) -->
                        <div class="nav-icons d-none d-lg-flex align-items-center justify-content-end flex-grow-1 flex-lg-grow-0 ms-lg-5">
                            <!-- Shop Cart Link -->
                            <t t-call="website_sale.header_cart_link">
                                <t t-set="_icon" t-value="True"/>
                                <t t-set="_item_class" t-valuef="nav-item"/>
                                <t t-set="_link_class" t-valuef="nav-link"/>
                                <t t-set="_icon_wrap_class" t-valuef="position-relative d-inline-block"/>
                                <t t-set="_badge_class" t-valuef="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark-custom"/>
                            </t>
                            <!-- Shop Wishlist Link -->
                            <t t-call="website_sale_wishlist.header_wishlist_link">
                                <t t-set="_icon" t-value="True"/>
                                <t t-set="_item_class" t-valuef="nav-item ms-3"/>
                                <t t-set="_link_class" t-valuef="nav-link"/>
                                <t t-set="_icon_wrap_class" t-valuef="position-relative d-inline-block"/>
                                <t t-set="_badge_class" t-valuef="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark-custom"/>
                            </t>
                            <!-- User Sign-in portal options -->
                            <t t-call="portal.placeholder_user_sign_in">
                                <t t-set="_link_class" t-valuef="nav-link ms-3"/>
                            </t>
                            <t t-call="portal.user_dropdown">
                                <t t-set="_user_name" t-value="True"/>
                                <t t-set="_item_class" t-value="'nav-item dropdown ms-3'"/>
                                <t t-set="_link_class" t-value="'nav-link'"/>
                            </t>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>
    </template>
    <!-- Custom Footer -->
    <template id="lantero_footer"
              inherit_id="website.layout"
              name="Lantero Footer">
        <!-- Replace default layout footer with a beautiful multi-column links grid and pre-footer newsletter -->
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo" data-name="Footer">
                <!-- Newsletter subscription block -->
                <section class="pre-footer">
                    <div class="container">
                        <div class="newsletter-wrapper text-center">
                            <h3 class="newsletter-title text-dark-custom">Join the Inner Circle</h3>
                            <p class="newsletter-text">Subscribe to receive exclusive offers, new collection previews, and more.</p>
                            <div class="newsletter-form">
                                <div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe"
                                     data-vxml="001"
                                     t-att-data-list-id="request.env.ref('theme_lantero.lantero_inner_circle_list').id"
                                     data-name="Newsletter Form">
                                    <div class="js_subscribed_wrap d-none">
                                        <p class="h5-fs text-success mt-3">
                                            <i class="fa fa-check-circle-o" role="img"/> Thank you for joining the Inner Circle!
                                        </p>
                                    </div>
                                    <div class="js_subscribe_wrap">
                                        <div class="input-group">
                                            <input type="email" name="email"
                                                   class="s_newsletter_subscribe_form_input js_subscribe_value form-control newsletter-input"
                                                   placeholder="Enter your email address"/>
                                            <a role="button" href="#"
                                               class="js_subscribe_btn o_submit btn newsletter-btn">Subscribe</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Main footer site navigation and copyright links -->
                <footer class="footer-main">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 pe-lg-5 mb-5 mb-lg-0">
                                <div class="footer-logo">LANTERO</div>
                                <p class="footer-text">Elevating everyday moments with thoughtfully crafted jewelry designed to last a lifetime.</p>
                                <div class="social-icons">
                                    <a href="#"><i class="bi bi-instagram"/></a>
                                    <a href="#"><i class="bi bi-facebook"/></a>
                                    <a href="#"><i class="bi bi-pinterest"/></a>
                                    <a href="#"><i class="bi bi-twitter-x"/></a>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                                <h5 class="footer-heading">Shop</h5>
                                <ul class="footer-links">
                                    <li><a href="/shop">All Jewelry</a></li>
                                    <li><a href="/shop/category/necklaces-50">Necklaces</a></li>
                                    <li><a href="/shop/category/rings-49">Rings</a></li>
                                    <li><a href="/shop/category/earrings-51">Earrings</a></li>
                                    <li><a href="/shop/category/bracelets-52">Bracelets</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                                <h5 class="footer-heading">About</h5>
                                <ul class="footer-links">
                                    <li><a href="/aboutus">Our Story</a></li>
                                    <li><a href="#">Craftsmanship</a></li>
                                    <li><a href="#">Sustainability</a></li>
                                    <li><a href="/blog">Journal / Blog</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-4 col-md-4">
                                <h5 class="footer-heading">Customer Care</h5>
                                <ul class="footer-links">
                                    <li><a href="/contactus">Contact Us</a></li>
                                    <li><a href="#">Shipping &amp; Returns</a></li>
                                    <li><a href="#">Jewelry Care</a></li>
                                    <li><a href="#">FAQ</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="footer-bottom">
                            <div>© 2026 Lantero Jewelry. All rights reserved.</div>
                            <div class="footer-bottom-links">
                                <a href="#">Privacy Policy</a>
                                <a href="#">Terms of Service</a>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </xpath>
    </template>
    <!-- Remove Odoo Branding -->
    <template id="lantero_no_branding" inherit_id="website.layout" name="Lantero No Branding">
        <!-- Deactivate web brand promotion block -->
        <xpath expr="//t[@t-call='web.brand_promotion']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
