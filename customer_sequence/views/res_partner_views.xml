<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited Partner form for adding the sequence field, shown
         only when the partner is a customer -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.customer.sequence</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="unique_id" invisible="customer_rank &lt;= 0"/>
            </xpath>
        </field>
    </record>

    <!-- Inherited Partner list for adding the sequence field, always
         visible (blank / '/' for non customers) -->
    <record id="view_partner_tree" model="ir.ui.view">
        <field name="name">res.partner.view.tree.inherit.customer.sequence</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="before">
                <field name="unique_id"/>
            </field>
        </field>
    </record>
</odoo>
