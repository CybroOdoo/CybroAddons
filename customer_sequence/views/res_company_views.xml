<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited company form for adding the sequence fields -->
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.customer.sequence</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <!-- Always invisible: only needed so that customer_code
                     below can be made readonly once the sequence exists -->
                <field name="customer_sequence_id" invisible="1"/>
                <field name="prefix"/>
                <!-- Only the starting value: locked once the sequence exists -->
                <field name="customer_code" readonly="customer_sequence_id"/>
                <field name="next_code"/>
            </xpath>
        </field>
    </record>
</odoo>
