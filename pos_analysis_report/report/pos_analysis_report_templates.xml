<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template used for the analysis report -->
    <template id="report_pos_analysis">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="row mt-4 mb-4" id="information">
                    <div t-if="from_date or (data and data.get('from_date'))" class="col-auto col-3 mw-100 mb-2">
                        <strong>Reporting From:</strong>
                        <t t-out="from_date or (data and data.get('from_date'))"/>
                    </div>
                    <div t-if="to_date or (data and data.get('to_date'))" class="col-auto col-3 mw-100 mb-2">
                        <strong>Reporting To:</strong>
                        <t t-out="to_date or (data and data.get('to_date'))"/>
                    </div>
                </div>
                <div class="text-center">
                    <h1>
                        <strong>POS Analysis Report</strong>
                    </h1>
                </div>
                <table class="table table-bordered mt32">
                    <thead>
                        <tr>
                            <th name="sl_no" class="text-start">
                                <span>Sl.No</span>
                            </th>
                            <th name="session"
                                class="text-start">
                                <span>Session</span>
                            </th>
                            <th name="order_ref" class="text-start">
                                <span>Order Ref</span>
                            </th>
                            <th name="rec_ref" class="text-start">
                                <span>Receipt Ref</span>
                            </th>
                            <th name="order_date" class="text-start">
                                <span>Order Date</span>
                            </th>
                            <th name="cust" class="text-start">
                                <span>Customer</span>
                            </th>
                            <th name="taxes" class="text-start">
                                <span>Taxes</span>
                            </th>
                            <th name="subtotal" class="text-start">
                                <span>Subtotal</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="i" t-value="1"/>
                        <t t-foreach="result"
                           t-as="line">
                            <tr>
                                <td>
                                    <span t-out="i"/>
                                </td>
                                <td>
                                    <span t-out="line['session']"/>
                                </td>
                                <td>
                                    <span t-out="line['order_ref']"/>
                                </td>
                                <td>
                                    <span t-out="line['receipt_ref']"/>
                                </td>
                                <td>
                                    <span t-out="line['order_date']"/>
                                </td>
                                <td>
                                    <span t-out="line['customer'] or ''"/>
                                </td>
                                <td>
                                    <span t-out="line['tax']"/>
                                </td>
                                <td>
                                    <span t-out="'%.2f'% line['sub_total']"/>
                                </td>
                            </tr>
                            <t t-set="i" t-value="i+1"/>
                        </t>
                    </tbody>
                </table>
                <div class="row justify-content-end">
                    <div class="col-4">
                        <table class="table table-sm">
                            <tr class="border-black">
                                <td>
                                    <strong>Total</strong>
                                </td>
                                <td class="text-end">
                                    <span t-out="'%.2f'% grant_tot"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
