<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_order_receipt" inherit_id="point_of_sale.pos_order_receipt">
        <xpath expr="//tr[hasclass('payment-line')]" position="after">
            <tr t-if="payment.get('user_payment_reference')" class="payment-reference-line">
                <td colspan="2" class="text-start text-muted ps-2" style="font-size: 0.85em;">
                    Payment Reference: <t t-out="payment['user_payment_reference']"/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>