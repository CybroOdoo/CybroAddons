<?xml version="1.0" encoding="UTF-8"?>
<templates>
<t t-name="pos_reference_for_payment.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <!-- Payment Reference in Order Receipt  -->
        <xpath expr="//div[hasclass('paymentlines')]" position="after">
            <t t-set="paymentRefs" t-value="getPaymentReferences()"/>
            <t t-if="paymentRefs.length">
                <div class="payment-references">
                    <div class="section-separator"/>
                    <t t-foreach="paymentRefs" t-as="ref" t-key="ref_index">
                        <div class="payment-reference-line">
                            <span class="ref-label">Payment Reference:</span>
                            <span class="ref-value">
                                <t t-esc="ref.reference"/>
                            </span>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>