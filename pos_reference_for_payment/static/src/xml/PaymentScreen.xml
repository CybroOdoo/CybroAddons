<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--  Button in Payment Screen -->
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <button t-if="this.pos.config.is_add_pos_payment_reference"
                    class="button btn btn-secondary btn-lg d-flex justify-content-between align-items-center w-100 lh-lg"
                    t-on-click="() => this.clickPaymentReference()">
                <span>
                    <i class="fa fa-credit-card me-2"/>
                    <t t-if="this.selectedPaymentLine and this.selectedPaymentLine.user_payment_reference">
                        Ref: <t t-out="this.selectedPaymentLine.user_payment_reference"/>
                    </t>
                    <t t-else="">Add Payment Reference</t>
                </span>
            </button>
        </xpath>
    </t>
</templates>