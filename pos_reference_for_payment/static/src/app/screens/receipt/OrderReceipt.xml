<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
<!--  Extending receipt template to add payment reference into receipt.-->
    <t t-name="OrderReceipt_name" t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension" owl="1">
       <xpath expr="//div[hasclass('before-footer')]" position="before">
           <t t-if="props.data.payment_reference">
                <div class="pos-receipt-payment-ref">
                    Payment Reference:
                    <span t-esc="props.data.payment_reference"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
