<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherited the form view of res.config.settings and add the Zendesk
         OAuth credentials -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo.zendesk.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="odoo_website_helpdesk.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='odoo_website_helpdesk']" position="inside">
                <block title="Connect Zendesk" id="connect_zendesk_block">
                    <setting string="Connect Zendesk" help="Do you want to connect with Zendesk?">
                        <field name="is_connect_zendesk"/>
                    </setting>
                </block>
                <block title="Zendesk Credentials" id="zendesk_credentials_block"
                       invisible="not is_connect_zendesk">
                    <setting string="Company Domain"
                             help="e.g. mycompany for https://mycompany.zendesk.com">
                        <field name="company_domain" placeholder="mycompany"/>
                    </setting>
                    <setting string="OAuth Client Identifier"
                             help="The 'Identifier' of the OAuth client created in Zendesk Admin Center &gt; Apps and integrations &gt; APIs &gt; OAuth clients">
                        <field name="zendesk_client_id"/>
                    </setting>
                    <setting string="OAuth Client Secret"
                             help="The secret shown when the OAuth client was created">
                        <field name="zendesk_client_secret" password="True"/>
                    </setting>
                    <setting string="OAuth Scope"
                             help="Space separated scopes, e.g. 'read write'">
                        <field name="zendesk_scope" placeholder="read write"/>
                    </setting>
                    <setting id="test_connection_setting">
                        <button name="action_test_connection"
                                type="object"
                                string="Test Connection"
                                class="oe_highlight"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
