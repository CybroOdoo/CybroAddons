<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Record for creating new fields in res configuration settings-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.transfer.in.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="after">
                <block title="Stock Transfer" id="pos_stock_transfer_section">
                    <setting string="Enable Stock Transfer" help="POS users can easily transfer stock directly from the Point of Sale session.">
                        <field name="is_stock_transfer"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>