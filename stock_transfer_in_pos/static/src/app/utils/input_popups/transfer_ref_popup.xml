<?xml version="1.0" encoding="UTF-8"?>
<!--This template is used for showing the success message for the transfer-->
<templates id="template" xml:space="preserve">
    <t t-name="stock_transfer_in_pos.TransferRefPopup">
        <Dialog title="this.props.title" bodyClass="'d-flex flex-column justify-content-center'" size="'sm'">
            <div class="popup popup-text popup-med stock-transfer-popup p-3 text-center">
                <div class="d-flex align-items-center justify-content-center gap-2 my-3 fs-5">
                    <span class="text-muted">Stock Transfer Ref:</span>
                    <a href="#" class="fw-bold text-decoration-none text-primary" role="button" t-on-click.prevent="() => this.openStockTransfer()">
                        <t t-out="this.props.data['name']"/>
                    </a>
                </div>
            </div>
            <t t-set-slot="footer">
                <div class="d-flex flex-grow-1 justify-content-center">
                    <button class="btn btn-primary btn-lg lh-lg o-default-button me-2" tabindex="1" t-on-click="() => this.confirm()">
                        <t t-out="this.props.confirmButtonLabel || 'Confirm'" />
                    </button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>