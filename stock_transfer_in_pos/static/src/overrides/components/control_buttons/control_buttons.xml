<?xml version="1.0" encoding="UTF-8"?>
<!--Inherit ControlButtons template for adding a button for stock transfer-->
<templates id="template" xml:space="preserve">
    <t t-name="stock_transfer_in_pos.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']/div/t[@name='o_pricelist_button']" position="after">
            <t t-if="this.pos.config.stock_transfer" t-call="point_of_sale.controlButton"
                icon="'swap_horiz'"
                btnText.translate="Stock Transfer"
                btnClasses="'btn-secondary'"
                onClick="() => this.clickStockTransfer()">
            </t>
        </xpath>
    </t>
</templates>