<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Defining Fleet Dashboard Action -->
    <record id="fleet_advanced_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">fleet_dashboard_tag</field>
    </record>
    <!-- Adding fleet Dashboard to the CRM Menu -->
    <menuitem name="Dashboard" id="fleet_dashboard_menu"
              parent="fleet.menu_root"
              sequence="0" action="fleet_advanced_dashboard_action"/>

</odoo>
