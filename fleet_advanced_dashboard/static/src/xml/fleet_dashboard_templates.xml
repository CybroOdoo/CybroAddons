<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!--
    Dashboard Template for the Fleet Management module in Odoo.

    This template renders the Fleet Management dashboard, providing visual elements
    and interactive components for users to filter and view data such as vehicles,
    manufacturers, models, odometer readings, service costs, and recurring costs.

    Components:
    - Filter Section: Allows filtering by date range, driver, vehicle model, and manufacturer.
    - Data Cards: Display summarized fleet information with icons representing vehicles, manufacturers, models, odometer, service costs, and contracts.
    - Graphs: Visualize key metrics such as odometer readings, service costs, and recurring costs using charts.
    - Vehicle Status Table: Lists the current status of vehicles along with the number of vehicles in each state.

    Interactive Elements:
    - Date Range, Driver, Vehicle Model, and Manufacturer selection dropdowns for filtering data.
    - Cards with click events for detailed views on vehicles, odometer readings, services, and contracts.

    Style:
    - Custom styles applied with responsive Bootstrap grid layout and cohesive dashboard design.
    -->
    <t t-name="fleet_advanced_dashboard.FleetDashBoard">
        <div class="oh_dashboards p-3">
            <!-- Filter Section -->
            <div class="filter p-3 mb-3 bg-white rounded shadow-sm" t-ref="filters">
                <t t-if="state.flag==1">
                    <div class="inner_select row g-3 align-items-center">
                        <div class="col-12 col-sm-6 col-lg-3 d-flex align-items-center">
                            <label class="form-label me-2 mb-0 text-nowrap fw-semibold" for="date_filter">Date Range:</label>
                            <select class="fleet_select form-select form-select-sm" id="date_filter"
                                    t-on-change="_onchangeFilter">
                                <option value="null">Without Date</option>
                                <option value="10">Last 10 Days</option>
                                <option value="30">Last Month</option>
                                <option value="90">Last 3 Months</option>
                                <option value="365">Last Year</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3 d-flex align-items-center">
                            <label class="form-label me-2 mb-0 text-nowrap fw-semibold" for="driver_selection">Driver:</label>
                            <select class="fleet_select form-select form-select-sm" id="driver_selection"
                                    t-on-change="_onchangeFilter">
                                <option value="null">All Drivers</option>
                                <t t-foreach="state.data.drivers" t-as="driver"
                                   t-key="driver.id">
                                    <option t-esc="driver.name"
                                            t-att-value="driver.id"
                                            t-att-data-id="driver.id"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3 d-flex align-items-center">
                            <label class="form-label me-2 mb-0 text-nowrap fw-semibold" for="vehicle_selection">Vehicle Model:</label>
                            <select class="fleet_select form-select form-select-sm" id="vehicle_selection"
                                    t-on-change="_onchangeFilter">
                                <option value="null">All Vehicles</option>
                                <t t-foreach="state.data.vehicles"
                                   t-as="vehicle" t-key="vehicle.id">
                                    <option t-esc="vehicle.name"
                                            t-att-value="vehicle.id"
                                            t-att-data-id="vehicle.id"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3 d-flex align-items-center">
                            <label class="form-label me-2 mb-0 text-nowrap fw-semibold" for="manufacturers_selection">Manufacturer:</label>
                            <select class="fleet_select form-select form-select-sm"
                                    id="manufacturers_selection"
                                    t-on-change="_onchangeFilter">
                                <option value="null">All Manufacturers</option>
                                <t t-foreach="state.data.manufactures"
                                   t-as="manufacture" t-key="manufacture.id">
                                    <option t-esc="manufacture.name"
                                            t-att-value="manufacture.id"
                                            t-att-data-id="manufacture.id"/>
                                </t>
                            </select>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Main Dashboard Area -->
            <div class="row g-3 align-items-stretch" t-ref="fleet_main">
                <!-- Left Column (KPI cards & Line Chart) -->
                <div class="col-12 col-lg-8 fleet_content d-flex flex-column">
                    <div class="fleet_main flex-grow-1 d-flex flex-column">
                        <!-- Top KPI Cards Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <div class="content_fleet_external fleet_clickable fleet_other_info card h-100"
                                     id="fleet_vehicles"
                                     t-on-click="_onClickVehicles">
                                    <div class="row g-0 h-100">
                                        <div class="col-3 fleet_icon-div">
                                            <i class="fa fa-car"/>
                                        </div>
                                        <div class="col-9 fleet_border-content">
                                            <div class="text-center p-2">
                                                <h6 class="card-title text-uppercase fw-bold mb-1">VEHICLES</h6>
                                                <p class="card-text text-muted mb-0" id="total_vehicles">
                                                    Total Vehicles <t t-esc="state.all_vehicles"/>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="content_fleet_external fleet_clickable fleet_other_info card h-100"
                                     id="fleet_manufacturers"
                                     t-on-click="_onClickManufacturers">
                                    <div class="row g-0 h-100">
                                        <div class="col-3 fleet_icon-div">
                                            <i class="fa fa-industry"/>
                                        </div>
                                        <div class="col-9 fleet_border-content">
                                            <div class="text-center p-2">
                                                <h6 class="card-title text-uppercase fw-bold mb-0">MANUFACTURERS</h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="content_fleet_external fleet_clickable fleet_other_info card h-100"
                                     id="fleet_models"
                                     t-on-click="_onClickModels">
                                    <div class="row g-0 h-100">
                                        <div class="col-3 fleet_icon-div">
                                            <i class="fa fa-cubes"/>
                                        </div>
                                        <div class="col-9 fleet_border-content">
                                            <div class="text-center p-2">
                                                <h6 class="card-title text-uppercase fw-bold mb-0">MODELS</h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Odometer Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <div class="content_fleet_external fleet_clickable fleet_content_main card h-100"
                                     id="fleet_odometer"
                                     t-on-click="_onClickOdoMeter">
                                    <div class="row g-0 h-100">
                                        <div class="col-3 fleet_icon-content"
                                             style="background-color:#71619E;">
                                            <i class="fa fa-tachometer"/>
                                        </div>
                                        <div class="col-9 fleet_border-content">
                                            <div class="text-center p-2">
                                                <h5 class="card-title fw-bold mb-1">Odometer</h5>
                                                <p class="card-text text-muted mb-0 small">
                                                    Shows all odometer values
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-8">
                                <div class="content_fleet_external fleet_clickable card fleet_content_graph h-100 p-2"
                                     t-on-click="_onClickOdoMeter">
                                    <div class="row g-2 align-items-center h-100">
                                        <div class="col-12 col-sm-4 text-primary fleet_content_graph_inner">
                                            <img class="fleet_img_content img-fluid"
                                                 src="/fleet_advanced_dashboard/static/src/img/speedometer.png"
                                                 alt="Odometer"/>
                                        </div>
                                        <div class="col-12 col-sm-4 text-center">
                                            <h6 class="card-title text-primary fleet_content_titles fw-bold mb-1">
                                                Total Odometer Value
                                            </h6>
                                            <h4 class="card-text text-primary fw-bold mb-0"
                                                id="odometer_value">
                                                <t t-esc="state.odometer_value"/>
                                            </h4>
                                        </div>
                                        <div class="col-12 col-sm-4 d-flex justify-content-center">
                                            <section class="fleet_container">
                                                <figure class="chart mb-0"
                                                        data-percent="75">
                                                    <figcaption class="text-primary"
                                                                id="odometer_value2">
                                                        <t t-esc="state.odometer_value"/>
                                                    </figcaption>
                                                    <svg viewBox="0 0 135 135">
                                                        <circle class="outer" cx="67.5" cy="67.5"
                                                                r="55" style="stroke:#71619E;"/>
                                                    </svg>
                                                </figure>
                                            </section>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Service Cost Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <div class="content_fleet_external fleet_clickable fleet_content_main card h-100"
                                     id="fleet_services"
                                     t-on-click="_onClickServices">
                                    <div class="row g-0 h-100">
                                        <div class="col-3 fleet_icon-content"
                                             style="background-color:#28A745;">
                                            <i class="fa fa-wrench"/>
                                        </div>
                                        <div class="col-9 fleet_border-content">
                                            <div class="text-center p-2">
                                                <h5 class="card-title fw-bold mb-1">Service Cost</h5>
                                                <p class="card-text text-muted mb-0 small">
                                                    Show All Service Cost
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-8">
                                <div class="content_fleet_external fleet_clickable card fleet_content_graph h-100 p-2"
                                     t-on-click="_onClickServices">
                                    <div class="row g-2 align-items-center h-100">
                                        <div class="col-12 col-sm-4 text-success fleet_content_graph_inner">
                                            <img class="fleet_img_content img-fluid"
                                                 src="/fleet_advanced_dashboard/static/src/img/tool.png"
                                                 alt="Service"/>
                                        </div>
                                        <div class="col-12 col-sm-4 text-center">
                                            <h6 class="card-title text-success fleet_content_titles fw-bold mb-1">
                                                Total Service Cost
                                            </h6>
                                            <h4 class="card-text text-success fw-bold mb-0"
                                                id="service_value">
                                                <t t-esc="state.service_value"/>
                                            </h4>
                                        </div>
                                        <div class="col-12 col-sm-4 d-flex justify-content-center">
                                            <section class="fleet_container">
                                                <figure class="chart mb-0"
                                                        data-percent="75">
                                                    <figcaption class="text-success"
                                                                id="service_value2">
                                                        <t t-esc="state.service_value"/>
                                                    </figcaption>
                                                    <svg viewBox="0 0 135 135">
                                                        <circle class="outer"
                                                                cx="67.5" cy="67.5"
                                                                r="55" style="stroke:#28A745;"/>
                                                    </svg>
                                                </figure>
                                            </section>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Recurring Cost Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <div class="content_fleet_external fleet_clickable fleet_content_main card h-100"
                                     id="fleet_contracts"
                                     t-on-click="_onClickContracts">
                                    <div class="row g-0 h-100">
                                        <div class="col-3 fleet_icon-content"
                                             style="background-color:#DC3545;">
                                            <i class="fa fa-book"/>
                                        </div>
                                        <div class="col-9 fleet_border-content">
                                            <div class="text-center p-2">
                                                <h5 class="card-title fw-bold mb-1">Recurring Cost</h5>
                                                <p class="card-text text-muted mb-0 small">
                                                    Show All Contracts
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-8">
                                <div class="content_fleet_external fleet_clickable card fleet_content_graph h-100 p-2"
                                     t-on-click="_onClickContracts">
                                    <div class="row g-2 align-items-center h-100">
                                        <div class="col-12 col-sm-4 text-danger fleet_content_graph_inner">
                                            <img class="fleet_img_content img-fluid"
                                                 src="/fleet_advanced_dashboard/static/src/img/recurring.png"
                                                 alt="Recurring"/>
                                        </div>
                                        <div class="col-12 col-sm-4 text-center">
                                            <h6 class="card-title text-danger fleet_content_titles fw-bold mb-1">
                                                Total Recurring Cost
                                            </h6>
                                            <h4 class="card-text text-danger fw-bold mb-0"
                                                id="recurring_value">
                                                <t t-esc="state.recurring_value"/>
                                            </h4>
                                        </div>
                                        <div class="col-12 col-sm-4 d-flex justify-content-center">
                                            <section class="fleet_container">
                                                <figure class="chart mb-0"
                                                        data-percent="75">
                                                    <figcaption
                                                            class="text-danger o_recurring_cost"
                                                            id="recurring_value2">
                                                        <t t-esc="state.recurring_value"/>
                                                    </figcaption>
                                                    <svg viewBox="0 0 135 135">
                                                        <circle class="outer"
                                                                cx="67.5" cy="67.5"
                                                                r="55" style="stroke:#DC3545;"/>
                                                    </svg>
                                                </figure>
                                            </section>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Line Chart -->
                        <div class="row mb-0 flex-grow-1">
                            <div class="col-12">
                                <div id="lineChart"
                                     class="content_fleet_external card w-100 h-100 p-2"
                                     style="min-height: 390px;">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column (Charts & Vehicle Status) -->
                <div class="col-12 col-lg-4 d-flex flex-column">
                    <div class="row g-3 flex-grow-1">
                        <div class="col-12 col-md-6 col-lg-12">
                            <div id="service_Chart"
                                 class="content_fleet_external card w-100 p-2"
                                 style="min-height: 350px;">
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-12">
                            <div id="barChart"
                                 class="content_fleet_external card w-100 p-2"
                                 style="min-height: 350px;">
                            </div>
                        </div>
                        <div class="col-12 flex-grow-1">
                            <div class="content_fleet_external card w-100 h-100 p-3"
                                 style="min-height: 302px;">
                                <h5 class="text-center fw-bold mb-3"
                                    style="color:#0253e8;">Vehicle Status
                                </h5>
                                <div class="table-responsive">
                                    <table id="table_status" class="table table-hover w-100 mb-0">
                                        <tbody>
                                            <t t-foreach="state.fleet_state" t-as="data"
                                               t-key="data.id">
                                                <tr>
                                                    <td class="align-middle">
                                                        <span class="fw-semibold" t-esc="data['state']"/>
                                                    </td>
                                                    <td class="align-middle text-end">
                                                        <span class="fleet-pill"
                                                              t-esc="data['number']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
