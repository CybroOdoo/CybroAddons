<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Builder options panel for the Image Hotspot feature.
        Rendered by the html_builder OWL option system when an <img> is selected.
    -->
    <t t-name="dynamic_image_hotspot.ImageHotspotOption">

        <!-- Toggle On / Off -->
        <BuilderRow label.translate="Image Hotspot">
            <BuilderButtonGroup action="'imageHotspotToggle'">
                <BuilderButton
                    id="'hotspot_off_btn'"
                    title.translate="Off"
                    actionValue="'off'"
                >
                    Off
                </BuilderButton>
                <BuilderButton
                    id="'hotspot_on_btn'"
                    title.translate="On"
                    actionValue="'on'"
                >
                    On
                </BuilderButton>
            </BuilderButtonGroup>
        </BuilderRow>

        <!-- Horizontal position (only visible when hotspot is On) -->
        <BuilderRow
            t-if="this.isActiveItem('hotspot_on_btn')"
            label.translate="Move Horizontal"
            level="1"
        >
            <BuilderRange
                id="'hotspot_range_h'"
                action="'imageHotspotHorizontal'"
                min="5"
                step="5"
                max="95"
            />
        </BuilderRow>

        <!-- Vertical position (only visible when hotspot is On) -->
        <BuilderRow
            t-if="this.isActiveItem('hotspot_on_btn')"
            label.translate="Move Vertical"
            level="1"
        >
            <BuilderRange
                id="'hotspot_range_v'"
                action="'imageHotspotVertical'"
                min="5"
                step="5"
                max="95"
            />
        </BuilderRow>

        <!-- Product link (only visible when hotspot is On) -->
        <BuilderRow
            t-if="this.isActiveItem('hotspot_on_btn')"
            label.translate="Choose Product"
            level="1"
        >
            <BuilderMany2One
                id="'hotspot_product_m2o'"
                action="'imageHotspotProduct'"
                model="'product.template'"
                domain="[['is_published', '=', true]]"
            />
        </BuilderRow>

    </t>

</templates>
