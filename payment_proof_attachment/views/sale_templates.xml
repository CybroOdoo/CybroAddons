<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit sale.sale_order_portal_template View to Modify it -->
    <template id="sale_order_portal_attachment_inherit"
              inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[hasclass('o_download_pdf')]" position="after">
            <div class="my_account_screen">
                <t t-if="sale_order.state != 'sale'">
                    <!-- Modal for My Account Screen -->
                    <div id="myAccountModal" class="payment_proof_modal"
                         style="display:none; position:fixed; z-index:1055; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5);">
                        <div style="background-color:#fff; margin:10% auto; padding:20px; border-radius:8px; width:90%; max-width:500px;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">Upload Transaction Receipt</h5>
                                <span class="close_modal" style="cursor:pointer; font-size:24px;">
                                    <i class="fa fa-times-circle"/>
                                </span>
                            </div>
                            <div class="mb-3">
                                <p class="text-muted">Note: You can attach proof of payments (PNG, JPEG, PDF).</p>
                                <input type="file" name="file"
                                       id="my_account_payment_proof"
                                       multiple="true"
                                       accept="image/png, image/jpeg, application/pdf"
                                       class="form-control"/>
                            </div>
                            <div class="text-end">
                                <button class="btn btn-secondary close_modal me-2">Cancel</button>
                                <button id="payment_proof_update"
                                        class="btn btn-primary"
                                        t-att-value="sale_order.id">Save</button>
                            </div>
                        </div>
                    </div>

                    <div>
                        <button id="btnShowModal" style="width: 100%;"
                                class="btn btn-primary">Save /
                            Update Transaction Receipt
                        </button>
                    </div>
                    <div style="margin-top: 5px;width: 100%;">
                        <button id="btnShowReceipt" class="btn btn-secondary"
                                style="width: 100%;"
                                t-att-value="sale_order.id">Show Updated Receipt
                        </button>
                    </div>
                    <div id="updated_receipt" style="width:100%;display:none">
                        <p style="text-align: end;">
                            <i class="fa fa-refresh" id="refresh_receipt"
                               t-att-value="sale_order.id"
                               style="cursor:pointer;"/>
                        </p>
                        <div id="showing_updated_receipt" style="width:100%;"/>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <template id="sale_order_portal_pay_modal_inherit"
              inherit_id="sale.sale_order_portal_pay_modal">
        <xpath expr="//main[@id='sign-dialog']" position="inside">
            <div class="payment_screen mt-3 p-3 border rounded bg-light">
                <h6 class="fw-bold mb-2">Transaction Receipt</h6>

                <!-- Modal for Payment Screen -->
                <div id="paymentScreenModal" class="payment_proof_modal"
                     style="display:none; position:fixed; z-index:1055; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5);">
                    <div style="background-color:#fff; margin:10% auto; padding:20px; border-radius:8px; width:90%; max-width:500px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Upload Transaction Receipt</h5>
                            <span class="close_payment_modal" style="cursor:pointer; font-size:24px;">
                                <i class="fa fa-times-circle"/>
                            </span>
                        </div>
                        <div class="mb-3">
                            <p class="text-muted">Note: You can attach proof of payments (PNG, JPEG, PDF).</p>
                            <input type="file" name="file"
                                   id="payment_screen_payment_proof"
                                   multiple="true"
                                   accept="image/png, image/jpeg, application/pdf"
                                   class="form-control"/>
                        </div>
                        <div class="text-end">
                            <button class="btn btn-secondary close_payment_modal me-2">Cancel</button>
                            <button id="payment_proof_cart_update"
                                    class="btn btn-primary"
                                    t-att-data-order-id="sale_order.id">Save</button>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <div id="paymentScreenBtnShowModal"
                         class="btn btn-outline-primary"
                         style="cursor:pointer;">
                        <i class="fa fa-upload me-1"/>
                        Upload Transaction Receipt
                    </div>
                    <div id="paymentScreenBtnShowReceipt"
                         class="btn btn-outline-secondary"
                         style="cursor:pointer;"
                         t-att-data-order-id="sale_order.id">
                        <i class="fa fa-eye me-1"/>
                        Show Uploaded Receipts
                    </div>
                </div>
                <div id="payment_screen_updated_receipt" style="display:none" class="mt-3">
                    <div class="d-flex justify-content-end mb-2">
                        <i class="fa fa-refresh btn btn-sm btn-light"
                           id="refresh_payment_receipt"
                           style="cursor:pointer;"
                           t-att-data-order-id="sale_order.id"
                           title="Refresh"/>
                    </div>
                    <div id="payment_screen_showing_updated_receipt"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>