<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compatibility guard for databases where Avatax sale fields are not installed. -->
    <template id="report_saleorder_document_avatax_guard" inherit_id="sale.report_saleorder_document" priority="1000" name="Reflect Sale Order Avatax Guard">
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">'is_avatax' not in doc._fields or not doc.is_avatax</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">'is_avatax' not in doc._fields or not doc.is_avatax</attribute>
        </xpath>
    </template>
</odoo>
