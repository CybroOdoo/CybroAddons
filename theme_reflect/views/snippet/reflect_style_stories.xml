<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Style Stories ── -->
    <template id="s_reflect_style_stories" name="Reflect Style Stories">

        <section class="cmpad">
            <div class="section-padding">
                <span class="section-label">Editorial</span>
                <h2 class="section-title">Style Stories</h2>
                <div class="grid-2">
                    <div class="story-card">
                        <img data-aspect-ratio="4:3"
                             data-query="Group of models in minimal elegant clothing standing together"
                             src="https://storage.googleapis.com/banani-generated-images/generated-images/02224083-c075-457a-9377-f8af91204f6d.jpg"/>
                        <div class="story-content">
                            <h3>Relaxed layers, cleaner details.</h3>
                            <p>
                                Start with denim, add a knit, finish with a structured outer
                                layer. The palette stays quiet so the silhouette does the
                                work.
                            </p>
                            <a href="./products.html" class="btn btn-primary" style="text-decoration:none;">
                                Read Story
                            </a>
                        </div>
                    </div>
                    <div class="story-card">
                        <img data-aspect-ratio="4:3" data-query="Minimalist accessories pouch and jewelry detail shot"
                             src="https://storage.googleapis.com/banani-generated-images/generated-images/d2de5342-49fb-49d9-94f1-7437355928fd.jpg"/>
                        <div class="story-content">Hero
                            <h3>Accessories that complete the look.</h3>
                            <p>
                                Structured bags, tonal footwear, and understated jewelry add
                                polish without pushing the look too far from everyday ease.
                            </p>
                            <a href="./category.html" class="btn btn-primary" style="text-decoration:none;">
                                Shop Accessories
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </template>
</odoo>