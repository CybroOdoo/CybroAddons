<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Snippet Section -->
  <template id="reflect_snippets" inherit_id="website.snippets" name="Reflect Snippets">
    <xpath expr="//snippets[@id='snippet_groups']" position="inside">
      <t snippet-group="reflect" t-snippet="website.s_snippet_group" string="Reflect Theme" t-thumbnail="/theme_reflect/static/img/fav.png"/>
    </xpath>
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
      <t t-snippet="theme_reflect.s_reflect_hero"       string="Reflect Hero"       group="reflect" label="Hero"       t-thumbnail="/theme_reflect/static/img/1.jpg"/>
      <t t-snippet="theme_reflect.s_reflect_categories" string="Reflect Categories" group="reflect" label="Categories" t-thumbnail="/theme_reflect/static/img/2.jpg"/>
      <t t-snippet="theme_reflect.s_reflect_products"   string="Reflect Products"   group="reflect" label="Products"   t-thumbnail="/theme_reflect/static/img/6.jpg"/>
      <t t-snippet="theme_reflect.s_reflect_editorial"  string="Reflect Editorial"  group="reflect" label="Editorial"  t-thumbnail="/theme_reflect/static/img/7.jpg"/>
      <t t-snippet="theme_reflect.s_reflect_features"   string="Reflect Features"   group="reflect" label="Features"   t-thumbnail="/theme_reflect/static/img/fav.png"/>
      <t t-snippet="theme_reflect.s_reflect_newsletter" string="Reflect Newsletter" group="reflect" label="Newsletter" t-thumbnail="/theme_reflect/static/img/3.jpg"/>
      <t t-snippet="theme_reflect.s_reflect_style_stories" string="Reflect Style Stories" group="reflect" label="Stories" t-thumbnail="/theme_reflect/static/img/style_stories.png"/>
      <t t-snippet="theme_reflect.s_reflect_cleaner_shopping" string="Reflect Cleaner Shopping" group="reflect" label="Shopping" t-thumbnail="/theme_reflect/static/img/shopping.png"/>
    </xpath>
  </template>

</odoo>
