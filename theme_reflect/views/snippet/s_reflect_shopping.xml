<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Cleaner Shopping ── -->
    <template id="s_reflect_cleaner_shopping" name="Reflect Cleaner Shopping">
        <section class="s_reflect_cleaner_shopping o_cc o_cc1 cmpad"
                 data-snippet="s_reflect_cleaner_shopping"
                 data-name="Reflect Cleaner Shopping"
                 style="background: #fafafa;">
            <div class="section-padding">
                    <div class="flex-between" style="margin-bottom: 48px; align-items: flex-end">
                        <div>
                            <span class="section-label">Why Reflect</span>
                            <h2 class="section-title" style="margin-bottom: 0">
                                A Cleaner Shopping.
                            </h2>
                        </div>
                        <div style="
                                max-width: 450px;
                                text-align: right;
                                font-size: 15px;
                                color: #666;
                                line-height: 1.5;
                              ">
                            The site stays minimal, but the service details are easy to find
                            and to reduce hesitation around fit, delivery, and quality.
                        </div>
                    </div>
                    <div class="grid-4">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fa fa-truck"/>
                            </div>
                            <h3 class="feature-title">Fast delivery</h3>
                            <p class="feature-desc">
                                Reliable shipping windows with dispatch updates that keep the
                                purchase feeling premium.
                            </p>
                        </div>
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fa fa-exchange"/>
                            </div>
                            <h3 class="feature-title">Easy exchanges</h3>
                            <p class="feature-desc">
                                Try on at home and swap for the right size with a simple returns
                                and exchanges flow.
                            </p>
                        </div>
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fa fa-shield"/>
                            </div>
                            <h3 class="feature-title">Quality promise</h3>
                            <p class="feature-desc">
                                Thoughtful material choices and careful finishing create pieces
                                that stay in rotation.
                            </p>
                        </div>
                        <div class="feature-card">
                            <div class="feature-icon">
                                <i class="fa fa-comment-o"/>
                            </div>
                            <h3 class="feature-title">Style support</h3>
                            <p class="feature-desc">
                                Get sizing notes and outfit suggestions before purchase for a
                                more confident checkout.
                            </p>
                        </div>
                    </div>
            </div>
        </section>
    </template>
</odoo>
