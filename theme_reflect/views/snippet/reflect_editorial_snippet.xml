<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ── Editorial ── -->
    <template id="s_reflect_editorial" name="Reflect Editorial">
        <section class="s_reflect_editorial o_cc o_cc1" data-snippet="s_reflect_editorial" data-name="Reflect Editorial"
                 style="background:#fff; padding:100px 0;">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-7">
                        <div class="position-relative overflow-hidden" style="aspect-ratio:16/9;">
                            <img src="/theme_reflect/static/img/5.jpg" alt="Editorial" class="w-100 h-100"
                                 style="object-fit:cover;"/>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <span class="d-block mb-3 text-uppercase text-muted small fw-bold" style="letter-spacing:1px;">
                            The Collection
                        </span>
                        <h2 class="display-5 fw-bold mb-4" style="letter-spacing:-1px;">A quieter way to dress.</h2>
                        <p class="fs-5 text-muted mb-5" style="line-height:1.6;">We believe in the longevity of style.
                            Pieces that speak softly but say everything about the person wearing them. Quality over
                            volume, always.
                        </p>
                        <a href="/shop" class="btn btn-dark px-5 py-3 rounded-0 text-uppercase fw-bold"
                           style="font-size:13px; letter-spacing:1px;">Read the Journal
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
