<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Hero ── -->
    <template id="s_reflect_hero" name="Reflect Hero">
        <section class="s_reflect_hero o_cc o_cc1" data-snippet="s_reflect_hero" data-name="Reflect Hero"
                 style="background:#f7f7f7; padding: 40px 0;">
            <div class="container">
                <div class="row g-0 bg-white overflow-hidden shadow-sm" style="min-height: 700px;">
                    <!-- Content Side -->
                    <div class="col-lg-6 d-flex flex-column justify-content-between order-2 order-lg-1">
                        <div class="p-4 p-md-5 p-xl-6">
                            <span class="d-block mb-3 text-uppercase fw-bold text-dark"
                                  style="font-size:13px; letter-spacing:1px;">Spring / Summer 2026
                            </span>
                            <h1 class="display-3 fw-medium mb-4 text-dark"
                                style="letter-spacing:-2px; line-height: 1.1;">Wear the mood<br
                                    class="d-none d-md-block"/>you want to keep.
                            </h1>
                            <p class="text-muted mb-5 fs-5" style="max-width:480px; line-height: 1.6;">Minimal
                                silhouettes, elevated fabrics, and everyday essentials designed for a wardrobe that
                                feels polished without trying too hard.
                            </p>
                            <div class="d-flex align-items-center gap-4 flex-wrap">
                                <a href="/shop"
                                   class="btn btn-dark px-4 py-3 fw-medium text-uppercase border-0 rounded-0"
                                   style="font-size: 14px; letter-spacing: 0.5px;">Explore new arrivals
                                </a>
                                <a href="/shop" class="text-dark fw-medium text-decoration-underline"
                                   style="font-size: 14px;">View best sellers
                                </a>
                            </div>
                        </div>

                        <div class="p-4 p-md-5 d-flex gap-4 gap-md-5 flex-wrap border-top">
                            <div>
                                <div class="fs-3 fw-medium text-dark mb-1">240+</div>
                                <div class="text-muted small">Curated pieces
                                    <br class="d-none d-xl-block"/>
                                    this season
                                </div>
                            </div>
                            <div>
                                <div class="fs-3 fw-medium text-dark mb-1">48h</div>
                                <div class="text-muted small">Fast dispatch
                                    <br class="d-none d-xl-block"/>
                                    for top cities
                                </div>
                            </div>
                            <div>
                                <div class="fs-3 fw-medium text-dark mb-1">4.9/5</div>
                                <div class="text-muted small">Average quality
                                    <br class="d-none d-xl-block"/>
                                    rating
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Image Side -->
                    <div class="col-lg-6 position-relative order-1 order-lg-2 overflow-hidden"
                         style="min-height: 500px;">
                        <img src="/theme_reflect/static/img/1.jpg" alt="Hero"
                             class="position-absolute translate-middle-x start-50 w-100 h-100"
                             style="object-fit: cover; top:0;"/>
                        <div class="hero-image-card position-absolute bottom-0 start-0 m-4 p-4 bg-white shadow-lg d-none d-sm-block"
                             style="width: 320px;">
                            <div class="fw-medium text-dark mb-2">New capsule drop</div>
                            <p class="text-muted small mb-0 lh-base">Relaxed tailoring, clean denim, and soft knit
                                layers styled for everyday wear.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
