<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Newsletter ── -->
    <template id="s_reflect_newsletter" name="Reflect Newsletter">
        <section class="s_reflect_newsletter o_cc o_cc1" data-snippet="s_reflect_newsletter"
                 data-name="Reflect Newsletter" style="padding:100px 0; text-align:center; background:#f7f7f7;">
            <div class="container">
                <span style="font-size:13px; text-transform:uppercase; letter-spacing:1px; color:#666; display:block; margin-bottom:16px; font-weight:600;">
                    Join The List
                </span>
                <h2 style="font-size:32px; font-weight:500; margin-bottom:16px; color:#111;">Exclusive access to new
                    drops.
                </h2>
                <p style="font-size:15px; color:#666; line-height:1.5; max-width:550px; margin:0 auto 48px;">Stay close
                    to the collection without the noise. Early access to capsule launches, restocks, and curated outfit
                    edits.
                </p>
                <div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe" data-vxml="001" data-list-id="0"
                     style="max-width:550px; margin:0 auto;">
                    <div class="js_subscribed_wrap d-none">
                        <p class="h4-fs text-center text-success mb-0 py-3">
                            <i class="fa fa-check-circle-o" role="img"/>
                            Thanks for registering!
                        </p>
                    </div>
                    <div class="js_subscribe_wrap" style="display:flex; border:1px solid #e5e5e5; overflow:hidden;">
                        <input type="email" name="email" class="js_subscribe_value"
                               placeholder="Enter your email address"
                               style="flex:1; border:none; padding:18px 24px; font-size:14px; outline:none; background:#fafafa;"/>
                        <button class="js_subscribe_btn o_submit"
                                style="background:#000; color:#fff; border:none; padding:18px 32px; font-size:14px; font-weight:500; cursor:pointer; text-transform: uppercase;">
                            Subscribe
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
