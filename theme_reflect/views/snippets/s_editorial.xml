<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — Editorial Stories Snippet-->
    <template id="s_reflect_editorial" name="Reflect Editorial Card">
        <section class="s_reflect_editorial reflect-bg-cream o_colored_level">
            <div class="reflect-container">
                <span class="reflect-label">Editorial</span>
                <h2 class="reflect-snippet-title" style="margin-bottom: 2.5rem;">Style Stories</h2>
                <div class="reflect-editorial-grid">
                    <!-- Story 1 -->
                    <div class="reflect-story-card">
                        <img src="/theme_reflect/static/src/img/7.jpg"
                             alt="Relaxed layers editorial"
                             loading="lazy"/>
                        <div class="reflect-story-overlay"></div>
                        <div class="reflect-story-content">
                            <h3>Relaxed layers, cleaner details.</h3>
                            <p>
                                Start with denim, add a knit, finish with a structured
                                outer layer. The palette stays quiet so the silhouette
                                does the work.
                            </p>
                            <a href="/blog" class="btn btn-primary">Read Story</a>
                        </div>
                    </div>
                    <!-- Story 2 -->
                    <div class="reflect-story-card">
                        <img src="/theme_reflect/static/src/img/9.jpg"
                             alt="Accessories editorial"
                             loading="lazy"/>
                        <div class="reflect-story-overlay"></div>
                        <div class="reflect-story-content">
                            <h3>Accessories that complete the look.</h3>
                            <p>
                                Structured bags, tonal footwear, and understated
                                jewellery add polish without pushing the look too far
                                from everyday ease.
                            </p>
                            <a href="/shop?categ_id=4" class="btn btn-primary">Shop Accessories</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="s_reflect_editorial_register" inherit_id="website.snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="theme_reflect.s_reflect_editorial"
               t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_editorial.svg"
               string="Reflect Editorial"/>
        </xpath>
    </template>
</odoo>
