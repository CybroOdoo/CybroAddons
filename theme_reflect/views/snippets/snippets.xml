<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — Snippet Editor Registry
         Registers custom snippets in the website builder panel -->
    <template id="snippets" inherit_id="website.snippets" name="Reflect Snippets">
        <!-- Add snippets to the "Content" category -->
        <xpath expr="//div[@id='snippet_content']" position="inside">
            <div class="o_panel_body">
                <!-- Hero Banner -->
                <t t-snippet="theme_reflect.s_reflect_hero"
                   t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_hero.svg"/>
                <!-- Category Grid -->
                <t t-snippet="theme_reflect.s_reflect_category_grid"
                   t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_categories.svg"/>
                <!-- Product Highlight -->
                <t t-snippet="theme_reflect.s_reflect_product_highlight"
                   t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_products.svg"/>
                <!-- Editorial Stories -->
                <t t-snippet="theme_reflect.s_reflect_editorial"
                   t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_editorial.svg"/>
                <!-- Feature / Trust Signals -->
                <t t-snippet="theme_reflect.s_reflect_features"
                   t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_features_1.svg"/>
                <!-- Newsletter -->
                <t t-snippet="theme_reflect.s_reflect_newsletter"
                   t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_newsletter.svg"/>
                <!-- CTA Banner -->
                <t t-snippet="theme_reflect.s_reflect_cta_banner"
                   t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_cta.svg"/>
                <!-- Testimonials -->
                <t t-snippet="theme_reflect.s_reflect_testimonials"
                   t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_testimonals.svg"/>
                <!-- Brand Strip -->
                <t t-snippet="theme_reflect.s_reflect_brand_strip"
                   t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_brands.svg"/>
            </div>
        </xpath>
    </template>

    <!-- ============================================================
         Snippet Options (custom editor controls per snippet)
         ============================================================ -->

    <template id="snippet_options" inherit_id="web_editor.snippet_options">
        <!-- Hero Banner options -->
        <xpath expr="." position="inside">
            <div data-js="ReflectHero" data-selector=".s_reflect_hero">
                <we-select string="Layout">
                    <we-button data-select-class="">Image Right</we-button>
                    <we-button data-select-class="s_reflect_hero_reverse">Image Left</we-button>
                    <we-button data-select-class="s_reflect_hero_full">Full Width</we-button>
                </we-select>
                <we-select string="Content Background">
                    <we-button data-select-class="">White</we-button>
                    <we-button data-select-class="s_reflect_hero_cream">Cream</we-button>
                    <we-button data-select-class="s_reflect_hero_dark">Dark</we-button>
                </we-select>
                <we-checkbox string="Show Stats" data-toggle-class="s_reflect_hero_stats_visible"/>
                <we-checkbox string="Show Info Card" data-toggle-class="s_reflect_hero_card_visible"/>
            </div>
            <!-- Features options -->
            <div data-js="ReflectFeatures" data-selector=".s_reflect_features">
                <we-select string="Columns">
                    <we-button data-select-class="">4 Columns</we-button>
                    <we-button data-select-class="s_reflect_features_3col">3 Columns</we-button>
                    <we-button data-select-class="s_reflect_features_2col">2 Columns</we-button>
                </we-select>
                <we-select string="Background">
                    <we-button data-select-class="">Warm Gray</we-button>
                    <we-button data-select-class="s_reflect_features_white">White</we-button>
                    <we-button data-select-class="s_reflect_features_dark">Dark</we-button>
                </we-select>
            </div>
            <!-- Newsletter options -->
            <div data-js="ReflectNewsletter" data-selector=".s_reflect_newsletter">
                <we-select string="Background">
                    <we-button data-select-class="">White</we-button>
                    <we-button data-select-class="s_reflect_newsletter_cream">Cream</we-button>
                    <we-button data-select-class="s_reflect_newsletter_dark">Dark</we-button>
                </we-select>
            </div>
        </xpath>
    </template>
</odoo>
