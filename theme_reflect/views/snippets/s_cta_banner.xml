<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — CTA Banner Snippet -->
    <template id="s_reflect_cta_banner" name="Reflect CTA Banner">
        <section class="s_reflect_cta_banner o_colored_level" data-name="Reflect CTA Banner" data-snippet="s_reflect_cta_banner">
            <img src="/theme_reflect/static/src/img/1.jpg" class="s_reflect_cta_bg" alt="CTA Background"/>
            <div class="container">
                <div class="s_reflect_cta_content">
                    <span class="reflect-label">Season Drop</span>
                    <h2>Essentials for the modern wardrobe.</h2>
                    <p>Elevated fabrics, minimalist silhouettes, and timeless designs for everyday wear.</p>
                    <a href="/shop" class="btn btn-outline-light">Show Collection</a>
                </div>
            </div>
        </section>
    </template>
</odoo>
