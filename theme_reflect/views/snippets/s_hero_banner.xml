<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template: s_reflect_hero-->
    <template id="s_reflect_hero" name="Reflect Hero Banner">
        <section class="s_reflect_hero o_colored_level" data-name="Reflect Hero Banner" data-snippet="s_reflect_hero">
            <div class="s_reflect_hero_content">
                <div class="s_reflect_hero_text">
                    <span class="s_reflect_hero_label">Spring / Summer 2025</span>
                    <h1 class="s_reflect_hero_title">Wear the mood you want to keep.</h1>
                    <p class="s_reflect_hero_subtitle">
                        Minimal silhouettes, elevated fabrics, and everyday
                        essentials designed for a wardrobe that feels polished
                        without trying too hard.
                    </p>
                    <div class="s_reflect_hero_actions">
                        <a href="/shop" class="btn btn-primary">Explore New Arrivals</a>
                        <a href="/shop" class="btn btn-link">View Best Sellers</a>
                    </div>
                </div>
                <div class="s_reflect_hero_stats">
                    <div class="reflect-stat"><h4>240+</h4><p>Curated pieces<br/>this season</p></div>
                    <div class="reflect-stat"><h4>48h</h4><p>Fast dispatch<br/>top cities</p></div>
                    <div class="reflect-stat"><h4>4.9/5</h4><p>Average fit &amp;<br/>quality rating</p></div>
                </div>
            </div>
            <div class="s_reflect_hero_media">
                <img src="/theme_reflect/static/src/img/1.jpg" alt="Hero fashion image" loading="eager"/>
                <div class="s_reflect_hero_card">
                    <h3>New capsule drop</h3>
                    <p>Relaxed tailoring, clean denim, and soft knit layers styled for everyday wear.</p>
                </div>
            </div>
        </section>
    </template>
</odoo>
