<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — Newsletter Section Snippet -->
    <template id="s_reflect_newsletter" name="Reflect Newsletter">
        <section class="s_reflect_newsletter o_colored_level" data-name="Reflect Newsletter" data-snippet="s_reflect_newsletter">
            <span class="reflect-newsletter-eyebrow">Join The List</span>
            <h2 class="reflect-newsletter-title">
                Exclusive access to new drops.
            </h2>
            <p class="reflect-newsletter-desc">
                Stay close to the collection without the noise. Early access
                to capsule launches, restocks, and curated outfit edits —
                delivered straight to your inbox.
            </p>

            <div class="reflect-newsletter-form">
                <!--
                    The email field is a styled div with contenteditable="true".
                    - Works in both Website Builder edit mode AND public view.
                    - The builder does not intercept contenteditable elements.
                    - JS reads .textContent from this div on subscribe click.
                    - data-placeholder drives the CSS ::before placeholder text.
                -->
                <div class="reflect-newsletter-input"
                     contenteditable="true"
                     data-placeholder="Enter your email address"
                     aria-label="Email address"
                     role="textbox"/>

                <!--
                    The button uses o_not_editable so the builder treats it as
                    a non-text node (prevents the builder from turning it into
                    an inline text editor). The JS widget attaches a native
                    addEventListener directly so it fires regardless of builder
                    event interception.
                -->
                <button class="btn btn-primary reflect-newsletter-btn o_not_editable" type="button">
                    Subscribe
                </button>
            </div>
            <!-- Feedback message box — shown/hidden by JS -->
            <div class="reflect-newsletter-msg" style="display:none; margin-top:10px;"></div>
        </section>
    </template>

    <!-- ─── Fallback if mass_mailing isn't installed ─── -->
    <template id="s_reflect_newsletter_standalone" name="Reflect Newsletter (Standalone)">
        <section class="s_reflect_newsletter o_colored_level">
            <span class="reflect-newsletter-eyebrow">Join The List</span>
            <h2 class="reflect-newsletter-title">
                Exclusive access to new drops.
            </h2>
            <p class="reflect-newsletter-desc">
                Stay close to the collection without the noise. Early access
                to capsule launches, restocks, and curated outfit edits.
            </p>
            <div class="reflect-newsletter-form">
                <div class="reflect-newsletter-input"
                     contenteditable="true"
                     data-placeholder="Enter your email address"
                     aria-label="Email address"
                     role="textbox"/>
                <button class="btn btn-primary reflect-newsletter-btn o_not_editable" type="button">
                    Subscribe
                </button>
            </div>
            <div class="reflect-newsletter-msg" style="display:none; margin-top:10px;"></div>
        </section>
    </template>
</odoo>
