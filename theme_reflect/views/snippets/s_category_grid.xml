<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Template: s_reflect_category_grid_content -->
    <template id="s_reflect_category_grid_content" name="Reflect Category Grid Content">
        <div class="reflect-cat-grid">
            <t t-foreach="categories" t-as="cat">
                <a t-att-href="'/shop/category/%s' % slug(cat)" class="reflect-cat-card">
                    <div class="reflect-cat-img">
                        <img t-if="cat.image_1920" t-attf-src="/web/image/product.public.category/#{cat.id}/image_512" class="w-100" t-att-alt="cat.name" style="aspect-ratio: 4/5; object-fit: cover;"/>
                        <img t-else="" src="/theme_reflect/static/src/img/placeholder.jpg" t-att-alt="cat.name" class="w-100" style="aspect-ratio: 4/5; object-fit: cover;"/>
                    </div>
                    <div class="reflect-cat-meta">
                        <span class="reflect-cat-name" t-esc="cat and cat.name"/>
                    </div>
                </a>
            </t>
        </div>
    </template>
    <!-- Template: s_reflect_category_grid -->
    <template id="s_reflect_category_grid" name="Reflect Category Grid">
        <section class="s_reflect_category_grid o_colored_level" data-name="Reflect Category Grid" data-snippet="s_reflect_category_grid">
            <div class="container">
                <div class="reflect-section-header">
                    <h2 class="reflect-section-title">Curated Essentials</h2>
                    <a href="/shop" class="btn btn-outline-dark">View All</a>
                </div>
                <div class="reflect-cat-grid-container o_not_editable">
                    <!-- Dynamic content loaded via JS -->
                    <div class="reflect-cat-grid">
                        <div class="reflect-cat-card">
                            <div class="reflect-cat-img"><img src="/theme_reflect/static/src/img/2.jpg" alt="Women"/></div>
                            <div class="reflect-cat-meta"><div class="reflect-cat-name">Women</div></div>
                        </div>
                        <div class="reflect-cat-card">
                            <div class="reflect-cat-img"><img src="/theme_reflect/static/src/img/3.jpg" alt="Men"/></div>
                            <div class="reflect-cat-meta"><div class="reflect-cat-name">Men</div></div>
                        </div>
                        <div class="reflect-cat-card">
                            <div class="reflect-cat-img"><img src="/theme_reflect/static/src/img/4.jpg" alt="Shoes"/></div>
                            <div class="reflect-cat-meta"><div class="reflect-cat-name">Shoes</div></div>
                        </div>
                        <div class="reflect-cat-card">
                            <div class="reflect-cat-img"><img src="/theme_reflect/static/src/img/5.jpg" alt="Accessories"/></div>
                            <div class="reflect-cat-meta"><div class="reflect-cat-name">Accessories</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
