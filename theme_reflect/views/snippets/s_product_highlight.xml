<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — Product Highlight Snippet -->
    <!-- Public Template for Dynamic Content -->
    <template id="s_reflect_product_highlight_content" name="Reflect Product Highlight Content">
        <div class="reflect-product-grid">
            <t t-foreach="products" t-as="product">
                <div class="reflect-product-card" t-att-data-href="product.website_url">
                    <div class="reflect-product-img position-relative">
                        <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                             t-att-alt="product.name" class="w-100" style="aspect-ratio: 3/4; object-fit: cover;"
                             loading="lazy"/>

                        <!-- Wishlist Button -->
                        <t t-set="in_wish" t-value="products_in_wishlist and product in products_in_wishlist"/>
                        <t t-set="product_variant_id" t-value="product._get_first_possible_variant_id()"/>
                        <a t-att-href="product.website_url" class="reflect-product-cta">Quick Add</a>
                    </div>
                    <div class="reflect-product-info">
                        <a t-att-href="product.website_url" class="reflect-product-name text-decoration-none"
                           t-esc="product and product.name"/>
                        <span class="reflect-product-price" t-esc="product.list_price"
                              t-options="{'widget': 'monetary', 'display_currency': website.pricelist_id.currency_id}"/>
                    </div>
                    <p class="reflect-product-desc" t-if="product and product.description_sale"
                       t-esc="product.description_sale"/>
                </div>
            </t>
        </div>
    </template>

    <template id="s_reflect_product_highlight" name="Reflect Product Highlight">
        <section class="s_reflect_product_highlight reflect-bg-white o_colored_level"
                 data-name="Reflect Product Highlight" data-snippet="s_reflect_product_highlight">
            <div class="reflect-container">
                <span class="reflect-label">Featured Edit</span>
                <h2 class="reflect-snippet-title" style="margin-bottom: 2.5rem;">Best Sellers</h2>

                <div class="reflect-product-highlight-container o_not_editable">
                    <!-- Dynamic content loaded via JS -->
                    <div class="reflect-product-grid">
                        <div class="bg-200" style="aspect-ratio: 3/4;"/>
                        <div class="bg-200" style="aspect-ratio: 3/4;"/>
                        <div class="bg-200" style="aspect-ratio: 3/4;"/>
                        <div class="bg-200" style="aspect-ratio: 3/4;"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
