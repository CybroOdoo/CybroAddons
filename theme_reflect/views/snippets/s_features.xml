<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — Features / Trust Signals Snippet -->
    <template id="s_reflect_features" name="Reflect Features / Trust">
        <section class="s_reflect_features o_colored_level">
            <div class="reflect-container">
                <div class="reflect-features-header">
                    <div>
                        <span class="reflect-label">Why Reflect</span>
                        <h2 class="reflect-snippet-title">A Cleaner Shopping.</h2>
                    </div>
                    <p class="reflect-features-desc">
                        The site stays minimal, but the service details are easy
                        to find — reducing hesitation around fit, delivery, and quality.
                    </p>
                </div>
                <div class="reflect-features-grid">
                    <!-- Feature 1: Fast delivery -->
                    <div class="reflect-feature-card">
                        <div class="reflect-feature-icon">
                            <i class="fa fa-truck" aria-hidden="true"/>
                        </div>
                        <h4>Fast Delivery</h4>
                        <p>
                            Reliable shipping windows with real-time dispatch
                            updates that keep every purchase feeling premium.
                        </p>
                    </div>
                    <!-- Feature 2: Easy exchanges -->
                    <div class="reflect-feature-card">
                        <div class="reflect-feature-icon">
                            <i class="fa fa-refresh" aria-hidden="true"/>
                        </div>
                        <h4>Easy Exchanges</h4>
                        <p>
                            Try on at home and swap for the right size with our
                            simple, no-hassle returns and exchanges flow.
                        </p>
                    </div>
                    <!-- Feature 3: Quality promise -->
                    <div class="reflect-feature-card">
                        <div class="reflect-feature-icon">
                            <i class="fa fa-shield" aria-hidden="true"/>
                        </div>
                        <h4>Quality Promise</h4>
                        <p>
                            Thoughtful material choices and careful finishing
                            create pieces that stay in your rotation for years.
                        </p>
                    </div>
                    <!-- Feature 4: Style support -->
                    <div class="reflect-feature-card">
                        <div class="reflect-feature-icon">
                            <i class="fa fa-comment-o" aria-hidden="true"/>
                        </div>
                        <h4>Style Support</h4>
                        <p>
                            Get sizing notes and outfit suggestions before
                            purchase for a more confident checkout experience.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_reflect_features_register" inherit_id="website.snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="theme_reflect.s_reflect_features"
               t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_features_1.svg"
               string="Reflect Features"/>
        </xpath>
    </template>
</odoo>
