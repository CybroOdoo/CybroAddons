<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — Reflect Brand Marquee-->
    <template id="s_reflect_brand_marquee" name="Reflect Brand Marquee">
        <section class="s_reflect_brand_strip o_colored_level">
            <div class="reflect-marquee-wrapper">
                <div class="reflect-marquee-track">
                    <span>Minimalist</span>
                    <span>Editorial</span>
                    <span>Sustainable</span>
                    <span>Refined</span>
                    <span>Modern</span>
                    <span>Timeless</span>
                    <span>Minimalist</span>
                    <span>Editorial</span>
                    <span>Sustainable</span>
                    <span>Refined</span>
                    <span>Modern</span>
                    <span>Timeless</span>
                </div>
            </div>
        </section>
    </template>
    <template id="s_reflect_brand_marquee_register" inherit_id="website.snippets">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_reflect.s_reflect_brand_marquee"
               t-thumbnail="/theme_reflect/static/src/img/snippets/thumb_brands.svg"
               string="Brand Marquee"/>
        </xpath>
    </template>
</odoo>
