<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — Testimonials Snippet -->
    <template id="s_reflect_testimonials" name="Reflect Testimonials">
        <section class="s_reflect_testimonials o_colored_level" data-name="Reflect Testimonials" data-snippet="s_reflect_testimonials">
            <div class="container">
                <div class="reflect-testimonials-grid">
                    <!-- Testimonial 1 -->
                    <div class="reflect-testimonial-card text-center">
                        <div class="reflect-testimonial-stars">★★★★★</div>
                        <blockquote>"The quality of the linen shirt is exceptional. It fits perfectly and feels like it will last for years."</blockquote>
                        <div class="reflect-testimonial-author">— Sarah J.</div>
                    </div>
                    <!-- Testimonial 2 -->
                    <div class="reflect-testimonial-card text-center">
                        <div class="reflect-testimonial-stars">★★★★★</div>
                        <blockquote>"Minimalist design at its best. I love how everything coordinates so easily."</blockquote>
                        <div class="reflect-testimonial-author">— Michael P.</div>
                    </div>
                    <!-- Testimonial 3 -->
                    <div class="reflect-testimonial-card text-center">
                        <div class="reflect-testimonial-stars">★★★★★</div>
                        <blockquote>"Fast shipping and the packaging was a nice premium touch. Highly recommend."</blockquote>
                        <div class="reflect-testimonial-author">— Emma L.</div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
