<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — Homepage -->
    <record id="reflect_homepage_view" model="ir.ui.view">
        <field name="name">Reflect Home Page</field>
        <field name="type">qweb</field>
        <field name="key">theme_reflect.homepage</field>
        <field name="arch" type="xml">
            <t name="Reflect Homepage" t-name="theme_reflect.homepage">
                <t t-call="website.layout">
                    <t t-set="pageName" t-value="'homepage'"/>
                    <t t-set="main_object" t-value="website"/>
                    <div id="wrap" class="oe_structure">
                        <!-- 1. Hero Banner -->
                        <t t-snippet-call="theme_reflect.s_reflect_hero"/>
                        <!-- 2. Category Grid -->
                        <t t-snippet-call="theme_reflect.s_reflect_category_grid"/>
                        <!-- 3. Best Sellers / Product Highlight -->
                        <t t-snippet-call="theme_reflect.s_reflect_product_highlight"/>
                        <!-- 4. Editorial Stories -->
                        <t t-snippet-call="theme_reflect.s_reflect_editorial"/>
                        <!-- 5. Features / Trust Signals -->
                        <t t-snippet-call="theme_reflect.s_reflect_features"/>
                        <!-- 6. Newsletter -->
                        <t t-snippet-call="theme_reflect.s_reflect_newsletter"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="reflect_homepage" model="website.page">
        <field name="url">/</field>
        <field name="view_id" ref="reflect_homepage_view"/>
        <field name="is_published">True</field>
    </record>
</odoo>
