<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — Homepage-->
    <record id="theme_reflect_homepage_inherit" model="ir.ui.view">
        <field name="name">Theme Reflect Homepage Inherit</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website.homepage"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='wrap']" position="before">
                <div class="oe_structure"/>
            </xpath>
        </field>
    </record>

    <record id="reflect_homepage_view" model="ir.ui.view">
        <field name="name">Reflect Homepage</field>
        <field name="type">qweb</field>
        <field name="key">theme_reflect.reflect_homepage_view</field>
        <field name="arch" type="xml">
            <t t-call="website.layout">
                <div class="oe_structure"/>
                <t t-set="pageName" t-value="'homepage'"/>
                <t t-set="main_object" t-value="website"/>
                <div class="oe_structure"/>
                <div id="wrap" class="oe_structure oe_empty">
                    <!-- 1. Hero Banner -->
                    <t t-snippet="theme_reflect.s_reflect_hero"/>
                    <!-- 2. Category Grid -->
                    <t t-snippet="theme_reflect.s_reflect_category_grid"/>
                    <!-- 3. Best Sellers / Product Highlight -->
                    <t t-snippet="theme_reflect.s_reflect_product_highlight"/>
                    <!-- 4. Editorial Stories -->
                    <t t-snippet="theme_reflect.s_reflect_editorial"/>
                    <!-- 5. Features / Trust Signals -->
                    <t t-snippet="theme_reflect.s_reflect_features"/>
                    <!-- 6. Newsletter -->
                    <t t-snippet="theme_reflect.s_reflect_newsletter"/>
                </div>
            </t>
        </field>
    </record>
    <record id="reflect_homepage" model="website.page" forcecreate="0">
        <field name="name">Homepage</field>
        <field name="is_published">True</field>
        <field name="url">/</field>
        <field name="view_id" ref="reflect_homepage_view"/>
        <field name="is_homepage">True</field>
    </record>
</odoo>
