<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Reflect — About Page-->
    <record id="reflect_about_page_record" model="website.page">
        <field name="name">About Us</field>
        <field name="is_published">True</field>
        <field name="url">/about</field>
        <field name="type">qweb</field>
        <field name="key">theme_reflect.reflect_about_page</field>
        <field name="arch" type="xml">
            <t name="About Us" t-name="theme_reflect.reflect_about_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <!-- Hero Section -->
                        <section class="s_reflect_hero_minimal o_colored_level py-5">
                            <div class="container text-center py-5">
                                <span class="reflect-label">Our Story</span>
                                <h1 class="display-3 reflect-font-serif">Refined by intent.</h1>
                                <p class="lead text-muted mx-auto" style="max-width: 600px;">
                                    We believe in a wardrobe that works harder,
                                    speaks softer, and lasts longer. Every piece
                                    is a reflection of our commitment to
                                    minimalist editorial excellence.
                                </p>
                            </div>
                        </section>
                        <!-- Story Section -->
                        <section class="s_reflect_editorial_text o_colored_level py-5">
                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-6">
                                        <img src="/theme_reflect/static/src/img/about_story.jpg" class="img-fluid" alt="Reflect Studio"/>
                                    </div>
                                    <div class="col-lg-5 offset-lg-1">
                                        <h2 class="reflect-font-serif mb-4">Less, but better.</h2>
                                        <p>
                                            Launched in 2025, Reflect was born from a desire
                                            to simplify the daily ritual of dressing.
                                        </p>
                                        <p>
                                            Our collections are released in small, curated
                                            capsules designed to be layered and loved for
                                            years, not weeks.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <t t-snippet-call="theme_reflect.s_reflect_features"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
