<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="reflect_homepage" inherit_id="website.homepage" name="Reflect Home" priority="100">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- ══════════════════════════════════════════
                     HERO
                ══════════════════════════════════════════ -->
                <section class="s_reflect_hero o_cc o_cc1" data-snippet="s_reflect_hero" data-name="Reflect Hero"
                         style="background:#f7f7f7; padding: 40px 0;">
                    <div class="container">
                        <div class="row g-0 bg-white overflow-hidden shadow-sm" style="min-height:700px;">
                            <!-- Content -->
                            <div class="col-lg-6 d-flex flex-column justify-content-between p-4 p-md-5 p-xl-6">
                                <div>
                                    <span class="d-block mb-3 text-uppercase fw-bold text-dark"
                                          style="font-size:13px; letter-spacing:1px;">Spring / Summer 2026
                                    </span>
                                    <h1 class="display-3 fw-medium mb-4 text-dark"
                                        style="letter-spacing:-2px; line-height: 1.1;">Wear the mood<br
                                            class="d-none d-md-block"/>you want to keep.
                                    </h1>
                                    <p class="text-muted mb-5 fs-5" style="max-width:480px; line-height: 1.6;">Minimal
                                        silhouettes, elevated fabrics, and everyday essentials designed for a wardrobe
                                        that feels polished without trying too hard.
                                    </p>
                                    <div class="d-flex align-items-center gap-4 flex-wrap">
                                        <a href="/shop"
                                           class="btn btn-dark px-4 py-3 fw-medium text-uppercase border-0 rounded-0"
                                           style="font-size: 14px; letter-spacing: 0.5px;">Explore new arrivals
                                        </a>
                                        <a href="/shop" class="text-dark fw-medium text-decoration-underline"
                                           style="font-size: 14px;">View best sellers
                                        </a>
                                    </div>
                                </div>

                                <div class="d-flex gap-4 gap-md-5 flex-wrap border-top pt-4 mt-auto">
                                    <div>
                                        <div class="fs-3 fw-medium text-dark mb-1">240+</div>
                                        <div class="text-muted small">Curated pieces
                                            <br class="d-none d-xl-block"/>
                                            this season
                                        </div>
                                    </div>
                                    <div>
                                        <div class="fs-3 fw-medium text-dark mb-1">48h</div>
                                        <div class="text-muted small">Fast dispatch
                                            <br class="d-none d-xl-block"/>
                                            for top cities
                                        </div>
                                    </div>
                                    <div>
                                        <div class="fs-3 fw-medium text-dark mb-1">4.9/5</div>
                                        <div class="text-muted small">Average quality
                                            <br class="d-none d-xl-block"/>
                                            rating
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Image -->
                            <div class="col-lg-6 position-relative overflow-hidden" style="min-height: 500px;">
                                <img src="/theme_reflect/static/img/1.jpg" alt="Hero"
                                     class="position-absolute translate-middle-x start-50 w-100 h-100"
                                     style="object-fit: cover; top:0;"/>
                                <div class="hero-image-card position-absolute bottom-0 start-0 m-4 p-4 bg-white shadow-lg d-none d-sm-block"
                                     style="width: 320px;">
                                    <div class="fw-medium text-dark mb-2">New capsule drop</div>
                                    <p class="text-muted small mb-0 lh-base">Relaxed tailoring, clean denim, and soft
                                        knit layers styled for everyday wear.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ══════════════════════════════════════════
                     CATEGORIES
                ══════════════════════════════════════════ -->
                <section class="s_reflect_categories o_cc o_cc1" data-snippet="s_reflect_categories"
                         data-name="Reflect Categories" style="background:#f7f7f7; padding:80px 0;">
                    <div class="container">
                        <t t-set="essential_products"
                           t-value="request.env['product.template'].with_context(website_id=request.website.id).search([('website_published', '=', True), ('sale_ok', '=', True)], limit=3, order='website_sequence asc, id desc')"/>
                        <span class="d-block mb-3 text-uppercase text-muted small fw-bold" style="letter-spacing:1px;">
                            Shop by Category
                        </span>
                        <div class="d-flex justify-content-between align-items-end mb-5 flex-wrap gap-3">
                            <h2 class="display-5 fw-medium m-0" style="letter-spacing:-0.5px;">Curated Essentials</h2>
                            <a href="/shop" class="btn btn-outline-dark px-4 py-2 border-1 rounded-0">View All</a>
                        </div>
                        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-3 g-4">
                            <t t-foreach="essential_products" t-as="product">
                                <t t-set="display_price"
                                   t-value="product.product_variant_id.lst_price or product.list_price"/>
                                <div class="col">
                                    <a t-att-href="product.website_url" class="text-decoration-none d-block">
                                        <div class="cat-img position-relative overflow-hidden mb-3"
                                             style="aspect-ratio:1/1;">
                                            <img t-if="product.image_1920"
                                                 t-att-src="image_data_uri(product.image_1920)"
                                                 t-att-alt="product.name" class="w-100 h-100"
                                                 style="object-fit:cover;"/>
                                            <img t-else="" src="/theme_reflect/static/img/2.jpg"
                                                 t-att-alt="product.name" class="w-100 h-100"
                                                 style="object-fit:cover;"/>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-baseline gap-2">
                                            <h4 class="text-dark fw-bold mb-1" style="font-size:16px;"
                                                t-field="product.name"/>
                                            <span class="text-dark fw-bold small"
                                                  t-esc="display_price"
                                                  t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                        </div>
                                        <p class="text-muted small text-truncate" t-field="product.description_sale"/>
                                    </a>
                                </div>
                            </t>
                            <t t-if="not essential_products">
                                <div class="col">
                                    <a href="/shop" class="text-decoration-none d-block">
                                        <div class="cat-img position-relative overflow-hidden mb-3"
                                             style="aspect-ratio:1/1;">
                                            <img src="/theme_reflect/static/img/2.jpg" alt="Women" class="w-100 h-100"
                                                 style="object-fit:cover;"/>
                                        </div>
                                        <h4 class="text-dark fw-bold mb-1" style="font-size:16px;">Women</h4>
                                        <p class="text-muted small">Elevated daily wear</p>
                                    </a>
                                </div>
                                <div class="col">
                                    <a href="/shop" class="text-decoration-none d-block">
                                        <div class="cat-img position-relative overflow-hidden mb-3"
                                             style="aspect-ratio:1/1;">
                                            <img src="/theme_reflect/static/img/4.jpg" alt="Men" class="w-100 h-100"
                                                 style="object-fit:cover;"/>
                                        </div>
                                        <h4 class="text-dark fw-bold mb-1" style="font-size:16px;">Men</h4>
                                        <p class="text-muted small">Modern silhouettes</p>
                                    </a>
                                </div>
                                <div class="col">
                                    <a href="/shop" class="text-decoration-none d-block">
                                        <div class="cat-img position-relative overflow-hidden mb-3"
                                             style="aspect-ratio:1/1;">
                                            <img src="/theme_reflect/static/img/3.jpg" alt="Accessories"
                                                 class="w-100 h-100" style="object-fit:cover;"/>
                                        </div>
                                        <h4 class="text-dark fw-bold mb-1" style="font-size:16px;">Accessories</h4>
                                        <p class="text-muted small">The finishing touch</p>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- ══════════════════════════════════════════
                     FEATURED EDIT
                ══════════════════════════════════════════ -->
                <section class="s_reflect_editorial o_cc o_cc1" data-snippet="s_reflect_editorial"
                         data-name="Reflect Editorial" style="background:#fff; padding:100px 0;">
                    <div class="container">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-7">
                                <div class="position-relative overflow-hidden" style="aspect-ratio:16/9;">
                                    <img src="/theme_reflect/static/img/5.jpg" alt="Editorial" class="w-100 h-100"
                                         style="object-fit:cover;"/>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <span class="d-block mb-3 text-uppercase text-muted small fw-bold"
                                      style="letter-spacing:1px;">The Collection
                                </span>
                                <h2 class="display-5 fw-bold mb-4" style="letter-spacing:-1px;">A quieter way to
                                    dress.
                                </h2>
                                <p class="fs-5 text-muted mb-5" style="line-height:1.6;">We believe in the longevity of
                                    style. Pieces that speak softly but say everything about the person wearing them.
                                    Quality over volume, always.
                                </p>
                                <a href="/shop" class="btn btn-dark px-5 py-3 rounded-0 text-uppercase fw-bold"
                                   style="font-size:13px; letter-spacing:1px;">Read the Journal
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ══════════════════════════════════════════
                     BEST SELLERS
                ══════════════════════════════════════════ -->
                <section class="s_reflect_products o_cc o_cc1" data-snippet="s_reflect_products"
                         data-name="Reflect Best Sellers" style="background:#fafafa; padding:80px 0;">
                    <div class="container">
                        <t t-set="bestseller_candidates"
                           t-value="request.env['product.template'].with_context(website_id=request.website.id).search([('website_published', '=', True), ('sale_ok', '=', True)], limit=12, order='website_sequence asc, id desc')"/>
                        <t t-set="bestseller_products"
                           t-value="bestseller_candidates.sorted(key=lambda product: product.sales_count, reverse=True)[:3]"/>
                        <span class="d-block mb-3 text-uppercase text-muted small fw-bold" style="letter-spacing:1px;">
                            Featured Edit
                        </span>
                        <h2 class="display-5 fw-medium mb-5" style="letter-spacing:-0.5px;">Best Sellers</h2>
                        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-3 g-4">
                            <t t-foreach="bestseller_products" t-as="product">
                                <t t-set="display_price"
                                   t-value="product.product_variant_id.lst_price or product.list_price"/>
                                <div class="col">
                                    <a t-att-href="product.website_url" class="text-decoration-none d-block">
                                        <div class="product-img position-relative overflow-hidden mb-3"
                                             style="aspect-ratio:3/4;">
                                            <span t-if="product.publish_date"
                                                  class="position-absolute translate-middle-y translate-middle-x top-0 start-0 m-4 badge bg-white text-dark py-2 px-3 fw-bold text-uppercase"
                                                  style="font-size:11px; z-index:2; border-radius:0;">New
                                            </span>
                                            <img t-if="product.image_1920"
                                                 t-att-src="image_data_uri(product.image_1920)"
                                                 t-att-alt="product.name" class="w-100 h-100"
                                                 style="object-fit:cover;"/>
                                            <img t-else="" src="/theme_reflect/static/img/6.jpg"
                                                 t-att-alt="product.name" class="w-100 h-100"
                                                 style="object-fit:cover;"/>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-baseline mb-1 gap-2">
                                            <span class="fw-medium text-dark" t-field="product.name"/>
                                            <span class="fw-bold text-dark"
                                                  t-esc="display_price"
                                                  t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                        </div>
                                        <p class="text-muted small text-truncate" t-field="product.description_sale"/>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <div class="oe_structure"/>
            </div>
        </xpath>
    </template>

</odoo>
