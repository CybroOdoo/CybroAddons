<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Main Categories -->
        <record id="category_accessories" model="product.public.category">
            <field name="name">Accessories</field>
            <field name="website_description" type="html">
                <p class="lead text-muted mx-auto" style="max-width: 600px;">
                    Structured bags, tonal footwear, and understated jewelry to complete your everyday look.
                </p>
            </field>
        </record>

        <record id="category_women" model="product.public.category">
            <field name="name">Women</field>
            <field name="website_description" type="html">
                <p class="lead text-muted mx-auto" style="max-width: 600px;">
                    Minimal silhouettes, elevated fabrics, and everyday essentials designed for the modern woman.
                </p>
            </field>
        </record>

        <record id="category_men" model="product.public.category">
            <field name="name">Men</field>
            <field name="website_description" type="html">
                <p class="lead text-muted mx-auto" style="max-width: 600px;">
                    Refined tailoring and premium casual pieces for a quiet, sophisticated wardrobe.
                </p>
            </field>
        </record>

        <record id="category_shoes" model="product.public.category">
            <field name="name">Shoes</field>
            <field name="website_description" type="html">
                <p class="lead text-muted mx-auto" style="max-width: 600px;">
                    From structured boots to minimal sneakers, footwear that grounds every outfit.
                </p>
            </field>
        </record>
    </data>
</odoo>
