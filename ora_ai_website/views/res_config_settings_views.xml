<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Choose the voice assistant of the shop page in the website settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ora.ai.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Website Assistant" name="website_assistant">
                    <setting id="enable_website_assistant"
                             help="Let the visitors order the products of the shop by voice">
                        <field name="is_website_assistant"/>
                        <div class="mt8" invisible="not is_website_assistant">
                            <field name="website_assistant_id"
                                   required="is_website_assistant"
                                   options="{'no_create': True}"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
