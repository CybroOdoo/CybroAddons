<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Inherit to add the pipedrive reference in product category-->
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.odoo.pipedrive.connector</field>
        <field name="model">product.template</field>
        <field name="priority">5</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_taxes_id']" position="after">
                <field name="pipedrive_reference"/>
            </xpath>
        </field>
    </record>
</odoo>
