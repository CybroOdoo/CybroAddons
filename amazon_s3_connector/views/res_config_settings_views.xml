<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Configure access keys -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.amazon.s3.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="amazon_s3_connector" string="Amazon S3 Cloud Storage"
                         help="Browse and upload files in an Amazon S3 bucket">
                    <field name="is_amazon_connector"/>
                    <div class="content-group" invisible="not is_amazon_connector">
                        <div class="row mt16">
                            <label for="amazon_access_key" class="col-lg-3 o_light_label"/>
                            <field name="amazon_access_key"/>
                        </div>
                        <div class="row mt16">
                            <label for="amazon_secret_key" class="col-lg-3 o_light_label"/>
                            <field name="amazon_secret_key" password="True"/>
                        </div>
                        <div class="row mt16">
                            <label for="amazon_bucket_name" class="col-lg-3 o_light_label"/>
                            <field name="amazon_bucket_name"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
