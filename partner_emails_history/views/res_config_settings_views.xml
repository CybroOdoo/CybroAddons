<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Show Partner History-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.partner.emails.history</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']" position="inside">
                <setting id="partner_history_setting"
                         string="Show History"
                         help="Show the history on the partner form">
                    <field name="is_history"/>
                </setting>
                <setting id="partner_sms_history_setting"
                         string="Show SMS History"
                         help="Show the history of SMS for each partner"
                         invisible="not is_history">
                    <field name="is_sms_history"/>
                </setting>
                <setting id="partner_email_history_setting"
                         string="Show Email History"
                         help="Show the history of sent and received emails for each partner"
                         invisible="not is_history">
                    <field name="is_email_history"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
