<?xml version="1.0" encoding="UTF-8" ?>
<!--Adding new fields to the res.company, related to the watermark with proper layout grouping-->
<odoo>
    <record id="res_company_view_form_inherit_pdf_report_with_watermark" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.pdf.report.with.watermark</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Watermark Configuration" name="watermark_config">
                    <group>
                        <field name="watermark"/>
                        <field name="watermark_type" widget="radio"
                               invisible="not watermark"/>
                        <field name="content_text"
                               invisible="watermark_type in ('image', 'logo') or not watermark"/>
                        <field name="font_size"
                               invisible="watermark_type in ('image', 'logo') or not watermark"/>
                    </group>
                    <group>
                        <field name="color_picker" widget="color"
                               invisible="watermark_type in ('image', 'logo') or not watermark"/>
                        <field name="background_image" widget="image"
                               invisible="watermark_type in ('text', 'logo') or not watermark"/>
                        <field name="rotating_angle"
                               invisible="not watermark"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
