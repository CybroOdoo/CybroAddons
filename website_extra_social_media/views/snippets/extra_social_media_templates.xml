<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template to display extra social media icons on the website -->
    <template id="extra_social_media" name="Extra Social Media">
        <div id="snippet_extra_social_media" class="s_badge s_extra_social_media extra_social_media text-center my-4 o_not_editable" contenteditable="false" data-name="Extra Social Media">
            <h5 class="extra_social_media_title d-none" contenteditable="true">Follow us</h5>
            <div class="extra_social_media_container d-flex flex-wrap justify-content-center gap-2 align-items-center">
                <a href="/website/sm/instagram" class="extra_social_media_instagram d-none" target="_blank" title="Instagram">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_instagram"/>
                </a>
                <a href="/website/sm/whatsapp" class="extra_social_media_whatsapp d-none" target="_blank" title="WhatsApp">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_whatsapp"/>
                </a>
                <a href="/website/sm/github" class="extra_social_media_github d-none" target="_blank" title="GitHub">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_github"/>
                </a>
                <a href="/website/sm/youtube" class="extra_social_media_youtube d-none" target="_blank" title="YouTube">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_youtube-play"/>
                </a>
                <a href="/website/sm/google_plus" class="extra_social_media_google_plus d-none" target="_blank" title="Google+">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_google-plus"/>
                </a>
                <a href="/website/sm/snapchat" class="extra_social_media_snapchat d-none" target="_blank" title="Snapchat">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_snapchat"/>
                </a>
                <a href="/website/sm/flickr" class="extra_social_media_flickr d-none" target="_blank" title="Flickr">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_flickr"/>
                </a>
                <a href="/website/sm/quora" class="extra_social_media_quora d-none" target="_blank" title="Quora">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_quora"/>
                </a>
                <a href="/website/sm/pinterest" class="extra_social_media_pinterest d-none" target="_blank" title="Pinterest">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_pinterest"/>
                </a>
                <a href="/website/sm/dribbble" class="extra_social_media_dribbble d-none" target="_blank" title="Dribbble">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_dribbble"/>
                </a>
                <a href="/website/sm/tumblr" class="extra_social_media_tumblr d-none" target="_blank" title="Tumblr">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="oi_tumblr"/>
                </a>
                <a href="/" class="extra_social_media_home text-800" title="Home">
                    <i class="oi rounded-circle shadow-sm o_editable_media" data-icon="home"/>
                </a>
            </div>
        </div>
    </template>
    <!-- Add snippet into inner content section of the website -->
    <template id="external_snippets" inherit_id="website.snippets" priority="8">
        <xpath expr="//snippets[@id='snippet_content']" position="inside">
            <t t-snippet="website_extra_social_media.extra_social_media"
               string="Extra Social Media"
               t-thumbnail="/website_extra_social_media/static/description/icon.png"/>
        </xpath>
    </template>
</odoo>
