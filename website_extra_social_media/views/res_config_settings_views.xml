<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit res.config.settings to add social media fields -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.extra.social.media</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="after">
                <block title="Social Media" id="add_social_media_settings">
                    <setting>
                        <div class="content-group">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="WhatsApp Number" for="whatsapp_link"/>
                                <field name="whatsapp_link"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="Instagram" for="instagram_link"/>
                                <field name="instagram_link"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="GitHub" for="github_link"/>
                                <field name="github_link"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="YouTube" for="youtube_link"/>
                                <field name="youtube_link"/>
                            </div>
                        </div>
                    </setting>
                    <setting>
                        <div class="content-group">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="Dribbble" for="dribbble_link"/>
                                <field name="dribbble_link"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="Tumblr" for="tumblr_link"/>
                                <field name="tumblr_link"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="Snapchat" for="snapchat_link"/>
                                <field name="snapchat_link"/>
                            </div>
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="Pinterest" for="pinterest_link"/>
                                <field name="pinterest_link"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
