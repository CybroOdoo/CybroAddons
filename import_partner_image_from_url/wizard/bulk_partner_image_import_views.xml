<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <!--  Bulk Partner Image Import view form -->
    <record id="view_bulk_partner_image_import_form" model="ir.ui.view">
        <field name="name">bulk.partner.image.import.form</field>
        <field name="model">bulk.partner.image.import</field>
        <field name="arch" type="xml">

            <form string="Bulk Partner Image Import">

                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="True"/>
                </group>

                <footer>
                    <button string="Import Images"
                            type="object"
                            name="action_import_images"
                            class="btn-primary"/>

                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>

        </field>
    </record>

    <record id="action_bulk_partner_image_import" model="ir.actions.act_window">
        <field name="name">Bulk Partner Image Import</field>
        <field name="res_model">bulk.partner.image.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_bulk_partner_image_import"
        name="Import Partner Images"
        parent="contacts.res_partner_menu_config"
        action="action_bulk_partner_image_import"
        sequence="30"
    />

</odoo>