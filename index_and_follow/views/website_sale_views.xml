<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!--Inherited website_sales product template for adding the is_index check box   -->
    <template id="website_index" inherit_id="website_sale.cta_wrapper" name="Web Index" customize_show="True">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="before">
            <t t-if="user">
                <t t-set="tmpl" t-value="main_object if main_object and main_object._name == 'product.template' else (product.product_tmpl_id if hasattr(product, 'product_tmpl_id') else product)"/>
                <div class="my-2">
                    <input type="checkbox" t-att-checked="tmpl.is_index" id="is_index" class="is_index"/>
                    <span class="ms-1"><b>Is Indexed</b></span><br/>
                    <input type="hidden" class="product" t-att-value="tmpl.id"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
