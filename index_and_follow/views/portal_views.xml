<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!-- Inherited the portal front layout for meta-tag   -->
    <template id="index_follow" inherit_id="portal.frontend_layout" name="Index and Follow">
            <xpath expr="//head/meta[last()]" position="after">
                <t t-if="main_object and main_object._name == 'product.template'">
                    <meta t-if="main_object.is_index" name='robots' content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'/>
                    <meta t-if="not main_object.is_index" name='robots' content="noindex, nofollow"/>
                </t>
            </xpath>
    </template>
</odoo>
