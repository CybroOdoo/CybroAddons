<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!-- Template extension to show Open Form View button only on Many2Many Tag dialogs -->
    <t t-inherit="web.ConfirmationDialog" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('btn')]" position="after">
            <button t-if="this.props.resModel and this.props.recordResId"
                    class="btn btn-secondary"
                    t-att-class="this.props.openFormViewClass"
                    t-on-click="this.openFormView"
                    t-out="this.props.openFormViewLabel">Open Form View
            </button>
        </xpath>
    </t>
</templates>

