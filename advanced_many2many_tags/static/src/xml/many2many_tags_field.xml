<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!--
        Extends ConfirmationDialog template to add a button
        for opening the form view of a many2many record.
    -->
    <t t-name="advanced_many2many_tags.Many2ManyTagsDialog"
       t-inherit="web.ConfirmationDialog" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('btn')]" position="after">
            <button t-attf-class="btn btn-secondary"
                    t-on-click="openFormView">
                <t t-esc="props.openFormViewLabel"/>
            </button>
        </xpath>
    </t>
</templates>

