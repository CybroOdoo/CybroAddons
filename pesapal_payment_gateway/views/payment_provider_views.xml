<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Added pesapal credentials.-->
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.view.form.inherit.pesapal.payment.gateway</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group invisible="code != 'pesapal'">
                    <field name="pesapal_consumer_key"
                           string="Consumer Key"
                           required="code == 'pesapal'"
                           invisible="state == 'disabled'"/>
                    <field name="pesapal_consumer_secret"
                           string="Consumer Secret"
                           invisible="state == 'disabled'"/>
                    <field name="token_request_url" invisible="1"/>
                    <field name="token_register_url" invisible="1"/>
                    <field name="payment_submit_url" invisible="1"/>
                    <field name="payment_status_url" invisible="1"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
