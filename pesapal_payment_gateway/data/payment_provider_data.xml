<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--Pesapal payment provider data-->
        <record id="payment_provider_pesapal" model="payment.provider">
            <field name="name">Pesapal</field>
            <field name="code">pesapal</field>
            <field name="image_128" type="base64"
                   file="pesapal_payment_gateway/static/description/icon.png"/>
            <field name="payment_method_ids"
                   eval="[Command.set([ ref('pesapal_payment_gateway.payment_method_pesapal')])]"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="redirect_form_view_id" ref="redirect_form"/>
        </record>
    </data>
</odoo>
