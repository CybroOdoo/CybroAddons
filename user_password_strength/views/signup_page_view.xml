<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="document_fields" inherit_id="auth_signup.fields">
        <!-- Add progress bar after password field group -->
        <xpath expr="//div[contains(@class, 'field-password')]"
               position="after">
            <div class="pt-2">
                <progress id="progress" value="0" max="100"
                          style="width:100%;color: red;">70
                </progress>
            </div>
        </xpath>
    </template>
</odoo>

