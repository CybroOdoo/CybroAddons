<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    If question_type= upload file then t-call template-->
    <template id="question_page_upload_answer"
              inherit_id="survey.question_container">
        <xpath expr="//div[@role='alert']" position="before">
            <t t-if="question.question_type == 'upload_file'">
                <t t-call="survey_upload_file.multi_upload_file"/>
            </t>
        </xpath>
    </template>
    <!--    Answer View-->
    <template id="multi_upload_file">
        <t t-set="existing_attachments" t-value="answer_lines.value_file_data_ids if answer_lines else False"/>
        <div class="o_survey_upload_container">
            <div class="o_survey_upload_box">
                <div class="o_survey_upload_box_header fw-bold mb-2">Upload Files</div>
                <div class="o_survey_upload_box_body">
                    <input type="file" class="form-control o_survey_upload_file"
                           data-oe-data=""
                           data-oe-file-name=""
                           t-att-data-existing-ids="','.join(str(att.id) for att in existing_attachments) if existing_attachments else ''"
                           t-att-data-question-type="question.question_type"
                           t-att-name="question.id"
                           t-att-multiple="question.upload_multiple_file"
                    />
                </div>
            </div>
            <div class="o_survey_upload_list mt-2" t-att-data-question-id="question.id">
                <t t-if="existing_attachments">
                    <ul class="o_survey_file_list o_survey_existing_files list-unstyled mb-2">
                        <t t-foreach="existing_attachments" t-as="att">
                            <li class="o_survey_file_item o_survey_existing_item d-flex align-items-center justify-content-between p-2 mb-1 border rounded bg-white"
                                t-att-data-existing-id="att.id">
                                <span class="text-truncate me-2">
                                    <i class="fa fa-file text-primary me-2"/>
                                    <a t-attf-href="/web/content/{{ att.id }}?download=true" target="_blank" class="text-decoration-none">
                                        <t t-out="att.name"/>
                                    </a>
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-danger o_survey_remove_existing_btn"
                                        t-att-data-existing-id="att.id" title="Remove file">
                                    <i class="fa fa-trash"/>
                                </button>
                            </li>
                        </t>
                    </ul>
                </t>
            </div>
            <t t-if="question.upload_multiple_file == False">
                <div class="o_survey_upload_note text-muted small mt-1">Note: You can only upload one
                    file.
                </div>
            </t>
            <t t-if="question.upload_multiple_file == True">
                <div class="o_survey_upload_note text-muted small mt-1">Note: You can upload
                    multiple files.
                </div>
            </t>
        </div>
    </template>
    <!--Show the answer in print page if question type = upload file then t-call template-->
    <template id="survey_page_print_upload_answer"
              inherit_id="survey.survey_page_print">
        <xpath expr="//div[hasclass('o_survey_question_error')]"
               position="before">
            <t t-if="question.question_type == 'upload_file'">
                <t t-call="survey_upload_file.multi_upload_answer"/>
            </t>
        </xpath>
    </template>
    <!--Answer Value attachments-->
    <template id="multi_upload_answer">
        <t t-if="answer_lines.value_file_data_ids">
            <div class="mt-2">
                <t t-foreach="answer_lines.value_file_data_ids"
                   t-as="attachment">
                    <a t-attf-href="/web/content/{{ attachment.id }}?download=true" target="_blank" class="d-inline-block text-decoration-none me-3 mb-1">
                        <i class="fa fa-download me-1"/>
                        <t t-out="attachment.name"/>
                    </a>
                </t>
            </div>
        </t>
    </template>
</odoo>
