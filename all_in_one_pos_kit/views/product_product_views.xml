<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the product_product form view to add field -->
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.view.form.inherit.all.in.one.pos.kit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
             <field name="detailed_type" position="after">
                <field name="is_age_restrict"/>
            </field>
            <!-- Define the position to insert the new elements in the view -->
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Barcodes">
                    <field name="product_multi_barcodes">
                        <tree editable="bottom">
                            <field name="multi_barcode"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
