<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--This XML template defines an extension to the 'pos.config' form view in the Odoo system.
      The extension adds additional settings related to the appearance of the point of sale receipt.-->
    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.all.in.one.pos.kit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id"
               ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_settings_container')]"
                   position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="is_qr_code"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="is_qr_code"/>
                        <div class="content-group"
                             id="is_qr_code_pos">
                            Enable to show QRCode on receipt
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="is_invoice_number"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="is_invoice_number"/>
                        <div class="content-group"
                             id="invoice_number_pos">
                            Enable to view invoice number on receipt
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="is_customer_details"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="is_customer_details"/>
                        <div class="content-group"
                             id="warning_text_pos_restaurant">
                            Enable to show customer details on receipt
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box"
                             id="customer_name">
                            <div class="o_setting_left_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <field name="is_customer_name"/>
                            </div>
                            <div class="o_setting_right_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <label for="is_customer_name"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <field name="is_customer_address"/>
                            </div>
                            <div class="o_setting_right_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <label for="is_customer_address"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <field name="is_customer_mobile"/>
                            </div>
                            <div class="o_setting_right_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <label for="is_customer_mobile"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <field name="is_customer_phone"/>
                            </div>
                            <div class="o_setting_right_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <label for="is_customer_phone"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <field name="is_customer_email"/>
                            </div>
                            <div class="o_setting_right_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <label for="is_customer_email"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <field name="is_customer_vat"/>
                            </div>
                            <div class="o_setting_right_pane"
                                 attrs="{'invisible': [('is_customer_details','=',False)]}">
                                <label for="is_customer_vat"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="enable_service_charge"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="enable_service_charge"/>
                        <div class="text-muted">Allow service charges on
                            orders
                        </div>
                        <div class="row"
                             attrs="{'invisible':[('enable_service_charge','=',False)]}">
                            <label for="visibility"
                                   class="col-lg-3 o_light_label"/>
                            <field name="visibility" widget="radio"
                                   options="{'horizontal': true}"
                                   class="o_light_label"
                                   attrs="{'required':[('enable_service_charge','=',True)]}"/>
                        </div>
                        <div class="content-group "
                             attrs="{'invisible':['|',('enable_service_charge','=',False),('visibility','=','session')]}">
                            <div class="row">
                                <label for="global_selection"
                                       class="col-lg-3 o_light_label"/>
                                <field name="global_selection"
                                       widget="radio"
                                       options="{'horizontal': true}"
                                       class="o_light_label"
                                       attrs="{'required':[('enable_service_charge','=',True)]}"/>
                            </div>
                            <div class="row mt16">
                                <label for="global_product_id"
                                       class="col-lg-3 o_light_label"/>
                                <field name="global_product_id"/>
                            </div>
                            <div class="row">
                                <label for="global_charge"
                                       class="col-lg-3 o_light_label"/>
                                <field name="global_charge"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='tip_product']" position="inside">
                <div class="mt8" id="custom_tip_percentage">
                    Mention fixed percentage of tip here
                    <br/>
                    <label string="Fixed Tip(%)" for="custom_tip_percentage"
                           class="o_form_label o_light_label"/>
                    <field name="custom_tip_percentage"/>
                </div>
            </xpath>
            <xpath expr="//div[@id='accounting_section']" position="after">
                <h2>POS Greetings</h2>
                <div class="row mt16 o_settings_container">
                    <div id="message_activation"
                         class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="customer_msg"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="customer_msg"/>
                            <div class="text-muted">Send greetings to
                                customers.
                            </div>
                            <div class="content-group mt16"
                                 attrs="{'invisible': [('customer_msg', '=', False)]}">
                                <div role="alert" class="alert alert-warning">
                                    Create a Twilio account.
                                    <a role="button"
                                       href="https://www.twilio.com/try-twilio"
                                       class="btn btn-link btn-success o_activity_link mr8">
                                        <i class="fa fa-arrow-right"/>
                                        Click Here
                                    </a>
                                </div>
                            </div>
                            <div class="row"
                                 attrs="{'invisible': [('customer_msg', '=', False)]}">
                                <label for="account_sid"
                                       class="col-lg-3 o_light_label"/>
                                <field name="account_sid"/>
                            </div>
                            <div class="row"
                                 attrs="{'invisible': [('customer_msg', '=', False)]}">
                                <label for="auth_token"
                                       class="col-lg-3 o_light_label"/>
                                <field name="auth_token"/>
                            </div>
                            <div class="row"
                                 attrs="{'invisible': [('customer_msg', '=', False)]}">
                                <label for="twilio_number"
                                       class="col-lg-3 o_light_label"/>
                                <field name="twilio_number"/>
                            </div>
                            <div class="row"
                                 attrs="{'invisible': [('customer_msg', '=', False)]}">
                                <label for="sms_body"
                                       class="col-lg-3 o_light_label"/>
                                <field name="sms_body"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <field name="name" position="after">
                <field name="image" widget="image" class="oe_avatar"
                       style="width:76px; height:47px"/>
            </field>
        </field>
    </record>
</odoo>
