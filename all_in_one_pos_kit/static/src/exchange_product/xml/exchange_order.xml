<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="ExchangeOrder">
        <Dialog title="'Exchange Products'" size="'md'">
            <!-- Popup body -->
            <table class="exchange-list table table-bordered mt32">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                    </tr>
                </thead>
                <tbody class="partner-list-contents">
                    <tr t-foreach="this.props.order_line"
                        t-as="line" t-key="line.name">
                        <td t-esc="line.name"/>
                        <td><input class="pos-input" type="number" t-model.number="line.qty"/></td>
                    </tr>
                </tbody>
            </table>
            <!-- Popup footer -->
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm">Exchange</button>
                <button class="btn btn-secondary" t-on-click="cancel">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
