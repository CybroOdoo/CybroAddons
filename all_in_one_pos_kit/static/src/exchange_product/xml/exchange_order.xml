<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="ExchangeOrder" owl="1">
        <!-- ExchangeOrder template -->
        <div class="popup opening-cash-control">
            <!-- Popup title -->
            <div class="exchange-header">
                <h4 class="modal-title title" style="text-align: center;">
                Exchange Products
            </h4>
                </div>
            <!-- Popup body -->
            <main class="body">
                <table class="exchange-list table table-bordered mt32">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <!-- Iterate over the props.line array and display product and quantity inputs -->
                    <tbody class="partner-list-contents">
                        <tr t-foreach="this.props.order_line"
                            t-as="line" t-key="line.name">
                            <td t-esc="line.name"/>
                            <td><input class="pos-input" type="number" t-model.number="line.qty"/></td>
                        </tr>
                    </tbody>
                </table>
            </main>
            <!-- Popup footer -->
            <footer class="footer exchange-button">
                <button class="oe_highlight" t-on-click="confirm">Exchange</button>
                <button class="discard btn btn-lg " t-on-click="cancel">Close</button>
            </footer>
        </div>
    </t>
</templates>
