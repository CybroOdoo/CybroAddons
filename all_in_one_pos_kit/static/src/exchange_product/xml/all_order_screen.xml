<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Displays a custom POS screen listing orders with key details like reference, customer, and date.
    Allows users to view and select orders directly from the POS interface.
-->
<templates id="template" xml:space="preserve">
    <t t-name="CustomOrdrScreen" owl="1">
       <div class="clientlist-screen screen">
           <div class="screen-content">
               <div class="top-content">
                   <button class="discard btn btn-lg btn-light back"
                           t-on-click="back">
                       <span class="search-icon">
                           <i class="fa fa-angle-double-left"/>
                       </span>
                       Back
                   </button>
               </div>
               <section class="full-content">
               </section>
               <br/>
               <section class="full-content">
                    <div class="partner-window">
                        <section class="list">
                            <div class="container">
                                <div class="subwindow-container-fix scrollable-y">
                                    <table class="order-list">
                                        <thead>
                                            <tr>
                                                <th>Order Reference</th>
                                                <th>Receipt Reference</th>
                                                <th>Customer</th>
                                                <th>Order Date</th>
                                            </tr>
                                        </thead>
                                        <tbody class="partner-list-contents">
                                            <tr t-foreach="this.state.orders"
                                                t-as="order" t-key="order.id"
                                                t-att-data-id="order.id"
                                                t-on-click="() => this._onClickOrder(order)">
                                                <td t-esc="order.pos_reference"/>
                                                <td t-esc="order.name"/>
                                                <td t-esc="order.partner_id ? order.partner_id[1] : ''"/>
                                                <td t-esc="order.date_order"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </section>
                    </div>
                </section>
           </div>
       </div>
   </t>
</templates>
