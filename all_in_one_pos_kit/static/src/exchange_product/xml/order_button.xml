<?xml version="1.0" encoding="UTF-8"?>
<!--
    Adds an "All Orders" button to the POS control panel for quick access to order history.
    Enables users to view and manage all orders directly from the POS interface.
-->
<templates id="template" xml:space="preserve">
    <t t-name="all_in_one_pos_kit.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div" position="inside">
            <button class="control-button btn btn-secondary btn-lg py-5" t-on-click="onClickAllOrders">
                <i class="fa fa-ticket me-2"> </i>
                <span>All Orders</span>
            </button>
        </xpath>
    </t>
</templates>
