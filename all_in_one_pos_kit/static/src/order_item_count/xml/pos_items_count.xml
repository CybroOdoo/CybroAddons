<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Item count and total quantity on the product screen, above the numpad -->
    <t t-name="all_in_one_pos_kit.ProductScreenItemCount"
       t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pads')]" position="before">
            <div t-if="pos and pos.getOrder()" class="d-flex justify-content-between px-3 py-1 text-muted fs-6">
                <span>Items: <b t-out="pos.getOrder().itemCount"/></span>
                <span>Total Quantity: <b t-out="pos.getOrder().totalQuantity"/></span>
            </div>
        </xpath>
    </t>
</templates>
