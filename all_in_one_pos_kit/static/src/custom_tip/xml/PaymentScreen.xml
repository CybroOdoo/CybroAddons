<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <!--  Shows the tip percentage to the payment screen -->
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <t t-if="pos.config.tip_product_id">
                <div id="tip_button" class="button"
                     t-on-click="CustomTipButton">
                    <i class="fa fa-percent"/>
                    Tip (<t t-esc="customTipInfo.tip"/>)%
                </div>
            </t>
       </xpath>
    </t>
</templates>
