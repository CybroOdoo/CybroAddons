<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <!--  Button with the tip percentage set in the settings -->
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <t t-if="pos.config.iface_tipproduct and customTipInfo.tip_enable">
                <button type="button" id="tip_button" class="button btn btn-secondary btn-lg"
                        t-on-click="CustomTipButton">
                    <i class="fa fa-percent"/>
                    Tip (<t t-out="customTipInfo.tip"/>%)
                </button>
            </t>
       </xpath>
    </t>
</templates>
