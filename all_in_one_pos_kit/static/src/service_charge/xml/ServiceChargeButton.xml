<?xml version="1.0" encoding="UTF-8"?>
<!-- Adds a Service Charge button in POS to apply charges when enabled in configuration. -->
<templates id="template" xml:space="preserve">
    <t t-name="all_in_one_pos_kit.ServiceChargeControlButton" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div" position="inside">
            <button t-if="pos.config?.enable_service_charge"
                    class="btn btn-secondary btn-lg py-5"
                    t-on-click="clickServiceCharge">
                <i class="fa fa-calculator me-1" role="img" aria-label="Service Charge" title="Service Charge" />
                Service Charge
            </button>
        </xpath>
    </t>
</templates>
