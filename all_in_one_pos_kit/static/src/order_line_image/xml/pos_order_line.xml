<?xml version="1.0" encoding="UTF-8"?>
<template id="template" xml:space="preserve">
<!--    Add product image in the order line-->
    <t t-name="all_in_one_pos_kit.ProductImage" t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]/span" position="before">
            <span class="orderline-product-img">
                <img t-attf-src="/web/image?model=product.product&amp;field=image_128&amp;id=#{line.productId}"
                     style="padding: 5px; height: 55px;"/>
            </span>
        </xpath>
    </t>
</template>
