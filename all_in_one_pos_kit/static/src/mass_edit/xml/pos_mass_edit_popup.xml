<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="MassEditPopup" owl="1">
        <div role="dialog" class="modal-dialog">
            <div class="popup popup-error">
                <p class="title">
                    <t t-esc="props.title"/>
                </p>
                <p class="body">
                    <div class="section-product-info-title">
                        <div class="column flex-start">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th style="width: 90px;">Price</th>
                                        <th t-if="env.pos.config.manual_discount">Discount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="props.body" t-as="line" t-key="line.id">
                                        <tr>
                                            <td style="padding: 20px;">
                                                <b><t t-esc="line.product.display_name"/></b>
                                            </td>
                                            <td>
                                                <input t-model="line.quantity" type="number" name="quantity"/>
                                            </td>
                                            <td>
                                                <b><t t-esc="line.product.uom_id[1]"/></b>
                                            </td>
                                            <td>
                                                <input t-model="line.price" type="number" name="unitPrice"/>
                                            </td>
                                            <td t-if="env.pos.config.manual_discount">
                                                <input t-model="line.discount" type="number" name="discount"/>
                                            </td>
                                            <td>
                                                <button class="input-button numpad-backspace" t-on-mousedown.prevent="() => this.sendInput(line.id)">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </p>
                <div class="footer">
                    <div class="button confirm highlight" t-on-click="confirm">
                        <t t-esc="props.confirmText"/>
                    </div>
                    <div class="button cancel" t-on-click="cancel">
                        <t t-esc="props.cancelText"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
