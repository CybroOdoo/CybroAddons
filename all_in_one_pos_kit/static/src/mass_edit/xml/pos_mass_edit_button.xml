<?xml version="1.0" encoding="UTF-8"?>
<!--Templates to add order line edit button in POS session-->
<templates id="template" xml:space="preserve">
    <!-- Edit Order Line button -->
    <t t-name="all_in_one_pos_kit.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//InternalNoteButton" position="after">
           <button class="btn btn-secondary btn-lg lh-lg flex-shrink-0" t-on-click="EditOrderLine">
               <i class="fa fa-pencil-square-o"/>
               <span>Edit Order Line</span>
           </button>
        </xpath>
    </t>
</templates>
