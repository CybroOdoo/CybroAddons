<?xml version="1.0" encoding="UTF-8"?>
<!-- Adds a mass edit button to POS control panel for editing order lines quickly. -->
<templates id="template" xml:space="preserve">
    <t t-name="all_in_one_pos_kit.MassEditButton" owl="1">
        <div class="control-button btn btn-light rounded-0 fw-bolder"
             t-on-click="onClick">
            <i class="fa fa-pencil-square-o"/>
            <span> Edit Order Line</span>
        </div>
    </t>

    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension" owl="1">
        <xpath expr="//OrderlineNoteButton[last()]" position="after">
            <MassEditButton />
        </xpath>
    </t>
</templates>
