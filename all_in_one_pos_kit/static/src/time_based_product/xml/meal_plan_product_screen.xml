<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Inject the isMealPlanProduct prop into each ProductCard rendered in ProductScreen.
        The pos.plannedProductIds getter (patched in pos_planning.js) returns a Set of
        product IDs belonging to the currently active meal plan(s).
    -->
    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="isMealPlanProduct">pos.plannedProductIds.has(product.id)</attribute>
        </xpath>
    </t>
</templates>
