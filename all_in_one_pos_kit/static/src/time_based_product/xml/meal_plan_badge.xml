<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Extend ProductCard to show a "Meal Plan" badge on products
        that are part of the currently active meal plan.
        The badge appears as a colored ribbon/corner strip on the card.
    -->
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//article" position="inside">
            <t t-if="props.isMealPlanProduct">
                <div class="meal-plan-badge" title="Meal Plan Product">
                    <i class="fa fa-cutlery"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
