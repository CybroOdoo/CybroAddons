<?xml version="1.0" encoding="UTF-8"?>
<!--To add the customer details in the settings page-->
<templates id="template" xml:space="preserve">
    <t t-name="OrderReceipt" t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="inside">
            <div t-if="props.data.customer_name or props.data.customer_address or props.data.customer_mobile"
                 style="padding: 10px; margin: 10px 0; text-align: center;">
                <div style="font-weight:bold;">
                    Customer Name: <t t-esc="props.data.customer_name or 'false'"/>
                </div>
                <div style="font-weight:bold;">
                    Customer Address: <t t-esc="props.data.customer_address or ''"/>
                </div>
                <div style="font-weight:bold;">
                    Customer Mobile: <t t-esc="props.data.customer_mobile or 'false'"/>
                </div>
                <div style="font-weight:bold;">
                    Customer Phone: <t t-esc="props.data.customer_phone or 'false'"/>
                </div>
                <div style="font-weight:bold;">
                    Customer Email: <t t-esc="props.data.customer_email or 'false'"/>
                </div>
                <div style="font-weight:bold;">
                    Customer Vat: <t t-esc="props.data.customer_vat or ''"/>
                </div>
                <div t-if="props.data.barcode_url" class="pos-receipt-order-data" style="text-align:center; padding-top: 10px;">
                    <img t-att-src="props.data.barcode_url" style="width:150px;height:150px;"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
