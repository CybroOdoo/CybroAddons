<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" inherit_id="point_of_sale_template"
           xml:space="preserve">
    <!-- Template for adding clear icon in orderline -->
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]" position="inside">
            <i style="margin-left: 3%; cursor: pointer;" id="clear_icon"
               class="fa fa-times-circle text-danger"
               t-on-click.stop="(ev) => this.clear_button_fun(ev)"/>
        </xpath>
    </t>
</templates>
