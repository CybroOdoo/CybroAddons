<?xml version="1.0" encoding="UTF-8"?>
<!--Adds a "Clear All" button to POS control buttons to remove all order lines at once.
    Enhances checkout efficiency by allowing quick clearing of the current order.-->
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//OrderlineNoteButton[last()]" position="after">
            <button class="control-button btn btn-light text-danger rounded-0 fw-bolder"
                     t-on-click="onClickClearAll">
                <i class="fa fa-eraser"> </i>
                <span> </span>
                <span>Clear All</span>
            </button>
        </xpath>
    </t>
</templates>
