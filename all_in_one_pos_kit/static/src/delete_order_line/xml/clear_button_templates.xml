<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="all_in_one_pos_kit.ClearAllControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//InternalNoteButton" position="after">
            <button class="btn btn-danger btn-lg lh-lg flex-shrink-0"
                    t-on-click="() => this.onClearLines()">
                <i class="fa fa-eraser"/>
                <span>Clear All</span>
            </button>
        </xpath>
    </t>
</templates>
