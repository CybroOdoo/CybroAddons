<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="mcp_gateway_menu_root" 
              name="MCP Gateway" 
              web_icon="odoo_mcp_manager,static/description/icon.png"
              groups="base.group_user"
              sequence="100"/>

    <!-- Dashboard -->
    <menuitem id="mcp_gateway_menu_dashboard" 
              name="Dashboard" 
              parent="mcp_gateway_menu_root" 
              action="ai_hub_dashboard_action_server"
              sequence="10"/>

    <!-- Configuration Submenu -->
    <menuitem id="mcp_gateway_menu_config" 
              name="Configuration" 
              parent="mcp_gateway_menu_root" 
              sequence="100"/>

    <menuitem id="mcp_gateway_menu_settings" 
              name="Settings" 
              parent="mcp_gateway_menu_config" 
              action="res_config_settings_action" 
              sequence="5"/>

    <menuitem id="mcp_gateway_menu_providers" 
              name="Providers" 
              parent="mcp_gateway_menu_config" 
              action="ai_provider_action" 
              sequence="10"/>

    <menuitem id="mcp_gateway_menu_models" 
              name="Models" 
              parent="mcp_gateway_menu_config" 
              action="ai_model_action" 
              sequence="20"/>

    <menuitem id="mcp_gateway_menu_tools"
              name="Tools"
              parent="mcp_gateway_menu_config"
              action="ai_tool_action"
              sequence="30"/>

    <menuitem id="mcp_gateway_menu_resources"
              name="Resources"
              parent="mcp_gateway_menu_config"
              action="ai_resource_action"
              sequence="40"/>

    <!-- Operations Submenu -->
    <menuitem id="mcp_gateway_menu_ops" 
              name="Operations" 
              parent="mcp_gateway_menu_root" 
              sequence="50"/>

    <menuitem id="mcp_gateway_menu_bot_channels"
              name="Bot Channels"
              parent="mcp_gateway_menu_ops"
              action="ai_bot_channel_action"
              sequence="5"/>

    <menuitem id="mcp_gateway_menu_sessions"
              name="Sessions"
              parent="mcp_gateway_menu_ops"
              action="ai_session_action"
              sequence="10"/>

    <menuitem id="mcp_gateway_menu_logs" 
              name="Tool Logs" 
              parent="mcp_gateway_menu_ops" 
              action="ai_tool_log_action" 
              sequence="20"/>

    <menuitem id="mcp_gateway_menu_consents"
              name="Consents"
              parent="mcp_gateway_menu_ops"
              action="ai_consent_action"
              groups="odoo_mcp_manager.group_mcp_consent_approver"
              sequence="30"/>

</odoo>

