<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_tool_access_view_list" model="ir.ui.view">
        <field name="name">ai.tool.access.list</field>
        <field name="model">ai.tool.access</field>
        <field name="arch" type="xml">
            <list string="Tool Access Rules" editable="bottom">
                <field name="model_id" options="{'no_create': True}"/>
                <field name="model_name" optional="show"/>
                <field name="allow_read"/>
                <field name="allow_create"/>
                <field name="allow_update"/>
                <field name="allow_delete"/>
                <field name="allow_unlink"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ai_tool_access_view_form" model="ir.ui.view">
        <field name="name">ai.tool.access.form</field>
        <field name="model">ai.tool.access</field>
        <field name="arch" type="xml">
            <form string="Tool Access Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name"/>
                            <field name="active"/>
                        </group>
                        <group string="Allowed Operations">
                            <field name="allow_read"/>
                            <field name="allow_create"/>
                            <field name="allow_update"/>
                            <field name="allow_delete"/>
                            <field name="allow_unlink"/>
                        </group>
                    </group>
                    <p colspan="2" class="text-muted">
                        These rules control which models the generic built-in AI
                        tools (search / create / update / delete / unlink) and the
                        MCP resource reader may operate on. They are layered on top
                        of each user's own access rights. Destructive operations
                        are off by default.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_tool_access_action" model="ir.actions.act_window">
        <field name="name">Tool Access Rules</field>
        <field name="res_model">ai.tool.access</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a model access rule</p>
            <p>
                Control which Odoo models the built-in AI tools are allowed to
                read or modify. Models without a rule are denied.
            </p>
        </field>
    </record>
</odoo>
