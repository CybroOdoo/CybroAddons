<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_session_view_tree" model="ir.ui.view">
        <field name="name">ai.session.view.tree</field>
        <field name="model">ai.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="session_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="protocol_version"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="ai_session_action" model="ir.actions.act_window">
        <field name="name">AI Sessions</field>
        <field name="res_model">ai.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
