<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client action — renders the OWL McpDashboard component -->
    <record id="ai_hub_dashboard_client_action" model="ir.actions.client">
        <field name="name">MCP Gateway Dashboard</field>
        <field name="tag">mcp_gateway_dashboard</field>
        <field name="target">main</field>
    </record>

    <!-- Legacy server action kept for backward-compat (menus.xml references this) -->
    <record id="ai_hub_dashboard_action_server" model="ir.actions.server">
        <field name="name">MCP Gateway Dashboard</field>
        <field name="model_id" ref="model_ai_dashboard"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.client',
                'tag': 'mcp_gateway_dashboard',
                'name': 'MCP Gateway Dashboard',
            }
        </field>
    </record>
</odoo>
