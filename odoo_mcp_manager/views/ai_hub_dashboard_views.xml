<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_hub_dashboard_view_form" model="ir.ui.view">
        <field name="name">ai.dashboard.view.form</field>
        <field name="model">ai.dashboard</field>
        <field name="arch" type="xml">
            <form string="AI Hub Dashboard" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Odoo MCP Gateway</h1>
                    </div>
                    <div class="row mt-4">
                        <div class="col-md-4">
                            <div class="card shadow-sm border-primary mb-3">
                                <div class="card-body text-center">
                                    <h5 class="card-title text-primary"><i class="fa fa-server"/> MCP Server Status</h5>
                                    <p class="card-text text-success"><strong>ACTIVE</strong></p>
                                    <button name="%(odoo_mcp_manager.ai_generate_mcp_key_action)d" string="New MCP Key" type="action" class="btn btn-primary"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card shadow-sm border-success mb-3">
                                <div class="card-body text-center">
                                    <h5 class="card-title text-success"><i class="fa fa-plug"/> Providers</h5>
                                    <p class="card-text"><field name="provider_count"/> Active Connections</p>
                                    <button name="%(odoo_mcp_manager.ai_provider_action)d" string="Manage Providers" type="action" class="btn btn-success"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card shadow-sm border-info mb-3">
                                <div class="card-body text-center">
                                    <h5 class="card-title text-info"><i class="fa fa-wrench"/> Tools</h5>
                                    <p class="card-text"><field name="tool_count"/> Standard Tools</p>
                                    <button name="%(odoo_mcp_manager.ai_tool_action)d" string="Manage Tools" type="action" class="btn btn-info"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr/>
                    <div class="row mt-4">
                        <div class="col-md-12">
                            <h3>Operations</h3>
                            <div class="d-flex gap-2">
                                <button name="%(odoo_mcp_manager.ai_session_action)d" string="View Sessions" type="action" class="btn btn-outline-secondary"/>
                                <button name="%(odoo_mcp_manager.ai_tool_log_action)d" string="Execution Logs" type="action" class="btn btn-outline-secondary"/>
                                <button name="%(odoo_mcp_manager.ai_consent_action)d" string="Pending Consents" type="action" class="btn btn-outline-secondary"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_hub_dashboard_action_server" model="ir.actions.server">
        <field name="name">MCP Gateway Dashboard</field>
        <field name="model_id" ref="model_ai_dashboard"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_open_dashboard()
        </field>
    </record>
</odoo>
