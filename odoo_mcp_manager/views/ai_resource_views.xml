<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_resource_view_list" model="ir.ui.view">
        <field name="name">ai.resource.view.list</field>
        <field name="model">ai.resource</field>
        <field name="arch" type="xml">
            <list string="MCP Resources" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="uri" optional="show"/>
                <field name="record_count" optional="show"/>
                <field name="model_exists" optional="show" string="Available"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ai_resource_view_form" model="ir.ui.view">
        <field name="name">ai.resource.view.form</field>
        <field name="model">ai.resource</field>
        <field name="arch" type="xml">
            <form string="MCP Resource">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_name"
                                   placeholder="e.g. res.partner"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="uri" readonly="1"/>
                            <field name="model_exists" readonly="1"/>
                            <field name="record_count" readonly="1"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Description (shown to MCP clients)">
                        <field name="description" nolabel="1"
                               placeholder="Brief description of what this resource contains…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_resource_action" model="ir.actions.act_window">
        <field name="name">MCP Resources</field>
        <field name="res_model">ai.resource</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
