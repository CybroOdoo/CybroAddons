<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_generate_mcp_key_view_form" model="ir.ui.view">
        <field name="name">ai.generate.mcp.key.view.form</field>
        <field name="model">ai.generate.mcp.key</field>
        <field name="arch" type="xml">
            <form string="Generate MCP Key">
                <sheet>

                    <!-- Input State -->
                    <group invisible="state != 'input'">
                        <field name="platform"/>
                        <field name="name" placeholder="e.g. Claude Desktop on My Laptop"/>
                    </group>

                    <!-- Result State: key details -->
                    <div invisible="state != 'result'">
                        <!-- Warning banner -->
                        <div class="alert alert-warning mb-3" role="alert">
                            <strong>Save this key now!</strong> It will not be shown again.
                        </div>

                        <!-- Generated Key -->
                        <div class="row mb-2 align-items-center">
                            <span class="col-lg-3 col-form-label fw-bold o_form_label text-end">Generated Key</span>
                            <div class="col-lg-9">
                                <field name="key" readonly="1" widget="CopyClipboardChar" nolabel="1"/>
                            </div>
                        </div>

                        <!-- MCP Server URL -->
                        <div class="row mb-2 align-items-center">
                            <span class="col-lg-3 col-form-label fw-bold o_form_label text-end">MCP Server URL</span>
                            <div class="col-lg-9">
                                <field name="mcp_url" readonly="1" nolabel="1" widget="url"/>
                            </div>
                        </div>

                        <!-- Platform -->
                        <div class="row mb-3 align-items-center">
                            <span class="col-lg-3 col-form-label fw-bold o_form_label text-end">Platform</span>
                            <div class="col-lg-9">
                                <field name="platform" nolabel="1"/>
                            </div>
                        </div>

                        <!-- Setup Instructions -->
                        <div class="o_horizontal_separator mt-4 mb-3 fw-bold text-uppercase text-muted" style="font-size:11px; letter-spacing:0.05em;">
                            Setup Instructions
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <field name="setup_instruction" widget="ai_instruction" readonly="1" nolabel="1"/>
                            </div>
                        </div>

                        <!-- Platform Configuration -->
                        <div class="o_horizontal_separator mt-4 mb-3 fw-bold text-uppercase text-muted" style="font-size:11px; letter-spacing:0.05em;">
                            Platform Configuration
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <field name="claude_config" widget="ai_json_editor" readonly="1" nolabel="1" style="min-height:180px; width:100%;"/>
                            </div>
                        </div>
                    </div>

                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_generate" string="Generate Key" type="object"
                            class="oe_highlight" invisible="state != 'input'"/>
                    <button string="Close" class="btn-secondary" special="cancel"
                            invisible="state != 'input'"/>
                    <button string="Done" class="btn-primary" special="cancel"
                            invisible="state != 'result'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ai_generate_mcp_key_action" model="ir.actions.act_window">
        <field name="name">Generate MCP Key</field>
        <field name="res_model">ai.generate.mcp.key</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
