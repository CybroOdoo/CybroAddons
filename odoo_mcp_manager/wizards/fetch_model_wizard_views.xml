<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_fetch_model_wizard_view_form" model="ir.ui.view">
        <field name="name">ai.fetch.model.wizard.view.form</field>
        <field name="model">ai.fetch.model.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Provider row -->
                    <div class="row mb-3 align-items-center">
                        <span class="col-lg-2 col-form-label fw-bold o_form_label text-end">Provider</span>
                        <div class="col-lg-10">
                            <field name="provider_id" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <!-- Divider + section title -->
                    <div class="o_horizontal_separator mt-2 mb-3 fw-bold text-uppercase text-muted"
                         style="font-size:11px; letter-spacing:0.05em;">
                        Suggested Models
                    </div>

                    <!-- Full-width model list -->
                    <div class="row">
                        <div class="col-12">
                            <field name="model_line_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="selected" string="Import" optional="show"/>
                                    <field name="name" string="Model ID"/>
                                    <field name="model_use" string="Use"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_fetch" string="Refresh / Fetch" type="object"
                            invisible="model_line_ids" class="oe_highlight"/>
                    <button name="action_confirm" string="Import Selected" type="object"
                            invisible="not model_line_ids" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ai_fetch_model_wizard_action" model="ir.actions.act_window">
        <field name="name">Fetch Models</field>
        <field name="res_model">ai.fetch.model.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
