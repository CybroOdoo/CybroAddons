<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_fetch_model_wizard_view_form" model="ir.ui.view">
        <field name="name">ai.fetch.model.wizard.view.form</field>
        <field name="model">ai.fetch.model.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="provider_id" readonly="1"/>
                    </group>
                    <group string="Suggested Models">
                        <field name="model_line_ids" nolabel="1">
                            <list editable="bottom" create="false">
                                <field name="selected"/>
                                <field name="name"/>
                                <field name="model_use"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_fetch" string="Refresh / Fetch" type="object" invisible="model_line_ids" class="oe_highlight"/>
                    <button name="action_confirm" string="Import Selected" type="object" invisible="not model_line_ids" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ai_fetch_model_wizard_action" model="ir.actions.act_window">
        <field name="name">Fetch Models</field>
        <field name="res_model">ai.fetch.model.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
