<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_test_tool_wizard_view_form" model="ir.ui.view">
        <field name="name">ai.test.tool.wizard.view.form</field>
        <field name="model">ai.test.tool.wizard</field>
        <field name="arch" type="xml">
            <form string="Test AI Tool">
                <sheet>
                    <!-- Tool row -->
                    <div class="row mb-3 align-items-center">
                        <span class="col-lg-2 col-form-label fw-bold o_form_label text-end">Tool</span>
                        <div class="col-lg-10">
                            <field name="tool_id" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <!-- Model selection (only shown when tool needs it) -->
                    <div class="row mb-3 align-items-center" invisible="not requires_model">
                        <span class="col-lg-2 col-form-label fw-bold o_form_label text-end">Odoo Model</span>
                        <div class="col-lg-10">
                            <field name="model_id" nolabel="1"
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="Search and select an installed Odoo model..."/>
                        </div>
                    </div>
                    <field name="requires_model" invisible="1"/>

                    <!-- Input Parameters -->
                    <div class="o_horizontal_separator mt-2 mb-2 fw-bold text-uppercase text-muted"
                         style="font-size:11px; letter-spacing:0.05em;">
                        Input Parameters
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <field name="params_json" nolabel="1"
                                   widget="ace" options="{'language': 'json'}"
                                   style="min-height:160px; width:100%;"/>
                        </div>
                    </div>

                    <!-- Result -->
                    <div invisible="not result">
                        <div class="o_horizontal_separator mt-2 mb-2 fw-bold text-uppercase text-muted"
                             style="font-size:11px; letter-spacing:0.05em;">
                            Result
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <field name="result" nolabel="1" readonly="1"
                                       widget="ace" options="{'language': 'text'}"
                                       style="min-height:160px; width:100%;"/>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_execute" string="Execute" type="object" class="oe_highlight"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ai_test_tool_wizard_action" model="ir.actions.act_window">
        <field name="name">Test Tool</field>
        <field name="res_model">ai.test.tool.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
