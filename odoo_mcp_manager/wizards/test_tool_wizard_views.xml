<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_test_tool_wizard_view_form" model="ir.ui.view">
        <field name="name">ai.test.tool.wizard.view.form</field>
        <field name="model">ai.test.tool.wizard</field>
        <field name="arch" type="xml">
            <form string="Test AI Tool">
                <sheet>
                    <group>
                        <field name="tool_id" readonly="1"/>
                        <field name="requires_model" invisible="1"/>
                    </group>
                    <group invisible="not requires_model" string="Model Selection">
                        <field
                            name="model_id"
                            options="{'no_create': True, 'no_open': True}"
                            placeholder="Search and select an installed Odoo model..."
                        />
                    </group>
                    <group string="Parameters (JSON)">
                        <field name="params_json" nolabel="1" widget="ace" options="{'language': 'json'}"/>
                    </group>
                    <group string="Result" invisible="not result">
                        <field name="result" nolabel="1" readonly="1" widget="ace" options="{'language': 'text'}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_execute" string="Execute" type="object" class="oe_highlight"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ai_test_tool_wizard_action" model="ir.actions.act_window">
        <field name="name">Test Tool</field>
        <field name="res_model">ai.test.tool.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
