<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Seed read-only allow-list rules for common installed models, once.
             Runs on every module load, but the method is idempotent and guarded
             by a system parameter so it seeds only once and never overwrites
             administrator changes on a later module update. -->
        <function model="ai.tool.access" name="_seed_default_rules"/>
    </data>
</odoo>
