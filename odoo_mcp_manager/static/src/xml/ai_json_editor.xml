<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Code-style config block with copy button -->
    <t t-name="odoo_mcp_manager.AiJsonEditor" owl="1">
        <div class="o_field_widget o_field_ai_json_editor d-flex flex-column" style="min-height: 200px;">
            <div class="d-flex justify-content-end mb-2">
                <button class="btn btn-sm btn-primary o_copy_button" t-on-click="onCopyClick">
                    <i class="fa fa-copy me-1"/> Copy
                </button>
            </div>
            <textarea
                class="o_input flex-grow-1 font-monospace p-2"
                style="resize: none; white-space: pre; overflow-wrap: normal; overflow-x: auto; background-color: #f8f9fa;"
                t-att-id="props.id"
                t-att-readonly="true"
                t-att-placeholder="props.placeholder"
                t-ref="textarea"
            ><t t-esc="props.record.data[props.name] or ''"/></textarea>
        </div>
    </t>

    <!-- Instruction display block (no copy button — read-only guidance) -->
    <t t-name="odoo_mcp_manager.AiInstruction" owl="1">
        <div class="o_field_widget o_field_ai_instruction">
            <div class="p-3 rounded font-monospace"
                 style="background-color: #eaf6fb; border-left: 4px solid #17a2b8; white-space: pre-wrap; font-size: 0.85rem; line-height: 1.7; color: #1a3a4a;">
                <t t-esc="props.record.data[props.name] or ''"/>
            </div>
        </div>
    </t>

</templates>
