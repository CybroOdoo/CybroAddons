<?xml version="1.0" encoding="UTF-8" ?>
<!-- Template for alternative product popup -->
<templates id="template" xml:space="preserve">
    <t t-name="pos_alternative_products.AlternativeProduct" owl="1">
        <div class="popup custom_popup" style="width: 500px; border: 1px solid #ccc; border-radius: 8px; background-color: #fff; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);">
            <!-- Header Section -->
            <div class="modal-header" style="display: flex; justify-content: center; align-items: center; padding: 10px; border-bottom: 1px solid #ddd;">
                <p class="title" style="margin: 0; font-size: 16px; font-weight: bold; text-align: center;">
                    <t t-esc="props.title"/>
                </p>
            </div>

            <!-- Body Section -->
            <div class="modal-body" style="padding: 20px; max-height: 300px; overflow-y: auto;">
                <t t-log="props"/>
                <t t-foreach="props.body" t-as="item" t-key="item.id">
                    <span class="product product_content fix_product selected"
                          t-att-data-product-id="item.id"
                          t-on-click="() => this.clickProduct(item)"
                          style="display: block; margin-bottom: 15px; cursor: pointer; border: 1px solid #eee; border-radius: 5px; padding: 10px;">
                        <div class="product-list row" style="display: flex; align-items: center;">
                            <div class="product-img" style="flex: 0 0 50px; margin-right: 10px;">
                                <img t-att-src="item.image_url" style="width: 50px; height: 50px; border-radius: 4px; object-fit: cover;" />
                            </div>
                            <div class="product-name" style="flex: 1; text-align: left; font-size: 14px; color: #333;">
                                <t t-esc="item.display_name"/>
                            </div>
                        </div>
                    </span>
                </t>
            </div>
            <div class="modal_footer">
                <div class="d-flex justify-content-end p-2 pt-0">
                    <button class="btn cy-button-primary-stroke" t-on-click="() => this.cancel()">OK</button>
                </div>
            </div>
        </div>
    </t>
</templates>
