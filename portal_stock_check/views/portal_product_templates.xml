<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template for showing the product availability card in the portal home -->
    <template id="portal_my_home" name="Portal Product Availability"
              customize_show="True"
              inherit_id="portal.portal_my_home" priority="100">
         <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">

        <div class="o_portal_index_card col-md-6 order-2">
            <a href="/my/product-availability"
               title="Product Availability"
               class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">

                <div class="o_portal_icon d-block align-self-start">
                    <i class="fa fa-cubes fa-2x"/>
                </div>

                <div>
                    <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                        Product Availability
                    </div>

                    <div class="opacity-75">
                        Check product availability
                    </div>
                </div>

            </a>
        </div>

    </xpath>

    </template>
    <!-- Template for the product search page -->
    <template id="portal_product_availability" name="Portal Product Availability Page">
        <t t-call="portal.portal_layout">
            <div class="o_portal_category row g-2 mt-3" id="portal_common_category">
            </div>

            <div class="text-center mt-4 mb-5">
                <h2><b>Search Products</b></h2>
                <span class="text-muted">Search results show the product name and the total available quantity.</span>
            </div>

            <form class="s_website_form container-fluid mt32" onsubmit="return false;">
                <div class="row">
                    <div class="col-md-6 col-sm-12 o_website_product_search">
                        <label class="control-label mb-1" for="product_name_input">
                            Product Stock Availability
                        </label>
                        <div class="position-relative">
                            <input type="text"
                                   class="form-control o_portal_product_input"
                                   id="product_name_input"
                                   name="products_search" required=""
                                   placeholder="Search products..."/>
                            <div aria-label="Search" title="Search"
                                 style="position: absolute; right: 10px; top: 10px; cursor: pointer;">
                                <i class="fa fa-search" style="color: black;"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6 col-sm-12">
                        <div class="product_results_table"/>
                    </div>
                </div>
            </form>
        </t>
    </template>
</odoo>
