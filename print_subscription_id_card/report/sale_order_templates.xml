<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Report for subscription id card-->
    <record id="action_report_subscription_card" model="ir.actions.report">
        <field name="name">Subscription ID Card</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">print_subscription_id_card.report_subscription_id_card</field>
    </record>
    <!--Template for subscription id card-->
    <template id="report_subscription_id_card">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="o_subscription_id_card">
                        <span class="o_subscription_id_card_title">SUBSCRIPTION ID CARD</span>
                        <div class="o_subscription_id_card_photo">
                            <!-- PNG data URI built by the report model (wkhtmltopdf: no session, no WebP). -->
                            <img t-if="partner_image" t-att-src="partner_image" alt="Customer photo"/>
                        </div>
                        <div class="o_subscription_id_card_name">
                            <t t-out="name"/>
                        </div>
                        <div class="o_subscription_id_card_line">Start Date:
                            <t t-out="start_date"/>
                        </div>
                        <div class="o_subscription_id_card_line">End Date:
                            <t t-out="end_date"/>
                        </div>
                        <div class="o_subscription_id_card_line o_subscription_id_card_products">
                            <b>Products:</b>
                            <t t-foreach="products" t-as="product">
                                <span t-out="product"/>
                                <br/>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
