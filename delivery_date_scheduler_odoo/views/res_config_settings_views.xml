<?xml version="1.0" encoding="UTF-8" ?>
<!--
    This XML file extends the website settings form (res.config.settings)
    to add configuration options for Delivery Date Restrictions.
-->
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.delivery.date.scheduler.odoo
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Delivery Scheduler" string="Delivery Scheduler" name="delivery_date_scheduler_odoo">
                    <block title="Delivery Date Restrictions" id="delivery_date_scheduler_settings">
                        <setting id="warning_date" string="Restrict Date" help="You can set date range for your customer delivery date">
                            <field name="warning_date"/>
                            <div class="content-group"
                                 invisible="not warning_date">
                                <div class="row mt16">
                                    <label string="Minimum Date Range (Days)"
                                           for="min_date_range"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="min_date_range"/>
                                </div>
                                <div class="row mt16">
                                    <label string="Maximum Date Range (Days)"
                                           for="max_date_range"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="max_date_range"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>