<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Extend calendar event form to add fields-->
    <record id="view_calendar_event_form" model="ir.ui.view">
        <field name="name">view.calendar.event.form.inherit.odoo.googlemeet.integration</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_ids']" position="after">
                <field name="is_google_meet"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="users_google_meet_integration"
                      string="Google Meet">
                    <group>
                        <group>
                            <field name="google_meet_url" placeholder="https://meet.google.com....."
                                   widget="CopyClipboardChar" class="mb-3 ps-3"/>
                        </group>
                        <group>
                            <button name="action_google_meet_url" string="Join Meeting" type="object"
                                    class="btn btn-primary"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="google_meet_code" widget="CopyClipboardChar" class="mb-3 ps-3"/>
                        </group>
                        <group>
                            <field name="google_event_id" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
