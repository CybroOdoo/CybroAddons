<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Action to open the Bid Selection wizard as a popup form -->
    <record id="bid_selection_action" model="ir.actions.act_window">
        <field name="name">Bid Selection</field>
        <field name="res_model">bid.selection</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <!-- Form view for Bid Selection wizard -->
    <record id="bid_selection_view_form" model="ir.ui.view">
        <field name="name">bid.selection.view.form</field>
        <field name="model">bid.selection</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="current_tender_id"/>
                        <field name="tender_bid_id"/>
                    </group>
                </group>
                <footer>
                    <button
                            name="action_confirm_purchase"
                            string="Confirm Purchase"
                            type="object"
                            class="btn-primary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>