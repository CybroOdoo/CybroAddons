<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Action to open the Import Tender Product Lines wizard in a popup -->
    <record id="import_tender_product_line_action" model="ir.actions.act_window">
        <field name="name">Import Tender Product Lines</field>
        <field name="res_model">import.tender.product.line</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <!-- Form view for importing tender product lines -->
    <record id="import_tender_product_line_view_form" model="ir.ui.view">
        <field name="name">import.tender.product.line.view.form</field>
        <field name="model">import.tender.product.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="file"/>
                    </group>
                </group>
                <footer>
                    <button
                            name="action_import_tender_product_lines"
                            string="Import"
                            type="object"
                            class="btn-primary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>