<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Category used to group all bidding-related user roles in settings -->
    <record id="module_category_bidding" model="ir.module.category">
        <field name="name">Bidding Management</field>
        <field name="description">Groups related to product bidding and auction
            management
        </field>
        <field name="sequence">10</field>
    </record>
    <!-- Basic user group for users who can participate in bidding operations -->
    <record id="group_bidding_user" model="res.groups">
        <field name="name">Bidding User</field>
        <field name="category_id" ref="module_category_bidding"/>
    </record>
    <!-- Manager group with advanced permissions, inheriting bidding user access rights -->
    <record id="group_bidding_manager" model="res.groups">
        <field name="name">Bidding Manager</field>
        <field name="category_id" ref="module_category_bidding"/>
        <field name="implied_ids" eval="[(4, ref('group_bidding_user'))]"/>
    </record>
</odoo>