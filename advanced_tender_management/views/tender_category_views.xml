<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Action to open Tender Category records in tree view -->
    <record id="tender_category_action" model="ir.actions.act_window">
        <field name="name">Tender Category</field>
        <field name="res_model">tender.category</field>
        <field name="view_mode">tree</field>
    </record>
        <!-- Action to open Tender Category records in tree view -->
    <record id="tender_category_view_tree" model="ir.ui.view">
        <field name="name">tender.category.view.tree</field>
        <field name="model">tender.category</field>
        <field name="arch" type="xml">
            <tree edit="1" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
</odoo>