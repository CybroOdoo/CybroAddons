<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Action to open Tender Category records in list view -->
    <record id="tender_category_action" model="ir.actions.act_window">
        <field name="name">Tender Category</field>
        <field name="res_model">tender.category</field>
        <field name="view_mode">list</field>
    </record>
        <!-- Action to open Tender Category records in list view -->
    <record id="tender_category_view_list" model="ir.ui.view">
        <field name="name">tender.category.view.list</field>
        <field name="model">tender.category</field>
        <field name="arch" type="xml">
            <list edit="1" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>