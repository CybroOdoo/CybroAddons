<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Website menu item to access Tender Management page -->
    <record id="tender_management_website_menu" model="website.menu">
        <field name="name">Tenders</field>
        <field name="url">/tender_management</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">90</field>
    </record>
    <!-- Website menu item to access Vendor Registration page -->
    <record id="vendor_management_website_menu" model="website.menu">
        <field name="name">Vendor Register</field>
        <field name="url">/vendor_register</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">80</field>
    </record>
</odoo>