<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <!-- Extend portal home page to add a Tender entry card -->
    <template id="tender_portal_view" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="title">Tenders</t>
                <t t-set="text">Review all your submitted bids for tenders</t>
                <t t-set="url" t-value="'/my/tenders'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>
</odoo>