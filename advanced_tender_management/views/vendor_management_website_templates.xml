<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website template for Vendor Registration Form -->
    <template id="vendor_register_template" name="Vendor Registration Form">
        <t t-log="tender_category"/>
        <t t-call="website.layout">
            <div id="vendor-registration-form-container">
                <section class="form-container">
                    <div class="container">
                        <form enctype="multipart/form-data" class="vendor-registration-form o_mark_required"
                              method="post" action="/vendor_register/submit" data-success-mode="redirect"
                              data-success-page="/vendor-register-thank-you">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="file-upload mb-4">
                                <label for="companyLogo" class="custom-file-upload">
                                    Upload Image
                                </label>
                                <input type="file" name="company_logo" accept="image/*" id="companyLogo"/>
                            </div>

                            <!-- Name Input -->
                            <div class="row mb-3">
                                <label class="col-form-label col-sm-auto s_website_form_label"
                                       style="width: 200px" for="name">
                                    <strong class="s_website_form_label_content">Name</strong>
                                    <strong class="s_website_form_mark">*</strong>
                                </label>
                                <div class="col-sm">
                                    <input name="name" required="1" type="text"
                                           class="form-control s_website_form_input"/>
                                </div>
                            </div>

                            <!-- Type Input -->
                            <div class="row mb-3">
                                <label class="col-form-label col-sm-auto s_website_form_label"
                                       style="width: 200px" for="vendor_type">
                                    <strong class="s_website_form_label_content">Type</strong>
                                    <strong class="s_website_form_mark">*</strong>
                                </label>
                                <div class="col-sm">
                                    <select class="form-control s_website_form_input" name="vendor_type" required="1">
                                        <option value="" selected="1" hidden="1"></option>
                                        <option value="company">Company</option>
                                        <option value="individual">Individual</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Address Input -->
                            <div class="row mb-3">
                                <label class="col-form-label col-sm-auto s_website_form_label"
                                       style="width: 200px" for="address">
                                    <strong class="s_website_form_label_content">Address</strong>
                                    <strong class="s_website_form_mark">*</strong>
                                </label>
                                <div class="col-sm">
                                    <div class="row mb-2">
                                        <div class="col-sm-6">
                                            <input name="street" required="1" type="text" placeholder="Street Address"
                                                   class="form-control s_website_form_input"/>
                                        </div>
                                        <div class="col-sm-6">
                                            <input name="street2" type="text" placeholder="Street Address Line 2"
                                                   class="form-control s_website_form_input"/>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-sm-6">
                                            <input name="city" required="1" type="text" placeholder="City"
                                                   class="form-control s_website_form_input"/>
                                        </div>
                                        <div class="col-sm-3">
                                            <select class="form-control s_website_form_input form-state" name="state">
                                                <option value="" selected="1" hidden="1">State</option>
                                                <t t-foreach="states" t-as="state">
                                                    <option t-att-value="state['id']" t-esc="state['name']"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-sm-3">
                                            <input name="zip" required="1" type="text" placeholder="ZIP Code"
                                                   class="form-control s_website_form_input"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <select class="form-control s_website_form_input form-country"
                                                    name="country">
                                                <option value="" selected="1" hidden="1">Country</option>
                                                <t t-foreach="countries" t-as="country">
                                                    <option t-att-value="country['id']" t-esc="country['name']"/>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Phone Input -->
                            <div class="row mb-3">
                                <label class="col-form-label col-sm-auto s_website_form_label"
                                       style="width: 200px" for="phone">
                                    <strong class="s_website_form_label_content">Phone</strong>
                                    <strong class="s_website_form_mark">*</strong>
                                </label>
                                <div class="col-sm">
                                    <input name="phone" type="tel" class="form-control s_website_form_input"/>
                                </div>
                            </div>

                            <!-- Email Input -->
                            <div class="row mb-3">
                                <label class="col-form-label col-sm-auto s_website_form_label"
                                       style="width: 200px" for="email">
                                    <strong class="s_website_form_label_content">Email</strong>
                                    <strong class="s_website_form_mark">*</strong>
                                </label>
                                <div class="col-sm">
                                    <input name="email" type="email" class="form-control s_website_form_input"/>
                                </div>
                            </div>

                            <!-- Website Input -->
                            <div class="row mb-3">
                                <label class="col-form-label col-sm-auto s_website_form_label"
                                       style="width: 200px" for="website">
                                    <strong class="s_website_form_label_content">Website</strong>
                                </label>
                                <div class="col-sm">
                                    <input name="website" type="url" class="form-control s_website_form_input"/>
                                </div>
                            </div>

                            <!-- Note Input -->
                            <div class="row mb-3">
                                <label class="col-form-label col-sm-auto s_website_form_label"
                                       style="width: 200px" for="note">
                                    <strong class="s_website_form_label_content">Note</strong>
                                </label>
                                <div class="col-sm">
                                    <textarea name="note" class="form-control s_website_form_input"></textarea>
                                </div>
                            </div>

                            <!-- Tender Categories Input -->
                            <div class="row mb-3">
                                <label class="col-form-label col-sm-auto s_website_form_label"
                                       style="width: 200px">
                                    <strong class="s_website_form_label_content">Tender Categories</strong>
                                    <strong class="s_website_form_mark">*</strong>
                                </label>
                                <div class="col-sm">
                                    <select class="js-example-basic-multiple form-control s_website_form_input form-tender-category"
                                            multiple="multiple" name="category">
                                        <t t-foreach="tender_category" t-as="category">
                                            <option t-att-value="category['id']" t-att-data-name="category['name']"
                                                    t-esc="category['name']"/>
                                        </t>
                                    </select>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <div class="form-group col-12 submit-button">
                                <div style="width: 200px;" class="s_website_form_label"/>
                                <button type="submit" class="btn btn-primary form-btn-submit">Register</button>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </t>
    </template>
    <!-- Thank You page after successful registration -->
    <template id="register_thankyou_page" name="Thank You Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-7 col-xl-6 me-lg-auto">
                                <span class="d-block fa fa-4x fa-thumbs-up mx-auto rounded-circle bg-primary"/>
                                <br/>
                                <h1 class="text-center">Thank You!</h1>
                                <div class="pb16 pt16 s_hr" data-snippet="s_hr" data-name="Separator">
                                    <hr class="mx-auto border-top w-50 border-dark text-center"/>
                                </div>
                                <h5 class="text-center">
                                    <span class="fa fa-check-circle"/>
                                    <span>Your Registration has been completed
                                        <b>successfully</b>
                                    </span>
                                </h5>
                            </div>
                            <div class="col-lg-4">
                                <ul class="list-unstyled mb-0 ps-2">
                                    <li style="margin-bottom: 10px;">
                                        <i class="fa fa-building fa-fw me-2"></i>
                                        <t t-esc="env.user.company_id.name"/>
                                    </li>
                                    <li style="margin-bottom: 10px;">
                                        <i class="fa fa-map-marker fa-fw me-2"></i>
                                        <t t-esc="env.user.company_id.street"/>
                                        <t t-esc="env.user.company_id.city"/>
                                        <t t-esc="env.user.company_id.zip"/>
                                    </li>
                                    <li style="margin-bottom: 10px;">
                                        <i class="fa fa-phone fa-fw me-2"></i>
                                        <t t-esc="env.user.company_id.phone"/>
                                    </li>
                                    <li>
                                        <i class="fa fa-envelope fa-fw me-2"></i>
                                        <t t-esc="env.user.company_id.email"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>


</odoo>
