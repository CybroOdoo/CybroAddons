<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Action to open vendor records filtered by is_vendor flag -->
    <record id="res_partner_action" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('is_vendor', '=', True)]</field>
    </record>
        <!-- Inherit partner form view to add vendor-specific fields -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.advanced.tender.management</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="is_vendor" widget="boolean_toggle"/>
                <field name="tender_category_ids" widget="many2many_tags"/>
                <field name="registered_tenders_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
