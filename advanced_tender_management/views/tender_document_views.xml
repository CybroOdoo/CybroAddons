<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Action to open Tender Documents with grouping by tender and no create option -->
    <record id="tender_document_action" model="ir.actions.act_window">
        <field name="name">Tender Document</field>
        <field name="res_model">tender.document</field>
        <field name="view_mode">tree</field>
        <field name="context">{'create': False,"search_default_filter_group_by_tender": 1}</field>
    </record>
        <!-- Tree view to manage tender documents with inline editing -->
    <record id="tender_document_view_tree" model="ir.ui.view">
        <field name="name">tender.document.view.tree</field>
        <field name="model">tender.document</field>
        <field name="arch" type="xml">
            <tree edit="1" editable="bottom">
                <field name="name"/>
                <field name="attachment"/>
                <field name="filename"/>
            </tree>
        </field>
    </record>
        <!-- Search view with group by tender option -->
    <record id="tender_document_view_search" model="ir.ui.view">
        <field name="name">tender.document.view.search</field>
        <field name="model">tender.document</field>
        <field name="arch" type="xml">
            <search>
                <group string="Group By">
                    <filter string="Tender" name="filter_group_by_tender"
                            context="{'group_by':'tender_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>