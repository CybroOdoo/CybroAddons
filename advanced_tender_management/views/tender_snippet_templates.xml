<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Snippet listing the tenders open for bidding. The cards are loaded on
         the website; the placeholder shows in the editor and its previews. -->
    <template id="tender_management_snippet" name="Tenders">
        <section class="oe_structure container dynamic_snippet_blog">
            <div class="row">
                <div class="col-md-12">
                    <div class="text-center py-5">
                        <h2 class="mb-2">Open Tenders</h2>
                        <p class="text-muted mb-4">Tenders currently accepting bids from registered vendors.</p>
                        <div id="carousel">
                            <p class="o_tender_snippet_placeholder text-muted border rounded py-5 mb-0">
                                The tenders open for bidding are listed here.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Adds the snippet to the website builder -->
    <template id="external_snippets" inherit_id="website.snippets" priority="8">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="advanced_tender_management.tender_management_snippet"
               string="Tenders" group="content"
               t-thumbnail="/advanced_tender_management/static/src/img/tender.svg">
                <keywords>tender, bid, vendor, procurement</keywords>
            </t>
        </xpath>
    </template>
</odoo>
