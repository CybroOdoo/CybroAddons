<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Tender Management menu-->
    <menuitem id="advanced_tender_management_root"
              name="Advanced Tender Management" groups="group_bidding_user"
               sequence="1"
              web_icon="advanced_tender_management,static/description/icon.png"/>
    <!--    Tender menu-->
    <menuitem id="tender_management_menu" name="Tenders"
              action="tender_management_action"
              sequence="10"
              parent="advanced_tender_management_root"/>
    <!--    Tender Bidding menu-->
    <menuitem id="tender_bidding_menu" name="Bidding"
              action="tender_bidding_action"
              parent="advanced_tender_management_root"/>
    <!--    Vendor menu-->
    <menuitem id="res_partner_menu" name="Vendors" action="res_partner_action"
              parent="advanced_tender_management_root"/>
    <!--    Product menu-->
    <menuitem id="product_template_menu" name="Products"
              action="product_template_action"
              parent="advanced_tender_management_root"/>
    <!--    Configuration menu-->
    <menuitem id="configuration_menu" name="Configurations"
              parent="advanced_tender_management_root"/>
    <!--    Tender Category menu-->
    <menuitem id="tender_category_menu" name="Tender Categories"
              parent="configuration_menu" action="tender_category_action"/>
    <!--    Tender Category menu-->
    <menuitem id="tender_document_menu" name="Tender Documents"
              parent="configuration_menu" action="tender_document_action"/>
    <!--    Tender Dashboard action-->
    <record id="tender_dashboard_action" model="ir.actions.client">
        <field name="name">Tender Dashboard</field>
        <field name="tag">tender_dashboard_tag</field>
    </record>
    <!--    Tender Dashboard menu-->
    <menuitem id="tender_dashboard_menu" name="Dashboard"
              sequence="0" action="tender_dashboard_action"
              groups="group_bidding_manager"
              parent="advanced_tender_management_root"/>
</odoo>
