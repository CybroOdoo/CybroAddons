<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Portal page template to display user's applied tenders and their bid details -->
    <template id="portal_my_tenders" name="My Tenders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Your Tenders</t>
            </t>
            <div t-if="not bid_records" class="alert alert-warning" role="alert">
                There are currently no applied tenders in your account.
            </div>
            <t t-if="bid_records" t-call="portal.portal_table">
                <table class="table table-striped o_list_view table-hover">
                    <thead>
                        <tr>
                            <th>Tender</th>
                            <th>Bid Reference</th>
                            <th>Rank</th>
                            <th>Bid Status</th>
                            <th>Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="bid_records" t-as="bid">
                            <tr>
                                <td t-esc="bid.tender_id.name"/>
                                <td t-esc="bid.name"/>
                                <td>
                                    <t t-if="bid.vendor_rank == 0">N/A</t>
                                    <t t-else="True" t-esc="bid.vendor_rank"/>
                                </td>
                                <td t-out="dict(bid._fields['qualification_stage'].selection).get(bid.qualification_stage)"/>
                                <td t-esc="bid.total_bidding_amount"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
    <!-- Add breadcrumb menu entry for "My Tenders" in portal navigation -->
    <template id="portal_my_tenders_menu"
              inherit_id="portal.portal_breadcrumbs" priority="60">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'tenders'"
                class="breadcrumb-item active">
                <span>My Tenders</span>
            </li>
        </xpath>
    </template>
</odoo>