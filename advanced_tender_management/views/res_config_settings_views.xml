<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend settings view to add Vendor Approval configuration -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="before">
                <div id="vendor_container">
                    <block title="Vendor Approval" name="vendor_approval_settings_container">
                        <setting id="vendor_approval">
                            <field name="auto_approval"/>
                            <group>
                                <field string="Manual Approval" name="manual_approval_users_ids"
                                       widget="many2many_tags"/>
                            </group>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>