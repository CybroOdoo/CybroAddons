<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings page section for vendor approval -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.advanced.tender.management</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Tender Management" string="Tender Management"
                     name="advanced_tender_management"
                     groups="advanced_tender_management.group_bidding_manager">
                    <block title="Vendor Approval" name="vendor_approval_settings_container">
                        <setting id="vendor_approval"
                                 help="Give registered vendors portal access automatically, or notify the approval users instead.">
                            <field name="auto_approval"/>
                            <div class="mt8" invisible="auto_approval">
                                <field name="manual_approval_users_ids" widget="many2many_tags"
                                       placeholder="Approval users"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
