<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Action to open Tender Bidding Product Lines in tree view -->
    <record id="tender_bidding_product_lines_action" model="ir.actions.act_window">
        <field name="name">Tender Bidding Product Lines</field>
        <field name="res_model">tender.bidding.product.lines</field>
        <field name="view_mode">tree</field>
    </record>
        <!-- Tree view to display bidding product lines with actions -->
    <record id="tender_bidding_product_lines_view_tree" model="ir.ui.view">
        <field name="name">tender.bidding.product.lines.view.tree</field>
        <field name="model">tender.bidding.product.lines</field>
        <field name="arch" type="xml">
            <tree default_order="product_total asc">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="bid_chosen" invisible="1" optional="hide"/>
                <field name="bid_status" invisible="1" optional="hide"/>
                <field name="product_id"/>
                <field name="product_total"/>
                <button name="action_confirm_bid" type="object" string="Confirm" class="btn-primary"
                        invisible="bid_chosen"/>
                <button name="action_reselect_bid" type="object" string="Re-select" class="btn-secondary"
                        invisible="not bid_status=='re_select'"/>
                <button name="action_selected_bid" type="object" string="Selected" class="btn-primary"
                        invisible="not bid_status=='selected'"/>
            </tree>
        </field>
    </record>
        <!-- Search view for filtering and grouping bidding product lines -->
    <record id="tender_bidding_product_lines_view_search" model="ir.ui.view">
        <field name="name">tender.bidding.product.lines.view.search</field>
        <field name="model">tender.bidding.product.lines</field>
        <field name="arch" type="xml">
            <search>
                <group string="Group By">
                    <filter string="Products" name="filter_group_by_product"
                            context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>