<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
        <!-- Website snippet template to display tenders in a carousel/card layout -->
        <t t-name="advanced_tender_management.tender_snippet_carousel">
            <div class="row w-100 mx-auto oe_tender_carousel">
                <t t-if="chunks.length>0">
                <t t-foreach="chunks" t-as="chunk" t-key="chunk[0]">
                    <div class="row">
                            <t t-foreach="chunk"
                               t-as="item"
                               t-key="item[0]">
                            <div class="block span3 col-3 oe_tender_card">

                                    <div class="card oe_tender_card_content">
                                        <div class="oe_tender_type">
                                            <span t-esc="item.tender_type"/>
                                        </div>
                                        <div class="oe_tender_group">
                                            <h5 class="mb-3 oe_tender_title">
                                                <span t-esc="item.name"/>
                                            </h5>
                                            <div class="oe_tender_group_category">
                                                <span t-esc="item.tender_category_id[1]"/>
                                            </div>

                                        </div>
                                        <div class="oe_tender_date_group">
                                            <div class="oe_tender_bid_date_group">
                                                <span>Tender Start : <strong
                                                        t-esc="item.tender_start_date"/></span>
                                                <span>Tender End   : <strong
                                                        t-esc="item.tender_end_date"/></span>
                                            </div>
                                            <div class="oe_tender_tender_date_group">
                                                <span>Bid Start : <strong
                                                        t-esc="item.bid_start_date"/></span>
                                                <span>Bid End   : <strong
                                                        t-esc="item.bid_end_date"/></span>
                                            </div>
                                        </div>
                                        <button class="oe_tender_button">
                                            <a t-attf-href="/show_tender/{{item.id}}">
                                                Show Details
                                            </a>
                                        </button>
                                    </div>
                            </div>
                        </t>
                    </div>
                </t>
                </t>
                <t t-else="">
                    <div class="col-12 text-center mt-4">
                        <h5>No tenders available at the moment.</h5>
                    </div>
                </t>
            </div>
        </t>
    </templates>