<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!-- Main dashboard template for displaying tender analytics and statistics -->
    <t t-name="advanced_tender_management.TenderDashboard">
        <xpath expr="." position="inside">
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        </xpath>
        <div class="primary-container">
            <div class="tender-statistics-container">
                <h3>Tender Statistic</h3>
                <hr/>
                <div class="tender-tile-container">
                    <div id="tenders" class="tile">
                        <strong>Tenders</strong>
                        <span t-ref="tender_count" class="tile-count">0</span>
                    </div>
                    <div id="vendors" class="tile">
                        <strong>Vendors</strong>
                        <span t-ref="vendor_count" class="tile-count">0</span>
                    </div>
                    <div id="locations" class="tile">
                        <strong>Countries</strong>
                        <span t-ref="tender_country_count" class="tile-count">0</span>
                    </div>
                    <div id="active_tenders" class="tile">
                        <strong>Active</strong>
                        <span t-ref="active_tenders_count" class="tile-count">0</span>
                    </div>
                    <div id="tender_categories" class="tile">
                        <strong>Categories</strong>
                        <span t-ref="tender_categories" class="tile-count">0</span>
                    </div>
                    <div class="tender-type-chart-container">
                        <canvas id="canvas_tender_type_chart" t-ref="tender_type_graph" class="canvas-tile"/>
                    </div>
                </div>
            </div>
            <div class="tender-category-type-chart-container">
                <h3>Tender Category</h3>
                <hr/>
                <canvas id="canvas_category_type_chart" t-ref="category_type_graph"/>
            </div>
            <div class="bidding-pending-container">
                <div class="tender-bidding-container">
                    <h3>Bidding</h3>
                    <hr/>
                    <div class="bidding-tile-container">
                        <div id="active_bids" class="tile">
                            <strong>Active</strong>
                            <span t-ref="active_bid_count" class="tile-count">0</span>
                        </div>
                        <div id="qualified_bids" class="tile">
                            <strong>Qualified</strong>
                            <span t-ref="qualified_bid_count" class="tile-count">0</span>
                        </div>
                        <div id="disqualified_bids" class="tile">
                            <strong>DisQualified</strong>
                            <span t-ref="disqualified_bid_count" class="tile-count">0</span>
                        </div>
                    </div>
                </div>
                <div class="pending-task-container">
                    <h3>Pending Task</h3>
                    <hr/>
                    <div class="pending-tile-container">
                        <div id="edit_requests" class="tile tile-tenders">
                            <strong>Edit Request</strong>
                            <span t-ref="edit_requests_count" class="tile-count">0</span>
                        </div>
                        <div id="pre_qualification" class="tile tile-vendors">
                            <strong>Pre Qualification</strong>
                            <span t-ref="pre_qualification_count" class="tile-count">0</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tender-timeline-chart-container">
                <h3>Tender Timeline</h3>
                <hr/>
                <canvas id="tender_timeline_chart" t-ref="tender_timeline_chart"/>
            </div>
        </div>
    </t>
</templates>
