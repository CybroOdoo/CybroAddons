<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Bid Submission Template -->
        <record id="bid_submission_template" model="mail.template">
            <field name="name">bid.submission.template</field>
            <field name="model_id" ref="advanced_tender_management.model_tender_bidding"/>
            <field name="email_to">{{ object.vendor_id.email }}</field>
            <field name="subject">Bid Registration Successful</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: 'Arial', sans-serif; font-size: 14px; color: #333;">
                    <p style="margin-bottom: 20px;">
                        Hello
                        <strong>
                            <t t-esc="object.vendor_id.name"/>
                        </strong>
                        ,
                    </p>
                    <p style="margin-bottom: 20px;">
                        We are pleased to inform you that your bid registration has been successfully completed. Thank
                        you for your interest in our tender process.
                    </p>
                    <p style="margin-bottom: 20px;">
                        If you have any questions or require further information, please do not hesitate to contact us.
                    </p>
                    <p style="margin-bottom: 20px;">
                        Best regards,
                        <br/>
                        <span style="color: #666;">
                            <t t-esc="user.company_id.name"/>
                        </span>
                    </p>
                </div>
            </field>
        </record>

        <!-- Bid Edit Request Template -->
        <record id="bid_edit_request_template" model="mail.template">
            <field name="name">bid.edit.request.template</field>
            <field name="model_id" ref="advanced_tender_management.model_tender_bidding"/>
            <field name="email_to">{{ object.tender_id.responsible_id.partner_id.email }}</field>
            <field name="subject">Bid Edit Request</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: 'Arial', sans-serif; font-size: 14px; color: #333;">
                    <p style="margin-bottom: 20px;">
                        Hello
                        <strong>
                            <t t-esc="object.tender_id.responsible_id.name"/>
                        </strong>
                        ,
                    </p>
                    <p style="margin-bottom: 20px;">
                        A bid edit request has been submitted. Please review and approve it after verification.
                    </p>
                    <p style="margin-bottom: 20px;">
                        You can view the bid details by clicking the link below:
                    </p>
                    <p style="margin-bottom: 20px;">
                        <a t-att-href="ctx.get('bid_link')" class="btn btn-primary"
                           style="color: white; background-color: #007bff; text-decoration: none; padding: 10px 15px; border-radius: 5px;">
                            View Bid
                        </a>
                    </p>
                    <p style="margin-bottom: 20px;">
                        Best regards,
                        <br/>
                        <span style="color: #666;">
                            <t t-esc="user.company_id.name"/>
                        </span>
                    </p>
                </div>
            </field>
        </record>

        <!-- User Approval Notification Template -->
        <record id="approval_user_notification_mail_template" model="mail.template">
            <field name="name">approval.user.notification.mail.template</field>
            <field name="model_id" ref="advanced_tender_management.model_res_partner"/>
            <field name="subject">Immediate User Approval Required</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: 'Arial', sans-serif; font-size: 14px; color: #333;">
                    <p style="margin-bottom: 20px;">
                        Please review and approve the following user after completing the necessary verification steps.
                    </p>
                    <p style="margin-bottom: 20px;">
                        <a t-att-href="ctx.get('contact_link')" class="btn btn-primary"
                           style="color: white; background-color: #007bff; text-decoration: none; padding: 10px 15px; border-radius: 5px;">
                            Approve User
                        </a>
                    </p>
                </div>
            </field>
        </record>

        <!-- Bidding Qualified Template -->
        <record id="bidding_qualified_template" model="mail.template">
            <field name="name">bidding.qualified.template</field>
            <field name="model_id" ref="advanced_tender_management.model_tender_bidding"/>
            <field name="email_to">{{ object.vendor_id.email }}</field>
            <field name="subject">Bid Qualification Notice</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: 'Arial', sans-serif; font-size: 14px; color: #333;">
                    <p style="margin-bottom: 20px;">
                        Hello
                        <strong>
                            <span t-esc="object.vendor_id.name"/>
                        </strong>
                        ,
                    </p>
                    <p style="margin-bottom: 20px;">
                        We are excited to inform you that your bid has successfully qualified. Thank you for
                        participating in our tender process.
                    </p>
                    <p style="margin-bottom: 20px;">
                        Our team will thoroughly review your submission, and you will receive further updates shortly.
                    </p>
                    <p style="margin-bottom: 20px;">
                        Best regards,
                        <br/>
                        <span style="color: #666;">
                            <t t-esc="user.company_id.name"/>
                        </span>
                    </p>
                </div>
            </field>
        </record>

        <!-- Bidding Disqualified Template -->
        <record id="bidding_disqualified_template" model="mail.template">
            <field name="name">bidding.disqualified.template</field>
            <field name="model_id" ref="advanced_tender_management.model_tender_bidding"/>
            <field name="email_to">{{ object.vendor_id.email }}</field>
            <field name="subject">Bid Disqualification Notice</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: 'Arial', sans-serif; font-size: 14px; color: #333;">
                    <p style="margin-bottom: 20px;">
                        Hello
                        <strong>
                            <span t-esc="object.vendor_id.name"/>
                        </strong>
                        ,
                    </p>
                    <p style="margin-bottom: 20px;">
                        We regret to inform you that your bid has been disqualified from the tender process.
                        We appreciate your effort and encourage you to stay engaged for future opportunities.
                    </p>
                    <p style="margin-bottom: 20px;">
                        If you have any questions or would like feedback on your submission, please feel free to contact
                        us.
                    </p>
                    <p style="margin-bottom: 20px;">
                        Best regards,
                        <br/>
                        <span style="color: #666;">
                            <t t-esc="user.company_id.name"/>
                        </span>
                    </p>
                </div>
            </field>
        </record>

        <!-- Vendor Registration Template -->
        <record id="vendor_registration_template" model="mail.template">
            <field name="name">vendor.registration.template</field>
            <field name="model_id" ref="advanced_tender_management.model_res_partner"/>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Vendor Registration Successful</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: 'Arial', sans-serif; font-size: 14px; color: #333;">
                    <p style="margin-bottom: 20px;">
                        Hello
                        <strong>
                            <t t-esc="object.name"/>
                        </strong>
                        ,
                    </p>
                    <p style="margin-bottom: 20px;">
                        We are pleased to inform you that your vendor registration has been successfully completed.
                        You will receive portal access shortly, allowing you to participate in tender bidding.
                    </p>
                    <p style="margin-bottom: 20px;">
                        If you have any questions or require further information, please do not hesitate to contact us.
                    </p>
                    <p style="margin-bottom: 20px;">
                        Best regards,
                        <br/>
                        <span style="color: #666;">
                            <t t-esc="user.company_id.name"/>
                        </span>
                    </p>
                </div>
            </field>
        </record>

        <!-- Edit Request Approved Template -->
        <record id="edit_request_approved_template" model="mail.template">
            <field name="name">edit.request.approved.template</field>
            <field name="model_id" ref="advanced_tender_management.model_tender_bidding"/>
            <field name="email_to">{{ object.vendor_id.email }}</field>
            <field name="subject">Bid Edit Request Approved</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: 'Arial', sans-serif; font-size: 14px; color: #333;">
                    <p style="margin-bottom: 20px;">
                        Hello
                        <strong>
                            <span t-esc="object.vendor_id.name"/>
                        </strong>
                        ,
                    </p>
                    <p style="margin-bottom: 20px;">
                        We are pleased to inform you that your bid edit request has been approved. You may now proceed
                        with the necessary changes.
                    </p>
                    <p style="margin-bottom: 20px;">
                        If you have any questions, feel free to reach out to us.
                    </p>
                    <p style="margin-bottom: 20px;">
                        Best regards,
                        <br/>
                        <span style="color: #666;">
                            <t t-esc="user.company_id.name"/>
                        </span>
                    </p>
                </div>
            </field>
        </record>

        <!-- Purchase Order Confirmed Template -->
        <record id="purchase_order_confirmed_template" model="mail.template">
            <field name="name">purchase.order.confirmed.template</field>
            <field name="model_id" ref="advanced_tender_management.model_purchase_order"/>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="subject">Purchase Order Confirmation</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: 'Arial', sans-serif; font-size: 14px; color: #333;">
                    <p style="margin-bottom: 20px;">
                        Hello
                        <strong>
                            <t t-esc="object.partner_id.name"/>
                        </strong>
                        ,
                    </p>
                    <p style="margin-bottom: 20px;">
                        Congratulations! Your purchase order for bid reference
                        <strong>
                            <t t-esc="object.partner_ref"/>
                        </strong>
                        has been confirmed. The total amount of
                        <strong>
                            <t t-esc="object.amount_total"/>
                        </strong>
                        has been approved.
                    </p>
                    <p style="margin-bottom: 20px;">
                        Thank you for your participation in our tender process. We look forward to successful
                        collaboration.
                    </p>
                    <p style="margin-bottom: 20px;">
                        Best regards,
                        <br/>
                        <span style="color: #666;">
                            <t t-esc="user.company_id.name"/>
                        </span>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
