<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Cron Action for tender activation-->
    <record id="ir_cron_scheduled_action_tender_expiry" model="ir.cron">
        <field name="name">ir.cron.scheduled.action.tender.expiry</field>
        <field name="model_id" ref="model_tender_management"/>
        <field name="state">code</field>
        <field name="code">model.action_tender_expiration()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now()+timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
    </record>
</odoo>
