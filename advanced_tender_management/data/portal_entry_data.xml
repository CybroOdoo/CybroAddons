<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Card on the portal home page listing the vendor's bids. It is
             shown to vendors, and to any user with bids through its counter. -->
        <record id="portal_tenders_client" model="portal.entry">
            <field name="name">Tenders</field>
            <field name="description">Review all your submitted bids for tenders</field>
            <field name="url">/my/tenders</field>
            <field name="image" type="bytes" file="advanced_tender_management/static/src/img/tender.svg"/>
            <field name="category">client_category</field>
            <field name="placeholder_count">tender_bid_count</field>
            <field name="sequence" eval="90"/>
        </record>
    </data>
    <!-- Brings the card of databases installed earlier up to date: bid counter and icon -->
    <function model="portal.entry" name="_update_tenders_card"/>
</odoo>
