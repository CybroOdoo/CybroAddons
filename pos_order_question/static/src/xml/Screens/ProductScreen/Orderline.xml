<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
<!-- Extending order line template to add button and output related to order questions.   -->
    <t t-name="pos_order_question.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('info-list')]" position="inside">
           <li class="orderline-add-options d-inline-flex align-items-center">
               <i class="oi cursor-pointer" data-icon="add" role="img" aria-label="Add Options" title="Add Options" t-on-click.stop="() => this.AddOptions()"/>
           </li>
            <t t-if="this.props.line.OrderQuestion">
                 <div class="orderline-question-list text-muted small">
                    <t t-foreach="this.props.line.OrderQuestion.split('/')" t-as="Question" t-key="Question">
                        <div>
                            <t t-out="Question"/>
                        </div>
                    </t>
                 </div>
            </t>
        </xpath>
    </t>
</templates>
