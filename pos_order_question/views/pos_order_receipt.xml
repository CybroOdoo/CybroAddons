<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="pos_order_question.pos_orderline_receipt_information" inherit_id="point_of_sale.pos_orderline_receipt_information">
            <div name="extra-info" position="inside">
                <t t-if="line.get('question_list')">
                    <div class="text-small mt-1 orderline-questions" style="font-style: italic; color: #555;">
                        <t t-foreach="line['question_list'].split(',')" t-as="question">
                            <div>- <t t-out="question" /></div>
                        </t>
                    </div>
                </t>
            </div>
        </template>
    </data>
</odoo>
