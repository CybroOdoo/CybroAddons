<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_view_form_inherit_product_wise_shipping_method" model="ir.ui.view">
        <!--Inherit product template form view-->
        <field name="name">product.template.view.form.inherit.product.wise.shipping.method</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!--Add the shipping method field to the inherited form and define its
            position-->
            <field name="categ_id" position="after">
                <field name="shipping_method_id" invisible="type != 'consu'" />
            </field>
        </field>
    </record>
</odoo>
