<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view of the drip mailing history -->
    <record id="drip_mailing_history_view_list" model="ir.ui.view">
        <field name="name">drip.mailing.history.view.list</field>
        <field name="model">drip.mailing.history</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="contact_id"/>
                <field name="mailing_id"/>
                <field name="template_id"/>
                <field name="send_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <!-- Form view of the drip mailing history -->
    <record id="drip_mailing_history_view_form" model="ir.ui.view">
        <field name="name">drip.mailing.history.view.form</field>
        <field name="model">drip.mailing.history</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contact_id"/>
                            <field name="mailing_id"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="send_date"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
