<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Drip history smart button on the mailing contact form -->
    <record id="mailing_contact_view_form" model="ir.ui.view">
        <field name="name">mailing.contact.view.form.inherit.odoo.drip.email.marketing</field>
        <field name="model">mailing.contact</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="get_drip_history" icon="history">
                    <field string="Drip History" name="drip_count"
                           widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
