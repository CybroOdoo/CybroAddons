#. module: base_accounting_kit
#: model:mail.template,body_html:base_accounting_kit.mail_template_followup
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                    <p>Dear <t t-out=\"object.name or ''\">Customer</t>,</p>\n"
"                    <p>\n"
"                        According to our records, the following invoices are still\n"
"                        unpaid and now overdue. We kindly ask you to arrange\n"
"                        payment at your earliest convenience.\n"
"                    </p>\n"
"                    <table border=\"1\" width=\"100%\" style=\"border-collapse:collapse;margin:12px 0;\">\n"
"                        <thead>\n"
"                            <tr style=\"background-color:#f2f2f2;\">\n"
"                                <th style=\"padding:6px;text-align:left;\">Invoice</th>\n"
"                                <th style=\"padding:6px;text-align:left;\">Date</th>\n"
"                                <th style=\"padding:6px;text-align:left;\">Due Date</th>\n"
"                                <th style=\"padding:6px;text-align:right;\">Amount Due</th>\n"
"                            </tr>\n"
"                        </thead>\n"
"                        <tbody>\n"
"                            <t t-foreach=\"object.invoice_list\" t-as=\"inv\">\n"
"                                <tr>\n"
"                                    <td style=\"padding:6px;\"><t t-out=\"inv.name or ''\"/></td>\n"
"                                    <td style=\"padding:6px;\"><t t-out=\"inv.invoice_date or ''\"/></td>\n"
"                                    <td style=\"padding:6px;\"><t t-out=\"inv.invoice_date_due or ''\"/></td>\n"
"                                    <td style=\"padding:6px;text-align:right;\">\n"
"                                        <t t-out=\"inv.amount_residual\" t-options=\"{'widget': 'monetary', 'display_currency': inv.currency_id}\"/>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </tbody>\n"
"                    </table>\n"
"                    <p>\n"
"                        <strong>Total overdue:\n"
"                            <t t-out=\"object.total_overdue\" t-options=\"{'widget': 'monetary', 'display_currency': object.env.company.currency_id}\"/>\n"
"                        </strong>\n"
"                    </p>\n"
"                    <p>If payment has already been made, please disregard this message.</p>\n"
"                    <p>Best regards,<br/><t t-out=\"object.env.company.name or ''\"/></p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                    <p>مشتری گرامی <t t-out=\"object.name or ''\">مشتری</t>،</p>\n"
"                    <p>\n"
"                        بر اساس سوابق ما، فاکتورهای زیر هنوز پرداخت نشده و سررسید آن‌ها گذشته است. خواهشمند است در اسرع وقت نسبت به تسویه حساب اقدام فرمایید.\n"
"                    </p>\n"
"                    <table border=\"1\" width=\"100%\" style=\"border-collapse:collapse;margin:12px 0;\">\n"
"                        <thead>\n"
"                            <tr style=\"background-color:#f2f2f2;\">\n"
"                                <th style=\"padding:6px;text-align:right;\">فاکتور</th>\n"
"                                <th style=\"padding:6px;text-align:right;\">تاریخ</th>\n"
"                                <th style=\"padding:6px;text-align:right;\">تاریخ سررسید</th>\n"
"                                <th style=\"padding:6px;text-align:left;\">مبلغ سررسید شده</th>\n"
"                            </tr>\n"
"                        </thead>\n"
"                        <tbody>\n"
"                            <t t-foreach=\"object.invoice_list\" t-as=\"inv\">\n"
"                                <tr>\n"
"                                    <td style=\"padding:6px;\"><t t-out=\"inv.name or ''\"/></td>\n"
"                                    <td style=\"padding:6px;\"><t t-out=\"inv.invoice_date or ''\"/></td>\n"
"                                    <td style=\"padding:6px;\"><t t-out=\"inv.invoice_date_due or ''\"/></td>\n"
"                                    <td style=\"padding:6px;text-align:left;\">\n"
"                                        <t t-out=\"inv.amount_residual\" t-options=\"{'widget': 'monetary', 'display_currency': inv.currency_id}\"/>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </tbody>\n"
"                    </table>\n"
"                    <p>\n"
"                        <strong>کل معوقات:\n"
"                            <t t-out=\"object.total_overdue\" t-options=\"{'widget': 'monetary', 'display_currency': object.env.company.currency_id}\"/>\n"
"                        </strong>\n"
"                    </p>\n"
"                    <p>اگر پرداخت قبلاً انجام شده است، لطفاً این پیام را نادیده بگیرید.</p>\n"
"                    <p>با احترام،<br/><t t-out=\"object.env.company.name or ''\"/></p>\n"
"                </div>"

