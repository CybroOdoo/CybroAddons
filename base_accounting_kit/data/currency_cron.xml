<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled action for automatic currency exchange rate synchronization -->
        <record id="ir_cron_currency_rates_update" model="ir.cron">
            <field name="name">Currency Rates Update</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_all_company_currency_rates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
