<odoo>
    <!--Res Config Settings Form View-->
    <record id="res_config_settings_view_form_base_accounting_kit" model="ir.ui.view">
        <field name="name">res.config.view.inherited.base.accounting.kit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="customer_credit" help="Enable credit limit for customers">
                    <field name="customer_credit_limit" on_change="1"/>
                </setting>
            </xpath>
            <!-- Remove the enterprise budget option -->
            <xpath expr="//setting[@id='account_budget']" position="replace"/>
            <!-- Replace enterprise currency live rate banner with community automatic currency rates -->
            <xpath expr="//setting[@id='update_exchange_rates']" position="replace">
                <setting id="automatic_currency_rates" string="Automatic Currency Rates"
                         help="Automatically synchronize foreign exchange rates from an online financial provider.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="currency_provider" string="Provider" class="col-lg-4 o_light_label"/>
                            <field name="currency_provider"/>
                        </div>
                        <div class="row" invisible="currency_provider != 'central_bank'">
                            <label for="currency_central_bank" string="Central Bank" class="col-lg-4 o_light_label"/>
                            <field name="currency_central_bank"/>
                        </div>
                        <div class="row">
                            <label for="currency_rate_interval" string="Sync Frequency" class="col-lg-4 o_light_label"/>
                            <field name="currency_rate_interval"/>
                        </div>
                        <div class="row" invisible="currency_provider not in ('exchangerate_api', 'openexchangerates')">
                            <label for="currency_api_key" string="API Key / App ID" class="col-lg-4 o_light_label"/>
                            <field name="currency_api_key" password="True" placeholder="Required for Open Exchange Rates; optional for ExchangeRate-API"/>
                        </div>
                        <div class="row">
                            <label for="currency_max_change" string="Hold Back Changes Above (%)" class="col-lg-4 o_light_label"/>
                            <field name="currency_max_change"/>
                        </div>
                        <div class="row mt4" invisible="not currency_last_sync_date">
                            <span class="text-muted small col-lg-8">
                                Last updated: <field name="currency_last_sync_date" class="d-inline"/>
                            </span>
                        </div>
                        <div class="mt8">
                            <button name="action_sync_currency_rates_now" type="object"
                                    string="Sync Rates Now" class="btn btn-secondary btn-sm"
                                    icon="fa-refresh"/>
                        </div>
                    </div>
                </setting>
            </xpath>
            <xpath expr="//block[@id='bank_cash']" position="inside">
                <setting id="anglo_saxon" help="It will record the cost of good sold">
                    <field name="use_anglo_saxon_accounting"/>
                </setting>
                <setting id="fx_revaluation" string="Foreign Currency Revaluation"
                         help="Accounts and journal used to book unrealized foreign-currency gains/losses.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="fx_reval_journal_id" class="col-lg-4 o_light_label"/>
                            <field name="fx_reval_journal_id"/>
                        </div>
                        <div class="row">
                            <label for="fx_reval_gain_account_id" class="col-lg-4 o_light_label"/>
                            <field name="fx_reval_gain_account_id"/>
                        </div>
                        <div class="row">
                            <label for="fx_reval_loss_account_id" class="col-lg-4 o_light_label"/>
                            <field name="fx_reval_loss_account_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
            <setting id="fiscalyear" position="replace">
                <setting id="fiscalyear">

                        <div class="o_setting_right_pane">
                            <separator string="Fiscal Year"/>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="fiscalyear_last_month" string="Last Day"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="fiscalyear_last_month" style="width: 100px; margin-right: 8px;"/>
                                    <field name="fiscalyear_last_day" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
