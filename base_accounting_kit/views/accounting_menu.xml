<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Change invoicing menu to Accounting     -->
    <record model="ir.ui.menu" id="account.menu_finance">
        <field name="name">Accounting</field>
    </record>
    <!-- Reporting: the statements, partner and tax reports go in core's
         folders (Statement Reports 1, Partner Reports 3, Taxes &amp; Fiscal
         4, Management 5); the kit adds the folders core does not have. -->
    <menuitem id="account_reports_audit" sequence="2"
              name="Audit Reports" parent="account.menu_finance_reports"/>
    <menuitem id="account_reports_daily_reports" sequence="4"
              name="Daily Reports" parent="account.menu_finance_reports"/>
    <!-- Accounting > Closing (core folder): Lock Dates, Lock Exceptions and
         Currency Revaluation, next to core's Secure Entries. -->
</odoo>
