<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Dynamic reports: each menu opens the shared screen
         (client action "kit_dynamic_report") for one report model. -->
    <record id="action_dynamic_trial_balance" model="ir.actions.client">
        <field name="name">Trial Balance</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.trial_balance'}"/>
    </record>

    <menuitem id="menu_Balance_report"
              name="Trial Balance"
              sequence="7"
              action="action_dynamic_trial_balance"
              parent="base_accounting_kit.account_reports_audit"/>
    <record id="action_dynamic_general_ledger" model="ir.actions.client">
        <field name="name">General Ledger</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.general_ledger'}"/>
    </record>
    <menuitem id="menu_general_ledger"
              name="General Ledger"
              sequence="3"
              parent="base_accounting_kit.account_reports_audit"
              action="action_dynamic_general_ledger"
              groups="account.group_account_readonly"/>

    <record id="action_dynamic_partner_ledger" model="ir.actions.client">
        <field name="name">Partner Ledger</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.partner_ledger'}"/>
    </record>
    <menuitem id="menu_partner_ledger"
              name="Partner Ledger"
              sequence="1"
              parent="account.account_reports_partners_reports_menu"
              action="action_dynamic_partner_ledger"/>

    <record id="action_dynamic_aged_receivable" model="ir.actions.client">
        <field name="name">Aged Receivable</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.aged', 'options': {'account_type': 'receivable'}}"/>
    </record>
    <record id="action_dynamic_aged_payable" model="ir.actions.client">
        <field name="name">Aged Payable</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.aged', 'options': {'account_type': 'payable'}}"/>
    </record>
    <menuitem id="menu_aged_trial_balance"
              name="Aged Receivable"
              sequence="2"
              action="action_dynamic_aged_receivable"
              parent="account.account_reports_partners_reports_menu"/>
    <menuitem id="menu_aged_payable"
              name="Aged Payable"
              sequence="3"
              action="action_dynamic_aged_payable"
              parent="account.account_reports_partners_reports_menu"/>
    <record id="action_dynamic_profit_loss" model="ir.actions.client">
        <field name="name">Profit and Loss</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.financial', 'options': {'account_report_id': ref('base_accounting_kit.account_financial_report_profitandloss0')}}"/>
    </record>
    <record id="action_dynamic_balance_sheet" model="ir.actions.client">
        <field name="name">Balance Sheet</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.financial', 'options': {'account_report_id': ref('base_accounting_kit.account_financial_report_balancesheet0')}}"/>
    </record>
    <record id="action_dynamic_cash_flow" model="ir.actions.client">
        <field name="name">Cash Flow Statement</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.cash_flow'}"/>
    </record>
    <menuitem id="account_financial_reports_profit_loss" sequence="1"
              name="Profit and Loss" parent="account.account_reports_legal_statements_menu"
              action="action_dynamic_profit_loss"/>
    <menuitem id="_account_financial_reports_balance_sheet" sequence="2"
              name="Balance Sheet" parent="account.account_reports_legal_statements_menu"
              action="action_dynamic_balance_sheet"/>
    <menuitem id="menu_account_cash_flow_report"
              name="Cash Flow Statement"
              sequence="5"
              action="action_dynamic_cash_flow"
              parent="account.account_reports_legal_statements_menu"/>
    <record id="action_dynamic_day_book" model="ir.actions.client">
        <field name="name">Day Book</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.day_book'}"/>
    </record>
    <menuitem id="account_day_book_menu" name="Day Book" action="action_dynamic_day_book"
              parent="base_accounting_kit.account_reports_daily_reports" sequence="1"/>

    <record id="action_dynamic_cash_book" model="ir.actions.client">
        <field name="name">Cash Book</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.cash_book'}"/>
    </record>
    <menuitem id="account_cash_book_menu" name="Cash Book" action="action_dynamic_cash_book"
              parent="base_accounting_kit.account_reports_daily_reports" sequence="2"/>

    <record id="action_dynamic_bank_book" model="ir.actions.client">
        <field name="name">Bank Book</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.bank_book'}"/>
    </record>
    <menuitem id="account_bank_book_menu" name="Bank Book" action="action_dynamic_bank_book"
              parent="base_accounting_kit.account_reports_daily_reports" sequence="3"/>

    <record id="action_dynamic_tax" model="ir.actions.client">
        <field name="name">Tax Report</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.tax'}"/>
    </record>
    <menuitem id="menu_tax_report" name="Tax Report" action="action_dynamic_tax"
              parent="account.account_reports_taxes_and_fiscal_menu" sequence="1" groups="account.group_account_readonly"/>

    <record id="action_dynamic_bank_reconciliation" model="ir.actions.client">
        <field name="name">Bank Reconciliation</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.bank_reconciliation'}"/>
    </record>
    <menuitem id="menu_bank_reconciliation_report" name="Bank Reconciliation"
              action="action_dynamic_bank_reconciliation"
              parent="base_accounting_kit.account_reports_audit" sequence="10"
              groups="account.group_account_readonly"/>

    <record id="action_dynamic_journal_audit" model="ir.actions.client">
        <field name="name">Journals Audit</field>
        <field name="tag">kit_dynamic_report</field>
        <field name="params" eval="{'model': 'account.dynamic.report.journal_audit'}"/>
    </record>
    <menuitem id="menu_print_journal" name="Journals Audit" action="action_dynamic_journal_audit"
              parent="base_accounting_kit.account_reports_audit" sequence="9" groups="account.group_account_readonly"/>
</odoo>
