<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Review > To Review: entries flagged to review (the condition of
         core's "To Review" filter), draft entries (core's "Unposted"
         filter), bank transactions not matched yet. Entries open in core's
         journal entries list, as Accounting > Journal Entries. -->
    <record id="action_review_entries" model="ir.actions.act_window">
        <field name="name">Entries to Review</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="context">{'default_move_type': 'entry', 'view_no_maturity': True}</field>
        <field name="domain">[('review_state', 'in', ('todo', 'anomaly')), ('state', '=', 'posted')]</field>
    </record>

    <record id="action_review_draft_entries" model="ir.actions.act_window">
        <field name="name">Draft Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="context">{'default_move_type': 'entry', 'view_no_maturity': True, 'search_default_unposted': 1}</field>
    </record>

    <menuitem id="menu_review_to_review" name="To Review" sequence="10"
              parent="account.account_audit_menu"
              groups="account.group_account_readonly"/>
    <menuitem id="menu_review_entries" action="action_review_entries"
              parent="menu_review_to_review" sequence="1"/>
    <menuitem id="menu_review_draft_entries" action="action_review_draft_entries"
              parent="menu_review_to_review" sequence="2"/>
    <menuitem id="menu_review_bank_transactions" action="action_kit_bank_reconciliation"
              parent="menu_review_to_review" sequence="3"
              groups="account.group_account_user"/>
    <menuitem id="menu_review_open_items" action="action_kit_open_items"
              parent="menu_review_to_review" sequence="4"
              groups="account.group_account_user"/>

    <!-- Accounting > Bank & Cash: statement import (P2.2), core's bank
         statements list and the reconciliation screen. -->
    <menuitem id="menu_bank_cash" name="Bank &amp; Cash" sequence="10"
              parent="account.menu_finance_entries"
              groups="account.group_account_readonly,account.group_account_invoice"/>
    <menuitem id="menu_bank_cash_import" action="import_bank_statement_view_action"
              parent="menu_bank_cash" sequence="1"
              groups="account.group_account_basic"/>
    <menuitem id="menu_bank_cash_statements" action="account.action_bank_statement_tree"
              parent="menu_bank_cash" sequence="2"/>
    <menuitem id="menu_bank_cash_transactions" action="action_kit_bank_reconciliation"
              parent="menu_bank_cash" sequence="3"
              groups="account.group_account_user"/>

    <!-- Budget menus (base_account_budget) placed with the kit's menus:
         Accounting > Management and Configuration > Management. -->
    <record id="base_account_budget.menu_act_budget_view" model="ir.ui.menu">
        <field name="parent_id" ref="management_menu"/>
        <field name="sequence">102</field>
    </record>
    <record id="base_account_budget.menu_budget_post_form" model="ir.ui.menu">
        <field name="parent_id" ref="menu_finance_config_assets"/>
        <field name="sequence">2</field>
    </record>
</odoo>
