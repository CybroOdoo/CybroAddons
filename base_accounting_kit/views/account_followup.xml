<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Reminder plan of a company: the follow-up steps edited in place. -->
    <record id="account_followup_view_form" model="ir.ui.view">
        <field name="name">account.followup.view.form</field>
        <field name="model">account.followup</field>
        <field name="arch" type="xml">
            <form string="Reminder Plan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="company_id" options="{'no_create': True}"
                               groups="base.group_multi_company"/>
                    </group>
                    <div class="text-muted mb-3">
                        Each step fires once an invoice is the given number of days past its due date.
                        A customer gets the step of their oldest unpaid invoice; the step decides
                        whether a reminder email is sent and whether a letter can be printed.
                    </div>
                    <field name="followup_line_ids">
                        <list editable="bottom">
                            <field name="delay" width="120px"/>
                            <field name="name"/>
                            <field name="send_email"/>
                            <field name="email_template_id" optional="show"
                                   readonly="not send_email"/>
                            <field name="print_letter"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_followup_view_tree" model="ir.ui.view">
        <field name="name">account.followup.view.tree</field>
        <field name="model">account.followup</field>
        <field name="arch" type="xml">
            <list string="Reminder Plans">
                <field name="company_id"/>
                <field name="followup_line_ids" string="Steps" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="account_followup_view_search" model="ir.ui.view">
        <field name="name">account.followup.view.search</field>
        <field name="model">account.followup</field>
        <field name="arch" type="xml">
            <search string="Reminder Plans">
                <field name="company_id" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_account_followup_definition_form" model="ir.actions.act_window">
        <field name="name">Follow-up Levels</field>
        <field name="res_model">account.followup</field>
        <field name="search_view_id" ref="account_followup_view_search"/>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up your reminder plan
            </p>
            <p>
                Add steps such as "7 days late: friendly email" or "30 days late: letter",
                then send them from Customers › Follow-up Reports.
            </p>
        </field>
    </record>

    <menuitem action="action_account_followup_definition_form" id="account_followup_menu"
              parent="account.account_account_menu" name="Follow-up Levels"
              groups="base_accounting_kit.group_account_chief" sequence="2"/>
</odoo>
