<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- form view -->
    <record model="ir.ui.view" id="master_search_form">
        <field name="name">Search</field>
        <field name="model">master.search</field>
        <field name="arch" type="xml">
            <form string="Search" js_class="master_search" class="o_master_search">
                <sheet>
                    <div class="row oe_search_bgnd">
                        <div class="col-12 col-md-8 col-xl-8">
                            <label for="search_string" string="Search"/>
                            <field name="search_string" default_focus="1"
                                   class="search_input"
                                   placeholder="Type here to search..."/>
                            <button name="action_clear_search"
                                    type="object" title="Clear Search"
                                    class="oi btn_master_search"
                                    data-icon="close"/>
                            <button name="action_search"
                                    class="oi oe_search_btn btn_master_search"
                                    type="object"
                                    title="Search"
                                    data-icon="search"/>
                            <div class="not-allowed">Regular expressions are
                                not allowed in search!
                            </div>
                            <div>
                                <label for="match_entire"
                                       string="Match Phrase :"/>
                                <field name="match_entire"
                                       class="search_match_phrase"/>
                            </div>
                            <div class="search_by_block">
                                <label for="search_by" string="Search For :"
                                       class="oe_read_only"/>
                                <field name="search_by" widget="radio"
                                       options="{'horizontal': true}"/>
                            </div>
                        </div>
                        <div class="col-12 col-md-4 col-xl-4">
                            <div class="search_mode_block">
                                <label for="search_mode" string="Mode :"
                                       class="oe_read_only"/>
                                <field name="search_mode" widget="radio"
                                       nolabel="1"
                                       options="{'horizontal': false}"/>
                            </div>
                        </div>
                    </div>
                    <div class="oe_result_div">
                        <div id="recent_searches"
                             class="oe_search_tab expand_tile">
                            Recent Searches
                            <div class="history">
                                <field name="history_count"
                                       class="oe_tab_count" readonly="1"/>
                                Records Found

                                <span class="oe_drop_down">
                                    <i class="oi"
                                       title="Search"
                                       data-icon="arrow_drop_down"
                                       role="img" aria-label="Expand"/>
                                </span>
                            </div>
                        </div>
                        <div class="oe_details_list">
                            <field name="master_search_ids">
                                <list create="0" delete="0" no_open="1" class="disable_open">
                                    <field name="search_string"
                                           class="re_search oe_key"/>
                                    <field name="search_mode" string="Mode"
                                           class="re_search"/>
                                    <field name="search_by" string="Type"
                                           class="re_search"/>
                                    <button name="action_unlink_search"
                                            title="Search" type="object"
                                            class="oi" data-icon="remove"/>
                                </list>
                            </field>
                        </div>
                    </div>
                    <div class="oe_result_div">
                        <div id="customer_search_results"
                             class="oe_search_tab accordion_tab expand_tile">
                            Customer Search Results
                            <div class="history">
                                <field name="customer_count"
                                       class="oe_tab_count" readonly="1"/>
                                Records Found
                                <span class="oe_drop_down">
                                    <i class="oi"
                                       title="Search"
                                       data-icon="arrow_drop_down"
                                       role="img" aria-label="Expand"/>
                                </span>
                            </div>
                        </div>
                        <div class="oe_details_list">
                            <field name="customer_ids" context="{'active_test': False}">
                                <list create="0" delete="0">
                                    <field name="name" string="Name"/>
                                    <field name="email" string="Email"/>
                                </list>
                            </field>
                        </div>
                    </div>
                    <div class="oe_result_div">
                        <div id="product_search_results"
                             class="oe_search_tab accordion_tab expand_tile">
                            Product Search Results
                            <div class="history">
                                <field name="product_count"
                                       class="oe_tab_count" readonly="1"/>
                                Records Found
                                <span class="oe_drop_down">
                                    <i class="oi"
                                       title="Search"
                                       data-icon="arrow_drop_down"
                                       role="img" aria-label="Expand"/>
                                </span>
                            </div>
                        </div>
                        <div class="oe_details_list"
                             name="products">
                            <field name="product_ids" context="{'active_test': False}">
                                <list create="0" delete="0">
                                    <field name="name" string="Name"/>
                                    <field name="default_code"
                                           string="Code"/>
                                    <field name="description"
                                           string="Description"/>
                                    <field name="type"
                                           string="Product Type"/>
                                    <field name="categ_id"
                                           string="Category"/>
                                    <field name="uom_id" string="Base UoM"
                                           optional="hide"/>
                                    <field name="qty_available"
                                           string="Stock"/>
                                </list>
                            </field>
                        </div>
                    </div>
                    <div class="oe_result_div">
                        <div id="inventory_search_results"
                             class="oe_search_tab accordion_tab expand_tile">
                            Inventory Search Results
                            <div class="history">
                                <field name="transaction_count"
                                       class="oe_tab_count" readonly="1"/>
                                Records Found
                                <span class="oe_drop_down">
                                    <i class="oi"
                                       title="Search"
                                       data-icon="arrow_drop_down"
                                       role="img" aria-label="Expand"/>
                                </span>
                            </div>
                        </div>
                        <div class="oe_details_list">
                            <field name="transaction_ids">
                                <list create="0" delete="0">
                                    <field name="name" string="Trans. # "/>
                                    <field name="date_done"
                                           string="Transaction Date"/>
                                    <field name="picking_type_id"
                                           string="Transaction Type"/>
                                    <field name="partner_id"
                                           string="Reference Name"/>
                                    <field name="state"
                                           string="Transaction Status"/>
                                 </list>
                            </field>
                        </div>
                    </div>
                    <div class="oe_result_div">
                        <div id="sale_search_results"
                             class="oe_search_tab accordion_tab expand_tile">
                            Sale Search Results
                            <div class="history">
                                <field name="sale_count"
                                       class="oe_tab_count" readonly="1"/>
                                Records Found
                                <span class="oe_drop_down">
                                    <i class="oi oi-fw"
                                       title="Search"
                                       data-icon="arrow_drop_down"/>
                                </span>
                            </div>
                        </div>
                        <div class="oe_details_list">
                            <field name="sale_ids">
                                <list create="0" delete="0">
                                    <field name="name" string="Trans. # "/>
                                    <field name="partner_id"
                                           string="Customer"/>
                                    <field name="pricelist_id"
                                           string="Pricelist"/>
                                    <field name="payment_term_id"
                                           string="Payment Term"/>
                                    <field name="state" string="Status"/>
                                </list>
                            </field>
                        </div>
                    </div>
                    <div class="oe_result_div">
                        <div id="purchase_search_results"
                             class="oe_search_tab accordion_tab expand_tile">
                            Purchase Search Results
                            <div class="history">
                                <field name="purchase_count"
                                       class="oe_tab_count" readonly="1"/>
                                Records Found
                                <span class="oe_drop_down">
                                    <i class="oi"
                                       title="Search"
                                       data-icon="arrow_drop_down"
                                       role="img" aria-label="Expand"/>
                                </span>
                            </div>
                        </div>
                        <div class="oe_details_list">
                            <field name="purchase_ids">
                                <list create="0" delete="0">
                                    <field name="name" string="Trans. # "/>
                                    <field name="partner_id"
                                           string="Customer"/>
                                    <field name="state" string="Status"/>
                                </list>
                            </field>
                        </div>
                    </div>
                    <div class="oe_result_div">
                        <div id="accounting_search_results"
                             class="oe_search_tab accordion_tab expand_tile">
                            Accounting Search Results
                            <div class="history">
                                <field name="account_count"
                                       class="oe_tab_count" readonly="1"/>
                                Records Found
                                <span class="oe_drop_down">
                                    <i class="oi"
                                       title="Search"
                                       data-icon="arrow_drop_down"
                                       role="img" aria-label="Expand"/>
                                </span>
                            </div>
                        </div>
                        <div class="oe_details_list">
                            <field name="account_ids">
                                <list create="0" delete="0">
                                    <field name="name" string="Trans. # "/>
                                    <field name="partner_id"
                                           string="Customer"/>
                                    <field name="state" string="Status"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="master_search_action">
        <field name="name">Search</field>
        <field name="res_model">master.search</field>
        <field name="view_mode">form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <!-- Search root menu -->
    <menuitem id="master_search_root" name="Search"
              action="master_search_action"
              web_icon="master_search,static/description/icon.png"
              sequence="2" groups="master_search.master_search_read"/>
</odoo>
