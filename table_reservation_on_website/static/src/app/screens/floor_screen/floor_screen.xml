<?xml version="1.0" encoding="UTF-8" ?>
<template id="template" xml:space="preserve">
    <!-- Template inherited for adding reserved labels in pos tables -->
    <t t-name="table_reservation_on_website.Reserved_FloorScreen_table"
       t-inherit="pos_restaurant.FloorScreen"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('table')]"
               position="attributes">
            <attribute name="t-attf-class">tableId-{{table.id}} {{table.reserved ? 'reserved-border' : ''}}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('table')]/div[hasclass('info')]" position="before">
            <div class="table-reserved" t-if="table.reserved" style="position: absolute; width: 100%; top: -10px; display: flex; justify-content: center; z-index: 10;">
                <span class="reserved-label" style="background: red; color: white; border-radius: 4px; padding: 2px 5px; font-weight: bold; font-size: 12px; border: 1px solid black;">
                    Reserved
                </span>
            </div>
        </xpath>
    </t>
</template>
