<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Extends hr_attendance to add a webcam-based face recognition modal -->
     <t t-inherit="hr_attendance.public_kiosk_app" t-inherit-mode="extension">
        <xpath expr="." position="inside">
            <div id="WebCamModal"
                 class="modal"
                 style="z-index: 1050; background: rgba(0,0,0,0.5); display: none;">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Face Recognition</h5>
                        </div>
                        <div class="modal-body text-center p-0 overflow-hidden" style="height: 500px; position: relative;">
                            <video id="video" autoplay="" t-ref="video" muted=""
                                   style="width: 100%; height: 100%; object-fit: cover;"/>
                            <img id="employee_image" style="display:none;" t-ref="employee_image"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" t-on-click="onCancelRecognition">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
