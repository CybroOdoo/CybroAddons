<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Top Menu for Oil ERP -->
    <menuitem id="menu_oil_root"
              name="Oil ERP"
              web_icon="oil_erp_base,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_oil_dashboard"
              name="Dashboard"
              parent="oil_erp_base.menu_oil_root"
              action="action_oil_dashboard"
              sequence="1"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_oil_config"
              name="Configuration"
              parent="menu_oil_root"
              groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"
              sequence="100"/>

    <!-- Settings Menu -->
    <menuitem id="menu_oil_settings"
              name="Settings"
              parent="menu_oil_config"
              groups="oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"
              action="action_oil_config_settings"
              sequence="10"/>

    <menuitem id="menu_oil_config_upstream"
              name="E&amp;P Operations"
              parent="menu_oil_config"
              groups="oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"
              sequence="20"/>

    <menuitem id="menu_oil_config_midstream"
              name="Pipeline &amp; Transport"
              parent="menu_oil_config"
              groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"
              sequence="30"/>

    <menuitem id="menu_oil_config_downstream"
              name="Refinery Operations"
              parent="menu_oil_config"
              groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"
              sequence="40"/>

    <!-- Upstream Menu -->
    <menuitem id="menu_oil_upstream_root"
              name="E&amp;P Operations"
              parent="oil_erp_base.menu_oil_root"
              sequence="20"/>
    <!-- Midstream Menu -->
    <menuitem id="menu_oil_midstream_root"
              name="Pipeline &amp; Transport"
              parent="oil_erp_base.menu_oil_root"
              sequence="22"/>
    <menuitem id="menu_oil_downstream_root"
              name="Refinery Operations"
              parent="oil_erp_base.menu_oil_root"
              sequence="23"/>
    <menuitem id="menu_sale_purchase"
              name="Sale/Purchase"
              parent="oil_erp_base.menu_oil_root"
              sequence="19"/>

    <menuitem id="menu_sale_orders"
              name="Sale Orders"
              parent="menu_sale_purchase"
              action="sale.action_orders"
              sequence="10"/>

    <menuitem id="menu_purchase_orders"
              name="Purchase Orders"
              parent="menu_sale_purchase"
              action="purchase.purchase_form_action"
              sequence="20"/>

    <!-- Master Data Menu -->
    <menuitem id="menu_oil_master_data_root"
              name="Product Configuration"
              parent="menu_oil_config"
              sequence="15"/>

    <menuitem id="menu_oil_product_all"
              name="Product"
              parent="menu_oil_master_data_root"
              action="product.product_template_action"
              sequence="10"/>

    <menuitem id="menu_oil_uom_all"
              name="Units of Measure"
              parent="menu_oil_master_data_root"
              action="uom.product_uom_form_action"
              groups="uom.group_uom"
              sequence="20"/>

    <!-- Procurement Menu -->
    <menuitem id="menu_oil_procurement_root"
              name="Procurement"
              parent="menu_oil_config"
              sequence="25"/>

</odoo>
