<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the dashboard views. -->
    <record id="action_oil_dashboard" model="ir.actions.client">
        <field name="name">Oil Dashboard</field>
        <field name="tag">oil_base.dashboard</field>
    </record>

    <record id="action_oil_dashboard_upstream" model="ir.actions.client">
        <field name="name">E&amp;P Operations</field>
        <field name="tag">oil_upstream.dashboard</field>
        <field name="context">{'operation': 'upstream'}</field>
    </record>

    <record id="action_oil_dashboard_midstream" model="ir.actions.client">
        <field name="name">Pipeline &amp; Transport</field>
        <field name="tag">oil_midstream.dashboard</field>
        <field name="context">{'operation': 'midstream'}</field>
    </record>

    <record id="action_oil_dashboard_downstream" model="ir.actions.client">
        <field name="name">Refinery Operations</field>
        <field name="tag">oil_downstream.dashboard</field>
        <field name="context">{'operation': 'downstream'}</field>
    </record>
</odoo>
