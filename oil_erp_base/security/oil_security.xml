<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the oil ERP security rules and groups. -->
    <data noupdate="1">
        <!-- Module Category -->
        <record id="module_category_oil_erp" model="ir.module.category">
            <field name="name">Oil ERP</field>
            <field name="description">Helps you manage your Oil
                &amp; Gas ERP processes.
            </field>
            <field name="sequence">1</field>
        </record>

        <!-- Module Privilege -->
        <record id="res_groups_privilege_oil" model="res.groups.privilege">
            <field name="name">Oil Erp</field>
            <field name="description">Helps you track, manage, and improve
                your environmental, social, and governance (ESG) impact.
            </field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_oil_erp"/>
        </record>

        <!-- User Group -->
        <record id="group_oil_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_oil"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The user will have basic access to
                Oil ERP features.
            </field>
        </record>

        <!-- Manager Group -->
        <record id="group_oil_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_oil"/>
            <field name="implied_ids" eval="[(4, ref('group_oil_user'))]"/>
            <field name="user_ids"
                   eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">The user will have full access to Oil
                ERP features.
            </field>
        </record>

        <!-- Admin group -->
        <record id="group_oil_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_oil"/>
            <field name="implied_ids" eval="[(4, ref('group_oil_manager'))]"/>
            <field name="user_ids"
                   eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">The user will have administrative access
                to all Oil ERP features.
            </field>
        </record>

    </data>
</odoo>
