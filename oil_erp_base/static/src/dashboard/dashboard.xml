<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="oil_erp_base.OilDashboard">
        <div class="o_oil_dashboard">
            <t t-if="state.isLoading">
                <div class="d-flex justify-content-center align-items-center"
                     style="min-height: 400px;">
                    <div class="text-center">
                        <div class="spinner-border text-primary mb-3"
                             role="status" style="width: 3rem; height: 3rem;"/>
                        <p class="text-muted">Fetching live market data from all configured APIs...</p>
                    </div>
                </div>
            </t>

            <t t-else="">
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h3 class="mb-0">
                                <i class="fa fa-tachometer me-2"/>
                                Dashboard
                            </h3>
                            <small class="text-muted">
                                Live global markets &amp; internal operations
                                <t t-if="state.lastRefresh">
                                    · Updated <t t-esc="state.lastRefresh"/>
                                </t>
                            </small>
                        </div>
                        <button class="btn btn-outline-secondary btn-sm"
                                t-on-click="onRefresh" title="Refresh">
                            <i class="fa fa-refresh me-1"/>Refresh
                        </button>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-xl-3 col-md-6">
                            <div class="card border-0 shadow-sm h-100 o_oil_kpi_card o_oil_kpi_card--brent">
                                <div class="card-body text-white p-3">
                                    <small class="o_oil_kpi_eyebrow text-uppercase fw-bold">
                                        Brent Crude
                                    </small>
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div>
                                            <h2 class="mb-0 o_oil_kpi_value">
                                                <t t-if="state.brentPrice">
                                                    <span class="o_oil_kpi_unit">$</span>
                                                    <t t-esc="state.brentPrice"/>
                                                </t>
                                                <t t-else=""><span class="o_oil_kpi_placeholder">—</span></t>
                                            </h2>
                                            <small class="o_oil_kpi_meta">
                                                <t t-esc="state.brentDate"/>
                                                · $/BBL · <t t-esc="state.brentSource"/>
                                            </small>
                                        </div>
                                        <i class="fa fa-line-chart fa-2x o_oil_kpi_icon"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <div class="card border-0 shadow-sm h-100 o_oil_kpi_card o_oil_kpi_card--wti">
                                <div class="card-body text-white p-3">
                                    <small class="o_oil_kpi_eyebrow text-uppercase fw-bold">
                                        WTI Crude
                                    </small>
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div>
                                            <h2 class="mb-0 o_oil_kpi_value">
                                                <t t-if="state.wtiPrice">
                                                    <span class="o_oil_kpi_unit">$</span>
                                                    <t t-esc="state.wtiPrice"/>
                                                </t>
                                                <t t-else=""><span class="o_oil_kpi_placeholder">—</span></t>
                                            </h2>
                                            <small class="o_oil_kpi_meta">
                                                <t t-esc="state.wtiDate"/>
                                                · $/BBL · <t t-esc="state.wtiSource"/>
                                            </small>
                                        </div>
                                        <i class="fa fa-area-chart fa-2x o_oil_kpi_icon"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <div class="card border-0 shadow-sm h-100 o_oil_kpi_card o_oil_kpi_card--rig">
                                <div class="card-body text-white p-3">
                                    <small class="o_oil_kpi_eyebrow text-uppercase fw-bold">
                                        Natural Gas
                                    </small>
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div>
                                            <h2 class="mb-0 o_oil_kpi_value">
                                                <t t-if="state.naturalGasPrice">
                                                    <span class="o_oil_kpi_unit">$</span>
                                                    <t t-esc="state.naturalGasPrice"/>
                                                </t>
                                                <t t-else=""><span class="o_oil_kpi_placeholder">—</span></t>
                                            </h2>
                                            <small class="o_oil_kpi_meta">
                                                <t t-esc="state.naturalGasDate"/>
                                                · NYMEX · <t t-esc="state.naturalGasSource"/>
                                            </small>
                                        </div>
                                        <i class="fa fa-industry fa-2x o_oil_kpi_icon"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <div class="card border-0 shadow-sm h-100 o_oil_kpi_card o_oil_kpi_card--production">
                                <div class="card-body text-white p-3">
                                    <small class="o_oil_kpi_eyebrow text-uppercase fw-bold">
                                        Henry Hub Gas
                                    </small>
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div>
                                            <h2 class="mb-0 o_oil_kpi_value">
                                                <t t-if="state.henryHubPrice">
                                                    <span class="o_oil_kpi_unit">$</span>
                                                    <t t-esc="state.henryHubPrice"/>
                                                </t>
                                                <t t-else=""><span class="o_oil_kpi_placeholder">—</span></t>
                                            </h2>
                                            <small class="o_oil_kpi_meta">
                                                <t t-esc="state.henryHubDate"/>
                                                · Benchmark · <t t-esc="state.henryHubSource"/>
                                            </small>
                                        </div>
                                        <i class="fa fa-bar-chart fa-2x o_oil_kpi_icon"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div t-att-class="showCombinedEmptyState ? 'col-12' : 'col-lg-8'">
                            <div class="card shadow-sm border-0 o_oil_dashboard_panel o_oil_dashboard_panel--country">
                                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">
                                        <i class="fa fa-globe me-2"/>
                                        Live Gas &amp; Refined Products
                                    </h6>
                                    <div class="d-flex align-items-center" t-if="state.commodityData.length &amp;&amp; !showCombinedEmptyState">
                                        <div class="input-group input-group-sm me-3" style="width: 200px;">
                                            <span class="input-group-text bg-light border-end-0">
                                                <i class="fa fa-search text-muted"/>
                                            </span>
                                            <input type="text"
                                                   class="form-control border-start-0 ps-0"
                                                   placeholder="Search gas/product..."
                                                   t-on-input="onSearchInput"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-0 o_oil_dashboard_panel_body o_oil_dashboard_panel_body--country" style="max-height: 620px; overflow-y: auto;">
                                    <t t-if="state.commodityData.length">
                                        <table class="table table-hover mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 40px;">#</th>
                                                    <th>Commodity</th>
                                                    <th class="text-end" style="width: 120px;">Price</th>
                                                    <th style="width: 40%;">Market Level</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="filteredCommodityData" t-as="c" t-key="c.id">
                                                    <tr>
                                                        <td class="text-muted fw-bold">
                                                            <t t-esc="c_index + 1"/>
                                                        </td>
                                                        <td>
                                                            <strong t-esc="c.commodity"/>
                                                            <br/>
                                                            <small class="text-muted">
                                                                <t t-esc="c.period"/> · <t t-esc="c.source"/>
                                                            </small>
                                                        </td>
                                                        <td class="text-end fw-bold">
                                                            $<t t-esc="c.value"/>
                                                        </td>
                                                        <td>
                                                            <div class="progress" style="height: 22px;">
                                                                <div class="progress-bar"
                                                                     role="progressbar"
                                                                     t-att-style="'width:' + c.pct + '%'"
                                                                     t-attf-class="progress-bar {{ c_index === 0 ? 'bg-danger' : c_index &lt; 3 ? 'bg-warning' : 'bg-primary' }}">
                                                                    <small t-esc="c.value"/>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>
                                    <t t-else="">
                                        <div class="p-4 text-center text-muted">
                                            <i class="fa fa-globe fa-3x mb-3 d-block"/>
                                            <h5>No Data Available</h5>
                                            <p>
                                                <t t-if="showCombinedEmptyState">
                                                    To view live commodity prices and live news, configure your API integrations.
                                                </t>
                                                <t t-else="">
                                                    To view live commodity prices, please configure your Live Oil Price API key.
                                                </t>
                                            </p>
                                            <br/>
                                            <p class="mb-1"><strong>Steps:</strong></p>
                                            <ol class="text-start d-inline-block text-muted small">
                                                <li>Go to <b>Settings</b></li>
                                                <li>Open the <b>Oil ERP</b> settings section</li>
                                                <t t-if="showCombinedEmptyState">
                                                    <li>Enable <b>Real-Time Energy Benchmarks</b> and <b>News Integration</b></li>
                                                    <li>Enter your <b>News API Key</b></li>
                                                </t>
                                                <t t-else="">
                                                    <li>Enable <b>Real-Time Energy Benchmarks</b></li>
                                                </t>
                                                <li>Click <b>Save</b></li>
                                            </ol>
                                            <div class="o_oil_empty_actions" t-if="state.canConfigure">
                                                <p class="text-muted small mb-0">
                                                    Or click the <b>Configure</b> button.
                                                </p>
                                                <button class="btn btn-primary btn-sm" t-on-click="onConfigure"
                                                        title="Configure Settings">
                                                    <i class="fa fa-cog me-1"/>Configure
                                                </button>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4" t-if="!showCombinedEmptyState">
                            <div class="card shadow-sm border-0 h-100 o_oil_dashboard_panel o_oil_dashboard_panel--sources">
                                <div class="card-header bg-white border-bottom">
                                    <h6 class="mb-0">
                                        <i class="fa fa-newspaper-o me-2"/>
                                        Live Energy News
                                    </h6>
                                </div>
                                <div class="card-body o_oil_dashboard_panel_body o_oil_dashboard_panel_body--sources">
                                    <div class="o_oil_news_feed">
                                        <div class="o_oil_news_feed_list">
                                            <t t-if="hasNewsArticles">
                                                <t t-foreach="state.newsArticles" t-as="article" t-key="article.id">
                                                    <a t-att-href="article.url"
                                                       target="_blank"
                                                       rel="noopener noreferrer"
                                                       class="o_oil_news_item text-decoration-none d-block">
                                                        <div class="d-flex align-items-center mb-1">
                                                            <span class="badge" t-esc="article.source"/>
                                                            <span class="fw-bold ms-2 text-dark" t-esc="article.title"/>
                                                        </div>
                                                        <div class="text-muted small" t-esc="article.publishedAt"/>
                                                        <div class="o_oil_news_description text-muted" t-esc="article.description"/>
                                                    </a>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <div class="o_oil_news_empty text-center text-muted">
                                                    <i class="fa fa-newspaper-o fa-3x mb-3 d-block"/>
                                                    <h5 class="text-dark mb-2">No News Available</h5>
                                                    <p class="mb-3">
                                                        To view live energy headlines, configure your news API settings.
                                                    </p>
                                                    <p class="mb-1">
                                                        <strong>Steps:</strong>
                                                    </p>
                                                    <ol class="text-start d-inline-block text-muted small mb-3">
                                                        <li>Go to <b>Settings</b></li>
                                                        <li>Open the <b>Oil ERP</b> settings section</li>
                                                        <li>Find <b>Enable News Integration</b></li>
                                                        <li>Enter your <b>News API Key</b></li>
                                                        <li>Click <b>Save</b></li>
                                                    </ol>
                                                    <div class="o_oil_empty_actions" t-if="state.canConfigure">
                                                        <p class="text-muted small mb-0">
                                                            Or click the <b>Configure</b> button.
                                                        </p>
                                                        <button class="btn btn-primary btn-sm" t-on-click="onConfigure"
                                                                title="Configure Settings">
                                                            <i class="fa fa-cog me-1"/>Configure
                                                        </button>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
