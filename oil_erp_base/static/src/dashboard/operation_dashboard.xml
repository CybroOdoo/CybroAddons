<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="oil_erp_base.OperationDashboard">
        <div class="oil-dashboard-container">
            <div class="oil-dashboard-shell">
                <div class="oil-dashboard-header">
                    <div class="oil-dashboard-heading">
                        <span class="oil-dashboard-eyebrow">Operational Analytics</span>
                        <h1><i class="fa fa-braille me-2"/><t t-esc="state.title"/></h1>
                        <p class="oil-dashboard-subtitle">Live KPIs, charts, and summary cards for day-to-day operational visibility.</p>
                    </div>
                    <div class="oil-dashboard-controls">
                        <button class="btn btn-sm oil-dashboard-refresh-btn" t-on-click="_fetchDashboardData">
                            <i class="fa fa-refresh me-1"/> Refresh
                        </button>
                    </div>
                </div>

                <div t-if="state.isLoading" class="oil-dashboard-loading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>

                <div t-else="" class="oil-dashboard-content">
                    <div t-if="state.error" class="alert alert-warning oil-dashboard-alert" role="alert">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <span t-esc="state.error"/>
                    </div>

                    <div class="oil-dashboard-tiles row">
                        <t t-foreach="state.data.tiles || []" t-as="tile" t-key="tile.id">
                            <div class="col-12 col-md-6 col-xl-3 mb-4">
                                <div class="oil-dashboard-tile h-100" t-on-click="() => this.onTileClick(tile)">
                                    <div class="tile-label" t-esc="tile.label"/>

                                    <div class="tile-value">
                                        <t t-if="tile.value and tile.value.toString().startsWith('$')">
                                            <span class="unit-prefix">$</span>
                                            <t t-esc="tile.value.toString().substring(1)"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="tile.value"/>
                                        </t>
                                    </div>

                                    <div class="tile-footer">
                                        <div class="tile-trend-info">
                                            <div class="tile-trend" t-if="tile.trend">
                                                <span t-attf-class="trend-pct #{tile.trend > 0 ? 'text-success' : 'text-danger'}">
                                                    <i t-attf-class="fa #{tile.trend > 0 ? 'fa-caret-up' : 'fa-caret-down'}"/>
                                                    <t t-esc="Math.abs(tile.trend)"/>%
                                                </span>
                                            </div>
                                        </div>
                                        <div class="tile-icon">
                                            <i t-attf-class="fa #{tile.icon || 'fa-line-chart'}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="oil-dashboard-charts row" t-if="(state.data.charts || []).length > 0">
                        <t t-foreach="state.data.charts" t-as="chart" t-key="chart.id">
                            <div t-attf-class="col-12 col-lg-#{chart.width || 6} mb-4">
                                <div class="oil-dashboard-chart-card">
                                    <div class="chart-header">
                                        <h3 t-esc="chart.title"/>
                                        <span class="section-chip">Chart</span>
                                    </div>
                                    <div class="card-body-content chart-container">
                                        <canvas t-attf-id="chart_#{chart.id}" t-ref="chart_#{chart.id}"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="oil-dashboard-summary row" t-if="(state.data.metrics || []).length > 0">
                        <div class="col-12">
                            <div class="oil-dashboard-kpi-card">
                                <div class="kpi-header">
                                    <div>
                                        <h3>Operational Insights</h3>
                                        <p>Performance indicators arranged as quick-read metric cards.</p>
                                    </div>
                                    <span class="section-chip">KPI</span>
                                </div>
                                <div class="card-body-content">
                                    <div class="kpi-grid">
                                        <t t-foreach="state.data.metrics || []" t-as="metric" t-key="metric.id">
                                            <div class="kpi-item">
                                                <div class="kpi-label" t-esc="metric.label"/>
                                                <div class="kpi-value" t-esc="metric.value"/>
                                                <div class="kpi-desc" t-if="metric.description" t-esc="metric.description"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="oil-dashboard-highlights row" t-if="(state.data.highlights || []).length > 0">
                        <t t-foreach="state.data.highlights" t-as="highlight" t-key="highlight.id">
                            <div class="col-12 col-md-6 col-lg-4 mb-4 d-flex align-items-stretch">
                                <div class="oil-dashboard-highlight-card w-100">
                                    <div class="highlight-header">
                                        <h3 t-esc="highlight.title"/>
                                        <span class="section-chip">Summary</span>
                                    </div>
                                    <div class="card-body-content">
                                        <ul class="highlight-list">
                                            <t t-foreach="highlight.items || []" t-as="item" t-key="item.label">
                                                <li class="highlight-item">
                                                    <span class="highlight-label" t-esc="item.label"/>
                                                    <span class="highlight-value" t-esc="item.value"/>
                                                </li>
                                            </t>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div t-if="(state.data.tiles || []).length === 0 and (state.data.charts || []).length === 0 and (state.data.metrics || []).length === 0" class="oil-dashboard-empty">
                        <img src="/oil_erp_base/static/src/img/empty_dashboard.svg" alt="Empty Dashboard" style="width: 200px; opacity: 0.5;"/>
                        <p class="mt-3 text-muted">No data available for this operation yet.</p>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
