<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.view.form.inherit.mrp.split.produce</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Add tracking fields (hidden) -->
            <xpath expr="//field[@name='show_produce_all']" position="after">
                <field name="is_partially_produced" readonly="1" invisible="1"/>
                <field name="is_finalized" readonly="1" invisible="1"/>
            </xpath>
            <!-- Hide default button_mark_done buttons -->
            <xpath expr="//header/button[@name='button_mark_done'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_mark_done'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_mark_done'][3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_mark_done'][4]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Produce All button after Confirm -->
            <xpath expr="//header/button[@name='action_confirm']" position="after">
                <button name="action_produce_all_custom"
                        invisible="is_partially_produced or state in ('done','cancel', 'draft')"
                        string="Consume Components"
                        type="object"
                        class="oe_highlight"
                        data-hotkey="g"/>
            </xpath>
            <!-- Finalize Production button -->
            <xpath expr="//header" position="inside">
                <button name="action_finalize_mo"
                        invisible="not is_partially_produced or is_finalized or state in ('done','cancel')"
                        string="Finalize Production"
                        type="object"
                        class="oe_highlight"
                        data-hotkey="shift+g"/>
            </xpath>
        </field>
    </record>
</odoo>
