<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_split" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.split</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Tracking fields -->
            <xpath expr="//field[@name='show_produce_all']" position="after">
                <field name="is_partially_produced" readonly="1" invisible="1"/>
                <field name="is_finalized" readonly="1" invisible="1"/>
            </xpath>

            <!-- Hide default mark as done buttons -->
            <xpath expr="//header/button[@name='button_mark_done'][@invisible='not move_raw_ids or not show_produce']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_mark_done'][@invisible='not move_raw_ids or not show_produce_all']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_mark_done'][@invisible='move_raw_ids or not show_produce']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_mark_done'][@invisible='move_raw_ids or not show_produce_all']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Produce All button -->
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_produce_all_custom"
                        invisible="not move_raw_ids or not show_produce_all or is_partially_produced or state == 'done' or state == 'cancel'"
                        string="Produce All"
                        type="object"
                        class="oe_highlight"
                        data-hotkey="g"/>
            </xpath>

            <!-- Finalize Production button -->
            <xpath expr="//header" position="inside">
                <button name="action_finalize_mo"
                        invisible="not is_partially_produced or is_finalized or state == 'done'"
                        string="Finalize Production"
                        type="object"
                        class="oe_highlight"
                        data-hotkey="shift+g"/>
            </xpath>
        </field>
    </record>
</odoo>
