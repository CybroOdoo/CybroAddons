<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.Orderline" t-inherit="point_of_sale.Orderline"
          t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('info-list')]" position="inside">
            <t t-if="this.line.salesperson || this.line.user_id?.name">
                <li class="price-per-unit">
                    Salesperson: <t t-out="this.line.salesperson || this.line.user_id.name"/>
                </li>
            </t>
        </xpath>
    </t>
</templates>
