<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="salesperson_pos_order_line.ControlButtons"
       t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="!this.props.showRemainingButtons"
                    t-attf-class="{{ this.buttonClass }}" t-on-click="() => this.onClickSalesperson()">
                <i class="fa fa-user" role="img" aria-label="Salesperson"
                   title="Salesperson"/>
                <span>Salesperson</span>
            </button>
        </xpath>
    </t>
</templates>
