<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== SEQUENCES ===== -->
    <record id="seq_oil_esg_emission" model="ir.sequence">
        <field name="name">ESG Emission Reference</field>
        <field name="code">oil.esg.emission</field>
        <field name="prefix">ESG/EM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_oil_esg_energy" model="ir.sequence">
        <field name="name">ESG Energy Reference</field>
        <field name="code">oil.esg.energy</field>
        <field name="prefix">ESG/EN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_oil_esg_water" model="ir.sequence">
        <field name="name">ESG Water Reference</field>
        <field name="code">oil.esg.water</field>
        <field name="prefix">ESG/WT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
