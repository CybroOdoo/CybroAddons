<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- This file defines the esg compliance views. -->
<record id="view_oil_esg_compliance_form" model="ir.ui.view">
        <field name="name">oil.esg.compliance.form</field>
        <field name="model">oil.esg.compliance</field>
        <field name="arch" type="xml">
            <form string="Compliance Record">
                <header>
                    <button name="action_set_review" type="object"
                            string="In Review"
                            class="btn-primary"
                            invisible="status not in ['not_started', 'gap']"/>
                    <button name="action_set_compliant" type="object"
                            string="Mark Compliant"
                            class="btn-success"
                            invisible="status != 'in_review'"/>
                    <button name="action_set_gap" type="object"
                            string="Flag Gap"
                            class="btn-warning"
                            invisible="status not in ['in_review', 'compliant']"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="not_started,in_review,compliant"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Framework Name"/>
                        </h1>
                        <field name="code"/>
                    </div>
                    <group>
                        <group string="Framework Details">
                            <field name="framework_type"/>
                            <field name="business_segment"/>
                            <field name="scope_description"/>
                            <field name="auditor"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Dates">
                            <field name="deadline_date"/>
                            <field name="last_audit_date"/>
                            <field name="next_audit_date"/>
                            <field name="certificate_expiry"/>
                        </group>
                    </group>
                    <group string="Findings">
                        <group>
                            <field name="findings_critical"/>
                            <field name="findings_major"/>
                        </group>
                        <group>
                            <field name="findings_minor"/>
                            <field name="findings_open" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"
                                   placeholder="Framework requirements and scope..."/>
                        </page>
                        <page string="Gap &amp; Action Plan">
                            <field name="gap_description"
                                   placeholder="Describe any gaps or non-conformances..."/>
                            <field name="action_plan"
                                   placeholder="Corrective action plan..."/>
                        </page>
                        <page string="Notes &amp; Documents">
                            <field name="notes"/>
                            <field name="attachment_ids"
                                   widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_oil_esg_compliance_tree" model="ir.ui.view">
        <field name="name">oil.esg.compliance.tree</field>
        <field name="model">oil.esg.compliance</field>
        <field name="arch" type="xml">
            <list string="Compliance &amp; Audits"
                  decoration-success="status=='compliant'"
                  decoration-warning="status=='in_review'"
                  decoration-danger="status=='gap' or status=='expired'">
                <field name="name"/>
                <field name="framework_type"/>
                <field name="business_segment" optional="show"/>
                <field name="scope_description"/>
                <field name="auditor"/>
                <field name="responsible_id"/>
                <field name="deadline_date"/>
                <field name="next_audit_date"/>
                <field name="findings_open"/>
                <field name="status" widget="badge"
                       decoration-success="status=='compliant'"
                       decoration-warning="status=='in_review'"
                       decoration-danger="status in ['gap','expired']"
                       decoration-muted="status=='not_started'"/>
            </list>
        </field>
    </record>

    <record id="view_oil_esg_compliance_search" model="ir.ui.view">
        <field name="name">oil.esg.compliance.search</field>
        <field name="model">oil.esg.compliance</field>
        <field name="arch" type="xml">
            <search string="Search Compliance">
                <field name="name"/>
                <field name="framework_type"/>
                <separator/>
                <filter string="Compliant" name="compliant"
                        domain="[('status','=','compliant')]"/>
                <filter string="Gaps Found" name="gap"
                        domain="[('status','=','gap')]"/>
                <filter string="In Review" name="review"
                        domain="[('status','=','in_review')]"/>
                <group name="group_by">
                    <filter string="Framework" name="group_fw"
                            context="{'group_by': 'framework_type'}"/>
                    <filter string="Business Segment" name="group_segment"
                            context="{'group_by': 'business_segment'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oil_esg_compliance" model="ir.actions.act_window">
        <field name="name">Regulatory Compliance</field>
        <field name="res_model">oil.esg.compliance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first compliance
                framework!
            </p>
            <p>Track GHG Protocol, IPIECA, TCFD, EU Taxonomy, and all regulatory
                requirements.
            </p>
        </field>
    </record>

</odoo>
