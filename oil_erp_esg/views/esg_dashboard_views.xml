<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ESG Dashboard (acts as a landing action) -->
    <record id="view_oil_esg_dashboard" model="ir.ui.view">
        <field name="name">oil.esg.dashboard</field>
        <field name="model">oil.esg.emission</field>
        <field name="arch" type="xml">
            <graph string="GHG Emissions Dashboard" type="bar">
                <field name="period_month" type="row"/>
                <field name="quantity_co2e" type="measure"/>
                <field name="scope" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Dashboard action — opens a graph of emissions as the ESG home -->
    <record id="action_oil_esg_dashboard" model="ir.actions.act_window">
        <field name="name">ESG Dashboard</field>
        <field name="res_model">oil.esg.emission</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_this_year': 1, 'search_default_group_scope': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Welcome to PetroCare ESG!</p>
            <p>Start by adding your
                <a href="#" data-model="oil.esg.site">field sites</a>
                and then log your first emission record.
            </p>
        </field>
    </record>

</odoo>
