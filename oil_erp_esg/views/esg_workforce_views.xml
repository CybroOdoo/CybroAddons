<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Workforce / Social Views -->
    <record id="view_oil_esg_workforce_form" model="ir.ui.view">
        <field name="name">oil.esg.workforce.form</field>
        <field name="model">oil.esg.workforce</field>
        <field name="arch" type="xml">
            <form string="Workforce &amp; Social KPIs">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="period_year" readonly="1"/>
                            <field name="period_month" readonly="1"/>
                            <field name="site_id"/>
                            <field name="business_segment"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Headcount &amp; Diversity" name="headcount_diversity">
                            <group>
                                <group>
                                    <field name="total_employees"/>
                                    <field name="pay_gap_pct"/>
                                </group>
                                <group>
                                    <field name="local_employees"/>
                                    <field name="local_hire_ratio" readonly="1"/>
                                    <field name="contractor_count"/>
                                    <field name="nationalities"/>
                                </group>
                            </group>
                        </page>
                        <page string="Training" name="training">
                            <group>
                                <field name="training_hours"/>
                                <field name="safety_training_hours"/>
                                <field name="training_hrs_per_employee" readonly="1"/>
                            </group>
                        </page>
                        <page string="Community" name="community">
                            <group>
                                <field name="community_investment"/>
                                <field name="beneficiaries"/>
                                <field name="grievances_total"/>
                                <field name="grievances_resolved"/>
                                <field name="grievance_resolution_rate" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes_page">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_oil_esg_workforce_tree" model="ir.ui.view">
        <field name="name">oil.esg.workforce.tree</field>
        <field name="model">oil.esg.workforce</field>
        <field name="arch" type="xml">
            <list string="Workforce &amp; Social KPIs">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="period_year"/>
                <field name="period_month"/>
                <field name="site_id"/>
                <field name="business_segment" optional="show"/>
                <field name="total_employees"/>
                <field name="local_hire_ratio"/>
                <field name="pay_gap_pct"/>
                <field name="training_hours"/>
                <field name="community_investment"/>
            </list>
        </field>
    </record>

    <record id="action_oil_esg_workforce" model="ir.actions.act_window">
        <field name="name">Workforce &amp; Social</field>
        <field name="res_model">oil.esg.workforce</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your workforce and social KPI data!</p>
        </field>
    </record>

</odoo>
