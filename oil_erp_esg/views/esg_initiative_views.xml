<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- This file defines the esg initiative views. -->
    <record id="view_oil_esg_initiative_form" model="ir.ui.view">
        <field name="name">oil.esg.initiative.form</field>
        <field name="model">oil.esg.initiative</field>
        <field name="arch" type="xml">
            <form string="ESG Initiative">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'idea'"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-success" invisible="state != 'inprogress'"/>
                    <button name="action_hold" type="object" string="Put On Hold"
                            invisible="state not in ['inprogress', 'approved']"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ['idea', 'approved', 'inprogress', 'onhold']"/>
                    <button name="action_reset" type="object" string="Reset to Idea"
                            invisible="state not in ['cancelled', 'onhold']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="idea,approved,inprogress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-flag">
                            <field name="milestone_done_count" widget="statinfo"
                                   string="Done" nolabel="0"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-list">
                            <field name="milestone_count" widget="statinfo"
                                   string="Milestones" nolabel="0"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Initiative Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="pillar"/>
                            <field name="category"/>
                            <field name="segment"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Ownership &amp; Dates">
                            <field name="owner_id"/>
                            <field name="start_date"/>
                            <field name="target_date"/>
                            <field name="completion_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Progress &amp; Budget">
                            <field name="progress" widget="progressbar"/>
                            <field name="budget"/>
                            <field name="actual_spend"/>
                            <field name="budget_used_pct" readonly="1" widget="progressbar"/>
                        </group>
                        <group string="KPI Tracking">
                            <field name="kpi_baseline"/>
                            <field name="kpi_target"/>
                            <field name="kpi_current"/>
                            <field name="kpi_unit"/>
                        </group>
                    </group>
                    <field name="site_ids" widget="many2many_tags"/>
                    <field name="description" placeholder="Describe this initiative..."/>
                    <notebook>
                        <page string="Milestones">
                            <field name="milestone_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="done" widget="boolean_toggle"/>
                                    <field name="completion_date"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes &amp; Documents">
                            <field name="notes"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_oil_esg_initiative_tree" model="ir.ui.view">
        <field name="name">oil.esg.initiative.tree</field>
        <field name="model">oil.esg.initiative</field>
        <field name="arch" type="xml">
            <list string="ESG Initiatives"
                  decoration-success="state=='done'"
                  decoration-warning="state=='onhold'"
                  decoration-muted="state in ['idea','cancelled']">
                <field name="name"/>
                <field name="pillar" widget="badge"/>
                <field name="category"/>
                <field name="segment"/>
                <field name="owner_id"/>
                <field name="target_date"/>
                <field name="progress" widget="progressbar"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-success="state=='done'"
                       decoration-info="state=='inprogress'"
                       decoration-warning="state=='onhold'"
                       decoration-muted="state in ['idea','cancelled']"/>
            </list>
        </field>
    </record>

    <record id="view_oil_esg_initiative_search" model="ir.ui.view">
        <field name="name">oil.esg.initiative.search</field>
        <field name="model">oil.esg.initiative</field>
        <field name="arch" type="xml">
            <search string="Search Initiatives">
                <field name="name"/>
                <field name="owner_id"/>
                <separator/>
                <filter string="Environmental" name="env"
                        domain="[('pillar','=','E')]"/>
                <filter string="Social" name="social"
                        domain="[('pillar','=','S')]"/>
                <filter string="Governance" name="gov"
                        domain="[('pillar','=','G')]"/>
                <separator/>
                <filter string="In Progress" name="inprogress"
                        domain="[('state','=','inprogress')]"/>
                <filter string="Completed" name="done"
                        domain="[('state','=','done')]"/>
                <group name="group_by">
                    <filter string="Pillar" name="group_pillar" context="{'group_by': 'pillar'}"/>
                    <filter string="Category" name="group_cat" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oil_esg_initiative" model="ir.actions.act_window">
        <field name="name">ESG Initiatives</field>
        <field name="res_model">oil.esg.initiative</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first ESG initiative!</p>
            <p>Track decarbonisation, social, and governance initiatives from idea to completion.</p>
        </field>
    </record>

</odoo>
