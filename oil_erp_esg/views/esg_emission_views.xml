<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ SITE VIEWS ============ -->
    <record id="view_oil_esg_site_form" model="ir.ui.view">
        <field name="name">oil.esg.site.form</field>
        <field name="model">oil.esg.site</field>
        <field name="arch" type="xml">
            <form string="Field Site">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_emissions" type="object"
                                class="oe_stat_button" icon="fa-fire">
                            <field name="emission_count" widget="statinfo" string="Emissions"/>
                        </button>
                        <button name="action_view_energy" type="object"
                                class="oe_stat_button" icon="fa-bolt">
                            <field name="energy_count" widget="statinfo" string="Energy"/>
                        </button>
                        <button name="action_view_hse" type="object"
                                class="oe_stat_button" icon="fa-medkit">
                            <field name="hse_count" widget="statinfo" string="HSE"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Site Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Operational Links">
                            <field name="business_segment"/>
                            <field name="project_id"
                                   invisible="business_segment != 'upstream'"/>
                            <field name="workcenter_id"
                                   invisible="business_segment != 'downstream'"/>
                            <field name="operation_id"
                                   invisible="business_segment != 'downstream'"/>
                            <field name="midstream_link_type"
                                   invisible="business_segment != 'midstream'"/>
                            <field name="delivery_method_id"
                                   invisible="business_segment != 'midstream' or midstream_link_type != 'pipeline'"/>
                            <field name="location_id"
                                   invisible="business_segment != 'midstream' or midstream_link_type != 'transfer'"/>
                            <field name="vehicle_id"
                                   invisible="business_segment != 'midstream' or midstream_link_type != 'fleet'"/>
                            <field name="code"/>
                            <field name="site_type"/>
                            <field name="operator_id"/>
                            <field name="production_capacity"/>
                        </group>
                        <group string="Location">
                            <field name="country_id"/>
                            <field name="state_id"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes about this site..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_oil_esg_site_tree" model="ir.ui.view">
        <field name="name">oil.esg.site.tree</field>
        <field name="model">oil.esg.site</field>
        <field name="arch" type="xml">
            <list string="Sites">
                <field name="business_segment"/>
                <field name="project_id" optional="hide"/>
                <field name="code"/>
                <field name="name"/>
                <field name="site_type"/>
                <field name="country_id"/>
                <field name="operator_id"/>
                <field name="production_capacity"/>
                <field name="emission_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_oil_esg_site" model="ir.actions.act_window">
        <field name="name">Field Sites</field>
        <field name="res_model">oil.esg.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first field site!</p>
            <p>Add all oil &amp; gas sites, refineries, and facilities.</p>
        </field>
    </record>

    <!-- ============ HSE INCIDENT ESG LINK ============ -->
    <record id="view_oil_hse_incident_form_inherit_esg_site" model="ir.ui.view">
        <field name="name">oil.hse.incident.form.inherit.esg.site</field>
        <field name="model">oil.hse.incident</field>
        <field name="inherit_id" ref="oil_erp_hse.view_oil_hse_incident_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='location_people']//field[@name='equipment_id']" position="after">
                <field name="esg_site_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_oil_hse_incident_list_inherit_esg_site" model="ir.ui.view">
        <field name="name">oil.hse.incident.list.inherit.esg.site</field>
        <field name="model">oil.hse.incident</field>
        <field name="inherit_id" ref="oil_erp_hse.view_oil_hse_incident_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='task_id']" position="after">
                <field name="esg_site_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_oil_hse_incident_search_inherit_esg_site" model="ir.ui.view">
        <field name="name">oil.hse.incident.search.inherit.esg.site</field>
        <field name="model">oil.hse.incident</field>
        <field name="inherit_id" ref="oil_erp_hse.view_oil_hse_incident_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='task_id']" position="after">
                <field name="esg_site_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Field Site" name="group_esg_site"
                        context="{'group_by': 'esg_site_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- ============ EMISSION VIEWS ============ -->
    <record id="view_oil_esg_emission_form" model="ir.ui.view">
        <field name="name">oil.esg.emission.form</field>
        <field name="model">oil.esg.emission</field>
        <field name="arch" type="xml">
            <form string="GHG Emission Record">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_verify" type="object" string="Verify"
                            class="oe_highlight" groups="base.group_system"
                            invisible="state != 'submitted'"/>
                    <button name="action_flag" type="object" string="Flag Issue"
                            invisible="state not in ['submitted', 'verified']"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ['submitted', 'flagged']"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,submitted,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Emission Details">
                            <field name="date"/>
                            <field name="site_id"/>
                            <field name="business_segment"/>
                            <field name="scope"/>
                            <field name="source"/>
                            <field name="gas_type"/>
                        </group>
                        <group string="Quantities">
                            <field name="quantity"/>
                            <field name="gwp_factor"/>
                            <field name="quantity_co2e" readonly="1"
                                   class="o_field_highlight"/>
                            <field name="period_year" readonly="1"/>
                            <field name="period_month" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Activity Data">
                            <group>
                                <group>
                                    <field name="activity_data"/>
                                    <field name="activity_unit"/>
                                </group>
                                <group>
                                    <field name="emission_factor"/>
                                    <field name="emission_factor_unit"/>
                                </group>
                            </group>
                        </page>
                        <page string="Verification">
                            <group>
                                <field name="verified_by" readonly="1"/>
                                <field name="verified_date" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes &amp; Documents">
                            <field name="notes" placeholder="Additional notes..."/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_oil_esg_emission_tree" model="ir.ui.view">
        <field name="name">oil.esg.emission.tree</field>
        <field name="model">oil.esg.emission</field>
        <field name="arch" type="xml">
            <list string="Emission Records" decoration-danger="state=='flagged'"
                  decoration-muted="state=='draft'"
                  decoration-success="state=='verified'">
                <field name="name"/>
                <field name="date"/>
                <field name="site_id"/>
                <field name="business_segment" optional="show"/>
                <field name="scope"/>
                <field name="source"/>
                <field name="gas_type"/>
                <field name="quantity"/>
                <field name="quantity_co2e" string="tCO₂e"/>
                <field name="period_year"/>
                <field name="state" widget="badge"
                       decoration-success="state=='verified'"
                       decoration-warning="state=='submitted'"
                       decoration-danger="state=='flagged'"
                       decoration-muted="state=='draft'"/>
            </list>
        </field>
    </record>

    <record id="view_oil_esg_emission_search" model="ir.ui.view">
        <field name="name">oil.esg.emission.search</field>
        <field name="model">oil.esg.emission</field>
        <field name="arch" type="xml">
            <search string="Search Emissions">
                <field name="name"/>
                <field name="site_id"/>
                <field name="period_year"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Verified" name="verified" domain="[('state','=','verified')]"/>
                <filter string="Flagged" name="flagged" domain="[('state','=','flagged')]"/>
                <separator/>
                <filter string="Scope 1" name="scope1" domain="[('scope','=','scope1')]"/>
                <filter string="Scope 2" name="scope2" domain="[('scope','=','scope2')]"/>
                <filter string="Scope 3" name="scope3" domain="[('scope','=','scope3')]"/>
                <separator/>
                <filter string="This Year" name="this_year"
                        domain="[('period_year','=', context_today().year)]"/>
                <group name="group_by">
                    <filter string="Site" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Scope" name="group_scope" context="{'group_by': 'scope'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'period_year'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'period_month'}"/>
                    <filter string="Gas Type" name="group_gas" context="{'group_by': 'gas_type'}"/>
                    <filter string="Business Segment" name="group_segment" context="{'group_by': 'business_segment'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_oil_esg_emission_pivot" model="ir.ui.view">
        <field name="name">oil.esg.emission.pivot</field>
        <field name="model">oil.esg.emission</field>
        <field name="arch" type="xml">
            <pivot string="Emissions Analysis">
                <field name="period_year" type="row"/>
                <field name="scope" type="col"/>
                <field name="quantity_co2e" type="measure"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_oil_esg_emission_graph" model="ir.ui.view">
        <field name="name">oil.esg.emission.graph</field>
        <field name="model">oil.esg.emission</field>
        <field name="arch" type="xml">
            <graph string="GHG Emissions" type="bar">
                <field name="period_month" type="row"/>
                <field name="quantity_co2e" type="measure"/>
                <field name="scope" type="col"/>
            </graph>
        </field>
    </record>

    <record id="action_oil_esg_emission" model="ir.actions.act_window">
        <field name="name">GHG Emissions</field>
        <field name="res_model">oil.esg.emission</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first emission record!</p>
            <p>Track GHG emissions across Scope 1, 2 and 3 for all your sites.</p>
        </field>
    </record>


</odoo>
