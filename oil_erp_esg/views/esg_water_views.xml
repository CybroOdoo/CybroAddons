<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- This file defines the esg water views. -->
    <record id="view_oil_esg_water_form" model="ir.ui.view">
        <field name="name">oil.esg.water.form</field>
        <field name="model">oil.esg.water</field>
        <field name="arch" type="xml">
            <form string="Water &amp; Waste Record">
                <header>
                    <button name="action_open" type="object" string="Open / Investigate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-primary" invisible="state not in ['draft', 'open']"/>
                    <button name="action_flag" type="object" string="Flag"
                            invisible="state not in ['draft', 'open']"/>
                    <button name="action_reset_draft" type="object" string="Reset"
                            invisible="state not in ['open', 'closed', 'flagged']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Record Details">
                            <field name="date"/>
                            <field name="site_id"/>
                            <field name="business_segment"/>
                            <field name="record_type"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Volume / Quantity">
                            <field name="volume_m3"
                                   invisible="record_type in ['waste_hazardous','waste_non_hazardous']"/>
                            <field name="water_source"
                                   invisible="record_type in ['spill','waste_hazardous','waste_non_hazardous']"/>
                            <field name="is_recycled"
                                   invisible="record_type in ['spill','waste_hazardous','waste_non_hazardous']"/>
                            <field name="quantity_tonnes"
                                   invisible="record_type not in ['waste_hazardous','waste_non_hazardous']"/>
                            <field name="disposal_method"
                                   invisible="record_type not in ['waste_hazardous','waste_non_hazardous']"/>
                        </group>
                    </group>
                    <group string="Spill Details"
                           invisible="record_type != 'spill'">
                        <group>
                            <field name="spill_substance"/>
                            <field name="spill_medium"/>
                            <field name="is_contained"/>
                        </group>
                        <group>
                            <field name="remediation_action"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes &amp; Documents">
                            <field name="notes" placeholder="Notes..."/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_oil_esg_water_tree" model="ir.ui.view">
        <field name="name">oil.esg.water.tree</field>
        <field name="model">oil.esg.water</field>
        <field name="arch" type="xml">
            <list string="Water &amp; Waste Records"
                  decoration-danger="state=='flagged'"
                  decoration-warning="state=='open'"
                  decoration-success="state=='closed'">
                <field name="name"/>
                <field name="date"/>
                <field name="site_id"/>
                <field name="business_segment" optional="show"/>
                <field name="record_type"/>
                <field name="volume_m3"/>
                <field name="quantity_tonnes"/>
                <field name="spill_substance" optional="show"/>
                <field name="period_year"/>
                <field name="state" widget="badge"
                       decoration-danger="state=='flagged'"
                       decoration-warning="state=='open'"
                       decoration-success="state=='closed'"
                       decoration-muted="state=='draft'"/>
            </list>
        </field>
    </record>

    <record id="view_oil_esg_water_search" model="ir.ui.view">
        <field name="name">oil.esg.water.search</field>
        <field name="model">oil.esg.water</field>
        <field name="arch" type="xml">
            <search string="Search Water &amp; Waste">
                <field name="name"/>
                <field name="site_id"/>
                <separator/>
                <filter string="Spills Only" name="spills"
                        domain="[('record_type','=','spill')]"/>
                <filter string="Water Records" name="water"
                        domain="[('record_type','in',['water_withdrawal','water_discharge','water_recycled','produced_water'])]"/>
                <filter string="Waste Records" name="waste"
                        domain="[('record_type','in',['waste_hazardous','waste_non_hazardous'])]"/>
                <separator/>
                <filter string="Open / Flagged" name="open"
                        domain="[('state','in',['open','flagged'])]"/>
                <group name="group_by">
                    <filter string="Record Type" name="group_type" context="{'group_by': 'record_type'}"/>
                    <filter string="Site" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'period_year'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--    ESG water action -->
    <record id="action_oil_esg_water" model="ir.actions.act_window">
        <field name="name">Water &amp; Waste</field>
        <field name="res_model">oil.esg.water</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first water or waste record!</p>
            <p>Track water withdrawal, recycling, spill incidents, and waste disposal.</p>
        </field>
    </record>
    <!--    ESG spills action-->
    <record id="action_oil_esg_spills" model="ir.actions.act_window">
        <field name="name">Spill Incidents</field>
        <field name="res_model">oil.esg.water</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('record_type','=','spill')]</field>
        <field name="context">{'default_record_type': 'spill'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No spill incidents recorded.</p>
        </field>
    </record>

</odoo>
