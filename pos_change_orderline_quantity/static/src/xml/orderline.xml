<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Extends POS Orderline to add plus/minus buttons for changing product-->
    <t t-name="pos_change_orderline_quantity.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//ul[hasclass('info-list')]" position="after">
                <div class="col-lg-2">
                    <div class="input-group" style="margin-left: 520%;">
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-danger btn-sm"
                                    t-on-click="line.onclick_minus">
                                <i class="fa fa-minus"/>
                            </button>
                        </span>
                        <span class="input-group-btn" style="margin-left: 10%;">
                            <button id="onclick_plus" class="btn btn-success btn-sm"
                                    t-on-click="line.onclick_plus">
                                <i class="fa fa-plus"/>
                            </button>
                        </span>
                    </div>
                </div>
        </xpath>
    </t>
</templates>
