<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Upload and clear buttons above the interactive 3D viewer -->
    <t t-name="model_viewer_widget.Field3D">
        <div class="o_field_3d">
            <div t-if="!this.props.readonly" class="mb-2">
                <FileUploader acceptedFileExtensions="this.acceptedFileExtensions"
                              t-key="this.props.record.resId"
                              onUploaded.bind="this.onFileUploaded">
                    <t t-set-slot="toggler">
                        <button class="o_select_file_button btn btn-secondary o_btn_circle"
                                data-tooltip="Edit"
                                aria-label="Edit">
                            <i class="oi oi-fw oi-filled" data-icon="edit"/>
                        </button>
                    </t>
                    <button t-if="this.props.record.data[this.props.name]"
                            class="o_clear_file_button btn btn-secondary o_btn_circle ms-1"
                            data-tooltip="Clear"
                            aria-label="Clear"
                            t-on-click="this.onFileRemove">
                        <i class="oi oi-fw" data-icon="delete"/>
                    </button>
                </FileUploader>
            </div>
            <div t-if="this.state.hasLoadFailed" class="alert alert-danger" role="alert">
                This 3D model could not be displayed.
            </div>
            <div class="view3d-wrapper o_field_3d_viewer" t-ref="this.viewerRef">
                <canvas class="view3d-canvas"/>
            </div>
        </div>
    </t>
</templates>
