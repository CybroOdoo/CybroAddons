<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for the model openai.image.suggestion -->
    <record id="openai_image_suggestion_view_form" model="ir.ui.view">
        <field name="name">openai.image.suggestion.view.form</field>
        <field name="model">openai.image.suggestion</field>
        <field name="arch" type="xml">
            <form string="AI Image Suggestion">
                <header>
                    <button name="action_set_as_product_image" type="object"
                            string="Set as Product Image"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="product_tmpl_id"/>
                        <h1>
                            <field name="product_tmpl_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_image" widget="image"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- List view for the model openai.image.suggestion -->
    <record id="openai_image_suggestion_view_list" model="ir.ui.view">
        <field name="name">openai.image.suggestion.view.list</field>
        <field name="model">openai.image.suggestion</field>
        <field name="arch" type="xml">
            <list string="AI Image Suggestion">
                <field name="product_tmpl_id"/>
                <field name="create_date"/>
                <field name="product_image" widget="image"/>
            </list>
        </field>
    </record>
</odoo>
