<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Added a server action in the model product template -->
    <record id="product_template_action_generate_openai_image" model="ir.actions.server">
        <field name="name">Generate Image Using OpenAI</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id"
               ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids"
               eval="[(4, ref('product.group_product_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_open_image_prompt_wizard()
        </field>
    </record>

    <!-- Added smart button in the product.template form -->
    <record id="product_template_view_form_inherit_openai_product_images" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.openai.product.images</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_ai_images" type="object"
                        class="oe_stat_button" icon="fa-image">
                    <div class="o_stat_info">
                        <span class="o_stat_text">AI Images</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
