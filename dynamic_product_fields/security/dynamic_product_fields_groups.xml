<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Defines a new user group for creating custom fields in product form. -->
       <record model="ir.module.category" id="module_dynamic_product_field">
        <field name="name">Others</field>
        <field name="description">Category for Parking Management</field>
    </record>
    <!--Group For User-->
    <record model="res.groups.privilege" id="module_dynamic_product_field_privilege">
        <field name="name">Create Custom Fields </field>
        <field name="sequence">17</field>
        <field name="category_id" ref="dynamic_product_fields.module_dynamic_product_field"/>
    </record>
    <record id="dynamic_product_fields_user" model="res.groups">

        <field name="name">Create Custom Fields</field>
        <field name="privilege_id" ref="module_dynamic_product_field_privilege"/>

    </record>
</odoo>
