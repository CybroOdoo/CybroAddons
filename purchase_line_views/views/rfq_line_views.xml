<?xml version="1.0" encoding="utf-8"?>
<odoo>

      <!-- RFQ line form view -->
    <record id="rfq_line_form_view" model="ir.ui.view">
        <field name="name">rfq.line.form.view</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <form string="RFQ Line">
                <sheet>
                    <field name="product_image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'product_image'}"/>
                    <group>
                        <group>
                            <field name="order_id"
                                   domain="[('state', 'not in', ['purchase'])]"/>
                            <field name="product_id" required="true"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                            <field name="product_qty"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="price_subtotal" widget="monetary"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="price_unit"/>
                            <field name="date_planned"/>
                            <field name="product_type"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- RFQ line list view -->
    <record id="rfq_line_tree_view" model="ir.ui.view">
        <field name="name">rfq.line.tree view</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="date_order"/>
                <field name="date_planned" optional="hide"/>
                <field name="product_qty"/>
                <field name="price_unit"/>
                <field name="product_uom_id" optional="hide"/>
                <field name="price_subtotal" optional="show" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="tax_ids" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- RFQ line kanban view -->
    <record id="rfq_line_kanban_view" model="ir.ui.view">
        <field name="name">rfq.line.kanban.view</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <kanban default_group_by="partner_id">
                <field name="partner_id" readonly="1"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card o_kanban_record_global_click">
                            <main class="row g-0">
                                <aside class="col-3 me-1">
                                    <field name="product_image" widget="image"
                                           options="{'img_class': 'o_image_64_contain mw-100 mh-100'}"
                                           alt="Product Image"/>
                                </aside>
                                <section class="col-9 ps-1">
                                    <div class="o_kanban_details">
                                        <div>
                                            <strong>Order:</strong>
                                            <field name="order_id"/>
                                        </div>
                                        <div class="mt-1">
                                            Vendor:
                                            <field name="partner_id"/>
                                        </div>
                                        <div>
                                            Product:
                                            <field name="product_id"/>
                                        </div>
                                        <div>
                                            Price:
                                            <field name="price_unit"/>
                                        </div>
                                        <div>
                                            Quantity:
                                            <field name="product_qty"/>
                                        </div>
                                        <div class="d-inline-flex">
                                            State:
                                            <field name="state" widget="badge"/>
                                        </div>
                                    </div>
                                </section>
                            </main>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- RFQ line pivot view -->
    <record id="rfq_line_pivot_view_pivot" model="ir.ui.view">
        <field name="name">rfq pivot</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Pivot View" sample="1">
                <field name="order_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="product_qty" type="measure"/>
                <field name="price_unit" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- RFQ line graph view -->
    <record id="rfq_line_graph_view" model="ir.ui.view">
        <field name="name">rfq.line.graph.view</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <graph string="Graph View" type="bar">
                <field name="product_id"/>
                <field name="price_unit" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- RFQ line calendar view -->
    <record id="rfq_line_calender_view" model="ir.ui.view">
        <field name="name">rfq.line.calender</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <calendar date_start="date_order" string="Tasks">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <!--Action for RFQ line  -->
    <record id="action_rfq_order_line_view"
            model="ir.actions.act_window">
        <field name="name">RFQ Line</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="domain">
            [('state','=','draft')]
        </field>
        <field name="view_ids" eval="[Command.clear(),
                    Command.create({'view_mode': 'list', 'view_id': ref('rfq_line_tree_view')}),
                    Command.create({'view_mode': 'form', 'view_id': ref('rfq_line_form_view')}),
                    Command.create({'view_mode': 'kanban', 'view_id': ref('rfq_line_kanban_view')}),
                    Command.create({'view_mode': 'pivot', 'view_id': ref('rfq_line_pivot_view_pivot')}),
                    Command.create({'view_mode': 'graph', 'view_id': ref('rfq_line_graph_view')}),
                    Command.create({'view_mode': 'calendar', 'view_id': ref('rfq_line_calender_view')}),]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                RFQ Line Views
            </p>
        </field>
    </record>

    <!-- Menu for RFQ line -->
    <menuitem id="menu_rfq_line_view" name="RFQ Line"
              sequence="310"
              parent="purchase.menu_procurement_management"
              action="action_rfq_order_line_view">
    </menuitem>

</odoo>
