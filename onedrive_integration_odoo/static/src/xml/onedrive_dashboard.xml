<?xml version="1.0" encoding="UTF-8" ?>
<!-- Dashboard template -->
<template id="onedrive">
    <t t-name="onedrive_integration_odoo.OnedriveDashboard">
        <section class="dashboard_main_section" id="main_section_manager">
            <div class="d-flex align-items-center mb-3">
                <!-- OneDrive logo -->
                <img src="/onedrive_integration_odoo/static/src/img/microsoft-onedrive.svg"
                     class="onedrive_logo ms-2" alt="Microsoft OneDrive"/>
                <img src="/onedrive_integration_odoo/static/src/img/onedrive_name.svg"
                     class="onedrive_name ms-3" alt="OneDrive"/>
                <!-- Import button -->
                <input class="btn import ms-3" type="button" value="Import"
                       id="import" t-on-click="this.synchronize" />
                <!-- Upload button -->
                <input class="btn upload ms-2" type="button" value="Upload"
                       id="upload" t-on-click="this.upload"/>
            </div>
            <div class="row g-0">
                <div class="left-sidebar">
                    <div class="files">
                        <!-- File type: all files -->
                        <div class="file-type" t-on-click="() => this.filterFileType('allfiles')">
                            <img class="file-icon"
                                 src="/onedrive_integration_odoo/static/src/img/file.png"
                                 alt="All Files" title="All Files"/>
                        </div>
                        <!-- File type: image -->
                        <div class="file-type" t-on-click="() => this.filterFileType('image')">
                            <img class="file-icon image"
                                 src="/onedrive_integration_odoo/static/src/img/image.png"
                                 alt="Images" title="Images"/>
                        </div>
                        <!-- File type: PDF -->
                        <div class="file-type" t-on-click="() => this.filterFileType('pdf')">
                            <img class="file-icon"
                                 src="/onedrive_integration_odoo/static/src/img/pdf.png"
                                 alt="PDF" title="PDF"/>
                        </div>
                        <!-- File type: Excel -->
                        <div class="file-type" t-on-click="() => this.filterFileType('xlsx')">
                            <img class="file-icon"
                                 src="/onedrive_integration_odoo/static/src/img/excel.png"
                                 alt="Excel" title="Excel"/>
                        </div>
                        <!-- File type: ZIP -->
                        <div class="file-type" t-on-click="() => this.filterFileType('zip')">
                            <img class="file-icon"
                                 src="/onedrive_integration_odoo/static/src/img/zip.png"
                                 alt="ZIP" title="ZIP"/>
                        </div>
                        <!-- File type: Text -->
                        <div class="file-type" t-on-click="() => this.filterFileType('txt')">
                            <img class="file-icon"
                                 src="/onedrive_integration_odoo/static/src/img/txt.png"
                                 alt="Text" title="Text"/>
                        </div>
                    </div>
                </div>
                <!-- Content area to display OneDrive files -->
                <div class="col row content onedrive_files_container p-3 g-3 ms-2" id="onedrive_files">
                    <t t-foreach="this.state.displayedFiles" t-as="file" t-key="file.name">
                        <div class="col-sm-6 col-md-4 col-lg-3 text-center">
                            <div class="onedrive_file_card h-100 d-flex flex-column justify-content-between">
                                <a t-att-href="file.url" target="_blank" class="text-decoration-none text-reset">
                                    <img class="onedrive_thumbnail mb-2"
                                         t-att-src="file.url"
                                         onerror="this.src='/onedrive_integration_odoo/static/src/img/file_icon.png';"
                                         alt="File Preview"/>
                                    <div class="file-name text-truncate small font-weight-bold"
                                         t-esc="file.name" t-att-title="file.name"/>
                                </a>
                            </div>
                        </div>
                    </t>
                    <div t-if="!this.state.displayedFiles.length" class="col-12 text-center text-muted py-5">
                        <p class="lead">No files found.</p>
                    </div>
                </div>
            </div>
        </section>
    </t>
</template>
