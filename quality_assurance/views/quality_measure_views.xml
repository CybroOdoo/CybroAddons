<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Quality Root Menu -->
    <menuitem
        id="menu_quality_root"
        name="Quality"
        sequence="30"
        groups="quality_assurance.group_quality_user,quality_assurance.group_quality_manager"
        web_icon="quality_assurance,static/description/icon.png"
    />

    <!-- Quality Assurance parent menu (defined here so it loads before the
         Quality Alerts and Quality Tests menus that use it as parent) -->
    <menuitem
        id="menu_quality_assurance"
        name="Quality Assurance"
        parent="menu_quality_root"
        sequence="1"
    />

    <!-- Quality Measure List View -->
    <record id="quality_measure_view_list" model="ir.ui.view">
        <field name="name">quality.measure.view.list</field>
        <field name="model">quality.measure</field>
        <field name="arch" type="xml">
            <list string="Quality Measures">
                <field name="name"/>
                <field name="product_id"/>
                <field name="type"/>
                <field name="quantity_min"/>
                <field name="quantity_max"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Quality Measure Form View -->
    <record id="quality_measure_view_form" model="ir.ui.view">
        <field name="name">quality.measure.view.form</field>
        <field name="model">quality.measure</field>
        <field name="arch" type="xml">
            <form string="Quality Measure">
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button
                            name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-archive"
                        >
                            <field
                                name="active"
                                widget="boolean_button"
                                options="{'terminology': 'archive'}"
                            />
                        </button>
                    </div>

                    <div class="oe_title">
                        <h3>
                            <field
                                name="name"
                                placeholder="Name"
                            />
                        </h3>
                    </div>

                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="type"/>
                        </group>

                        <group>
                            <field
                                name="quantity_min"
                                invisible="type == 'quality'"
                            />
                            <field
                                name="quantity_max"
                                invisible="type == 'quality'"
                            />
                        </group>
                    </group>

                    <group>
                        <field name="picking_type_ids"/>
                    </group>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Quality Measure Search View -->
    <record id="quality_measure_view_search" model="ir.ui.view">
        <field name="name">quality.measure.view.search</field>
        <field name="model">quality.measure</field>
        <field name="arch" type="xml">
            <search string="Quality Measures">

                <field
                    name="name"
                    filter_domain="[('name', 'ilike', self)]"
                />

                <field name="product_id"/>

                <separator/>

                <filter
                    string="Quantitative"
                    name="filter_quantity"
                    domain="[('type', '=', 'quantity')]"
                />

                <filter
                    string="Qualitative"
                    name="filter_quality"
                    domain="[('type', '=', 'quality')]"
                />

                <separator/>

                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />

                <group>
                    <filter
                        string="Product"
                        name="group_by_product_id"
                        context="{'group_by': 'product_id'}"
                    />

                    <filter
                        string="Type"
                        name="group_by_type"
                        context="{'group_by': 'type'}"
                    />
                </group>

            </search>
        </field>
    </record>

    <!-- Quality Measure Action -->
    <record id="quality_measure_action" model="ir.actions.act_window">
        <field name="name">Quality Measures</field>
        <field name="res_model">quality.measure</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="quality_measure_view_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click here to add a new quality measure.
            </p>
        </field>
    </record>

    <!-- Configuration Menu -->
    <menuitem
        id="menu_quality_config_settings"
        name="Configuration"
        parent="menu_quality_root"
        sequence="100"
        groups="quality_assurance.group_quality_manager"
    />

    <!-- Quality Measures Menu -->
    <menuitem
        id="menu_quality_measure"
        name="Quality Measures"
        parent="menu_quality_config_settings"
        action="quality_measure_action"
        groups="quality_assurance.group_quality_manager"
    />

</odoo>
