<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--        Creates the Quality category-->
        <record model="ir.module.category"
                id="module_category_quality_management">
            <field name="name">Quality</field>
            <field name="description">Helps you manage your quality assurance
                processes
            </field>
            <field name="sequence">4</field>
        </record>
        <record model="res.groups.privilege"
                id="res_groups_privilege_quality_management">
            <field name="name">Quality</field>
            <field name="category_id" ref="quality_assurance.module_category_quality_management"/>
        </record>
        <!--        Create User-->
        <record id="group_quality_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_quality_management"/>
        </record>
        <!--        Create the quality manager-->
        <record id="group_quality_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_quality_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_quality_management"/>
        </record>
    </data>
</odoo>
