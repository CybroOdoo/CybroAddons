<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Read-only list view for audit trail entries. -->
    <record id="view_pharma_audit_trail_list" model="ir.ui.view">
        <field name="name">pharma.audit.trail.list</field>
        <field name="model">pharma.audit.trail</field>
        <field name="arch" type="xml">
            <list string="Audit Trail" create="0" edit="0" delete="0">
                <field name="changed_on"/>
                <field name="model_id"/>
                <field name="record_name"/>
                <field name="field_name"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="changed_by"/>
            </list>
        </field>
    </record>

    <!-- Search view for audit trail entries. -->
    <record id="view_pharma_audit_trail_search" model="ir.ui.view">
        <field name="name">pharma.audit.trail.search</field>
        <field name="model">pharma.audit.trail</field>
        <field name="arch" type="xml">
            <search string="Search Audit Trail">
                <field name="model_id"/>
                <field name="record_name"/>
                <field name="changed_by"/>
                <group>
                    <filter string="Model" name="group_by_model" domain="[]" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action opening the audit trail. -->
    <record id="action_pharma_audit_trail" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">pharma.audit.trail</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_model': 1}</field>
    </record>
</odoo>
