<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for certificate of analysis numbers. -->
    <record id="seq_pharma_coa" model="ir.sequence">
        <field name="name">Certificate of Analysis</field>
        <field name="code">pharma.coa</field>
        <field name="prefix">COA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for QA release numbers. -->
    <record id="seq_pharma_qa_release" model="ir.sequence">
        <field name="name">QA Release Queue</field>
        <field name="code">pharma.qa.release</field>
        <field name="prefix">QA/RELEASE/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
