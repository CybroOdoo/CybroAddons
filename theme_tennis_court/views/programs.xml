<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full Programs page template -->
    <template id="tc_programs_page" name="Tennis Court Programs">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero -->
                <section class="programs-hero-section container section-spacing o_colored_level"
                         data-snippet="theme_tennis_court.tc_programs_hero" data-name="Programs Hero">
                    <div class="programs-hero-container">
                        <div class="programs-hero-bg">
                            <img src="/theme_tennis_court/static/src/img/scenes/hero_court.jpg" alt="Tennis players"/>
                        </div>
                        <div class="programs-hero-overlay"/>
                        <div class="programs-hero-content">
                            <div class="tag-pill hero-pill-light">Our Programs</div>
                            <h1 class="programs-hero-title">Elevate your game.<br/>Programs for every level.
                            </h1>
                            <p class="programs-hero-subtitle">From first-time beginners to tournament competitors, our
                                expert-designed programs develop real skills at every stage.
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Featured: Junior Academy -->
                <section class="container section-spacing o_colored_level"
                         data-snippet="theme_tennis_court.tc_programs_junior" data-name="Junior Academy">
                    <div class="section-header">
                        <div>
                            <div class="tag-pill">Elite Junior Training</div>
                            <h2 class="section-title">Our flagship programs</h2>
                        </div>
                    </div>
                    <div class="featured-program">
                        <div class="featured-img-wrap">
                            <img src="/theme_tennis_court/static/src/img/scenes/junior_academy.jpg"
                                 alt="Junior Academy"/>
                            <div class="featured-img-badge">Junior Academy</div>
                        </div>
                        <div class="featured-text">
                            <h2 class="featured-program-title">Elite Junior Academy</h2>
                            <p class="featured-program-desc">From beginner fundamentals to high-performance training,
                                our Junior Academy provides structured, progressive coaching for players aged 5–18. Led
                                by USPTA-certified coaches.
                            </p>
                            <ul class="featured-bullets">
                                <li>
                                    <div class="bullet-icon">
                                        <i class="fa fa-check" style="font-size:14px;"/>
                                    </div>
                                    Age-appropriate skill tracks from Mini Tennis to Tournament Prep
                                </li>
                                <li>
                                    <div class="bullet-icon">
                                        <i class="fa fa-check" style="font-size:14px;"/>
                                    </div>
                                    High-Performance structured curriculum &amp; video analysis
                                </li>
                                <li>
                                    <div class="bullet-icon">
                                        <i class="fa fa-check" style="font-size:14px;"/>
                                    </div>
                                    College-level recruiting support for elite teens
                                </li>
                            </ul>
                            <div class="featured-meta">
                                <div class="meta-item">
                                    <span class="meta-label">Ages</span>
                                    <span class="meta-value">5 – 18 yrs</span>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-label">Schedule</span>
                                    <span class="meta-value">Mon – Sat</span>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-label">Starting from</span>
                                    <span class="meta-value">$149 / mo</span>
                                </div>
                            </div>
                            <div style="display:flex;gap:14px;">
                                <a href="/contactus" style="text-decoration:none;">
                                    <button class="btn-primary">Enroll in Junior Academy
                                        <i class="fa fa-arrow-right" style="font-size:16px;color:white;"/>
                                    </button>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Adult Clinics -->
                    <div class="featured-program reverse">
                        <div class="featured-img-wrap">
                            <img src="/theme_tennis_court/static/src/img/scenes/competitive.jpg" alt="Adult Leagues"/>
                            <div class="featured-img-badge">Adults</div>
                        </div>
                        <div class="featured-text">
                            <h2 class="featured-program-title">Adult Clinics &amp; Leagues</h2>
                            <p class="featured-program-desc">Whether you're a weekend warrior or a competitive player,
                                our adult programs deliver expert instruction in a fun, motivating environment. Group
                                clinics run daily.
                            </p>
                            <ul class="featured-bullets">
                                <li>
                                    <div class="bullet-icon">
                                        <i class="fa fa-check" style="font-size:14px;"/>
                                    </div>
                                    Beginner, intermediate, and advanced group clinics
                                </li>
                                <li>
                                    <div class="bullet-icon">
                                        <i class="fa fa-check" style="font-size:14px;"/>
                                    </div>
                                    Structured NTRP-matched league seasons
                                </li>
                                <li>
                                    <div class="bullet-icon">
                                        <i class="fa fa-check" style="font-size:14px;"/>
                                    </div>
                                    Social round-robins every weekend
                                </li>
                            </ul>
                            <div class="featured-meta">
                                <div class="meta-item">
                                    <span class="meta-label">Ages</span>
                                    <span class="meta-value">18+ yrs</span>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-label">Schedule</span>
                                    <span class="meta-value">Daily</span>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-label">Starting from</span>
                                    <span class="meta-value">$89 / mo</span>
                                </div>
                            </div>
                            <div style="display:flex;gap:14px;">
                                <a href="/contactus" style="text-decoration:none;">
                                    <button class="btn-primary">View all clinics
                                        <i class="fa fa-arrow-right" style="font-size:16px;color:white;"/>
                                    </button>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Programs Grid -->
                <section class="container section-spacing o_colored_level"
                         data-snippet="theme_tennis_court.tc_programs_adult" data-name="Adult Leagues">
                    <div class="section-header">
                        <div>
                            <div class="tag-pill">All Programs</div>
                            <h2 class="section-title">Find your perfect fit</h2>
                        </div>
                    </div>
                    <div class="programs-grid">
                        <div class="program-card">
                            <div class="program-card-img">
                                <img src="/theme_tennis_court/static/src/img/scenes/private_coaching.jpg"
                                     alt="Private Coaching"/>
                                <div class="program-card-tag">Private Coaching</div>
                            </div>
                            <div class="program-card-body">
                                <h3 class="program-card-title">1-on-1 Private Lessons</h3>
                                <p class="program-card-desc">Personalized instruction tailored to your goals. Rapid
                                    improvement at any skill level.
                                </p>
                                <div class="program-card-meta">
                                    <span class="program-tag-chip">
                                        <i class="fa fa-clock-o" style="font-size:14px;"/>
                                        60 min
                                    </span>
                                    <span class="program-tag-chip">
                                        <i class="fa fa-users" style="font-size:14px;"/>
                                        All levels
                                    </span>
                                </div>
                                <div class="program-card-footer">
                                    <div class="program-price">$95
                                        <span>/ session</span>
                                    </div>
                                    <a href="/contactus" style="text-decoration:none;">
                                        <button class="btn-primary" style="padding:10px 20px;font-size:13px;">Book Now
                                        </button>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="program-card">
                            <div class="program-card-img">
                                <img src="/theme_tennis_court/static/src/img/scenes/cardio.jpg" alt="Cardio Tennis"/>
                                <div class="program-card-tag">Fitness</div>
                            </div>
                            <div class="program-card-body">
                                <h3 class="program-card-title">Cardio Tennis</h3>
                                <p class="program-card-desc">High-energy group fitness using tennis drills. Fun social
                                    workout improving footwork and endurance.
                                </p>
                                <div class="program-card-meta">
                                    <span class="program-tag-chip">
                                        <i class="fa fa-clock-o" style="font-size:14px;"/>
                                        45 min
                                    </span>
                                    <span class="program-tag-chip">
                                        <i class="fa fa-bolt" style="font-size:14px;"/>
                                        High energy
                                    </span>
                                </div>
                                <div class="program-card-footer">
                                    <div class="program-price">$25
                                        <span>/ class</span>
                                    </div>
                                    <a href="/contactus" style="text-decoration:none;">
                                        <button class="btn-primary" style="padding:10px 20px;font-size:13px;">Book Now
                                        </button>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="program-card">
                            <div class="program-card-img">
                                <img src="/theme_tennis_court/static/src/img/scenes/night_court.jpg" alt="Tournaments"/>
                                <div class="program-card-tag">Tournament</div>
                            </div>
                            <div class="program-card-body">
                                <h3 class="program-card-title">Club Tournaments</h3>
                                <p class="program-card-desc">USTA-sanctioned and club-exclusive tournaments. Full draws
                                    for Singles, Doubles, and Mixed.
                                </p>
                                <div class="program-card-meta">
                                    <span class="program-tag-chip">
                                        <i class="fa fa-calendar" style="font-size:14px;"/>
                                        Monthly
                                    </span>
                                    <span class="program-tag-chip">
                                        <i class="fa fa-trophy" style="font-size:14px;"/>
                                        USTA rated
                                    </span>
                                </div>
                                <div class="program-card-footer">
                                    <div class="program-price">$45
                                        <span>/ entry</span>
                                    </div>
                                    <a href="/contactus" style="text-decoration:none;">
                                        <button class="btn-primary" style="padding:10px 20px;font-size:13px;">Register
                                        </button>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA -->
                <section class="tc-cta container section-spacing o_colored_level">
                    <div class="cta-section">
                        <img class="cta-bg" src="/theme_tennis_court/static/src/img/scenes/night_court.jpg"
                             alt="Night court"/>
                        <div class="cta-overlay"/>
                        <div class="cta-content">
                            <h2 class="cta-title">Find your perfect program</h2>
                            <p class="cta-desc">Let us help you find a program that matches your schedule, goals, and
                                skill level.
                            </p>
                            <a href="/contactus" style="text-decoration:none;">
                                <button class="btn-primary"
                                        style="background:white;color:var(--primary);padding:16px 32px;font-size:16px;
                                        margin-top:16px;">
                                    Book Assessment
                                </button>
                            </a>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>

    <!-- Publishes the Programs page at /programs -->
    <record id="tc_programs_page_page" model="theme.website.page">
        <field name="url">/programs</field>
        <field name="view_id" ref="tc_programs_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>