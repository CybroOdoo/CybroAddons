<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full About page template composed from reusable snippet sections -->
    <template id="tc_about_page" name="Tennis Court About">
        <t t-call="website.layout">
            <!-- Page content wrapper required by Odoo website layout -->
            <div id="wrap" class="oe_structure">
                <!-- Hero -->
                <section class="about-hero-section container section-spacing o_colored_level" data-name="About Hero"
                         data-snippet="theme_tennis_court.tc_about_hero">
                    <div class="about-hero-container">
                        <div class="about-hero-bg">
                            <img src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg" alt="Club Exterior"/>
                        </div>
                        <div class="about-hero-overlay"/>
                        <div class="about-hero-content">
                            <div class="tag-pill hero-pill-light">Our Story</div>
                            <h1 class="about-hero-title">More than just a club.<br/>A legacy of excellence.
                            </h1>
                        </div>
                    </div>
                </section>

                <!-- Mission -->
                <section class="container section-spacing o_colored_level" data-name="Mission"
                         data-snippet="theme_tennis_court.tc_about_mission">
                    <div class="mission-grid">
                        <div class="mission-text-content">
                            <div class="tag-pill">Our Mission</div>
                            <h2 class="mission-heading">We exist to elevate the game of tennis and build a community
                                united by passion.
                            </h2>
                            <p class="mission-paragraph">Since our doors opened, Horizon Courts has been driven by a
                                singular vision: to create the ultimate environment for tennis players to thrive. We
                                believe that top-tier facilities must be paired with an inclusive, welcoming community
                                to truly inspire greatness.
                            </p>
                            <p class="mission-paragraph">Whether you're an aspiring junior professional, a dedicated
                                league player, or someone stepping onto the court for the very first time, our
                                commitment remains the same.
                            </p>
                            <div style="margin-top:24px;display:flex;gap:16px;">
                                <img src="/theme_tennis_court/static/src/img/avatars/male_european_50.jpg" alt="Founder"
                                     style="width:64px;height:64px;border-radius:50%;object-fit:cover;"/>
                                <div style="display:flex;flex-direction:column;justify-content:center;">
                                    <div style="font-weight:600;font-size:16px;" class="">Arthur Pendelton</div>
                                    <div style="color:var(--muted-foreground);font-size:14px;" class="">Founder &amp;
                                        CEO
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mission-image">
                            <img src="/theme_tennis_court/static/src/img/scenes/coaches_bg.jpg"
                                 alt="Players shaking hands"/>
                        </div>
                    </div>
                </section>

                <!-- Values -->
                <section class="container section-spacing o_colored_level" data-name="Values"
                         data-snippet="theme_tennis_court.tc_about_values">
                    <div class="values-section">
                        <div class="values-header">
                            <div class="tag-pill" style="background:white;">Core Pillars</div>
                            <h2 class="section-title" style="margin:0;text-align:center;">What drives us forward</h2>
                        </div>
                        <div class="values-grid">
                            <div class="value-card">
                                <div class="value-icon">
                                    <i class="fa fa-trophy" style="font-size:28px;"/>
                                </div>
                                <h3 class="value-title">Excellence</h3>
                                <p class="value-desc">From our championship-grade court surfaces to our carefully
                                    selected coaching staff, we refuse to compromise on quality.
                                </p>
                            </div>
                            <div class="value-card">
                                <div class="value-icon">
                                    <i class="fa fa-users" style="font-size:28px;"/>
                                </div>
                                <h3 class="value-title">Community</h3>
                                <p class="value-desc">Tennis is as much about the people as it is about the sport. We
                                    foster an environment where friendships are forged.
                                </p>
                            </div>
                            <div class="value-card">
                                <div class="value-icon">
                                    <i class="fa fa-heartbeat" style="font-size:28px;"/>
                                </div>
                                <h3 class="value-title">Holistic Wellness</h3>
                                <p class="value-desc">We support the complete athlete. Our focus extends beyond
                                    technique to include physical conditioning and mental resilience.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Leadership Team -->
                <section class="container section-spacing o_colored_level" data-name="Leadership"
                         data-snippet="theme_tennis_court.tc_about_leadership">
                    <div class="section-header">
                        <div>
                            <div class="tag-pill">Leadership</div>
                            <h2 class="section-title">The team behind the net</h2>
                        </div>
                    </div>
                    <div class="team-grid">
                        <div class="team-card">
                            <img src="/theme_tennis_court/static/src/img/avatars/male_european_50.jpg" class="team-img"
                                 alt="Leader"/>
                            <div class="team-info">
                                <h4 class="team-name">Arthur Pendelton</h4>
                                <span class="team-role">Founder &amp; CEO</span>
                            </div>
                        </div>
                        <div class="team-card">
                            <img src="/theme_tennis_court/static/src/img/avatars/female_na_35_2.jpg" class="team-img"
                                 alt="Leader"/>
                            <div class="team-info">
                                <h4 class="team-name">Jessica Vance</h4>
                                <span class="team-role">Chief Operating Officer</span>
                            </div>
                        </div>
                        <div class="team-card">
                            <img src="/theme_tennis_court/static/src/img/avatars/male_african_35.jpg" class="team-img"
                                 alt="Leader"/>
                            <div class="team-info">
                                <h4 class="team-name">Marcus Hayes</h4>
                                <span class="team-role">Director of Operations</span>
                            </div>
                        </div>
                        <div class="team-card">
                            <img src="/theme_tennis_court/static/src/img/avatars/female_na_35_2.jpg" class="team-img"
                                 alt="Leader"/>
                            <div class="team-info">
                                <h4 class="team-name">Chloe Lin</h4>
                                <span class="team-role">Head of Member Experience</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA -->
                <section class="tc-cta container section-spacing o_colored_level"
                         data-snippet="theme_tennis_court.tc_cta_banner" data-name="CTA">
                    <div class="cta-section">
                        <img class="cta-bg o_we_custom_image"
                             src="/theme_tennis_court/static/src/img/scenes/scene_6.jpg" alt="Ready to play"/>
                        <div class="cta-overlay"/>
                        <div class="cta-content">
                            <h2 class="cta-title">Be part of our story</h2>
                            <p class="cta-desc">Join our community and experience tennis the way it was meant to be
                                played.
                            </p>
                            <a href="/join" style="text-decoration:none;">
                                <button class="btn-primary"
                                        style="background:white;color:var(--primary);padding:16px 40px;font-size:16px;margin-top:16px;">
                                    Become a Member
                                </button>
                            </a>
                        </div>
                    </div>
                </section>
                <!-- Empty editable zone for adding extra snippets via the editor -->
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>

    <!-- Publishes the About page at /about -->
    <record id="tc_about_page_page" model="theme.website.page">
        <field name="url">/about</field>
        <field name="view_id" ref="tc_about_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>