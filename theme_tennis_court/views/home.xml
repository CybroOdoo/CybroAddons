<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Home page: replaces the default Odoo homepage content -->
    <template id="tc_home_page" name="Tennis Court Home Page" inherit_id="website.homepage">
        <data name="Tennis Court Home Page" inherit_id="website.homepage">
            <xpath expr="//div[@id='wrap']" position="replace">
                <div id="wrap" class="oe_structure">
                    <!-- Hero Banner -->
                    <section class="tc-hero o_colored_level" data-snippet="theme_tennis_court.tc_hero_banner"
                             data-name="Hero Banner">
                        <div class="hero-section container">
                            <div class="hero-container">
                                <div class="hero-bg">
                                    <img src="/theme_tennis_court/static/src/img/scenes/hero_court.jpg"
                                         class="o_we_custom_image" alt="Tennis players on court"/>
                                </div>
                                <div class="hero-overlay"/>
                                <div class="hero-content">
                                    <div class="hero-badge">
                                        <div class="stars">
                                            <i class="fa fa-star"/>
                                            <i class="fa fa-star"/>
                                            <i class="fa fa-star"/>
                                            <i class="fa fa-star"/>
                                            <i class="fa fa-star"/>
                                        </div>
                                        <span class="">Rated 4.9/5 by 1,200+ members</span>
                                    </div>
                                    <h1 class="hero-title">Unleash Your Champion Today.<br/>All In One Place.
                                    </h1>
                                    <p class="hero-subtitle">Join the ultimate tennis experience where passion meets
                                        performance, world-class facilities await, and every swing brings you closer to
                                        victory.
                                    </p>
                                    <div class="hero-actions">
                                        <a href="/about" class="btn-primary"
                                           style="padding:16px 32px;font-size:16px;text-decoration:none;">Start your
                                            journey
                                        </a>
                                        <a href="/contactus" class="btn-secondary"
                                           style="background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.2);
                                           color:white;padding:16px 32px;font-size:16px;text-decoration:none;">
                                            <i class="fa fa-play-circle" style="font-size:20px;color:white;"/>
                                            Tour the Club
                                        </a>
                                    </div>
                                </div>
                                <div class="hero-bottom-left">
                                    <div class="hero-avatars">
                                        <img src="/theme_tennis_court/static/src/img/avatars/male_european_25.jpg"
                                             class="hero-avatar" alt="Player 1"/>
                                        <img src="/theme_tennis_court/static/src/img/avatars/female_european_25.jpg"
                                             class="hero-avatar" alt="Player 2"/>
                                        <img src="/theme_tennis_court/static/src/img/avatars/male_na_35.jpg"
                                             class="hero-avatar" alt="Player 3"/>
                                        <div class="hero-avatar"
                                             style="background:var(--accent);display:flex;align-items:center;
                                             justify-content:center;font-size:12px;font-weight:600;color:white;border:2px
                                             solid rgba(255,255,255,0.2);">
                                            +5k
                                        </div>
                                    </div>
                                    <div class="hero-bottom-text">Train with real professionals.<br/>Join an active
                                        community.
                                    </div>
                                </div>
                                <div class="hero-bottom-right">
                                    <a class="social-link">Instagram
                                        <i class="fa fa-external-link" style="font-size:14px;color:white;"/>
                                    </a>
                                    <a class="social-link">Facebook
                                        <i class="fa fa-external-link" style="font-size:14px;color:white;"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="oe_structure oe_empty"/>

                    <!-- Partners Strip -->
                    <section class="tc-partners logos-section container section-spacing o_colored_level"
                             data-snippet="theme_tennis_court.tc_partners_strip" data-name="Partners Strip">
                        <div class="logos-title">Official Partners &amp; Sponsors</div>
                        <div class="logos-grid">
                            <div class="logo-item">
                                <i class="fa fa-play" style="font-size:24px;"/>
                                <span class="">Wilson</span>
                            </div>
                            <div class="logo-item">
                                <i class="fa fa-cube" style="font-size:24px;"/>
                                <span class="">Head Pro</span>
                            </div>
                            <div class="logo-item">
                                <i class="fa fa-dot-circle-o" style="font-size:24px;"/>
                                <span class="">Babolat</span>
                            </div>
                            <div class="logo-item">
                                <i class="fa fa-leaf" style="font-size:24px;"/>
                                <span class="">Yonex</span>
                            </div>
                            <div class="logo-item">
                                <i class="fa fa-trophy" style="font-size:24px;"/>
                                <span class="">ATP Tour</span>
                            </div>
                        </div>
                    </section>
                    <div class="oe_structure oe_empty"/>

                    <!-- About Intro -->
                    <section class="tc-about container section-spacing o_colored_level"
                             data-snippet="theme_tennis_court.tc_about_intro" data-name="About Intro">
                        <div class="about-section">
                            <div class="about-text-content">
                                <div class="tag-pill">The Horizon Difference</div>
                                <h2 class="about-text">At Horizon, we don't just play tennis — we live it. Our club has
                                    been a sanctuary for players of all levels since 2012.
                                </h2>
                                <p class="about-subtext">Whether you're picking up a racket for the very first time,
                                    looking for a competitive league, or aiming for professional development, our
                                    comprehensive facilities and expert coaching staff provide everything you need.
                                </p>
                                <ul style="list-style:none;display:flex;flex-direction:column;gap:16px;">
                                    <li style="display:flex;align-items:center;gap:12px;font-size:16px;font-weight:500;">
                                        <div style="width:24px;height:24px;border-radius:50%;background:var(--primary);
                                        display:flex;align-items:center;justify-content:center;color:white;">
                                            <i class="fa fa-check" style="font-size:14px;"/>
                                        </div>
                                        <span class="">12 Indoor &amp; Outdoor Championship Courts</span>
                                    </li>
                                    <li style="display:flex;align-items:center;gap:12px;font-size:16px;font-weight:500;">
                                        <div style="width:24px;height:24px;border-radius:50%;background:var(--primary);
                                        display:flex;align-items:center;justify-content:center;color:white;">
                                            <i class="fa fa-check" style="font-size:14px;"/>
                                        </div>
                                        <span class="">USPTA Certified Coaching Staff</span>
                                    </li>
                                    <li style="display:flex;align-items:center;gap:12px;font-size:16px;font-weight:500;">
                                        <div style="width:24px;height:24px;border-radius:50%;background:var(--primary);
                                        display:flex;align-items:center;justify-content:center;color:white;">
                                            <i class="fa fa-check" style="font-size:14px;"/>
                                        </div>
                                        <span class="">State-of-the-art Fitness &amp; Recovery Center</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="about-image">
                                <img src="/theme_tennis_court/static/src/img/scenes/club_lounge.jpg"
                                     class="o_we_custom_image" alt="Club Lounge"/>
                            </div>
                        </div>
                    </section>
                    <div class="oe_structure oe_empty"/>

                    <!-- Stats Banner -->
                    <section class="tc-stats container section-spacing o_colored_level"
                             data-snippet="theme_tennis_court.tc_stats_banner" data-name="Stats Banner">
                        <div class="stats-section">
                            <div class="stats-grid">
                                <div class="stat-item">
                                    <h4 class="">12k+</h4>
                                    <p class="">Hours Played Annually</p>
                                </div>
                                <div class="stat-item">
                                    <h4 class="">89%</h4>
                                    <p class="">Player Retention Rate</p>
                                </div>
                                <div class="stat-item">
                                    <h4 class="">1,200</h4>
                                    <p class="">Active Members</p>
                                </div>
                                <div class="stat-item">
                                    <h4 class="">125</h4>
                                    <p class="">Annual Tournaments</p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="oe_structure oe_empty"/>

                    <!-- Coaches Grid -->
                    <section class="tc-coaches container section-spacing o_colored_level"
                             data-snippet="theme_tennis_court.tc_coaches_grid" data-name="Coaches Grid">
                        <div class="section-header">
                            <div>
                                <div class="tag-pill">Our Team</div>
                                <h2 class="section-title">Meet our Head Coaches</h2>
                            </div>
                            <a href="/contactus" style="text-decoration:none;">
                                <button class="btn-secondary">See All Coaches</button>
                            </a>
                        </div>
                        <div class="coaches-grid">
                            <div class="coach-card">
                                <img src="/theme_tennis_court/static/src/img/avatars/male_european_35_1.jpg"
                                     class="coach-img o_we_custom_image" alt="Coach"/>
                                <div class="coach-info">
                                    <h4 class="coach-name">David Miller</h4>
                                    <span class="coach-role">Director of Tennis</span>
                                    <p class="coach-desc">Former ATP Tour professional with 15+ years of coaching
                                        experience.
                                    </p>
                                </div>
                            </div>
                            <div class="coach-card">
                                <img src="/theme_tennis_court/static/src/img/avatars/female_na_25.jpg"
                                     class="coach-img o_we_custom_image" alt="Coach"/>
                                <div class="coach-info">
                                    <h4 class="coach-name">Sarah Jenkins</h4>
                                    <span class="coach-role">Head Junior Coach</span>
                                    <p class="coach-desc">Specializes in youth development and collegiate preparation.
                                    </p>
                                </div>
                            </div>
                            <div class="coach-card">
                                <img src="/theme_tennis_court/static/src/img/avatars/male_hispanic_25.jpg"
                                     class="coach-img o_we_custom_image" alt="Coach"/>
                                <div class="coach-info">
                                    <h4 class="coach-name">Carlos Mendez</h4>
                                    <span class="coach-role">Senior Pro</span>
                                    <p class="coach-desc">Expert in modern baseline techniques and biomechanics.</p>
                                </div>
                            </div>
                            <div class="coach-card">
                                <img src="/theme_tennis_court/static/src/img/avatars/female_european_35.jpg"
                                     class="coach-img o_we_custom_image" alt="Coach"/>
                                <div class="coach-info">
                                    <h4 class="coach-name">Elena Rostova</h4>
                                    <span class="coach-role">Strength &amp; Conditioning</span>
                                    <p class="coach-desc">Focuses on tennis-specific fitness and injury prevention.</p>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="oe_structure oe_empty"/>

                    <!-- CTA Banner -->
                    <section class="tc-cta container section-spacing o_colored_level"
                             data-snippet="theme_tennis_court.tc_cta_banner" data-name="CTA Banner">
                        <div class="cta-section">
                            <img class="cta-bg o_we_custom_image"
                                 src="/theme_tennis_court/static/src/img/scenes/night_court.jpg" alt="Night Court"/>
                            <div class="cta-overlay"/>
                            <div class="cta-content">
                                <h2 class="cta-title">Ready to hit the court?</h2>
                                <p class="cta-desc">Join over 1,200 members who have already made Horizon their home
                                    court. Sign up today and book your first session instantly.
                                </p>
                                <a href="/join" style="text-decoration:none;">
                                    <button class="btn-primary"
                                            style="background:white;color:var(--primary);padding:16px 40px;font-size:16px;
                                            margin-top:16px;">
                                        Become a Member
                                    </button>
                                </a>
                            </div>
                        </div>
                    </section>
                    <div class="oe_structure oe_empty"/>
                </div>
            </xpath>
        </data>
    </template>
</odoo>