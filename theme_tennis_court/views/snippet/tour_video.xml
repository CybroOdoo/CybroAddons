<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Full-width video / 360° tour placeholder section -->
    <template id="tc_tour_video" name="Tour Video">
        <section class="section-spacing o_colored_level" data-snippet="theme_tennis_court.tc_tour_video"
                 data-name="Tour Video">
            <div class="container">
                <div style="position: relative; width: 100%; height: 600px; border-radius: var(--radius-xl); overflow: hidden;
                 background: #000;">
                    <img
                            src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg"
                            style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6;"
                            alt="Main tour of indoor tennis court"
                    />
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: flex;
                    flex-direction: column; align-items: center; color: white;">
                        <!-- Centered play button icon -->
                        <div class="play-btn">
                            <i class="fa fa-play" style="font-size: 32px; color: white; margin-left: 4px;"/>
                        </div>
                        <div style="font-size: 18px; font-weight: 600; text-shadow: 0 2px 8px rgba(0,0,0,0.3);"
                             class="">Start 360° Tour
                        </div>
                    </div>
                </div>
            </div>

        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_tour_video_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_tour_video"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Tour Video"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>