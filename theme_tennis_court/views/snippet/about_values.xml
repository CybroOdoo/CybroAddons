<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Core values section with three value cards -->
    <template id="tc_about_values" name="Values">
        <section class="container section-spacing o_colored_level" data-name="Values"
                 data-snippet="theme_tennis_court.tc_about_values">
            <div class="values-section">
                <!-- Centered header with tag pill and title -->
                <div class="values-header">
                    <div class="tag-pill" style="background:white;">Core Pillars</div>
                    <h2 class="section-title" style="margin:0;text-align:center;">What drives us forward</h2>
                </div>
                <!-- Three-column grid of value cards -->
                <div class="values-grid">
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa fa-trophy" style="font-size:28px;"/>
                        </div>
                        <h3 class="value-title">Excellence</h3>
                        <p class="value-desc">From our championship-grade court surfaces to our carefully selected
                            coaching staff, we refuse to compromise on quality.
                        </p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa fa-users" style="font-size:28px;"/>
                        </div>
                        <h3 class="value-title">Community</h3>
                        <p class="value-desc">Tennis is as much about the people as it is about the sport. We foster an
                            environment where friendships are forged.
                        </p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa fa-heartbeat" style="font-size:28px;"/>
                        </div>
                        <h3 class="value-title">Holistic Wellness</h3>
                        <p class="value-desc">We support the complete athlete. Our focus extends beyond technique to
                            include physical conditioning and mental resilience.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_about_values_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_about_values"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Values"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>