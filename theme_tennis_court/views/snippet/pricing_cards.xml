<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Membership pricing cards snippet for use in the website editor -->
    <template id="tc_pricing_cards" name="Tennis Court Pricing Cards">
        <section class="tc-pricing section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.tc_pricing_cards"
                 data-name="Pricing Cards">
            <div class="container">
                <div class="section-header" style="justify-content: center; text-align: center;">
                    <div style="display: flex; flex-direction: column; align-items: center;">
                        <div class="tag-pill">Memberships</div>
                        <h2 class="section-title">Choose your club pass</h2>
                    </div>
                </div>
                <!-- Three-column grid of pricing plan cards -->
                <div class="pricing-grid">
                    <div class="pricing-card" data-name="Guest Pass">
                        <h3 class="pricing-tier">Guest Pass</h3>
                        <div class="pricing-price">
                            <span class="">$35</span>
                            <span class="pricing-period">/day</span>
                        </div>
                        <p class="pricing-desc">Perfect for visitors or those looking to try our facilities before
                            committing.
                        </p>
                        <ul class="pricing-features">
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Full day court access</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Locker room &amp; amenities</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Pro shop access</span>
                            </li>
                            <li class="pricing-feature" style="color:var(--muted-foreground);">
                                <div style="width:20px;display:flex;align-items:center;justify-content:center;color:var(--border);">
                                    <i class="fa fa-minus" style="font-size:20px;"/>
                                </div>
                                <span class="">No advance court booking</span>
                            </li>
                        </ul>
                        <a href="/contactus" style="text-decoration:none;">
                            <button class="btn-secondary pricing-btn">Buy Guest Pass</button>
                        </a>
                    </div>
                    <div class="pricing-card" data-name="Individual"
                         style="border:2px solid var(--accent);box-shadow:0 10px 25px -5px rgba(0,0,0,0.05);">
                        <div class="popular-badge">Most Popular</div>
                        <h3 class="pricing-tier">Individual</h3>
                        <div class="pricing-price">
                            <span class="">$149</span>
                            <span class="pricing-period">/month</span>
                        </div>
                        <p class="pricing-desc">Everything an adult player needs. Full access to courts, clinics, and
                            exclusive events.
                        </p>
                        <ul class="pricing-features">
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Unlimited court time</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">7-day advance booking</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">USTA affiliated leagues</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Access to fitness center</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Complimentary towel service</span>
                            </li>
                        </ul>
                        <a href="/contactus" style="text-decoration:none;">
                            <button class="btn-primary pricing-btn"
                                    style="background-color:var(--accent);color:white;border:none;">Join as Individual
                            </button>
                        </a>
                    </div>
                    <div class="pricing-card" data-name="Family">
                        <h3 class="pricing-tier">Family</h3>
                        <div class="pricing-price">
                            <span class="">$249</span>
                            <span class="pricing-period">/month</span>
                        </div>
                        <p class="pricing-desc">Bring the whole family. Complete membership for up to 4 family
                            members.
                        </p>
                        <ul class="pricing-features">
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Includes 2 adults &amp; 2 children</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Unlimited court time</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">7-day advance booking</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Priority junior camp registration</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle" style="font-size:20px;"/>
                                </div>
                                <span class="">Guest passes (2/month)</span>
                            </li>
                        </ul>
                        <a href="/contactus" style="text-decoration:none;">
                            <button class="btn-primary pricing-btn">Join as Family</button>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_pricing_cards_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_pricing_cards"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Pricing Cards"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>