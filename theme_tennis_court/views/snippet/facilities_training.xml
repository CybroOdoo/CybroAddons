<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Clubhouse amenities section: café, pro shop, locker rooms -->
    <template id="tc_facilities_training" name="Training Center">
        <section class="container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.tc_facilities_training" data-name="Training Center">
            <div class="amenities-section">
                <!-- Stacked image layout: main clubhouse + pro shop inset -->
                <div class="amenities-image-stack">
                    <img class="amenities-img-main" src="/theme_tennis_court/static/src/img/scenes/clubhouse.jpg"
                         alt="Clubhouse"/>
                    <img class="amenities-img-sub" src="/theme_tennis_court/static/src/img/scenes/pro_shop.jpg"
                         alt="Pro Shop"/>
                </div>
                <!-- Text content: heading, description, and amenity items -->
                <div class="amenities-content">
                    <div class="tag-pill">The Clubhouse</div>
                    <h2 class="amenities-heading">Relax, refuel, and re-equip between your matches</h2>
                    <p class="amenities-desc">Our modern clubhouse serves as the central hub. Designed with comfort and
                        luxury in mind.
                    </p>
                    <div class="amenities-list">
                        <div class="amenity-item">
                            <div class="amenity-icon">
                                <i class="fa fa-coffee" style="font-size:28px;"/>
                            </div>
                            <div class="amenity-text">
                                <span class="amenity-name">Courtside Café &amp; Lounge</span>
                                <span class="amenity-sub">Healthy smoothies, artisanal coffee, and fresh meals with
                                    panoramic court views.
                                </span>
                            </div>
                        </div>
                        <div class="amenity-item">
                            <div class="amenity-icon">
                                <i class="fa fa-shopping-bag" style="font-size:28px;"/>
                            </div>
                            <div class="amenity-text">
                                <span class="amenity-name">Pro Shop &amp; Stringing</span>
                                <span class="amenity-sub">Full-service pro shop with latest gear. 24-hour racket
                                    stringing available.
                                </span>
                            </div>
                        </div>
                        <div class="amenity-item">
                            <div class="amenity-icon">
                                <i class="fa fa-shield" style="font-size:28px;"/>
                            </div>
                            <div class="amenity-text">
                                <span class="amenity-name">Executive Locker Rooms</span>
                                <span class="amenity-sub">Spacious secure lockers with towel service, premium
                                    toiletries, and steam rooms.
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_facilities_training_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_facilities_training"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Training Center"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>