<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hero banner for the Facilities page -->
    <template id="tc_facilities_hero" name="Facilities Hero">
        <section class="hero-section container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.tc_facilities_hero" data-name="Facilities Hero">
            <div class="about-hero-container">
                <!-- Full-bleed background image of facilities overview -->
                <div class="about-hero-bg">
                    <img src="/theme_tennis_court/static/src/img/scenes/facilities_overview.jpg"
                         alt="Facilities Overview"/>
                </div>
                <!-- Dark overlay for text readability -->
                <div class="about-hero-overlay"/>
                <div class="about-hero-content">
                    <div class="tag-pill hero-pill-light">Our Facilities</div>
                    <h1 class="about-hero-title">World-class courts.<br/>Unmatched amenities.
                    </h1>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_facilities_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_facilities_hero"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Facilities Hero"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>