<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Virtual tour grid with filterable category tabs -->
    <template id="tc_tour_grid" name="Tour Grid">
        <section class="tc-tour-section section-spacing o_colored_level" data-snippet="theme_tennis_court.tc_tour_grid"
                 data-name="Tour Grid">
            <div class="container">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;
                flex-wrap: wrap; gap: 24px;">
                    <h2 class="section-title" style="margin: 0;">Explore Our Spaces</h2>
                    <!-- Filter buttons: All, Courts, Fitness, Amenities -->
                    <div class="filter-tabs">
                        <div class="filter-tab active" data-filter="all">All Areas</div>
                        <div class="filter-tab" data-filter="courts">Courts</div>
                        <div class="filter-tab" data-filter="fitness">Fitness</div>
                        <div class="filter-tab" data-filter="amenities">Amenities</div>
                    </div>
                </div>

                <!-- Responsive grid of tour cards with image, title, description, and link -->
                <div class="tour-grid">

                    <!-- Card 1 -->
                    <div class="tour-card" data-category="courts">
                        <div class="tour-card-img-wrap">
                            <img src="/theme_tennis_court/static/src/img/scenes/scene_11.jpg" class="tour-card-img"
                                 alt="Indoor Courts"/>
                            <div class="tour-card-label">Indoor Courts</div>
                        </div>
                        <h3 class="tour-card-title">Championship Indoor Courts</h3>
                        <p class="tour-card-desc">
                            Our indoor courts feature state-of-the-art US Open grade hard surfacing and Smart Court
                            tracking systems.
                        </p>
                        <div class="tour-card-link">
                            <span class="">View 360°</span>
                            <i class="fa fa-arrow-right" style="font-size: 16px;"/>
                        </div>
                    </div>

                    <!-- Card 2 -->
                    <div class="tour-card" data-category="courts">
                        <div class="tour-card-img-wrap">
                            <img src="/theme_tennis_court/static/src/img/scenes/scene_15.jpg" class="tour-card-img"
                                 alt="Outdoor Courts"/>
                            <div class="tour-card-label">Outdoor Courts</div>
                        </div>
                        <h3 class="tour-card-title">Premium Outdoor Courts</h3>
                        <p class="tour-card-desc">
                            Six premium outdoor courts offer the perfect sun-lit matches. All outdoor viewing sections
                            are shaded setting.
                        </p>
                        <div class="tour-card-link">
                            <span class="">View 360°</span>
                            <i class="fa fa-arrow-right" style="font-size: 16px;"/>
                        </div>
                    </div>

                    <!-- Card 3 -->
                    <div class="tour-card" data-category="fitness">
                        <div class="tour-card-img-wrap">
                            <img src="/theme_tennis_court/static/src/img/scenes/cardio.jpg" class="tour-card-img"
                                 alt="Gym"/>
                            <div class="tour-card-label">Fitness Center</div>
                        </div>
                        <h3 class="tour-card-title">High-Performance Gym</h3>
                        <p class="tour-card-desc">
                            Fully-equipped conditioning center including extension spaces specifically designed for
                            recovery.
                        </p>
                        <div class="tour-card-link">
                            <span class="">View 360°</span>
                            <i class="fa fa-arrow-right" style="font-size: 16px;"/>
                        </div>
                    </div>

                    <!-- Card 4 -->
                    <div class="tour-card" data-category="amenities">
                        <div class="tour-card-img-wrap">
                            <img src="/theme_tennis_court/static/src/img/scenes/clubhouse.jpg" class="tour-card-img"
                                 alt="Locker Rooms"/>
                            <div class="tour-card-label">Locker Rooms &amp; Spa</div>
                        </div>
                        <h3 class="tour-card-title">Luxury Locker Rooms</h3>
                        <p class="tour-card-desc">
                            Spacious locker rooms featuring private showers, traditional sauna, and a steam room.
                        </p>
                        <div class="tour-card-link">
                            <span class="">View 360°</span>
                            <i class="fa fa-arrow-right" style="font-size: 16px;"/>
                        </div>
                    </div>

                    <!-- Card 5 -->
                    <div class="tour-card" data-category="amenities">
                        <div class="tour-card-img-wrap">
                            <img src="/theme_tennis_court/static/src/img/scenes/club_lounge.jpg" class="tour-card-img"
                                 alt="Cafe"/>
                            <div class="tour-card-label">Courtside Cafe</div>
                        </div>
                        <h3 class="tour-card-title">The Courtside Cafe</h3>
                        <p class="tour-card-desc">
                            Enjoy post-match organic smoothies, healthy meals, and a perfect view of the indoor center
                            court.
                        </p>
                        <div class="tour-card-link">
                            <span class="">View 360°</span>
                            <i class="fa fa-arrow-right" style="font-size: 16px;"/>
                        </div>
                    </div>

                    <!-- Card 6 -->
                    <div class="tour-card" data-category="amenities">
                        <div class="tour-card-img-wrap">
                            <img src="/theme_tennis_court/static/src/img/scenes/pro_shop.jpg" class="tour-card-img"
                                 alt="Pro Shop"/>
                            <div class="tour-card-label">Pro Shop</div>
                        </div>
                        <h3 class="tour-card-title">Horizon Pro Shop</h3>
                        <p class="tour-card-desc">
                            Stocked with the latest rackets, apparel, and offering same-day professional stringing and
                            grip services.
                        </p>
                        <div class="tour-card-link">
                            <span class="">View 360°</span>
                            <i class="fa fa-arrow-right" style="font-size: 16px;"/>
                        </div>
                    </div>

                </div>
            </div>

        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_tour_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_tour_grid"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Tour Grid"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>