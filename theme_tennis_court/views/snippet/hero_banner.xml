<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Full-screen hero banner for the homepage -->
    <template id="tc_hero_banner" name="Tennis Court Hero Banner">
        <section class="tc-hero o_colored_level"
                 data-snippet="theme_tennis_court.tc_hero_banner"
                 data-name="Hero Banner">
            <div class="hero-section container">
                <div class="hero-container">
                    <!-- Background image behind the hero content -->
                    <div class="hero-bg">
                        <img src="/theme_tennis_court/static/src/img/scenes/hero_court.jpg"
                             class="o_we_custom_image"
                             alt="Tennis players on court"/>
                    </div>
                    <!-- Dark gradient overlay for text legibility -->
                    <div class="hero-overlay"/>
                    <div class="hero-content">
                        <!-- Star rating badge shown above the headline -->
                        <div class="hero-badge">
                            <div class="stars">
                                <i class="fa fa-star"/>
                                <i class="fa fa-star"/>
                                <i class="fa fa-star"/>
                                <i class="fa fa-star"/>
                                <i class="fa fa-star"/>
                            </div>
                            <span class="">Rated 4.9/5 by 1,200+ members</span>
                        </div>
                        <h1 class="hero-title">
                            Unleash Your Champion Today.<br/>All In One Place.
                        </h1>
                        <p class="hero-subtitle">
                            Join the ultimate tennis experience where passion meets
                            performance, world-class facilities await, and every swing
                            brings you closer to victory.
                        </p>
                        <!-- Primary and secondary CTA buttons -->
                        <div class="hero-actions">
                            <a href="/about" class="btn-primary"
                               style="padding: 16px 32px; font-size: 16px; text-decoration: none;">
                                Start your journey
                            </a>
                            <a href="/contactus" class="btn-secondary"
                               style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2); color: white;
                               padding: 16px 32px; font-size: 16px; text-decoration: none;">
                                <i class="fa fa-play-circle" style="font-size: 20px; color: white;"/>
                                Tour the Club
                            </a>
                        </div>
                    </div>
                    <!-- Member avatar strip and tagline in the bottom-left corner -->
                    <div class="hero-bottom-left">
                        <div class="hero-avatars">
                            <img src="/theme_tennis_court/static/src/img/avatars/male_european_25.jpg"
                                 class="hero-avatar" alt="Player 1"/>
                            <img src="/theme_tennis_court/static/src/img/avatars/female_european_25.jpg"
                                 class="hero-avatar" alt="Player 2"/>
                            <img src="/theme_tennis_court/static/src/img/avatars/male_na_35.jpg"
                                 class="hero-avatar" alt="Player 3"/>
                            <div class="hero-avatar"
                                 style="background: var(--accent); display: flex; align-items: center;
                                 justify-content: center; font-size: 12px; font-weight: 600; color: white;
                                 border: 2px solid rgba(255,255,255,0.2);">
                                +5k
                            </div>
                        </div>
                        <div class="hero-bottom-text">
                            Train with real professionals.<br/>Join an active community.
                        </div>
                    </div>
                    <!-- Social media links in the bottom-right corner -->
                    <div class="hero-bottom-right">
                        <a class="social-link">Instagram
                            <i class="fa fa-external-link" style="font-size: 14px; color: white;"/>
                        </a>
                        <a class="social-link">Facebook
                            <i class="fa fa-external-link" style="font-size: 14px; color: white;"/>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_hero_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_hero_banner"
               string="Hero Banner"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>