<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Leadership team grid section -->
    <template id="tc_about_leadership" name="Leadership">
        <section class="container section-spacing o_colored_level" data-name="Leadership"
                 data-snippet="theme_tennis_court.tc_about_leadership">
            <!-- Section heading with tag pill and title -->
            <div class="section-header">
                <div>
                    <div class="tag-pill">Leadership</div>
                    <h2 class="section-title">The team behind the net</h2>
                </div>
            </div>
            <!-- Grid of leadership team member cards -->
            <div class="team-grid">
                <div class="team-card">
                    <img src="/theme_tennis_court/static/src/img/avatars/male_european_50.jpg" class="team-img"
                         alt="Leader"/>
                    <div class="team-info">
                        <h4 class="team-name">Arthur Pendelton</h4>
                        <span class="team-role">Founder &amp; CEO</span>
                    </div>
                </div>
                <div class="team-card">
                    <img src="/theme_tennis_court/static/src/img/avatars/female_na_35_2.jpg" class="team-img"
                         alt="Leader"/>
                    <div class="team-info">
                        <h4 class="team-name">Jessica Vance</h4>
                        <span class="team-role">Chief Operating Officer</span>
                    </div>
                </div>
                <div class="team-card">
                    <img src="/theme_tennis_court/static/src/img/avatars/male_african_35.jpg" class="team-img"
                         alt="Leader"/>
                    <div class="team-info">
                        <h4 class="team-name">Marcus Hayes</h4>
                        <span class="team-role">Director of Operations</span>
                    </div>
                </div>
                <div class="team-card">
                    <img src="/theme_tennis_court/static/src/img/avatars/female_na_35_2.jpg" class="team-img"
                         alt="Leader"/>
                    <div class="team-info">
                        <h4 class="team-name">Chloe Lin</h4>
                        <span class="team-role">Head of Member Experience</span>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_about_leadership_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_about_leadership"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Leadership"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>