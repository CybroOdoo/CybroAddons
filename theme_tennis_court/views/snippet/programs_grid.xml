<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Programs overview: descriptive text left, visual cards right -->
    <template id="tc_programs_grid" name="Tennis Court Programs Grid">
        <section class="tc-programs services-section container py-5 o_colored_level"
                 data-snippet="theme_tennis_court.tc_programs_grid"
                 data-name="Programs Grid">
            <!-- Left column: tag, heading, description, and CTA button -->
            <div class="services-left" data-name="Left Column">
                <div class="tag-pill mb-4 o_editable">Programs</div>
                <h2 class="services-title mb-4 o_editable">
                    Explore our full range of coaching, training, and events.
                </h2>
                <p class="services-desc mb-4 text-muted o_editable">
                    From first serve to match point — we've got the right program for
                    you. Whether you're looking for structured academy training or
                    casual social play, you'll find it here.
                </p>
                <a href="/contactus" class="mt-3 d-inline-block" style="text-decoration: none;">
                    <button class="btn-primary">
                        View Schedule
                        <i class="fa fa-arrow-right" style="font-size: 16px; color: white; margin-left: 8px;"/>
                    </button>
                </a>
            </div>
            <!-- Right column: tall academy card + two half-height cards -->
            <div class="services-right" data-name="Right Column">
                <div class="svc-card-tall">
                    <img src="/theme_tennis_court/static/src/img/scenes/junior_academy.jpg"
                         class="o_we_custom_image" alt="Tennis Training"/>
                    <div class="svc-card-tall-overlay"/>
                    <div class="svc-pill o_editable">Academy</div>
                    <div style="margin-top: auto;">
                        <div class="svc-tall-text o_editable">High-Performance Training</div>
                        <div class="svc-tall-desc o_editable">
                            Intensive programs designed for juniors aiming for collegiate
                            or professional levels.
                        </div>
                    </div>
                </div>
                <div class="svc-col-right">
                    <div class="svc-card-half">
                        <img src="/theme_tennis_court/static/src/img/scenes/cardio.jpg"
                             class="o_we_custom_image" alt="Court Access"/>
                        <div class="svc-card-tall-overlay"/>
                        <div class="svc-pill o_editable">Court Access</div>
                        <div class="svc-half-text o_editable">
                            Hourly Rentals &amp; Subscriptions
                        </div>
                    </div>
                    <div class="svc-card-half">
                        <img src="/theme_tennis_court/static/src/img/scenes/competitive.jpg"
                             class="o_we_custom_image" alt="Social Leagues"/>
                        <div class="svc-card-tall-overlay"/>
                        <div class="svc-pill o_editable">Community</div>
                        <div class="svc-half-text o_editable">Adult Social Leagues</div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_programs_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_programs_grid"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Programs Grid"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>