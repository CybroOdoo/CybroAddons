<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Key statistics banner: hours played, retention, members, tournaments -->
    <template id="tc_stats_banner" name="Tennis Court Stats Banner">
        <section class="tc-stats container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.tc_stats_banner"
                 data-name="Stats Banner">
            <div class="stats-section">
                <!-- Four-column grid of stat items -->
                <div class="stats-grid">
                    <div class="stat-item" data-name="Stat 1">
                        <h4 class="">12k+</h4>
                        <p class="">Hours Played Annually</p>
                    </div>
                    <div class="stat-item" data-name="Stat 2">
                        <h4 class="">89%</h4>
                        <p class="">Player Retention Rate</p>
                    </div>
                    <div class="stat-item" data-name="Stat 3">
                        <h4 class="">1,200</h4>
                        <p class="">Active Members</p>
                    </div>
                    <div class="stat-item" data-name="Stat 4">
                        <h4 class="">125</h4>
                        <p class="">Annual Tournaments</p>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_stats_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_stats_banner"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Stats Banner"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>