<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Adult programs grid: private lessons, cardio tennis, tournaments -->
    <template id="tc_programs_adult" name="Adult Leagues">
        <section class="container section-spacing o_colored_level" data-snippet="theme_tennis_court.tc_programs_adult"
                 data-name="Adult Leagues">
            <div class="section-header">
                <div>
                    <div class="tag-pill">All Programs</div>
                    <h2 class="section-title">Find your perfect fit</h2>
                </div>
            </div>
            <!-- Three-column grid of program cards with price and CTA -->
            <div class="programs-grid">
                <div class="program-card">
                    <div class="program-card-img">
                        <img src="/theme_tennis_court/static/src/img/scenes/private_coaching.jpg"
                             alt="Private Coaching"/>
                        <div class="program-card-tag">Private Coaching</div>
                    </div>
                    <div class="program-card-body">
                        <h3 class="program-card-title">1-on-1 Private Lessons</h3>
                        <p class="program-card-desc">Personalized instruction tailored to your goals. Rapid improvement
                            at any skill level.
                        </p>
                        <div class="program-card-meta">
                            <span class="program-tag-chip">
                                <i class="fa fa-clock-o" style="font-size:14px;"/>
                                60 min
                            </span>
                            <span class="program-tag-chip">
                                <i class="fa fa-users" style="font-size:14px;"/>
                                All levels
                            </span>
                        </div>
                        <div class="program-card-footer">
                            <div class="program-price">$95
                                <span>/ session</span>
                            </div>
                            <a href="/contactus" style="text-decoration:none;">
                                <button class="btn-primary" style="padding:10px 20px;font-size:13px;">Book Now</button>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="program-card">
                    <div class="program-card-img">
                        <img src="/theme_tennis_court/static/src/img/scenes/cardio.jpg" alt="Cardio Tennis"/>
                        <div class="program-card-tag">Fitness</div>
                    </div>
                    <div class="program-card-body">
                        <h3 class="program-card-title">Cardio Tennis</h3>
                        <p class="program-card-desc">High-energy group fitness using tennis drills. Fun social workout
                            improving footwork and endurance.
                        </p>
                        <div class="program-card-meta">
                            <span class="program-tag-chip">
                                <i class="fa fa-clock-o" style="font-size:14px;"/>
                                45 min
                            </span>
                            <span class="program-tag-chip">
                                <i class="fa fa-bolt" style="font-size:14px;"/>
                                High energy
                            </span>
                        </div>
                        <div class="program-card-footer">
                            <div class="program-price">$25
                                <span>/ class</span>
                            </div>
                            <a href="/contactus" style="text-decoration:none;">
                                <button class="btn-primary" style="padding:10px 20px;font-size:13px;">Book Now</button>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="program-card">
                    <div class="program-card-img">
                        <img src="/theme_tennis_court/static/src/img/scenes/night_court.jpg" alt="Tournaments"/>
                        <div class="program-card-tag">Tournament</div>
                    </div>
                    <div class="program-card-body">
                        <h3 class="program-card-title">Club Tournaments</h3>
                        <p class="program-card-desc">USTA-sanctioned and club-exclusive tournaments. Full draws for
                            Singles, Doubles, and Mixed.
                        </p>
                        <div class="program-card-meta">
                            <span class="program-tag-chip">
                                <i class="fa fa-calendar" style="font-size:14px;"/>
                                Monthly
                            </span>
                            <span class="program-tag-chip">
                                <i class="fa fa-trophy" style="font-size:14px;"/>
                                USTA rated
                            </span>
                        </div>
                        <div class="program-card-footer">
                            <div class="program-price">$45
                                <span>/ entry</span>
                            </div>
                            <a href="/contactus" style="text-decoration:none;">
                                <button class="btn-primary" style="padding:10px 20px;font-size:13px;">Register</button>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_programs_adult_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_programs_adult"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Adult Leagues"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>