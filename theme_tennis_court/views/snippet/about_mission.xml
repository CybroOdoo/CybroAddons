<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Mission statement section with image and founder signature -->
    <template id="tc_about_mission" name="Mission">
        <section class="container section-spacing o_colored_level" data-name="Mission"
                 data-snippet="theme_tennis_court.tc_about_mission">
            <div class="mission-grid">
                <!-- Left column: mission text, paragraphs, and founder attribution -->
                <div class="mission-text-content">
                    <div class="tag-pill">Our Mission</div>
                    <h2 class="mission-heading">We exist to elevate the game of tennis and build a community united by
                        passion.
                    </h2>
                    <p class="mission-paragraph">Since our doors opened, Horizon Courts has been driven by a singular
                        vision: to create the ultimate environment for tennis players to thrive. We believe that
                        top-tier facilities must be paired with an inclusive, welcoming community to truly inspire
                        greatness.
                    </p>
                    <p class="mission-paragraph">Whether you're an aspiring junior professional, a dedicated league
                        player, or someone stepping onto the court for the very first time, our commitment remains the
                        same.
                    </p>
                    <div style="margin-top:24px;display:flex;gap:16px;">
                        <img src="/theme_tennis_court/static/src/img/avatars/male_european_50.jpg" alt="Founder"
                             style="width:64px;height:64px;border-radius:50%;object-fit:cover;"/>
                        <div style="display:flex;flex-direction:column;justify-content:center;">
                            <div style="font-weight:600;font-size:16px;" class="">Arthur Pendelton</div>
                            <div style="color:var(--muted-foreground);font-size:14px;" class="">Founder &amp; CEO</div>
                        </div>
                    </div>
                </div>
                <!-- Right column: supporting image -->
                <div class="mission-image">
                    <img src="/theme_tennis_court/static/src/img/scenes/coaches_bg.jpg" alt="Players shaking hands"/>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_about_mission_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_about_mission"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Mission"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>