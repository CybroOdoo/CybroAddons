<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Partner and sponsor logo strip -->
    <template id="tc_partners_strip" name="Tennis Court Partners Strip">
        <section class="tc-partners logos-section container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.tc_partners_strip"
                 data-name="Partners Strip">
            <div class="logos-title">Official Partners &amp; Sponsors</div>
            <!-- Flex row of partner logo items -->
            <div class="logos-grid">
                <div class="logo-item">
                    <i class="fa fa-play" style="font-size: 24px;"/>
                    <span class="">Wilson</span>
                </div>
                <div class="logo-item">
                    <i class="fa fa-hexagon" style="font-size: 24px;"/>
                    <span class="">Head Pro</span>
                </div>
                <div class="logo-item">
                    <i class="fa fa-dot-circle-o" style="font-size: 24px;"/>
                    <span class="">Babolat</span>
                </div>
                <div class="logo-item">
                    <i class="fa fa-leaf" style="font-size: 24px;"/>
                    <span class="">Yonex</span>
                </div>
                <div class="logo-item">
                    <i class="fa fa-trophy" style="font-size: 24px;"/>
                    <span class="">ATP Tour</span>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_partners_strip_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_partners_strip"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Partners Strip"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>