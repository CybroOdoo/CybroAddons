<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Fitness and recovery amenities section with three value cards -->
    <template id="tc_facilities_amenities" name="Pro Shop &amp; Amenities">
        <section class="container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.tc_facilities_amenities" data-name="Pro Shop &amp; Amenities">
            <div class="values-section">
                <div class="values-header">
                    <div class="tag-pill" style="background:white;">Fitness &amp; Recovery</div>
                    <h2 class="section-title" style="margin:0;text-align:center;">Train. Recover. Repeat.</h2>
                </div>
                <!-- Three-column grid: gym, physio, recovery suites -->
                <div class="values-grid">
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa fa-heartbeat" style="font-size:28px;"/>
                        </div>
                        <h3 class="value-title">Performance Gym</h3>
                        <p class="value-desc">Fully equipped fitness center with cardio, free weights, and functional
                            training zones for tennis conditioning.
                        </p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa fa-line-chart" style="font-size:28px;"/>
                        </div>
                        <h3 class="value-title">Physiotherapy Clinic</h3>
                        <p class="value-desc">On-site sports physiotherapists for injury prevention, mobility screening,
                            and rehabilitation programs.
                        </p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">
                            <i class="fa fa-sun-o" style="font-size:28px;"/>
                        </div>
                        <h3 class="value-title">Recovery Suites</h3>
                        <p class="value-desc">Post-match recovery with ice baths, infrared saunas, and normatec
                            compression therapy.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_facilities_amenities_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_facilities_amenities"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Pro Shop &amp; Amenities"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>