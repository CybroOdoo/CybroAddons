<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Main courts section: indoor hard courts and outdoor clay courts -->
    <template id="tc_facilities_main_courts" name="Main Courts">
        <section class="container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.tc_facilities_main_courts" data-name="Main Courts">
            <div class="section-header">
                <div>
                    <div class="tag-pill">The Courts</div>
                    <h2 class="section-title">Play year-round, whatever the weather</h2>
                </div>
            </div>
            <!-- Two-column grid comparing indoor and outdoor courts -->
            <div class="court-grid">
                <div class="court-card">
                    <div class="court-image">
                        <img src="/theme_tennis_court/static/src/img/scenes/scene_11.jpg" alt="Indoor Courts"/>
                    </div>
                    <h3 class="court-title">Championship Indoor Hard Courts</h3>
                    <p class="court-desc">Our eight indoor courts feature a tournament-grade multi-layer acrylic surface
                        designed for medium-fast play and optimal shock absorption.
                    </p>
                    <ul class="court-features">
                        <li class="court-feature-item">
                            <div class="court-feature-icon">
                                <i class="fa fa-check" style="font-size:16px;"/>
                            </div>
                            Climate-controlled (70°F year-round)
                        </li>
                        <li class="court-feature-item">
                            <div class="court-feature-icon">
                                <i class="fa fa-check" style="font-size:16px;"/>
                            </div>
                            Anti-glare LED tournament lighting
                        </li>
                        <li class="court-feature-item">
                            <div class="court-feature-icon">
                                <i class="fa fa-check" style="font-size:16px;"/>
                            </div>
                            Smart court camera integration
                        </li>
                    </ul>
                </div>
                <div class="court-card">
                    <div class="court-image">
                        <img src="/theme_tennis_court/static/src/img/scenes/scene_15.jpg" alt="Outdoor Courts"/>
                    </div>
                    <h3 class="court-title">Premium Outdoor Clay Courts</h3>
                    <p class="court-desc">Experience the traditional European game on our ten pristine red clay courts.
                        Meticulously maintained daily for consistent bounce.
                    </p>
                    <ul class="court-features">
                        <li class="court-feature-item">
                            <div class="court-feature-icon">
                                <i class="fa fa-check" style="font-size:16px;"/>
                            </div>
                            Sub-surface irrigation system
                        </li>
                        <li class="court-feature-item">
                            <div class="court-feature-icon">
                                <i class="fa fa-check" style="font-size:16px;"/>
                            </div>
                            Shaded spectator seating
                        </li>
                        <li class="court-feature-item">
                            <div class="court-feature-icon">
                                <i class="fa fa-check" style="font-size:16px;"/>
                            </div>
                            Professional daily grooming
                        </li>
                    </ul>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_facilities_main_courts_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_facilities_main_courts"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Main Courts"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>