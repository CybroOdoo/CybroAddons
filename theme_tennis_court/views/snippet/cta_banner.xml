<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Full-width CTA banner with background image, overlay, and button -->
    <template id="tc_cta_banner" name="Tennis Court CTA Banner">
        <section class="tc-cta container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.tc_cta_banner"
                 data-name="CTA Banner">
            <div class="cta-section">
                <!-- Background image for the CTA section -->
                <img class="cta-bg o_we_custom_image"
                     src="/theme_tennis_court/static/src/img/scenes/night_court.jpg"
                     alt="Night Court"/>
                <!-- Semi-transparent overlay for contrast -->
                <div class="cta-overlay"/>
                <!-- Headline, description text, and CTA button -->
                <div class="cta-content">
                    <h2 class="cta-title">Ready to hit the court?</h2>
                    <p class="cta-desc">
                        Join over 1,200 members who have already made Horizon their home
                        court. Sign up today and book your first session instantly.
                    </p>
                    <a href="/join" style="text-decoration: none;">
                        <button class="btn-primary"
                                style="background: white; color: var(--primary); padding: 16px 40px; font-size: 16px;
                                margin-top: 16px;">
                            Become a Member
                        </button>
                    </a>
                </div>
            </div>
        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_cta_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_cta_banner"
               string="CTA Banner"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>