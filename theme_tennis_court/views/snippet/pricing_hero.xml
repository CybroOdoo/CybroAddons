<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hero banner for the Pricing page -->
    <template id="tc_pricing_hero" name="Pricing Hero">
        <section class="programs-hero-section section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.tc_pricing_hero" data-name="Pricing Hero">
            <div class="container">
                <div class="programs-hero-container">
                    <!-- Full-bleed background image -->
                    <div class="programs-hero-bg">
                        <img src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg" alt="Tennis court"/>
                    </div>
                    <!-- Dark overlay for text readability -->
                    <div class="programs-hero-overlay"/>
                    <!-- Heading, tag pill, and subtitle text -->
                    <div class="programs-hero-content">
                        <div class="tag-pill hero-pill-light">Memberships</div>
                        <h1 class="programs-hero-title">Simple, transparent pricing</h1>
                        <p class="programs-hero-subtitle">Choose the membership that fits your game. Whether you play
                            once a month or every day, we have a plan for you.
                        </p>
                    </div>
                </div>
            </div>

        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_pricing_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_pricing_hero"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Pricing Hero"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>