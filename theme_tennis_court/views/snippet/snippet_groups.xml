<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Adds a custom "Tennis Court Sections" group in the snippets panel -->
    <template id="tc_snippet_groups" inherit_id="website.snippets"
              name="Tennis Court Snippet Groups" priority="5">
        <xpath expr="//div[@id='snippet_content']" position="after">
            <div id="snippet_tennis_court" class="o_panel">
                <div class="o_panel_header">Tennis Court Sections</div>
                <div class="o_panel_body">
                    <!-- Snippets are registered inside this container -->
                </div>
            </div>
        </xpath>
    </template>
</odoo>