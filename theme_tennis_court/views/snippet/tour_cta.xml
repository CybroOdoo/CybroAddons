<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Split CTA section: text left, club exterior image right -->
    <template id="tc_tour_cta" name="Tour CTA">
        <section class="section-spacing o_colored_level" style="margin-bottom: 120px;"
                 data-snippet="theme_tennis_court.tc_tour_cta" data-name="Tour CTA">
            <div class="container">
                <div class="cta-split">
                    <div style="flex: 1; padding: 80px 64px; display: flex; flex-direction: column; justify-content: center;">
                        <h2 class=""
                            style="font-size: 36px; font-weight: 700; margin-bottom: 24px; color: var(--foreground);">
                            Prefer to see it in person?
                        </h2>
                        <p class=""
                           style="font-size: 16px; color: var(--muted-foreground); margin-bottom: 40px; line-height: 1.6;
                           max-width: 480px;">
                            Book a guided tour with our membership team. We'll show you around the facilities, answer
                            your questions, and you can even hit a few balls on center court.
                        </p>
                        <div style="display: flex; align-items: center; gap: 24px; flex-wrap: wrap;">
                            <a href="/join" style="text-decoration: none;">
                                <button class="btn-primary" style="padding: 16px 32px;">Schedule a Visit</button>
                            </a>
                            <div style="display: flex; align-items: center; gap: 8px; color: var(--muted-foreground);
                            font-size: 13px;">
                                <i class="fa fa-clock-o" style="font-size: 16px;"/>
                                <span class="">Tours available daily from 9 AM to 7 PM</span>
                            </div>
                        </div>
                    </div>
                    <div style="flex: 1;" class="cta-split-img">
                        <img src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg"
                             style="width: 100%; height: 100%; object-fit: cover;" alt="Welcome desk"/>
                    </div>
                </div>
            </div>

        </section>
    </template>

    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="tc_tour_cta_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_tennis_court']/div[@class='o_panel_body']" position="inside">
            <t t-snippet="theme_tennis_court.tc_tour_cta"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Tour CTA"
               group="tc_section"/>
        </xpath>
    </template>
</odoo>