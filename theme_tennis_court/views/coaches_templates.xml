<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full Coaches page template -->
    <template id="coaches_templates" name="Tennis Court Coaches">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero -->
                <section class="programs-hero-section container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_coaches_hero" data-name="Coaches Hero">
                    <div class="programs-hero-container">
                        <div class="programs-hero-bg"><img src="/theme_tennis_court/static/src/img/scenes/coaches_bg.jpg" alt="Coaches"/></div>
                        <div class="programs-hero-overlay"/>
                        <div class="programs-hero-content">
                            <div class="tag-pill hero-pill-light o_editable">Our Team</div>
                            <h1 class="programs-hero-title o_editable">Meet the experts.<br/>Train with the best.</h1>
                        </div>
                    </div>
                </section>
                <!-- Philosophy -->
                <section class="container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_coaches_head_coach" data-name="Head Coach">
                    <div style="background-color:var(--background);padding:80px 40px;border-radius:var(--radius-xl);text-align:center;">
                        <div class="tag-pill o_editable" style="background:white;display:inline-block;">Our approach</div>
                        <h2 class="section-title o_editable" style="margin:0 auto 64px auto;">The Horizon Philosophy</h2>
                        <div class="grid-3-cols text-start">
                            <div class="facility-card" style="border:none;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);"><div class="facility-icon" style="background-color:rgba(255,183,77,0.15);color:var(--accent);"><i class="fa fa-crosshairs" style="font-size:20px;"/></div><h3 class="facility-title o_editable" style="font-size:18px;font-weight:600;">Goal-Oriented</h3><p class="facility-desc o_editable">An evolving program that accommodates all styles of play, tailoring our approach to maximize every player's potential.</p></div>
                            <div class="facility-card" style="border:none;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);"><div class="facility-icon" style="background-color:rgba(11,100,214,0.1);color:var(--primary);"><i class="fa fa-video-camera" style="font-size:20px;"/></div><h3 class="facility-title o_editable" style="font-size:18px;font-weight:600;">Data-Driven</h3><p class="facility-desc o_editable">We incorporate video technology and analysis for objective feedback. You cannot change what you can't see.</p></div>
                            <div class="facility-card" style="border:none;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);"><div class="facility-icon" style="background-color:rgba(232,90,79,0.1);color:var(--destructive);"><i class="fa fa-handshake-o" style="font-size:20px;"/></div><h3 class="facility-title o_editable" style="font-size:18px;font-weight:600;">Mentorship</h3><p class="facility-desc o_editable">Our mentors care deeply about player development. We teach resilience, discipline, and sportsmanship.</p></div>
                        </div>
                    </div>
                </section>
                <!-- Directors -->
                <section class="container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_coaches_senior" data-name="Senior Pros">
                    <div class="section-header"><div><div class="tag-pill o_editable">Leadership</div><h2 class="section-title o_editable">Directors &amp; Head Professionals</h2></div></div>
                    <div class="grid-3-cols">
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/michael_vance.png" class="coach-img" alt="Michael Vance"/><div class="coach-info"><h4 class="coach-name o_editable">Michael Vance</h4><span class="coach-role o_editable" style="color:var(--primary);">Director of Tennis</span><p class="coach-desc o_editable">Former touring professional with 15+ years of coaching experience. Oversees all club programming.</p></div></div>
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/sarah_jenkins.png" class="coach-img" alt="Sarah Jenkins"/><div class="coach-info"><h4 class="coach-name o_editable">Sarah Jenkins</h4><span class="coach-role o_editable" style="color:var(--primary);">Head Professional - Junior Programs</span><p class="coach-desc o_editable">Specialized in high-performance junior development and collegiate preparation.</p></div></div>
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/david_chen.png" class="coach-img" alt="David Chen"/><div class="coach-info"><h4 class="coach-name o_editable">David Chen</h4><span class="coach-role o_editable" style="color:var(--primary);">Head Professional - Adult Programs</span><p class="coach-desc o_editable">USPTA Elite Professional ensuring adult programs are engaging and tactical.</p></div></div>
                    </div>
                </section>
                <!-- Elite Coaches -->
                <section class="container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_coaches_fitness" data-name="Fitness Trainers">
                    <div class="section-header"><div><div class="tag-pill o_editable">Our Staff</div><h2 class="section-title o_editable">Elite Coaches</h2></div></div>
                    <div class="coaches-grid">
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/elena_rostova.png" class="coach-img" alt="Elena Rostova"/><div class="coach-info"><h4 class="coach-name o_editable">Elena Rostova</h4><span class="coach-role o_editable">Senior Coach</span><p class="coach-desc o_editable">Known for technical precision and energetic on-court presence. Former top-300 WTA player.</p></div></div>
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/marcus_johnson.png" class="coach-img" alt="Marcus Johnson"/><div class="coach-info"><h4 class="coach-name o_editable">Marcus Johnson</h4><span class="coach-role o_editable">Performance Coach</span><p class="coach-desc o_editable">Focuses on matchplay tactics, psychological resilience, and athletic conditioning.</p></div></div>
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/chloe_smith.png" class="coach-img" alt="Chloe Smith"/><div class="coach-info"><h4 class="coach-name o_editable">Chloe Smith</h4><span class="coach-role o_editable">Junior Coach</span><p class="coach-desc o_editable">Building strong foundations and a love for the game in our 10-and-under programs.</p></div></div>
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/michael_vance.png" class="coach-img" alt="James Wilson"/><div class="coach-info"><h4 class="coach-name o_editable">James Wilson</h4><span class="coach-role o_editable">Cardio Tennis Specialist</span><p class="coach-desc o_editable">High-energy fitness backgrounds applied to cardio tennis and adult intermediate classes.</p></div></div>
                    </div>
                </section>
                <!-- CTA -->
                <section class="container o_colored_level" style="margin-bottom:120px;">
                    <div class="cta-section">
                        <img class="cta-bg" src="/theme_tennis_court/static/src/img/scenes/night_court.jpg" alt="Court"/>
                        <div class="cta-overlay"/>
                        <div class="cta-content" style="text-align:center;">
                            <h2 class="cta-title o_editable">Ready to elevate your game?</h2>
                            <p class="cta-desc o_editable">Book a session with one of our elite coaches today.</p>
                            <a href="/contactus" style="text-decoration:none;"><button class="btn-primary" style="background:white;color:var(--primary);padding:16px 32px;font-size:16px;margin-top:16px;">Book a Session</button></a>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
    <!-- Publishes the Coaches page at /coaches -->
    <record id="coaches_templates_record" model="theme.website.page">
        <field name="url">/coaches</field>
        <field name="view_id" ref="coaches_templates"/>
        <field name="is_published">True</field>
    </record>
</odoo>
