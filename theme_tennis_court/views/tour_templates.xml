<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full Club Tour page assembled from reusable snippets -->
    <template id="tour_templates" name="Tennis Court Tour">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Renders the tour hero banner -->
                <t t-call="theme_tennis_court.s_tour_hero"/>
                <!-- Renders the 360° video placeholder -->
                <t t-call="theme_tennis_court.s_tour_video"/>
                <!-- Renders the filterable tour spaces grid -->
                <t t-call="theme_tennis_court.s_tour_grid"/>
                <!-- Renders the "Book a Visit" CTA split section -->
                <t t-call="theme_tennis_court.s_tour_cta"/>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
    <!-- Publishes the Tour page at /tour -->
    <record id="tour_templates_record" model="theme.website.page">
        <field name="url">/tour</field>
        <field name="view_id" ref="tour_templates"/>
        <field name="is_published">True</field>
    </record>
</odoo>
