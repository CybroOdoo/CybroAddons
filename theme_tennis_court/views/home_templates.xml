                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Full day court access</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Locker room &amp; amenities
                                </span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Pro shop access</span>
                            </li>
                            <li class="pricing-feature"
                                style="color:var(--muted-foreground);">
                                <div style="width:20px;display:flex;align-items:center;justify-content:center;color:var(--border);">
                                    <i class="fa fa-minus" style="font-size:20px;"/>
                                </div>
