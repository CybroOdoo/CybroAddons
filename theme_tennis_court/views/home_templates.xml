<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Home page: replaces the default Odoo homepage content -->
    <template id="home_templates" name="Tennis Court Home Page" inherit_id="website.homepage">
        <data name="Tennis Court Home Page" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- Hero Banner -->
                <section class="tc-hero o_colored_level" data-snippet="theme_tennis_court.s_hero_banner" data-name="Hero Banner">
                    <div class="hero-section container">
                        <div class="hero-container">
                            <div class="hero-bg">
                                <img src="/theme_tennis_court/static/src/img/scenes/hero_court.jpg" class="o_we_custom_image" alt="Tennis players on court"/>
                            </div>
                            <div class="hero-overlay"/>
                            <div class="hero-content">
                                <div class="hero-badge">
                                    <div class="stars"><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/></div>
                                    <span class="o_editable">Rated 4.9/5 by 1,200+ members</span>
                                </div>
                                <h1 class="hero-title o_editable">Unleash Your Champion Today.<br/>All In One Place.</h1>
                                <p class="hero-subtitle o_editable">Join the ultimate tennis experience where passion meets performance, world-class facilities await, and every swing brings you closer to victory.</p>
                                <div class="hero-actions">
                                    <a href="/about" class="btn-primary" style="padding:16px 32px;font-size:16px;text-decoration:none;">Start your journey</a>
                                    <a href="/tour" class="btn-secondary" style="background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.2);color:white;padding:16px 32px;font-size:16px;text-decoration:none;"><i class="fa fa-play-circle" style="font-size:20px;color:white;"/> Tour the Club</a>
                                </div>
                            </div>
                            <div class="hero-bottom-left">
                                <div class="hero-avatars">
                                    <img src="/theme_tennis_court/static/src/img/avatars/male_european_25.jpg" class="hero-avatar" alt="Player 1"/>
                                    <img src="/theme_tennis_court/static/src/img/avatars/female_european_25.jpg" class="hero-avatar" alt="Player 2"/>
                                    <img src="/theme_tennis_court/static/src/img/avatars/male_na_35.jpg" class="hero-avatar" alt="Player 3"/>
                                    <div class="hero-avatar" style="background:var(--accent);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:white;border:2px solid rgba(255,255,255,0.2);">+5k</div>
                                </div>
                                <div class="hero-bottom-text o_editable">Train with real professionals.<br/>Join an active community.</div>
                            </div>
                            <div class="hero-bottom-right">
                                <a class="social-link">Instagram <i class="fa fa-external-link" style="font-size:14px;color:white;"/></a>
                                <a class="social-link">Facebook <i class="fa fa-external-link" style="font-size:14px;color:white;"/></a>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Partners Strip -->
                <section class="tc-partners logos-section container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_partners_strip" data-name="Partners Strip">
                    <div class="logos-title o_editable">Official Partners &amp; Sponsors</div>
                    <div class="logos-grid">
                        <div class="logo-item"><i class="fa fa-play" style="font-size:24px;"/> <span class="o_editable">Wilson</span></div>
                        <div class="logo-item"><i class="fa fa-cube" style="font-size:24px;"/> <span class="o_editable">Head Pro</span></div>
                        <div class="logo-item"><i class="fa fa-dot-circle-o" style="font-size:24px;"/> <span class="o_editable">Babolat</span></div>
                        <div class="logo-item"><i class="fa fa-leaf" style="font-size:24px;"/> <span class="o_editable">Yonex</span></div>
                        <div class="logo-item"><i class="fa fa-trophy" style="font-size:24px;"/> <span class="o_editable">ATP Tour</span></div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- About Intro -->
                <section class="tc-about container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_about_intro" data-name="About Intro">
                    <div class="about-section">
                        <div class="about-text-content">
                            <div class="tag-pill o_editable">The Horizon Difference</div>
                            <h2 class="about-text o_editable">At Horizon, we don't just play tennis — we live it. Our club has been a sanctuary for players of all levels since 2012.</h2>
                            <p class="about-subtext o_editable">Whether you're picking up a racket for the very first time, looking for a competitive league, or aiming for professional development, our comprehensive facilities and expert coaching staff provide everything you need.</p>
                            <ul style="list-style:none;display:flex;flex-direction:column;gap:16px;">
                                <li style="display:flex;align-items:center;gap:12px;font-size:16px;font-weight:500;"><div style="width:24px;height:24px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;color:white;"><i class="fa fa-check" style="font-size:14px;"/></div><span class="o_editable">12 Indoor &amp; Outdoor Championship Courts</span></li>
                                <li style="display:flex;align-items:center;gap:12px;font-size:16px;font-weight:500;"><div style="width:24px;height:24px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;color:white;"><i class="fa fa-check" style="font-size:14px;"/></div><span class="o_editable">USPTA Certified Coaching Staff</span></li>
                                <li style="display:flex;align-items:center;gap:12px;font-size:16px;font-weight:500;"><div style="width:24px;height:24px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;color:white;"><i class="fa fa-check" style="font-size:14px;"/></div><span class="o_editable">State-of-the-art Fitness &amp; Recovery Center</span></li>
                            </ul>
                        </div>
                        <div class="about-image">
                            <img src="/theme_tennis_court/static/src/img/scenes/club_lounge.jpg" class="o_we_custom_image" alt="Club Lounge"/>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Features Grid -->
                <section class="tc-features container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_features_grid"
                 data-name="Features Grid">
            <div class="section-header">
                <div>
                    <div class="tag-pill o_editable">World Class Facilities</div>
                    <h2 class="section-title o_editable">
                        Everything you need for the perfect game.
                    </h2>
                </div>
                <a href="/facilities" style="text-decoration: none;">
                    <button class="btn-secondary">View Facility Map</button>
                </a>
            </div>
            <!-- Three-column feature cards: dark card, image card, stats card -->
            <div class="features-grid">
                <div class="feature-card feature-dark" data-name="Feature Dark">
                    <i class="fa fa-th"
                       style="font-size: 32px; color: white; margin-bottom: 16px;"/>
                    <h3 class="feature-dark-title o_editable">
                        Professional hard courts
                        <span>with tournament-grade lighting &amp; climate control — play
                            perfectly, in any season.
                        </span>
                    </h3>
                    <div class="feature-toggle">
                        <div class="toggle-switch">
                            <div class="toggle-knob">
                                <div class="toggle-knob-inner"/>
                            </div>
                        </div>
                        <span class="o_editable">Smart Court Analytics enabled</span>
                    </div>
                </div>
                <div class="feature-card feature-blue" data-name="Feature Image">
                    <img src="/theme_tennis_court/static/src/img/scenes/private_coaching.jpg"
                         class="o_we_custom_image" alt="Tennis Coach"/>
                    <div class="feature-blue-pill o_editable">Private &amp; Group
                        Lessons
                    </div>
                </div>
                <div class="feature-card feature-light" data-name="Feature Stats">
                    <h3 class="o_editable">100+</h3>
                    <h4 class="o_editable">Pro Coaches</h4>
                    <p class="o_editable">
                        Certified professionals ready to boost your game from first
                        serve to tournament level.
                    </p>
                    <div class="skill-row">
                        <span class="skill-label">Beginner</span>
                        <div class="skill-dots">
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                        </div>
                        <span class="skill-num">55</span>
                    </div>
                    <div class="skill-row">
                        <span class="skill-label">Intermediate</span>
                        <div class="skill-dots">
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot"/>
                            <div class="dot"/>
                        </div>
                        <span class="skill-num">40</span>
                    </div>
                    <div class="skill-row">
                        <span class="skill-label">Advanced</span>
                        <div class="skill-dots">
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot active"/>
                            <div class="dot"/>
                            <div class="dot"/>
                            <div class="dot"/>
                            <div class="dot"/>
                        </div>
                        <span class="skill-num">35</span>
                    </div>
                </div>
            </div>
            <!-- Four-column icon row: gym, café, pro shop, parking -->
            <div class="facilities-grid">
                <div class="facility-card" data-name="Facility 1">
                    <div class="facility-icon">
                        <i class="fa fa-heartbeat" style="font-size: 20px;"/>
                    </div>
                    <div>
                        <h4 class="facility-title o_editable">Fitness Center</h4>
                        <p class="facility-desc o_editable">
                            Fully equipped gym focused on tennis-specific strength and
                            conditioning.
                        </p>
                    </div>
                </div>
                <div class="facility-card" data-name="Facility 2">
                    <div class="facility-icon">
                        <i class="fa fa-coffee" style="font-size: 20px;"/>
                    </div>
                    <div>
                        <h4 class="facility-title o_editable">Courtside Cafe</h4>
                        <p class="facility-desc o_editable">
                            Healthy meals, smoothies, and a comfortable lounge to relax
                            post-match.
                        </p>
                    </div>
                </div>
                <div class="facility-card" data-name="Facility 3">
                    <div class="facility-icon">
                        <i class="fa fa-shopping-bag" style="font-size: 20px;"/>
                    </div>
                    <div>
                        <h4 class="facility-title o_editable">Pro Shop</h4>
                        <p class="facility-desc o_editable">
                            Latest gear, stringing services, and expert advice from our
                            staff.
                        </p>
                    </div>
                </div>
                <div class="facility-card" data-name="Facility 4">
                    <div class="facility-icon">
                        <i class="fa fa-car" style="font-size: 20px;"/>
                    </div>
                    <div>
                        <h4 class="facility-title o_editable">Free Parking</h4>
                        <p class="facility-desc o_editable">
                            Spacious, secure parking lot with EV charging stations for all
                            members.
                        </p>
                    </div>
                </div>
            </div>
        </section>
                <div class="oe_structure oe_empty"/>
                <!-- Stats Banner -->
                <section class="tc-stats container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_stats_banner" data-name="Stats Banner">
                    <div class="stats-section">
                        <div class="stats-grid">
                            <div class="stat-item"><h4 class="o_editable">12k+</h4><p class="o_editable">Hours Played Annually</p></div>
                            <div class="stat-item"><h4 class="o_editable">89%</h4><p class="o_editable">Player Retention Rate</p></div>
                            <div class="stat-item"><h4 class="o_editable">1,200</h4><p class="o_editable">Active Members</p></div>
                            <div class="stat-item"><h4 class="o_editable">125</h4><p class="o_editable">Annual Tournaments</p></div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Programs Grid -->
                <section
                class="tc-programs services-section container section-spacing o_colored_level"
                data-snippet="theme_tennis_court.s_programs_grid"
                data-name="Programs Grid">
            <!-- Left column: tag, heading, description, and CTA button -->
            <div class="services-left" data-name="Left Column">
                <div class="tag-pill o_editable">Programs</div>
                <h2 class="services-title o_editable">
                    Explore our full range of coaching, training, and events.
                </h2>
                <p class="services-desc o_editable">
                    From first serve to match point — we've got the right program for
                    you. Whether you're looking for structured academy training or
                    casual social play, you'll find it here.
                </p>
                <a href="/join" style="text-decoration: none;">
                    <button class="btn-primary">View Schedule<div style="width: 16px; height: 16px; display: flex; align-items: center; justify-content: center;"><i class="fa fa-arrow-right" style="font-size: 16px; color: white;"/></div></button>
                </a>
            </div>
            <!-- Right column: tall academy card + two half-height cards -->
            <div class="services-right" data-name="Right Column">
                <div class="svc-card-tall">
                    <img src="/theme_tennis_court/static/src/img/scenes/junior_academy.jpg"
                         class="o_we_custom_image" alt="Tennis Training"/>
                    <div class="svc-card-tall-overlay"/>
                    <div class="svc-pill o_editable">Academy</div>
                    <div style="margin-top: auto;">
                        <div class="svc-tall-text o_editable">High-Performance Training
                        </div>
                        <div class="svc-tall-desc o_editable">
                            Intensive programs designed for juniors aiming for collegiate
                            or professional levels.
                        </div>
                    </div>
                </div>
                <div class="svc-col-right">
                    <div class="svc-card-half">
                        <img src="/theme_tennis_court/static/src/img/scenes/cardio.jpg"
                             class="o_we_custom_image" alt="Court Access"/>
                        <div class="svc-card-tall-overlay"/>
                        <div class="svc-pill o_editable">Court Access</div>
                        <div class="svc-half-text o_editable">
                            Hourly Rentals &amp; Subscriptions
                        </div>
                    </div>
                    <div class="svc-card-half">
                        <img src="/theme_tennis_court/static/src/img/scenes/competitive.jpg"
                             class="o_we_custom_image" alt="Social Leagues"/>
                        <div class="svc-card-tall-overlay"/>
                        <div class="svc-pill o_editable">Community</div>
                        <div class="svc-half-text o_editable">Adult Social Leagues</div>
                    </div>
                </div>
            </div>
        </section>
                <div class="oe_structure oe_empty"/>
                <!-- Coaches Grid -->
                <section class="tc-coaches container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_coaches_grid" data-name="Coaches Grid">
                    <div class="section-header">
                        <div><div class="tag-pill o_editable">Our Team</div><h2 class="section-title o_editable">Meet our Head Coaches</h2></div>
                        <a href="/coaches" style="text-decoration:none;"><button class="btn-secondary">See All Coaches</button></a>
                    </div>
                    <div class="coaches-grid">
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/avatars/male_european_35_1.jpg" class="coach-img o_we_custom_image" alt="Coach"/><div class="coach-info"><h4 class="coach-name o_editable">David Miller</h4><span class="coach-role o_editable">Director of Tennis</span><p class="coach-desc o_editable">Former ATP Tour professional with 15+ years of coaching experience.</p></div></div>
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/avatars/female_na_25.jpg" class="coach-img o_we_custom_image" alt="Coach"/><div class="coach-info"><h4 class="coach-name o_editable">Sarah Jenkins</h4><span class="coach-role o_editable">Head Junior Coach</span><p class="coach-desc o_editable">Specializes in youth development and collegiate preparation.</p></div></div>
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/avatars/male_hispanic_25.jpg" class="coach-img o_we_custom_image" alt="Coach"/><div class="coach-info"><h4 class="coach-name o_editable">Carlos Mendez</h4><span class="coach-role o_editable">Senior Pro</span><p class="coach-desc o_editable">Expert in modern baseline techniques and biomechanics.</p></div></div>
                        <div class="coach-card"><img src="/theme_tennis_court/static/src/img/avatars/female_european_35.jpg" class="coach-img o_we_custom_image" alt="Coach"/><div class="coach-info"><h4 class="coach-name o_editable">Elena Rostova</h4><span class="coach-role o_editable">Strength &amp; Conditioning</span><p class="coach-desc o_editable">Focuses on tennis-specific fitness and injury prevention.</p></div></div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- Pricing Cards -->
                <section class="tc-pricing section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_pricing_cards"
                 data-name="Pricing Cards">
            <div class="container">
                <div class="section-header"
                     style="justify-content: center; text-align: center;">
