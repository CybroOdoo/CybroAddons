<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full Pricing page template -->
    <template id="tc_pricing_page" name="Tennis Court Pricing">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero -->
                <section class="programs-hero-section section-spacing o_colored_level"
                         data-snippet="theme_tennis_court.tc_pricing_hero" data-name="Pricing Hero">
                    <div class="container">
                        <div class="programs-hero-container">
                            <div class="programs-hero-bg">
                                <img src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg"
                                     alt="Tennis court"/>
                            </div>
                            <div class="programs-hero-overlay"/>
                            <div class="programs-hero-content">
                                <div class="tag-pill hero-pill-light">Memberships</div>
                                <h1 class="programs-hero-title">Simple, transparent pricing</h1>
                                <p class="programs-hero-subtitle">Choose the membership that fits your game. Whether you
                                    play once a month or every day, we have a plan for you.
                                </p>
                            </div>
                        </div>
                    </div>

                </section>

                <!-- Pricing Cards -->
                <section class="section-spacing o_colored_level" data-snippet="theme_tennis_court.tc_pricing_benefits"
                         data-name="Membership Benefits">
                    <div class="container">
                        <div class="pricing-grid">
                            <div class="pricing-card">
                                <h3 class="pricing-tier">Guest Pass</h3>
                                <div class="pricing-price">
                                    <span class="">$35</span>
                                    <span class="pricing-period">/day</span>
                                </div>
                                <p class="pricing-desc">Perfect for visitors or those looking to try our facilities
                                    before committing.
                                </p>
                                <ul class="pricing-features">
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Full day court access</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Locker room &amp; amenities</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Pro shop access</span>
                                    </li>
                                    <li class="pricing-feature" style="color:var(--muted-foreground);">
                                        <div style="width:20px;display:flex;align-items:center;justify-content:center;
                                        color:var(--border);">
                                            <i class="fa fa-minus" style="font-size:20px;"/>
                                        </div>
                                        <span class="">No advance court booking</span>
                                    </li>
                                </ul>
                                <a href="/join" style="text-decoration:none;">
                                    <button class="btn-secondary pricing-btn">Buy Guest Pass</button>
                                </a>
                            </div>
                            <div class="pricing-card"
                                 style="border:2px solid var(--accent);box-shadow:0 10px 25px -5px rgba(0,0,0,0.05);">
                                <div class="popular-badge">Most Popular</div>
                                <h3 class="pricing-tier">Individual</h3>
                                <div class="pricing-price">
                                    <span class="">$149</span>
                                    <span class="pricing-period">/month</span>
                                </div>
                                <p class="pricing-desc">Everything an adult player needs. Full access to courts,
                                    clinics, and exclusive events.
                                </p>
                                <ul class="pricing-features">
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Unlimited court time</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">7-day advance booking</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">USTA affiliated leagues</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Access to fitness center</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Complimentary towel service</span>
                                    </li>
                                </ul>
                                <a href="/join" style="text-decoration:none;">
                                    <button class="btn-primary pricing-btn"
                                            style="background-color:var(--accent);color:white;border:none;">Join as
                                        Individual
                                    </button>
                                </a>
                            </div>
                            <div class="pricing-card">
                                <h3 class="pricing-tier">Family</h3>
                                <div class="pricing-price">
                                    <span class="">$249</span>
                                    <span class="pricing-period">/month</span>
                                </div>
                                <p class="pricing-desc">Bring the whole family. Complete membership for up to 4 family
                                    members.
                                </p>
                                <ul class="pricing-features">
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Includes 2 adults &amp; 2 children</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Unlimited court time</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">7-day advance booking</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Priority junior camp registration</span>
                                    </li>
                                    <li class="pricing-feature">
                                        <div class="feature-icon">
                                            <i class="fa fa-check-circle" style="font-size:20px;"/>
                                        </div>
                                        <span class="">Guest passes (2/month)</span>
                                    </li>
                                </ul>
                                <a href="/join" style="text-decoration:none;">
                                    <button class="btn-primary pricing-btn">Join as Family</button>
                                </a>
                            </div>
                        </div>
                    </div>

                </section>

                <!-- A La Carte -->
                <section class="section-spacing o_colored_level" data-snippet="theme_tennis_court.tc_pricing_faq"
                         data-name="Pricing FAQ">
                    <div class="container">
                        <div class="alacarte-container">
                            <h2 class="section-title" style="margin-bottom:48px;">A La Carte &amp; Add-ons</h2>
                            <div class="alacarte-grid">
                                <div style="display:flex;flex-direction:column;">
                                    <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;
                                    justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
                                        <div>
                                            <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                                 class="">Private Lesson (1 Hour)
                                            </div>
                                            <div style="font-size:14px;color:var(--muted-foreground);" class="">
                                                One-on-one with a certified professional.
                                            </div>
                                        </div>
                                        <div style="font-weight:600;font-size:18px;" class="">$95</div>
                                    </div>
                                    <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;
                                    justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
                                        <div>
                                            <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                                 class="">Semi-Private Lesson
                                            </div>
                                            <div style="font-size:14px;color:var(--muted-foreground);" class="">Share
                                                the court and focus on technique.
                                            </div>
                                        </div>
                                        <div style="font-weight:600;font-size:18px;" class="">$50 /pp</div>
                                    </div>
                                    <div style="padding-bottom:24px;display:flex;justify-content:space-between;align-items:flex-start;">
                                        <div>
                                            <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                                 class="">Ball Machine Rental
                                            </div>
                                            <div style="font-size:14px;color:var(--muted-foreground);" class="">1 hour,
                                                unlimited balls on court 4.
                                            </div>
                                        </div>
                                        <div style="font-weight:600;font-size:18px;" class="">$25</div>
                                    </div>
                                </div>
                                <div style="display:flex;flex-direction:column;">
                                    <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;
                                    justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
                                        <div>
                                            <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                                 class="">Group Clinic (Drop-in)
                                            </div>
                                            <div style="font-size:14px;color:var(--muted-foreground);" class="">
                                                90-minute structured clinic with drill and play.
                                            </div>
                                        </div>
                                        <div style="font-weight:600;font-size:18px;" class="">$35</div>
                                    </div>
                                    <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;
                                    justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
                                        <div>
                                            <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                                 class="">Racket Stringing
                                            </div>
                                            <div style="font-size:14px;color:var(--muted-foreground);" class="">Labor
                                                only, premium strings in stock.
                                            </div>
                                        </div>
                                        <div style="font-weight:600;font-size:18px;" class="">$20</div>
                                    </div>
                                    <div style="padding-bottom:24px;display:flex;justify-content:space-between;align-items:flex-start;">
                                        <div>
                                            <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                                 class="">Seasonal Locker
                                            </div>
                                            <div style="font-size:14px;color:var(--muted-foreground);" class="">
                                                Dedicated premium locker in the clubhouse.
                                            </div>
                                        </div>
                                        <div style="font-weight:600;font-size:18px;" class="">$15 /mo</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </section>

                <!-- FAQ -->
                <section class="section-spacing o_colored_level">
                    <div class="container">
                        <div style="text-align:center;margin-bottom:48px;">
                            <div class="tag-pill" style="display:inline-block;">Questions?</div>
                            <h2 class="section-title" style="margin:0 auto;">Frequently Asked Questions</h2>
                        </div>
                        <div style="max-width:800px;margin:0 auto;">
                            <div style="padding:32px 0;border-bottom:1px solid var(--border);">
                                <div style="font-weight:600;font-size:18px;color:var(--foreground);" class="">Are there
                                    any initiation fees?
                                </div>
                                <div style="margin-top:16px;font-size:15px;color:var(--muted-foreground);line-height:1.6;"
                                     class="">No. The monthly fee you see is the fee you pay. No hidden initiation or
                                    cancellation fees.
                                </div>
                            </div>
                            <div style="padding:32px 0;border-bottom:1px solid var(--border);">
                                <div style="font-weight:600;font-size:18px;color:var(--foreground);" class="">Can I
                                    cancel my membership at any time?
                                </div>
                                <div style="margin-top:16px;font-size:15px;color:var(--muted-foreground);line-height:1.6;"
                                     class="">Yes. All memberships are month-to-month with no long-term contracts.
                                </div>
                            </div>
                            <div style="padding:32px 0;border-bottom:1px solid var(--border);">
                                <div style="font-weight:600;font-size:18px;color:var(--foreground);" class="">Do I need
                                    to be a member to take private lessons?
                                </div>
                                <div style="margin-top:16px;font-size:15px;color:var(--muted-foreground);line-height:1.6;"
                                     class="">No. Private lessons and guest passes are available to everyone.
                                </div>
                            </div>
                            <div style="padding:32px 0;border-bottom:1px solid var(--border);">
                                <div style="font-weight:600;font-size:18px;color:var(--foreground);" class="">How far in
                                    advance can I book a court?
                                </div>
                                <div style="margin-top:16px;font-size:15px;color:var(--muted-foreground);line-height:1.6;"
                                     class="">Individual and Family members can book up to 7 days in advance. Guest Pass
                                    holders book same-day only.
                                </div>
                            </div>
                        </div>
                    </div>

                </section>

                <!-- CTA -->
                <section class="tc-cta container section-spacing o_colored_level">
                    <div class="container">
                        <div class="cta-section">
                            <img class="cta-bg" src="/theme_tennis_court/static/src/img/scenes/scene_6.jpg"
                                 alt="Court"/>
                            <div class="cta-overlay"/>
                            <div class="cta-content">
                                <h2 class="cta-title">Ready to join the club?</h2>
                                <p class="cta-desc">Become part of our growing community and train with the best tennis
                                    facilities in the city.
                                </p>
                                <div style="display:flex;gap:16px;justify-content:center;margin-top:16px;">
                                    <a href="/join" style="text-decoration:none;">
                                        <button class="btn-primary"
                                                style="background:white;color:var(--primary);border:none;padding:14px 32px;">
                                            Sign Up Now
                                        </button>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>

    <!-- Publishes the Pricing page at /pricing -->
    <record id="tc_pricing_page_page" model="theme.website.page">
        <field name="url">/pricing</field>
        <field name="view_id" ref="tc_pricing_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>