<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Elite coaches / fitness trainers grid section -->
    <template id="s_coaches_fitness" name="Fitness Trainers">
        <section class="container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_coaches_fitness"
                 data-name="Fitness Trainers">
            <div class="section-header">
                <div>
                    <div class="tag-pill o_editable">Our Staff</div>
                    <h2 class="section-title o_editable">Elite Coaches</h2>
                </div>
            </div>
            <!-- Four-column grid of coach cards -->
            <div class="coaches-grid">
                <div class="coach-card">
                    <img src="/theme_tennis_court/static/src/img/elena_rostova.png"
                         class="coach-img" alt="Elena Rostova"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">Elena Rostova</h4>
                        <span class="coach-role o_editable">Senior Coach</span>
                        <p class="coach-desc o_editable">Known for technical precision and
                            energetic on-court presence. Former top-300 WTA player.
                        </p>
                    </div>
                </div>
                <div class="coach-card">
                    <img src="/theme_tennis_court/static/src/img/marcus_johnson.png"
                         class="coach-img" alt="Marcus Johnson"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">Marcus Johnson</h4>
                        <span class="coach-role o_editable">Performance Coach</span>
                        <p class="coach-desc o_editable">Focuses on matchplay tactics,
                            psychological resilience, and athletic conditioning.
                        </p>
                    </div>
                </div>
                <div class="coach-card">
                    <img src="/theme_tennis_court/static/src/img/chloe_smith.png"
                         class="coach-img" alt="Chloe Smith"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">Chloe Smith</h4>
                        <span class="coach-role o_editable">Junior Coach</span>
                        <p class="coach-desc o_editable">Building strong foundations and a
                            love for the game in our 10-and-under programs.
                        </p>
                    </div>
                </div>
                <div class="coach-card">
                    <img src="/theme_tennis_court/static/src/img/michael_vance.png"
                         class="coach-img" alt="James Wilson"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">James Wilson</h4>
                        <span class="coach-role o_editable">Cardio Tennis Specialist
                        </span>
                        <p class="coach-desc o_editable">High-energy fitness backgrounds
                            applied to cardio tennis and adult intermediate classes.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_coaches_fitness_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_coaches_fitness"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Fitness Trainers"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
