<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Head coaches overview grid with "See All" CTA -->
    <template id="s_coaches_grid" name="Tennis Court Coaches Grid">
        <section class="tc-coaches container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_coaches_grid"
                 data-name="Coaches Grid">
            <!-- Section title and link to full coaches page -->
            <div class="section-header">
                <div>
                    <div class="tag-pill o_editable">Our Team</div>
                    <h2 class="section-title o_editable">Meet our Head Coaches</h2>
                </div>
                <a href="/coaches" style="text-decoration: none;">
                    <button class="btn-secondary">
                        See All Coaches
                    </button>
                </a>
            </div>
            <!-- Four-column responsive grid of coach cards -->
            <div class="coaches-grid">
                <div class="coach-card" data-name="Coach 1">
                    <img src="/theme_tennis_court/static/src/img/avatars/male_european_35_1.jpg"
                         class="coach-img o_we_custom_image" alt="Coach"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">David Miller</h4>
                        <span class="coach-role o_editable">Director of Tennis</span>
                        <p class="coach-desc o_editable">
                            Former ATP Tour professional with 15+ years of coaching
                            experience at elite levels.
                        </p>
                    </div>
                </div>
                <div class="coach-card" data-name="Coach 2">
                    <img src="/theme_tennis_court/static/src/img/avatars/female_na_25.jpg"
                         class="coach-img o_we_custom_image" alt="Coach"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">Sarah Jenkins</h4>
                        <span class="coach-role o_editable">Head Junior Coach</span>
                        <p class="coach-desc o_editable">
                            Specializes in youth development, collegiate preparation, and
                            sports psychology.
                        </p>
                    </div>
                </div>
                <div class="coach-card" data-name="Coach 3">
                    <img src="/theme_tennis_court/static/src/img/avatars/male_hispanic_25.jpg"
                         class="coach-img o_we_custom_image" alt="Coach"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">Carlos Mendez</h4>
                        <span class="coach-role o_editable">Senior Pro</span>
                        <p class="coach-desc o_editable">
                            Expert in modern baseline techniques, biomechanics, and adult
                            beginner clinics.
                        </p>
                    </div>
                </div>
                <div class="coach-card" data-name="Coach 4">
                    <img src="/theme_tennis_court/static/src/img/avatars/female_european_35.jpg"
                         class="coach-img o_we_custom_image" alt="Coach"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">Elena Rostova</h4>
                        <span class="coach-role o_editable">Strength &amp; Conditioning
                        </span>
                        <p class="coach-desc o_editable">
                            Focuses on tennis-specific fitness, injury prevention, and
                            explosive movement.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_coaches_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_coaches_grid"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Coaches Grid"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
