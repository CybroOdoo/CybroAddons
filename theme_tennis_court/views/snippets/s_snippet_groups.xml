<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Adds a custom "Tennis Court Sections" group in the snippets panel -->
    <template id="s_snippet_groups" inherit_id="website.snippets"
              name="Tennis Court Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_tennis_court/static/src/img/snippet_thumb.svg"
               string="Tennis Court Sections"
               snippet-group="s_section"/>
        </xpath>
    </template>
</odoo>
