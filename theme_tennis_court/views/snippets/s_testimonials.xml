<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Member testimonials section with three review cards -->
    <template id="s_testimonials" name="Tennis Court Testimonials">
        <section class="tc-testimonials container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_testimonials"
                 data-name="Testimonials">
            <div class="reviews-section">
                <!-- Section header with tag pill and title -->
                <div class="reviews-header">
                    <div class="tag-pill o_editable" style="background: white;">
                        Testimonials
                    </div>
                    <h2 class="section-title o_editable" style="margin: 0 auto;">
                        Don't just take our word for it.
                    </h2>
                </div>
                <!-- Three-column grid of review cards -->
                <div class="reviews-grid">
                    <div class="review-card" data-name="Review 1">
                        <div class="review-stars">
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                        </div>
                        <p class="review-text o_editable">
                            "The indoor facilities at Horizon are unmatched in the city. I
                            can keep my game sharp all winter, and the lighting is
                            tournament quality."
                        </p>
                        <div class="review-author">
                            <img src="/theme_tennis_court/static/src/img/avatars/male_european_35_2.jpg"
                                 alt="Reviewer"/>
                            <div class="author-info">
                                <h5 class="o_editable">Michael Chen</h5>
                                <p class="o_editable">Pro Member since 2021</p>
                            </div>
                        </div>
                    </div>
                    <div class="review-card" data-name="Review 2">
                        <div class="review-stars">
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                        </div>
                        <p class="review-text o_editable">
                            "Signed my kids up for the summer academy, and they absolutely
                            loved it. The coaches are incredibly patient and skilled at
                            teaching fundamentals."
                        </p>
                        <div class="review-author">
                            <img src="/theme_tennis_court/static/src/img/avatars/female_na_35_1.jpg"
                                 alt="Reviewer"/>
                            <div class="author-info">
                                <h5 class="o_editable">Amanda Richards</h5>
                                <p class="o_editable">Family Pass Member</p>
                            </div>
                        </div>
                    </div>
                    <div class="review-card" data-name="Review 3">
                        <div class="review-stars">
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                            <i class="fa fa-star" style="font-size: 16px;"/>
                        </div>
                        <p class="review-text o_editable">
                            "I joined for the social leagues and ended up making lifelong
                            friends. The courtside cafe is the perfect spot for post-match
                            drinks."
                        </p>
                        <div class="review-author">
                            <img src="/theme_tennis_court/static/src/img/avatars/male_african_25.jpg"
                                 alt="Reviewer"/>
                            <div class="author-info">
                                <h5 class="o_editable">Marcus Johnson</h5>
                                <p class="o_editable">Social Player</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_testimonials_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_testimonials"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Testimonials"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
