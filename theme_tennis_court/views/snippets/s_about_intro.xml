<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- About intro section with text and image side by side -->
    <template id="s_about_intro" name="Tennis Court About Intro">
        <section class="tc-about container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_about_intro"
                 data-name="About Intro">
            <div class="about-section">
                <!-- Left column: tag pill, heading, description, and feature list -->
                <div class="about-text-content" data-name="Text Column">
                    <div class="tag-pill o_editable">The Horizon Difference</div>
                    <h2 class="about-text o_editable">
                        At Horizon, we don't just play tennis — we live it. Our club has
                        been a sanctuary for players of all levels since 2012.
                    </h2>
                    <p class="about-subtext o_editable">
                        Whether you're picking up a racket for the very first time,
                        looking for a competitive league, or aiming for professional
                        development, our comprehensive facilities and expert coaching
                        staff provide everything you need to succeed on and off the court.
                    </p>
                    <ul style="list-style: none; display: flex; flex-direction: column; gap: 16px;">
                        <li style="display: flex; align-items: center; gap: 12px; font-size: 16px; font-weight: 500;">
                            <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; color: white;">
                                <i class="fa fa-check" style="font-size: 14px;"/>
                            </div>
                            <span class="o_editable">12 Indoor &amp; Outdoor Championship
                                Courts
                            </span>
                        </li>
                        <li style="display: flex; align-items: center; gap: 12px; font-size: 16px; font-weight: 500;">
                            <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; color: white;">
                                <i class="fa fa-check" style="font-size: 14px;"/>
                            </div>
                            <span class="o_editable">USPTA Certified Coaching Staff</span>
                        </li>
                        <li style="display: flex; align-items: center; gap: 12px; font-size: 16px; font-weight: 500;">
                            <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; color: white;">
                                <i class="fa fa-check" style="font-size: 14px;"/>
                            </div>
                            <span class="o_editable">State-of-the-art Fitness &amp;
                                Recovery Center
                            </span>
                        </li>
                    </ul>
                </div>
                <!-- Right column: club lounge image -->
                <div class="about-image" data-name="Image Column">
                    <img src="/theme_tennis_court/static/src/img/scenes/club_lounge.jpg"
                         class="o_we_custom_image" alt="Club Lounge"/>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_about_intro_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_about_intro"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="About Intro"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
