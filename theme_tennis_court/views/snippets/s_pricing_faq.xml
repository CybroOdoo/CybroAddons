<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- À la carte add-on pricing section with two-column layout -->
    <template id="s_pricing_faq" name="Pricing FAQ">
        <section class="section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_pricing_faq" data-name="Pricing FAQ">
            <div class="container">
                <div class="alacarte-container">
                    <h2 class="section-title o_editable" style="margin-bottom:48px;">A La
                        Carte &amp; Add-ons
                    </h2>
                    <!-- Two-column grid of individual add-on items with prices -->
                    <div class="alacarte-grid">
                        <div style="display:flex;flex-direction:column;">
                            <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
                                <div>
                                    <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                         class="o_editable">Private Lesson (1 Hour)
                                    </div>
                                    <div style="font-size:14px;color:var(--muted-foreground);"
                                         class="o_editable">One-on-one with a certified
                                        professional.
                                    </div>
                                </div>
                                <div style="font-weight:600;font-size:18px;"
                                     class="o_editable">$95
                                </div>
                            </div>
                            <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
                                <div>
                                    <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                         class="o_editable">Semi-Private Lesson
                                    </div>
                                    <div style="font-size:14px;color:var(--muted-foreground);"
                                         class="o_editable">Share the court and focus on
                                        technique.
                                    </div>
                                </div>
                                <div style="font-weight:600;font-size:18px;"
                                     class="o_editable">$50 /pp
                                </div>
                            </div>
                            <div style="padding-bottom:24px;display:flex;justify-content:space-between;align-items:flex-start;">
                                <div>
                                    <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                         class="o_editable">Ball Machine Rental
                                    </div>
                                    <div style="font-size:14px;color:var(--muted-foreground);"
                                         class="o_editable">1 hour, unlimited balls on
                                        court 4.
                                    </div>
                                </div>
                                <div style="font-weight:600;font-size:18px;"
                                     class="o_editable">$25
                                </div>
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;">
                            <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
                                <div>
                                    <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                         class="o_editable">Group Clinic (Drop-in)
                                    </div>
                                    <div style="font-size:14px;color:var(--muted-foreground);"
                                         class="o_editable">90-minute structured clinic
                                        with drill and play.
                                    </div>
                                </div>
                                <div style="font-weight:600;font-size:18px;"
                                     class="o_editable">$35
                                </div>
                            </div>
                            <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
                                <div>
                                    <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                         class="o_editable">Racket Stringing
                                    </div>
                                    <div style="font-size:14px;color:var(--muted-foreground);"
                                         class="o_editable">Labor only, premium strings in
                                        stock.
                                    </div>
                                </div>
                                <div style="font-weight:600;font-size:18px;"
                                     class="o_editable">$20
                                </div>
                            </div>
                            <div style="padding-bottom:24px;display:flex;justify-content:space-between;align-items:flex-start;">
                                <div>
                                    <div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);"
                                         class="o_editable">Seasonal Locker
                                    </div>
                                    <div style="font-size:14px;color:var(--muted-foreground);"
                                         class="o_editable">Dedicated premium locker in
                                        the clubhouse.
                                    </div>
                                </div>
                                <div style="font-weight:600;font-size:18px;"
                                     class="o_editable">$15 /mo
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_pricing_faq_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_pricing_faq"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Pricing FAQ"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
