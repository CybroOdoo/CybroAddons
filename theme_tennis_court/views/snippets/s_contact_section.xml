<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Full contact section: info panel on left, form on right -->
    <template id="s_contact_section" name="Contact Section">
        <section class="tc-contact-section section-spacing"
                 data-snippet="theme_tennis_court.s_contact_section"
                 data-name="Contact Section">
            <div class="container">
                <div class="tc-contact-grid">
                    <!-- Left: Info Panel -->
                    <!-- Info cards for address, hours, phone, and email -->
                    <div class="tc-contact-info">
                        <div class="tc-contact-info-card">
                            <div class="tc-contact-icon">
                                <i class="fa fa-map-marker"/>
                            </div>
                            <h4>Visit Us</h4>
                            <p>
                                <span t-field="res_company.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            </p>
                        </div>
                        <div class="tc-contact-info-card">
                            <div class="tc-contact-icon">
                                <i class="fa fa-clock-o"/>
                            </div>
                            <h4>Opening Hours</h4>
                            <p class="o_editable">Monday – Friday: 6am – 10pm<br/>Saturday
                                – Sunday: 7am – 9pm
                            </p>
                        </div>
                        <div class="tc-contact-info-card">
                            <div class="tc-contact-icon">
                                <i class="fa fa-phone"/>
                            </div>
                            <h4>Call Us</h4>
                            <p>
                                <a t-att-href="'tel:' + res_company.phone">
                                    <t t-esc="res_company.phone"/>
                                </a>
                            </p>
                        </div>
                        <div class="tc-contact-info-card">
                            <div class="tc-contact-icon">
                                <i class="fa fa-envelope-o"/>
                            </div>
                            <h4>Email Us</h4>
                            <p>
                                <a t-if="res_company.email"
                                   t-att-href="'mailto:' + res_company.email"/>
                            </p>
                        </div>
                    </div>
                    <!-- Right: Odoo native website form -->
                    <!-- Right column: form header and Odoo website form -->
                    <div class="tc-contact-form-wrapper">
                        <div class="tc-contact-form-header">
                            <span class="tag-pill">Get in Touch</span>
                            <h2 class="section-title">Send Us a
                                <span style="color: var(--accent);">Message</span>
                            </h2>
                            <p class="tc-contact-form-desc">Have a question about our
                                programs, membership, or facilities? We'd love to hear
                                from you.
                            </p>
                        </div>
                        <!--
                            Native Odoo website form.
                            action="/website/form/"   → Odoo's WebsiteForm controller
                            data-model_name           → stores submission as mail.mail
                            data-success-mode         → redirect after success
                            data-success-page         → Odoo's built-in thank-you page
                        -->
                        <section class="s_website_form"
                                 data-vcss="001"
                                 data-snippet="s_website_form">
                            <div class="container p-0">
                                <form id="contactus_form"
                                      action="/website/form/"
                                      method="post"
                                      enctype="multipart/form-data"
                                      class="o_mark_required"
                                      data-mark="*"
                                      data-model_name="mail.mail"
                                      data-success-mode="redirect"
                                      data-success-page="/contactus-thank-you"
                                      data-pre-fill="true">
                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                        <!-- First Name -->
                                        <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                             data-type="char" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="contact_name">Name</label>
                                                <input id="contact_name"
                                                       type="text"
                                                       class="form-control s_website_form_input"
                                                       name="name"
                                                       placeholder="Your full name"
                                                       required=""/>
                                            </div>
                                        </div>
                                        <!-- Phone -->
                                        <div class="mb-0 py-2 col-md-6 col-12 s_website_form_field"
                                             data-type="char" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="contact_phone">Phone
                                                </label>
                                                <input id="contact_phone"
                                                       type="tel"
                                                       class="form-control s_website_form_input"
                                                       name="phone"
                                                       placeholder="Your phone number"
                                                       data-fill-with="phone"/>
                                            </div>
                                        </div>
                                        <!-- Email -->
                                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                             data-type="email" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="contact_email">Email
                                                </label>
                                                <input id="contact_email"
                                                       type="email"
                                                       class="form-control s_website_form_input"
                                                       name="email_from"
                                                       placeholder="Your email address"
                                                       required=""
                                                       data-fill-with="email"/>
                                            </div>
                                        </div>
                                        <!-- Subject -->
                                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                             data-type="char" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="contact_subject">Subject
                                                </label>
                                                <input id="contact_subject"
                                                       type="text"
                                                       class="form-control s_website_form_input"
                                                       name="subject"
                                                       placeholder="How can we help?"
                                                       required=""/>
                                            </div>
                                        </div>
                                        <!-- Message -->
                                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_required"
                                             data-type="text" data-name="Field">
                                            <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                                <label for="contact_msg">Message
                                                </label>
                                                <textarea id="contact_msg"
                                                          class="form-control s_website_form_input"
                                                          name="description"
                                                          rows="5"
                                                          placeholder="Tell us more about your inquiry..."
                                                          required=""/>
                                            </div>
                                        </div>
                                        <!-- Hidden email_to (filled by Odoo from company settings) -->
                                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_dnone">
                                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                                <input type="hidden"
                                                       class="form-control s_website_form_input"
                                                       name="email_to"/>
                                            </div>
                                        </div>
                                        <!-- Submit -->
                                        <div class="mb-0 py-2 col-12 s_website_form_submit"
                                             data-name="Submit Button">
                                            <a href="#"
                                               role="button"
                                               class="btn btn-primary s_website_form_send">
                                                <span>Send Message</span>
                                                <i class="fa fa-long-arrow-right ms-2"/>
                                            </a>
                                            <span id="s_website_form_result"/>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_contact_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_contact_section"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Contact Section"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
