<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Directors and head professionals section -->
    <template id="s_coaches_senior" name="Senior Pros">
        <section class="container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_coaches_senior"
                 data-name="Senior Pros">
            <div class="section-header">
                <div>
                    <div class="tag-pill o_editable">Leadership</div>
                    <h2 class="section-title o_editable">Directors &amp; Head
                        Professionals
                    </h2>
                </div>
            </div>
            <div class="coaches-grid" style="grid-template-columns:repeat(3,1fr);">
                <div class="coach-card">
                    <img src="/theme_tennis_court/static/src/img/michael_vance.png"
                         class="coach-img" alt="Michael Vance"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">Michael Vance</h4>
                        <span class="coach-role o_editable" style="color:var(--primary);">
                            Director of Tennis
                        </span>
                        <p class="coach-desc o_editable">Former touring professional with
                            15+ years of coaching experience. Oversees all club
                            programming.
                        </p>
                    </div>
                </div>
                <div class="coach-card">
                    <img src="/theme_tennis_court/static/src/img/sarah_jenkins.png"
                         class="coach-img" alt="Sarah Jenkins"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">Sarah Jenkins</h4>
                        <span class="coach-role o_editable" style="color:var(--primary);">
                            Head Professional - Junior Programs
                        </span>
                        <p class="coach-desc o_editable">Specialized in high-performance
                            junior development and collegiate preparation.
                        </p>
                    </div>
                </div>
                <div class="coach-card">
                    <img src="/theme_tennis_court/static/src/img/david_chen.png"
                         class="coach-img" alt="David Chen"/>
                    <div class="coach-info">
                        <h4 class="coach-name o_editable">David Chen</h4>
                        <span class="coach-role o_editable" style="color:var(--primary);">
                            Head Professional - Adult Programs
                        </span>
                        <p class="coach-desc o_editable">USPTA Elite Professional ensuring
                            adult programs are engaging and tactical.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_coaches_senior_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_coaches_senior"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Senior Pros"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
