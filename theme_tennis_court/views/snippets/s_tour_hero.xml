<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hero banner for the Club Tour page -->
    <template id="s_tour_hero" name="Tour Hero">
        <section class="programs-hero-section section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_tour_hero" data-name="Tour Hero">
            <div class="container">
                <div class="programs-hero-container">
                    <!-- Full-bleed background image of the club -->
                    <div class="programs-hero-bg">
                        <img src="https://storage.googleapis.com/banani-generated-images/generated-images/7aebf226-c73d-412a-90d6-11d3413c7041.jpg"
                             alt="Tennis club overview"/>
                    </div>
                    <!-- Dark overlay for text readability -->
                    <div class="programs-hero-overlay"/>
                    <div class="programs-hero-content">
                        <div class="tag-pill hero-pill-light o_editable">Club Tour</div>
                        <h1 class="programs-hero-title o_editable">Experience Horizon
                            Courts
                        </h1>
                        <p class="programs-hero-subtitle o_editable">
                            Take a digital walk through our world-class facilities,
                            championship courts, and luxury amenities before you even step
                            foot in the club.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_tour_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_tour_hero"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Tour Hero"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
