<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Page header / breadcrumb for the Contact page -->
    <template id="s_contact_header" name="Contact Header">
        <section class="tc-page-header o_colored_level"
                 data-snippet="theme_tennis_court.s_contact_header"
                 data-name="Contact Header">
            <div class="container">
                <!-- Breadcrumb navigation showing current page path -->
                <div class="tc-breadcrumb">
                    <h2 class="tc-page-title">Contact Us</h2>
                    <ul class="tc-breadcrumb-links">
                        <li>
                            <a href="/">Home</a>
                        </li>
                        <li>
                            <a class="active">Contact Us</a>
                        </li>
                    </ul>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_contact_header_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_contact_header"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Contact Header"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
