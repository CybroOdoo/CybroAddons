<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Membership pricing cards snippet for use in the website editor -->
    <template id="s_pricing_cards" name="Tennis Court Pricing Cards">
        <section class="tc-pricing section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_pricing_cards"
                 data-name="Pricing Cards">
            <div class="container">
                <div class="section-header"
                     style="justify-content: center; text-align: center;">
                    <div style="display: flex; flex-direction: column; align-items: center;">
                        <div class="tag-pill o_editable">Memberships</div>
                        <h2 class="section-title o_editable">Choose your club pass</h2>
                    </div>
                </div>
                <!-- Three-column grid of pricing plan cards -->
                <div class="pricing-grid">
                    <div class="pricing-card" data-name="Guest Pass">
                        <h3 class="pricing-tier o_editable">Guest Pass</h3>
                        <div class="pricing-price">
                            <span class="o_editable">$35</span>
                            <span class="pricing-period">/day</span>
                        </div>
                        <p class="pricing-desc o_editable">Perfect for visitors or those
                            looking to try our facilities before committing.
                        </p>
                        <ul class="pricing-features">
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Full day court access</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Locker room &amp; amenities
                                </span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Pro shop access</span>
                            </li>
                            <li class="pricing-feature"
                                style="color:var(--muted-foreground);">
                                <div style="width:20px;display:flex;align-items:center;justify-content:center;color:var(--border);">
                                    <i class="fa fa-minus" style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">No advance court booking</span>
                            </li>
                        </ul>
                        <a href="/join" style="text-decoration:none;">
                            <button class="btn-secondary pricing-btn o_editable">Choose Plan
                            </button>
                        </a>
                    </div>
                    <div class="pricing-card" data-name="Individual"
                         style="border:2px solid var(--accent);box-shadow:0 10px 25px -5px rgba(0,0,0,0.05);">
                        <div class="popular-badge o_editable">Most Popular</div>
                        <h3 class="pricing-tier o_editable">Individual</h3>
                        <div class="pricing-price">
                            <span class="o_editable">$149</span>
                            <span class="pricing-period">/month</span>
                        </div>
                        <p class="pricing-desc o_editable">Everything an adult player
                            needs. Full access to courts, clinics, and exclusive events.
                        </p>
                        <ul class="pricing-features">
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Unlimited court time</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">7-day advance booking</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">USTA affiliated leagues</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Access to fitness center</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Complimentary towel service
                                </span>
                            </li>
                        </ul>
                        <a href="/join" style="text-decoration:none;">
                            <button class="btn-primary pricing-btn"
                                    style="background-color:var(--accent);color:white;border:none;">
                                Join as Individual
                            </button>
                        </a>
                    </div>
                    <div class="pricing-card" data-name="Family">
                        <h3 class="pricing-tier o_editable">Family</h3>
                        <div class="pricing-price">
                            <span class="o_editable">$249</span>
                            <span class="pricing-period">/month</span>
                        </div>
                        <p class="pricing-desc o_editable">Bring the whole family.
                            Complete membership for up to 4 family members.
                        </p>
                        <ul class="pricing-features">
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Includes 2 adults &amp; 2
                                    children
                                </span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Unlimited court time</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">7-day advance booking</span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Priority junior camp
                                    registration
                                </span>
                            </li>
                            <li class="pricing-feature">
                                <div class="feature-icon">
                                    <i class="fa fa-check-circle"
                                       style="font-size:20px;"/>
                                </div>
                                <span class="o_editable">Guest passes (2/month)</span>
                            </li>
                        </ul>
                        <a href="/join" style="text-decoration:none;">
                            <button class="btn-primary pricing-btn">Join as Family
                            </button>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_pricing_cards_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_pricing_cards"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Pricing Cards"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
