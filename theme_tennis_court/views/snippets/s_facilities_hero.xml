<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hero banner for the Facilities page -->
    <template id="s_facilities_hero" name="Facilities Hero">
        <section class="hero-section container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_facilities_hero"
                 data-name="Facilities Hero">
            <div class="about-hero-container">
                <!-- Full-bleed background image of facilities overview -->
                <div class="about-hero-bg">
                    <img src="/theme_tennis_court/static/src/img/scenes/facilities_overview.jpg"
                         alt="Facilities Overview"/>
                </div>
                <!-- Dark overlay for text readability -->
                <div class="about-hero-overlay"/>
                <div class="about-hero-content">
                    <div class="tag-pill hero-pill-light o_editable">Our Facilities</div>
                    <h1 class="about-hero-title o_editable">World-class courts.<br/>
                        Unmatched amenities.
                    </h1>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_facilities_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_facilities_hero"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Facilities Hero"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
