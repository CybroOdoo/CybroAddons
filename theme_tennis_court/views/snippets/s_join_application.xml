<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Membership application section: sidebar benefits + form -->
    <template id="s_join_application" name="Membership Application Form">
        <section class="container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_join_application"
                 data-name="Membership Application">
            <div class="join-container">
                <!-- Sidebar -->
                <!-- Left sidebar with club image and membership benefits list -->
                <aside class="join-sidebar">
                    <img src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg"
                         class="sidebar-img" alt="Tennis court aerial view"/>
                    <!-- Sidebar heading, description, and benefits list -->
                    <div class="sidebar-content">
                        <h3 class="sidebar-title o_editable">Join the club</h3>
                        <p class="sidebar-desc o_editable">
                            Get access to premium courts, professional coaching, and a
                            vibrant community of tennis enthusiasts.
                        </p>
                        <!-- Bulleted list of key member benefits -->
                        <ul class="sidebar-benefits">
                            <li class="sidebar-benefit">
                                <i class="fa fa-check-circle benefit-icon"/>
                                <span class="o_editable">12 Championship-grade courts
                                </span>
                            </li>
                            <li class="sidebar-benefit">
                                <i class="fa fa-check-circle benefit-icon"/>
                                <span class="o_editable">Advanced 7-day booking
                                    privileges
                                </span>
                            </li>
                            <li class="sidebar-benefit">
                                <i class="fa fa-check-circle benefit-icon"/>
                                <span class="o_editable">Exclusive member tournaments
                                    &amp; leagues
                                </span>
                            </li>
                            <li class="sidebar-benefit">
                                <i class="fa fa-check-circle benefit-icon"/>
                                <span class="o_editable">Luxury clubhouse &amp; locker
                                    room access
                                </span>
                            </li>
                        </ul>
                    </div>
                </aside>
                <!-- Form Wrapper -->
                <!-- Right side containing the application form -->
                <div class="join-form-wrapper">
                    <h1 class="form-header-title o_editable">Membership Application</h1>
                    <p class="form-header-desc o_editable">Complete the form below to
                        secure your membership and start playing today.
                    </p>
                    <!-- Odoo native website form section -->
                    <section class="s_website_form" data-vcss="001"
                             data-snippet="s_website_form">
                        <div class="container-fluid px-0">
                            <form action="/website/form/" method="post"
                                  enctype="multipart/form-data" class="o_mark_required"
                                  data-mark="*" data-pre-fill="true"
                                  data-model_name="mail.mail" data-success-mode="redirect"
                                  data-success-page="/contactus-thank-you">
                                <div class="s_website_form_rows row s_col_no_bgcolor">
                                    <!-- Hidden email_to -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-0 py-2 col-12 s_website_form_dnone">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <input type="hidden"
                                                   class="form-control s_website_form_input"
                                                   name="email_to"
                                                   value="info@yourcompany.example.com"/>
                                        </div>
                                    </div>
                                    <!-- First Name -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-0 py-2 col-12 col-md-6 s_website_form_custom s_website_form_required s_website_form_model_required"
                                         data-type="char">
                                        <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                            <label for="join_first_name">First Name
                                            </label>
                                            <input class="form-control s_website_form_input"
                                                   type="text" name="name" required=""
                                                   data-fill-with="name"
                                                   id="join_first_name"
                                                   placeholder="Your first name"/>
                                        </div>
                                    </div>
                                    <!-- Last Name -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-0 py-2 col-12 col-md-6 s_website_form_custom s_website_form_required"
                                         data-type="char">
                                        <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                            <label for="join_last_name">Last Name</label>
                                            <input class="form-control s_website_form_input"
                                                   type="text" name="last_name"
                                                   required="" id="join_last_name"
                                                   placeholder="Your last name"/>
                                        </div>
                                    </div>
                                    <!-- Email -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-0 py-2 col-12 s_website_form_required s_website_form_model_required"
                                         data-type="email">
                                        <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                            <label for="join_email">Email Address</label>
                                            <input class="form-control s_website_form_input"
                                                   type="email" name="email_from"
                                                   required="" data-fill-with="email"
                                                   id="join_email"
                                                   placeholder="Your email address"/>
                                        </div>
                                    </div>
                                    <!-- Phone -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-0 py-2 col-12 col-md-6 s_website_form_custom"
                                         data-type="tel">
                                        <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                            <label for="join_phone">Phone Number</label>
                                            <input class="form-control s_website_form_input"
                                                   type="tel" name="phone"
                                                   data-fill-with="phone" id="join_phone"
                                                   placeholder="Your phone number"/>
                                        </div>
                                    </div>
                                    <!-- Date of Birth -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-0 py-2 col-12 col-md-6 s_website_form_custom s_website_form_required"
                                         data-type="date">
                                        <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                            <label for="join_dob">Date of Birth</label>
                                            <input class="form-control s_website_form_input"
                                                   type="date" name="dob" required=""
                                                   id="join_dob"/>
                                        </div>
                                    </div>
                                    <!-- Membership Plan -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-0 py-2 col-12 s_website_form_custom"
                                         data-type="selection">
                                        <div class="row s_col_no_resize s_col_no_bgcolor form-group">
                                            <label for="join_plan">Membership Plan</label>
                                            <select class="form-select s_website_form_input form-control"
                                                    name="membership_plan" id="join_plan">
                                                <option value="Guest Pass">Guest Pass
                                                    ($35/day)
                                                </option>
                                                <option value="Individual Membership">
                                                    Individual Membership ($149/month)
                                                </option>
                                                <option value="Family Membership">Family
                                                    Membership ($249/month)
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                    <!-- Submit -->
                                    <div class="mb-0 py-2 col-12 s_website_form_submit"
                                         data-name="Submit Button">
                                        <a href="#" role="button"
                                           class="btn btn-primary s_website_form_send">
                                            <span>Complete Application</span>
                                            <i class="fa fa-long-arrow-right ms-2"/>
                                        </a>
                                        <span id="s_website_form_result"/>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_join_application_snippet" inherit_id="website.snippets"
              priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_join_application"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Membership Application"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
