<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- About History Timeline -->
    <template id="s_about_history" name="About History Timeline">
        <section class="tc-about-history container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_about_history" data-name="About History">
            <div class="section-header" style="justify-content: center; text-align: center">
                <div style="display: flex; flex-direction: column; align-items: center">
                    <div class="tag-pill o_editable">Our History</div>
                    <h2 class="section-title o_editable">A decade of growth on the court</h2>
                </div>
            </div>
            <div class="timeline-container">
                <div class="timeline-line"/>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fa fa-flag" style="font-size: 20px; color: white;"/>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-year o_editable">2012</div>
                        <h3 class="timeline-title o_editable">The Foundation</h3>
                        <p class="timeline-desc o_editable">
                            Horizon Courts was established with just four outdoor clay
                            courts and a small pro shop. Founded by Arthur Pendelton, a
                            former collegiate champion, the goal was simple: bring premium
                            tennis facilities to the local community.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fa fa-building" style="font-size: 20px; color: white;"/>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-year o_editable">2016</div>
                        <h3 class="timeline-title o_editable">The Great Expansion</h3>
                        <p class="timeline-desc o_editable">
                            In response to overwhelming demand, the club underwent a
                            massive $5M renovation, adding eight indoor hard courts with
                            climate control, ensuring year-round playability for our
                            growing member base.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fa fa-graduation-cap" style="font-size: 20px; color: white;"/>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-year o_editable">2019</div>
                        <h3 class="timeline-title o_editable">Horizon Academy Launch</h3>
                        <p class="timeline-desc o_editable">
                            We officially launched our High-Performance Junior Academy,
                            bringing in elite coaches from around the globe. Since its
                            inception, the academy has helped over 50 juniors secure
                            collegiate athletic scholarships.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fa fa-trophy" style="font-size: 20px; color: white;"/>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-year o_editable">2023</div>
                        <h3 class="timeline-title o_editable">Awarded Club of the Year</h3>
                        <p class="timeline-desc o_editable">
                            Horizon was recognized as the "Premier Tennis Facility of the
                            Year" by the National Tennis Association, cementing our status
                            as a leading destination for tennis excellence in the region.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="s_about_history_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_about_history" t-thumbnail="/theme_tennis_court/static/src/img/fav.png" string="About History Timeline" group="s_section"/>
        </xpath>
    </template>
</odoo>
