<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Coaching philosophy section with three pillar cards -->
    <template id="s_coaches_head_coach" name="Head Coach">
        <section class="container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_coaches_head_coach"
                 data-name="Head Coach">
            <div style="background-color:var(--background);padding:80px 40px;border-radius:var(--radius-xl);text-align:center;">
                <div class="tag-pill o_editable"
                     style="background:white;display:inline-block;">Our approach
                </div>
                <h2 class="section-title o_editable" style="margin:0 auto 64px auto;">The
                    Horizon Philosophy
                </h2>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;text-align:left;">
                    <div class="facility-card"
                         style="border:none;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">
                        <div class="facility-icon"
                             style="background-color:rgba(255,183,77,0.15);color:var(--accent);">
                            <i class="fa fa-crosshairs" style="font-size:20px;"/>
                        </div>
                        <h3 class="facility-title o_editable"
                            style="font-size:18px;font-weight:600;">Goal-Oriented
                        </h3>
                        <p class="facility-desc o_editable">An evolving program that
                            accommodates all styles of play, tailoring our approach to
                            maximize every player's potential.
                        </p>
                    </div>
                    <div class="facility-card"
                         style="border:none;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">
                        <div class="facility-icon"
                             style="background-color:rgba(11,100,214,0.1);color:var(--primary);">
                            <i class="fa fa-video-camera" style="font-size:20px;"/>
                        </div>
                        <h3 class="facility-title o_editable"
                            style="font-size:18px;font-weight:600;">Data-Driven
                        </h3>
                        <p class="facility-desc o_editable">We incorporate video
                            technology and analysis for objective feedback. You cannot
                            change what you can't see.
                        </p>
                    </div>
                    <div class="facility-card"
                         style="border:none;box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">
                        <div class="facility-icon"
                             style="background-color:rgba(232,90,79,0.1);color:var(--destructive);">
                            <i class="fa fa-handshake-o" style="font-size:20px;"/>
                        </div>
                        <h3 class="facility-title o_editable"
                            style="font-size:18px;font-weight:600;">Mentorship
                        </h3>
                        <p class="facility-desc o_editable">Our mentors care deeply about
                            player development. We teach resilience, discipline, and
                            sportsmanship.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_coaches_head_coach_snippet" inherit_id="website.snippets"
              priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_coaches_head_coach"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Head Coach"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
