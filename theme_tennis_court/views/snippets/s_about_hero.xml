<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Main hero section for the About page -->
    <template id="s_about_hero" name="About Hero">
        <section class="about-hero-section container section-spacing o_colored_level"
                 data-name="About Hero" data-snippet="theme_tennis_court.s_about_hero">
            <div class="about-hero-container">
                <!-- Background image container -->
                <div class="about-hero-bg">
                    <img src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg"
                         alt="Club Exterior"/>
                </div>
                <!-- Dark overlay on top of background image -->
                <div class="about-hero-overlay"/>
                <!-- Centered text content over the hero image -->
                <div class="about-hero-content">
                    <div class="tag-pill hero-pill-light o_editable">Our Story</div>
                    <h1 class="about-hero-title o_editable">More than just a club.<br/>A
                        legacy of excellence.
                    </h1>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_about_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_about_hero"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="About Hero"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
