<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hero banner for the Programs page -->
    <template id="s_programs_hero" name="Programs Hero">
        <section class="programs-hero-section container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_programs_hero"
                 data-name="Programs Hero">
            <div class="programs-hero-container">
                <!-- Full-bleed background image of tennis players -->
                <div class="programs-hero-bg">
                    <img src="/theme_tennis_court/static/src/img/scenes/hero_court.jpg"
                         alt="Tennis players"/>
                </div>
                <!-- Dark overlay for text readability -->
                <div class="programs-hero-overlay"/>
                <div class="programs-hero-content">
                    <div class="tag-pill hero-pill-light o_editable">Our Programs</div>
                    <h1 class="programs-hero-title o_editable">Elevate your game.<br/>
                        Programs for every level.
                    </h1>
                    <p class="programs-hero-subtitle o_editable">From first-time beginners
                        to tournament competitors, our expert-designed programs develop
                        real skills at every stage.
                    </p>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_programs_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_programs_hero"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Programs Hero"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
