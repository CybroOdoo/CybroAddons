<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Leadership team grid section -->
    <template id="s_about_leadership" name="Leadership">
        <section class="container section-spacing o_colored_level" data-name="Leadership"
                 data-snippet="theme_tennis_court.s_about_leadership">
            <!-- Section heading with tag pill and title -->
            <div class="section-header">
                <div>
                    <div class="tag-pill o_editable">Leadership</div>
                    <h2 class="section-title o_editable">The team behind the net</h2>
                </div>
            </div>
            <!-- Grid of leadership team member cards -->
            <div class="team-grid">
                <div class="team-card">
                    <img src="/theme_tennis_court/static/src/img/avatars/male_european_50.jpg"
                         class="team-img" alt="Leader"/>
                    <div class="team-info">
                        <h4 class="team-name o_editable">Arthur Pendelton</h4>
                        <span class="team-role o_editable">Founder &amp; CEO</span>
                    </div>
                </div>
                <div class="team-card">
                    <img src="/theme_tennis_court/static/src/img/avatars/female_na_35_2.jpg"
                         class="team-img" alt="Leader"/>
                    <div class="team-info">
                        <h4 class="team-name o_editable">Jessica Vance</h4>
                        <span class="team-role o_editable">Chief Operating Officer</span>
                    </div>
                </div>
                <div class="team-card">
                    <img src="/theme_tennis_court/static/src/img/avatars/male_african_35.jpg"
                         class="team-img" alt="Leader"/>
                    <div class="team-info">
                        <h4 class="team-name o_editable">Marcus Hayes</h4>
                        <span class="team-role o_editable">Director of Operations</span>
                    </div>
                </div>
                <div class="team-card">
                    <img src="/theme_tennis_court/static/src/img/avatars/female_na_35_2.jpg"
                         class="team-img" alt="Leader"/>
                    <div class="team-info">
                        <h4 class="team-name o_editable">Chloe Lin</h4>
                        <span class="team-role o_editable">Head of Member Experience
                        </span>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_about_leadership_snippet" inherit_id="website.snippets"
              priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_about_leadership"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Leadership"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
