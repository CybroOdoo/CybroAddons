<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Key statistics banner: hours played, retention, members, tournaments -->
    <template id="s_stats_banner" name="Tennis Court Stats Banner">
        <section class="tc-stats container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_stats_banner"
                 data-name="Stats Banner">
            <div class="stats-section">
                <!-- Four-column grid of stat items -->
                <div class="stats-grid">
                    <div class="stat-item" data-name="Stat 1">
                        <h4 class="o_editable">12k+</h4>
                        <p class="o_editable">Hours Played Annually</p>
                    </div>
                    <div class="stat-item" data-name="Stat 2">
                        <h4 class="o_editable">89%</h4>
                        <p class="o_editable">Player Retention Rate</p>
                    </div>
                    <div class="stat-item" data-name="Stat 3">
                        <h4 class="o_editable">1,200</h4>
                        <p class="o_editable">Active Members</p>
                    </div>
                    <div class="stat-item" data-name="Stat 4">
                        <h4 class="o_editable">125</h4>
                        <p class="o_editable">Annual Tournaments</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_stats_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_stats_banner"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Stats Banner"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
