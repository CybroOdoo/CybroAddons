<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Featured programs: Junior Academy and Adult Clinics -->
    <template id="s_programs_junior" name="Junior Academy">
        <section class="container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_programs_junior"
                 data-name="Junior Academy">
            <div class="section-header">
                <div>
                    <div class="tag-pill o_editable">Elite Junior Training</div>
                    <h2 class="section-title o_editable">Our flagship programs</h2>
                </div>
            </div>
            <!-- Junior Academy: image left, details right -->
            <div class="featured-program">
                <div class="featured-img-wrap">
                    <img src="/theme_tennis_court/static/src/img/scenes/junior_academy.jpg"
                         alt="Junior Academy"/>
                    <div class="featured-img-badge o_editable">Junior Academy</div>
                </div>
                <div class="featured-text">
                    <h2 class="featured-program-title o_editable">Elite Junior Academy
                    </h2>
                    <p class="featured-program-desc o_editable">From beginner fundamentals
                        to high-performance training, our Junior Academy provides
                        structured, progressive coaching for players aged 5–18. Led by
                        USPTA-certified coaches.
                    </p>
                    <ul class="featured-bullets">
                        <li>
                            <div class="bullet-icon">
                                <i class="fa fa-check" style="font-size:14px;"/>
                            </div>
                            Age-appropriate skill tracks from Mini Tennis to Tournament
                            Prep
                        </li>
                        <li>
                            <div class="bullet-icon">
                                <i class="fa fa-check" style="font-size:14px;"/>
                            </div>
                            High-Performance structured curriculum &amp; video analysis
                        </li>
                        <li>
                            <div class="bullet-icon">
                                <i class="fa fa-check" style="font-size:14px;"/>
                            </div>
                            College-level recruiting support for elite teens
                        </li>
                    </ul>
                    <div class="featured-meta">
                        <div class="meta-item">
                            <span class="meta-label">Ages</span>
                            <span class="meta-value o_editable">5 – 18 yrs</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Schedule</span>
                            <span class="meta-value o_editable">Mon – Sat</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Starting from</span>
                            <span class="meta-value o_editable">$149 / mo</span>
                        </div>
                    </div>
                    <div style="display:flex;gap:14px;">
                        <a href="/join" style="text-decoration:none;">
                            <button class="btn-primary">Enroll in Junior Academy
                                <i class="fa fa-arrow-right"
                                   style="font-size:16px;color:white;"/>
                            </button>
                        </a>
                    </div>
                </div>
            </div>
            <!-- Adult Clinics -->
            <div class="featured-program reverse">
                <div class="featured-img-wrap">
                    <img src="/theme_tennis_court/static/src/img/scenes/competitive.jpg"
                         alt="Adult Leagues"/>
                    <div class="featured-img-badge o_editable">Adults</div>
                </div>
                <div class="featured-text">
                    <h2 class="featured-program-title o_editable">Adult Clinics &amp;
                        Leagues
                    </h2>
                    <p class="featured-program-desc o_editable">Whether you're a weekend
                        warrior or a competitive player, our adult programs deliver expert
                        instruction in a fun, motivating environment. Group clinics run
                        daily.
                    </p>
                    <ul class="featured-bullets">
                        <li>
                            <div class="bullet-icon">
                                <i class="fa fa-check" style="font-size:14px;"/>
                            </div>
                            Beginner, intermediate, and advanced group clinics
                        </li>
                        <li>
                            <div class="bullet-icon">
                                <i class="fa fa-check" style="font-size:14px;"/>
                            </div>
                            Structured NTRP-matched league seasons
                        </li>
                        <li>
                            <div class="bullet-icon">
                                <i class="fa fa-check" style="font-size:14px;"/>
                            </div>
                            Social round-robins every weekend
                        </li>
                    </ul>
                    <div class="featured-meta">
                        <div class="meta-item">
                            <span class="meta-label">Ages</span>
                            <span class="meta-value o_editable">18+ yrs</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Schedule</span>
                            <span class="meta-value o_editable">Daily</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Starting from</span>
                            <span class="meta-value o_editable">$89 / mo</span>
                        </div>
                    </div>
                    <div style="display:flex;gap:14px;">
                        <a href="/join" style="text-decoration:none;">
                            <button class="btn-primary">View all clinics
                                <i class="fa fa-arrow-right"
                                   style="font-size:16px;color:white;"/>
                            </button>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_programs_junior_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_programs_junior"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Junior Academy"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
