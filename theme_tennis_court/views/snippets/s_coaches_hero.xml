<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Hero banner for the Coaches page -->
    <template id="s_coaches_hero" name="Coaches Hero">
        <section class="programs-hero-section container section-spacing o_colored_level"
                 data-snippet="theme_tennis_court.s_coaches_hero"
                 data-name="Coaches Hero">
            <div class="programs-hero-container">
                <!-- Full-bleed background image -->
                <div class="programs-hero-bg">
                    <img src="/theme_tennis_court/static/src/img/scenes/coaches_bg.jpg"
                         alt="Coaches"/>
                </div>
                <!-- Dark overlay for text readability -->
                <div class="programs-hero-overlay"/>
                <!-- Hero headline and tag pill -->
                <div class="programs-hero-content">
                    <div class="tag-pill hero-pill-light o_editable">Our Team</div>
                    <h1 class="programs-hero-title o_editable">Meet the experts.<br/>Train
                        with the best.
                    </h1>
                </div>
            </div>
        </section>
    </template>
    <!-- Registers this template as a draggable snippet in the website editor -->
    <template id="s_coaches_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_tennis_court.s_coaches_hero"
               t-thumbnail="/theme_tennis_court/static/src/img/fav.png"
               string="Coaches Hero"
               group="s_section"/>
        </xpath>
    </template>
</odoo>
