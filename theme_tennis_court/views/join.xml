<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Join / Membership Application page -->
    <template id="tc_join_page" name="Tennis Court Join">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container section-spacing o_colored_level"
                         data-snippet="theme_tennis_court.tc_join_application" data-name="Membership Application">
                    <div class="join-container">
                        <!-- Sidebar -->
                        <aside class="join-sidebar">
                            <img src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg" class="sidebar-img"
                                 alt="Tennis court aerial view"/>
                            <div class="sidebar-content">
                                <h3 class="sidebar-title">Join the club</h3>
                                <p class="sidebar-desc">
                                    Get access to premium courts, professional coaching, and a vibrant community of
                                    tennis enthusiasts.
                                </p>
                                <!-- Bulleted list of key member benefits -->
                                <ul class="sidebar-benefits">
                                    <li class="sidebar-benefit">
                                        <i class="fa fa-check-circle benefit-icon"/>
                                        <span class="">12 Championship-grade courts</span>
                                    </li>
                                    <li class="sidebar-benefit">
                                        <i class="fa fa-check-circle benefit-icon"/>
                                        <span class="">Advanced 7-day booking privileges</span>
                                    </li>
                                    <li class="sidebar-benefit">
                                        <i class="fa fa-check-circle benefit-icon"/>
                                        <span class="">Exclusive member tournaments &amp; leagues</span>
                                    </li>
                                    <li class="sidebar-benefit">
                                        <i class="fa fa-check-circle benefit-icon"/>
                                        <span class="">Luxury clubhouse &amp; locker room access</span>
                                    </li>
                                </ul>
                            </div>
                        </aside>

                        <!-- Form Wrapper -->
                        <div class="join-form-wrapper">
                            <h1 class="form-header-title">Membership Application</h1>
                            <p class="form-header-desc">Complete the form below to secure your membership and start
                                playing today.
                            </p>

                            <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                <div class="container-fluid px-0">
                                    <form action="/website/form/" method="post" enctype="multipart/form-data"
                                          class="o_mark_required" data-mark="*" data-pre-fill="true"
                                          data-model_name="mail.mail" data-success-mode="redirect"
                                          data-success-page="/contactus-thank-you">
                                        <div class="s_website_form_rows row s_col_no_bgcolor">
                                            <div data-name="Field"
                                                 class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                                    <label class="col-form-label col-sm-auto s_website_form_label"
                                                           style="width: 200px">
                                                        <span class="s_website_form_label_content"/>
                                                    </label>
                                                    <div class="col-sm">
                                                        <input type="hidden" class="form-control s_website_form_input"
                                                               name="email_to" value="info@yourcompany.example.com"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div data-name="Field"
                                                 class="s_website_form_field mb-3 col-12 col-md-6 s_website_form_custom
                                                 s_website_form_required"
                                                 data-type="char">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                                    <label class="col-form-label col-sm-auto s_website_form_label"
                                                           style="width: 200px" for="join_first_name">
                                                        <span class="s_website_form_label_content">First Name</span>
                                                        <span class="s_website_form_mark">*</span>
                                                    </label>
                                                    <div class="col-sm">
                                                        <input class="form-control s_website_form_input" type="text"
                                                               name="name" required="1" data-fill-with="name"
                                                               id="join_first_name"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div data-name="Field"
                                                 class="s_website_form_field mb-3 col-12 col-md-6 s_website_form_custom
                                                 s_website_form_required"
                                                 data-type="char">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                                    <label class="col-form-label col-sm-auto s_website_form_label"
                                                           style="width: 200px" for="join_last_name">
                                                        <span class="s_website_form_label_content">Last Name</span>
                                                        <span class="s_website_form_mark">*</span>
                                                    </label>
                                                    <div class="col-sm">
                                                        <input class="form-control s_website_form_input" type="text"
                                                               name="last_name" required="1" id="join_last_name"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div data-name="Field"
                                                 class="s_website_form_field mb-3 col-12 s_website_form_model_required"
                                                 data-type="email">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                                    <label class="col-form-label col-sm-auto s_website_form_label"
                                                           style="width: 200px" for="join_email">
                                                        <span class="s_website_form_label_content">Email Address</span>
                                                        <span class="s_website_form_mark">*</span>
                                                    </label>
                                                    <div class="col-sm">
                                                        <input class="form-control s_website_form_input" type="email"
                                                               name="email_from" required="1" data-fill-with="email"
                                                               id="join_email"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div data-name="Field"
                                                 class="s_website_form_field mb-3 col-12 col-md-6 s_website_form_custom"
                                                 data-type="tel">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                                    <label class="col-form-label col-sm-auto s_website_form_label"
                                                           style="width: 200px" for="join_phone">
                                                        <span class="s_website_form_label_content">Phone Number</span>
                                                    </label>
                                                    <div class="col-sm">
                                                        <input class="form-control s_website_form_input" type="tel"
                                                               name="phone" data-fill-with="phone" id="join_phone"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div data-name="Field"
                                                 class="s_website_form_field mb-3 col-12 col-md-6 s_website_form_custom
                                                 s_website_form_required"
                                                 data-type="date">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                                    <label class="col-form-label col-sm-auto s_website_form_label"
                                                           style="width: 200px" for="join_dob">
                                                        <span class="s_website_form_label_content">Date of Birth</span>
                                                        <span class="s_website_form_mark">*</span>
                                                    </label>
                                                    <div class="col-sm">
                                                        <input class="form-control s_website_form_input" type="date"
                                                               name="dob" required="1" id="join_dob"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div data-name="Field"
                                                 class="s_website_form_field mb-3 col-12 s_website_form_custom"
                                                 data-type="selection">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                                    <label class="col-form-label col-sm-auto s_website_form_label"
                                                           style="width: 200px" for="join_plan">
                                                        <span class="s_website_form_label_content">Membership Plan
                                                        </span>
                                                    </label>
                                                    <div class="col-sm">
                                                        <select class="form-select s_website_form_input"
                                                                name="membership_plan" id="join_plan">
                                                            <option value="Guest Pass">Guest Pass ($35/day)</option>
                                                            <option value="Individual Membership">Individual Membership
                                                                ($149/month)
                                                            </option>
                                                            <option value="Family Membership">Family Membership
                                                                ($249/month)
                                                            </option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mb-0 py-2 col-12 s_website_form_submit text-start s_website_form_no_submit_label"
                                                 data-name="Submit Button">
                                                <div style="width: 200px;" class="s_website_form_label"/>
                                                <span id="s_website_form_result"/>
                                                <a href="#" role="button" class="btn btn-primary s_website_form_send">
                                                    Complete Application
                                                </a>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </section>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>

    <!-- Publishes the Join page at /join -->
    <record id="tc_join_page_page" model="theme.website.page">
        <field name="url">/join</field>
        <field name="view_id" ref="tc_join_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>