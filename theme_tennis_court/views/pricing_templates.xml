<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full Pricing page template -->
    <template id="pricing_templates" name="Tennis Court Pricing">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero -->
                <section class="programs-hero-section section-spacing o_colored_level" data-snippet="theme_tennis_court.s_pricing_hero" data-name="Pricing Hero">
                    <div class="container">
                        <div class="programs-hero-container">
                        <div class="programs-hero-bg"><img src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg" alt="Tennis court"/></div>
                        <div class="programs-hero-overlay"/>
                        <div class="programs-hero-content">
                            <div class="tag-pill hero-pill-light o_editable">Memberships</div>
                            <h1 class="programs-hero-title o_editable">Simple, transparent pricing</h1>
                            <p class="programs-hero-subtitle o_editable">Choose the membership that fits your game. Whether you play once a month or every day, we have a plan for you.</p>
                        </div>
                    </div>
                    </div>
                </section>
                <!-- Pricing Cards -->
                <section class="section-spacing o_colored_level" data-snippet="theme_tennis_court.s_pricing_benefits" data-name="Membership Benefits">
                    <div class="container">
                        <div class="pricing-grid">
                        <div class="pricing-card">
                            <h3 class="pricing-tier o_editable">Guest Pass</h3>
                            <div class="pricing-price"><span class="o_editable">$35</span><span class="pricing-period">/day</span></div>
                            <p class="pricing-desc o_editable">Perfect for visitors or those looking to try our facilities before committing.</p>
                            <ul class="pricing-features">
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Full day court access</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Locker room &amp; amenities</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Pro shop access</span></li>
                                <li class="pricing-feature" style="color:var(--muted-foreground);"><div style="width:20px;display:flex;align-items:center;justify-content:center;color:var(--border);"><i class="fa fa-minus" style="font-size:20px;"/></div><span class="o_editable">No advance court booking</span></li>
                            </ul>
                            <a href="/join" style="text-decoration:none;"><button class="btn-secondary pricing-btn">Buy Guest Pass</button></a>
                        </div>
                        <div class="pricing-card" style="border:2px solid var(--accent);box-shadow:0 10px 25px -5px rgba(0,0,0,0.05);">
                            <div class="popular-badge o_editable">Most Popular</div>
                            <h3 class="pricing-tier o_editable">Individual</h3>
                            <div class="pricing-price"><span class="o_editable">$149</span><span class="pricing-period">/month</span></div>
                            <p class="pricing-desc o_editable">Everything an adult player needs. Full access to courts, clinics, and exclusive events.</p>
                            <ul class="pricing-features">
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Unlimited court time</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">7-day advance booking</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">USTA affiliated leagues</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Access to fitness center</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Complimentary towel service</span></li>
                            </ul>
                            <a href="/join" style="text-decoration:none;"><button class="btn-primary pricing-btn" style="background-color:var(--accent);color:white;border:none;">Join as Individual</button></a>
                        </div>
                        <div class="pricing-card">
                            <h3 class="pricing-tier o_editable">Family</h3>
                            <div class="pricing-price"><span class="o_editable">$249</span><span class="pricing-period">/month</span></div>
                            <p class="pricing-desc o_editable">Bring the whole family. Complete membership for up to 4 family members.</p>
                            <ul class="pricing-features">
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Includes 2 adults &amp; 2 children</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Unlimited court time</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">7-day advance booking</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Priority junior camp registration</span></li>
                                <li class="pricing-feature"><div class="feature-icon"><i class="fa fa-check-circle" style="font-size:20px;"/></div><span class="o_editable">Guest passes (2/month)</span></li>
                            </ul>
                            <a href="/join" style="text-decoration:none;"><button class="btn-primary pricing-btn">Join as Family</button></a>
                        </div>
                    </div>
                    </div>
                </section>
                <!-- A La Carte -->
                <section class="section-spacing o_colored_level" data-snippet="theme_tennis_court.s_pricing_faq" data-name="Pricing FAQ">
                    <div class="container">
                        <div class="alacarte-container">
                        <h2 class="section-title o_editable" style="margin-bottom:48px;">A La Carte &amp; Add-ons</h2>
                        <div class="alacarte-grid">
                            <div style="display:flex;flex-direction:column;">
                                <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;"><div><div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);" class="o_editable">Private Lesson (1 Hour)</div><div style="font-size:14px;color:var(--muted-foreground);" class="o_editable">One-on-one with a certified professional.</div></div><div style="font-weight:600;font-size:18px;" class="o_editable">$95</div></div>
                                <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;"><div><div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);" class="o_editable">Semi-Private Lesson</div><div style="font-size:14px;color:var(--muted-foreground);" class="o_editable">Share the court and focus on technique.</div></div><div style="font-weight:600;font-size:18px;" class="o_editable">$50 /pp</div></div>
                                <div style="padding-bottom:24px;display:flex;justify-content:space-between;align-items:flex-start;"><div><div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);" class="o_editable">Ball Machine Rental</div><div style="font-size:14px;color:var(--muted-foreground);" class="o_editable">1 hour, unlimited balls on court 4.</div></div><div style="font-weight:600;font-size:18px;" class="o_editable">$25</div></div>
                            </div>
                            <div style="display:flex;flex-direction:column;">
                                <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;"><div><div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);" class="o_editable">Group Clinic (Drop-in)</div><div style="font-size:14px;color:var(--muted-foreground);" class="o_editable">90-minute structured clinic with drill and play.</div></div><div style="font-weight:600;font-size:18px;" class="o_editable">$35</div></div>
                                <div style="padding-bottom:24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;"><div><div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);" class="o_editable">Racket Stringing</div><div style="font-size:14px;color:var(--muted-foreground);" class="o_editable">Labor only, premium strings in stock.</div></div><div style="font-weight:600;font-size:18px;" class="o_editable">$20</div></div>
                                <div style="padding-bottom:24px;display:flex;justify-content:space-between;align-items:flex-start;"><div><div style="font-weight:600;font-size:16px;margin-bottom:4px;color:var(--foreground);" class="o_editable">Seasonal Locker</div><div style="font-size:14px;color:var(--muted-foreground);" class="o_editable">Dedicated premium locker in the clubhouse.</div></div><div style="font-weight:600;font-size:18px;" class="o_editable">$15 /mo</div></div>
                            </div>
                        </div>
                    </div>
                    </div>
                </section>
                <!-- FAQ -->
                <section class="section-spacing o_colored_level">
                    <div class="container">
                        <div style="text-align:center;margin-bottom:48px;"><div class="tag-pill o_editable" style="display:inline-block;">Questions?</div><h2 class="section-title o_editable" style="margin:0 auto;">Frequently Asked Questions</h2></div>
                    <div style="max-width:800px;margin:0 auto;">
                        <div style="padding:32px 0;border-bottom:1px solid var(--border);"><div style="font-weight:600;font-size:18px;color:var(--foreground);" class="o_editable">Are there any initiation fees?</div><div style="margin-top:16px;font-size:15px;color:var(--muted-foreground);line-height:1.6;" class="o_editable">No. The monthly fee you see is the fee you pay. No hidden initiation or cancellation fees.</div></div>
                        <div style="padding:32px 0;border-bottom:1px solid var(--border);"><div style="font-weight:600;font-size:18px;color:var(--foreground);" class="o_editable">Can I cancel my membership at any time?</div><div style="margin-top:16px;font-size:15px;color:var(--muted-foreground);line-height:1.6;" class="o_editable">Yes. All memberships are month-to-month with no long-term contracts.</div></div>
                        <div style="padding:32px 0;border-bottom:1px solid var(--border);"><div style="font-weight:600;font-size:18px;color:var(--foreground);" class="o_editable">Do I need to be a member to take private lessons?</div><div style="margin-top:16px;font-size:15px;color:var(--muted-foreground);line-height:1.6;" class="o_editable">No. Private lessons and guest passes are available to everyone.</div></div>
                        <div style="padding:32px 0;border-bottom:1px solid var(--border);"><div style="font-weight:600;font-size:18px;color:var(--foreground);" class="o_editable">How far in advance can I book a court?</div><div style="margin-top:16px;font-size:15px;color:var(--muted-foreground);line-height:1.6;" class="o_editable">Individual and Family members can book up to 7 days in advance. Guest Pass holders book same-day only.</div></div>
                    </div>
                    </div>
                </section>
                <!-- CTA -->
                <section class="o_colored_level" style="margin-bottom:120px;">
                    <div class="container">
                        <div class="cta-section">
                        <img class="cta-bg" src="/theme_tennis_court/static/src/img/scenes/scene_6.jpg" alt="Court"/>
                        <div class="cta-overlay"/>
                        <div class="cta-content">
                            <h2 class="cta-title o_editable">Ready to join the club?</h2>
                            <p class="cta-desc o_editable">Become part of our growing community and train with the best tennis facilities in the city.</p>
                            <div style="display:flex;gap:16px;justify-content:center;margin-top:16px;">
                                <a href="/join" style="text-decoration:none;"><button class="btn-primary" style="background:white;color:var(--primary);border:none;padding:14px 32px;">Sign Up Now</button></a>
                            </div>
                        </div>
                    </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
    <!-- Publishes the Pricing page at /pricing -->
    <record id="pricing_templates_record" model="theme.website.page">
        <field name="url">/pricing</field>
        <field name="view_id" ref="pricing_templates"/>
        <field name="is_published">True</field>
    </record>
</odoo>
