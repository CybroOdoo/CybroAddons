<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full About page template composed of reusable snippet sections -->
    <template id="about_templates" name="Tennis Court About">
        <t t-call="website.layout">
            <!-- Page content wrapper required by Odoo website layout -->
            <div id="wrap" class="oe_structure">
                <!-- Hero -->
                <section class="about-hero-section container section-spacing o_colored_level" data-name="About Hero" data-snippet="theme_tennis_court.s_about_hero">
                    <div class="about-hero-container">
                        <div class="about-hero-bg">
                            <img src="/theme_tennis_court/static/src/img/scenes/club_exterior.jpg" alt="Club Exterior"/>
                        </div>
                        <div class="about-hero-overlay"/>
                        <div class="about-hero-content">
                            <div class="tag-pill hero-pill-light o_editable">Our Story</div>
                            <h1 class="about-hero-title o_editable">More than just a club.<br/>A legacy of excellence.</h1>
                        </div>
                    </div>
                </section>
                <!-- Mission -->
                <section class="container section-spacing o_colored_level" data-name="Mission" data-snippet="theme_tennis_court.s_about_mission">
                    <div class="mission-grid">
                        <div class="mission-text-content">
                            <div class="tag-pill o_editable">Our Mission</div>
                            <h2 class="mission-heading o_editable">We exist to elevate the game of tennis and build a community united by passion.</h2>
                            <p class="mission-paragraph o_editable">Since our doors opened, Horizon Courts has been driven by a singular vision: to create the ultimate environment for tennis players to thrive. We believe that top-tier facilities must be paired with an inclusive, welcoming community to truly inspire greatness.</p>
                            <p class="mission-paragraph o_editable">Whether you're an aspiring junior professional, a dedicated league player, or someone stepping onto the court for the very first time, our commitment remains the same.</p>
                            <div style="margin-top:24px;display:flex;gap:16px;">
                                <img src="/theme_tennis_court/static/src/img/avatars/male_european_50.jpg" alt="Founder" style="width:64px;height:64px;border-radius:50%;object-fit:cover;"/>
                                <div style="display:flex;flex-direction:column;justify-content:center;">
                                    <div style="font-weight:600;font-size:16px;" class="o_editable">Arthur Pendelton</div>
                                    <div style="color:var(--muted-foreground);font-size:14px;" class="o_editable">Founder &amp; CEO</div>
                                </div>
                            </div>
                        </div>
                        <div class="mission-image">
                            <img src="/theme_tennis_court/static/src/img/scenes/coaches_bg.jpg" alt="Players shaking hands"/>
                        </div>
                    </div>
                </section>
                <!-- Values -->
                <section class="container section-spacing o_colored_level" data-name="Values" data-snippet="theme_tennis_court.s_about_values">
                    <div class="values-section">
                        <div class="values-header">
                            <div class="tag-pill o_editable" style="background:white;">Core Pillars</div>
                            <h2 class="section-title o_editable" style="margin:0;text-align:center;">What drives us forward</h2>
                        </div>
                        <div class="values-grid">
                            <div class="value-card">
                                <div class="value-icon"><i class="fa fa-trophy" style="font-size:28px;"/></div>
                                <h3 class="value-title o_editable">Excellence</h3>
                                <p class="value-desc o_editable">From our championship-grade court surfaces to our carefully selected coaching staff, we refuse to compromise on quality.</p>
                            </div>
                            <div class="value-card">
                                <div class="value-icon"><i class="fa fa-users" style="font-size:28px;"/></div>
                                <h3 class="value-title o_editable">Community</h3>
                                <p class="value-desc o_editable">Tennis is as much about the people as it is about the sport. We foster an environment where friendships are forged.</p>
                            </div>
                            <div class="value-card">
                                <div class="value-icon"><i class="fa fa-heartbeat" style="font-size:28px;"/></div>
                                <h3 class="value-title o_editable">Holistic Wellness</h3>
                                <p class="value-desc o_editable">We support the complete athlete. Our focus extends beyond technique to include physical conditioning and mental resilience.</p>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
                <!-- History -->
                <section class="tc-about-history container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_about_history" data-name="About History">
            <div class="section-header" style="justify-content: center; text-align: center">
                <div style="display: flex; flex-direction: column; align-items: center">
                    <div class="tag-pill o_editable">Our History</div>
                    <h2 class="section-title o_editable">A decade of growth on the court</h2>
                </div>
            </div>
            <div class="timeline-container">
                <div class="timeline-line"/>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fa fa-flag" style="font-size: 20px; color: white;"/>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-year o_editable">2012</div>
                        <h3 class="timeline-title o_editable">The Foundation</h3>
                        <p class="timeline-desc o_editable">
                            Horizon Courts was established with just four outdoor clay
                            courts and a small pro shop. Founded by Arthur Pendelton, a
                            former collegiate champion, the goal was simple: bring premium
                            tennis facilities to the local community.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fa fa-building" style="font-size: 20px; color: white;"/>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-year o_editable">2016</div>
                        <h3 class="timeline-title o_editable">The Great Expansion</h3>
                        <p class="timeline-desc o_editable">
                            In response to overwhelming demand, the club underwent a
                            massive $5M renovation, adding eight indoor hard courts with
                            climate control, ensuring year-round playability for our
                            growing member base.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fa fa-graduation-cap" style="font-size: 20px; color: white;"/>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-year o_editable">2019</div>
                        <h3 class="timeline-title o_editable">Horizon Academy Launch</h3>
                        <p class="timeline-desc o_editable">
                            We officially launched our High-Performance Junior Academy,
                            bringing in elite coaches from around the globe. Since its
                            inception, the academy has helped over 50 juniors secure
                            collegiate athletic scholarships.
                        </p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker">
                        <i class="fa fa-trophy" style="font-size: 20px; color: white;"/>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-year o_editable">2023</div>
                        <h3 class="timeline-title o_editable">Awarded Club of the Year</h3>
                        <p class="timeline-desc o_editable">
                            Horizon was recognized as the "Premier Tennis Facility of the
                            Year" by the National Tennis Association, cementing our status
                            as a leading destination for tennis excellence in the region.
                        </p>
                    </div>
                </div>
            </div>
        </section>
                <!-- Leadership Team -->
                <section class="container section-spacing o_colored_level" data-name="Leadership" data-snippet="theme_tennis_court.s_about_leadership">
                    <div class="section-header"><div><div class="tag-pill o_editable">Leadership</div><h2 class="section-title o_editable">The team behind the net</h2></div></div>
                    <div class="team-grid">
                        <div class="team-card"><img src="/theme_tennis_court/static/src/img/avatars/male_european_50.jpg" class="team-img" alt="Leader"/><div class="team-info"><h4 class="team-name o_editable">Arthur Pendelton</h4><span class="team-role o_editable">Founder &amp; CEO</span></div></div>
                        <div class="team-card"><img src="/theme_tennis_court/static/src/img/avatars/female_na_35_2.jpg" class="team-img" alt="Leader"/><div class="team-info"><h4 class="team-name o_editable">Jessica Vance</h4><span class="team-role o_editable">Chief Operating Officer</span></div></div>
                        <div class="team-card"><img src="/theme_tennis_court/static/src/img/avatars/male_african_35.jpg" class="team-img" alt="Leader"/><div class="team-info"><h4 class="team-name o_editable">Marcus Hayes</h4><span class="team-role o_editable">Director of Operations</span></div></div>
                        <div class="team-card"><img src="/theme_tennis_court/static/src/img/avatars/female_na_35_2.jpg" class="team-img" alt="Leader"/><div class="team-info"><h4 class="team-name o_editable">Chloe Lin</h4><span class="team-role o_editable">Head of Member Experience</span></div></div>
                    </div>
                </section>
                <!-- CTA -->
                <section class="container o_colored_level" data-snippet="theme_tennis_court.s_cta_banner" data-name="CTA">
                    <div class="cta-section">
                        <img class="cta-bg o_we_custom_image" src="/theme_tennis_court/static/src/img/scenes/scene_6.jpg" alt="Ready to play"/>
                        <div class="cta-overlay"/>
                        <div class="cta-content">
                            <h2 class="cta-title o_editable">Be part of our story</h2>
                            <p class="cta-desc o_editable">Join our community and experience tennis the way it was meant to be played.</p>
                            <a href="/join" style="text-decoration:none;"><button class="btn-primary" style="background:white;color:var(--primary);padding:16px 40px;font-size:16px;margin-top:16px;">Become a Member</button></a>
                        </div>
                    </div>
                </section>
                <!-- Empty editable zone for adding extra snippets via the editor -->
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
    <!-- Publishes the About page at /about -->
    <record id="about_templates_record" model="theme.website.page">
        <field name="url">/about</field>
        <field name="view_id" ref="about_templates"/>
        <field name="is_published">True</field>
    </record>
</odoo>
