<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full Facilities page template -->
    <template id="facilities_templates" name="Tennis Court Facilities">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero -->
                <section class="hero-section container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_facilities_hero" data-name="Facilities Hero">
                    <div class="about-hero-container">
                        <div class="about-hero-bg">
                            <img src="/theme_tennis_court/static/src/img/scenes/facilities_overview.jpg" alt="Facilities Overview"/>
                        </div>
                        <div class="about-hero-overlay"/>
                        <div class="about-hero-content">
                            <div class="tag-pill hero-pill-light o_editable">Our Facilities</div>
                            <h1 class="about-hero-title o_editable">World-class courts.<br/>Unmatched amenities.</h1>
                        </div>
                    </div>
                </section>
                <!-- Courts -->
                <section class="container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_facilities_main_courts" data-name="Main Courts">
                    <div class="section-header"><div><div class="tag-pill o_editable">The Courts</div><h2 class="section-title o_editable">Play year-round, whatever the weather</h2></div></div>
                    <div class="court-grid">
                        <div class="court-card">
                            <div class="court-image"><img src="/theme_tennis_court/static/src/img/scenes/scene_11.jpg" alt="Indoor Courts"/></div>
                            <h3 class="court-title o_editable">Championship Indoor Hard Courts</h3>
                            <p class="court-desc o_editable">Our eight indoor courts feature a tournament-grade multi-layer acrylic surface designed for medium-fast play and optimal shock absorption.</p>
                            <ul class="court-features">
                                <li class="court-feature-item"><div class="court-feature-icon"><i class="fa fa-check" style="font-size:16px;"/></div> Climate-controlled (70°F year-round)</li>
                                <li class="court-feature-item"><div class="court-feature-icon"><i class="fa fa-check" style="font-size:16px;"/></div> Anti-glare LED tournament lighting</li>
                                <li class="court-feature-item"><div class="court-feature-icon"><i class="fa fa-check" style="font-size:16px;"/></div> Smart court camera integration</li>
                            </ul>
                        </div>
                        <div class="court-card">
                            <div class="court-image"><img src="/theme_tennis_court/static/src/img/scenes/scene_15.jpg" alt="Outdoor Courts"/></div>
                            <h3 class="court-title o_editable">Premium Outdoor Clay Courts</h3>
                            <p class="court-desc o_editable">Experience the traditional European game on our ten pristine red clay courts. Meticulously maintained daily for consistent bounce.</p>
                            <ul class="court-features">
                                <li class="court-feature-item"><div class="court-feature-icon"><i class="fa fa-check" style="font-size:16px;"/></div> Sub-surface irrigation system</li>
                                <li class="court-feature-item"><div class="court-feature-icon"><i class="fa fa-check" style="font-size:16px;"/></div> Shaded spectator seating</li>
                                <li class="court-feature-item"><div class="court-feature-icon"><i class="fa fa-check" style="font-size:16px;"/></div> Professional daily grooming</li>
                            </ul>
                        </div>
                    </div>
                </section>
                <!-- Amenities -->
                <section class="container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_facilities_training" data-name="Training Center">
                    <div class="amenities-section">
                        <div class="amenities-image-stack">
                            <img class="amenities-img-main" src="/theme_tennis_court/static/src/img/scenes/clubhouse.jpg" alt="Clubhouse"/>
                            <img class="amenities-img-sub" src="/theme_tennis_court/static/src/img/scenes/pro_shop.jpg" alt="Pro Shop"/>
                        </div>
                        <div class="amenities-content">
                            <div class="tag-pill o_editable">The Clubhouse</div>
                            <h2 class="amenities-heading o_editable">Relax, refuel, and re-equip between your matches</h2>
                            <p class="amenities-desc o_editable">Our modern clubhouse serves as the central hub. Designed with comfort and luxury in mind.</p>
                            <div class="amenities-list">
                                <div class="amenity-item"><div class="amenity-icon"><i class="fa fa-coffee" style="font-size:28px;"/></div><div class="amenity-text"><span class="amenity-name o_editable">Courtside Café &amp; Lounge</span><span class="amenity-sub o_editable">Healthy smoothies, artisanal coffee, and fresh meals with panoramic court views.</span></div></div>
                                <div class="amenity-item"><div class="amenity-icon"><i class="fa fa-shopping-bag" style="font-size:28px;"/></div><div class="amenity-text"><span class="amenity-name o_editable">Pro Shop &amp; Stringing</span><span class="amenity-sub o_editable">Full-service pro shop with latest gear. 24-hour racket stringing available.</span></div></div>
                                <div class="amenity-item"><div class="amenity-icon"><i class="fa fa-shield" style="font-size:28px;"/></div><div class="amenity-text"><span class="amenity-name o_editable">Executive Locker Rooms</span><span class="amenity-sub o_editable">Spacious secure lockers with towel service, premium toiletries, and steam rooms.</span></div></div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Wellness -->
                <section class="container section-spacing o_colored_level" data-snippet="theme_tennis_court.s_facilities_amenities" data-name="Pro Shop &amp; Amenities">
                    <div class="values-section">
                        <div class="values-header">
                            <div class="tag-pill o_editable" style="background:white;">Fitness &amp; Recovery</div>
                            <h2 class="section-title o_editable" style="margin:0;text-align:center;">Train. Recover. Repeat.</h2>
                        </div>
                        <div class="values-grid">
                            <div class="value-card"><div class="value-icon"><i class="fa fa-heartbeat" style="font-size:28px;"/></div><h3 class="value-title o_editable">Performance Gym</h3><p class="value-desc o_editable">Fully equipped fitness center with cardio, free weights, and functional training zones for tennis conditioning.</p></div>
                            <div class="value-card"><div class="value-icon"><i class="fa fa-line-chart" style="font-size:28px;"/></div><h3 class="value-title o_editable">Physiotherapy Clinic</h3><p class="value-desc o_editable">On-site sports physiotherapists for injury prevention, mobility screening, and rehabilitation programs.</p></div>
                            <div class="value-card"><div class="value-icon"><i class="fa fa-sun-o" style="font-size:28px;"/></div><h3 class="value-title o_editable">Recovery Suites</h3><p class="value-desc o_editable">Post-match recovery with ice baths, infrared saunas, and normatec compression therapy.</p></div>
                        </div>
                    </div>
                </section>
                <!-- CTA -->
                <section class="container o_colored_level">
                    <div class="cta-section">
                        <img class="cta-bg" src="/theme_tennis_court/static/src/img/scenes/scene_6.jpg" alt="Ready"/>
                        <div class="cta-overlay"/>
                        <div class="cta-content">
                            <h2 class="cta-title o_editable">Ready to experience the best?</h2>
                            <p class="cta-desc o_editable">Take a private tour and see why Horizon Courts is the preferred destination.</p>
                            <a href="/contactus" style="text-decoration:none;"><button class="btn-primary" style="background:white;color:var(--primary);padding:16px 40px;font-size:16px;margin-top:16px;">Book a Tour</button></a>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
    <!-- Publishes the Facilities page at /facilities -->
    <record id="facilities_templates_record" model="theme.website.page">
        <field name="url">/facilities</field>
        <field name="view_id" ref="facilities_templates"/>
        <field name="is_published">True</field>
    </record>
</odoo>
