<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--Record for payplug payment provider-->
        <record id="payment_acquirer_payplug" model="payment.provider">
            <field name="code">payplug</field>
            <field name="name">PayPlug</field>
            <field name="redirect_form_view_id" ref="redirect_form"/>
            <field name="image_128" type="base64"
                   file="payment_payplug_acquirer/static/src/img/payplug_logo.png"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="payment_method_ids"
                   eval="[Command.set([ref('payment_payplug_acquirer.payment_method_payplug')])]"/>
            <field name="module_id" ref="base.module_payment_payplug_acquirer"/>
        </record>
    </data>
</odoo>
