<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--This XML record customizes the form view of the `payment.provider` model
        to add fields for the PayPlug payment provider.-->
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">
            payment.provider.view.form.inherit.payment.payplug.acquirer
        </field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="model">payment.provider</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='credentials']" position="inside">
                <group invisible="code != 'payplug'">
                    <field name="payplug_secret_key"/>
                    <field name="payplug_end_point"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
