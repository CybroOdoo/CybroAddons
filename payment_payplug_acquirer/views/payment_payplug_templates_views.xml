<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    This template defines a form that contains hidden input fields used
    for redirecting to the payment provider.-->
    <template id="redirect_form">
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="amount" t-att-value="amount"/>
            <input type="hidden" name="currency" t-att-value="currency"/>
            <input type="hidden" name="save_card" t-att-value="save_card"/>
            <input type="hidden" name="return_url" t-att-value="return_url"/>
            <input type="hidden" name="cancel_url" t-att-value="cancel_url"/>
            <input type="hidden" name="notification_url"
                   t-att-value="notification_url"/>
            <input type="hidden" name="customer_id" t-att-value="customer_id"/>
            <input type="hidden" name="return" t-att-value="return"/>
            <input type="hidden" name="csrf_token"
                   t-att-value="request.csrf_token()"/>
        </form>
    </template>
</odoo>
