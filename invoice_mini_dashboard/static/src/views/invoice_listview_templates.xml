<?xml version="1.0" encoding="UTF-8"?>
<!-- List renderer showing the dashboard above the customer invoices list -->
<templates>
    <t t-name="invoice_mini_dashboard.AccountListView" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[contains(@class,'o_list_renderer')]" position="before">
            <AccountDashboard/>
        </xpath>
    </t>
</templates>
