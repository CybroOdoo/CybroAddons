<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_whatsapp_icon" name="Website WhatsApp Icon"
              inherit_id="portal.frontend_layout">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <a t-if="website.sanitized_mobile_number"
               t-attf-href="https://api.whatsapp.com/send?phone=#{website.sanitized_mobile_number}"
               class="cy_whatsapp_web"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Contact us on WhatsApp">
                <i class="oi oi-whatsapp" data-icon="oi_whatsapp" aria-hidden="true"/>
            </a>
        </xpath>
    </template>
</odoo>
