<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- View for res config settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.product.internal.ref.generator
        </field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="companies" position="after">
                <block title="Product Internal Reference Generator"
                       name="product_internal_ref_setting_container">
                    <setting id="auto_generate_internal_ref_setting"
                             string="Auto Generate Internal Reference"
                             help="Automatically generate the internal reference of new products.">
                        <field name="auto_generate_internal_ref"/>
                    </setting>
                    <setting id="product_name_config_setting"
                             string="Product Name Configuration"
                             help="Add the product name to the internal reference.">
                        <field name="product_name_config"/>
                        <div class="content-group mt16"
                             invisible="not product_name_config">
                            <div class="row">
                                <label for="pro_name_digit"
                                       string="Product Name Digit"
                                       class="col-lg-4"/>
                                <field name="pro_name_digit"/>
                            </div>
                            <div class="row mt8">
                                <label for="pro_name_separator"
                                       string="Product Name Separator"
                                       class="col-lg-4"/>
                                <field name="pro_name_separator"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="pro_template_config_setting"
                             string="Product Attribute Configuration"
                             help="Add the product attribute values to the internal reference.">
                        <field name="pro_template_config"/>
                        <div class="content-group mt16"
                             invisible="not pro_template_config">
                            <div class="row">
                                <label for="pro_template_digit"
                                       string="Attribute Name Digit"
                                       class="col-lg-4"/>
                                <field name="pro_template_digit"/>
                            </div>
                            <div class="row mt8">
                                <label for="pro_template_separator"
                                       string="Attribute Name Separator"
                                       class="col-lg-4"/>
                                <field name="pro_template_separator"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="pro_categ_config_setting"
                             string="Product Category Configuration"
                             help="Add the product category name to the internal reference.">
                        <field name="pro_categ_config"/>
                        <div class="content-group mt16"
                             invisible="not pro_categ_config">
                            <div class="row">
                                <label for="pro_categ_digit"
                                       string="Product Category Name Digit"
                                       class="col-lg-4"/>
                                <field name="pro_categ_digit"/>
                            </div>
                            <div class="row mt8">
                                <label for="pro_categ_separator"
                                       string="Product Category Name Separator"
                                       class="col-lg-4"/>
                                <field name="pro_categ_separator"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </div>
        </field>
    </record>
</odoo>
