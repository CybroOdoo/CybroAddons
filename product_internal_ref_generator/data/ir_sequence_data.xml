<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Single sequence shared by every product reference, never reset -->
        <record id="product_sequence_ref" model="ir.sequence">
            <field name="name">Product Internal Reference</field>
            <field name="code">product.sequence.ref</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="use_date_range"/>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
