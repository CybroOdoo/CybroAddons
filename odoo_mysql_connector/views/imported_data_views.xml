<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- imported data list view -->
    <record id="imported_data_view_list" model="ir.ui.view">
        <field name="model">imported.data</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" string="Imported On"/>
                <field name="mysql_table"/>
                <field name="mysql_ref"/>
                <field name="model_id"/>
                <field name="odoo_ref"/>
                <field name="log_note"/>
            </list>
        </field>
    </record>

    <!-- imported data form view -->
    <record id="imported_data_view_form" model="ir.ui.view">
        <field name="model">imported.data</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="mysql_table"/>
                            <field name="mysql_ref"/>
                            <field name="create_date" string="Imported On"/>
                        </group>
                        <group>
                            <field name="model_id"/>
                            <field name="odoo_ref"/>
                        </group>
                    </group>
                    <group>
                        <field name="log_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- imported data search view -->
    <record id="imported_data_view_search" model="ir.ui.view">
        <field name="model">imported.data</field>
        <field name="arch" type="xml">
            <search string="Search Audit Logs">
                <field name="mysql_table"/>
                <field name="mysql_ref"/>
                <field name="model_id"/>
                <group>
                    <filter string="MySQL Table" name="group_by_table"
                            domain="[]" context="{'group_by': 'mysql_table'}"/>
                    <filter string="Model" name="group_by_model"
                            domain="[]" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- imported data action -->
    <record id="imported_data_action" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">imported.data</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="imported_data_view_search"/>
    </record>

    <!-- imported data menu item -->
    <menuitem id="imported_data_menu"
              name="Audit Logs"
              action="imported_data_action"
              parent="mysql_connector_menu_root"
              sequence="10"/>
</odoo>
