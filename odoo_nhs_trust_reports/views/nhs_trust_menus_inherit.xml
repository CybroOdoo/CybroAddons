<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Adds the Reports sub-menu under the root NHS Trusts menu.
        The root menu (menu_nhs_trust_root) is defined in odoo_nhs_trust_management.
    -->
    <menuitem id="menu_nhs_trust_reports"
              name="Reports"
              parent="odoo_nhs_trust_management.menu_nhs_trust_root"
              sequence="30"/>

    <menuitem id="menu_nhs_trust_directory_export"
              name="Export Trust Directory"
              parent="menu_nhs_trust_reports"
              action="action_nhs_trust_directory_export"
              sequence="10"/>
</odoo>
