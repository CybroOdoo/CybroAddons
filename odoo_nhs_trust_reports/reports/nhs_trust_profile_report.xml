<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Report action for the NHS Trust Profile PDF.
        Bound to nhs.trust via binding_model_id + binding_type=report so Odoo
        automatically adds a "Print Trust Profile" entry in the Print menu on
        the Trust form.
    -->
    <record id="action_report_nhs_trust_profile" model="ir.actions.report">
        <field name="name">NHS Trust Profile</field>
        <field name="model">nhs.trust</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_trust_reports.nhs_trust_profile_template</field>
        <field name="report_file">odoo_nhs_trust_reports.nhs_trust_profile_template</field>
        <field name="print_report_name">'NHS Trust Profile - ' + (object.short_name or object.name)</field>
        <field name="binding_model_id" ref="odoo_nhs_trust_management.model_nhs_trust"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
</odoo>
