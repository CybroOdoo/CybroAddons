<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    View for sale order-->
    <record id="sale_order_view_form_inherit_barcode_scanning_sale_purchase"
            model="ir.ui.view">
        <field name="name">
            sale.order.view.form.inherit.barcode.scanning.sale.purchase
        </field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list[@name='sol_list']/column[@name='product_and_description']"
                   position="before">
                <field name="barcode_scan" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>
