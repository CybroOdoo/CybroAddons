<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- discuss.Call is the call view everywhere: inline in a channel, and inside mail.Meeting
         for fullscreen and picture-in-picture, so patching it alone covers every view. -->
    <t t-inherit="discuss.Call" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-discuss-Call-main')]" position="inside">
            <MeetingSubtitles t-if="isActiveCall" thread="channel"/>
        </xpath>
    </t>
</templates>
