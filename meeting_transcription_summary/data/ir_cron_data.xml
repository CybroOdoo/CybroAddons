<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Starts and completes the background transcription of uploaded meeting recordings.
         Triggered right away when a recording is queued, and every 20 s while one is running;
         the interval is only a fallback. -->
    <record id="ir_cron_process_recordings" model="ir.cron">
        <field name="name">Discuss: Transcribe Meeting Recordings</field>
        <field name="model_id" ref="model_discuss_meeting_summary"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_recordings()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
