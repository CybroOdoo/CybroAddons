<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Meeting transcripts are as private as the conversation they come from:
         only members of the channel see them (administrators see everything). -->
    <record id="rule_discuss_meeting_summary_member" model="ir.rule">
        <field name="name">Meeting summary: members of the channel</field>
        <field name="model_id" ref="model_discuss_meeting_summary"/>
        <field name="domain_force">[('channel_id.is_member', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_discuss_meeting_summary_admin" model="ir.rule">
        <field name="name">Meeting summary: administrators</field>
        <field name="model_id" ref="model_discuss_meeting_summary"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_discuss_meeting_transcript_line_member" model="ir.rule">
        <field name="name">Meeting transcript line: members of the channel</field>
        <field name="model_id" ref="model_discuss_meeting_transcript_line"/>
        <field name="domain_force">[('summary_id.channel_id.is_member', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_discuss_meeting_transcript_line_admin" model="ir.rule">
        <field name="name">Meeting transcript line: administrators</field>
        <field name="model_id" ref="model_discuss_meeting_transcript_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
