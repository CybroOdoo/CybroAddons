<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Inherited form view of res config settings to add field in
    configuration settings-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.analytic.tag</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
             <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                 <setting id="pos_analytic_account_setting" string="Analytic Account" help="Track costs and revenues in each POS session">
                     <field name="pos_analytic_account_id"
                            domain="['|', ('company_id', '=', company_id), ('company_id', '=', False)]"/>
                 </setting>
             </xpath>
        </field>
    </record>
</odoo>