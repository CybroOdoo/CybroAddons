<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Record rules-->
    <!--Rule for User-->
    <record id="rule_employee_purchase_requisition_user" model="ir.rule">
        <field name="name">Requisition User Rule</field>
        <field name="model_id" ref="model_employee_purchase_requisition"/>
        <field name="domain_force">[('confirm_id', '=', user.id)]</field>
        <field name="groups"
               eval="[(4, ref('all_in_one_purchase_kit.group_employee_requisition_user'))]"/>
    </record>
    <!--Rule for head-->
    <record id="rule_employee_purchase_requisition_head" model="ir.rule">
        <field name="name">Department Head Rule</field>
        <field name="model_id" ref="model_employee_purchase_requisition"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups"
               eval="[(4, ref('all_in_one_purchase_kit.group_employee_requisition_head'))]"/>
    </record>
    <!--Rule for manager-->
    <record id="rule_employee_purchase_requisition_manager" model="ir.rule">
        <field name="name">Requisition Manager Rule</field>
        <field name="model_id" ref="model_employee_purchase_requisition"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups"
               eval="[(4, ref('all_in_one_purchase_kit.group_employee_requisition_manager'))]"/>
    </record>
    <!--Company rule-->
    <record id="rule_employee_purchase_requisition_company" model="ir.rule">
        <field name="name">Purchase Requisition Company Rule</field>
        <field name="model_id" ref="model_employee_purchase_requisition"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
</odoo>
