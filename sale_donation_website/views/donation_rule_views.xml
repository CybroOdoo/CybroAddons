<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    donation rule form view-->
    <record id="donation_rule_view_form" model="ir.ui.view">
        <field name="name">donation.rule.form</field>
        <field name="model">donation.rule</field>
        <field name="arch" type="xml">
            <form string="Donation">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="website_ids" widget='many2many_tags'/>
                            <field name="ask_to_donate"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <!--    donation rule tree view-->
    <record id="donation_rule_view_tree" model="ir.ui.view">
        <field name="name">donation.rule.tree</field>
        <field name="model">donation.rule</field>
        <field name="arch" type="xml">
            <tree string="Donation">
                <field name="name"/>
                <field name="amount"/>
                <field name="website_ids" widget='many2many_tags'/>
                <field name="ask_to_donate"/>
            </tree>
        </field>
    </record>
    <!--    Action for donation rule-->
    <record id="donation_rule_action" model="ir.actions.act_window">
        <field name="name">Donation</field>
        <field name="res_model">donation.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
