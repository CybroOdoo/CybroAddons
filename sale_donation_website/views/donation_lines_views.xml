<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    donation lines tree view-->
    <record id="donation_lines_view_tree" model="ir.ui.view">
        <field name="name">donation.lines.tree</field>
        <field name="model">donation.lines</field>
        <field name="arch" type="xml">
            <tree string="Donation">
                <field name="partner_id"/>
                <field name="sale"/>
                <field name="donation"/>
                <field name="date"/>
                <field name="donated_amount"/>
                <field name="website"/>
            </tree>
        </field>
    </record>
    <!--    Action for donation lines-->
    <record id="donation_lines_action" model="ir.actions.act_window">
        <field name="name">Donation Lines</field>
        <field name="res_model">donation.lines</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
