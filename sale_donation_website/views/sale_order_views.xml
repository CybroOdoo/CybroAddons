<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Adding donation fields into sale order-->
     <record id="view_inherit_sale_order_donation" model="ir.ui.view">
         <field name="name">Add Donation in Sale Order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="donation_ids" widget="many2many_tags"/>
                <field name="donation_amount"/>
            </field>
        </field>
    </record>

</odoo>
