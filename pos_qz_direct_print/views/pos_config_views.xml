<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit POS configuration form to add server direct print settings -->
    <record id="view_pos_config_qz" model="ir.ui.view">
        <field name="name">pos.config.server.print.form</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Add printer configuration after other device settings -->
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting id="server_print_settings" string="Server Direct Print" help="Configure silent printing via the Odoo server">
                    <div class="content-group mt16">
                        <div class="row">
                            <label string="Printer Name (CUPS)" for="system_printer_name" class="col-lg-12 o_light_label"/>
                            <field name="system_printer_name" class="col-lg-12" placeholder="e.g. Canon-G6000"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
