<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit POS configuration form to add QZ Tray direct print settings -->
    <record id="view_pos_config_qz" model="ir.ui.view">
        <field name="name">pos.config.qz.tray.print.form</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Add printer configuration after other device settings -->
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting id="qz_tray_print_settings" string="Direct Print (QZ Tray)" help="Print receipts silently through QZ Tray installed on the cashier's computer">
                    <div class="content-group mt16">
                        <div class="row">
                            <label string="QZ Tray Printer Name" for="system_printer_name" class="col-lg-12 o_light_label"/>
                            <field name="system_printer_name" class="col-lg-12" placeholder="e.g. Canon-G6000"/>
                        </div>
                    </div>
                </setting>
            </xpath>

        </field>
    </record>
</odoo>
