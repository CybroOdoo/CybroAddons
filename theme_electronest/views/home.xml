<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <template id="homepage_banner" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="inside">
                <t t-call="theme_electronest.product_showcase_snippet"/>
                <div class="oe_structure"/>
                <t t-call="theme_electronest.top_categories_snippet"/>
                <div class="oe_structure"/>
                <t t-call="theme_electronest.best_offers_snippet"/>
                <div class="oe_structure"/>
                <t t-call="theme_electronest.promotional_banner_slider_snippet"/>
                <div class="oe_structure"/>
                <t t-call="theme_electronest.product_offer_banner_snippet"/>
            <div id="homepage_content" class="oe_structure">
            </div>
        </xpath>
    </template>
</odoo>
