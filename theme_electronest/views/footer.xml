<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Template for footer-->
    <template id="footer_electronest" inherit_id="website.layout"
              name="Footer Electronest">
        <xpath expr="//footer[@id='bottom']" position="replace">
            <div>
                <div class="container-fluid cmpad">
                    <div class="footer-top">
                        <div class="row">
                            <div class="col-lg-6 pb-3 pb-lg-0">
                                <h5>STAY UPTO DATE ABOUT<br/>OUR LATEST OFFERS
                                </h5>
                            </div>
                            <div
                                    class="col-lg-6 d-flex align-items-center justify-content-lg-end">
                                <div class="position-relative">
                                    <img src="/theme_electronest/static/description/images/icons/email.svg" alt=""/>
                                    <input type="text" placeholder="Enter your email address"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer>
                <div class="container-fluid cmpad py-5">
                    <div class="row foot-border">
                        <div class="col-xl-4 pb-3 pb-xl-0">
                            <img src="/theme_electronest/static/src/img/logo/logo.svg" alt="logo" class="mb-3"/>
                            <p class="para mb-3">
                                Find the latest electronics that match your needs and style, from
                                smartphones to laptops.
                            </p>
                            <ul class="social-list">
                                <li>
                                    <a href="">
                                        <img src="/theme_electronest/static/description/images/icons/x.svg"
                                             alt=""
                                             width="15"
                                             height="15"/>
                                    </a>
                                </li>
                                <li>
                                    <a href="">
                                        <img
                                            src="/theme_electronest/static/description/images/icons/fb.svg"
                                            alt=""
                                            width="15"
                                            height="15"
                                        />
                                    </a>
                                </li>
                                <li>
                                    <a href="">
                                        <img
                                            src="/theme_electronest/static/description/images/icons/insta.svg"
                                            alt=""
                                            width="15"
                                            height="15"
                                        />
                                    </a>
                                </li>
                                <li>
                                    <a href="">
                                        <img
                                            src="/theme_electronest/static/description/images/icons/youtube.svg"
                                            alt=""
                                            width="15"
                                            height="15"
                                        />
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-xl-8">
                            <div class="row">
                                <div class="col-lg-3 col-6 pb-3 pb-lg-0">
                                    <h4>COMPANY</h4>
                                    <ul>
                                        <li>
                                            <a href="">About</a>
                                        </li>
                                        <li>
                                            <a href="">Features</a>
                                        </li>
                                        <li>
                                            <a href="">Shop</a>
                                        </li>
                                        <li>
                                            <a href="">Contact Us</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-lg-3 col-6 pb-3 pb-lg-0">
                                    <h4>HELP</h4>
                                    <ul>
                                        <li>
                                            <a href="">Customer Support</a>
                                        </li>
                                        <li>
                                            <a href="">Delivery Details</a>
                                        </li>
                                        <li>
                                            <a href="">Terms and Conditions</a>
                                        </li>
                                        <li>
                                            <a href="">Privacy Policy</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-lg-3 col-6 pb-3 pb-lg-0">
                                    <h4>FAQ</h4>
                                    <ul>
                                        <li>
                                            <a href="">Account</a>
                                        </li>
                                        <li>
                                            <a href="">Manage Deliveries</a>
                                        </li>
                                        <li>
                                            <a href="">Orders</a>
                                        </li>
                                        <li>
                                            <a href="">Payments</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-lg-3 col-6 pb-3 pb-lg-0">
                                    <h4>RESOURCES</h4>
                                    <ul>
                                        <li>
                                            <a href="">Free EBooks</a>
                                        </li>
                                        <li>
                                            <a href="">Development Tutorial</a>
                                        </li>
                                        <li>
                                            <a href="">How to Blog</a>
                                        </li>
                                        <li>
                                            <a href="">Youtube Playlist</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 pb-2 pb-md-0 d-flex align-items-center">
                            <p class="para">ElectroNest © 2025. All Rights Reserved</p>
                        </div>
                        <div class="col-md-6">
                            <ul class="d-flex gap-1 justify-content-start justify-content-md-end">
                                <li>
                                    <img src="/theme_electronest/static/description/images/icons/g1.svg" alt="" width="50"/>
                                </li>
                                <li>
                                    <img src="/theme_electronest/static/description/images/icons/g2.svg" alt="" width="50"/>
                                </li>
                                <li>
                                    <img src="/theme_electronest/static/description/images/icons/g3.svg" alt="" width="50"/>
                                </li>
                                <li>
                                    <img src="/theme_electronest/static/description/images/icons/g4.svg" alt="" width="50"/>
                                </li>
                                <li>
                                    <img src="/theme_electronest/static/description/images/icons/g5.svg" alt="" width="50"/>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>

