<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="electronest_product_offer_banner_snippet" inherit_id="website.snippets" name="Product Offer Banner">
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
            <t t-snippet="theme_electronest.product_offer_banner_snippet"
               string="Product Offer Banner"/>
        </xpath>
    </template>

    <!-- Website snippet to display promotional product offer banners linking to the shop page -->
    <template id="product_offer_banner_snippet" name="Product Offer Banner">
        <section>
            <div class="container-fluid cmpad py-4 pb-5">
                <div class="row row-cols-lg-3 row-cols-sm-2 row-cols-1 g-3">
                    <div class="cols">
                        <div class="shortbanner">
                            <img src="/theme_electronest/static/src/img/images/ban1.png" alt=""/>
                            <a href="/shop" class="stretched-link"/>
                        </div>
                    </div>
                    <div class="cols">
                        <div class="shortbanner">
                            <img src="/theme_electronest/static/src/img/images/ban2.png" alt=""/>
                            <a href="/shop" class="stretched-link"/>
                        </div>
                    </div>
                    <div class="cols">
                        <div class="shortbanner">
                            <img src="/theme_electronest/static/src/img/images/ban3.png" alt=""/>
                            <a href="/shop" class="stretched-link"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
