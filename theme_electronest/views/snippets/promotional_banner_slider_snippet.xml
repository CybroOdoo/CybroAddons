<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="electronest_promotional_banner_slider_snippet" inherit_id="website.snippets"
              name="Promotional Banner Slider">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]"
               position="inside">
            <t t-snippet="theme_electronest.promotional_banner_slider_snippet"
               string="Promotional Banner Slider"/>
        </xpath>
    </template>
    <!-- Website snippet for displaying a promotional banner slider with desktop and mobile images -->
    <template id="promotional_banner_slider_snippet" name="Product Offer Banner">
        <section>
            <div class="container-fluid cmpad py-4">
                <div class="row">
                    <div class="col-md-12">
                        <div class="swiper addswiper">
                            <div class="swiper-wrapper">
                                <div class="swiper-slide">
                                    <div class="desk">
                                        <img src="/theme_electronest/static/src/img/images/add1.jpg" alt=""/>
                                    </div>
                                    <div class="mob">
                                        <img src="/theme_electronest/static/src/img/images/add1-mob.jpg" alt=""/>
                                    </div>
                                </div>
                                <div class="swiper-slide">
                                    <div class="desk">
                                        <img src="/theme_electronest/static/src/img/images/add2.jpg" alt=""/>
                                    </div>
                                    <div class="mob">
                                        <img src="/theme_electronest/static/src/img/images/add2-mob.jpg" alt=""/>
                                    </div>
                                </div>
                            </div>

                            <div class="swiper-button-next"></div>
                            <div class="swiper-button-prev"></div>
                            <div class="swiper-pagination"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
