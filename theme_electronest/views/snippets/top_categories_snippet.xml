<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="electronest_top_categories_snippet" inherit_id="website.snippets" name="Top Categories">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]"
               position="inside">
            <t t-snippet="theme_electronest.top_categories_snippet"
               string="Top Categories"/>
        </xpath>
    </template>

    <!-- Website snippet to display top product categories with image and link to category shop page -->
    <template id="top_categories_snippet" name="Top Categories">
        <section>
            <div class="container-fluid cmpad pt-4 pb-3 font-montserrat">
                <div class="row">
                    <div class="col-md-12 pb-4">
                        <div class="head-flex head1">
                            <h3>Meet Our <span>Top Categories</span></h3>
                            <a href="/shop">View All</a>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="row row-cols-xl-7 g-3">

                            <t t-set="current_website" t-value="request.env['website'].get_current_website()"/>


                            <t t-set="top_cats" t-value="request.env['product.public.category'].sudo().search([
                                ('parent_id', '=', False),
                                ('website_id', 'in', [False, current_website.id])
                            ], order='sequence, name', limit=7)"/>

                            <t t-foreach="top_cats" t-as="cat">
                                <div class="col">
                                    <a t-attf-href="/shop?category=#{cat.id}" class="cat">
                                        <div class="img">
                                            <t t-if="cat.image_128">
                                                <img t-attf-src="/web/image/product.public.category/#{cat.id}/image_128"
                                                     t-att-alt="cat.name"
                                                     style="width:100%; height:100%; object-fit:contain;"/>
                                            </t>
                                            <t t-else="">
                                                <!-- Fallback placeholder if no image set -->
                                                <img src="/theme_electronest/static/src/img/images/cat1.png"
                                                     t-att-alt="cat.name"/>
                                            </t>
                                        </div>
                                        <h3 t-esc="cat.name"/>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>