<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="theme_electronest_portfolio_snippet_groups" inherit_id="website.snippets" name="Theme Electronest Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail=""
               string="Theme Electronest Sections"
               snippet-group="theme_electronest_sections"/>
        </xpath>
    </template>
</odoo>
