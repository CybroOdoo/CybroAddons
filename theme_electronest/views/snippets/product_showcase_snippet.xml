<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="electronest_product_showcase_snippet" inherit_id="website.snippets" name="Product Showcase">
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
            <t t-snippet="theme_electronest.product_showcase_snippet"
               string="Product Showcase"/>
        </xpath>
    </template>
    <!-- Website snippet showing homepage product showcase with hero slider and promotional product banners -->
    <template id="product_showcase_snippet" name="Product Offer Banner">
        <section>
            <div class="container-fluid cmpad slider">
                <div class="row">
                    <div class="col-xl-7 pe-xl-1 pb-3 pb-xl-0">
                        <div class="swiper heroswiper">
                            <div class="swiper-wrapper">
                                <div class="swiper-slide">
                                    <div class="desk">
                                        <img src="/theme_electronest/static/src/img/slider/slide1.jpg" alt="Slide 1"/>
                                        <a href="/shop" class="stretched-link"></a>
                                    </div>
                                    <div class="mob">
                                        <img src="/theme_electronest/static/src/img/slider/slide1-mob.jpg" alt="Slide 1 Mobile"/>
                                        <a href="/shop" class="stretched-link"></a>
                                    </div>
                                </div>
                                <div class="swiper-slide">
                                    <div class="desk">
                                        <img src="/theme_electronest/static/src/img/slider/slide2.jpg" alt="Slide 2"/>
                                        <a href="/shop" class="stretched-link"></a>
                                    </div>
                                    <div class="mob">
                                        <img src="/theme_electronest/static/src/img/slider/slide2-mob.jpg" alt="Slide 2 Mobile"/>
                                        <a href="/shop" class="stretched-link"></a>
                                    </div>
                                </div>
                                <div class="swiper-slide">
                                    <div class="desk">
                                        <img src="/theme_electronest/static/src/img/slider/slide3.jpg" alt="Slide 3"/>
                                        <a href="/shop" class="stretched-link"></a>
                                    </div>
                                    <div class="mob">
                                        <img src="/theme_electronest/static/src/img/slider/slide3-mob.jpg" alt="Slide 3 Mobile"/>
                                        <a href="/shop" class="stretched-link"></a>
                                    </div>
                                </div>
                            </div>
                            <div class="swiper-pagination"></div>
                        </div>
                    </div>
                    <div class="col-xl-5">
                        <div class="row">
                            <div class="col-xl-12 col-lg-6 pb-3">
                                <div class="hero1">
                                    <div class="herotext">
                                        <span class="subpara subpara1">Trend Devices</span>
                                        <p>Latest Laptops</p>
                                        <a href="/shop" class="bttn">View More</a>
                                    </div>
                                    <img src="/theme_electronest/static/src/img/images/pro1.png" alt="Latest Laptops"/>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 pe-xl-1 pb-3 pb-lg-0">
                                <div class="hero1 hero2">
                                    <div class="herotext">
                                        <span class="subpara subpara2">Best</span>
                                        <p>
                                            Gaming
                                            <br/>
                                            Console
                                        </p>
                                        <a href="/shop" class="bttn">View More</a>
                                    </div>
                                    <img src="/theme_electronest/static/src/img/images/pro2.png" alt="Gaming Console"/>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6">
                                <div class="hero1 hero3">
                                    <div class="herotext">
                                        <span class="subpara subpara3">Most</span>
                                        <p>
                                            Popular
                                            <br/>
                                            Watches
                                        </p>
                                        <a href="/shop" class="bttn">View More</a>
                                    </div>
                                    <img src="/theme_electronest/static/src/img/images/pro3.png" alt="Popular Watches"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>