<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Contact Us page template -->
    <template id="mars_contact" inherit_id="website.contactus" name="Contactus">
        <xpath expr="//section[hasclass('s_title')]" position="replace"/>
        <xpath expr="//section[hasclass('s_text_block')]" position="replace">
            <section class="electronest_section">
                <div class="container-fluid cmpad pb-5 slider">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="head-flex border-0 pb-4">
                                <p class="mb-0">Home - Contact</p>
                            </div>
                        </div>
                        <div class="col-md-12 pb-4">
                            <div class="head-flex head1">
                                <h3>Contact Us for
                                    <span>Exclusive Deals</span>
                                </h3>
                            </div>
                        </div>
                    </div>

                    <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                        <div class="container-fluid">
                            <form id="contactus_form" action="/website/form/" method="post"
                                  enctype="multipart/form-data"
                                  class="o_mark_required" data-mark="*" data-model_name="mail.mail"
                                  data-success-mode="redirect" data-success-page="/contactus-thank-you"
                                  data-pre-fill="true">

                                <div class="row myform contact">
                                    <div class="col-lg-8 pb-4 pb-lg-0">
                                        <div class="row s_website_form_rows s_col_no_bgcolor">
                                            <div class="col-sm-6 pe-sm-0 pb-2 s_website_form_field s_website_form_custom s_website_form_required"
                                                 data-type="char" data-name="Field">
                                                <label class="s_website_form_label d-none" style="width: 200px" for="contact1">
                                                    <span class="s_website_form_label_content">Name</span>
                                                    <span class="s_website_form_mark"> *</span>
                                                </label>
                                                <input id="contact1" type="text"
                                                       class="form-control s_website_form_input"
                                                       name="name" placeholder="Name" required=""
                                                       data-fill-with="name"/>
                                            </div>
                                            <div class="col-sm-6 pb-2 s_website_form_field s_website_form_custom"
                                                 data-type="char" data-name="Field">
                                                <label class="s_website_form_label d-none" style="width: 200px" for="contact2">
                                                    <span class="s_website_form_label_content">Phone Number</span>
                                                </label>
                                                <input id="contact2" type="tel"
                                                       class="form-control s_website_form_input"
                                                       name="phone" placeholder="Phone Number" data-fill-with="phone"/>
                                            </div>
                                            <div class="col-sm-6 pe-sm-0 pb-2 s_website_form_field s_website_form_required s_website_form_model_required"
                                                 data-type="email" data-name="Field">
                                                <label class="s_website_form_label d-none" style="width: 200px" for="contact3">
                                                    <span class="s_website_form_label_content">Email</span>
                                                    <span class="s_website_form_mark"> *</span>
                                                </label>
                                                <input id="contact3" type="email"
                                                       class="form-control s_website_form_input"
                                                       name="email_from" placeholder="Email" required=""
                                                       data-fill-with="email"/>
                                            </div>
                                            <div class="col-sm-6 pb-2 s_website_form_field s_website_form_custom"
                                                 data-type="char" data-name="Field">
                                                <label class="s_website_form_label d-none" style="width: 200px" for="contact4">
                                                    <span class="s_website_form_label_content">Company</span>
                                                </label>
                                                <input id="contact4" type="text"
                                                       class="form-control s_website_form_input"
                                                       name="company" placeholder="Company"
                                                       data-fill-with="commercial_company_name"/>
                                            </div>
                                            <div class="col-sm-12 pb-2 s_website_form_field s_website_form_required s_website_form_model_required"
                                                 data-type="char" data-name="Field">
                                                <label class="s_website_form_label d-none" style="width: 200px" for="contact5">
                                                    <span class="s_website_form_label_content">Subject</span>
                                                    <span class="s_website_form_mark"> *</span>
                                                </label>
                                                <input id="contact5" type="text"
                                                       class="form-control s_website_form_input"
                                                       name="subject" placeholder="Subject" required=""/>
                                            </div>
                                            <div class="col-sm-12 pb-2 s_website_form_field s_website_form_custom s_website_form_required"
                                                 data-type="text" data-name="Field">
                                                <label class="s_website_form_label d-none" style="width: 200px" for="contact6">
                                                    <span class="s_website_form_label_content">Question</span>
                                                    <span class="s_website_form_mark"> *</span>
                                                </label>
                                                <textarea id="contact6" class="form-control s_website_form_input"
                                                          name="description" placeholder="Question" required=""
                                                          rows="5"></textarea>
                                            </div>
                                            <div class="col-sm-12 s_website_form_field s_website_form_dnone">
                                                <label class="s_website_form_label d-none" style="width: 200px">
                                                    <span class="s_website_form_label_content"></span>
                                                </label>
                                                <input type="hidden" class="form-control s_website_form_input"
                                                       name="email_to"/>
                                            </div>
                                            <div class="col-sm-12 s_website_form_submit s_website_form_no_submit_label">
                                                <a href="#" role="button" class="bttn s_website_form_send">Submit</a>
                                                <span id="s_website_form_result"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="conbox">
                                            <h5>Need a Help?</h5>
                                            <p class="d-flex gap-2">
                                                <img src="/theme_electronest/static/description/images/icons/phone.svg" alt=""
                                                     width="15"/>
                                                +91 7688927937, +91 7688927943
                                            </p>
                                            <p class="d-flex gap-2">
                                                <img src="/theme_electronest/static/description/images/icons/mail.svg" alt=""
                                                     width="16"/>
                                                dm@electronestonline.com
                                            </p>
                                            <ul class="social-list">
                                                <li>
                                                    <a href="#" target="_blank">
                                                        <img src="/theme_electronest/static/description/images/icons/x.svg"
                                                             alt="Twitter" width="15" height="15"/>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="#" target="_blank">
                                                        <img src="/theme_electronest/static/description/images/icons/fb.svg"
                                                             alt="Facebook" width="15" height="15"/>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="#" target="_blank">
                                                        <img src="/theme_electronest/static/description/images/icons/insta.svg"
                                                             alt="Instagram" width="15" height="15"/>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a href="#" target="_blank">
                                                        <img src="/theme_electronest/static/description/images/icons/youtube.svg"
                                                             alt="YouTube" width="15" height="15"/>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
