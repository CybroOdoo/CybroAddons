<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="about_us_page" model="website.page">
        <field name="name">About Us Page</field>
        <field name="type">qweb</field>
        <field name="url">/about_us</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">theme_electronest.about_us</field>
        <field name="arch" type="xml">
            <t name="About Us Page" t-name="theme_electronest.about_us">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <t t-call="theme_electronest.snippet_about_us"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_about_us" model="website.menu">
        <field name="name">About Us</field>
        <field name="url">/about_us</field>
        <field name="page_id" ref="theme_electronest.about_us_page"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">10</field>
    </record>
</odoo>
