<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form view of the copy hidden menus wizard -->
    <record id="hide_menu_copy_wizard_view_form" model="ir.ui.view">
        <field name="name">hide.menu.copy.wizard.view.form</field>
        <field name="model">hide.menu.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="Copy Hidden Menus">
                <group>
                    <field name="source_user_id"
                           options="{'no_create': True}"/>
                    <field name="target_user_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_copy" type="object" string="Copy"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the copy hidden menus wizard -->
    <record id="action_hide_menu_copy_wizard" model="ir.actions.act_window">
        <field name="name">Copy Hidden Menus</field>
        <field name="res_model">hide.menu.copy.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
