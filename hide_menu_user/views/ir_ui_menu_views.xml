<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Inherited view of the model ir.ui.menu-->
    <record id="edit_menu_access" model="ir.ui.view">
        <field name="name">ir.ui.menu.view.form.inherit.hide.menu.user</field>
        <field name="model">ir.ui.menu</field>
        <field name="inherit_id" ref="base.edit_menu_access"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Restrict Access" name="restrict_users">
                    <group>
                        <field name="restrict_user_ids" widget="many2many_tags"/>
                        <field name="restrict_group_ids" widget="many2many_tags"/>
                    </group>
                    <button name="action_restrict_submenus" type="object"
                            string="Apply to sub-menus" class="btn-secondary"
                            confirm="Apply these restrictions to all sub-menus of this menu?"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
