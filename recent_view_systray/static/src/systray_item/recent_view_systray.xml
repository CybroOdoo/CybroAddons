<?xml version="1.0" encoding="UTF-8" ?>
 <!-- Defines systray dropdown UI to display and access recently viewed records with quick navigation. -->
<templates xml:space="preserve">
    <t t-name="recent_view_systray.RecentViewSystray">
        <Dropdown>
            <t t-set-slot="toggler">
                <i class="fa fa-history fa-lg" role="img" aria-label="Recent Views" title="Recent Views"/>
            </t>
            <t t-if="state.recentViews.length > 0">
                <t t-foreach="state.recentViews" t-as="view" t-key="view.url">
                    <DropdownItem
                        href="view.url"
                        onSelected="() => this.navigateToUrl(view.url)"
                        class="'o_recent_view_item'"
                    >
                        <t t-esc="view.name"/>
                    </DropdownItem>
                </t>
            </t>
            <t t-else="">
                <div class="px-3 py-2 text-muted">No recent views</div>
            </t>
        </Dropdown>
    </t>
</templates>
