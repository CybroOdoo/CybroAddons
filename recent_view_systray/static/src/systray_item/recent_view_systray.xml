<?xml version="1.0" encoding="UTF-8" ?>
 <!-- Defines systray dropdown UI to display and access recently viewed records with quick navigation. -->
<templates xml:space="preserve">
    <t t-name="recent_view_systray.RecentViewSystray">
        <Dropdown position="'bottom-end'" beforeOpen.bind="this.onBeforeOpen">
            <button class="o_nav_entry" aria-label="Recent Views" title="Recent Views">
                <i class="oi" data-icon="history" role="img" aria-label="Recent Views"/>
            </button>
            <t t-set-slot="content">
                <t t-if="this.recentViews.length > 0">
                    <t t-foreach="this.recentViews" t-as="view" t-key="view.url">
                        <DropdownItem attrs="{ href: view.url }" onSelected="() => this.onRecentViewClick(view)" class="'o_recent_view_item'">
                            <t t-out="view.name"/>
                        </DropdownItem>
                    </t>
                </t>
                <t t-else="">
                    <div class="px-3 py-2 text-muted">No recent views</div>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
