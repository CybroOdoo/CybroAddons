<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <!-- Adds a user-specific configuration tab to define the limit of recent views stored per user. -->
    <record id="view_users_form_recent_view_systray" model="ir.ui.view">
        <field name="name">res.users.form.recent.view.systray</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="recent_view_systray" string="Recents Limit">
                    <group>
                        <group>
                            <field name="history_limit"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
