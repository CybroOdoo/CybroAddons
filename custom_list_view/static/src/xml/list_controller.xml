<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<!-- Extension template for adding buttons in the listview -->
    <t t-inherit="web.ListView" t-inherit-mode="extension">
        <!-- Add buttons to list view control panel buttons slot -->
        <xpath expr="//t[@t-set-slot='control-panel-buttons']"
               position="inside">
            <!-- Shown only to users allowed to export data, like the
                 standard Export action -->
            <t t-if="this.isExportEnable">
                <!-- Print PDF button -->
                <button type="button" class="btn btn-primary"
                        t-on-click="this._onClickPDF" data-tooltip="Print PDF" >PDF</button>
                <!-- Print Excel button -->
                <button type="button" class="btn btn-secondary"
                        t-on-click="this._onClickExcel" data-tooltip="Print Excel" >Excel</button>
                <!-- Print CSV button -->
                <button type="button" class="btn btn-secondary"
                        t-on-click="this._onClickCSV" data-tooltip="Print CSV" >CSV</button>
                <!-- Copy to Clipboard button -->
                <button type="button" class="btn btn-secondary"
                        t-on-click="this._onClickCopy" data-tooltip="Copy to Clipboard" aria-label="Copy to Clipboard">
                    <i class="oi oi-fw" data-icon="assignment"/>
                </button>
            </t>
        </xpath>
    </t>
</templates>
