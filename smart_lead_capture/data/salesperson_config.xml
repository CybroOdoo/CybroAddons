<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Default configuration values for Smart Lead Capture.
            Change these values via:
            Odoo Settings → Smart Lead Capture section
        -->

        <!-- Default salesperson — set to Administrator initially -->
        <record id="smart_lead_capture_default_salesperson" model="ir.config_parameter">
            <field name="key">smart_lead_capture.default_salesperson_id</field>
            <field name="value"></field>
        </record>

        <!-- Twilio credentials — fill via Settings UI -->
        <record id="smart_lead_capture_twilio_sid" model="ir.config_parameter">
            <field name="key">smart_lead_capture.twilio_account_sid</field>
            <field name="value"></field>
        </record>

        <record id="smart_lead_capture_twilio_token" model="ir.config_parameter">
            <field name="key">smart_lead_capture.twilio_auth_token</field>
            <field name="value"></field>
        </record>

        <record id="smart_lead_capture_twilio_from" model="ir.config_parameter">
            <field name="key">smart_lead_capture.twilio_whatsapp_from</field>
            <field name="value">whatsapp:+14155238886</field>
        </record>

        <record id="smart_lead_capture_whatsapp_to" model="ir.config_parameter">
            <field name="key">smart_lead_capture.whatsapp_notify_number</field>
            <field name="value"></field>
        </record>

        <!-- Outbound webhook URL -->
        <record id="smart_lead_capture_outbound_url" model="ir.config_parameter">
            <field name="key">smart_lead_capture.outbound_webhook_url</field>
            <field name="value"></field>
        </record>

        <!-- Inbound webhook secret token — blank means the endpoint stays open -->
        <record id="smart_lead_capture_webhook_secret_token" model="ir.config_parameter">
            <field name="key">smart_lead_capture.webhook_secret_token</field>
            <field name="value"></field>
        </record>

    </data>
</odoo>