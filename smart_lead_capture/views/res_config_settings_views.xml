<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            res.config.settings — Smart Lead Capture section

            Extends the General Settings > CRM screen with a dedicated
            "Smart Lead Capture" block, added right after the built-in
            "Integrations" block. Exposes the configuration needed by the
            /webhook/google-form controller and the crm.lead extension:

                - Default salesperson for auto-assignment of new leads
                - Outbound webhook URL (Odoo -> external system on
                  lead create/update)
                - Inbound webhook secret token (external system -> Odoo,
                  optional shared-secret auth on /webhook/google-form)
                - Twilio credentials and WhatsApp numbers used for the
                  WhatsApp lead notification feature

            Each <setting> field is backed by a config_parameter on the
            res.config.settings model defined in models/res_config_settings.py,
            so values persist in ir.config_parameter and don't require a
            dedicated settings record.
        -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.smart_lead_capture</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='integration']" position="after">

                    <block title="Smart Lead Capture" name="smart_lead_capture">

                        <setting string="Default Salesperson"
                                 help="All new leads from Google Form will be assigned to this person automatically.">
                            <field name="slc_default_salesperson_id" widget="many2one"/>
                        </setting>

                        <setting string="Outbound Webhook URL"
                                 help="POSTs lead data here when any lead is created or updated in Odoo.">
                            <field name="slc_outbound_webhook_url"
                                   placeholder="https://webhook.site/your-id"/>
                        </setting>

                        <setting string="Inbound Webhook Secret Token"
                                 help="If set, /webhook/google-form requires this value via the X-Webhook-Token header (or ?token= query param). Leave blank to keep the endpoint open.">
                            <field name="slc_webhook_secret_token"
                                   password="True"
                                   placeholder="leave blank for no auth"/>
                        </setting>

                        <!-- ── WhatsApp / Twilio ── -->
                        <setting string="Twilio Account SID"
                                 help="Get this from your Twilio dashboard.">
                            <field name="slc_twilio_account_sid"
                                   placeholder="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"/>
                        </setting>

                        <setting string="Twilio Auth Token">
                            <field name="slc_twilio_auth_token"
                                   password="True"
                                   placeholder="your_auth_token"/>
                        </setting>

                        <setting string="WhatsApp From Number"
                                 help="Twilio sandbox number. Keep as default unless you have a dedicated number.">
                            <field name="slc_twilio_whatsapp_from"
                                       placeholder="whatsapp:+14155238886"/>
                        </setting>

                        <setting string="WhatsApp Notify Number"
                                 help="Your WhatsApp number that receives lead notifications.">
                            <field name="slc_whatsapp_notify_number"
                                   placeholder="whatsapp:+919876543210"/>
                        </setting>

                    </block>

                </xpath>
            </field>
        </record>

    </data>
</odoo>