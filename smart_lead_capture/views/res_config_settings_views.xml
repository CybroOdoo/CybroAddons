<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Smart Lead Capture Configuration Settings
            Provides system-wide configuration options for:
            - Default lead assignment
            - Outbound webhook integration
            - Twilio WhatsApp notifications
        -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.smart.lead.capture</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='integration']" position="after">

                    <block title="Smart Lead Capture" name="smart_lead_capture">

                        <!-- ── Auto Assign Salesperson ── -->
                        <setting string="Default Salesperson"
                                 help="All new leads from Google Form will be assigned to this person automatically.">
                            <field name="slc_default_salesperson_id" widget="many2one"/>
                        </setting>

                        <!-- ── Outbound Webhook ── -->
                        <setting string="Outbound Webhook URL"
                                 help="POSTs lead data here when any lead is created or updated in Odoo.">
                            <field name="slc_outbound_webhook_url"
                                   placeholder="https://webhook.site/your-id"/>
                        </setting>

                        <!-- ── WhatsApp / Twilio ── -->
                        <setting string="Twilio Account SID"
                                 help="Get this from your Twilio dashboard.">
                            <field name="slc_twilio_account_sid"
                                   placeholder="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"/>
                        </setting>

                        <setting string="Twilio Auth Token">
                            <field name="slc_twilio_auth_token"
                                   password="True"
                                   placeholder="your_auth_token"/>
                        </setting>

                        <setting string="WhatsApp From Number"
                                 help="Twilio sandbox number. Keep as default unless you have a dedicated number.">
                            <field name="slc_twilio_whatsapp_from"
                                   placeholder="whatsapp:+14155238886"/>
                        </setting>

                        <setting string="WhatsApp Notify Number"
                                 help="Your WhatsApp number that receives lead notifications.">
                            <field name="slc_whatsapp_notify_number"
                                   placeholder="whatsapp:+919876543210"/>
                        </setting>

                    </block>

                </xpath>
            </field>
        </record>

    </data>
</odoo>