<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_compute_bill_form" model="ir.ui.view">
        <field name="name">compute.bill.form</field>
        <field name="model">compute.bill</field>
        <field name="arch" type="xml">
            <form string="Compute Bill">
                <sheet>
                    <group string="FOLIO DETAILS">
                        <group>
                            <field name="booking_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Room Details" invisible="not room_line_ids">
                            <field name="room_line_ids" readonly="1">
                                <tree>
                                    <field name="room_id"/>
                                    <field name="checkin_date"/>
                                    <field name="checkout_date"/>
                                    <field name="uom_qty" string="Duration"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Food Details" invisible="not food_line_ids">
                            <field name="food_line_ids" readonly="1">
                                <tree>
                                    <field name="food_id"/>
                                    <field name="uom_qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Other Services" invisible="not service_line_ids and not fleet_line_ids and not event_line_ids">
                            <group string="Services" invisible="not service_line_ids">
                                <field name="service_line_ids" nolabel="1" readonly="1">
                                    <tree>
                                        <field name="service_id"/>
                                        <field name="uom_qty"/>
                                        <field name="price_unit"/>
                                        <field name="price_subtotal" sum="Total"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="Fleet" invisible="not fleet_line_ids">
                                <field name="fleet_line_ids" nolabel="1" readonly="1">
                                    <tree>
                                        <field name="fleet_id"/>
                                        <field name="uom_qty"/>
                                        <field name="price_unit"/>
                                        <field name="price_subtotal" sum="Total"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="Event" invisible="not event_line_ids">
                                <field name="event_line_ids" nolabel="1" readonly="1">
                                    <tree>
                                        <field name="event_id"/>
                                        <field name="uom_qty"/>
                                        <field name="price_unit"/>
                                        <field name="price_subtotal" sum="Total"/>
                                    </tree>
                                </field>
                            </group>
                        </page>
                        <page string="POS ORDERS">
                            <field name="pos_order_ids" nolabel="1">
                                <tree>
                                    <field name="pos_reference" string="Order Ref"/>
                                    <field name="session_id" string="Session"/>
                                    <field name="date_order" string="Date"/>
                                    <field name="partner_id" string="Customer"/>
                                    <field name="user_id" string="Cashier" widget="many2one_avatar_user"/>
                                    <field name="amount_total" string="Total" sum="Total" widget="monetary"/>
                                    <field name="state" string="Status" widget="badge" decoration-success="state in ('paid', 'invoiced', 'done')"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    
                    <group>
                        <field name="bill_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_bill" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
