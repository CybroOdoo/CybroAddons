<?xml version="1.0" encoding="utf-8"?>
<!-- Popup for selecting a room booking and viewing its details -->
<templates id="template" xml:space="preserve">
    <t t-name="hotel_pos_extension.HotelRoomPopup">
        <div class="popup hotel-room-popup">
            <div class="modal-header drag-handle">
                <h4 class="modal-title"><t t-esc="props.title"/></h4>
            </div>
            <div class="p-3">
                <div class="mb-3">
                    <label class="form-label">Room No</label>
                    <select class="form-control" t-on-change="onBookingChange">
                        <t t-foreach="props.bookings" t-as="booking" t-key="booking.id">
                            <option t-att-value="booking.id"><t t-esc="booking.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Booking No</label>
                    <input type="text" class="form-control"
                           t-att-value="state.selectedBooking ? state.selectedBooking.name : ''"
                           readonly="1"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Booking Customer</label>
                    <input type="text" class="form-control"
                           t-att-value="state.selectedBooking ? state.selectedBooking.partner_id[1] : ''"
                           readonly="1"/>
                </div>
            </div>
            <footer class="footer modal-footer">
                <button class="btn btn-lg btn-secondary" t-on-click="cancel">Close</button>
                <button class="btn btn-lg btn-primary" t-on-click="confirm">Confirm</button>
            </footer>
        </div>
    </t>
</templates>
