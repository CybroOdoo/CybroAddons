<?xml version="1.0" encoding="utf-8"?>
<!-- Adds a room selection button to the POS product screen -->
<templates id="template" xml:space="preserve">
    <t t-name="hotel_pos_extension.HotelRoomSelectionButton">
        <button class="room-selection-button btn btn-secondary btn-lg lh-lg text-truncate w-auto"
                t-on-click="click">
            <i class="fa fa-bed me-2" role="img" aria-label="Room" title="Room"/>
            <t t-esc="currentBookingName"/>
        </button>
    </t>
</templates>
