<?xml version="1.0" encoding="UTF-8"?>
<!-- Extends POS receipt to display room details for hotel charge payments -->
<templates id="template" xml:space="preserve">
    <t t-name="hotel_pos_extension.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentlines')]//t[@t-esc='line.payment_method_id.name']" position="after">
            <t t-if="line.payment_method_id.is_hotel_charge and order.uiState.roomName">
                (Room: <t t-esc="order.uiState.roomName"/>)
            </t>
        </xpath>
    </t>
</templates>
