<?xml version="1.0" encoding="UTF-8"?>
<!-- Extends POS receipt to display room details for hotel charge payments -->
<templates id="template" xml:space="preserve">
    <t t-name="hotel_pos_extension.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentlines')]/t[@t-esc='line.name']" position="after">
            <t t-if="line.is_hotel_charge and props.data.room_name">
                (Room: <t t-esc="props.data.room_name"/>)
            </t>
        </xpath>
    </t>
</templates>

