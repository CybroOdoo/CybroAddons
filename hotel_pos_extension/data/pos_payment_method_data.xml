<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Creates a POS payment method named "Pay at Checkout" for hotel charges,
         allowing customers to pay later during checkout without immediate journal entry -->
        <record id="pos_payment_method_pay_at_checkout" model="pos.payment.method">
            <field name="name">Pay at Checkout</field>
            <field name="is_hotel_charge">True</field>
            <!-- No journal_id means it's a "Customer Account" type in Odoo -->
            <field name="journal_id" eval="False"/>
        </record>
    </data>
</odoo>
