<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Report template -->
    <template id="progress_billing_report_progress_billing">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="data">
                <t t-call="web.external_layout">
                    <div class="page">
                        <span style="font-size:35px;">
                            <strong>
                                <t t-out="data.name"/>
                            </strong>
                        </span>
                        <p t-if="data.partner_id">Customer :
                            <t t-out="data.partner_id.name"/>
                        </p>
                        <p t-if="data.project_id">Progress Bill :
                            <t t-out="data.project_id.name"/>
                        </p>
                        <p t-if="data.invoice_date">Progress Bill Date :
                            <t t-out="data.invoice_date"/>
                        </p>
                        <br/>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th style="min-width: 150px">Product</th>
                                    <th style="min-width: 150px">Quantity</th>
                                    <th style="min-width: 150px">Unit Price</th>
                                    <th style="min-width: 150px">Taxes</th>
                                    <th style="min-width: 150px">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data.invoice_line_ids" t-as="rec">
                                    <td>
                                        <t t-out="rec.product_id.name or rec.name"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.quantity"/>
                                    </td>
                                    <td>
                                        <span t-field="rec.price_unit"/>
                                    </td>
                                    <td>
                                        <t t-out="', '.join(rec.tax_ids.mapped('name'))"/>
                                    </td>
                                    <td>
                                        <span t-field="rec.price_subtotal"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="clearfix">
                            <div class="float-end" style="font-size:20px;">
                                <strong>Total: </strong>
                                <span t-field="data.amount_total"/>
                            </div>
                        </div>
                        <br/>
                        <br/>
                        <span style="font-size:20px;">Progress Billing Information</span>
                        <table class="table table-bordered"
                               style="border: 3px solid black;">
                            <tr style="border: 3px solid black;">
                                <th style="min-width: 150px">Total Progress Billing</th>
                                <td style="min-width: 150px">
                                    <span t-field="data.total_progress_billing"
                                          t-options="{'widget': 'monetary', 'display_currency': data.currency_id}"/>
                                </td>
                                <th style="min-width: 150px">Previously Invoiced</th>
                                <td style="min-width: 150px">
                                    <span t-field="data.previously_invoice"
                                          t-options="{'widget': 'monetary', 'display_currency': data.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="border: 3px solid black;">
                                <th style="min-width: 150px">Invoice To Date</th>
                                <td style="min-width: 150px">
                                    <span t-field="data.invoice_to_date"
                                          t-options="{'widget': 'monetary', 'display_currency': data.currency_id}"/>
                                </td>
                                <th style="min-width: 150px">Previously Invoiced Due</th>
                                <td style="min-width: 150px">
                                    <span t-field="data.previously_invoice_due"
                                          t-options="{'widget': 'monetary', 'display_currency': data.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="border: 3px solid black;">
                                <th style="min-width: 150px">Remaining Progress Billing</th>
                                <td style="min-width: 150px">
                                    <span t-field="data.remaining_progress_billing"
                                          t-options="{'widget': 'monetary', 'display_currency': data.currency_id}"/>
                                </td>
                                <th style="min-width: 150px">Current Invoiced</th>
                                <td style="min-width: 150px">
                                    <span t-field="data.current_invoice"
                                          t-options="{'widget': 'monetary', 'display_currency': data.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="border: 3px solid black;">
                                <th style="min-width: 150px"/>
                                <td style="min-width: 150px"/>
                                <th style="min-width: 150px">Less Paid Amount</th>
                                <td style="min-width: 150px">
                                    <span t-field="data.less_paid_amount"
                                          t-options="{'widget': 'monetary', 'display_currency': data.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="border: 3px solid black;">
                                <th style="min-width: 150px"/>
                                <td style="min-width: 150px"/>
                                <th style="min-width: 150px">Total Due Amount</th>
                                <td style="min-width: 150px">
                                    <span t-field="data.total_due"
                                          t-options="{'widget': 'monetary', 'display_currency': data.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
