<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security groups for SCADA Integration -->
    <data>
        <record id="group_scada_user" model="res.groups">
            <field name="name">SCADA User</field>
            <field name="privilege_id" ref="oil_erp_base.res_groups_privilege_oil"/>
            <field name="comment">Can view SCADA tags and readings.</field>
        </record>

        <record id="group_scada_manager" model="res.groups">
            <field name="name">SCADA Manager</field>
            <field name="privilege_id" ref="oil_erp_base.res_groups_privilege_oil"/>
            <field name="implied_ids" eval="[(4, ref('group_scada_user'))]"/>
            <field name="comment">Can configure SCADA tags, thresholds and the API key.</field>
        </record>
    </data>
</odoo>
