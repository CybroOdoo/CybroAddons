<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Per-tag retention policy — runs daily -->
        <record id="cron_purge_scada_readings_per_tag" model="ir.cron">
            <field name="name">SCADA: Per-Tag Data Retention Purge</field>
            <field name="model_id" ref="model_scada_tag"/>
            <field name="state">code</field>
            <field name="code">model.cron_purge_all_readings()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Global fallback: Purge readings older than 90 days — runs weekly -->
        <record id="cron_purge_scada_readings" model="ir.cron">
            <field name="name">SCADA: Global Purge (90 Days)</field>
            <field name="model_id" ref="model_scada_reading"/>
            <field name="state">code</field>
            <field name="code">model.purge_old_readings(days=90)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <!-- Midnight: auto-create daily production reports from SCADA readings -->
        <record id="cron_daily_production_from_scada" model="ir.cron">
            <field name="name">SCADA: Auto-create Daily Production Reports</field>
            <field name="model_id" ref="model_oil_daily_production"/>
            <field name="state">code</field>
            <field name="code">model.auto_create_daily_production()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).replace(hour=0, minute=5, second=0)"/>
        </record>
    </data>
</odoo>

