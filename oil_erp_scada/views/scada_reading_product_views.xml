<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── List ──────────────────────────────────────────────────── -->
    <record id="view_scada_reading_product_list" model="ir.ui.view">
        <field name="name">scada.reading.product.list</field>
        <field name="model">scada.reading.product</field>
        <field name="arch" type="xml">
            <list string="SCADA Production Logs" create="false" edit="false">
                <!-- Keep reading_id but hide it -->
                <field name="reading_id" column_invisible="1"/>

                <!-- Display related fields for context -->
                <field name="timestamp"/>
                <field name="tag_id" optional="show"/>
                <field name="product_id"/>
                <field name="produced_qty"/>
            </list>
        </field>
    </record>

    <!-- ── Search ────────────────────────────────────────────────── -->
    <record id="view_scada_reading_product_search" model="ir.ui.view">
        <field name="name">scada.reading.product.search</field>
        <field name="model">scada.reading.product</field>
        <field name="arch" type="xml">
            <search string="Search Production Logs">
                <!-- Swapped reading_id for tag and timestamp searching -->
                <field name="timestamp"/>
                <field name="tag_id"/>
                <field name="product_id"/>

                <filter string="Product" name="group_by_product" context="{'group_by':'product_id'}"/>
                <filter string="Date" name="group_by_date" context="{'group_by':'timestamp:day'}"/>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────── -->
    <record id="action_scada_reading_product" model="ir.actions.act_window">
        <field name="name">Production Logs</field>
        <field name="res_model">scada.reading.product</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_scada_reading_product"
              name="Production Logs"
              parent="menu_scada_live"
              action="action_scada_reading_product"
              sequence="25"/>
</odoo>
