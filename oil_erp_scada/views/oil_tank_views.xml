<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Storage Location (ATG) List ──────────────────────────────── -->
    <record id="view_storage_location_atg_list" model="ir.ui.view">
        <field name="name">stock.location.atg.list</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <list string="Storage Locations"
                  decoration-danger="fill_percent &gt;= 95 or (low_low_level_mm and current_level_mm &lt;= low_low_level_mm and current_level_mm &gt; 0)"
                  decoration-warning="fill_percent &gt;= 85 or (low_level_mm and current_level_mm &lt;= low_level_mm and current_level_mm &gt; 0)">
                <field name="complete_name" string="Location"/>
                <field name="tank_type_id" optional="show"/>
                <field name="product_type_id" optional="show"/>
                <field name="tank_project_id" string="Project" optional="show"/>
                <field name="current_level_mm" string="Level (mm)" optional="show"/>
                <field name="gross_volume_bbl" string="Gross Vol (bbl)" optional="show"/>
                <field name="fill_percent" string="Fill %" widget="progressbar" optional="show"/>
                <field name="tank_state" widget="badge"
                       decoration-info="tank_state == 'loading'"
                       decoration-warning="tank_state == 'unloading'"
                       decoration-danger="tank_state == 'full'"
                       optional="show"/>
                <field name="last_scada_sync" optional="show"/>
                <field name="is_storage_tank" invisible="1"/>
                <field name="low_level_mm" column_invisible="1"/>
                <field name="low_low_level_mm" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Storage Location (ATG) Form ──────────────────────────────── -->
    <record id="view_storage_location_atg_form" model="ir.ui.view">
        <field name="name">stock.location.atg.form</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <form string="Storage Location">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_scada_tags" type="object"
                                class="oe_stat_button" icon="fa-signal"
                                invisible="not is_storage_tank">
                            <field name="tank_scada_tag_count" widget="statinfo" string="SCADA Tags"/>
                        </button>
                        <button name="action_view_readings" type="object"
                                class="oe_stat_button" icon="fa-tachometer"
                                invisible="not is_storage_tank">
                            <span class="o_stat_text">Readings</span>
                        </button>
                        <button name="action_view_products" type="object"
                                class="oe_stat_button" icon="fa-cubes"
                                invisible="not is_storage_tank">
                            <span class="o_stat_text">Products</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="location_id" string="Parent Location"/>
                            <field name="usage"/>
                            <field name="tank_project_id" string="Project"/>
                            <field name="tank_company_id" string="Company"
                                   groups="base.group_multi_company"/>
                            <field name="is_storage_tank" widget="boolean_toggle"/>
                        </group>
                        <group string="Live SCADA Values" invisible="not is_storage_tank">
                            <field name="tank_state" widget="badge"
                                   decoration-info="tank_state == 'loading'"
                                   decoration-warning="tank_state == 'unloading'"
                                   decoration-danger="tank_state == 'full'"/>
                            <field name="current_level_mm" readonly="1"/>
                            <field name="current_temperature_f" readonly="1"/>
                            <field name="gross_volume_bbl" readonly="1"/>
                            <field name="net_standard_volume_bbl" readonly="1"/>
                            <field name="ullage_bbl" readonly="1"/>
                            <field name="fill_percent" readonly="1" widget="progressbar"/>
                            <field name="last_scada_sync" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="not is_storage_tank">
                        <group string="Type &amp; Product">
                            <field name="tank_type_id"/>
                            <field name="product_type_id"/>
                        </group>
                        <group string="Alarm Levels" invisible="not is_storage_tank">
                            <field name="high_high_level_mm"/>
                            <field name="high_level_mm"/>
                            <field name="low_level_mm"/>
                            <field name="low_low_level_mm"/>
                        </group>
                        <group string="Tank Geometry">
                            <field name="diameter_m"/>
                            <field name="shell_height_mm"/>
                            <field name="max_capacity_bbl"/>
                            <field name="bbl_per_mm"/>
                            <field name="base_temperature_f"/>
                            <field name="expansion_coeff"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action: filtered to is_storage_tank = True ───────────────── -->
    <record id="action_storage_location_atg" model="ir.actions.act_window">
        <field name="name">Storage Locations</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_storage_tank', '=', True)]</field>
        <field name="context">{'default_is_storage_tank': True, 'default_usage': 'internal'}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_storage_location_atg_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_storage_location_atg_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No storage locations with ATG enabled yet
            </p>
            <p>
                Enable "Is Storage Tank / ATG" on a stock location to track
                SCADA-driven level readings, volume calculations, and alarms.
            </p>
        </field>
    </record>

    <menuitem id="menu_storage_location_atg"
              name="Storage Locations"
              parent="menu_scada_live"
              action="action_storage_location_atg"
              sequence="30"/>
</odoo>
