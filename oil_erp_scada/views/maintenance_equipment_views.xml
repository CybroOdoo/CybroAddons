<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inject SCADA smart buttons into the equipment form -->
    <record id="view_equipment_form_scada" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.scada</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="oil_erp_equipment.maintenance_equipment_view_form_inherit_oil"/>
        <field name="arch" type="xml">
            <!-- Smart buttons -->
            <div name="button_box" position="inside">
                <button name="action_view_readings" type="object"
                        class="oe_stat_button" icon="fa-tachometer"
                        invisible="not is_oil_equipment">
                    <span class="o_stat_text">Readings</span>
                </button>
            </div>

            <xpath expr="//field[@name='well_site_ids']" position="after">
                <field name="scada_tag_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"/>
            </xpath>

            <!-- Inject live values after the Operating Parameters group -->
            <field name="operating_pressure" position="after">
                <field name="scada_tag_ids" widget="many2many_tags"/>
            </field>
            <field name="operating_temperature" position="after">
                <field name="live_temperature" readonly="1"
                       invisible="not is_oil_equipment"/>
            </field>
            <field name="last_inspection_date" position="after">
                <field name="last_scada_sync" readonly="1"
                       invisible="not is_oil_equipment"/>
            </field>
        </field>
    </record>
</odoo>
