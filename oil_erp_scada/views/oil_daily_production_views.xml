<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oil_daily_prod_list" model="ir.ui.view">
        <field name="name">oil.daily.production.list</field>
        <field name="model">oil.daily.production</field>
        <field name="arch" type="xml">
            <list string="Daily Production">
                <field name="name"/>
                <field name="report_date"/>
                <field name="tag_id"/>
                <field name="project_id"/>
                <field name="well_id"/>
                <field name="lease_id"/>
                <field name="storage_location_id"/>
                <field name="picking_id"/>
                <field name="source"/>
            </list>
        </field>
    </record>

    <record id="view_oil_daily_prod_form" model="ir.ui.view">
        <field name="name">oil.daily.production.form</field>
        <field name="model">oil.daily.production</field>
        <field name="arch" type="xml">
            <form string="Daily Production Report">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lease_royalties" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not lease_id">
                            <field name="lease_royalty_count" widget="statinfo"
                                   string="Royalties"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Source &amp; Date">
                            <field name="report_date"/>
                            <field name="tag_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="well_id"/>
                            <field name="lease_id"/>
                            <field name="storage_location_id"
                                   domain="[('is_storage_tank', '=', True)]"/>
                            <field name="picking_id" readonly="1"/>
                            <field name="source"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Production Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="produced_qty"/>
                                    <field name="uom_id"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_oil_daily_production" model="ir.actions.act_window">
        <field name="name">Daily Production</field>
        <field name="res_model">oil.daily.production</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_oil_daily_production"
              name="Daily Production Reports"
              parent="menu_scada_pra"
              action="action_oil_daily_production"
              sequence="10"/>
</odoo>
