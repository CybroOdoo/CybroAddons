<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oil_reservoir_form_inherit_scada" model="ir.ui.view">
        <field name="name">project.project.form.inherit.scada</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_scada_tags" type="object"
                        class="oe_stat_button" icon="fa-signal">
                    <field name="scada_tag_count" widget="statinfo" string="SCADA Tags"/>
                </button>
                <button name="action_view_readings" type="object"
                        class="oe_stat_button" icon="fa-tachometer">
                    <span class="o_stat_text">Readings</span>
                </button>
            </div>
        </field>
    </record>
</odoo>
