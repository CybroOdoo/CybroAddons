<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_scada" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.scada</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="oil_erp_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='oil_scada_integration_setting']//div[hasclass('o_eia_api_key_section')]" position="inside">
                <div class="o_eia_api_key_field_group"
                     invisible="not module_oil_erp_scada">
                    <div class="o_eia_api_key_label">
                        SCADA API Key:
                    </div>
                    <field name="scada_api_key" password="True"/>
                </div>
                <div class="text-muted" invisible="not module_oil_erp_scada">
                    This key must match the 'api_key' sent in JSON payloads from Ignition SCADA.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
