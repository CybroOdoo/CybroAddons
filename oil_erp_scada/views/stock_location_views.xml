<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the standard stock location form to add the ATG toggle and a
         summary panel when the location is marked as a storage tank. -->
    <record id="view_location_form_atg" model="ir.ui.view">
        <field name="name">stock.location.form.atg</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <!-- Tank alert banner -->
                <div class="alert alert-danger" role="alert"
                     invisible="not (is_storage_tank and tank_state in ('full', 'loading'))"
                     style="margin-bottom: 0px;">
                    <strong>Storage Tank Alert:</strong>
                    <field name="tank_state" widget="badge"
                           decoration-info="tank_state == 'loading'"
                           decoration-danger="tank_state == 'full'"/>
                    — Level: <field name="current_level_mm" class="oe_inline"/> mm
                    | Fill: <field name="fill_percent" class="oe_inline"/>%
                </div>
            </xpath>
            <!-- Add the ATG toggle after the location type (usage) field -->
            <field name="usage" position="after">
                <field name="is_storage_tank" widget="boolean_toggle"
                       string="Is Storage Tank / ATG"/>
            </field>
        </field>
    </record>

    <!-- Inherit the standard stock location list to show ATG status badge -->
    <record id="view_location_tree_atg" model="ir.ui.view">
        <field name="name">stock.location.list.atg</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="is_storage_tank" invisible="1"/>
                <field name="tank_state" widget="badge"
                       decoration-info="tank_state == 'loading'"
                       decoration-warning="tank_state == 'unloading'"
                       decoration-danger="tank_state == 'full'"
                       invisible="not is_storage_tank"
                       optional="show"/>
                <field name="fill_percent" string="Fill %"
                       invisible="not is_storage_tank"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
