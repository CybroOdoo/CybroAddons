<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scada_threshold_list" model="ir.ui.view">
        <field name="name">scada.threshold.list</field>
        <field name="model">scada.threshold</field>
        <field name="arch" type="xml">
            <list string="Alert Thresholds"
                  editable="bottom"
                  decoration-danger="severity in ('high','critical')"
                  decoration-warning="severity == 'medium'">
                <field name="name"/>
                <field name="tag_id"/>
                <field name="applies_to" optional="show"
                       decoration-muted="applies_to == 'any'"/>
                <field name="operator"/>
                <field name="threshold_value"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity in ('high','critical')"
                       decoration-warning="severity == 'medium'"
                       decoration-info="severity == 'low'"/>
                <field name="action"/>
                <field name="cooldown_minutes"/>
                <field name="last_triggered"/>
                <field name="trigger_count"/>
                <field name="send_sms" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_scada_threshold" model="ir.actions.act_window">
        <field name="name">Alert Thresholds</field>
        <field name="res_model">scada.threshold</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new alert threshold
            </p>
            <p>
                Define rules to automatically create maintenance requests or HSE incidents
                when SCADA sensors exceed safe limits.
            </p>
        </field>
    </record>

    <menuitem id="menu_scada_thresholds"
              name="Alert Thresholds"
              parent="menu_scada_config"
              action="action_scada_threshold"
              sequence="10"/>
</odoo>
