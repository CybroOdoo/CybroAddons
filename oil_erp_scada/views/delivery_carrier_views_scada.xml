<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_inherit_scada" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.scada</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="oil_erp_pipeline.view_delivery_carrier_form_inherit_oil_erp_pipeline"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_scada_tags" type="object"
                        class="oe_stat_button" icon="fa-signal"
                        invisible="not is_oil_gas_pipeline">
                    <field name="scada_tag_count" widget="statinfo" string="SCADA Tags"/>
                </button>
                <button name="action_view_readings" type="object"
                        class="oe_stat_button" icon="fa-tachometer"
                        invisible="not is_oil_gas_pipeline">
                    <span class="o_stat_text">Readings</span>
                </button>
            </div>
        </field>
    </record>
</odoo>
