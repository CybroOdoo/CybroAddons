<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scada_reading_wizard_form" model="ir.ui.view">
        <field name="name">scada.reading.wizard.form</field>
        <field name="model">scada.reading.wizard</field>
        <field name="arch" type="xml">
            <form string="Simulate SCADA Reading">
                <group>
                    <group>
                        <field name="tag_id" readonly="1"/>
                        <field name="quality"/>
                        <field name="timestamp"/>
                    </group>
                    <group>
                        <field name="is_production_tag" invisible="1"/>
                        <field name="measure_pressure" invisible="1"/>
                        <field name="measure_temperature" invisible="1"/>
                        <field name="measure_flow_rate" invisible="1"/>
                        <field name="measure_level" invisible="1"/>
                        <field name="measure_gas_ppm" invisible="1"/>
                        <field name="measure_vibration" invisible="1"/>
                        <field name="measure_valve_position" invisible="1"/>
                        <field name="measure_cumulative" invisible="1"/>
                        <field name="measure_other" invisible="1"/>
                    </group>
                </group>
                <group string="Measurements">
                    <field name="val_pressure" invisible="not measure_pressure"/>
                    <field name="val_temperature" invisible="not measure_temperature"/>
                    <field name="val_flow_rate" invisible="not measure_flow_rate"/>
                    <field name="val_level" invisible="not measure_level"/>
                    <field name="val_gas_ppm" invisible="not measure_gas_ppm"/>
                    <field name="val_vibration" invisible="not measure_vibration"/>
                    <field name="val_valve_position" invisible="not measure_valve_position"/>
                    <field name="val_cumulative" invisible="not measure_cumulative"/>
                    <field name="val_other" invisible="not measure_other"/>
                </group>
                <group invisible="not is_production_tag">
                    <notebook>
                        <page string="Production Line">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom" create="false">
                                    <field name="product_id"/>
                                    <field name="scada_key"/>
                                    <field name="produced_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </group>
                <footer>
                    <button name="action_confirm" string="Process Reading"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
