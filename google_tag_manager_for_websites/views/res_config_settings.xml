<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='google_analytics_setting']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="google_tag_manager"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="google_tag_manager" string="Google Tag Manager"/>
                         <div class="text-muted">
                                <span searchabletext="Track visits using  Google Tag Manager"> Track visits using Google Tag Manager</span>
                        </div>
                        <div class="content-group" invisible="not google_tag_manager">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" for="container_id"/>
                                <field name="container_id"
                                       required="google_tag_manager"
                                       placeholder="GTM-XXXXXXX or G-XXXXXXXXXX"/>
                            </div>
                            <!-- 🔗 Odoo-style green link with arrow -->
                            <div class="mt8">
                                <i class="fa pe-1 oi oi-arrow-right" style="color:#017e84;font-weight:400;"/>
                                <a href="https://tagmanager.google.com"
                                   target="_blank"
                                    style="color:#017e84;font-weight:400;">
                                    Google Tag Manager
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
