<?xml version="1.0" encoding="UTF-8"?>
<!-- Displays Instagram posts in a carousel format -->
<templates id="template" xml:space="preserve">
    <t t-name="insta_feed_snippet.instagram_carousel_template">
        <div class="position-relative px-3">
            <!-- Use unique_id with t-attf-id syntax like auction snippet -->
            <div class="carousel carousel-dark slide"
                 t-attf-id="instaCarousel_{{unique_id}}"
                 data-bs-ride="carousel">
                <div class="carousel-inner">
                    <t t-foreach="chunks" t-as="chunk" t-key="chunk_index">
                        <div t-att-class="chunk.is_active ? 'carousel-item active' : 'carousel-item'">
                            <div class="container">
                                <div class="row justify-content-center">
                                    <t t-foreach="chunk" t-as="post" t-key="post_index">
                                        <div class="col-lg-4 col-md-4 col-sm-6 mb-3 px-2">
                                            <a t-attf-href="https://www.instagram.com/{{post.profile_username}}/"
                                               target="_blank"
                                               class="text-decoration-none d-block h-100">
                                                <div class="card h-100 shadow-sm hover-lift">
                                                    <!-- Post Image -->
                                                    <t t-if="post.has_image">
                                                        <img class="card-img-top"
                                                             t-attf-src="/web/image/insta.post/{{post.id}}/post_image"
                                                             alt="Instagram Post"
                                                             style="height: 280px; object-fit: cover;"/>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                                             style="height: 280px;">
                                                            <i class="fa fa-instagram fa-4x text-muted"></i>
                                                        </div>
                                                    </t>

                                                    <!-- Card body with caption -->
                                                    <div class="card-body">
                                                        <p class="card-text small text-muted mb-2"
                                                           style="height: 60px; overflow: hidden; text-overflow: ellipsis;">
                                                            <t t-if="post.caption">
                                                                <t t-out="post.caption.substring(0, 100)"/>
                                                                <t t-if="post.caption.length > 100">...</t>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="text-muted fst-italic">No caption</span>
                                                            </t>
                                                        </p>
                                                        <div class="text-center">
                                                            <small class="text-primary fw-bold">
                                                                <i class="fa fa-instagram"></i>
                                                                @<t t-out="post.profile_username"/>
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Navigation Arrows -->
                <t t-if="chunks.length &gt; 1">
                    <button t-attf-data-bs-target="#instaCarousel_{{unique_id}}"
                            class="carousel-control-prev o_not_editable"
                            data-bs-slide="prev"
                            type="button"
                            aria-label="Previous">
                        <span class="d-flex align-items-center justify-content-center rounded-circle bg-dark text-white shadow-sm"
                              style="width: 42px; height: 42px;">
                            <i class="oi fs-5" data-icon="chevron_left"/>
                        </span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button t-attf-data-bs-target="#instaCarousel_{{unique_id}}"
                            class="carousel-control-next o_not_editable"
                            data-bs-slide="next"
                            type="button"
                            aria-label="Next">
                        <span class="d-flex align-items-center justify-content-center rounded-circle bg-dark text-white shadow-sm"
                              style="width: 42px; height: 42px;">
                            <i class="oi fs-5" data-icon="chevron_right"/>
                        </span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </t>
            </div>
        </div>
    </t>
</templates>