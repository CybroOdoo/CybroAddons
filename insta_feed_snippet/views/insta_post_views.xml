<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Insta Post Kanban View-->
    <record id="instagram_post_view_kanban" model="ir.ui.view">
        <field name="name">insta.post.view.kanban</field>
        <field name="model">insta.post</field>
        <field name="arch" type="xml">
            <kanban sample="1" create="false">
                <field name="caption"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click" style="min-height: 110px;">
                            <div class="mr-1" style="width: 100px !important; height: 100px !important; min-width: 100px !important; min-height: 100px !important; overflow: hidden !important; display: flex !important; align-items: center !important; justify-content: center !important; border-radius: 6px !important; float: left;">

                                <field name="post_image" widget="image" options="{'size': [100, 100]}" class="h-100 w-100" style="object-fit: cover !important; width: 100% !important; height: 100% !important;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="caption"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- Insta Post Form View-->
    <record id="instagram_post_view_form" model="ir.ui.view">
        <field name="name">insta.post.view.form</field>
        <field name="model">insta.post</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet clas="bg-primary">
                    <div class="row o_website_sale_image_modal"
                         style="display:flex;justify-content: center;">
                        <div class="col-md-6 col-xl-5">
                            <h2>
                                <field name="name" invisible="1"/>
                                <field name="profile_id" invisible="1"/>
                                <field name="caption"
                                       style="word-break: break-all;"/>
                                <field name="post_image" widget="image"/>
                            </h2>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Insta Post Tree View-->
    <record id="instagram_post_view_tree" model="ir.ui.view">
        <field name="name">insta.post.view.tree</field>
        <field name="model">insta.post</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!-- Insta Post Search View-->
    <record id="insta_post_view_search" model="ir.ui.view">
        <field name="name">insta.post.view.search</field>
        <field name="model">insta.post</field>
        <field name="arch" type="xml">
            <search>
                <field name="caption"/>
            </search>
        </field>
    </record>
     <!-- Insta Feed Menu action-->
    <record id="action_insta_posts" model="ir.actions.act_window">
        <field name="name">Instagram Posts</field>
        <field name="res_model">insta.post</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <!-- Insta Feed Menu-->
    <menuitem id="insta_posts"
              name="Instagram Post"
              sequence="10"
              action="action_insta_posts"
              parent="website.menu_site"/>
</odoo>
