<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Main snippet template -->
    <template id="s_carousel_template" name="Instagram Feed Carousel">
        <section class="s_carousel_template pt32 pb32">
            <div class="container">
                <h3 class="text-center mb-4">Follow Us On Instagram</h3>
                <div id="instagram_carousel_container"/>
            </div>
        </section>
    </template>

    <!-- Register snippet in website builder -->
    <template id="instagram_snippet_register" inherit_id="website.snippets" name="Insta Snippet">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="insta_feed_snippet.s_carousel_template"
               t-thumbnail="/insta_feed_snippet/static/src/image/insta.png"/>
        </xpath>
    </template>
</odoo>