<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!--        Schedule action for work progress -->
        <record id="ir_cron_scheduler_car_workshop_action" model="ir.cron">
            <field name="name">Car Workshop: Work Progress Scheduler</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="model_id" ref="fleet_car_workshop.model_car_workshop"/>
            <field name="state">code</field>
            <field name="code">model.process_demo_scheduler_queue()</field>
        </record>
    </data>
</odoo>
