<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view"
            model="ir.ui.view">
        <field name="name">
            product.template.view.form.inherit.product.image.suggestion
        </field>
        <field name="model">product.template</field>
        <field name="inherit_id"
               ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[last()]" position="inside">
                <page string="Image Suggestion">
                    <group>
                        <group>
                            <field name="image_limit"/>
                            <field name="resize_image"/>
                        </group>
                        <group>
                            <div class="o_row d-flex align-items-center">
                                <field name="search_field"
                                       placeholder="Search here..."
                                       nolabel="1"
                                       style="width: 220px;"/>
                                 <button name="action_search_image"
                                        type="object"
                                        icon="search"
                                        class="btn btn-primary ms-1"
                                        title="Search Image"/>
                            </div>
                        </group>
                    </group>
                    <!-- Kanban view to show the images downloaded -->
                    <field name="search_image_ids" mode="kanban"
                           context="{'default_name': name}">
                        <kanban string="Suggested Images">
                            <field name="id"/>
                            <field name="image"/>
                            <templates>
                                <t t-name="card" class="d-flex flex-row align-items-center justify-content-between p-3 position-relative" style="min-height: 110px;">
                                    <a type="delete"
                                       class="position-absolute top-0 start-0 m-2"
                                       title="Delete"
                                       aria-label="Delete"
                                       style="cursor: pointer; z-index: 10;">
                                        <i class="oi" data-icon="close"/>
                                    </a>
                                    <div class="d-flex align-items-center justify-content-center ms-3" style="width: 120px; height: 90px;">
                                        <img t-if="record.image.raw_value"
                                             t-att-src="'/web/image/product.image.suggestion/' + record.id.raw_value + '/image'"
                                             alt="Product"
                                             style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 4px;"/>
                                    </div>
                                    <div class="ms-auto">
                                        <button name="action_set_image"
                                                string="Set Image"
                                                class="btn btn-primary text-nowrap px-3 py-1"
                                                type="object">
                                            Set Image
                                        </button>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
