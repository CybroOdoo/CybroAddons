<?xml version="1.0" encoding="UTF-8" ?>
<!--Product tab content template-->
<templates xml:space="preserve">
   <t t-name="theme_lego.lego_deals">
       <section class="categories_section">
           <t t-if="result.length == 0">
                <div class="col-lg-9 col-12 d-flex align-items-center justify-content-center">
                    <span class="text-center" style="font-size: 1.5rem; font-weight: 500; opacity: 0.6;">
                        We're out of deals for now — but fresh ones are on the way. Stay tuned!
                    </span>
                </div>
            </t>
           <t t-else="">
                <div class="col-12">
                    <div class="row g-3">
                        <t t-foreach="result" t-as="product_id" t-key="product_id.id">
                            <div class="col-lg-4 col-md-6 col-sm-12">
                                <div class="card h-100 shadow-sm">

                                    <a t-attf-href="/shop/product/{{ product_id.id }}" class="text-decoration-none text-dark">
                                        <img
                                            t-attf-src="/web/image?model=product.template&amp;field=image_1920&amp;id=#{product_id.id}"
                                            class="card-img-top img-fluid"
                                            alt="Product Image"
                                        />

                                        <div class="card-body">
                                            <h6 class="card-title mb-1">
                                                <t t-esc="product_id.display_name"/>
                                            </h6>
                                            <p class="fw-bold text-primary mb-0">
                                                <span>$</span>
                                                <t t-esc="product_id.list_price"/>
                                            </p>
                                        </div>
                                    </a>

                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
       </section>
   </t>
</templates>

