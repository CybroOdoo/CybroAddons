<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website Snippet templates -->
    <template id="lego_banner" inherit_id="website.snippets" name="Banner">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="Banner" t-snippet="theme_lego.banner"
            t-thumbnail="/theme_lego/static/src/img/snippets/home-banner-blockt.jpg"/>
            <t snippet-group="Contact" t-snippet="theme_lego.contact"
            t-thumbnail="/theme_lego/static/src/img/snippets/contact-block.jpg"/>
        </xpath>

        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_lego.banner" string="Banner" group="Banner">
            <keywords>Banner</keywords>
            </t>
        </xpath>

        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_lego.contact" string="Contact" group="Contact">
            <keywords>Contact</keywords>
            </t>
        </xpath>

        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_lego.index_deals" string="Lego Week Deals" group="Banner">
                <keywords>Lego Deals</keywords>
            </t>
        </xpath>

        <xpath expr="//snippets[@id='snippet_content']" position="inside">
            <t t-snippet="theme_lego.deal_week"
            t-thumbnail="/theme_lego/static/src/img/snippets/deals-of-the-day-blocks.jpg"/>
            <t t-snippet="theme_lego.map"
            t-thumbnail="/theme_lego/static/src/img/snippets/map-block.jpg"/>
        </xpath>
    </template>

    <template id="deal_week" name="Deal of the Week">
        <!-- template for deal of the week snippet-->
        <section class="deals_week">
            <div class="container">
                <div class="main_heading">
                    <div class="row justify-content-center">
                        <div class="col-lg-6 col-md-12 col-sm-12 col-12">
                            <h3>Deals of the week</h3>
                            <p>
                                Lorem Ipsum is simply dummy text of the printing
                                and typesetting industry. Lorem Ipsum has been
                                the industry's standard dummy text ever since
                                the 1500s, when an unknown printer took a galley
                                of type and scrambled it to make a type specimen
                                book.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row lego_week_deals_main_section" style="padding: 10px;">
                </div>
            </div>
        </section>
    </template>

</odoo>
