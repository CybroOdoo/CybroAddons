<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="testimonial_user" model="res.groups">
        <field name="name">Testimonial</field>
        <field name="privilege_id" ref="website.res_groups_privilege_website"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="access_website_testimonial_user" model="ir.access">
        <field name="name">Website Testimonial User Access</field>
        <field name="model_id" ref="model_website_testimonial"/>
        <field name="group_id" ref="testimonial_user"/>
        <field name="operation">crud</field>
    </record>
</odoo>
