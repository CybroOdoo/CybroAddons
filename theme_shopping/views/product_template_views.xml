<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_normal_form_view" model="ir.ui.view">
            <field name="name">product.template.view.form.inherit.theme.shopping</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span name="top_deal_option" class="d-inline-flex">
                    <field name="is_top_deal_product" widget="boolean_checkbox" class="w-auto"/>
                    <label for="is_top_deal_product" string="Top Deal"/>
                </span>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="readonly">is_top_deal_product</attribute>
            </xpath>
            <field name="categ_id" position="before">
            <field name="actual_price" invisible="True"/>
            <field name="time_period_end" invisible="True"/>
            <label for="time_period_from" invisible="not is_top_deal_product"/>
            <div class="o_row" invisible="not is_top_deal_product">
                <span style="display:contents!important">
                    <field name="time_period_from" string="Planned Date"
                           widget="daterange"
                           options="{'end_date_field': 'time_period_end', 'always_range': '1'}"
                           invisible="not is_top_deal_product"/>
                </span>
                <button name="apply_top_deal_time" type="object" string="Apply" class="oe_highlight" invisible="is_top_deal_product != True"/>
            </div>
            <field name="offer_price" widget="monetary"
                   options="{'currency_field': 'currency_id'}"
                   invisible="not is_top_deal_product"/>
            <field name="ready_to_top_deal" invisible="not is_top_deal_product"/>
            </field>
        </field>
    </record>
</odoo>
