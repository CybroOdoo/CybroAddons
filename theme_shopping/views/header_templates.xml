<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    Template for customized the search bar-->
    <template id="website_search_box_input" inherit_id="website.website_search_box_input" primary="True">
        <xpath expr="//form" position="attributes">
            <attribute name="style">flex:1;min-width:0;border-radius:30px;background-color:#FFFAF4;border:none;</attribute>
        </xpath>
        <xpath expr="//input[@name='search']" position="attributes">
            <attribute name="style">border:none;background-color:#FFFAF4;</attribute>
        </xpath>
    </template>
    <!--    Template customized for header-->
    <template id="template_header_theme_shopping"
              inherit_id="website.template_header_default"
              name="website_layout">
        <xpath expr="//header" position="attributes">
            <attribute name="t-attf-class" add="d-none"  separator=" " />
        </xpath>
        <xpath expr="//header" position="after">
            <header>
                <div class="st-topnavbar">
                    <nav class="container navbar flex-nowrap">
                        <!-- Logo -->
                        <a class="navbar-brand d-none d-md-block st-logo"
                           href="index.html">
                            <t t-call="website.placeholder_header_brand">
                                <t t-set="_link_class"
                                   t-value="'mr-4'"/>
                            </t>
                        </a>
                        <t t-call="theme_shopping.website_search_box_input"
                           search_type.f="all"
                           action.f="/website/search"
                           limit="5"/>
                        <ul class="st-header_link-list">
                            <!-- Keep action parameters local to this header. -->
                            <t>
                                <t t-set="_icon" t-value="True"/>
                                <t t-set="_text" t-value="False"/>
                                <t t-set="_item_class" t-value="'nav-item'"/>
                                <t t-set="_link_class" t-value="'nav-link st-header-icon'"/>
                                <t t-set="_icon_wrap_class" t-value="'st-header-icon-wrap'"/>
                                <t t-set="_badge_class" t-value="'position-absolute top-0 end-0 rounded-pill'"/>
                                <!-- Wishlist remains visible when empty. -->
                                <t t-set="wishcount" t-value="len(request.env['product.wishlist'].current())"/>
                                <li class="o_wsale_my_wish nav-item">
                                    <a href="/shop/wishlist" class="nav-link st-header-icon" aria-label="Wishlist">
                                        <div class="st-header-icon-wrap">
                                            <i class="oi oi-filled" data-icon="favorite"/>
                                            <sup t-out="wishcount"
                                                 t-attf-class="my_wish_quantity o_animate_blink badge bg-primary #{_badge_class} #{'d-none' if wishcount == 0 else ''}"/>
                                        </div>
                                    </a>
                                </li>
                                <t t-call="portal.placeholder_user_sign_in">
                                    <t t-set="_link_class" t-value="'nav-link st-header-signin'"/>
                                </t>
                                <t t-call="theme_shopping.user_logo">
                                    <t t-set="_user_name" t-value="False"/>
                                    <t t-set="_item_class" t-value="'nav-item dropdown'"/>
                                    <t t-set="_link_class" t-value="'nav-link st-header-icon st-header-account'"/>
                                    <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end'"/>
                                </t>
                                <t t-call="website_sale.header_cart_link">
                                    <t t-set="_item_class" t-value="'nav-item oe_cart custom_cart'"/>
                                </t>
                            </t>
                        </ul>
                    </nav>
                </div>
                <div class="st-mob-sidebar_menu-container">
                    <ul class="main-menu" id="myMenus"
                        style=" display: flex; justify-content: center;">
                        <t t-foreach="website.menu_id.child_id"
                           t-as="submenu">
                            <li class="menu-list">
                                <button class="st-mob-sidebar--nav-btn">
                                    <t t-call="website.submenu">
                                        <t t-set="item_class"
                                           t-value="'st-menu__item'"/>
                                        <t t-set="link_class"
                                           t-value="'nav-link'"/>
                                    </t>
                                </button>
                            </li>
                        </t>
                    </ul>
                </div>
            </header>
        </xpath>
    </template>

        <template id="user_logo" name="Link to frontend portal" inherit_id="portal.user_dropdown" primary="True">
        <xpath expr="//div[@t-if='_icon']" position="replace">
             <div t-if="_icon" t-attf-class="#{_icon_wrap_class}">
                        <i t-attf-class="oi oi-1x oi-fw oi-filled #{_icon_class}" data-icon="person"/>
                    </div>
        </xpath>
    </template>
</odoo>
