<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="shopping_blog_template"
              name="Shopping Blog"
              inherit_id="website_blog.blog_post_short" active="True"
              customize_show="True">
        <!-- Keep the droppable placeholder intact: opt_blog_cover_post also
        replaces it. Anchor the banner to the stable index header instead. -->
        <xpath expr="//div[@id='o_wblog_blog_top']"
                              position="before">
            <section class="st-hero_section-banner">
                <div class="container st-hero_section-content">
                    <h3 class="st-hero_section-banner--head">Blog</h3>
                </div>
            </section>
        </xpath>
    </template>
    <template id="shopping_blog_grid"
              name="Shopping Blog Regular Grid"
              inherit_id="website_blog.blog_post_short">
        <!-- Odoo 20 enables a promoted sticky column by default. Keep all
        posts in the regular responsive grid used by the shopping theme. -->
        <xpath expr="//t[@t-set='opt_blog_promoted_post']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
    </template>
</odoo>
