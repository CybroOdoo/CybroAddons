<odoo>
    <!-- Keep the module category -->
    <record id="module_category_document_management" model="ir.module.category">
        <field name="name">Document Management</field>
        <field name="description">Access for Document module</field>
        <field name="sequence">50</field>
    </record>

    <!-- Define the privilege that references the category -->
    <record model="res.groups.privilege" id="privilege_document_management">
        <field name="name">Document Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_document_management"/>
    </record>

    <!-- Define a group 'User' -->
    <record id="view_own_document" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_document_management"/>
    </record>

    <!-- Define a group 'Manager' with implied 'User' group and associated users -->
    <record id="view_all_document" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_document_management"/>
        <field name="implied_ids" eval="[(4, ref('view_own_document'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>