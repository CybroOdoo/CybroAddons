<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Adding sequence for insurance-->
        <record id="document_request_sequence" model="ir.sequence">
            <field name="name">Document Details</field>
            <field name="code">document.request</field>
            <field name="prefix">DOC/REQ</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="document_template_request_sequence" model="ir.sequence">
            <field name="name">Document Template Request Details</field>
            <field name="code">document.template.request</field>
            <field name="prefix">DOC/TMPL/REQ</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
</odoo>
