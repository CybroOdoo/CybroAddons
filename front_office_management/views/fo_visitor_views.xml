<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Form view of visitor-->
    <record id="fo_visitor_view_form" model="ir.ui.view">
        <field name="name">fo.visitor.view.form</field>
        <field name="model">fo.visitor</field>
        <field name="arch" type="xml">
            <form string="Visitors">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                name="%(fo_visit_action)d" type="action"
                                icon="fa-arrows-v"
                                context="{'default_visitor': id,'search_default_visitor': id}">
                            <field name="visit_count" widget="statinfo"
                                   string="Visits"
                                   style="margin-right:50px"/>
                        </button>
                    </div>
                    <field name="visitor_image" widget="image"
                           class="oe_avatar" style="margin-right:50px"/>
                    <div name="title_name" class="oe_title">
                        <h1>
                            <table>
                                <tr>
                                    <td>
                                        <field name="name"
                                               placeholder="FullName"
                                               style="padding-right:10px"/>
                                    </td>
                                </tr>
                            </table>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street"
                                       placeholder="Street..."
                                       class="o_address_street"/>
                                <field name="street2"
                                       placeholder="Street 2..."
                                       class="o_address_street"/>
                                <field name="city" placeholder="City"
                                       class="o_address_city"/>
                                <field name="state_id"
                                       class="o_address_state"
                                       placeholder="State"
                                       options='{"no_open": True}'/>
                                <field name="zip" placeholder="ZIP"
                                       class="o_address_zip"/>
                                <field name="country_id"
                                       placeholder="Country"
                                       class="o_address_country"
                                       options='{"no_open": True, "no_create": True}'/>
                            </div>
                            <field name="company_info_id"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="proof_id"/>
                            <field name="id_proof_no"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Kanban view of visitor-->
    <record id="fo_visitor_view_kanban" model="ir.ui.view">
        <field name="name">fo.visitor.view.kanban</field>
        <field name="model">fo.visitor</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="visitor_image"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <main class="pe-2">
                            <div class="mb-1">
                                <div class="d-flex mb-0 h5">
                                    <field name="name" class="fw-bold"/>
                                </div>
                            </div>
                            <div class="text-muted">
                                <i class="fa fa-phone me-1" title="Phone"/>
                                <field name="phone"/>
                            </div>
                            <div t-if="record.email.value" class="text-muted">
                                <i class="fa fa-envelope me-1" title="Email"/>
                                <field name="email"/>
                            </div>
                        </main>
                        <aside>
                            <field name="visitor_image"
                                   widget="image"
                                   alt="Visitor"
                                   options="{'img_class': 'w-100 object-fit-contain'}"
                                   invisible="not visitor_image"/>
                        </aside>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--Tree view of visitor-->
    <record id="fo_visitor_view_list" model="ir.ui.view">
        <field name="name">fo.visitor.view.list</field>
        <field name="model">fo.visitor</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string='Visitors'>
                <field name="name"/>
                <field name="phone"/>
                <field name="company_info_id"/>
            </list>
        </field>
    </record>

    <!--Action for fo visitor-->
    <record id="fo_visitor_action" model="ir.actions.act_window">
        <field name="name">Visitors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fo.visitor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="fo_visitor_view_kanban"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to Create New Visitor.
            </p>
        </field>
    </record>

    <!--All menus-->
    <menuitem id="fo_visit_menu_root"
              name="Front Office"
              web_icon="front_office_management,static/description/icon.png"
              sequence="2"/>
    <menuitem id="fo_visitor_menu"
              name="Visitor Management"
              parent="fo_visit_menu_root"
              sequence="1"/>
    <menuitem id="fo_visitor_menu_visitor"
              name="Visitor"
              parent="fo_visitor_menu"
              action="fo_visitor_action"
              groups="base.group_user"
              sequence="1"/>
    <menuitem id="fo_visit_menu_today"
              name="Today's Visits"
              parent="fo_visit_menu_root"
              sequence="2"/>
    <menuitem id="fo_visit_menu_today_child"
              name="Today's Visits"
              parent="fo_visit_menu_today"
              action="fo_visit_action"
              groups="base.group_user"
              sequence="2"/>
</odoo>
