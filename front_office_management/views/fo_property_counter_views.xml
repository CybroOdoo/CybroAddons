<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Form view of fo property counter-->
    <record id="fo_property_counter_view_form" model="ir.ui.view">
        <field name="name">fo.property.counter.view.form</field>
        <field name="model">fo.property.counter</field>
        <field name="arch" type="xml">
            <form string="Visits">
                <header>
                    <button name="action_taken_in"
                            string="Take In"
                            type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight"
                    />
                    <button name="action_taken_out"
                            string="Take Out"
                            type="object"
                            invisible="state != 'taken_in'"
                            class="oe_highlight"
                    />
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state != 'draft'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,taken_in,taken_out,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personal belongings">
                            <field name="belonging_ids" nolabel="1">
                                <list decoration-success="permission == '0' or permission == '2'"
                                      decoration-danger="permission == '1'"
                                      string="Items" editable="bottom">
                                    <field name="property_name"/>
                                    <field name="property_count"/>
                                    <field name="permission"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view of property counters -->
    <record id="fo_property_counter_view_list" model="ir.ui.view">
        <field name="name">fo.property.counter.view.list</field>
        <field name="model">fo.property.counter</field>
        <field name="arch" type="xml">
            <list string="Property Counters" decoration-success="state == 'taken_in'"
                  decoration-muted="state == 'taken_out'">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="fo_property_counter_view_search" model="ir.ui.view">
        <field name="name">fo.property.counter.view.search</field>
        <field name="model">fo.property.counter</field>
        <field name="arch" type="xml">
            <search string="Search Property Counters">
                <field name="employee_id"/>
                <field name="date"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_taken_in" string="Taken In" domain="[('state', '=', 'taken_in')]"/>
                <filter name="filter_taken_out" string="Taken Out" domain="[('state', '=', 'taken_out')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--    Action for property counter-->
    <record id="fo_property_counter_action" model="ir.actions.act_window">
        <field name="name">Property Counter</field>
        <field name="res_model">fo.property.counter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Record personal belongings.</p>
        </field>
    </record>

    <record id="fo_belongings_form_view" model="ir.ui.view">
        <field name="name">Belongings</field>
        <field name="model">fo.belongings</field>
        <field name="arch" type="xml">
            <form string="Belongings">
                <sheet>
                    <group>
                        <group>
                            <field name="property_name"/>
                        </group>
                        <group>
                            <field name="property_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--    Menu Items-->
    <menuitem id="fo_property_counter_menu" name="Property Counter"
              parent="fo_visit_menu_root"
              sequence="4"/>
    <menuitem id="fo_property_counter_menu_child" name="Property Counter"
              parent="fo_property_counter_menu"
              action="fo_property_counter_action"
              groups="front_office_management.group_receptionist" sequence="2"/>
</odoo>
