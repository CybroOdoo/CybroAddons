<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Proof Form view-->
    <record id="id_proof_view_form" model="ir.ui.view">
        <field name="name">id_proof_view_form</field>
        <field name="model">id.proof</field>
        <field name="arch" type="xml">
            <form string="ID Proof">
                <sheet>
                    <group>
                        <group>
                            <field name="id_proof"/>
                        </group>
                        <group>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="id_proof_view_list" model="ir.ui.view">
        <field name="name">id.proof.view.list</field>
        <field name="model">id.proof</field>
        <field name="arch" type="xml">
            <list string="ID Proofs">
                <field name="id_proof"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="id_proof_action" model="ir.actions.act_window">
        <field name="name">ID Proofs</field>
        <field name="res_model">id.proof</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="id_proof_menu"
              name="ID Proofs"
              parent="fo_configuration_menu"
              action="id_proof_action"
              groups="front_office_management.group_receptionist"
              sequence="20"/>
</odoo>
