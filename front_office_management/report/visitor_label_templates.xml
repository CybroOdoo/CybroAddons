<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_visitor_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t>
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-xs-2" style="margin:auto;">
                            </div>
                            <center>
                                <div class="col-xs-8"
                                     style="margin:auto">
                                    <br/>
                                    <table class="table table-condensed"
                                           style="border: 2px solid black !important;">
                                        <tr>
                                            <td width="40%">
                                                <p style="text-align:center;padding-top:10px;">
                                                    <div t-if="not o.visitor_id.visitor_image"
                                                         style="width: 120px; height: 120px; background-color: #46A29F; color: white; text-align: center; line-height: 120px; font-size: 60px; font-weight: bold; text-transform: uppercase; border: 1px solid black; margin: 0 auto;">
                                                        <t t-esc="o.visitor_id.name[0] if o.visitor_id.name else '?'"/>
                                                    </div>
                                                    <img t-if="o.visitor_id.visitor_image"
                                                         t-att-src="image_data_uri(o.visitor_id.visitor_image)"
                                                         class="float-left"
                                                         alt="Logo"
                                                         height="120"
                                                         border="1"
                                                         width="120"/>
                                                </p>
                                                <p style="text-align:center;">
                                                    <strong>
                                                        <span t-field="o.visitor_id"/>
                                                    </strong>
                                                </p>
                                            </td>
                                            <td width="50%">
                                                <table style="width: 100%; border: none; margin-top: 10px;">
                                                    <t t-if="o.employee_id">
                                                        <tr>
                                                            <td style="vertical-align: top; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;">
                                                                    <strong>Visitor ID:</strong>
                                                                </p>
                                                            </td>
                                                            <td style="vertical-align: top; padding-left: 10px; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;" t-field="o.name"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="vertical-align: top; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;">
                                                                    <strong>Phone:</strong>
                                                                </p>
                                                            </td>
                                                            <td style="vertical-align: top; padding-left: 10px; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;" t-field="o.phone"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="vertical-align: top; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;">
                                                                    <strong>Meeting With:</strong>
                                                                </p>
                                                            </td>
                                                            <td style="vertical-align: top; padding-left: 10px; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;" t-field="o.employee_id"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="vertical-align: top; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;">
                                                                    <strong>Department:</strong>
                                                                </p>
                                                            </td>
                                                            <td style="vertical-align: top; padding-left: 10px; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;" t-field="o.department_id"/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                    <t t-if="not o.employee_id">
                                                        <tr>
                                                            <td style="vertical-align: top; text-align: right; padding-top: 30px; padding-bottom: 5px;">
                                                                <p style="margin: 0;">
                                                                    <strong>Visitor ID:</strong>
                                                                </p>
                                                            </td>
                                                            <td style="vertical-align: top; padding-left: 10px; padding-top: 30px; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;" t-field="o.name"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="vertical-align: top; text-align: right; padding-top: 15px; padding-bottom: 5px;">
                                                                <p style="margin: 0;">
                                                                    <strong>Phone:</strong>
                                                                </p>
                                                            </td>
                                                            <td style="vertical-align: top; padding-left: 10px; padding-top: 15px; padding-bottom: 5px;">
                                                                <p style="text-align:left; margin: 0;" t-field="o.phone"/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </center>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
