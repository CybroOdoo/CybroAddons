<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_visitor_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <style>
                            .visitor-report-title {
                            margin: 24px 0 22px;
                            text-align: center;
                            font-size: 22px;
                            font-weight: 700;
                            }
                            .visitor-report-section {
                            margin: 20px 0 8px;
                            font-size: 15px;
                            font-weight: 700;
                            }
                            .visitor-report-table {
                            width: 100%;
                            margin: 0;
                            border-collapse: collapse;
                            font-size: 12px;
                            }
                            .visitor-report-table th,
                            .visitor-report-table td {
                            padding: 8px 10px;
                            border: 1px solid #555;
                            vertical-align: top;
                            }
                            .visitor-report-table th {
                            background: #f2f2f2;
                            font-weight: 700;
                            }
                            .visitor-report-label {
                            display: inline-block;
                            min-width: 88px;
                            margin-right: 6px;
                            font-weight: 700;
                            }
                            .visitor-report-empty {
                            color: #666;
                            font-style: italic;
                            text-align: center;
                            }
                        </style>

                        <h3 class="visitor-report-title">Visitor Report</h3>

                        <table class="visitor-report-table">
                            <tbody>
                                <tr>
                                    <td style="width:33.33%;">
                                        <span class="visitor-report-label">Visitor</span>
                                        <span t-field="o.visitor_id"/>
                                    </td>
                                    <td style="width:33.33%;">
                                        <span class="visitor-report-label">Email</span>
                                        <span t-field="o.email"/>
                                    </td>
                                    <td style="width:33.33%;">
                                        <span class="visitor-report-label">Phone</span>
                                        <span t-field="o.phone"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span class="visitor-report-label">Meeting With</span>
                                        <span t-field="o.employee_id"/>
                                    </td>
                                    <td colspan="2">
                                        <span class="visitor-report-label">Department</span>
                                        <span t-field="o.department_id"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="visitor-report-section">In/Out Details</h4>
                        <table class="visitor-report-table">
                            <tbody>
                                <tr>
                                    <td style="width:50%;">
                                        <span class="visitor-report-label">Check In</span>
                                        <span t-field="o.check_in_date"/>
                                    </td>
                                    <td style="width:50%;">
                                        <span class="visitor-report-label">Check Out</span>
                                        <span t-field="o.check_out_date"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="visitor-report-section">Personal Belongings</h4>
                        <table class="visitor-report-table">
                            <thead>
                                <tr>
                                    <th style="width:70%;">Name</th>
                                    <th style="width:30%;">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.belonging_ids">
                                    <t t-foreach="o.belonging_ids" t-as="belonging">
                                        <tr>
                                            <td>
                                                <span t-field="belonging.property_name"/>
                                            </td>
                                            <td>
                                                <span t-field="belonging.property_count"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="2" class="visitor-report-empty">
                                            No personal belongings recorded.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <p style="page-break-after:always"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
