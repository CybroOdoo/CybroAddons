<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_property_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article"
                     t-att-data-oe-model="o._name"
                     t-att-data-oe-id="o.id"
                     t-att-data-oe-lang="o.env.context.get('lang')">
                    <div class="page">
                        <div class="oe_structure"/>
                        <style>
                            .property-label-card { width: 560px; margin: 25px auto; padding: 24px; border: 2px solid #333; font-size: 12px; }
                            .property-label-title { margin: 0 0 18px; text-align: center; font-size: 20px; font-weight: 700; }
                            .property-label-photo, .property-label-initials { display: block; width: 104px; height: 104px; margin: 0 auto 14px; border: 1px solid #555; }
                            .property-label-photo { object-fit: cover; }
                            .property-label-initials { background: #46A29F; color: #fff; font-size: 44px; font-weight: 700; line-height: 104px; text-align: center; text-transform: uppercase; }
                            .property-label-person { margin: 4px 0; text-align: center; font-size: 14px; }
                            .property-label-section { margin: 22px 0 8px; padding-bottom: 5px; border-bottom: 1px solid #555; font-size: 15px; font-weight: 700; }
                            .property-label-table { width: 100%; border-collapse: collapse; font-size: 12px; }
                            .property-label-table th, .property-label-table td { padding: 8px 10px; border: 1px solid #555; vertical-align: top; }
                            .property-label-table th { background: #f2f2f2; font-weight: 700; }
                            .property-label-empty { color: #666; font-style: italic; text-align: center; }
                        </style>

                        <div class="property-label-card">
                            <img t-if="o.employee_id.image_1920"
                                 class="property-label-photo"
                                 t-att-src="image_data_uri(o.employee_id.image_1920)"
                                 alt="Employee photo"/>
                            <div t-if="not o.employee_id.image_1920" class="property-label-initials">
                                <t t-esc="(o.employee_id.name or '?')[0]"/>
                            </div>

                            <p class="property-label-person">
                                <strong>Name:</strong>
                                <span t-field="o.employee_id"/>
                            </p>
                            <p class="property-label-person">
                                <strong>Department:</strong>
                                <span t-field="o.employee_id.department_id"/>
                            </p>

                            <h4 class="property-label-section">Personal Belongings</h4>
                            <table class="property-label-table">
                                <thead>
                                    <tr>
                                        <th style="width:70%;">Name</th>
                                        <th style="width:30%;">Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="o.belonging_ids">
                                        <t t-foreach="o.belonging_ids" t-as="belonging">
                                            <tr>
                                                <td><span t-field="belonging.property_name"/></td>
                                                <td><span t-field="belonging.property_count"/></td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="2" class="property-label-empty">
                                                No personal belongings recorded.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
