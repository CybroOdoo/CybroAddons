<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="theme_solarion.solutions_dynamic_content">
        <div class="solarion-dynamic-solutions-wrapper">
            <!-- FEATURED PRODUCT: QUANTUM PANELS -->
            <t t-if="featured_product">
                <section class="spotlight-section lp-overlap-white">
                    <div class="container">
                        <div class="section__header">
                            <div class="section__eyebrow">Featured Product</div>
                            <h2 class="section__title">
                                <t t-esc="featured_product.name"/>
                            </h2>
                        </div>
                        <div class="spotlight-grid">
                            <div class="spotlight-img-col">
                                <div class="spotlight-img-wrap">
                                    <img t-if="featured_product.has_image"
                                         t-attf-src="/web/image/solarion.product/#{featured_product.id}/image"
                                         t-att-alt="featured_product.name"/>
                                    <img t-else=""
                                         src="https://images.unsplash.com/photo-1611365892117-00ac5ef43c90?w=900&amp;q=85&amp;fit=crop"
                                         alt="Quantum solar panels"/>
                                    <div class="spotlight-tag">
                                        <iconify-icon icon="mdi:star" width="13" height="13"/>
                                        Most Popular
                                    </div>
                                    <div class="spotlight-specs">
                                        <div class="sspec">
                                            <span>Efficiency</span>
                                            <strong><t t-esc="featured_product.efficiency"/></strong>
                                        </div>
                                        <div class="sspec">
                                            <span>Lifespan</span>
                                            <strong><t t-esc="featured_product.lifespan"/></strong>
                                        </div>
                                        <div class="sspec">
                                            <span>Warranty</span>
                                            <strong><t t-esc="featured_product.warranty"/></strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="spotlight-text-col">
                                <div class="spotlight-divider"/>
                                <div class="spotlight-body">
                                    <div t-out="featured_product.description"/>
                                </div>
                                <div class="spotlight-actions">
                                    <a href="/contactus" class="btn btn--primary">Get a Free Assessment →</a>
                                    <a href="/contactus" class="spotlight-link">Request Datasheet</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>

            <!-- MORE SOLUTIONS / OTHER PRODUCTS -->
            <t t-if="other_products &amp;&amp; other_products.length">
                <section class="services section lp-overlap-light">
                    <div class="container">
                        <div class="section__header">
                            <div class="section__eyebrow">More Solutions</div>
                            <h2 class="section__title">The Complete <span class="gradient-text">Energy Ecosystem</span></h2>
                            <p class="section__desc">Every product in our lineup is designed to work together — or standalone.</p>
                        </div>
                        <div class="services__cards">
                            <t t-foreach="other_products" t-as="product" t-key="product.id">
                                <div class="service-card">
                                    <div class="service-card__img">
                                        <img t-if="product.has_image"
                                             t-attf-src="/web/image/solarion.product/#{product.id}/image"
                                             t-att-alt="product.name"/>
                                        <img t-else=""
                                             src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=600&amp;q=85&amp;fit=crop"
                                             alt="Solar battery storage"/>
                                    </div>
                                    <div class="service-card__body">
                                        <span class="service__num">
                                            <t t-esc="String(product_index + 2).padStart(2, '0')"/>
                                        </span>
                                        <h3><t t-esc="product.name"/></h3>
                                        <div t-out="product.description"
                                             style="margin-bottom: 24px; color: var(--text-color);"/>
                                        <a href="/contactus" class="service-card__link">Learn More <span>→</span></a>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
            </t>
        </div>
    </t>
</templates>
