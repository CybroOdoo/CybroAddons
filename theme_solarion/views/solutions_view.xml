<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_solutions" name="Solutions">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty solarion-theme">
                <!-- PAGE HERO -->
                <section class="page-hero">
                    <div class="page-hero__bg">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1920&amp;q=85&amp;fit=crop"
                             alt="Solar panels"/>
                        <div class="page-hero__bg-overlay"/>
                    </div>
                    <div class="container">
                        <div class="page-hero__eyebrow">What We Offer</div>
                        <h1 class="page-hero__title">Solar Solutions
                            <span class="gradient-text-light">Beyond Limits</span>
                        </h1>
                        <p class="page-hero__desc">Comprehensive clean energy ecosystems designed for every scale — from
                            a single home to an entire city grid.
                        </p>
                    </div>
                </section>

                <!-- STATS BAND -->
                <section class="page-stats-intro section lp-overlap-light">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">By the Numbers</div>
                            <h2 class="section__title">Products Built for
                                <span class="gradient-text">Every Scale</span>
                            </h2>
                            <p class="section__desc">Four industry-leading solutions, one unified platform.</p>
                        </div>
                        <div class="page-stats-grid">
                            <div class="page-stat-box" data-reveal="true" data-reveal-delay="1">
                                <div class="page-stat-box__val">4</div>
                                <div class="page-stat-box__label">Core Solutions</div>
                            </div>
                            <div class="page-stat-box" data-reveal="true" data-reveal-delay="2">
                                <div class="page-stat-box__val">47%</div>
                                <div class="page-stat-box__label">Panel Efficiency</div>
                            </div>
                            <div class="page-stat-box" data-reveal="true" data-reveal-delay="3">
                                <div class="page-stat-box__val">50yr</div>
                                <div class="page-stat-box__label">Guaranteed Lifespan</div>
                            </div>
                            <div class="page-stat-box" data-reveal="true" data-reveal-delay="4">
                                <div class="page-stat-box__val">∞</div>
                                <div class="page-stat-box__label">Lifetime Warranty</div>
                            </div>
                        </div>
                    </div>
                </section>

                <t t-set="all_products" t-value="request.env['solarion.product'].sudo().search([])"/>
                <t t-set="featured_product" t-value="all_products and all_products[0] or None"/>
                <t t-set="other_products" t-value="all_products and all_products[1:] or []"/>

                <!-- FEATURED PRODUCT: QUANTUM PANELS -->
                <section class="spotlight-section lp-overlap-white">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">Featured Product</div>
                            <t t-if="featured_product">
                                <h2 class="section__title">
                                    <t t-out="featured_product.name"/>
                                </h2>
                            </t>
                        </div>
                        <t t-if="featured_product">
                            <div class="spotlight-grid">
                                <div class="spotlight-img-col" data-reveal="true" data-reveal-delay="1">
                                    <div class="spotlight-img-wrap">
                                        <img t-if="featured_product.image"
                                             t-attf-src="/web/image/solarion.product/#{featured_product.id}/image"
                                             t-att-alt="featured_product.name"/>
                                        <img t-else=""
                                             src="https://images.unsplash.com/photo-1611365892117-00ac5ef43c90?w=900&amp;q=85&amp;fit=crop"
                                             alt="Quantum solar panels"/>
                                        <div class="spotlight-tag">
                                            <iconify-icon icon="mdi:star" width="13" height="13"/>
                                            Most Popular
                                        </div>
                                        <div class="spotlight-specs">
                                            <div class="sspec">
                                                <span>Efficiency</span>
                                                <strong>
                                                    <t t-out="featured_product.efficiency"/>
                                                </strong>
                                            </div>
                                            <div class="sspec">
                                                <span>Lifespan</span>
                                                <strong>
                                                    <t t-out="featured_product.lifespan"/>
                                                </strong>
                                            </div>
                                            <div class="sspec">
                                                <span>Warranty</span>
                                                <strong>
                                                    <t t-out="featured_product.warranty"/>
                                                </strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="spotlight-text-col" data-reveal="true" data-reveal-delay="2">
                                    <div class="spotlight-divider"/>
                                    <div class="spotlight-body">
                                        <div t-field="featured_product.description"/>
                                    </div>
                                    <div class="spotlight-actions">
                                        <a href="/contactus" class="btn btn--primary">Get a Free Assessment →</a>
                                        <a href="/contactus" class="spotlight-link">Request Datasheet</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>

                <!-- 3 SERVICE CARDS -->
                <section class="services section lp-overlap-light">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">More Solutions</div>
                            <h2 class="section__title">The Complete
                                <span class="gradient-text">Energy Ecosystem</span>
                            </h2>
                            <p class="section__desc">Every product in our lineup is designed to work together — or
                                standalone.
                            </p>
                        </div>
                        <t t-if="other_products">
                            <div class="services__cards">
                                <t t-foreach="other_products" t-as="product">
                                    <div class="service-card" data-reveal="true"
                                         t-att-data-reveal-delay="product_index + 1">
                                        <div class="service-card__img">
                                            <img t-if="product.image"
                                                 t-attf-src="/web/image/solarion.product/#{product.id}/image"
                                                 t-att-alt="product.name"/>
                                            <img t-else=""
                                                 src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=600&amp;q=85&amp;fit=crop"
                                                 alt="Solar battery storage"/>
                                        </div>
                                        <div class="service-card__body">
                                            <span class="service__num">
                                                <t t-out="str(product_index + 2).zfill(2)"/>
                                            </span>
                                            <h3>
                                                <t t-out="product.name"/>
                                            </h3>
                                            <div t-field="product.description"
                                                 style="margin-bottom: 24px; color: var(--text-color);"/>
                                            <a href="/contactus" class="service-card__link">Learn More
                                                <span>→</span>
                                            </a>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </section>
                <!-- WHY OUR TECHNOLOGY -->
                <section class="dark-section lp-overlap">
                    <div class="dark-section__parallax">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar field"/>
                        <div class="dark-section__overlay"/>
                    </div>
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">Why Our Tech</div>
                            <h2 class="section__title section__title--white">The Difference Is
                                <span class="gradient-text-light">Engineering</span>
                            </h2>
                            <p class="section__desc" style="color:rgba(255,255,255,0.5)">Three innovations that put
                                every Solarion product in a league of its own.
                            </p>
                        </div>
                        <div class="pillars-dark">
                            <div class="pillar-dark" data-reveal="true" data-reveal-delay="1">
                                <div class="pillar-dark__icon">
                                    <iconify-icon icon="mdi:atom" width="36" height="36"/>
                                </div>
                                <h4>Quantum Dot Layers</h4>
                                <p>Third-generation QD cells absorb photons across three spectral ranges simultaneously
                                    — a breakthrough impossible with conventional silicon.
                                </p>
                            </div>
                            <div class="pillar-dark" data-reveal="true" data-reveal-delay="2">
                                <div class="pillar-dark__icon">
                                    <iconify-icon icon="mdi:brain" width="36" height="36"/>
                                </div>
                                <h4>Neural MPPT</h4>
                                <p>Our AI-driven Maximum Power Point Tracking adjusts 10,000× per second — 100× faster
                                    than any hardware-based inverter on the market.
                                </p>
                            </div>
                            <div class="pillar-dark" data-reveal="true" data-reveal-delay="3">
                                <div class="pillar-dark__icon">
                                    <iconify-icon icon="mdi:link-variant" width="36" height="36"/>
                                </div>
                                <h4>Open Protocol Stack</h4>
                                <p>Full compatibility with IEEE 2030.5, SunSpec, and Modbus — no vendor lock-in. Your
                                    investment works with any future grid upgrade.
                                </p>
                            </div>
                        </div>
                        <div style="text-align:center; margin-top:48px;" data-reveal="true">
                            <a href="/technology" class="btn btn--outline-white">Explore Our Technology →</a>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>
</odoo>
