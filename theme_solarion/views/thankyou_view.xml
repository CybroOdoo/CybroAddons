<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Thank you template-->
    <template id="page_thank_you" name="Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty solarion-theme">
                <section class="page-hero">
                    <div class="page-hero__bg">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=1920&amp;q=85&amp;fit=crop"
                             alt="Solar consultation"/>
                        <div class="page-hero__bg-overlay"/>
                    </div>
                    <div class="container" style="text-align: center;">
                        <div class="page-hero__eyebrow">Thank You!</div>
                        <h1 class="page-hero__title">Your Request has been
                            <span class="gradient-text-light">Received</span>
                        </h1>
                        <p class="page-hero__desc" style="margin: 0 auto; max-width: 600px; padding-bottom: 30px;">
                            We appreciate you reaching out. One of our solar experts will get back to you within 24
                            hours.
                        </p>
                        <br/>
                        <a href="/" class="btn btn--primary btn--lg">Back to Home</a>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>