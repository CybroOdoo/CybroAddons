<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Home template -->
    <template id="page_index" name="Home">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty solarion-theme">
                <!-- HERO -->
                <section class="hero" id="home">
                    <div class="hero__bg">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1920&amp;q=90&amp;fit=crop"
                             alt="Solar panels" loading="eager"/>
                        <div class="hero__overlay"/>
                    </div>

                    <div class="hero__content">
                        <p class="hero__label">Next-Generation Solar Technology</p>
                        <h1 class="hero__title">Powering the World<br/>with Intelligent Solar
                        </h1>
                        <p class="hero__subtitle">Quantum-dot photovoltaics and AI-driven energy management — delivering
                            up to 47% efficiency for homes, businesses, and cities.
                        </p>
                        <div class="hero__cta-row">
                            <a href="/solutions" class="btn btn--hero-primary">Explore Solutions</a>
                            <a href="/technology" class="btn btn--hero-ghost">How It Works →</a>
                        </div>
                    </div>

                    <div class="hero__stats-bar">
                        <div class="hero__stat">
                            <strong>47%</strong>
                            <span>Panel Efficiency</span>
                        </div>
                        <div class="hero__stat-sep"/>
                        <div class="hero__stat">
                            <strong>2.4 GW</strong>
                            <span>Capacity Deployed</span>
                        </div>
                        <div class="hero__stat-sep"/>
                        <div class="hero__stat">
                            <strong>34+</strong>
                            <span>Countries Active</span>
                        </div>
                        <div class="hero__stat-sep"/>
                        <div class="hero__stat">
                            <strong>850K</strong>
                            <span>Homes Powered</span>
                        </div>
                    </div>

                    <a href="#mission" class="hero__scroll-hint">
                        <span>Scroll</span>
                        <div class="scroll-line"/>
                    </a>
                </section>

                <!-- SEPARATOR -->
                <div class="hero-separator lp-overlap"/>

                <!-- MISSION -->
                <section class="mission-section lp-overlap" id="mission">
                    <div class="mission__parallax-wrap">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=1920&amp;q=85&amp;fit=crop"
                             alt="Solar energy"/>
                        <div class="mission__overlay"/>
                    </div>
                    <div class="container-fluid mission__container">
                        <div class="mission__left">
                            <div class="section__eyebrow section__eyebrow--light">Our Mission</div>
                            <h2 class="mission__headline">
                                The future of energy is here.
                                <br/>
                                And it's
                                <span class="gradient-text-light">brilliantly simple.</span>
                            </h2>
                            <p class="mission__body">Founded in 2019, Solarion merges quantum photovoltaics with
                                artificial intelligence to make clean, intelligent energy accessible to everyone — from
                                a single home to an entire city grid.
                            </p>
                            <a href="/about" class="btn btn--outline-white">Our Story →</a>
                        </div>
                        <div class="mission__right" data-reveal-delay="2">
                            <div class="mission__metrics-grid">
                                <div class="mission__metric">
                                    <span class="mission__metric-val">47%</span>
                                    <span class="mission__metric-label">Panel Efficiency</span>
                                </div>
                                <div class="mission__metric">
                                    <span class="mission__metric-val">50yr</span>
                                    <span class="mission__metric-label">Lifespan</span>
                                </div>
                                <div class="mission__metric">
                                    <span class="mission__metric-val">AI</span>
                                    <span class="mission__metric-label">Powered</span>
                                </div>
                                <div class="mission__metric">
                                    <span class="mission__metric-val">6+</span>
                                    <span class="mission__metric-label">Years Innovation</span>
                                </div>
                            </div>
                            <div class="mission__img-accent">
                                <img src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=600&amp;q=85&amp;fit=crop"
                                     alt="Aerial solar farm"/>
                                <div class="mission__img-badge">
                                    <iconify-icon icon="mdi:medal-outline" width="22" height="22"/>
                                    <div>
                                        <strong>ISO 9001</strong>
                                        <span>Certified</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- FEATURES -->
                <section class="features-section section lp-overlap-light">
                    <div class="container">
                        <div class="section__header">
                            <div class="section__eyebrow">Why Solarion</div>
                            <h2 class="section__title">Built Different.
                                <span class="gradient-text">Built to Last.</span>
                            </h2>
                            <p class="section__desc">Three breakthrough innovations converge in every Solarion system.
                            </p>
                        </div>
                        <div class="features-grid">
                            <div class="feature-tile feature-tile--tall" data-reveal-delay="1">
                                <div class="feature-tile__img">
                                    <img src="https://images.unsplash.com/photo-1611365892117-00ac5ef43c90?w=800&amp;q=85&amp;fit=crop"
                                         alt="Quantum panels"/>
                                </div>
                                <div class="feature-tile__body">
                                    <div class="feature-tile__icon">
                                        <iconify-icon icon="mdi:lightning-bolt" width="36" height="36"/>
                                    </div>
                                    <h3>Quantum Efficiency</h3>
                                    <p>Multi-spectrum QD arrays capture UV, visible, and near-IR simultaneously —
                                        delivering 47% real-world efficiency, double the industry average.
                                    </p>
                                    <a href="/technology" class="feature-tile__link">Explore Technology →</a>
                                </div>
                            </div>
                            <div class="feature-tile" data-reveal-delay="2">
                                <div class="feature-tile__img">
                                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&amp;q=85&amp;fit=crop"
                                         alt="AI dashboard"/>
                                </div>
                                <div class="feature-tile__body">
                                    <div class="feature-tile__icon">
                                        <iconify-icon icon="mdi:robot-outline" width="36" height="36"/>
                                    </div>
                                    <h3>Neural AI Brain</h3>
                                    <p>Self-optimizing algorithms adjust power output 10,000× per second to maximize
                                        capture in any weather condition, anywhere on Earth.
                                    </p>
                                    <a href="/technology" class="feature-tile__link">See AI in Action →</a>
                                </div>
                            </div>
                            <div class="feature-tile" data-reveal-delay="3">
                                <div class="feature-tile__img">
                                    <img src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=800&amp;q=85&amp;fit=crop"
                                         alt="Solar grid array"/>
                                </div>
                                <div class="feature-tile__body">
                                    <div class="feature-tile__icon">
                                        <iconify-icon icon="mdi:earth" width="36" height="36"/>
                                    </div>
                                    <h3>Universal Grid Connect</h3>
                                    <p>Open-protocol integration works seamlessly with any municipal, commercial, or
                                        residential grid — no proprietary lock-in, ever.
                                    </p>
                                    <a href="/solutions" class="feature-tile__link">View Solutions →</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- PROCESS -->
                <section class="process-section lp-overlap">
                    <div class="container">
                        <div class="section__header">
                            <div class="section__eyebrow">How It Works</div>
                            <h2 class="section__title">From Sunlight to
                                <span class="gradient-text">Savings</span>
                            </h2>
                            <p class="section__desc">Four intelligent stages — from photon capture to lower electricity
                                bills.
                            </p>
                        </div>
                        <div class="process-steps">
                            <div class="process-step" data-reveal-delay="1">
                                <div class="process-step__num">01</div>
                                <div class="process-step__icon-wrap">
                                    <iconify-icon icon="mdi:white-balance-sunny" width="40" height="40"/>
                                </div>
                                <h4>Capture</h4>
                                <p>QD panels absorb sunlight across UV, visible, and near-IR wavelengths — extracting
                                    energy from every photon that hits your roof.
                                </p>
                            </div>
                            <div class="process-connector" data-reveal-delay="2"/>
                            <div class="process-step" data-reveal-delay="2">
                                <div class="process-step__num">02</div>
                                <div class="process-step__icon-wrap">
                                    <iconify-icon icon="mdi:cog-outline" width="40" height="40"/>
                                </div>
                                <h4>Convert</h4>
                                <p>Neural MPPT algorithms optimize power conversion 10,000× per second, achieving 98%
                                    conversion efficiency in real-world conditions.
                                </p>
                            </div>
                            <div class="process-connector" data-reveal-delay="3"/>
                            <div class="process-step" data-reveal-delay="3">
                                <div class="process-step__num">03</div>
                                <div class="process-step__icon-wrap">
                                    <iconify-icon icon="mdi:battery-charging-outline" width="40" height="40"/>
                                </div>
                                <h4>Store &amp; Route</h4>
                                <p>Solid-state batteries store excess energy. Smart load balancing routes power to your
                                    home, storage, or the grid instantly.
                                </p>
                            </div>
                            <div class="process-connector" data-reveal-delay="4"/>
                            <div class="process-step" data-reveal-delay="4">
                                <div class="process-step__num">04</div>
                                <div class="process-step__icon-wrap">
                                    <iconify-icon icon="mdi:chart-line" width="40" height="40"/>
                                </div>
                                <h4>Monitor &amp; Learn</h4>
                                <p>Edge AI tracks 200+ metrics per panel. Your system learns, predicts failures weeks
                                    ahead, and improves efficiency every day.
                                </p>
                            </div>
                        </div>
                        <div class="process-cta">
                            <a href="/technology" class="btn btn--primary">Explore Full Technology →</a>
                        </div>
                    </div>
                </section>

                <!-- DYNAMIC PRODUCTS WIDGET SECTION (STATIC SECTION WRAPPER FOR WEBSITE EDITOR) -->
                <section class="solarion-dynamic-products-section js_solarion_solutions_widget">
                    <div class="js_solutions_content"/>
                </section>

                <!-- IMPACT NUMBERS -->
                <section class="impact-home lp-overlap">
                    <div class="impact-home__parallax-wrap">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar landscape"/>
                        <div class="impact-home__overlay"/>
                    </div>
                    <div class="container impact-home__inner">
                        <div class="section__header">
                            <div class="section__eyebrow section__eyebrow--light">Global Impact</div>
                            <h2 class="section__title section__title--white">Our Numbers
                                <span class="gradient-text-light">Speak Loudly</span>
                            </h2>
                        </div>
                        <div class="impact-home__counters">
                            <div class="impact-home__counter" data-reveal-delay="1">
                                <div class="impact-home__val" data-count="2400000">0</div>
                                <div class="impact-home__unit">Tonnes / yr</div>
                                <div class="impact-home__label">CO₂ Offset Annually</div>
                            </div>
                            <div class="impact-home__counter" data-reveal-delay="2">
                                <div class="impact-home__val" data-count="850000">0</div>
                                <div class="impact-home__unit">Homes</div>
                                <div class="impact-home__label">Powered by Solarion</div>
                            </div>
                            <div class="impact-home__counter" data-reveal-delay="3">
                                <div class="impact-home__val" data-count="34">0</div>
                                <div class="impact-home__unit">Countries</div>
                                <div class="impact-home__label">Active Deployments</div>
                            </div>
                            <div class="impact-home__counter" data-reveal-delay="4">
                                <div class="impact-home__val" data-count="2400">0</div>
                                <div class="impact-home__unit">GW Installed</div>
                                <div class="impact-home__label">Total Capacity</div>
                            </div>
                        </div>
                        <div class="impact-home__cta">
                            <a href="/impact" class="btn btn--outline-white">See Full Impact Report →</a>
                        </div>
                    </div>
                </section>

                <!-- TESTIMONIAL -->
                <section class="quote-section lp-overlap-light">
                    <div class="quote-parallax-wrap">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar field"/>
                        <div class="quote-overlay"/>
                    </div>
                    <div class="container">
                        <div class="quote-inner">
                            <div class="quote-mark">"</div>
                            <blockquote class="quote-text">
                                Solarion's AI grid cut our facility's energy cost by 68% in the first year. The
                                predictive maintenance alone has saved us hundreds of thousands in potential downtime.
                            </blockquote>
                            <div class="quote-author">
                                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=80&amp;h=80&amp;fit=crop&amp;crop=face&amp;q=80"
                                     alt="Amir Khalid"/>
                                <div class="quote-author__info">
                                    <strong>Amir Khalid</strong>
                                    <span>CTO, NovaTech Industries</span>
                                </div>
                                <div class="quote-stars">★★★★★</div>
                            </div>
                            <a href="/impact" class="quote-more">Read All Testimonials →</a>
                        </div>
                    </div>
                </section>

                <!-- CTA BANNER -->
                <section class="cta-banner lp-overlap">
                    <div class="cta-banner__bg">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar farm"/>
                        <div class="cta-banner__overlay"/>
                    </div>
                    <div class="container cta-banner__content">
                        <div class="cta-banner__eyebrow">Limited Time Offer</div>
                        <h2>Ready to Switch to
                            <span class="gradient-text-light">Solar Power?</span>
                        </h2>
                        <p>Get a free energy assessment and custom quote. Save up to 80% on electricity bills from day
                            one.
                        </p>
                        <div class="cta-banner__actions">
                            <a href="/contactus" class="btn btn--white btn--lg">Get Free Assessment</a>
                            <a href="tel:18885627466" class="btn btn--outline-white btn--lg">
                                <iconify-icon icon="mdi:phone-outline" width="18" height="18"/>
                                Call Us Now
                            </a>
                        </div>
                        <div class="cta-banner__trust">
                            <span>✓ No commitment required</span>
                            <span>✓ Response within 24 hours</span>
                            <span>✓ Free site survey</span>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
