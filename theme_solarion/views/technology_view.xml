<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Technology template -->
    <template id="page_technology" name="Technology">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty solarion-theme">
                <!-- PAGE HERO -->
                <section class="page-hero">
                    <div class="page-hero__bg">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1613665813446-82a78c468a1d?w=1920&amp;q=85&amp;fit=crop"
                             alt="Solar cell technology"/>
                        <div class="page-hero__bg-overlay"/>
                    </div>
                    <div class="container">
                        <div class="page-hero__eyebrow">Our Technology</div>
                        <h1 class="page-hero__title">How
                            <span class="gradient-text-light">Solarion Works</span>
                        </h1>
                        <p class="page-hero__desc">Four intelligent stages — quantum capture, AI conversion, smart
                            distribution, and predictive maintenance — working in perfect harmony.
                        </p>
                    </div>
                </section>

                <!-- PERFORMANCE STATS -->
                <section class="page-stats-intro section lp-overlap-light">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">Performance</div>
                            <h2 class="section__title">Industry-Leading
                                <span class="gradient-text">Benchmarks</span>
                            </h2>
                            <p class="section__desc">Real-world performance data from our global fleet — not lab
                                conditions.
                            </p>
                        </div>
                        <div class="page-stats-grid">
                            <div class="page-stat-box" data-reveal="true" data-reveal-delay="1">
                                <div class="page-stat-box__val">47%</div>
                                <div class="page-stat-box__label">Panel Efficiency</div>
                            </div>
                            <div class="page-stat-box" data-reveal="true" data-reveal-delay="2">
                                <div class="page-stat-box__val">98%</div>
                                <div class="page-stat-box__label">Conversion Rate</div>
                            </div>
                            <div class="page-stat-box" data-reveal="true" data-reveal-delay="3">
                                <div class="page-stat-box__val">99%</div>
                                <div class="page-stat-box__label">Routing Accuracy</div>
                            </div>
                            <div class="page-stat-box" data-reveal="true" data-reveal-delay="4">
                                <div class="page-stat-box__val">95%</div>
                                <div class="page-stat-box__label">Downtime Prevention</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- HOW IT WORKS — 4 STEPS (dark) -->
                <section class="process-section lp-overlap">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">The Process</div>
                            <h2 class="section__title">Four Stages.
                                <span class="gradient-text-light">One Seamless System.</span>
                            </h2>
                            <p class="section__desc" style="color:rgba(255,255,255,0.5)">From the moment photons hit the
                                panel to the moment power reaches your devices.
                            </p>
                        </div>
                        <div class="process-steps">
                            <div class="process-step" data-reveal="true" data-reveal-delay="1">
                                <div class="process-step__num">01</div>
                                <div class="process-step__icon-wrap">
                                    <iconify-icon icon="mdi:white-balance-sunny" width="40" height="40"/>
                                </div>
                                <h4>Quantum Capture</h4>
                                <p>QD-enhanced cells absorb photons across UV, visible, and near-IR wavelengths
                                    simultaneously — extracting 92% of the available solar spectrum.
                                </p>
                            </div>
                            <div class="process-connector" data-reveal="true" data-reveal-delay="2"/>
                            <div class="process-step" data-reveal="true" data-reveal-delay="2">
                                <div class="process-step__num">02</div>
                                <div class="process-step__icon-wrap">
                                    <iconify-icon icon="mdi:cog-outline" width="40" height="40"/>
                                </div>
                                <h4>AI Conversion</h4>
                                <p>Neural MPPT algorithms optimize the power conversion point 10,000× per second —
                                    eliminating the efficiency losses of conventional inverters.
                                </p>
                            </div>
                            <div class="process-connector" data-reveal="true" data-reveal-delay="3"/>
                            <div class="process-step" data-reveal="true" data-reveal-delay="3">
                                <div class="process-step__num">03</div>
                                <div class="process-step__icon-wrap">
                                    <iconify-icon icon="mdi:battery-charging-outline" width="40" height="40"/>
                                </div>
                                <h4>Smart Distribution</h4>
                                <p>Intelligent load balancing routes power where it's needed — home, storage, or grid
                                    export — in real-time with zero manual configuration required.
                                </p>
                            </div>
                            <div class="process-connector" data-reveal="true" data-reveal-delay="4"/>
                            <div class="process-step" data-reveal="true" data-reveal-delay="4">
                                <div class="process-step__num">04</div>
                                <div class="process-step__icon-wrap">
                                    <iconify-icon icon="mdi:chart-line" width="40" height="40"/>
                                </div>
                                <h4>Predictive Maintenance</h4>
                                <p>Edge AI monitors 200+ health metrics per panel — predicting and preventing failures
                                    weeks before they occur, keeping uptime near-perfect.
                                </p>
                            </div>
                        </div>
                        <div class="process-cta" data-reveal="true">
                            <a href="/solutions" class="btn btn--primary">See Our Products →</a>
                        </div>
                    </div>
                </section>

                <!-- TECH DEEP DIVE -->
                <section class="section lp-overlap-light">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">Under the Hood</div>
                            <h2 class="section__title">What Makes Each Stage
                                <span class="gradient-text">Special</span>
                            </h2>
                            <p class="section__desc">Four breakthrough technologies, each pushing the boundaries of what
                                renewable energy can achieve.
                            </p>
                        </div>
                        <div class="tech-compare-grid">
                            <div class="tech-compare-card" data-reveal="true" data-reveal-delay="1">
                                <div class="tech-compare-card__icon">
                                    <iconify-icon icon="mdi:lightning-bolt" width="32" height="32"/>
                                </div>
                                <div class="tech-compare-card__val">92%</div>
                                <div class="tech-compare-card__label">Spectrum Coverage</div>
                                <div class="tech-compare-card__desc">Multi-layer QD stacks capture UV, visible, and
                                    near-IR photons simultaneously — 2× the coverage of standard monocrystalline
                                    silicon.
                                </div>
                            </div>
                            <div class="tech-compare-card" data-reveal="true" data-reveal-delay="2">
                                <div class="tech-compare-card__icon">
                                    <iconify-icon icon="mdi:brain" width="32" height="32"/>
                                </div>
                                <div class="tech-compare-card__val">10K×</div>
                                <div class="tech-compare-card__label">AI Ops per Second</div>
                                <div class="tech-compare-card__desc">Our Neural MPPT engine recalculates the optimum
                                    power point 10,000 times per second — continuously adapting to cloud cover,
                                    temperature, and angle changes.
                                </div>
                            </div>
                            <div class="tech-compare-card" data-reveal="true" data-reveal-delay="3">
                                <div class="tech-compare-card__icon">
                                    <iconify-icon icon="mdi:swap-horizontal" width="32" height="32"/>
                                </div>
                                <div class="tech-compare-card__val">0ms</div>
                                <div class="tech-compare-card__label">Routing Latency</div>
                                <div class="tech-compare-card__desc">Sub-millisecond power routing decisions mean zero
                                    energy is wasted waiting. Smart load balancing happens before you even notice demand
                                    changed.
                                </div>
                            </div>
                            <div class="tech-compare-card" data-reveal="true" data-reveal-delay="4">
                                <div class="tech-compare-card__icon">
                                    <iconify-icon icon="mdi:shield-check-outline" width="32" height="32"/>
                                </div>
                                <div class="tech-compare-card__val">200+</div>
                                <div class="tech-compare-card__label">Health Metrics</div>
                                <div class="tech-compare-card__desc">Every panel streams 200+ live data points to our
                                    edge AI — detecting micro-cracks, soiling, shading, and thermal runaway weeks before
                                    failure.
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TECH VISUAL + CTA -->
                <section class="dark-section lp-overlap">
                    <div class="dark-section__parallax">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1611365892117-00ac5ef43c90?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar panel close-up"/>
                        <div class="dark-section__overlay"/>
                    </div>
                    <div class="container">
                        <div class="tech__layout" data-reveal="true">
                            <div class="tech__steps-col">
                                <div class="tech__step active" data-step="1">
                                    <div class="tech__step-header">
                                        <div class="tech__step-circle">01</div>
                                        <h4>Quantum Capture</h4>
                                    </div>
                                    <div class="tech__step-body">
                                        <p>QD-enhanced cells absorb photons across UV, visible, and near-IR wavelengths
                                            simultaneously.
                                        </p>
                                        <div class="tech__step-bar-wrap">
                                            <div class="tech__step-bar">
                                                <div class="tech__step-fill" style="--pct:92%"/>
                                            </div>
                                            <span>92% Spectrum Coverage</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="tech__step" data-step="2">
                                    <div class="tech__step-header">
                                        <div class="tech__step-circle">02</div>
                                        <h4>AI Conversion Engine</h4>
                                    </div>
                                    <div class="tech__step-body">
                                        <p>Neural MPPT algorithms dynamically optimize the power conversion point
                                            10,000× per second.
                                        </p>
                                        <div class="tech__step-bar-wrap">
                                            <div class="tech__step-bar">
                                                <div class="tech__step-fill" style="--pct:98%"/>
                                            </div>
                                            <span>98% Conversion Efficiency</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="tech__step" data-step="3">
                                    <div class="tech__step-header">
                                        <div class="tech__step-circle">03</div>
                                        <h4>Smart Distribution</h4>
                                    </div>
                                    <div class="tech__step-body">
                                        <p>Intelligent load balancing routes power where it's needed in real-time with
                                            zero manual configuration.
                                        </p>
                                        <div class="tech__step-bar-wrap">
                                            <div class="tech__step-bar">
                                                <div class="tech__step-fill" style="--pct:99%"/>
                                            </div>
                                            <span>99% Routing Accuracy</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="tech__step" data-step="4">
                                    <div class="tech__step-header">
                                        <div class="tech__step-circle">04</div>
                                        <h4>Predictive Maintenance</h4>
                                    </div>
                                    <div class="tech__step-body">
                                        <p>Edge AI continuously monitors 200+ health metrics per panel, predicting
                                            failures weeks in advance.
                                        </p>
                                        <div class="tech__step-bar-wrap">
                                            <div class="tech__step-bar">
                                                <div class="tech__step-fill" style="--pct:95%"/>
                                            </div>
                                            <span>95% Downtime Prevention</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tech__visual-col">
                                <div class="tech__image-wrap">
                                    <img src="https://images.unsplash.com/photo-1613665813446-82a78c468a1d?w=900&amp;q=85&amp;fit=crop"
                                         alt="Solar cell technology"/>
                                    <div class="tech__image-chip tech__image-chip--tl">
                                        <strong>AI Active</strong>
                                        <span class="chip__dot"/>
                                    </div>
                                    <div class="tech__overlay-bar">
                                        <div class="ostat">
                                            <strong>47%</strong>
                                            <span>Efficiency</span>
                                        </div>
                                        <div class="ostat">
                                            <strong>10K×</strong>
                                            <span>AI Ops/sec</span>
                                        </div>
                                        <div class="ostat">
                                            <strong>200+</strong>
                                            <span>Metrics</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div style="text-align:center; margin-top:48px; position:relative; z-index:2;"
                             data-reveal="true">
                            <a href="/contactus" class="btn btn--white btn--lg">Get a Free Assessment →</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
