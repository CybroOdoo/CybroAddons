<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- About template -->
    <template id="page_about" name="About">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty solarion-theme">
                <!-- PAGE HERO -->
                <section class="page-hero">
                    <div class="page-hero__bg">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=1920&amp;q=85&amp;fit=crop"
                             alt="Aerial solar farm"/>
                        <div class="page-hero__bg-overlay"/>
                    </div>
                    <div class="container">
                        <div class="page-hero__eyebrow">Who We Are</div>
                        <h1 class="page-hero__title">Engineered for a
                            <span class="gradient-text-light">Brighter Tomorrow</span>
                        </h1>
                        <p class="page-hero__desc">Founded in 2019, Solarion merges quantum photovoltaics with
                            artificial intelligence — making clean, intelligent energy accessible to everyone.
                        </p>
                    </div>
                </section>
                <!-- ABOUT CONTENT -->
                <section class="about section lp-overlap-light">
                    <div class="container">
                        <div class="about__grid">
                            <div class="about__image-col" data-reveal="true" data-reveal-delay="1">
                                <div class="about__img-frame">
                                    <img src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=900&amp;q=85&amp;fit=crop"
                                         alt="Solar farm aerial"/>
                                    <div class="about__img-frame-dot about__img-frame-dot--tl"/>
                                    <div class="about__img-frame-dot about__img-frame-dot--br"/>
                                </div>
                                <div class="about__img-inset">
                                    <img src="https://images.unsplash.com/photo-1497435334941-8c899ee9e8e9?w=400&amp;q=85&amp;fit=crop"
                                         alt="Solar sunset"/>
                                </div>
                                <div class="about__float-badge">
                                    <div class="float-badge__icon">
                                        <iconify-icon icon="mdi:medal-outline" width="22" height="22"/>
                                    </div>
                                    <div class="float-badge__text">
                                        <strong>ISO 9001 Certified</strong>
                                        <span>Engineering Excellence</span>
                                    </div>
                                </div>
                                <div class="about__years-badge">
                                    <span class="years__num">6+</span>
                                    <span class="years__label">Years of<br/>Innovation
                                    </span>
                                </div>
                            </div>
                            <div class="about__content" data-reveal="true" data-reveal-delay="2">
                                <div class="section__eyebrow">Our Story</div>
                                <h2 class="section__title">Pushing the Limits of
                                    <br/>
                                    <span class="gradient-text">Renewable Energy</span>
                                </h2>
                                <div class="about__divider"/>
                                <p class="about__text">Founded in 2019, Solarion is a pioneer in advanced solar energy
                                    systems. We merge cutting-edge photovoltaic research with artificial intelligence to
                                    deliver solutions that are not just clean — but intelligent.
                                </p>
                                <p class="about__text">From residential micro-grids to utility-scale solar farms, our
                                    technology adapts, learns, and optimizes in real-time — pushing the limits of what
                                    renewable energy can achieve.
                                </p>
                                <div class="about__pillars">
                                    <div class="pillar" data-reveal="true" data-reveal-delay="1">
                                        <div class="pillar__icon-box">
                                            <iconify-icon icon="mdi:microscope" width="28" height="28"/>
                                        </div>
                                        <div class="pillar__content">
                                            <strong>R&amp;D Driven</strong>
                                            <span>12 active patents in quantum solar conversion</span>
                                        </div>
                                    </div>
                                    <div class="pillar" data-reveal="true" data-reveal-delay="2">
                                        <div class="pillar__icon-box">
                                            <iconify-icon icon="mdi:earth" width="28" height="28"/>
                                        </div>
                                        <div class="pillar__content">
                                            <strong>Global Reach</strong>
                                            <span>Deployed in 34 countries across 6 continents</span>
                                        </div>
                                    </div>
                                    <div class="pillar" data-reveal="true" data-reveal-delay="3">
                                        <div class="pillar__icon-box">
                                            <iconify-icon icon="mdi:robot-outline" width="28" height="28"/>
                                        </div>
                                        <div class="pillar__content">
                                            <strong>AI-Powered</strong>
                                            <span>Self-optimizing neural grid management</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="about__cta-row">
                                    <a href="/solutions" class="btn btn--primary">Explore Solutions →</a>
                                    <a href="/contactus" class="about__link">Schedule a Demo</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CORE VALUES -->
                <section class="dark-section lp-overlap">
                    <div class="dark-section__parallax">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar field"/>
                        <div class="dark-section__overlay"/>
                    </div>
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">Core Values</div>
                            <h2 class="section__title section__title--white">What Drives
                                <span class="gradient-text-light">Everything We Do</span>
                            </h2>
                            <p class="section__desc" style="color:rgba(255,255,255,0.5)">Three principles guide every
                                decision — from R&amp;D lab to global deployment.
                            </p>
                        </div>
                        <div class="pillars-dark">
                            <div class="pillar-dark" data-reveal="true" data-reveal-delay="1">
                                <div class="pillar-dark__icon">
                                    <iconify-icon icon="mdi:lightbulb-on-outline" width="36" height="36"/>
                                </div>
                                <h4>Innovation First</h4>
                                <p>We invest 22% of revenue back into R&amp;D. With 12 active patents, our lab is always
                                    working on the next generation of solar technology — not just incremental
                                    improvements.
                                </p>
                            </div>
                            <div class="pillar-dark" data-reveal="true" data-reveal-delay="2">
                                <div class="pillar-dark__icon">
                                    <iconify-icon icon="mdi:sprout-outline" width="36" height="36"/>
                                </div>
                                <h4>Planet Positive</h4>
                                <p>Every Solarion deployment offsets more carbon than it produces. We aim to eliminate
                                    10 million tonnes of CO₂ annually by 2030 — and we're on track.
                                </p>
                            </div>
                            <div class="pillar-dark" data-reveal="true" data-reveal-delay="3">
                                <div class="pillar-dark__icon">
                                    <iconify-icon icon="mdi:handshake-outline" width="36" height="36"/>
                                </div>
                                <h4>Human Scale</h4>
                                <p>From single-home systems to city-wide grids, every person deserves access to clean
                                    energy. We design products that work for individuals, not just corporations.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- MILESTONES -->
                <section class="section lp-overlap-light">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">Our Journey</div>
                            <h2 class="section__title">Six Years of
                                <span class="gradient-text">Milestones</span>
                            </h2>
                            <p class="section__desc">From a small research team in San Francisco to a global clean
                                energy leader.
                            </p>
                        </div>
                        <div class="milestones-grid" style="--bg:#fff">
                            <div class="milestone-card" style="background:var(--bg-alt); border-color:var(--border);"
                                 data-reveal="true" data-reveal-delay="1">
                                <div class="milestone-card__year" style="color:var(--solar)">2019</div>
                                <div class="milestone-card__title" style="color:var(--text)">Founded in San Francisco
                                </div>
                                <div class="milestone-card__desc" style="color:var(--muted)">A team of 8 researchers and
                                    engineers set out to rethink photovoltaic technology from first principles.
                                </div>
                            </div>
                            <div class="milestone-card" style="background:var(--bg-alt); border-color:var(--border);"
                                 data-reveal="true" data-reveal-delay="2">
                                <div class="milestone-card__year" style="color:var(--solar)">2020</div>
                                <div class="milestone-card__title" style="color:var(--text)">First Quantum Panel
                                    Patent
                                </div>
                                <div class="milestone-card__desc" style="color:var(--muted)">Our QD multi-spectrum
                                    absorption technology is granted patent protection — the foundation of everything we
                                    build.
                                </div>
                            </div>
                            <div class="milestone-card" style="background:var(--bg-alt); border-color:var(--border);"
                                 data-reveal="true" data-reveal-delay="3">
                                <div class="milestone-card__year" style="color:var(--solar)">2021</div>
                                <div class="milestone-card__title" style="color:var(--text)">10-Country Deployment</div>
                                <div class="milestone-card__desc" style="color:var(--muted)">Solarion systems go live
                                    across 10 countries with our first commercial-scale installations in Europe and
                                    Southeast Asia.
                                </div>
                            </div>
                            <div class="milestone-card" style="background:var(--bg-alt); border-color:var(--border);"
                                 data-reveal="true" data-reveal-delay="1">
                                <div class="milestone-card__year" style="color:var(--solar)">2022</div>
                                <div class="milestone-card__title" style="color:var(--text)">Neural AI Platform Launch
                                </div>
                                <div class="milestone-card__desc" style="color:var(--muted)">Our proprietary Neural MPPT
                                    AI engine goes into production — delivering 98% conversion efficiency across all
                                    product lines.
                                </div>
                            </div>
                            <div class="milestone-card" style="background:var(--bg-alt); border-color:var(--border);"
                                 data-reveal="true" data-reveal-delay="2">
                                <div class="milestone-card__year" style="color:var(--solar)">2024</div>
                                <div class="milestone-card__title" style="color:var(--text)">ISO 9001 Certification
                                </div>
                                <div class="milestone-card__desc" style="color:var(--muted)">Awarded ISO 9001 for
                                    engineering excellence. Our manufacturing processes meet the highest global
                                    standards for quality and consistency.
                                </div>
                            </div>
                            <div class="milestone-card" style="background:var(--bg-alt); border-color:var(--border);"
                                 data-reveal="true" data-reveal-delay="3">
                                <div class="milestone-card__year" style="color:var(--solar)">2026</div>
                                <div class="milestone-card__title" style="color:var(--text)">2.4 GW Deployed Globally
                                </div>
                                <div class="milestone-card__desc" style="color:var(--muted)">Active in 34 countries.
                                    850K homes powered. 2.4M tonnes of CO₂ offset every year — and growing every day.
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA -->
                <section class="dark-section lp-overlap">
                    <div class="dark-section__parallax">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar landscape"/>
                        <div class="dark-section__overlay"/>
                    </div>
                    <div class="container" style="text-align:center; position:relative; z-index:2;">
                        <div data-reveal="true">
                            <div class="section__eyebrow" style="justify-content:center; color:rgba(253,186,116,0.9)">
                                Join the Revolution
                            </div>
                            <h2 class="section__title section__title--white" style="margin-bottom:16px">Ready to
                                <span class="gradient-text-light">Go Solar?</span>
                            </h2>
                            <p style="font-size:17px; color:rgba(255,255,255,0.55); max-width:520px; margin:0 auto 36px; line-height:1.75;">
                                Get a free energy assessment designed for your property. Our experts will build a custom
                                proposal within 24 hours.
                            </p>
                            <div style="display:flex; gap:20px; justify-content:center; flex-wrap:wrap;">
                                <a href="/contactus" class="btn btn--white btn--lg">Get Free Assessment</a>
                                <a href="/solutions" class="btn btn--outline-white btn--lg">Explore Solutions →</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
