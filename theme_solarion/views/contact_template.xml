<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact page template -->
    <template id="page_contact" name="Contact">
        <t t-call="website.layout">
            <div id="wrap" class="solarion-theme">
                <div classs="oe_structure oe_empty o_editable">
                    <!-- PAGE HERO -->
                    <section class="page-hero">
                        <div class="page-hero__bg">
                            <img class="parallax-img"
                                 src="/theme_solarion/static/src/images/celebration.jpeg"
                                 alt="Solar consultation"/>
                            <div class="page-hero__bg-overlay"/>
                        </div>
                        <div class="container">
                            <div class="page-hero__eyebrow">Get In Touch</div>
                            <h1 class="page-hero__title">Start Your
                                <span class="gradient-text-light">Solar Journey</span>
                            </h1>
                            <p class="page-hero__desc">Join thousands of homes and businesses that have already made the
                                switch. Our experts respond within 24 hours.
                            </p>
                        </div>
                    </section>

                    <!-- CONTACT FORM -->
                    <section class="contact section lp-overlap-light">
                        <div class="container">
                            <div class="contact__grid">
                                <div class="contact__left" data-reveal="true" data-reveal-delay="1">
                                    <div class="section__eyebrow">Why Choose Us</div>
                                    <h2 class="section__title">We Make
                                        <span class="gradient-text">Going Solar Easy</span>
                                    </h2>
                                    <p class="contact__intro">From free site assessment to full installation and
                                        monitoring, Solarion handles everything. No upfront complexity — just clean
                                        energy from day one.
                                    </p>
                                    <div class="contact__image">
                                        <img src="/theme_solarion/static/src/images/celebration.jpeg"
                                             alt="Solar consultation"/>
                                        <div class="contact__image-badge">Free Site Survey Included</div>
                                    </div>
                                    <div class="contact__info-cards">
                                        <div class="contact__info-card" data-reveal="true" data-reveal-delay="1">
                                            <div class="contact__info-icon">
                                                <iconify-icon icon="mdi:map-marker-outline" width="22" height="22"/>
                                            </div>
                                            <div>
                                                <strong>Our Office</strong>
                                                <span>1 Solar Drive, Helios Tower, San Francisco, CA</span>
                                            </div>
                                        </div>
                                        <div class="contact__info-card" data-reveal="true" data-reveal-delay="2">
                                            <div class="contact__info-icon">
                                                <iconify-icon icon="mdi:phone-outline" width="22" height="22"/>
                                            </div>
                                            <div>
                                                <strong>Phone</strong>
                                                <span>+1 (888) SOLARION</span>
                                            </div>
                                        </div>
                                        <div class="contact__info-card" data-reveal="true" data-reveal-delay="3">
                                            <div class="contact__info-icon">
                                                <iconify-icon icon="mdi:email-outline" width="22" height="22"/>
                                            </div>
                                            <div>
                                                <strong>Email</strong>
                                                <span>hello@solarion.energy</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="contact__right" data-reveal="true" data-reveal-delay="2">
                                    <form action="/solarion/contact/submit" method="post"
                                          class="o_mark_required contact__form" enctype="multipart/form-data">
                                        <div class="form__header">
                                            <h3>Request a Free Quote</h3>
                                            <p>We'll get back to you within 24 hours</p>
                                        </div>
                                        <div class="s_website_form_rows">
                                            <div class="form__row">
                                                <div class="form__group s_website_form_field s_website_form_required s_website_form_model_required"
                                                     data-type="char" data-name="Field">
                                                    <label class="s_website_form_label s_website_form_label_content"
                                                           for="contact_name">Full Name *
                                                    </label>
                                                    <div class="s_website_form_control">
                                                        <input type="text" id="contact_name"
                                                               class="form-control s_website_form_input"
                                                               name="contact_name" required="1" placeholder="John Doe"/>
                                                        <!-- Using contact_name for the person and hidden name for the lead subject -->
                                                        <input type="hidden" name="name" class="s_website_form_input"
                                                               value="Solarion Website Contact"/>
                                                    </div>
                                                </div>
                                                <div class="form__group s_website_form_field s_website_form_required s_website_form_model_required"
                                                     data-type="email" data-name="Field">
                                                    <label class="s_website_form_label s_website_form_label_content"
                                                           for="email_from">Email Address
                                                        *
                                                    </label>
                                                    <div class="s_website_form_control">
                                                        <input type="email" id="email_from"
                                                               class="form-control s_website_form_input"
                                                               name="email_from" required="1"
                                                               placeholder="john@example.com"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form__row">
                                                <div class="form__group s_website_form_field" data-type="char"
                                                     data-name="Field">
                                                    <label class="s_website_form_label s_website_form_label_content"
                                                           for="phone">Phone Number
                                                    </label>
                                                    <div class="s_website_form_control">
                                                        <input type="tel" id="phone"
                                                               class="form-control s_website_form_input" name="phone"
                                                               placeholder="+1 (555) 000-0000"/>
                                                    </div>
                                                </div>
                                                <div class="form__group s_website_form_field" data-type="char"
                                                     data-name="Field">
                                                    <label class="s_website_form_label s_website_form_label_content"
                                                           for="property_type">Property
                                                        Type
                                                    </label>
                                                    <div class="s_website_form_control">
                                                        <select class="form-control s_website_form_input"
                                                                name="property_type" id="property_type">
                                                            <option value="">Select type...</option>
                                                            <option value="Residential">Residential</option>
                                                            <option value="Commercial">Commercial</option>
                                                            <option value="Industrial">Industrial</option>
                                                            <option value="Municipal / Government">Municipal /
                                                                Government
                                                            </option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form__group s_website_form_field" data-type="char"
                                                 data-name="Field">
                                                <label class="s_website_form_label s_website_form_label_content"
                                                       for="solution_interest">Solution
                                                    Interest
                                                </label>
                                                <div class="s_website_form_control">
                                                    <select class="form-control s_website_form_input"
                                                            name="solution_interest" id="solution_interest">
                                                        <option value="">Select a solution...</option>
                                                        <option value="Quantum Solar Panels">Quantum Solar Panels
                                                        </option>
                                                        <option value="Neural Battery Grid">Neural Battery Grid</option>
                                                        <option value="Smart City Integration">Smart City Integration
                                                        </option>
                                                        <option value="Remote Monitoring">Remote Monitoring</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form__group s_website_form_field s_website_form_required s_website_form_model_required"
                                                 data-type="text" data-name="Field">
                                                <label class="s_website_form_label s_website_form_label_content"
                                                       for="description">Your Message *
                                                </label>
                                                <div class="s_website_form_control">
                                                    <textarea id="description" class="form-control s_website_form_input"
                                                              name="description" required="1" rows="4"
                                                              placeholder="Tell us about your energy goals and current setup..."/>
                                                </div>
                                            </div>
                                            <div id="contact-form-error"
                                                 style="display:none; color:#ff4d4d; margin-bottom:15px; font-weight: 500; font-size: 14px; background: rgba(255,0,0,0.1); padding: 10px; border-radius: 4px;">
                                                Please fill the required fields.
                                            </div>
                                            <div class="s_website_form_submit" data-name="Submit Button">
                                                <button type="submit"
                                                        class="btn btn--primary btn--full btn--lg s_website_form_send">
                                                    Send Message
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2"
                                                         style="margin-left: 8px;">
                                                        <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/>
                                                    </svg>
                                                </button>
                                                <span id="s_website_form_result"/>
                                            </div>
                                            <p class="form__note">
                                                <iconify-icon icon="mdi:lock-outline" width="14" height="14"/>
                                                Your information is secure. No spam, ever.
                                            </p>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- WHY CHOOSE SOLARION -->
                    <section class="dark-section lp-overlap">
                        <div class="dark-section__parallax">
                            <img class="parallax-img"
                                 src="/theme_solarion/static/src/images/electic_line.jpeg"
                                 alt="Solar field"/>
                            <div class="dark-section__overlay"/>
                        </div>
                        <div class="container">
                            <div class="section__header" data-reveal="true">
                                <div class="section__eyebrow">Why Solarion</div>
                                <h2 class="section__title section__title--white">What Sets Us
                                    <span class="gradient-text-light">Apart</span>
                                </h2>
                                <p class="section__desc" style="color:rgba(255,255,255,0.5)">Three reasons thousands of
                                    customers choose Solarion over every other solar provider.
                                </p>
                            </div>
                            <div class="trust-grid">
                                <div class="trust-item" data-reveal="true" data-reveal-delay="1">
                                    <div class="trust-item__icon">
                                        <iconify-icon icon="mdi:lightning-bolt" width="40" height="40"/>
                                    </div>
                                    <h4>Fastest ROI</h4>
                                    <p>Customers typically see payback within 4–6 years — and enjoy free energy for the
                                        remaining 44 years of the panel's lifespan.
                                    </p>
                                </div>
                                <div class="trust-item" data-reveal="true" data-reveal-delay="2">
                                    <div class="trust-item__icon">
                                        <iconify-icon icon="mdi:shield-check-outline" width="40" height="40"/>
                                    </div>
                                    <h4>Lifetime Warranty</h4>
                                    <p>Every product we install carries a lifetime performance warranty. If anything
                                        fails, we fix or replace it — at no cost to you. Ever.
                                    </p>
                                </div>
                                <div class="trust-item" data-reveal="true" data-reveal-delay="3">
                                    <div class="trust-item__icon">
                                        <iconify-icon icon="mdi:handshake-outline" width="40" height="40"/>
                                    </div>
                                    <h4>Dedicated Support</h4>
                                    <p>A named account manager plus 24/7 remote monitoring. We don't disappear after
                                        installation — we're with you for the life of your system.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- FAQ -->
                    <section class="section lp-overlap-white">
                        <div class="container">
                            <div class="section__header" data-reveal="true">
                                <div class="section__eyebrow">FAQ</div>
                                <h2 class="section__title">Common
                                    <span class="gradient-text">Questions</span>
                                </h2>
                                <p class="section__desc">Everything you need to know before getting started.</p>
                            </div>
                            <div style="max-width:760px; margin:0 auto;" data-reveal="true">
                                <div class="faq-list">
                                    <div class="faq-item open">
                                        <div class="faq-item__q">How long does installation take?
                                            <span>+</span>
                                        </div>
                                        <div class="faq-item__a">Most residential installations are completed within 1–2
                                            days. Commercial and utility-scale projects vary by size, but our team
                                            handles all permits, grid connection paperwork, and commissioning so you
                                            don't have to.
                                        </div>
                                    </div>
                                    <div class="faq-item">
                                        <div class="faq-item__q">What happens if my panels produce more energy than I
                                            use?
                                            <span>+</span>
                                        </div>
                                        <div class="faq-item__a">Surplus energy flows back to the grid through our
                                            net-metering integration, earning you credits on your electricity bill. With
                                            our Neural Battery Grid add-on, you can also store excess energy for use at
                                            night or on cloudy days.
                                        </div>
                                    </div>
                                    <div class="faq-item">
                                        <div class="faq-item__q">Do the panels work on cloudy days?
                                            <span>+</span>
                                        </div>
                                        <div class="faq-item__a">Yes. Our QD panels capture diffuse light, so they
                                            continue generating power even on overcast days — just at a reduced rate.
                                            Our AI system automatically compensates for changing light conditions to
                                            maximise output in all weather.
                                        </div>
                                    </div>
                                    <div class="faq-item">
                                        <div class="faq-item__q">What financing options are available?
                                            <span>+</span>
                                        </div>
                                        <div class="faq-item__a">We offer a range of financing options including
                                            zero-down solar loans, power purchase agreements (PPAs), and leasing — so
                                            you can switch to solar with no upfront cost. Our advisors will recommend
                                            the best option for your situation.
                                        </div>
                                    </div>
                                    <div class="faq-item">
                                        <div class="faq-item__q">How does the monitoring system work?
                                            <span>+</span>
                                        </div>
                                        <div class="faq-item__a">Every panel streams live data to our cloud platform:
                                            power output, temperature, health score, and 200+ additional metrics. You
                                            can track everything from our mobile app, and our AI automatically flags any
                                            issues — usually before they affect performance.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
</odoo>
