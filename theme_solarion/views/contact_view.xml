<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact Page Template-->
    <template id="page_contact" name="Contact">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty solarion-theme">
                <!-- PAGE HERO -->
                <section class="page-hero">
                    <div class="page-hero__bg">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=1920&amp;q=85&amp;fit=crop"
                             alt="Solar consultation"/>
                        <div class="page-hero__bg-overlay"/>
                    </div>
                    <div class="container">
                        <div class="page-hero__eyebrow">Get In Touch</div>
                        <h1 class="page-hero__title">Start Your
                            <span class="gradient-text-light">Solar Journey</span>
                        </h1>
                        <p class="page-hero__desc">Join thousands of homes and businesses that have already made the
                            switch. Our experts respond within 24 hours.
                        </p>
                    </div>
                </section>

                <!-- CONTACT FORM -->
                <section class="contact section lp-overlap-light">
                    <div class="container">
                        <div class="contact__grid">
                            <div class="contact__left" data-reveal="true" data-reveal-delay="1">
                                <div class="section__eyebrow">Why Choose Us</div>
                                <h2 class="section__title">We Make
                                    <span class="gradient-text">Going Solar Easy</span>
                                </h2>
                                <p class="contact__intro">From free site assessment to full installation and monitoring,
                                    Solarion handles everything. No upfront complexity — just clean energy from day one.
                                </p>
                                <div class="contact__image">
                                    <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600&amp;q=85&amp;fit=crop"
                                         alt="Solar consultation"/>
                                    <div class="contact__image-badge">Free Site Survey Included</div>
                                </div>
                                <div class="contact__info-cards">
                                    <div class="contact__info-card" data-reveal="true" data-reveal-delay="1">
                                        <div class="contact__info-icon">
                                            <iconify-icon icon="mdi:map-marker-outline" width="22"
                                                          height="22"/>
                                        </div>
                                        <div>
                                            <strong>Our Office</strong>
                                            <span>1 Solar Drive, Helios Tower, San Francisco, CA</span>
                                        </div>
                                    </div>
                                    <div class="contact__info-card" data-reveal="true" data-reveal-delay="2">
                                        <div class="contact__info-icon">
                                            <iconify-icon icon="mdi:phone-outline" width="22"
                                                          height="22"/>
                                        </div>
                                        <div>
                                            <strong>Phone</strong>
                                            <span>+1 (888) SOLARION</span>
                                        </div>
                                    </div>
                                    <div class="contact__info-card" data-reveal="true" data-reveal-delay="3">
                                        <div class="contact__info-icon">
                                            <iconify-icon icon="mdi:email-outline" width="22"
                                                          height="22"/>
                                        </div>
                                        <div>
                                            <strong>Email</strong>
                                            <span>hello@solarion.energy</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="contact__right" data-reveal="true" data-reveal-delay="2">
                                <form class="contact__form" action="/solarion/contact/submit" method="POST"
                                      id="solarionContactForm">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="form__header">
                                        <h3>Request a Free Quote</h3>
                                        <p>We'll get back to you within 24 hours</p>
                                    </div>

                                    <div id="formErrorMsg"
                                         style="display: none; color: #dc3545; background-color: #f8d7da; padding: 10px; border-radius: 5px; margin-bottom: 15px; font-weight: 500;">
                                        Please fill the required fields.
                                    </div>

                                    <div class="form__row">
                                        <div class="form__group">
                                            <label>Full Name *</label>
                                            <input type="text" name="contact_name" id="c_name" placeholder="John Doe"/>
                                        </div>
                                        <div class="form__group">
                                            <label>Email Address *</label>
                                            <input type="email" name="email_from" id="c_email"
                                                   placeholder="john@example.com"/>
                                        </div>
                                    </div>
                                    <div class="form__row">
                                        <div class="form__group">
                                            <label>Phone Number *</label>
                                            <input type="tel" name="phone" id="c_phone"
                                                   placeholder="+1 (555) 000-0000"/>
                                        </div>
                                        <div class="form__group">
                                            <label>Property Type</label>
                                            <select name="property_type">
                                                <option value="">Select type...</option>
                                                <option value="Residential">Residential</option>
                                                <option value="Commercial">Commercial</option>
                                                <option value="Industrial">Industrial</option>
                                                <option value="Municipal / Government">Municipal / Government</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form__group">
                                        <label>Solution Interest</label>
                                        <select name="solution_interest">
                                            <option value="">Select a solution...</option>
                                            <option value="Quantum Solar Panels">Quantum Solar Panels</option>
                                            <option value="Neural Battery Grid">Neural Battery Grid</option>
                                            <option value="Smart City Integration">Smart City Integration</option>
                                            <option value="Remote Monitoring">Remote Monitoring</option>
                                        </select>
                                    </div>
                                    <div class="form__group">
                                        <label>Your Message</label>
                                        <textarea name="description" rows="4"
                                                  placeholder="Tell us about your energy goals and current setup..."/>
                                    </div>
                                    <button type="submit" class="btn btn--primary btn--full btn--lg">
                                        Send Message
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2">
                                            <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/>
                                        </svg>
                                    </button>
                                    <p class="form__note">
                                        <iconify-icon icon="mdi:lock-outline" width="14" height="14"/>
                                        Your information is secure. No spam, ever.
                                    </p>
                                    <script type="text/javascript">
                                        document.addEventListener("DOMContentLoaded", function() {
                                        var form = document.getElementById('solarionContactForm');
                                        var errorMsg = document.getElementById('formErrorMsg');
                                        form.addEventListener('submit', function(e) {
                                        var name = document.getElementById('c_name').value.trim();
                                        var email = document.getElementById('c_email').value.trim();
                                        var phone = document.getElementById('c_phone').value.trim();
                                        if(!name || !email || !phone) {
                                        e.preventDefault();
                                        errorMsg.style.display = 'block';
                                        } else {
                                        errorMsg.style.display = 'none';
                                        }
                                        });
                                        });
                                    </script>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- WHY CHOOSE SOLARION -->
                <section class="dark-section lp-overlap">
                    <div class="dark-section__parallax">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar field"/>
                        <div class="dark-section__overlay"/>
                    </div>
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">Why Solarion</div>
                            <h2 class="section__title section__title--white">What Sets Us
                                <span class="gradient-text-light">Apart</span>
                            </h2>
                            <p class="section__desc" style="color:rgba(255,255,255,0.5)">Three reasons thousands of
                                customers choose Solarion over every other solar provider.
                            </p>
                        </div>
                        <div class="trust-grid">
                            <div class="trust-item" data-reveal="true" data-reveal-delay="1">
                                <div class="trust-item__icon">
                                    <iconify-icon icon="mdi:lightning-bolt" width="40" height="40"/>
                                </div>
                                <h4>Fastest ROI</h4>
                                <p>Customers typically see payback within 4–6 years — and enjoy free energy for the
                                    remaining 44 years of the panel's lifespan.
                                </p>
                            </div>
                            <div class="trust-item" data-reveal="true" data-reveal-delay="2">
                                <div class="trust-item__icon">
                                    <iconify-icon icon="mdi:shield-check-outline" width="40" height="40"/>
                                </div>
                                <h4>Lifetime Warranty</h4>
                                <p>Every product we install carries a lifetime performance warranty. If anything fails,
                                    we fix or replace it — at no cost to you. Ever.
                                </p>
                            </div>
                            <div class="trust-item" data-reveal="true" data-reveal-delay="3">
                                <div class="trust-item__icon">
                                    <iconify-icon icon="mdi:handshake-outline" width="40" height="40"/>
                                </div>
                                <h4>Dedicated Support</h4>
                                <p>A named account manager plus 24/7 remote monitoring. We don't disappear after
                                    installation — we're with you for the life of your system.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- FAQ -->
                <section class="section lp-overlap-white">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">FAQ</div>
                            <h2 class="section__title">Common
                                <span class="gradient-text">Questions</span>
                            </h2>
                            <p class="section__desc">Everything you need to know before getting started.</p>
                        </div>
                        <div style="max-width:760px; margin:0 auto;" data-reveal="true">
                            <div class="faq-list">
                                <div class="faq-item open">
                                    <div class="faq-item__q">How long does installation take?
                                        <span>+</span>
                                    </div>
                                    <div class="faq-item__a">Most residential installations are completed within 1–2
                                        days. Commercial and utility-scale projects vary by size, but our team handles
                                        all permits, grid connection paperwork, and commissioning so you don't have to.
                                    </div>
                                </div>
                                <div class="faq-item">
                                    <div class="faq-item__q">What happens if my panels produce more energy than I use?
                                        <span>+</span>
                                    </div>
                                    <div class="faq-item__a">Surplus energy flows back to the grid through our
                                        net-metering integration, earning you credits on your electricity bill. With our
                                        Neural Battery Grid add-on, you can also store excess energy for use at night or
                                        on cloudy days.
                                    </div>
                                </div>
                                <div class="faq-item">
                                    <div class="faq-item__q">Do the panels work on cloudy days?
                                        <span>+</span>
                                    </div>
                                    <div class="faq-item__a">Yes. Our QD panels capture diffuse light, so they continue
                                        generating power even on overcast days — just at a reduced rate. Our AI system
                                        automatically compensates for changing light conditions to maximise output in
                                        all weather.
                                    </div>
                                </div>
                                <div class="faq-item">
                                    <div class="faq-item__q">What financing options are available?
                                        <span>+</span>
                                    </div>
                                    <div class="faq-item__a">We offer a range of financing options including zero-down
                                        solar loans, power purchase agreements (PPAs), and leasing — so you can switch
                                        to solar with no upfront cost. Our advisors will recommend the best option for
                                        your situation.
                                    </div>
                                </div>
                                <div class="faq-item">
                                    <div class="faq-item__q">How does the monitoring system work?
                                        <span>+</span>
                                    </div>
                                    <div class="faq-item__a">Every panel streams live data to our cloud platform: power
                                        output, temperature, health score, and 200+ additional metrics. You can track
                                        everything from our mobile app, and our AI automatically flags any issues —
                                        usually before they affect performance.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
