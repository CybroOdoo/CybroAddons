<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view of solarion product -->
    <record id="solarion_product_view_tree" model="ir.ui.view">
        <field name="name">solarion.product.view.tree</field>
        <field name="model">solarion.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <field name="name"/>
                <field name="efficiency"/>
                <field name="lifespan"/>
                <field name="warranty"/>
            </list>
        </field>
    </record>
    <!-- Action window -->
    <record id="solarion_product_view_form" model="ir.ui.view">
        <field name="name">solarion.product.view.form</field>
        <field name="model">solarion.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Product Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="efficiency"/>
                            <field name="lifespan"/>
                        </group>
                        <group>
                            <field name="warranty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action window -->
    <record id="action_solarion_product" model="ir.actions.act_window">
        <field name="name">Solarion Products</field>
        <field name="res_model">solarion.product</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Menu item-->
    <menuitem id="menu_solarion_product"
              name="Solarion Products"
              parent="website.menu_website_global_configuration"
              action="action_solarion_product"
              sequence="100"/>
</odoo>
