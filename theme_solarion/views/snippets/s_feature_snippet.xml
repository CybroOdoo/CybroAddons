<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_feature" name="Solarion Feature">
        <!-- FEATURES -->
        <section class="features-section section lp-overlap-light">
            <div class="container">
                <div class="section__header">
                    <div class="section__eyebrow">Why Solarion</div>
                    <h2 class="section__title">Built Different.
                        <span class="gradient-text">Built to Last.</span>
                    </h2>
                    <p class="section__desc">Three breakthrough innovations converge in every Solarion system.</p>
                </div>
                <div class="features-grid">
                    <div class="feature-tile feature-tile--tall" data-reveal-delay="1">
                        <div class="feature-tile__img">
                            <img src="https://images.unsplash.com/photo-1611365892117-00ac5ef43c90?w=800&amp;q=85&amp;fit=crop"
                                 alt="Quantum panels"/>
                        </div>
                        <div class="feature-tile__body">
                            <div class="feature-tile__icon">
                                <iconify-icon icon="mdi:lightning-bolt" width="36" height="36"/>
                            </div>
                            <h3>Quantum Efficiency</h3>
                            <p>Multi-spectrum QD arrays capture UV, visible, and near-IR simultaneously — delivering 47%
                                real-world efficiency, double the industry average.
                            </p>
                            <a href="/technology" class="feature-tile__link">Explore Technology →</a>
                        </div>
                    </div>
                    <div class="feature-tile" data-reveal-delay="2">
                        <div class="feature-tile__img">
                            <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&amp;q=85&amp;fit=crop"
                                 alt="AI dashboard"/>
                        </div>
                        <div class="feature-tile__body">
                            <div class="feature-tile__icon">
                                <iconify-icon icon="mdi:robot-outline" width="36" height="36"/>
                            </div>
                            <h3>Neural AI Brain</h3>
                            <p>Self-optimizing algorithms adjust power output 10,000× per second to maximize capture in
                                any weather condition, anywhere on Earth.
                            </p>
                            <a href="/technology" class="feature-tile__link">See AI in Action →</a>
                        </div>
                    </div>
                    <div class="feature-tile" data-reveal-delay="3">
                        <div class="feature-tile__img">
                            <img src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=800&amp;q=85&amp;fit=crop"
                                 alt="Solar grid array"/>
                        </div>
                        <div class="feature-tile__body">
                            <div class="feature-tile__icon">
                                <iconify-icon icon="mdi:earth" width="36" height="36"/>
                            </div>
                            <h3>Universal Grid Connect</h3>
                            <p>Open-protocol integration works seamlessly with any municipal, commercial, or residential
                                grid — no proprietary lock-in, ever.
                            </p>
                            <a href="/solutions" class="feature-tile__link">View Solutions →</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>