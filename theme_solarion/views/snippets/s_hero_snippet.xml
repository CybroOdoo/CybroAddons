<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_hero" name="Solarion About">
        <!-- HERO -->
        <section class="hero" id="home">
            <div class="hero__bg">
                <img class="parallax-img"
                     src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1920&amp;q=90&amp;fit=crop"
                     alt="Solar panels" loading="eager"/>
                <div class="hero__overlay"/>
            </div>

            <div class="hero__content">
                <p class="hero__label">Next-Generation Solar Technology</p>
                <h1 class="hero__title">Powering the World<br/>with Intelligent Solar
                </h1>
                <p class="hero__subtitle">Quantum-dot photovoltaics and AI-driven energy management — delivering up to
                    47% efficiency for homes, businesses, and cities.
                </p>
                <div class="hero__cta-row">
                    <a href="/solutions" class="btn btn--hero-primary">Explore Solutions</a>
                    <a href="/technology" class="btn btn--hero-ghost">How It Works →</a>
                </div>
            </div>

            <div class="hero__stats-bar">
                <div class="hero__stat">
                    <strong>47%</strong>
                    <span>Panel Efficiency</span>
                </div>
                <div class="hero__stat-sep"/>
                <div class="hero__stat">
                    <strong>2.4 GW</strong>
                    <span>Capacity Deployed</span>
                </div>
                <div class="hero__stat-sep"/>
                <div class="hero__stat">
                    <strong>34+</strong>
                    <span>Countries Active</span>
                </div>
                <div class="hero__stat-sep"/>
                <div class="hero__stat">
                    <strong>850K</strong>
                    <span>Homes Powered</span>
                </div>
            </div>

            <a href="#mission" class="hero__scroll-hint">
                <span>Scroll</span>
                <div class="scroll-line"/>
            </a>
        </section>

    </template>
</odoo>