<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_product" name="Solarion Product">
        <!-- PRODUCT SPOTLIGHT -->
        <section class="spotlight-section section lp-overlap-light">
            <div class="container">
                <div class="spotlight-grid">
                    <div class="spotlight-img-col" data-reveal-delay="1">
                        <div class="spotlight-img-wrap">
                            <img src="/theme_solarion/static/src/images/solar_building.jpeg"
                                 alt="Quantum solar panel"/>
                            <div class="spotlight-tag">
                                <iconify-icon icon="mdi:star" width="13" height="13"></iconify-icon>
                                Most Popular
                            </div>
                            <div class="spotlight-specs">
                                <div class="sspec">
                                    <span>Efficiency</span>
                                    <strong>47%</strong>
                                </div>
                                <div class="sspec">
                                    <span>Lifespan</span>
                                    <strong>50 yrs</strong>
                                </div>
                                <div class="sspec">
                                    <span>Warranty</span>
                                    <strong>Lifetime</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="spotlight-text-col" data-reveal-delay="2">
                        <div class="section__eyebrow">Featured Product</div>
                        <h2 class="section__title">Quantum Solar
                            <span class="gradient-text">Panels</span>
                        </h2>
                        <div class="spotlight-divider"></div>
                        <p class="spotlight-body">Third-generation QD photovoltaic arrays that capture UV, visible, and
                            near-IR spectra simultaneously — redefining what's possible in renewable energy. Every panel
                            includes a built-in micro-inverter and real-time telemetry.
                        </p>
                        <ul class="spotlight-bullets">
                            <li>
                                <span class="bullet-check">✓</span>
                                Multi-spectrum quantum dot absorption
                            </li>
                            <li>
                                <span class="bullet-check">✓</span>
                                Self-cleaning nano-coating surface
                            </li>
                            <li>
                                <span class="bullet-check">✓</span>
                                Built-in micro-inverter per panel
                            </li>
                            <li>
                                <span class="bullet-check">✓</span>
                                Real-time per-panel telemetry
                            </li>
                            <li>
                                <span class="bullet-check">✓</span>
                                50-year guaranteed lifespan
                            </li>
                        </ul>
                        <div class="spotlight-actions">
                            <a href="/solutions" class="btn btn--primary">View All Solutions →</a>
                            <a href="/contact" class="spotlight-link">Get Free Assessment</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>