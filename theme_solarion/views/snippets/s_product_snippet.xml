<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_product" name="Solarion Product">
       <!-- PRODUCT SPOTLIGHT -->
                <t t-set="all_products" t-value="request.env['solarion.product'].sudo().search([])"/>
                <t t-set="featured_product" t-value="all_products and all_products[0] or None"/>
                <section class="spotlight-section section lp-overlap-light">
                    <div class="container">
                        <t t-if="featured_product">
                            <div class="spotlight-grid">
                                <div class="spotlight-img-col" data-reveal-delay="1">
                                    <div class="spotlight-img-wrap">
                                        <img t-if="featured_product.image"
                                             t-attf-src="/web/image/solarion.product/#{featured_product.id}/image"
                                             t-att-alt="featured_product.name"/>
                                        <img t-else=""
                                             src="https://images.unsplash.com/photo-1611365892117-00ac5ef43c90?w=900&amp;q=85&amp;fit=crop"
                                             alt="Quantum solar panel"/>
                                        <div class="spotlight-tag">
                                            <iconify-icon icon="mdi:star" width="13" height="13"/>
                                            Most Popular
                                        </div>
                                        <div class="spotlight-specs">
                                            <div class="sspec">
                                                <span>Efficiency</span>
                                                <strong>
                                                    <t t-out="featured_product.efficiency"/>
                                                </strong>
                                            </div>
                                            <div class="sspec">
                                                <span>Lifespan</span>
                                                <strong>
                                                    <t t-out="featured_product.lifespan"/>
                                                </strong>
                                            </div>
                                            <div class="sspec">
                                                <span>Warranty</span>
                                                <strong>
                                                    <t t-out="featured_product.warranty"/>
                                                </strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="spotlight-text-col" data-reveal-delay="2">
                                    <div class="section__eyebrow">Featured Product</div>
                                    <h2 class="section__title">
                                        <t t-out="featured_product.name"/>
                                    </h2>
                                    <div class="spotlight-divider"/>
                                    <div class="spotlight-body">
                                        <div t-field="featured_product.description"/>
                                    </div>
                                    <div class="spotlight-actions">
                                        <a href="/solutions" class="btn btn--primary">View All Solutions →</a>
                                        <a href="/contactus" class="spotlight-link">Get Free Assessment</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="spotlight-grid">
                                <div class="spotlight-img-col" data-reveal-delay="1">
                                    <div class="spotlight-img-wrap">
                                        <img src="https://images.unsplash.com/photo-1611365892117-00ac5ef43c90?w=900&amp;q=85&amp;fit=crop"
                                             alt="Quantum solar panel"/>
                                        <div class="spotlight-tag">
                                            <iconify-icon icon="mdi:star" width="13" height="13"/>
                                            Most Popular
                                        </div>
                                        <div class="spotlight-specs">
                                            <div class="sspec">
                                                <span>Efficiency</span>
                                                <strong>47%</strong>
                                            </div>
                                            <div class="sspec">
                                                <span>Lifespan</span>
                                                <strong>50yr</strong>
                                            </div>
                                            <div class="sspec">
                                                <span>Warranty</span>
                                                <strong>Lifetime</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="spotlight-text-col" data-reveal-delay="2">
                                    <div class="section__eyebrow">Featured Product</div>
                                    <h2 class="section__title">Solarion Quantum X1</h2>
                                    <div class="spotlight-divider"/>
                                    <div class="spotlight-body">
                                        <p>The Quantum X1 represents a fundamental shift in photovoltaic technology. By leveraging multi-spectrum quantum dots, the X1 captures not just visible light, but ultraviolet and near-infrared spectrums simultaneously. This results in unprecedented energy generation even on cloudy days.</p>
                                    </div>
                                    <div class="spotlight-actions">
                                        <a href="/solutions" class="btn btn--primary">View All Solutions →</a>
                                        <a href="/contactus" class="spotlight-link">Get Free Assessment</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>
    </template>
</odoo>