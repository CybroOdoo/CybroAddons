<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_impact" name="Solarion Impact">
        <!-- IMPACT NUMBERS -->
        <section class="impact-home lp-overlap">
            <div class="impact-home__parallax-wrap">
                <img class="parallax-img"
                     src="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=1920&amp;q=80&amp;fit=crop"
                     alt="Solar landscape"/>
                <div class="impact-home__overlay"/>
            </div>
            <div class="container impact-home__inner">
                <div class="section__header">
                    <div class="section__eyebrow section__eyebrow--light">Global Impact</div>
                    <h2 class="section__title section__title--white">Our Numbers
                        <span class="gradient-text-light">Speak Loudly</span>
                    </h2>
                </div>
                <div class="impact-home__counters">
                    <div class="impact-home__counter" data-reveal-delay="1">
                        <div class="impact-home__val" data-count="2400000">0</div>
                        <div class="impact-home__unit">Tonnes / yr</div>
                        <div class="impact-home__label">CO₂ Offset Annually</div>
                    </div>
                    <div class="impact-home__counter" data-reveal-delay="2">
                        <div class="impact-home__val" data-count="850000">0</div>
                        <div class="impact-home__unit">Homes</div>
                        <div class="impact-home__label">Powered by Solarion</div>
                    </div>
                    <div class="impact-home__counter" data-reveal-delay="3">
                        <div class="impact-home__val" data-count="34">0</div>
                        <div class="impact-home__unit">Countries</div>
                        <div class="impact-home__label">Active Deployments</div>
                    </div>
                    <div class="impact-home__counter" data-reveal-delay="4">
                        <div class="impact-home__val" data-count="2400">0</div>
                        <div class="impact-home__unit">GW Installed</div>
                        <div class="impact-home__label">Total Capacity</div>
                    </div>
                </div>
                <div class="impact-home__cta">
                    <a href="/impact" class="btn btn--outline-white">See Full Impact Report →</a>
                </div>
            </div>
        </section>
    </template>
</odoo>