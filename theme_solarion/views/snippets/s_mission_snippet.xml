<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_mission" name="Solarion Mission">
        <!-- MISSION -->
        <section class="mission-section lp-overlap" id="mission">
            <div class="mission__parallax-wrap">
                <img class="parallax-img"
                     src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=1920&amp;q=85&amp;fit=crop"
                     alt="Solar energy"/>
                <div class="mission__overlay"/>
            </div>
            <div class="container-fluid mission__container">
                <div class="mission__left">
                    <div class="section__eyebrow section__eyebrow--light">Our Mission</div>
                    <h2 class="mission__headline">
                        The future of energy is here.
                        <br/>
                        And it's
                        <span class="gradient-text-light">brilliantly simple.</span>
                    </h2>
                    <p class="mission__body">Founded in 2019, Solarion merges quantum photovoltaics with artificial
                        intelligence to make clean, intelligent energy accessible to everyone — from a single home to an
                        entire city grid.
                    </p>
                    <a href="/about" class="btn btn--outline-white">Our Story →</a>
                </div>
                <div class="mission__right" data-reveal-delay="2">
                    <div class="mission__metrics-grid">
                        <div class="mission__metric">
                            <span class="mission__metric-val">47%</span>
                            <span class="mission__metric-label">Panel Efficiency</span>
                        </div>
                        <div class="mission__metric">
                            <span class="mission__metric-val">50yr</span>
                            <span class="mission__metric-label">Lifespan</span>
                        </div>
                        <div class="mission__metric">
                            <span class="mission__metric-val">AI</span>
                            <span class="mission__metric-label">Powered</span>
                        </div>
                        <div class="mission__metric">
                            <span class="mission__metric-val">6+</span>
                            <span class="mission__metric-label">Years Innovation</span>
                        </div>
                    </div>
                    <div class="mission__img-accent">
                        <img src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=600&amp;q=85&amp;fit=crop"
                             alt="Aerial solar farm"/>
                        <div class="mission__img-badge">
                            <iconify-icon icon="mdi:medal-outline" width="22" height="22"/>
                            <div>
                                <strong>ISO 9001</strong>
                                <span>Certified</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>