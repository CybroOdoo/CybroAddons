<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_process" name="Solarion Process">
        <!-- PROCESS -->
                  <section class="process-section lp-overlap">
                    <div class="container">
                      <div class="section__header">
                        <div class="section__eyebrow">How It Works</div>
                        <h2 class="section__title">From Sunlight to <span class="gradient-text">Savings</span></h2>
                        <p class="section__desc">Four intelligent stages — from photon capture to lower electricity bills.</p>
                      </div>
                      <div class="process-steps">
                        <div class="process-step" data-reveal-delay="1">
                          <div class="process-step__num">01</div>
                          <div class="process-step__icon-wrap"><iconify-icon icon="mdi:white-balance-sunny" width="40" height="40"/></div>
                          <h4>Capture</h4>
                          <p>QD panels absorb sunlight across UV, visible, and near-IR wavelengths — extracting energy from every photon that hits your roof.</p>
                        </div>
                        <div class="process-connector" data-reveal-delay="2"/>
                        <div class="process-step" data-reveal-delay="2">
                          <div class="process-step__num">02</div>
                          <div class="process-step__icon-wrap"><iconify-icon icon="mdi:cog-outline" width="40" height="40"/></div>
                          <h4>Convert</h4>
                          <p>Neural MPPT algorithms optimize power conversion 10,000× per second, achieving 98% conversion efficiency in real-world conditions.</p>
                        </div>
                        <div class="process-connector" data-reveal-delay="3"/>
                        <div class="process-step" data-reveal-delay="3">
                          <div class="process-step__num">03</div>
                          <div class="process-step__icon-wrap"><iconify-icon icon="mdi:battery-charging-outline" width="40" height="40"/></div>
                          <h4>Store &amp; Route</h4>
                          <p>Solid-state batteries store excess energy. Smart load balancing routes power to your home, storage, or the grid instantly.</p>
                        </div>
                        <div class="process-connector" data-reveal-delay="4"/>
                        <div class="process-step" data-reveal-delay="4">
                          <div class="process-step__num">04</div>
                          <div class="process-step__icon-wrap"><iconify-icon icon="mdi:chart-line" width="40" height="40"/></div>
                          <h4>Monitor &amp; Learn</h4>
                          <p>Edge AI tracks 200+ metrics per panel. Your system learns, predicts failures weeks ahead, and improves efficiency every day.</p>
                        </div>
                      </div>
                      <div class="process-cta">
                        <a href="/technology" class="btn btn--primary">Explore Full Technology →</a>
                      </div>
                    </div>
                  </section>
    </template>
</odoo>