<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <template id="solarion_snippets" inherit_id="website.snippets" name="Solarion Snippets">
            <xpath expr="//snippets[@id='snippet_groups']" position="inside">
                <t snippet-group="solarion_hero" t-snippet="theme_solarion.s_hero" t-thumbnail="/theme_solarion/static/src/images/snippets/s_hero.png"/>
                <t snippet-group="solarion_mission" t-snippet="theme_solarion.s_mission" t-thumbnail="/theme_solarion/static/src/images/snippets/s_mission.png"/>
                <t snippet-group="solarion_feature" t-snippet="theme_solarion.s_feature" t-thumbnail="/theme_solarion/static/src/images/snippets/s_feature.png"/>
                <t snippet-group="solarion_product" t-snippet="theme_solarion.s_product" t-thumbnail="/theme_solarion/static/src/images/snippets/s_product.png"/>
                <t snippet-group="solarion_process" t-snippet="theme_solarion.s_process" t-thumbnail="/theme_solarion/static/src/images/snippets/s_process.png"/>
                <t snippet-group="solarion_impact" t-snippet="theme_solarion.s_impact" t-thumbnail="/theme_solarion/static/src/images/snippets/s_impact.png"/>
                <t snippet-group="solarion_testimonial" t-snippet="theme_solarion.s_testimonial" t-thumbnail="/theme_solarion/static/src/images/snippets/s_testimonial.png"/>
                <t snippet-group="solarion_insight" t-snippet="theme_solarion.s_insight" t-thumbnail="/theme_solarion/static/src/images/snippets/s_solarion.png"/>
                <t snippet-group="solarion_cta" t-snippet="theme_solarion.s_cta" t-thumbnail="/theme_solarion/static/src/images/snippets/s_cta.png"/>
            </xpath>
            <xpath expr="//snippets[@id='snippet_structure']" position="inside">
                <t t-snippet="theme_solarion.s_hero" string="Hero" group="solarion_hero"/>
                <t t-snippet="theme_solarion.s_mission" string="Mission" group="solarion_mission"/>
                <t t-snippet="theme_solarion.s_feature" string="Feature" group="solarion_feature"/>
                <t t-snippet="theme_solarion.s_product" string="Product Spotlight" group="solarion_product"/>
                <t t-snippet="theme_solarion.s_process" string="Process" group="solarion_process"/>
                <t t-snippet="theme_solarion.s_impact" string="Impact" group="solarion_impact"/>
                <t t-snippet="theme_solarion.s_testimonial" string="Testimonial" group="solarion_testimonial"/>
                <t t-snippet="theme_solarion.s_insight" string="Insight" group="solarion_insight"/>
                <t t-snippet="theme_solarion.s_cta" string="Cta" group="solarion_cta"/>
            </xpath>
        </template>
</odoo>
