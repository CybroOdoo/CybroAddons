<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="greenscape_snippets" inherit_id="website.snippets" name="Greenscape Snippets">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_solarion.s_hero"
               t-thumbnail="/theme_solarion/static/src/snippet_thumbnails/solarian_about.png"/>
            <t t-snippet="theme_solarion.s_mission"
               t-thumbnail="/theme_solarion/static/src/snippet_thumbnails/solar_mission.png"/>
            <t t-snippet="theme_solarion.s_feature"
               t-thumbnail="/theme_solarion/static/src/snippet_thumbnails/solarian_version.png"/>
            <t t-snippet="theme_solarion.s_product"
               t-thumbnail="/theme_solarion/static/src/snippet_thumbnails/solarian_product.png"/>
            <t t-snippet="theme_solarion.s_process"
               t-thumbnail="/theme_solarion/static/src/snippet_thumbnails/solarian_process.png"/>
            <t t-snippet="theme_solarion.s_impact"
               t-thumbnail="/theme_solarion/static/src/snippet_thumbnails/solarian_impact.png"/>
            <t t-snippet="theme_solarion.s_testimonial"
               t-thumbnail="/theme_solarion/static/src/snippet_thumbnails/Solarion_Testimonial.png"/>
            <t t-snippet="theme_solarion.s_insight"
               t-thumbnail="/theme_solarion/static/src/snippet_thumbnails/Solarion_Insight.png"/>
            <t t-snippet="theme_solarion.s_cta"
               t-thumbnail="/theme_solarion/static/src/snippet_thumbnails/Solarion_About.png"/>
        </xpath>
    </template>
</odoo>
