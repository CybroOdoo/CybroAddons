<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Impact template -->
    <template id="page_impact" name="Impact">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty solarion-theme">
                <!-- PAGE HERO -->
                <section class="page-hero">
                    <div class="page-hero__bg">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar energy landscape"/>
                        <div class="page-hero__bg-overlay"/>
                    </div>
                    <div class="container">
                        <div class="page-hero__eyebrow">Global Impact</div>
                        <h1 class="page-hero__title">Numbers That
                            <span class="gradient-text-light">Define Our Future</span>
                        </h1>
                        <p class="page-hero__desc">Real-world results from real deployments. The measurable difference
                            Solarion is making across 34 countries and counting.
                        </p>
                    </div>
                </section>

                <!-- IMPACT HIGHLIGHTS STRIP -->
                <section class="impact-strip lp-overlap">
                    <div class="container">
                        <div class="impact-strip__grid">
                            <div class="impact-strip__item" data-reveal="true" data-reveal-delay="1">
                                <div class="impact-strip__icon">
                                    <iconify-icon icon="mdi:leaf" width="28" height="28"/>
                                </div>
                                <div class="impact-strip__body">
                                    <strong>Carbon Neutral by 2028</strong>
                                    <span>Verified offsets across all 34 active deployments, tracked in real time.
                                    </span>
                                </div>
                            </div>
                            <div class="impact-strip__item" data-reveal="true" data-reveal-delay="2">
                                <div class="impact-strip__icon">
                                    <iconify-icon icon="mdi:lightning-bolt" width="28" height="28"/>
                                </div>
                                <div class="impact-strip__body">
                                    <strong>47% Panel Efficiency</strong>
                                    <span>Industry-leading quantum-dot technology, validated by third-party labs.</span>
                                </div>
                            </div>
                            <div class="impact-strip__item" data-reveal="true" data-reveal-delay="3">
                                <div class="impact-strip__icon">
                                    <iconify-icon icon="mdi:shield-check-outline" width="28" height="28"/>
                                </div>
                                <div class="impact-strip__body">
                                    <strong>ISO 14001 Certified</strong>
                                    <span>Full environmental management compliance across every installation site.
                                    </span>
                                </div>
                            </div>
                            <div class="impact-strip__item" data-reveal="true" data-reveal-delay="4">
                                <div class="impact-strip__icon">
                                    <iconify-icon icon="mdi:chart-line" width="28" height="28"/>
                                </div>
                                <div class="impact-strip__body">
                                    <strong>$2.1B Saved for Customers</strong>
                                    <span>Cumulative energy bill savings since Solarion's first commercial deployment.
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- COUNTERS -->
                <section class="impact-home lp-overlap">
                    <div class="impact-home__parallax-wrap">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar field"/>
                        <div class="impact-home__overlay"/>
                    </div>
                    <div class="container impact-home__inner">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow" style="color:rgba(253,186,116,0.9)">Live Totals</div>
                            <h2 class="section__title section__title--white">Our Numbers
                                <span class="gradient-text-light">Keep Growing</span>
                            </h2>
                        </div>
                        <div class="impact-home__counters">
                            <div class="impact-home__counter" data-reveal="true" data-reveal-delay="1">
                                <div class="impact-home__val" data-count="2400000">0</div>
                                <div class="impact-home__unit">Tonnes / yr</div>
                                <div class="impact-home__label">CO₂ Offset Annually</div>
                            </div>
                            <div class="impact-home__counter" data-reveal="true" data-reveal-delay="2">
                                <div class="impact-home__val" data-count="850000">0</div>
                                <div class="impact-home__unit">Homes</div>
                                <div class="impact-home__label">Powered by Solarion</div>
                            </div>
                            <div class="impact-home__counter" data-reveal="true" data-reveal-delay="3">
                                <div class="impact-home__val" data-count="34">0</div>
                                <div class="impact-home__unit">Countries</div>
                                <div class="impact-home__label">Active Deployments</div>
                            </div>
                            <div class="impact-home__counter" data-reveal="true" data-reveal-delay="4">
                                <div class="impact-home__val" data-count="2400">0</div>
                                <div class="impact-home__unit">GW Installed</div>
                                <div class="impact-home__label">Total Capacity</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TESTIMONIALS -->
                <section class="testimonials section lp-overlap-light">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">What People Say</div>
                            <h2 class="section__title">Trusted by
                                <span class="gradient-text">Industry Leaders</span>
                            </h2>
                            <p class="section__desc">From city councils to offshore oil platforms — real stories from
                                real customers.
                            </p>
                        </div>
                        <div class="testimonials__grid">
                            <div class="testimonial-card" data-reveal="true" data-reveal-delay="1">
                                <div class="testimonial-card__top">
                                    <div class="testimonial-card__stars">★★★★★</div>
                                    <div class="testimonial-card__logo">NT</div>
                                </div>
                                <p class="testimonial-card__quote">"Solarion's AI grid cut our facility's energy cost by
                                    68% in the first year. The predictive maintenance alone has saved us hundreds of
                                    thousands."
                                </p>
                                <div class="testimonial-card__author">
                                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=80&amp;h=80&amp;fit=crop&amp;crop=face&amp;q=80"
                                         alt="Amir Khalid"/>
                                    <div>
                                        <strong>Amir Khalid</strong>
                                        <span>CTO, NovaTech Industries</span>
                                    </div>
                                </div>
                            </div>
                            <div class="testimonial-card testimonial-card--featured" data-reveal="true"
                                 data-reveal-delay="2">
                                <div class="testimonial-card__top">
                                    <div class="testimonial-card__stars">★★★★★</div>
                                    <div class="testimonial-card__logo">HC</div>
                                </div>
                                <p class="testimonial-card__quote">"Installing Solarion's quantum panels was a
                                    statement. The performance data is unreal — we are now energy-positive, exporting
                                    back to the grid every single day."
                                </p>
                                <div class="testimonial-card__author">
                                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=80&amp;h=80&amp;fit=crop&amp;crop=face&amp;q=80"
                                         alt="Sofia Lindqvist"/>
                                    <div>
                                        <strong>Sofia Lindqvist</strong>
                                        <span>Mayor, Helios City Council</span>
                                    </div>
                                </div>
                            </div>
                            <div class="testimonial-card" data-reveal="true" data-reveal-delay="3">
                                <div class="testimonial-card__top">
                                    <div class="testimonial-card__stars">★★★★★</div>
                                    <div class="testimonial-card__logo">OC</div>
                                </div>
                                <p class="testimonial-card__quote">"The space-grade panels survived our offshore
                                    platform's brutal conditions without a single failure in 3 years. This is
                                    engineering at its finest."
                                </p>
                                <div class="testimonial-card__author">
                                    <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=80&amp;h=80&amp;fit=crop&amp;crop=face&amp;q=80"
                                         alt="Raj Nair"/>
                                    <div>
                                        <strong>Raj Nair</strong>
                                        <span>Operations Director, OceanCore Energy</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- GLOBAL REACH -->
                <section class="dark-section lp-overlap">
                    <div class="dark-section__parallax">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar farm"/>
                        <div class="dark-section__overlay"/>
                    </div>
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">Global Reach</div>
                            <h2 class="section__title section__title--white">Deployed Across
                                <span class="gradient-text-light">6 Continents</span>
                            </h2>
                            <p class="section__desc" style="color:rgba(255,255,255,0.5)">From the Arctic Circle to the
                                Sahara — our technology performs in every climate on Earth.
                            </p>
                        </div>
                        <div class="global-strip">
                            <div class="global-strip__item" data-reveal="true" data-reveal-delay="1">
                                <div class="global-strip__val">34</div>
                                <div class="global-strip__unit">Countries</div>
                                <div class="global-strip__label">Active Deployments</div>
                            </div>
                            <div class="global-strip__item" data-reveal="true" data-reveal-delay="2">
                                <div class="global-strip__val">6</div>
                                <div class="global-strip__unit">Continents</div>
                                <div class="global-strip__label">Global Coverage</div>
                            </div>
                            <div class="global-strip__item" data-reveal="true" data-reveal-delay="3">
                                <div class="global-strip__val">1,200+</div>
                                <div class="global-strip__unit">Projects</div>
                                <div class="global-strip__label">Completed Installations</div>
                            </div>
                            <div class="global-strip__item" data-reveal="true" data-reveal-delay="4">
                                <div class="global-strip__val">99.7%</div>
                                <div class="global-strip__unit">Uptime</div>
                                <div class="global-strip__label">Global Fleet Average</div>
                            </div>
                        </div>
                        <div style="text-align:center; margin-top:48px; position:relative; z-index:2;"
                             data-reveal="true">
                            <a href="/contactus" class="btn btn--outline-white">Start Your Project →</a>
                        </div>
                    </div>
                </section>

                <!-- CASE STUDIES -->
                <section class="insights-section section lp-overlap-white">
                    <div class="container">
                        <div class="section__header" data-reveal="true">
                            <div class="section__eyebrow">Case Studies</div>
                            <h2 class="section__title">Impact in
                                <span class="gradient-text">Action</span>
                            </h2>
                            <p class="section__desc">Three deployments, three very different challenges — one consistent
                                result.
                            </p>
                        </div>
                        <div class="insights-grid">
                            <article class="insight-card" data-reveal="true" data-reveal-delay="1">
                                <a href="#" class="insight-card__img-wrap">
                                    <img src="https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?w=600&amp;q=85&amp;fit=crop"
                                         alt="Smart city"/>
                                    <span class="insight-card__tag">Smart City</span>
                                </a>
                                <div class="insight-card__body">
                                    <p class="insight-card__date">Helios City, Germany</p>
                                    <h3 class="insight-card__title">City of 200K Goes 100% Solar in 18 Months</h3>
                                    <p class="insight-card__excerpt">Helios City partnered with Solarion to install a
                                        120 MW grid-connected solar infrastructure — now exporting surplus energy to
                                        neighbouring municipalities.
                                    </p>
                                    <a href="#" class="insight-card__link">Read Case Study →</a>
                                </div>
                            </article>
                            <article class="insight-card" data-reveal="true" data-reveal-delay="2">
                                <a href="#" class="insight-card__img-wrap">
                                    <img src="https://images.unsplash.com/photo-1497440001374-f26997328c1b?w=600&amp;q=85&amp;fit=crop"
                                         alt="Industrial solar installation"/>
                                    <span class="insight-card__tag">Industrial</span>
                                </a>
                                <div class="insight-card__body">
                                    <p class="insight-card__date">NovaTech, Singapore</p>
                                    <h3 class="insight-card__title">Manufacturing Facility Cuts Energy Bills by 68%</h3>
                                    <p class="insight-card__excerpt">NovaTech's 40,000 m² factory integrated our Neural
                                        Battery Grid to eliminate peak tariffs and achieve near-zero grid dependency
                                        during daylight hours.
                                    </p>
                                    <a href="#" class="insight-card__link">Read Case Study →</a>
                                </div>
                            </article>
                            <article class="insight-card" data-reveal="true" data-reveal-delay="3">
                                <a href="#" class="insight-card__img-wrap">
                                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&amp;q=85&amp;fit=crop"
                                         alt="Offshore monitoring"/>
                                    <span class="insight-card__tag">Offshore</span>
                                </a>
                                <div class="insight-card__body">
                                    <p class="insight-card__date">OceanCore, North Sea</p>
                                    <h3 class="insight-card__title">3 Years Zero Failures on Offshore Platform</h3>
                                    <p class="insight-card__excerpt">Space-grade Solarion panels on OceanCore's offshore
                                        rig withstood Category-4 storms, salt spray, and extreme temperature cycling —
                                        without a single maintenance call.
                                    </p>
                                    <a href="#" class="insight-card__link">Read Case Study →</a>
                                </div>
                            </article>
                        </div>
                    </div>
                </section>

                <!-- CTA -->
                <section class="cta-banner lp-overlap">
                    <div class="cta-banner__bg">
                        <img class="parallax-img"
                             src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=1920&amp;q=80&amp;fit=crop"
                             alt="Solar landscape"/>
                        <div class="cta-banner__overlay"/>
                    </div>
                    <div class="container cta-banner__content">
                        <div class="cta-banner__eyebrow">Join the Movement</div>
                        <h2>Add Your Story to Our
                            <span class="gradient-text-light">Impact Numbers</span>
                        </h2>
                        <p>Get a free energy assessment and custom quote. Save up to 80% on electricity bills from day
                            one.
                        </p>
                        <div class="cta-banner__actions">
                            <a href="/contactus" class="btn btn--white btn--lg">Get Free Assessment</a>
                            <a href="tel:18885627466" class="btn btn--outline-white btn--lg">
                                <iconify-icon icon="mdi:phone-outline" width="18" height="18"/>
                                Call Us Now
                            </a>
                        </div>
                        <div class="cta-banner__trust">
                            <span>✓ No commitment required</span>
                            <span>✓ Response within 24 hours</span>
                            <span>✓ Free site survey</span>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
