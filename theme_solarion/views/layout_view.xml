<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout" inherit_id="website.layout" name="Solarion Layout">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&amp;family=Inter:wght@300;400;500;600;700;800&amp;display=swap"
                  rel="stylesheet"/>
        </xpath>
        <xpath expr="//main" position="attributes">
            <attribute name="class" add="solarion-theme" separator=" "/>
        </xpath>
        <xpath expr="//header" position="replace">
            <header id="top">
                <div class="solarion-theme">
                    <nav class="nav" id="nav">
                        <a href="/" class="nav__logo">
                            <img src="/theme_solarion/static/src/images/logo.png" alt="Solarion" class="nav__logo-img"/>
                        </a>
                        <div class="nav__drawer" id="navDrawer">
                            <div class="nav__drawer-header">
                                <img src="/theme_solarion/static/src/images/logo.png" alt="Solarion"
                                     class="nav__logo-img"/>
                            </div>
                            <ul class="nav__links" id="navLinks">
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <li>
                                        <a t-att-href="submenu.url" t-attf-class="#{request.httprequest.path == submenu.url and 'active' or ''}">
                                            <span class="nav__link-num" t-esc="str(submenu_index + 1).zfill(2)"/>
                                            <t t-esc="submenu.name"/>
                                        </a>
                                    </li>
                                </t>
                            </ul>
                            <div class="nav__drawer-footer">
                                <a href="/contactus" class="nav__drawer-cta">Get a Quote →</a>
                            </div>
                        </div>
                        <div class="nav__right" style="display: flex; gap: 12px; align-items: center;">
                            <a href="/contactus" class="nav__login">Get a Quote →</a>
                            <t t-if="request.env.user._is_public()">
                                <a href="/web/login" class="nav__login">Sign In</a>
                            </t>
                            <t t-else="">
                                <div class="dropdown">
                                    <a href="#" class="nav__login dropdown-toggle" data-bs-toggle="dropdown" style="display: inline-flex; align-items: center; gap: 5px;">
                                        <t t-esc="request.env.user.name"/>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a href="/my/home" class="dropdown-item">My Account</a>
                                        <a href="/web/session/logout?redirect=/" class="dropdown-item">Logout</a>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <button class="nav__toggle" id="navToggle" aria-label="Menu">
                            <span/>
                            <span/>
                            <span/>
                        </button>
                    </nav>
                </div>
            </header>
        </xpath>
        <xpath expr="//footer" position="replace">
            <footer id="bottom">
                <div class="solarion-theme">
                    <div class="footer">
                        <div class="footer__top-band"/>
                        <div class="container">
                            <div class="footer__main">
                                <div class="footer__brand">
                                    <a href="/" class="footer__logo">
                                        <div class="nav__logo-icon">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                                <circle cx="12" cy="12" r="4.5" fill="#fff"/>
                                                <line x1="12" y1="2" x2="12" y2="5.5" stroke="#fff" stroke-width="2"
                                                      stroke-linecap="round"/>
                                                <line x1="12" y1="18.5" x2="12" y2="22" stroke="#fff" stroke-width="2"
                                                      stroke-linecap="round"/>
                                                <line x1="2" y1="12" x2="5.5" y2="12" stroke="#fff" stroke-width="2"
                                                      stroke-linecap="round"/>
                                                <line x1="18.5" y1="12" x2="22" y2="12" stroke="#fff" stroke-width="2"
                                                      stroke-linecap="round"/>
                                                <line x1="4.93" y1="4.93" x2="7.05" y2="7.05" stroke="#fff"
                                                      stroke-width="2" stroke-linecap="round"/>
                                                <line x1="16.95" y1="16.95" x2="19.07" y2="19.07" stroke="#fff"
                                                      stroke-width="2" stroke-linecap="round"/>
                                                <line x1="4.93" y1="19.07" x2="7.05" y2="16.95" stroke="#fff"
                                                      stroke-width="2" stroke-linecap="round"/>
                                                <line x1="16.95" y1="7.05" x2="19.07" y2="4.93" stroke="#fff"
                                                      stroke-width="2" stroke-linecap="round"/>
                                            </svg>
                                        </div>
                                        <span class="nav__logo-text">SOLARION</span>
                                    </a>
                                    <p>Powering humanity's future with intelligent, clean solar energy systems built for
                                        the next century.
                                    </p>
                                    <div class="footer__social">
                                        <a href="#" class="social-link" aria-label="Twitter">𝕏</a>
                                        <a href="#" class="social-link" aria-label="LinkedIn">in</a>
                                        <a href="#" class="social-link" aria-label="YouTube">▶</a>
                                        <a href="#" class="social-link" aria-label="Instagram">◎</a>
                                    </div>
                                </div>
                                <div class="footer__cols">
                                    <div class="footer__col">
                                        <h4>Solutions</h4>
                                        <ul>
                                            <li>
                                                <a href="/solutions">Quantum Panels</a>
                                            </li>
                                            <li>
                                                <a href="/solutions">Neural Grid</a>
                                            </li>
                                            <li>
                                                <a href="/solutions">Smart City</a>
                                            </li>
                                            <li>
                                                <a href="/solutions">Monitoring</a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="footer__col">
                                        <h4>Company</h4>
                                        <ul>
                                            <li>
                                                <a href="/about">About Us</a>
                                            </li>
                                            <li>
                                                <a href="/technology">Technology</a>
                                            </li>
                                            <li>
                                                <a href="/impact">Impact</a>
                                            </li>
                                            <li>
                                                <a href="/contactus">Contact</a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="footer__col">
                                        <h4>Resources</h4>
                                        <ul>
                                            <li>
                                                <a href="#">Documentation</a>
                                            </li>
                                            <li>
                                                <a href="#">Case Studies</a>
                                            </li>
                                            <li>
                                                <a href="#">Blog</a>
                                            </li>
                                            <li>
                                                <a href="#">Support</a>
                                            </li>
                                            <li>
                                                <a href="#">API</a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="footer__col footer__col--newsletter">
                                        <h4>Stay Updated</h4>
                                        <p>Get our latest solar insights and product updates.</p>
                                        <form class="footer__newsletter">
                                            <input type="email" placeholder="your@email.com"/>
                                            <button type="submit">→</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="footer__bottom">
                                <span>© 2026 Solarion Energy Systems. All rights reserved.</span>
                                <div class="footer__bottom-links">
                                    <a href="#">Privacy Policy</a>
                                    <a href="#">Terms of Service</a>
                                    <a href="#">Cookies</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
