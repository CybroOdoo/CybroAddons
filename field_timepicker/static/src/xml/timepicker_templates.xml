<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="field_timepicker.FieldTimePicker">
        <!-- FieldTimePicker template to add input field -->
        <div class="o_field_timepicker" t-att-class="{ o_edit_mode: !this.props.readonly }">
            <input type="text"
                   t-ref="this.input"
                   t-att-id="this.props.id"
                   t-att-value="this.props.record.data[this.props.name] || ''"
                   t-on-click="this._onClickTimeField"
                   readonly="readonly"
                   class="o_input"/>
        </div>
    </t>

    <t t-name="field_timepicker.TimePickerPopover">
        <div class="time-picker-container">
            <div class="time-boxes-container">
                <!-- Hour -->
                <div class="time-box-wrapper">
                    <div class="time-box-label" t-out="this.hourLabel"/>
                    <button type="button" class="btn btn-sm btn-secondary time-box-btn" t-on-click="() => this.increment('hour', 23)">+</button>
                    <div class="time-box-display" t-out="this.formatValue(this.state.hour)"/>
                    <button type="button" class="btn btn-sm btn-secondary time-box-btn" t-on-click="() => this.decrement('hour', 23)">-</button>
                </div>
                <!-- Minute -->
                <div class="time-box-wrapper">
                    <div class="time-box-label" t-out="this.minuteLabel"/>
                    <button type="button" class="btn btn-sm btn-secondary time-box-btn" t-on-click="() => this.increment('minute', 59)">+</button>
                    <div class="time-box-display" t-out="this.formatValue(this.state.minute)"/>
                    <button type="button" class="btn btn-sm btn-secondary time-box-btn" t-on-click="() => this.decrement('minute', 59)">-</button>
                </div>
                <!-- Second -->
                <div class="time-box-wrapper">
                    <div class="time-box-label" t-out="this.secondLabel"/>
                    <button type="button" class="btn btn-sm btn-secondary time-box-btn" t-on-click="() => this.increment('second', 59)">+</button>
                    <div class="time-box-display" t-out="this.formatValue(this.state.second)"/>
                    <button type="button" class="btn btn-sm btn-secondary time-box-btn" t-on-click="() => this.decrement('second', 59)">-</button>
                </div>
            </div>
            <div class="time-picker-buttons">
                <button type="button" class="btn btn-secondary btn-sm" t-on-click="this.onCancel" t-out="this.cancelLabel"/>
                <button type="button" class="btn btn-primary btn-sm" t-on-click="this.onConfirm" t-out="this.confirmLabel"/>
            </div>
        </div>
    </t>
</templates>
