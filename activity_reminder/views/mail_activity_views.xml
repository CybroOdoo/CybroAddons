<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Extension for mail.activity.schedule wizard form view -->
    <record id="mail_activity_schedule_view_form_inherit_activity_reminder" model="ir.ui.view">
        <field name="name">mail.activity.schedule.view.form.inherit.activity.reminder</field>
        <field name="model">mail.activity.schedule</field>
        <field name="priority">21</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']/.." position="after">
                <div groups="activity_reminder.group_set_activity_alarm"
                     class="o_outlined d-flex align-items-baseline mb-2 gap-2">
                    <i class="oi oi-filled" data-icon="calendar_today" title="Reminder Due Date"/>
                    <field name="reminder_due_date" nolabel="1" class="w-100" placeholder="Reminder Due Date"
                           groups="activity_reminder.group_set_activity_alarm"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Extension for mail.activity form popup view -->
    <record id="mail_activity_view_form_popup_inherit_activity_reminder" model="ir.ui.view">
        <field name="name">mail.activity.view.form.popup.inherit.activity.reminder</field>
        <field name="model">mail.activity</field>
        <field name="priority">21</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']/.." position="after">
                <div groups="activity_reminder.group_set_activity_alarm"
                     class="o_outlined d-flex align-items-baseline mb-2 gap-2">
                    <i class="oi oi-filled" data-icon="calendar_today" title="Reminder Due Date"/>
                    <field name="reminder_due_date" nolabel="1" class="w-100" placeholder="Reminder Due Date"
                           groups="activity_reminder.group_set_activity_alarm"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
