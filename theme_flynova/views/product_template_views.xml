<?xml version="1.0" encoding="utf-8"?>
<!-- Inherits the standard product.template backend form view to add Flynova-specific fields: listing type, location, duration, gallery images, and included/excluded details. -->
<odoo>
    <record id="product_template_view_form_inherit_flynova" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.flynova</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Flynova Travel" name="flynova_travel">
                    <group>
                        <group string="Tour/Hotel Info">
                            <field name="flynova_listing_type"/>
                            <field name="duration" placeholder="e.g. 1 Week"/>
                            <field name="location_name" placeholder="e.g. Thailand"/>
                        </group>
                        <group string="Details">
                            <field name="included_details"/>
                            <field name="excluded_details"/>
                        </group>
                    </group>
                    <group string="Gallery">
                        <field name="gallery_image_ids" widget="many2many_binary" string="Gallery Images"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
