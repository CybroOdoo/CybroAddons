<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        View: product.template.view.form.inherit.flynova
        Model: product.template
        Type: form (inherited from product.product_template_only_form_view)

        Injects a new "Flynova Travel" page inside the product form notebook
        containing two field groups and a gallery section:

        Group — Tour/Hotel Info:
          • flynova_listing_type  – Whether the product is a Tour or Hotel.
          • duration              – Human-readable stay/trip length.
          • location_name         – Destination city or country.

        Group — Details:
          • included_details  – Amenities/services included (one item per line).
          • excluded_details  – Items not covered by the package (one per line).

        Group — Gallery:
          • gallery_image_ids  – Additional photos for the website detail carousel.
    -->
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.theme.flynova</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Append the "Flynova Travel" tab as the last page in the notebook. -->
            <xpath expr="//notebook" position="inside">
                <page string="Flynova Travel" name="flynova_travel">
                    <group>
                        <group string="Tour/Hotel Info">
                            <field name="flynova_listing_type"/>
                            <field name="duration" placeholder="e.g. 1 Week"/>
                            <field name="location_name" placeholder="e.g. Thailand"/>
                        </group>
                        <group string="Details">
                            <field name="included_details"/>
                            <field name="excluded_details"/>
                        </group>
                    </group>
                    <group string="Gallery">
                        <field name="gallery_image_ids" widget="many2many_binary" string="Gallery Images"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
