<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout_flynova" inherit_id="website.layout" name="Flynova Layout">
        <xpath expr="//head" position="inside">
            <link rel="dns-prefetch" href="https://fonts.googleapis.com"/>
            <link rel="dns-prefetch" href="https://fonts.gstatic.com"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&amp;family=Island+Moments&amp;display=swap"/>
        </xpath>
        <xpath expr="//footer" position="replace">
            <footer class="footer">
                <div class="container-fluid cmpad">
                    <div class="footer-content conwidth">
                        <!-- Brand -->
                        <div class="footer-brand">
                            <h2>FlyNova</h2>
                            <p>Your trusted partner for unforgettable travel experiences worldwide.</p>
                            <div class="social-links">
                                <a target="_blank" t-att-href="website.social_facebook"
                                   t-if="website.social_facebook" aria-label="Facebook">
                                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                    </svg>
                                </a>
                                <a target="_blank" t-att-href="website.social_twitter"
                                   t-if="website.social_twitter" aria-label="Twitter">
                                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                    </svg>
                                </a>
                                <a target="_blank" t-att-href="website.social_instagram"
                                   t-if="website.social_instagram" aria-label="Instagram">
                                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                    </svg>
                                </a>
                            </div>
                        </div>

                        <!-- Quick Links -->
                        <div class="footer-section">
                            <h3>Quick Links</h3>
                            <ul class="footer-links">
                                <li>
                                    <a href="/">Home</a>
                                </li>
                                <li>
                                    <a href="/about-us">About Us</a>
                                </li>
                                <li>
                                    <a href="/packages">Tours</a>
                                </li>
                                <li>
                                    <a href="/explore">Explore</a>
                                </li>
                            </ul>
                        </div>

                        <!-- Support -->
                        <div class="footer-section">
                            <h3>Support</h3>
                            <ul class="footer-links">
                                <li>
                                    <a href="/contactus">Contact Us</a>
                                </li>
                                <li>
                                    <a href="#">FAQs</a>
                                </li>
                                <li>
                                    <a href="/terms">Terms &amp; Conditions</a>
                                </li>
                            </ul>
                        </div>

                        <!-- Newsletter — plain form, no module check needed -->
                        <div class="footer-section newsletter-section">
                            <h3>Subscribe Newsletter</h3>
                            <p>Stay updated with our latest offers and travel inspiration</p>
                            <form class="newsletter-form" action="/flynova/newsletter/subscribe" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="email" name="email" placeholder="Enter your email"
                                       required="required"/>
                                <button type="submit" class="subscribe-btn bttn">Subscribe</button>
                            </form>
                        </div>
                    </div>

                    <!-- Footer Bottom -->
                    <div class="footer-bottom conwidth">
                        <div class="copyright">
                            &#169;
                            <span t-esc="time.strftime('%Y')"/>
                            <span t-field="website.name"/>. All rights reserved.
                        </div>
                        <div class="payment-methods">
                            <div class="payment-icon visa">VISA</div>
                            <div class="payment-icon">
                                <svg width="24" height="16" viewBox="0 0 24 16" fill="currentColor">
                                    <circle cx="8" cy="8" r="8" fill="#eb001b"/>
                                    <circle cx="16" cy="8" r="8" fill="#f79e1b" opacity="0.8"/>
                                </svg>
                            </div>
                            <div class="payment-icon paypal">PayPal</div>
                            <div class="payment-icon amex">AMEX</div>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>

        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <owl-component name="theme_flynova.FlynovaTheme"/>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="#{'inpage' if is_inpage else ''}" separator=" "/>
        </xpath>
    </template>

    <template id="header_default_flynova" inherit_id="website.template_header_default"
              name="Flynova Header Menu Filter">
        <xpath expr="//t[@t-foreach='website.menu_id.child_id']" position="replace">
            <t t-set="flynova_header_menus"
               t-value="website.menu_id.child_id"/>
            <t t-set="flynova_current_path" t-value="request.httprequest.path.rstrip('/') or '/'"/>
            <t t-foreach="flynova_header_menus" t-as="submenu">
                <t t-set="flynova_menu_path" t-value="(submenu.url or '/').split('?')[0].rstrip('/') or '/'"/>
                <t t-set="flynova_menu_active"
                   t-value="flynova_current_path == flynova_menu_path
                            or (flynova_menu_path == '/tours' and (flynova_current_path.startswith('/tours') or flynova_current_path.startswith('/tour') or flynova_current_path.startswith('/packages')))
                            or (flynova_menu_path == '/hotels' and (flynova_current_path.startswith('/hotels') or flynova_current_path.startswith('/hotel')))
                            or (flynova_menu_path == '/about-us' and flynova_current_path.startswith('/about-us'))
                            or (flynova_menu_path == '/explore' and flynova_current_path.startswith('/explore'))
                            or (flynova_menu_path in ['/contactus', '/contact-us'] and flynova_current_path in ['/contactus', '/contact-us'])"/>
                <t t-call="website.submenu">
                    <t t-set="item_class" t-valuef="nav-item #{flynova_menu_active and 'active' or ''}"/>
                    <t t-set="link_class" t-valuef="nav-link #{flynova_menu_active and 'active' or ''}"/>
                </t>
            </t>
        </xpath>
    </template>

    <template id="header_mobile_flynova" inherit_id="website.template_header_mobile"
              name="Flynova Mobile Header Menu Filter">
        <xpath expr="//button[@data-bs-target='#top_menu_collapse_mobile']" position="attributes">
            <attribute name="class" add="mobmenu flynova-mobmenu-btn" separator=" "/>
        </xpath>
        <xpath expr="//button[@data-bs-target='#top_menu_collapse_mobile']/span[hasclass('navbar-toggler-icon')]" position="replace">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path stroke="#ffffff" stroke-width="2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
            </svg>
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse_mobile']" position="attributes">
            <attribute name="t-attf-class">offcanvas offcanvas-end o_navbar_mobile flynova-mobile-offcanvas</attribute>
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse_mobile']/div[hasclass('offcanvas-body')]" position="attributes">
            <attribute name="class">offcanvas-body flynova-mobile-offcanvas-body</attribute>
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse_mobile']//button[@data-bs-dismiss='offcanvas']" position="replace">
            <button type="button" class="close-btn flynova-mobile-close-btn" data-bs-dismiss="offcanvas" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                </svg>
            </button>
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse_mobile']//t[@t-call='website.placeholder_header_search_box']" position="replace"/>
        <xpath expr="//div[@id='top_menu_collapse_mobile']//t[@t-call='website.placeholder_header_text_element']" position="replace"/>
        <xpath expr="//div[@id='top_menu_collapse_mobile']//t[@t-call='website.placeholder_header_social_links']" position="replace"/>

        <xpath expr="//t[@t-foreach='website.menu_id.child_id']" position="replace">
            <t t-set="flynova_mobile_menus"
               t-value="website.menu_id.child_id.filtered(lambda menu: menu.url not in ['/shop', '/event', '/events'])"/>
            <t t-set="flynova_current_path" t-value="request.httprequest.path.rstrip('/') or '/'"/>
            <t t-foreach="flynova_mobile_menus" t-as="submenu">
                <t t-set="flynova_menu_path" t-value="(submenu.url or '/').split('?')[0].rstrip('/') or '/'"/>
                <t t-set="flynova_menu_active"
                   t-value="flynova_current_path == flynova_menu_path
                            or (flynova_menu_path == '/tours' and (flynova_current_path.startswith('/tours') or flynova_current_path.startswith('/tour') or flynova_current_path.startswith('/packages')))
                            or (flynova_menu_path == '/hotels' and (flynova_current_path.startswith('/hotels') or flynova_current_path.startswith('/hotel')))
                            or (flynova_menu_path == '/about-us' and flynova_current_path.startswith('/about-us'))
                            or (flynova_menu_path == '/explore' and flynova_current_path.startswith('/explore'))
                            or (flynova_menu_path in ['/contactus', '/contact-us'] and flynova_current_path in ['/contactus', '/contact-us'])"/>
                <li t-attf-class="nav-item flynova-mobile-nav-item #{flynova_menu_active and 'active' or ''}"
                    style="border-bottom: 1px solid #eef0f6; margin: 0; padding: 0; list-style: none; display: block; width: 100%;">
                    <a t-att-href="submenu.url"
                       t-attf-class="nav-link flynova-mobile-nav-link #{flynova_menu_active and 'active' or ''}"
                       style="font-family: 'Montserrat', sans-serif !important; font-size: 1.35rem !important; font-weight: 500 !important; color: #1e293b !important; padding: 1.4rem 1.5rem !important; margin: 0 !important; line-height: 1.2 !important; text-decoration: none !important; display: block !important; width: 100% !important; background: transparent !important; border: none !important;">
                        <t t-if="flynova_menu_active">
                            <span style="font-size: 1.35rem !important; font-weight: 600 !important; color: #7749f8 !important;"><t t-out="submenu.name"/></span>
                        </t>
                        <t t-else="">
                            <span style="font-size: 1.35rem !important; font-weight: 500 !important; color: #1e293b !important;"><t t-out="submenu.name"/></span>
                        </t>
                    </a>
                </li>
            </t>
        </xpath>

        <xpath expr="//div[@id='top_menu_collapse_mobile']//ul[hasclass('gap-2')]" position="replace">
            <div class="flynova-mobile-bottom mt-auto pt-3">
                <!-- Phone info -->
                <div class="flynova-mobile-phone mb-3">
                    <i class="fa fa-phone me-3"/>
                    <a t-attf-href="tel:#{res_company.phone or website.company_id.phone or '+1 555-555-5556'}">
                        <t t-out="res_company.phone or website.company_id.phone or '+1 555-555-5556'"/>
                    </a>
                </div>

                <!-- User Dropdown / Sign In -->
                <div class="flynova-mobile-user mb-3">
                    <ul class="navbar-nav w-100">
                        <t t-call="portal.placeholder_user_sign_in">
                            <t t-set="_link_class" t-valuef="btn btn-outline-secondary w-100"/>
                        </t>
                        <t t-call="portal.user_dropdown">
                            <t t-set="_icon" t-value="true"/>
                            <t t-set="_user_name" t-value="true"/>
                            <t t-set="_user_name_class" t-valuef="me-auto small"/>
                            <t t-set="_link_class" t-valuef="btn-outline-secondary d-flex align-items-center border-0 px-2"/>
                            <t t-set="_icon_class" t-valuef="me-2"/>
                            <t t-set="_item_class" t-valuef="dropdown dropup"/>
                            <t t-set="_dropdown_menu_class" t-valuef="w-100"/>
                        </t>
                    </ul>
                </div>

                <!-- Call to action button -->
                <div class="flynova-mobile-cta">
                    <a href="/contactus" class="oe_unremovable bttn btn_cta w-100">Get Featured</a>
                </div>
            </div>
        </xpath>
    </template>

    <template id="header_cta_flynova" inherit_id="website.header_call_to_action" name="Flynova Header CTA">
        <xpath expr="//a[hasclass('btn_cta')]" position="replace">
            <a href="/contactus" class="oe_unremovable bttn btn_cta">Get Featured</a>
        </xpath>
    </template>

    <template id="header_brand_flynova" inherit_id="website.option_header_brand_logo" name="Flynova Header Brand">
        <xpath expr="//span[@t-field='website.logo']" position="replace">
            <img src="/theme_flynova/static/src/img/logo/logo.svg"
                 alt="FlyNova"
                 title="FlyNova"/>
        </xpath>
    </template>
</odoo>
