<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="booking_payment" name="Booking Payment">
        <t t-call="website.layout">
            <div id="wrap" class="inpage">
                <section class="position-relative py-5">
                    <div class="container-fluid cmpad pt-5">
                        <!-- Progress Steps -->
                        <div class="progress-steps">
                            <div class="step completed">
                                <div class="step-number">1</div>
                                <div class="step-label">Booking Details</div>
                                <div class="step-connector"></div>
                            </div>
                            <div class="step active">
                                <div class="step-number">2</div>
                                <div class="step-label">Payment</div>
                                <div class="step-connector"></div>
                            </div>
                            <div class="step inactive">
                                <div class="step-number">3</div>
                                <div class="step-label">Confirmation</div>
                            </div>
                        </div>

                        <div class="main-content d-flex flex-column flex-lg-row gap-4">
                            <!-- Booking Summary -->
                            <div class="booking-summary col-lg-4">
                                <h2 class="summary-title">Booking Summary</h2>

                                <div class="trip-image">
                                    <img t-if="product.image_1920" t-attf-src="/web/image/product.template/#{product.id}/image_1920" alt="Trip Image"/>
                                    <img t-else="" src="https://images.pexels.com/photos/1285625/pexels-photo-1285625.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800" alt="Default Image"/>
                                </div>

                                <h3 class="trip-title" t-field="product.name"/>

                                <div class="trip-details">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                        <path fill="currentColor" d="M5 22q-.825 0-1.412-.587T3 20V6q0-.825.588-1.412T5 4h1V3q0-.425.288-.712T7 2t.713.288T8 3v1h8V3q0-.425.288-.712T17 2t.713.288T18 3v1h1q.825 0 1.413.588T21 6v14q0 .825-.587 1.413T19 22zm0-2h14V10H5zm7-6q-.425 0-.712-.288T11 13t.288-.712T12 12t.713.288T13 13t-.288.713T12 14m-4 0q-.425 0-.712-.288T7 13t.288-.712T8 12t.713.288T9 13t-.288.713T8 14m8 0q-.425 0-.712-.288T15 13t.288-.712T16 12t.713.288T17 13t-.288.713T16 14m-4 4q-.425 0-.712-.288T11 17t.288-.712T12 16t.713.288T13 17t-.288.713T12 18m-4 0q-.425 0-.712-.288T7 17t.288-.712T8 16t.713.288T9 17t-.288.713T8 18m8 0q-.425 0-.712-.288T15 17t.288-.712T16 16t.713.288T17 17t-.288.713T16 18" />
                                    </svg>
                                    <span t-field="order.booking_date" t-options='{"widget": "date", "format": "EEE MMM dd, YYYY"}'/>
                                </div>

                                <div class="trip-guests">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                        <path fill="currentColor" d="M1 20v-2.8q0-.85.438-1.562T2.6 14.55q1.55-.775 3.15-1.162T9 13t3.25.388t3.15 1.162q.725.375 1.163 1.088T17 17.2V20zm18 0v-3q0-1.1-.612-2.113T16.65 13.15q1.275.15 2.4.513t2.1.887q.9.5 1.375 1.112T23 17v3zM9 12q-1.65 0-2.825-1.175T5 8t1.175-2.825T9 4t2.825 1.175T13 8t-1.175 2.825T9 12m10-4q0 1.65-1.175 2.825T15 12q-.275 0-.7-.062t-.7-.138q.675-.8 1.038-1.775T15 8t-.362-2.025T13.6 4.2q.35-.125.7-.163T15 4q1.65 0 2.825 1.175T19 8M3 18h12v-.8q0-.275-.137-.5t-.363-.35q-1.35-.675-2.725-1.012T9 15t-2.775.338T3.5 16.35q-.225.125-.363.35T3 17.2zm6-8q.825 0 1.413-.587T11 8t-.587-1.412T9 6t-1.412.588T7 8t.588 1.413T9 10m0-2" />
                                    </svg>
                                    <t t-out="order.adult_qty"/> Adults
                                    <t t-if="order.child_qty > 0">, <t t-out="order.child_qty"/> Children</t>
                                </div>

                                <div class="price-breakdown">
                                    <div class="price-row">
                                        <span class="price-label">Package Price</span>
                                        <span class="price-value" t-field="order.amount_untaxed" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                    </div>
                                    <div class="price-row">
                                        <span class="price-label">Taxes &amp; Fees</span>
                                        <span class="price-value" t-field="order.amount_tax" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                    </div>
                                    <div class="price-row total-row">
                                        <span class="price-label">Total</span>
                                        <span class="price-value" t-field="order.amount_total" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment Section -->
                            <div class="payment-section col-lg-8">
                                <h2 class="payment-title">Payment Details</h2>

                                <!-- Odoo Payment Form -->
                                <div t-if="payment_methods_sudo or tokens_sudo"
                                     id="payment_method"
                                     class="o_not_editable mt-4">
                                    <t t-call="payment.form">
                                        <t t-set="submit_button_label">Complete Payment</t>
                                    </t>
                                </div>
                                <div t-else="" class="alert alert-warning mt-4">
                                    <strong>No suitable payment option could be found.</strong><br/>
                                    <div t-if="not request.env.is_admin()">
                                        Please contact the website administrator.
                                    </div>
                                    <div class="mt-2" groups="base.group_system">
                                        <a t-if="request.env.company.country_id.is_stripe_supported_country"
                                           t-attf-href="/web#action=#{action_activate_stripe_id}"
                                           role="button"
                                           class="btn btn-primary">
                                            ACTIVATE STRIPE
                                        </a>
                                        <a role="button"
                                           class="btn-link alert-warning ps-2"
                                           t-attf-href="/web#action=#{payment_action_id}">
                                            <strong><i class="oi oi-arrow-right"></i> View alternatives</strong>
                                        </a>
                                    </div>
                                </div>

                                <div class="policy-section mt-4">
                                    <div class="policy-item d-flex gap-2 mb-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                            <path fill="currentColor" d="M11 17h2v-6h-2zm1-8q.425 0 .713-.288T13 8t-.288-.712T12 7t-.712.288T11 8t.288.713T12 9m0 13q-2.075 0-3.9-.788t-3.175-2.137T2.788 15.9T2 12t.788-3.9t2.137-3.175T8.1 2.788T12 2t3.9.788t3.175 2.137T21.213 8.1T22 12t-.788 3.9t-2.137 3.175t-3.175 2.138T12 22" />
                                        </svg>
                                        <span style="flex: 1;">Free cancellation up to 24 hours before check-in. View our full cancellation policy</span>
                                    </div>

                                    <div class="secure-payment d-flex gap-2 mb-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                            <path fill="currentColor" d="M4 22V8h3V6q0-2.075 1.463-3.537T12 1t3.538 1.463T17 6v2h3v14zm8-5q.825 0 1.413-.587T14 15t-.587-1.412T12 13t-1.412.588T10 15t.588 1.413T12 17M9 8h6V6q0-1.25-.875-2.125T12 3t-2.125.875T9 6z" />
                                        </svg>
                                        <span style="flex: 1;">Secure payment powered by Odoo Payment Providers</span>
                                    </div>
                                </div>

                                <div class="action-buttons d-flex gap-3 mt-4">
                                    <a t-attf-href="/#{product.flynova_listing_type}/#{product.id}" class="flynova-payment-back-btn btn btn-secondary py-3 px-4 rounded-pill">Back to Details</a>
                                    <!-- The Complete Payment button is handled by the payment.form -->
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="booking_confirmation" name="Booking Confirmation">
        <t t-call="website.layout">
            <div id="wrap" class="inpage">
                <section class="position-relative py-5">
                    <div class="container cmpad pt-5" style="max-width: 700px;">
                        <!-- Progress Steps -->
                        <div class="progress-steps">
                            <div class="step completed">
                                <div class="step-number">1</div>
                                <div class="step-label">Booking Details</div>
                                <div class="step-connector"></div>
                            </div>
                            <div class="step completed">
                                <div class="step-number">2</div>
                                <div class="step-label">Payment</div>
                                <div class="step-connector"></div>
                            </div>
                            <div class="step completed">
                                <div class="step-number">3</div>
                                <div class="step-label">Confirmation</div>
                            </div>
                        </div>

                        <div class="text-center py-5">
                            <!-- Checkmark icon -->
                            <div class="mb-4" style="font-size: 5rem; color: var(--color-primary, #22c55e);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24">
                                    <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8z"/>
                                </svg>
                            </div>
                            <h1 class="fw-bold mb-2">Booking Confirmed!</h1>
                            <p class="text-muted mb-4">
                                Thank you for your booking. Your order
                                <strong t-esc="order.name"/> has been received and will be processed shortly.
                            </p>

                            <!-- Summary card -->
                            <div class="card shadow-sm text-start mb-4">
                                <div class="card-body p-4">
                                    <h5 class="fw-semibold mb-3">Booking Summary</h5>
                                    <div class="row g-2">
                                        <div class="col-6 text-muted">Order</div>
                                        <div class="col-6 fw-semibold" t-esc="order.name"/>
                                        <div class="col-6 text-muted">Product</div>
                                        <div class="col-6 fw-semibold" t-esc="order.booking_product_id.name or ''"/>
                                        <div class="col-6 text-muted">Check-in</div>
                                        <div class="col-6">
                                            <span t-field="order.booking_date"
                                                  t-options='{"widget": "date", "format": "EEE MMM dd, YYYY"}'/>
                                        </div>
                                        <div class="col-6 text-muted">Guests</div>
                                        <div class="col-6">
                                            <t t-esc="order.adult_qty"/> Adults
                                            <t t-if="order.child_qty &gt; 0">
                                                , <t t-esc="order.child_qty"/> Children
                                            </t>
                                        </div>
                                        <div class="col-6 text-muted">Total Paid</div>
                                        <div class="col-6 fw-bold"
                                             t-field="order.amount_total"
                                             t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                    </div>
                                </div>
                            </div>

                            <a href="/" class="btn btn-primary rounded-pill px-5 py-3 me-2">Back to Home</a>
                            <a t-attf-href="#{order.get_portal_url()}"
                               class="btn btn-outline-secondary rounded-pill px-5 py-3">View Order</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
