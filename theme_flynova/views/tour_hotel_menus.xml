<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tours Action -->
    <record id="action_flynova_tours" model="ir.actions.act_window">
        <field name="name">Tours</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">['|', ('flynova_listing_type', '=', 'tour'), ('categ_id.parent_id.name', '=', 'Tours')]</field>
        <field name="context">{'default_type': 'service', 'default_flynova_listing_type': 'tour', 'search_default_filter_to_sell': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Tour!
            </p>
        </field>
    </record>

    <!-- Hotels Action -->
    <record id="action_flynova_hotels" model="ir.actions.act_window">
        <field name="name">Hotels</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">['|', ('flynova_listing_type', '=', 'hotel'), ('categ_id.parent_id.name', '=', 'Hotels')]</field>
        <field name="context">{'default_type': 'service', 'default_flynova_listing_type': 'hotel', 'search_default_filter_to_sell': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Hotel!
            </p>
        </field>
    </record>

    <!-- Menu structure under Website > Configuration -->
    <menuitem id="menu_flynova_packages"
              name="Flynova Packages"
              parent="website.menu_website_global_configuration"
              sequence="100"/>

    <menuitem id="menu_flynova_tours_config"
              name="Tours"
              parent="menu_flynova_packages"
              action="action_flynova_tours"
              sequence="10"/>

    <menuitem id="menu_flynova_hotels_config"
              name="Hotels"
              parent="menu_flynova_packages"
              action="action_flynova_hotels"
              sequence="20"/>

    <menuitem id="menu_flynova_traveller_photos"
              name="Traveller Photos"
              parent="menu_flynova_packages"
              action="flynova_traveller_photo_action"
              sequence="30"/>

    <record id="website_menu_tours" model="website.menu">
        <field name="name">Tours</field>
        <field name="url">/tours</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="25"/>
    </record>

    <record id="website_menu_hotels" model="website.menu">
        <field name="name">Hotels</field>
        <field name="url">/hotels</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="30"/>
    </record>

    <record id="website_menu_explore" model="website.menu">
        <field name="name">Explore</field>
        <field name="url">/explore</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="35"/>
    </record>

    <record id="website_menu_about" model="website.menu">
        <field name="name">About</field>
        <field name="url">/about-us</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="40"/>
    </record>
</odoo>
