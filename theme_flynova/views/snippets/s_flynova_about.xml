<?xml version="1.0" encoding="utf-8"?>
<!-- Defines the About Us page hero banner and content sections for the Flynova theme.
     Rendered at /about-us and editable via the Odoo website builder. -->
<odoo>
    <!-- About Hero Banner -->
    <template id="s_flynova_about_hero" name="Flynova About Hero">
        <section class="s_flynova_about_hero"
                 data-snippet="s_flynova_about_hero"
                 data-name="Flynova About Hero">
            <div class="inbanner flynova-page-banner">
                <img src="/theme_flynova/static/src/img/images/about.jpg"
                     alt="About banner"
                     class="flynova-page-banner__image"/>
                <div class="container-fluid cmpad flynova-page-banner__content">
                    <div class="row">
                        <div class="col-md-12 d-flex flex-column justify-content-center position-relative py-5 mt-5">
                            <h1 class="text-white font-weight-bold text-center"
                                style="font-size: 3rem;">About Us</h1>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Who We Are + Mission -->
    <template id="s_flynova_about_who" name="Flynova About Who We Are">
        <section class="s_flynova_about_who position-relative py-5"
                 data-snippet="s_flynova_about_who"
                 data-name="Flynova Who We Are">
            <div class="container-fluid cmpad">
                <div class="row mb-5 align-items-center">
                    <div class="col-lg-6 d-flex flex-column justify-content-center">
                        <h2 class="mainhead mb-3 text-left">Who
                            <span class="primary-color">we are?</span>
                        </h2>
                        <p class="mb-5 para">We're all about creating unforgettable experiences for our
                            guests. Our journey began with a simple passion for exploring the beauty of the
                            World.
                        </p>
                        <h2 class="mainhead mb-3 text-left">Our
                            <span class="primary-color">Mission</span>
                        </h2>
                        <p class="para">We believe that travel is not just about visiting new places, but
                            about immersing yourself in new cultures, connecting with nature, and making
                            memories that last a lifetime.
                        </p>
                    </div>
                    <div class="col-lg-6 mt-4 mt-lg-0">
                        <div class="about-collage">
                            <img src="/theme_flynova/static/src/img/images/aboutmain.jpg"
                                 alt="Travel destination"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Services -->
    <template id="s_flynova_about_services" name="Flynova About Services">
        <section class="s_flynova_about_services position-relative py-5"
                 data-snippet="s_flynova_about_services"
                 data-name="Flynova Services">
            <div class="container-fluid cmpad">
                <div class="row align-items-center">
                    <div class="col-lg-4">
                        <div class="section-header">
                            <div class="section-subtitle">What we serve</div>
                            <h2 class="section-title">We offer our best services</h2>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <div class="services-grid">
                            <div class="service-card text-center">
                                <div class="service-icon mx-auto mb-4"
                                     style="width:80px;height:80px;background:#7749f8;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                    <img src="/theme_flynova/static/src/img/images/weather.svg"
                                         alt="Weather"
                                         style="width:40px;filter:brightness(0) invert(1);"/>
                                </div>
                                <h3 class="service-title">Calculate Weather</h3>
                                <p class="service-description">Built Wicket longer admire do barton vanity
                                    itself do in it.</p>
                            </div>
                            <div class="service-card text-center">
                                <div class="service-icon mx-auto mb-4"
                                     style="width:80px;height:80px;background:#7749f8;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                    <img src="/theme_flynova/static/src/img/images/guide.svg"
                                         alt="Guide"
                                         style="width:40px;filter:brightness(0) invert(1);"/>
                                </div>
                                <h3 class="service-title">Best Tour Guide</h3>
                                <p class="service-description">Built Wicket longer admire do barton vanity
                                    itself do in it.</p>
                            </div>
                            <div class="service-card text-center">
                                <div class="service-icon mx-auto mb-4"
                                     style="width:80px;height:80px;background:#7749f8;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                    <img src="/theme_flynova/static/src/img/images/custom.svg"
                                         alt="Customization"
                                         style="width:40px;filter:brightness(0) invert(1);"/>
                                </div>
                                <h3 class="service-title">Customization</h3>
                                <p class="service-description">Built Wicket longer admire do barton vanity
                                    itself do in it.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
