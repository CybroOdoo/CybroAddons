<?xml version="1.0" encoding="utf-8"?>
<!-- Defines the Features section presenting the key selling points of Flynova services.
     Available as a draggable block in the Flynova website builder. -->
<odoo>
    <template id="s_flynova_features" name="Flynova Features">
        <section class="s_flynova_features position-relative mainbg py-3 py-md-5"
                 data-snippet="s_flynova_features"
                 data-name="Flynova Features">
            <div class="container-fluid cmpad py-3">
                <div class="row conwidth">
                    <div class="col-md-12 text-center">
                        <h2 class="mainhead mb-3 text-start">Our Features</h2>
                        <div class="row g-3">
                            <div class="col-lg-3 col-md-6 col-12">
                                <div class="feabox">
                                    <img src="/theme_flynova/static/src/img/images/icon1.svg" alt=""/>
                                    <h5>24/7 Customer Support</h5>
                                    <p>Round-the-clock assistance for all your travel needs</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 col-12">
                                <div class="feabox">
                                    <img src="/theme_flynova/static/src/img/images/icon2.svg" alt=""/>
                                    <h5>Best Price Guarantee</h5>
                                    <p>We match or beat any comparable travel package price</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 col-12">
                                <div class="feabox">
                                    <img src="/theme_flynova/static/src/img/images/icon3.svg" alt=""/>
                                    <h5>Secure Payments</h5>
                                    <p>Safe and encrypted payment processing</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 col-12">
                                <div class="feabox">
                                    <img src="/theme_flynova/static/src/img/images/icon4.svg" alt=""/>
                                    <h5>Real Feedback</h5>
                                    <p>Real feedback from real travelers</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
