<?xml version="1.0" encoding="utf-8"?>
<!-- Defines the Destinations card grid snippet showing featured travel destinations.
     Available as a draggable block in the Flynova website builder. -->
<odoo>
    <template id="s_flynova_destinations" name="Flynova Destinations">
        <section class="s_flynova_destinations position-relative w-100"
                 data-snippet="s_flynova_destinations"
                 data-name="Flynova Destinations">
            <div class="container-fluid cmpad py-3 py-md-5">
                <div class="flynova-section-shell">
                    <div class="row conwidth">
                        <div class="col-12 text-center text-lg-start">
                            <span class="flynova-kicker">Popular Destinations</span>
                            <div class="d-lg-flex justify-content-between align-items-end gap-4 mb-4 mb-lg-5">
                                <h2 class="mainhead mb-3 mb-lg-0">Beautiful Places Around The World</h2>
                                <p class="flynova-section-copy mb-0">Choose from curated escapes, culture-rich cities, and relaxing seaside stays designed to feel as polished as the hero above.</p>
                            </div>
                        </div>
                    </div>
                    <div class="row conwidth g-4 align-items-stretch flynova-destination-layout">
                        <div class="col-lg-4">
                            <div class="destination-card destination-card--large h-100" data-destination="paris">
                                <img src="/theme_flynova/static/src/img/images/paris.jpg" alt="Paris" class="card-image"/>
                                <div class="card-overlay">
                                    <div class="card-badge">Most Booked</div>
                                    <div class="card-copy">
                                        <div class="card-info">City of Light</div>
                                        <h3 class="card-title">Paris</h3>
                                        <p class="card-summary">Iconic streets, boutique hotels, and effortless evenings by the Seine.</p>
                                        <a href="/tour/paris-by-night-39" class="view-more-btn">View More</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-8">
                            <div class="destinations-grid">
                                <div class="destination-card destination-card--compact" data-destination="kyoto">
                                    <img src="/theme_flynova/static/src/img/images/kyoto.jpeg" alt="Kyoto" class="card-image"/>
                                    <div class="card-overlay">
                                        <div class="card-copy">
                                            <div class="card-info">Land of Tradition</div>
                                            <h3 class="card-title">Kyoto</h3>
                                            <a href="/tour/gion-district-walk-38" class="view-more-btn">View More</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="destination-card destination-card--compact" data-destination="santorini">
                                    <img src="/theme_flynova/static/src/img/images/Santorini.jpg" alt="Santorini" class="card-image"/>
                                    <div class="card-overlay">
                                        <div class="card-copy">
                                            <div class="card-info">Island Escape</div>
                                            <h3 class="card-title">Santorini</h3>
                                            <a href="/tour/swiss-alphs-hiking-40" class="view-more-btn">View More</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="destination-card destination-card--compact" data-destination="dubai">
                                    <img src="/theme_flynova/static/src/img/images/dubai.jpg" alt="Dubai" class="card-image"/>
                                    <div class="card-overlay">
                                        <div class="card-copy">
                                            <div class="card-info">Luxury Skyline</div>
                                            <h3 class="card-title">Dubai</h3>
                                            <a href="/hotel/burj-al-arab-44" class="view-more-btn">View More</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="destination-card destination-card--compact" data-destination="bali">
                                    <img src="/theme_flynova/static/src/img/images/bali.jpg" alt="Bali" class="card-image"/>
                                    <div class="card-overlay">
                                        <div class="card-copy">
                                            <div class="card-info">Tropical Reset</div>
                                            <h3 class="card-title">Bali</h3>
                                            <a href="/tour/ubud-temple-tour-37" class="view-more-btn">View More</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
