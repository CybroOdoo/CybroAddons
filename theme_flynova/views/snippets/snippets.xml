<?xml version="1.0" encoding="utf-8"?>
<!-- Registers all Flynova custom snippets into the Odoo website builder snippet panel.
     Inherits website.snippets to add Flynova blocks under the Structure section. -->
<odoo>
    <template id="flynova_snippets" inherit_id="website.snippets" name="Flynova Snippets">
        <xpath expr="//div[@id='snippet_structure']" position="after">
            <div id="snippet_flynova" class="o_panel">
                <div class="o_panel_header">Flynova Theme</div>
                <div class="o_panel_body">
                    <t t-snippet="theme_flynova.s_flynova_hero"
                       string="Flynova Hero"
                       t-thumbnail="/theme_flynova/static/src/img/images/flynova.png"/>
                    <t t-snippet="theme_flynova.s_flynova_destinations"
                       string="Flynova Destinations"
                       t-thumbnail="/theme_flynova/static/src/img/images/paris.jpg"/>
                    <t t-snippet="theme_flynova.s_flynova_featured_tours"
                       string="Flynova Featured Tours"
                       t-thumbnail="/theme_flynova/static/src/img/images/img1.png"/>
                    <t t-snippet="theme_flynova.s_flynova_hotels"
                       string="Flynova Hotels"
                       t-thumbnail="/theme_flynova/static/src/img/images/img2.png"/>
                    <t t-snippet="theme_flynova.s_flynova_features"
                       string="Flynova Features"
                       t-thumbnail="/theme_flynova/static/src/img/images/icon1.svg"/>
                    <t t-snippet="theme_flynova.s_flynova_activities"
                       string="Flynova Activities"
                       t-thumbnail="/theme_flynova/static/src/img/images/explore.png"/>
                    <t t-snippet="theme_flynova.s_flynova_traveler_photos"
                       string="Flynova Traveler Photos"
                       t-thumbnail="/theme_flynova/static/src/img/images/img3.png"/>
                    <t t-snippet="theme_flynova.s_flynova_discover"
                       string="Flynova Discover Paradise"
                       t-thumbnail="/theme_flynova/static/src/img/logo/logo.svg"/>
                    <t t-snippet="theme_flynova.s_flynova_about_hero"
                       string="Flynova About Hero"
                       t-thumbnail="/theme_flynova/static/src/img/images/about.jpg"/>
                    <t t-snippet="theme_flynova.s_flynova_about_who"
                       string="Flynova Who We Are"
                       t-thumbnail="/theme_flynova/static/src/img/images/aboutmain.jpg"/>
                    <t t-snippet="theme_flynova.s_flynova_about_services"
                       string="Flynova Services"
                       t-thumbnail="/theme_flynova/static/src/img/images/icon1.svg"/>
                    <t t-snippet="theme_flynova.s_flynova_explore_hero"
                       string="Flynova Explore Hero"
                       t-thumbnail="/theme_flynova/static/src/img/images/explore.png"/>
                    <t t-snippet="theme_flynova.s_flynova_explore_highlights"
                       string="Flynova Explore Highlights"
                       t-thumbnail="/theme_flynova/static/src/img/images/paris.jpg"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
