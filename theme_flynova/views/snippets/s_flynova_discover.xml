<?xml version="1.0" encoding="utf-8"?>
<!-- Website builder snippet defining the 'Discover' introductory section template used on the Flynova homepage. -->
<odoo>
    <template id="s_flynova_discover" name="Flynova Discover Paradise">
        <section class="s_flynova_discover position-relative py-3 py-md-5"
                 data-snippet="s_flynova_discover"
                 data-name="Flynova Discover Paradise">
            <div class="container-fluid cmpad py-3">
                <div class="row conwidth">
                    <div class="col-md-12 text-center">
                        <div class="banner">
                            <div class="content">
                                <div class="left-content">
                                    <h1 class="title">Discover paradise</h1>
                                    <p class="discount">GET 30% OFF</p>
                                    <!-- No w-25, no inline text-decoration — handled by CSS -->
                                    <a href="/about-us" class="get-register-btn">Get Register</a>
                                </div>
                                <div class="right-content">
                                    <p class="description">
                                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Obcaecati
                                        adipisci sunt in, provident facere ipsam?
                                    </p>
                                    <div class="email-signup">
                                        <form action="/flynova/newsletter/subscribe" method="post"
                                              style="display:flex;width:100%;">
                                            <input type="hidden" name="csrf_token"
                                                   t-att-value="request.csrf_token() if request else ''"/>
                                            <input type="email" name="email" class="email-input"
                                                   placeholder="Enter your email" required="required"/>
                                            <button type="submit" class="bttn"
                                                    style="border-radius:30px;border:none;">Subscribe</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
