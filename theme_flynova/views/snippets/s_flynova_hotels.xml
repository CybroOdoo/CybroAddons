<?xml version="1.0" encoding="utf-8"?>
<!-- Website builder snippet defining the 'Featured Hotels' grid section for the Flynova homepage. -->
<odoo>
    <template id="s_flynova_hotels" name="Flynova Hotels">
        <section class="s_flynova_hotels position-relative"
                 data-snippet="s_flynova_hotels"
                 data-name="Flynova Hotels">
            <div class="container-fluid cmpad py-3 py-md-5">
                <div class="row conwidth">
                    <div class="col-md-12 text-center">
                        <h2 class="mainhead mb-4 text-start">Most popular hotel</h2>
                        <div class="flynova-carousel" data-carousel-autoplay="true" data-carousel-interval="2200">
                            <div class="flynova-carousel-header">
                                <button type="button" class="flynova-carousel-control flynova-carousel-control--prev" aria-label="Previous hotels">
                                    <i class="fa fa-angle-left"/>
                                </button>
                                <button type="button" class="flynova-carousel-control flynova-carousel-control--next" aria-label="Next hotels">
                                    <i class="fa fa-angle-right"/>
                                </button>
                            </div>
                            <div class="flynova-carousel-viewport">
                                <div class="flynova-carousel-track">
                                    <t t-set="hotel_packages" t-value="env['product.template'].sudo().search([('type', '=', 'service'), '|', ('flynova_listing_type', '=', 'hotel'), ('categ_id.parent_id.name', '=', 'Hotels')], limit=8)"/>
                                    <t t-foreach="hotel_packages" t-as="product">
                                        <div class="flynova-carousel-slide">
                                            <div class="destination-card">
                                                <div class="card-image1">
                                                    <img t-attf-src="/web/image/product.template/{{ product.id }}/image_1920" class="w-100 h-100 object-fit-cover" alt="Cover"/>
                                                    <div class="image-overlay1"></div>
                                                </div>
                                                <div class="card-content1">
                                                    <h3 class="card-title1" t-field="product.name"/>
                                                    <div class="card-rating">
                                                        <div class="stars">
                                                            <span class="star filled">★</span>
                                                            <span class="star filled">★</span>
                                                            <span class="star filled">★</span>
                                                            <span class="star filled">★</span>
                                                            <span class="star">★</span>
                                                            <span class="rating-value">4.5</span>
                                                        </div>
                                                        <span class="review-count">(234 Reviews)</span>
                                                    </div>
                                                    <div class="card-footer">
                                                        <span class="price"><t t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/></span>
                                                        <a t-attf-href="/hotel/{{ slug(product) }}" class="book-btn">Book</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_flynova_traveler_photos" name="Flynova Traveler Photos">
        <section class="s_flynova_traveler_photos position-relative mainbg py-3 py-md-5"
                 data-snippet="s_flynova_traveler_photos"
                 data-name="Flynova Traveler Photos">
            <div class="container-fluid cmpad py-3">
                <div class="row conwidth">
                    <div class="col-md-12 text-center">
                        <h2 class="mainhead mb-3 text-start">Best Traveller Share A Photo</h2>
                        <div class="flynova-carousel flynova-carousel--photos" data-carousel-autoplay="true" data-carousel-interval="1600" data-carousel-controls="false">
                            <div class="flynova-carousel-viewport">
                                <div class="flynova-carousel-track">
                                    <t t-set="traveller_photos" t-value="env['flynova.traveller.photo'].sudo().search([('active', '=', True)], order='sequence, id')"/>
                                    <t t-foreach="traveller_photos" t-as="photo">
                                        <div class="flynova-carousel-slide">
                                            <div class="destination-card cursor-pointer">
                                                <div class="card-image1">
                                                    <img t-att-src="'/web/image/flynova.traveller.photo/%s/image_1920' % photo.id"
                                                         t-att-alt="photo.name"/>
                                                    <div class="image-overlay1"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
