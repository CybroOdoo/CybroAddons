<?xml version="1.0" encoding="utf-8"?>
<!-- Defines the full-width hero slider for the Explore page of the Flynova theme.
     Rendered at the top of /explore and editable via the Odoo website builder. -->
<odoo>
    <template id="s_flynova_explore_hero" name="Flynova Explore Hero">
        <section class="explore-hero slider" data-snippet="s_flynova_explore_hero" data-name="Flynova Explore Hero">
            <t t-set="explore_destinations" t-value="request.env['product.template'].sudo().read_group(
                [('flynova_listing_type', '=', 'hotel'), ('location_name', '!=', False), ('location_name', '!=', '')],
                ['location_name'], ['location_name'])"/>

            <div class="container-fluid cmpad py-5">
                <div class="row">
                    <div class="col-md-6 d-flex flex-column justify-content-center pb-5 pb-md-0">
                        <h1 class="explore-hero__title">It's A Big World<br/>Out There, Go<br/>Explore
                        </h1>
                        <p class="explore-hero__sub">
                            Conveniently explore popular places with selected tour guides for
                            budget-friendly travel experiences that create lasting memories
                        </p>
                        <div class="d-flex gap-2 mb-5">
                            <a href="/tours" class="bttn">Get Started</a>
                            <a href="/about-us" class="bttn">Read More</a>
                        </div>

                        <div class="button-container">
                            <a href="/explore" class="travel-button">
                                <div class="icon share-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                         viewBox="0 0 24 24">
                                        <path fill="none" stroke="currentColor" stroke-linecap="round"
                                              stroke-linejoin="round" stroke-width="2"
                                              d="M13 4v4C6.425 9.028 3.98 14.788 3 20c-.037.206 5.384-5.962 10-6v4l8-7z"/>
                                    </svg>
                                </div>
                                <span>Share</span>
                            </a>

                            <a href="/tours" class="travel-button">
                                <div class="icon flight-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                         viewBox="0 0 24 24">
                                        <path fill="none" stroke="currentColor" stroke-linecap="round"
                                              stroke-linejoin="round" stroke-width="2"
                                              d="M15 11.085h5a2 2 0 1 1 0 4H5l-3-6h3l2 2h3l-2-7h3zM3 21h18"/>
                                    </svg>
                                </div>
                                <span>Flight</span>
                            </a>

                            <a href="/hotels" class="travel-button">
                                <div class="icon car-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                         viewBox="0 0 24 24">
                                        <g fill="none" stroke="currentColor" stroke-linecap="round"
                                           stroke-linejoin="round" stroke-width="2">
                                            <path d="M5 17a2 2 0 1 0 4 0a2 2 0 0 0-4 0m11 0a2 2 0 1 0 4 0a2 2 0 0 0-4 0M5 9l2-4h7.438a2 2 0 0 1 1.94 1.515L17 9h3a2 2 0 0 1 2 2v3M10 9V5M2 7v4"/>
                                            <path d="M22.001 14.001A5 5 0 0 0 18 12a5 5 0 0 0-4 2h-3a4.998 4.998 0 0 0-8.003.003"/>
                                            <path d="M5 12V9h13"/>
                                        </g>
                                    </svg>
                                </div>
                                <span>Car</span>
                            </a>

                            <a href="/tours" class="travel-button">
                                <div class="icon trip-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                         viewBox="0 0 24 24">
                                        <g fill="none" stroke="currentColor" stroke-linecap="round"
                                           stroke-linejoin="round" stroke-width="2">
                                            <path d="m8 16l2-6l6-2l-2 6z"/>
                                            <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0m9-9v2m0 14v2m-9-9h2m14 0h2"/>
                                        </g>
                                    </svg>
                                </div>
                                <span>Trip</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <img src="/theme_flynova/static/src/img/images/explore.png" alt=""
                             class="slideimg explore-circle-img"/>
                    </div>
                </div>

                <div class="row pt-5">
                    <div class="col-md-12">
                        <div class="slidebox">
                            <form action="/booking/search" method="post" class="w-100">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="listing_type" value="hotel"/>
                                <div class="row align-items-center">
                                    <div class="col-xl-10 pb-4 pb-xl-0">
                                        <div class="row g-4">
                                            <div class="col-xl-3 col-lg-6 col-12">
                                                <div class="box w-100">
                                                    <div class="icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                             height="24" viewBox="0 0 24 24">
                                                            <path fill="currentColor"
                                                                  d="M12 12q.825 0 1.413-.587T14 10t-.587-1.412T12 8t-1.412.588T10 10t.588 1.413T12 12m0 7.35q3.05-2.8 4.525-5.087T18 10.2q0-2.725-1.737-4.462T12 4T7.738 5.738T6 10.2q0 1.775 1.475 4.063T12 19.35M12 22q-4.025-3.425-6.012-6.362T4 10.2q0-3.75 2.413-5.975T12 2t5.588 2.225T20 10.2q0 2.5-1.987 5.438T12 22m0-12"/>
                                                        </svg>
                                                    </div>
                                                    <div class="text">
                                                        <label>Your destination</label>
                                                        <select name="destination" class="explore-select">
                                                            <option value="">All Destinations</option>
                                                            <t t-foreach="explore_destinations" t-as="dest">
                                                                <option t-att-value="dest['location_name']" class="px-2"
                                                                        t-esc="dest['location_name']"/>
                                                            </t>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xl-3 col-lg-6 col-12">
                                                <div class="box w-100">
                                                    <div class="icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                             height="24" viewBox="0 0 24 24">
                                                            <path fill="currentColor"
                                                                  d="M8 14q-.425 0-.712-.288T7 13t.288-.712T8 12t.713.288T9 13t-.288.713T8 14m4 0q-.425 0-.712-.288T11 13t.288-.712T12 12t.713.288T13 13t-.288.713T12 14m4 0q-.425 0-.712-.288T15 13t.288-.712T16 12t.713.288T17 13t-.288.713T16 14M5 22q-.825 0-1.412-.587T3 20V6q0-.825.588-1.412T5 4h1V2h2v2h8V2h2v2h1q.825 0 1.413.588T21 6v14q0 .825-.587 1.413T19 22zm0-2h14V10H5zM5 8h14V6H5zm0 0V6z"/>
                                                        </svg>
                                                    </div>
                                                    <div class="text">
                                                        <label>Check In</label>
                                                        <input type="date" name="date_in"
                                                               class="explore-input"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xl-3 col-lg-6 col-12">
                                                <div class="box w-100">
                                                    <div class="icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                             height="24" viewBox="0 0 24 24">
                                                            <path fill="currentColor"
                                                                  d="M8 14q-.425 0-.712-.288T7 13t.288-.712T8 12t.713.288T9 13t-.288.713T8 14m4 0q-.425 0-.712-.288T11 13t.288-.712T12 12t.713.288T13 13t-.288.713T12 14m4 0q-.425 0-.712-.288T15 13t.288-.712T16 12t.713.288T17 13t-.288.713T16 14M5 22q-.825 0-1.412-.587T3 20V6q0-.825.588-1.412T5 4h1V2h2v2h8V2h2v2h1q.825 0 1.413.588T21 6v14q0 .825-.587 1.413T19 22zm0-2h14V10H5zM5 8h14V6H5zm0 0V6z"/>
                                                        </svg>
                                                    </div>
                                                    <div class="text">
                                                        <label>Check Out</label>
                                                        <input type="date" name="date_out"
                                                               class="explore-input"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xl-3 col-lg-6 col-12">
                                                <div class="box w-100">
                                                    <div class="icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24"
                                                             height="24" viewBox="0 0 24 24">
                                                            <g fill="none" stroke="currentColor"
                                                               stroke-linecap="round"
                                                               stroke-linejoin="round" stroke-width="2">
                                                                <circle cx="12" cy="8" r="5"/>
                                                                <path d="M20 21a8 8 0 0 0-16 0"/>
                                                            </g>
                                                        </svg>
                                                    </div>
                                                    <div class="text">
                                                        <label>Adult</label>
                                                        <input type="number" name="guests" value="1" min="1"
                                                               class="explore-input"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-2">
                                        <button type="submit" class="bttn w-100 border-0"
                                                style="height: 50px;">Book Now
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
