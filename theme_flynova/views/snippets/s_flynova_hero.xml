<?xml version="1.0" encoding="utf-8"?>
<!-- Website builder snippet defining the main hero search banner on the Flynova homepage, including the destination and date booking form. -->
<odoo>
    <template id="s_flynova_hero" name="Flynova Hero">
        <section class="s_flynova_hero slider" data-snippet="s_flynova_hero" data-name="Flynova Hero">
            <!-- Self-contained destination list — works on homepage AND explore page
                 without needing the controller to inject anything. -->
            <t t-set="booking_destinations" t-value="request.env['product.template'].sudo().read_group(
                [('flynova_listing_type', '=', 'hotel'), ('location_name', '!=', False), ('location_name', '!=', '')],
                ['location_name'], ['location_name'])"/>

            <div class="container-fluid cmpad">
                <div class="row conwidth">
                    <div class="col-md-6 d-flex flex-column justify-content-center pb-5 pb-md-0">
                        <h1>It's A Big World<br/>Out There, Go <br/>Explore</h1>
                        <p>
                            Conveniently explore popular places with selected tour guides for budget-friendly travel
                            experiences that create lasting memories
                        </p>
                        <div class="d-flex gap-2">
                            <a href="/hotels" class="bttn">Get Started</a>
                            <a href="/about-us" class="bttn bttn-tra">Read More</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <img src="/theme_flynova/static/src/img/images/slider.png" alt="" class="slideimg"/>
                    </div>
                </div>

                <div class="row conwidth">
                    <div class="col-md-12">
                        <div class="slidebox">
                            <form action="/booking/search" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="listing_type" value="hotel"/>
                                <div class="row">
                                    <div class="col-xl-10 pb-4 pb-xl-0">
                                        <div class="row g-4">

                                            <!-- Destination Dropdown (live DB data) -->
                                            <div class="col-xl-3 col-lg-6 col-12">
                                                <div class="box w-100">
                                                    <div class="icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                                            <path fill="currentColor" d="M12 12q.825 0 1.413-.587T14 10t-.587-1.412T12 8t-1.412.588T10 10t.588 1.413T12 12m0 7.35q3.05-2.8 4.525-5.087T18 10.2q0-2.725-1.737-4.462T12 4T7.738 5.738T6 10.2q0 1.775 1.475 4.063T12 19.35M12 22q-4.025-3.425-6.012-6.362T4 10.2q0-3.75 2.413-5.975T12 2t5.588 2.225T20 10.2q0 2.5-1.987 5.438T12 22m0-12"/>
                                                        </svg>
                                                    </div>
                                                    <div class="text">
                                                        <label for="hero_destination">Your destination</label>
                                                        <select id="hero_destination" name="destination" class="hero-select">
                                                            <option value="">All Destinations</option>
                                                            <t t-foreach="booking_destinations" t-as="dest">
                                                                <option t-att-value="dest['location_name']" t-esc="dest['location_name']"/>
                                                            </t>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Check In -->
                                            <div class="col-xl-3 col-lg-6 col-12">
                                                <div class="box w-100">
                                                    <div class="icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                                            <path fill="currentColor" d="M8 14q-.425 0-.712-.288T7 13t.288-.712T8 12t.713.288T9 13t-.288.713T8 14m4 0q-.425 0-.712-.288T11 13t.288-.712T12 12t.713.288T13 13t-.288.713T12 14m4 0q-.425 0-.712-.288T15 13t.288-.712T16 12t.713.288T17 13t-.288.713T16 14M5 22q-.825 0-1.412-.587T3 20V6q0-.825.588-1.412T5 4h1V2h2v2h8V2h2v2h1q.825 0 1.413.588T21 6v14q0 .825-.587 1.413T19 22zm0-2h14V10H5zM5 8h14V6H5zm0 0V6z"/>
                                                        </svg>
                                                    </div>
                                                    <div class="text">
                                                        <label>Check In</label>
                                                        <input type="date" name="date_in"/>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Check Out -->
                                            <div class="col-xl-3 col-lg-6 col-12">
                                                <div class="box w-100">
                                                    <div class="icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                                            <path fill="currentColor" d="M8 14q-.425 0-.712-.288T7 13t.288-.712T8 12t.713.288T9 13t-.288.713T8 14m4 0q-.425 0-.712-.288T11 13t.288-.712T12 12t.713.288T13 13t-.288.713T12 14m4 0q-.425 0-.712-.288T15 13t.288-.712T16 12t.713.288T17 13t-.288.713T16 14M5 22q-.825 0-1.412-.587T3 20V6q0-.825.588-1.412T5 4h1V2h2v2h8V2h2v2h1q.825 0 1.413.588T21 6v14q0 .825-.587 1.413T19 22zm0-2h14V10H5zM5 8h14V6H5zm0 0V6z"/>
                                                        </svg>
                                                    </div>
                                                    <div class="text">
                                                        <label>Check Out</label>
                                                        <input type="date" name="date_out"/>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Guests -->
                                            <div class="col-xl-3 col-lg-6 col-12">
                                                <div class="box w-100">
                                                    <div class="icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                                            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                                                <circle cx="12" cy="8" r="5"/>
                                                                <path d="M20 21a8 8 0 0 0-16 0"/>
                                                            </g>
                                                        </svg>
                                                    </div>
                                                    <div class="text">
                                                        <label>Adult</label>
                                                        <input type="number" placeholder="1" name="guests" min="1" value="1"/>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                    <div class="col-xl-2">
                                        <button type="submit" class="bttn w-100" style="height:100%;border:none;">Book Now</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
