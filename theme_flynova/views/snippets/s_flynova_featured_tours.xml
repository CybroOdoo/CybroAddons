<?xml version="1.0" encoding="utf-8"?>
<!-- Website builder snippet defining the 'Featured Tours' carousel section for the Flynova homepage. -->
<odoo>
    <template id="s_flynova_featured_tours" name="Flynova Featured Tours">
        <section class="s_flynova_featured_tours position-relative"
                 data-snippet="s_flynova_featured_tours"
                 data-name="Flynova Featured Tours">
            <div class="container-fluid cmpad py-3 py-md-5">
                <div class="row conwidth">
                    <div class="col-md-12 text-center">
                        <h2 class="mainhead mb-4 text-start">Check out our packages</h2>
                        <div class="flynova-carousel" data-carousel-autoplay="true" data-carousel-interval="2000">
                            <div class="flynova-carousel-header">
                                <button type="button" class="flynova-carousel-control flynova-carousel-control--prev" aria-label="Previous packages">
                                    <i class="fa fa-angle-left"/>
                                </button>
                                <button type="button" class="flynova-carousel-control flynova-carousel-control--next" aria-label="Next packages">
                                    <i class="fa fa-angle-right"/>
                                </button>
                            </div>
                            <div class="flynova-carousel-viewport">
                                <div class="flynova-carousel-track">
                                    <t t-set="tour_packages" t-value="env['product.template'].sudo().search([('type', '=', 'service'), '|', ('flynova_listing_type', '=', 'tour'), ('categ_id.parent_id.name', '=', 'Tours')], limit=8)"/>
                                    <t t-foreach="tour_packages" t-as="product">
                                        <div class="flynova-carousel-slide">
                                            <div class="destination-card">
                                                <div class="card-image1">
                                                    <img t-attf-src="/web/image/product.template/{{ product.id }}/image_1920" class="w-100 h-100 object-fit-cover" alt="Cover"/>
                                                    <div class="image-overlay1"></div>
                                                </div>
                                                <div class="card-content1">
                                                    <h3 class="card-title1" t-field="product.name"/>
                                                    <div class="card-rating">
                                                        <div class="stars">
                                                            <span class="star filled">★</span>
                                                            <span class="star filled">★</span>
                                                            <span class="star filled">★</span>
                                                            <span class="star filled">★</span>
                                                            <span class="star">★</span>
                                                            <span class="rating-value">4.5</span>
                                                        </div>
                                                        <span class="review-count">(234 Reviews)</span>
                                                    </div>
                                                    <div class="card-footer">
                                                        <span class="price"><t t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/></span>
                                                        <a t-attf-href="/tour/{{ slug(product) }}" class="book-btn">Book</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
