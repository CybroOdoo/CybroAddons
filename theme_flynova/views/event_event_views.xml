<?xml version="1.0" encoding="utf-8"?>
<!-- Inherits the standard event.event backend form view to add the Flynova
     custom fields: event image avatar, duration, and location name. -->
<odoo>
    <record id="event_event_view_form_inherit_flynova" model="ir.ui.view">
        <field name="name">event.event.view.form.inherit.flynova</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <!-- Place the image avatar BEFORE the oe_title block -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="image_1920" widget="image" class="oe_avatar"
                       options="{'preview_image': 'image_128'}"/>
            </xpath>
            <xpath expr="//field[@name='date_tz']" position="after">
                <field name="duration" placeholder="e.g. 1 Week"/>
                <field name="location_name" placeholder="e.g. Thailand"/>
            </xpath>
        </field>
    </record>
</odoo>
