<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        View: event.event.view.form.inherit.flynova
        Model: event.event Inherits the core Odoo event form to surface Flynova-specific travel
        fields (event image, trip duration, and destination) in the backend.
    -->
    <record id="event_view_form" model="ir.ui.view">
        <field name="name">event.event.view.form.inherit.theme.flynova</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">

            <!-- 1. Inject the event banner image as an avatar widget
                    above the event title (oe_title div). -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="image_1920" widget="image" class="oe_avatar"
                       options="{'preview_image': 'image_128'}"/>
            </xpath>

            <!-- 2. Add 'duration' and 'location_name' fields directly after
                    the timezone (date_tz) field in the date/time section. -->
            <xpath expr="//field[@name='date_tz']" position="after">
                <field name="duration" placeholder="e.g. 1 Week"/>
                <field name="location_name" placeholder="e.g. Thailand"/>
            </xpath>

        </field>
    </record>
</odoo>
