<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  EXPLORE PAGE -->
    <template id="page_explore" name="Explore Page">
        <t t-call="website.layout">
            <t t-set="is_inpage" t-value="True"/>
            <div id="wrap" class="oe_structure oe_empty">
                <t t-snippet="theme_flynova.s_flynova_explore_hero"/>
                <t t-snippet="theme_flynova.s_flynova_explore_highlights"/>
                <t t-snippet="theme_flynova.s_flynova_featured_tours"/>
                <t t-snippet="theme_flynova.s_flynova_activities"/>
                <t t-snippet="theme_flynova.s_flynova_traveler_photos"/>
                <t t-snippet="theme_flynova.s_flynova_discover"/>
            </div>
            <div class="oe_structure"/>
        </t>
    </template>

    <!-- ABOUT PAGE -->
    <template id="page_about" name="About Page">
        <t t-call="website.layout">
            <t t-set="is_inpage" t-value="True"/>
            <div id="wrap" class="oe_structure oe_empty">
                <t t-snippet="theme_flynova.s_flynova_about_hero"/>
                <t t-snippet="theme_flynova.s_flynova_about_who"/>
                <t t-snippet="theme_flynova.s_flynova_about_services"/>
                <t t-snippet="theme_flynova.s_flynova_discover"/>
            </div>
            <div class="oe_structure"/>

        </t>
    </template>

    <!-- URL Routing -->
    <record id="website_page_explore" model="website.page">
        <field name="name">Explore</field>
        <field name="url">/explore</field>
        <field name="view_id" ref="theme_flynova.page_explore"/>
        <field name="is_published">True</field>
    </record>

    <record id="website_page_about" model="website.page">
        <field name="name">About Us</field>
        <field name="url">/about-us</field>
        <field name="view_id" ref="theme_flynova.page_about"/>
        <field name="is_published">True</field>
        <field name="is_in_menu">False</field>
    </record>

</odoo>
