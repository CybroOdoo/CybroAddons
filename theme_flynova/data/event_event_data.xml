<?xml version="1.0" encoding="utf-8"?>
<!-- Demo data for event.event records used by the Flynova theme, including sample tour events with dates, locations and published status. -->
<odoo>
    <data noupdate="1">
        <record id="event_bali" model="event.event">
            <field name="name">Bali Adventure</field>
            <field name="date_begin" eval="(DateTime.today() + relativedelta(months=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(months=3, days=7)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_tz">Asia/Makassar</field>
            <field name="duration">1 Week</field>
            <field name="location_name">Indonesia</field>
            <field name="image_1920" type="base64" file="theme_flynova/static/description/icon.png"/>
            <field name="description"><![CDATA[
                Visit the ancient temples and the vibrant night markets. Explore the lush rice terraces and hidden waterfalls of Ubud.
            ]]></field>
            <field name="is_published">True</field>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_adventure'), ref('tag_beach')])]"/>
        </record>

        <record id="event_kyoto" model="event.event">
            <field name="name">Kyoto Culture</field>
            <field name="date_begin" eval="(DateTime.today() + relativedelta(months=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(months=5, days=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_tz">Asia/Tokyo</field>
            <field name="duration">5 Days</field>
            <field name="location_name">Japan</field>
            <field name="image_1920" type="base64" file="theme_flynova/static/description/icon.png"/>
            <field name="description"><![CDATA[
                Discover the incredible landmarks such as the Fushimi Inari shrine and its famous thousand vermilion torii gates.
            ]]></field>
            <field name="is_published">True</field>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_cultural'), ref('tag_luxury')])]"/>
        </record>

        <record id="event_maldives" model="event.event">
            <field name="name">Maldives Retreat</field>
            <field name="date_begin" eval="(DateTime.today() + relativedelta(months=6)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(months=6, days=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_tz">Indian/Maldives</field>
            <field name="duration">15 Days</field>
            <field name="location_name">Maldives</field>
            <field name="image_1920" type="base64" file="theme_flynova/static/description/icon.png"/>
            <field name="description"><![CDATA[
                8 Days of Ultimate Relaxation. Seaplane transfers, snorkeling with manta rays, and overwater villa luxury.
            ]]></field>
            <field name="is_published">True</field>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_beach'), ref('tag_luxury'), ref('tag_hotel')])]"/>
        </record>
    </data>
</odoo>
