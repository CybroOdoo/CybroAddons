<?xml version="1.0" encoding="utf-8"?>
<!-- Demo data for event.event.ticket records that define ticket types and capacities for Flynova sample tour events. -->
<odoo>
    <data noupdate="1">
        <record id="ticket_bali_tour" model="event.event.ticket">
            <field name="name">Guided Temple Tour</field>
            <field name="event_id" ref="event_bali"/>
            <field name="price">490.00</field>
            <field name="seats_max">20</field>
            <field name="seats_limited">True</field>
        </record>

        <record id="ticket_kyoto_tour" model="event.event.ticket">
            <field name="name">Full Kyoto City Tour</field>
            <field name="event_id" ref="event_kyoto"/>
            <field name="price">890.00</field>
            <field name="seats_max">15</field>
            <field name="seats_limited">True</field>
        </record>

        <record id="ticket_maldives_tour" model="event.event.ticket">
            <field name="name">Manta Ray Snorkeling</field>
            <field name="event_id" ref="event_maldives"/>
            <field name="price">4500.00</field>
            <field name="seats_max">12</field>
            <field name="seats_limited">True</field>
        </record>
    </data>
</odoo>
