<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains the default product categories for the theme. -->
<odoo>
    <data noupdate="1">
        <!-- Parent Categories -->
        <record id="cat_tours" model="product.category">
            <field name="name">Tours</field>
        </record>
        <record id="cat_hotels" model="product.category">
            <field name="name">Hotels</field>
        </record>

        <!-- Sub Categories (Packages) -->
        <record id="cat_bali" model="product.category">
            <field name="name">Bali Adventure</field>
            <field name="parent_id" ref="cat_tours"/>
        </record>
        <record id="cat_kyoto" model="product.category">
            <field name="name">Kyoto Culture</field>
            <field name="parent_id" ref="cat_tours"/>
        </record>
        <record id="cat_maldives" model="product.category">
            <field name="name">Maldives Retreat</field>
            <field name="parent_id" ref="cat_hotels"/>
        </record>
        <record id="cat_europe" model="product.category">
            <field name="name">Europe Escape</field>
            <field name="parent_id" ref="cat_tours"/>
        </record>
        <record id="cat_luxury" model="product.category">
            <field name="name">Luxury Hotels</field>
            <field name="parent_id" ref="cat_hotels"/>
        </record>
    </data>
</odoo>
