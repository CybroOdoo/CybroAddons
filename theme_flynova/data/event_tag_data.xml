<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains the default tag records for categorizing events. -->
<odoo>
    <data noupdate="1">
        <record id="event_tag_category_destination" model="event.tag.category">
            <field name="name">Destination Type</field>
        </record>

        <record id="tag_beach" model="event.tag">
            <field name="name">Beach</field>
            <field name="category_id" ref="event_tag_category_destination"/>
        </record>
        <record id="tag_adventure" model="event.tag">
            <field name="name">Adventure</field>
            <field name="category_id" ref="event_tag_category_destination"/>
        </record>
        <record id="tag_cultural" model="event.tag">
            <field name="name">Cultural</field>
            <field name="category_id" ref="event_tag_category_destination"/>
        </record>
        <record id="tag_luxury" model="event.tag">
            <field name="name">Luxury</field>
            <field name="category_id" ref="event_tag_category_destination"/>
        </record>
        <record id="tag_hotel" model="event.tag">
            <field name="name">Hotel</field>
            <field name="category_id" ref="event_tag_category_destination"/>
        </record>
    </data>
</odoo>
