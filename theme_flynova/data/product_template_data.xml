<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tour Products -->
        <record id="tour_bali_temple" model="product.template">
            <field name="name">Ubud Temple Tour</field>
            <field name="type">service</field>
            <field name="flynova_listing_type">tour</field>
            <field name="categ_id" ref="cat_bali"/>
            <field name="list_price">299.00</field>
            <field name="duration">1 Day</field>
            <field name="location_name">Ubud, Bali</field>
            <field name="description_sale">Explore the mystical temples of Ubud, including the famous Monkey Forest and
                Tirta Empul.
            </field>
            <field name="image_1920" type="base64" file="theme_flynova/static/src/img/images/bali.jpg"/>
        </record>

        <record id="tour_kyoto_city" model="product.template">
            <field name="name">Gion District Walk</field>
            <field name="type">service</field>
            <field name="flynova_listing_type">tour</field>
            <field name="categ_id" ref="cat_kyoto"/>
            <field name="list_price">199.00</field>
            <field name="duration">4 Hours</field>
            <field name="location_name">Kyoto, Japan</field>
            <field name="description_sale">Discover the secrets of the Geisha district and the beautiful shrines of old
                Kyoto.
            </field>
            <field name="image_1920" type="base64" file="theme_flynova/static/src/img/images/kyoto.jpeg"/>
        </record>

        <record id="tour_paris_lights" model="product.template">
            <field name="name">Paris by Night</field>
            <field name="type">service</field>
            <field name="flynova_listing_type">tour</field>
            <field name="categ_id" ref="cat_europe"/>
            <field name="list_price">450.00</field>
            <field name="duration">3 Hours</field>
            <field name="location_name">Paris, France</field>
            <field name="description_sale">Experience the magic of Paris when the sun goes down and the monuments light
                up.
            </field>
            <field name="image_1920" type="base64" file="theme_flynova/static/src/img/images/paris.jpg"/>
        </record>

        <record id="tour_swiss_alps" model="product.template">
            <field name="name">Swiss Alps Hiking</field>
            <field name="type">service</field>
            <field name="flynova_listing_type">tour</field>
            <field name="categ_id" ref="cat_europe"/>
            <field name="list_price">599.00</field>
            <field name="duration">2 Days</field>
            <field name="location_name">Zermatt, Switzerland</field>
            <field name="description_sale">A breathtaking journey through the Swiss Alps with stunning views of the
                Matterhorn.
            </field>
            <field name="image_1920" type="base64" file="theme_flynova/static/src/img/images/Santorini.jpg"/>
        </record>

        <!-- Hotel Products -->
        <record id="hotel_layar" model="product.template">
            <field name="name">The Layar Villa</field>
            <field name="type">service</field>
            <field name="flynova_listing_type">hotel</field>
            <field name="categ_id" ref="cat_maldives"/>
            <field name="list_price">899.00</field>
            <field name="duration">Per Night</field>
            <field name="location_name">Seminyak, Bali</field>
            <field name="description_sale">Luxury private villas with swimming pools and personalized service in the
                heart of Seminyak.
            </field>
            <field name="image_1920" type="base64" file="theme_flynova/static/src/img/images/Seminyak.jpg"/>
        </record>

        <record id="hotel_ritz" model="product.template">
            <field name="name">The Ritz-Carlton</field>
            <field name="type">service</field>
            <field name="flynova_listing_type">hotel</field>
            <field name="categ_id" ref="cat_luxury"/>
            <field name="list_price">1200.00</field>
            <field name="duration">Per Night</field>
            <field name="location_name">Tokyo, Japan</field>
            <field name="description_sale">Unparalleled luxury and service in the heart of Tokyo's Roppongi district.
            </field>
            <field name="image_1920" type="base64" file="theme_flynova/static/src/img/images/Tokyo.jpg"/>
        </record>

        <record id="hotel_marina_bay" model="product.template">
            <field name="name">Marina Bay Sands</field>
            <field name="type">service</field>
            <field name="flynova_listing_type">hotel</field>
            <field name="categ_id" ref="cat_luxury"/>
            <field name="list_price">950.00</field>
            <field name="duration">Per Night</field>
            <field name="location_name">Singapore</field>
            <field name="description_sale">Iconic hotel with the world's largest rooftop infinity pool and stunning city
                views.
            </field>
            <field name="image_1920" type="base64" file="theme_flynova/static/src/img/images/Singapore.jpg"/>
        </record>

        <record id="hotel_burj_al_arab" model="product.template">
            <field name="name">Burj Al Arab</field>
            <field name="type">service</field>
            <field name="flynova_listing_type">hotel</field>
            <field name="categ_id" ref="cat_luxury"/>
            <field name="list_price">1500.00</field>
            <field name="duration">Per Night</field>
            <field name="location_name">Dubai, UAE</field>
            <field name="description_sale">World-famous luxury hotel offering lavish suites, private beach access, and
                breathtaking Arabian Gulf views.
            </field>
            <field name="image_1920" type="base64" file="theme_flynova/static/src/img/images/dubai.jpg"/>
        </record>
    </data>
</odoo>
