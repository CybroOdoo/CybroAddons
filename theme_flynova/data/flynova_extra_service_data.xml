<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains the default extra service records for bookings. -->
<odoo>
    <data noupdate="1">
        <record id="extra_service_health_insurance" model="flynova.extra.service">
            <field name="name">Health Insurance</field>
            <field name="description">Full medical coverage for the duration of your trip</field>
            <field name="price">250.00</field>
            <field name="sequence">1</field>
            <field name="icon">fa-heartbeat</field>
        </record>

        <record id="extra_service_medical_insurance" model="flynova.extra.service">
            <field name="name">Medical Insurance</field>
            <field name="description">Emergency medical and evacuation coverage</field>
            <field name="price">49.00</field>
            <field name="sequence">2</field>
            <field name="icon">fa-medkit</field>
        </record>

        <record id="extra_service_travel_cancellation" model="flynova.extra.service">
            <field name="name">Trip Cancellation Cover</field>
            <field name="description">Refund protection if you need to cancel your booking</field>
            <field name="price">79.00</field>
            <field name="sequence">3</field>
            <field name="icon">fa-shield</field>
        </record>

        <record id="extra_service_baggage_insurance" model="flynova.extra.service">
            <field name="name">Baggage Protection</field>
            <field name="description">Coverage for lost, stolen or delayed baggage</field>
            <field name="price">35.00</field>
            <field name="sequence">4</field>
            <field name="icon">fa-suitcase</field>
        </record>
    </data>
</odoo>
