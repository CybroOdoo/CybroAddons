<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_order_form_inherit_order_line_note" model="ir.ui.view">
        <!-- Inherit the purchase_order form view to add field -->
        <field name="name">purchase.order.view.form.inherit.order.line.note</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Define the position to insert the new elements in the view -->
            <xpath expr="//field[@name='order_line']//list/column[@name='product_and_description']" position="after">
                <field name="note" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
