<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit_order_line_note" model="ir.ui.view">
        <!-- Inherit the sale_order form view to add field -->
        <field name="name">sale.order.view.form.inherit.order.line.note</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Define the position to insert the new elements in the view -->
            <xpath expr="//field[@name='order_line']//list/column[@name='product_and_description']" position="after">
                <field name="note" readonly="not product_updatable" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
