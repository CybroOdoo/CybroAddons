<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="multicolor_backend_theme.SearchBarMenu"
       t-inherit="web.SearchBarMenu" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_searchview_dropdown_toggler')]" position="inside">
            <!-- Odoo 20 supplies its own caret on touch devices only. -->
            <i t-if="!this.hasTouch" class="oi" data-icon="arrow_drop_down" aria-hidden="true"/>
        </xpath>
    </t>
</templates>
