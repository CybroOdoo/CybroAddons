<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--    Advanced sidebar view-->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav[hasclass('o_main_navbar')]" position="after">
            <div class="cybro-sidebar-qweb" t-att-class="{ 'sidebar-active': this.sidebarState.isOpen }">
                <div class="sidebar-menus" role="menu">
                    <DropdownItem
                        t-foreach="this.menuService.getApps()"
                        t-as="app"
                        t-key="app.id"
                        class="{ 'o_app': true, focus: this.menuService.getCurrentApp() === app }"
                        onSelected="() => { this.onNavBarDropdownItemSelection(app); this.onclickCloseSidebar(); }"
                        attrs="{ href: this.getMenuItemHref(app), 'data-menu-xmlid': app.xmlid, 'data-section': app.id }"
                    >
                        <img 
                             class="o_app_icon me-2"
                             t-attf-src="{{app.webIconData || '/web/static/img/default_icon_app.png'}}"
                             t-att-title="app.name"
                             style="width: 40px !important;height: 40px !important; border-radius: 10px !important;margin: 5px;"/>
                    </DropdownItem>
                </div>
            </div>

            <div class="sidebar_panel" t-att-class="{ 'sidebar-visible': this.sidebarState.isOpen }">
                <div class="sidebar">
                    <div class="sidebar_close">
                        <a class="sidebar-close-btn"
                           style="cursor: pointer;"
                           t-on-click="this.onclickCloseSidebar"/>
                    </div>

                    <div class="search-container form-row align-items-center m-auto col-12" t-attf-class="{{ this.searchState.hasResults ? 'has-results' : '' }}">
                        <div class="search-input col-md-12 ml-auto mr-auto">
                            <div class="d-flex align-items-center">
                                <div class="input-group-prepend">
                                    <div class="input-group-text">
                                        <i class="oi" data-icon="search" aria-hidden="true"/>
                                    </div>
                                </div>
                                <input type="search"
                                       autocomplete="off"
                                       placeholder="Search menus..."
                                       class="o_input search_input_style"
                                       t-att-value="this.searchState.query"
                                       t-on-input="this._searchMenusSchedule"
                                />
                            </div>
                        </div>
                        <div class="search-results col-md-12 ml-auto mr-auto"
                             t-attf-class="{{ !this.searchState.showResults ? 'o_hidden' : '' }}"
                             t-on-click="this.onclickCloseSidebar">
                            <t t-foreach="this.searchState.searchResults" t-as="result" t-key="result.id">
                                <p class="search-items">
                                    <a t-att-data-tooltip-info="result.name"
                                       t-att-href="result.href"
                                       t-on-click="(ev) => this.onSearchResultClick(ev, result)"
                                       t-esc="result.name"/>
                                </p>
                            </t>
                        </div>
                    </div>

                    <ul class="sidebar_menu">
                        <DropdownItem
                            t-foreach="this.menuService.getApps()"
                            t-as="app"
                            t-key="app.id"
                            class="{ 'o_app': true, focus: this.menuService.getCurrentApp() === app }"
                            onSelected="() => { this.onNavBarDropdownItemSelection(app); this.onclickCloseSidebar(); }"
                            attrs="{ href: this.getMenuItemHref(app), 'data-menu-xmlid': app.xmlid, 'data-section': app.id }"
                        >
                            <img 
                                 class="o_app_icon me-2"
                                 t-attf-src="{{app.webIconData || '/web/static/img/default_icon_app.png'}}"
                                 t-att-title="app.name"
                                 style="width: 40px !important;height: 40px !important; border-radius: 10px !important;margin: 5px;"/>
                            <b class="a_app_menu_title"><t t-esc="app.name"/></b>
                        </DropdownItem>
                    </ul>
                </div>
            </div>
        </xpath>
    </t>
     <!--Toggle icon for Advanced sidebar-->
    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//Dropdown" position="replace">
            <button type="button" class="sidebar-toggle o_menu_toggle"
                    title="Applications" aria-label="Applications"
                    t-att-aria-expanded="this.sidebarState.isOpen ? 'true' : 'false'"
                    t-on-click="this.sidebarState.isOpen ? this.onclickCloseSidebar : this.onclickOpenSidebar">
                <i class="oi oi-lg" t-att-data-icon="this.sidebarState.isOpen ? 'close' : 'menu'" aria-hidden="true"/>
            </button>
        </xpath>
    </t>
</templates>