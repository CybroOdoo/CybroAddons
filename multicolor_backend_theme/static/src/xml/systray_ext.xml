<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_menu_systray')]" position="inside">
            <Dropdown t-if="this.themeState.isManager">
                <button title="Themes Configuration" aria-label="Themes Configuration">
                    <i class="oi oi-lg" data-icon="palette" aria-hidden="true"/>
                </button>
                <t t-set-slot="content">
                    <div class="multicolor-theme-selector p-3" style="width: 300px; max-width: 90vw;">
                        <t t-if="this.themeState.selected">
                            <label for="multicolor_theme_select" class="form-label">Theme</label>
                            <select id="multicolor_theme_select" class="theme_select form-select mb-3" t-on-change="this.onChangeTheme">
                                <option t-foreach="this.themeState.themes" t-as="theme" t-key="theme.id"
                                        t-att-value="theme.id" t-att-selected="theme.id === this.themeState.selected.id" t-out="theme.name"/>
                            </select>
                            <label for="multicolor_theme_name" class="form-label">Name</label>
                            <input id="multicolor_theme_name" class="form-control mb-3" t-att-value="this.themeState.selected.name" t-on-change="this.onThemeNameChange"/>
                            <span t-if="this.themeState.selected.is_theme_active" class="badge text-bg-success mb-3">Active</span>
                            <t t-foreach="['theme_main_color', 'theme_font_color', 'view_font_color']" t-as="field" t-key="field">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label t-att-for="'multicolor_' + field" t-out="{theme_main_color: 'Base Color', theme_font_color: 'Font Color', view_font_color: 'View Font Color'}[field]"/>
                                    <input type="color" class="form-control form-control-color" t-att-id="'multicolor_' + field"
                                           t-att-value="this.themeColorValue(field)" t-on-change="(ev) => this.onChangeThemeColor(ev, field)"/>
                                </div>
                            </t>
                        </t>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-secondary" t-on-click="this.onClickCreate">Create</button>
                            <button t-if="this.themeState.selected" class="btn btn-secondary" t-on-click="this.onClickRemove">Remove</button>
                            <button t-if="this.themeState.selected" class="btn btn-primary" t-on-click="this.onClickApply">Apply</button>
                        </div>
                    </div>
                </t>
            </Dropdown>
        </xpath>
    </t>
</templates>
