<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds a multi-select panel with bulk add-to-cart button in the shop product listing page -->
    <template id="website_add_multi_product_item_button"
              inherit_id="website_sale.products"
              name="Add Multi Item To Cart Button">
        <xpath expr="//aside[@id='products_grid_before']//div[@class='o_wsale_products_grid_before_rail vh-100 ms-n2 px-lg-2 ps-2 overflow-y-scroll']" position="before">
            <div class="row mb-3">

                <h6 class="card-title mb-2">
                    <i class="fa fa-check-square-o me-1"></i>
                    Multi-Select Mode
                </h6>
                <p class="small text-muted mb-2">Select products and add them all at once</p>
                <button type="button"
                        class="btn btn-primary btn-sm w-100 confirm_check">
                    <i class="fa fa-shopping-cart me-1"></i>Add Selected
                </button>
            </div>
        </xpath>
    </template>
    <!-- Adds a selectable checkbox to each product card for multi-product selection -->
    <template id="add_website_product_item"
              inherit_id="website_sale.products_item"
              name="Add Multi Product To Cart">
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="inside">
            <div class="ms-auto d-flex align-items-center">
                <input type="checkbox"
                       name="pdid"
                       class="mycheckbox form-check-input"
                       t-att-value="product.product_variant_ids[0].id"
                       t-att-data-product-name="product.name"
                       style="width: 22px; height: 22px; cursor: pointer;"
                       title="Select this product"/>
            </div>
        </xpath>
    </template>
</odoo>
