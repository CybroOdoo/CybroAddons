<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_enviro_management" model="res.groups.privilege">
        <field name="name">Enviro Management</field>
    </record>

    <record id="group_enviro_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_enviro_management"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('account.group_account_invoice'))]"/>
        <field name="comment">Users can log emission records and review ESG reports.</field>
    </record>

    <record id="group_enviro_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_enviro_management"/>
        <field name="implied_ids" eval="[Command.link(ref('group_enviro_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Managers can configure emission factors, targets, reporting periods, and sites.</field>
    </record>

    <record id="group_enviro_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="privilege_id" ref="privilege_enviro_management"/>
        <field name="implied_ids" eval="[Command.link(ref('group_enviro_user'))]"/>
        <field name="comment">Read-only access to all ESG records for external or internal audit purposes.</field>
    </record>

    <!-- Multi-company rules -->
    <record id="enviro_emission_record_company_rule" model="ir.rule">
        <field name="name">Enviro Emission Records: multi-company</field>
        <field name="model_id" ref="model_enviro_emission_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="enviro_emission_factor_company_rule" model="ir.rule">
        <field name="name">Enviro Emission Factors: multi-company</field>
        <field name="model_id" ref="model_enviro_emission_factor"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="enviro_target_company_rule" model="ir.rule">
        <field name="name">Enviro Targets: multi-company</field>
        <field name="model_id" ref="model_enviro_target"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="enviro_factor_rule_company_rule" model="ir.rule">
        <field name="name">Enviro Factor Rules: multi-company</field>
        <field name="model_id" ref="model_enviro_factor_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="enviro_initiative_company_rule" model="ir.rule">
        <field name="name">Enviro Initiatives: multi-company</field>
        <field name="model_id" ref="model_enviro_initiative"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="enviro_offset_company_rule" model="ir.rule">
        <field name="name">Enviro Offsets: multi-company</field>
        <field name="model_id" ref="model_enviro_offset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="enviro_reporting_period_company_rule" model="ir.rule">
        <field name="name">Enviro Reporting Periods: multi-company</field>
        <field name="model_id" ref="model_enviro_reporting_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="enviro_site_company_rule" model="ir.rule">
        <field name="name">Enviro Sites: multi-company</field>
        <field name="model_id" ref="model_enviro_site"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
