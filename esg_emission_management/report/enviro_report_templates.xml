<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_enviro_emission_records">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Enviro Emission Records Summary</h2>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Name</th>
                                <th>Reporting Class</th>
                                <th>Category</th>
                                <th>Factor</th>
                                <th>Period</th>
                                <th>Site</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">tCO2e</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_tonnes" t-value="0"/>
                            <tr t-foreach="docs" t-as="entry">
                                <t t-set="total_tonnes" t-value="total_tonnes + entry.co2e_tonnes"/>
                                <td><span t-field="entry.date"/></td>
                                <td><span t-field="entry.name"/></td>
                                <td><span t-field="entry.scope"/></td>
                                <td><span t-field="entry.category"/></td>
                                <td><span t-field="entry.factor_id"/></td>
                                <td><span t-field="entry.reporting_period_id"/></td>
                                <td><span t-field="entry.site_id"/></td>
                                <td class="text-end"><span t-field="entry.quantity"/></td>
                                <td class="text-end"><span t-esc="'%.3f' % entry.co2e_tonnes"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="8" class="text-end"><strong>Total</strong></td>
                                <td class="text-end"><strong><span t-esc="'%.3f' % total_tonnes"/></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
