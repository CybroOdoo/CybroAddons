<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enviro_initiative_view_list" model="ir.ui.view">
        <field name="name">enviro.initiative.list</field>
        <field name="model">enviro.initiative</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="category"/>
                <field name="responsible_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="expected_saving_tonnes" sum="Expected Saving"/>
                <field name="actual_saving_tonnes" sum="Actual Saving"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="enviro_initiative_view_form" model="ir.ui.view">
        <field name="name">enviro.initiative.form</field>
        <field name="model">enviro.initiative</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_done" type="object" string="Mark Done" invisible="state not in ('planned', 'in_progress')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Replace warehouse lighting with LEDs"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="responsible_id"/>
                            <field name="category"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="expected_saving_tonnes"/>
                            <field name="actual_saving_tonnes"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Implementation plan, assumptions, evidence, and updates."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="enviro_initiative_action" model="ir.actions.act_window">
        <field name="name">Reduction Initiatives</field>
        <field name="res_model">enviro.initiative</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
