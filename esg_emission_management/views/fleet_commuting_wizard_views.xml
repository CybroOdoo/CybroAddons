<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enviro_fleet_commuting_wizard_form" model="ir.ui.view">
        <field name="name">enviro.fleet.commuting.wizard.form</field>
        <field name="model">enviro.fleet.commuting.wizard</field>
        <field name="arch" type="xml">
            <form string="Fleet Commuting Emissions">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                    <group>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Preview" name="preview">
                        <field name="preview_line_ids" readonly="1">
                            <list>
                                <field name="vehicle_name"/>
                                <field name="driver_name"/>
                                <field name="overlap_days"/>
                                <field name="round_trip_km"/>
                                <field name="office_ratio_pct" string="Office %" widget="percentage"/>
                                <field name="co2_gkm"/>
                                <field name="total_km"/>
                                <field name="co2e_kg"/>
                            </list>
                        </field>
                        <p class="text-muted">
                            Click <b>Preview</b> to calculate before generating records.
                            Only drivers linked to an employee with home-work distance set are included.
                            Vehicles with CO₂ = 0 are skipped.
                        </p>
                    </page>
                </notebook>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_generate" type="object" string="Generate Emission Records" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="enviro_fleet_commuting_wizard_action" model="ir.actions.act_window">
        <field name="name">Fleet Commuting Emissions</field>
        <field name="res_model">enviro.fleet.commuting.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
