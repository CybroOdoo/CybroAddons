<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enviro_gas_view_list" model="ir.ui.view">
        <field name="name">enviro.gas.list</field>
        <field name="model">enviro.gas</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="global_warming_potential"/>
            </list>
        </field>
    </record>
    <record id="enviro_gas_view_form" model="ir.ui.view">
        <field name="name">enviro.gas.form</field>
        <field name="model">enviro.gas</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Methane"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="global_warming_potential"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Source, assumptions, or GWP version notes."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="enviro_gas_view_search" model="ir.ui.view">
        <field name="name">enviro.gas.search</field>
        <field name="model">enviro.gas</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="enviro_gas_action" model="ir.actions.act_window">
        <field name="name">Gases</field>
        <field name="res_model">enviro.gas</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
