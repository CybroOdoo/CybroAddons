<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enviro_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">esg_emission_management.dashboard</field>
    </record>

    <menuitem
        id="enviro_main_menu"
        name="Environmental Social Governance"
        web_icon="esg_emission_management,static/description/icon.png"
        sequence="65"
        groups="esg_emission_management.group_enviro_user"
    >
        <menuitem
            id="enviro_dashboard_menu"
            name="Dashboard"
            sequence="10"
            action="enviro_dashboard_action"
        />
        <menuitem
            id="enviro_emission_record_menu"
            name="Emission Records"
            sequence="20"
            action="enviro_emission_record_action"
        />
        <menuitem
            id="enviro_reporting_menu"
            name="Reports"
            sequence="30"
            action="enviro_emission_record_reporting_action"
        />
        <menuitem
            id="enviro_target_menu"
            name="Targets"
            sequence="40"
            action="enviro_target_action"
        />
        <menuitem
            id="enviro_initiative_menu"
            name="Initiatives"
            sequence="45"
            action="enviro_initiative_action"
        />
        <menuitem
            id="enviro_offset_menu"
            name="Offsets"
            sequence="47"
            action="enviro_offset_action"
        />
        <menuitem
            id="enviro_fleet_menu"
            name="Fleet"
            sequence="35"
            groups="esg_emission_management.group_enviro_user"
        >
            <menuitem
                id="enviro_fleet_commuting_menu"
                name="Commuting Emissions"
                sequence="10"
                action="enviro_fleet_commuting_wizard_action"
            />
        </menuitem>
        <menuitem
            id="enviro_configuration_menu"
            name="Configuration"
            sequence="50"
            groups="esg_emission_management.group_enviro_manager"
        >
            <menuitem
                id="enviro_emission_factor_menu"
                name="Emission Factors"
                sequence="10"
                action="enviro_emission_factor_action"
            />
            <menuitem
                id="enviro_gas_menu"
                name="Gases"
                sequence="15"
                action="enviro_gas_action"
            />
            <menuitem
                id="enviro_activity_type_menu"
                name="Activity Types"
                sequence="20"
                action="enviro_activity_type_action"
            />
            <menuitem
                id="enviro_factor_rule_menu"
                name="Assignment Rules"
                sequence="30"
                action="enviro_factor_rule_action"
            />
            <menuitem
                id="enviro_reporting_period_menu"
                name="Reporting Periods"
                sequence="40"
                action="enviro_reporting_period_action"
            />
            <menuitem
                id="enviro_site_menu"
                name="Sites / Facilities"
                sequence="50"
                action="enviro_site_action"
            />
        </menuitem>
    </menuitem>
</odoo>
