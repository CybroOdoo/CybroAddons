<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enviro_target_view_list" model="ir.ui.view">
        <field name="name">enviro.target.list</field>
        <field name="model">enviro.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="year"/>
                <field name="reporting_period_id"/>
                <field name="company_id"/>
                <field name="baseline_tonnes"/>
                <field name="target_reduction_pct"/>
                <field name="target_tonnes"/>
                <field name="actual_tonnes"/>
                <field name="progress_pct" widget="progressbar"/>
            </list>
        </field>
    </record>
    <record id="enviro_target_view_form" model="ir.ui.view">
        <field name="name">enviro.target.form</field>
        <field name="model">enviro.target</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="year"/>
                            <field name="reporting_period_id"/>
                            <field name="baseline_tonnes"/>
                            <field name="target_reduction_pct"/>
                        </group>
                        <group>
                            <field name="target_tonnes"/>
                            <field name="actual_tonnes"/>
                            <field name="progress_pct" widget="progressbar"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="enviro_target_view_search" model="ir.ui.view">
        <field name="name">enviro.target.search</field>
        <field name="model">enviro.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="year"/>
                <field name="reporting_period_id"/>
                <field name="company_id"/>
                <group>
                    <filter name="group_year" context="{'group_by': 'year'}"/>
                    <filter name="group_period" string="Reporting Period" context="{'group_by': 'reporting_period_id'}"/>
                    <filter name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="enviro_target_action" model="ir.actions.act_window">
        <field name="name">Enviro Targets</field>
        <field name="res_model">enviro.target</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
