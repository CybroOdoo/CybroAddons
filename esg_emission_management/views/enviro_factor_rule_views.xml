<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enviro_factor_rule_view_list" model="ir.ui.view">
        <field name="name">enviro.factor.rule.list</field>
        <field name="model">enviro.factor.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="factor_id"/>
                <field name="activity_type_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="enviro_factor_rule_view_form" model="ir.ui.view">
        <field name="name">enviro.factor.rule.form</field>
        <field name="model">enviro.factor.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Diesel products use Diesel Fuel factor"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="factor_id"/>
                            <field name="activity_type_id"/>
                        </group>
                        <group string="Match Conditions">
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <field name="account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="enviro_factor_rule_view_search" model="ir.ui.view">
        <field name="name">enviro.factor.rule.search</field>
        <field name="model">enviro.factor.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="factor_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <group>
                    <filter name="group_factor" context="{'group_by': 'factor_id'}"/>
                    <filter name="group_activity" context="{'group_by': 'activity_type_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="enviro_factor_rule_action" model="ir.actions.act_window">
        <field name="name">Assignment Rules</field>
        <field name="res_model">enviro.factor.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
