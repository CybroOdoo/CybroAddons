<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enviro_site_view_list" model="ir.ui.view">
        <field name="name">enviro.site.list</field>
        <field name="model">enviro.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="site_type"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="floor_area_m2"/>
                <field name="entry_count"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="enviro_site_view_form" model="ir.ui.view">
        <field name="name">enviro.site.form</field>
        <field name="model">enviro.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_entries" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="entry_count" widget="statinfo" string="Records"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. London HQ"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="parent_id"/>
                            <field name="site_type"/>
                        </group>
                        <group>
                            <field name="floor_area_m2"/>
                            <field name="country_id"/>
                            <field name="city"/>
                            <field name="street"/>
                        </group>
                    </group>
                    <group string="Coordinates (for climate risk mapping)">
                        <field name="latitude"/>
                        <field name="longitude"/>
                    </group>
                    <notebook>
                        <page string="Sub-Sites">
                            <field name="child_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="site_type"/>
                                    <field name="city"/>
                                    <field name="floor_area_m2"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="enviro_site_view_search" model="ir.ui.view">
        <field name="name">enviro.site.search</field>
        <field name="model">enviro.site</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name"/>
                <field name="city"/>
                <field name="country_id"/>
                <filter name="top_level" string="Top Level" domain="[('parent_id', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_type" context="{'group_by': 'site_type'}"/>
                    <filter name="group_country" context="{'group_by': 'country_id'}"/>
                    <filter name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="enviro_site_action" model="ir.actions.act_window">
        <field name="name">Sites / Facilities</field>
        <field name="res_model">enviro.site</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
