<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_esg" model="ir.ui.view">
        <field name="name">account.move.form.esg</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_enviro_emission_records" type="object"
                        class="oe_stat_button" icon="fa-leaf"
                        invisible="enviro_emission_record_count == 0">
                    <field name="enviro_emission_record_count" widget="statinfo" string="Enviro Records"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="reporting_period_id" invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
