<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enviro_reporting_period_view_list" model="ir.ui.view">
        <field name="name">enviro.reporting.period.list</field>
        <field name="model">enviro.reporting.period</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'locked'" decoration-info="state == 'open'">
                <field name="name"/>
                <field name="company_id"/>
                <field name="period_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="entry_count"/>
                <field name="target_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="enviro_reporting_period_view_form" model="ir.ui.view">
        <field name="name">enviro.reporting.period.form</field>
        <field name="model">enviro.reporting.period</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_lock" type="object" string="Lock" invisible="state != 'closed'"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state == 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed,locked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_entries" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="entry_count" widget="statinfo" string="Records"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. FY 2025"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="period_type"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes about this reporting period, boundary assumptions, etc."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="enviro_reporting_period_view_search" model="ir.ui.view">
        <field name="name">enviro.reporting.period.search</field>
        <field name="model">enviro.reporting.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="locked" string="Locked" domain="[('state', '=', 'locked')]"/>
                <separator/>
                <group>
                    <filter name="group_type" context="{'group_by': 'period_type'}"/>
                    <filter name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="enviro_reporting_period_action" model="ir.actions.act_window">
        <field name="name">Reporting Periods</field>
        <field name="res_model">enviro.reporting.period</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
