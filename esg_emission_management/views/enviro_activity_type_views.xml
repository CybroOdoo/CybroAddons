<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enviro_activity_type_view_list" model="ir.ui.view">
        <field name="name">enviro.activity.type.list</field>
        <field name="model">enviro.activity.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="scope" string="Reporting Class"/>
                <field name="category"/>
            </list>
        </field>
    </record>
    <record id="enviro_activity_type_view_form" model="ir.ui.view">
        <field name="name">enviro.activity.type.form</field>
        <field name="model">enviro.activity.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="scope" string="Reporting Class"/>
                        <field name="category"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="enviro_activity_type_action" model="ir.actions.act_window">
        <field name="name">Activity Types</field>
        <field name="res_model">enviro.activity.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
