<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="factor_grid_electricity" model="enviro.emission.factor">
        <field name="name">Grid Electricity</field>
        <field name="category">energy</field>
        <field name="scope">scope2</field>
        <field name="calculation_type">quantity</field>
        <field name="uom_id" ref="uom.product_uom_kwh"/>
        <field name="kg_co2e_per_unit">0.233</field>
        <field name="source">Default seed data</field>
    </record>
    <record id="factor_diesel" model="enviro.emission.factor">
        <field name="name">Diesel Fuel</field>
        <field name="category">fleet</field>
        <field name="scope">scope1</field>
        <field name="calculation_type">quantity</field>
        <field name="uom_id" ref="uom.product_uom_litre"/>
        <field name="kg_co2e_per_unit">2.68</field>
        <field name="use_gas_breakdown">1</field>
        <field name="source">Default seed data</field>
    </record>
    <record id="factor_diesel_gas_co2" model="enviro.emission.factor.gas.line">
        <field name="factor_id" ref="factor_diesel"/>
        <field name="gas_id" ref="enviro_gas_co2"/>
        <field name="gas_quantity_kg">2.68</field>
    </record>
    <record id="factor_petrol" model="enviro.emission.factor">
        <field name="name">Petrol Fuel</field>
        <field name="category">fleet</field>
        <field name="scope">scope1</field>
        <field name="calculation_type">quantity</field>
        <field name="uom_id" ref="uom.product_uom_litre"/>
        <field name="kg_co2e_per_unit">2.31</field>
        <field name="use_gas_breakdown">1</field>
        <field name="source">Default seed data</field>
    </record>
    <record id="factor_petrol_gas_co2" model="enviro.emission.factor.gas.line">
        <field name="factor_id" ref="factor_petrol"/>
        <field name="gas_id" ref="enviro_gas_co2"/>
        <field name="gas_quantity_kg">2.31</field>
    </record>
    <record id="factor_domestic_flight" model="enviro.emission.factor">
        <field name="name">Domestic Flight Passenger Distance</field>
        <field name="category">travel</field>
        <field name="scope">scope3</field>
        <field name="calculation_type">quantity</field>
        <field name="uom_id" ref="uom.product_uom_km"/>
        <field name="kg_co2e_per_unit">0.255</field>
        <field name="source">Default seed data</field>
    </record>
    <record id="factor_landfill_waste" model="enviro.emission.factor">
        <field name="name">Landfill Waste</field>
        <field name="category">waste</field>
        <field name="scope">scope3</field>
        <field name="calculation_type">quantity</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="kg_co2e_per_unit">0.587</field>
        <field name="source">Default seed data</field>
    </record>
    <record id="factor_carbon_offset" model="enviro.emission.factor">
        <field name="name">Carbon Offset Credit</field>
        <field name="category">offset</field>
        <field name="scope">scope3</field>
        <field name="calculation_type">quantity</field>
        <field name="uom_id" ref="uom.product_uom_ton"/>
        <field name="kg_co2e_per_unit">0</field>
        <field name="source">Default seed data</field>
    </record>
</data>
</odoo>
