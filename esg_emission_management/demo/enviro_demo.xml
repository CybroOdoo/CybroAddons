<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_period_fy2026" model="enviro.reporting.period">
        <field name="name">FY 2026</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date_start">2026-01-01</field>
        <field name="date_end">2026-12-31</field>
        <field name="period_type">annual</field>
        <field name="state">open</field>
    </record>

    <record id="demo_site_hq" model="enviro.site">
        <field name="name">Headquarters</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="site_type">hq</field>
        <field name="city">London</field>
        <field name="country_id" ref="base.uk"/>
        <field name="floor_area_m2">2500</field>
    </record>

    <record id="demo_site_warehouse" model="enviro.site">
        <field name="name">Warehouse</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="parent_id" ref="demo_site_hq"/>
        <field name="site_type">warehouse</field>
        <field name="city">London</field>
        <field name="country_id" ref="base.uk"/>
        <field name="floor_area_m2">5000</field>
    </record>

    <record id="demo_entry_electricity_hq_jan" model="enviro.emission.record">
        <field name="name">Electricity - HQ - January</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date">2026-01-31</field>
        <field name="factor_id" ref="esg_emission_management.factor_grid_electricity"/>
        <field name="enviro_activity_type_id" ref="esg_emission_management.activity_purchased_electricity"/>
        <field name="reporting_period_id" ref="demo_period_fy2026"/>
        <field name="site_id" ref="demo_site_hq"/>
        <field name="quantity">12400</field>
        <field name="uom_id" ref="uom.product_uom_kwh"/>
        <field name="source_type">manual</field>
        <field name="state">logged</field>
        <field name="notes">Monthly electricity consumption from utility bill.</field>
    </record>

    <record id="demo_entry_electricity_hq_feb" model="enviro.emission.record">
        <field name="name">Electricity - HQ - February</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date">2026-02-28</field>
        <field name="factor_id" ref="esg_emission_management.factor_grid_electricity"/>
        <field name="enviro_activity_type_id" ref="esg_emission_management.activity_purchased_electricity"/>
        <field name="reporting_period_id" ref="demo_period_fy2026"/>
        <field name="site_id" ref="demo_site_hq"/>
        <field name="quantity">11680</field>
        <field name="uom_id" ref="uom.product_uom_kwh"/>
        <field name="source_type">manual</field>
        <field name="state">logged</field>
    </record>

    <record id="demo_entry_diesel_fleet_jan" model="enviro.emission.record">
        <field name="name">Fleet Diesel - January</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date">2026-01-25</field>
        <field name="factor_id" ref="esg_emission_management.factor_diesel"/>
        <field name="enviro_activity_type_id" ref="esg_emission_management.activity_mobile_combustion"/>
        <field name="reporting_period_id" ref="demo_period_fy2026"/>
        <field name="quantity">820</field>
        <field name="uom_id" ref="uom.product_uom_litre"/>
        <field name="source_type">manual</field>
        <field name="state">logged</field>
    </record>

    <record id="demo_entry_petrol_sales_team" model="enviro.emission.record">
        <field name="name">Sales Team Petrol</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date">2026-03-12</field>
        <field name="factor_id" ref="esg_emission_management.factor_petrol"/>
        <field name="enviro_activity_type_id" ref="esg_emission_management.activity_mobile_combustion"/>
        <field name="reporting_period_id" ref="demo_period_fy2026"/>
        <field name="quantity">430</field>
        <field name="uom_id" ref="uom.product_uom_litre"/>
        <field name="source_type">manual</field>
        <field name="state">logged</field>
    </record>

    <record id="demo_entry_domestic_flights" model="enviro.emission.record">
        <field name="name">Domestic Flights - Sales Visits</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date">2026-03-20</field>
        <field name="factor_id" ref="esg_emission_management.factor_domestic_flight"/>
        <field name="enviro_activity_type_id" ref="esg_emission_management.activity_business_travel"/>
        <field name="reporting_period_id" ref="demo_period_fy2026"/>
        <field name="quantity">5400</field>
        <field name="uom_id" ref="uom.product_uom_km"/>
        <field name="source_type">manual</field>
        <field name="state">logged</field>
    </record>

    <record id="demo_entry_landfill_waste" model="enviro.emission.record">
        <field name="name">Warehouse Landfill Waste</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date">2026-04-08</field>
        <field name="factor_id" ref="esg_emission_management.factor_landfill_waste"/>
        <field name="enviro_activity_type_id" ref="esg_emission_management.activity_waste"/>
        <field name="reporting_period_id" ref="demo_period_fy2026"/>
        <field name="site_id" ref="demo_site_warehouse"/>
        <field name="quantity">960</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="source_type">manual</field>
        <field name="state">logged</field>
    </record>

    <record id="demo_entry_draft_electricity" model="enviro.emission.record">
        <field name="name">Electricity - Branch Office Draft</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date">2026-04-30</field>
        <field name="factor_id" ref="esg_emission_management.factor_grid_electricity"/>
        <field name="enviro_activity_type_id" ref="esg_emission_management.activity_purchased_electricity"/>
        <field name="reporting_period_id" ref="demo_period_fy2026"/>
        <field name="quantity">3100</field>
        <field name="uom_id" ref="uom.product_uom_kwh"/>
        <field name="source_type">manual</field>
        <field name="state">draft</field>
    </record>

    <record id="demo_entry_missing_factor" model="enviro.emission.record">
        <field name="name">Office Supplies - Missing Factor</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date">2026-04-18</field>
        <field name="quantity">1</field>
        <field name="source_type">manual</field>
        <field name="state">missing</field>
        <field name="notes">Example record that needs an emission factor before logging.</field>
    </record>

    <record id="demo_target_2026" model="enviro.target">
        <field name="company_id" ref="base.main_company"/>
        <field name="year">2026</field>
        <field name="reporting_period_id" ref="demo_period_fy2026"/>
        <field name="baseline_tonnes">28.5</field>
        <field name="target_reduction_pct">20</field>
    </record>

    <record id="demo_initiative_led_lighting" model="enviro.initiative">
        <field name="name">LED Lighting Upgrade</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="category">efficiency</field>
        <field name="start_date">2026-02-01</field>
        <field name="end_date">2026-06-30</field>
        <field name="expected_saving_tonnes">4.2</field>
        <field name="actual_saving_tonnes">1.1</field>
        <field name="progress">35</field>
        <field name="state">in_progress</field>
    </record>

    <record id="demo_initiative_ev_fleet" model="enviro.initiative">
        <field name="name">Pilot EV Fleet Replacement</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="category">fleet</field>
        <field name="start_date">2026-04-01</field>
        <field name="expected_saving_tonnes">8.5</field>
        <field name="progress">10</field>
        <field name="state">planned</field>
    </record>

    <record id="demo_offset_reforestation" model="enviro.offset">
        <field name="name">Reforestation Credits 2026</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="provider">Demo Offset Provider</field>
        <field name="project_name">Community Reforestation Project</field>
        <field name="project_type">reforestation</field>
        <field name="vintage_year">2025</field>
        <field name="certificate_number">DEMO-OFFSET-2026-001</field>
        <field name="purchase_date">2026-04-15</field>
        <field name="tonnes">10</field>
        <field name="retired_tonnes">4</field>
        <field name="state">partially_retired</field>
    </record>

    <!-- Fleet commuting demo: assignment logs for the commuting wizard -->
    <record id="base.main_company" model="res.company">
        <field name="enviro_weekly_office_days">4.0</field>
    </record>

    <record id="fleet_assign_demo_1" model="fleet.vehicle.assignation.log">
        <field name="vehicle_id" ref="fleet.vehicle_1"/>
        <field name="driver_id" ref="base.partner_demo"/>
        <field name="date_start" eval="(datetime.today() - timedelta(days=90)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="fleet_assign_demo_2" model="fleet.vehicle.assignation.log">
        <field name="vehicle_id" ref="fleet.vehicle_4"/>
        <field name="driver_id" ref="hr.work_contact_hne"/>
        <field name="date_start" eval="(datetime.today() - timedelta(days=90)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="fleet_assign_demo_3" model="fleet.vehicle.assignation.log">
        <field name="vehicle_id" ref="fleet.vehicle_3"/>
        <field name="driver_id" ref="hr.work_contact_fpi"/>
        <field name="date_start" eval="(datetime.today() - timedelta(days=90)).strftime('%Y-%m-%d')"/>
    </record>

</odoo>
