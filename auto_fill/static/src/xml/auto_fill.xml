<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="FieldAutoFill">
        <t t-if="props.readonly">
            <span t-esc="value"/>
        </t>
        <t t-else="">
            <div class="o_auto_fill_container position-relative" t-ref="container">
                <input
                    type="text"
                    t-ref="input_data"
                    class="o_input input_field_auto_fill"
                    t-att-id="props.id"
                    t-att-placeholder="props.placeholder"
                    t-on-keyup="_onKeyup"
                />
                <table
                    t-if="state.matches.length"
                    id="list_matches"
                    class="list_matches"
                >
                    <tbody>
                        <t t-foreach="state.matches" t-as="match" t-key="match_index">
                            <tr t-on-click="() => this._onSelectRecord(match)">
                                <td><t t-esc="match"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </t>
</templates>
