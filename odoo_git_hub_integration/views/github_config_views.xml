<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_github_config_form" model="ir.ui.view">
        <field name="name">github.config.form</field>
        <field name="model">github.config</field>
        <field name="arch" type="xml">
            <form string="Configuration">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="GitHub"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <div class="row">
                        <div class="col-6">
                            <label for="access_token" string="Personal Access Token" class="fw-bold"/>
                            <div class="text-muted mb-2">Enter your Personal Access Token</div>
                            <field name="access_token" password="True" placeholder="Token"/>
                            
                            <div class="mt-4">
                                <p class="text-info mb-1">To generate your token, click the button below:</p>
                                <a href="https://github.com/settings/tokens" target="_blank" class="btn btn-link p-0 mb-3">Github Access token</a>
                                
                                <p class="mb-1">Follow these steps:</p>
                                <ol class="ps-3 small text-muted">
                                    <li>Select 'Personal access tokens' and click 'Generate new token'.</li>
                                    <li>Follow the instructions to create your token, then copy and paste it into the field above.</li>
                                </ol>
                            </div>
                        </div>
                        <div class="col-6">
                            <label for="username" string="GitHub Username" class="fw-bold"/>
                            <div class="text-muted mb-2">Enter your GitHub Username</div>
                            <field name="username" placeholder="User"/>
                        </div>
                    </div>
                    <notebook>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_github_config_final" model="ir.actions.act_window">
        <field name="name">GitHub Configurations</field>
        <field name="res_model">github.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Setup your GitHub Configuration here!
            </p>
        </field>
    </record>
</odoo>
