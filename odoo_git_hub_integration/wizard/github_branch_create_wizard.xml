<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_github_branch_create_wizard_form" model="ir.ui.view">
        <field name="name">github.branch.create.wizard.form</field>
        <field name="model">github.branch.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Branch">
                <group>
                    <field name="repository_id"/>
                    <field name="branch_name" placeholder="feature-new"/>
                    <field name="base_branch_name"/>
                </group>
                <footer>
                    <button name="action_confirm_create" type="object" string="Create Branch" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>