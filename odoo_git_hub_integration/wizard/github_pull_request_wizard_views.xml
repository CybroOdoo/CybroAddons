<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pull Request Wizard Form -->
    <record id="github_pull_request_wizard_view_form" model="ir.ui.view">
        <field name="name">github.pull.request.wizard.form</field>
        <field name="model">github.pull.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Pull Request">
                <sheet>
                    <div class="oe_title">
                        <h1>Create Pull Request</h1>
                    </div>

                    <group>
                        <group>
                            <field name="repository_id" options="{'no_create': True}"/>
                            <field name="name" placeholder="Brief description of changes"/>
                        </group>
                        <group>
                            <field name="head_branch" placeholder="feature-branch"/>
                            <field name="base_branch" placeholder="main"/>
                        </group>
                    </group>
                    <field name="description"
                           nolabel="1"
                           placeholder="Detailed description of changes..."
                           widget="text"
                           />
                </sheet>
                <footer>
                    <button name="action_create_pull_request" type="object"
                            string="Create Pull Request" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_github_pull_request_wizard" model="ir.actions.act_window">
        <field name="name">Create Pull Request</field>
        <field name="res_model">github.pull.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>