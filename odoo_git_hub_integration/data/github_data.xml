<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron job for automatic synchronization -->
    <record id="cron_github_sync" model="ir.cron">
        <field name="name">GitHub Auto Sync</field>
        <field name="model_id" ref="model_github_repository"/>
        <field name="state">code</field>
        <field name="code">model.cron_github_sync()</field>
        <field name="interval_number">24</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>