<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Smart Alert privilege, grouping the access levels in the user form -->
    <record id="res_groups_privilege_smart_alert" model="res.groups.privilege">
        <field name="name">Smart Alert</field>
        <field name="sequence">50</field>
    </record>
    <!-- Smart Alert Warning: User, can see the alerts -->
    <record id="smart_alert_warning_group_user" model="res.groups">
        <field name="name">Smart Alert Warning: User</field>
        <field name="privilege_id" ref="res_groups_privilege_smart_alert"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!-- Smart Alert Warning: Admin, can also create and apply alerts -->
    <record id="smart_alert_warning_group_admin" model="res.groups">
        <field name="name">Smart Alert Warning: Admin</field>
        <field name="privilege_id" ref="res_groups_privilege_smart_alert"/>
        <field name="implied_ids" eval="[(4, ref('smart_alert_warning_group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
