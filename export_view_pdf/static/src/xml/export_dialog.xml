<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<!--    template for export dialog-->
    <t t-name="ExportPdf.List" class="export-pdf">
        <Dialog size="'md'" title="this.props.title" modalRef="this.modalRef">
            <div class="md-8">
                <h2><center>SELECT FIELDS</center></h2>
                <t t-foreach="this.props.context" t-as="example" t-key="example.name">
                    <div class="col-3 o_export_field_item" style="font-weight:bolder;" id="check">
                        <label class="cursor-pointer mb-0">
                            <input class="me-2" type="checkbox"
                                   t-att-id="example.name"
                                   t-att-name="example.name"
                                   t-att-value="example.label"/>
                            <t t-out="example.label"/>
                        </label>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn" t-att-class="this.props.confirmClass" t-on-click="this._confirm" t-out="this.props.confirmLabel"/>
                <button class="btn btn-secondary" t-on-click="this._cancel" t-out="this.props.cancelLabel"/>
            </t>
        </Dialog>
    </t>
</templates>
