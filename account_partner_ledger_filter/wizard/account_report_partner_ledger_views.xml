<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit partner ledger report wizard view to add partner filter and initial balance option -->
    <record id="account_report_partner_ledger_view" model="ir.ui.view">
        <field name="name">account.report.partner.ledger.view.form.inherit.account.partner.ledger.filter</field>
        <field name="model">account.report.partner.ledger</field>
        <field name="inherit_id" ref="base_accounting_kit.account_report_partner_ledger_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_ids']" position="before">
                <field name="partner_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//field[@name='reconciled']" position="before">
                <field name="is_include_initial_balance"/>
            </xpath>
        </field>
    </record>
</odoo>
