<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define a view that inherits from the base partner ledger report view. -->
    <record id="account_report_partner_ledger_view" model="ir.ui.view">
        <field name="name">
            base.account.kit.account.report.partner.ledger.view.form.inherit.account.partner.ledger.filter
        </field>
        <field name="model">account.report.partner.ledger</field>
        <field name="inherit_id"
               ref="base_accounting_kit.account_report_partner_ledger_view"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='journal_ids']" position="before">
                    <field name="partner_ids" widget="many2many_tags"/>
                </xpath>
                <xpath expr="//field[@name='reconciled']" position="before">
                    <field name="is_include_initial_balance"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
