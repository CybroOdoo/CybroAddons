<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--Add boolean field for enabling the payment details in invoice report-->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.payment.details.invoice.report</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']/field[@name='partner_shipping_id']" position="before">
                <field name="is_payment_details"
                       string="Payment Details in Report"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
            </xpath>
        </field>
    </record>
</odoo>