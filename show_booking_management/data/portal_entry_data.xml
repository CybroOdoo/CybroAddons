<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--  "Show Bookings" card of the customer portal home  -->
    <record id="portal_entry_show_bookings" model="portal.entry">
        <field name="name">Show Bookings</field>
        <field name="description">View your show bookings and tickets</field>
        <field name="url">/my/shows</field>
        <field name="placeholder_count">shows_count</field>
        <field name="category">client_category</field>
        <field name="image" type="bytes" file="show_booking_management/static/src/img/ticket.png"/>
    </record>
</odoo>
