<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--  Let staff find paid booking invoices whose ticket could not be issued  -->
    <record id="view_account_invoice_filter_movie_booking" model="ir.ui.view">
        <field name="name">account.invoice.select.movie.booking</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='posted']" position="after">
                <filter name="movie_booking_issue" string="Movie Booking Needs Attention"
                        domain="[('movie_booking_issue', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
