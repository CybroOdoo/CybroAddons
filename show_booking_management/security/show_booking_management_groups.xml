<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Main Category -->
    <record id="module_category_show_booking_management"
            model="ir.module.category">
        <field name="name">Show Booking Management</field>
        <field name="description">
            Category for Show Booking Management
        </field>
        <field name="sequence">10</field>
    </record>

    <!-- Prebooking Category -->
    <record id="module_category_show_prebooking"
            model="ir.module.category">
        <field name="name">Show Prebooking</field>
        <field name="description">
            Category for Show Prebooking
        </field>
        <field name="sequence">20</field>
    </record>

    <!-- Main Privilege -->
    <record id="show_booking_management_privilege"
            model="res.groups.privilege">
        <field name="name">Show Booking Management</field>
        <field name="sequence">10</field>
        <field name="category_id"
               ref="show_booking_management.module_category_show_booking_management"/>
    </record>

    <!-- Prebooking Privilege -->
    <record id="show_prebooking_privilege"
            model="res.groups.privilege">
        <field name="name">Show Prebooking</field>
        <field name="sequence">20</field>
        <field name="category_id"
               ref="show_booking_management.module_category_show_prebooking"/>
    </record>

    <!-- User Group -->
    <record id="show_booking_management_group_user"
            model="res.groups">

        <field name="name">User</field>

        <field name="privilege_id"
               ref="show_booking_management.show_booking_management_privilege"/>

        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Prebooking Group -->
    <record id="show_booking_management_group_prebooking"
            model="res.groups">

        <field name="name">Prebooking</field>

        <field name="privilege_id"
               ref="show_booking_management.show_prebooking_privilege"/>
    </record>

    <!-- Admin Group -->
    <record id="show_booking_management_group_admin"
            model="res.groups">

        <field name="name">Administrator</field>

        <field name="privilege_id"
               ref="show_booking_management.show_booking_management_privilege"/>

        <field name="implied_ids"
               eval="[
                   (4, ref('show_booking_management.show_booking_management_group_user')),
               ]"/>
    </record>

</odoo>