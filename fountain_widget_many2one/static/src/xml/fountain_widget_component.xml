<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <!-- Changing the button into an input -->
    <t t-name="fountain.Dropdown" owl="1">
        <div class="o-dropdown dropdown fountain_dropdown_wrapper"
             t-att-class="this.props.class"
             t-attf-class="
             {{ this.directionCaretClass || ''}}
             {{ this.state.isOpen ? 'show' : ''}}
             {{ !this.showCaret ? 'o-dropdown--no-caret' : '' }}"
             t-ref="this.rootRef">
            <input class="o_input dropdown-toggle fountain_input"
                   t-att-class="{
                   [this.props.togglerClass]: this.props.togglerClass,
                   'dropdown-item': this.parentDropdown }"
                   t-on-click.stop="this.onClick"
                   t-att-title="this.props.title"
                   t-att-value="this.props.inputData?.input || ''"
                   t-att-data-tooltip="this.props.tooltip"
                   t-att-data-hotkey="this.props.hotkey"
                   t-att-aria-expanded="this.state.isOpen ? 'true' : 'false'"
                   t-att-tabindex="this.props.skipTogglerTabbing ? -1 : 0"
                   readonly="readonly"/>
            <div t-if="this.state.isOpen"
                 class="o-dropdown--menu dropdown-menu show fountain_dropdown_menu"
                 t-att-class="this.props.menuClass"
                 role="menu">
                <t t-call-slot="default" close="() => this.close()"/>
            </div>
        </div>
    </t>
</templates>
