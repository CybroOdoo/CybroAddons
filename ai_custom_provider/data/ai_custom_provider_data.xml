<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define default AI providers and their supported models. -->
    <data noupdate="1">
        <record id="provider_openai" model="ai.custom.provider">
            <field name="name">OpenAI</field>
            <field name="sequence">10</field>
            <field name="base_url">https://api.openai.com/v1</field>
            <field name="send_embedding_dimensions" eval="True"/>
        </record>
        <record id="model_openai_gpt_4_1_mini" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openai"/>
            <field name="name">gpt-4.1-mini</field>
            <field name="label">GPT-4.1 mini</field>
            <field name="model_type">chat</field>
            <field name="sequence">10</field>
        </record>
        <record id="model_openai_gpt_4_1" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openai"/>
            <field name="name">gpt-4.1</field>
            <field name="label">GPT-4.1</field>
            <field name="model_type">chat</field>
            <field name="sequence">20</field>
        </record>
        <record id="model_openai_gpt_4o_mini" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openai"/>
            <field name="name">gpt-4o-mini</field>
            <field name="label">GPT-4o mini</field>
            <field name="model_type">chat</field>
            <field name="sequence">30</field>
        </record>
        <record id="model_openai_gpt_4o" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openai"/>
            <field name="name">gpt-4o</field>
            <field name="label">GPT-4o</field>
            <field name="model_type">chat</field>
            <field name="sequence">40</field>
        </record>
        <record id="model_openai_o4_mini" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openai"/>
            <field name="name">o4-mini</field>
            <field name="label">o4-mini (reasoning)</field>
            <field name="model_type">chat</field>
            <field name="sequence">50</field>
        </record>
        <record id="model_openai_text_embedding_3_small" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openai"/>
            <field name="name">text-embedding-3-small</field>
            <field name="label">Embedding 3 small</field>
            <field name="model_type">embedding</field>
            <field name="sequence">10</field>
        </record>
        <record id="model_openai_text_embedding_3_large" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openai"/>
            <field name="name">text-embedding-3-large</field>
            <field name="label">Embedding 3 large</field>
            <field name="model_type">embedding</field>
            <field name="sequence">20</field>
        </record>
        <record id="provider_anthropic" model="ai.custom.provider">
            <field name="name">Anthropic (Claude)</field>
            <field name="sequence">20</field>
            <field name="base_url">https://api.anthropic.com/v1</field>
            <field name="send_embedding_dimensions" eval="True"/>
            <field name="note">Uses Anthropic's OpenAI SDK compatibility endpoint. No embedding models.</field>
        </record>
        <record id="model_anthropic_claude_sonnet_5_5" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_anthropic"/>
            <field name="name">claude-sonnet-5-5</field>
            <field name="label">Claude Sonnet 5.5</field>
            <field name="model_type">chat</field>
            <field name="sequence">10</field>
        </record>
        <record id="model_anthropic_claude_opus_5_5" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_anthropic"/>
            <field name="name">claude-opus-5-5</field>
            <field name="label">Claude Opus 5.5</field>
            <field name="model_type">chat</field>
            <field name="sequence">20</field>
        </record>
        <record id="model_anthropic_claude_haiku_5_5" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_anthropic"/>
            <field name="name">claude-haiku-5-5</field>
            <field name="label">Claude Haiku 5.5</field>
            <field name="model_type">chat</field>
            <field name="sequence">30</field>
        </record>
        <record id="provider_google" model="ai.custom.provider">
            <field name="name">Google Gemini</field>
            <field name="sequence">30</field>
            <field name="base_url">https://generativelanguage.googleapis.com/v1beta/openai</field>
            <field name="send_embedding_dimensions" eval="True"/>
            <field name="note">Uses Gemini's OpenAI compatibility endpoint.</field>
        </record>
        <record id="model_google_gemini_2_5_flash" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_google"/>
            <field name="name">gemini-2.5-flash</field>
            <field name="label">Gemini 2.5 Flash</field>
            <field name="model_type">chat</field>
            <field name="sequence">10</field>
        </record>
        <record id="model_google_gemini_2_5_pro" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_google"/>
            <field name="name">gemini-2.5-pro</field>
            <field name="label">Gemini 2.5 Pro</field>
            <field name="model_type">chat</field>
            <field name="sequence">20</field>
        </record>
        <record id="model_google_gemini_embedding_001" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_google"/>
            <field name="name">gemini-embedding-001</field>
            <field name="label">Gemini Embedding</field>
            <field name="model_type">embedding</field>
            <field name="sequence">10</field>
        </record>
        <record id="provider_openrouter" model="ai.custom.provider">
            <field name="name">OpenRouter</field>
            <field name="sequence">40</field>
            <field name="base_url">https://openrouter.ai/api/v1</field>
            <field name="send_embedding_dimensions" eval="True"/>
            <field name="note">Model IDs use the 'vendor/model' form.</field>
        </record>
        <record id="model_openrouter_openai_gpt_4_1_mini" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openrouter"/>
            <field name="name">openai/gpt-4.1-mini</field>
            <field name="label">GPT-4.1 mini</field>
            <field name="model_type">chat</field>
            <field name="sequence">10</field>
        </record>
        <record id="model_openrouter_anthropic_claude_sonnet_5_5" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openrouter"/>
            <field name="name">anthropic/claude-sonnet-5-5</field>
            <field name="label">Claude Sonnet 5.5</field>
            <field name="model_type">chat</field>
            <field name="sequence">20</field>
        </record>
        <record id="model_openrouter_google_gemini_2_5_flash" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_openrouter"/>
            <field name="name">google/gemini-2.5-flash</field>
            <field name="label">Gemini 2.5 Flash</field>
            <field name="model_type">chat</field>
            <field name="sequence">30</field>
        </record>
        <record id="provider_mistral" model="ai.custom.provider">
            <field name="name">Mistral AI</field>
            <field name="sequence">50</field>
            <field name="base_url">https://api.mistral.ai/v1</field>
            <field name="send_embedding_dimensions" eval="True"/>
            <field name="note">mistral-embed returns 1024 dimensions, which Odoo cannot store.</field>
        </record>
        <record id="model_mistral_mistral_large_latest" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_mistral"/>
            <field name="name">mistral-large-latest</field>
            <field name="label">Mistral Large</field>
            <field name="model_type">chat</field>
            <field name="sequence">10</field>
        </record>
        <record id="model_mistral_mistral_small_latest" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_mistral"/>
            <field name="name">mistral-small-latest</field>
            <field name="label">Mistral Small</field>
            <field name="model_type">chat</field>
            <field name="sequence">20</field>
        </record>
        <record id="provider_groq" model="ai.custom.provider">
            <field name="name">Groq</field>
            <field name="sequence">60</field>
            <field name="base_url">https://api.groq.com/openai/v1</field>
            <field name="send_embedding_dimensions" eval="True"/>
        </record>
        <record id="model_groq_llama_3_3_70b_versatile" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_groq"/>
            <field name="name">llama-3.3-70b-versatile</field>
            <field name="label">Llama 3.3 70B</field>
            <field name="model_type">chat</field>
            <field name="sequence">10</field>
        </record>
        <record id="model_groq_openai_gpt_oss_120b" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_groq"/>
            <field name="name">openai/gpt-oss-120b</field>
            <field name="label">GPT-OSS 120B</field>
            <field name="model_type">chat</field>
            <field name="sequence">20</field>
        </record>
        <record id="provider_deepseek" model="ai.custom.provider">
            <field name="name">DeepSeek</field>
            <field name="sequence">70</field>
            <field name="base_url">https://api.deepseek.com/v1</field>
            <field name="send_embedding_dimensions" eval="True"/>
        </record>
        <record id="model_deepseek_deepseek_chat" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_deepseek"/>
            <field name="name">deepseek-chat</field>
            <field name="label">DeepSeek Chat</field>
            <field name="model_type">chat</field>
            <field name="sequence">10</field>
        </record>
        <record id="model_deepseek_deepseek_reasoner" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_deepseek"/>
            <field name="name">deepseek-reasoner</field>
            <field name="label">DeepSeek Reasoner</field>
            <field name="model_type">chat</field>
            <field name="sequence">20</field>
        </record>
        <record id="provider_ollama" model="ai.custom.provider">
            <field name="name">Ollama (local)</field>
            <field name="sequence">80</field>
            <field name="base_url">http://localhost:11434/v1</field>
            <field name="send_embedding_dimensions" eval="False"/>
            <field name="note">Local models, no API key needed. Ollama embedding models are not 1536-dimensional.</field>
        </record>
        <record id="model_ollama_llama3_1" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_ollama"/>
            <field name="name">llama3.1</field>
            <field name="label">Llama 3.1</field>
            <field name="model_type">chat</field>
            <field name="sequence">10</field>
        </record>
        <record id="model_ollama_qwen2_5" model="ai.custom.provider.model">
            <field name="provider_id" ref="provider_ollama"/>
            <field name="name">qwen2.5</field>
            <field name="label">Qwen 2.5</field>
            <field name="model_type">chat</field>
            <field name="sequence">20</field>
        </record>
    </data>
</odoo>
