<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define views and menu for AI Custom Providers. -->
    <record id="ai_custom_provider_view_list" model="ir.ui.view">
        <field name="name">ai.custom.provider.list</field>
        <field name="model">ai.custom.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="base_url"/>
                <field name="chat_model_count" string="Chat Models"/>
                <field name="embedding_model_count" string="Embedding Models"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="ai_custom_provider_view_form" model="ir.ui.view">
        <field name="name">ai.custom.provider.form</field>
        <field name="model">ai.custom.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. OpenAI"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="base_url" placeholder="https://api.openai.com/v1"/>
                            <field name="api_key" password="True"/>
                        </group>
                        <group>
                            <field name="send_embedding_dimensions"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models" name="models">
                            <field name="model_ids" context="{'default_provider_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="model_type"/>
                                    <field name="name"/>
                                    <field name="label"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes about this provider..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_custom_provider_view_search" model="ir.ui.view">
        <field name="name">ai.custom.provider.search</field>
        <field name="model">ai.custom.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="base_url"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="ai_custom_provider_action" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">ai.custom.provider</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an OpenAI-compatible AI provider</p>
            <p>Each provider has its own API base URL, API key and list of models.</p>
        </field>
    </record>

    <menuitem id="ai_custom_provider_menu"
              name="AI Providers"
              parent="base.menu_custom"
              action="ai_custom_provider_action"
              sequence="90"/>
</odoo>
