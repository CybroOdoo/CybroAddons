<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Custom AI Provider settings to General Settings. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.custom.provider</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="after">
                <block title="AI Provider" name="ai_custom_provider_setting_container">
                    <setting id="ai_custom_provider_setting" string="Custom AI Provider"
                             help="Use your own OpenAI-compatible API (OpenAI, Anthropic, Gemini, OpenRouter, Ollama, ...) instead of Odoo IAP credits">
                        <field name="ai_custom_provider_enabled"/>
                        <div class="content-group mt-2" invisible="not ai_custom_provider_enabled">
                            <div class="row">
                                <label for="ai_custom_provider_id" class="col-lg-4 o_light_label"/>
                                <field name="ai_custom_provider_id" required="ai_custom_provider_enabled"
                                       options="{'no_quick_create': True}"/>
                            </div>
                            <div class="row" invisible="not ai_custom_provider_id">
                                <label for="ai_custom_provider_base_url" string="API Base URL" class="col-lg-4 o_light_label"/>
                                <field name="ai_custom_provider_base_url" required="ai_custom_provider_id"/>
                            </div>
                            <div class="row" invisible="not ai_custom_provider_id">
                                <label for="ai_custom_provider_api_key" string="API Key" class="col-lg-4 o_light_label"/>
                                <field name="ai_custom_provider_api_key" password="True"/>
                            </div>
                            <div class="row" invisible="not ai_custom_provider_id">
                                <label for="ai_custom_provider_model_id" class="col-lg-4 o_light_label"/>
                                <field name="ai_custom_provider_model_id" required="ai_custom_provider_enabled"
                                       context="{'default_provider_id': ai_custom_provider_id, 'default_model_type': 'chat'}"/>
                            </div>
                            <div class="row" invisible="not ai_custom_provider_id">
                                <label for="ai_custom_provider_reasoning_model_id" class="col-lg-4 o_light_label"/>
                                <field name="ai_custom_provider_reasoning_model_id"
                                       context="{'default_provider_id': ai_custom_provider_id, 'default_model_type': 'chat'}"/>
                            </div>
                            <div class="row" invisible="not ai_custom_provider_id">
                                <label for="ai_custom_provider_embedding_model_id" class="col-lg-4 o_light_label"/>
                                <field name="ai_custom_provider_embedding_model_id"
                                       context="{'default_provider_id': ai_custom_provider_id, 'default_model_type': 'embedding'}"/>
                            </div>
                            <div class="row" invisible="not ai_custom_provider_id">
                                <label for="ai_custom_provider_send_embedding_dimensions" string="Send 'dimensions=1536'" class="col-lg-4 o_light_label"/>
                                <field name="ai_custom_provider_send_embedding_dimensions"/>
                            </div>
                            <div class="row">
                                <label for="ai_custom_provider_timeout" class="col-lg-4 o_light_label"/>
                                <field name="ai_custom_provider_timeout"/>
                            </div>
                            <div class="mt-2">
                                <button name="%(ai_custom_provider.ai_custom_provider_action)d" type="action"
                                        string="Manage Providers &amp; Models" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
