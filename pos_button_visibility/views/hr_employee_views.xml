<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Extend employee form to configure POS button visibility and POS config restrictions for pos_hr. -->
    <record id="view_employee_form_inherit_pos_button" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.pos.button.visibility</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Point of Sale" name="point_of_sale_restrictions">
                    <group>
                        <field name="pos_config_ids" widget="many2many_tags"/>
                        <field name="pos_button_ids" widget="many2many_checkboxes"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
