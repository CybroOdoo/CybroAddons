<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Adding POS button restrictions to the user form -->
    <record id="view_users_form_inherit_pos_button_visibility" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.pos.button.visibility</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='account_security']" position="after">
                <page string="Point of Sale" name="point_of_sales"
                      groups="point_of_sale.group_pos_user,point_of_sale.group_pos_manager">
                    <group>
                        <field name="buttons_pos_ids"
                               widget="many2many_checkboxes"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
