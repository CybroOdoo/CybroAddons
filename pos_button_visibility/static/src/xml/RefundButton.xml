<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_button_visibility.RefundButton"
       t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='() =&gt; this.clickRefund()']"
               position="attributes">
            <attribute name="t-att-disabled">
                this.isPosButtonRestricted('Refund')
            </attribute>
        </xpath>
    </t>
</templates>
