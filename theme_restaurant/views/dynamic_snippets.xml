<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ─── Dynamic Best Sellers Snippet ─── -->
  <template id="s_savora_best_sellers_dynamic" name="Savora Best Sellers Dynamic">
    <section class="s_savora_products o_cc o_cc1" data-snippet="s_savora_products"
             data-name="Savora Best Sellers" style="background:var(--sv-dark,#0f0b09); padding:80px 0;">
      <div class="container">
        <t t-set="current_website" t-value="request.env['website'].get_current_website()"/>
        <t t-set="candidates"
           t-value="request.env['product.template'].with_context(website_id=current_website.id).search(
               [('website_published','=',True),('sale_ok','=',True)], limit=12,
               order='website_sequence asc, id desc')"/>
        <t t-set="bestsellers" t-value="candidates.sorted(key=lambda p: p.sales_count, reverse=True)[:4]"/>
        <p class="sv-eyebrow mb-2">Featured Edit</p>
        <h2 class="sv-section-title mb-5">Best Sellers</h2>
        <div class="row row-cols-2 row-cols-md-4 g-4">
          <t t-foreach="bestsellers" t-as="product">
            <t t-set="display_price" t-value="product.product_variant_id.lst_price or product.list_price"/>
            <div class="col">
              <a t-att-href="product.website_url" class="sv-mcard text-decoration-none d-block h-100">
                <div class="sv-mcard-img">
                  <img t-if="product.image_512" t-att-src="image_data_uri(product.image_512)" t-att-alt="product.name" class="w-100 h-100" style="object-fit:cover;"/>
                  <img t-else="" src="/theme_restaurant/static/img/food_placeholder.jpg" t-att-alt="product.name" class="w-100 h-100" style="object-fit:cover;"/>
                </div>
                <div class="sv-mcard-body">
                  <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <span class="sv-mcard-name" t-field="product.name"/>
                    <span class="sv-mcard-price" t-esc="display_price"
                          t-options="{'widget':'monetary','display_currency':product.currency_id}"/>
                  </div>
                  <p class="sv-mcard-desc text-truncate" t-field="product.description_sale"/>
                </div>
              </a>
            </div>
          </t>
          <t t-if="not bestsellers">
            <div class="col-12 text-center py-5" style="color:var(--sv-muted);">
              <p>No featured products yet. <a href="/shop" style="color:var(--sv-gold);">Browse the menu →</a></p>
            </div>
          </t>
        </div>
      </div>
    </section>
  </template>
  <!-- ─── Dynamic New Arrivals Snippet ─── -->
  <template id="s_savora_new_arrivals_dynamic" name="Savora New Arrivals Dynamic">
    <section class="s_savora_new_arrivals o_cc o_cc1" data-snippet="s_savora_new_arrivals"
             data-name="Savora New Arrivals" style="background:var(--sv-surface-1,#1a1411); padding:80px 0;">
      <div class="container">
        <t t-set="current_website" t-value="request.env['website'].get_current_website()"/>
        <t t-set="new_products"
           t-value="request.env['product.template'].with_context(website_id=current_website.id).search(
               [('website_published','=',True),('sale_ok','=',True)], limit=4,
               order='create_date desc, id desc')"/>
        <p class="sv-eyebrow mb-2">Fresh From the Kitchen</p>
        <h2 class="sv-section-title mb-5">New on the Menu</h2>
        <div class="row row-cols-2 row-cols-md-4 g-4">
          <t t-foreach="new_products" t-as="product">
            <t t-set="display_price" t-value="product.product_variant_id.lst_price or product.list_price"/>
            <div class="col">
              <a t-att-href="product.website_url" class="sv-mcard text-decoration-none d-block h-100">
                <div class="sv-mcard-img position-relative">
                  <span class="sv-ribbon">New</span>
                  <img t-if="product.image_512" t-att-src="image_data_uri(product.image_512)" t-att-alt="product.name" class="w-100 h-100" style="object-fit:cover;"/>
                  <img t-else="" src="/theme_restaurant/static/img/food_placeholder.jpg" t-att-alt="product.name" class="w-100 h-100" style="object-fit:cover;"/>
                </div>
                <div class="sv-mcard-body">
                  <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <span class="sv-mcard-name" t-field="product.name"/>
                    <span class="sv-mcard-price" t-esc="display_price"
                          t-options="{'widget':'monetary','display_currency':product.currency_id}"/>
                  </div>
                  <p class="sv-mcard-desc text-truncate" t-field="product.description_sale"/>
                </div>
              </a>
            </div>
          </t>
          <t t-if="not new_products">
            <div class="col-12 text-center py-5" style="color:var(--sv-muted);">
              <p>No new items yet. <a href="/shop" style="color:var(--sv-gold);">Browse the menu →</a></p>
            </div>
          </t>
        </div>
      </div>
    </section>
  </template>
</odoo>
