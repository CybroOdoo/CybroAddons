<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Menu-->
    <template id="savora_menu_page" name="Dinner Menu">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- MENU HERO -->
                <section class="menu-hero">
                    <div class="menu-hero-bg">
                        <img src="/theme_restaurant/static/img/menu_hero_alt.jpg" alt="Atmospheric Dining Room" />
                    </div>
                    <div class="container" style="z-index: 2; position: relative;">
                        <p class="sv-eyebrow reveal active" style="color: var(--sv-gold); letter-spacing: 0.3em;">Est. 2024</p>
                        <h1 class="reveal active">Dinner Menu</h1>
                    </div>
                </section>
                <!-- CATEGORY NAV -->
                <div class="menu-nav">
                    <div class="menu-tabs">
                        <t t-foreach="menu_data" t-as="item">
                            <button type="button" t-attf-class="menu-tab #{'active' if item_index == 0 else ''}" 
                                    t-att-data-f="item['category'].id">
                                <t t-esc="item['category'].name"/>
                            </button>
                        </t>
                    </div>
                </div>
                <!-- MENU CONTENT -->
                <main class="menu-listing">
                    <div class="container">
                        <t t-foreach="menu_data" t-as="item">
                            <div class="menu-category" t-att-data-c="item['category'].id" 
                                 t-att-style="'display: block;' if item_index == 0 else 'display: none;'">
                                <section class="menu-cat-sec">
                                    <div class="menu-cat-head">
                                        <h2 t-esc="item['category'].name"/>
                                        <div class="line"/>
                                    </div>
                                    <div class="menu-list-grid">
                                        <t t-foreach="item['products']" t-as="product">
                                            <a t-att-href="product.website_url" class="menu-item text-decoration-none d-flex align-items-start gap-3">
                                                <div class="menu-item-img" style="width: 70px; height: 70px; flex-shrink: 0; overflow: hidden; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1);">
                                                    <img t-if="product.image_128" t-att-src="image_data_uri(product.image_128)" t-att-alt="product.name" class="w-100 h-100" style="object-fit: cover;"/>
                                                    <img t-else="" src="/theme_restaurant/static/img/food_placeholder.jpg" t-att-alt="product.name" class="w-100 h-100" style="object-fit: cover;"/>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="menu-item-hd">
                                                        <span class="menu-item-name" t-field="product.name"/>
                                                        <span class="menu-item-price" t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                                    </div>
                                                    <p class="menu-item-desc mb-0" t-field="product.description_sale"/>
                                                </div>
                                            </a>
                                        </t>
                                    </div>
                                </section>
                            </div>
                        </t>
                    </div>
                </main>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    <!-- ─── Menu Page ─── -->
    <record id="savora_menu_website_page" model="website.page">
        <field name="name">Dinner Menu</field>
        <field name="url">/menu</field>
        <field name="view_id" ref="theme_restaurant.savora_menu_page"/>
        <field name="website_published">True</field>
        <field name="is_published">True</field>
    </record>
</odoo>
