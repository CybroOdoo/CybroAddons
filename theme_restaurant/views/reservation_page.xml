<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Reservation -->
  <template id="savora_reservation_page" name="Reservation Experience">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <!-- Header Section -->
        <section class="sv-res-header">
          <div class="container">
            <h1 class="sv-res-title">Reservation Experience System</h1>
            <p class="sv-res-subtitle">Easily reserve your table in just a few clicks with our seamless online booking system. Choose your preferred date, time, and seating</p>
          </div>
        </section>
        <!-- Reservation Container -->
        <section class="sv-reservation-wrapper">
          <div class="sv-res-container">
            <!-- Progress Bar -->
            <div class="sv-res-progress">
              <div class="sv-res-line" id="resLine1"/>
              <div class="sv-res-line" id="resLine2"/>
              <div class="sv-res-line" id="resLine3"/>
            </div>
            <div class="row g-0 h-100">
              <!-- Left Side: Visual/Context -->
              <div class="col-lg-5 d-none d-lg-block">
                <div class="sv-res-visual" style="background-image: url('/theme_restaurant/static/img/table_view.png');">
                  <div class="sv-res-visual-overlay">
                    <div class="sv-res-visual-content">
                      <h3>Savora</h3>
                      <p><i class="fa fa-map-marker me-2"/> 123 Gourmet Avenue, New York, NY 10012</p>
                      <p><i class="fa fa-clock-o me-2"/> Dinner Only: 5:00 PM — 11:30 PM</p>
                      <div class="sv-res-visual-footer">
                        <p id="resReviewDate">Thursday, Oct 24, 2024</p>
                        <p id="resReviewTime">7:30 PM</p>
                        <p id="resReviewGuests">2 Guests</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Right Side: Multi-step Form -->
              <div class="col-lg-7">
                <div class="sv-res-form-content">
                  <!-- Step 1: Find a Table -->
                  <div id="reserveStep1" class="sv-res-step-panel">
                    <h2 class="sv-res-step-title">Find a Table</h2>
                    <p class="sv-res-step-desc">Select your party size, date, and time</p>
                    <div class="sv-res-group">
                      <label>GUESTS</label>
                      <div class="sv-res-party-selector">
                        <button type="button" class="sv-res-step" data-guests="1">1</button>
                        <button type="button" class="sv-res-step active" data-guests="2">2</button>
                        <button type="button" class="sv-res-step" data-guests="3">3</button>
                        <button type="button" class="sv-res-step" data-guests="4">4</button>
                        <button type="button" class="sv-res-step" data-guests="5">5</button>
                        <button type="button" class="sv-res-step" data-guests="6">6</button>
                        <button type="button" class="sv-res-step" data-guests="7">7</button>
                        <button type="button" class="sv-res-step" data-guests="8">8</button>
                        <button type="button" class="sv-res-step" data-guests="9">9+</button>
                      </div>
                    </div>
                    <div class="sv-res-group">
                      <label>DATE</label>
                      <div class="sv-res-calendar mt-3">
                        <div class="sv-cal-header">
                          <span class="sv-cal-month" id="calMonthYear">Loading...</span>
                          <div class="sv-cal-nav">
                            <i class="fa fa-chevron-left"/>
                            <i class="fa fa-chevron-right"/>
                          </div>
                        </div>
                        <div class="sv-cal-weekdays">
                          <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
                        </div>
                        <div class="sv-cal-grid">
                          <div class="sv-cal-day muted">20</div>
                          <div class="sv-cal-day muted">21</div>
                          <div class="sv-cal-day muted">22</div>
                          <div class="sv-cal-day muted">23</div>
                          <div class="sv-cal-day active">24</div>
                          <div class="sv-cal-day">25</div>
                          <div class="sv-cal-day">26</div>
                          <div class="sv-cal-day">27</div>
                          <div class="sv-cal-day">28</div>
                          <div class="sv-cal-day">29</div>
                          <div class="sv-cal-day">30</div>
                          <div class="sv-cal-day">31</div>
                        </div>
                      </div>
                    </div>
                    <div class="sv-res-group">
                      <label>TIME</label>
                      <div class="sv-res-times">
                        <div class="sv-res-time"/>
                        <div class="sv-res-time"/>
                        <div class="sv-res-time"/>
                        <div class="sv-res-time"/>
                        <div class="sv-res-time active"/>
                        <div class="sv-res-time"/>
                        <div class="sv-res-time"/>
                        <div class="sv-res-time"/>
                      </div>
                    </div>
                    <div class="sv-res-footer">
                      <button class="sv-res-continue" id="toStep2">Continue to Details</button>
                    </div>
                  </div>
                  <!-- Step 2: Guest Details -->
                  <div id="reserveStep2" class="sv-res-step-panel" style="display: none;">
                    <h2 class="sv-res-step-title">Guest Details</h2>
                    <p class="sv-res-step-desc">Please provide your contact information to finalize the reservation</p>
                    <div class="row g-3">
                      <div class="col-md-6">
                        <div class="sv-res-field">
                          <label>FIRST NAME</label>
                          <input type="text" placeholder="Jane" class="sv-res-input" id="resFirstName"/>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="sv-res-field">
                          <label>LAST NAME</label>
                          <input type="text" placeholder="Doe" class="sv-res-input" id="resLastName"/>
                        </div>
                      </div>
                      <div class="col-12">
                        <div class="sv-res-field">
                          <label>EMAIL ADDRESS</label>
                          <input type="email" placeholder="jane.doe@example.com" class="sv-res-input" id="resEmail"/>
                        </div>
                      </div>
                      <div class="col-12">
                        <div class="sv-res-field">
                          <label>PHONE NUMBER</label>
                          <input type="tel" placeholder="+1 (555) 000-0000" class="sv-res-input" id="resPhone"/>
                        </div>
                      </div>
                      <div class="col-12">
                        <div class="sv-res-field">
                          <label>SPECIAL REQUESTS (OPTIONAL)</label>
                          <textarea placeholder="Allergies, special occasions..." class="sv-res-input" id="resNotes" rows="3"/>
                        </div>
                      </div>
                    </div>
                    <div class="sv-res-footer mt-4">
                      <button class="sv-res-back" id="backToStep1">Back</button>
                      <button class="sv-res-continue" id="toStep3">Review Reservation</button>
                    </div>
                  </div>
                  <!-- Step 3: Review -->
                  <div id="reserveStep3" class="sv-res-step-panel" style="display: none;">
                    <h2 class="sv-res-step-title">Review Reservation</h2>
                    <p class="sv-res-step-desc">Please confirm your reservation details below.</p>
                    <div class="sv-review-list">
                      <div class="sv-review-row">
                        <span class="sv-rev-label">DATE</span>
                        <span class="sv-rev-val" id="reviewDateVal">October 2024 24</span>
                      </div>
                      <div class="sv-review-row">
                        <span class="sv-rev-label">TIME</span>
                        <span class="sv-rev-val" id="reviewTimeVal">7:30 PM</span>
                      </div>
                      <div class="sv-review-row">
                        <span class="sv-rev-label">GUESTS</span>
                        <span class="sv-rev-val" id="reviewGuestsVal">2 Guests</span>
                      </div>
                      <div class="sv-review-row">
                        <span class="sv-rev-label">NAME</span>
                        <span class="sv-rev-val" id="reviewNameVal">Jane Doe</span>
                      </div>
                      <div class="sv-review-row">
                        <span class="sv-rev-label">EMAIL</span>
                        <span class="sv-rev-val" id="reviewEmailVal">jane.doe@example.com</span>
                      </div>
                      <div class="sv-review-row">
                        <span class="sv-rev-label">PHONE</span>
                        <span class="sv-rev-val" id="reviewPhoneVal">+1 (555) 019-9238</span>
                      </div>
                      <div class="sv-review-row">
                        <span class="sv-rev-label">REQUESTS</span>
                        <span class="sv-rev-val" id="reviewNotesVal">None</span>
                      </div>
                    </div>
                    <div class="sv-res-footer mt-4 align-items-center">
                      <button class="sv-res-continue" id="toStep4">Confirm Reservation</button>
                      <button class="sv-res-edit-link" id="backToStep2">Edit Info</button>
                    </div>
                  </div>
                  <!-- Step 4: Confirmation -->
                  <div id="reserveStep4" class="sv-res-step-panel" style="display: none;">
                    <div class="sv-confirm-status">
                      <div class="sv-confirm-icon">
                        <i class="fa fa-check"/>
                      </div>
                      <h2 class="sv-res-step-title">Reservation Confirmed</h2>
                      <p class="sv-res-step-desc">Thank you. A confirmation email has been sent.</p>
                      <div class="sv-confirm-card">
                        <p><strong>Reservation confirmed for the Savora</strong></p>
                        <p>Monday, Oct 24, 2024 at <span id="confirmTimeVal">7:30 PM</span></p>
                        <p>Booking Reference: #SAV-74291-C</p>
                      </div>
                      <a href="/" class="sv-res-continue w-auto px-5 mt-4 d-inline-block text-decoration-none">Go Back Home</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <div class="oe_structure"/>
      </div>
    </t>
  </template>
<!--  Reservation page link-->
  <record id="savora_reservation_website_page" model="website.page">
    <field name="name">Reservation Experience</field>
    <field name="url">/reservations</field>
    <field name="view_id" ref="theme_restaurant.savora_reservation_page"/>
    <field name="website_published">True</field>
    <field name="is_published">True</field>
  </record>
</odoo>
