<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ═══════════════════════════════════════════════
       SAVORA HOMEPAGE
  ═══════════════════════════════════════════════ -->
  <template id="savora_homepage" inherit_id="website.homepage" name="Savora Home" priority="100">
    <xpath expr="//div[@id='wrap']" position="attributes">
      <attribute name="class" add="oe_structure" separator=" "/>
    </xpath>
    <xpath expr="//div[@id='wrap']" position="inside">
      <!-- HERO -->
      <section class="s_savora_hero o_cc o_cc1" data-snippet="s_savora_hero" data-name="Savora Hero"
               style="background:var(--sv-dark,#0f0b09); padding-top:80px; min-height:100vh; display:flex; align-items:center;">
        <div class="container py-5">
          <div class="row g-0 align-items-center">
            <div class="col-lg-6 pe-lg-5 py-5">
              <p class="sv-eyebrow mb-3">Modern Steakhouse / Fire-Led Dining</p>
              <h1 class="sv-hero-title mb-4">Fire-led dining with a polished, late-night mood.</h1>
              <p class="sv-hero-desc mb-5">Savora brings dry-aged steaks, glowing interiors, and sharp service together in a restaurant designed for memorable dinners, cocktails, and long conversations.</p>
              <div class="d-flex gap-3 flex-wrap mb-5">
                <a href="/reservations" class="sv-btn-gold">Book Your Table</a>
                <a href="/menu" class="sv-btn-outline">Explore Menu</a>
              </div>
              <div class="sv-hero-stats">
                <div><div class="sv-stat-lbl">Location</div><div class="sv-stat-val">10 Mercer Ave, New York</div></div>
                <div><div class="sv-stat-lbl">Hours</div><div class="sv-stat-val">Daily 5 PM – 11:30 PM</div></div>
                <div><div class="sv-stat-lbl">Signature</div><div class="sv-stat-val">Ribeye &amp; amber cocktails</div></div>
              </div>
            </div>
            <div class="col-lg-6 position-relative" style="min-height:580px;">
              <div class="sv-hero-img-wrap position-absolute top-0 start-0 w-100 h-100">
                <img src="/theme_restaurant/static/img/hero_food.jpg" alt="Signature dish" class="w-100 h-100" style="object-fit:cover;"/>
                <div class="sv-hero-overlay">
                  <p class="sv-eyebrow">Tonight's Highlight</p>
                  <p>Dry-aged wagyu burger, smoked cheddar, caramelized onion, herb brioche and house pepper glaze.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- OUR STORY -->
      <section class="s_savora_story o_cc o_cc1" data-snippet="s_savora_story" data-name="Savora Story"
               style="background: linear-gradient(rgba(26,20,17,0.92), rgba(26,20,17,0.92)), url('/theme_restaurant/static/img/story_bg.jpg') center/cover; padding:100px 0;">
        <div class="container">
          <div class="row align-items-center g-5">
            <div class="col-lg-5">
              <div style="aspect-ratio:4/5; overflow:hidden;">
                <img src="/theme_restaurant/static/img/story_chef.jpg" alt="Chef at the grill" class="w-100 h-100" style="object-fit:cover;"/>
              </div>
            </div>
            <div class="col-lg-7">
              <p class="sv-eyebrow mb-3">Our Story</p>
              <h2 class="sv-section-title mb-4">A premium steakhouse built around fire, craft, and atmosphere.</h2>
              <div class="row g-4 mb-4">
                <div class="col-md-6">
                  <p style="color:var(--sv-muted,#9b8f85); line-height:1.7;">We created Savora for guests who love deep flavors, warm lighting, and refined service without excess. Every cut is selected carefully, grilled over open flame, and finished with modern restraint.</p>
                </div>
                <div class="col-md-6">
                  <p style="color:var(--sv-muted,#9b8f85); line-height:1.7;">From the first cocktail to the final dessert, the room is designed to feel intimate and polished — rich materials, soft shadows, and high-quality plating at every table.</p>
                </div>
              </div>
              <div class="d-flex gap-5 mb-5">
                <div><div class="sv-num">28</div><div class="sv-num-lbl">Day dry-aged program</div></div>
                <div><div class="sv-num">14</div><div class="sv-num-lbl">Curated wine labels</div></div>
              </div>
              <a href="/story" class="sv-story-link">Read Our Full Story →</a>
            </div>
          </div>
        </div>
      </section>
      <!-- MENU -->
      <section class="s_savora_menu o_cc o_cc1" data-snippet="s_savora_menu" data-name="Savora Menu"
               style="background: linear-gradient(rgba(15,11,9,0.9), rgba(15,11,9,0.9)), url('/theme_restaurant/static/img/menu_bg.jpg') center/cover; padding:100px 0;">
        <div class="container">
          <t t-set="menu_categories"
             t-value="request.env['product.public.category'].browse([
               request.env.ref('theme_restaurant.category_starters').id,
               request.env.ref('theme_restaurant.category_main_course').id,
               request.env.ref('theme_restaurant.category_desserts').id,
             ])"/>
          <p class="sv-eyebrow mb-2">Selected Menu</p>
          <h2 class="sv-section-title mb-5">Steakhouse favorites with modern presentation.</h2>
          <div class="sv-tabs mb-5">
            <t t-foreach="menu_categories" t-as="category">
              <button type="button"
                      t-attf-class="sv-tab #{'active' if category_index == 0 else ''}"
                      t-att-data-filter="category.id">
                <t t-esc="category.name"/>
              </button>
            </t>
          </div>
          <div class="row g-4" id="sv_mgrid">
            <t t-set="has_menu_products" t-value="False"/>
            <t t-foreach="menu_categories" t-as="category">
              <t t-set="category_products"
                 t-value="request.env['product.template'].sudo().with_context(website_id=request.website.id).search([('public_categ_ids','child_of',category.id),('website_published','=',True),('sale_ok','=',True)], limit=8, order='website_sequence asc, id desc')"/>
              <t t-if="category_products" t-set="has_menu_products" t-value="True"/>
              <t t-foreach="category_products" t-as="product">
                <t t-set="display_price" t-value="product.product_variant_id.lst_price or product.list_price"/>
                <div class="col-sm-6 col-lg-3 sv-mcard-col"
                     t-att-data-filter="category.id"
                     t-att-style="'display:none;' if category_index != 0 else ''">
                  <a t-att-href="product.website_url" class="sv-mcard text-decoration-none d-block h-100">
                    <div class="sv-mcard-img">
                      <img t-if="product.image_512" t-att-src="image_data_uri(product.image_512)" t-att-alt="product.name" class="w-100 h-100" style="object-fit:cover;"/>
                      <img t-else="" src="/theme_restaurant/static/img/food_placeholder.jpg" t-att-alt="product.name" class="w-100 h-100" style="object-fit:cover;"/>
                    </div>
                    <div class="sv-mcard-body">
                      <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span class="sv-mcard-name" t-field="product.name"/>
                        <span class="sv-mcard-price" t-esc="display_price"
                              t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                      </div>
                      <p class="sv-mcard-desc text-truncate" t-field="product.description_sale"/>
                    </div>
                  </a>
                </div>
              </t>
            </t>
            <t t-if="not has_menu_products">
              <div class="col-sm-6 col-lg-3 sv-mcard-col" t-att-data-filter="request.env.ref('theme_restaurant.category_starters').id"><div class="sv-mcard"><div class="sv-mcard-img"><img src="/theme_restaurant/static/img/food_placeholder.jpg" alt="Beef Tartare" class="w-100 h-100" style="object-fit:cover;"/></div><div class="sv-mcard-body"><div class="d-flex justify-content-between align-items-baseline mb-1"><span class="sv-mcard-name">Beef Tartare</span><span class="sv-mcard-price">$24</span></div><p class="sv-mcard-desc">Habanero tenderloin, cured yolk, shallot ash, mustard seed.</p></div></div></div>
              <div class="col-sm-6 col-lg-3 sv-mcard-col" t-att-data-filter="request.env.ref('theme_restaurant.category_starters').id"><div class="sv-mcard"><div class="sv-mcard-img"><img src="/theme_restaurant/static/img/food_placeholder.jpg" alt="Charred Prawns" class="w-100 h-100" style="object-fit:cover;"/></div><div class="sv-mcard-body"><div class="d-flex justify-content-between align-items-baseline mb-1"><span class="sv-mcard-name">Charred Prawns</span><span class="sv-mcard-price">$28</span></div><p class="sv-mcard-desc">Brown butter chili glaze, grilled lemon, fennel herb salad.</p></div></div></div>
              <div class="col-sm-6 col-lg-3 sv-mcard-col" t-att-data-filter="request.env.ref('theme_restaurant.category_main_course').id" style="display:none;"><div class="sv-mcard"><div class="sv-mcard-img"><img src="/theme_restaurant/static/img/food_placeholder.jpg" alt="Signature Ribeye" class="w-100 h-100" style="object-fit:cover;"/></div><div class="sv-mcard-body"><div class="d-flex justify-content-between align-items-baseline mb-1"><span class="sv-mcard-name">Signature Ribeye</span><span class="sv-mcard-price">$85</span></div><p class="sv-mcard-desc">Dry-aged 45 days, smoked garlic jus, crisp potatoes.</p></div></div></div>
              <div class="col-sm-6 col-lg-3 sv-mcard-col" t-att-data-filter="request.env.ref('theme_restaurant.category_desserts').id" style="display:none;"><div class="sv-mcard"><div class="sv-mcard-img"><img src="/theme_restaurant/static/img/food_placeholder.jpg" alt="Chocolate Fondant" class="w-100 h-100" style="object-fit:cover;"/></div><div class="sv-mcard-body"><div class="d-flex justify-content-between align-items-baseline mb-1"><span class="sv-mcard-name">Chocolate Fondant</span><span class="sv-mcard-price">$16</span></div><p class="sv-mcard-desc">Dark chocolate center, malt crumble, vanilla bean cream.</p></div></div></div>
            </t>
          </div>
        </div>
      </section>
      <!-- GALLERY HERO -->
      <section class="sv-gallery-hero">
        <div class="sv-gallery-hero-bg">
          <img src="/theme_restaurant/static/img/gallery_bg.jpg" alt="Atmospheric Table Setting"/>
        </div>
        <div class="container" style="position:relative; z-index:1; text-align:center;">
          <p class="sv-eyebrow sv-reveal" style="color:var(--sv-gold); letter-spacing:0.3em;">The Experience</p>
          <h2 class="sv-gallery-hero-title sv-reveal" style="transition-delay:0.2s;">Gallery</h2>
        </div>
      </section>
      <!-- GALLERY GRID -->
      <section class="sv-gallery-section s_savora_gallery o_cc o_cc1" data-snippet="s_savora_gallery" data-name="Savora Gallery">
        <div class="container">
          <div class="sv-gallery-grid">
            <!-- 1. Interior — w-8 h-2 -->
            <div class="sv-gallery-item sv-w-8 sv-h-2"
                 data-caption="Restaurant Interior"
                 data-src="/theme_restaurant/static/img/gallery/interior.jpg">
              <img src="/theme_restaurant/static/img/gallery/interior.jpg" alt="Restaurant Interior"/>
            </div>
            <!-- 2. Steak — w-4 h-1 -->
            <div class="sv-gallery-item sv-w-4 sv-h-1"
                 data-caption="Dry-Aged Steak"
                 data-src="/theme_restaurant/static/img/gallery/steak.jpg">
              <img src="/theme_restaurant/static/img/gallery/steak.jpg" alt="Dry-Aged Steak"/>
            </div>
            <!-- 3. Cocktail — w-4 h-1 -->
            <div class="sv-gallery-item sv-w-4 sv-h-1"
                 data-caption="Mixologist at Work"
                 data-src="/theme_restaurant/static/img/gallery/cocktail.jpg">
              <img src="/theme_restaurant/static/img/gallery/cocktail.jpg" alt="Mixologist at Work"/>
            </div>
            <!-- 4. Table — w-8 h-1 -->
            <div class="sv-gallery-item sv-w-8 sv-h-1"
                 data-caption="Candlelit Table"
                 data-src="/theme_restaurant/static/img/gallery/table.jpg">
              <img src="/theme_restaurant/static/img/gallery/table.jpg" alt="Candlelit Table"/>
            </div>
            <!-- 5. Aging Room — w-4 h-2 -->
            <div class="sv-gallery-item sv-w-4 sv-h-2"
                 data-caption="Dry Aging Room"
                 data-src="/theme_restaurant/static/img/gallery/aging.jpg">
              <img src="/theme_restaurant/static/img/gallery/aging.jpg" alt="Dry Aging Room"/>
            </div>
            <!-- 6. Chef — w-4 h-1 -->
            <div class="sv-gallery-item sv-w-4 sv-h-1"
                 data-caption="Executive Chef Plating"
                 data-src="/theme_restaurant/static/img/gallery/chef.jpg">
              <img src="/theme_restaurant/static/img/gallery/chef.jpg" alt="Executive Chef Plating"/>
            </div>
            <!-- 7. Wine — w-4 h-1 -->
            <div class="sv-gallery-item sv-w-4 sv-h-1"
                 data-caption="Premium Wine Service"
                 data-src="/theme_restaurant/static/img/gallery/wine.jpg">
              <img src="/theme_restaurant/static/img/gallery/wine.jpg" alt="Premium Wine Service"/>
            </div>
          </div>
        </div>
      </section>
      <!-- GALLERY LIGHTBOX -->
      <div id="sv_gallery_lightbox" class="sv-lightbox" role="dialog" aria-modal="true">
        <button class="sv-lightbox-close" id="sv_lightbox_close" aria-label="Close"><i class="fa fa-times"/></button>
        <button class="sv-lightbox-nav sv-lightbox-prev" id="sv_lightbox_prev" aria-label="Previous"><i class="fa fa-chevron-left"/></button>
        <button class="sv-lightbox-nav sv-lightbox-next" id="sv_lightbox_next" aria-label="Next"><i class="fa fa-chevron-right"/></button>
        <div class="sv-lightbox-inner">
          <div class="sv-lightbox-img-wrap">
            <img id="sv_lightbox_img" src="" alt=""/>
          </div>
          <div class="sv-lightbox-caption-bar">
            <span class="sv-eyebrow" style="letter-spacing:0.2em; font-size:10px;">The Experience</span>
            <p id="sv_lightbox_caption" class="sv-lightbox-caption"/>
            <div class="sv-lightbox-dots" id="sv_lightbox_dots"/>
          </div>
        </div>
      </div>
      <!-- REVIEWS -->
      <section class="s_savora_reviews o_cc o_cc1" data-snippet="s_savora_reviews" data-name="Savora Reviews"
               style="background: linear-gradient(rgba(15,11,9,0.9), rgba(15,11,9,0.9)), url('/theme_restaurant/static/img/reservation_bg.jpg') center/cover; padding:100px 0;">
        <div class="container">
          <div class="row g-5 align-items-start">
            <div class="col-lg-7">
              <p class="sv-eyebrow mb-3">Guest Reviews</p>
              <h2 class="sv-section-title mb-4">Loved for atmosphere, service, and fire-cooked flavor.</h2>
              <p style="color:var(--sv-muted,#9b8f85); margin-bottom:3rem;">Our guests come for premium cuts and return for the room, the pacing, and the warm modern mood.</p>
              <div class="sv-review-block mb-4">
                <div class="sv-stars mb-3">★★★★★</div>
                <p class="sv-review-q">"Exactly the kind of modern steakhouse New York needed — rich lighting, polished service, and one of the best ribeyes I've had this year."</p>
                <p class="sv-review-auth">Jordan Miles — Food Editor</p>
              </div>
              <div class="sv-review-block">
                <div class="sv-stars mb-3">★★★★★</div>
                <p class="sv-review-q">"The burger, the cocktails, the room — everything feels perfectly executed."</p>
                <p class="sv-review-auth">Alex Chen — Local Guide</p>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="sv-res-card">
                <p class="sv-eyebrow mb-2">Reservation</p>
                <h3 style="color:var(--sv-cream,#efe6db); font-size:1.4rem; margin-bottom:1rem;">Reserve for dinner, cocktails, or a private celebration.</h3>
                <p style="color:var(--sv-muted,#9b8f85); margin-bottom:1.5rem;">Secure your experience at Savora.</p>
                <a href="/reservations" class="sv-btn-gold d-block text-center">Book a Table</a>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- FEATURES -->
      <section class="s_savora_features o_cc o_cc1" data-snippet="s_savora_features" data-name="Savora Features"
               style="background:var(--sv-surface-1,#1a1411); padding:80px 0; border-top:1px solid rgba(255,255,255,0.06);">
        <div class="container">
          <div class="row g-4 text-center">
            <div class="col-md-4">
              <div class="sv-feature-icon mb-3">🍷</div>
              <h5 class="sv-feature-title">Curated Wine List</h5>
              <p class="sv-feature-desc">Over 40 labels spanning old-world classics to new-world discoveries.</p>
            </div>
            <div class="col-md-4">
              <div class="sv-feature-icon mb-3">🔥</div>
              <h5 class="sv-feature-title">Fire-Led Cooking</h5>
              <p class="sv-feature-desc">Every cut grilled over open flame — technique-first, always.</p>
            </div>
            <div class="col-md-4">
              <div class="sv-feature-icon mb-3">🌙</div>
              <h5 class="sv-feature-title">Late-Night Atmosphere</h5>
              <p class="sv-feature-desc">Low lighting, warm booths, and a mood that makes every evening special.</p>
            </div>
          </div>
        </div>
      </section>
      <div class="oe_structure"/>
    </xpath>
  </template>
  <!-- ═══════════════════════════════════════════════
       SAVORA GALLERY PAGE — standalone /gallery route
  ═══════════════════════════════════════════════ -->
  <!-- 1. The page view template -->
  <template id="savora_gallery_page" name="Savora Gallery Page">
    <t t-call="website.layout">
      <t t-set="pageName" t-value="'gallery'"/>
      <div id="wrap" class="oe_structure">
        <!-- ── Gallery Hero ── -->
        <section class="sv-gallery-hero">
          <div class="sv-gallery-hero-bg">
            <img src="/theme_restaurant/static/img/gallery_bg.jpg"
                 alt="Atmospheric Table Setting"/>
          </div>
          <div class="container" style="position:relative; z-index:1; text-align:center;">
            <p class="sv-eyebrow sv-reveal" style="color:var(--sv-gold); letter-spacing:0.3em;">The Experience</p>
            <h1 class="sv-gallery-hero-title sv-reveal" style="transition-delay:0.2s;">Gallery</h1>
          </div>
        </section>
        <!-- ── Gallery Grid ── -->
        <section class="sv-gallery-section">
          <div class="container">
            <div class="sv-gallery-grid">
              <!-- 1. Interior — w-8 h-2 -->
              <div class="sv-gallery-item sv-w-8 sv-h-2"
                   data-caption="Restaurant Interior"
                   data-src="/theme_restaurant/static/img/gallery/interior.jpg">
                <img src="/theme_restaurant/static/img/gallery/interior.jpg"
                     alt="Restaurant Interior"/>
              </div>
              <!-- 2. Steak — w-4 h-1 -->
              <div class="sv-gallery-item sv-w-4 sv-h-1"
                   data-caption="Dry-Aged Steak"
                   data-src="/theme_restaurant/static/img/gallery/steak.jpg">
                <img src="/theme_restaurant/static/img/gallery/steak.jpg"
                     alt="Dry-Aged Steak"/>
              </div>
              <!-- 3. Cocktail — w-4 h-1 -->
              <div class="sv-gallery-item sv-w-4 sv-h-1"
                   data-caption="Mixologist at Work"
                   data-src="/theme_restaurant/static/img/gallery/cocktail.jpg">
                <img src="/theme_restaurant/static/img/gallery/cocktail.jpg"
                     alt="Mixologist at Work"/>
              </div>
              <!-- 4. Table — w-8 h-1 -->
              <div class="sv-gallery-item sv-w-8 sv-h-1"
                   data-caption="Candlelit Table"
                   data-src="/theme_restaurant/static/img/gallery/table.jpg">
                <img src="/theme_restaurant/static/img/gallery/table.jpg"
                     alt="Candlelit Table"/>
              </div>
              <!-- 5. Aging Room — w-4 h-2 -->
              <div class="sv-gallery-item sv-w-4 sv-h-2"
                   data-caption="Dry Aging Room"
                   data-src="/theme_restaurant/static/img/gallery/aging.jpg">
                <img src="/theme_restaurant/static/img/gallery/aging.jpg"
                     alt="Dry Aging Room"/>
              </div>
              <!-- 6. Chef — w-4 h-1 -->
              <div class="sv-gallery-item sv-w-4 sv-h-1"
                   data-caption="Executive Chef Plating"
                   data-src="/theme_restaurant/static/img/gallery/chef.jpg">
                <img src="/theme_restaurant/static/img/gallery/chef.jpg"
                     alt="Executive Chef Plating"/>
              </div>
              <!-- 7. Wine — w-4 h-1 -->
              <div class="sv-gallery-item sv-w-4 sv-h-1"
                   data-caption="Premium Wine Service"
                   data-src="/theme_restaurant/static/img/gallery/wine.jpg">
                <img src="/theme_restaurant/static/img/gallery/wine.jpg"
                     alt="Premium Wine Service"/>
              </div>
              <!-- 8. Exterior — w-4 h-1 -->
              <div class="sv-gallery-item sv-w-4 sv-h-1"
                   data-caption="Restaurant Exterior"
                   data-src="/theme_restaurant/static/img/gallery/exterior.jpg">
                <img src="/theme_restaurant/static/img/gallery/exterior.jpg"
                     alt="Restaurant Exterior"/>
              </div>
              <!-- 9. Fire — w-8 h-1 -->
              <div class="sv-gallery-item sv-w-8 sv-h-1"
                   data-caption="Cooking over Open Fire"
                   data-src="/theme_restaurant/static/img/gallery/fire.jpg">
                <img src="/theme_restaurant/static/img/gallery/fire.jpg"
                     alt="Cooking over Open Fire"/>
              </div>
            </div>
          </div>
        </section>
        <!-- ── Lightbox ── -->
        <div id="sv_gallery_lightbox" class="sv-lightbox" role="dialog" aria-modal="true">
          <button class="sv-lightbox-close" id="sv_lightbox_close" aria-label="Close">
            <i class="fa fa-times"/>
          </button>
          <button class="sv-lightbox-nav sv-lightbox-prev" id="sv_lightbox_prev" aria-label="Previous">
            <i class="fa fa-chevron-left"/>
          </button>
          <button class="sv-lightbox-nav sv-lightbox-next" id="sv_lightbox_next" aria-label="Next">
            <i class="fa fa-chevron-right"/>
          </button>
          <div class="sv-lightbox-inner">
            <div class="sv-lightbox-img-wrap">
              <img id="sv_lightbox_img" src="" alt=""/>
            </div>
            <div class="sv-lightbox-caption-bar">
              <span class="sv-eyebrow" style="letter-spacing:0.2em; font-size:10px;">The Experience</span>
              <p id="sv_lightbox_caption" class="sv-lightbox-caption"/>
              <div class="sv-lightbox-dots" id="sv_lightbox_dots"/>
            </div>
          </div>
        </div>
        <div class="oe_structure"/>
      </div>
    </t>
  </template>
  <!-- 2. Register as a website.page so /gallery route works -->
  <record id="savora_gallery_website_page" model="website.page">
    <field name="name">Gallery</field>
    <field name="url">/gallery</field>
    <field name="view_id" ref="theme_restaurant.savora_gallery_page"/>
    <field name="website_published">True</field>
    <field name="is_published">True</field>
  </record>
</odoo>
