<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reviews -->
    <template id="savora_reviews_page" name="Guest Experiences">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- REVIEWS HERO -->
                <section class="menu-hero">
                    <div class="menu-hero-bg">
                        <img src="/theme_restaurant/static/img/reservation_bg.jpg" alt="Atmospheric Dining Room" />
                    </div>
                    <div class="container" style="z-index: 2; position: relative;">
                        <t t-if="request.params.get('submitted')">
                            <div class="alert alert-success mb-4" role="alert" style="background:rgba(212,175,55,0.1); border-color:var(--sv-gold); color:var(--sv-gold); text-align:center;">
                                <h4 class="alert-heading">Thank You!</h4>
                                <p>Your review has been submitted and is now live on our website.</p>
                            </div>
                        </t>
                        <p class="sv-eyebrow reveal active" style="color: var(--sv-gold); letter-spacing: 0.3em; margin-bottom: 8px;">GUEST EXPERIENCES</p>
                        <h1 class="reveal active">Reviews</h1>
                    </div>
                </section>
                <!-- SUMMARY SECTION -->
                <section class="review-summary">
                    <div class="container">
                        <div class="summary-content">
                            <div class="big-rating" t-esc="'%.1f' % average_rating"/>
                            <div class="summary-stars">
                                <t t-foreach="range(5)" t-as="i">
                                    <i t-attf-class="fa fa-star#{'' if i &lt; int(average_rating) else '-o'}"/>
                                </t>
                            </div>
                            <p class="summary-note" t-esc="summary_note"/>
                        </div>
                    </div>
                </section>
                <!-- REVIEWS GRID -->
                <main class="review-page-grid" style="padding-bottom: 60px;">
                    <div class="container">
                        <t t-if="reviews">
                            <div class="r-grid">
                                <t t-foreach="reviews" t-as="review">
                                    <div t-attf-class="r-card #{'r-hidden' if review_index &gt; 5 else ''}">
                                        <div class="r-card-top">
                                            <t t-if="review.image_1920">
                                                <img t-att-src="'/web/image/theme.restaurant.review/%s/image_1920' % review.id"
                                                     t-att-alt="review.name"
                                                     class="r-avatar"/>
                                            </t>
                                            <t t-elif="review.avatar_url">
                                                <img t-att-src="review.avatar_url"
                                                     t-att-alt="review.name"
                                                     class="r-avatar"/>
                                            </t>
                                            <t t-else="">
                                                <div class="r-avatar r-avatar-fallback" style="background:var(--sv-surface-2); display:flex; align-items:center; justify-content:center; border-radius:50%; font-weight:bold; color:var(--sv-gold);">
                                                    <t t-esc="(review.name or 'G')[:1].upper()"/>
                                                </div>
                                            </t>
                                            <div class="r-meta">
                                                <h4 class="r-name" t-esc="review.name"/>
                                                <p class="r-date" t-esc="review.review_date.strftime('%B %d, %Y') if review.review_date else ''"/>
                                            </div>
                                        </div>
                                        <div class="r-stars" style="color:var(--sv-gold); margin:10px 0;">
                                            <t t-foreach="range(5)" t-as="i">
                                                <i t-attf-class="fa fa-star#{'' if i &lt; review.rating else '-o'}"/>
                                            </t>
                                        </div>
                                        <p class="r-text">"<t t-esc="review.review_text"/>"</p>
                                    </div>
                                </t>
                            </div>
                            <t t-if="len(reviews) &gt; 6">
                                <div class="load-more-wrap text-center mt-5">
                                    <button class="sv-btn-outline js_see_all_reviews" style="padding:15px 40px; background:none; border:1px solid var(--sv-gold); color:var(--sv-gold);">SEE ALL REVIEWS</button>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="text-center py-5">
                                <p class="summary-note" style="color:var(--sv-muted);">NO GUEST REVIEWS ARE PUBLISHED YET.</p>
                            </div>
                        </t>
                    </div>
                </main>
                <!-- SUBMISSION FORM -->
                <section class="sv-review-submission-section" style="background:var(--sv-surface-1); padding:100px 0; border-top:1px solid rgba(255,255,255,0.05);">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-7 text-center mb-5">
                                <p class="sv-eyebrow mb-2">Feedback</p>
                                <h2 class="sv-section-title" style="color:var(--sv-cream);">Share Your Experience</h2>
                                <p style="color:var(--sv-muted);">We value your thoughts. Tell us about your visit to Savora.</p>
                            </div>
                            <div class="col-lg-8">
                                <div class="sv-review-form-card" style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.08); padding:40px; border-radius:4px;">
                                    <form action="/reviews/submit" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label style="color:var(--sv-cream); font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; margin-bottom:8px; display:block;">Full Name</label>
                                                <input type="text" name="name" style="width:100%; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:var(--sv-cream); padding:12px 16px; outline:none;" required="1" placeholder="Jane Doe"/>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label style="color:var(--sv-cream); font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; margin-bottom:8px; display:block;">Rating</label>
                                                <select name="rating" style="width:100%; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:var(--sv-cream); padding:12px 16px; outline:none;" required="1">
                                                    <option value="5" style="color:black;">5 Stars - Exceptional</option>
                                                    <option value="4" style="color:black;">4 Stars - Great</option>
                                                    <option value="3" style="color:black;">3 Stars - Good</option>
                                                    <option value="2" style="color:black;">2 Stars - Average</option>
                                                    <option value="1" style="color:black;">1 Star - Poor</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="mb-4">
                                            <label style="color:var(--sv-cream); font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; margin-bottom:8px; display:block;">Review Details</label>
                                            <textarea name="review_text" style="width:100%; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:var(--sv-cream); padding:12px 16px; outline:none;" rows="5" required="1" placeholder="Describe your dining experience..."/>
                                        </div>
                                        <div class="text-center">
                                            <button type="submit" class="sv-btn-gold" style="padding:15px 60px; background:var(--sv-gold); border:none; color:#1b0f08; font-weight:700; letter-spacing:1px; cursor:pointer;">Post Your Review</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
<!--    Reviews page link-->
    <record id="savora_reviews_website_page" model="website.page">
        <field name="name">Guest Experiences</field>
        <field name="url">/reviews</field>
        <field name="view_id" ref="theme_restaurant.savora_reviews_page"/>
        <field name="website_published">True</field>
        <field name="is_published">True</field>
    </record>
</odoo>
