<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filtered Action for Savora Bookings Only -->
    <record id="action_savora_bookings_filtered" model="ir.actions.act_window">
        <field name="name">Savora Reservations</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('name', 'ilike', 'Reservation')]</field>
        <field name="context">{'default_name': 'Reservation'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Savora reservations yet!
            </p>
            <p>
                Bookings made through the Savora Experience System will appear here.
            </p>
        </field>
    </record>
    <!-- Savora Root Menu -->
    <menuitem id="menu_savora_root" name="Savora" sequence="10" web_icon="theme_restaurant,static/description/icon.png"/>
    <!-- Dedicated Reservations Menu -->
    <menuitem id="menu_savora_booking" 
              name="Reservations" 
              parent="menu_savora_root" 
              action="action_savora_bookings_filtered" 
              sequence="10"/>
</odoo>
