<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form view for wizard of application shortlist -->
    <record id="hr_ai_shortlist_view_form" model="ir.ui.view">
        <field name="name">hr.ai.shortlist.view.form</field>
        <field name="model">hr.ai.shortlist</field>
        <field name="arch" type="xml">
            <form string="Shortlist">
                <group>
                    <field name="stage_id"/>
                    <field name="job_id" readonly="1"/>
                </group>
                <group>
                    <group>
                        <label string="Score" for="operators"/>
                        <field name="operators" nolabel="1"/>
                    </group>
                    <group>
                        <field name="required_score" nolabel="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Applications">
                        <field name="applicant_ids">
                            <tree>
                                <field name="partner_name"/>
                                <field name="create_date"/>
                                <field name="name"/>
                                <field name="application_status"/>
                                <field name="ats_score"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_application_shortlist"
                            string="Shortlist" type="object"
                            class="oe_highlight"
                            confirm="Only applicants who have a review score will be considered for the shortlisting process. Calculate the score before shortlisting applicants."/>
                    <button name="cancel" string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
