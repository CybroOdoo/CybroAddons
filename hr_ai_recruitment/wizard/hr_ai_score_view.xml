<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form view for wizard of ai score -->
    <record id="hr_ai_score_view_form" model="ir.ui.view">
        <field name="name">hr.ai.score.view.form</field>
        <field name="model">hr.ai.score</field>
        <field name="arch" type="xml">
            <form string="Shortlist">
                <group>
                    <field name="hr_shortlist_id"/>
                    <field name="hr_applicant_id" invisible="1"/>
                    <field name="attachment_id"/>
                </group>
                <footer>
                    <button name="action_calculate_score"
                            string="Calculate" type="object"
                            class="oe_highlight"/>
                    <button name="cancel" string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
