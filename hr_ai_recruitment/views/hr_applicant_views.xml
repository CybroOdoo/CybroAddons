<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Inherited Hr applicant view form to add fields-->
    <record id="hr_applicant_view_form" model="ir.ui.view">
        <field name="name">hr.applicant.view.form.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='archive_applicant']" position="after">
                <field name="ai_shortlist_enabled" invisible="1"/>
                <button name="action_ats_score" type="object"
                        string="Calculate Score" invisible="not ai_shortlist_enabled"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Score Summary" name="cv_summary" invisible="not ats_score">
                    <field name="cv_score_summary"/>
                </page>
            </xpath>
            <xpath expr="//field[@name='type_id']" position="after">
                <field name="ats_score" type="object" string="CV Score"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
