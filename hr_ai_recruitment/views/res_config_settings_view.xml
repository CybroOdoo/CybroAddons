<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Setup Shortlist Ai view on settings    -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr_ai_recruitment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="hr_recruitment.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='recruitment_process_div']"
                   position="inside">
                <setting string="AI Recruitment Shortlist"
                         help="Use AI to enhance the recruitment process, including automated resume screening and candidate ranking."
                         id="display_ai_shortlist">
                    <field name="is_ai_shortlist"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
