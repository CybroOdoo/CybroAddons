<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form view for of hr shortlist configuration-->
    <record id="hr_shortlist_view_form" model="ir.ui.view">
        <field name="name">hr.shortlist.view.form</field>
        <field name="model">hr.shortlist</field>
        <field name="arch" type="xml">
            <form string="Shortlist">
                <group>
                    <field name="name"/>
                </group>
                <notebook>
                    <page string="Shortlist lines">
                        <field name="hr_shortlist_line_ids">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="score" sum="Total Score"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>
    <!-- actions -->
    <record id="hr_shortlist_action" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">HR Shortlist</field>
        <field name="res_model">hr.shortlist</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="hr_shortlist_menu" name="Shortlist Configuration"
              parent="hr_recruitment.menu_hr_recruitment_config_applications"
              action="hr_shortlist_action" active="False"/>
</odoo>
