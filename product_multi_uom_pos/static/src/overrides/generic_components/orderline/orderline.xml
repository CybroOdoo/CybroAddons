<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="product_multi_uom_pos.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('info-list')]" position="after">
            <t t-set="uomList" t-value="getAvailableUoms()"/>
            <t t-if="props.mode !== 'receipt' and uomList.length > 0">
                <div class="uom-selector-area mt-1 p-2 border rounded bg-light"
                     t-on-pointerdown.stop=""
                     t-on-pointerup.stop=""
                     t-on-pointercancel.stop=""
                     t-on-mousedown.stop=""
                     t-on-mouseup.stop=""
                     t-on-click.stop=""
                     t-on-touchstart.stop=""
                     t-on-touchend.stop="">
                    <div class="mb-1 small fw-bold text-primary">
                        Selected: <t t-esc="getCurrentUomDisplay().uomName"/>
                        (<t t-esc="env.utils.formatCurrency(getCurrentUomDisplay().price)"/>)
                    </div>
                    <div class="d-flex gap-1">
                        <select class="form-select form-select-sm"
                                t-on-change="onUomChange"
                                t-on-click.stop=""
                                t-on-pointerdown.stop=""
                                t-on-pointerup.stop=""
                                t-on-mousedown.stop=""
                                t-on-mouseup.stop=""
                                t-on-wheel.stop.prevent="">
                            <option value="" t-att-selected="!getCurrentSelectedUomId() ? 'selected' : undefined">Change Uom</option>
                            <t t-foreach="uomList" t-as="item" t-key="item.id">
                                <option t-att-value="item.uom_id" t-att-selected="getCurrentSelectedUomId() === item.uom_id ? 'selected' : undefined">
                                    <t t-esc="item.uom_name"/> - <t t-esc="env.utils.formatCurrency(item.price)"/>
                                </option>
                            </t>
                        </select>
                        <button t-if="props.line.custom_uom_name"
                                class="btn btn-sm btn-outline-danger"
                                t-on-click.stop="onReset"
                                t-on-pointerdown.stop=""
                                t-on-pointerup.stop="">
                            <i class="fa fa-undo"/>
                        </button>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>