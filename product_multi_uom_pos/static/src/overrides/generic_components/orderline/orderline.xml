<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="product_multi_uom_pos.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">

        <xpath expr="//ul[hasclass('info-list')]" position="inside">
            <t t-if="this.props.mode === 'receipt' and this.props.line.custom_uom_name">
                <li style="list-style: none; font-weight: 600; color: #444; line-height: 1.2; margin-top: 2px; font-size: 0.85em;">
                    <t t-out="this.formatCurrency(this.props.line.custom_uom_price || this.props.line.price_unit)"/> / <t t-out="this.props.line.custom_uom_name"/>
                </li>
            </t>
        </xpath>

        <xpath expr="//ul[hasclass('info-list')]" position="after">
            <t t-set="uomList" t-value="this.getAvailableUoms()"/>
            <t t-if="this.props.mode !== 'receipt' and uomList.length > 0">
                <div class="uom-selector-area mt-1 p-2 border rounded bg-light">
                    <div class="mb-1 small fw-bold text-primary">
                        Selected: <t t-out="this.getCurrentUomDisplay().uomName"/>
                        (<t t-out="this.formatCurrency(this.getCurrentUomDisplay().price)"/>)
                    </div>
                    <div class="d-flex gap-1">
                        <select class="form-select form-select-sm" t-on-change=" (event) => this.onUomChange(event)" t-on-click.stop="() => {}">
                            <option value="">Change Uom</option>
                            <t t-foreach="uomList" t-as="item" t-key="item.id">
                                <option t-att-value="item.uom_id" t-att-selected="this.props.line.product_uom_id === item.uom_id">
                                    <t t-out="item.uom_name"/> - <t t-out="this.formatCurrency(item.price)"/>
                                </option>
                            </t>
                        </select>
                        <button t-if="this.props.line.custom_uom_name" class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center" t-on-click.stop="() => this.onReset()" title="Reset UoM">
                            <i class="oi" data-icon="close"/>
                        </button>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
