<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- QR scanner template -->
    <template id="qr_login" inherit_id="web.login" name="QR scanner">
        <xpath expr="//form" position="inside">
            <div class="justify-content-between mt-2 d-flex small oe_qr_login">
                <a href="#" id="login_click" class="btn btn-link">Log in with QR Code</a>
                <div class="scanner-overlay d-none"/>
                <div class="qr_video">
                    <div class="close_button d-none">
                        <button id="close_qr_scanner" type="button" class="btn btn-danger">X</button>
                    </div>
                    <div class="video-container d-none">
                        <video id="video" autoplay="true" playsinline="true" muted="true"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
