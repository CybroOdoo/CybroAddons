<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Extend list renderer: add drag and drop attributes to column headers -->
    <t t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//thead//t[@t-foreach='state.columns']/th[@t-if]" position="attributes">
            <attribute name="data-col-id" t-att-data-col-id="column.id"/>
            <attribute name="draggable">true</attribute>
            <attribute name="t-on-dragstart">onColumnDragStart</attribute>
            <attribute name="t-on-dragover">onColumnDragOver</attribute>
            <attribute name="t-on-dragleave">onColumnDragLeave</attribute>
            <attribute name="t-on-drop">onColumnDrop</attribute>
            <attribute name="t-on-dragend">onColumnDragEnd</attribute>
        </xpath>
    </t>

</templates>

