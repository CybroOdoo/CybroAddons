<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Extend list renderer: add data-col-id to each header cell -->
    <t t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <!--
            We use custom pointer events, so we do NOT add draggable="true"
            to avoid conflict with native HTML5 drag and drop.
        -->
        <xpath expr="//thead//t[@t-foreach='columns']/th" position="attributes">
            <attribute name="t-att-data-col-id">column.id</attribute>
        </xpath>
    </t>
</templates>
