<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Manufacturing Order Form View -->
    <record id="mrp_production_form_dimension_view" model="ir.ui.view">
        <field name="name">mrp.production.form.dimension</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Add dimension fields after the product field -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="dimension_method" invisible="not show_dimension_fields"/>
                <field name="width" invisible="not show_dimension_fields"/>
                <field name="height" invisible="not show_dimension_fields"/>
                <field name="length" invisible="not show_dimension_fields"/>
                <field name="dimension_qty" invisible="not show_dimension_fields"/>
                <field name="show_dimension_fields" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
