<?xml version="1.0" encoding="UTF-8"?>
<!-- views/report_saleorder_custom_table.xml -->
<odoo>
    <template id="report_saleorder_document_custom_table" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table[@class='table table-sm o_main_table table-borderless mt-4']/thead/tr/th[@name='th_description']"
               position="after">
            <!-- Adding new table headers for custom fields -->
            <th name="th_length" class="text-end">Length</th>
            <th name="th_width" class="text-end">Width</th>
            <th name="th_height" class="text-end">Height</th>
            <th name="th_dimension_qty" class="text-end">Dimension Qty</th>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="after">
            <!-- Adding the custom fields in the order line rows with t-if and t-else conditions -->
            <td style="text-align: center; padding: 0 5px;">
                <span t-if="line.length" t-field="line.length"/>
                <span t-else=" "/>
            </td>
            <td style="text-align: center; padding: 0 5px;">
                <span t-if="line.width" t-field="line.width"/>
                <span t-else=" "/>
            </td>
            <td style="text-align: center; padding: 0 5px;">
                <span t-if="line.height" t-field="line.height"/>
                <span t-else=" "/>
            </td>
            <td style="text-align: center; padding: 0 5px;">
                <span t-if="line.dimension_qty" t-field="line.dimension_qty"/>
                <span t-else=" "/>
            </td>
        </xpath>
    </template>
</odoo>
