<?xml version="1.0" encoding="UTF-8"?>
<!-- This view inherits the purchase order form and adds dimension fields (Length, Width, Height, Dimension Qty) next
to the product field in the order lines tree -->
<odoo>
    <record id="view_purchase_order_line_tree_inherit_dimensions" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.inherit.dimensions</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="length" width="80px"/>
                <field name="width" width="80px"/>
                <field name="height" width="80px"/>
                <field name="dimension_qty" width="100px"/>
            </xpath>
        </field>
    </record>
</odoo>
