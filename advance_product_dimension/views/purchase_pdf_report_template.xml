<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- This template inherits the purchase quotation report and adds columns for product dimensions (Length, Width, Height, Dimension Qty) in both the table header and order line rows -->
    <template id="report_purchaseorder_document_custom_table" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//table[@class='table table-sm mt-4']/thead/tr/th[@name='th_description']" position="after">
            <!-- Adding new table headers for custom fields -->
            <th name="th_length"><strong>Length</strong></th>
            <th name="th_width"><strong>Width</strong></th>
            <th name="th_height"><strong>Height</strong></th>
            <th name="th_dimension_qty"><strong>Dimension Qty</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <!-- Adding the custom fields in the order line rows with t-if conditions and styling -->
            <td id="length">
                <span t-if="order_line.length" t-field="order_line.length"/>
                <span t-else=" "/>
            </td>
            <td id="width">
                <span t-if="order_line.width" t-field="order_line.width"/>
                <span t-else=" "/>
            </td>
            <td id="height">
                <span t-if="order_line.height" t-field="order_line.height"/>
                <span t-else=" "/>
            </td>
            <td id="dimension_qty">
                <span t-if="order_line.dimension_qty" t-field="order_line.dimension_qty"/>
                <span t-else=" "/>
            </td>
        </xpath>
    </template>
</odoo>
