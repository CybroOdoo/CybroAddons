<?xml version="1.0" encoding="UTF-8"?>
<!-- This template inherits the purchase order report and adds columns for product dimensions (Length, Width, Height,
 Dimension Qty) in both the table header and order line rows -->
<odoo>
    <template id="report_purchaseorder" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//table[contains(@class,'o_main_table')]/thead/tr/th[@name='th_description']" position="after">
            <!-- Adding new table headers for custom fields -->
            <th name="th_length"><strong>Length</strong></th>
            <th name="th_width"><strong>Width</strong></th>
            <th name="th_height"><strong>Height</strong></th>
            <th name="th_dimension_qty"><strong>Dimension Qty</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <!-- Adding the custom fields in the order line rows with t-if conditions and styling -->
            <td id="length">
                <span t-if="line.length" t-field="line.length"/>
                <span t-else=" "/>
            </td>
            <td id="width">
                <span t-if="line.width" t-field="line.width"/>
                <span t-else=" "/>
            </td>
            <td id="height">
                <span t-if="line.height" t-field="line.height"/>
                <span t-else=" "/>
            </td>
            <td id="dimension_qty">
                <span t-if="line.dimension_qty" t-field="line.dimension_qty"/>
                <span t-else=" "/>
            </td>
        </xpath>
    </template>
</odoo>
