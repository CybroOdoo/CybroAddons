<?xml version="1.0" encoding="UTF-8"?>
<!-- This view inherits the sale order form and adds dimension fields (Length, Width, Height, Dimension Qty) next to
the product description in the order lines tree -->
<odoo>
    <record id="view_order_form_inherit_custom_note" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.note</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='name']" position="after">
                <field name="length" width="50px"/>
                <field name="width" width="50px"/>
                <field name="height" width="50px"/>
                <field name="dimension_qty" width="80px"/>
            </xpath>
        </field>
    </record>
</odoo>

