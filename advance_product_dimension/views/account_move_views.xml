<?xml version="1.0" encoding="UTF-8"?>
<!-- This view inherits the account.move form view and adds dimension fields (length, width, height, dimension_qty)
 after the product description in the invoice lines tree -->
<odoo>
    <record id="account_move_view_form_inherit_advance_product_dimension" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.advance.product.dimension</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
                <field name="length" width="50px"/>
                <field name="width" width="50px"/>
                <field name="height" width="50px"/>
                <field name="dimension_qty" width="80px"/>
            </xpath>
        </field>
    </record>
</odoo>
