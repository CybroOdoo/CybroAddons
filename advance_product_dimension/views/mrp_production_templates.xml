<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- This template inherits the manufacturing order report and adds a row displaying the product dimensions
     (length, width, height, dimension quantity) if available -->
    <template id="report_manufacture_order" inherit_id="mrp.report_mrporder">
        <xpath expr="//div[contains(@class,'row mt32 mb32')]" position="after">
            <div class="row mt32 mb32">
                        <div class="col-3" t-if="o.length">
                            <strong>Length:</strong><br/>
                            <span t-field="o.length"/>
                        </div>
                        <div class="col-3" t-if="o.width">
                            <strong>Width:</strong><br/>
                            <span t-field="o.width"/>
                        </div>
                        <div class="col-3" t-if="o.height">
                            <strong>height:</strong><br/>
                            <span t-field="o.height"/>
                        </div>
                        <div class="col-3" t-if="o.dimension_qty">
                            <strong>Dimension Qty:</strong><br/>
                            <span t-field="o.dimension_qty"/>
                        </div>
            </div>
        </xpath>
    </template>
</odoo>
