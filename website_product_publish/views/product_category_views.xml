<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adding buttons in product category for website publish -->
    <record id="product_category_form_view" model="ir.ui.view">
        <field name="name">
            product.category.view.form.inherit.website.product.publish
        </field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_publish_all_products"
                        type="object"
                        class="oe_stat_button">
                    <i class="oi" style="margin-right:5px" data-icon="check"
                       title="Publish All"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Publish All</span>
                    </div>
                </button>
                <button name="action_unpublish_all_products"
                        type="object"
                        class="oe_stat_button">
                    <i class="oi" style="margin-right:5px" data-icon="close"
                       title="Unpublish All"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Unpublish All</span>
                    </div>
                </button>
                <button class="oe_stat_button"
                        name="action_view_published_products" type="object"
                        sequence="12">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="published_count"/>
                        </span>
                        <span class="o_stat_text">Published</span>
                    </div>
                </button>
                <button class="oe_stat_button"
                        name="action_view_unpublished_products" type="object"
                        sequence="13">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="unpublished_count"/>
                        </span>
                        <span class="o_stat_text">Unpublished</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
