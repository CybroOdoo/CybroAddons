<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Home-->
    <record id="menu_home" model="website.menu">
        <field name="name">HOME</field>
        <field name="url">/</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="10"/>
    </record>
    <!-- Baby Feeding -->
    <record id="menu_baby_feeding" model="website.menu">
        <field name="name">BABY FEEDING</field>
        <field name="url">/shop/baby_feeding</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="20"/>
    </record>
    <!-- Baby T-Shirt -->
    <record id="menu_baby_tshirt" model="website.menu">
        <field name="name">BABY T-SHIRT</field>
        <field name="url">/shop/baby_tshirt</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="30"/>
    </record>
    <!-- Baby Toys -->
    <record id="menu_baby_toys" model="website.menu">
        <field name="name">BABY TOYS</field>
        <field name="url">/shop/baby_toys</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="40"/>
    </record>
</odoo>
