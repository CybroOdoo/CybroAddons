<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template to inherit the contact us page from the website module -->
    <template id="mars_contact" inherit_id="website.contactus" name="Contactus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap">
                <!-- custom header section -->
                <section class="category-header category-header-contact-us p-4 w-100 float-left">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-6">
                                <h3 class="text-white mt-3"><b>Contact Us</b></h3>
                            </div>
                            <div class="col-lg-6">
                                <ul class="ul-header-links">
                                    <li class="float-left ml-2">
                                        <a href="/"><img src="/theme_kids_care/static/src/images/home-icon.png"/></a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Contact form section with proper Odoo integration -->
                <section class="section-contact-us float-left w-100">
                    <div class="container">
                        <div class="row">
                            <!-- Contact information -->
                            <div class="col-lg-6" style="display: flex; justify-content: space-between; margin-top: 40px;">
                                <div style="width: 48%;">
                                    <b>Telephone</b><br/>
                                    610-403-403<br/>
                                    <b>Email</b><br/>
                                    shop@company.com
                                </div>
                                <div style="width: 48%;">
                                    <b>Address</b><br/>
                                    kidscare9070 Green Lake<br/>
                                    Drive Chevy Chase,<br/>
                                    MD 20815, USA
                                </div>
                            </div>
                            <!-- Odoo contact form with proper configuration -->
                            <div class="col-lg-6">
                                <div class="container-contact-form p-4 mb-5">
                                    <h3 class="h3-contact-form pt-3 pb-3 pl-1">Contact Form</h3>
                                    <form id="contactus_form" action="/theme_kids_care/contactus/submit" method="post"
                                          enctype="multipart/form-data">
                                        <div class="row">
                                            <!-- Name Field -->
                                            <div class="form-group mb-3 col-12">
                                                <label for="name">Your Name <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control"
                                                       id="name" name="name"
                                                       t-att-value="logged_partner and logged_partner.name or ''"
                                                       required="required"/>
                                            </div>
                                            <!-- Email Field -->
                                            <div class="form-group mb-3 col-12">
                                                <label for="email_from">E-mail Address <span class="text-danger">*</span></label>
                                                <input type="email" class="form-control"
                                                       id="email_from" name="email_from"
                                                       t-att-value="logged_partner and logged_partner.email or ''"
                                                       required="required"/>
                                            </div>
                                            <!-- Subject Field -->
                                            <div class="form-group mb-3 col-12">
                                                <label for="subject">Subject <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control"
                                                       id="subject" name="subject" required="required"/>
                                            </div>
                                            <!-- Message Field -->
                                            <div class="form-group mb-3 col-12">
                                                <label for="description">Your Message <span class="text-danger">*</span></label>
                                                <textarea class="form-control"
                                                          id="description" name="description"
                                                          required="required"/>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end">
                                                <button type="submit"
                                                   class="btn-add-to-cart-check-out-orange px-4 py-2 mt-2">
                                                    Submit
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
