<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Automatically insert snippets into the homepage for the theme -->
    <template id="theme_homepage" inherit_id="website.homepage" name="Kids Care Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty"/>
        </xpath>
    </template>
</odoo>
