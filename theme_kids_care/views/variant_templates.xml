<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Variants-->
    <template id="variants_inline" inherit_id="website_sale.variants">
        <!-- Flex layout + proper vertical alignment -->
        <xpath expr="//li[@t-att-data-attribute-id]" position="attributes">
            <attribute name="style">display: flex; align-items: center; gap: 8px; flex-wrap: wrap; line-height: 1.5;
            </attribute>
        </xpath>
        <!-- Replace <strong> with inline normal text and colon -->
        <xpath expr="//li[@t-att-data-attribute-id]/h6" position="replace">
            <span class="attribute_name" style="font-weight: normal; display: inline-flex; align-items: center;">
                <t t-esc="ptal.attribute_id.name"/>
                <span style="margin-left:5px;">:</span>
            </span>
        </xpath>
    </template>
</odoo>
