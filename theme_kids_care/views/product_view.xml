<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    product view inherit-->
    <template id="product_view_inherit" inherit_id="website_sale.product" priority="999">
        <xpath expr="//section[@id='product_detail']" position="replace">
            <t t-set="main_object" t-value="product"/>
            <t t-set="combination" t-value="product._get_first_possible_combination()"/>
            <t t-set="product_variant" t-value="product_variant or product.env['product.product'].browse(product._get_first_possible_variant_id(combination))"/>
            <t t-set="product_images" t-value="product._get_images()"/>
            <t t-set="combination_info" t-value="product._get_combination_info(combination, product_id, add_qty or 1)"/>
            <t t-set="ribbon" t-value="product_variant and product_variant.variant_ribbon_id or product.website_ribbon_id"/>
            <section t-attf-class="oe_website_sale #{'discount' if combination_info['has_discounted_price'] else ''}" id="product_detail"
                t-att-data-view-track="view_track and '1' or '0'"
                t-att-data-product-tracking-info="json.dumps(product_tracking_info)"
                t-att-data-oe-model="product._name"
                t-att-data-oe-id="product.id">
                <div class="container py-5">
                    <div class="row align-items-start" id="product_detail_main" data-image_layout="carousel" data-image_width="none">
                        <!-- Left: Product Images (Forced to 6 columns) -->
                        <div class="col-md-6 o_wsale_product_images o_wsale_sticky_object mb-4 mb-md-0">
                            <t t-call="website_sale.shop_product_carousel"/>
                        </div>
                        <!-- Right: Product Detailed Info (Forced to 6 columns) -->
                        <div class="col-md-6" id="product_details">
                            <div class="bg-white p-4 p-md-5 shadow-sm rounded-3 border">
                                <div id="o_wsale_product_details_content" class="js_product js_main_product">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="text-warning fs-5 me-2">
                                                <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star-o"/>
                                            </div>
                                            <small class="text-muted">| 0 Review | Write a Review</small>
                                        </div>
                                        <div>
                                            <t t-set="in_wish" t-value="product_variant and product_variant._is_in_wishlist()"/>
                                            <button type="button"
                                                    t-attf-class="btn p-0 border-0 o_add_wishlist_toggle text-muted #{in_wish and 'o_in_wishlist'}"
                                                    t-att-data-product-template-id="product.id"
                                                    t-att-data-product-product-id="product_variant.id"
                                                    title="Add to wishlist"
                                                    style="background: none; box-shadow: none;">
                                                <i t-attf-class="fa #{in_wish and 'fa-heart text-danger' or 'fa-heart-o'}" style="font-size: 24px;"/>
                                            </button>
                                        </div>
                                    </div>
                                    <p class="text-uppercase text-secondary small mb-1 ls-1" t-field="product.categ_id.name"/>
                                    <h1 itemprop="name" t-field="product.name" class="h2 mb-4 fw-bold">Product Name</h1>
                                    <div class="product-metadata border-bottom pb-4 mb-4">
                                        <h5 class="fw-bold mb-3">Products Details:</h5>
                                        <div class="d-flex mb-2">
                                            <span class="text-muted w-50">Brand:</span>
                                            <span class="fw-bold text-dark">Cloths</span>
                                        </div>
                                        <div class="d-flex mb-2">
                                            <span class="text-muted w-50">Product Code:</span>
                                            <span class="fw-bold text-dark" t-field="product.default_code">Product 4</span>
                                        </div>
                                        <div class="d-flex mb-2">
                                            <span class="text-muted w-50">Availability:</span>
                                            <span class="text-success fw-bold">In Stock</span>
                                        </div>
                                        <div class="d-flex mb-2">
                                            <span class="text-muted w-50">Ex Tax:</span>
                                            <span class="fw-bold text-dark" t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                        </div>
                                    </div>
                                    <form t-if="product._is_add_to_cart_possible()" action="/shop/cart/update" method="POST">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" t-nocache="The CSRF token must always be up to date."/>
                                        <div class="js_product mb-3">
                                            <t t-placeholder="select">
                                                <input type="hidden" class="product_id" name="product_id" t-att-value="product_variant.id" />
                                                <input type="hidden" class="product_template_id" name="product_template_id" t-att-value="product.id" />
                                                <t t-call="website_sale.variants">
                                                    <t t-set="ul_class" t-valuef="list-unstyled" />
                                                    <t t-set="parent_combination" t-value="None" />
                                                </t>
                                            </t>
                                            <t t-placeholder="optional_bill_plans"/>
                                            <div id="o_wsale_cta_wrapper" class="d-flex flex-column">
                                                <div class="availability_messages o_not_editable"/>
                                                <div class="d-flex align-items-center gap-3 mt-4 mb-5">
                                                    <span class="text-muted">Qty</span>
                                                    <div class="css_quantity input-group border rounded-pill" style="max-width: 130px; overflow: hidden;">
                                                        <a t-attf-href="#" class="btn btn-link link-dark js_add_cart_json p-2 px-3 border-0 css_quantity_minus" aria-label="Remove one" title="Remove one" name="remove_one">
                                                            <i class="fa fa-minus"/>
                                                        </a>
                                                        <input type="text" class="form-control quantity text-center border-0 bg-transparent fw-bold" data-min="1" name="add_qty" t-att-value="add_qty or 1"/>
                                                        <a t-attf-href="#" class="btn btn-link link-dark js_add_cart_json p-2 px-3 border-0 css_quantity_plus" aria-label="Add one" title="Add one">
                                                            <i class="fa fa-plus"/>
                                                        </a>
                                                    </div>
                                                </div>
                                                <div id="add_to_cart_wrap" class="product-price-action pt-4 border-top">
                                                    <div class="row align-items-center">
                                                        <div class="col-6">
                                                            <h2 class="m-0 fw-bold" style="font-size: 32px; color: #333;">
                                                                <span class="oe_price" t-esc="combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                                            </h2>
                                                        </div>
                                                        <div class="col-6 text-end">
                                                            <a role="button" id="add_to_cart" class="btn btn-primary btn-lg js_check_product a-submit px-5 py-3 fw-bold rounded-pill shadow-sm" style="background: #F1BD36; border: none; color: #fff; white-space: nowrap;" href="#">Add to Cart</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="product_unavailable" class="d-none"/>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
        <!-- Tabs Section -->
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="section-description py-5">
                <div class="container">
                    <ul class="nav nav-tabs border-0" id="productTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active border-0 font-weight-bold text-dark px-4 py-2" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab" style="background: none; border-bottom: 2px solid #F1BD36 !important;">Description</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link border-0 font-weight-bold px-4 py-2" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab" style="color: #007bff;">Reviews (0)</button>
                        </li>
                    </ul>
                    <div class="tab-content p-4 border rounded" style="background: #fff;">
                        <div class="tab-pane fade show active" id="desc" role="tabpanel">
                            <div t-field="product.website_description" class="mt-3"/>
                            <p t-if="not product.website_description">Embark on exciting imaginary adventures with our Explorer Play Tent. This lightweight and easy-to-assemble tent is a portal to limitless possibilities. Whether your child envisions a jungle expedition or a secret hideout, the play tent offers a cozy and imaginative space for playtime fun and storytelling. Introduce your child to the enchanting world of music with our Musical Instrument Set. This collection includes a mini keyboard, xylophone, tambourine, and maracas, allowing your little musician to explore different sounds and rhythms. Watch as they develop a love for music and unleash their inner rockstar.</p>
                        </div>
                        <div class="tab-pane fade" id="reviews" role="tabpanel">
                            <p class="mt-3">No reviews yet.</p>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Custom Content Section (Mockup 2) -->
            <section class="section-custom-product-content py-5 bg-light">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-md-7 pe-5">
                            <h2 class="font-weight-bold mb-4" style="font-size: 36px;">Plastic kid standing</h2>
                            <p class="text-secondary small font-weight-bold mb-3">BABY CARE</p>
                            <p class="mb-4 text-muted" style="line-height: 1.8;">Let your child's creativity and engineering skills shine with our Construction Vehicle Set. This set includes a range of vehicles, such as bulldozers, cranes, and dump trucks, allowing your little builder to create and transport their own construction sites. Watch as they develop fine motor skills and learn about different types of machinery.</p>
                            <a href="#" class="btn btn-primary px-5 py-3" style="background: #F1BD36; border: none; border-radius: 50px;">Add to Cart</a>
                        </div>
                        <div class="col-md-5">
                            <img src="/theme_kids_care/static/src/images/img-stand.png" class="img-fluid rounded shadow" alt="Kids Care"/>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Related Products -->
            <section class="section-related-products py-5 oe_website_sale">
                <div class="container" id="products_grid">
                    <h2 class="font-weight-bold mb-5">Related Products</h2>
                    <div class="row">
                        <t t-set="related_products" t-value="product.alternative_product_ids[:3] or request.env['product.template'].sudo().search([('is_published', '=', True), ('categ_id', '=', product.categ_id.id), ('id', '!=', product.id)], limit=3)"/>
                        <t t-foreach="related_products" t-as="rel_p">
                            <div class="col-md-4 mb-4 mt-4">
                                <form action="/shop/cart/update" method="POST" class="h-100 js_product">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" t-nocache="The CSRF token must always be up to date."/>
                                    <input type="hidden" name="product_id" t-att-value="rel_p.product_variant_id.id"/>
                                    <input type="hidden" name="product_template_id" t-att-value="rel_p.id"/>
                                    <div class="card border-0 p-4 shadow-sm h-100" style="background: #f9f9f9; border-radius: 12px;">
                                        <div class="row align-items-center h-100">
                                            <div class="col-7">
                                                <h5 class="font-weight-bold mb-1">
                                                    <a t-att-href="'/shop/' + slug(rel_p)" class="text-dark text-decoration-none" t-field="rel_p.name"/>
                                                </h5>
                                                <p class="text-secondary small mb-2" t-field="rel_p.categ_id.name"/>
                                                <div class="mb-3">
                                                    <span class="small text-muted me-2">Size:</span>
                                                    <span class="card-attribute-pill">18</span>
                                                    <span class="card-attribute-pill active">24</span>
                                                </div>
                                                <div class="mb-3">
                                                    <span class="small text-muted me-2">Color:</span>
                                                    <span class="card-color-dot" style="background: #fff;"/>
                                                    <span class="card-color-dot" style="background: #eee;"/>
                                                </div>
                                                <h4 class="font-weight-bold mb-4" t-field="rel_p.list_price" t-options="{'widget': 'monetary', 'display_currency': rel_p.currency_id}"/>
                                                <div class="o_wsale_product_btn">
                                                    <a role="button" class="btn btn-warning px-3 py-2 fw-bold small a-submit js_check_product" style="background: #F1BD36; border: none; border-radius: 50px; color: #fff;" href="#">Add to Cart</a>
                                                </div>
                                            </div>
                                            <div class="col-5">
                                                <img t-att-src="'/web/image/product.template/%s/image_512' % rel_p.id" class="img-fluid" style="object-fit: contain; max-height: 150px;"/>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </t>
                    </div>
                </div>
            </section>
            <!-- Testimonials & Promotion Section -->
            <section class="section-testimonials-bottom py-5" style="background-color: #CB62F0;">
                <div class="container text-center text-white py-5">
                    <p class="small text-uppercase mb-1 fw-bold">All Products</p>
                    <h2 class="fw-bold mb-5" style="font-size: 42px;">Testimonials</h2>
                    <div class="row">
                        <t t-foreach="[1, 2, 3]" t-as="i">
                            <div class="col-md-4 mb-4">
                                <div class="testimonial-card p-4 border rounded-3 text-start h-100">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                            <img src="/theme_kids_care/static/src/images/img-baby-icon.png" style="width: 25px;" onerror="this.src='/web/static/img/placeholder.png'"/>
                                        </div>
                                        <h4 class="m-0 fw-bold">Fantastic</h4>
                                    </div>
                                    <p class="small mb-5" style="opacity: 0.9; min-height: 60px;">This collection includes a mini keyboard, xylophone, tambourine and maracas, allowing your little musician to explore different sounds.</p>
                                    <div class="d-flex align-items-center mt-auto">
                                        <img src="/web/static/img/user_menu_avatar.png" class="rounded-circle me-3 border border-2 border-white" style="width: 45px;"/>
                                        <div>
                                            <p class="m-0 fw-bold">John Doe</p>
                                            <p class="m-0 small opacity-75">Client</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="d-flex justify-content-center gap-2 mt-5">
                        <span class="rounded-circle" style="width: 12px; height: 12px; background: #F1BD36;"/>
                        <span class="rounded-circle" style="width: 12px; height: 12px; background: rgba(255,255,255,0.5);"/>
                        <span class="rounded-circle" style="width: 12px; height: 12px; background: rgba(255,255,255,0.5);"/>
                        <span class="rounded-circle" style="width: 12px; height: 12px; background: rgba(255,255,255,0.5);"/>
                    </div>
                </div>
                <div class="container mt-5 pt-5 border-top" style="border-color: rgba(255,255,255,0.2) !important;">
                    <div class="row align-items-center py-5">
                        <div class="col-md-7 text-white text-start">
                            <p class="small text-uppercase mb-2 fw-bold">ALL PRODUCT</p>
                            <h2 class="fw-bold mb-0" style="font-size: 56px; line-height: 1.1;">Get 20% off<br/>for first order</h2>
                        </div>
                        <div class="col-md-5">
                            <div class="input-group rounded-pill border border-white p-1" style="background: rgba(255,255,255,0.1);">
                                <input type="text" class="form-control bg-transparent border-0 text-white placeholder-white py-3 px-4 shadow-none" placeholder="Type Your Address Email"/>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
