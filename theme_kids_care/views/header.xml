<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Header Logo -->
    <template id="theme_kids_care_header_logo"
              inherit_id="website.option_header_brand_logo"
              name="Theme Kids Care Header Logo">
        <xpath expr="//span[@t-field='website.logo']" position="replace">
            <img src="/theme_kids_care/static/src/images/logo.png"
                 alt="Kids Care"
                 style="max-height: 40px; width: auto;"/>
        </xpath>
    </template>
</odoo>
