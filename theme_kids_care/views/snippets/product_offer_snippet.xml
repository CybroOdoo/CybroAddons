<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template to register the "Product Offer" snippet in the website builder's snippet panel -->
    <template id="kidscare_product_offer_snippet" inherit_id="website.snippets" name="Product Offer">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]"
               position="inside">
            <t t-snippet="theme_kids_care.product_offer_snippet"
               string="Product Offer"/>
        </xpath>
    </template>
    <!-- Main template for the "Product Offer" snippet, showing a promotional banner with newsletter input -->
    <template id="product_offer_snippet" name="Product Offer">
        <section class="product-off-section w-100 float-left" data-snippet="theme_kids_care.product_offer_snippet" data-name="Product Offer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="product-off-section-container">
                            <h5 class="text-white">ALL PRODUCT</h5>
                            <h2 class="text-white font-weight-bold">
                                Get 20% off
                                <br/>
                                for first order
                            </h2>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="container-newsletter w-100 float-left">
                            <input placeholder="Type Your Address Email" class="input-newsletter"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
