<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kidscare_blog_slider_snippet" inherit_id="website.snippets" name="Blog Slider">
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
            <t t-snippet="theme_kids_care.blog_slider_snippet"
               string="Blog Slider"/>
        </xpath>
    </template>
    <template id="blog_slider_snippet" name="Blog Slider">
        <section class="section-blog float-left w-100 pt-5 pb-5"
                 data-snippet="theme_kids_care.blog_slider_snippet"
                 data-name="Blog Slider">
            <div class="container">

                <div class="row">

                    <div class="col-lg-12">
                        <h3>
                            <b class="text-dark">From our Blog</b>
                        </h3>

                    </div>
                    <div class="owl-carousel owl-theme blog-carousel mt-3">
                        <t t-set="blogs"
                           t-value="request.env['blog.post'].sudo().search([('is_published', '=', True)])"/>
                        <t t-foreach="blogs" t-as="blog">
                            <div class="item">
                                <div class="blog-container float-left w-100 bg-white">
                                    <t t-set="image_url" t-value="'/web/static/img/placeholder.png'"/>
                                    <t t-if="blog.cover_properties">
                                        <t t-set="cover_props" t-value="json.loads(blog.cover_properties)"/>
                                        <t t-set="bg_image" t-value="cover_props.get('background-image', 'none')"/>
                                        <t t-if="bg_image and bg_image.startswith('url')">
                                            <t t-set="image_url" t-value="bg_image[4:-1].strip(&quot;'&quot;)"/>
                                        </t>
                                    </t>
                                    <img t-att-src="image_url"
                                         t-att-alt="blog.name"
                                         loading="lazy"
                                         style="width: 100%; height: 220px; object-fit: cover; border-radius: 8px;"/>

                                    <h3 class="p-3">
                                        <b>
                                            <t t-esc="blog.name"/>
                                        </b>
                                    </h3>
                                    <div class="pl-3 pr-3 pt-0 blog-excerpt"
                                         style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5; max-height: 4.5em;">
                                        <t t-raw="blog.teaser or blog.subtitle or blog.content"/>
                                    </div>
                                    <div class="comments-section w-100 float-left p-4"/>
                                    <a class="read-more-blog pt-2 pb-2 pl-4 pr-4 text-dark text-decoration-none"
                                       t-att-href="blog.website_url">
                                        Read
                                        More
                                    </a>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
