<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet - Product Info Showcase -->
    <template id="kidscare_product_info_showcase_snippet" inherit_id="website.snippets" name="Product Info Showcase">
        <xpath expr="//snippets[@id='snippet_content']"
               position="inside">
            <t t-snippet="theme_kids_care.product_info_showcase_snippet" group="kids_care" t-thumbnail="/theme_kids_care/static/description/img/product1.png"
               string="Product Info Showcase"/>
        </xpath>
    </template>
    <!-- Product Info Showcase -->
    <template id="product_info_showcase_snippet" name="Product Info Showcase">
        <section class="section-tab mt-5 d-block w-100 position-relative" data-snippet="theme_kids_care.product_info_showcase_snippet"
                 data-name="Product Info Showcase">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <t t-set="baby_categ" t-value="request.env['product.category'].sudo().search([('name', '=', 'BABY CARE'), ('parent_id', '=', False)], limit=1)"/>
                        <t t-set="baby_products" t-value="request.env['product.template'].sudo().search([('is_published', '=', True), ('categ_id', 'child_of', baby_categ.ids)], order='id asc', limit=4) if baby_categ else []"/>
                        <ul class="nav nav-tabs" role="tablist" id="productShowcaseTabs">
                            <t t-foreach="baby_products" t-as="tab_product">
                                <li class="nav-item" role="presentation">
                                    <button t-attf-class="nav-link pt-3 pb-3 ps-3 pe-3 text-white font-weight-bold #{'active' if tab_product_index == 0 else ''}"
                                            t-attf-id="tab-btn-#{tab_product.id}"
                                            t-attf-data-bs-target="#showcase_tab_#{tab_product.id}"
                                            type="button"
                                            role="tab"
                                            t-att-aria-controls="'showcase_tab_%s' % tab_product.id"
                                            t-att-aria-selected="'true' if tab_product_index == 0 else 'false'"
                                            style="border: none; background: transparent;">
                                        <span class="tab-number"><t t-esc="tab_product_index + 1"/></span>
                                        <br/>
                                        BABY CARE
                                    </button>
                                </li>
                            </t>
                        </ul>
                        <!-- Tab panes -->
                        <div class="tab-content tab-content-babycare">
                            <t t-foreach="baby_products" t-as="product">
                                <div t-attf-id="showcase_tab_#{product.id}" t-attf-class="tab-pane fade #{'show active' if product_index == 0 else ''}" role="tabpanel" t-att-aria-labelledby="'tab-btn-%s' % product.id">
                                    <div class="row">
                                        <div class="col-lg-5 ps-0 pe-0">
                                            <div class="baby-care-cart-section text-center">
                                                <img t-att-src="'/web/image/product.template/%s/image_512' % product.id" class="img-fluid" style="max-height: 250px;"/>
                                            </div>
                                            <h3 class="mt-3">
                                                <b><t t-esc="product.name"/></b>
                                            </h3>
                                            <h4 class="text-muted small">BABY CARE</h4>
                                            <p class="pe-4">
                                                <t t-if="product.description_sale" t-esc="product.description_sale"/>
                                                <t t-else="">Instill good oral hygiene habits from an early age with our fun and effective dental care products. Our toothbrushes, toothpaste, and mouthwash are specially designed for children.</t>
                                            </p>
                                            <div class="container-t-shirt-images mt-2 float-start w-100">
                                                <div class="t-shirt-img">
                                                    <img t-att-src="'/web/image/product.template/%s/image_512' % product.id" style="width: 60px; height: 60px; object-fit: contain; border: 1px solid #eee; padding: 5px;"/>
                                                </div>
                                            </div>
                                            <div class="kids-care-size float-start w-100 pt-3">
                                                <t t-foreach="product.attribute_line_ids" t-as="line">
                                                    <div class="d-flex align-items-center mb-3">
                                                        <span class="me-2"><t t-esc="line.attribute_id.name"/> :</span>
                                                        <div class="sizes d-flex gap-2">
                                                            <t t-foreach="line.value_ids" t-as="value">
                                                                <t t-if="line.attribute_id.display_type == 'color'">
                                                                    <div t-attf-class="rounded-circle border color-attr-select cur-pointer #{'active' if value_index == 0 else ''}"
                                                                         t-attf-style="width: 24px; height: 24px; background-color: #{value.html_color or value.name};"
                                                                         t-att-title="value.name"
                                                                         t-att-data-value-id="value.id"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <div t-attf-class="badge border badge-attr-select cur-pointer px-2 py-1 #{'bg-dark text-white active' if value_index == 0 else 'text-dark'}"
                                                                         t-att-data-value-id="value.id">
                                                                        <t t-esc="value.name"/>
                                                                    </div>
                                                                </t>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </t>
                                                <form action="/shop/cart/update/http" method="POST" class="cart-container w-100 d-block pe-4 position-relative" style="z-index: 10;">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <input type="hidden" name="product_id" t-att-value="product.product_variant_id.id"/>
                                                    <input type="hidden" name="add_qty" value="1"/>
                                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                                        <h2 class="mb-0">
                                                            <b><span t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/></b>
                                                        </h2>
                                                        <button type="submit" class="btn btn-primary px-5 py-2" style="background-color: #F1BD36; border: none; border-radius: 30px; color: #333; font-weight: bold; position: relative; z-index: 11;">
                                                            Add to Cart
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                        <div class="col-lg-7 ps-0 pe-0">
                                            <div class="baby-care-img">
                                                <img class="w-100" src="/theme_kids_care/static/src/images/img-section-baby-care.png" style="max-height: 620px; object-fit: cover;"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <t t-if="not baby_products">
                                <div class="container-fluid tab-pane show active">
                                    <div class="row">
                                        <div class="col-12 text-center pt-5 pb-5">
                                            <h4 class="mb-2">No published Baby Care products found</h4>
                                            <p class="mb-0">Publish at least four products in the BABY CARE category to fill these tabs.</p>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
