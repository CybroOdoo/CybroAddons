<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template to register the "Product Info Showcase" snippet in the website builder's snippet panel -->
    <template id="kidscare_product_info_showcase_snippet" inherit_id="website.snippets" name="Product Info Showcase">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]"
               position="inside">
            <t t-snippet="theme_kids_care.product_info_showcase_snippet"
               string="Product Info Showcase"/>
        </xpath>
    </template>
    <!-- Template for the options of the "Product Info Showcase" snippet -->
    <template id="kidscare_product_info_showcase_options"
              inherit_id="website.snippet_options"
              name="Product Info Showcase Options">
        <xpath expr="." position="inside">
            <div data-js="NavTabs" data-selector=".section-tab">
                <we-button data-add-item=""
                           data-item=".tab-content:first > .tab-pane.active"
                           data-no-preview="true"
                           class="o_we_text_success ms-0"
                           title="Add Tab"
                           aria-label="Add Tab">
                    <i class="fa fa-fw fa-plus"/>
                </we-button>
                <we-button data-remove-item=""
                           data-item=".tab-content:first > .tab-pane.active"
                           data-name="remove_tab_opt"
                           data-no-preview="true"
                           class="o_we_text_danger me-3"
                           title="Remove Tab"
                           aria-label="Remove Tab">
                    <i class="fa fa-fw fa-minus"/>
                </we-button>
            </div>
        </xpath>
    </template>
