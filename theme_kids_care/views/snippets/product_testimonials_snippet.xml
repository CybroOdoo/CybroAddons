<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet - Product Testimonials -->
    <template id="kidscare_product_testimonials_snippet" inherit_id="website.snippets" name="Product Testimonials">
        <xpath expr="//snippets[@id='snippet_content']"
               position="inside">
            <t t-snippet="theme_kids_care.product_testimonials_snippet" group="kids_care" t-thumbnail="/theme_kids_care/static/description/img/review_11709745.png"
               string="Product Testimonials"/>
        </xpath>
    </template>
    <!-- Product Testimonials -->
    <template id="product_testimonials_snippet" name="Product Testimonials">
        <section class="section-testimonials float-left w-100" data-snippet="theme_kids_care.product_testimonials_snippet" data-name="Product Testimonials">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-center">
                        <div class="pt-5 pb-5">
                            <p class="mb-0 text-white">All Products</p>
                            <h3 class="text-white">
                                <b>Testimonials</b>
                            </h3>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="container-slider-testimonials-products mt-3">
                            <div class="owl-carousel owl-theme mt-3 testimonials-carousel">
                                <t t-foreach="[1,2,3,4,5,6]" t-as="i">
                                    <div class="item">
                                        <div class="testimonials-container">
                                            <h3 class="text-white">
                                                <img t-att-src="'/theme_kids_care/static/src/images/testimonials-img.png'"/>
                                                <span>Fantastic</span>
                                            </h3>
                                            <p class="text-white">This collection includes a mini
                                                keyboard, xylophone, tambourine and maracas,
                                            </p>
                                            <div class="container-client-name">
                                                <span style="float: left; padding-right: 10px;">
                                                    <img style="width:100%;"
                                                         t-att-src="'/theme_kids_care/static/src/images/client-img.png'"/>
                                                </span>
                                                <span style="float: left; color: #fff;">
                                                    <b>John Doe</b>
                                                </span>
                                                <br/>
                                                <p class="text-white" style="padding-left:35px;">
                                                    Client
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
