<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template to register the "Product Testimonials" snippet in the website builder's snippet panel -->
    <template id="kidscare_product_testimonials_snippet" inherit_id="website.snippets" name="Product Testimonials">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_kids_care.product_testimonials_snippet" string="Product Testimonials"/>
        </xpath>
    </template>
    <!-- Main template for the "Product Testimonials" snippet, showing a carousel of product testimonials -->
    <template id="product_testimonials_snippet" name="Product Testimonials">
        <section class="section-testimonials float-left w-100" data-snippet="theme_kids_care.product_testimonials_snippet" data-name="Product Testimonials">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-center">
                        <div class="pt-5 pb-3">
                            <p class="mb-0 text-white">All Products</p>
                            <h3 class="text-white">
                                <b>Testimonials</b>
                            </h3>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="container-slider-testimonials-products float-left w-100 mt-3">
                            <div class="second-carousel owl-carousel owl-theme mt-3">
                                <div class="item">
                                    <div class="testimonials-container">
                                        <h3 class="text-white">
                                            <img src="/theme_kids_care/static/src/images/testimonials-img.png"/>
                                            <span>Fantastic</span>
                                        </h3>
                                        <p class="text-white">This collection includes a mini keyboard, xylophone,
                                            tambourine and maracas,</p>
                                        <div class="container-client-name">
                                            <span class="testimonial-client-avatar">
                                                <img src="/theme_kids_care/static/src/images/client-img.png"/>
                                            </span>
                                            <div class="testimonial-client-meta text-white">
                                                <b>John Doe</b>
                                                <p class="mb-0 text-white">Client</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="item">
                                    <div class="testimonials-container">
                                        <h3 class="text-white">
                                            <img src="/theme_kids_care/static/src/images/testimonials-img.png"/>
                                            <span>Amazing</span>
                                        </h3>
                                        <p class="text-white">Lovely toy quality, neat finishing, and packaging that
                                            feels thoughtful for gifting and everyday use.</p>
                                        <div class="container-client-name">
                                            <span class="testimonial-client-avatar">
                                                <img src="/theme_kids_care/static/src/images/client-img.png"/>
                                            </span>
                                            <div class="testimonial-client-meta text-white">
                                                <b>Amelia Ray</b>
                                                <p class="mb-0 text-white">Customer</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="item">
                                    <div class="testimonials-container">
                                        <h3 class="text-white">
                                            <img src="/theme_kids_care/static/src/images/testimonials-img.png"/>
                                            <span>Superb</span>
                                        </h3>
                                        <p class="text-white">The colors, material, and comfort level are exactly what
                                            we wanted for our kids' daily essentials.</p>
                                        <div class="container-client-name">
                                            <span class="testimonial-client-avatar">
                                                <img src="/theme_kids_care/static/src/images/client-img.png"/>
                                            </span>
                                            <div class="testimonial-client-meta text-white">
                                                <b>Daniel Lee</b>
                                                <p class="mb-0 text-white">Parent</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="item">
                                    <div class="testimonials-container">
                                        <h3 class="text-white">
                                            <img src="/theme_kids_care/static/src/images/testimonials-img.png"/>
                                            <span>Wonderful</span>
                                        </h3>
                                        <p class="text-white">A playful collection with practical designs. It works
                                            well for both special occasions and regular wear.</p>
                                        <div class="container-client-name">
                                            <span class="testimonial-client-avatar">
                                                <img src="/theme_kids_care/static/src/images/client-img.png"/>
                                            </span>
                                            <div class="testimonial-client-meta text-white">
                                                <b>Sophia James</b>
                                                <p class="mb-0 text-white">Client</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="item">
                                    <div class="testimonials-container">
                                        <h3 class="text-white">
                                            <img src="/theme_kids_care/static/src/images/testimonials-img.png"/>
                                            <span>Brilliant</span>
                                        </h3>
                                        <p class="text-white">The stitching and fabric quality are strong, and the
                                            pieces still look great after repeated washing and regular use.</p>
                                        <div class="container-client-name">
                                            <span class="testimonial-client-avatar">
                                                <img src="/theme_kids_care/static/src/images/client-img.png"/>
                                            </span>
                                            <div class="testimonial-client-meta text-white">
                                                <b>Olivia Carter</b>
                                                <p class="mb-0 text-white">Customer</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="item">
                                    <div class="testimonials-container">
                                        <h3 class="text-white">
                                            <img src="/theme_kids_care/static/src/images/testimonials-img.png"/>
                                            <span>Excellent</span>
                                        </h3>
                                        <p class="text-white">Fast delivery, clean packaging, and designs that feel
                                            both playful and practical for everyday family shopping.</p>
                                        <div class="container-client-name">
                                            <span class="testimonial-client-avatar">
                                                <img src="/theme_kids_care/static/src/images/client-img.png"/>
                                            </span>
                                            <div class="testimonial-client-meta text-white">
                                                <b>Noah Wilson</b>
                                                <p class="mb-0 text-white">Parent</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
