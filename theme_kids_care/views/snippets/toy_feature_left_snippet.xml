<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template to register the "Toy Feature Left" snippet in the website builder's snippet panel -->
    <template id="kidscare_toy_feature_lefy_snippet" inherit_id="website.snippets" name="Toy Feature Left">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]"
               position="inside">
            <t t-snippet="theme_kids_care.toy_feature_left_snippet"
               string="Toy Feature Left"/>
        </xpath>
    </template>
    <!-- Main template for the "Toy Feature Left" snippet, showing a section with an image and text -->
    <template id="toy_feature_left_snippet" name="Toy Feature Left">
        <section class="section-plastic-kids-standing mt-5 float-left w-100"
                 data-snippet="theme_kids_care.toy_feature_left_snippet"
                 data-name="Toy Feature Left">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3">
                        <img src="/theme_kids_care/static/src/images/img-stand.png"/>
                    </div>
                    <div class="col-lg-9">
                        <h2>Plastic kid standing</h2>
                        <p>BABY CARE</p>
                        <p class="plastic-kids-stand-p">Let your child's creativity and engineering skills shine
                            with our Construction Vehicle Set. This set includes a range of vehicles, such as
                            bulldozers, cranes, and dump trucks, allowing your little builder to create and
                            transport their own construction sites. Watch as they develop fine motor skills and
                            learn about different types of machinery.
                        </p>
                        <div class="item-view-price mt-5">
                            <button class="float-left btn-add-to-cart pr-4 pl-4 pt-2 pb-2"
                                    style="position: static;">Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
