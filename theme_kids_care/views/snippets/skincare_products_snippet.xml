<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet - Skin Care Products -->
    <template id="kidscare_skincare_products_snippet" inherit_id="website.snippets" name="Skin Care Products">
        <xpath expr="//snippets[@id='snippet_content']"
               position="inside">
            <t t-snippet="theme_kids_care.skincare_products_snippet" group="kids_care" t-thumbnail="/theme_kids_care/static/description/img/product.png"
               string="Skin Care Products"/>
        </xpath>
    </template>
<!--    Skin care products-->
    <template id="skincare_products_snippet" name="Skin Care Products">
        <section class="section-skincare-products mt-5 float-left w-100 py-5 bg-white"
                 data-snippet="theme_kids_care.skincare_products_snippet"
                 data-name="Skin Care Products">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 pl-0">
                        <h3 class="h3-skincare-products">
                            <p class="mb-0 small">All product</p>
                            <b>SKIN CARE PRODUCTS</b>
                        </h3>
                    </div>
                    <div class="col-lg-6">
                        <div class="w-100 float-left text-end container-btn">
                            <button class="btn btn-outline-dark" style="border: 1px solid #000; border-radius: 10px; padding: 5px 20px;">
                                <a href="/shop" style="color: inherit; text-decoration: none;">Show More</a>
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="row">
                            <div class="owl-carousel owl-theme mt-3">
                                <t t-set="baby_categ" t-value="request.env['product.category'].sudo().search([('name', '=', 'BABY CARE')], limit=1)"/>
                                <t t-set="products"
                                   t-value="request.env['product.template'].sudo().search([('is_published', '=', True), ('categ_id', 'child_of', baby_categ.ids)], limit=8) if baby_categ else request.env['product.template'].sudo().search([('is_published', '=', True)], limit=8)"/>
                                <t t-foreach="products" t-as="product">
                                     <div class="item">
                                         <div class="card border-0 mr-4 p-4" style="background-color: #f8f9fa; border-radius: 10px; min-height: 280px;">
                                             <div class="d-flex justify-content-between align-items-center">
                                                 <h3 class="text-dark mb-0 h5">
                                                     <b><t t-esc="product.name"/></b>
                                                 </h3>
                                                 <span class="span-star" style="color: #F1BD36; font-size: 16px;">&#9734; &#9734; &#9734; &#9734; &#9734;</span>
                                             </div>
                                             <p class="text-muted small mb-3"><t t-esc="product.categ_id.name"/></p>
                                             <div class="d-flex justify-content-start align-items-center mt-auto pb-1">
                                                 <div class="product-info-right position-relative me-3" style="width: 100px; height: 100px;">
                                                     <img t-att-src="'/web/image/product.template/%s/image_256' % product.id"
                                                          class="img-fluid"
                                                          style="max-height: 100px; object-fit: contain; position: absolute; bottom: 0; left: 0;"/>
                                                 </div>
                                                 <div class="product-info-left">
                                                     <h2 class="text-dark h4 mb-0">
                                                         <b><span t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/></b>
                                                     </h2>
                                                 </div>
                                              </div>
                                              <div class="d-flex justify-content-start mt-3">
                                                 <a t-attf-href="/shop/cart/update/http?product_id=#{product.product_variant_id.id}"
                                                    class="btn btn-primary px-4 py-2" 
                                                    style="background-color: #F1BD36; border: none; border-radius: 20px; color: #fff; font-weight: bold; font-size: 14px;">
                                                     Add to Cart
                                                 </a>
                                             </div>
                                         </div>
                                     </div>
                                 </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
