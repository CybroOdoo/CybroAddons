<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet - All Products -->
    <template id="kidscare_all_products_snippet" inherit_id="website.snippets" name="All Products">
        <xpath expr="//snippets[@id='snippet_content']"
               position="inside">
            <t t-snippet="theme_kids_care.all_products_snippet" group="kids_care" t-thumbnail="/theme_kids_care/static/description/img/product.png"
               string="All Products"/>
        </xpath>
    </template>
<!--    All Products-->
    <template id="all_products_snippet" name="All Products">
        <section class="section-all-the-snekers mt-5 float-left w-100"
                 data-snippet="theme_kids_care.all_products_snippet"
                 data-name="All Products">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="section-title-wrap mb-4">
                            <p class="mb-0 poppins-medium" style="font-size: 14px; color: #555;">All product</p>
                            <h2 class="poppins-bold text-dark" style="font-size: 32px; letter-spacing: -0.5px;">All the Sneakers</h2>
                        </div>
                    </div>
                    <div class="col-lg-6 text-end">
                        <div class="container-btn pt-4">
                            <a href="/shop" class="btn btn-outline-dark px-4 py-2" style="border: 1.5px solid #000; border-radius: 12px; font-weight: 600; font-size: 13px; text-decoration: none; color: #000;">
                                Show More
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="row">
                            <div class="owl-carousel owl-theme mt-3 all-products-carousel">
                                <t t-set="baby_categ" t-value="request.env['product.category'].sudo().search([('name', '=', 'BABY CARE')], limit=1)"/>
                                <t t-set="products"
                                   t-value="request.env['product.template'].sudo().search([('is_published', '=', True), ('categ_id', 'child_of', baby_categ.ids)]) if baby_categ else request.env['product.template'].sudo().search([('is_published', '=', True)], limit=8)"/>
                                <t t-foreach="products" t-as="product">
                                      <div class="item">
                                          <div class="card border-0 mr-4 p-4 position-relative" style="background-color: #F8F8F8; border-radius: 12px; min-height: 280px;">
                                              <div class="row g-0">
                                                  <div class="col-8 pe-2">
                                                      <div class="d-flex justify-content-between align-items-center mb-1">
                                                          <h3 class="text-dark mb-0 h4 text-truncate poppins-bold" style="max-width: 160px; font-weight: 700;">
                                                              <t t-esc="product.name"/>
                                                          </h3>
                                                          <span class="span-star" style="color: #F1BD36; font-size: 12px; opacity: 0.5;">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                                                      </div>
                                                      <p class="text-muted small mb-3 text-uppercase poppins-medium" style="font-size: 11px; letter-spacing: 0.8px; color: #888 !important;"><t t-esc="product.categ_id.name"/> CATEGORY</p>
                                                      
                                                      <div class="product-attributes mt-3 small">
                                                          <p class="mb-2 d-flex align-items-center" style="font-size: 12px; color: #444;">Size : 
                                                              <span class="badge border text-dark ms-2 bg-white" style="border-radius: 4px; padding: 5px 10px; font-weight: 600; border-color: #333 !important;">18</span>
                                                              <span class="badge border text-dark ms-1 bg-white" style="border-radius: 4px; padding: 5px 10px; font-weight: 600; border-color: #ddd !important; opacity: 0.6;">24</span>
                                                          </p>
                                                          <p class="mb-4 d-flex align-items-center" style="font-size: 12px; color: #444;">Color : 
                                                              <span class="rounded-circle d-inline-block border ms-2" style="width: 16px; height: 16px; background: #fff; border-color: #ddd !important;"/>
                                                              <span class="rounded-circle d-inline-block border ms-1" style="width: 16px; height: 16px; background: #eee; border-color: #ddd !important;"/>
                                                          </p>
                                                      </div>
                                                      <div class="price-wrap mt-2">
                                                          <h2 class="text-dark poppins-bold" style="font-size: 48px; font-weight: 800; margin-bottom: 0;">
                                                              $<t t-esc="'%.0f' % product.list_price"/>
                                                          </h2>
                                                      </div>
                                                  </div>
                                                  <div class="col-4 text-center d-flex align-items-center justify-content-center">
                                                       <img t-att-src="image_data_uri(product.image_128)" class="img-fluid" t-att-alt="product.name" style="max-height: 110px; object-fit: contain;"/>
                                                  </div>
                                              </div>
                                              <div class="position-absolute" style="bottom: 12px; right: 12px;">
                                                  <a t-attf-href="/shop/cart/update/http?product_id=#{product.product_variant_id.id}"
                                                     class="btn btn-primary px-4 py-2" 
                                                     style="background-color: #F1BD36; border: none; border-radius: 25px; color: #fff; font-weight: 700; font-size: 13px; box-shadow: 0 4px 10px rgba(241, 189, 54, 0.4);">
                                                      Add to Cart
                                                  </a>
                                              </div>
                                          </div>
                                      </div>
                                 </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
