<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet - Product Spotlight -->
    <template id="kidscare_product_spotlight_snippet" inherit_id="website.snippets" name="Product Spotlight">
        <xpath expr="//snippets[@id='snippet_content']"
               position="inside">
            <t t-snippet="theme_kids_care.product_spotlight_snippet" group="kids_care" t-thumbnail="/theme_kids_care/static/description/img/spotlight_5058340.png"
               string="Product Spotlight"/>
        </xpath>
    </template>
    <!-- Product Spotlight -->
    <template id="product_spotlight_snippet" name="Product Spotlight">
        <section class="section-banner w-100 float-left" data-snippet="theme_kids_care.product_spotlight_snippet"
                 data-name="Product Spotlight">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div id="demo" class="carousel  slide" data-bs-ride="carousel">
                            <!-- Indicators -->
                            <ul class="carousel-indicators">
                                <li data-bs-target="#demo" data-bs-slide-to="0" class="active"/>
                                <li data-bs-target="#demo" data-bs-slide-to="1"/>
                                <li data-bs-target="#demo" data-bs-slide-to="2"/>
                            </ul>
                            <!-- The slideshow -->
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <div class="row">
                                        <div class="col-lg-5 text-center">
                                            <img src="/theme_kids_care/static/src/images/chair.png"/>
                                        </div>
                                        <div class="col-lg-7">
                                            <div class="banner-content">
                                                <h3>
                                                    <b>BOOSTER CHAIR</b>
                                                </h3>
                                                <h5>BABY CARE CATEGORY</h5>
                                                <p>Nourish and protect your baby's delicate skin with our
                                                    gentle and
                                                    hypoallergenic skincare products
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="carousel-item">
                                    <div class="row">
                                        <div class="col-lg-5 banner-img text-center">
                                            <img src="/theme_kids_care/static/src/images/chair.png"/>
                                        </div>
                                        <div class="col-lg-7">
                                            <div class="banner-content">
                                                <h3>
                                                    <b>BOOSTER CHAIR</b>
                                                </h3>
                                                <h5>BABY CARE CATEGORY</h5>
                                                <p>Nourish and protect your baby's delicate skin with our
                                                    gentle and
                                                    hypoallergenic skincare products
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="carousel-item">
                                    <div class="row">
                                        <div class="col-lg-5 banner-img text-center">
                                            <img src="/theme_kids_care/static/src/images/chair.png"/>
                                        </div>
                                        <div class="col-lg-7">
                                            <div class="banner-content">
                                                <h3>
                                                    <b>BOOSTER CHAIR</b>
                                                </h3>
                                                <h5>BABY CARE CATEGORY</h5>
                                                <p>Nourish and protect your baby's delicate skin with our
                                                    gentle and
                                                    hypoallergenic skincare products
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Left and right controls -->
                            <a class="carousel-control-prev" href="#demo" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"/>
                            </a>
                            <a class="carousel-control-next" href="#demo" data-bs-slide="next">
                                <span class="carousel-control-next-icon"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
