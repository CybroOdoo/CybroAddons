<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Snippet Groups -->
    <template id="snippets" inherit_id="website.snippets">
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t snippet-group="kids_care" t-snippet="website.s_snippet_group" string="Kids Care"
               t-thumbnail="/theme_kids_care/static/src/images/snippets/snippet_group.svg"/>
        </xpath>
    </template>
</odoo>
