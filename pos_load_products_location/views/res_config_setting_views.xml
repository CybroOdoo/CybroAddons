<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Inherit the res config settings form view  -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.load.products.location</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='update_quantities_stock_setting']" position="after">
                 <setting id="location_need_to_load" string="Stock Location"  help="Select the stock location to load only the products from that specific location.">
                     <field name="source_loc_id" colspan="4"/>
                 </setting>
            </xpath>
        </field>
    </record>
</odoo>
