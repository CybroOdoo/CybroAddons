<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Redesigned Booked Orders Screen -->
    <t t-name="pos_book_order.BookedOrdersScreen" owl="1">
        <div class="booked-orders-screen screen">

            <!-- Header Section -->
            <div class="screen-header">
                <div class="header-left">
                    <div class="button back" t-on-click="back" t-if="!props.new_order">
                        <i class="fa fa-arrow-left"/> Back
                    </div>
                    <div class="button new-order" t-if="props.new_order" t-on-click="orderDone">
                        <i class="fa fa-plus-circle"/> New Order
                    </div>
                </div>
                <div class="header-right">
                    <h2><i class="fa fa-clipboard-list"/> Booked Orders</h2>
                </div>
            </div>

            <!-- Orders List -->
            <div class="orders-container">
                <t t-foreach="props.data" t-as="order" t-key="order.id">
                    <div class="order-card">
                        <div class="order-card-header">
                            <span class="order-ref"><i class="fa fa-hashtag"/> <t t-esc="order.name"/></span>
                            <span class="order-total">$<t t-esc="order.total"/></span>
                        </div>
                        <div class="order-card-body">
                            <div class="order-row">
                                <span class="label"><i class="fa fa-user"/> Customer:</span>
                                <span class="value"><t t-esc="order.partner_name"/></span>
                            </div>
                            <div class="order-row">
                                <span class="label"><i class="fa fa-phone"/> Contact:</span>
                                <span class="value"><t t-esc="order.phone"/></span>
                            </div>
                            <div class="order-row">
                                <span class="label"><i class="fa fa-calendar"/> Order Date:</span>
                                <span class="value"><t t-esc="order.date"/></span>
                            </div>
                            <div class="order-row" t-if="order.pickup">
                                <span class="label"><i class="fa fa-box"/> Pickup:</span>
                                <span class="value"><t t-esc="order.pickup"/></span>
                            </div>
                            <div class="order-row" t-if="order.deliver">
                                <span class="label"><i class="fa fa-truck"/> Delivery:</span>
                                <span class="value"><t t-esc="order.deliver"/></span>
                            </div>
                            <div class="order-row">
                                <span class="label"><i class="fa fa-map-marker"/> Address:</span>
                                <span class="value"><t t-esc="order.address"/></span>
                            </div>
                        </div>
                        <div class="order-card-footer">
                            <button class="btn-confirm" t-on-click="() => this._Confirm(order)">
                                <i class="fa fa-check-circle"/> Confirm
                            </button>
                        </div>
                    </div>
                </t>

                <!-- Empty State -->
                <t t-if="props.data.length == 0">
                    <div class="empty-order-list">
                        <i class="fa fa-shopping-cart"/>
                        <h2>No booked orders found</h2>
                        <p>New orders will appear here.</p>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
