<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- This button for seeing booked orders-->
    <t t-name="pos_book_order.BookedOrdersButton" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <div class="btn btn-secondary btn-lg py-5" t-on-click="() => this.getBookingOrders()">
                Booked Orders
            </div>
        </xpath>
    </t>

    <!-- This button for booking orders-->
    <t t-name="pos_book_order.BookOrderButton" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <button class="btn btn-secondary btn-lg py-5" t-on-click="() => this.bookOrder()">
                <i class='fa fa-book'/>
                <span class="label">Booking</span>
            </button>
        </xpath>
    </t>
</templates>
