  </record>
  <record id="training_session_1e616aef-76ec-4260-81e7-a994c9376af5" model="ir.actions.act_window" context="{'studio': True}">
    <field name="context">{'search_default_x_studio_enrollment': active_id,'default_x_studio_enrollment': active_id}</field>
    <field name="domain">[('x_studio_enrollment', '=', active_id)]</field>
    <field name="name">Training Session</field>
    <field name="res_model">x_training_sessions</field>
  </record>
  <record id="invoice_8d1999e4-bebc-4619-925b-bb3438678031" model="ir.actions.act_window" context="{'studio': True}">
    <field name="context">{'search_default_x_studio_enrollment_id': active_id,'default_x_studio_enrollment_id': active_id}</field>
    <field name="domain">[('x_studio_enrollment_id', '=', active_id)]</field>
    <field name="name">Invoice</field>
    <field name="res_model">account.move</field>
  </record>
  <record id="action_members_view" model="ir.actions.act_window" context="{'studio': True}">
    <field name="name">Members</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                    No members found.
                </p>
                <p>
                    Create a new member contact here.
                </p>
            ]]></field>
  </record>
  <record id="action_members_view_kanban" model="ir.actions.act_window.view" context="{'studio': True}">
    <field name="sequence" eval="1"/>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="base.res_partner_kanban_view"/>
    <field name="act_window_id" ref="action_members_view"/>
  </record>
  <record id="action_members_view_list" model="ir.actions.act_window.view" context="{'studio': True}">
    <field name="sequence" eval="2"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="base.view_partner_tree"/>
    <field name="act_window_id" ref="action_members_view"/>
  </record>
  <record id="action_enrollment_from_plan" model="ir.actions.act_window" context="{'studio': True}">
    <field name="name">Enrollments</field>
    <field name="res_model">x_enrollment</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('x_studio_membership_plan', '=', active_id)]</field>
    <field name="context">{'default_x_studio_membership_plan': active_id}</field>
  </record>
  <record id="action_enrollment_from_partner" model="ir.actions.act_window" context="{'studio': True}">
    <field name="name">Enrollments</field>
    <field name="res_model">x_enrollment</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('x_studio_member', '=', active_id)]</field>
    <field name="context">{'default_x_studio_member': active_id}</field>
  </record>
  <record id="action_sessions_from_partner" model="ir.actions.act_window" context="{'studio': True}">
    <field name="name">Sessions</field>
    <field name="res_model">x_training_sessions</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('x_studio_member', '=', active_id)]</field>
    <field name="context">{'default_x_studio_member': active_id}</field>
  </record>
</odoo>
