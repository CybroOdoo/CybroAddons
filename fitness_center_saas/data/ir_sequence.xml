<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Fitness Center Management SaaS Module
  File: ir_sequence.xml
  Description: Registers sequence generator for unique membership enrollment numbering (ENR/XXXXX).
-->

<odoo>
    <data noupdate="1">
        <record id="sequence_enrollment" model="ir.sequence">
            <field name="name">Enrollment Sequence</field>
            <field name="code">x_enrollment</field>
            <field name="prefix">ENR/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
