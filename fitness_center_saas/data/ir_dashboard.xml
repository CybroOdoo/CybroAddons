<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Fitness Center Management SaaS Module
  File: ir_dashboard.xml
  Description: Declares standard/legacy reporting actions and registers the main OWL client dashboard action.
-->

<odoo>
    <!-- Dashboard sub-view actions (kept for compatibility) -->
    <record id="action_dashboard_enrollments_graph" model="ir.actions.act_window">
        <field name="name">Active Enrollments by Plan</field>
        <field name="res_model">x_enrollment</field>
        <field name="view_mode">graph</field>
        <field name="domain">[('x_studio_status', '=', 'Active')]</field>
    </record>

    <record id="action_dashboard_sessions_list" model="ir.actions.act_window">
        <field name="name">Today's Scheduled Sessions</field>
        <field name="res_model">x_training_sessions</field>
        <field name="view_mode">list</field>
        <field name="domain">[('x_studio_date', '=', context_today())]</field>
    </record>

    <record id="action_dashboard_membership_pivot" model="ir.actions.act_window">
        <field name="name">Membership Plans Revenue Analytics</field>
        <field name="res_model">x_membership_plans</field>
        <field name="view_mode">pivot</field>
    </record>

    <!-- Main Dashboard Client Action — Modern OWL Component -->
    <!-- Uses a new XML ID to avoid conflict with the legacy ir.actions.act_window record -->
    <record id="action_fitness_center_dashboard_client" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">fitness_center_saas.fitness_dashboard</field>
    </record>
</odoo>
