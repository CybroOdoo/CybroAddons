<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Fitness Center Management SaaS Module
  File: mail_template.xml
  Description: Configures email templates for session scheduling notifications and membership updates.
-->

<odoo>
    <record id="email_template_enrollment_activation_member" model="mail.template">
        <field name="name">Enrollment: Member Activation</field>
        <field name="model_id" ref="enrollment_cb27ce50-8ceb-4ad5-b5fe-a9c9536f0399"/>
        <field name="subject">Your Enrollment {{ object.x_name }} is now Active!</field>
        <field name="email_to">{{ object.x_studio_member.email }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333333; margin: 0px; padding: 0px;">
                <p>Dear <strong><t t-out="object.x_studio_member.name"/></strong>,</p>
                <p>We are excited to inform you that your enrollment <strong><t t-out="object.x_name"/></strong> is now <strong>Active</strong>!</p>
                <p><strong>Membership Plan:</strong> <t t-out="object.x_studio_membership_plan.x_name or 'N/A'"/><br/>
                <strong>Start Date:</strong> <t t-out="object.x_studio_start_date or 'N/A'"/><br/>
                <strong>End Date:</strong> <t t-out="object.x_studio_end_date or 'N/A'"/></p>
                <p>Thank you for joining our Fitness Center. We look forward to seeing you reach your fitness goals!</p>
                <p>Best regards,<br/>Fitness Center Team</p>
            </div>
        </field>
    </record>

    <record id="email_template_enrollment_activation_trainer" model="mail.template">
        <field name="name">Enrollment: Trainer Activation Notification</field>
        <field name="model_id" ref="enrollment_cb27ce50-8ceb-4ad5-b5fe-a9c9536f0399"/>
        <field name="subject">New Assigned Member: {{ object.x_studio_member.name or object.x_name }}</field>
        <field name="email_to">{{ object.x_studio_trainer.work_email }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333333; margin: 0px; padding: 0px;">
                <p>Hello <strong><t t-out="object.x_studio_trainer.name"/></strong>,</p>
                <p>This is to notify you that a new enrollment <strong><t t-out="object.x_name"/></strong> has been activated under your supervision.</p>
                <p><strong>Member Name:</strong> <t t-out="object.x_studio_member.name or 'N/A'"/><br/>
                <strong>Membership Plan:</strong> <t t-out="object.x_studio_membership_plan.x_name or 'N/A'"/><br/>
                <strong>Start Date:</strong> <t t-out="object.x_studio_start_date or 'N/A'"/><br/>
                <strong>End Date:</strong> <t t-out="object.x_studio_end_date or 'N/A'"/></p>
                <p>Please connect with the member to schedule their training sessions.</p>
                <p>Best regards,<br/>Fitness Center Management</p>
            </div>
        </field>
    </record>
</odoo>
