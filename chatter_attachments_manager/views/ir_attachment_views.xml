<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attachment Form View -->
    <record id="ir_attachment_view_form_inherit_chatter_attachments_manager" model="ir.ui.view">
        <field name="name">ir.attachment.view.form.inherit.chatter.attachments.manager</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="priority" eval="25"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="tag_ids" string="Tags" widget="many2many_tags"
                       options="{'color_field': 'color', 'no_create_edit': True}"/>
                <field name="local_url" string="Location URL"/>
            </xpath>
        </field>
    </record>
    <!-- Search View -->
    <record id="ir_attachment_view_search_inherit_chatter_attachments_manager" model="ir.ui.view">
        <field name="name">ir.attachment.view.search.inherit.chatter.attachments.manager</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='creation_month']" position="after">
                <filter string="Tags" name="attach_tags" domain="[]" context="{'group_by':'tag_ids'}"/>
            </xpath>
            <xpath expr="//field[@name='type']" position="after">
                <field name="tag_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
