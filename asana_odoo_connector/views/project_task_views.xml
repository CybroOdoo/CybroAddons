<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited form view of project.task -->
    <record id="project_task_view_form_inherit_asana_odoo_connector"
            model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.asana.odoo.connector</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="asana" string="Asana">
                    <group>
                        <group>
                            <field name="asana_gid"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
