<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited form view of res.config.settings -->
    <record id="res_config_settings_view_form_inherit_asana_odoo_connector"
            model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.asana.odoo.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Asana" string="Asana"
                     name="asana_odoo_connector">
                    <block title="Asana Settings" id="asana_settings">
                        <setting id="workspace_gid_setting"
                                 string="Workspace ID"
                                 help="ID of the workspace in Asana">
                            <field name="workspace_gid"/>
                        </setting>
                        <setting id="app_token_setting" string="App Token"
                                 help="Personal Access Token of the corresponding Asana account">
                            <field name="app_token" password="True"/>
                            <div class="mt8">
                                <button class="btn btn-primary" type="object"
                                        name="action_test_asana"
                                        string="Test Connection"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Asana Import Settings"
                           id="asana_import_settings">
                        <setting id="import_projects_setting"
                                 string="Import Projects"
                                 help="Import projects and tasks from Asana to Odoo">
                            <button class="btn btn-primary" type="object"
                                    name="action_import_projects"
                                    string="Import Projects and Tasks"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
