<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited form view of project.project -->
    <record id="project_project_view_form_inherit_asana_odoo_connector"
            model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.asana.odoo.connector</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="asana" string="Asana">
                    <group>
                        <group>
                            <field name="asana_gid"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
