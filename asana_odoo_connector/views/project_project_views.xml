<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--This is the inherited form view of the project project  -->
    <record id="edit_project" model="ir.ui.view">
        <field name="name">
            project.project.view.form.inherit.asana.odoo.connector
        </field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Asana">
                    <group>
                        <group>
                            <field name="asana_gid"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!--    Tree View of project-->
    <record id="view_project_project_tree" model="ir.ui.view">
        <field name="name">project.project.tree</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <tree string="Projects">
                <field name="name"/>
                <field name="user_id"/>
                <field name="date_start"/>
            </tree>
        </field>
    </record>
    <!--    Action for project Views-->
    <record id="project.open_view_project_all" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">project.project</field>
        <field name="domain">[]</field>
        <field name="view_mode">kanban,form,tree</field>
        <field name="view_id" ref="project.view_project_kanban"/>
        <field name="search_view_id" ref="project.view_project_project_filter"/>
        <field name="view_ids"
               eval="[(5, 0, 0),(0, 0, {'view_mode': 'kanban',
                                   'view_id':  ref('project.view_project_kanban')}),(0, 0, {'view_mode': 'tree',
                                   'view_id':  ref('view_project_project_tree')}),]"/>
        <field name="target">main</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No projects found. Let's create one!
            </p>
            <p>
                Projects regroup tasks on the same topic, and each has its
                dashboard.
            </p>
        </field>
    </record>
    <!--Action for project with all stage-->
    <record id="project.open_view_project_all_group_stage"
            model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">project.project</field>
        <field name="domain">[]</field>
        <field name="view_mode">kanban,form,tree</field>
        <field name="view_id" ref="project.view_project_kanban"/>
        <field name="search_view_id" ref="project.view_project_project_filter"/>
        <field name="target">main</field>
        <field name="context">{'search_default_groupby_stage': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No projects found. Let's create one!
            </p>
            <p>
                Projects regroup tasks on the same topic, and each has its
                dashboard.
            </p>
        </field>
    </record>
</odoo>
