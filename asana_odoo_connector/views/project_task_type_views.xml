<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited form view of project.task.type -->
    <record id="project_task_type_view_form_inherit_asana_odoo_connector"
            model="ir.ui.view">
        <field name="name">project.task.type.view.form.inherit.asana.odoo.connector</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="asana" string="Asana">
                        <group>
                            <group>
                                <field name="asana_gid"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
