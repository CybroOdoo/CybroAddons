<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server action to export projects from Odoo to Asana -->
    <record id="action_export_projects_asana" model="ir.actions.server">
        <field name="name">Export to Asana</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="binding_model_id" ref="model_project_project"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('project.group_project_manager'))]"/>
        <field name="code">
            action = records.action_export_to_asana()
        </field>
    </record>
</odoo>
