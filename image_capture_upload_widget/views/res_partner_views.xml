<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_capture_image" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.capture.image</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="widget">capture_image</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_inherit_capture_image" model="ir.ui.view">
        <field name="name">res.users.form.inherit.capture.image</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="widget">capture_image</attribute>
            </xpath>
        </field>
    </record>
</odoo>
