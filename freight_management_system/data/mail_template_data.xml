<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Freight Order: Submitted Email Template -->
        <record id="mail_template_freight_order_submitted" model="mail.template">
            <field name="name">Freight Order: Submitted</field>
            <field name="model_id" ref="freight_management_system.model_freight_order"/>
            <field name="subject">Freight Order {{ object.name }} has been Submitted</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="description">Sent to stakeholders when freight order is submitted</field>
            <field name="email_layout_xmlid" eval="False"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 10px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #111827 !important; font-size: 13px; line-height: 1.6; background-color: #ffffff;">
    <p style="margin: 0px; padding: 0px; color: #111827 !important;">
        Hello,
        <br/><br/>
        The Freight Order <strong style="color: #000000 !important;" t-out="object.name">FO/0001</strong> has been successfully Submitted.
        <br/><br/>
        <strong style="color: #000000 !important;">Shipment Details:</strong>
        <ul style="margin: 8px 0; padding-left: 20px; color: #111827 !important;">
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Shipper:</strong> <t t-out="object.shipper_id.name or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Consignee:</strong> <t t-out="object.consignee_id.name or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Transport Mode:</strong> <t t-out="object.transport_type and object.transport_type.capitalize() or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Loading Port:</strong> <t t-out="object.loading_port_id.name or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Discharging Port:</strong> <t t-out="object.discharging_port_id.name or 'N/A'"/></li>
            <t t-if="object.expected_date">
                <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Expected Date:</strong> <t t-out="object.expected_date"/></li>
            </t>
        </ul>
        <br/>
        Please review the order and proceed with the necessary custom clearance and shipment arrangements.
        <br/><br/>
        Best regards,<br/>
        <strong style="color: #000000 !important;" t-out="object.company_id.name or ''"/>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Freight Order: Confirmed Email Template -->
        <record id="mail_template_freight_order_confirmed" model="mail.template">
            <field name="name">Freight Order: Confirmed</field>
            <field name="model_id" ref="freight_management_system.model_freight_order"/>
            <field name="subject">Freight Order {{ object.name }} is Confirmed</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="description">Sent to stakeholders when freight order is confirmed</field>
            <field name="email_layout_xmlid" eval="False"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 10px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #111827 !important; font-size: 13px; line-height: 1.6; background-color: #ffffff;">
    <p style="margin: 0px; padding: 0px; color: #111827 !important;">
        Hello,
        <br/><br/>
        The Freight Order <strong style="color: #000000 !important;" t-out="object.name">FO/0001</strong> has been Confirmed. All necessary clearances have been verified and containers have been reserved.
        <br/><br/>
        <strong style="color: #000000 !important;">Order Summary:</strong>
        <ul style="margin: 8px 0; padding-left: 20px; color: #111827 !important;">
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Shipper:</strong> <t t-out="object.shipper_id.name or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Consignee:</strong> <t t-out="object.consignee_id.name or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Loading Port:</strong> <t t-out="object.loading_port_id.name or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Discharging Port:</strong> <t t-out="object.discharging_port_id.name or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Total Weight:</strong> <t t-out="object.total_weight"/> kg</li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Total Volume:</strong> <t t-out="object.total_volume"/> m³</li>
        </ul>
        <br/>
        Shipment operations can now proceed according to schedule.
        <br/><br/>
        Best regards,<br/>
        <strong style="color: #000000 !important;" t-out="object.company_id.name or ''"/>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Freight Order: Done Email Template -->
        <record id="mail_template_freight_order_done" model="mail.template">
            <field name="name">Freight Order: Completed</field>
            <field name="model_id" ref="freight_management_system.model_freight_order"/>
            <field name="subject">Freight Order {{ object.name }} is Completed</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="description">Sent to stakeholders when freight order is completed</field>
            <field name="email_layout_xmlid" eval="False"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 10px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #111827 !important; font-size: 13px; line-height: 1.6; background-color: #ffffff;">
    <p style="margin: 0px; padding: 0px; color: #111827 !important;">
        Hello,
        <br/><br/>
        We are pleased to inform you that Freight Order <strong style="color: #000000 !important;" t-out="object.name">FO/0001</strong> has been successfully Completed and Delivered
        <br/><br/>
        Thank you for your business.
        <br/><br/>
        Best regards,<br/>
        <strong style="color: #000000 !important;" t-out="object.company_id.name or ''"/>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Custom Clearance: Confirmed Email Template -->
        <record id="mail_template_custom_clearance_confirmed" model="mail.template">
            <field name="name">Custom Clearance: Confirmed</field>
            <field name="model_id" ref="freight_management_system.model_custom_clearance"/>
            <field name="subject">Custom Clearance for {{ object.freight_id.name or object.name }} is Confirmed</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="description">Sent to agent when custom clearance is confirmed</field>
            <field name="email_layout_xmlid" eval="False"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 10px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #111827 !important; font-size: 13px; line-height: 1.6; background-color: #ffffff;">
    <p style="margin: 0px; padding: 0px; color: #111827 !important;">
        Dear <t t-out="object.agent_id.name or 'Agent'">Agent</t>,
        <br/><br/>
        The Custom Clearance <strong style="color: #000000 !important;" t-out="object.name">CC - 0001</strong> for Freight Order <strong style="color: #000000 !important;" t-out="object.freight_id.name or ''">FO/0001</strong> has been Confirmed.
        <br/><br/>
        <strong style="color: #000000 !important;">Clearance Details:</strong>
        <ul style="margin: 8px 0; padding-left: 20px; color: #111827 !important;">
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Freight Order:</strong> <t t-out="object.freight_id.name or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Date:</strong> <t t-out="object.date or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Loading Port:</strong> <t t-out="object.loading_port_id.name or 'N/A'"/></li>
            <li style="color: #111827 !important;"><strong style="color: #000000 !important;">Discharging Port:</strong> <t t-out="object.discharging_port_id.name or 'N/A'"/></li>
        </ul>
        <br/>
        All attached clearance documents have been approved.
        <br/><br/>
        Best regards,<br/>
        <strong style="color: #000000 !important;" t-out="object.company_id.name or ''"/>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
