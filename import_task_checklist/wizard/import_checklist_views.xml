<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    View for importing checklists-->
    <record id="import_task_checklist_view_form" model="ir.ui.view">
        <field name="name">import.task.checklist.view.form</field>
        <field name="model">import.task.checklist</field>
        <field name="arch" type="xml">
            <form string="Import Task Checklist">
                <sheet>
                    <group>
                        <group>
                            <field name="file_type" widget="radio"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="file_content" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <div class="mt-3">
                        <p class="text-muted mb-2">
                            <strong>Sample File Format:</strong> (Each row represents a checklist, and columns after Company are added as checklist items in order)
                        </p>
                        <table class="table table-sm table-bordered text-center" style="font-size: 13px;">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Company</th>
                                    <th>Checklist 1</th>
                                    <th>Checklist 2</th>
                                    <th>Checklist 3</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Project Kickoff</td>
                                    <td>Initial project setup</td>
                                    <td>My Company</td>
                                    <td>Requirement Analysis</td>
                                    <td>Environment Setup</td>
                                    <td>Kickoff Meeting</td>
                                </tr>
                                <tr>
                                    <td>Module Release</td>
                                    <td>Deployment checks</td>
                                    <td>My Company</td>
                                    <td>Code Review</td>
                                    <td>Run Test Cases</td>
                                    <td>Release Notes</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </sheet>
                <footer>
                    <button name="action_import_task_checklist_xlsx"
                            string="Import"
                            type="object"
                            class="btn-primary"
                            invisible="file_type == 'csv'"/>
                    <button name="action_import_task_checklist_csv"
                            string="Import"
                            type="object"
                            class="btn-primary"
                            invisible="file_type == 'xls'"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--    Action for the wizard-->
    <record id="import_task_checklist_action" model="ir.actions.act_window">
        <field name="name">Import Task Checklist</field>
        <field name="res_model">import.task.checklist</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!--    Menu item for importing task checklist-->
    <menuitem id="import_task_checklist_menu" name="Import Task Checklist"
              parent="projects_task_checklists.project_checklist_root"
              action="import_task_checklist_action"/>
</odoo>
