<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--To add a field in task checklist-->
    <record id="view_task_checklist_list_inherit_import_task_checklist" model="ir.ui.view">
        <field name="name">
            task.checklist.view.list.inherit.import.task.checklist
        </field>
        <field name="model">task.checklist</field>
        <field name="inherit_id"
               ref="projects_task_checklists.task_checklist_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='name']" position="after">
                <field name="description"/>
                <field name="company_id"/>
            </xpath>
        </field>
    </record>
</odoo>
