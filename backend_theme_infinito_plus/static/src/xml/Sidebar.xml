<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="backend_theme_infinito_plus.AdvancedFeatures">
<div class="sidebar_simple_editor"><Sidebar/></div>
</t>
    <t t-name="backend_theme_infinito_plus.Sidebar">
<div id="theme_editor_sidebar" class="main_sidebar">
<div class="sidebar_wrapper">
<div class="sidebar_content" t-on-change="(ev) => this.onToggleChange(ev)">

<div class="button_properties">
<p><a class="btn btn-primary_style" data-bs-toggle="collapse" href="#advanced" role="button" aria-expanded="false" aria-controls="advanced">Advanced</a></p>
    <div class="collapse" id="advanced"><div class="card card-body"><div class="sidebar_left"><div class="wrapper">
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="All internal users can edit their Advanced features for themselves" title="Help">User edit</div>
    <label class="switch"><input type="checkbox" id="userEditToggler" checked=""/>
        <span class="slider round"/></label>
</div>
<div>
<h6 class="info-infinito" data-bs-toggle="popover" data-bs-placement="right"
    data-bs-content="All internal users can edit their Advanced features for themselves" title="Help">Loaders</h6>
    <div class="sub_style">
<select class="form-select infinito-form-select" id="loader" t-on-change="(ev) => this.onLoaderSelect(ev)">
<option t-foreach="this.state.loaders || []" t-as="load" t-key="load_index" t-att-value="load.name || load"
        t-att-selected="(load.name || load) == this.state.loader" t-out="load.name || load"/>
</select>
</div>
</div>
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="The theme colors will change to random colors every 10 minutes. Edited colors will remain unchanged."
     title="Help">Chameleon Mode</div>
    <label class="switch"><input type="checkbox" id="chameleonToggler" checked=""/>
        <span class="slider round"/></label>
</div>
</div></div></div></div>
</div>

    <div class="button_properties">
<p><a class="btn btn-primary_style" data-bs-toggle="collapse" href="#sidebar" role="button" aria-expanded="false" aria-controls="sidebar">Sidebar</a></p>
        <div class="collapse" id="sidebar"><div class="card card-body"><div class="sidebar_left"><div class="wrapper">
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Enables sidebar apps menu" title="Help">Sidebar</div>
    <label class="switch"><input type="checkbox" id="sidebarToggler" checked="1"/>
        <span class="slider round"/></label>
</div>
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Show App icon in sidebar" title="Help">Show Icon</div>
    <label class="switch"><input type="checkbox" id="sidebarIconToggler" checked=""/>
        <span class="slider round"/></label>
</div>
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Show App name in sidebar" title="Help">Show Name</div>
    <label class="switch"><input type="checkbox" id="sidebarNameToggler" checked=""/>
        <span class="slider round"/></label>
</div>
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Show company logo in top of app sidebar" title="Help">Company Logo</div>
    <label class="switch"><input type="checkbox" id="sidebarCompanyToggler" checked=""/>
        <span class="slider round"/></label>
</div>
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Show User Menu in top of app sidebar" title="Help">User Menu</div>
    <label class="switch"><input type="checkbox" id="sidebarUserToggler" checked=""/>
        <span class="slider round"/></label>
</div>
</div></div></div></div>
</div>

    <div class="button_properties">
<p><a class="btn btn-primary_style" data-bs-toggle="collapse" href="#navbar" role="button" aria-expanded="false" aria-controls="navbar">Navbar</a></p>
        <div class="collapse" id="navbar"><div class="card card-body"><div class="sidebar_left"><div class="wrapper">
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Only show navbar while hover top section of browser" title="Help">Navbar on Hover</div>
    <label class="switch"><input type="checkbox" id="navbarHoverToggler" checked=""/>
        <span class="slider round"/></label>
</div>
</div></div></div></div>
</div>

    <div class="button_properties">
<p><a class="btn btn-primary_style" data-bs-toggle="collapse" href="#dark" role="button" aria-expanded="false" aria-controls="dark">Dark mode</a></p>
        <div class="collapse" id="dark"><div class="card card-body"><div class="sidebar_left"><div class="wrapper">
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Turn On Dark mode" title="Help">Dark Mode</div>
    <label class="switch"><input type="checkbox" id="navbarDarkToggler" checked="" t-on-change="(ev) => this._OnChangeDark(ev)"/>
        <span class="slider round"/></label>
</div>
<div class="dark_mode">
<ul class="mode dark-switch" t-on-click="(ev) => this.onChangeDarkMode(ev)">
<li><a data-mode="all"><i class="oi" data-icon="light_mode" role="img"/><span>All time</span></a></li>
    <li><a data-mode="schedule"><i class="oi" data-icon="schedule" role="img"/><span>Schedule</span></a></li>
    <li><a data-mode="auto"><i class="oi" data-icon="autorenew" role="img"/><span>Automatic</span></a></li>
</ul>
    <div class="on_off dark-schedule">
<ul>
<li class="d-flex">
<div class="left">Turn On&#160;</div>
    <div class="right d-flex">
<span id="startSchedule"/>
        <i class="oi dropdown-caret-icon schedule-input" data-icon="arrow_right" role="img"
           t-on-click="(ev) => this.onClickSchedule(ev)"/>
        <input type="text" style="display: none" id="time1"/>
</div>
</li>
    <li class="d-flex">
<div class="left">Turn Off&#160;</div>
        <div class="right d-flex">
<span id="endSchedule"/>
            <i class="oi dropdown-caret-icon schedule-input" data-icon="arrow_right" role="img"
               t-on-click="(ev) => this.onClickSchedule(ev)"/>
            <input type="text" style="display: none" id="time2"/>
</div>
</li>
</ul>
</div>
</div>
</div></div></div></div>
</div>

    <div class="button_properties">
<p><a class="btn btn-primary_style" data-bs-toggle="collapse" href="#other" role="button" aria-expanded="false" aria-controls="other">Other</a></p>
        <div class="collapse" id="other"><div class="card card-body"><div class="sidebar_left"><div class="wrapper">
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Shows recent used apps on bottom of browser while hovering" title="Help">Recent Apps</div>
    <label class="switch"><input type="checkbox" id="navbarRecentToggler" checked=""/>
        <span class="slider round"/></label>
</div>
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Enable Enterprise Like App menu" title="Help">Full Screen App menu</div>
    <label class="switch"><input type="checkbox" id="navbarFullScreenAppToggler" checked=""/>
        <span class="slider round"/></label>
</div>
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Can save menu as favorite and use it from Right side of browser while hovering" title="Help">Menu Bookmark</div>
    <label class="switch"><input type="checkbox" id="navbarMenuBookmarkToggler" checked=""/>
        <span class="slider round"/></label>
</div>
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right" data-bs-content="Enable RTL"
     title="Help">RTL</div>
    <label class="switch"><input type="checkbox" id="navbarRTLToggler" checked=""/>
        <span class="slider round"/></label>
</div>
<div class="sub_style">
<div class="t_settings info-infinito" data-bs-toggle="popover" data-bs-placement="right"
     data-bs-content="Refresh the tree, kanban view" title="Help">Refresh</div>
    <label class="switch"><input type="checkbox" id="navbarRefreshToggler" checked=""/>
        <span class="slider round"/></label>
</div>
<div>
<h6 class="info-infinito" data-bs-toggle="popover" data-bs-placement="right"
    data-bs-content="All internal users can edit their Advanced features for themselves" title="Help">Fonts</h6>
    <div class="sub_style" id="js_fonts">
<select id="infinito_font_select" class="form-select infinito-form-select" t-on-change="(ev) => this.onFontChange(ev)">
<option class="form-select infinito-form-select system-font" value="System Font">System Font</option>
    <option t-foreach="this.state.fontData || []" t-as="font" t-key="font.id" class="form-select infinito-form-select"
            t-att-data-id="font.id" t-att-value="font.id" t-out="font.name"/>
    <option class="form-select infinito-form-select add-font" value="Add a Google Font">Add a Google Font</option>
</select>
</div>
</div>
<div>
<h6 class="info-infinito" data-bs-toggle="popover" data-bs-placement="right"
    data-bs-content="All internal users can edit their Advanced features for themselves"
    title="Help">Chatbox Position</h6>
    <div class="sub_style">
<select class="form-select infinito-form-select" id="chatterbox_position">
<option t-foreach="this.chatBoxPosition" t-as="chatbox" t-key="chatbox.value" t-att-value="chatbox.value"
        t-att-selected="chatbox.value == this.session.chatBoxPosition" t-out="chatbox.label"/>
</select>
</div>
</div>
<div>
<h6 class="info-infinito" data-bs-toggle="popover" data-bs-placement="right"
    data-bs-content="All internal users can edit their Advanced features for themselves" title="Help">Animation</h6>
    <div class="sub_style">
<select class="form-select infinito-form-select" id="animated_view" t-on-change="(ev) => this.onAnimationChange(ev)">
<option t-foreach="this.infinitoAnimation" t-as="animation" t-key="animation.value" t-att-value="animation.value"
        t-att-selected="animation.value == (this.session.infinitoAnimation || 'Default')" t-out="animation.label"/>
</select>
</div>
</div>
</div></div></div></div>
</div>

</div>
    <div class="sidebar_footer">
<a href="#" class="btn btn-submit close_changes" t-on-click.prevent="(ev) => this._onCloseClick(ev)">Close</a>
        <a href="#" class="btn btn-submit js_save_changes" t-on-click.prevent="(ev) => this._SaveChanges(ev)">Save Changes</a>
</div>
</div>
</div>
</t>
</templates>