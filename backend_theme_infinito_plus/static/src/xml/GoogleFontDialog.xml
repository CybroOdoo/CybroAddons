<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="backend_theme_infinito_plus.GoogleFontDialog">
        <Dialog size="'md'" title="this.title">
            <div class="mb-3">
                <label class="form-label" for="google_font_html_infinito">Google Font address</label>
                <textarea id="google_font_html_infinito"
                          class="form-control"
                          rows="3"
                          placeholder="https://fonts.google.com/specimen/Roboto"
                          t-on-input="this.onInput"/>
                <small class="text-muted">
                    Select one font on <a href="https://fonts.google.com" target="_blank" rel="noopener">fonts.google.com</a>
                    and copy-paste the address of the font page here.
                </small>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.onSave">Save &amp; Reload</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>