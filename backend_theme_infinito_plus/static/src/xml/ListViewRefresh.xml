<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_navigation')]" position="after">
<!--            Showing Refresh icon in the systray-->
            <button type="button" t-if="RefreshOn"
                    class="btn btn-refresh fa fa-refresh align-self-center" style=" margin-top: 3px; color:blue !important;"
                    t-on-click="onRefresh"/>
        </xpath>
    </t>
</templates>
