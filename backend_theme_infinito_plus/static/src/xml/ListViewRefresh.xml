<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_navigation')]" position="after">
            <!-- Refresh button of the control panel, drawn as an inline SVG. -->
            <button type="button" t-if="this.RefreshOn"
                    class="btn btn-link btn-refresh align-self-center p-1"
                    title="Refresh"
                    style="margin-top: 3px; color: #1a73e8 !important;"
                    t-on-click="(ev) => this.onRefresh(ev)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10"/>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                </svg>
            </button>
        </xpath>
    </t>
</templates>
