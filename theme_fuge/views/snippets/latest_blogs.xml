<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Added fuge latest blog snippet in website snippet section-->
    <template id="latest_blog_banner" inherit_id="website.snippets"
              name="Fuge Latest blog">
        <xpath expr="//snippets[@id='snippet_structure']"
               position="inside">
            <t t-snippet="theme_fuge.latest_blog"
               t-thumbnail="/theme_fuge/static/src/images/snippets/banner/blog-section.jpg" group="fuge"/>
        </xpath>
    </template>
    <!--Template for fuge latest blog snippet-->
    <template id="latest_blog" name="Fuge Latest Blog">
        <section class="blog">
            <owl-component name="theme_fuge.FugeLatestBlog"/>
        </section>
        <div class="oe_structure"/>
    </template>
</odoo>