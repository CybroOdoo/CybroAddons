<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="theme_fuge.FugeLatestBlog">
        <section class="latest_blog_post">
            <div class="wrapper">
                <div class="container">
                    <div class="row">
                        <div class="tile" id="tile-1">
                            <div class="tab-content gap">
                                <div class="tab-pane fade show active" id="home"
                                     role="tabpanel" aria-labelledby="home-tab">
                                    <div class="container">
                                        <div class="blog_contents">
                                            <div class="row">
                                                <div class="container text-center">
                                                    <h1>
                                                        LATEST BLOG
                                                        <span>SPOT</span>
                                                    </h1>
                                                    <p>Handpicked Favourite Just For You</p>
                                                </div>
                                                    <t t-foreach="state.posts_recent"
                                                       t-as="p"
                                                       t-key="p_index">
                                                        <div class="col-lg-3 col-md-6 col-sm-6" style="padding:1%;">
                                                            <div class="card"
                                                                 style="height:300px !important; text-align: center; background-image:url('/theme_fuge/static/src/images/snippets/banner/blog_img.jpg')">
                                                                <ul class="d-flex">
                                                                    <li class="" style="color: white;">By admin</li>
                                                                    <li class="" style="color: white;">
                                                                        <t t-esc="p.published_date"
                                                                           t-options="{'widget': 'date', 'format': 'MMM dd yyyy'}"/>
                                                                    </li>
                                                                </ul>
                                                                <div class="card-body" style="color: white;">
                                                                    <a t-att-href="p.website_absolute_url" style="color: white;">
                                                                        <t t-esc="p.name"/>
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </t>
</templates>