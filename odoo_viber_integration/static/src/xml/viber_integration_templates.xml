<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="odoo_viber_integration.ViberSystray">
        <!-- Systray icon for Viber -->
        <div class="toggle-icon viber-systray" role="button"
             title="Open Viber" t-on-click="this.onClickViber">
            <i id="viber_msg" aria-label="Viber Chat" title="Viber Chat">
                <img class="o_viber_icon"
                     src="/odoo_viber_integration/static/description/icon.png"
                     alt="Viber"/>
            </i>
        </div>
        <div class="o_mail_navbar_item">
            <div id="viber_msg_form"
                 class="o_viber_form dropdown-menu dropdown-menu-end"
                 t-att-class="{'d-none': !this.state.isOpen}">
                <div class="o_viber_header">
                    <h4 class="m-0"><b>Viber chat</b></h4>
                    <button type="button" id="close_viber"
                            class="btn o_viber_close"
                            aria-label="Close Viber popup" title="Close"
                            t-on-click="this.onCloseViber">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <select id="user_select" name="users"
                        class="o_viber_select input_field"
                        t-on-change="this.onSelectionUser">
                    <option value="" selected="selected">Choose a user to contact...</option>
                    <t t-foreach="this.state.users" t-as="user" t-key="user.id">
                        <option t-att-value="user.phone or ''"
                                t-att-disabled="!user.phone">
                            <t t-if="user.phone" t-out="user.name"/>
                            <t t-else="">
                                <t t-out="user.name"/> (no phone number)
                            </t>
                        </option>
                    </t>
                </select>
            </div>
        </div>
    </t>
</templates>
