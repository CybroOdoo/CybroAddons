<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="ViberSystray" id="odoo_viber_integration.viber_systray" owl="1">
        <!--Adding a systray icon for viber-->
        <div class="toggle-icon viber-systray" role="button"
                      id="schedule_systray"
                      title="Scheduled Actions"
                      t-on-click="OnClickViber">
                   <i id='viber_msg' aria-label="Viber Chatter"
                   title="Viber Chatter" >
                    <img src="/odoo_viber_integration/static/src/img/systray_icon.png"
                         style="width: 26px;height: 34px;display: inline-block;
                         background-size: cover;padding-top: 13px;padding-top: 2px;
                         padding-bottom: 11px;
                         padding-right: 2px;"/>
                </i>
                 </div>
        <div class="o_mail_navbar_item">
            <div class="o_mail_navbar_dropdown dropdown-menu dropdown-menu-right"
                 style="display: block;margin-left: -300px;
                 width: 364px;background:#9898ed;"
                 id="viber_msg_form"  t-ref="viber_msg">
                <div class="container">
                    <!--User selection form-->
                    <form class="form" name="msg">
                        <button type="button"
                                class="btn btn-default o_form_button_cancel"
                                id="close_viber" t-on-click="OnCloseViber">
                            <i class="fa fa-times"/>
                        </button>
                        <div class="form-group">
                            <center>
                                <h4>
                                    <b>Viber chatter</b>
                                </h4>
                            </center>
                        </div>
                        <div style="height:40px"/>
                    </form>
                </div>
                <div class="container">
                    <form class="user_select_section" name="user_select">
                        <div class="form-group">
                            <div class="col-sm" style="margin-top: -17px;">
                                <select name="users" id="user_select" t-ref="user_select"
                                        style="width:329px;background:#ffffff;
                                        margin-left:0px;"
                                        class="input_field" t-on-change="onSelectionUser"/>
                            </div>
                        </div>
                    </form>
                </div>
                <div style="height:20px"/>
            </div>
        </div>
    </t>
</templates>
