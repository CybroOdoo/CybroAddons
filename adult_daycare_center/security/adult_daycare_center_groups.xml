<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Adult Day Care user group -->
    <record id="group_adult_day_care" model="res.groups">
        <field name="name">Adult Day Care</field>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('sales_team.group_sale_salesman')),
            Command.link(ref('project.group_project_user')),
        ]"/>
        <field name="user_ids" eval="[
            Command.link(ref('base.user_root')),
            Command.link(ref('base.user_admin')),
        ]"/>
    </record>
</odoo>