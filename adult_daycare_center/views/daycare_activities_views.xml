<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Daycare Activity Action-->
    <record id="action_daycare_activities" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">daycare.activities</field>
        <field name="view_mode">list</field>
    </record>

    <!--Daycare Activity List View-->
    <record id="daycare_activity_view_tree" model="ir.ui.view">
        <field name="name">daycare.activities.view.list</field>
        <field name="model">daycare.activities</field>
        <field name="arch" type="xml">
            <list create='0'>
                <field name="activity_id"/>
                <field name="product_id"/>
                <field name="notes"/>
                <field name="time_in"/>
                <field name="time_out"/>
                <field name="responsible_id"/>
            </list>
        </field>
    </record>
</odoo>