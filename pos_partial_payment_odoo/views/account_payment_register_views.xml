<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_inherit_pos" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.pos</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="is_pos_order" invisible="1"/>
                <field name="pos_payment_method_id" invisible="not is_pos_order" required="is_pos_order"/>
            </xpath>
        </field>
    </record>
</odoo>
