<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!--    Ir cron fail mail template  -->
        <record id="mail_template_cron_error" model="mail.template">
            <field name="name">Mail: Cron Action Error Notification</field>
            <field name="model_id" ref="base.model_ir_cron"/>
            <field name="subject">{{ object.name }} Cron Failed</field>
            <field name="report_template_ids" eval="[(4, ref('cron_failure_notification.cron_fail_pdf_report'))]"/>
            <field name="body_html" type="html">
                <p>Dear Admin,</p>
                <p>Please find attached the report containing details of failed scheduled actions on the server.</p>
                <p>Thank you.</p>
            </field>
        </record>
    </data>
</odoo>
