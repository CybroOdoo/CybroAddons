<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Frontend Layout Extension -->
    <template id="frontend_layout_extension" name="Frontend Layout"
              inherit_id="web.frontend_layout">
        <xpath expr="//div[@id='wrapwrap']/main" position="attributes">
            <!-- Add a background image style based on the signup configuration -->
            <attribute name="t-attf-style"
                       add="#{(request.env['signup.configuration'].sudo().search([('website_id', '=', env.website.id)], limit=1) or request.env['signup.configuration'].sudo().search([], limit=1)).background_image and ('background-image: url(\'data:image/*;base64,' + (request.env['signup.configuration'].sudo().search([('website_id', '=', env.website.id)], limit=1) or request.env['signup.configuration'].sudo().search([], limit=1)).background_image.to_base64() + '\'); background-size: cover; background-position: center; background-repeat: no-repeat; min-height: 100vh;') or ''}"/>
        </xpath>
    </template>
    <!-- Auth Signup/ResetPassword Form Fields -->
    <template id="advance_signup_portal_fields"
              inherit_id="auth_signup.fields"
              name="Auth Signup/ResetPassword form fields">
        <xpath expr="//div[hasclass('field-confirm_password')]"
               position="after">
            <t t-set="configuration"
               t-value="configuration or request.env['signup.configuration'].sudo().search([('website_id', '=', env.website.id)], limit=1) or request.env['signup.configuration'].sudo().search([], limit=1)"/>
            <t t-if="configuration and configuration.is_active">
                <t t-foreach="configuration.signup_field_ids" t-as="field">
                    <t t-if="field.field_type in ['char', 'text']">
                        <div class="mb-3 field-test pt-2">
                            <label class="form-label" t-attf-for="{{field.field_id.name}}">
                                <t t-out="field.name"/>
                            </label>
                            <input type="text"
                                   t-attf-name="{{field.field_id.name}}"
                                   t-attf-id="{{field.field_id.name}}"
                                   class="form-control"
                                   t-att-placeholder="field.placeholder"
                                   t-att-title="field.help_description"
                                   t-att-required="'required' if field.is_required else None"/>
                        </div>
                    </t>
                    <t t-elif="field.field_type == 'boolean'">
                        <div class="mb-3 field-test pt-2 form-check">
                            <input type="checkbox"
                                   class="form-check-input"
                                   t-attf-id="{{field.field_id.name}}"
                                   t-att-name="field.field_id.name"
                                   t-att-required="'required' if field.is_required else None"/>
                            <label class="form-check-label ms-2" t-attf-for="{{field.field_id.name}}">
                                <t t-out="field.name"/>
                            </label>
                        </div>
                    </t>
                    <t t-elif="field.field_type in ['date', 'datetime']">
                        <div class="mb-3 field-test pt-2">
                            <label class="form-label" t-attf-for="{{field.field_id.name}}">
                                <t t-out="field.name"/>
                            </label>
                            <input type="date"
                                   t-att-name="field.field_id.name"
                                   t-attf-id="{{field.field_id.name}}"
                                   class="form-control"
                                   t-att-placeholder="field.placeholder"
                                   t-att-title="field.help_description"
                                   t-att-required="'required' if field.is_required else None"/>
                        </div>
                    </t>
                    <t t-elif="field.field_type =='binary'">
                        <div class="mb-3 field-test pt-2">
                            <label class="form-label" t-attf-for="{{field.field_id.name}}">
                                <t t-out="field.name"/>
                            </label>
                            <input type="file"
                                   t-attf-id="{{field.field_id.name}}"
                                   class="form-control"
                                   t-att-name="field.field_id.name"
                                   accept="image/*"
                                   t-att-title="field.help_description"
                                   t-att-required="'required' if field.is_required else None"/>
                        </div>
                    </t>
                    <t t-elif="field.field_type in ['integer', 'float']">
                        <div class="mb-3 field-test pt-2">
                            <label class="form-label" t-attf-for="{{field.field_id.name}}">
                                <t t-out="field.name"/>
                            </label>
                            <input type="number"
                                   class="form-control"
                                   t-att-name="field.field_id.name"
                                   t-attf-id="{{field.field_id.name}}"
                                   t-att-placeholder="field.placeholder"
                                   t-att-title="field.help_description"
                                   t-att-required="'required' if field.is_required else None"/>
                        </div>
                    </t>
                </t>
                <!-- Display terms and conditions from the configuration -->
                <t t-if="configuration.is_show_terms_conditions">
                    <div class="form-check mt-3 mb-3">
                        <input type="checkbox" class="form-check-input" id="accept_terms" name="accept_terms" required="required"/>
                        <label class="form-check-label" for="accept_terms">
                            I Agree to the <t t-out="configuration.terms_and_conditions"/>
                        </label>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
    <!-- Template for Login Form -->
    <template id="advance_signup_portal_login"
              inherit_id="web.login" name="Login Form">
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="attributes">
            <attribute name="style"
                       add="z-index: 99;background: #f0f8ff70;padding: 20px;border-radius: 5px;max-width:350px;"/>
        </xpath>
        <xpath expr="//input[@name='csrf_token']" position="before">
            <t t-set="configuration"
               t-value="request.env['signup.configuration'].sudo().search([('website_id', '=', env.website.id)], limit=1) or request.env['signup.configuration'].sudo().search([], limit=1)"/>
            <div class="mb-3 text-center">
                <span style="font-size: 19px;font-family: sans-serif;">
                    <b>SIGN IN TO YOUR ACCOUNT</b>
                </span>
            </div>
            <div class="mb-4 text-center">
                <span style="font-size: 15px;font-family: cursive;font-weight: bold;">
                    <t t-out="configuration.login_page_content"/>
                </span>
            </div>
        </xpath>
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="inside">
            <div class="text-center small mt-4 pt-3 border-top"
                 t-if="not disable_footer">
                <t t-if="not disable_database_manager">
                    <a class="border-end pe-2 me-1"
                       href="/web/database/manager">Manage Databases
                    </a>
                </t>
                <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth"
                   target="_blank">Powered by
                    <span>Odoo</span>
                </a>
            </div>
        </xpath>
    </template>
    <!-- Template for Sign Up Form -->
    <template id="advance_signup_portal_signup"
              inherit_id="auth_signup.signup" name="Signup Form">
        <xpath expr="//form[hasclass('oe_signup_form')]" position="attributes">
            <attribute name="style"
                       add="z-index: 99;background: #f0f8ff70;padding: 20px;border-radius: 5px;max-width:350px;"/>
        </xpath>
        <xpath expr="//input[@name='csrf_token']" position="before">
            <t t-set="configuration"
               t-value="request.env['signup.configuration'].sudo().search([('website_id', '=', env.website.id)], limit=1) or request.env['signup.configuration'].sudo().search([], limit=1)"/>
            <div class="mb-3 text-center">
                <span style="font-size: 19px;font-family: sans-serif;">
                    <b>CREATE YOUR ACCOUNT</b>
                </span>
            </div>
            <div class="mb-4 text-center">
                <span style="font-size: 15px;font-family: cursive;font-weight: bold;">
                    <t t-out="configuration.signup_page_content"/>
                </span>
            </div>
        </xpath>
        <xpath expr="//form[hasclass('oe_signup_form')]" position="inside">
            <div class="text-center small mt-4 pt-3 border-top"
                 t-if="not disable_footer">
                <t t-if="not disable_database_manager">
                    <a class="border-end pe-2 me-1"
                       href="/web/database/manager">Manage Databases
                    </a>
                </t>
                <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth"
                   target="_blank">Powered by
                    <span>Odoo</span>
                </a>
            </div>
        </xpath>
    </template>
    <!-- Template for Reset Password Form -->
    <template id="advance_signup_portal_reset_password"
              inherit_id="auth_signup.reset_password"
              name="Reset Password Form">
        <xpath expr="//input[@name='csrf_token']" position="before">
            <t t-set="configuration"
               t-value="request.env['signup.configuration'].sudo().search([('website_id', '=', env.website.id)], limit=1) or request.env['signup.configuration'].sudo().search([], limit=1)"/>
            <div class="mb-3 text-center">
                <span style="font-size: 19px;font-family: sans-serif;">
                    <b>FORGOT YOUR PASSWORD?</b>
                </span>
            </div>
            <div class="mb-4 text-center">
                <span style="font-size: 15px;font-family: cursive;font-weight: bold;">
                    <t t-out="configuration.reset_password_content"/>
                </span>
            </div>
        </xpath>
        <xpath expr="//form[hasclass('oe_reset_password_form')]" position="attributes">
            <attribute name="style"
                       add="z-index: 99;background: #f0f8ff70;padding: 20px;border-radius: 5px;max-width:350px;"/>
        </xpath>
    </template>
    <!-- Template for the Home Page Layout -->
    <template id="advance_signup_portal_layout" name="Home"
              inherit_id="website.layout">
        <xpath expr="//header" position="attributes">
            <attribute name="t-if">not (hide_header or (request.httprequest.path.rstrip('/') in ['/web/login', '/web/signup', '/web/reset_password'] and (request.env['signup.configuration'].sudo().search([('website_id', '=', env.website.id)], limit=1) or request.env['signup.configuration'].sudo().search([], limit=1)).is_active))</attribute>
        </xpath>
        <xpath expr="//footer" position="attributes">
            <attribute name="t-if">not (hide_footer or (request.httprequest.path.rstrip('/') in ['/web/login', '/web/signup', '/web/reset_password'] and (request.env['signup.configuration'].sudo().search([('website_id', '=', env.website.id)], limit=1) or request.env['signup.configuration'].sudo().search([], limit=1)).is_active))</attribute>
        </xpath>
    </template>
</odoo>
