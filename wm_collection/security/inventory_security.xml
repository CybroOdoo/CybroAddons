<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Master gate: granted when wm_enable_sorting is checked in Settings -->
        <record id="group_wm_sorting_enabled" model="res.groups">
            <field name="name">Sorting Enabled</field>
        </record>

        <!-- User Group: Sort by Material -->
        <record id="group_sort_by_material" model="res.groups">
            <field name="name">Sort by Material</field>
            <field name="implied_ids" eval="[(4, ref('group_wm_sorting_enabled'))]"/>
        </record>

        <!-- User Group: Sort by Category -->
        <record id="group_sort_by_category" model="res.groups">
            <field name="name">Sort by Category</field>
            <field name="implied_ids" eval="[(4, ref('group_wm_sorting_enabled'))]"/>
        </record>

        <!-- User Group: wm_base.group_wm_inventory_operator -->
        <record id="wm_base.group_wm_inventory_operator" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_sort_by_material')), (4, ref('stock.group_stock_user'))]"/>
        </record>

        <!-- Multi-Company Record Rules -->
        <record id="rule_waste_batch_company" model="ir.rule">
            <field name="name">Waste Batch Multi-Company</field>
            <field name="model_id" ref="model_waste_batch"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Security Rule: Waste Batch Inspection Multi-Company -->
        <record id="rule_wm_batch_inspection_company" model="ir.rule">
            <field name="name">Waste Batch Inspection Multi-Company</field>
            <field name="model_id" ref="model_wm_batch_inspection"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
