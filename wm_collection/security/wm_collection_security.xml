            <field name="model_id" ref="model_wm_missed_collection"/>
            <field name="groups" eval="[(4, ref('wm_base.group_wm_driver'))]"/>
            <field name="domain_force">['|', '|', ('driver_id', '=', user.partner_id.id), ('order_id.driver_id', '=', user.partner_id.id), ('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
