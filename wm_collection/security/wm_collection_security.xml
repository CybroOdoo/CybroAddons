            <field name="model_id" ref="model_wm_maintenance_history_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- WM roles may run vehicle inspections (pre/post-trip checklists)
             without being Survey users: limit them to checklist answers. -->
        <record id="rule_wm_survey_user_input_driver" model="ir.rule">
            <field name="name">Survey answers: WM vehicle checklists only</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="groups" eval="[(4, ref('wm_base.group_wm_driver'))]"/>
            <field name="domain_force">[('checklist_type', '!=', False), ('create_uid', '=', user.id)]</field>
        </record>
        <record id="rule_wm_survey_user_input_line_driver" model="ir.rule">
            <field name="name">Survey answer lines: WM vehicle checklists only</field>
            <field name="model_id" ref="survey.model_survey_user_input_line"/>
            <field name="groups" eval="[(4, ref('wm_base.group_wm_driver'))]"/>
            <field name="domain_force">[('user_input_id.checklist_type', '!=', False), ('user_input_id.create_uid', '=', user.id)]</field>
        </record>
        <!-- Drivers only reach the status logs, missed collections and signatures of their own work; dispatchers and managers keep full access. -->
        <record id="rule_wm_status_log_driver" model="ir.rule">
