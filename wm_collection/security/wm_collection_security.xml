        <record id="rule_wm_batch_aging_report_company" model="ir.rule">
            <field name="name">Batch Aging Report: Multi-Company</field>
            <field name="model_id" ref="model_wm_batch_aging_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_wm_driver_performance_report_company" model="ir.rule">
            <field name="name">Driver Performance Report: Multi-Company</field>
            <field name="model_id" ref="model_wm_driver_performance_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_wm_fleet_expiry_report_company" model="ir.rule">
