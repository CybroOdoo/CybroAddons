            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_wm_signature_all" model="ir.rule">
            <field name="name">Signature: All Access for Dispatcher / Manager / System Admin</field>
            <field name="model_id" ref="model_wm_signature"/>
            <field name="groups" eval="[(4, ref('wm_base.group_wm_dispatcher')), (4, ref('wm_base.group_wm_ops_manager')), (4, ref('wm_base.group_wm_admin')), (4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!-- Dispatchers and managers review every driver's inspection checklist. -->
        <record id="rule_wm_survey_user_input_dispatcher" model="ir.rule">
            <field name="name">Survey answers: WM vehicle checklists (dispatchers)</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
