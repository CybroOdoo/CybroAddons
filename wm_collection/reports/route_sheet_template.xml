<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template: report_route_sheet -->
    <template id="report_route_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Route Sheet: <span t-field="doc.name"/></h2>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Driver:</strong> <span t-field="doc.driver_id.name"/><br/>
                                <strong>Vehicle:</strong> <span t-field="doc.vehicle_id.name"/><br/>
                                <strong>Date:</strong> <span t-field="doc.date"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Status:</strong> <span t-field="doc.state"/>
                            </div>
                        </div>

                        <h3>Route Sequence &amp; Waypoints</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Seq</th>
                                    <th>Collection Point</th>
                                    <th>Address</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.sequence"/></td>
                                        <td><span t-field="line.collection_point_id.name"/></td>
                                        <td><span t-field="line.collection_point_id.street"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h3 class="mt32">Route Summary</h3>
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Total Points:</strong></td>
                                <td><span t-esc="len(doc.line_ids)"/></td>
                                <td><strong>Estimated Duration (Hours):</strong></td>
                                <td><span t-field="doc.estimated_duration"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
