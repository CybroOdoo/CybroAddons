<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.missed.collection.report.wizard - wm.missed.collection.report.wizard.form (Form) -->
    <record id="view_wm_missed_collection_report_wizard_form" model="ir.ui.view">
        <field name="name">wm.missed.collection.report.wizard.form</field>
        <field name="model">wm.missed.collection.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Missed Collection Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="route_id" options="{'no_create': True}"/>
                        <field name="reason_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: Print Missed Collection Report -->
    <record id="action_wm_missed_collection_report_wizard" model="ir.actions.act_window">
        <field name="name">Print Missed Collection Report</field>
        <field name="res_model">wm.missed.collection.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="wm_collection.model_wm_missed_collection"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
