<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.collection.order.report.wizard - wm.collection.order.report.wizard.form (Form) -->
    <record id="view_wm_collection_order_report_wizard_form" model="ir.ui.view">
        <field name="name">wm.collection.order.report.wizard.form</field>
        <field name="model">wm.collection.order.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Collection Order Summary">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="order_id" options="{'no_create': True}" placeholder="Select an order..."/>
                    </group>
                    <group>
                        <field name="state"/>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="route_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: Print Collection Order Summary -->
    <record id="action_wm_collection_order_report_wizard" model="ir.actions.act_window">
        <field name="name">Print Collection Order Summary</field>
        <field name="res_model">wm.collection.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
