<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wm_add_status_log_wizard_form" model="ir.ui.view">
        <field name="name">wm.add.status.log.wizard.form</field>
        <field name="model">wm.add.status.log.wizard</field>
        <field name="arch" type="xml">
            <form string="Log Driver Status">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="status"/>
                            <field name="timestamp"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="photo" widget="image"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Add optional details, e.g. 'Arrived at site gate', 'Traffic delay', 'Container lifted successfully'..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Log Status" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
