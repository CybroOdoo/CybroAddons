<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.mark.missed.wizard - wm.mark.missed.wizard.form (Form) -->
    <record id="view_wm_mark_missed_wizard_form" model="ir.ui.view">
        <field name="name">wm.mark.missed.wizard.form</field>
        <field name="model">wm.mark.missed.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark as Missed">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="reason_id" options="{'no_create': True}"/>
                    <field name="notes" placeholder="Optional driver notes..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm Missed" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
