<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Change Driver Wizard View -->
    <record id="view_wm_change_driver_wizard_form" model="ir.ui.view">
        <field name="name">wm.change.driver.wizard.form</field>
        <field name="model">wm.change.driver.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Driver">
                <group>
                    <field name="route_id" invisible="1"/>
                    <field name="new_driver_id" options="{'no_create': True}"/>
                    <field name="reason" placeholder="State the reason for changing the driver..."/>
                </group>
                <footer>
                    <button name="action_change_driver" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- History List View -->
    <record id="view_wm_driver_change_history_list" model="ir.ui.view">
        <field name="name">wm.driver.change.history.list</field>
        <field name="model">wm.driver.change.history</field>
        <field name="arch" type="xml">
            <list string="Driver Change History" create="false" edit="false" delete="false">
                <field name="date_changed"/>
                <field name="route_id"/>
                <field name="old_driver_id"/>
                <field name="new_driver_id"/>
                <field name="reason"/>
                <field name="changed_by_id"/>
            </list>
        </field>
    </record>
</odoo>
