<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Waste Management: Auto-Assign Orders to Zone Routes -->
        <record id="ir_cron_auto_assign_orders_to_routes" model="ir.cron">
            <field name="name">Waste Management: Auto-Assign Orders to Zone Routes</field>
            <field name="model_id" ref="model_wm_route"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_assign_orders_to_routes()</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:15:00')"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Waste Management: Auto-Dispatch Ready Routes -->
        <record id="ir_cron_auto_dispatch_ready_routes" model="ir.cron">
            <field name="name">Waste Management: Auto-Dispatch Ready Routes</field>
            <field name="model_id" ref="model_wm_route"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_dispatch_ready_routes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
