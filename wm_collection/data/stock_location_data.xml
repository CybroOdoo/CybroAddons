<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ─────────────────────────────────────────────────────────────────
             Landfill / Disposal — virtual location for failed-inspection
             batches.  Uses usage='inventory' so stock moved here is removed
             from on-hand quantities but remains fully traceable in moves.
             Mirrors the pattern used by stock.stock_location_scrapped.
        ──────────────────────────────────────────────────────────────────── -->
        <record id="stock_location_landfill" model="stock.location">
            <field name="name">Landfill/Disposal</field>
            <field name="usage">inventory</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
