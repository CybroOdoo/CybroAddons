<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SIGNATURE ROLE FOR COLLECTION ORDERS (WASTE MANAGEMENT COMPANY VERIFIER) -->
    <record id="sig_role_driver" model="wm.signature.role">
        <field name="name">Waste Collector / Verification Officer</field>
        <field name="description">Authorized representative of the waste management company verifying collected waste details.</field>
    </record>

    <!-- SIGNATURE TEMPLATE FOR COLLECTION ORDERS -->
    <record id="sig_template_collection_order" model="wm.signature.template">
        <field name="name">Waste Collection Order Signoff</field>
        <field name="description">Electronic verification signature template for waste management company field personnel confirming collected waste details.</field>
        <field name="role_ids" eval="[(6, 0, [ref('sig_role_driver')])]"/>
    </record>

    <!-- SIGNATURE ITEMS FOR WASTE COLLECTOR VERIFICATION SIGN-OFF -->
    <record id="sig_item_driver_signature" model="wm.signature.item">
        <field name="template_id" ref="sig_template_collection_order"/>
        <field name="role_id" ref="sig_role_driver"/>
        <field name="type">signature</field>
        <field name="page">1</field>
        <field name="x">12</field>
        <field name="y">78</field>
        <field name="width">42</field>
        <field name="height">7</field>
    </record>
</odoo>
