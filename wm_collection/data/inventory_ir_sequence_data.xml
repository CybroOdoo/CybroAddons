<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence: Waste Batch Sequence -->
        <record id="seq_waste_batch" model="ir.sequence">
            <field name="name">Waste Batch Sequence</field>
            <field name="code">waste.batch</field>
            <field name="prefix">WB/</field>
            <field name="padding">5</field>
            <field name="number_next">10</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence: Waste Batch Inspection Sequence -->
        <record id="seq_waste_batch_inspection" model="ir.sequence">
            <field name="name">Waste Batch Inspection Sequence</field>
            <field name="code">wm.batch.inspection</field>
            <field name="prefix">INSP/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence: Material Sort Configuration -->
        <record id="seq_wm_waste_material_sort_config" model="ir.sequence">
            <field name="name">Material Sort Configuration</field>
            <field name="code">wm.waste.material.sort.config</field>
            <field name="prefix">MSC/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence: Category Sort Configuration -->
        <record id="seq_wm_waste_category_sort_config" model="ir.sequence">
            <field name="name">Category Sort Configuration</field>
            <field name="code">wm.waste.category.sort.config</field>
            <field name="prefix">CSC/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
