<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: background geocoding of collection points. Triggered right
             after an address is saved; the hourly run retries what failed. -->
        <record id="ir_cron_geocode_collection_points" model="ir.cron">
            <field name="name">Waste Management: Geocode Collection Points</field>
            <field name="model_id" ref="model_wm_collection_point"/>
            <field name="state">code</field>
            <field name="code">model._cron_geocode_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
