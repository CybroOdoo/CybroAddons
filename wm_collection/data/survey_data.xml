<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Pre-Trip Survey -->
        <record id="survey_pre_trip_inspection" model="survey.survey">
            <field name="title">Pre-Trip Inspection</field>
            <field name="access_mode">public</field>
            <field name="questions_layout">one_page</field>
            <field name="scoring_type">scoring_without_answers</field>
        </record>

        <!-- Pre-Trip Questions -->
        <record id="survey_pre_trip_q1" model="survey.question">
            <field name="survey_id" ref="survey_pre_trip_inspection"/>
            <field name="title">1. Brakes functional?</field>
            <field name="question_type">simple_choice</field>
            <field name="sequence">10</field>
        </record>
        <!-- Record: survey.question.answer (survey_pre_trip_q1_yes) -->
        <record id="survey_pre_trip_q1_yes" model="survey.question.answer">
            <field name="question_id" ref="survey_pre_trip_q1"/>
            <field name="value">Yes</field>
            <field name="answer_score">1.0</field>
            <field name="is_correct">True</field>
        </record>
        <!-- Record: survey.question.answer (survey_pre_trip_q1_no) -->
        <record id="survey_pre_trip_q1_no" model="survey.question.answer">
            <field name="question_id" ref="survey_pre_trip_q1"/>
            <field name="value">No</field>
            <field name="answer_score">0.0</field>
            <field name="is_correct">False</field>
        </record>

        <!-- Record: survey.question (survey_pre_trip_q2) -->
        <record id="survey_pre_trip_q2" model="survey.question">
            <field name="survey_id" ref="survey_pre_trip_inspection"/>
            <field name="title">2. Headlights and Indicators OK?</field>
            <field name="question_type">simple_choice</field>
            <field name="sequence">20</field>
        </record>
        <!-- Record: survey.question.answer (survey_pre_trip_q2_yes) -->
        <record id="survey_pre_trip_q2_yes" model="survey.question.answer">
            <field name="question_id" ref="survey_pre_trip_q2"/>
            <field name="value">Yes</field>
            <field name="answer_score">1.0</field>
            <field name="is_correct">True</field>
        </record>
        <!-- Record: survey.question.answer (survey_pre_trip_q2_no) -->
        <record id="survey_pre_trip_q2_no" model="survey.question.answer">
            <field name="question_id" ref="survey_pre_trip_q2"/>
            <field name="value">No</field>
            <field name="answer_score">0.0</field>
            <field name="is_correct">False</field>
        </record>

        <!-- Record: survey.question (survey_pre_trip_q3) -->
        <record id="survey_pre_trip_q3" model="survey.question">
            <field name="survey_id" ref="survey_pre_trip_inspection"/>
            <field name="title">3. Additional Notes</field>
            <field name="question_type">text_box</field>
            <field name="sequence">30</field>
        </record>

        <!-- Post-Trip Survey -->
        <record id="survey_post_trip_inspection" model="survey.survey">
            <field name="title">Post-Trip Inspection</field>
            <field name="access_mode">public</field>
            <field name="questions_layout">one_page</field>
            <field name="scoring_type">scoring_without_answers</field>
        </record>

        <!-- Post-Trip Questions -->
        <record id="survey_post_trip_q1" model="survey.question">
            <field name="survey_id" ref="survey_post_trip_inspection"/>
            <field name="title">1. New damage detected?</field>
            <field name="question_type">simple_choice</field>
            <field name="sequence">10</field>
        </record>
        <!-- Record: survey.question.answer (survey_post_trip_q1_no) -->
        <record id="survey_post_trip_q1_no" model="survey.question.answer">
            <field name="question_id" ref="survey_post_trip_q1"/>
            <field name="value">No</field>
            <field name="answer_score">1.0</field>
            <field name="is_correct">True</field>
        </record>
        <!-- Record: survey.question.answer (survey_post_trip_q1_yes) -->
        <record id="survey_post_trip_q1_yes" model="survey.question.answer">
            <field name="question_id" ref="survey_post_trip_q1"/>
            <field name="value">Yes</field>
            <field name="answer_score">0.0</field>
            <field name="is_correct">False</field>
        </record>

        <!-- Record: survey.question (survey_post_trip_q2) -->
        <record id="survey_post_trip_q2" model="survey.question">
            <field name="survey_id" ref="survey_post_trip_inspection"/>
            <field name="title">2. Comments/Damage Description</field>
            <field name="question_type">text_box</field>
            <field name="sequence">20</field>
        </record>
    </data>
</odoo>
