<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Pre-Trip Checklist Items -->
        <record id="checklist_item_pre_tires" model="wm.checklist.item">
            <field name="name">Tire pressure and condition</field>
            <field name="checklist_type">pre_trip</field>
        </record>
        <!-- Record: wm.checklist.item - Brake function (parking and service brakes) -->
        <record id="checklist_item_pre_brakes" model="wm.checklist.item">
            <field name="name">Brake function (parking and service brakes)</field>
            <field name="checklist_type">pre_trip</field>
        </record>
        <!-- Record: wm.checklist.item - Fluid levels (oil, coolant, windshield washer) -->
        <record id="checklist_item_pre_fluids" model="wm.checklist.item">
            <field name="name">Fluid levels (oil, coolant, windshield washer)</field>
            <field name="checklist_type">pre_trip</field>
        </record>
        <!-- Record: wm.checklist.item - Headlights, brake lights, and turn signals -->
        <record id="checklist_item_pre_lights" model="wm.checklist.item">
            <field name="name">Headlights, brake lights, and turn signals</field>
            <field name="checklist_type">pre_trip</field>
        </record>
        <!-- Record: wm.checklist.item - Mirrors, windshield, and wipers -->
        <record id="checklist_item_pre_mirrors" model="wm.checklist.item">
            <field name="name">Mirrors, windshield, and wipers</field>
            <field name="checklist_type">pre_trip</field>
        </record>
    </data>
</odoo>
