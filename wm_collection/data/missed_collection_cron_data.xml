<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- E4: Weekly Review — raises a to-do activity for whoever is set
             as "Execute As" below, summarizing missed-collection patterns
             by customer, reason, and route from the last 7 days.
             To assign this to your Operations Manager: Settings >
             Technical > Automation > Scheduled Actions > this record >
             change the "Execute As" (user_id) field. -->
        <record id="ir_cron_wm_missed_collection_weekly_review" model="ir.cron">
            <field name="name">WM: Weekly Missed Collection Review Reminder</field>
            <field name="model_id" ref="model_wm_missed_collection"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">code</field>
            <field name="code">model._cron_weekly_review_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(weekday=0, hour=8, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
