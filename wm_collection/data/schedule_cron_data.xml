<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Waste Management: Process Route Schedules -->
        <record id="ir_cron_process_wm_schedules" model="ir.cron">
            <field name="name">Waste Management: Process Route Schedules</field>
            <field name="model_id" ref="model_wm_schedule"/>
            <field name="state">code</field>
            <field name="code">model._process_schedules()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
