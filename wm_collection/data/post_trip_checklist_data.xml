<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Post-Trip Checklist Items -->
        <record id="checklist_item_post_damage" model="wm.checklist.item">
            <field name="name">Check for new vehicle damage</field>
            <field name="checklist_type">post_trip</field>
        </record>
        <!-- Record: wm.checklist.item - Ensure all waste is fully discharged/emptied -->
        <record id="checklist_item_post_empty" model="wm.checklist.item">
            <field name="name">Ensure all waste is fully discharged/emptied</field>
            <field name="checklist_type">post_trip</field>
        </record>
        <!-- Record: wm.checklist.item - Clean vehicle cabin -->
        <record id="checklist_item_post_clean" model="wm.checklist.item">
            <field name="name">Clean vehicle cabin</field>
            <field name="checklist_type">post_trip</field>
        </record>
        <!-- Record: wm.checklist.item - Document any mechanical issues encountered -->
        <record id="checklist_item_post_issues" model="wm.checklist.item">
            <field name="name">Document any mechanical issues encountered</field>
            <field name="checklist_type">post_trip</field>
        </record>
    </data>
</odoo>
