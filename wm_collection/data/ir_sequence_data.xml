<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Collection Route -->
        <record id="seq_wm_route" model="ir.sequence">
            <field name="name">Collection Route Sequence</field>
            <field name="code">wm.route</field>
            <field name="prefix">ROUTE</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Sequence: Collection Order Sequence -->
        <record id="seq_wm_collection_order" model="ir.sequence">
            <field name="name">Collection Order Sequence</field>
            <field name="code">wm.collection.order</field>
            <field name="prefix">ORDER</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Sequence: Missed Collection Sequence -->
        <record id="seq_wm_missed_collection" model="ir.sequence">
            <field name="name">Missed Collection Sequence</field>
            <field name="code">wm.missed.collection</field>
            <field name="prefix">MISS</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
