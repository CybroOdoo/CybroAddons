<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.missed.collection - wm.missed.collection.list (List) -->
    <record id="view_wm_missed_collection_list" model="ir.ui.view">
        <field name="name">wm.missed.collection.list</field>
        <field name="model">wm.missed.collection</field>
        <field name="arch" type="xml">
            <list string="Missed Collections">
                <header>
                    <button name="%(wm_collection.action_wm_missed_collection_report_wizard)d" type="action" string="Print Report" display="always"/>
                </header>
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="reason_id"/>
                <field name="driver_id"/>
                <field name="missed_date"/>
                <field name="retry_order_id"/>
                <field name="customer_notified" readonly="1"/>
                <field name="route_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- View: wm.missed.collection - wm.missed.collection.form (Form) -->
    <record id="view_wm_missed_collection_form" model="ir.ui.view">
        <field name="name">wm.missed.collection.form</field>
        <field name="model">wm.missed.collection</field>
        <field name="arch" type="xml">
            <form string="Missed Collection">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="reason_id"/>
                            <field name="driver_id"/>
                            <field name="missed_date"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="route_id"/>
                            <field name="retry_order_id"/>
                            <field name="customer_notified" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action: Missed Collections -->
    <record id="action_wm_missed_collection" model="ir.actions.act_window">
        <field name="name">Missed Collections</field>
        <field name="res_model">wm.missed.collection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
