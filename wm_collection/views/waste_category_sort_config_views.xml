<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="wm_waste_category_sort_config_view_list" model="ir.ui.view">
        <field name="name">wm.waste.category.sort.config.view.list</field>
        <field name="model">wm.waste.category.sort.config</field>
        <field name="arch" type="xml">
            <list string="Category Sort Configuration">
                <field name="name"/>
                <field name="category_id"/>
                <field name="dest_location_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="wm_waste_category_sort_config_view_form" model="ir.ui.view">
        <field name="name">wm.waste.category.sort.config.view.form</field>
        <field name="model">wm.waste.category.sort.config</field>
        <field name="arch" type="xml">
            <form string="Category Sort Configuration">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="dest_location_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional instructions..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wm_waste_category_sort_config" model="ir.actions.act_window">
        <field name="name">Category Sort Configuration</field>
        <field name="res_model">wm.waste.category.sort.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new category sort configuration
          </p>
        </field>
    </record>
</odoo>
