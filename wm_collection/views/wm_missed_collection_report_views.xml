<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- E4: Weekly Review — Missed Collection Report (pivot/graph by customer, reason, route) -->
    <record id="view_wm_missed_collection_report_pivot" model="ir.ui.view">
        <field name="name">wm.missed.collection.report.pivot</field>
        <field name="model">wm.missed.collection</field>
        <field name="arch" type="xml">
            <pivot string="Missed Collection Report">
                <field name="partner_id" type="row"/>
                <field name="reason_id" type="col"/>
                <field name="route_id" type="row"/>
                <field name="missed_date" interval="week" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- View: wm.missed.collection - wm.missed.collection.report.graph (Graph) -->
    <record id="view_wm_missed_collection_report_graph" model="ir.ui.view">
        <field name="name">wm.missed.collection.report.graph</field>
        <field name="model">wm.missed.collection</field>
        <field name="arch" type="xml">
            <graph string="Missed Collection Report" type="bar">
                <field name="reason_id"/>
                <field name="missed_date" interval="week"/>
            </graph>
        </field>
    </record>

    <!-- Action: Missed Collection Report -->
    <record id="action_wm_missed_collection_report" model="ir.actions.act_window">
        <field name="name">Missed Collection Report</field>
        <field name="res_model">wm.missed.collection</field>
        <field name="view_mode">graph,list,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nodata_smiling_face">No missed collections in this period.</p>
            <p>Review patterns by customer, reason, or route to inform operational changes
                such as customer education on bin placement or route timing adjustments.</p>
        </field>
    </record>
</odoo>
