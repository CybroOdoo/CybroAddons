<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.service.zone - wm.service.zone.list (List) -->
    <record id="view_wm_service_zone_list" model="ir.ui.view">
        <field name="name">wm.service.zone.list</field>
        <field name="model">wm.service.zone</field>
        <field name="arch" type="xml">
            <list string="Service Zones">
                <field name="name"/>
                <field name="code"/>
                <field name="default_vehicle_id"/>
                <field name="default_driver_id"/>
                <field name="max_stops_per_route"/>
                <field name="collection_point_count"/>
            </list>
        </field>
    </record>

    <!-- View: wm.service.zone - wm.service.zone.form (Form) -->
    <record id="view_wm_service_zone_form" model="ir.ui.view">
        <field name="name">wm.service.zone.form</field>
        <field name="model">wm.service.zone</field>
        <field name="arch" type="xml">
            <form string="Service Zone">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Zone Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_vehicle_id"/>
                            <field name="default_driver_id"/>
                            <field name="max_stops_per_route"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Collection Points" name="collection_points">
                            <field name="collection_point_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="city"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Service Zones -->
    <record id="action_wm_service_zone" model="ir.actions.act_window">
        <field name="name">Service Zones</field>
        <field name="res_model">wm.service.zone</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
