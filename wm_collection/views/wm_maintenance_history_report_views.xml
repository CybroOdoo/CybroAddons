<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.maintenance.history.report - wm.maintenance.history.report.pivot (Pivot) -->
    <record id="view_wm_maintenance_history_report_pivot" model="ir.ui.view">
        <field name="name">wm.maintenance.history.report.pivot</field>
        <field name="model">wm.maintenance.history.report</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance History" sample="1">
                <field name="vehicle_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="pass_rate" type="measure"/>
                <field name="passed_checks" type="measure"/>
                <field name="total_checks" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- View: wm.maintenance.history.report - wm.maintenance.history.report.graph (Graph) -->
    <record id="view_wm_maintenance_history_report_graph" model="ir.ui.view">
        <field name="name">wm.maintenance.history.report.graph</field>
        <field name="model">wm.maintenance.history.report</field>
        <field name="arch" type="xml">
            <graph string="Maintenance History" type="bar" sample="1">
                <field name="vehicle_id"/>
                <field name="pass_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- View: wm.maintenance.history.report - wm.maintenance.history.report.list (List) -->
    <record id="view_wm_maintenance_history_report_list" model="ir.ui.view">
        <field name="name">wm.maintenance.history.report.list</field>
        <field name="model">wm.maintenance.history.report</field>
        <field name="arch" type="xml">
            <list string="Maintenance History Analysis">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="total_checks"/>
                <field name="passed_checks"/>
                <field name="pass_rate"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- View: wm.maintenance.history.report - wm.maintenance.history.report.search (Search) -->
    <record id="view_wm_maintenance_history_report_search" model="ir.ui.view">
        <field name="name">wm.maintenance.history.report.search</field>
        <field name="model">wm.maintenance.history.report</field>
        <field name="arch" type="xml">
            <search string="Maintenance History">
                <field name="vehicle_id"/>
                <group>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Maintenance History -->
    <record id="action_wm_maintenance_history_report" model="ir.actions.act_window">
        <field name="name">Maintenance History</field>
        <field name="res_model">wm.maintenance.history.report</field>
        <field name="view_mode">graph,list,pivot</field>
    </record>
</odoo>
