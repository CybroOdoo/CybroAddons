<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.collection.point - wm.collection.point.list (List) -->
    <record id="view_wm_collection_point_list" model="ir.ui.view">
        <field name="name">wm.collection.point.list</field>
        <field name="model">wm.collection.point</field>
        <field name="arch" type="xml">
            <list string="Collection Points">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="zone_id" optional="show"/>
                <field name="city"/>
                <field name="state_id"/>
            </list>
        </field>
    </record>

    <!-- View: wm.collection.point - wm.collection.point.form (Form) -->
    <record id="view_wm_collection_point_form" model="ir.ui.view">
        <field name="name">wm.collection.point.form</field>
        <field name="model">wm.collection.point</field>
        <field name="arch" type="xml">
            <form string="Collection Point">
                <field name="use_route_zones" invisible="1"/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_geo_localize" type="object"
                                class="oe_stat_button" icon="fa-map-marker"
                                string="Geolocate">
                        </button>
                        <button name="action_view_map" type="object"
                                class="oe_stat_button" icon="fa-globe"
                                string="Map View">
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Site Name (e.g. Main Collection Site)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="zone_id" invisible="not use_route_zones"/>
                            <field name="category_ids" widget="many2many_tags"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                        <group>
                            <span class="o_form_label o_td_label" name="address_name">
                                <b>Address</b>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <div name="div_country">
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                </div>
                            </div>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- View: wm.collection.point - wm.collection.point.map (Map) -->
    <record id="view_wm_collection_point_map" model="ir.ui.view">
        <field name="name">wm.collection.point.map</field>
        <field name="model">wm.collection.point</field>
        <field name="type">map</field>
        <field name="arch" type="xml">
            <map>
                <field name="latitude" string="Latitude"/>
                <field name="longitude" string="Longitude"/>
                <field name="contact_address" string="Address"/>
            </map>
        </field>
    </record>

    <!-- Action: Collection Points -->
    <record id="action_wm_collection_point" model="ir.actions.act_window">
        <field name="name">Collection Points</field>
        <field name="res_model">wm.collection.point</field>
        <field name="view_mode">list,form,map</field>
    </record>
</odoo>
