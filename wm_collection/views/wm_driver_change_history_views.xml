<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.driver.change.history - wm.driver.change.history.list (List) -->
    <record id="view_wm_driver_change_history_list" model="ir.ui.view">
        <field name="name">wm.driver.change.history.list</field>
        <field name="model">wm.driver.change.history</field>
        <field name="arch" type="xml">
            <list string="Driver Change History" create="0" edit="0">
                <field name="date_changed"/>
                <field name="route_id"/>
                <field name="old_driver_id"/>
                <field name="new_driver_id"/>
                <field name="reason"/>
                <field name="changed_by_id"/>
            </list>
        </field>
    </record>

    <!-- View: wm.driver.change.history - wm.driver.change.history.form (Form) -->
    <record id="view_wm_driver_change_history_form" model="ir.ui.view">
        <field name="name">wm.driver.change.history.form</field>
        <field name="model">wm.driver.change.history</field>
        <field name="arch" type="xml">
            <form string="Driver Change History" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Route Details">
                            <field name="route_id"/>
                            <field name="date_changed"/>
                            <field name="changed_by_id"/>
                        </group>
                        <group string="Driver Assignment">
                            <field name="old_driver_id"/>
                            <field name="new_driver_id"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View: wm.driver.change.history - Search -->
    <record id="view_wm_driver_change_history_search" model="ir.ui.view">
        <field name="name">wm.driver.change.history.search</field>
        <field name="model">wm.driver.change.history</field>
        <field name="arch" type="xml">
            <search string="Search Driver Change History">
                <field name="route_id"/>
                <field name="old_driver_id"/>
                <field name="new_driver_id"/>
                <field name="changed_by_id"/>
                <group>
                    <filter string="Route" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="New Driver" name="group_new_driver" context="{'group_by': 'new_driver_id'}"/>
                    <filter string="Changed By" name="group_changed_by" context="{'group_by': 'changed_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Driver Change History -->
    <record id="action_wm_driver_change_history" model="ir.actions.act_window">
        <field name="name">Driver Change History</field>
        <field name="res_model">wm.driver.change.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wm_driver_change_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No driver reassignment records found</p>
            <p>Driver change logs are recorded automatically when a route driver is reassigned.</p>
        </field>
    </record>
</odoo>
