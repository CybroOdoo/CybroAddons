<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.waste.material.sort.config - wm.waste.material.sort.config.list (List) -->
    <record id="view_wm_waste_material_sort_config_list" model="ir.ui.view">
        <field name="name">wm.waste.material.sort.config.list</field>
        <field name="model">wm.waste.material.sort.config</field>
        <field name="arch" type="xml">
            <list string="Material Sort Configuration">
                <field name="name"/>
                <field name="material_id" domain="[('is_waste_material', '=', True)]" options="{'no_create': True}"/>
                <field name="category_id" readonly="1"/>
                <field name="dest_product_id" options="{'no_create': True}"/>
                <field name="dest_location_id" options="{'no_create': True}"/>
                <field name="notes" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- View: wm.waste.material.sort.config - wm.waste.material.sort.config.form (Form) -->
    <record id="view_wm_waste_material_sort_config_form" model="ir.ui.view">
        <field name="name">wm.waste.material.sort.config.form</field>
        <field name="model">wm.waste.material.sort.config</field>
        <field name="arch" type="xml">
            <form string="Material Sort Configuration">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active == True"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Material Details">
                            <field name="material_id" domain="[('is_waste_material', '=', True)]" options="{'no_create': True}"/>
                            <field name="category_id" readonly="1"/>
                        </group>
                        <group string="Sorting Destination">
                            <field name="dest_product_id" options="{'no_create': True}"/>
                            <field name="dest_location_id" options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add optional sorting notes or instructions here..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action: Material Sort Configuration -->
    <record id="action_wm_waste_material_sort_config" model="ir.actions.act_window">
        <field name="name">Material Sort Configuration</field>
        <field name="res_model">wm.waste.material.sort.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure a default sort destination for a waste material
            </p>
            <p>
                For each material, set its recycling method and the product
                and location it should be sorted into. The Sort Batch wizard
                uses this to pre-fill sorting decisions automatically.
            </p>
        </field>
    </record>
</odoo>
