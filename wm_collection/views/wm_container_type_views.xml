<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View extension: wm.container.type - form view inherit in wm_collection -->
    <record id="view_wm_container_type_form_inherit_collection" model="ir.ui.view">
        <field name="name">wm.container.type.form.inherit.collection</field>
        <field name="model">wm.container.type</field>
        <field name="inherit_id" ref="wm_base.view_wm_container_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_individual_containers" type="object" class="oe_stat_button" icon="fa-archive" invisible="unit_count == 0">
                    <field name="unit_count" widget="statinfo" string="Physical Units"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
