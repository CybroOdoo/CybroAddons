<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action: Maintenance Checklists -->
    <record id="action_wm_survey_user_input" model="ir.actions.act_window">
        <field name="name">Maintenance Checklists</field>
        <field name="res_model">survey.user_input</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="wm_collection.view_wm_survey_user_input_list"/>
        <field name="domain">[('checklist_type', '!=', False)]</field>
        <field name="context">{'default_checklist_type': 'pre_trip'}</field>
    </record>

    <!-- Menu: Maintenance Checklists -->
    <menuitem id="menu_wm_vehicle_maintenance_checklist" name="Maintenance Checklists" parent="fleet.menu_root" action="action_wm_survey_user_input" sequence="90"/>
    <!-- Menu: Fleet Availability -->
    <menuitem id="menu_wm_driver_shift" name="Fleet Availability" parent="fleet.menu_root" action="action_wm_driver_shift" sequence="91"/>

    <!-- Action: Checklist Templates -->
    <record id="action_wm_survey_templates" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">survey.survey</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <!-- Menu: Checklist Templates -->
    <menuitem id="menu_wm_survey_templates" name="Checklist Templates" parent="fleet.fleet_configuration" action="action_wm_survey_templates" sequence="16"/>

    <!-- Configuration Menu for Checklist Items -->
    <menuitem id="menu_wm_checklist_item_pre_trip" name="Pre-Trip Checklist Items" parent="fleet.fleet_configuration" action="action_wm_checklist_item_pre_trip" sequence="17"/>
    <!-- Menu: Post-Trip Checklist Items -->
    <menuitem id="menu_wm_checklist_item_post_trip" name="Post-Trip Checklist Items" parent="fleet.fleet_configuration" action="action_wm_checklist_item_post_trip" sequence="18"/>

    <!-- Configuration for Compatible Containers -->
    <record id="action_wm_container" model="ir.actions.act_window">
        <field name="name">Compatible Containers</field>
        <field name="res_model">wm.container.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Menu: Compatible Containers -->
    <menuitem id="menu_wm_container" name="Compatible Containers" parent="fleet.fleet_configuration" action="action_wm_container" sequence="19"/>

    <!-- Reporting Submenu under Fleet -->
    <menuitem id="menu_wm_fleet_reporting" name="Reporting" parent="fleet.menu_root" sequence="95"/>
    <!-- Menu: Certificate & Licence Expiry -->
    <menuitem id="menu_wm_fleet_expiry_report" name="Certificate &amp; Licence Expiry" parent="menu_wm_fleet_reporting" action="action_wm_fleet_expiry_report" sequence="20"/>
    <!-- Menu: Maintenance History -->
    <menuitem id="menu_wm_maintenance_history_report" name="Maintenance History" parent="menu_wm_fleet_reporting" action="action_wm_maintenance_history_report" sequence="30"/>
</odoo>
