<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: waste.valuation.wizard - waste.valuation.wizard.form (Form) -->
    <record id="view_waste_valuation_wizard_form" model="ir.ui.view">
        <field name="name">waste.valuation.wizard.form</field>
        <field name="model">waste.valuation.wizard</field>
        <field name="arch" type="xml">
            <form string="Inventory Valuation Report">
                <group string="Filters">
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="warehouse_id" options="{'no_create': True}"/>
                        <field name="category_id" options="{'no_create': True}"/>
                        <field name="product_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" type="object"
                            string="Generate Report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server action to open wizard from list toolbar -->
    <record id="action_open_waste_valuation_wizard" model="ir.actions.act_window">
        <field name="name">Inventory Valuation</field>
        <field name="res_model">waste.valuation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
