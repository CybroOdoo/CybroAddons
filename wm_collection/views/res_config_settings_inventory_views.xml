<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: res.config.settings - res.config.settings.view.form.inherit.wm_collection.inventory (Xpath) -->
    <record id="res_config_settings_view_form_inherit_wm_collection_inventory" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.wm_collection.inventory</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="15"/>
        <field name="inherit_id" ref="wm_base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='wm_base']" position="inside">
                <block title="Inventory Workflow" name="wm_collection_inventory_workflow">
                    <setting id="use_batch_inspection" help="Enable batch inspection functionality." string="Batch Inspection">
                        <field name="use_batch_inspection"/>
                    </setting>
                </block>
                <block title="Logistics &amp; Tracking" name="wm_collection_inventory_logistics">
                    <setting id="use_batch_labels" help="Enable batch label printing." string="Batch Labels">
                        <field name="use_batch_labels"/>
                    </setting>
                </block>
                <block title="Sorting Configuration" name="wm_sorting_setting_container">
                    <setting id="wm_sort_based_on_setting"
                           string="Sort Based On"
                           help="Select the basis for sorting waste batches">
                        <field name="wm_sort_based_on" widget="radio"/>
                        <field name="group_sort_by_material" invisible="1"/>
                        <field name="group_sort_by_category" invisible="1"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
