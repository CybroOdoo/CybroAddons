<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.missed.reason - wm.missed.reason.list (List) -->
    <record id="view_wm_missed_reason_list" model="ir.ui.view">
        <field name="name">wm.missed.reason.list</field>
        <field name="model">wm.missed.reason</field>
        <field name="arch" type="xml">
            <list string="Missed Collection Reasons" editable="bottom">
                <field name="name"/>

            </list>
        </field>
    </record>

    <!-- Action: Missed Collection Reasons -->
    <record id="action_wm_missed_reason" model="ir.actions.act_window">
        <field name="name">Missed Collection Reasons</field>
        <field name="res_model">wm.missed.reason</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menu: Missed Collection Reasons -->
    <menuitem id="menu_wm_missed_reason" name="Missed Collection Reasons" parent="wm_base.menu_wm_config" action="action_wm_missed_reason" sequence="40"/>
</odoo>
