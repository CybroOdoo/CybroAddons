<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Sort Batch Wizard ───────────────────────────────────────────── -->
    <record id="view_waste_batch_sort_wizard_form" model="ir.ui.view">
        <field name="name">waste.batch.sort.wizard.form</field>
        <field name="model">waste.batch.sort.wizard</field>
        <field name="arch" type="xml">
            <form string="Sort Waste Batch">
                <group>
                    <group>
                        <field name="batch_id" readonly="1"/>
                        <field name="source_location_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="output_batch_mode" widget="radio"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sequence" widget="handle"/>
                        <field name="batch_line_id" column_invisible="1"/>

                        <field name="material_id" readonly="1"/>
                        <field name="category_id" readonly="1"/>
                        <field name="remaining_qty" readonly="1"/>
                        <field name="source_uom_id" readonly="1" string="UoM"/>
                        <field name="sort_qty"/>
                        <field name="dest_product_id" options="{'no_create': True}"/>
                        <field name="dest_location_id" options="{'no_create': True}"/>

                    </list>
                </field>
                <field name="notes" placeholder="Optional sorting notes…"/>
                <footer>
                    <button name="action_confirm_sort" type="object"
                            string="Confirm Sort" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: Sort Batch -->
    <record id="action_waste_batch_sort_wizard" model="ir.actions.act_window">
        <field name="name">Sort Batch</field>
        <field name="res_model">waste.batch.sort.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
