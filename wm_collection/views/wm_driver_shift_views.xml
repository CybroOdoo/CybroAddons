<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.driver.shift - wm.driver.shift.form (Form) -->
    <record id="view_wm_driver_shift_form" model="ir.ui.view">
        <field name="name">wm.driver.shift.form</field>
        <field name="model">wm.driver.shift</field>
        <field name="arch" type="xml">
            <form string="Driver Shift">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="driver_id"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group>
                            <field name="shift_start"/>
                            <field name="shift_end"/>
                            <field name="hours_driven"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- View: wm.driver.shift - wm.driver.shift.list (List) -->
    <record id="view_wm_driver_shift_list" model="ir.ui.view">
        <field name="name">wm.driver.shift.list</field>
        <field name="model">wm.driver.shift</field>
        <field name="arch" type="xml">
            <list string="Driver Shifts">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="shift_start"/>
                <field name="shift_end"/>
                <field name="hours_driven"/>
            </list>
        </field>
    </record>

    <!-- View: wm.driver.shift - wm.driver.shift.calendar (Calendar) -->
    <record id="view_wm_driver_shift_calendar" model="ir.ui.view">
        <field name="name">wm.driver.shift.calendar</field>
        <field name="model">wm.driver.shift</field>
        <field name="arch" type="xml">
            <calendar string="Vehicle Availability" date_start="shift_start" date_stop="shift_end" color="vehicle_id" mode="month">
                <field name="driver_id"/>
                <field name="vehicle_id" filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- Action: Fleet Availability -->
    <record id="action_wm_driver_shift" model="ir.actions.act_window">
        <field name="name">Fleet Availability</field>
        <field name="res_model">wm.driver.shift</field>
        <field name="view_mode">list,calendar,form</field>
    </record>
</odoo>
