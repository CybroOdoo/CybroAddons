<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.route.efficiency.report - wm.route.efficiency.report.pivot (Pivot) -->
    <record id="view_wm_route_efficiency_report_pivot" model="ir.ui.view">
        <field name="name">wm.route.efficiency.report.pivot</field>
        <field name="model">wm.route.efficiency.report</field>
        <field name="arch" type="xml">
            <pivot string="Route Efficiency" sample="1">
                <field name="driver_id" type="row"/>
                <field name="date" interval="week" type="col"/>
                <field name="completion_rate" type="measure"/>
                <field name="orders_completed" type="measure"/>
                <field name="points_planned" type="measure"/>
                <field name="distance_km" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- View: wm.route.efficiency.report - wm.route.efficiency.report.graph (Graph) -->
    <record id="view_wm_route_efficiency_report_graph" model="ir.ui.view">
        <field name="name">wm.route.efficiency.report.graph</field>
        <field name="model">wm.route.efficiency.report</field>
        <field name="arch" type="xml">
            <graph string="Route Efficiency" type="bar" sample="1">
                <field name="driver_id"/>
                <field name="completion_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- View: wm.route.efficiency.report - wm.route.efficiency.report.list (List) -->
    <record id="view_wm_route_efficiency_report_list" model="ir.ui.view">
        <field name="name">wm.route.efficiency.report.list</field>
        <field name="model">wm.route.efficiency.report</field>
        <field name="arch" type="xml">
            <list string="Route Efficiency Analysis">
                <field name="date"/>
                <field name="route_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="points_planned"/>
                <field name="orders_completed"/>
                <field name="completion_rate"/>
                <field name="distance_km"/>
                <field name="estimated_mins"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- View: wm.route.efficiency.report - wm.route.efficiency.report.search (Search) -->
    <record id="view_wm_route_efficiency_report_search" model="ir.ui.view">
        <field name="name">wm.route.efficiency.report.search</field>
        <field name="model">wm.route.efficiency.report</field>
        <field name="arch" type="xml">
            <search string="Route Efficiency">
                <field name="route_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <group>
                    <filter string="Driver" name="group_driver" context="{'group_by':'driver_id'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                    <filter string="Date (Week)" name="group_date_week" context="{'group_by':'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Route Efficiency -->
    <record id="action_wm_route_efficiency_report" model="ir.actions.act_window">
        <field name="name">Route Efficiency</field>
        <field name="res_model">wm.route.efficiency.report</field>
        <field name="view_mode">graph,list,pivot</field>
    </record>
</odoo>
