<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.signature - List -->
    <record id="view_wm_signature_list" model="ir.ui.view">
        <field name="name">wm.signature.list</field>
        <field name="model">wm.signature</field>
        <field name="arch" type="xml">
            <list string="Signatures">
                <field name="name"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- View: wm.signature - Form -->
    <record id="view_wm_signature_form" model="ir.ui.view">
        <field name="name">wm.signature.form</field>
        <field name="model">wm.signature</field>
        <field name="arch" type="xml">
            <form string="Signature">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="signature" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View: wm.signature - Search -->
    <record id="view_wm_signature_search" model="ir.ui.view">
        <field name="name">wm.signature.search</field>
        <field name="model">wm.signature</field>
        <field name="arch" type="xml">
            <search string="Search Signatures">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action: Signatures -->
    <record id="action_wm_signature" model="ir.actions.act_window">
        <field name="name">Handover Signatures</field>
        <field name="res_model">wm.signature</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wm_signature_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No signatures recorded</p>
            <p>Digital signatures captured during collection order handovers appear here.</p>
        </field>
    </record>
</odoo>
