<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: fleet.vehicle - fleet.vehicle.form.inherit.wm.fleet (Xpath) -->
    <record id="view_fleet_vehicle_form_inherit_wm_fleet" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.wm.fleet</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='note']" position="after">
                <page string="Waste Management" name="waste_management">
                    <group>
                        <group>
                            <field name="wm_capacity_volume"/>
                            <field name="wm_capacity_weight"/>
                        </group>
                        <group>
                            <field name="wm_container_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
