<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: wm.collection.report - wm.collection.report.pivot (Pivot) -->
    <record id="view_wm_collection_report_pivot" model="ir.ui.view">
        <field name="name">wm.collection.report.pivot</field>
        <field name="model">wm.collection.report</field>
        <field name="arch" type="xml">
            <pivot string="Collection Analysis" sample="1">
                <field name="waste_category_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="weight_kg" type="measure"/>
                <field name="order_count" type="measure"/>
                <field name="volume_l" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- View: wm.collection.report - wm.collection.report.graph (Graph) -->
    <record id="view_wm_collection_report_graph" model="ir.ui.view">
        <field name="name">wm.collection.report.graph</field>
        <field name="model">wm.collection.report</field>
        <field name="arch" type="xml">
            <graph string="Collection Analysis" type="bar" sample="1">
                <field name="waste_category_id"/>
                <field name="weight_kg" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- View: wm.collection.report - wm.collection.report.list (List) -->
    <record id="view_wm_collection_report_list" model="ir.ui.view">
        <field name="name">wm.collection.report.list</field>
        <field name="model">wm.collection.report</field>
        <field name="arch" type="xml">
            <list string="Collection Analysis">
                <field name="date"/>
                <field name="waste_category_id"/>
                <field name="collection_point_id"/>
                <field name="partner_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="weight_kg"/>
                <field name="order_count"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- View: wm.collection.report - wm.collection.report.search (Search) -->
    <record id="view_wm_collection_report_search" model="ir.ui.view">
        <field name="name">wm.collection.report.search</field>
        <field name="model">wm.collection.report</field>
        <field name="arch" type="xml">
            <search string="Collection Analysis">
                <field name="waste_category_id"/>
                <field name="collection_point_id"/>
                <field name="partner_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <filter string="Completed Orders" name="completed" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter string="Waste Category" name="group_waste_category" context="{'group_by':'waste_category_id'}"/>
                    <filter string="Collection Point" name="group_point" context="{'group_by':'collection_point_id'}"/>
                    <filter string="Driver" name="group_driver" context="{'group_by':'driver_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Collection Analysis -->
    <record id="action_wm_collection_report_analysis" model="ir.actions.act_window">
        <field name="name">Collection Analysis</field>
        <field name="res_model">wm.collection.report</field>
        <field name="view_mode">graph,list,pivot</field>
        <field name="context">{'search_default_done_states': 1}</field>
    </record>
</odoo>
