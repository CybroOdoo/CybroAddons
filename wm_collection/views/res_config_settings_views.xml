<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: res.config.settings - res.config.settings.view.form.inherit.wm_collection (Xpath) -->
    <record id="res_config_settings_view_form_wm_collection" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.wm_collection</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="wm_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='wm_base']" position="inside">
                <block title="Route Dispatching" name="wm_collection_dispatch_settings">
                    <setting
                        id="use_route_zones"
                        string="Service Zones &amp; Auto-Assignment"
                        help="Enable geographic service zones and daily automated assignment of collection orders to zoned routes.">
                        <field name="use_route_zones"/>
                    </setting>
                    <setting
                        id="wm_auto_dispatch_enabled"
                        string="Auto-Dispatch Ready Routes"
                        help="Automatically dispatch routes that are fully staffed and whose orders are all ready. When off, routes are flagged as ready but must be dispatched manually.">
                        <field name="wm_auto_dispatch_enabled"/>
                    </setting>
                </block>
                <block title="Collection Operations" name="wm_collection_ops_settings">
                    <setting
                        id="use_missed_collection"
                        string="Missed Collections"
                        help="Enable missed collection tracking, reason management, and retry workflows.">
                        <field name="use_missed_collection"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
