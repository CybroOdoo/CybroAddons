<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wm_collection.WmRouteMap">
        <div class="o_action_manager h-100 w-100 d-flex flex-column">
            <Layout className="'o_map_view h-100 d-flex flex-column'" display="display">
                <div class="wm-route-map-container flex-grow-1 position-relative w-100 h-100" style="min-height: 400px; overflow: hidden;">
                    <div class="position-absolute top-0 start-0 m-3 z-index-1000 bg-white p-3 rounded shadow-sm border border-secondary border-opacity-25" style="z-index: 1000; min-width: 250px;">
                        <button type="button" class="btn btn-outline-secondary btn-sm mb-3 w-100 d-flex align-items-center justify-content-center gap-2" t-on-click="onBackToRoute">
                            <i class="fa fa-arrow-left"></i> <span>Back to Route</span>
                        </button>
                        <h6 class="mb-1 text-primary fw-bold">
                            <i class="fa fa-map-signs me-1"></i> <t t-esc="state.routeName"/>
                        </h6>
                        <div class="d-flex align-items-center gap-3 text-muted small mt-2">
                            <div>
                                <i class="fa fa-map-marker text-danger me-1"></i>
                                <span class="fw-bold text-dark"><t t-esc="state.pointCount"/></span> Stops
                            </div>
                            <t t-if="state.totalDistance">
                                <div>
                                    <i class="fa fa-road text-info me-1"></i>
                                    <span class="fw-bold text-dark"><t t-esc="state.totalDistance"/></span> km
                                </div>
                            </t>
                            <t t-if="state.totalDuration">
                                <div>
                                    <i class="fa fa-clock-o text-warning me-1"></i>
                                    <span class="fw-bold text-dark"><t t-esc="state.totalDuration"/></span> min
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="h-100 w-100" t-ref="mapContainer"></div>
                </div>
            </Layout>
        </div>
    </t>
    <t t-name="wm_collection.WmRouteMapField">
        <div class="wm-route-map-field-wrapper position-relative w-100 rounded border shadow-sm overflow-hidden" style="height: 500px; min-height: 500px; background-color: #f8f9fa;">
            <div class="position-absolute top-0 start-0 m-3 bg-white p-2 px-3 rounded shadow-sm border" style="z-index: 1000; min-width: 220px; opacity: 0.95;">
                <h6 class="mb-1 text-primary fw-bold small">
                    <i class="fa fa-map-signs me-1"></i> Route Map Summary
                </h6>
                <div class="d-flex align-items-center gap-3 text-muted small mt-1">
                    <div>
                        <i class="fa fa-map-marker text-danger me-1"></i>
                        <span class="fw-bold text-dark"><t t-esc="state.pointCount"/></span> Stops
                    </div>
                    <t t-if="state.totalDistance">
                        <div>
                            <i class="fa fa-road text-info me-1"></i>
                            <span class="fw-bold text-dark"><t t-esc="state.totalDistance"/></span> km
                        </div>
                    </t>
                    <t t-if="state.totalDuration">
                        <div>
                            <i class="fa fa-clock-o text-warning me-1"></i>
                            <span class="fw-bold text-dark"><t t-esc="state.totalDuration"/></span> min
                        </div>
                    </t>
                </div>
            </div>
            <div class="w-100 h-100" style="height: 500px !important; min-height: 500px;" t-ref="mapContainer"></div>
        </div>
    </t>
</templates>
