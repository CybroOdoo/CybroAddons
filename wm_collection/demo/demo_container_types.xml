<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- CONTAINER TYPES DEMO DATA                                          -->
    <!-- Categories are referenced from wm_base demo records.              -->
    <!-- is_hazardous_suitable = True  → appears in hazardous-batch filter -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── General Municipal / Dry-Waste Containers ─────────────────── -->

    <record id="ct_wheelie_bin_240" model="wm.container.type">
        <field name="name">240 L Wheelie Bin</field>
        <field name="code">WB-240</field>
        <field name="capacity">240.0</field>
        <field name="default_tare_weight">14.5</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.waste_category_recycle')),
                                          (4, ref('wm_base.waste_category_organic'))]"/>
        <field name="description">
            Standard 240-litre two-wheeled bin for kerbside dry-recyclable
            and organic collection. HDPE construction; colour-coded lids
            available (yellow/green/red). Tare weight 14.5 kg per unit.
        </field>
    </record>

    <!-- Record: wm.container.type - 1100 L Euro Wheelie Bin -->
    <record id="ct_wheelie_bin_1100" model="wm.container.type">
        <field name="name">1100 L Euro Wheelie Bin</field>
        <field name="code">WB-1100</field>
        <field name="capacity">1100.0</field>
        <field name="default_tare_weight">52.0</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.waste_category_recycle')),
                                          (4, ref('wm_base.waste_category_organic')),
                                          (4, ref('wm_base.wcat_industrial'))]"/>
        <field name="description">
            Heavy-duty 1100-litre four-wheeled Euro container for commercial
            and industrial premises. Galvanised steel lid; capacity for high
            volume dry-recyclable, organic and light industrial waste streams.
        </field>
    </record>

    <!-- ─── Skip / Roll-off Containers ──────────────────────────────── -->

    <record id="ct_skip_bin_4m3" model="wm.container.type">
        <field name="name">4 m³ Skip Bin</field>
        <field name="code">SK-4</field>
        <field name="capacity">4000.0</field>
        <field name="default_tare_weight">850.0</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.wcat_construction')),
                                          (4, ref('wm_base.waste_category_recycle')),
                                          (4, ref('wm_base.wcat_industrial'))]"/>
        <field name="description">
            Standard 4 m³ open-top skip for construction, demolition and
            general industrial waste. Heavy-gauge mild-steel construction;
            hook-lift or skip-truck compatible. Max gross load 4 t.
        </field>
    </record>

    <!-- Record: wm.container.type - 10 m³ Skip Bin -->
    <record id="ct_skip_bin_10m3" model="wm.container.type">
        <field name="name">10 m³ Skip Bin</field>
        <field name="code">SK-10</field>
        <field name="capacity">10000.0</field>
        <field name="default_tare_weight">1600.0</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.wcat_construction')),
                                          (4, ref('wm_base.waste_category_recycle')),
                                          (4, ref('wm_base.wcat_industrial'))]"/>
        <field name="description">
            Large 10 m³ marrel skip for bulk C&amp;D rubble and industrial
            waste. Chain-lift compatible; drop-door end for walk-in loading.
        </field>
    </record>

    <!-- Record: wm.container.type - 20 m³ Roll-off Container -->
    <record id="ct_rolloff_20m3" model="wm.container.type">
        <field name="name">20 m³ Roll-off Container</field>
        <field name="code">RO-20</field>
        <field name="capacity">20000.0</field>
        <field name="default_tare_weight">3200.0</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.wcat_construction')),
                                          (4, ref('wm_base.waste_category_recycle')),
                                          (4, ref('wm_base.wcat_industrial'))]"/>
        <field name="description">
            20 m³ compactor-ready roll-off container for high-volume site
            clearance, bulk cardboard and light industrial mixed waste.
            Telescopic tarp cover available. Suits hook-lift trucks.
        </field>
    </record>

    <!-- ─── Drums — Hazardous / Chemical ─────────────────────────────── -->

    <record id="ct_steel_drum_205l" model="wm.container.type">
        <field name="name">205 L Closed-Top Steel Drum</field>
        <field name="code">SD-205</field>
        <field name="capacity">205.0</field>
        <field name="default_tare_weight">19.0</field>
        <field name="is_hazardous_suitable" eval="True"/>
        <field name="category_ids" eval="[(4, ref('wm_base.waste_category_hazard')),
                                          (4, ref('wm_base.wcat_industrial')),
                                          (4, ref('wm_base.wcat_ewaste'))]"/>
        <field name="description">
            UN-approved 1A1 closed-top steel drum for liquid hazardous waste
            (used oils, solvents, chemical by-products). 2 mm wall thickness;
            UN 1A1/X1.9/300 rating. Bung closure with tamper-evident seal.
            Tare weight 19 kg; max gross mass 300 kg.
        </field>
    </record>

    <!-- Record: wm.container.type - 220 L Poly (HDPE) Drum -->
    <record id="ct_poly_drum_220l" model="wm.container.type">
        <field name="name">220 L Poly (HDPE) Drum</field>
        <field name="code">PD-220</field>
        <field name="capacity">220.0</field>
        <field name="default_tare_weight">11.5</field>
        <field name="is_hazardous_suitable" eval="True"/>
        <field name="category_ids" eval="[(4, ref('wm_base.waste_category_hazard')),
                                          (4, ref('wm_base.wcat_industrial'))]"/>
        <field name="description">
            UN-certified 220 L HDPE closed-head drum for corrosive and
            chemical liquid waste. Chemical-resistant natural HDPE; suitable
            for pH 1–14 liquids. UN 1H1/Y1.9/150. Lighter than steel —
            tare 11.5 kg.
        </field>
    </record>

    <!-- ─── IBC Tote ──────────────────────────────────────────────────── -->

    <record id="ct_ibc_tote_1000l" model="wm.container.type">
        <field name="name">1000 L IBC Tote</field>
        <field name="code">IBC-1000</field>
        <field name="capacity">1000.0</field>
        <field name="default_tare_weight">60.0</field>
        <field name="is_hazardous_suitable" eval="True"/>
        <field name="category_ids" eval="[(4, ref('wm_base.waste_category_hazard')),
                                          (4, ref('wm_base.wcat_industrial')),
                                          (4, ref('wm_base.wcat_ewaste'))]"/>
        <field name="description">
            1000-litre Intermediate Bulk Container (IBC) with HDPE inner
            bottle, galvanised steel cage and pallet base. UN 31HA1/Y/
            rating for liquid hazardous waste including used oils, solvents
            and chemical rinse waters. DN150 top fill, DN80 bottom outlet.
            Tare weight 60 kg; max gross 1250 kg.
        </field>
    </record>

    <!-- ─── Specialist Hazardous / Safety Containers ─────────────────── -->

    <record id="ct_antistatic_bin_60l" model="wm.container.type">
        <field name="name">60 L Anti-Static ESD Bin</field>
        <field name="code">ESD-60</field>
        <field name="capacity">60.0</field>
        <field name="default_tare_weight">3.2</field>
        <field name="is_hazardous_suitable" eval="True"/>
        <field name="category_ids" eval="[(4, ref('wm_base.wcat_ewaste')),
                                          (4, ref('wm_base.waste_category_hazard'))]"/>
        <field name="description">
            Conductive polyethylene 60 L bin rated &lt;10⁴ Ω surface
            resistance for safe collection of ESD-sensitive electronic
            scrap (PCBs, batteries, capacitors). Prevents static discharge
            in Class I/II hazardous areas. Lid with ESD label required.
        </field>
    </record>

    <!-- Record: wm.container.type - 5 L Sharps Container (Biomedical) -->
    <record id="ct_sharps_container_5l" model="wm.container.type">
        <field name="name">5 L Sharps Container (Biomedical)</field>
        <field name="code">SH-5</field>
        <field name="capacity">5.0</field>
        <field name="default_tare_weight">0.28</field>
        <field name="is_hazardous_suitable" eval="True"/>
        <field name="category_ids" eval="[(4, ref('wm_base.wcat_biomedical'))]"/>
        <field name="description">
            UN3291-compliant puncture-resistant polypropylene sharps
            container for used hypodermic needles, lancets and scalpels.
            One-way locking lid; permanently sealed at ¾ fill marker.
            Yellow body per WHO colour coding for infectious waste. 5 L
            capacity; tare 280 g.
        </field>
    </record>

    <!-- Record: wm.container.type - 30 L Biohazard Bag (Autoclavable) -->
    <record id="ct_biohazard_bag_30l" model="wm.container.type">
        <field name="name">30 L Biohazard Bag (Autoclavable)</field>
        <field name="code">BHB-30</field>
        <field name="capacity">30.0</field>
        <field name="default_tare_weight">0.06</field>
        <field name="is_hazardous_suitable" eval="True"/>
        <field name="category_ids" eval="[(4, ref('wm_base.wcat_biomedical')),
                                          (4, ref('wm_base.waste_category_hazard'))]"/>
        <field name="description">
            30 L autoclave-rated LDPE biohazard bag for infectious and
            pathological waste. Printed with universal biohazard symbol and
            autoclave indicator strip. Red or yellow per local regulation.
            Rated to 134 °C / 3 bar for pre-treatment steam sterilisation.
        </field>
    </record>

    <!-- ─── Recycling / Sorting Containers ───────────────────────────── -->

    <record id="ct_recycling_cage_1m3" model="wm.container.type">
        <field name="name">1 m³ Wire Mesh Recycling Cage</field>
        <field name="code">RC-1000</field>
        <field name="capacity">1000.0</field>
        <field name="default_tare_weight">48.0</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.waste_category_recycle')),
                                          (4, ref('wm_base.wcat_ewaste')),
                                          (4, ref('wm_base.wcat_industrial'))]"/>
        <field name="description">
            Galvanised wire mesh pallet cage (1 m³) on steel skid base for
            loose dry recyclables — paper, cardboard, cans and e-scrap.
            Collapsible for return logistics; 500 kg capacity. Yellow RAL
            1021 powder-coat standard.
        </field>
    </record>

    <!-- Record: wm.container.type - 60 L Plastic Stacking Crate -->
    <record id="ct_plastic_crate_60l" model="wm.container.type">
        <field name="name">60 L Plastic Stacking Crate</field>
        <field name="code">PC-60</field>
        <field name="capacity">60.0</field>
        <field name="default_tare_weight">2.1</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.waste_category_recycle')),
                                          (4, ref('wm_base.wcat_industrial'))]"/>
        <field name="description">
            Ventilated PP stacking crate 600 × 400 × 310 mm for sorted
            dry recyclables, metal offcuts and plastic components. Nestle-
            stack design; handles 25 kg working load. Food-grade grade
            available for organic sorting pre-composting.
        </field>
    </record>

    <!-- ─── Organics / Compost ────────────────────────────────────────── -->

    <record id="ct_compost_bin_220l" model="wm.container.type">
        <field name="name">220 L Compost Tumbler Bin</field>
        <field name="code">CB-220</field>
        <field name="capacity">220.0</field>
        <field name="default_tare_weight">12.0</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.waste_category_organic'))]"/>
        <field name="description">
            220 L twin-chamber tumbler compost bin for on-site organic waste
            treatment. UV-stabilised recycled HDPE; dual air vents; 360°
            rotation for aeration. Converts food and garden waste to compost
            in 4–6 weeks. Tare weight 12 kg.
        </field>
    </record>

    <!-- ─── Bulk / Flexible ───────────────────────────────────────────── -->

    <record id="ct_bulk_bag_fibc_1t" model="wm.container.type">
        <field name="name">1 t Bulk Bag (FIBC / Jumbo Bag)</field>
        <field name="code">FIBC-1T</field>
        <field name="capacity">1500.0</field>
        <field name="default_tare_weight">3.5</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.wcat_construction')),
                                          (4, ref('wm_base.waste_category_recycle')),
                                          (4, ref('wm_base.wcat_industrial'))]"/>
        <field name="description">
            Woven polypropylene Flexible Intermediate Bulk Container (FIBC)
            rated 1000 kg SWL (5:1 SF). Four-loop lift; discharge spout
            with tie cord. Suitable for dry C&amp;D rubble, granulated
            plastic, metal shavings and textile offcuts. Single-use or
            multi-trip type C available. Tare 3.5 kg.
        </field>
    </record>

    <!-- ─── Liquid Bulk / Tank ────────────────────────────────────────── -->

    <record id="ct_road_tanker_20000l" model="wm.container.type">
        <field name="name">20 000 L Road Tanker</field>
        <field name="code">RT-20K</field>
        <field name="capacity">20000.0</field>
        <field name="default_tare_weight">8500.0</field>
        <field name="is_hazardous_suitable" eval="True"/>
        <field name="category_ids" eval="[(4, ref('wm_base.waste_category_hazard')),
                                          (4, ref('wm_base.wcat_industrial'))]"/>
        <field name="description">
            20 000-litre stainless-steel ADR road tanker for bulk liquid
            hazardous waste transport (used oil, chemical effluent, spent
            solvents). Compartmentalised with top-manhole access and
            bottom-valve discharge. ADR/RID Class 3, 6.1, 8 rated.
            Tare approx. 8 500 kg; GVM 28 t.
        </field>
    </record>

    <!-- ─── Hopper / Industrial Process ──────────────────────────────── -->

    <record id="ct_hopper_bin_2m3" model="wm.container.type">
        <field name="name">2 m³ Hopper Bin</field>
        <field name="code">HB-2</field>
        <field name="capacity">2000.0</field>
        <field name="default_tare_weight">380.0</field>
        <field name="is_hazardous_suitable" eval="False"/>
        <field name="category_ids" eval="[(4, ref('wm_base.wcat_industrial')),
                                          (4, ref('wm_base.wcat_construction')),
                                          (4, ref('wm_base.waste_category_recycle'))]"/>
        <field name="description">
            2 m³ mild-steel forklift hopper bin with bottom-discharge gate
            for foundry sand, swarf, rubber crumb and granulated plastic.
            Fork pockets on two sides; optional dust-flap lid. Powder-coated
            safety yellow; 2 000 kg capacity. Tare 380 kg.
        </field>
    </record>

</odoo>
