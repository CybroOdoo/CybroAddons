<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- DRIVER SHIFTS -->
    <record id="demo_shift_1" model="wm.driver.shift">
        <field name="driver_id" ref="base.res_partner_1"/>
        <field name="vehicle_id" ref="demo_vehicle_garbage_1"/>
        <field name="shift_start" eval="(DateTime.today() - relativedelta(days=1, hours=-8)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="shift_end" eval="(DateTime.today() - relativedelta(days=1, hours=-16)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- Record: wm.driver.shift (demo_shift_2) -->
    <record id="demo_shift_2" model="wm.driver.shift">
        <field name="driver_id" ref="base.res_partner_1"/>
        <field name="vehicle_id" ref="demo_vehicle_garbage_1"/>
        <field name="shift_start" eval="(DateTime.today() + relativedelta(hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <!-- shift_end is empty as it's currently in progress -->
    </record>

    <!-- Record: wm.driver.shift (demo_shift_3) -->
    <record id="demo_shift_3" model="wm.driver.shift">
        <field name="driver_id" ref="base.res_partner_address_31"/>
        <field name="vehicle_id" ref="fleet.vehicle_4"/>
        <field name="shift_start" eval="(DateTime.today() - relativedelta(days=2, hours=-6)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="shift_end" eval="(DateTime.today() - relativedelta(days=2, hours=-14)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- Record: wm.driver.shift (demo_shift_4) -->
    <record id="demo_shift_4" model="wm.driver.shift">
        <field name="driver_id" ref="base.res_partner_address_2"/>
        <field name="vehicle_id" ref="fleet.vehicle_1"/>
        <field name="shift_start" eval="(DateTime.today() - relativedelta(days=1, hours=-7)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="shift_end" eval="(DateTime.today() - relativedelta(days=1, hours=-15)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- Record: wm.driver.shift (demo_shift_5) -->
    <record id="demo_shift_5" model="wm.driver.shift">
        <field name="driver_id" ref="base.res_partner_12"/>
        <field name="vehicle_id" ref="fleet.vehicle_3"/>
        <field name="shift_start" eval="(DateTime.today() - relativedelta(hours=-6)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="shift_end" eval="(DateTime.today() - relativedelta(hours=-14)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

</odoo>
