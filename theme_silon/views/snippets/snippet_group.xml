<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="snippets" inherit_id="website.snippets">
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t snippet-group="silon" t-snippet="website.s_snippet_group" string="Silon"
               t-thumbnail="/theme_silon/static/src/img/snippets/snippet_group.svg"/>
        </xpath>
    </template>
</odoo>