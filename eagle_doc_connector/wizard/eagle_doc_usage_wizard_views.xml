<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eagle_doc_usage_wizard_form" model="ir.ui.view">
        <field name="name">eagle.doc.usage.wizard.form</field>
        <field name="model">eagle.doc.usage.wizard</field>
        <field name="arch" type="xml">
            <form string="Eagle Doc Usage">
                <group>
                    <group>
                        <field name="period_month" string="Month"/>
                        <field name="period_year" string="Year"/>
                    </group>
                    <group>
                        <field name="period" string="Showing" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <list create="false" delete="false">
                        <field name="feature_label" string="Feature"/>
                        <field name="quantity" string="Quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_fetch"
                            type="object"
                            string="Fetch Usage"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
