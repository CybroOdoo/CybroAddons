<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eagle_doc_feedback_wizard_form" model="ir.ui.view">
        <field name="name">eagle.doc.feedback.wizard.form</field>
        <field name="model">eagle.doc.feedback.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Correction to Eagle Doc">
                <field name="move_id" invisible="1"/>
                <group>
                    <field name="feedback_type" widget="radio"/>
                </group>
                <group invisible="feedback_type != 'vendor'">
                    <field name="new_vendor_name" required="feedback_type == 'vendor'"
                           placeholder="e.g. Buerobedarf Mueller GmbH"/>
                    <field name="new_vendor_account" required="feedback_type == 'vendor'"
                           placeholder="e.g. 70042"/>
                    <field name="new_vendor_city"/>
                    <field name="new_vendor_street"/>
                </group>
                <group invisible="feedback_type != 'product_account'">
                    <field name="product_name" placeholder="Leave empty for vendor-level correction"/>
                    <field name="new_bk_account_number" required="feedback_type == 'product_account'"
                           placeholder="e.g. 4930"/>
                    <field name="new_tax_code" placeholder="e.g. 9"/>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Send to Eagle Doc" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_eagle_doc_feedback_wizard" model="ir.actions.act_window">
        <field name="name">Send Correction to Eagle Doc</field>
        <field name="res_model">eagle.doc.feedback.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>