<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_eagle_doc" model="ir.ui.view">
        <field name="name">res.company.form.inherit.eagle.doc</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_eagle_create_sub_business"
                            type="object"
                            string="Create Eagle Doc Sub-Business"
                            class="btn-primary"
                            invisible="eagle_sub_business_id or not id"/>
                    <button name="action_eagle_refresh_sub_business"
                            type="object"
                            string="Refresh from Eagle Doc"
                            class="btn-secondary"
                            invisible="not eagle_sub_business_id"/>
                    <button name="action_eagle_update_sub_business"
                            type="object"
                            string="Update Eagle Doc Profile"
                            class="btn-secondary"
                            invisible="not eagle_sub_business_id or is_eagle_doc_profile_synced"/>
                    <button name="action_eagle_delete_sub_business"
                            type="object"
                            string="Delete Sub-Business from Eagle Doc"
                            class="btn-secondary"
                            confirm="This will soft-delete the sub-business on Eagle Doc's side. Continue?"
                            invisible="not eagle_sub_business_id"/>
                </header>
            </xpath>
            <xpath expr="//page[@name='general_info']//field[@name='currency_id']" position="after">
                <field name="is_eagle_doc_profile_synced" invisible="1"/>
                <field name="eagle_sub_business_id"
                       string="Eagle Doc Sub-Business ID"
                       readonly="1"
                       placeholder="Created automatically on first document upload"/>
                <field name="eagle_sub_business_industry"
                       invisible="eagle_sub_business_id"/>
                <field name="eagle_sub_business_account_type"
                       invisible="eagle_sub_business_id"/>
            </xpath>
        </field>
    </record>
</odoo>
