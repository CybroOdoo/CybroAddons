<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.eagle.doc.connector</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Eagle Doc Connector" string="Eagle Doc Connector" name="eagle_doc_connector">
                    <block title="Eagle Doc Connector" id="eagle_doc_connector_settings">
                        <setting string="Base URL" help="Base URL for Eagle Doc API">
                            <field name="eagle_doc_base_url" placeholder="https://api.eagledoc.io"/>/>
                        </setting>
                        <setting string="API Key" help="Store the Eagle Doc API Key.">
                            <field name="eagle_doc_api_key" password="True"/>
                        </setting>
                        <setting string="Usage" help="Check this month's Eagle Doc usage.">
                            <button name="action_eagle_doc_check_usage"
                                    type="object"
                                    string="Check Usage"
                                    class="btn-secondary"/>
                        </setting>
                    </block>
                    <block title="Eagle Doc Auto-Creation" id="eagle_doc_auto_create_settings">
                        <setting string="Auto-create Customer/Vendor"
                                 help="If disabled, a document with an unmatched customer/vendor is left without a partner.">
                            <field name="is_eagle_doc_auto_create_partner"/>
                        </setting>
                        <setting string="Auto-create Product"
                                 help="If disabled , unmatched product lines are kept as free text with no product linked.">
                            <field name="is_eagle_doc_auto_create_product"/>
                        </setting>
                        <setting string="Auto-create Tax"
                                 help="If disabled , unmatched tax is left blank on the line.">
                            <field name="is_eagle_doc_auto_create_tax"/>
                            <div class="content-group" invisible="not is_eagle_doc_auto_create_tax">
                                <div class="row mt16">
                                    <label for="eagle_doc_auto_tax_account_sale_id" class="col-lg-5 o_light_label" string="Sales Tax Account"/>
                                    <field name="eagle_doc_auto_tax_account_sale_id" placeholder="e.g. Tax Received (Suspense)" required="is_eagle_doc_auto_create_tax"/>
                                </div>
                                <div class="row mt8">
                                    <label for="eagle_doc_auto_tax_account_purchase_id" class="col-lg-5 o_light_label" string="Purchase Tax Account"/>
                                    <field name="eagle_doc_auto_tax_account_purchase_id" placeholder="e.g. Tax Paid (Suspense)" required="is_eagle_doc_auto_create_tax"/>
                                </div>
                                <div class="text-muted mt8">
                                    Required for auto-creating taxes in the
                                    matching direction. If left
                                    empty, auto-creation is skipped for that
                                    direction.
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
