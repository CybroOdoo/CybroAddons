<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_eagle_doc" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.eagle.doc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_eagle_doc_sync_now"
                            type="object"
                            string="Sync to Eagle Doc"
                            class="btn-primary"
                            groups="account.group_account_user"
                            invisible="supplier_rank == 0 and customer_rank == 0"/>
                </header>
            </xpath>
        </field>
    </record>
    <record id="action_eagle_doc_sync_partners" model="ir.actions.server">
        <field name="name">Sync to Eagle Doc</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_eagle_doc_sync_now()</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
