<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_eagle_doc_feedback" model="ir.ui.view">
        <field name="name">account.move.form.eagle.doc.feedback</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(eagle_doc_connector.action_eagle_doc_feedback_wizard)d"
                        type="action"
                        string="Correct Eagle Doc Extraction"
                        class="btn-secondary"
                        invisible="not eagle_doc_document_id or state == 'posted'"
                        groups="account.group_account_user"
                        context="{'default_move_id': id}"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="is_eagle_doc_total_mismatch" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not is_eagle_doc_total_mismatch">
                    <field name="eagle_doc_total_mismatch_message" readonly="1" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
