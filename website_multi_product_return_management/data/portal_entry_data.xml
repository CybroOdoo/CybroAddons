<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--   Portal card for return orders -->
    <record id="portal_return_orders" model="portal.entry">
        <field name="name">Return Orders</field>
        <field name="description">Follow or view your return orders</field>
        <field name="url">/my/return_orders</field>
        <field name="placeholder_count">return_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="60"/>
    </record>
</odoo>
