<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_res_config_settings_inherit_pdf" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pdf.background</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='performance']" position="after">

                <block title="Background PDF" name="background_pdf_settings">
                    <setting id="attach_pdf_in_chatter_setting"
                             string="Attach Background PDF in Chatter"
                             help="If enabled, generated background PDFs will be attached in the document chatter.">
                        <field name="is_attach_pdf_in_chatter"/>
                    </setting>
                </block>

            </xpath>

        </field>
    </record>
</odoo>