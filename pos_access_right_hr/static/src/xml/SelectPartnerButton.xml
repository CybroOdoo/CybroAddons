<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!--
        Template extension to disable the 'Select Customer' button on the POS screen
        based on the cashier's POS permission (disable_customer).
    -->
    <t t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('set-partner')]" position="attributes">
            <attribute name="t-att-disabled">disable_customer()</attribute>
        </xpath>
    </t>
</templates>
