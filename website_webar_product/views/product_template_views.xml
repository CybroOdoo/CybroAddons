<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.website.webar.product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='variants']" position="after">
                <page string="AR Image" name="ar_image">
                    <group>
                        <group>
                            <field name="enable_ar_images" widget="boolean_toggle"/>
                            <field name="ar_image_type"/>
                            <field name="ar_url"
                                   invisible="ar_image_type == 'upload'"
                                   required="enable_ar_images and ar_image_type == 'url'"/>
                            <field name="model_ar"
                                   filename="filename"
                                   invisible="ar_image_type == 'url'"
                                   required="enable_ar_images and ar_image_type == 'upload'"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="auto_rotate"/>
                            <field name="ar_scale"/>
                            <field name="ar_placement"/>
                            <field name="poster_image"
                                   widget="image"
                                   class="oe_avatar"
                                   options="{'zoom': true, 'size': [100, 100]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>