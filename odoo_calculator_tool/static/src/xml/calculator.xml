<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="CalculatorTool">
        <div class="calc_dropdown o-dropdown dropdown o-dropdown--no-caret">
            <button class="calc_dropdown-toggle" type="button" t-on-click="onclick_calc_icon" style="height: 100%; display: flex; align-items: center; justify-content: center; border: none; background: none; color: inherit; padding: 0 10px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                    <line x1="8" y1="6" x2="16" y2="6"></line>
                    <line x1="16" y1="14" x2="16" y2="18"></line>
                    <path d="M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M8 18h.01M12 18h.01"></path>
                </svg>
            </button>
            <ul class="calc_dropdown-menu"
                t-attf-style="z-index: 9999999; position: fixed; left: {{this.state.x}}px; top: {{this.state.y}}px; display: {{this.state.isVisible ? 'block' : 'none'}};"
                t-on-mousedown.prevent="startDragging">
                <li>
                    <div class="calc-pad-tool draggable-tool">
                        <div class="calculator-app">
                            <input type="text" class="display" id="display" readonly="1" t-att-value="this.state.display"/>
                            <div class="buttons">
                                <button class="number" data-key="7" t-on-click="onNumberClick">7</button>
                                <button class="number" data-key="8" t-on-click="onNumberClick">8</button>
                                <button class="number" data-key="9" t-on-click="onNumberClick">9</button>
                                <button class="operator" data-key="+" t-on-click="onOperatorClick">+</button>
                                <button class="number" data-key="4" t-on-click="onNumberClick">4</button>
                                <button class="number" data-key="5" t-on-click="onNumberClick">5</button>
                                <button class="number" data-key="6" t-on-click="onNumberClick">6</button>
                                <button class="operator" data-key="-" t-on-click="onOperatorClick">-</button>
                                <button class="number" data-key="1" t-on-click="onNumberClick">1</button>
                                <button class="number" data-key="2" t-on-click="onNumberClick">2</button>
                                <button class="number" data-key="3" t-on-click="onNumberClick">3</button>
                                <button class="operator" data-key="*" t-on-click="onOperatorClick">*</button>
                                <button class="number" data-key="0" t-on-click="onNumberClick">0</button>
                                <button class="decimal" data-key="." t-on-click="onDecimalClick">.</button>
                                <button class="operator" data-key="%" t-on-click="onOperatorClick">%</button>
                                <button class="operator" data-key="/" t-on-click="onOperatorClick">/</button>
                                <button class="clear" data-key="C" t-on-click="onClearClick">C</button>
                                <button class="toggle-sign" data-key="±" t-on-click="onToggleSignClick">±</button>
                                <button class="equals" data-key="=" t-on-click="onEqualsClick">=</button>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </t>
</templates>
