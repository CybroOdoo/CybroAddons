<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form view of the account day book report inherit -->
    <record id="account_day_book_report_view_form_inherit" model="ir.ui.view">
        <field name="name">account.day.book.report.view.form.inherit.account.day.book</field>
        <field name="model">account.day.book.report</field>
        <field name="inherit_id" ref="base_accounting_kit.account_day_book_report_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='check_report']" position="before">
                <button name="report_xlsx" string="Export to Excel" type="object"
                        default_focus="1"
                        context="{'xls_export':1}" class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>
