<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Extending the chatter to add the camera icon -->
    <t name="chatter_camera" t-inherit="mail.Chatter"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o-mail-Chatter-topbar')]" position="inside">
            <button id="camera_button" type="button" t-on-click="onClickCamera" style="border:none;background-color:white;">
                <i class="fa fa-camera-retro"/>
            </button>
            <center>
                <div id="myModal" class="modal" style="width: 35%; height: 58%; display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999;">
                    <div class="modal-content" style="border-radius: 8px; background-color: white; padding: 10px;">
                        <header style="text-align: center; padding-bottom: 10px;">
                            <video id="videoCam" t-ref="video" style="width: 100%; height: 100%; border-radius: 8px;"></video>
                        </header>
                        <footer style="text-align: center; padding-top: 10px;">
                            <button id="click_photo" t-on-click="ImageCapture" class="btn btn-primary" style="padding: 10px 20px;">
                                Capture
                            </button>
                            <button id="stop-camera-button" t-ref="stop-camera-button" class="btn btn-secondary" style="padding: 10px 20px;">
                                Cancel
                            </button>
                        </footer>
                        <span hidden="hidden">
                            <canvas id="canvas" width="150" height="100" t-ref="canvas"/>
                        </span>
                    </div>
                </div>
            </center>
        </xpath>
    </t>
</templates>
