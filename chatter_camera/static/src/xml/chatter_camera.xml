<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Extending the chatter to add the camera icon in topbar before followers (next to attachments) -->
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Followers')]" position="before">
            <button id="camera_button" class="btn btn-link text-action px-1 my-2 d-flex align-items-center" type="button" t-on-click="this.onClickCamera" title="Camera" aria-label="Camera" t-att-disabled="this.isDisabled">
                <i class="oi oi-fw" data-icon="photo_camera" role="img"/>
            </button>
        </xpath>
    </t>

    <!-- Camera Dialog Component Template -->
    <t t-name="chatter_camera.CameraDialog">
        <Dialog size="'md'" title="this.title">
            <div class="o_chatter_camera_container text-center">
                <video t-ref="this.videoRef" class="o_chatter_camera_video" autoplay="autoplay" playsinline="playsinline"/>
                <canvas t-ref="this.canvasRef" class="d-none"/>
            </div>
            <t t-set-slot="footer">
                <button id="click_photo" type="button" class="btn btn-primary px-3" t-on-click="this.capturePhoto">
                    <i class="oi oi-fw me-1" data-icon="photo_camera" role="img"/> Capture
                </button>
                <button type="button" class="btn btn-secondary px-3" t-on-click="() => this.props.close()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>
</templates>
