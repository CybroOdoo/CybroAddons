<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_lot_expiry_warning.LotListPopup">
        <Dialog title="props.title">
            <t t-set-slot="header">
                <div class="d-flex flex-column">
                    <h4 class="modal-title text-truncate" t-esc="props.title" />
                    <span class="text-muted small" t-esc="props.name"/>
                </div>
            </t>

            <div t-ref="root">
                <main class="modal-body py-4">
                    <div class="mb-3">
                        <label for="lot_select" class="form-label">Select a Lot</label>
                        <select id="lot_select" t-model="state.lot_id" class="form-select form-select-lg">
                            <option value="0">
                                Select a Lot/Serial Number
                            </option>
                            <t t-foreach="props.lotStock" t-as="lot" t-key="lot.id">
                                <option t-att-value="lot.name">
                                    <t t-esc="lot.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </main>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg o-default-button" t-on-click="confirm">Confirm</button>
                <button class="btn btn-secondary btn-lg" t-on-click="cancel">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
