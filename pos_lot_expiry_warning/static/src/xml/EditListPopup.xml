<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_lot_expiry_warning.LotListPopup">
        <Dialog title="props.title">
            <t t-set-slot="header">
                <h4 class="modal-title title" t-esc="props.title" />
                <span class="sub-title" t-esc="props.name"/>
            </t>
            <div t-ref="root">
                <main class="modal-body">
                    <select t-model="state.lot_id" class="form-select" style="background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px;">
                        <option value="0">
                            Select a Lot
                        </option>
                        <option t-foreach="props.lotStock" t-as="lot" t-key="lot.id" t-att-value="lot.name">
                            <t t-esc="lot.name"/>
                        </option>
                    </select>
                </main>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg lh-lg o-default-button" t-on-click="confirm">Ok</button>
                <button class="btn btn-secondary btn-lg lh-lg" t-on-click="cancel">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
