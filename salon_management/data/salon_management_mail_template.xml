<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
<!--        Salon booking request received mail template (sent immediately
            after a booking request is submitted, before approval)-->
        <record id="mail_template_salon_request_received" model="mail.template">
            <field name="name">Salon Booking Request Received E-mail</field>
            <field name="email_from">{{ object.company_id and object.company_id.email or '' }}</field>
            <field name="subject">We received your booking request, {{ object.name }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="model_id" ref="salon_management.model_salon_booking" />
            <field name="auto_delete" eval="True" />
            <field name="body_html" type="html">
                <div>
                    <p>Dear <t t-out="object.name" />,<br />
                    Thank you for choosing <t t-out="object.company_id.name" />!
                    We have received your booking request and it is now
                    awaiting confirmation from our team. You'll get a
                    follow-up e-mail as soon as it is approved.<br /><br /></p>
                    Regards,<br />
                    <t t-out="object.company_id.name" />
                </div>
            </field>
        </record>
<!--        Salon approved mail template-->
        <record id="mail_template_salon_approved" model="mail.template">
            <field name="name">Salon Approved E-mail</field>
            <field name="email_from">{{ object.company_id and object.company_id.email or '' }}</field>
            <field name="subject">Congrats {{ object.name }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="model_id" ref="salon_management.model_salon_booking" />
            <field name="auto_delete" eval="True" />
            <field name="body_html" type="html">
                <div>
                    <p>Dear <t t-out="object.name" />,<br />
                    Thank you for choosing <t t-out="object.company_id.name" />, your booking was registered!<br /><br /></p>
                    Regards,<br />
                    <t t-out="object.company_id.name" />
                </div>
            </field>
        </record>
        <!--        Salon rejecting mail template-->
        <record id="mail_template_salon_rejected" model="mail.template">
            <field name="name">Salon Rejected E-mail</field>
            <field name="email_from">{{ object.company_id and object.company_id.email or '' }}</field>
            <field name="subject">We are Sorry {{ object.name }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="model_id" ref="salon_management.model_salon_booking" />
            <field name="auto_delete" eval="True" />
            <field name="body_html" type="html">
                <div>
                    <p>Dear <t t-out="object.name" />,<br />
                    Thank you for choosing <t t-out="object.company_id.name" />, but your booking was rejected!<br />
                    There are no seats available for the time you chose.<br />
                    Better luck next time.<br /><br /></p>
                    Regards,<br />
                    <t t-out="object.company_id.name" />
                </div>
            </field>
       </record>
    </data>
</odoo>
