<?xml version="1.0" encoding="UTF-8"?>
<!--Salon management dashboard template-->
<templates id="template" xml:space="preserve">
    <t t-name="SalonSpaDashBoard">
    <div class="o_salon_dashboard">

      <div class="salon_dashboard_header">
        <h2 class="salon_dashboard_title">Salon Overview</h2>
        <p class="salon_dashboard_subtitle">Today's bookings, orders, clients and chair activity at a glance</p>
      </div>

      <div class="row main-section">
        <div class="col-6 col-md-4 col-lg-3 salon_spa_bookings salon salon_bookings"
             t-on-click="this.show_bookings">
          <div class="salon-card">
            <div class="salon-card-body">
              <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="16" rx="2"/>
                  <path d="M3 9h18"/>
                  <path d="M8 3v4M16 3v4"/>
                  <path d="M9 14l2 2 4-4"/>
                </svg>
              </div>
              <div class="stat-content">
                <div class="stat-text">Bookings</div>
                <div class="stat-digit"><span t-out="this.bookingsCount"/></div>
                <div class="stat-caption">Approved</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3 salon_spa_revenue salon salon_revenue"
             t-on-click="this.show_revenue">
          <div class="salon-card">
            <div class="salon-card-body">
              <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="6" width="20" height="12" rx="2"/>
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M6 6v0M18 18v0"/>
                </svg>
              </div>
              <div class="stat-content">
                <div class="stat-text">Revenue</div>
                <div class="stat-digit stat-digit-sm"><span t-out="this.revenueTodayFormatted"/></div>
                <div class="stat-caption">Today</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3 salon_spa_orders salon salon_orders"
             t-on-click="this.show_orders">
          <div class="salon-card">
            <div class="salon-card-body">
              <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 6h13M8 12h13M8 18h13"/>
                  <circle cx="3.5" cy="6" r="1.4" fill="currentColor" stroke="none"/>
                  <circle cx="3.5" cy="12" r="1.4" fill="currentColor" stroke="none"/>
                  <circle cx="3.5" cy="18" r="1.4" fill="currentColor" stroke="none"/>
                </svg>
              </div>
              <div class="stat-content">
                <div class="stat-text">Orders</div>
                <div class="stat-digit"><span t-out="this.ordersCount"/></div>
                <div class="stat-caption">All time</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3 salon_spa_clients salon salon_clients"
             t-on-click="this.show_clients">
          <div class="salon-card">
            <div class="salon-card-body">
              <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="3.5"/>
                  <path d="M5 20c0-4 3-6.5 7-6.5s7 2.5 7 6.5"/>
                </svg>
              </div>
              <div class="stat-content">
                <div class="stat-text">Clients</div>
                <div class="stat-digit"><span t-out="this.clientsCount"/></div>
                <div class="stat-caption">Total</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Services overview -->
      <div class="salon_services_section">
        <div class="salon_panel">
          <h3 class="salon_section_title">Services</h3>
          <div class="salon_table_wrapper" t-if="this.state.servicesSummary.length">
            <table class="salon_table">
              <thead>
                <tr>
                  <th>Service</th>
                  <th class="text-end">Price</th>
                  <th class="text-end">Orders</th>
                  <th class="text-end">Revenue</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="this.state.servicesSummary" t-as="service" t-key="service['id']">
                  <tr>
                    <td><t t-out="service['name']"/></td>
                    <td class="text-end"><t t-out="service['price'].toFixed(2)"/></td>
                    <td class="text-end"><t t-out="service['orders_count']"/></td>
                    <td class="text-end"><t t-out="service['revenue'].toFixed(2)"/></td>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
          <div class="salon_table_empty" t-else="">
            <p>No services have been configured yet.</p>
          </div>
        </div>
      </div>

      <!--  Dashboard chairs view-->
      <div class="salon_chairs_section">
        <h3 class="salon_section_title">Chairs</h3>
        <article role="main" id="chairs_dashboard_view" t-if="this.state.chairs.length">
          <t t-foreach="this.state.chairs" t-as="chair" t-key="chair['id']">
            <div class="salon_chair" t-att-id="chair['id']" t-on-click="this.chairs_click">
              <span t-if="chair['busy']" class="chair_status chair_status_busy">Busy</span>
              <span t-else="" class="chair_status chair_status_free">Free</span>
              <div class="chair_setting" t-att-id="chair['name']" t-on-click="this.settings_click">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/>
                </svg>
              </div>
              <div class="chair_icon_wrap">
                <div class="chair_icon"/>
              </div>

              <p class="chair_stylist" t-if="chair['stylist']">
                <t t-out="chair['stylist']"/></p>
                <h5 style="color: black;"><t t-out="chair['name']"/>
              </h5>
            </div>
          </t>
        </article>
        <div class="salon_chairs_empty" t-else="">
          <p>No chairs have been configured yet.</p>
        </div>
      </div>

    </div>
  </t>
</templates>
