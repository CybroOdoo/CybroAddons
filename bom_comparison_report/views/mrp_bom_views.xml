<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Compare button on the list of the bills of materials -->
    <record id="mrp_bom_tree_view" model="ir.ui.view">
        <field name="name">mrp.bom.view.list.inherit.bom.comparison.report</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(bom_comparison_report.bom_comparison_action)d"
                            string="Compare" type="action"
                            class="btn btn-secondary" display="always"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
