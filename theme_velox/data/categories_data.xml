<?xml version="1.0" encoding="utf-8"?>
<!-- eCommerce categories definition for the Velox sports theme. -->
<odoo>

    <record id="velox_cat_running" model="product.public.category">
        <field name="name">Running</field>
        <field name="image_1920" type="base64"
               file="theme_velox/static/src/img/running.jpg"/>
    </record>

    <record id="velox_cat_football" model="product.public.category">
        <field name="name">Football</field>
        <field name="image_1920" type="base64"
               file="theme_velox/static/src/img/soccer.jpg"/>
    </record>

    <record id="velox_cat_training" model="product.public.category">
        <field name="name">Training</field>
        <field name="image_1920" type="base64"
               file="theme_velox/static/src/img/training.jpg"/>
    </record>

    <record id="velox_cat_basketball" model="product.public.category">
        <field name="name">Basketball</field>
        <field name="image_1920" type="base64"
               file="theme_velox/static/src/img/basketball.jpg"/>
    </record>

    <record id="velox_cat_accessories" model="product.public.category">
        <field name="name">Accessories</field>
        <field name="image_1920" type="base64"
               file="theme_velox/static/src/img/outdoor.jpg"/>
    </record>

</odoo>
