<?xml version="1.0" encoding="utf-8"?>
<!-- Product attributes and variants data for the Velox sports theme. -->
<odoo>
    <record id="velox_attr_gender" model="product.attribute">
        <field name="name">Gender</field>
        <field name="visibility">visible</field>
        <field name="create_variant">no_variant</field>
    </record>

    <record id="velox_attr_gender_men" model="product.attribute.value">
        <field name="name">Men</field>
        <field name="attribute_id" ref="velox_attr_gender"/>
    </record>

    <record id="velox_attr_gender_women" model="product.attribute.value">
        <field name="name">Women</field>
        <field name="attribute_id" ref="velox_attr_gender"/>
    </record>

    <record id="velox_attr_gender_unisex" model="product.attribute.value">
        <field name="name">Unisex</field>
        <field name="attribute_id" ref="velox_attr_gender"/>
    </record>

    <record id="velox_attr_size" model="product.attribute">
        <field name="name">Size</field>
        <field name="visibility">visible</field>
        <field name="create_variant">always</field>
    </record>

    <record id="velox_attr_size_s" model="product.attribute.value">
        <field name="name">S</field>
        <field name="attribute_id" ref="velox_attr_size"/>
    </record>

    <record id="velox_attr_size_m" model="product.attribute.value">
        <field name="name">M</field>
        <field name="attribute_id" ref="velox_attr_size"/>
    </record>

    <record id="velox_attr_size_l" model="product.attribute.value">
        <field name="name">L</field>
        <field name="attribute_id" ref="velox_attr_size"/>
    </record>

    <record id="velox_attr_size_xl" model="product.attribute.value">
        <field name="name">XL</field>
        <field name="attribute_id" ref="velox_attr_size"/>
    </record>
</odoo>
