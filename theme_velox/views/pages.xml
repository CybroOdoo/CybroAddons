<?xml version="1.0" encoding="utf-8"?>
<!-- QWeb template modifications for general website pages and asset registrations. -->
<odoo>
    <template id="velox_homepage" inherit_id="website.homepage" name="Velox Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="o_home_cover oe_structure oe_empty">
                <t t-call="theme_velox.s_velox_hero_snippet"/>
                <t t-call="theme_velox.s_velox_features_snippet"/>
                <t t-call="theme_velox.s_velox_new_arrivals_snippet"/>
                <t t-call="theme_velox.s_velox_sport_categories_snippet"/>
                <t t-call="theme_velox.s_velox_sale_products_snippet"/>
                <t t-call="theme_velox.s_velox_club_banner_snippet"/>
                <t t-call="theme_velox.s_velox_trending_grid_snippet"/>
                <t t-call="theme_velox.s_velox_seasonal_banner_snippet"/>
            </div>
        </xpath>
    </template>
</odoo>
