<?xml version="1.0" encoding="utf-8"?>
<!-- Custom footer layout template with newsletter sign-up and links. -->
<odoo>

    <template id="velox_footer" name="Velox Footer" inherit_id="website.layout">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="o_footer velox-footer oe_structure" t-ignore="true"
                 t-if="not no_footer">
                <footer class="velox-footer">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-lg-3 col-md-6">
                                <p class="velox-footer-brand">VELO
                                    <span>X</span>
                                </p>
                                <p class="velox-footer-tagline">Premium athletic gear
                                    engineered for peak performance. Defy your limits.
                                </p>
                            </div>
                            <div class="col-lg-2 col-md-3 col-6">
                                <p class="velox-footer-col-title">Products</p>
                                <ul class="velox-footer-links list-unstyled">
                                    <li>
                                        <a href="/shop">Shoes</a>
                                    </li>
                                    <li>
                                        <a href="/shop">Clothing</a>
                                    </li>
                                    <li>
                                        <a href="/shop">Accessories</a>
                                    </li>
                                    <li>
                                        <a href="/shop/new-release">New Arrivals</a>
                                    </li>
                                    <li>
                                        <a href="/shop/sale">Sale</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-3 col-6">
                                <p class="velox-footer-col-title">Support</p>
                                <ul class="velox-footer-links list-unstyled">
                                    <li>
                                        <a href="/contactus">Help &amp; FAQs</a>
                                    </li>
                                    <li>
                                        <a href="/my/orders">Order Tracking</a>
                                    </li>
                                    <li>
                                        <a href="/contactus">Shipping &amp; Delivery</a>
                                    </li>
                                    <li>
                                        <a href="/contactus">Returns</a>
                                    </li>
                                    <li>
                                        <a href="/contactus">Contact Us</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-3 col-6">
                                <p class="velox-footer-col-title">Company</p>
                                <ul class="velox-footer-links list-unstyled">
                                    <li>
                                        <a href="/">About Us</a>
                                    </li>
                                    <li>
                                        <a href="/">Careers</a>
                                    </li>
                                    <li>
                                        <a href="/">Sustainability</a>
                                    </li>
                                    <li>
                                        <a href="/">Investors</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <p class="velox-footer-col-title">Stay in the Loop</p>
                                <p class="velox-footer-tagline mb-3">Sign up for exclusive
                                    offers, original stories, newest drops.
                                </p>
                                <div class="velox-newsletter-form input-group">
                                    <input type="email" class="form-control"
                                           placeholder="Your email address"/>
                                    <button class="btn btn-primary">Sign Up</button>
                                </div>
                                <div class="d-flex gap-3 mt-4 velox-social-links">
                                    <a href="#" aria-label="Instagram">
                                        <i class="fa fa-instagram fa-lg"></i>
                                    </a>
                                    <a href="#" aria-label="Twitter">
                                        <i class="fa fa-twitter fa-lg"></i>
                                    </a>
                                    <a href="#" aria-label="Facebook">
                                        <i class="fa fa-facebook fa-lg"></i>
                                    </a>
                                    <a href="#" aria-label="YouTube">
                                        <i class="fa fa-youtube-play fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="velox-footer-bottom">
                            <p class="velox-footer-copy mb-0">&#169;
                                <span t-esc="datetime.date.today().year"/>
                                Velox Sports. All Rights Reserved.
                            </p>
                            <div class="velox-footer-legal">
                                <a href="/">Terms of Use</a>
                                <a href="/">Privacy Policy</a>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </xpath>
    </template>

</odoo>
