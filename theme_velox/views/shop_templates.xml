<?xml version="1.0" encoding="utf-8"?>
<!-- QWeb templates overriding the default eCommerce shop and product page layouts. -->
<odoo>

    <template id="velox_shop_wrap" name="Velox Shop Wrap"
              inherit_id="website_sale.products">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="velox-shop-page" separator=" "/>
        </xpath>
    </template>

    <template id="velox_shop_banner" name="Velox Shop Banner"
              inherit_id="website_sale.products">
        <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
            <div class="velox-shop-banner">
                <div class="velox-shop-banner-overlay"/>
                <div class="container position-relative" style="z-index:1">
                    <t t-if="category">
                        <h1 t-esc="category.name"/>
                        <p t-if="category.website_description"
                           t-out="category.website_description"/>
                        <p t-else="">Conquer the elements. Engineered for ultimate
                            durability, protection, and performance.
                        </p>
                    </t>
                    <t t-else="">
                        <h1>Outdoor Collection</h1>
                        <p>Conquer the elements. Engineered for ultimate durability,
                            protection, and performance.
                        </p>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <template id="velox_product_img" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="attributes">
            <attribute name="class" add="velox-product-img-wrap" separator=" "/>
        </xpath>
    </template>

    <template id="velox_product_body" name="Velox Product Body"
              inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('o_wsale_product_information')]"
               position="attributes">
            <attribute name="class" add="velox-product-body" separator=" "/>
        </xpath>
    </template>

    <template id="velox_product_breadcrumb" name="Velox Product Breadcrumb"
              inherit_id="website_sale.product">
        <xpath expr="//ol[hasclass('breadcrumb')]" position="attributes">
            <attribute name="class" add="velox-breadcrumb" separator=" "/>
        </xpath>
    </template>

    <template id="velox_product_detail_style" name="Velox Product Detail Style"
              inherit_id="website_sale.product">
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name="class" add="velox-product-detail" separator=" "/>
        </xpath>
    </template>

    <template id="velox_add_to_cart_btn" inherit_id="website_sale.product">
        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="class" add="velox-add-to-cart-btn" separator=" "/>
        </xpath>
    </template>


    <template id="velox_portal_wrap" name="Velox Portal Wrap"
              inherit_id="portal.portal_layout">
        <xpath expr="//div[hasclass('o_portal_wrap')]" position="attributes">
            <attribute name="class" add="velox-portal-wrap" separator=" "/>
        </xpath>
    </template>

    <template id="velox_similar_products" name="Velox Similar Products"
              inherit_id="website_sale.product">
        <xpath expr="//section[@id='product_detail']" position="after">
            <section
                    class="s_dynamic_snippet_products o_colored_level pb64 pt64 velox-similar-products"
                    data-snippet="s_dynamic_snippet_products"
                    data-name="Similar Products"
                    data-template-key="website_sale.dynamic_filter_template_product_product_products_item"
                    data-product-category-id="all"
                    data-number-of-elements="4">
                <div class="container">
                    <div class="velox-section-header mb40">
                        <h2 class="s_title velox-section-title">Similar Products</h2>
                    </div>
                    <div class="o_not_editable">
                        <div class="dynamic_snippet_template"/>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <template id="velox_confirmation" name="Velox Confirmation"
              inherit_id="website_sale.confirmation">
        <xpath expr="//t[@t-call='website_sale.checkout_layout']" position="before">
            <div class="velox-confirmation-header text-center mb-5 mt-4">
                <div class="d-inline-block position-relative">
                    <t t-if="order.order_line">
                        <img t-att-src="website.image_url(order.order_line[0].product_id, 'image_1024')"
                             class="img-fluid rounded-circle border border-3 border-primary shadow-lg"
                             style="width: 240px; height: 240px; object-fit: cover; background: #fff;"/>
                        <div class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px;">
                            <i class="fa fa-check"/>
                        </div>
                    </t>
                </div>
                <h1 class="mt-4 text-white font-display">THANK YOU!</h1>
                <p class="text-muted">Your order
                    <strong class="text-primary" t-esc="order.name"/>
                    has been placed successfully.
                </p>
            </div>
        </xpath>
    </template>

</odoo>
