<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme Header Customization -->
    <!-- Velox Head Assets
         Defines the structure and styling for Velox Head Assets.
    -->
    <template id="velox_head_assets" name="Velox Head Assets" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&amp;family=Barlow+Condensed:wght@400;600;700&amp;display=swap"
                  rel="stylesheet"/>
        </xpath>
    </template>

    <!--
       Velox Custom Header
       Defines the structure and styling for Velox Custom Header.
    -->
    <template id="velox_header_override" name="Velox Custom Header" inherit_id="website.layout">
        <xpath expr="//header" position="replace">
            <header id="top" data-name="Header" class="o_header_standard">
                <nav class="navbar navbar-expand-lg velox-nav">
                    <div class="container">
                        <a class="navbar-brand" href="/">VELO
                            <span>X</span>
                        </a>
                        <div class="d-flex align-items-center order-lg-3 ms-auto ms-lg-3 nav-icons velox-nav-icons">
                            <a href="#" id="openSearchBtn" aria-label="Search">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                    <path fill="none" stroke="currentColor" stroke-linecap="round"
                                          stroke-linejoin="round" stroke-width="2"
                                          d="m21 21l-4.343-4.343m0 0A8 8 0 1 0 5.343 5.343a8 8 0 0 0 11.314 11.314"/>
                                </svg>
                            </a>
                            <ul class="navbar-nav mb-0 ms-2 d-none d-sm-flex">
                                <t t-call="portal.placeholder_user_sign_in">
                                    <t t-set="_link_class" t-value="'nav-link'"/>
                                </t>
                                <t t-call="portal.user_dropdown">
                                    <t t-set="_user_name" t-value="False"/>
                                    <t t-set="_item_class" t-value="'nav-item dropdown'"/>
                                    <t t-set="_link_class" t-value="'nav-link'"/>
                                </t>
                            </ul>
                            <ul class="navbar-nav mb-0 ms-3 flex-row gap-3">
                                <t t-set="wishcount"
                                   t-value="len(request.env['product.wishlist'].current()) if request.env.registry.models.get('product.wishlist') else 0"/>
                                <li class="nav-item o_wsale_my_wish" style="display: block !important;">
                                    <a href="/shop/wishlist" class="nav-link" aria-label="Wishlist"
                                       style="position:relative;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                             viewBox="0 0 24 24">
                                            <path fill="none" stroke="currentColor" stroke-linecap="round"
                                                  stroke-linejoin="round" stroke-width="2"
                                                  d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78l1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                        </svg>
                                        <sup t-esc="wishcount"
                                             class="my_wish_quantity o_animate_blink badge text-bg-primary rounded-pill z-index-1"
                                             style="position:absolute;top:-1px;right:-4px;background:var(--velox-accent) !important;color:#fff;font-size:9px;font-family:var(--font-cond);font-weight:700;width:16px;height:16px;display:flex;align-items:center;justify-content:center;padding:0;"/>
                                    </a>
                                </li>
                                <li class="nav-item o_wsale_my_cart" style="display: block !important;">
                                    <a href="/shop/cart" aria-label="Cart" class="nav-link" style="position:relative;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                             viewBox="0 0 16 16">
                                            <path fill="currentColor" fill-rule="evenodd"
                                                  d="M5.174 3h5.652a1.5 1.5 0 0 1 1.49 1.328l.808 7A1.5 1.5 0 0 1 11.634 13H4.366a1.5 1.5 0 0 1-1.49-1.672l.808-7A1.5 1.5 0 0 1 5.174 3m-2.98 1.156A3 3 0 0 1 5.174 1.5h5.652a3 3 0 0 1 2.98 2.656l.808 7a3 3 0 0 1-2.98 3.344H4.366a3 3 0 0 1-2.98-3.344zM5 5.25a.75.75 0 0 1 1.5 0v.25a1.5 1.5 0 1 0 3 0v-.25a.75.75 0 0 1 1.5 0v.25a3 3 0 0 1-6 0z"
                                                  clip-rule="evenodd"/>
                                        </svg>
                                        <t t-set="website_sale_cart_quantity"
                                           t-value="request.session.get('website_sale_cart_quantity', request.cart and request.cart.cart_quantity or 0)"/>
                                        <sup class="my_cart_quantity o_cart_quantity badge text-bg-primary rounded-pill z-index-1"
                                             style="position:absolute;top:-1px;right:-4px;background:var(--velox-accent) !important;color:#fff;font-size:9px;font-family:var(--font-cond);font-weight:700;width:16px;height:16px;display:flex;align-items:center;justify-content:center;padding:0;"
                                             t-esc="website_sale_cart_quantity"/>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <button class="navbar-toggler ms-2" type="button" data-bs-toggle="offcanvas"
                                data-bs-target="#top_menu_collapse_mobile" aria-controls="top_menu_collapse_mobile"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <!-- Desktop Menu -->
                        <div class="collapse navbar-collapse d-none d-lg-flex order-lg-2" id="veloxNavDesktop">
                            <ul class="navbar-nav mb-2 mb-lg-0 mx-auto justify-content-center" id="top_menu">
                                <li class="nav-item">
                                    <a t-attf-class="nav-link#{' active' if request.httprequest.path.startswith('/shop/new-release') else ''}"
                                       href="/shop/new-release">New Releases
                                    </a>
                                </li>
                                <t t-set="gender_attr"
                                   t-value="request.env.ref('theme_velox.velox_attr_gender', raise_if_not_found=False)"/>
                                <t t-set="men_val"
                                   t-value="request.env.ref('theme_velox.velox_attr_gender_men', raise_if_not_found=False)"/>
                                <t t-set="women_val"
                                   t-value="request.env.ref('theme_velox.velox_attr_gender_women', raise_if_not_found=False)"/>
                                <li class="nav-item">
                                    <t t-if="gender_attr and men_val">
                                        <a class="nav-link"
                                           t-attf-href="/shop/category/#{men_val.id}">Men
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <a class="nav-link" href="/shop">Men</a>
                                    </t>
                                </li>
                                <li class="nav-item">
                                    <t t-if="gender_attr and women_val">
                                        <a class="nav-link"
                                           t-attf-href="/shop/category/#{women_val.id}">Women
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <a class="nav-link" href="/shop">Women</a>
                                    </t>
                                </li>
                                <li class="nav-item">
                                    <a t-attf-class="nav-link#{' active' if request.httprequest.path.startswith('/shop/sale') else ''}"
                                       href="/shop/sale">Sale
                                    </a>
                                </li>
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-if="submenu.url not in ['/', '/shop', '/contactus']">
                                        <t t-call="website.submenu">
                                            <t t-set="item_class" t-value="'nav-item'"/>
                                            <t t-set="link_class" t-value="'nav-link'"/>
                                        </t>
                                    </t>
                                </t>
                            </ul>
                        </div>

                        <!-- Mobile Offcanvas -->
                        <div class="offcanvas offcanvas-end text-bg-dark o_navbar_mobile d-lg-none" data-bs-theme="dark"
                             tabindex="-1" id="top_menu_collapse_mobile"
                             aria-labelledby="top_menu_collapse_mobile_label"
                             style="background-color: #0a0a0a !important;">
                            <div class="offcanvas-header justify-content-end">
                                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"
                                        aria-label="Close"></button>
                            </div>
                            <div class="offcanvas-body d-flex flex-column justify-content-between pt-0">
                                <ul class="navbar-nav mb-2 mb-lg-0 mx-auto justify-content-center w-100">
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link#{' active' if request.httprequest.path.startswith('/shop/new-release') else ''}"
                                           href="/shop/new-release">New Releases
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <t t-if="gender_attr and men_val">
                                            <a class="nav-link"
                                               t-attf-href="/shop?attribute_values=#{gender_attr.id}-#{men_val.id}">Men
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <a class="nav-link" href="/shop">Men</a>
                                        </t>
                                    </li>
                                    <li class="nav-item">
                                        <t t-if="gender_attr and women_val">
                                            <a class="nav-link"
                                               t-attf-href="/shop?attribute_values=#{gender_attr.id}-#{women_val.id}">
                                                Women
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <a class="nav-link" href="/shop">Women</a>
                                        </t>
                                    </li>
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link#{' active' if request.httprequest.path.startswith('/shop/sale') else ''}"
                                           href="/shop/sale">Sale
                                        </a>
                                    </li>
                                    <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                        <t t-if="submenu.url not in ['/', '/shop', '/contactus']">
                                            <t t-call="website.submenu">
                                                <t t-set="item_class" t-value="'nav-item'"/>
                                                <t t-set="link_class" t-value="'nav-link'"/>
                                            </t>
                                        </t>
                                    </t>
                                </ul>
                                <div class="velox-mobile-menu-footer w-100">
                                    <ul class="navbar-nav mb-0 flex-column gap-2">
                                        <li class="nav-item">
                                            <a href="/contactus" class="nav-link">Contact Us</a>
                                        </li>
                                        <t t-if="request.env.user._is_public()">
                                            <li class="nav-item">
                                                <a href="/web/login" class="nav-link">Sign In</a>
                                            </li>
                                        </t>
                                        <t t-else="">
                                            <li class="nav-item">
                                                <a href="/my/home" class="nav-link">My Account</a>
                                            </li>
                                            <li class="nav-item">
                                                <a href="/web/session/logout?redirect=/" class="nav-link">Logout</a>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </div>
                        </div>

                    </div>
                </nav>

            </header>
        </xpath>
    </template>


    <!--
       Velox Search Overlay
       Defines the structure and styling for Velox Search Overlay.
    -->
    <template id="velox_search_overlay" name="Velox Search Overlay" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <div class="velox-search-overlay" id="searchOverlay" t-ignore="true" data-oe-readonly="true">
                <button class="velox-search-close" id="closeSearchBtn">&#215;</button>
                <div class="velox-search-inner">
                    <form action="/shop" class="velox-search-form" id="searchForm" method="get">
                        <input type="text" name="search" placeholder="WHAT ARE YOU LOOKING FOR?"
                               class="velox-search-input" id="searchInput" autocomplete="off"/>
                        <button type="submit" class="velox-search-submit oe_search_button" aria-label="Submit Search">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                      stroke-width="2"
                                      d="m21 21l-4.343-4.343m0 0A8 8 0 1 0 5.343 5.343a8 8 0 0 0 11.314 11.314"/>
                            </svg>
                        </button>
                    </form>
                    <div class="velox-popular-searches">
                        <p>POPULAR SEARCHES</p>
                        <div class="velox-search-tags">
                            <a href="/shop?search=Running+Shoes" class="velox-search-tag">Running Shoes</a>
                            <a href="/shop?search=Tech+Fleece" class="velox-search-tag">Tech Fleece</a>
                            <a href="/shop?search=Training+Shorts" class="velox-search-tag">Training Shorts</a>
                            <a href="/shop?search=Bags" class="velox-search-tag">Bags &amp; Backpacks</a>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>


    <!--
      Velox User Dropdown
      Defines the structure and styling for Velox User Dropdown.
    -->
    <template id="velox_user_dropdown" inherit_id="portal.user_dropdown">
        <xpath expr="//a" position="replace">
            <a href="#" role="button" data-bs-toggle="dropdown"
               t-attf-class="#{'' if _no_caret else 'dropdown-toggle'} #{_link_class}">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                       stroke-width="2">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </g>
                </svg>
            </a>
        </xpath>
    </template>

</odoo>
