<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Header asset -->
    <template id="velox_head_assets" name="Velox Head Assets"
              inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com"
                  crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&amp;family=Barlow+Condensed:wght@400;600;700&amp;display=swap"
                  rel="stylesheet"/>
        </xpath>
    </template>
    <!-- Theme header customisation -->
    <template id="velox_header_override" name="Velox Custom Header"
              inherit_id="website.layout">
        <xpath expr="//header" position="replace">
            <header id="top" data-name="Header" class="o_header_standard">
                <div class="announcement-bar o_velox_announcement">
                    <span>Free standard shipping</span>
                    on orders over $100.
                    <span>Free returns.</span>
                </div>

                <nav class="velox-nav navbar navbar-expand-lg">
                    <div class="container">

                        <a class="navbar-brand" href="/">VELO
                            <span>X</span>
                        </a>
                        <div class="d-flex align-items-center order-lg-3 ms-auto ms-lg-3
                         nav-icons velox-nav-icons">
                            <a href="#" id="openSearchBtn" aria-label="Search">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                    <path fill="none" stroke="currentColor" stroke-linecap="round"
                                          stroke-linejoin="round" stroke-width="2"
                                          d="m21 21l-4.343-4.343m0 0A8 8 0 1 0 5.343 5.343a8 8 0 0 0 11.314 11.314"/>
                                </svg>
                            </a>
                            <ul class="navbar-nav mb-0 ms-2 d-none d-sm-flex">
                                <t t-call="portal.placeholder_user_sign_in">
                                    <t t-set="_link_class" t-value="'nav-link'"/>
                                </t>
                                <t t-call="portal.user_dropdown">
                                    <t t-set="_user_name" t-value="False"/>
                                    <t t-set="_item_class" t-value="'nav-item dropdown'"/>
                                    <t t-set="_link_class" t-value="'nav-link'"/>
                                </t>
                            </ul>

                            <ul class="navbar-nav mb-0 ms-3 flex-row align-items-center">
                                <t t-set="wishlist_view"
                                   t-value="request.env.ref('website_sale_wishlist.add_to_wishlist', raise_if_not_found=False)"/>
                                <t t-if="wishlist_view and wishlist_view.active">
                                    <t t-set="wishes"
                                       t-value="request.env['product.wishlist'].with_context(display_default_code=False).current()"/>
                                    <li class="nav-item o_wsale_my_wish me-3">
                                        <a href="/shop/wishlist" class="nav-link p-0" style="position:relative;"
                                           aria-label="Wishlist">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24">
                                                <path fill="currentColor"
                                                      d="m12 21l-1.45-1.3q-2.525-2.275-4.175-3.837T3.75 12.812T2.388 10.4T2 8.15Q2 5.8 3.575 4.225T7.5 2.65q1.3 0 2.475.55T12 4.75q.825-.975 2-1.525t2.5-.55q2.35 0 3.925 1.575T22 8.15q0 1.15-.387 2.25t-1.363 2.412t-2.625 3.05t-4.175 3.838z"/>
                                            </svg>
                                            <sup t-attf-class="my_wish_quantity o_animate_blink badge text-bg-primary rounded-pill #{not wishes and 'd-none'}"
                                                 style="position:absolute;top:-4px;right:-8px;
                                    background:var(--velox-accent) !important;
                                    color:#fff;font-size:9px;
                                    font-family:var(--font-cond);font-weight:700;
                                    width:16px;height:16px;display:flex;
                                    align-items:center;justify-content:center;
                                    padding:0;"
                                                 t-esc="len(wishes)"/>
                                        </a>
                                    </li>
                                </t>
                                <li class="nav-item o_wsale_my_cart">
                                    <a href="/shop/cart" aria-label="Cart"
                                       class="nav-link p-0" style="position:relative;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                             viewBox="0 0 16 16">
                                            <path fill="currentColor" fill-rule="evenodd"
                                                  d="M5.174 3h5.652a1.5 1.5 0 0 1 1.49 1.328l.808 7A1.5 1.5 0 0 1 11.634 13H4.366a1.5 1.5 0 0 1-1.49-1.672l.808-7A1.5 1.5 0 0 1 5.174 3m-2.98 1.156A3 3 0 0 1 5.174 1.5h5.652a3 3 0 0 1 2.98 2.656l.808 7a3 3 0 0 1-2.98 3.344H4.366a3 3 0 0 1-2.98-3.344zM5 5.25a.75.75 0 0 1 1.5 0v.25a1.5 1.5 0 1 0 3 0v-.25a.75.75 0 0 1 1.5 0v.25a3 3 0 0 1-6 0z"
                                                  clip-rule="evenodd"/>
                                        </svg>

                                        <t t-set="sale_order" t-value="request.website.sale_get_order()"/>
                                        <t t-set="cart_qty" t-value="sale_order.cart_quantity if sale_order else 0"/>

                                        <sup class="my_cart_quantity o_cart_quantity badge text-bg-primary rounded-pill"
                                             style="position:absolute;top:-4px;right:-8px;
                                background:var(--velox-accent) !important;
                                color:#fff;font-size:9px;
                                font-family:var(--font-cond);font-weight:700;
                                width:16px;height:16px;display:flex;
                                align-items:center;justify-content:center;
                                padding:0;"
                                             t-esc="cart_qty"/>
                                    </a>
                                </li>
                            </ul>

                        </div>

                        <button class="navbar-toggler ms-2" type="button"
                                data-bs-toggle="collapse" data-bs-target="#veloxNav"
                                aria-controls="veloxNav" aria-expanded="false"
                                aria-label="Toggle navigation">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <line x1="4" y1="12" x2="20" y2="12"/>
                                <line x1="4" y1="6" x2="20" y2="6"/>
                                <line x1="4" y1="18" x2="20" y2="18"/>
                            </svg>
                        </button>

                        <div class="collapse navbar-collapse order-lg-2" id="veloxNav">
                            <!-- Mobile Sidebar Header -->
                            <div class="velox-sidebar-header d-lg-none">
                                <a class="navbar-brand" href="/">VELO
                                    <span>X</span>
                                </a>
                                <button class="btn-close-custom" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#veloxNav" aria-label="Close menu">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>

                            <!-- Scrollable Menu Wrapper -->
                            <div class="velox-sidebar-menu-wrapper">
                                <ul class="navbar-nav mb-2 mb-lg-0 mx-auto justify-content-center" id="top_menu">
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link#{' active' if request.httprequest.path.startswith('/shop/new-release') else ''}"
                                           href="/shop/new-release">New Releases
                                        </a>
                                    </li>
                                    <t t-set="men_val"
                                       t-value="request.env.ref('theme_velox.velox_attr_gender_men', raise_if_not_found=False)"/>
                                    <t t-set="women_val"
                                       t-value="request.env.ref('theme_velox.velox_attr_gender_women', raise_if_not_found=False)"/>
                                    <li class="nav-item">
                                        <t t-if="men_val">
                                            <a class="nav-link"
                                               t-attf-href="/shop/category/#{men_val.id}">Men
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <a class="nav-link" href="/shop">Men</a>
                                        </t>
                                    </li>
                                    <li class="nav-item">
                                        <t t-if="women_val">
                                            <a class="nav-link"
                                               t-attf-href="/shop/category/#{women_val.id}">Women
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <a class="nav-link" href="/shop">Women</a>
                                        </t>
                                    </li>
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link#{' active' if request.httprequest.path.startswith('/shop/sale') else ''}"
                                           href="/shop/sale">Sale
                                        </a>
                                    </li>
                                    <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                        <t t-if="submenu.url not in ['/', '/shop', '/contactus']">
                                            <t t-call="website.submenu">
                                                <t t-set="item_class" t-value="'nav-item'"/>
                                                <t t-set="link_class" t-value="'nav-link'"/>
                                            </t>
                                        </t>
                                    </t>
                                </ul>
                            </div>

                            <!-- Mobile User Section -->
                            <div class="velox-sidebar-user-section d-lg-none">
                                <t t-if="not user_id._is_public()">
                                    <div class="velox-user-info">
                                        <div class="velox-avatar me-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="12" cy="7" r="4"></circle>
                                            </svg>
                                        </div>
                                        <span t-esc="user_id.name"/>
                                    </div>
                                    <a class="velox-user-link" href="/my/home">
                                        <i class="fa fa-user me-2"/>My Account
                                    </a>
                                    <a class="velox-user-link text-danger" href="/web/session/logout?redirect=/">
                                        <i class="fa fa-sign-out me-2"/>Logout
                                    </a>
                                </t>
                                <t t-else="">
                                    <a class="velox-user-link" href="/web/login">
                                        <i class="fa fa-sign-in me-2"/>Sign In
                                    </a>
                                </t>
                            </div>
                        </div>

                    </div>
                </nav>
                <div class="modal fade css_editable_mode_hidden" id="o_search_modal" aria-hidden="true"
                     tabindex="-1">
                    <div class="modal-dialog modal-lg pt-5">
                        <div class="modal-content mt-5">
                            <t t-call="website.header_search_box_input">
                                <t t-set="_classes" t-valuef="input-group-lg"/>
                            </t>
                        </div>
                    </div>
                </div>
            </header>
        </xpath>
    </template>
    <!-- Search template Customisation  -->
    <template id="velox_search_overlay" name="Velox Search Overlay"
              inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <div class="velox-search-overlay" id="searchOverlay" t-ignore="true" data-oe-readonly="true">
                <button class="velox-search-close" id="closeSearchBtn">&#215;</button>
                <div class="velox-search-inner">
                    <form action="/shop" class="velox-search-form" id="searchForm" method="get">
                        <input type="text" name="search" placeholder="WHAT ARE YOU LOOKING FOR?"
                               class="velox-search-input" id="searchInput" autocomplete="off"/>
                        <button type="submit" class="velox-search-submit oe_search_button" aria-label="Submit Search">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                      stroke-width="2"
                                      d="m21 21l-4.343-4.343m0 0A8 8 0 1 0 5.343 5.343a8 8 0 0 0 11.314 11.314"/>
                            </svg>
                        </button>
                    </form>
                    <div class="velox-popular-searches">
                        <p>POPULAR SEARCHES</p>
                        <div class="velox-search-tags">
                            <a href="/shop?search=Running+Shoes" class="velox-search-tag">Running Shoes</a>
                            <a href="/shop?search=Tech+Fleece" class="velox-search-tag">Tech Fleece</a>
                            <a href="/shop?search=Training+Shorts" class="velox-search-tag">Training Shorts</a>
                            <a href="/shop?search=Bags" class="velox-search-tag">Bags &amp; Backpacks</a>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="velox_user_dropdown" inherit_id="portal.user_dropdown">
        <xpath expr="//a" position="replace">
            <a href="#" role="button" data-bs-toggle="dropdown"
               t-attf-class="#{'' if _no_caret else 'dropdown-toggle'} #{_link_class}">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                     viewBox="0 0 24 24">
                    <g fill="none" stroke="currentColor" stroke-linecap="round"
                       stroke-linejoin="round" stroke-width="2">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </g>
                </svg>
            </a>
        </xpath>
    </template>

</odoo>
