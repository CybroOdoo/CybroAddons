<?xml version="1.0" encoding="utf-8"?>
<!-- Main homepage hero banner snippet with high-impact call-to-actions. -->
<odoo>
    <template id="s_velox_hero_snippet" name="Velox Hero Banner">
        <section class="s_velox_hero o_colored_level hero pb0 pt0"
                 data-snippet="s_velox_hero"
                 data-name="Velox Hero Banner"
                 style="background-image:url('/theme_velox/static/src/img/banner.jpg');">
            <div class="container s_velox_hero_content container-fluid">
                <div class="row s_nb_column_fixed">
                    <div class="col-lg-12 col-md-12 text-center text-lg-start">
                        <p class="s_text_block s_velox_hero_eyebrow" data-name="Eyebrow">
                            Latest Innovation
                        </p>
                        <h1 class="s_title s_velox_hero_title" data-name="Title">DEFY
                            GRAVITY.<br/>UNLEASH SPEED.
                        </h1>
                        <p class="s_text_block s_velox_hero_desc" data-name="Description">
                            Experience the next generation of performance running with the
                            new Phantom X.
                            <br/>
                            Designed for ultimate energy return and unparalleled
                            responsiveness on the track or the street.
                        </p>
                        <div class="s_velox_hero_btns">
                            <t t-set="g"
                               t-value="request.env['product.attribute'].sudo().search([('name','=','Gender')], limit=1)"/>
                            <t t-set="mv"
                               t-value="g.value_ids.filtered(lambda v: v.name == 'Men')[:1] if g else request.env['product.attribute.value']"/>
                            <t t-set="wv"
                               t-value="g.value_ids.filtered(lambda v: v.name == 'Women')[:1] if g else request.env['product.attribute.value']"/>
                            <t t-if="g and mv">
                                <a t-attf-href="/shop?attribute_value=#{g.id}-#{mv.id}"
                                   class="btn btn-primary btn-velox-primary">Shop Men's
                                </a>
                            </t>
                            <t t-else="">
                                <a href="/shop" class="btn btn-primary btn-velox-primary">
                                    Shop Men's
                                </a>
                            </t>
                            <t t-if="g and wv">
                                <a t-attf-href="/shop?attribute_value=#{g.id}-#{wv.id}"
                                   class="btn btn-outline-light btn-velox-outline">Shop
                                    Women's
                                </a>
                            </t>
                            <t t-else="">
                                <a href="/shop"
                                   class="btn btn-outline-light btn-velox-outline">Shop
                                    Women's
                                </a>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
