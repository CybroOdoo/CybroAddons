<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hero Banner Snippet -->
    <template id="s_velox_hero_snippet" name="Velox Hero Banner">
        <section class="s_velox_hero o_colored_level hero pb0 pt0 position-relative"
                 data-snippet="theme_velox.s_velox_hero_snippet"
                 data-name="Velox Hero Banner">
            <t t-set="g" t-value="request.env.ref('theme_velox.velox_attr_gender', raise_if_not_found=False)"/>
            <t t-set="mv" t-value="request.env.ref('theme_velox.velox_attr_gender_men', raise_if_not_found=False)"/>
            <t t-set="wv" t-value="request.env.ref('theme_velox.velox_attr_gender_women', raise_if_not_found=False)"/>

            <div class="hero-inner position-absolute top-0 start-0 w-100 h-100">
                <img class="hero-bg o_we_image" src="/theme_velox/static/src/img/banner.jpg" alt="Hero Background"/>
            </div>
            <div class="container s_velox_hero_content container-fluid">
                <div class="row s_nb_column_fixed">
                    <div class="col-lg-12 col-md-12 text-center text-lg-start">
                        <p class="s_text_block s_velox_hero_eyebrow text-white" data-name="Eyebrow">Latest Innovation
                        </p>
                        <h1 class="s_title s_velox_hero_title text-white" data-name="Title">DEFY GRAVITY.<br/>UNLEASH
                            SPEED.
                        </h1>
                        <p class="s_text_block s_velox_hero_desc text-white" data-name="Description">
                            Experience the next generation of performance running with the new Phantom X.
                            <br/>
                            Designed for ultimate energy return and unparalleled responsiveness on the track or the
                            street.
                        </p>
                        <div class="s_velox_hero_btns">
                            <t t-if="g and mv">
                                <a t-attf-href="/shop?attribute_values=#{g.id}-#{mv.id}"
                                   class="btn btn-primary btn-velox-primary">Shop Men's
                                </a>
                            </t>
                            <t t-else="">
                                <a href="/shop" class="btn btn-primary btn-velox-primary">Shop Men's</a>
                            </t>
                            <t t-if="g and wv">
                                <a t-attf-href="/shop?attribute_values=#{g.id}-#{wv.id}"
                                   class="btn btn-outline-light btn-velox-outline">Shop Women's
                                </a>
                            </t>
                            <t t-else="">
                                <a href="/shop" class="btn btn-outline-light btn-velox-outline">Shop Women's</a>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
