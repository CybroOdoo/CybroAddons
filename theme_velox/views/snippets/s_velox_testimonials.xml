<?xml version="1.0" encoding="utf-8"?>
<!-- Athlete testimonials and ratings carousel snippet. -->
<odoo>
    <template id="s_velox_testimonials_snippet" name="Velox Testimonials">
        <section class="s_velox_testimonials o_colored_level pt64 pb64"
                 data-snippet="s_velox_testimonials"
                 data-name="Velox Testimonials">
            <div class="container container-fluid">
                <div class="velox-section-header mb40">
                    <h2 class="s_title velox-section-title" data-name="Section Title">What
                        Athletes Say
                    </h2>
                </div>
                <div class="row g-4 s_nb_column_fixed">
                    <div class="col-lg-4 col-md-12 pt16 pb16">
                        <div class="velox-testimonial-card card border-0 h-100 p-4">
                            <div class="card-body">
                                <div class="velox-testimonial-stars mb32">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                                <p class="s_text_block velox-testimonial-text card-text"
                                   data-name="Review 1">The Phantom X Pro completely
                                    changed my race performance. The energy return is
                                    unreal &#8212; PR'd my last marathon by 8 minutes.
                                </p>
                                <div class="d-flex align-items-center mt24">
                                    <div class="ps-3">
                                        <p class="s_title velox-testimonial-author mb-0"
                                           data-name="Author 1">Sarah K.
                                        </p>
                                        <p class="s_text_block velox-testimonial-role small mb-0"
                                           data-name="Role 1">Marathon Runner
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-12 pt16 pb16">
                        <div class="velox-testimonial-card card border-0 h-100 p-4">
                            <div class="card-body">
                                <div class="velox-testimonial-stars mb32">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                                <p class="s_text_block velox-testimonial-text card-text"
                                   data-name="Review 2">Best training gear I've ever worn.
                                    The AeroKnit Jacket keeps me dry during HIIT sessions
                                    and looks incredible.
                                </p>
                                <div class="d-flex align-items-center mt24">
                                    <div class="ps-3">
                                        <p class="s_title velox-testimonial-author mb-0"
                                           data-name="Author 2">Marcus T.
                                        </p>
                                        <p class="s_text_block velox-testimonial-role small mb-0"
                                           data-name="Role 2">CrossFit Athlete
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-12 pt16 pb16">
                        <div class="velox-testimonial-card card border-0 h-100 p-4">
                            <div class="card-body">
                                <div class="velox-testimonial-stars mb32">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                                <p class="s_text_block velox-testimonial-text card-text"
                                   data-name="Review 3">Velox is in a league of its own.
                                    Court Master 3000s give me unmatched court feel and my
                                    ankles have never felt safer.
                                </p>
                                <div class="d-flex align-items-center mt24">
                                    <div class="ps-3">
                                        <p class="s_title velox-testimonial-author mb-0"
                                           data-name="Author 3">Jordan L.
                                        </p>
                                        <p class="s_text_block velox-testimonial-role small mb-0"
                                           data-name="Role 3">Basketball Player
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
