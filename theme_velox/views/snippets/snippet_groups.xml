<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Velox Snippet template -->
    <template id="velox_snippets_panel" name="Velox Snippets"
              inherit_id="website.snippets">
        <xpath expr="//*[@id='snippet_structure']//t[@t-snippet]" position="after">
            <t t-snippet="theme_velox.s_velox_hero_snippet"
               string="Velox Hero Banner"
               t-thumbnail="/theme_velox/static/src/img/thumbs/hero.svg"/>

            <t t-snippet="theme_velox.s_velox_features_snippet"
               string="Velox Feature Strip"
               t-thumbnail="/theme_velox/static/src/img/thumbs/features.svg"/>

            <t t-snippet="theme_velox.s_velox_new_arrivals_snippet"
               string="Velox New Arrivals"
               t-thumbnail="/theme_velox/static/src/img/thumbs/featured.svg"/>

            <t t-snippet="theme_velox.s_velox_sale_products_snippet"
               string="Velox Sale Products"
               t-thumbnail="/theme_velox/static/src/img/thumbs/featured.svg"/>

            <t t-snippet="theme_velox.s_velox_sport_categories_snippet"
               string="Velox Sport Categories"
               t-thumbnail="/theme_velox/static/src/img/thumbs/sport_cats.svg"/>

            <t t-snippet="theme_velox.s_velox_club_banner_snippet"
               string="Velox Club Banner"
               t-thumbnail="/theme_velox/static/src/img/thumbs/club.svg"/>

            <t t-snippet="theme_velox.s_velox_trending_grid_snippet"
               string="Velox Trending Now"
               t-thumbnail="/theme_velox/static/src/img/thumbs/featured.svg"/>

            <t t-snippet="theme_velox.s_velox_seasonal_banner_snippet"
               string="Velox Seasonal Banner"
               t-thumbnail="/theme_velox/static/src/img/thumbs/seasonal.svg"/>

            <t t-snippet="theme_velox.s_velox_testimonials_snippet"
               string="Velox Testimonials"
               t-thumbnail="/theme_velox/static/src/img/thumbs/testimonials.svg"/>

            <t t-snippet="theme_velox.s_velox_stats_snippet"
               string="Velox Brand Stats"
               t-thumbnail="/theme_velox/static/src/img/thumbs/stats.svg"/>

            <t t-snippet="theme_velox.s_velox_featured_product_snippet"
               string="Velox Featured Product"
               t-thumbnail="/theme_velox/static/src/img/thumbs/featured.svg"/>

        </xpath>
    </template>
</odoo>
