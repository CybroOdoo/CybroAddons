<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippets -->
    <template id="velox_snippets_panel" name="Velox Snippets" inherit_id="website.snippets">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg" string="Velox Sections"
               snippet-group="velox"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_velox.s_velox_hero_snippet" string="Velox Hero Banner" group="velox"/>
            <t t-snippet="theme_velox.s_velox_features_snippet" string="Velox Feature Strip" group="velox"/>
            <t t-snippet="theme_velox.s_velox_new_arrivals_snippet" string="Velox New Arrivals" group="velox"/>
            <t t-snippet="theme_velox.s_velox_sale_products_snippet" string="Velox Sale Products" group="velox"/>
            <t t-snippet="theme_velox.s_velox_sport_categories_snippet" string="Velox Sport Categories" group="velox"/>
            <t t-snippet="theme_velox.s_velox_club_banner_snippet" string="Velox Club Banner" group="velox"/>
            <t t-snippet="theme_velox.s_velox_trending_grid_snippet" string="Velox Trending Now" group="velox"/>
            <t t-snippet="theme_velox.s_velox_seasonal_banner_snippet" string="Velox Seasonal Banner" group="velox"/>
            <t t-snippet="theme_velox.s_velox_testimonials_snippet" string="Velox Testimonials" group="velox"/>
            <t t-snippet="theme_velox.s_velox_stats_snippet" string="Velox Brand Stats" group="velox"/>
            <t t-snippet="theme_velox.s_velox_featured_product_snippet" string="Velox Featured Product" group="velox"/>
        </xpath>
    </template>
</odoo>
