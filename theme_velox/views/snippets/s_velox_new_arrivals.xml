<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- New Arrivals Snippet -->
    <template id="s_velox_new_arrivals_snippet" name="Velox New Arrivals">
        <t t-set="new_ribbon" t-value="request.env.ref('website_sale.new_ribbon', raise_if_not_found=False)"/>
        <t t-set="new_products"
           t-value="request.env['product.template'].sudo().search([('is_published', '=', True), ('website_ribbon_id', '=', new_ribbon.id)], order='create_date desc', limit=8) if new_ribbon else request.env['product.template'].sudo().browse()"/>
        <t t-set="products_in_wishlist"
           t-value="request.env['product.wishlist'].sudo().search([('partner_id', '=', request.env.user.partner_id.id)]).mapped('product_id.product_tmpl_id') if (request.env.registry.models.get('product.wishlist') and not request.env.user._is_public()) else request.env['product.template'].sudo().browse()"/>
        <section id="new_arrivals" class="s_velox_new_arrivals o_colored_level new-arrivals pb64 pt64"
                 data-snippet="theme_velox.s_velox_new_arrivals_snippet"
                 data-name="Velox New Arrivals">
            <div class="container container-fluid">
                <div class="velox-section-header mb40">
                    <h2 class="s_title velox-section-title text-white" data-name="Section Title">New Arrivals</h2>
                    <a href="/shop/new-release" class="velox-section-link">Shop All New Releases</a>
                </div>
                <div class="velox-products-wrap">
                    <t t-if="new_products">
                        <div class="row g-3">
                            <t t-foreach="new_products" t-as="product">
                                <div class="col-6 col-md-4 col-lg-3">
                                    <t t-call="theme_velox.velox_product_card"/>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <p class="text-center velox-section-link">No new arrivals yet. Check back soon!</p>
                    </t>
                </div>
            </div>
        </section>
    </template>
</odoo>
