<?xml version="1.0" encoding="utf-8"?>
<!-- Velox athletic club registration promotion banner snippet. -->
<odoo>
    <template id="s_velox_club_banner_snippet" name="Velox Club Banner">
        <section class="s_velox_club_banner o_colored_level velox-club pb64 pt64"
                 data-snippet="s_velox_club_banner"
                 data-name="Velox Club Banner">
            <div class="container container-fluid">
                <div class="velox-club-inner">
                    <div class="velox-club-left">
                        <div class="velox-club-icon">
                            <i class="fa fa-trophy fa-3x" role="img" aria-label="Trophy"/>
                        </div>
                        <div>
                            <p class="s_title velox-club-name" data-name="Club Name">The
                                Velox Club
                            </p>
                            <p class="s_text_block velox-club-desc"
                               data-name="Club Description">
                                Join for exclusive product drops, free shipping, and
                                personalized workout plans tailored for you. Unlock
                                rewards with every purchase.
                            </p>
                        </div>
                    </div>
                    <a href="/contactus" class="btn btn-primary btn-club">Join for Free
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>
