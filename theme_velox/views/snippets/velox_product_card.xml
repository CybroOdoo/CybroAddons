<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Card Snippet -->
    <template id="velox_product_card" name="Velox Product Card">
        <article class="velox-card h-100">
            <a t-att-href="product.website_url" class="velox-card-img-link d-block text-decoration-none">
                <div class="velox-card-img-wrap">
                    <t t-if="product.image_1920">
                        <img t-attf-src="/web/image/product.template/#{product.id}/image_512/400x500"
                             t-att-alt="product.name"
                             class="velox-card-img"
                             loading="lazy"/>
                    </t>
                    <t t-else="">
                        <img src="/web/static/img/placeholder.png"
                             t-att-alt="product.name"
                             class="velox-card-img"
                             loading="lazy"/>
                    </t>
                    <t t-if="product.website_ribbon_id">
                        <span class="velox-card-ribbon" t-esc="product.website_ribbon_id.name"/>
                    </t>
                    <t t-elif="product.compare_list_price and product.compare_list_price &gt; product.list_price">
                        <span class="velox-card-ribbon">SALE</span>
                    </t>

                    <!-- Add to Cart: POST form to /shop/cart/update (works outside shop grid context) -->
                    <t t-set="_variant_id" t-value="product._get_first_possible_variant_id()"/>
                    <t t-if="_variant_id">
                        <form action="/shop/cart/update" method="post"
                              class="velox-card-cart-form"
                              t-att-data-product-template-id="product.id">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="product_id" t-att-value="_variant_id"/>
                            <input type="hidden" name="product_template_id" t-att-value="product.id"/>
                            <input type="hidden" name="add_qty" value="1"/>
                            <button type="submit"
                                    class="velox-grid-cart-btn"
                                    aria-label="Add to cart"
                                    title="Add to cart">
                                <i class="fa fa-shopping-bag"/>
                            </button>
                        </form>
                    </t>

                    <!-- Wishlist button: always rendered, styled via CSS, handled by our JS -->
                    <t t-set="_in_wish" t-value="product in (products_in_wishlist or [])"/>
                    <button
                            type="button"
                            t-attf-class="velox-grid-wishlist-btn o_add_wishlist #{_in_wish and 'o_in_wishlist' or ''}"
                            t-att-data-product-template-id="product.id"
                            t-att-data-product-product-id="product._get_first_possible_variant_id()"
                            data-action="o_wishlist"
                            t-att-disabled="_in_wish or False"
                            aria-label="Add to wishlist"
                            title="Add to wishlist"
                    >
                        <i t-attf-class="fa #{_in_wish and 'fa-heart' or 'fa-heart-o'}"/>
                    </button>
                </div>
            </a>
            <div class="velox-card-body">
                <p class="velox-card-brand">VELOX</p>
                <a t-att-href="product.website_url" class="velox-card-name-link text-decoration-none">
                    <h3 class="velox-card-name" t-esc="product.name"/>
                </a>
                <div class="velox-card-price-row">
                    <t t-if="product.compare_list_price and product.compare_list_price &gt; product.list_price">
                        <span class="velox-card-price velox-card-price-sale">
                            <t t-esc="product.currency_id.symbol"/>
                            <t t-esc="'%.2f' % product.list_price"/>
                        </span>
                        <span class="velox-card-price-old">
                            <t t-esc="product.currency_id.symbol"/>
                            <t t-esc="'%.2f' % product.compare_list_price"/>
                        </span>
                    </t>
                    <t t-else="">
                        <span class="velox-card-price">
                            <t t-esc="product.currency_id.symbol"/>
                            <t t-esc="'%.2f' % product.list_price"/>
                        </span>
                    </t>
                </div>
            </div>
        </article>
    </template>
</odoo>
