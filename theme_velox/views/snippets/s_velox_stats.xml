<?xml version="1.0" encoding="utf-8"?>
<!-- Stats snippet showing brand achievements and records. -->
<odoo>
    <template id="s_velox_stats_snippet" name="Velox Brand Stats">
        <section class="s_velox_stats o_colored_level pt48 pb48"
                 data-snippet="s_velox_stats"
                 data-name="Velox Brand Stats">
            <div class="container container-fluid">
                <div class="row s_nb_column_fixed">
                    <div class="col-6 col-lg-3 text-center pt16 pb16">
                        <div class="velox-stat-item">
                            <div class="s_title velox-stat-number" data-name="Stat 1">
                                2M+
                            </div>
                            <div class="s_text_block velox-stat-label"
                                 data-name="Label 1">Athletes Worldwide
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3 text-center pt16 pb16">
                        <div class="velox-stat-item">
                            <div class="s_title velox-stat-number" data-name="Stat 2">
                                120+
                            </div>
                            <div class="s_text_block velox-stat-label"
                                 data-name="Label 2">Products
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3 text-center pt16 pb16">
                        <div class="velox-stat-item">
                            <div class="s_title velox-stat-number" data-name="Stat 3">48
                            </div>
                            <div class="s_text_block velox-stat-label"
                                 data-name="Label 3">Countries
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3 text-center pt16 pb16">
                        <div class="velox-stat-item">
                            <div class="s_title velox-stat-number" data-name="Stat 4">12
                            </div>
                            <div class="s_text_block velox-stat-label"
                                 data-name="Label 4">World Records
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
