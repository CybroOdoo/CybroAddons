<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Velox Sport Categories Template -->
    <template id="s_velox_sport_categories_snippet" name="Velox Sport Categories">
        <section class="s_velox_sport_categories o_colored_level shop-by-sport pb64 pt64"
                 data-snippet="s_velox_sport_categories"
                 data-name="Velox Sport Categories">
            <div class="container container-fluid">
                <div class="velox-section-header mb32">
                    <h2 class="s_title velox-section-title" data-name="Section Title">Shop by Categories</h2>
                    <a href="/shop" class="velox-section-link">View All</a>
                </div>
                <div class="velox-sport-grid">
                    <t t-foreach="request.env['product.public.category'].search([('parent_id', '=', False)], limit=5)"
                       t-as="category">
                        <a t-attf-href="/shop/category/#{slug(category)}" class="velox-sport-card">
                            <img t-if="category.image_1920"
                                 t-attf-src="/web/image/product.public.category/#{category.id}/image_512"
                                 t-att-alt="category.name"
                                 class="o_editable_media" loading="lazy"
                                 style="object-fit:cover;width:100%;height:100%;"/>
                            <img t-else="" src="/web/static/img/placeholder.png"
                                 class="o_editable_media" loading="lazy"
                                 style="object-fit:cover;width:100%;height:100%;"/>
                            <span class="velox-sport-label fw-bold" t-esc="category.name"/>
                        </a>
                    </t>
                </div>
            </div>
        </section>
    </template>
</odoo>
