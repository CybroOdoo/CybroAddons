<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Products Snippet -->
    <template id="s_velox_sale_products_snippet" name="Velox Sale Products">
        <t t-set="sale_ribbon" t-value="request.env.ref('website_sale.sale_ribbon', raise_if_not_found=False)"/>
        <t t-set="sale_products"
           t-value="request.env['product.template'].sudo().search([('is_published', '=', True), ('website_ribbon_id', '=', sale_ribbon.id)], order='create_date desc', limit=8) if sale_ribbon else request.env['product.template'].sudo().browse()"/>
        <t t-set="products_in_wishlist"
           t-value="request.env['product.wishlist'].sudo().search([('partner_id', '=', request.env.user.partner_id.id)]).mapped('product_id.product_tmpl_id') if (request.env.registry.models.get('product.wishlist') and not request.env.user._is_public()) else request.env['product.template'].sudo().browse()"/>
        <section id="sale_products" class="s_velox_sale_products o_colored_level velox-sale-section pb64 pt64"
                 data-snippet="theme_velox.s_velox_sale_products_snippet"
                 data-name="Velox Sale Products">
            <div class="container container-fluid">
                <div class="velox-section-header mb40">
                    <h2 class="s_title velox-section-title text-white" data-name="Sale Title">
                        <span style="color:var(--velox-accent)">SALE</span> &#8212; Limited Time
                    </h2>
                    <a href="/shop/sale" class="velox-section-link">Shop All Sale</a>
                </div>
                <div class="velox-products-wrap">
                    <t t-if="sale_products">
                        <div class="row g-3">
                            <t t-foreach="sale_products" t-as="product">
                                <div class="col-6 col-md-4 col-lg-3">
                                    <t t-call="theme_velox.velox_product_card"/>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <p class="text-center velox-section-link">No sale products at the moment. Check back soon!</p>
                    </t>
                </div>
            </div>
        </section>
    </template>
</odoo>
