<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Featured Product Snippet -->
    <template id="s_velox_featured_product_snippet" name="Velox Featured Product">
        <section class="s_velox_featured_product o_colored_level py-5"
                 data-snippet="theme_velox.s_velox_featured_product_snippet"
                 data-name="Velox Featured Product">
            <div class="container container-fluid">
                <div class="row align-items-center g-5 s_nb_column_fixed">
                    <div class="col-lg-6 pt24 pb24">
                        <div class="velox-featured-img-wrap shadow-lg">
                            <img src="/theme_velox/static/src/img/placeholder.jpg"
                                 alt="Featured Product"
                                 class="img-fluid w-100 o_editable_media"
                                 loading="lazy"/>
                        </div>
                    </div>
                    <div class="col-lg-6 pt24 pb24">
                        <p class="s_text_block velox-product-brand text-white-50 text-uppercase fw-bold"
                           data-name="Brand Label">VELOX
                        </p>
                        <h2 class="s_title velox-featured-title text-white" data-name="Product Name">PHANTOM X<br/>PRO
                        </h2>
                        <p class="s_text_block velox-featured-desc lead text-white" data-name="Product Description">
                            Our flagship running shoe, engineered with CarbonFlex technology for maximum energy return.
                            Worn by world-record holders. Built for champions.
                        </p>
                        <p class="s_title velox-featured-price h2 text-white" data-name="Price">$180.00</p>
                        <div class="d-flex gap-3 flex-wrap">
                            <a href="/shop" class="btn btn-primary btn-lg">Shop Now</a>
                            <a href="/shop" class="btn btn-outline-light btn-lg">Learn More</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
