<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Seasonal Banner Snippet -->
    <template id="s_velox_seasonal_banner_snippet" name="Velox Seasonal Banner">
        <section class="s_velox_seasonal_banner o_colored_level winter-banner pb64 pt64"
                 data-snippet="theme_velox.s_velox_seasonal_banner_snippet"
                 data-name="Velox Seasonal Banner">
            <div class="container">
                <div class="winter-card position-relative overflow-hidden rounded-4 pb128 pt128 px-4 px-md-5"
                     data-name="Winter Card">
                    <img class="winter-bg o_we_image" src="/theme_velox/static/src/img/winter.png"
                         alt="Winter Collection"/>
                    <div class="winter-overlay o_we_bg_filter bg-black-50"></div>
                    <div class="row position-relative z-1 s_nb_column_fixed s_velox_seasonal_content">
                        <div class="col-lg-5 col-md-7">
                            <h2 class="s_title s_velox_seasonal_title text-white" data-name="Season Title">THE<br/>
                                WINTER<br/>COLLECTION
                            </h2>
                            <p class="s_text_block s_velox_seasonal_desc text-white" data-name="Season Description">
                                Engineered to keep you warm and dry in the harshest conditions without compromising
                                mobility or performance.
                            </p>
                            <a href="/shop" class="btn mt24 btn-explore-collection">Explore Collection</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
