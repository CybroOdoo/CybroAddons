<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Velox Seasonal Template -->
    <template id="s_velox_seasonal_banner_snippet" name="Velox Seasonal Banner">
        <section class="s_velox_seasonal_banner o_colored_level winter-banner pb128 pt128"
                 data-snippet="s_velox_seasonal_banner"
                 data-name="Velox Seasonal Banner">
            <div class="winter-bg" style="background-image:url('/theme_velox/static/src/img/winter.png');"/>
            <div class="winter-overlay"/>
            <div class="container s_velox_seasonal_content container-fluid">
                <div class="row position-relative z-1 s_nb_column_fixed">
                    <div class="col-lg-5 col-md-7">
                        <h2 class="s_title s_velox_seasonal_title" data-name="Season Title">THE<br/>WINTER<br/>
                            COLLECTION
                        </h2>
                        <p class="s_text_block s_velox_seasonal_desc" data-name="Season Description">
                            Engineered to keep you warm and dry in the harshest conditions without compromising mobility
                            or performance.
                        </p>
                        <a href="/shop" class="btn btn-primary mt24">Explore Collection</a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
