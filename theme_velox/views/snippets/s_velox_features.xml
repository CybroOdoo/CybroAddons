<?xml version="1.0" encoding="utf-8"?>
<!-- Brand features list snippet showing trust badges and USPs. -->
<odoo>
    <template id="s_velox_features_snippet" name="Velox Feature Strip">
        <section class="s_velox_features o_colored_level pb24 pt24"
                 data-snippet="s_velox_features"
                 data-name="Velox Feature Strip">
            <div class="container container-fluid">
                <div class="row g-0 s_nb_column_fixed">
                    <div class="col-lg-3 col-md-6 col-6 pt8 pb8">
                        <div class="velox-feature-item">
                            <div class="velox-feature-icon">
                                <i class="fa fa-truck fa-2x" role="img"
                                   aria-label="Shipping"/>
                            </div>
                            <div>
                                <p class="s_title velox-feature-title"
                                   data-name="Feature 1 Title">Free Shipping
                                </p>
                                <p class="s_text_block velox-feature-text"
                                   data-name="Feature 1 Text">On orders over $100
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-6 pt8 pb8">
                        <div class="velox-feature-item">
                            <div class="velox-feature-icon">
                                <i class="fa fa-undo fa-2x" role="img"
                                   aria-label="Returns"/>
                            </div>
                            <div>
                                <p class="s_title velox-feature-title"
                                   data-name="Feature 2 Title">Free Returns
                                </p>
                                <p class="s_text_block velox-feature-text"
                                   data-name="Feature 2 Text">30-day return policy
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-6 pt8 pb8">
                        <div class="velox-feature-item">
                            <div class="velox-feature-icon">
                                <i class="fa fa-shield fa-2x" role="img"
                                   aria-label="Warranty"/>
                            </div>
                            <div>
                                <p class="s_title velox-feature-title"
                                   data-name="Feature 3 Title">2 Year Warranty
                                </p>
                                <p class="s_text_block velox-feature-text"
                                   data-name="Feature 3 Text">On all footwear
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-6 pt8 pb8">
                        <div class="velox-feature-item">
                            <div class="velox-feature-icon">
                                <i class="fa fa-headphones fa-2x" role="img"
                                   aria-label="Support"/>
                            </div>
                            <div>
                                <p class="s_title velox-feature-title"
                                   data-name="Feature 4 Title">24/7 Support
                                </p>
                                <p class="s_text_block velox-feature-text"
                                   data-name="Feature 4 Text">Athlete care team
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
