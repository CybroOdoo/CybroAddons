<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- User access groups -->
    <record id="group_risk_management_user" model="res.groups">
        <field name="name">Project Task Risk Management User</field>
    </record>

    <record id="group_risk_management_admin" model="res.groups">
        <field name="name">Project Task Risk Management Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_risk_management_user'))]"/>
    </record>

    <record id="rule_own_doc" model="ir.access">
        <field name="name">Project Task Risk Management View Own Docs</field>
        <field name="model_id" ref="model_risks_project"/>
        <field name="group_id" ref="group_risk_management_user"/>
        <field name="operation">crud</field>
        <field name="domain">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_all_doc" model="ir.access">
        <field name="name">View All Docs</field>
        <field name="model_id" ref="model_risks_project"/>
        <field name="group_id" ref="group_risk_management_admin"/>
        <field name="operation">crud</field>
    </record>
</odoo>
