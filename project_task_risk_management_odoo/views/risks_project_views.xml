<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Risk Type list View-->
    <record id="risks_project_view_list" model="ir.ui.view">
        <field name="name">risks.project.view.list</field>
        <field name="model">risks.project</field>
        <field name="arch" type="xml">
            <list string="Risks">
                <field name="code"/>
                <field name="risk_name"/>
                <field name="risk_quantification"/>
                <field name="category_id"/>
                <field name="risk_type_id"/>
                <field name="risk_response_id"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
            </list>
        </field>
    </record>
    <!--    Risk Project Form View-->
    <record id="risks_project_view_form" model="ir.ui.view">
        <field name="name">risks.project.view.form</field>
        <field name="model">risks.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="risk_name"/>
                            <field name="code"/>
                            <field name="risk_quantification"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="category_id" required="1"/>
                            <field name="risk_type_id" required="1"/>
                            <field name="risk_response_id" required="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Internal Notes" name="internal_notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>
    <!--    Risk Project Search View-->
    <record id="risks_project_view_search" model="ir.ui.view">
        <field name="name">risks.project.view.search</field>
        <field name="model">risks.project</field>
        <field name="arch" type="xml">
            <search string="Search Risks">
                <field name="risk_name" string="Risk"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="risk_type_id"/>
                <field name="risk_response_id"/>
                <field name="tag_ids"/>
                <separator/>
                <filter string="High Risk" name="filter_high_risk" domain="[('risk_quantification', '=', 'high')]"/>
                <filter string="Medium Risk" name="filter_medium_risk" domain="[('risk_quantification', '=', 'medium')]"/>
                <filter string="Low Risk" name="filter_low_risk" domain="[('risk_quantification', '=', 'low')]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Risk Type" name="group_type" context="{'group_by': 'risk_type_id'}"/>
                    <filter string="Quantification" name="group_quantification" context="{'group_by': 'risk_quantification'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
