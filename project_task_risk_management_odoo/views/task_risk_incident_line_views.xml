<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Task Risk Incident Line list View-->
    <record id="task_risk_incident_line_view_list" model="ir.ui.view">
        <field name="name">task.risk.incident.line.view.list</field>
        <field name="model">task.risk.incident.line</field>
        <field name="arch" type="xml">
            <list string="Risk Incident Lines" create="0">
                <field name="task_incident_order_id" column_invisible="1"/>
                <field name="risk_id"/>
                <field name="des"/>
                <field name="category_id" force_save="1"/>
                <field name="risk_response_id" force_save="1"/>
                <field name="risk_type_id" force_save="1"/>
                <field name="tag_ids" widget="many2many_tags"
                       force_save="1"
                       options="{'color_field': 'color'}"/>
                <field name="probability"/>
            </list>
        </field>
    </record>
    <!--    Task Risk Incident Line Pivot View -->
    <record id="task_risk_incident_line_view_pivot" model="ir.ui.view">
        <field name="name">task.risk.incident.line.view.pivot</field>
        <field name="model">task.risk.incident.line</field>
        <field name="arch" type="xml">
            <pivot string="Task Risks Analysis" display_quantity="1"
                   sample="1">
                <field name="risk_id" type="row"/>
                <field name="probability" type="col"/>
            </pivot>
        </field>
    </record>
    <!--    Task Risk Incident Line Graph View -->
    <record id="task_risk_incident_line_view_graph" model="ir.ui.view">
        <field name="name">task.risk.incident.line.view.graph</field>
        <field name="model">task.risk.incident.line</field>
        <field name="arch" type="xml">
            <graph string="Task Risks Analysis" sample="1">
                <field name="risk_id"/>
                <field name="probability"/>
            </graph>
        </field>
    </record>
    <!--    Task Risk Incident Line Search View -->
    <record id="task_risk_incident_line_view_search" model="ir.ui.view">
        <field name="name">task.risk.incident.line.view.search</field>
        <field name="model">task.risk.incident.line</field>
        <field name="arch" type="xml">
            <search string="Search Task Risks Analysis">
                <field name="risk_id"/>
                <field name="task_incident_order_id" string="Task"/>
                <field name="category_id"/>
                <field name="risk_type_id"/>
                <field name="tag_ids"/>
                <group>
                    <filter string="Task" name="group_task" context="{'group_by': 'task_incident_order_id'}"/>
                    <filter string="Risk" name="group_risk" context="{'group_by': 'risk_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
