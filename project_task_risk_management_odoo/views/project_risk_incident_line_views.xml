<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    Project Risk Incident Line list View-->
    <record id="project_risk_incident_line_view_list" model="ir.ui.view">
        <field name="name">project.risk.incident.line.view.list</field>
        <field name="model">project.risk.incident.line</field>
        <field name="arch" type="xml">
            <list string="Risk Incident Lines" create="0">
                <field name="incident_order_id" column_invisible="1"/>
                <field name="risk_id"/>
                <field name="des"/>
                <field name="category_id" force_save="1"/>
                <field name="risk_response_id" force_save="1"/>
                <field name="risk_type_id" force_save="1"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}" force_save="1"/>
                <field name="probability"/>
            </list>
        </field>
    </record>
<!--    Project Risk Incident Line Pivot View-->
    <record id="project_risk_incident_line_view_pivot" model="ir.ui.view">
        <field name="name">project.risk.incident.line.view.pivot</field>
        <field name="model">project.risk.incident.line</field>
        <field name="arch" type="xml">
            <pivot string="Project Risks Analysis" display_quantity="1" sample="1">
                <field name="risk_id" type="row"/>
                <field name="probability" type="col"/>
            </pivot>
        </field>
    </record>
<!--    Project Risk Incident Line. Graph View-->
    <record id="project_risk_incident_line_view_graph" model="ir.ui.view">
        <field name="name">project.risk.incident.line.view.graph</field>
        <field name="model">project.risk.incident.line</field>
        <field name="arch" type="xml">
            <graph string="Project Risks Analysis" sample="1">
                <field name="risk_id"/>
                <field name="probability"/>
            </graph>
        </field>
    </record>
</odoo>
