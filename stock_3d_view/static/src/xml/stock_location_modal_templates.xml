<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!--template to display location details such as product and its quantity in a modal dialog-->
    <t t-name="stock_3d_view.StockLocationDialog">
        <Dialog title="this.props.title || 'Location Details'" size="'sm'">
            <div class="p-3">
                <t t-if="this.props.data &amp;&amp; this.props.data.capacity &gt; 0">
                    <div class="text-center mb-3">
                        <h6 class="mb-1"><strong>Total Capacity:</strong> <span t-out="this.props.data.capacity"/> Units</h6>
                        <h6><strong>Available Space:</strong> <span t-out="this.props.data.space"/> Units</h6>
                    </div>
                </t>
                <t t-if="this.props.data &amp;&amp; this.props.data.product_list &amp;&amp; this.props.data.product_list.length &gt; 0">
                    <table class="table table-sm table-bordered mt-2">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px; text-align: center;">#</th>
                                <th style="padding-left: 10px;">Product</th>
                                <th style="padding-left: 10px; text-align: right; width: 90px;">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="num" t-value="1"/>
                            <t t-foreach="this.props.data.product_list" t-as="item" t-key="item_index">
                                <tr>
                                    <td style="text-align: center;"><span t-esc="num"/></td>
                                    <td style="padding-left: 10px;"><span t-esc="item[0]"/></td>
                                    <td style="padding-left: 10px; text-align: right;"><span t-esc="item[1]"/></td>
                                </tr>
                                <t t-set="num" t-value="num + 1"/>
                            </t>
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <div class="text-center text-muted my-3 py-2">
                        <span>No Products Stored Here...!</span>
                    </div>
                </t>
            </div>
        </Dialog>
    </t>
</templates>
