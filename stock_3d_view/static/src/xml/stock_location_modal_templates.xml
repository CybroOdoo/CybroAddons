<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="stock_3d_view.ViewLocationData">
        <div class="p-3">
            <t t-if="data.capacity > 0">
                <div class="text-center mb-2">
                    <h6>Total Capacity: <t t-esc="data.capacity"/> Units</h6>
                    <h6>Available Space: <t t-esc="data.space"/> Units</h6>
                </div>
            </t>
            <t t-if="data.product_list and data.product_list.length > 0">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th class="ps-2">Product</th>
                            <th class="ps-2">Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.product_list" t-as="product" t-key="product[0]">
                            <tr>
                                <td><t t-esc="product_index + 1"/></td>
                                <td class="ps-2"><t t-esc="product[0]"/></td>
                                <td class="ps-2"><t t-esc="product[1]"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else="">
                <div class="text-center opacity-75">No Products Stored Here...!</div>
            </t>
        </div>
    </t>

    <t t-name="stock_3d_view.PositionDialog" t-inherit="web.Dialog" t-inherit-mode="primary">
        <xpath expr="//main[hasclass('modal-body')]" position="replace">
            <main class="modal-body">
                <t t-call="stock_3d_view.ViewLocationData">
                    <t t-set="data" t-value="props.data"/>
                </t>
            </main>
        </xpath>
    </t>
</templates>
