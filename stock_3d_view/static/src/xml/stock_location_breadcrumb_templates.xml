<?xml version="1.0" encoding="utf-8" ?>
<templates id="stock_3d_form_view_template" xml:space="preserve">
    <!--adding breadcrumbs manually in stock.location form view.-->
    <t t-name="Location3DFormView" owl="1">
        <div t-ref="canvasContainer" class="o_3d_canvas_container"/>
        <div class="o_action">
            <div class="o_control_panel">
                <div class="o_cp_top">
                    <div class="o_cp_top_left">
                        <t t-slot="control-panel-top-left">
                            <Breadcrumbs breadcrumbs="state.breadcrumbs"/>
                        </t>
                    </div>
                </div>
                <div class="o_cp_bottom"/>
            </div>
            <div t-ref="contentDiv" class="o_content"/>
        </div>
    </t>
</templates>
