<templates xml:space="preserve">
    <!--adding breadcrumbs manually in stock.location form view.-->
    <t t-name="Location3DFormView">
        <div class="o_action">
            <div class="o_control_panel">
                <div class="o_cp_top">
                    <div class="o_cp_top_left">
                        <t t-slot="control-panel-top-left">
                            <ol class="breadcrumb">
                                <t t-foreach="state.breadcrumbs" t-as="breadcrumb" t-key="breadcrumb.jsId">
                                    <li class="breadcrumb-item">
                                        <a href="#" t-att-jsId="breadcrumb.jsId" t-on-click="onBreadcrumbClick">
                                            <t t-esc="breadcrumb.name"/>
                                        </a>
                                    </li>
                                </t>
                                <li class="breadcrumb-item active">
                                    <span class="text-muted">3D view</span>
                                </li>
                            </ol>
                        </t>
                    </div>
                </div>
                <div class="o_cp_bottom"/>
            </div>
            <div t-ref="contentDiv" class="o_content h-100 w-100" t-on-dblclick="onPointerMoveForm">
                <div t-ref="legend" class="rectangle" t-if="state.showLegend">
                    <div class="square1"></div><div class="squareText1">Overload</div>
                    <div class="square2"></div><div class="squareText2">Almost Full</div>
                    <div class="square3"></div><div class="squareText3">Free Space Available</div>
                    <div class="square4blue"></div><div class="squareText4">No Product/Load</div>
                </div>
            </div>
        </div>
    </t>
</templates>
