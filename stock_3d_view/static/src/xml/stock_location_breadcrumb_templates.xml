<?xml version="1.0" encoding="utf-8" ?>
<templates id="stock_3d_form_view_template" xml:space="preserve">
    <!--adding breadcrumbs manually in stock.location form view.-->
    <t t-name="Location3DFormView" owl="1">
        <div class="o_action stock_3d_view_root">
            <div class="o_control_panel">
                <div class="o_cp_top">
                    <div class="o_cp_top_left">
                        <t t-slot="control-panel-top-left">
                            <ol class="breadcrumb">
                                <t t-foreach="state.breadcrumbs" t-as="breadcrumb" t-key="breadcrumb_index">
                                    <t t-if="breadcrumb.name">
                                        <li class="breadcrumb-item">
                                            <a href="#" t-att-jsId="breadcrumb.jsId" t-on-click="onBreadcrumbClick">
                                                <t t-esc="breadcrumb.name"/>
                                            </a>
                                        </li>
                                    </t>
                                </t>
                                <li class="breadcrumb-item active">
                                    <span class="text-muted">3D view</span>
                                </li>
                            </ol>
                        </t>
                    </div>
                </div>
                <div class="o_cp_bottom"/>
            </div>
            <div t-ref="canvasContainer" class="o_content"/>
        </div>
    </t>
    <t t-name="Location3DListView" owl="1">
        <div t-ref="root" class="o_action stock_3d_view_root">
            <div class="o_control_panel">
                <div class="o_cp_top">
                    <div class="o_cp_top_left">
                        <t t-slot="control-panel-top-left">
                            <ol class="breadcrumb">
                                <t t-foreach="state.breadcrumbs" t-as="breadcrumb" t-key="breadcrumb_index">
                                    <t t-if="breadcrumb.name">
                                        <li class="breadcrumb-item">
                                            <a href="#" t-att-jsId="breadcrumb.jsId" t-on-click="onBreadcrumbClick">
                                                <t t-esc="breadcrumb.name"/>
                                            </a>
                                        </li>
                                    </t>
                                </t>
                                <li class="breadcrumb-item active">
                                    <span class="text-muted">3D View</span>
                                </li>
                            </ol>
                        </t>
                    </div>
                <div class="o_cp_top_right">
                    <t t-if="state.wh_data.length > 1">
                        <div class="d-flex align-items-center me-2">
                            <label class="me-2 mb-0 fw-bold text-muted">Warehouse:</label>
                            <select class="form-select form-select-sm w-auto border-0 bg-light shadow-sm" t-on-change="onWarehouseChange">
                                <t t-foreach="state.wh_data" t-as="wh" t-key="wh[0]">
                                    <option t-att-value="wh[0]" t-att-selected="state.wh_id == wh[0]">
                                        <t t-esc="wh[1]"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </t>
                </div>
                </div>
                <div class="o_cp_bottom"/>
            </div>
            <div t-ref="oContent" class="o_content"/>
        </div>
    </t>
</templates>
