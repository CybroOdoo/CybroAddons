<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!--extending listview button template to add 3D action button-->
    <t t-name="stock_3d_view.ListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="before">
            <div t-if="state.show3D" class="o_3d_view_container" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1000; background: white;">
                <div t-ref="content3D" class="h-100 w-100" t-on-dblclick="onPointerMove"></div>
                <button class="closeBtn" t-on-click="onClickClose3D">&#215;</button>
                <select class="customselect" t-on-change="warehouseChange">
                    <t t-foreach="state.wh_data" t-as="wh" t-key="wh[0]">
                        <option t-att-value="wh[0]" t-att-selected="state.wh_id == wh[0]"><t t-esc="wh[1]"/></option>
                    </t>
                </select>
                <div class="rectangle">
                    <div class="square1"></div><div class="squareText1">Overload</div>
                    <div class="square2"></div><div class="squareText2">Almost Full</div>
                    <div class="square3"></div><div class="squareText3">Free Space Available</div>
                    <div class="square4blue"></div><div class="squareText4">No Product/Load</div>
                </div>
            </div>
        </xpath>
       <xpath expr="//div[hasclass('o_list_buttons')]" position="after">
            <button type="button" class="btn btn-primary fa fa-lg fa-cubes open_3d_view"
                    style="margin-left: 3px; margin-right: 3px;" t-on-click="OnClickList3DvView">
                3D
            </button>
       </xpath>
   </t>
</templates>
