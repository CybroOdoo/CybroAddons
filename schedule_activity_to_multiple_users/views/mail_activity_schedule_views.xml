<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit the mail.activity.schedule form view and add the assign_multiple_user_ids field after the activity_user_id field container -->
    <record id="mail_activity_schedule_view_form" model="ir.ui.view">
        <field name="name">mail.activity.schedule.view.form.inherit.schedule.activity.to.multiple.users</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_user_id']/.." position="after">
                <div class="o_outlined d-flex align-items-center mb-2 gap-2">
                    <i class="oi oi-filled mb-2" data-icon="group" role="img" title="Assign Multiple Users" aria-label="Assign Multiple Users"/>
                    <field name="assign_multiple_user_ids"
                           widget="many2many_tags"
                           nolabel="1"
                           class="w-100"
                           placeholder="Assign Multiple Users"
                           options="{'no_create': True}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
