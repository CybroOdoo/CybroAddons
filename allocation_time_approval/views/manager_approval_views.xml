<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view for Manager Approval model -->
    <record id="manager_approval_view_list" model="ir.ui.view">
        <!--Create a new tree view-->
        <field name="name">manager.approval.view.list</field>
        <field name="model">manager.approval</field>
        <field name="arch" type="xml">
            <tree string="Manager Approval" editable="top" create="false">
                <!--Add certain fields to tree view-->
                <field name="task" readonly="button_view_boolean == True"/>
                <field name="project_id" readonly="button_view_boolean == True"/>
                <field name="user_ids" widget="many2many_avatar_user" readonly="button_view_boolean == True"/>
                <field name="planned_hours" readonly="button_view_boolean == True"/>
                <field name="button_view_boolean" invisible="1"/>
                <field name="button_view_boolean_cancel" invisible="1"/>
                <button name="action_approve" string="Approve"
                        class="oe_highlight" type="object"
                        invisible="button_view_boolean == True"/>
                <button name="action_manager_cancel" string="Cancel"
                        class="oe_highlight" type="object"
                invisible="button_view_boolean_cancel == True"/>
            </tree>
        </field>
    </record>
    <!-- Search view for Manager Approval model -->
    <record id="manager_approval_view_search" model="ir.ui.view">
        <field name="name">manager.approval.view.search</field>
        <field name="model">manager.approval</field>
        <field name="arch" type="xml">
            <search string="Manager Approval Search">
                <field name="task" string="Task"/>
                <field name="project_id" string="Project"/>
                <field name="user_ids" string="Assignees"/>
                <filter string="Pending" name="pending" domain="[('button_view_boolean', '=', False), ('button_view_boolean_cancel', '=', False)]"/>
                <filter string="Approved" name="approved" domain="[('button_view_boolean', '=', True)]"/>
                <filter string="Canceled" name="canceled" domain="[('button_view_boolean_cancel', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--Action for Allocation Time Approval-->
    <!-- Window Action for Manager Approval -->
    <record id="manager_approval_action" model="ir.actions.act_window">
        <field name="name">Allocation Time Approval</field>
        <field name="res_model">manager.approval</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="manager_approval_view_search"/>
    </record>
    <!--Add a menu in Timesheet module-->
    <!-- Menu Item for Allocated Hour Approval, placed under Timesheet/Time Tracking -->
    <menuitem name="Allocated Hour Approval" id="allocated_hour_approval"
              action="manager_approval_action"
              parent="hr_timesheet.menu_hr_time_tracking"
              groups="project.group_project_manager"/>
</odoo>
