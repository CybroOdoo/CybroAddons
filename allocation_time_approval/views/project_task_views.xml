<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.allocation.time.approval</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approval" string="Manager Approval" type="object"
                        invisible="not is_new_stage"/>
                <button name="action_done" string="Done" type="object"
                        invisible="not is_progress_stage"/>
                <button name="action_cancel" string="Cancel" type="object"
                        invisible="not is_progress_stage"/>
            </xpath>
            <field name="tag_ids" position="after">
                <field name="is_new_stage" invisible="1"/>
                <field name="is_approve_stage" invisible="1"/>
                <field name="is_progress_stage" invisible="1"/>
            </field>
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">is_approve_stage</attribute>
            </xpath>
            <xpath expr="//field[@name='allocated_hours']" position="attributes">
                <attribute name="readonly">is_progress_stage</attribute>
            </xpath>
        </field>
    </record>
</odoo>
