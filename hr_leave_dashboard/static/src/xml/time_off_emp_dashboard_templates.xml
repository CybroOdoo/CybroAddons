<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!--    This template is an extension of the "hr_holidays.TimeOffDashboard"-->
    <!--    template and includes four sub-templates to display information about an -->
    <!--    employee's time off, organization chart, department, and approval status. -->
    <!--    It uses the "current_employee" object to fetch and display relevant information.-->
    <t t-name="hr_leave_dashboard.TimeOffEmpDashboard"
       t-inherit="hr_holidays.TimeOffDashboard" t-inherit-mode="extension"
       class="o_timeoff_dashboard">
        <xpath expr="//div[hasclass('overflow-x-auto')]" position="after">
          <div class="o_hr_leave_dashboard_cards">
            <TimeOffEmpCard name="this.currentEmployee.data.name"
                            id="this.currentEmployee.data.id"
                            work_email="this.currentEmployee.data.work_email"
                            work_phone="this.currentEmployee.data.work_phone"
                            image_1920="this.currentEmployee.data.image_1920"
                            department_id="this.currentEmployee.data.department_id"
                            resource_calendar_id="this.currentEmployee.data.resource_calendar_id"
                            company="this.currentEmployee.data.company"
                            job_position="this.currentEmployee.data.job_position"
                            children="this.currentEmployee.data.children"/>
            <TimeOffEmpOrgChart name="this.currentEmployee.data.name"
                                id="this.currentEmployee.data.id"
                                job_id="this.currentEmployee.data.job_id"
                                manager="this.currentEmployee.data.manager"
                                manager_all_count="this.currentEmployee.data.manager_all_count"
                                child_all_count="this.currentEmployee.data.child_all_count"/>
           <EmpDepartmentCard name="this.currentEmployee.data.name"
                               id="this.currentEmployee.data.id"
                               child_all_count="this.currentEmployee.data.child_all_count"
                               children="this.currentEmployee.data.children"
                               department_id="this.currentEmployee.data.department_id"
                               absentees="this.currentAbsentees.data"
                               current_shift="this.currentShift.data"
                               upcoming_holidays="this.upcoming_holidays.data"/>
            <ApprovalStatusCard id="this.currentEmployee.data.id"
                                name="this.currentEmployee.data.name"
                                child_ids="this.currentEmployee.data.child_ids"
                                children="this.currentEmployee.data.children"
                                all_validated_leaves="this.all_validated_leaves"
                                approval_status_count="this.approval_status_count"/>
          </div>
        </xpath>
    </t>
</templates>
