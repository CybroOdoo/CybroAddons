<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the POS configuration form to add the mass edit button setting. -->
    <record id="pos_config_view_form_mass_edit" model="ir.ui.view">
        <field name="name">pos.config.form.mass.edit.button</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Add the mass edit configuration option inside the form sheet. -->
            <xpath expr="//sheet" position="inside">
                <group string="Order Line Mass Edit">
                    <!-- Enable or disable the Edit Order Line button in the POS interface. -->
                    <field name="show_mass_edit_button"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
