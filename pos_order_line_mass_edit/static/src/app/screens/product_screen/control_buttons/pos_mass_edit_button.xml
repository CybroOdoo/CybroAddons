<?xml version="1.0" encoding="UTF-8"?>
<!--Templates to add order line edit button in POS session-->
<templates id="template" xml:space="preserve">
    <!-- Edit Order Line button -->
    <t t-name="pos_order_line_mass_edit.ControlButtons"  t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//InternalNoteButton" position="after">
            <button
                t-if="this.pos.config.show_mass_edit_button"
                class="btn btn-secondary btn-lg lh-lg flex-shrink-0"
                t-on-click="() => this.editOrderLine()">
                <i class="oi oi-filled me-1" data-icon="edit"/>
                <span> Edit Order Line</span>
            </button>
        </xpath>
    </t>
</templates>
