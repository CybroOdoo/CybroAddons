<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_order_line_mass_edit.MassEditPopup">
        <!-- Custom popup template -->
        <Dialog title="props.title" bodyClass="'d-flex flex-column'" size="'lg'">
            <main class="body">
                <div class="section-product-info-title">
                    <div>
                        <table>
                            <thead>
                                <tr>
                                    <th>
                                        <b>Product</b>
                                    </th>
                                    <th style="padding: 0px 0px 0px 10px;">
                                        <b>Quantity</b>
                                    </th>
                                    <th style="padding: 0px 0px 0px 10px;">
                                        <b>Unit</b>
                                    </th>
                                    <th style="padding: 0px 0px 0px 10px;">
                                        <b>Price without tax</b>
                                    </th>
                                    <th style="width: 90px;padding: 0px 0px 0px 10px;">
                                        <b>Discount</b>
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <t t-foreach="state.lines" t-as="line" t-key="line.id">
                                <tbody>
                                    <td style="padding: 10px 10px 10px 0px;">
                                        <b>
                                            <t t-esc="line.full_product_name"/>
                                        </b>
                                    </td>
                                    <td style="padding: 10px;">
                                        <input class="form-control form-control-lg mt-2"
                                               t-on-input="(ev) => this.updateQty(line, ev.target.value)"
                                               type="number"
                                               name="quantity"
                                               t-att-value="line.qty"/>
                                    </td>
                                    <td style="padding: 10px;">
                                        <b>
                                            <t t-if="line.product_id?.uom_id?.name" t-esc="line.product_id.uom_id.name"/>
                                            <t t-else="" t-esc="line.uom_id?.name || 'Unit'"/>
                                        </b>
                                    </td>
                                    <td style="padding: 10px;">
                                        <input class="form-control form-control-lg mt-2"
                                               t-model="line.price_unit"
                                               type="number" name="unitPrice"/>
                                    </td>
                                    <td t-if="env.services.pos.config.manual_discount"
                                        style="padding: 10px;">
                                        <input class="form-control form-control-lg mt-2"
                                               t-model="line.discount"
                                               type="number" name="discount"/>
                                    </td>
                                    <td style="padding: 10px;">
                                        <button class="input-button btn btn-danger btn-lg mt-2"
                                                t-on-click="() => this.sendInput(line.id)">
                                            <i class="fa fa-trash"/>
                                        </button>
                                    </td>
                                </tbody>
                            </t>
                        </table>
                    </div>
                </div>
            </main>
            <t t-set-slot="footer">
                <!-- Undo button - only show when there's something to undo -->
                <button t-if="state.lastDeleted"
                        class="btn btn-warning"
                        t-on-click="undoDelete">
                    <i class="fa fa-undo"/> Undo Delete
                </button>
                <button class="btn btn-secondary"
                        t-on-click="props.close"
                        t-esc="props.closeLabel"/>
            </t>
        </Dialog>
    </t>
</templates>
