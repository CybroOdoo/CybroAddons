<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file loads the ir sequence data. -->
    <data noupdate="1">
        <record id="seq_oil_hse_incident" model="ir.sequence">
            <field name="name">HSE Incident</field>
            <field name="code">oil.hse.incident</field>
            <field name="prefix">HSE/%(range_year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_oil_hse_inspection" model="ir.sequence">
            <field name="name">HSE Inspection</field>
            <field name="code">oil.hse.inspection</field>
            <field name="prefix">INSP/%(range_year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_oil_hse_permit" model="ir.sequence">
            <field name="name">HSE Permit</field>
            <field name="code">oil.hse.permit</field>
            <field name="prefix">PTW/%(range_year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>