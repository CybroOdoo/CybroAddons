<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inspection Search View -->
    <record id="view_oil_hse_inspection_search" model="ir.ui.view">
        <field name="name">oil.hse.inspection.search</field>
        <field name="model">oil.hse.inspection</field>
        <field name="arch" type="xml">
            <search string="Search Inspections">
                <field name="name"/>
                <field name="inspector_id"/>
                <field name="project_id"
                       domain="[('is_oil_gas_project', '=', True)]"/>
                <filter string="Safety" name="safety"
                        domain="[('inspection_type','=','safety')]"/>
                <filter string="Environment" name="environment"
                        domain="[('inspection_type','=','environment')]"/>
                <filter string="Equipment" name="equipment"
                        domain="[('inspection_type','=','equipment')]"/>
                <group>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'inspection_type'}"/>
                    <filter string="Inspector" name="group_inspector"
                            context="{'group_by': 'inspector_id'}"/>
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Inspection List View -->
    <record id="view_oil_hse_inspection_list" model="ir.ui.view">
        <field name="name">oil.hse.inspection.list</field>
        <field name="model">oil.hse.inspection</field>
        <field name="arch" type="xml">
            <list string="HSE Inspections">
                <field name="name"/>
                <field name="date"/>
                <field name="inspection_type"/>
                <field name="project_id" optional="show"/>
                <field name="task_id" optional="show"/>
                <field name="equipment_id" optional="show"/>
                <field name="inspector_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Inspection Form View -->
    <record id="view_oil_hse_inspection_form" model="ir.ui.view">
        <field name="name">oil.hse.inspection.form</field>
        <field name="model">oil.hse.inspection</field>
        <field name="arch" type="xml">
            <form string="HSE Inspection">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="inspection_type"/>
                            <field name="inspector_id"/>
                        </group>
                        <group>
                            <field name="project_id" domain="[('is_oil_gas_project', '=', True)]"/>
                            <field name="task_id"
                                   domain="[('project_id.is_oil_gas_project', '=', True), ('project_id', '=?', project_id)]"/>
                            <field name="equipment_id" domain="[('is_oil_equipment', '=', True)]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist" name="checklist">
                            <field name="checklist_line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Inspection Action -->
    <record id="action_oil_hse_inspection" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">oil.hse.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No inspections recorded yet.
            </p>
            <p>Create HSE inspections with checklists for safety, environment, and equipment.</p>
        </field>
    </record>

    <!-- Configuration > Upstream > HSE > Inspections -->
    <menuitem id="menu_oil_config_hse_inspection"
              name="Inspections"
              parent="menu_oil_config_hse"
              action="action_oil_hse_inspection"
              sequence="20"/>
</odoo>
