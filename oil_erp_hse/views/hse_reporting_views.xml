<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Incidents Reporting -->
    <record id="view_oil_hse_incident_pivot" model="ir.ui.view">
        <field name="name">oil.hse.incident.pivot</field>
        <field name="model">oil.hse.incident</field>
        <field name="arch" type="xml">
            <pivot string="Incidents Analysis" display_quantity="1" sample="1">
                <field name="incident_type_id" type="row"/>
                <field name="severity" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_oil_hse_incident_graph" model="ir.ui.view">
        <field name="name">oil.hse.incident.graph</field>
        <field name="model">oil.hse.incident</field>
        <field name="arch" type="xml">
            <graph string="Incidents Analysis" type="bar" sample="1">
                <field name="incident_type_id"/>
                <field name="severity"/>
            </graph>
        </field>
    </record>

    <record id="action_hse_incident_reporting" model="ir.actions.act_window">
        <field name="name">Incidents by Type</field>
        <field name="res_model">oil.hse.incident</field>
        <field name="view_mode">pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No incidents recorded.
            </p>
        </field>
    </record>

    <!-- 2. Permits Reporting -->
    <record id="view_oil_hse_permit_pivot" model="ir.ui.view">
        <field name="name">oil.hse.permit.pivot</field>
        <field name="model">oil.hse.permit</field>
        <field name="arch" type="xml">
            <pivot string="Permit Analysis" display_quantity="1" sample="1">
                <field name="permit_type" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_oil_hse_permit_graph" model="ir.ui.view">
        <field name="name">oil.hse.permit.graph</field>
        <field name="model">oil.hse.permit</field>
        <field name="arch" type="xml">
            <graph string="Permit Analysis" type="pie" sample="1">
                <field name="permit_type"/>
            </graph>
        </field>
    </record>

    <record id="action_hse_permit_reporting" model="ir.actions.act_window">
        <field name="name">Active Permits by Type</field>
        <field name="res_model">oil.hse.permit</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('state', '=', 'approved')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active permits found.
            </p>
        </field>
    </record>

    <!-- 3. Risk Level Distribution -->
    <record id="view_oil_hse_risk_pivot" model="ir.ui.view">
        <field name="name">oil.hse.risk.pivot</field>
        <field name="model">oil.hse.risk</field>
        <field name="arch" type="xml">
            <pivot string="Risk Analysis" display_quantity="1" sample="1">
                <field name="risk_level" type="row"/>
                <field name="project_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_oil_hse_risk_graph" model="ir.ui.view">
        <field name="name">oil.hse.risk.graph</field>
        <field name="model">oil.hse.risk</field>
        <field name="arch" type="xml">
            <graph string="Risk Analysis" type="bar" sample="1">
                <field name="risk_level"/>
            </graph>
        </field>
    </record>

    <record id="action_hse_risk_reporting" model="ir.actions.act_window">
        <field name="name">Risk Level Distribution</field>
        <field name="res_model">oil.hse.risk</field>
        <field name="view_mode">pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No risk assessments found.
            </p>
        </field>
    </record>

    <!-- Menu Items in Reporting > HSE -->
    <menuitem id="menu_oil_reporting_hse_incidents"
              name="Incidents by Type"
              parent="oil_erp_base.menu_oil_reporting_hse"
              action="action_hse_incident_reporting"
              sequence="10"/>

    <menuitem id="menu_oil_reporting_hse_permits"
              name="Active Permits by Type"
              parent="oil_erp_base.menu_oil_reporting_hse"
              action="action_hse_permit_reporting"
              sequence="20"/>

    <menuitem id="menu_oil_reporting_hse_risks"
              name="Risk Level Distribution"
              parent="oil_erp_base.menu_oil_reporting_hse"
              action="action_hse_risk_reporting"
              sequence="30"/>
</odoo>
