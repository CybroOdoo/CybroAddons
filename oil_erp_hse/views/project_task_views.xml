<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- This file defines the project task views. -->
    <record id="project_task_view_form_inherit_oil_hse" model="ir.ui.view">
        <field name="name">project.task.form.inherit.oil.hse</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_hse_incidents" type="object"
                        class="oe_stat_button"
                        icon="fa-exclamation-triangle"
                        invisible="not is_oil_gas_well">
                    <field name="hse_incident_count"
                           widget="statinfo"
                           string="Incidents"/>
                </button>
                <button name="action_view_hse_inspections" type="object"
                        class="oe_stat_button" icon="fa-search"
                        invisible="not is_oil_gas_well">
                    <field name="hse_inspection_count" widget="statinfo"
                           string="Inspections"/>
                </button>
                <button name="action_view_hse_permits" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not is_oil_gas_well">
                    <field name="hse_permit_count" widget="statinfo"
                           string="Work Permits"/>
                </button>
                <button name="action_view_hse_risks" type="object"
                        class="oe_stat_button" icon="fa-shield"
                        invisible="not is_oil_gas_well">
                    <field name="hse_risk_count" widget="statinfo"
                           string="Risk Assessments"/>
                </button>
            </xpath>
            <xpath expr="//notebook/page[@name='well_drilling']" position="after">
                <page string="HSE Info" name="hse_info"
                      invisible="not is_oil_gas_well">
                    <group>
                        <group string="HSE Classification">
                            <field name="hse_classification"/>
                            <field name="h2s_present"/>
                        </group>
                        <group string="Emergency Response">
                            <field name="emergency_contact_id"/>
                            <field name="nearest_hospital"/>
                            <field name="muster_point"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_report_incident"
                        string="Report Incident"
                        type="object"
                        class="btn-danger"
                        invisible="not is_oil_gas_well"/>
                <button name="action_create_permit"
                        string="Create Work Permit"
                        type="object"
                        class="oe_highlight"
                        invisible="not is_waiting_stage"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="prev_stage_id" invisible="1"/>
                <field name="requested_stage_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.form.view.inherit.oil_erp_hse</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="oil_erp_equipment.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='equipment']/field/list" position="inside">
                <button name="action_create_inspection"
                        string="Create Inspection"
                        type="object"
                        class="btn-secondary "/>
            </xpath>
        </field>
    </record>
</odoo>