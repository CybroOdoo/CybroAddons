<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the project project views. -->
    <record id="project_project_view_form_inherit_oil_hse" model="ir.ui.view">
        <field name="name">project.project.form.inherit.oil.hse</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_hse_incidents" type="object"
                        class="oe_stat_button"
                        icon="fa-exclamation-triangle"
                        invisible="not is_oil_gas_project">
                    <field name="hse_incident_count" widget="statinfo"
                           string="Incidents"/>
                </button>
                <button name="action_view_hse_inspections" type="object"
                        class="oe_stat_button" icon="fa-search"
                        invisible="not is_oil_gas_project">
                    <field name="hse_inspection_count" widget="statinfo"
                           string="Inspections"/>
                </button>
                <button name="action_view_hse_permits" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not is_oil_gas_project">
                    <field name="hse_permit_count" widget="statinfo"
                           string="Work Permits"/>
                </button>
                <button name="action_view_hse_risks" type="object"
                        class="oe_stat_button" icon="fa-shield"
                        invisible="not is_oil_gas_project">
                    <field name="hse_risk_count" widget="statinfo"
                           string="Risk Assessments"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_report_incident"
                        string="Report Incident"
                        type="object"
                        class="btn-danger"
                        invisible="not is_oil_gas_project"/>
            </xpath>
        </field>
    </record>
</odoo>
