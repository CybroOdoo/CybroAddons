<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the oil hse security rules and groups. -->
    <data noupdate="1">
        <record id="oil_hse_incident_rule_company" model="ir.rule">
            <field name="name">Oil HSE Incident: multi-company</field>
            <field name="model_id" ref="model_oil_hse_incident"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="oil_hse_inspection_rule_company" model="ir.rule">
            <field name="name">Oil HSE Inspection: multi-company</field>
