        </record>

        <record id="oil_hse_permit_rule_company" model="ir.rule">
            <field name="name">Oil HSE Permit: multi-company</field>
            <field name="model_id" ref="model_oil_hse_permit"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="oil_hse_risk_rule_company" model="ir.rule">
            <field name="name">Oil HSE Risk: multi-company</field>
            <field name="model_id" ref="model_oil_hse_risk"/>
