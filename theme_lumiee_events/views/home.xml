<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Home Page -->
    <template id="le_home_page" name="Lumiee Events Home" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- Hero Banner -->
                <section class="le-hero o_colored_level" data-snippet="theme_lumiee_events.le_hero_banner" data-name="Hero Banner">
                    <div class="le-hero-text">
                        <h1>Crafting Unforgettable Experiences</h1>
                        <p>From intimate gatherings to grand celebrations, we bring your vision to life with flawless execution and elegant design.</p>
                        <div class="le-hero-buttons">
                            <a href="/services" class="le-hero-button" style="text-decoration:none; display: inline-block;">Explore Services</a>
                            <a href="/contact" class="le-hero-button2" style="text-decoration:none; display: inline-block;">Get Started</a>
                        </div>
                    </div>
                    <div class="le-hero-image">
                        <img src="/theme_lumiee_events/static/src/img/banner.png" class="o_we_custom_image" alt="Event setup"/>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Brochure Section -->
                <section class="le-brochure-section o_colored_level" data-snippet="theme_lumiee_events.le_brochure_section" data-name="Brochure Section">
                    <div class="le-container">
                        <div class="le-content">
                            <h2>Discover the Possibilities</h2>
                            <p>Download our comprehensive event planning brochure to explore our full range of services, thematic inspirations, and success stories.</p>
                            <div class="le-buttons">
                                <a href="/contact" class="le-btn primary" style="text-decoration:none; display: inline-block;">⬇ Download Brochure</a>
                                <a href="/services" class="le-btn outline" style="text-decoration:none; display: inline-block;">Read Online</a>
                            </div>
                        </div>
                        <div class="le-image-box">
                            <img src="/theme_lumiee_events/static/src/img/brochure.png" class="o_we_custom_image" alt="Brochure Preview"/>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Pricing Cards -->
                <section class="le-pricing-section o_colored_level" data-snippet="theme_lumiee_events.le_pricing_cards_home" data-name="Pricing Cards">
                    <div class="le-pricing-header">
                        <h2>Transparent Pricing</h2>
                        <p>Packages designed to fit your needs, from partial planning to full-service event production.</p>
                    </div>
                    <div class="le-pricing-cards">
                        <div class="le-card">
                            <h3>Day-Of Coordination</h3>
                            <h1>$1,500</h1>
                            <ul>
                                <li>✔ Pre-event consultation</li>
                                <li>✔ Vendor management</li>
                                <li>✔ 8 hours on-site coordination</li>
                                <li>✔ Timeline creation</li>
                            </ul>
                            <a href="/contact" class="le-btn outline" style="text-decoration:none; display: inline-block;">Choose Plan</a>
                        </div>
                        <div class="le-card active">
                            <h3>Full Service Planning</h3>
                            <h1>$4,500</h1>
                            <ul>
                                <li>✔ Everything in Day-Of</li>
                                <li>✔ Venue selection &amp; touring</li>
                                <li>✔ Budget management</li>
                                <li>✔ Design &amp; styling board</li>
                                <li>✔ Unlimited communication</li>
                            </ul>
                            <a href="/contact" class="le-btn primary" style="text-decoration:none; display: inline-block;">Choose Plan</a>
                        </div>
                        <div class="le-card">
                            <h3>Custom Event</h3>
                            <h1>Let's Talk</h1>
                            <ul>
                                <li>✔ Multi-day events</li>
                                <li>✔ Destination planning</li>
                                <li>✔ Corporate galas &amp; retreats</li>
                                <li>✔ VIP guest handling</li>
                            </ul>
                            <a href="/contact" class="le-btn outline" style="text-decoration:none; display: inline-block;">Contact Us</a>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Gallery Grid -->
                <section class="le-gallery-section o_colored_level" data-snippet="theme_lumiee_events.le_gallery_grid_home" data-name="Gallery Grid">
                    <div class="le-gallery-header">
                        <h2>Our Recent Masterpieces</h2>
                        <p>A curated selection of weddings, brand launches, and private celebrations.</p>
                    </div>
                    <div class="le-gallery-grid">
                        <div class="le-gallery-item le-large"><img src="/theme_lumiee_events/static/src/img/img1.png" class="o_we_custom_image" alt="Garden wedding"/><div class="le-overlay"/><span>Garden wedding</span></div>
                        <div class="le-gallery-item le-small"><img src="/theme_lumiee_events/static/src/img/img2.png" class="o_we_custom_image" alt="Floral details"/><div class="le-overlay"/><span>Floral details</span></div>
                        <div class="le-gallery-item le-wide"><img src="/theme_lumiee_events/static/src/img/img3.png" class="o_we_custom_image" alt="Corporate gala"/><div class="le-overlay"/><span>Corporate gala</span></div>
                        <div class="le-gallery-item le-medium"><img src="/theme_lumiee_events/static/src/img/img4.png" class="o_we_custom_image" alt="Birthday styling"/><div class="le-overlay"/><span>Birthday styling</span></div>
                        <div class="le-gallery-item le-small"><img src="/theme_lumiee_events/static/src/img/img5.png" class="o_we_custom_image" alt="Private dinner"/><div class="le-overlay"/><span>Private dinner</span></div>
                        <div class="le-gallery-item le-medium"><img src="/theme_lumiee_events/static/src/img/img6.png" class="o_we_custom_image" alt="Reception night"/><div class="le-overlay"/><span>Reception night</span></div>
                        <div class="le-gallery-item le-small"><img src="/theme_lumiee_events/static/src/img/img7.png" class="o_we_custom_image" alt="Arrival moment"/><div class="le-overlay"/><span>Arrival moment</span></div>
                        <div class="le-gallery-item le-small"><img src="/theme_lumiee_events/static/src/img/img9.webp" class="o_we_custom_image" alt="Luxury setup"/><div class="le-overlay"/><span>Luxury setup</span></div>
                        <div class="le-gallery-item le-wide"><img src="/theme_lumiee_events/static/src/img/img8.webp" class="o_we_custom_image" alt="Stage design"/><div class="le-overlay"/><span>Stage design</span></div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- Contact Form -->
                <section class="le-contact-section o_colored_level" data-snippet="theme_lumiee_events.le_contact_form_home" data-name="Contact Form">
                    <div class="le-contact-container">
                        <div class="le-contact-left">
                            <h2>Get in Touch</h2>
                            <div class="le-info">
                                <p><i class="fa fa-map-marker" style="color:#ff4da6;margin-right:8px;"/> 123 Elegance Blvd, Suite 400<br/>New York, NY 10001</p>
                                <p><i class="fa fa-phone" style="color:#ff4da6;margin-right:8px;"/> +1 (555) 123-4567</p>
                                <p><i class="fa fa-envelope" style="color:#ff4da6;margin-right:8px;"/> hello@lumiereevents.com</p>
                            </div>
                        </div>
                        <div class="le-contact-right">
                            <form action="/website/form/" method="post" enctype="multipart/form-data"
                                  class="o_mark_required" data-mark="*" data-model_name="mail.mail">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="le-row">
                                    <div class="le-field s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                                        <label class="s_website_form_label" for="le_hp_name">First Name</label>
                                        <input id="le_hp_name" type="text" class="s_website_form_input" name="name" placeholder="Jane" required="" data-fill-with="name"/>
                                    </div>
                                    <div class="le-field s_website_form_field" data-type="char" data-name="Field">
                                        <label class="s_website_form_label" for="le_hp_last_name">Last Name</label>
                                        <input id="le_hp_last_name" type="text" class="s_website_form_input" name="last_name" placeholder="Doe"/>
                                    </div>
                                </div>
                                <div class="le-row">
                                    <div class="le-field s_website_form_field s_website_form_required" data-type="email" data-name="Field">
                                        <label class="s_website_form_label" for="le_hp_email">Email Address</label>
                                        <input id="le_hp_email" type="email" class="s_website_form_input" name="email_from" placeholder="jane@example.com" required="" data-fill-with="email"/>
                                    </div>
                                    <div class="le-field s_website_form_field" data-type="date" data-name="Field">
                                        <label class="s_website_form_label" for="le_hp_event_date">Event Date</label>
                                        <input id="le_hp_event_date" type="text" class="s_website_form_input" name="event_date" placeholder="MM/DD/YYYY"/>
                                    </div>
                                </div>
                                <div class="le-field full s_website_form_field s_website_form_required" data-type="text" data-name="Field">
                                    <label class="s_website_form_label" for="le_hp_description">Tell us about your event</label>
                                    <textarea id="le_hp_description" class="s_website_form_input" name="description" placeholder="I am planning a wedding for 150 guests..." required=""/>
                                </div>
                                <div class="le-field s_website_form_field s_website_form_dnone">
                                    <input type="hidden" class="s_website_form_input" name="email_to"/>
                                </div>
                                <div class="s_website_form_submit" data-name="Submit Button" style="margin-top: 15px;">
                                    <a href="#" role="button" class="le-submit-btn s_website_form_send" style="text-decoration:none; display: block; text-align: center;">
                                        <span>Send Message</span>
                                    </a>
                                    <span id="s_website_form_result"/>
                                </div>
                            </form>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>

                <!-- FAQ -->
                <section class="le-faq-section o_colored_level" data-snippet="theme_lumiee_events.le_faq_section" data-name="FAQ Section">
                    <div class="le-faq-header">
                        <h2>Frequently Asked Questions</h2>
                        <p>Find answers to common questions about our event planning services.</p>
                    </div>
                    <div class="le-faq-container">
                        <div class="le-faq-item active"><div class="le-faq-question"><span>How far in advance should we book?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">We recommend booking at least 6–12 months in advance.</div></div>
                        <div class="le-faq-item"><div class="le-faq-question"><span>Do you offer custom packages?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">Yes! We create custom proposals tailored to your needs.</div></div>
                        <div class="le-faq-item"><div class="le-faq-question"><span>Will you travel for destination events?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">Absolutely! We coordinate logistics anywhere.</div></div>
                        <div class="le-faq-item"><div class="le-faq-question"><span>Do you handle vendor contracts?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">Yes, we assist with vendor coordination and payments.</div></div>
                    </div>
                </section>
                <div class="oe_structure oe_empty"/>
            </div>
        </xpath>
    </template>
</odoo>
