<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme View for Contact Us Page -->
    <record id="le_contact_page" model="theme.ir.ui.view">
        <field name="name">Lumiee Contact Page</field>
        <field name="key">theme_lumiee_events.le_contact_page</field>
        <field name="arch" type="xml">
            <t t-name="theme_lumiee_events.le_contact_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <!-- Page Hero Snippet -->
                        <section class="le-page-hero o_colored_level" data-snippet="theme_lumiee_events.le_page_hero" data-name="Page Hero">
                            <p class="le-breadcrumb">Reach Out</p>
                            <h1>Get in Touch</h1>
                            <p>Ready to start planning? We'd love to hear about your event. Send us a message and we'll respond within 24 hours.</p>
                        </section>
                        <div class="oe_structure oe_empty"/>

                        <!-- Contact Info Cards Snippet -->
                        <section class="le-contact-page-section o_colored_level"
                                 data-snippet="theme_lumiee_events.le_contact_info_cards"
                                 data-name="Contact Info Cards">
                            <div class="le-contact-info-cards">
                                <div class="le-info-card" data-name="Info Card">
                                    <i class="fa fa-map-marker"/><h4>Our Office</h4>
                                    <p>123 Elegance Blvd, Suite 400<br/>New York, NY 10001</p>
                                </div>
                                <div class="le-info-card" data-name="Info Card">
                                    <i class="fa fa-phone"/><h4>Phone</h4>
                                    <p>+1 (555) 123-4567<br/>Mon–Fri, 9am–6pm EST</p>
                                </div>
                                <div class="le-info-card" data-name="Info Card">
                                    <i class="fa fa-envelope"/><h4>Email</h4>
                                    <p>hello@lumiereevents.com<br/>We reply within 24 hours</p>
                                </div>
                                <div class="le-info-card" data-name="Info Card">
                                    <i class="fa fa-clock-o"/><h4>Business Hours</h4>
                                    <p>Monday – Friday: 9am – 6pm<br/>Weekends: By appointment</p>
                                </div>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>

                        <!-- Contact Form Snippet -->
                        <section class="le-contact-page-section o_colored_level"
                                 data-snippet="theme_lumiee_events.le_contact_form"
                                 data-name="Contact Form Full">
                            <div class="le-contact-container">
                                <div class="le-contact-left" data-name="Contact Info">
                                    <h2>Send Us a Message</h2>
                                    <div class="le-info">
                                        <p><i class="fa fa-map-marker" style="color:#ff4da6;margin-right:8px;"/> 123 Elegance Blvd, Suite 400<br/>New York, NY 10001</p>
                                        <p><i class="fa fa-phone" style="color:#ff4da6;margin-right:8px;"/> +1 (555) 123-4567</p>
                                        <p><i class="fa fa-envelope" style="color:#ff4da6;margin-right:8px;"/> hello@lumiereevents.com</p>
                                    </div>
                                </div>
                                <div class="le-contact-right" data-name="Contact Form">
                                    <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="mail.mail">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="le-row">
                                            <div class="le-field s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                                                <label class="s_website_form_label" for="le_cf_name">First Name</label>
                                                <input id="le_cf_name" type="text" class="s_website_form_input" name="name" placeholder="Jane" required="" data-fill-with="name"/>
                                            </div>
                                            <div class="le-field s_website_form_field" data-type="char" data-name="Field">
                                                <label class="s_website_form_label" for="le_cf_last_name">Last Name</label>
                                                <input id="le_cf_last_name" type="text" class="s_website_form_input" name="last_name" placeholder="Doe"/>
                                            </div>
                                        </div>
                                        <div class="le-row">
                                            <div class="le-field s_website_form_field s_website_form_required" data-type="email" data-name="Field">
                                                <label class="s_website_form_label" for="le_cf_email">Email Address</label>
                                                <input id="le_cf_email" type="email" class="s_website_form_input" name="email_from" placeholder="jane@example.com" required="" data-fill-with="email"/>
                                            </div>
                                            <div class="le-field s_website_form_field" data-type="char" data-name="Field">
                                                <label class="s_website_form_label" for="le_cf_phone">Phone Number</label>
                                                <input id="le_cf_phone" type="tel" class="s_website_form_input" name="phone" placeholder="+1 (555) 000-0000" data-fill-with="phone"/>
                                            </div>
                                        </div>
                                        <div class="le-row">
                                            <div class="le-field s_website_form_field" data-type="char" data-name="Field">
                                                <label class="s_website_form_label" for="le_cf_event_type">Event Type</label>
                                                <input id="le_cf_event_type" type="text" class="s_website_form_input" name="subject" placeholder="Wedding, Corporate, Birthday..."/>
                                            </div>
                                            <div class="le-field s_website_form_field" data-type="date" data-name="Field">
                                                <label class="s_website_form_label" for="le_cf_event_date">Event Date</label>
                                                <div class="s_website_form_date input-group date">
                                                    <input id="le_cf_event_date" type="text" class="datetimepicker-input s_website_form_input" name="event_date" placeholder="MM/DD/YYYY"/>
                                                    <div class="input-group-text o_input_group_date_icon"><i class="fa fa-calendar"/></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="le-field full s_website_form_field s_website_form_required" data-type="text" data-name="Field">
                                            <label class="s_website_form_label" for="le_cf_description">Tell us about your event</label>
                                            <textarea id="le_cf_description" class="s_website_form_input" name="description" placeholder="I am planning a wedding for 150 guests..." required=""></textarea>
                                        </div>
                                        <!-- Hidden email_to field -->
                                        <div class="le-field s_website_form_field s_website_form_dnone">
                                            <input type="hidden" class="s_website_form_input" name="email_to"/>
                                        </div>
                                        <div class="s_website_form_submit" data-name="Submit Button" style="margin-top: 15px;">
                                            <a href="#" role="button" class="le-submit-btn s_website_form_send" style="text-decoration:none; display:block; text-align:center;">
                                                <span>Send Message</span>
                                            </a>
                                            <span id="s_website_form_result"/>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Theme Page for Contact -->
    <record id="le_contact_page_page" model="theme.website.page">
        <field name="url">/contact</field>
        <field name="view_id" ref="le_contact_page"/>
        <field name="is_published">True</field>
    </record>

    <!-- Thank-you page template for the /contact form -->
    <record id="le_contactus_thanks" model="theme.ir.ui.view">
        <field name="name">Lumiee Contact Thanks</field>
        <field name="key">theme_lumiee_events.le_contactus_thanks</field>
        <field name="arch" type="xml">
            <t t-name="theme_lumiee_events.le_contactus_thanks">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="le-contact-page-section">
                            <div class="le-contact-container" style="justify-content: center; display: flex;">
                                <div class="le-contact-right" style="max-width: 600px; width: 100%; text-align: center; background: #fff; padding: 40px; border: 1px solid #e5e7eb; border-radius: 12px; box-shadow: 0 8px 30px rgba(255, 77, 166, 0.05);">
                                    <div style="font-size: 64px; color: #ff4da6; margin-bottom: 24px;">
                                        <i class="fa fa-paper-plane-o"/>
                                    </div>
                                    <h2 style="font-size: 28px; font-weight: 700; color: #1f2937; margin-bottom: 16px;">Message Received!</h2>
                                    <p style="font-size: 16px; color: #6b7280; line-height: 1.8; margin-bottom: 30px;">
                                        Thank you for reaching out to Lumiee Events. We have received your inquiry and will respond within 24 hours.
                                    </p>
                                    <a href="/" class="le-btn primary" style="text-decoration: none; display: inline-block; padding: 12px 30px; font-weight: 600; border-radius: 8px;">Back to Home</a>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>