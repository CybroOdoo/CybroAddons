<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme View for Pricing Page -->
    <record id="le_pricing_page" model="theme.ir.ui.view">
        <field name="name">Lumiee Pricing Page</field>
        <field name="key">theme_lumiee_events.le_pricing_page</field>
        <field name="arch" type="xml">
            <t t-name="theme_lumiee_events.le_pricing_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="le-page-hero o_colored_level" data-snippet="theme_lumiee_events.le_page_hero" data-name="Page Hero">
                            <p class="le-breadcrumb">Plans &amp; Packages</p>
                            <h1>Transparent Pricing</h1>
                            <p>Simple, honest pricing designed to fit every budget — from day-of coordination to full-service production.</p>
                        </section>
                        <section class="le-pricing-section o_colored_level" data-snippet="theme_lumiee_events.le_pricing_cards" data-name="Pricing Cards">
                            <div class="le-pricing-cards">
                                <div class="le-card">
                                    <h3>Day-Of Coordination</h3>
                                    <h1>$1,500</h1>
                                    <ul><li>✔ Pre-event consultation</li><li>✔ Vendor management</li><li>✔ 8 hours on-site coordination</li><li>✔ Timeline creation</li></ul>
                                    <a href="/contact" class="le-btn outline" style="text-decoration:none; display: inline-block;">Choose Plan</a>
                                </div>
                                <div class="le-card active">
                                    <h3>Full Service Planning</h3>
                                    <h1>$4,500</h1>
                                    <ul><li>✔ Everything in Day-Of</li><li>✔ Venue selection &amp; touring</li><li>✔ Budget management</li><li>✔ Design &amp; styling board</li><li>✔ Unlimited communication</li></ul>
                                    <a href="/contact" class="le-btn primary" style="text-decoration:none; display: inline-block;">Choose Plan</a>
                                </div>
                                <div class="le-card">
                                    <h3>Custom Event</h3>
                                    <h1>Let's Talk</h1>
                                    <ul><li>✔ Multi-day events</li><li>✔ Destination planning</li><li>✔ Corporate galas &amp; retreats</li><li>✔ VIP guest handling</li></ul>
                                    <a href="/contact" class="le-btn outline" style="text-decoration:none; display: inline-block;">Contact Us</a>
                                </div>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>
                        <section class="le-comparison-section o_colored_level" data-snippet="theme_lumiee_events.le_comparison_table" data-name="Comparison Table">
                            <div class="le-section-header"><h2>Compare All Features</h2><p>See exactly what's included in each plan.</p></div>
                            <div class="le-comparison-table-wrap">
                                <table class="le-comparison-table">
                                    <thead><tr><th>Feature</th><th>Day-Of</th><th>Full Service</th><th>Custom</th></tr></thead>
                                    <tbody>
                                        <tr><td>Pre-event consultation</td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                                        <tr><td>Vendor coordination</td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                                        <tr><td>Timeline creation</td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                                        <tr><td>On-site coordination</td><td>8 hours</td><td>Full day</td><td>Custom</td></tr>
                                        <tr><td>Venue selection</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                                        <tr><td>Budget management</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                                        <tr><td>Design &amp; styling</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                                        <tr><td>Unlimited communication</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                                        <tr><td>Destination support</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                                        <tr><td>VIP guest handling</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>
                        <section class="le-faq-section o_colored_level" data-snippet="theme_lumiee_events.le_faq_section" data-name="FAQ">
                            <div class="le-faq-header"><h2>Pricing Questions</h2><p>Common questions about packages, payments, and what's included.</p></div>
                            <div class="le-faq-container">
                                <div class="le-faq-item active"><div class="le-faq-question"><span>Are there any hidden fees?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">No. Our pricing is fully transparent. Vendor costs are separate and managed within your agreed budget.</div></div>
                                <div class="le-faq-item"><div class="le-faq-question"><span>What payment methods do you accept?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">All major credit cards, bank transfers, and checks. A 30% deposit is required to secure your date.</div></div>
                                <div class="le-faq-item"><div class="le-faq-question"><span>Can I upgrade my package?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">Yes! You can upgrade at any time before 60 days prior to your event.</div></div>
                                <div class="le-faq-item"><div class="le-faq-question"><span>What is your cancellation policy?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">Cancellations 90+ days out receive a full refund minus deposit. Within 90 days are non-refundable.</div></div>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <!-- Theme Page for Pricing -->
    <record id="le_pricing_page_page" model="theme.website.page">
        <field name="url">/pricing</field>
        <field name="view_id" ref="le_pricing_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>
