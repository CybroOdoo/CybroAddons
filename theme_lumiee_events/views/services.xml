<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme View for Services Page -->
    <record id="le_services_page" model="theme.ir.ui.view">
        <field name="name">Lumiee Services Page</field>
        <field name="key">theme_lumiee_events.le_services_page</field>
        <field name="arch" type="xml">
            <t t-name="theme_lumiee_events.le_services_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="le-page-hero o_colored_level" data-snippet="theme_lumiee_events.le_page_hero" data-name="Page Hero">
                            <p class="le-breadcrumb">What We Offer</p>
                            <h1>Our Services</h1>
                            <p>From intimate gatherings to grand celebrations — every detail expertly handled so you can be present in every moment.</p>
                        </section>
                        <section class="le-services-section o_colored_level" data-snippet="theme_lumiee_events.le_services_grid" data-name="Services Grid">
                            <div class="le-service-cards">
                                <div class="le-service-card"><div class="le-service-icon"><i class="fa fa-heart" style="font-size:34px;color:#ff4da6;"/></div><h3>Wedding Planning</h3><p>From ceremony to reception, we handle every detail — venue selection, floral design, catering coordination, and day-of management.</p><a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a></div>
                                <div class="le-service-card"><div class="le-service-icon"><i class="fa fa-building" style="font-size:34px;color:#ff4da6;"/></div><h3>Corporate Events</h3><p>Conferences, award galas, team retreats, and product launches. Professional experiences that reflect your brand.</p><a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a></div>
                                <div class="le-service-card"><div class="le-service-icon"><i class="fa fa-birthday-cake" style="font-size:34px;color:#ff4da6;"/></div><h3>Birthday Celebrations</h3><p>Milestone birthdays deserve unforgettable moments. Fully themed parties with custom decor and entertainment.</p><a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a></div>
                                <div class="le-service-card"><div class="le-service-icon"><i class="fa fa-plane" style="font-size:34px;color:#ff4da6;"/></div><h3>Destination Events</h3><p>Destination weddings or overseas retreats? We coordinate travel logistics and on-site management anywhere.</p><a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a></div>
                                <div class="le-service-card"><div class="le-service-icon"><i class="fa fa-glass" style="font-size:34px;color:#ff4da6;"/></div><h3>Social Galas</h3><p>Cocktail receptions, fundraising events, and private dinners crafted with elegance.</p><a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a></div>
                                <div class="le-service-card"><div class="le-service-icon"><i class="fa fa-rocket" style="font-size:34px;color:#ff4da6;"/></div><h3>Brand Launches</h3><p>Product unveilings, pop-up activations, and PR events that generate buzz.</p><a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a></div>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>
                        <section class="le-process-section o_colored_level" data-snippet="theme_lumiee_events.le_process_steps" data-name="Process Steps">
                            <div class="le-section-header"><h2>How We Work</h2><p>A clear, collaborative process designed to make planning effortless.</p></div>
                            <div class="le-process-steps">
                                <div class="le-step"><div class="le-step-num">1</div><h4>Discovery Call</h4><p>Free 30-minute consultation to understand your vision.</p></div>
                                <div class="le-step"><div class="le-step-num">2</div><h4>Custom Proposal</h4><p>Tailored proposal with vendor recommendations and pricing.</p></div>
                                <div class="le-step"><div class="le-step-num">3</div><h4>Planning &amp; Design</h4><p>We handle bookings, contracts, and design boards.</p></div>
                                <div class="le-step"><div class="le-step-num">4</div><h4>Your Perfect Day</h4><p>Our team manages every detail on the day.</p></div>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>
                        <section class="le-faq-section o_colored_level" data-snippet="theme_lumiee_events.le_faq_section" data-name="FAQ Section">
                            <div class="le-faq-header"><h2>Common Questions</h2><p>Everything you need to know about booking and working with our team.</p></div>
                            <div class="le-faq-container">
                                <div class="le-faq-item active"><div class="le-faq-question"><span>What types of events do you specialize in?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">We specialize in weddings, corporate events, birthday celebrations, destination events, social galas, and brand launches.</div></div>
                                <div class="le-faq-item"><div class="le-faq-question"><span>How far in advance should I book?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">We recommend 6–12 months for weddings and 2–3 months for corporate or social events.</div></div>
                                <div class="le-faq-item"><div class="le-faq-question"><span>Can I customize a service package?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">Absolutely. We're happy to build a completely custom proposal tailored to your needs.</div></div>
                                <div class="le-faq-item"><div class="le-faq-question"><span>Do you travel for destination events?</span><button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button></div><div class="le-faq-answer">Yes! Travel fees may apply depending on location.</div></div>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <!-- Theme Page for Services -->
    <record id="le_services_page_page" model="theme.website.page">
        <field name="url">/services</field>
        <field name="view_id" ref="le_services_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>
