<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Header Assets for Google Fonts -->
    <template id="le_head_assets" inherit_id="website.layout" name="Lumiee Events Head Assets">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <!-- Custom Header Layout -->
    <template id="le_header" inherit_id="website.layout" name="Lumiee Events Header">
        <xpath expr="//header" position="replace">
            <header class="le-navbar" id="leMainHeader">
                <div class="le-logo">
                    <a href="/"><img src="/theme_lumiee_events/static/src/img/logo.png" alt="Logo"/></a>
                </div>

                <nav class="le-nav-menu le-desktop-nav" id="leNavMenu">
                    <ul id="top_menu">
                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                            <li><a t-att-href="submenu.url" t-esc="submenu.name"/></li>
                        </t>
                    </ul>
                </nav>

                <div class="le-desktop-cta">
                    <ul class="navbar-nav le-user-nav">
                        <t t-call="portal.placeholder_user_sign_in">
                            <t t-set="_link_class" t-valuef="btn le-sign-btn"/>
                        </t>
                        <t t-call="portal.user_dropdown">
                            <t t-set="_user_name" t-value="True"/>
                            <t t-set="_item_class" t-value="'nav-item dropdown'"/>
                            <t t-set="_link_class" t-value="'btn le-sign-btn'"/>
                        </t>
                    </ul>
                    <div class="oe_structure oe_structure_solo" id="oe_structure_header_cta">
                        <section class="s_text_block le-header-cta-wrapper" data-snippet="s_text_block" data-name="Header CTA">
                            <a href="/contact" class="le-nav-btn" style="text-decoration:none; display: inline-block;">Get Started</a>
                        </section>
                    </div>
                </div>

                <!-- Mobile hamburger button -->
                <button class="le-mobile-toggle" id="leMobileToggle" aria-label="Open menu" type="button">
                    <i class="fa fa-bars"/>
                </button>

                <!-- Mobile drawer -->
                <div class="le-mobile-menu" id="leMobileMenu">
                    <div class="le-mobile-menu-header">
                        <a href="/"><img src="/theme_lumiee_events/static/src/img/logo.png" alt="Logo" style="height:36px;"/></a>
                        <button class="le-mobile-close" id="leMobileClose" aria-label="Close menu" type="button">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <nav class="le-mobile-nav">
                        <ul>
                            <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                <li><a t-att-href="submenu.url" t-esc="submenu.name"/></li>
                            </t>
                        </ul>
                    </nav>
                    <a href="/contact" class="le-nav-btn" style="text-decoration:none; display: inline-block; margin-top: auto;">Get Started</a>
                </div>
                <!-- Mobile overlay -->
                <div class="le-mobile-overlay" id="leMobileOverlay"/>
            </header>
        </xpath>
    </template>

    <!-- Custom Footer Layout -->
    <template id="le_footer" inherit_id="website.layout" name="Lumiee Events Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <footer id="footer" class="le-ft-wrap">
                <div class="le-ft-cta">
                    <div class="le-cta-left">
                        <h2>Continue Your <span>Success Story</span></h2>
                        <p>Join 10,000+ teams who get weekly insights on turning data into decisions. No spam, just stories worth telling. Unsubscribe anytime.</p>
                    </div>
                    <div class="le-cta-right">
                        <div class="le-ft-form">
                            <input type="email" placeholder="your@email.com"/>
                            <a href="#" class="le-ft-subscribe-btn" style="text-decoration:none; display: inline-block;">Subscribe</a>
                        </div>
                    </div>
                </div>
                <div class="le-ft-main">
                    <div class="le-ft-brand">
                        <div class="le-ft-logo">
                            <a href="/"><img src="/theme_lumiee_events/static/src/img/logo-white.png" alt="Lumiee Events Logo" style="height:70px;"/></a>
                        </div>
                        <p>Crafting unforgettable experiences from intimate gatherings to grand celebrations. Every event tells a story — we help you tell yours.</p>
                        <div class="le-ft-socials">
                            <a class="le-ft-social" aria-label="Twitter"><i class="fa fa-twitter"/></a>
                            <a class="le-ft-social" aria-label="LinkedIn"><i class="fa fa-linkedin"/></a>
                            <a class="le-ft-social" aria-label="Instagram"><i class="fa fa-instagram"/></a>
                        </div>
                    </div>
                    <div class="le-ft-right">
                        <div class="le-ft-col">
                            <h4>Services</h4>
                            <ul>
                                <li><a href="/services">Wedding Planning</a></li>
                                <li><a href="/services">Corporate Events</a></li>
                                <li><a href="/services">Birthday Celebrations</a></li>
                                <li><a href="/services">Brand Launches</a></li>
                            </ul>
                        </div>
                        <div class="le-ft-col">
                            <h4>Company</h4>
                            <ul>
                                <li><a href="/">Home</a></li>
                                <li><a href="/gallery">Gallery</a></li>
                                <li><a href="/pricing">Pricing</a></li>
                                <li><a href="/contact">Contact</a></li>
                            </ul>
                        </div>
                        <div class="le-ft-col">
                            <h4>Location</h4>
                            <ul>
                                <li style="color:rgba(255,255,255,0.7);font-size:14px;line-height:1.6;">123 Elegance Blvd, Suite 400<br/>New York, NY 10001</li>
                                <li style="color:rgba(255,255,255,0.7);font-size:14px;">+1 (555) 123-4567</li>
                                <li style="color:rgba(255,255,255,0.7);font-size:14px;">hello@lumiereevents.com</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="le-ft-bottom">
                    <p>© 2026 Lumiee Events. All rights reserved.</p>
                    <div class="le-ft-bottom-links">
                        <a href="#">Privacy Policy</a>
                        <a href="#">Terms of Service</a>
                        <a href="#">Cookie Policy</a>
                    </div>
                </div>
            </footer>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="replace"/>
    </template>
</odoo>