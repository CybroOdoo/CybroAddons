<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Theme View for Gallery Page -->
    <record id="le_gallery_page" model="theme.ir.ui.view">
        <field name="name">Lumiee Gallery Page</field>
        <field name="key">theme_lumiee_events.le_gallery_page</field>
        <field name="arch" type="xml">
            <t t-name="theme_lumiee_events.le_gallery_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <section class="le-page-hero o_colored_level" data-snippet="theme_lumiee_events.le_page_hero" data-name="Page Hero">
                            <p class="le-breadcrumb">Our Portfolio</p>
                            <h1>Recent Masterpieces</h1>
                            <p>A curated look at weddings, brand launches, corporate galas, and private celebrations — each one unique, all unforgettable.</p>
                        </section>
                        <section class="le-gallery-section le-gallery-filter-section o_colored_level" data-snippet="theme_lumiee_events.le_gallery_filter" data-name="Gallery with Filter">
                            <div class="le-filter-tabs">
                                <a class="le-filter-btn active" data-filter="all" style="cursor: pointer;">All Events</a>
                                <a class="le-filter-btn" data-filter="weddings" style="cursor: pointer;">Weddings</a>
                                <a class="le-filter-btn" data-filter="corporate" style="cursor: pointer;">Corporate</a>
                                <a class="le-filter-btn" data-filter="birthdays" style="cursor: pointer;">Birthdays</a>
                                <a class="le-filter-btn" data-filter="social" style="cursor: pointer;">Social</a>
                            </div>
                            <div class="le-gallery-grid">
                                <div class="le-gallery-item le-large" data-category="weddings"><img src="/theme_lumiee_events/static/src/img/img1.png" class="o_we_custom_image" alt="Garden Wedding"/><div class="le-overlay"/><span>Garden Wedding</span></div>
                                <div class="le-gallery-item le-small" data-category="weddings"><img src="/theme_lumiee_events/static/src/img/img2.png" class="o_we_custom_image" alt="Floral Details"/><div class="le-overlay"/><span>Floral Details</span></div>
                                <div class="le-gallery-item le-wide" data-category="corporate"><img src="/theme_lumiee_events/static/src/img/img3.png" class="o_we_custom_image" alt="Corporate Gala"/><div class="le-overlay"/><span>Corporate Gala</span></div>
                                <div class="le-gallery-item le-medium" data-category="birthdays"><img src="/theme_lumiee_events/static/src/img/img4.png" class="o_we_custom_image" alt="Birthday Styling"/><div class="le-overlay"/><span>Birthday Styling</span></div>
                                <div class="le-gallery-item le-small" data-category="social"><img src="/theme_lumiee_events/static/src/img/img5.png" class="o_we_custom_image" alt="Private Dinner"/><div class="le-overlay"/><span>Private Dinner</span></div>
                                <div class="le-gallery-item le-medium" data-category="weddings"><img src="/theme_lumiee_events/static/src/img/img6.png" class="o_we_custom_image" alt="Reception Night"/><div class="le-overlay"/><span>Reception Night</span></div>
                                <div class="le-gallery-item le-small" data-category="weddings"><img src="/theme_lumiee_events/static/src/img/img7.png" class="o_we_custom_image" alt="Arrival Moment"/><div class="le-overlay"/><span>Arrival Moment</span></div>
                                <div class="le-gallery-item le-small" data-category="social"><img src="/theme_lumiee_events/static/src/img/img9.webp" class="o_we_custom_image" alt="Luxury Setup"/><div class="le-overlay"/><span>Luxury Setup</span></div>
                                <div class="le-gallery-item le-wide" data-category="corporate"><img src="/theme_lumiee_events/static/src/img/img8.webp" class="o_we_custom_image" alt="Stage Design"/><div class="le-overlay"/><span>Stage Design</span></div>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>
                        <section class="le-brochure-section o_colored_level" data-snippet="theme_lumiee_events.le_brochure_section" data-name="Brochure CTA">
                            <div class="le-container">
                                <div class="le-content">
                                    <h2>Love What You See?</h2>
                                    <p>Every event in our portfolio started with a conversation. Let's talk about your vision.</p>
                                    <div class="le-buttons">
                                        <a href="/contact" class="le-btn primary" style="text-decoration:none; display: inline-block;">Start Planning</a>
                                        <a href="/pricing" class="le-btn outline" style="text-decoration:none; display: inline-block;">View Pricing</a>
                                    </div>
                                </div>
                                <div class="le-image-box"><img src="/theme_lumiee_events/static/src/img/brochure.png" class="o_we_custom_image" alt="Brochure Preview"/></div>
                            </div>
                        </section>
                        <div class="oe_structure oe_empty"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <!-- Theme Page for Gallery -->
    <record id="le_gallery_page_page" model="theme.website.page">
        <field name="url">/gallery</field>
        <field name="view_id" ref="le_gallery_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>
