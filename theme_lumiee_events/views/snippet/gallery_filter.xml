<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Gallery Filter Snippet -->
    <template id="le_gallery_filter" name="Lumiee Gallery Filter">
        <section class="le-gallery-section le-gallery-filter-section o_colored_level"
                 data-snippet="theme_lumiee_events.le_gallery_filter"
                 data-name="Gallery with Filter">
            <div class="le-filter-tabs" data-name="Filter Tabs">
                <a class="le-filter-btn active" data-filter="all" style="cursor: pointer;">All Events</a>
                <a class="le-filter-btn" data-filter="weddings" style="cursor: pointer;">Weddings</a>
                <a class="le-filter-btn" data-filter="corporate" style="cursor: pointer;">Corporate</a>
                <a class="le-filter-btn" data-filter="birthdays" style="cursor: pointer;">Birthdays</a>
                <a class="le-filter-btn" data-filter="social" style="cursor: pointer;">Social</a>
            </div>
            <div class="le-gallery-grid">
                <div class="le-gallery-item le-large" data-category="weddings" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img1.png" class="o_we_custom_image" alt="Garden Wedding"/><div class="le-overlay"/><span>Garden Wedding</span></div>
                <div class="le-gallery-item le-small" data-category="weddings" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img2.png" class="o_we_custom_image" alt="Floral Details"/><div class="le-overlay"/><span>Floral Details</span></div>
                <div class="le-gallery-item le-wide" data-category="corporate" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img3.png" class="o_we_custom_image" alt="Corporate Gala"/><div class="le-overlay"/><span>Corporate Gala</span></div>
                <div class="le-gallery-item le-medium" data-category="birthdays" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img4.png" class="o_we_custom_image" alt="Birthday Styling"/><div class="le-overlay"/><span>Birthday Styling</span></div>
                <div class="le-gallery-item le-small" data-category="social" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img5.png" class="o_we_custom_image" alt="Private Dinner"/><div class="le-overlay"/><span>Private Dinner</span></div>
                <div class="le-gallery-item le-medium" data-category="weddings" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img6.png" class="o_we_custom_image" alt="Reception Night"/><div class="le-overlay"/><span>Reception Night</span></div>
                <div class="le-gallery-item le-small" data-category="weddings" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img7.png" class="o_we_custom_image" alt="Arrival Moment"/><div class="le-overlay"/><span>Arrival Moment</span></div>
                <div class="le-gallery-item le-small" data-category="social" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img9.webp" class="o_we_custom_image" alt="Luxury Setup"/><div class="le-overlay"/><span>Luxury Setup</span></div>
                <div class="le-gallery-item le-wide" data-category="corporate" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img8.webp" class="o_we_custom_image" alt="Stage Design"/><div class="le-overlay"/><span>Stage Design</span></div>
            </div>
        </section>
    </template>
    <!-- Snippet Registration for Gallery Filter -->
    <template id="le_gallery_filter_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_gallery_filter" string="Gallery Filter"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
