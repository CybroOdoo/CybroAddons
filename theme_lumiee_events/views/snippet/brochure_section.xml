<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Brochure Section Snippet -->
    <template id="le_brochure_section" name="Lumiee Brochure Section">
        <section class="le-brochure-section o_colored_level"
                 data-snippet="theme_lumiee_events.le_brochure_section"
                 data-name="Brochure Section">
            <div class="le-container">
                <div class="le-content" data-name="Brochure Text">
                    <h2>Discover the Possibilities</h2>
                    <p>Download our comprehensive event planning brochure to explore our full range of services, thematic inspirations, and success stories.</p>
                    <div class="le-buttons">
                        <a href="/contact" class="le-btn primary" style="text-decoration:none; display: inline-block;">⬇ Download Brochure</a>
                        <a href="/services" class="le-btn outline" style="text-decoration:none; display: inline-block;">Read Online</a>
                    </div>
                </div>
                <div class="le-image-box" data-name="Brochure Image">
                    <img src="/theme_lumiee_events/static/src/img/brochure.png"
                         class="o_we_custom_image" alt="Brochure Preview"/>
                </div>
            </div>
        </section>
    </template>
    <!-- Snippet Registration for Brochure Section -->
    <template id="le_brochure_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_brochure_section" string="Brochure Section"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
