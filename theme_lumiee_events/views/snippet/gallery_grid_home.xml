<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Gallery Grid Snippet -->
    <template id="le_gallery_grid_home" name="Lumiee Gallery Grid">
        <section class="le-gallery-section o_colored_level"
                 data-snippet="theme_lumiee_events.le_gallery_grid_home"
                 data-name="Gallery Grid">
            <div class="le-gallery-header" data-name="Gallery Header">
                <h2>Our Recent Masterpieces</h2>
                <p>A curated selection of weddings, brand launches, and private celebrations.</p>
            </div>
            <div class="le-gallery-grid">
                <div class="le-gallery-item le-large" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img1.png" class="o_we_custom_image" alt="Garden wedding"/><div class="le-overlay"/><span>Garden wedding</span></div>
                <div class="le-gallery-item le-small" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img2.png" class="o_we_custom_image" alt="Floral details"/><div class="le-overlay"/><span>Floral details</span></div>
                <div class="le-gallery-item le-wide" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img3.png" class="o_we_custom_image" alt="Corporate gala"/><div class="le-overlay"/><span>Corporate gala</span></div>
                <div class="le-gallery-item le-medium" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img4.png" class="o_we_custom_image" alt="Birthday styling"/><div class="le-overlay"/><span>Birthday styling</span></div>
                <div class="le-gallery-item le-small" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img5.png" class="o_we_custom_image" alt="Private dinner"/><div class="le-overlay"/><span>Private dinner</span></div>
                <div class="le-gallery-item le-medium" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img6.png" class="o_we_custom_image" alt="Reception night"/><div class="le-overlay"/><span>Reception night</span></div>
                <div class="le-gallery-item le-small" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img7.png" class="o_we_custom_image" alt="Arrival moment"/><div class="le-overlay"/><span>Arrival moment</span></div>
                <div class="le-gallery-item le-small" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img9.webp" class="o_we_custom_image" alt="Luxury setup"/><div class="le-overlay"/><span>Luxury setup</span></div>
                <div class="le-gallery-item le-wide" data-name="Gallery Item"><img src="/theme_lumiee_events/static/src/img/img8.webp" class="o_we_custom_image" alt="Stage design"/><div class="le-overlay"/><span>Stage design</span></div>
            </div>
        </section>
    </template>
    <!-- Snippet Registration for Gallery Grid Home -->
    <template id="le_gallery_grid_home_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_gallery_grid_home" string="Gallery Grid"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
