<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Contact Form Home Snippet -->
    <template id="le_contact_form_home" name="Lumiee Contact Form Home">
        <section class="le-contact-section o_colored_level"
                 data-snippet="theme_lumiee_events.le_contact_form_home"
                 data-name="Contact Form">
            <div class="le-contact-container">
                <div class="le-contact-left" data-name="Contact Info">
                    <h2>Get in Touch</h2>
                    <div class="le-info">
                        <p><i class="fa fa-map-marker" style="color:#ff4da6;margin-right:8px;"/> 123 Elegance Blvd, Suite 400<br/>New York, NY 10001</p>
                        <p><i class="fa fa-phone" style="color:#ff4da6;margin-right:8px;"/> +1 (555) 123-4567</p>
                        <p><i class="fa fa-envelope" style="color:#ff4da6;margin-right:8px;"/> hello@lumiereevents.com</p>
                    </div>
                </div>
                <div class="le-contact-right" data-name="Contact Form">
                    <form action="/website/form/" method="post" enctype="multipart/form-data"
                          class="o_mark_required" data-mark="*" data-model_name="mail.mail">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="le-row">
                            <div class="le-field s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                                <label class="s_website_form_label" for="le_home_name">First Name</label>
                                <input id="le_home_name" type="text" class="s_website_form_input" name="name" placeholder="Jane" required="" data-fill-with="name"/>
                            </div>
                            <div class="le-field s_website_form_field" data-type="char" data-name="Field">
                                <label class="s_website_form_label" for="le_home_last_name">Last Name</label>
                                <input id="le_home_last_name" type="text" class="s_website_form_input" name="last_name" placeholder="Doe"/>
                            </div>
                        </div>
                        <div class="le-row">
                            <div class="le-field s_website_form_field s_website_form_required" data-type="email" data-name="Field">
                                <label class="s_website_form_label" for="le_home_email">Email Address</label>
                                <input id="le_home_email" type="email" class="s_website_form_input" name="email_from" placeholder="jane@example.com" required="" data-fill-with="email"/>
                            </div>
                            <div class="le-field s_website_form_field" data-type="char" data-name="Field">
                                <label class="s_website_form_label" for="le_home_event_date">Event Date</label>
                                <input id="le_home_event_date" type="text" class="s_website_form_input" name="event_date" placeholder="MM/DD/YYYY"/>
                            </div>
                        </div>
                        <div class="le-field full s_website_form_field s_website_form_required" data-type="text" data-name="Field">
                            <label class="s_website_form_label" for="le_home_description">Tell us about your event</label>
                            <textarea id="le_home_description" class="s_website_form_input" name="description" placeholder="I am planning a wedding for 150 guests..." required=""/>
                        </div>
                        <div class="le-field s_website_form_field s_website_form_dnone">
                            <input type="hidden" class="s_website_form_input" name="email_to"/>
                        </div>
                        <div class="s_website_form_submit" data-name="Submit Button" style="margin-top: 15px;">
                            <a href="#" role="button" class="le-submit-btn s_website_form_send" style="text-decoration:none; display: block; text-align: center;">
                                <span>Send Message</span>
                            </a>
                            <span id="s_website_form_result"/>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </template>
    <!-- Snippet Registration for Contact Form Home -->
    <template id="le_contact_form_home_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_contact_form_home" string="Contact Form"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
