<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Services Grid Snippet -->
    <template id="le_services_grid" name="Lumiee Services Grid">
        <section class="le-services-section o_colored_level"
                 data-snippet="theme_lumiee_events.le_services_grid"
                 data-name="Services Grid">
            <div class="le-service-cards">
                <div class="le-service-card" data-name="Service Card">
                    <div class="le-service-icon"><i class="fa fa-heart" style="font-size:34px;color:#ff4da6;"/></div>
                    <h3>Wedding Planning</h3>
                    <p>From ceremony to reception, we handle every detail — venue selection, floral design, catering coordination, and day-of management.</p>
                    <a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a>
                </div>
                <div class="le-service-card" data-name="Service Card">
                    <div class="le-service-icon"><i class="fa fa-building" style="font-size:34px;color:#ff4da6;"/></div>
                    <h3>Corporate Events</h3>
                    <p>Conferences, award galas, team retreats, and product launches. Professional experiences that reflect your brand.</p>
                    <a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a>
                </div>
                <div class="le-service-card" data-name="Service Card">
                    <div class="le-service-icon"><i class="fa fa-birthday-cake" style="font-size:34px;color:#ff4da6;"/></div>
                    <h3>Birthday Celebrations</h3>
                    <p>Milestone birthdays deserve unforgettable moments. Fully themed parties with custom decor and entertainment.</p>
                    <a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a>
                </div>
                <div class="le-service-card" data-name="Service Card">
                    <div class="le-service-icon"><i class="fa fa-plane" style="font-size:34px;color:#ff4da6;"/></div>
                    <h3>Destination Events</h3>
                    <p>Destination weddings or overseas retreats? We coordinate travel logistics and on-site management anywhere.</p>
                    <a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a>
                </div>
                <div class="le-service-card" data-name="Service Card">
                    <div class="le-service-icon"><i class="fa fa-glass" style="font-size:34px;color:#ff4da6;"/></div>
                    <h3>Social Galas</h3>
                    <p>Cocktail receptions, fundraising events, and private dinners crafted with elegance.</p>
                    <a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a>
                </div>
                <div class="le-service-card" data-name="Service Card">
                    <div class="le-service-icon"><i class="fa fa-rocket" style="font-size:34px;color:#ff4da6;"/></div>
                    <h3>Brand Launches</h3>
                    <p>Product unveilings, pop-up activations, and PR events that generate buzz.</p>
                    <a href="/contact" class="le-learn-more">Get a Quote <i class="fa fa-arrow-right"/></a>
                </div>
            </div>
        </section>
    </template>
    <!-- Snippet Registration for Services Grid -->
    <template id="le_services_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_services_grid" string="Services Grid"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
