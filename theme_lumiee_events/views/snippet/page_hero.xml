<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Page Hero Snippet -->
    <template id="le_page_hero" name="Lumiee Page Hero">
        <section class="le-page-hero o_colored_level"
                 data-snippet="theme_lumiee_events.le_page_hero"
                 data-name="Page Hero">
            <p class="le-breadcrumb">Section Title</p>
            <h1>Page Heading</h1>
            <p>A brief description of this page section.</p>
        </section>
    </template>
    <!-- Snippet Registration for Page Hero -->
    <template id="le_page_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_page_hero" string="Page Hero"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
