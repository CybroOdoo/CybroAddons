<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Snippet Groups Registration -->
    <template id="le_snippet_groups" inherit_id="website.snippets"
              name="Lumiee Events Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_lumiee_events/static/description/icon.png"
               string="Lumiee Events Sections"
               snippet-group="le_section"/>
        </xpath>
    </template>
</odoo>
