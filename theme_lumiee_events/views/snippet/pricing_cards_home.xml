<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Pricing Cards Home Snippet -->
    <template id="le_pricing_cards_home" name="Lumiee Pricing Cards Home">
        <section class="le-pricing-section o_colored_level"
                 data-snippet="theme_lumiee_events.le_pricing_cards_home"
                 data-name="Pricing Cards">
            <div class="le-pricing-header" data-name="Pricing Header">
                <h2>Transparent Pricing</h2>
                <p>Packages designed to fit your needs, from partial planning to full-service event production.</p>
            </div>
            <div class="le-pricing-cards">
                <div class="le-card" data-name="Card 1">
                    <h3>Day-Of Coordination</h3>
                    <h1>$1,500</h1>
                    <ul><li>✔ Pre-event consultation</li><li>✔ Vendor management</li><li>✔ 8 hours on-site coordination</li><li>✔ Timeline creation</li></ul>
                    <a href="/contact" class="le-btn outline" style="text-decoration:none; display: inline-block;">Choose Plan</a>
                </div>
                <div class="le-card active" data-name="Card 2">
                    <h3>Full Service Planning</h3>
                    <h1>$4,500</h1>
                    <ul><li>✔ Everything in Day-Of</li><li>✔ Venue selection &amp; touring</li><li>✔ Budget management</li><li>✔ Design &amp; styling board</li><li>✔ Unlimited communication</li></ul>
                    <a href="/contact" class="le-btn primary" style="text-decoration:none; display: inline-block;">Choose Plan</a>
                </div>
                <div class="le-card" data-name="Card 3">
                    <h3>Custom Event</h3>
                    <h1>Let's Talk</h1>
                    <ul><li>✔ Multi-day events</li><li>✔ Destination planning</li><li>✔ Corporate galas &amp; retreats</li><li>✔ VIP guest handling</li></ul>
                    <a href="/contact" class="le-btn outline" style="text-decoration:none; display: inline-block;">Contact Us</a>
                </div>
            </div>
        </section>
    </template>
    <!-- Snippet Registration for Pricing Cards Home -->
    <template id="le_pricing_cards_home_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_pricing_cards_home" string="Pricing Cards"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
