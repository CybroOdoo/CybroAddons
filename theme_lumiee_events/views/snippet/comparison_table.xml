<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Comparison Table Snippet -->
    <template id="le_comparison_table" name="Lumiee Comparison Table">
        <section class="le-comparison-section o_colored_level"
                 data-snippet="theme_lumiee_events.le_comparison_table"
                 data-name="Comparison Table">
            <div class="le-section-header" data-name="Section Header">
                <h2>Compare All Features</h2>
                <p>See exactly what's included in each plan before you decide.</p>
            </div>
            <div class="le-comparison-table-wrap">
                <table class="le-comparison-table">
                    <thead><tr><th>Feature</th><th>Day-Of</th><th>Full Service</th><th>Custom</th></tr></thead>
                    <tbody>
                        <tr><td>Pre-event consultation</td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                        <tr><td>Vendor coordination</td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                        <tr><td>Timeline creation</td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                        <tr><td>On-site coordination</td><td>8 hours</td><td>Full day</td><td>Custom</td></tr>
                        <tr><td>Venue selection &amp; touring</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                        <tr><td>Budget management</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                        <tr><td>Design &amp; styling board</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                        <tr><td>Unlimited communication</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                        <tr><td>Destination event support</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                        <tr><td>VIP guest handling</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                        <tr><td>Multi-day event support</td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-minus le-dash-icon"/></td><td><i class="fa fa-check le-check-icon"/></td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </template>
    <!-- Snippet Registration for Comparison Tabsnippet -->
    <template id="le_comparison_table_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_comparison_table" string="Comparison Table"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
