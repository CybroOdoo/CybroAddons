<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Process Steps Snippet -->
    <template id="le_process_steps" name="Lumiee Process Steps">
        <section class="le-process-section o_colored_level"
                 data-snippet="theme_lumiee_events.le_process_steps"
                 data-name="Process Steps">
            <div class="le-section-header" data-name="Section Header">
                <h2 class="o_editable">How We Work</h2>
                <p class="o_editable">A clear, collaborative process designed to make planning effortless.</p>
            </div>
            <div class="le-process-steps">
                <div class="le-step" data-name="Step 1"><div class="le-step-num">1</div><h4 class="o_editable">Discovery Call</h4><p class="o_editable">Free 30-minute consultation to understand your vision.</p></div>
                <div class="le-step" data-name="Step 2"><div class="le-step-num">2</div><h4 class="o_editable">Custom Proposal</h4><p class="o_editable">Tailored proposal with vendor recommendations and pricing.</p></div>
                <div class="le-step" data-name="Step 3"><div class="le-step-num">3</div><h4 class="o_editable">Planning &amp; Design</h4><p class="o_editable">We handle bookings, contracts, and design boards.</p></div>
                <div class="le-step" data-name="Step 4"><div class="le-step-num">4</div><h4 class="o_editable">Your Perfect Day</h4><p class="o_editable">Our team manages every detail on the day.</p></div>
            </div>
        </section>
    </template>
    <!-- Snippet Registration for Process Steps -->
    <template id="le_process_steps_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_process_steps" string="Process Steps"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
