<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Hero Banner Snippet -->
    <template id="le_hero_banner" name="Lumiee Hero Banner">
        <section class="le-hero o_colored_level"
                 data-snippet="theme_lumiee_events.le_hero_banner"
                 data-name="Hero Banner">
            <div class="le-hero-text" data-name="Hero Text">
                <h1>Crafting Unforgettable Experiences</h1>
                <p>From intimate gatherings to grand celebrations, we bring your vision to life with flawless execution and elegant design.</p>
                <div class="le-hero-buttons">
                    <a href="/services" class="le-hero-button" style="text-decoration:none; display: inline-block;">Explore Services</a>
                    <a href="/contact" class="le-hero-button2" style="text-decoration:none; display: inline-block;">Get Started</a>
                </div>
            </div>
            <div class="le-hero-image" data-name="Hero Image">
                <img src="/theme_lumiee_events/static/src/img/banner.png"
                     class="o_we_custom_image" alt="Event setup"/>
            </div>
        </section>
    </template>

    <!-- Snippet Registration for Hero Banner -->
    <template id="le_hero_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_hero_banner"
               string="Hero Banner"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png"
               group="le_section"/>
        </xpath>
    </template>
</odoo>
