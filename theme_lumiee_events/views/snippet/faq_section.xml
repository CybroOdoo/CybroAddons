<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for FAQ Section Snippet -->
    <template id="le_faq_section" name="Lumiee FAQ Section">
        <section class="le-faq-section o_colored_level"
                 data-snippet="theme_lumiee_events.le_faq_section"
                 data-name="FAQ Section">
            <div class="le-faq-header" data-name="FAQ Header">
                <h2>Frequently Asked Questions</h2>
                <p>Find answers to common questions about our event planning services.</p>
            </div>
            <div class="le-faq-container">
                <div class="le-faq-item active" data-name="FAQ Item">
                    <div class="le-faq-question">
                        <span>How far in advance should we book?</span>
                        <button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button>
                    </div>
                    <div class="le-faq-answer">
                        <p>We recommend booking at least 6–12 months in advance for weddings, and 2–3 months for corporate or social events.</p>
                    </div>
                </div>
                <div class="le-faq-item" data-name="FAQ Item">
                    <div class="le-faq-question">
                        <span>Do you offer custom packages?</span>
                        <button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button>
                    </div>
                    <div class="le-faq-answer">
                        <p>Yes! We create custom proposals tailored to your specific needs, budget, and vision.</p>
                    </div>
                </div>
                <div class="le-faq-item" data-name="FAQ Item">
                    <div class="le-faq-question">
                        <span>Will you travel for destination events?</span>
                        <button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button>
                    </div>
                    <div class="le-faq-answer">
                        <p>Absolutely! We coordinate logistics anywhere. Travel fees may apply depending on location.</p>
                    </div>
                </div>
                <div class="le-faq-item" data-name="FAQ Item">
                    <div class="le-faq-question">
                        <span>Do you handle vendor contracts?</span>
                        <button class="le-faq-btn" type="button"><i class="fa fa-chevron-down le-icon"/></button>
                    </div>
                    <div class="le-faq-answer">
                        <p>Yes, we assist with vendor coordination, contracts, and payments within your agreed budget.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Snippet Registration for Faq Section -->
    <template id="le_faq_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_lumiee_events.le_faq_section" string="FAQ Section"
               t-thumbnail="/theme_lumiee_events/static/src/img/logo.png" group="le_section"/>
        </xpath>
    </template>
</odoo>
