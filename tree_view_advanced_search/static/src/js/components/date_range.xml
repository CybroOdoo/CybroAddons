<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="tree_view_advanced_search.DateRange">
        <div class="d-flex align-items-center">
            <div class="date-input me-1">
                <DateTimeInput
                    value="this.dateFrom"
                    type="'date'"
                    placeholder="this.fromPlaceholder"
                    onChange.bind="this.onDateFromChanged"
                />
            </div>
            <div class="arrow mx-1">
                <i class="oi" data-icon="arrow_forward"/>
            </div>
            <div class="date-input ms-1">
                <DateTimeInput
                    value="this.dateTo"
                    type="'date'"
                    placeholder="this.toPlaceholder"
                    onChange.bind="this.onDateToChanged"
                />
            </div>
        </div>
    </t>
</templates>
