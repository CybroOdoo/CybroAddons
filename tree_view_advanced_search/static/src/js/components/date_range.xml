<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="DateRange">
        <div style=" display: flex;">
            <div class="date-input">
                <DateTimeInput
                    value="dateFrom"
                    type="'date'"
                    placeholder="fromPlaceholder"
                    onChange="(val) => this.onDateFromChanged(val)"
                />
            </div>
            <div class="arrow">
                <i class="oi oi-arrow-right"/>
            </div>
            <div class="date-input">
                <DateTimeInput
                    value="dateTo"
                    type="'date'"
                    placeholder="toPlaceholder"
                    onChange="(val) => this.onDateToChanged(val)"
                />
            </div>
        </div>
    </t>
</templates>
