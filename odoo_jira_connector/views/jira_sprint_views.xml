<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List View -->
    <record id="jira_sprint_view_list" model="ir.ui.view">
        <field name="name">jira.sprint.view.list</field>
        <field name="model">jira.sprint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sprint_goal"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!-- Form View -->
    <record id="jira_sprint_view_form" model="ir.ui.view">
        <field name="name">jira.sprint.view.form</field>
        <field name="model">jira.sprint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button string="Tasks" class="oe_stat_button" type="object"
                                name="action_get_tasks" icon="fa-tasks"/>
                        <button string="Backlogs" class="oe_stat_button" type="object"
                                name="action_get_backlogs" icon="fa-list"/>
                        <button string="All Tasks" class="oe_stat_button" type="object"
                                name="action_get_all_tasks" icon="fa-folder-open"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Sprint name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="sprint_id_jira"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Goal" name="goal">
                            <field name="sprint_goal"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
