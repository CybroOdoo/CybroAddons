<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add the Jira project fields and the Sprint smart button to the project form -->
    <record id="edit_project" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.odoo.jira.connector</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="project_id_jira"/>
                <field name="jira_project_key"/>
            </field>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="sprint_active" invisible="1"/>
                <button string="Sprint" class="oe_stat_button" type="object" name="action_get_sprint"
                        icon="fa-clock-o" invisible="not sprint_active"/>
            </xpath>
        </field>
    </record>
</odoo>
