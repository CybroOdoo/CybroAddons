<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Add the Jira issue key and sprint to the task form -->
    <record id="project_project_form_view_inherit_jira_connector" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.odoo.jira.connector</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="task_id_jira"/>
                <field name="task_sprint_active" invisible="1"/>
                <field name="sprint_id" invisible="not task_sprint_active"/>
            </field>
        </field>
    </record>
</odoo>
