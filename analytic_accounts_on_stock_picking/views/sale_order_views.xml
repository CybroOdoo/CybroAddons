<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Adding the field 'analytic_account_id' to the model sale.order.line -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.analytic.accounts.on.stock.picking</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//page[@name='order_lines']//tree/field[@name='name']" position="after">
                <field name="analytic_account_id"/>
            </xpath>
        </field>
    </record>
</odoo>