<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Defines the list view for flight aerodrome records. -->
    <record id="view_flight_aerodrome_list" model="ir.ui.view">
        <field name="name">flight.aerodrome.list</field>
        <field name="model">flight.aerodrome</field>
        <field name="arch" type="xml">
            <list string="Aerodromes">
                <field name="icao_code"/>
                <field name="iata_code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <!-- Defines the form view for managing flight aerodrome details. -->
    <record id="view_flight_aerodrome_form" model="ir.ui.view">
        <field name="name">flight.aerodrome.form</field>
        <field name="model">flight.aerodrome</field>
        <field name="arch" type="xml">
            <form string="Aerodrome">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Los Angeles International"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="icao_code"/>
                            <field name="iata_code"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="timezone"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Defines the search view for filtering flight aerodrome records. -->
    <record id="view_flight_aerodrome_search" model="ir.ui.view">
        <field name="name">flight.aerodrome.search</field>
        <field name="model">flight.aerodrome</field>
        <field name="arch" type="xml">
            <search string="Aerodromes">
                <field name="name"/>
                <field name="icao_code"/>
                <field name="iata_code"/>
                <field name="country_id"/>
                <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
            </search>
        </field>
    </record>

    <!-- Defines the window action for accessing flight aerodrome records. -->
    <record id="action_flight_aerodrome" model="ir.actions.act_window">
        <field name="name">Aerodromes</field>
        <field name="res_model">flight.aerodrome</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flight_aerodrome_search"/>
    </record>

</odoo>