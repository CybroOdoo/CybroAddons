<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Defines the root menu for the Flight Management module. -->
    <menuitem id="menu_flight_management_root" name="Flight Management" sequence="10"
              groups="group_flight_management_user"/>

    <!-- Defines the Operations menu under Flight Management. -->
    <menuitem id="menu_flight_operations" name="Operations" parent="menu_flight_management_root" sequence="10"/>

    <!-- Defines the menu for accessing flight records. -->
    <menuitem id="menu_flight_flight" name="Flights" parent="menu_flight_operations"
              action="action_flight_flight" sequence="10"/>

    <!-- Defines the menu for accessing flight event records. -->
    <menuitem id="menu_flight_event" name="Flight Events" parent="menu_flight_operations"
              action="action_flight_event" sequence="20"/>

    <!-- Defines the Fleet menu under Flight Management. -->
    <menuitem id="menu_flight_fleet" name="Fleet" parent="menu_flight_management_root" sequence="20"/>

    <!-- Defines the menu for accessing aircraft records. -->
    <menuitem id="menu_flight_aircraft" name="Aircraft" parent="menu_flight_fleet"
              action="action_flight_aircraft" sequence="10"/>

    <!-- Defines the Configuration menu for flight management settings. -->
    <menuitem id="menu_flight_configuration" name="Configuration" parent="menu_flight_management_root"
              sequence="90" groups="group_flight_management_manager"/>

    <!-- Defines the menu for accessing aerodrome records. -->
    <menuitem id="menu_flight_aerodrome" name="Aerodromes" parent="menu_flight_configuration"
              action="action_flight_aerodrome" sequence="10"/>

    <!-- Defines the menu for accessing aircraft manufacturers. -->
    <menuitem id="menu_flight_aircraft_make" name="Manufacturers" parent="menu_flight_configuration"
              action="action_flight_aircraft_make" sequence="20"/>

    <!-- Defines the menu for accessing aircraft models. -->
    <menuitem id="menu_flight_aircraft_model" name="Aircraft Models" parent="menu_flight_configuration"
              action="action_flight_aircraft_model" sequence="30"/>

    <!-- Defines the menu for accessing aircraft classes. -->
    <menuitem id="menu_flight_aircraft_class" name="Aircraft Classes" parent="menu_flight_configuration"
              action="action_flight_aircraft_class" sequence="40"/>

</odoo>