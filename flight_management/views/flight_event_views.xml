<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Defines the list view for managing flight events. -->
    <record id="view_flight_event_list" model="ir.ui.view">
        <field name="name">flight.event.list</field>
        <field name="model">flight.event</field>
        <field name="arch" type="xml">
            <list string="Flight Events">
                <field name="flight_id"/>
                <field name="event_type"/>
                <field name="timestamp"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Defines the window action for accessing flight events. -->
    <record id="action_flight_event" model="ir.actions.act_window">
        <field name="name">Flight Events</field>
        <field name="res_model">flight.event</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>