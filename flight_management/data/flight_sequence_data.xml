<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for generating flight numbers. -->
    <record id="seq_flight_flight" model="ir.sequence">
        <field name="name">Flight Number</field>
        <field name="code">flight.flight</field>
        <field name="prefix">FL</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>