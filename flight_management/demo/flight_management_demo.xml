<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="demo_class_narrow_body" model="flight.aircraft.class">
        <field name="name">Narrow Body</field>
        <field name="code">NB</field>
    </record>

    <record id="demo_make_boeing" model="flight.aircraft.make">
        <field name="name">Boeing</field>
        <field name="code">BA</field>
    </record>

    <record id="demo_model_737" model="flight.aircraft.model">
        <field name="name">737-800</field>
        <field name="code">B738</field>
        <field name="make_id" ref="demo_make_boeing"/>
        <field name="class_id" ref="demo_class_narrow_body"/>
        <field name="default_capacity">189</field>
    </record>

    <record id="demo_aerodrome_lax" model="flight.aerodrome">
        <field name="name">Los Angeles International</field>
        <field name="icao_code">KLAX</field>
        <field name="iata_code">LAX</field>
        <field name="city">Los Angeles</field>
    </record>

    <record id="demo_aerodrome_jfk" model="flight.aerodrome">
        <field name="name">John F. Kennedy International</field>
        <field name="icao_code">KJFK</field>
        <field name="iata_code">JFK</field>
        <field name="city">New York</field>
    </record>

    <record id="demo_aircraft_1" model="flight.aircraft">
        <field name="name">N12345</field>
        <field name="code">AC-001</field>
        <field name="model_id" ref="demo_model_737"/>
        <field name="capacity">189</field>
        <field name="home_base_id" ref="demo_aerodrome_lax"/>
        <field name="status">active</field>
    </record>

    <record id="demo_flight_1" model="flight.flight">
        <field name="aircraft_id" ref="demo_aircraft_1"/>
        <field name="origin_id" ref="demo_aerodrome_lax"/>
        <field name="destination_id" ref="demo_aerodrome_jfk"/>
        <field name="scheduled_departure" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
        <field name="scheduled_arrival" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 17:30:00')"/>
        <field name="state">scheduled</field>
    </record>

</odoo>