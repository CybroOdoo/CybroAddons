<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Flight management user group. -->
    <record id="group_flight_management_user" model="res.groups">
        <field name="name">Flight Management / User</field>
    </record>

    <!-- Flight management manager group. -->
    <record id="group_flight_management_manager" model="res.groups">
        <field name="name">Flight Management / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_flight_management_user'))]"/>
    </record>
</odoo>