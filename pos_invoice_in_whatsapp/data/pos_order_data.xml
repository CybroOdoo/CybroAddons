<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--Whatsapp message mail template of purchase order -->
        <record id="pos_order_whatsapp_template" model="mail.template">
            <field name="name">Whatsapp Template for POS Order</field>
            <field name="subject">POS Order Template</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="is_pos_template">True</field>
            <field name="body_html">
                <![CDATA[<div style="F Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;">
                 <p style="margin: 0px; padding: 0px; font-size: 13px;">
                 <div>
                    Hello *<t t-out="object.partner_id.name or ''"></t>*,
                    Greetings from *<t t-out="object.company_id.name or ' '"></t>*

                 </div>
                    Your Request For Quotation (RFQ) *<t t-out="object.pos_reference"></t>* with amount *<t t-out="format_amount(object.amount_total,object.currency_id)"></t>* is ready.
                    <div>
                        Quotation details are mentioned below: <br>
                        <t t-foreach="object" t-as="each">
                            <t t-foreach="each.lines" t-as="id">
                                *Product: <t t-out="id.full_product_name"></t>* <br>
                                 *Qty: <t t-out="id.qty"></t>*<br>
                                 *Price:<t t-out="id.price_subtotal"></t>*<br>
                            </t>
                        </t>
                    </div>
                 <div>
                If you require any further information, feel free to contact me.
            </div>
        ]]>
            </field>
        </record>
    </data>
</odoo>
