<?xml version="1.0" encoding="UTF-8"?>
<!--Inherited the receipt screen and added a Send Through Whatsapp button-->
<templates id="template" xml:space="preserve">
    <t t-name="ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('receipt-screen')]//form" position="after">
            <div>
        <form class="send-wtsp">
                <button class="send whatsapp" t-on-click="click_whatsapp">Send Through Whatsapp</button>
        </form>
            </div>
        </xpath>
            </t>
</templates>
