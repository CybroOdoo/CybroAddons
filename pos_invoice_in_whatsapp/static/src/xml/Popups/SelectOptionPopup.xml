<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for Whatsapp Message Popup -->
<templates id="template" xml:space="preserve">
    <t t-name="WtspMessagePopup" owl="1">
        <div class="popup order-question-popup">
    <header class="title">
        <t t-esc="props.title"/>
    </header>
            <div style="padding: 1rem;display: flex;flex-direction: column;">
        <label>
            <input type="radio" id="option1_text" name="option"
                   t-on-change="getValue" string="text"/>
            Text
        </label>
                <br/>
                <label>
            <input type="radio" id="option2_doc_pdf" name="option"
                   string="pdf"/>
                    Document As Pdf
        </label>
                <br/>
                <label>
            <input type="radio" id="option3_doc_img" name="option"
                   string="image"/>
                    Document As Image
        </label>
    </div>
            <div class="order_line_content d-none"/>
            <div class="footer">
        <div class="button confirm highlight" t-on-click="confirm">
            <t t-esc="props.confirmText"/>
        </div>
                <div class="button cancel" t-on-click="cancel">
            <t t-esc="props.cancelText"/>
        </div>
    </div>
</div>
    </t>
        </templates>
