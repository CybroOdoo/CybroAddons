<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report list: one row per salesperson of a wizard run -->
    <record id="view_sales_performance_line_list" model="ir.ui.view">
        <field name="name">sales.performance.line.list</field>
        <field name="model">sales.performance.line</field>
        <field name="arch" type="xml">
            <list string="Sales Performance" sample="1" create="0" delete="0">
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="company_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="estimated_revenue" sum="Total Estimated Revenue"
                       widget="monetary" decoration-bf="1" optional="show"/>
                <field name="net_revenue" sum="Net Revenue" widget="monetary"
                       decoration-bf="1" optional="show"/>
                <field name="total_sale_order" sum="Total Order"
                       decoration-bf="1" optional="show"/>
                <button name="action_sale_order" type="object"
                       string="Sale Orders" class="oe_highlight"/>
                <field name="sale_order_done" sum="Total Done Order"
                       decoration-bf="1" optional="show"/>
                <field name="returned_orders" sum="Total Returned Orders"
                       decoration-bf="1" optional="show"/>
                <field name="avg_price" widget="monetary"
                       decoration-bf="1" optional="show"/>
                <field name="overall_performance" optional="show"/>
                <field name="overall_performance_separate" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sales_performance_line_search" model="ir.ui.view">
        <field name="name">sales.performance.line.search</field>
        <field name="model">sales.performance.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="company_id"/>
                <group>
                    <filter string="Sales Team" name="group_team"
                            context="{'group_by': 'team_id'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
