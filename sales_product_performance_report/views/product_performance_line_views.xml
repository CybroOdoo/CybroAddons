<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report list: one row per product and company of a wizard run -->
    <record id="view_product_performance_line_list" model="ir.ui.view">
        <field name="name">product.performance.line.list</field>
        <field name="model">product.performance.line</field>
        <field name="arch" type="xml">
            <list string="Product Performance" sample="1" create="0" delete="0">
                <field name="product_tmpl_id"/>
                <field name="categ_id"/>
                <field name="company_id"/>
                <field name="warehouse_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="revenue" sum="Total Revenue" widget="monetary" optional="show"/>
                <field name="quantity" sum="On Hand Quantity" optional="show"
                       decoration-danger="quantity &lt;= avg_ordered_qty"/>
                <field name="total_order" sum="Total Order" optional="show"/>
                <button name="action_sale_order" type="object" string="Sale Orders" class="oe_highlight"/>
                <field name="ordered_quantities" sum="Total Ordered Quantities" optional="show"/>
                <field name="delivered_quantities" sum="Total Delivered Quantities" optional="show"/>
                <field name="returned_quantities" sum="Total Returned Quantities" optional="show"/>
                <field name="avg_price" widget="monetary" optional="show"/>
                <field name="avg_ordered_qty" optional="show"/>
                <field name="avg_delivered_qty" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_product_performance_line_search" model="ir.ui.view">
        <field name="name">product.performance.line.search</field>
        <field name="model">product.performance.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="categ_id"/>
                <field name="company_id"/>
                <group>
                    <filter string="Product Category" name="group_categ"
                            context="{'group_by': 'categ_id'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"/>
                    <filter string="Warehouse" name="group_warehouse"
                            context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
