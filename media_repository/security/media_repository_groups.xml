<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Category: Media Repository Access Rights Module Category -->
        <record id="media_repository_category" model="ir.module.category">
            <field name="name">Media Repository</field>
            <field name="description">Media Repository Access Rights</field>
        </record>

        <!-- Group: User Group (Base Users) -->
        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="media_repository_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group: Manager Group (Admins / Managers) -->
        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="media_repository_category"/>
            <field name="implied_ids" eval="[(4, ref('media_repository.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
