<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action: Media Assets window action -->
    <record id="action_media_asset" model="ir.actions.act_window">
        <field name="name">Media Assets</field>
        <field name="res_model">media.asset</field>
        <field name="context">{'search_default_admin_records': 1}</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload your first media asset!
            </p>
            <p>
                Store images, videos, documents, audio files, and external URLs
                in one centralized repository.
            </p>
        </field>
    </record>

    <!-- Form View: Media Asset Form View -->
    <record id="view_media_asset_form" model="ir.ui.view">
        <field name="name">media.asset.form</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <form string="Media Asset">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button type="object" name="confirm" string="Confirm" class="btn btn-primary" invisible="state == 'confirmed'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Media Name…" readonly="state == 'confirmed'"/>
                        </h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="media_type" readonly="state in 'confirmed'"/>
                            <field name="category_id" readonly="state in 'confirmed'"/>
                            <field name="source_type" readonly="state in 'confirmed'"/>
                        </group>
                         <group string="Upload Info" >
                            <field name="create_uid" readonly="state in 'confirmed'"/>
                            <field name="create_date" readonly="state in 'confirmed'"/>
                             <field name="favorite" readonly="state in 'confirmed'"/>
                             <field name="media_tag_ids" widget="many2many_tags" readonly="state in 'confirmed'"/>
                        </group>
                    </group>

                    <group string="Upload" >
                        <field name="file" filename="file_name" widget="media_large_file" invisible="source_type =='url' or not source_type" readonly="state in 'confirmed'"/>
                        <field name="source_url" widget="url" placeholder="https://…" invisible="source_type =='file' or not source_type " readonly="state in 'confirmed'"/>
                        <field name="file_name" invisible="source_type =='url' or not source_type" readonly="state in 'confirmed'"/>
                        <field name="file_size" invisible="source_type =='url' or not source_type" readonly="state in 'confirmed'"/>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Enter a description…" readonly="state in 'confirmed'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View: Media Asset Kanban Card Layout -->
    <record id="view_media_asset_kanban" model="ir.ui.view">
        <field name="name">media.asset.kanban</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="o_kanban_attachment flex-row">
                        <aside class="o_kanban_image m-1">
                            <div style="padding-left:10px;" class="o_kanban_image_wrapper d-flex align-items-center justify-content-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" invisible="media_type != 'image'" style="width: 60px; height: 60px; background-color: #eff6ff;">
                                    <i class="fa fa-picture-o text-primary" style="font-size: 24px;" title="Image Icon"/>
                                </div>
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; background-color: #fff1f2;" invisible="media_type != 'video'">
                                    <i class="fa fa-video-camera" style="font-size: 24px; color: #f43f5e;" title="Video Icon"/>
                                </div>
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; background-color: #ecfdf5;" invisible="media_type != 'document'">
                                    <i class="fa fa-file-text" style="font-size: 24px; color: #10b981;" title="Document Icon"/>
                                </div>
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" invisible="media_type != 'audio'" style="width: 60px; height: 60px; background-color: #f5f3ff;">
                                    <i class="fa fa-music" style="font-size: 24px; color: #8b5cf6;" title="Audio Icon"/>
                                </div>
                                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" invisible="media_type != 'url'" style="width: 60px; height: 60px; background-color: #fffbeb;">
                                    <i class="fa fa-link" style="font-size: 24px; color: #f59e0b;" title="URL Link Icon"/>
                                </div>
                            </div>
                        </aside>
                        <main class="ms-1">
                            <div class="o_kanban_details_wrapper d-flex flex-column">
                                <field name="name" class="text-truncate fw-bold fs-5"/>
                                <div class="d-flex" style="padding-top:10px;">
                                    <field name="media_type"/>
                                    <field name="create_uid" class="ms-auto" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View: Media Asset List View -->
    <record id="view_media_asset_list" model="ir.ui.view">
        <field name="name">media.asset.list</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <list string="Media Assets">
                <field name="name"/>
                <field name="media_type"/>
                <field name="category_id"/>
                <field name="create_uid"/>
                <field name="create_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Search View: Media Asset Search and Filter Configuration -->
    <record id="view_media_asset_search" model="ir.ui.view">
        <field name="name">media.asset.search</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <search string="Search Media Assets">
                <field name="name"/>
                <field name="category_id"/>

                <filter name="filter_image" string="Images" domain="[('media_type', '=', 'image')]"/>
                <filter name="filter_video" string="Videos" domain="[('media_type', '=', 'video')]"/>
                <filter name="filter_url" string="URL" domain="[('media_type', '=', 'url')]"/>
                <filter name="filter_document" string="Documents" domain="[('media_type', '=', 'document')]"/>
                <filter name="filter_favourite" string="Favourites" domain="[('favorite', '=', True)]"/>
                <filter name="admin_records" string="My Records" domain="[('create_uid', '=', uid)]" groups="media_repository.group_manager"/>

                <filter name="media_type" string="Media Type" context="{'group_by': 'media_type'}"/>
                <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>

    <!-- Menu Items: Root menu and configuration menus -->
    <menuitem id="menu_media_repository_root"
              name="Media Repository"
              web_icon="media_repository,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_media_repository_configuration"
              name="Configuration"
              parent="menu_media_repository_root"
              sequence="20"/>

    <menuitem id="menu_media_assets"
              name="Media Assets"
              parent="menu_media_repository_root"
              action="action_media_asset"
              sequence="11"/>
</odoo>
