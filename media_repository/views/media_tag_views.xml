<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_media_tag_list" model="ir.ui.view">
        <field name="name">media.tag.list</field>
        <field name="model">media.tag</field>
        <field name="arch" type="xml">
            <list string="Media Tag" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_media_tag" model="ir.actions.act_window">
        <field name="name">Media Tag</field>
        <field name="res_model">media.tag</field>
        <field name="view_mode">list</field>
    </record>

    <!-- MENU ITEM -->
    <menuitem id="menu_media_tag"
              name="Media Tag"
              parent="menu_media_repository_configuration"
              action="action_media_tag"/>
</odoo>