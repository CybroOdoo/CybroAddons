<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Raises the direct multipart upload ceiling (used by the large-file
             upload controller) from Odoo's 128MiB default to 50GiB. Does not
             affect the standard binary widget's call_kw upload path, which is
             capped earlier in the request lifecycle regardless of this value. -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('web.max_file_upload_size', 53687091200)"/>

    </data>
</odoo>
