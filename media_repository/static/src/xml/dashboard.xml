<?xml version="1.0" encoding="UTF-8" ?>
<!-- Dashboard Template for Media Repository
     Displays asset metrics, category counts, and media type navigation. -->
<templates>
    <t t-name="media_type_dashboard.MediaTypeDashboard">
        <div class="container-fluid p-4 bg-light min-vh-100" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h1 class="h3 fw-bold text-dark mb-1">Media Dashboard</h1>
                    <p class="text-muted mb-0">Centralized repository for storing and organizing assets</p>
                </div>
                <div class="bg-white px-3 py-2 rounded-pill shadow-sm border d-flex align-items-center gap-2">
                    <i class="fa fa-cubes text-primary"/>
                    <span class="text-secondary fw-semibold">Total Assets</span>
                    <span class="badge rounded-pill bg-primary" t-out="this.result.count[0] + this.result.count[1] + this.result.count[2] + this.result.count[3] + this.result.count[4]"/>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-sm-6 col-lg">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden"
                         style="border-top: 4px solid #3b82f6 !important; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                         onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(59, 130, 246, 0.15)';"
                         onmouseout="this.style.transform='none'; this.style.boxShadow='none';"
                         t-on-click.prevent="() => this.actionService.doAction({
                             name: 'Image',
                             res_model: 'media.asset',
                             type: 'ir.actions.act_window',
                             views: [[false, 'list'], [false, 'form']],
                             domain: [['media_type', '=', 'image']],
                         })">
                        <div class="card-body text-center d-flex flex-column align-items-center p-4">
                            <div class="rounded-circle d-flex align-items-center justify-content-center mb-3"
                                 style="width: 60px; height: 60px; background-color: #eff6ff;">
                                <i class="fa fa-picture-o text-primary" style="font-size: 24px;"/>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Images</h5>
                            <p class="text-muted small mb-3">Photos, graphics, and illustrations</p>
                            <h2 class="fw-bold text-dark mb-3" t-out="this.result.count[0]"/>
                            <div class="mt-auto text-primary fw-semibold small">
                                Browse files <i class="fa fa-arrow-right ms-1"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden"
                         style="border-top: 4px solid #f43f5e !important; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                         onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(244, 63, 94, 0.15)';"
                         onmouseout="this.style.transform='none'; this.style.boxShadow='none';"
                         t-on-click.prevent="() => this.actionService.doAction({
                             name: 'Video',
                             res_model: 'media.asset',
                             type: 'ir.actions.act_window',
                             views: [[false, 'list'], [false, 'form']],
                             domain: [['media_type', '=', 'video']],
                         })">
                        <div class="card-body text-center d-flex flex-column align-items-center p-4">
                            <div class="rounded-circle d-flex align-items-center justify-content-center mb-3"
                                 style="width: 60px; height: 60px; background-color: #fff1f2;">
                                <i class="fa fa-video-camera" style="font-size: 24px; color: #f43f5e;"/>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Videos</h5>
                            <p class="text-muted small mb-3">Video clips, animations, and movies</p>
                            <h2 class="fw-bold text-dark mb-3" t-out="this.result.count[1]"/>
                            <div class="mt-auto fw-semibold small" style="color: #f43f5e;">
                                Browse files <i class="fa fa-arrow-right ms-1"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden"
                         style="border-top: 4px solid #10b981 !important; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                         onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(16, 185, 129, 0.15)';"
                         onmouseout="this.style.transform='none'; this.style.boxShadow='none';"
                         t-on-click.prevent="() => this.actionService.doAction({
                             name: 'Document',
                             res_model: 'media.asset',
                             type: 'ir.actions.act_window',
                             views: [[false, 'list'], [false, 'form']],
                             domain: [['media_type', '=', 'document']],
                         })">
                        <div class="card-body text-center d-flex flex-column align-items-center p-4">
                            <div class="rounded-circle d-flex align-items-center justify-content-center mb-3"
                                 style="width: 60px; height: 60px; background-color: #ecfdf5;">
                                <i class="fa fa-file-text" style="font-size: 24px; color: #10b981;"/>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Documents</h5>
                            <p class="text-muted small mb-3">PDFs, text files, and spreadsheets</p>
                            <h2 class="fw-bold text-dark mb-3" t-out="this.result.count[2]"/>
                            <div class="mt-auto fw-semibold small" style="color: #10b981;">
                                Browse files <i class="fa fa-arrow-right ms-1"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden"
                         style="border-top: 4px solid #f59e0b !important; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                         onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(245, 158, 11, 0.15)';"
                         onmouseout="this.style.transform='none'; this.style.boxShadow='none';"
                         t-on-click.prevent="() => this.actionService.doAction({
                             name: 'Url',
                             res_model: 'media.asset',
                             type: 'ir.actions.act_window',
                             views: [[false, 'list'], [false, 'form']],
                             domain: [['media_type', '=', 'url']],
                         })">
                        <div class="card-body text-center d-flex flex-column align-items-center p-4">
                            <div class="rounded-circle d-flex align-items-center justify-content-center mb-3"
                                 style="width: 60px; height: 60px; background-color: #fffbeb;">
                                <i class="fa fa-link" style="font-size: 24px; color: #f59e0b;"/>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">URLs</h5>
                            <p class="text-muted small mb-3">Websites and external links</p>
                            <h2 class="fw-bold text-dark mb-3" t-out="this.result.count[3]"/>
                            <div class="mt-auto fw-semibold small" style="color: #f59e0b;">
                                Browse files <i class="fa fa-arrow-right ms-1"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden"
                         style="border-top: 4px solid #8b5cf6 !important; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                         onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(139, 92, 246, 0.15)';"
                         onmouseout="this.style.transform='none'; this.style.boxShadow='none';"
                         t-on-click.prevent="() => this.actionService.doAction({
                             name: 'Audio',
                             res_model: 'media.asset',
                             type: 'ir.actions.act_window',
                             views: [[false, 'list'], [false, 'form']],
                             domain: [['media_type', '=', 'audio']],
                         })">
                        <div class="card-body text-center d-flex flex-column align-items-center p-4">
                            <div class="rounded-circle d-flex align-items-center justify-content-center mb-3"
                                 style="width: 60px; height: 60px; background-color: #f5f3ff;">
                                <i class="fa fa-music" style="font-size: 24px; color: #8b5cf6;"/>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Audio</h5>
                            <p class="text-muted small mb-3">Audio tracks, music, and voice notes</p>
                            <h2 class="fw-bold text-dark mb-3" t-out="this.result.count[4]"/>
                            <div class="mt-auto fw-semibold small" style="color: #8b5cf6;">
                                Browse files <i class="fa fa-arrow-right ms-1"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>

