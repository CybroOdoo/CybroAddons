<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="media_repository.LargeFileBinaryField">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <t t-if="!props.record.resId">
                <span class="text-muted fst-italic">Save the record first to upload a file.</span>
            </t>
            <t t-else="">
                <t t-if="hasFile">
                    <a href="#" class="fw-bold" t-on-click.prevent="onFileDownload" t-esc="fileName"/>
                    <button t-if="!props.readonly" class="btn btn-sm btn-link text-danger p-0"
                            type="button" t-on-click="onFileRemove" data-tooltip="Remove">
                        <i class="fa fa-trash" role="img" aria-label="Remove"/>
                    </button>
                </t>
                <FileInput t-if="!props.readonly"
                           route="uploadRoute"
                           resModel="props.record.resModel"
                           resId="props.record.resId"
                           onUpload.bind="onFileUploaded">
                    <button class="btn btn-sm btn-secondary" type="button">
                        <i class="fa fa-upload" role="img" aria-label="Upload"/> Upload
                    </button>
                </FileInput>
            </t>
        </div>
    </t>

</templates>
