<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Register the About Us Page Route -->
        <record id="aboutus_page_greenscape" model="website.page">
            <field name="name">About Us</field>
            <field name="url">/aboutus</field>
            <field name="view_id" ref="website.aboutus"/>
            <field name="is_published">True</field>
            <field name="track">True</field>
        </record>
        <!-- Add About Us to Main Menu -->
        <record id="menu_aboutus_greenscape" model="website.menu">
            <field name="name">About</field>
            <field name="url">/aboutus</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">20</field>
        </record>
        <!-- Register the Services Page Route -->
        <record id="services_page_greenscape" model="website.page">
            <field name="name">Services</field>
            <field name="url">/services</field>
            <field name="view_id" ref="services_greenscape"/>
            <field name="is_published">True</field>
            <field name="track">True</field>
        </record>
        <!-- Add Services to Main Menu -->
        <record id="menu_services_greenscape" model="website.menu">
            <field name="name">Services</field>
            <field name="url">/services</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">30</field>
        </record>
        <!-- Register the Projects Page Route -->
        <record id="projects_page_greenscape" model="website.page">
            <field name="name">Projects</field>
            <field name="url">/projects</field>
            <field name="view_id" ref="projects_greenscape"/>
            <field name="is_published">True</field>
            <field name="track">True</field>
        </record>
        <!-- Add Projects to Main Menu -->
        <record id="menu_projects_greenscape" model="website.menu">
            <field name="name">Projects</field>
            <field name="url">/projects</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">40</field>
        </record>
    </data>
</odoo>
