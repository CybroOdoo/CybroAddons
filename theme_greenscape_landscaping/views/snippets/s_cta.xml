<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_greenscape_cta" name="Greenscape Call to Action">
        <section class="s_greenscape_cta greenscape-home cta-section">
            <div class="container">
                <div class="cta-content fade-up">
                    <span class="section-tag"
                          style="color:var(--secondary);background:rgba(139,195,74,0.12);border-color:rgba(139,195,74,0.2);">
                        Ready to Transform?
                    </span>
                    <h2>Let's Create Your Dream Outdoor Space</h2>
                    <p>Schedule your free consultation today and get a no-obligation estimate for your project.</p>
                    <div class="cta-actions">
                        <a href="/contactus" class="btn btn-accent">
                            <iconify-icon icon="tabler:leaf" width="18" height="18"/>
                            Get a Free Quote
                        </a>
                        <a href="tel:+15551234567" class="btn btn-outline-white">
                            <iconify-icon icon="tabler:phone" width="18" height="18"/>
                            (555) 123-4567
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>