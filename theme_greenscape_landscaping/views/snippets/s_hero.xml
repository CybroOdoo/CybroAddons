<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Hero section snippet for Greenscape theme -->
        <template id="s_greenscape_hero" name="Greenscape Hero">
            <section class="s_greenscape_hero greenscape-home hero" id="home">
                <div class="hero-bg"/>
                <div class="hero-overlay"/>-
                <div class="hero-glow-1"/>
                <div class="hero-glow-2"/>
                <div class="container">
                    <div class="hero-inner">
                    <div class="hero-content fade-in">
                        <h1>
                        Transforming<br />
                        Outdoor Spaces<br />
                        into <em>Living Art</em>
                        </h1>
                        <p class="hero-subtitle">
                        We design, build, and maintain breathtaking landscapes that turn your yard into a serene outdoor retreat — crafted with passion, precision, and purpose.
                        </p>
                        <div class="hero-actions">
                        <a href="/contactus" class="btn btn-primary"><iconify-icon icon="tabler:leaf" width="18" height="18"/> Get a Free Quote</a>
                        <a href="#services" class="btn btn-outline-white">View Services →</a>
                        </div>
                        <div class="hero-stats">
                        <div class="hero-stat"><span class="hero-stat-number">500+</span><span class="hero-stat-label">Projects Done</span></div>
                        <div class="hero-stat"><span class="hero-stat-number">20</span><span class="hero-stat-label">Years Exp.</span></div>
                        <div class="hero-stat"><span class="hero-stat-number">98%</span><span class="hero-stat-label">Satisfaction</span></div>
                        <div class="hero-stat"><span class="hero-stat-number">50+</span><span class="hero-stat-label">Experts</span></div>
                        </div>
                    </div>
                    </div>
                </div>
            </section>
        </template>
</odoo>
