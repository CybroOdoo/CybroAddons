<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_greenscape_about" name="Greenscape About Us">
        <section class="s_greenscape_about greenscape-home why-section" id="about">
            <div class="container">
                <div class="why-grid">
                    <div class="why-image-wrap fade-in">
                        <div class="why-image-main">
                            <img src="/theme_greenscape_landscaping/static/src/images/img2.png"
                                 alt="Lush landscaped garden created by GreenScape" loading="lazy"/>
                        </div>
                        <div class="why-img-float">
                            <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=400&amp;q=80"
                                 alt="Beautiful green lawn" loading="lazy"/>
                        </div>
                    </div>
                    <div class="why-content fade-up">
                        <span class="section-tag">Why Choose Us</span>
                        <h2 class="section-title">We Don't Just Grow Gardens —<br/>We Create Experiences
                        </h2>
                        <p class="section-desc">Since 2005, GreenScape has been the trusted landscaping partner for
                            hundreds of homeowners and businesses. Our skilled team combines horticultural expertise
                            with artistic vision to deliver outdoor spaces that exceed expectations.
                        </p>
                        <div class="why-features">
                            <div class="why-feature">
                                <div class="why-feature-icon">
                                    <iconify-icon icon="tabler:palette" width="24" height="24"/>
                                </div>
                                <div class="why-feature-text">
                                    <h4>Custom Design Process</h4>
                                    <p>Every project starts with a detailed consultation and 3D design plan tailored to
                                        your vision and budget.
                                    </p>
                                </div>
                            </div>
                            <div class="why-feature">
                                <div class="why-feature-icon">
                                    <iconify-icon icon="tabler:plant-2" width="24" height="24"/>
                                </div>
                                <div class="why-feature-text">
                                    <h4>Sustainable Materials</h4>
                                    <p>We source eco-friendly plants, native species, and sustainable hardscape
                                        materials for lasting beauty.
                                    </p>
                                </div>
                            </div>
                            <div class="why-feature">
                                <div class="why-feature-icon">
                                    <iconify-icon icon="tabler:star-filled" width="24" height="24"/>
                                </div>
                                <div class="why-feature-text">
                                    <h4>5-Star Workmanship</h4>
                                    <p>Our certified professionals deliver meticulous craftsmanship backed by a 2-year
                                        satisfaction guarantee.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div style="margin-top:36px; display:flex; gap:14px; flex-wrap:wrap;">
                            <a href="/about" class="btn btn-primary">Our Story</a>
                            <a href="/contactus" class="btn btn-secondary">Free Consultation</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>