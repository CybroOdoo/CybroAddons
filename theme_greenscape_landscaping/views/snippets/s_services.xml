<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Services snippet for Greenscape theme -->
        <template id="s_greenscape_services" name="Greenscape Services">
            <section class="s_greenscape_services greenscape-home" id="services">
                <div class="container">
                    <div class="section-header">
                    <span class="section-tag fade-up">Our Services</span>
                    <h2 class="section-title fade-up">Everything Your Outdoor Space Needs</h2>
                    <p class="section-desc fade-up">From routine lawn maintenance to complete landscape transformations, we cover every corner of your outdoor space.</p>
                    </div>
                    <div class="services-grid">
                    <div class="service-card fade-up">
                        <div class="service-card-img">
                        <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=700&amp;q=80" alt="Professional lawn mowing and edging" loading="lazy" />
                        <div class="service-card-icon"><iconify-icon icon="tabler:scissors" width="26" height="26"/></div>
                        </div>
                        <div class="service-card-body">
                        <h3>Lawn Care &amp; Maintenance</h3>
                        <p>Regular mowing, edging, fertilisation, and seasonal treatments to keep your lawn lush and healthy year-round.</p>
                        <a href="/services" class="service-link">Learn More →</a>
                        </div>
                    </div>
                    <div class="service-card fade-up">
                        <div class="service-card-img">
                        <img src="https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?w=700&amp;q=80" alt="Custom garden design and planting" loading="lazy" />
                        <div class="service-card-icon"><iconify-icon icon="tabler:flower" width="26" height="26"/></div>
                        </div>
                        <div class="service-card-body">
                        <h3>Garden Design</h3>
                        <p>Custom garden layouts with carefully selected plants, flowers, and focal points that reflect your personal style.</p>
                        <a href="/services" class="service-link">Learn More →</a>
                        </div>
                    </div>
                    <div class="service-card fade-up">
                        <div class="service-card-img">
                        <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&amp;q=80" alt="Patio and walkway hardscaping" loading="lazy" />
                        <div class="service-card-icon"><iconify-icon icon="tabler:wall" width="26" height="26"/></div>
                        </div>
                        <div class="service-card-body">
                        <h3>Hardscaping</h3>
                        <p>Stunning patios, walkways, retaining walls, and outdoor structures that extend your living space beautifully.</p>
                        <a href="/services" class="service-link">Learn More →</a>
                        </div>
                    </div>
                    <div class="service-card fade-up">
                        <div class="service-card-img">
                        <img src="https://images.unsplash.com/photo-1622383563227-04401ab4e5ea?w=700&amp;q=80" alt="Smart irrigation system installation" loading="lazy" />
                        <div class="service-card-icon"><iconify-icon icon="tabler:droplet" width="26" height="26"/></div>
                        </div>
                        <div class="service-card-body">
                        <h3>Irrigation Systems</h3>
                        <p>Smart, water-efficient irrigation systems designed for optimal plant health and up to 50% reduced water use.</p>
                        <a href="/services" class="service-link">Learn More →</a>
                        </div>
                    </div>
                    <div class="service-card fade-up" style="background:linear-gradient(145deg,var(--primary-dark),var(--primary)); border:none; display:flex; align-items:center; justify-content:center;">
                        <div class="service-card-body" style="text-align:center; padding:44px 32px;">
                        <div style="width:60px;height:60px;background:rgba(255,255,255,0.12);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;box-shadow:0 4px 20px rgba(0,0,0,0.2);color:white;">
                            <iconify-icon icon="tabler:plant-2" width="30" height="30"/>
                        </div>
                        <h3 style="color:var(--white);margin-bottom:12px;font-size:1.2rem;">View All Services</h3>
                        <p style="color:rgba(255,255,255,0.72);margin-bottom:24px;font-size:0.875rem;">Explore our complete range of outdoor solutions.</p>
                        <a href="/services" class="btn btn-white" style="width:100%;justify-content:center;">See All Services</a>
                        </div>
                    </div>
                    </div>
                </div>
            </section>
        </template>
</odoo>
