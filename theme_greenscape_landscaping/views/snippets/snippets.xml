<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Snippets registration for Greenscape theme -->
        <!-- ════════════ REGISTRATION IN WEBSITE SNIPPETS ════════════ -->
        <template id="greenscape_snippets" inherit_id="website.snippets" name="Greenscape Snippets">
            <xpath expr="//snippets[@id='snippet_groups']" position="inside">
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_hero" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_hero.png"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_trust" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_trust.png"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_about" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_about.png"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_services" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_services.png"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_process" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_process.png"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_testimonials" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_testimonials.png"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_cta" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_cta.png"/>
            </xpath>
        </template>
</odoo>
