<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════ REGISTRATION IN WEBSITE SNIPPETS ════════════ -->
    <template id="greenscape_snippets" inherit_id="website.snippets" name="Greenscape Snippets">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_greenscape_landscaping.s_greenscape_hero" string="Hero"
               t-thumbnail="/theme_greenscape_landscaping/static/src/images/snippets/hero.png"/>
            <t t-snippet="theme_greenscape_landscaping.s_greenscape_trust" string="Trust"
               t-thumbnail="/theme_greenscape_landscaping/static/src/images/snippets/trust.png"/>
            <t t-snippet="theme_greenscape_landscaping.s_greenscape_about" string="About"
               t-thumbnail="/theme_greenscape_landscaping/static/src/images/snippets/about.png"/>
            <t t-snippet="theme_greenscape_landscaping.s_greenscape_services" string="Services"
               t-thumbnail="/theme_greenscape_landscaping/static/src/images/snippets/services.png"/>
            <t t-snippet="theme_greenscape_landscaping.s_greenscape_process" string="Process"
               t-thumbnail="/theme_greenscape_landscaping/static/src/images/snippets/process.png"/>
            <t t-snippet="theme_greenscape_landscaping.s_greenscape_testimonials" string="Testimonials"
               t-thumbnail="/theme_greenscape_landscaping/static/src/images/snippets/testimonials.png"/>
            <t t-snippet="theme_greenscape_landscaping.s_greenscape_cta" string="Call to Action"
               t-thumbnail="/theme_greenscape_landscaping/static/src/images/snippets/cta.png"/>
        </xpath>
    </template>
</odoo>