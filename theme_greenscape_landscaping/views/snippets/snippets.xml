<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ════════════ REGISTRATION IN WEBSITE SNIPPETS ════════════ -->
        <template id="greenscape_snippets" inherit_id="website.snippets" name="Greenscape Snippets">
            <xpath expr="//snippets[@id='snippet_groups']" position="inside">
                <t snippet-group="greenscape_hero" t-snippet="theme_greenscape_landscaping.s_greenscape_hero" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_hero.png"/>
                <t snippet-group="greenscape_trust" t-snippet="theme_greenscape_landscaping.s_greenscape_trust" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_trust.png"/>
                <t snippet-group="greenscape_about" t-snippet="theme_greenscape_landscaping.s_greenscape_about" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_about.png"/>
                <t snippet-group="greenscape_services" t-snippet="theme_greenscape_landscaping.s_greenscape_services" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_services.png"/>
                <t snippet-group="greenscape_process" t-snippet="theme_greenscape_landscaping.s_greenscape_process" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_process.png"/>
                <t snippet-group="greenscape_testimonials" t-snippet="theme_greenscape_landscaping.s_greenscape_testimonials" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_testimonials.png"/>
                <t snippet-group="greenscape_cta" t-snippet="theme_greenscape_landscaping.s_greenscape_cta" t-thumbnail="/theme_greenscape_landscaping/static/src/img/snippets/s_cta.png"/>
            </xpath>
            <xpath expr="//snippets[@id='snippet_structure']" position="inside">
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_hero" string="Hero" group="greenscape_hero"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_trust" string="Trust" group="greenscape_trust"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_about" string="About" group="greenscape_about"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_services" string="About" group="greenscape_services"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_process" string="About" group="greenscape_process"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_testimonials" string="About" group="greenscape_testimonials"/>
                <t t-snippet="theme_greenscape_landscaping.s_greenscape_cta" string="About" group="greenscape_cta"/>
            </xpath>
        </template>
    </data>
</odoo>
