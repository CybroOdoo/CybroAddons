<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for displaying the landscaping projects portfolio page -->
    <template id="projects_greenscape" name="Greenscape Projects">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty greenscape-home">
                <!-- ========== PAGE HERO ========== -->
                <div class="page-hero">
                    <div class="container">
                        <div class="page-hero-content">
                            <div class="breadcrumb">
                                <a href="/">Home</a>
                                <span class="sep">/</span>
                                <span>Projects</span>
                            </div>
                            <h1>Our Project Portfolio</h1>
                            <p>Explore our gallery of completed landscapes — each one a unique story of transformation,
                                craftsmanship, and outdoor living elevated.
                            </p>
                        </div>
                    </div>
                </div>
                <!-- ========== PORTFOLIO GALLERY ========== -->
                <section>
                    <div class="container">
                        <div class="filter-bar">
                            <button class="filter-btn active" data-filter="all">All Projects</button>
                            <button class="filter-btn" data-filter="residential">Residential</button>
                            <button class="filter-btn" data-filter="commercial">Commercial</button>
                            <button class="filter-btn" data-filter="garden">Garden Design</button>
                            <button class="filter-btn" data-filter="hardscaping">Hardscaping</button>
                            <button class="filter-btn" data-filter="lawn">Lawn Care</button>
                        </div>
                        <div class="portfolio-grid">
                            <t t-foreach="projects" t-as="proj">
                                <div class="portfolio-item" t-att-data-category="proj.category">
                                    <div class="portfolio-img">
                                        <!-- Load image directly from the model -->
                                        <img t-attf-src="/web/image/greenscape.project/#{proj.id}/image"
                                             t-att-alt="proj.name" loading="lazy"/>
                                    </div>
                                    <span class="portfolio-tag"
                                          t-out="dict(proj._fields['category'].selection).get(proj.category)"/>
                                    <div class="portfolio-overlay">
                                        <h4 t-out="proj.name"/>
                                        <p>
                                            <t t-out="proj.location"/>
                                            —
                                            <t t-out="proj.year"/>
                                        </p>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
                <!-- ========== CTA ========== -->
                <section class="cta-section">
                    <div class="container">
                        <div class="cta-content fade-up">
                            <span class="section-tag" style="color:var(--secondary); background:rgba(139,195,74,0.15);">
                                Start Your Project
                            </span>
                            <h2>Ready to Create Your Own Success Story?</h2>
                            <p>Let's discuss your project goals and design the outdoor space you've always envisioned.
                            </p>
                            <div class="cta-actions">
                                <a href="/contactus" class="btn btn-accent">Get a Free Quote</a>
                                <a href="/services" class="btn btn-outline-white">Explore Services</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
