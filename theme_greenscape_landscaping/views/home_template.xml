<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage_greenscape" inherit_id="website.homepage" name="Greenscape Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty o_editable greenscape-home">

                <!-- ════════════ HERO ════════════ -->
                <header class="hero" id="home">
                    <div class="hero-bg"/>
                    <div class="hero-overlay"/>
                    <div class="hero-glow-1"/>
                    <div class="hero-glow-2"/>
                    <div class="container">
                        <div class="hero-inner">
                            <div class="hero-content fade-in">
                                <h1>
                                    Transforming
                                    <br/>
                                    Outdoor Spaces
                                    <br/>
                                    into
                                    <em>Living Art</em>
                                </h1>
                                <p class="hero-subtitle">
                                    We design, build, and maintain breathtaking landscapes that turn your yard into a
                                    serene outdoor retreat — crafted with passion, precision, and purpose.
                                </p>
                                <div class="hero-actions">
                                    <a href="/contactus" class="btn btn-primary">
                                        <iconify-icon icon="tabler:leaf" width="18" height="18"/>
                                        Get a Free Quote
                                    </a>
                                    <a href="/services" class="btn btn-outline-white">View Services →</a>
                                </div>
                                <div class="hero-stats">
                                    <div class="hero-stat">
                                        <span class="hero-stat-number">500+</span>
                                        <span class="hero-stat-label">Projects Done</span>
                                    </div>
                                    <div class="hero-stat">
                                        <span class="hero-stat-number">20</span>
                                        <span class="hero-stat-label">Years Exp.</span>
                                    </div>
                                    <div class="hero-stat">
                                        <span class="hero-stat-number">98%</span>
                                        <span class="hero-stat-label">Satisfaction</span>
                                    </div>
                                    <div class="hero-stat">
                                        <span class="hero-stat-number">50+</span>
                                        <span class="hero-stat-label">Experts</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- ════════════ TRUST STRIP ════════════ -->
                <div class="about-strip">
                    <div class="container">
                        <div class="about-strip-inner">
                            <div class="strip-item">
                                <div class="strip-icon">
                                    <iconify-icon icon="tabler:award" width="28" height="28"/>
                                </div>
                                <div>
                                    <strong>Award-Winning Design</strong>
                                    <span>NALP Certified Professionals</span>
                                </div>
                            </div>
                            <div class="strip-item">
                                <div class="strip-icon">
                                    <iconify-icon icon="tabler:leaf" width="28" height="28"/>
                                </div>
                                <div>
                                    <strong>Eco-Friendly Practices</strong>
                                    <span>Sustainable &amp; organic methods</span>
                                </div>
                            </div>
                            <div class="strip-item">
                                <div class="strip-icon">
                                    <iconify-icon icon="tabler:shield-check" width="28" height="28"/>
                                </div>
                                <div>
                                    <strong>Fully Licensed &amp; Insured</strong>
                                    <span>Peace of mind guaranteed</span>
                                </div>
                            </div>
                            <div class="strip-item">
                                <div class="strip-icon">
                                    <iconify-icon icon="tabler:phone" width="28" height="28"/>
                                </div>
                                <div>
                                    <strong>Free Consultations</strong>
                                    <span>No obligation estimates</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ════════════ WHY CHOOSE US ════════════ -->
                <section class="why-section" id="about">
                    <div class="container">
                        <div class="why-grid">
                            <div class="why-image-wrap fade-in">
                                <div class="why-image-main">
                                    <img
                                            src="/theme_greenscape_landscaping/static/src/images/img2.png"
                                            alt="Lush landscaped garden created by GreenScape"
                                            loading="lazy"
                                    />
                                </div>
                                <div class="why-img-float">
                                    <img
                                            src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=400&amp;q=80"
                                            alt="Beautiful green lawn"
                                            loading="lazy"
                                    />
                                </div>
                            </div>
                            <div class="why-content fade-up">
                                <span class="section-tag">Why Choose Us</span>
                                <h2 class="section-title">
                                    We Don't Just Grow Gardens —<br/>We Create Experiences
                                </h2>
                                <p class="section-desc">
                                    Since 2005, GreenScape has been the trusted landscaping partner for hundreds of
                                    homeowners and businesses. Our skilled team combines horticultural expertise with
                                    artistic vision to deliver outdoor spaces that exceed expectations.
                                </p>
                                <div class="why-features">
                                    <div class="why-feature">
                                        <div class="why-feature-icon">
                                            <iconify-icon icon="tabler:palette" width="24" height="24"/>
                                        </div>
                                        <div class="why-feature-text">
                                            <h4>Custom Design Process</h4>
                                            <p>Every project starts with a detailed consultation and 3D design plan
                                                tailored to your vision and budget.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="why-feature">
                                        <div class="why-feature-icon">
                                            <iconify-icon icon="tabler:plant-2" width="24" height="24"/>
                                        </div>
                                        <div class="why-feature-text">
                                            <h4>Sustainable Materials</h4>
                                            <p>We source eco-friendly plants, native species, and sustainable hardscape
                                                materials for lasting beauty.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="why-feature">
                                        <div class="why-feature-icon">
                                            <iconify-icon icon="tabler:star-filled" width="24"
                                                          height="24"/>
                                        </div>
                                        <div class="why-feature-text">
                                            <h4>5-Star Workmanship</h4>
                                            <p>Our certified professionals deliver meticulous craftsmanship backed by a
                                                2-year satisfaction guarantee.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div style="margin-top:36px; display:flex; gap:14px; flex-wrap:wrap;">
                                    <a href="/aboutus" class="btn btn-primary">Our Story</a>
                                    <a href="/contactus" class="btn btn-secondary">Free Consultation</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ════════════ SERVICES ════════════ -->
                <section id="services">
                    <div class="container">
                        <div class="section-header">
                            <span class="section-tag fade-up">Our Services</span>
                            <h2 class="section-title fade-up">Everything Your Outdoor Space Needs</h2>
                            <p class="section-desc fade-up">From routine lawn maintenance to complete landscape
                                transformations, we cover every corner of your outdoor space.
                            </p>
                        </div>
                        <div class="services-grid">
                            <div class="service-card fade-up">
                                <div class="service-card-img">
                                    <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=700&amp;q=80"
                                         alt="Professional lawn mowing and edging" loading="lazy"/>
                                    <div class="service-card-icon">
                                        <iconify-icon icon="tabler:scissors" width="26" height="26"/>
                                    </div>
                                </div>
                                <div class="service-card-body">
                                    <h3>Lawn Care &amp; Maintenance</h3>
                                    <p>Regular mowing, edging, fertilisation, and seasonal treatments to keep your lawn
                                        lush and healthy year-round.
                                    </p>
                                    <a href="/services" class="service-link">Learn More →</a>
                                </div>
                            </div>
                            <div class="service-card fade-up">
                                <div class="service-card-img">
                                    <img src="https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?w=700&amp;q=80"
                                         alt="Custom garden design and planting" loading="lazy"/>
                                    <div class="service-card-icon">
                                        <iconify-icon icon="tabler:flower" width="26" height="26"/>
                                    </div>
                                </div>
                                <div class="service-card-body">
                                    <h3>Garden Design</h3>
                                    <p>Custom garden layouts with carefully selected plants, flowers, and focal points
                                        that reflect your personal style.
                                    </p>
                                    <a href="/services" class="service-link">Learn More →</a>
                                </div>
                            </div>
                            <div class="service-card fade-up">
                                <div class="service-card-img">
                                    <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&amp;q=80"
                                         alt="Patio and walkway hardscaping" loading="lazy"/>
                                    <div class="service-card-icon">
                                        <iconify-icon icon="tabler:wall" width="26" height="26"/>
                                    </div>
                                </div>
                                <div class="service-card-body">
                                    <h3>Hardscaping</h3>
                                    <p>Stunning patios, walkways, retaining walls, and outdoor structures that extend
                                        your living space beautifully.
                                    </p>
                                    <a href="/services" class="service-link">Learn More →</a>
                                </div>
                            </div>
                            <div class="service-card fade-up">
                                <div class="service-card-img">
                                    <img src="https://images.unsplash.com/photo-1622383563227-04401ab4e5ea?w=700&amp;q=80"
                                         alt="Smart irrigation system installation" loading="lazy"/>
                                    <div class="service-card-icon">
                                        <iconify-icon icon="tabler:droplet" width="26" height="26"/>
                                    </div>
                                </div>
                                <div class="service-card-body">
                                    <h3>Irrigation Systems</h3>
                                    <p>Smart, water-efficient irrigation systems designed for optimal plant health and
                                        up to 50% reduced water use.
                                    </p>
                                    <a href="/services" class="service-link">Learn More →</a>
                                </div>
                            </div>
                            <div class="service-card fade-up"
                                 style="background:linear-gradient(145deg,var(--primary-dark),var(--primary)); border:none; display:flex; align-items:center; justify-content:center;">
                                <div class="service-card-body" style="text-align:center; padding:44px 32px;">
                                    <div style="width:60px;height:60px;background:rgba(255,255,255,0.12);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;box-shadow:0 4px 20px rgba(0,0,0,0.2);color:white;">
                                        <iconify-icon icon="tabler:plant-2" width="30" height="30"/>
                                    </div>
                                    <h3 style="color:var(--white);margin-bottom:12px;font-size:1.2rem;">View All
                                        Services
                                    </h3>
                                    <p style="color:rgba(255,255,255,0.72);margin-bottom:24px;font-size:0.875rem;">
                                        Explore our complete range of outdoor solutions.
                                    </p>
                                    <a href="/services" class="btn btn-white"
                                       style="width:100%;justify-content:center;">See All Services
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ════════════ TESTIMONIALS ════════════ -->
                <section class="testimonials-section">
                    <div class="container">
                        <div class="section-header">
                            <span class="section-tag">Client Reviews</span>
                            <h2 class="section-title">What Our Clients Say</h2>
                            <p class="section-desc">Hear from the homeowners and businesses who trust GreenScape with
                                their outdoor spaces.
                            </p>
                        </div>
                        <div class="testimonials-grid">
                            <div class="testimonial-card fade-up">
                                <div class="testimonial-stars">★★★★★</div>
                                <p class="testimonial-text">
                                    "GreenScape completely transformed our backyard into a stunning oasis. The team was
                                    professional, punctual, and the attention to detail was phenomenal. Our neighbours
                                    constantly compliment the garden!"
                                </p>
                                <div class="testimonial-author">
                                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=120&amp;q=80"
                                         alt="Sarah Mitchell" class="author-avatar" loading="lazy"/>
                                    <div class="author-info">
                                        <strong>Sarah Mitchell</strong>
                                        <span>Homeowner, Pasadena CA</span>
                                    </div>
                                </div>
                            </div>
                            <div class="testimonial-card fade-up">
                                <div class="testimonial-stars">★★★★★</div>
                                <p class="testimonial-text">
                                    "We hired GreenScape for our commercial property and the results were outstanding.
                                    Our curb appeal has never been better. The maintenance team keeps everything
                                    immaculate every single week."
                                </p>
                                <div class="testimonial-author">
                                    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=120&amp;q=80"
                                         alt="David Rodriguez" class="author-avatar" loading="lazy"/>
                                    <div class="author-info">
                                        <strong>David Rodriguez</strong>
                                        <span>Business Owner, Los Angeles CA</span>
                                    </div>
                                </div>
                            </div>
                            <div class="testimonial-card fade-up">
                                <div class="testimonial-stars">★★★★★</div>
                                <p class="testimonial-text">
                                    "The patio and stone walkways they built exceeded every expectation. Worth every
                                    penny. They truly are artists with stone and plants — our backyard is now the envy
                                    of the block!"
                                </p>
                                <div class="testimonial-author">
                                    <img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=120&amp;q=80"
                                         alt="Jennifer Kim" class="author-avatar" loading="lazy"/>
                                    <div class="author-info">
                                        <strong>Jennifer Kim</strong>
                                        <span>Homeowner, Riverside CA</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ════════════ PROCESS ════════════ -->
                <section>
                    <div class="container">
                        <div class="section-header">
                            <span class="section-tag fade-up">How It Works</span>
                            <h2 class="section-title fade-up">Our Simple 4-Step Process</h2>
                            <p class="section-desc fade-up">From your first call to the final reveal — a seamless
                                experience from start to finish.
                            </p>
                        </div>
                        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:24px;" class="process-grid">
                            <div class="fade-up" style="text-align:center; padding:0 8px;">
                                <div style="width:70px;height:70px;background:var(--primary-xlight);border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;box-shadow:var(--shadow-green-sm);border:1px solid rgba(45,122,79,0.12);color:var(--primary);">
                                    <iconify-icon icon="tabler:clipboard-list" width="32" height="32"/>
                                </div>
                                <div style="font-family:var(--font-heading);font-size:0.72rem;font-weight:800;color:var(--primary);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:10px;">
                                    Step 01
                                </div>
                                <h4 style="margin-bottom:10px;">Free Consultation</h4>
                                <p style="font-size:0.875rem;">We visit your property, listen to your goals, and assess
                                    the space at no charge.
                                </p>
                            </div>
                            <div class="fade-up" style="text-align:center; padding:0 8px;">
                                <div style="width:70px;height:70px;background:var(--primary-xlight);border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;box-shadow:var(--shadow-green-sm);border:1px solid rgba(45,122,79,0.12);color:var(--primary);">
                                    <iconify-icon icon="tabler:palette" width="32" height="32"/>
                                </div>
                                <div style="font-family:var(--font-heading);font-size:0.72rem;font-weight:800;color:var(--primary);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:10px;">
                                    Step 02
                                </div>
                                <h4 style="margin-bottom:10px;">Custom Design</h4>
                                <p style="font-size:0.875rem;">Our designers create a tailored plan with plant
                                    selections, layout, and a detailed estimate.
                                </p>
                            </div>
                            <div class="fade-up" style="text-align:center; padding:0 8px;">
                                <div style="width:70px;height:70px;background:var(--primary-xlight);border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;box-shadow:var(--shadow-green-sm);border:1px solid rgba(45,122,79,0.12);color:var(--primary);">
                                    <iconify-icon icon="tabler:hammer" width="32" height="32"/>
                                </div>
                                <div style="font-family:var(--font-heading);font-size:0.72rem;font-weight:800;color:var(--primary);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:10px;">
                                    Step 03
                                </div>
                                <h4 style="margin-bottom:10px;">Expert Installation</h4>
                                <p style="font-size:0.875rem;">Our certified crew brings the design to life with premium
                                    materials and craftsmanship.
                                </p>
                            </div>
                            <div class="fade-up" style="text-align:center; padding:0 8px;">
                                <div style="width:70px;height:70px;background:linear-gradient(135deg,var(--primary),var(--primary-light));border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;box-shadow:var(--shadow-green-md);color:white;">
                                    <iconify-icon icon="tabler:sparkles" width="32" height="32"/>
                                </div>
                                <div style="font-family:var(--font-heading);font-size:0.72rem;font-weight:800;color:var(--primary);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:10px;">
                                    Step 04
                                </div>
                                <h4 style="margin-bottom:10px;">Final Walkthrough</h4>
                                <p style="font-size:0.875rem;">We walk you through every detail, answer questions, and
                                    hand over care instructions.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ════════════ CTA ════════════ -->
                <section class="cta-section">
                    <div class="container">
                        <div class="cta-content fade-up">
                            <span class="section-tag"
                                  style="color:var(--secondary);background:rgba(139,195,74,0.12);border-color:rgba(139,195,74,0.2);">
                                Ready to Transform?
                            </span>
                            <h2>Let's Create Your Dream Outdoor Space</h2>
                            <p>Schedule your free consultation today and get a no-obligation estimate for your
                                project.
                            </p>
                            <div class="cta-actions">
                                <a href="/contactus" class="btn btn-accent">
                                    <iconify-icon icon="tabler:leaf" width="18" height="18"/>
                                    Get a Free Quote
                                </a>
                                <a href="tel:+15551234567" class="btn btn-outline-white">
                                    <iconify-icon icon="tabler:phone" width="18" height="18"/>
                                    (555) 123-4567
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>