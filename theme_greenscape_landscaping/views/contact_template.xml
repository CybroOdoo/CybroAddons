<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for displaying the landscaping projects contact page -->
    <template id="contactus_greenscape" inherit_id="website.contactus" name="Greenscape Contact Us">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty o_editable greenscape-contact">
                <!-- ========== PAGE HERO ========== -->
                <div class="page-hero">
                    <div class="container">
                        <div class="page-hero-content">
                            <div class="breadcrumb">
                                <a href="/">Home</a>
                                <span class="sep">/</span>
                                <span>Contact</span>
                            </div>
                            <h1>Get in Touch</h1>
                            <p>Ready to transform your outdoor space? We'd love to hear from you. Request a free
                                consultation or estimate today.
                            </p>
                        </div>
                    </div>
                </div>
                <!-- ========== CONTACT SECTION ========== -->
                <section>
                    <div class="container">
                        <div class="contact-grid">
                            <div class="contact-info-box fade-up">
                                <h3>Contact Information</h3>
                                <p>We're available Monday through Saturday to answer your questions and schedule site
                                    visits.
                                </p>
                                <div class="contact-detail">
                                    <div class="contact-detail-icon">
                                        <iconify-icon icon="tabler:map-pin" width="22" height="22"/>
                                    </div>
                                    <div class="contact-detail-content">
                                        <strong>Our Office</strong>
                                        <span>4821 Garden Way, Suite 100<br/>Los Angeles, CA 90028
                                        </span>
                                    </div>
                                </div>
                                <div class="contact-detail">
                                    <div class="contact-detail-icon">
                                        <iconify-icon icon="tabler:phone" width="22" height="22"/>
                                    </div>
                                    <div class="contact-detail-content">
                                        <strong>Phone Number</strong>
                                        <span>
                                            <a href="tel:+15551234567" style="color:inherit;">(555) 123-4567</a>
                                        </span>
                                    </div>
                                </div>
                                <div class="contact-detail">
                                    <div class="contact-detail-icon">
                                        <iconify-icon icon="tabler:mail" width="22" height="22"/>
                                    </div>
                                    <div class="contact-detail-content">
                                        <strong>Email Address</strong>
                                        <span>
                                            <a href="mailto:hello@greenscapela.com" style="color:inherit;">
                                                hello@greenscapela.com
                                            </a>
                                        </span>
                                    </div>
                                </div>
                                <div class="contact-detail">
                                    <div class="contact-detail-icon">
                                        <iconify-icon icon="tabler:world" width="22" height="22"/>
                                    </div>
                                    <div class="contact-detail-content">
                                        <strong>Service Area</strong>
                                        <span>Los Angeles, Pasadena, Glendale,<br/>Burbank, Santa Monica &amp;
                                            surrounding areas
                                        </span>
                                    </div>
                                </div>
                                <div class="hours-list">
                                    <h4>Business Hours</h4>
                                    <div class="hours-item">
                                        <span class="day">Monday – Friday</span>
                                        <span>7:00 AM – 6:00 PM</span>
                                    </div>
                                    <div class="hours-item">
                                        <span class="day">Saturday</span>
                                        <span>8:00 AM – 4:00 PM</span>
                                    </div>
                                    <div class="hours-item">
                                        <span class="day">Sunday</span>
                                        <span>By Appointment Only</span>
                                    </div>
                                </div>
                                <div style="margin-top:28px;">
                                    <p style="color:rgba(255,255,255,0.65); font-size:0.85rem; margin-bottom:14px;">
                                        Follow us for inspiration and project updates:
                                    </p>
                                    <div style="display:flex; gap:10px;">
                                        <a href="#"
                                           style="width:38px; height:38px; background:rgba(255,255,255,0.1); border-radius:8px; display:flex; align-items:center; justify-content:center; color:white;"
                                           aria-label="Facebook">
                                            <iconify-icon icon="tabler:brand-facebook" width="18"
                                                          height="18"/>
                                        </a>
                                        <a href="#"
                                           style="width:38px; height:38px; background:rgba(255,255,255,0.1); border-radius:8px; display:flex; align-items:center; justify-content:center; color:white;"
                                           aria-label="Instagram">
                                            <iconify-icon icon="tabler:brand-instagram" width="18"
                                                          height="18"/>
                                        </a>
                                        <a href="#"
                                           style="width:38px; height:38px; background:rgba(255,255,255,0.1); border-radius:8px; display:flex; align-items:center; justify-content:center; color:white;"
                                           aria-label="Pinterest">
                                            <iconify-icon icon="tabler:brand-pinterest" width="18"
                                                          height="18"/>
                                        </a>
                                        <a href="#"
                                           style="width:38px; height:38px; background:rgba(255,255,255,0.1); border-radius:8px; display:flex; align-items:center; justify-content:center; color:white;"
                                           aria-label="YouTube">
                                            <iconify-icon icon="tabler:brand-youtube" width="18"
                                                          height="18"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="contact-form-wrap fade-up">
                                <h3>Send Us a Message</h3>
                                <p>Fill out the form below and our team will get back to you within one business day.
                                </p>
                                <form action="/website/form/" method="post" enctype="multipart/form-data"
                                      class="s_website_form" data-model_name="crm.lead"
                                      data-success-mode="redirect"
                                      data-success-page="/contactus-thank-you">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="s_website_form_field d-none">
                                        <input type="hidden" name="name" class="s_website_form_input" value="Greenscape Website Inquiry"/>
                                    </div>
                                    <div class="s_website_form_rows">
                                    <div class="form-row">
                                        <div class="form-group s_website_form_field s_website_form_required" data-type="char">
                                            <label class="col-form-label" for="firstName">First Name *</label>
                                            <input type="text" id="firstName" name="contact_name" placeholder="John"
                                                   required="" autocomplete="given-name"
                                                   class="s_website_form_input form-control"/>
                                        </div>
                                        <div class="form-group s_website_form_field s_website_form_required" data-type="char">
                                            <label class="col-form-label" for="lastName">Last Name *</label>
                                            <input type="text" id="lastName" name="Custom_Last_Name" placeholder="Smith"
                                                   required="" autocomplete="family-name"
                                                   class="s_website_form_input form-control"/>
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group s_website_form_field s_website_form_required" data-type="email">
                                            <label class="col-form-label" for="email">Email Address *</label>
                                            <input type="email" id="email" name="email_from"
                                                   placeholder="john@example.com" required="" autocomplete="email"
                                                   class="s_website_form_input form-control"/>
                                        </div>
                                        <div class="form-group s_website_form_field s_website_form_required" data-type="tel">
                                            <label class="col-form-label" for="phone">Phone Number *</label>
                                            <input type="tel" id="phone" name="phone" placeholder="(555) 000-0000"
                                                   required="" autocomplete="tel" class="s_website_form_input form-control"/>
                                        </div>
                                    </div>
                                    <div class="form-group s_website_form_field s_website_form_custom" data-type="char">
                                        <label class="col-form-label" for="service">Service Interested In</label>
                                        <select id="service" name="Custom_Service"
                                                class="s_website_form_input form-control">
                                            <option value="" disabled="1" selected="1">Select a service...</option>
                                            <option value="Lawn Care &amp; Maintenance">Lawn Care &amp; Maintenance
                                            </option>
                                            <option value="Garden Design &amp; Installation">Garden Design &amp;
                                                Installation
                                            </option>
                                            <option value="Hardscaping (Patio, Walkways, Walls)">Hardscaping (Patio,
                                                Walkways, Walls)
                                            </option>
                                            <option value="Irrigation Systems">Irrigation Systems</option>
                                            <option value="Tree &amp; Shrub Care">Tree &amp; Shrub Care</option>
                                            <option value="Full Landscape Transformation">Full Landscape
                                                Transformation
                                            </option>
                                            <option value="Other">Other / Not Sure Yet</option>
                                        </select>
                                    </div>
                                    <div class="form-group s_website_form_field s_website_form_custom" data-type="char">
                                        <label class="col-form-label" for="propertyType">Property Type</label>
                                        <select id="propertyType" name="Custom_PropertyType"
                                                class="s_website_form_input form-control">
                                            <option value="" disabled="1" selected="1">Select property type...</option>
                                            <option value="Residential">Residential</option>
                                            <option value="Commercial">Commercial</option>
                                            <option value="HOA / Community">HOA / Community</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                    <div class="form-group s_website_form_field s_website_form_custom" data-type="char">
                                        <label class="col-form-label" for="budget">Approximate Budget</label>
                                        <select id="budget" name="Custom_Budget"
                                                class="s_website_form_input form-control">
                                            <option value="" disabled="1" selected="1">Select a range...</option>
                                            <option value="Under $1,000">Under $1,000</option>
                                            <option value="$1,000 – $5,000">$1,000 – $5,000</option>
                                            <option value="$5,000 – $15,000">$5,000 – $15,000</option>
                                            <option value="$15,000 – $50,000">$15,000 – $50,000</option>
                                            <option value="$50,000+">$50,000+</option>
                                            <option value="Not sure yet">Not sure yet</option>
                                        </select>
                                    </div>
                                    <div class="form-group s_website_form_field s_website_form_required" data-type="text">
                                        <label class="col-form-label" for="message">Tell Us About Your Project *</label>
                                        <textarea id="message" name="description"
                                                  placeholder="Describe your project, property size, specific goals or challenges, and anything else we should know..."
                                                  required="" class="s_website_form_input form-control"/>
                                    </div>
                                    <div class="form-group s_website_form_field"
                                         style="display:flex; align-items:flex-start; gap:10px; margin-bottom:24px;">
                                        <input type="checkbox" id="consent" name="Custom_Consent"
                                               style="width:auto; margin-top:3px; flex-shrink:0;" required=""
                                               class="s_website_form_input form-check-input"/>
                                        <label class="col-form-label" for="consent"
                                               style="font-size:0.8rem; color:var(--text-light); font-weight:400; cursor:pointer;">
                                            I agree to be contacted by GreenScape Landscaping regarding my inquiry. View
                                            our <a href="#" style="color:var(--primary);">Privacy Policy</a>.
                                        </label>
                                    </div>
                                    <div class="s_website_form_submit" style="text-align:center;">
                                        <span id="s_website_form_result"/>
                                        <a href="#" role="button" class="btn btn-primary s_website_form_send"
                                           style="width:100%; justify-content:center; font-size:1rem; padding:16px; display:inline-flex; align-items:center; gap:8px;">
                                            <iconify-icon icon="tabler:leaf" width="18" height="18"/>
                                            Send Message &amp; Request Quote
                                        </a>
                                    </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ========== MAP SECTION ========== -->
                <div class="map-section">
                    <div class="container">
                        <div class="section-header" style="margin-bottom:40px;">
                            <span class="section-tag fade-up">Find Us</span>
                            <h2 class="section-title fade-up">Visit Our Office</h2>
                            <p class="section-desc fade-up">Located in the heart of Los Angeles, CA. We serve all of the
                                greater LA area.
                            </p>
                        </div>
                        <div class="map-container fade-up">
                            <iframe
                                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d423286.27405050475!2d-118.69191576908744!3d34.02016130390405!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c2c75ddc27da13%3A0xe22fef1de0f46349!2sLos%20Angeles%2C%20CA%2C%20USA!5e0!3m2!1sen!2s!4v1690000000000!5m2!1sen!2s"
                                    allowfullscreen="1"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    title="GreenScape Landscaping Office Location - Los Angeles, CA"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
