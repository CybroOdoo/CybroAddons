<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_greenscape_project_form" model="ir.ui.view">
        <field name="name">greenscape.project.form</field>
        <field name="model">greenscape.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="location" placeholder="e.g., Bel Air, CA"/>
                            <field name="year" placeholder="e.g., 2024"/>
                        </group>
                        <group>
                            <field name="is_published" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_greenscape_project_tree" model="ir.ui.view">
        <field name="name">greenscape.project.tree</field>
        <field name="model">greenscape.project</field>
        <field name="arch" type="xml">
            <tree string="Projects">
                <field name="name"/>
                <field name="category"/>
                <field name="location"/>
                <field name="year"/>
                <field name="is_published" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_greenscape_project_search" model="ir.ui.view">
        <field name="name">greenscape.project.search</field>
        <field name="model">greenscape.project</field>
        <field name="arch" type="xml">
            <search string="Projects">
                <field name="name"/>
                <field name="category"/>
                <field name="location"/>
                <filter string="Published" name="published" domain="[('is_published', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_greenscape_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">greenscape.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_greenscape_project_search"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_greenscape_project"
              name="Greenscape Projects"
              parent="website.menu_website_global_configuration"
              action="action_greenscape_project"
              sequence="100"/>
</odoo>