<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override Global Website Layout -->
    <template id="greenscape_layout" inherit_id="website.layout" name="Greenscape Layout">
        <!-- Inject Iconify Script -->
        <xpath expr="//head" position="inside">
            <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"/>
        </xpath>
        <!-- Replace Header -->
        <xpath expr="//header" position="replace">
            <header id="top" data-anchor="true" data-name="Header" class="greenscape-home o_header_standard">
                <nav class="navbar" aria-label="Main navigation">
                    <div class="container">
                        <div class="navbar-inner">
                            <a href="/" class="logo">
                                <div class="logo-mark">
                                    <img src="/theme_greenscape_landscaping/static/src/images/logo_greenscape.png" alt="GreenScape Landscaping"
                                         style="max-height: 70px;"/>
                                </div>
                            </a>
                            <ul class="nav-links" role="list" id="top_menu">
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <!-- Odoo handles the active state natively using JS or we can check URL -->
                                    <li>
                                        <a t-att-href="submenu.url" t-out="submenu.name"
                                           t-attf-class="#{request.httprequest.path == submenu.url and 'active' or ''}"/>
                                    </li>
                                </t>
                                <li>
                                    <a href="/contactus" class="nav-cta">Get a Quote</a>
                                </li>
                            </ul>
                            <button class="hamburger" aria-label="Toggle menu" aria-expanded="false">
                                <span/>
                                <span/>
                                <span/>
                            </button>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>
        <!-- Replace Footer -->
        <xpath expr="//footer[@id='bottom']" position="replace">
            <footer id="bottom" data-anchor="true" data-name="Footer" class="greenscape-home o_colored_level o_cc">
                <div class="footer">
                    <div class="container">
                        <div class="footer-grid">
                            <div class="footer-brand">
                                <a href="/" class="logo">
                                    <div class="logo-mark">
                                        <img src="/theme_greenscape_landscaping/static/src/images/logo_greenscape.png" alt="GreenScape Landscaping"
                                             style="max-height: 40px; filter: brightness(0) invert(1);"/>
                                    </div>
                                </a>
                                <p class="footer-desc">Transforming outdoor spaces into living art since 2005.</p>
                                <div class="social-links">
                                    <a href="#" class="social-link" aria-label="Facebook">
                                        <iconify-icon icon="tabler:brand-facebook" width="18"
                                                      height="18"/>
                                    </a>
                                    <a href="#" class="social-link" aria-label="Instagram">
                                        <iconify-icon icon="tabler:brand-instagram" width="18"
                                                      height="18"/>
                                    </a>
                                    <a href="#" class="social-link" aria-label="Twitter/X">
                                        <iconify-icon icon="tabler:brand-x" width="18" height="18"/>
                                    </a>
                                    <a href="#" class="social-link" aria-label="Pinterest">
                                        <iconify-icon icon="tabler:brand-pinterest" width="18"
                                                      height="18"/>
                                    </a>
                                </div>
                            </div>
                            <div class="footer-col">
                                <h4>Quick Links</h4>
                                <ul class="footer-links">
                                    <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                        <li>
                                            <a t-att-href="submenu.url">→
                                                <t t-out="submenu.name"/>
                                            </a>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                            <div class="footer-col">
                                <h4>Our Services</h4>
                                <ul class="footer-links">
                                    <li>
                                        <a href="/services#lawn">→ Lawn Maintenance</a>
                                    </li>
                                    <li>
                                        <a href="/services#garden">→ Garden Design</a>
                                    </li>
                                    <li>
                                        <a href="/services#hardscaping">→ Hardscaping</a>
                                    </li>
                                    <li>
                                        <a href="/services#irrigation">→ Irrigation</a>
                                    </li>
                                    <li>
                                        <a href="/services#trees">→ Tree Care</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="footer-col">
                                <h4>Contact Us</h4>
                                <div class="footer-contact-item">
                                    <span class="icon">
                                        <iconify-icon icon="tabler:map-pin" width="18" height="18"/>
                                    </span>
                                    <span>4821 Garden Way, Suite 100<br/>Los Angeles, CA 90028
                                    </span>
                                </div>
                                <div class="footer-contact-item">
                                    <span class="icon">
                                        <iconify-icon icon="tabler:phone" width="18" height="18"/>
                                    </span>
                                    <span>
                                        <a href="tel:+15551234567" style="color:inherit;">(555) 123-4567</a>
                                    </span>
                                </div>
                                <div class="footer-contact-item">
                                    <span class="icon">
                                        <iconify-icon icon="tabler:mail" width="18" height="18"/>
                                    </span>
                                    <span>hello@greenscapela.com</span>
                                </div>
                            </div>
                        </div>
                        <div class="footer-bottom">
                            <p>© 2025 GreenScape Landscaping. All rights reserved.</p>
                            <div style="display:flex; gap:20px;">
                                <a href="#">Privacy Policy</a>
                                <a href="#">Terms of Service</a>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
