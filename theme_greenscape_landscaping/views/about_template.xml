<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Template for displaying the landscaping projects about page -->
        <template id="aboutus_greenscape" inherit_id="website.aboutus" name="Greenscape About Us">
            <xpath expr="//div[@id='wrap']" position="replace">
                <div id="wrap" class="oe_structure oe_empty greenscape-home">
                    <!-- ========== PAGE HERO ========== -->
                    <div class="page-hero">
                        <div class="container">
                        <div class="page-hero-content">
                            <div class="breadcrumb">
                            <a href="/">Home</a>
                            <span class="sep">/</span>
                            <span>About Us</span>
                            </div>
                            <h1>Our Story &amp; Mission</h1>
                            <p>Two decades of passion, craftsmanship, and a commitment to transforming the way people experience the outdoors.</p>
                        </div>
                        </div>
                    </div>
                    <!-- ========== COMPANY STORY ========== -->
                    <section>
                        <div class="container">
                        <div class="story-grid">
                            <div class="story-images fade-in">
                            <div class="story-img-main">
                                <img src="/theme_greenscape_landscaping/static/src/images/img1.png" alt="GreenScape team at work" loading="lazy" />
                            </div>
                            <div class="story-img-secondary">
                                <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=400" alt="A completed GreenScape project" loading="lazy" />
                            </div>
                            </div>
                            <div class="fade-up">
                            <span class="section-tag">Our Story</span>
                            <h2 class="section-title">From a Single Mower to a Full Team of Experts</h2>
                            <p style="margin-bottom:16px;">
                                GreenScape Landscaping was founded in 2005 by Marcus Reed, a horticulturist with a passion for blending nature's beauty with purposeful design. What began as a one-man lawn care operation out of a pickup truck quickly grew into the region's most trusted full-service landscaping company.
                            </p>
                            <p style="margin-bottom:16px;">
                                Over the years, we've assembled a team of certified landscape architects, master gardeners, irrigation specialists, and hardscape craftsmen — all united by one belief: every outdoor space has the potential to become something extraordinary.
                            </p>
                            <p>
                                Today, GreenScape employs over 50 professionals and has completed more than 500 residential and commercial projects across the Los Angeles area. We're proud members of NALP, and hold multiple industry certifications in sustainable landscaping and water management.
                            </p>
                            <div class="mission-grid">
                                <div class="mission-card">
                                <h4>Our Mission</h4>
                                <p>To design and maintain beautiful, sustainable landscapes that enrich lives, increase property value, and inspire a deeper connection with nature.</p>
                                </div>
                                <div class="mission-card">
                                <h4>Our Vision</h4>
                                <p>To be the most trusted and innovative landscaping company in Southern California, setting new standards in quality, sustainability, and client satisfaction.</p>
                                </div>
                            </div>
                            </div>
                        </div>
                        </div>
                    </section>
                    <!-- ========== VALUES ========== -->
                    <section style="background:var(--neutral-100);">
                        <div class="container">
                        <div class="section-header">
                            <span class="section-tag fade-up">What We Stand For</span>
                            <h2 class="section-title fade-up">Our Core Values</h2>
                            <p class="section-desc fade-up">These principles guide every decision we make, from design to the final walkthrough with our clients.</p>
                        </div>
                        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:28px;">
                            <div class="fade-up" style="background:var(--white); border-radius:var(--radius-lg); padding:32px; box-shadow:var(--shadow-sm); text-align:center;">
                            <div style="color:var(--primary); margin-bottom:16px;"><iconify-icon icon="tabler:leaf" width="40" height="40"/></div>
                            <h3 style="margin-bottom:12px; font-size:1.1rem;">Sustainability</h3>
                            <p style="font-size:0.9rem;">We prioritize eco-friendly methods, native plants, and water-saving technology to protect our environment for future generations.</p>
                            </div>
                            <div class="fade-up" style="background:var(--white); border-radius:var(--radius-lg); padding:32px; box-shadow:var(--shadow-sm); text-align:center;">
                            <div style="color:var(--primary); margin-bottom:16px;"><iconify-icon icon="tabler:target" width="40" height="40"/></div>
                            <h3 style="margin-bottom:12px; font-size:1.1rem;">Precision</h3>
                            <p style="font-size:0.9rem;">Every stone placed, every plant chosen, every line edged — we approach our work with meticulous attention to detail and craftsmanship.</p>
                            </div>
                            <div class="fade-up" style="background:var(--white); border-radius:var(--radius-lg); padding:32px; box-shadow:var(--shadow-sm); text-align:center;">
                            <div style="color:var(--primary); margin-bottom:16px;"><iconify-icon icon="tabler:handshake" width="40" height="40"/></div>
                            <h3 style="margin-bottom:12px; font-size:1.1rem;">Integrity</h3>
                            <p style="font-size:0.9rem;">We believe in honest communication, fair pricing, and standing behind our work. We do what we say, always.</p>
                            </div>
                            <div class="fade-up" style="background:var(--white); border-radius:var(--radius-lg); padding:32px; box-shadow:var(--shadow-sm); text-align:center;">
                            <div style="color:var(--primary); margin-bottom:16px;"><iconify-icon icon="tabler:bulb" width="40" height="40"/></div>
                            <h3 style="margin-bottom:12px; font-size:1.1rem;">Innovation</h3>
                            <p style="font-size:0.9rem;">We stay ahead of industry trends, incorporating the latest design techniques, tools, and sustainable practices into our work.</p>
                            </div>
                        </div>
                        </div>
                    </section>
                    <!-- ========== ACHIEVEMENTS ========== -->
                    <section style="background:var(--primary-dark);">
                        <div class="container">
                        <div class="achievements-grid">
                            <div class="achievement-card fade-up">
                            <div class="achievement-number">500+</div>
                            <div class="achievement-label">Projects Completed</div>
                            </div>
                            <div class="achievement-card fade-up" style="background:rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
                            <div class="achievement-number">20+</div>
                            <div class="achievement-label">Years in Business</div>
                            </div>
                            <div class="achievement-card fade-up">
                            <div class="achievement-number">98%</div>
                            <div class="achievement-label">Client Satisfaction</div>
                            </div>
                            <div class="achievement-card fade-up" style="background:rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
                            <div class="achievement-number">50+</div>
                            <div class="achievement-label">Team Professionals</div>
                            </div>
                        </div>
                        </div>
                    </section>
                    <!-- ========== TEAM ========== -->
                    <section>
                        <div class="container">
                        <div class="section-header">
                            <span class="section-tag fade-up">Meet the Crew</span>
                            <h2 class="section-title fade-up">The Experts Behind Your Landscape</h2>
                            <p class="section-desc fade-up">Our experienced team brings together passion, knowledge, and artistry to create outdoor spaces you'll love for years to come.</p>
                        </div>
                        <div class="team-grid">
                            <div class="team-card">
                            <div class="team-img">
                                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400" alt="Marcus Reed - Founder" loading="lazy" />
                            </div>
                            <div class="team-info">
                                <h3>Marcus Reed</h3>
                                <p class="team-role">Founder &amp; Lead Designer</p>
                                <p class="team-bio">With a degree in Horticulture and 20+ years of experience, Marcus leads the company with vision and hands-on expertise.</p>
                                <div class="team-socials">
                                <a href="#" aria-label="LinkedIn"><iconify-icon icon="tabler:brand-linkedin" width="16" height="16"/></a>
                                <a href="#" aria-label="Twitter/X"><iconify-icon icon="tabler:brand-x" width="16" height="16"/></a>
                                <a href="#" aria-label="Instagram"><iconify-icon icon="tabler:brand-instagram" width="16" height="16"/></a>
                                </div>
                            </div>
                            </div>
                            <div class="team-card">
                            <div class="team-img">
                                <img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?w=400" alt="Emily Torres - Landscape Architect" loading="lazy" />
                            </div>
                            <div class="team-info">
                                <h3>Emily Torres</h3>
                                <p class="team-role">Landscape Architect</p>
                                <p class="team-bio">Emily specializes in sustainable garden design and has won three regional design awards for her innovative approach.</p>
                                <div class="team-socials">
                                <a href="#" aria-label="LinkedIn"><iconify-icon icon="tabler:brand-linkedin" width="16" height="16"/></a>
                                <a href="#" aria-label="Instagram"><iconify-icon icon="tabler:brand-instagram" width="16" height="16"/></a>
                                </div>
                            </div>
                            </div>
                            <div class="team-card">
                            <div class="team-img">
                                <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=400" alt="James Park - Hardscape Specialist" loading="lazy" />
                            </div>
                            <div class="team-info">
                                <h3>James Park</h3>
                                <p class="team-role">Hardscape Specialist</p>
                                <p class="team-bio">James is our stone and concrete artisan, with 15 years of masonry experience and an eye for perfect symmetry.</p>
                                <div class="team-socials">
                                <a href="#" aria-label="LinkedIn"><iconify-icon icon="tabler:brand-linkedin" width="16" height="16"/></a>
                                <a href="#" aria-label="Instagram"><iconify-icon icon="tabler:brand-instagram" width="16" height="16"/></a>
                                </div>
                            </div>
                            </div>
                            <div class="team-card">
                            <div class="team-img">
                                <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=400" alt="Aria Nguyen - Irrigation Engineer" loading="lazy" />
                            </div>
                            <div class="team-info">
                                <h3>Aria Nguyen</h3>
                                <p class="team-role">Irrigation Engineer</p>
                                <p class="team-bio">Certified in smart irrigation systems, Aria designs water-efficient solutions that reduce consumption by up to 50%.</p>
                                <div class="team-socials">
                                <a href="#" aria-label="LinkedIn"><iconify-icon icon="tabler:brand-linkedin" width="16" height="16"/></a>
                                <a href="#" aria-label="Instagram"><iconify-icon icon="tabler:brand-instagram" width="16" height="16"/></a>
                                </div>
                            </div>
                            </div>
                        </div>
                        </div>
                    </section>
                    <!-- ========== CERTIFICATIONS ========== -->
                    <section style="background:var(--neutral-100); padding:60px 0;">
                        <div class="container">
                        <div class="section-header" style="margin-bottom:40px;">
                            <span class="section-tag fade-up">Credentials</span>
                            <h2 class="section-title fade-up">Licensed, Certified &amp; Award-Winning</h2>
                        </div>
                        <div style="display:flex; gap:24px; flex-wrap:wrap; justify-content:center;">
                            <div class="fade-up" style="background:var(--white); border-radius:var(--radius-md); padding:24px 32px; box-shadow:var(--shadow-sm); text-align:center; min-width:160px;">
                            <div style="color:var(--primary); margin-bottom:8px;"><iconify-icon icon="tabler:award" width="32" height="32"/></div>
                            <strong style="font-size:0.85rem; display:block;">NALP Certified</strong>
                            <span style="font-size:0.75rem; color:var(--text-light);">Member Since 2007</span>
                            </div>
                            <div class="fade-up" style="background:var(--white); border-radius:var(--radius-md); padding:24px 32px; box-shadow:var(--shadow-sm); text-align:center; min-width:160px;">
                            <div style="color:var(--primary); margin-bottom:8px;"><iconify-icon icon="tabler:plant-2" width="32" height="32"/></div>
                            <strong style="font-size:0.85rem; display:block;">Eco-Certified Pro</strong>
                            <span style="font-size:0.75rem; color:var(--text-light);">Sustainable Practices</span>
                            </div>
                            <div class="fade-up" style="background:var(--white); border-radius:var(--radius-md); padding:24px 32px; box-shadow:var(--shadow-sm); text-align:center; min-width:160px;">
                            <div style="color:var(--primary); margin-bottom:8px;"><iconify-icon icon="tabler:droplet" width="32" height="32"/></div>
                            <strong style="font-size:0.85rem; display:block;">WaterSmart Certified</strong>
                            <span style="font-size:0.75rem; color:var(--text-light);">Irrigation Specialist</span>
                            </div>
                            <div class="fade-up" style="background:var(--white); border-radius:var(--radius-md); padding:24px 32px; box-shadow:var(--shadow-sm); text-align:center; min-width:160px;">
                            <div style="color:var(--primary); margin-bottom:8px;"><iconify-icon icon="tabler:star-filled" width="32" height="32"/></div>
                            <strong style="font-size:0.85rem; display:block;">Best of LA Award</strong>
                            <span style="font-size:0.75rem; color:var(--text-light);">2019, 2021, 2023</span>
                            </div>
                            <div class="fade-up" style="background:var(--white); border-radius:var(--radius-md); padding:24px 32px; box-shadow:var(--shadow-sm); text-align:center; min-width:160px;">
                            <div style="color:var(--primary); margin-bottom:8px;"><iconify-icon icon="tabler:shield-check" width="32" height="32"/></div>
                            <strong style="font-size:0.85rem; display:block;">Fully Insured</strong>
                            <span style="font-size:0.75rem; color:var(--text-light);">CA License #123456</span>
                            </div>
                        </div>
                        </div>
                    </section>
                    <!-- ========== CTA ========== -->
                    <section class="cta-section">
                        <div class="container">
                        <div class="cta-content fade-up">
                            <span class="section-tag" style="color:var(--secondary); background:rgba(139,195,74,0.15);">Work With Us</span>
                            <h2>Ready to Start Your Project?</h2>
                            <p>Let our experts design the outdoor space you've always dreamed of. Free consultations available.</p>
                            <div class="cta-actions">
                            <a href="/contactus" class="btn btn-accent">Schedule a Consultation</a>
                            <a href="/services" class="btn btn-outline-white">Explore Services</a>
                            </div>
                        </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </template>
</odoo>
