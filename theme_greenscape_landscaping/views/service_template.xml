<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for displaying the landscaping services page -->
    <template id="services_greenscape" name="Greenscape Services">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty greenscape-home">
                <!-- ========== PAGE HERO ========== -->
                <div class="page-hero">
                    <div class="container">
                        <div class="page-hero-content">
                            <div class="breadcrumb">
                                <a href="/">Home</a>
                                <span class="sep">/</span>
                                <span>Services</span>
                            </div>
                            <h1>Our Landscaping Services</h1>
                            <p>From lawn care to complete landscape transformations — comprehensive outdoor services
                                crafted for your needs and budget.
                            </p>
                        </div>
                    </div>
                </div>
                <!-- ========== SERVICE OVERVIEW CARDS ========== -->
                <section style="background:var(--neutral-100);">
                    <div class="container">
                        <div class="section-header">
                            <span class="section-tag fade-up">What We Offer</span>
                            <h2 class="section-title fade-up">Complete Outdoor Solutions</h2>
                            <p class="section-desc fade-up">Each service is delivered by certified specialists using
                                premium materials and proven techniques.
                            </p>
                        </div>
                        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:16px; margin-bottom:0;">
                            <a href="#lawn" class="fade-up"
                               style="display:flex; flex-direction:column; align-items:center; gap:10px; background:var(--white); border-radius:var(--radius-md); padding:24px 16px; box-shadow:var(--shadow-sm); text-align:center; color:inherit; text-decoration:none;">
                                <span style="color:var(--primary);">
                                    <iconify-icon icon="tabler:scissors" width="32" height="32"/>
                                </span>
                                <strong style="font-size:0.875rem;">Lawn Care</strong>
                            </a>
                            <a href="#garden" class="fade-up"
                               style="display:flex; flex-direction:column; align-items:center; gap:10px; background:var(--white); border-radius:var(--radius-md); padding:24px 16px; box-shadow:var(--shadow-sm); text-align:center; color:inherit; text-decoration:none;">
                                <span style="color:var(--primary);">
                                    <iconify-icon icon="tabler:flower" width="32" height="32"/>
                                </span>
                                <strong style="font-size:0.875rem;">Garden Design</strong>
                            </a>
                            <a href="#irrigation" class="fade-up"
                               style="display:flex; flex-direction:column; align-items:center; gap:10px; background:var(--white); border-radius:var(--radius-md); padding:24px 16px; box-shadow:var(--shadow-sm); text-align:center; color:inherit; text-decoration:none;">
                                <span style="color:var(--primary);">
                                    <iconify-icon icon="tabler:droplet" width="32" height="32"/>
                                </span>
                                <strong style="font-size:0.875rem;">Irrigation</strong>
                            </a>
                            <a href="#hardscaping" class="fade-up"
                               style="display:flex; flex-direction:column; align-items:center; gap:10px; background:var(--white); border-radius:var(--radius-md); padding:24px 16px; box-shadow:var(--shadow-sm); text-align:center; color:inherit; text-decoration:none;">
                                <span style="color:var(--primary);">
                                    <iconify-icon icon="tabler:wall" width="32" height="32"/>
                                </span>
                                <strong style="font-size:0.875rem;">Hardscaping</strong>
                            </a>
                            <a href="#trees" class="fade-up"
                               style="display:flex; flex-direction:column; align-items:center; gap:10px; background:var(--white); border-radius:var(--radius-md); padding:24px 16px; box-shadow:var(--shadow-sm); text-align:center; color:inherit; text-decoration:none;">
                                <span style="color:var(--primary);">
                                    <iconify-icon icon="tabler:tree" width="32" height="32"/>
                                </span>
                                <strong style="font-size:0.875rem;">Tree &amp; Shrub Care</strong>
                            </a>
                        </div>
                    </div>
                </section>
                <!-- ========== SERVICE 1: LAWN CARE ========== -->
                <section class="service-detail" id="lawn">
                    <div class="container">
                        <div class="service-detail-grid">
                            <div class="service-detail-img fade-in">
                                <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=800"
                                     alt="Professional lawn care and maintenance" loading="lazy"/>
                            </div>
                            <div class="service-detail-content fade-up">
                                <span class="section-tag">
                                    <iconify-icon icon="tabler:scissors" width="14" height="14"/>
                                    Service 01
                                </span>
                                <h2 class="section-title">Lawn Care &amp; Maintenance</h2>
                                <p style="margin-bottom:16px;">
                                    A lush, healthy lawn is the foundation of a beautiful property. Our comprehensive
                                    lawn care programs are customized to your grass type, climate, and lifestyle —
                                    ensuring a vibrant, well-maintained lawn every season.
                                </p>
                                <p style="margin-bottom:24px;">
                                    We use professional-grade equipment, slow-release organic fertilizers, and precision
                                    edging techniques to give your lawn a manicured, resort-quality appearance
                                    year-round.
                                </p>
                                <div class="service-benefits">
                                    <div class="benefit-item">Regular mowing, edging, and trimming on your schedule
                                    </div>
                                    <div class="benefit-item">Seasonal fertilization and soil amendment programs</div>
                                    <div class="benefit-item">Weed control and pre-emergent treatments</div>
                                    <div class="benefit-item">Aeration and overseeding for thick, healthy grass</div>
                                    <div class="benefit-item">Pest and disease identification and treatment</div>
                                    <div class="benefit-item">Spring and fall cleanup services</div>
                                </div>
                                <div style="margin-top:32px; display:flex; gap:16px; flex-wrap:wrap;">
                                    <a href="/contactus" class="btn btn-primary">Get a Quote</a>
                                    <a href="/projects" class="btn btn-secondary">See Examples</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ========== SERVICE 2: GARDEN DESIGN ========== -->
                <section class="service-detail" id="garden">
                    <div class="container">
                        <div class="service-detail-grid">
                            <div class="service-detail-img fade-in">
                                <img src="https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?w=800"
                                     alt="Custom garden design and installation" loading="lazy"/>
                            </div>
                            <div class="service-detail-content fade-up">
                                <span class="section-tag">
                                    <iconify-icon icon="tabler:flower" width="14" height="14"/>
                                    Service 02
                                </span>
                                <h2 class="section-title">Garden Design &amp; Installation</h2>
                                <p style="margin-bottom:16px;">
                                    Great garden design is both art and science. Our landscape architects collaborate
                                    with you to create living compositions that reflect your personality, complement
                                    your home, and thrive in your specific microclimate.
                                </p>
                                <p style="margin-bottom:24px;">
                                    From cottage garden charm to sleek modern landscapes, we design, plant, and install
                                    every element with expert precision — from the first blueprint to the final bloom.
                                </p>
                                <div class="service-benefits">
                                    <div class="benefit-item">Personalized 3D design consultation and rendering</div>
                                    <div class="benefit-item">Curated plant selection for your climate and soil</div>
                                    <div class="benefit-item">Native and drought-tolerant planting options</div>
                                    <div class="benefit-item">Seasonal color planting for year-round beauty</div>
                                    <div class="benefit-item">Mulching, edging, and bed preparation</div>
                                    <div class="benefit-item">Ongoing garden maintenance plans available</div>
                                </div>
                                <div style="margin-top:32px; display:flex; gap:16px; flex-wrap:wrap;">
                                    <a href="/contactus" class="btn btn-primary">Start Your Design</a>
                                    <a href="/projects" class="btn btn-secondary">View Portfolio</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ========== SERVICE 3: IRRIGATION ========== -->
                <section class="service-detail" id="irrigation">
                    <div class="container">
                        <div class="service-detail-grid">
                            <div class="service-detail-img fade-in">
                                <img src="https://images.unsplash.com/photo-1622383563227-04401ab4e5ea?w=800"
                                     alt="Smart irrigation system installation" loading="lazy"/>
                            </div>
                            <div class="service-detail-content fade-up">
                                <span class="section-tag">
                                    <iconify-icon icon="tabler:droplet" width="14" height="14"/>
                                    Service 03
                                </span>
                                <h2 class="section-title">Irrigation Systems</h2>
                                <p style="margin-bottom:16px;">
                                    Water is precious, and smart irrigation is the key to healthy plants without waste.
                                    Our certified irrigation engineers design and install custom systems that deliver
                                    the right amount of water to the right places — automatically.
                                </p>
                                <p style="margin-bottom:24px;">
                                    From drip systems for garden beds to rotary zones for large lawns, we install smart
                                    controllers compatible with weather apps and soil sensors for maximum efficiency and
                                    water savings.
                                </p>
                                <div class="service-benefits">
                                    <div class="benefit-item">Custom drip and sprinkler system design</div>
                                    <div class="benefit-item">Smart Wi-Fi controller installation (Rachio, Hunter)</div>
                                    <div class="benefit-item">Reduce water usage by up to 50%</div>
                                    <div class="benefit-item">Seasonal system startup and winterization</div>
                                    <div class="benefit-item">Leak detection and repair services</div>
                                    <div class="benefit-item">Backflow prevention and compliance testing</div>
                                </div>
                                <div style="margin-top:32px; display:flex; gap:16px; flex-wrap:wrap;">
                                    <a href="/contactus" class="btn btn-primary">Get a Quote</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ========== SERVICE 4: HARDSCAPING ========== -->
                <section class="service-detail" id="hardscaping">
                    <div class="container">
                        <div class="service-detail-grid">
                            <div class="service-detail-img fade-in">
                                <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800"
                                     alt="Hardscaping patio and walkway construction" loading="lazy"/>
                            </div>
                            <div class="service-detail-content fade-up">
                                <span class="section-tag">
                                    <iconify-icon icon="tabler:wall" width="14" height="14"/>
                                    Service 04
                                </span>
                                <h2 class="section-title">Hardscaping</h2>
                                <p style="margin-bottom:16px;">
                                    Hardscaping extends your living space beyond your walls. Our expert craftsmen build
                                    durable, beautiful outdoor structures using natural stone, concrete pavers, brick,
                                    and timber — designed to last decades and look stunning throughout.
                                </p>
                                <p style="margin-bottom:24px;">
                                    Whether it's an intimate stone patio, a grand entertaining terrace, or a functional
                                    retaining wall that prevents erosion — we build it right the first time.
                                </p>
                                <div class="service-benefits">
                                    <div class="benefit-item">Custom patio design and installation</div>
                                    <div class="benefit-item">Natural stone and paver walkways</div>
                                    <div class="benefit-item">Retaining walls and terracing</div>
                                    <div class="benefit-item">Outdoor kitchens and fire pit areas</div>
                                    <div class="benefit-item">Steps, borders, and edging systems</div>
                                    <div class="benefit-item">Structural grading and drainage solutions</div>
                                </div>
                                <div style="margin-top:32px; display:flex; gap:16px; flex-wrap:wrap;">
                                    <a href="/contactus" class="btn btn-primary">Plan My Hardscape</a>
                                    <a href="/projects" class="btn btn-secondary">See Our Work</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ========== SERVICE 5: TREE CARE ========== -->
                <section class="service-detail" id="trees">
                    <div class="container">
                        <div class="service-detail-grid">
                            <div class="service-detail-img fade-in">
                                <img src="/theme_greenscape_landscaping/static/src/images/img3.png" alt="Tree and shrub care and pruning" loading="lazy"/>
