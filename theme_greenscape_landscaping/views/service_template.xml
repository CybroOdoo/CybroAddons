                            <div class="service-detail-content fade-up">
                                <span class="section-tag">
                                    <iconify-icon icon="tabler:tree" width="14" height="14"/>
                                    Service 05
                                </span>
                                <h2 class="section-title">Tree &amp; Shrub Care</h2>
                                <p style="margin-bottom:16px;">
                                    Trees and shrubs are long-term investments in your property's beauty and value.
                                    Proper care extends their life, enhances their form, and keeps them safe. Our
                                    ISA-trained arborists provide expert care for all species and sizes.
                                </p>
                                <p style="margin-bottom:24px;">
                                    From structural pruning to hazard tree removal, we approach every job safely and
                                    with respect for the living organisms we work with. We also offer planting
                                    consultation for new trees.
                                </p>
                                <div class="service-benefits">
                                    <div class="benefit-item">Professional pruning and shaping for all species</div>
                                    <div class="benefit-item">Crown thinning, raising, and reduction</div>
                                    <div class="benefit-item">Tree health assessments and disease treatment</div>
                                    <div class="benefit-item">Safe tree and stump removal services</div>
                                    <div class="benefit-item">Deep root fertilization and soil care</div>
                                    <div class="benefit-item">New tree selection and planting guidance</div>
                                </div>
                                <div style="margin-top:32px; display:flex; gap:16px; flex-wrap:wrap;">
                                    <a href="/contactus" class="btn btn-primary">Schedule Assessment</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
