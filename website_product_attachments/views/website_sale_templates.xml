<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show product attachments on the website product page -->
    <template id="product_attachments" inherit_id="website_sale.cta_wrapper"
              name="Product Attachments">
         <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <div class="js_attachment_container">
                <t t-if="attachments">
                    <span>
                        <strong>Related Documents:</strong>
                    </span>
                    <br/>

                    <t t-foreach="attachments" t-as="attachment">
                        <a class="js_on_click_show_attachment"
                           style="cursor: pointer;"
                           t-att-data-value="attachment.id">
                            <span class="oi oi-fw me-1" data-icon="download"/>
                            <span t-out="attachment.name"/>
                        </a>
                    </t>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
