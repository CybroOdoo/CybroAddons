<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <!--
        This view inherits the standard product form and adds
        a preparation time field used by the POS Kitchen Screen.-->
    <record id="product_template_view_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pos.kitchen.screen.odoo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='to_weight']" position="after">
                <field name="prepair_time_minutes"/>
            </xpath>
        </field>
    </record>
</odoo>
