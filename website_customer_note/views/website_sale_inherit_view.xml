<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Add a customer note field to the website payment page -->
    <template id="website_customer_note_template" name="Customer Note"
              inherit_id="website_sale.payment">
        <xpath expr="//div[@id='payment_method']" position="before">
            <!-- Hidden field so JS can read the current sale order ID -->
            <input type="hidden"
                   name="sale_order_id"
                   t-att-value="website_sale_order.id"/>
            <div class="form-group mb-3">
                <label for="customer_note" class="form-label fw-bold">
                    Customer Note:
                </label>
                <textarea id="customer_note"
                          class="form-control"
                          name="customer_note"
                          rows="3"
                          placeholder="Add any special instructions for your order..."/>
            </div>
        </xpath>
    </template>
</odoo>
