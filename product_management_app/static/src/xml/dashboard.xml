<?xml version="1.0" encoding="utf-8"?>
<template>
    <t t-name="ProductDashboard">
        <div class="product_dashboard_container p-3 p-md-4 pb-5">
            <!-- Header Banner -->
            <div class="dashboard_header_card mb-4 p-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard_header_icon">
                        <i class="oi" data-icon="inventory_2"/>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark">Product Management Dashboard</h4>
                        <span class="text-muted" style="font-size: 0.875rem;">Comprehensive overview of inventory, sales, purchases, and movements</span>
                    </div>
                </div>
            </div>

            <!-- KPI Tiles Grid -->
            <div class="row g-3 g-xl-4 mb-4">
                <!-- Products -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi_card">
                        <div class="kpi_icon_wrapper kpi_blue">
                            <i class="oi" data-icon="inventory_2"/>
                        </div>
                        <div class="kpi_content">
                            <span class="kpi_label">Products</span>
                            <h3 class="kpi_value">
                                <t t-out="this.state.product_templates || 0"/>
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Product Variants -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi_card">
                        <div class="kpi_icon_wrapper kpi_purple">
                            <i class="oi" data-icon="sell"/>
                        </div>
                        <div class="kpi_content">
                            <span class="kpi_label">Product Variants</span>
                            <h3 class="kpi_value">
                                <t t-out="this.state.variants_count || 0"/>
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Combo Products -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi_card">
                        <div class="kpi_icon_wrapper kpi_green">
                            <i class="oi" data-icon="grid_view"/>
                        </div>
                        <div class="kpi_content">
                            <span class="kpi_label">Combo Products</span>
                            <h3 class="kpi_value">
                                <t t-out="this.state.products_storable || 0"/>
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Goods Products -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi_card">
                        <div class="kpi_icon_wrapper kpi_amber">
                            <i class="oi" data-icon="package_2"/>
                        </div>
                        <div class="kpi_content">
                            <span class="kpi_label">Goods Products</span>
                            <h3 class="kpi_value">
                                <t t-out="this.state.product_consumable || 0"/>
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Service Products -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi_card">
                        <div class="kpi_icon_wrapper kpi_rose">
                            <i class="oi" data-icon="build"/>
                        </div>
                        <div class="kpi_content">
                            <span class="kpi_label">Service Products</span>
                            <h3 class="kpi_value">
                                <t t-out="this.state.product_service || 0"/>
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Product Categories -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi_card">
                        <div class="kpi_icon_wrapper kpi_cyan">
                            <i class="oi" data-icon="account_tree"/>
                        </div>
                        <div class="kpi_content">
                            <span class="kpi_label">Product Categories</span>
                            <h3 class="kpi_value">
                                <t t-out="this.state.product_categ || 0"/>
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Price Lists -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi_card">
                        <div class="kpi_icon_wrapper kpi_indigo">
                            <i class="oi" data-icon="payments"/>
                        </div>
                        <div class="kpi_content">
                            <span class="kpi_label">Price Lists</span>
                            <h3 class="kpi_value">
                                <t t-out="this.state.product_pricelist || 0"/>
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Product Attributes -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi_card">
                        <div class="kpi_icon_wrapper kpi_teal">
                            <i class="oi" data-icon="tune"/>
                        </div>
                        <div class="kpi_content">
                            <span class="kpi_label">Product Attributes</span>
                            <h3 class="kpi_value">
                                <t t-out="this.state.product_attribute || 0"/>
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row 1: Top Sales & Top Purchases -->
            <div class="row g-3 g-xl-4 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="chart_dashboard_card">
                        <div class="chart_card_header">
                            <div class="d-flex align-items-center gap-2">
                                <span class="chart_header_icon text-primary"><i class="oi" data-icon="pie_chart"/></span>
                                <h6 class="mb-0 fw-bold">Top Selling Products</h6>
                            </div>
                        </div>
                        <div class="chart_card_body d-flex justify-content-center align-items-center">
                            <div class="chart_canvas_wrapper">
                                <canvas t-ref="this.TopSaleChart"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="chart_dashboard_card">
                        <div class="chart_card_header">
                            <div class="d-flex align-items-center gap-2">
                                <span class="chart_header_icon text-success"><i class="oi" data-icon="shopping_cart"/></span>
                                <h6 class="mb-0 fw-bold">Top Purchased Products</h6>
                            </div>
                        </div>
                        <div class="chart_card_body d-flex justify-content-center align-items-center">
                            <div class="chart_canvas_wrapper">
                                <canvas t-ref="this.TopPurchaseChart"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row 2: Monthly Moves & Location Analysis -->
            <div class="row g-3 g-xl-4 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="chart_dashboard_card">
                        <div class="chart_card_header d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="chart_header_icon text-info"><i class="oi" data-icon="show_chart"/></span>
                                <h6 class="mb-0 fw-bold">Product Moves Monthly Analysis</h6>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <select class="form-select form-select-sm filter_select" id="prod_selection"
                                        t-on-change="this.onchange_prod_selection"
                                        t-ref="this.ProductSelection">
                                </select>
                                <select class="form-select form-select-sm filter_select" id="year_selection"
                                        t-on-change="this.onchange_prod_selection"
                                        t-ref="this.YearSelection">
                                </select>
                            </div>
                        </div>
                        <div class="chart_card_body">
                            <div class="bar_line_canvas_wrapper">
                                <canvas t-ref="this.ProductChart"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="chart_dashboard_card">
                        <div class="chart_card_header d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="chart_header_icon text-warning"><i class="oi" data-icon="location_on"/></span>
                                <h6 class="mb-0 fw-bold">Product By Location</h6>
                            </div>
                            <div>
                                <select class="form-select form-select-sm filter_select" id="product_location_selection"
                                        t-on-change="this.onchange_location_selection"
                                        t-ref="this.ProductLocation">
                                </select>
                            </div>
                        </div>
                        <div class="chart_card_body">
                            <div class="bar_line_canvas_wrapper">
                                <canvas t-ref="this.ProductQtyChart"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>
