<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <!--Access group for whatsapp configuration and messaging-->
        <record id="survey_whatsapp_integration_group_user" model="res.groups">
            <field name="name">Whatsapp Messaging</field>
            <field name="privilege_id" ref="survey.res_groups_privilege_surveys"/>
        </record>
        
        <!-- Make Survey Administrator automatically include WhatsApp Messaging access -->
        <record id="survey.group_survey_manager" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('survey_whatsapp_integration_group_user'))]"/>
        </record>
    </data>
</odoo>
