<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_move_view_list_valuation" model="ir.ui.view">
        <field name="name">stock.move.view.list.valuation.inherit.stock.last.purchase.price</field>
        <field name="model">stock.move</field>
        <field name="inherit_id"
               ref="stock_account.stock_move_view_list_valuation"/>
        <field name="arch" type="xml">
             <!-- Update 'value' column invisibility -->
            <xpath expr="//field[@name='value']" position="attributes">
                <attribute name="column_invisible">context.get('cost_method') not in ('fifo', 'last')</attribute>
            </xpath>

            <!-- Update 'standard_price' column invisibility -->
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="column_invisible">context.get('cost_method') in ('fifo','last')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
