<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================================
         PRODUCT ATTRIBUTES: Material & Diameter
         These drive the sidebar filter checkboxes on /shop
    ========================================================= -->
    <!-- Material Attribute -->
    <record id="attr_material" model="product.attribute">
        <field name="name">Material</field>
        <field name="display_type">multi</field>
        <field name="create_variant">no_variant</field>
    </record>
    <record id="attr_val_manila" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Natural Manila Fibre</field>
    </record>
    <record id="attr_val_pp" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Polypropylene (PP)</field>
    </record>
    <record id="attr_val_steel" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Steel core</field>
    </record>
    <record id="attr_val_polyester" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Polyester</field>
    </record>
    <record id="attr_val_nylon" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Nylon (Polyamide)</field>
    </record>
    <record id="attr_val_cotton" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">100% Natural Cotton</field>
    </record>
    <record id="attr_val_dyed" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Dyed Cotton</field>
    </record>
    <record id="attr_val_kern" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Nylon kernmantle</field>
    </record>
    <!-- Diameter Attribute -->
    <record id="attr_diameter" model="product.attribute">
        <field name="name">Diameter</field>
        <field name="display_type">multi</field>
        <field name="create_variant">no_variant</field>
    </record>
    <record id="attr_val_4mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">4 mm</field>
    </record>
    <record id="attr_val_6mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">6 mm</field>
    </record>
    <record id="attr_val_8mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">8 mm</field>
    </record>
    <record id="attr_val_9_8mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">9.8 mm</field>
    </record>
    <record id="attr_val_10mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">10 mm</field>
    </record>
    <record id="attr_val_11mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">11 mm</field>
    </record>
    <record id="attr_val_12mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">12 mm</field>
    </record>
    <record id="attr_val_14mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">14 mm</field>
    </record>
    <record id="attr_val_16mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">16 mm</field>
    </record>
    <!-- =========================================================
         WEBSITE PRODUCT CATEGORIES  (product.public.category)
         These appear in Website > eCommerce > Categories
         and drive the shop sidebar category filter.
    ========================================================= -->
    <record id="cat_industrial" model="product.public.category">
        <field name="name">Industrial</field>
    </record>
    <record id="cat_marine" model="product.public.category">
        <field name="name">Marine</field>
    </record>
    <record id="cat_fabric" model="product.public.category">
        <field name="name">Fabric</field>
    </record>
    <record id="cat_climbing" model="product.public.category">
        <field name="name">Climbing</field>
    </record>
    <!-- =========================================================
         INTERNAL SALES / PRODUCT CATEGORIES  (product.category)
         These appear in Sales > Configuration > Product Categories
         under All / Saleable, for internal stock/accounting use.
    ========================================================= -->
    <record id="internal_cat_industrial" model="product.category">
        <field name="name">Industrial</field>
        <field name="parent_id" ref="product.product_category_all"/>
    </record>
    <record id="internal_cat_marine" model="product.category">
        <field name="name">Marine</field>
        <field name="parent_id" ref="product.product_category_all"/>
    </record>
    <record id="internal_cat_fabric" model="product.category">
        <field name="name">Fabric</field>
        <field name="parent_id" ref="product.product_category_all"/>
    </record>
    <record id="internal_cat_climbing" model="product.category">
        <field name="name">Climbing</field>
        <field name="parent_id" ref="product.product_category_all"/>
    </record>
    <!-- =========================================================
         ACTIVATE SIDEBAR FILTERS
         Enable Categories sidebar, Attributes sidebar, Price filter
    ========================================================= -->
    <record id="website_sale.products_categories" model="ir.ui.view">
        <field name="active">True</field>
    </record>
    <record id="website_sale.products_attributes" model="ir.ui.view">
        <field name="active">True</field>
    </record>
    <record id="website_sale.filter_products_price" model="ir.ui.view">
        <field name="active">False</field>
    </record>
</odoo>
