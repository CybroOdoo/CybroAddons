<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =============================================================
         Cordage Footer
    ============================================================= -->
    <template id="theme_cordage_footer" inherit_id="website.footer_custom" name="Cordage Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo" t-if="not no_footer">
                <footer class="theme-cordage-footer" data-name="Footer">
                    <div class="container-xl">
                        <div class="theme-cordage-footer__top">
                            <div class="theme-cordage-footer__brand-col">
                                <a href="/" class="theme-cordage-footer__brand" aria-label="Cordage home">
                                    <img src="/theme_cordage/static/src/img/logo.png" alt="Cordage" class="theme-cordage-footer__logo"/>
                                </a>
                                <p class="theme-cordage-footer__blurb">ISO 9001 certified supplier of industrial,<br/>marine, fabric, and climbing ropes.<br/>Cut to your exact length —<br/>dispatched in 48 hours.</p>
                            </div>
                            <div>
                                <h5>PRODUCTS</h5>
                                <a href="/shop?search=industrial">Industrial Ropes</a>
                                <a href="/shop?search=marine">Marine Ropes</a>
                                <a href="/shop?search=fabric">Fabric Ropes</a>
                                <a href="/shop?search=climbing">Climbing Ropes</a>
                                <a href="/shop?search=lifting">Lifting Slings</a>
                                <a href="/shop?search=rigging">Rigging Hardware</a>
                            </div>
                            <div>
                                <h5>COMPANY</h5>
                                <a href="/about-us">About Us</a>
                                <a href="/about-us#certifications">Certifications</a>
                                <a href="/about-us">Careers</a>
                                <a href="/contactus">Contact</a>
                                <a href="/my/home">Trade Accounts</a>
                                <a href="/contactus">Wholesale</a>
                            </div>
                            <div>
                                <h5>SUPPORT</h5>
                                <a href="/contactus">FAQ</a>
                                <a href="/contactus">Shipping Info</a>
                                <a href="/contactus">Returns</a>
                                <a href="/contactus">Load Spec Guide</a>
                                <a href="/contactus">Technical Support</a>
                            </div>
                        </div>
                        <div class="theme-cordage-footer__bottom">
                            <span>© 2026 CORDAGE Ltd. All rights reserved.</span>
                            <span>
                                <a href="/contactus">Privacy</a> · 
                                <a href="/contactus">Terms</a> · 
                                ISO 9001:2015 Certified
                            </span>
                        </div>
                    </div>
                </footer>
            </div>
        </xpath>
    </template>
</odoo>
