<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Contact page - styled to match cordage_example/contact.html -->
    <template id="cordage_contact_page" inherit_id="website.contactus" name="Cordage Custom Contact">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- PAGE HERO / BREADCRUMB -->
                <div class="contact-hero-section">
                    <nav style="display:flex;align-items:center;gap:.4rem;font-size:12px;color:#7a8a9a;margin-bottom:1rem;">
                        <a href="/" style="color:#7a8a9a;text-decoration:none;">Home</a>
                        <span>›</span>
                        <span style="color:#16202e;">Contact</span>
                    </nav>
                    <h1 style="font-size:clamp(1.8rem,4vw,2.8rem);font-weight:700;color:#16202e;letter-spacing:-.025em;margin-bottom:.5rem;">Get in touch</h1>
                    <p style="font-size:15px;color:#7a8a9a;max-width:560px;line-height:1.7;">Need help choosing a rope, requesting a bulk quote, or opening a trade account? We respond to every enquiry within one business day.</p>
                </div>
                <!-- MAIN CONTACT LAYOUT: form + sidebar -->
                <div id="contact-form" class="contact-form-grid">
                    <!-- CONTACT FORM CARD -->
                    <div style="background:#fff;border:1px solid #e7e0d4;border-radius:12px;padding:2rem;">
                        <h2 style="font-size:18px;font-weight:700;color:#16202e;margin-bottom:1.4rem;display:flex;align-items:center;gap:.5rem;">
                            <i class="bi bi-send" style="color:#e8641a;"/> Send us a message
                        </h2>
                        <div class="s_website_form container-fluid p-0" data-vcss="001" data-snippet="s_website_form" data-name="Contact Form">
                            <form id="cordage_contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required cordage-validated-form" data-mark="*" data-model_name="mail.mail" data-success-mode="redirect" data-success-page="/contactus?success=1" data-pre-fill="true">
                                <div class="s_website_form_rows row s_col_no_bgcolor g-3">
                                    <div class="col-md-6 col-12 s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                                        <div class="form-group">
                                            <label for="cc_name">First name</label>
                                            <input id="cc_name" type="text" class="form-control s_website_form_input" name="name" required="" placeholder="Jane" data-fill-with="name"/>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-12 s_website_form_field" data-type="char" data-name="Field">
                                        <div class="form-group">
                                            <label for="cc_last_name">Last name</label>
                                            <input id="cc_last_name" type="text" class="form-control s_website_form_input" name="Last Name" placeholder="Maker"/>
                                        </div>
                                    </div>
                                    <div class="col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="email" data-name="Field">
                                        <div class="form-group">
                                            <label for="cc_email">Work email</label>
                                            <input id="cc_email" type="email" class="form-control s_website_form_input" name="email_from" required="" placeholder="you@company.com" data-fill-with="email"/>
                                        </div>
                                    </div>
                                    <div class="col-12 s_website_form_field" data-type="char" data-name="Field">
                                        <div class="form-group">
                                            <label for="cc_company">Company <span class="text-muted fw-normal">(optional)</span></label>
                                            <input id="cc_company" type="text" class="form-control s_website_form_input" name="company" placeholder="Acme Rigging Ltd."/>
                                        </div>
                                    </div>
                                    <div class="col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                                        <div class="form-group">
                                            <label for="cc_subject">Subject</label>
                                            <select id="cc_subject" name="subject" class="form-select s_website_form_input" required="">
                                                <option value="">Select a subject</option>
                                                <option value="Product enquiry">Product enquiry</option>
                                                <option value="Request a quote">Request a quote</option>
                                                <option value="Trade account application">Trade account application</option>
                                                <option value="Order support">Order support</option>
                                                <option value="Technical specification help">Technical specification help</option>
                                                <option value="Returns and refunds">Returns and refunds</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-12 s_website_form_field s_website_form_required" data-type="text" data-name="Field">
                                        <div class="form-group">
                                            <label for="cc_message">Message</label>
                                            <textarea id="cc_message" class="form-control s_website_form_input" name="description" required="" rows="5" placeholder="Describe your application, load requirements, or question..."/>
                                        </div>
                                    </div>
                                    <div class="col-12 s_website_form_field s_website_form_dnone">
                                        <div>
                                            <input type="hidden" class="form-control s_website_form_input" name="email_to"/>
                                        </div>
                                    </div>
                                    <div class="col-12 s_website_form_submit" data-name="Submit Button">
                                        <a href="#" role="button" class="btn-primary-custom border-0 s_website_form_send w-100">
                                            <i class="bi bi-send"/> Send message
                                        </a>
                                        <span id="s_website_form_result"/>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <!-- INFO SIDEBAR -->
                    <div style="display:flex;flex-direction:column;gap:1rem;">
                        <!-- Response time badge -->
                        <div style="display:flex;align-items:center;gap:6px;background:rgba(47,125,91,.1);border:1px solid rgba(47,125,91,.25);border-radius:8px;padding:.7rem 1rem;font-size:12px;color:#16202e;">
                            <i class="bi bi-clock" style="color:#2f7d5b;font-size:1rem;flex-shrink:0;"/>
                            <span>Typical response time: <strong>under 4 hours</strong> on business days</span>
                        </div>
                        <div style="background:#fff;border:1px solid #e7e0d4;border-radius:10px;padding:1.3rem;display:flex;align-items:flex-start;gap:.9rem;">
                            <div style="width:40px;height:40px;border-radius:8px;background:rgba(232,100,26,.1);border:1px solid rgba(232,100,26,.2);display:flex;align-items:center;justify-content:center;color:#e8641a;flex-shrink:0;">
                                <i class="bi bi-envelope" style="font-size:1.2rem;"/>
                            </div>
                            <div>
                                <h4 style="font-size:13px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Email</h4>
                                <p style="font-size:12px;color:#7a8a9a;line-height:1.6;margin:0;">
                                    <a href="mailto:hello@cordage.com" style="color:#e8641a;text-decoration:none;font-weight:600;">hello@cordage.com</a><br/>
                                    <a href="mailto:trade@cordage.com" style="color:#e8641a;text-decoration:none;font-weight:600;">trade@cordage.com</a> <span style="font-size:11px;color:#7a8a9a;">(wholesale)</span>
                                </p>
                            </div>
                        </div>
                        <div style="background:#fff;border:1px solid #e7e0d4;border-radius:10px;padding:1.3rem;display:flex;align-items:flex-start;gap:.9rem;">
                            <div style="width:40px;height:40px;border-radius:8px;background:rgba(232,100,26,.1);border:1px solid rgba(232,100,26,.2);display:flex;align-items:center;justify-content:center;color:#e8641a;flex-shrink:0;">
                                <i class="bi bi-telephone" style="font-size:1.2rem;"/>
                            </div>
                            <div>
                                <h4 style="font-size:13px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Phone</h4>
                                <p style="font-size:12px;color:#7a8a9a;line-height:1.6;margin:0;">
                                    <a href="tel:+441705929402" style="color:#e8641a;text-decoration:none;font-weight:600;">+44 1705 929 402</a><br/>
                                    Mon – Fri, 9 am – 5 pm GMT
                                </p>
                            </div>
                        </div>
                        <div style="background:#fff;border:1px solid #e7e0d4;border-radius:10px;padding:1.3rem;display:flex;align-items:flex-start;gap:.9rem;">
                            <div style="width:40px;height:40px;border-radius:8px;background:rgba(232,100,26,.1);border:1px solid rgba(232,100,26,.2);display:flex;align-items:center;justify-content:center;color:#e8641a;flex-shrink:0;">
                                <i class="bi bi-geo-alt" style="font-size:1.2rem;"/>
                            </div>
                            <div>
                                <h4 style="font-size:13px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Address</h4>
                                <p style="font-size:12px;color:#7a8a9a;line-height:1.6;margin:0;">12 Harbour Way<br/>Portsmouth, PO1 2AB<br/>United Kingdom</p>
                            </div>
                        </div>
                        <div style="background:#fff;border:1px solid #e7e0d4;border-radius:10px;padding:1.3rem;display:flex;align-items:flex-start;gap:.9rem;">
                            <div style="width:40px;height:40px;border-radius:8px;background:rgba(232,100,26,.1);border:1px solid rgba(232,100,26,.2);display:flex;align-items:center;justify-content:center;color:#e8641a;flex-shrink:0;">
                                <i class="bi bi-truck" style="font-size:1.2rem;"/>
                            </div>
                            <div>
                                <h4 style="font-size:13px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Dispatch &amp; returns</h4>
                                <p style="font-size:12px;color:#7a8a9a;line-height:1.6;margin:0;">Orders dispatched within 48 hrs.<br/>30-day no-fuss return policy.</p>
                            </div>
                        </div>
                        <div style="background:#fff;border:1px solid #e7e0d4;border-radius:10px;padding:1.3rem;display:flex;align-items:flex-start;gap:.9rem;">
                            <div style="width:40px;height:40px;border-radius:8px;background:rgba(232,100,26,.1);border:1px solid rgba(232,100,26,.2);display:flex;align-items:center;justify-content:center;color:#e8641a;flex-shrink:0;">
                                <i class="bi bi-building" style="font-size:1.2rem;"/>
                            </div>
                            <div>
                                <h4 style="font-size:13px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Trade accounts</h4>
                                <p style="font-size:12px;color:#7a8a9a;line-height:1.6;margin:0;">Discounts from 10 – 30% on volume. Email <a href="mailto:trade@cordage.com" style="color:#e8641a;text-decoration:none;font-weight:600;">trade@cordage.com</a> to apply.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- FAQ SECTION -->
                <section id="faq" class="contact-faq-section">
                    <div style="max-width:760px;margin:0 auto;">
                        <div style="margin-bottom:2rem;">
                            <h2 style="font-size:clamp(1.4rem,3vw,1.9rem);font-weight:700;color:#16202e;letter-spacing:-.025em;margin-bottom:.4rem;">Frequently asked questions</h2>
                            <p style="font-size:14px;color:#7a8a9a;">Quick answers to the questions we hear most often.</p>
                        </div>
                        <div class="faq-list" style="display:flex;flex-direction:column;gap:.5rem;">

                            <div class="ct-faq-item" style="border:1px solid #e7e0d4;border-radius:10px;overflow:hidden;">
                                <button class="ct-faq-q" style="width:100%;background:none;border:0;padding:15px 18px;text-align:left;font-weight:700;font-size:14px;cursor:pointer;color:#16202e;display:flex;justify-content:space-between;align-items:center;gap:1rem;">
                                    Do you really cut rope to any length?
                                    <i class="bi bi-chevron-down" style="color:#7a8a9a;font-size:1.1rem;flex-shrink:0;transition:transform .25s;"/>
                                </button>
                                <div class="ct-faq-a" style="max-height:0;overflow:hidden;transition:max-height .3s ease;">
                                    <p style="padding:0 18px 15px;font-size:13px;color:#7a8a9a;line-height:1.7;">Yes — every product is sold by the metre and cut to your exact specification at dispatch. Enter your required length at checkout. Minimum order is 1 metre, there is no maximum.</p>
                                </div>
                            </div>
                            <div class="ct-faq-item" style="border:1px solid #e7e0d4;border-radius:10px;overflow:hidden;">
                                <button class="ct-faq-q" style="width:100%;background:none;border:0;padding:15px 18px;text-align:left;font-weight:700;font-size:14px;cursor:pointer;color:#16202e;display:flex;justify-content:space-between;align-items:center;gap:1rem;">
                                    How quickly will my order arrive?
                                    <i class="bi bi-chevron-down" style="color:#7a8a9a;font-size:1.1rem;flex-shrink:0;transition:transform .25s;"/>
                                </button>
                                <div class="ct-faq-a" style="max-height:0;overflow:hidden;transition:max-height .3s ease;">
                                    <p style="padding:0 18px 15px;font-size:13px;color:#7a8a9a;line-height:1.7;">All in-stock orders are dispatched within 48 working hours. UK delivery typically takes 2 – 3 days after dispatch. We ship to over 40 countries — estimated transit times are shown at checkout.</p>
                                </div>
                            </div>
                            <div class="ct-faq-item" style="border:1px solid #e7e0d4;border-radius:10px;overflow:hidden;">
                                <button class="ct-faq-q" style="width:100%;background:none;border:0;padding:15px 18px;text-align:left;font-weight:700;font-size:14px;cursor:pointer;color:#16202e;display:flex;justify-content:space-between;align-items:center;gap:1rem;">
                                    What is WLL and how is it different from breaking strength?
                                    <i class="bi bi-chevron-down" style="color:#7a8a9a;font-size:1.1rem;flex-shrink:0;transition:transform .25s;"/>
                                </button>
                                <div class="ct-faq-a" style="max-height:0;overflow:hidden;transition:max-height .3s ease;">
                                    <p style="padding:0 18px 15px;font-size:13px;color:#7a8a9a;line-height:1.7;">WLL (Working Load Limit) is the maximum safe load during normal use — it includes an appropriate safety factor. Breaking Strength is the load at which the rope will fail under test conditions, typically 3 – 4× the WLL. Always design to WLL, never to breaking strength.</p>
                                </div>
                            </div>
                            <div class="ct-faq-item" style="border:1px solid #e7e0d4;border-radius:10px;overflow:hidden;">
                                <button class="ct-faq-q" style="width:100%;background:none;border:0;padding:15px 18px;text-align:left;font-weight:700;font-size:14px;cursor:pointer;color:#16202e;display:flex;justify-content:space-between;align-items:center;gap:1rem;">
                                    Can I return a rope cut to my specification?
                                    <i class="bi bi-chevron-down" style="color:#7a8a9a;font-size:1.1rem;flex-shrink:0;transition:transform .25s;"/>
                                </button>
                                <div class="ct-faq-a" style="max-height:0;overflow:hidden;transition:max-height .3s ease;">
                                    <p style="padding:0 18px 15px;font-size:13px;color:#7a8a9a;line-height:1.7;">Cut lengths cannot be returned unless there is a manufacturing fault. Unopened standard-length products can be returned within 30 days. Contact us within 48 hours of delivery if there is a problem and we will resolve it quickly.</p>
                                </div>
                            </div>
                            <div class="ct-faq-item" style="border:1px solid #e7e0d4;border-radius:10px;overflow:hidden;">
                                <button class="ct-faq-q" style="width:100%;background:none;border:0;padding:15px 18px;text-align:left;font-weight:700;font-size:14px;cursor:pointer;color:#16202e;display:flex;justify-content:space-between;align-items:center;gap:1rem;">
                                    Do you offer trade or wholesale pricing?
                                    <i class="bi bi-chevron-down" style="color:#7a8a9a;font-size:1.1rem;flex-shrink:0;transition:transform .25s;"/>
                                </button>
                                <div class="ct-faq-a" style="max-height:0;overflow:hidden;transition:max-height .3s ease;">
                                    <p style="padding:0 18px 15px;font-size:13px;color:#7a8a9a;line-height:1.7;">Yes — trade accounts receive tiered discounts of 10 – 30% depending on annual volume. Apply by emailing <a href="mailto:trade@cordage.com" style="color:#e8641a;font-weight:600;">trade@cordage.com</a> with your company name, VAT number, and estimated annual spend.</p>
                                </div>
                            </div>
                            <div class="ct-faq-item" style="border:1px solid #e7e0d4;border-radius:10px;overflow:hidden;">
                                <button class="ct-faq-q" style="width:100%;background:none;border:0;padding:15px 18px;text-align:left;font-weight:700;font-size:14px;cursor:pointer;color:#16202e;display:flex;justify-content:space-between;align-items:center;gap:1rem;">
                                    I'm not sure which rope to specify — can you help?
                                    <i class="bi bi-chevron-down" style="color:#7a8a9a;font-size:1.1rem;flex-shrink:0;transition:transform .25s;"/>
                                </button>
                                <div class="ct-faq-a" style="max-height:0;overflow:hidden;transition:max-height .3s ease;">
                                    <p style="padding:0 18px 15px;font-size:13px;color:#7a8a9a;line-height:1.7;">Absolutely. Send us a message describing your application, working load, environment (indoor / outdoor / marine), and any certification requirements. Our team specifies rope for engineers and riggers daily and will respond with a recommendation — usually within the same business day.</p>
                                </div>
                            </div>
                            <div class="ct-faq-item" style="border:1px solid #e7e0d4;border-radius:10px;overflow:hidden;">
                                <button class="ct-faq-q" style="width:100%;background:none;border:0;padding:15px 18px;text-align:left;font-weight:700;font-size:14px;cursor:pointer;color:#16202e;display:flex;justify-content:space-between;align-items:center;gap:1rem;">
                                    Do your products come with certification documentation?
                                    <i class="bi bi-chevron-down" style="color:#7a8a9a;font-size:1.1rem;flex-shrink:0;transition:transform .25s;"/>
                                </button>
                                <div class="ct-faq-a" style="max-height:0;overflow:hidden;transition:max-height .3s ease;">
                                    <p style="padding:0 18px 15px;font-size:13px;color:#7a8a9a;line-height:1.7;">Yes. CE, ISO 9001, UIAA 101, EN 13414, and EN 1891 documentation is supplied with every order where applicable. If you need a specific certificate format for a site audit or insurance requirement, mention it in your order notes and we'll include it.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- QUICK LINKS -->
                <div class="contact-quick-links">
                    <a href="/shop" style="background:#fff;border:1px solid #e7e0d4;border-radius:10px;padding:1.4rem 1.3rem;display:flex;align-items:center;gap:.9rem;text-decoration:none;">
                        <div style="width:42px;height:42px;border-radius:8px;background:rgba(232,100,26,.1);border:1px solid rgba(232,100,26,.2);display:flex;align-items:center;justify-content:center;color:#e8641a;flex-shrink:0;">
                            <i class="bi bi-tag" style="font-size:1.2rem;"/>
                        </div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#16202e;">Browse products</div>
                            <div style="font-size:12px;color:#7a8a9a;margin-top:1px;">12 certified rope products</div>
                        </div>
                    </a>
                    <a href="/industries" style="background:#fff;border:1px solid #e7e0d4;border-radius:10px;padding:1.4rem 1.3rem;display:flex;align-items:center;gap:.9rem;text-decoration:none;">
                        <div style="width:42px;height:42px;border-radius:8px;background:rgba(232,100,26,.1);border:1px solid rgba(232,100,26,.2);display:flex;align-items:center;justify-content:center;color:#e8641a;flex-shrink:0;">
                            <i class="bi bi-building-gear" style="font-size:1.2rem;"/>
                        </div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#16202e;">Industries we serve</div>
                            <div style="font-size:12px;color:#7a8a9a;margin-top:1px;">Oil &amp; gas, marine, construction…</div>
                        </div>
                    </a>
                    <a href="/aboutus" style="background:#fff;border:1px solid #e7e0d4;border-radius:10px;padding:1.4rem 1.3rem;display:flex;align-items:center;gap:.9rem;text-decoration:none;">
                        <div style="width:42px;height:42px;border-radius:8px;background:rgba(232,100,26,.1);border:1px solid rgba(232,100,26,.2);display:flex;align-items:center;justify-content:center;color:#e8641a;flex-shrink:0;">
                            <i class="bi bi-info-circle" style="font-size:1.2rem;"/>
                        </div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#16202e;">About CORDAGE</div>
                            <div style="font-size:12px;color:#7a8a9a;margin-top:1px;">ISO 9001 certified since 1971</div>
                        </div>
                    </a>
                </div>
                <!-- FAQ accordion JS -->
                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function() {
                        document.querySelectorAll('.ct-faq-q').forEach(function(btn) {
                            btn.addEventListener('click', function() {
                                var item = btn.closest('.ct-faq-item');
                                var answer = btn.nextElementSibling;
                                var isOpen = item.classList.contains('faq-open');
                                document.querySelectorAll('.ct-faq-item').forEach(function(i) {
                                    i.classList.remove('faq-open');
                                    i.querySelector('.ct-faq-a').style.maxHeight = '0';
                                    var icon = i.querySelector('.bi-chevron-down');
                                    if (icon) icon.style.transform = '';
                                });
                                if (!isOpen) {
                                    item.classList.add('faq-open');
                                    item.style.borderColor = '#e8641a';
                                    answer.style.maxHeight = answer.scrollHeight + 'px';
                                    var icon = btn.querySelector('.bi-chevron-down');
                                    if (icon) icon.style.transform = 'rotate(180deg)';
                                }
                            });
                        });
                    });
                </script>
            </div>
        </xpath>
    </template>
</odoo>
