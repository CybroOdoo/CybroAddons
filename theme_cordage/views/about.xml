<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- About Us Page - styled to match cordage_example/about.html -->
    <template id="cordage_about_page" name="About Us page" key="theme_cordage.cordage_about_page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- PAGE HERO / BREADCRUMB -->
                <div style="background:var(--color-menu-topbar-bg, #f8f7f5); border-bottom:1px solid #e7e0d4; padding:48px 4rem 40px;">
                    <nav style="display:flex;align-items:center;gap:.4rem;font-size:12px;color:#7a8a9a;margin-bottom:1rem;">
                        <a href="/" style="color:#7a8a9a;text-decoration:none;">Home</a>
                        <span>›</span>
                        <span style="color:#16202e;">About</span>
                    </nav>
                    <h1 style="font-size:clamp(1.8rem,4vw,2.8rem);font-weight:700;color:#16202e;letter-spacing:-.025em;margin-bottom:.6rem;">About CORDAGE</h1>
                    <p style="font-size:15px;color:#7a8a9a;max-width:620px;line-height:1.7;">Supplying certified industrial, marine, fabric and climbing ropes since 1971. Every metre tested, documented, and cut to your exact specification.</p>
                </div>
                <!-- STATS BAR -->
                <t t-call="theme_cordage.s_stats_bar"/>
                <!-- OUR STORY & FACTS -->
                <t t-call="theme_cordage.s_story_facts"/>
                <!-- HOW WE OPERATE -->
                <t t-call="theme_cordage.s_values_grid"/>
                <!-- CERTIFICATIONS -->
                <t t-call="theme_cordage.s_certifications_band"/>
                <!-- TEAM -->
                <t t-call="theme_cordage.s_team_grid"/>
                <!-- TIMELINE -->
                <section style="padding:64px 4rem;background:#fffdf9;">
                    <div style="text-align:center;max-width:580px;margin:0 auto 2.6rem;">
                        <h2 style="font-size:clamp(1.5rem,3vw,2.1rem);font-weight:700;color:#16202e;letter-spacing:-.025em;">Company milestones</h2>
                    </div>
                    <div style="max-width:660px;margin:0 auto;position:relative;padding-left:2.2rem;border-left:2px solid #e7e0d4;">
                        <div style="position:relative;margin-bottom:2.2rem;">
                            <div style="position:absolute;left:-1.85rem;top:.3rem;width:14px;height:14px;border-radius:50%;background:#e8641a;border:2.5px solid #fffdf9;box-shadow:0 0 0 3px rgba(232,100,26,.22);"/>
                            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#e8641a;margin-bottom:.25rem;">1971</div>
                            <div style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Founded in Portsmouth</div>
                            <div style="font-size:13px;color:#7a8a9a;line-height:1.65;">Started as a dockside rope supplier serving local fishermen and harbour workers. First year revenue: £4,200.</div>
                        </div>
                        <div style="position:relative;margin-bottom:2.2rem;">
                            <div style="position:absolute;left:-1.85rem;top:.3rem;width:14px;height:14px;border-radius:50%;background:#e8641a;border:2.5px solid #fffdf9;box-shadow:0 0 0 3px rgba(232,100,26,.22);"/>
                            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#e8641a;margin-bottom:.25rem;">1989</div>
                            <div style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Synthetic rope manufacturing</div>
                            <div style="font-size:13px;color:#7a8a9a;line-height:1.65;">Expanded into polypropylene and polyester production. Achieved first ISO quality certification.</div>
                        </div>
                        <div style="position:relative;margin-bottom:2.2rem;">
                            <div style="position:absolute;left:-1.85rem;top:.3rem;width:14px;height:14px;border-radius:50%;background:#e8641a;border:2.5px solid #fffdf9;box-shadow:0 0 0 3px rgba(232,100,26,.22);"/>
                            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#e8641a;margin-bottom:.25rem;">2002</div>
                            <div style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Online ordering launches</div>
                            <div style="font-size:13px;color:#7a8a9a;line-height:1.65;">First UK rope supplier to offer cut-to-length ordering online. 1,400 orders placed in year one.</div>
                        </div>
                        <div style="position:relative;margin-bottom:2.2rem;">
                            <div style="position:absolute;left:-1.85rem;top:.3rem;width:14px;height:14px;border-radius:50%;background:#e8641a;border:2.5px solid #fffdf9;box-shadow:0 0 0 3px rgba(232,100,26,.22);"/>
                            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#e8641a;margin-bottom:.25rem;">2011</div>
                            <div style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.3rem;">ISO 9001 certification</div>
                            <div style="font-size:13px;color:#7a8a9a;line-height:1.65;">Full quality management system certified across manufacturing, testing, and supply operations.</div>
                        </div>
                        <div style="position:relative;margin-bottom:2.2rem;">
                            <div style="position:absolute;left:-1.85rem;top:.3rem;width:14px;height:14px;border-radius:50%;background:#e8641a;border:2.5px solid #fffdf9;box-shadow:0 0 0 3px rgba(232,100,26,.22);"/>
                            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#e8641a;margin-bottom:.25rem;">2015</div>
                            <div style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Climbing &amp; safety rope range</div>
                            <div style="font-size:13px;color:#7a8a9a;line-height:1.65;">UIAA-certified dynamic and static ropes added. CE certifications applied across the full catalogue.</div>
                        </div>
                        <div style="position:relative;margin-bottom:2.2rem;">
                            <div style="position:absolute;left:-1.85rem;top:.3rem;width:14px;height:14px;border-radius:50%;background:#e8641a;border:2.5px solid #fffdf9;box-shadow:0 0 0 3px rgba(232,100,26,.22);"/>
                            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#e8641a;margin-bottom:.25rem;">2022</div>
                            <div style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Fabric &amp; craft range</div>
                            <div style="font-size:13px;color:#7a8a9a;line-height:1.65;">Cotton, macramé, and coloured rope range launched. Customer base exceeds 8,000 active accounts.</div>
                        </div>
                        <div style="position:relative;">
                            <div style="position:absolute;left:-1.85rem;top:.3rem;width:14px;height:14px;border-radius:50%;background:#e8641a;border:2.5px solid #fffdf9;box-shadow:0 0 0 3px rgba(232,100,26,.22);"/>
                            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#e8641a;margin-bottom:.25rem;">Today</div>
                            <div style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.3rem;">Shipping worldwide</div>
                            <div style="font-size:13px;color:#7a8a9a;line-height:1.65;">12 core products, 40+ countries, 50+ years of expertise. The same principle as 1971.</div>
                        </div>
                    </div>
                </section>
                <!-- CTA BANNER -->
                <section style="background:#e8641a;padding:64px 4rem;text-align:center;">
                    <h2 style="font-size:clamp(1.6rem,3.5vw,2.2rem);font-weight:700;color:#fff;margin-bottom:.6rem;">Ready to find the right rope?</h2>
                    <p style="color:rgba(255,255,255,.82);font-size:15px;max-width:500px;margin:0 auto 1.8rem;line-height:1.65;">Browse our full catalogue or speak with our technical team. We'll spec the exact product for your application.</p>
                    <div style="display:flex;align-items:center;justify-content:center;gap:1rem;flex-wrap:wrap;">
                        <a href="/shop" style="display:inline-flex;align-items:center;gap:8px;background:#fff;color:#e8641a;border:0;border-radius:999px;padding:11px 26px;font-weight:700;font-size:14px;text-decoration:none;">
                            <i class="bi bi-tag"/> Browse products
                        </a>
                        <a href="/contactus" style="display:inline-flex;align-items:center;gap:8px;background:transparent;color:#fff;border:2px solid rgba(255,255,255,.5);border-radius:999px;padding:11px 26px;font-weight:700;font-size:14px;text-decoration:none;">
                            <i class="bi bi-envelope"/> Contact our team
                        </a>
                    </div>
                </section>
            </div>
        </t>
    </template>
    <!-- Register /aboutus route -->
    <record id="cordage_about_theme_page" model="theme.website.page">
        <field name="url">/aboutus</field>
        <field name="view_id" ref="cordage_about_page"/>
        <field name="is_published">True</field>
    </record>
    <!-- About Menu -->
    <record id="theme_cordage.theme_menu_about" model="theme.website.menu">
        <field name="name">About Us</field>
        <field name="url">/aboutus</field>
        <field name="page_id" ref="cordage_about_theme_page"/>
        <field name="use_main_menu_as_parent">True</field>
        <field name="sequence" type="int">20</field>
    </record>
</odoo>
