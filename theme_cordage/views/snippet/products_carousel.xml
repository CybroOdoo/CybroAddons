<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dynamic Products Carousel Template -->
    <template id="s_products_carousel" name="Cordage Products Carousel">
        <t t-set="carousel_products" t-value="request.env['product.template'].sudo().search([('website_published', '=', True)], limit=8)"/>
        <section class="section s_products_carousel o_colored_level" data-snippet="theme_cordage.s_products_carousel" data-name="Products Carousel">
            <div class="container text-center">
                <div class="section-eyebrow justify-content-center mb-2">
                    <div class="eyebrow-line"/>
                    <span class="eyebrow-text">Product Showcase</span>
                    <div class="eyebrow-line"/>
                </div>
                <h2 class="mb-5">Featured High-Strength Catalog</h2>
                <t t-if="carousel_products">
                    <div id="cordageFeaturedCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            <t t-set="prod_slices" t-value="[carousel_products[i:i+4] for i in range(0, len(carousel_products), 4)]"/>
                            <t t-foreach="prod_slices" t-as="slice">
                                <div t-attf-class="carousel-item #{'active' if slice_index == 0 else ''}">
                                    <div class="row">
                                        <t t-foreach="slice" t-as="product">
                                            <div class="col-lg-3 col-md-6 mb-4">
                                                <div class="card h-100 border-0 shadow-sm rounded-lg overflow-hidden" style="border: 1px solid #e7e0d4 !important;">
                                                    <div class="position-relative bg-light aspect-ratio-1-1" style="min-height: 200px;">
                                                        <a t-attf-href="/shop/product/#{slug(product)}">
                                                            <img t-attf-src="/web/image/product.template/#{product.id}/image_1920" class="img img-fluid w-100" t-att-alt="product.name" style="height: 200px; object-fit: cover;"/>
                                                        </a>
                                                        <span class="position-absolute top-2 start-2 badge bg-warning text-dark font-weight-bold uppercase" style="top: 10px; left: 10px;">CE Tested</span>
                                                    </div>
                                                    <div class="card-body p-3 text-start d-flex flex-column justify-content-between">
                                                        <div>
                                                            <h5 class="card-title font-weight-bold mb-1" style="font-size: 1.15rem;">
                                                                <a t-attf-href="/shop/product/#{slug(product)}" class="text-dark" t-esc="product.name" style="text-decoration: none;"/>
                                                            </h5>
                                                            <p class="text-muted" style="font-size: 0.85rem;" t-esc="product.description_sale or 'Premium heavy load spec rigging line.'"/>
                                                        </div>
                                                        <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-2">
                                                            <span class="font-weight-bold text-dark h5 mb-0" style="font-size: 1.2rem;" t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': (website and website.currency_id) or request.env.company.currency_id}"/>
                                                            <a t-attf-href="/shop/product/#{slug(product)}" class="btn btn-warning rounded-0 px-3 py-1 text-dark btn-sm font-weight-bold">View Specs</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <!-- Controls -->
                        <t t-if="len(prod_slices) &gt; 1">
                            <button class="carousel-control-prev" type="button" data-bs-target="#cordageFeaturedCarousel" data-bs-slide="prev" style="width: 5%; filter: invert(1);">
                                <span class="carousel-control-prev-icon" aria-hidden="true"/>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#cordageFeaturedCarousel" data-bs-slide="next" style="width: 5%; filter: invert(1);">
                                <span class="carousel-control-next-icon" aria-hidden="true"/>
                            </button>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center py-5">
                        <p class="text-muted">No products configured for eCommerce. Add standard products to display them here.</p>
                    </div>
                </t>
            </div>
        </section>
    </template>
    <!-- Register Products Carousel Snippet in builder structure -->
    <template id="s_products_carousel_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_products_carousel"
               string="Featured Showcase"
               t-thumbnail="/theme_cordage/static/src/img/img3.jpg"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
