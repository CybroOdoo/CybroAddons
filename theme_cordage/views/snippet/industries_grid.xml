<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dynamic Industries Grid Template -->
    <template id="s_industries_grid" name="Cordage Industries Grid">
        <t t-set="shop_categories" t-value="request.env['product.public.category'].sudo().search([], order='sequence asc', limit=6)"/>
        <section class="section s_industries_grid o_colored_level" data-snippet="theme_cordage.s_industries_grid" data-name="Industries Grid">
            <div class="container text-center">
                <div class="section-eyebrow justify-content-center mb-2">
                    <div class="eyebrow-line"/>
                    <span class="eyebrow-text">Industries We Serve</span>
                    <div class="eyebrow-line"/>
                </div>
                <h2 class="mb-4">Engineered for every sector</h2>
                <p class="text-muted mb-5" style="max-width: 680px; margin: 0 auto;">From offshore platforms to craft studios - if it needs a rope, we have it certified and in stock.</p>
                <t t-if="shop_categories">
                    <div class="row">
                        <t t-foreach="shop_categories" t-as="cat">
                            <div class="col-lg-4 col-md-6 mb-4">
                                <a t-attf-href="/shop/category/#{slug(cat)}" class="cat-card-custom d-block" t-attf-style="background-image: url('/web/image/product.public.category/#{cat.id}/image_1920' if cat.image_1920 else '/theme_cordage/static/src/img/img10.webp');">
                                    <div class="cat-label text-start">
                                        <span class="d-block text-warning font-weight-bold mb-1">Engineered Spec</span>
                                        <strong t-esc="cat.name"/>
                                    </div>
                                    <div class="cat-icon text-white">
                                        <i class="bi bi-box-arrow-in-up-right"/>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="row">
                        <!-- Fallback Static Cards when no categories configured in db -->
                        <div class="col-lg-4 col-md-6 mb-4">
                            <a href="/shop" class="cat-card-custom d-block" style="background-image: url('/theme_cordage/static/src/img/img10.webp');">
                                <div class="cat-label text-start">
                                    <span class="d-block text-warning font-weight-bold mb-1">Offshore / Maritime</span>
                                    <strong>Oil &amp; Gas Rigging</strong>
                                </div>
                            </a>
                        </div>
                        <div class="col-lg-4 col-md-6 mb-4">
                            <a href="/shop" class="cat-card-custom d-block" style="background-image: url('/theme_cordage/static/src/img/img11.webp');">
                                <div class="cat-label text-start">
                                    <span class="d-block text-warning font-weight-bold mb-1">Heavy Cranes</span>
                                    <strong>Construction Safety</strong>
                                </div>
                            </a>
                        </div>
                        <div class="col-lg-4 col-md-6 mb-4">
                            <a href="/shop" class="cat-card-custom d-block" style="background-image: url('/theme_cordage/static/src/img/img12.webp');">
                                <div class="cat-label text-start">
                                    <span class="d-block text-warning font-weight-bold mb-1">Harbour / Ports</span>
                                    <strong>Maritime Mooring</strong>
                                </div>
                            </a>
                        </div>
                    </div>
                </t>
            </div>
        </section>
    </template>
    <!-- Register Industries Grid Snippet in builder structure -->
    <template id="s_industries_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_industries_grid"
               string="Industries Grid"
               t-thumbnail="/theme_cordage/static/src/img/img10.webp"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
