<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Snippet Groups registration inside website builder -->
    <template id="cordage_snippet_groups" inherit_id="website.snippets" name="Cordage Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_cordage/static/description/icon.png"
               string="Cordage Ropes"
               snippet-group="cordage_section"/>
        </xpath>
    </template>
</odoo>
