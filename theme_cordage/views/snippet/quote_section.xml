<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom CTA quote request section template -->
    <template id="s_quote_section" name="Cordage Quick Quote">
        <section class="section o_colored_level" data-snippet="theme_cordage.s_quote_section" data-name="Quick Quote" style="background-color: #16202e;">
            <div class="container text-center text-white py-4">
                <h2 class="font-weight-bold mb-3 o_editable">Ready to order high-spec rigging ropes?</h2>
                <p class="text-muted-light mb-4 o_editable" style="max-width: 600px; margin: 0 auto; color: #b9c4d0;">Our trade support desk handles corporate bulk requests, load testing certifications, and custom reel splice requests.</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="/contactus" class="btn-primary-custom">Get Custom Spec Quote</a>
                    <a href="/shop" class="btn-outline-custom">Browse Full Catalog</a>
                </div>
            </div>
        </section>
    </template>
    <!-- Register CTA band inside structural widgets -->
    <template id="s_quote_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_quote_section"
               string="Quick Spec Band"
               t-thumbnail="/theme_cordage/static/src/img/fav.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
