<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Our story page-->
    <template id="s_story_facts" name="Cordage Our Story &amp; Facts">
        <section class="s_story_facts o_colored_level" data-snippet="theme_cordage.s_story_facts" data-name="Our Story &amp; Facts" style="padding:72px 4rem;background:#fffdf9;">
            <div class="container">
                <div class="row align-items-start g-5">
                    <!-- Left: Story Text -->
                    <div class="col-lg-7 text-start">
                        <h2 class="o_editable" style="font-size:clamp(1.5rem,3vw,2.1rem);font-weight:700;color:#16202e;letter-spacing:-.025em;margin-bottom:1.2rem;">50 years of craft.<br/>One standard of quality.</h2>
                        <p class="o_editable" style="font-size:14px;color:#6b7a8d;line-height:1.8;margin-bottom:1rem;">CORDAGE began in 1971 as a small dockside supplier in Portsmouth — coiling and cutting rope for fishermen and harbor workers. Every customer came through the door and knew us by name.</p>
                        <p class="o_editable" style="font-size:14px;color:#6b7a8d;line-height:1.8;margin-bottom:1rem;">Fifty years later, we serve engineers, riggers, marine operators, climbers, and makers across the globe. Our range has grown, but the standard has not moved a millimetre.</p>
                        <blockquote class="o_editable" style="border-left:3px solid #e8641a;padding:.8rem 1.2rem;margin:1.4rem 0;background:rgba(232,100,26,.06);border-radius:0 6px 6px 0;font-size:15px;font-style:italic;color:#16202e;line-height:1.6;">
                            "If we wouldn't put it on our own boat or rigging, we won't sell it to you."
                        </blockquote>
                        <p class="o_editable" style="font-size:14px;color:#6b7a8d;line-height:1.8;margin-bottom:1rem;">That principle shapes every buying decision, every supplier audit, and every load test we run. It's why customers who placed their first order in 2002 are still with us today.</p>
                    </div>
                    <!-- Right: Facts Card -->
                    <div class="col-lg-5">
                        <div class="bg-white border border-secondary border-opacity-10 rounded p-4 shadow-sm" style="border-radius:0;">
                            <div class="d-inline-flex align-items-center gap-2 text-warning bg-warning bg-opacity-10 border border-warning border-opacity-20 px-3 py-1 rounded mb-3" style="font-size:12px;font-weight:700;color:#e8641a !important;background:rgba(232,100,26,.1) !important;border:1px solid rgba(232,100,26,.2) !important;">
                                <i class="fa fa-anchor"/> Est. Portsmouth, 1971
                            </div>
                            <div class="d-flex align-items-start gap-3 py-3 border-bottom border-secondary border-opacity-10">
                                <i class="bi bi-scissors text-warning" style="color:#e8641a;font-size:1.25rem;flex-shrink:0;margin-top:2px;"/>
                                <div>
                                    <div class="font-weight-bold o_editable" style="font-size:13px;font-weight:700;color:#16202e;">Cut to your exact length</div>
                                    <div class="o_editable" style="font-size:12px;color:#7a8a9a;margin-top:2px;">1 metre to unlimited — no minimum, no waste charge</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-3 py-3 border-bottom border-secondary border-opacity-10">
                                <i class="bi bi-file-earmark-text text-warning" style="color:#e8641a;font-size:1.25rem;flex-shrink:0;margin-top:2px;"/>
                                <div>
                                    <div class="font-weight-bold o_editable" style="font-size:13px;font-weight:700;color:#16202e;">Full certification on every order</div>
                                    <div class="o_editable" style="font-size:12px;color:#7a8a9a;margin-top:2px;">CE, ISO, UIAA, EN 13414 documentation included</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-3 py-3 border-bottom border-secondary border-opacity-10">
                                <i class="bi bi-clock-history text-warning" style="color:#e8641a;font-size:1.25rem;flex-shrink:0;margin-top:2px;"/>
                                <div>
                                    <div class="font-weight-bold o_editable" style="font-size:13px;font-weight:700;color:#16202e;">48-hour guaranteed dispatch</div>
                                    <div class="o_editable" style="font-size:12px;color:#7a8a9a;margin-top:2px;">All in-stock orders — or we refund the shipping</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-3 py-3 border-bottom border-secondary border-opacity-10">
                                <i class="bi bi-eyedropper" style="color:#e8641a;font-size:1.25rem;flex-shrink:0;margin-top:2px;"/>
                                <div>
                                    <div class="font-weight-bold o_editable" style="font-size:13px;font-weight:700;color:#16202e;">Batch load-tested</div>
                                    <div class="o_editable" style="font-size:12px;color:#7a8a9a;margin-top:2px;">WLL and breaking strength published per product</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-3 py-3">
                                <i class="bi bi-headset" style="color:#e8641a;font-size:1.25rem;flex-shrink:0;margin-top:2px;"/>
                                <div>
                                    <div class="font-weight-bold o_editable" style="font-size:13px;font-weight:700;color:#16202e;">Technical support</div>
                                    <div class="o_editable" style="font-size:12px;color:#7a8a9a;margin-top:2px;">We spec rope for engineers and riggers daily</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register in Website Builder under Cordage Ropes group -->
    <template id="s_story_facts_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_story_facts"
               string="Story &amp; Facts"
               t-thumbnail="/theme_cordage/static/src/img/fav.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
