<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Core Values Grid -->
    <template id="s_values_grid" name="Cordage Core Values">
        <section class="s_values_grid o_colored_level" data-snippet="theme_cordage.s_values_grid" data-name="Core Values Grid" style="padding:64px 4rem;background:#f7f2ea;">
            <div class="container">
                <div class="text-center mx-auto mb-5" style="max-width:580px;">
                    <h2 class="o_editable" style="font-size:clamp(1.5rem,3vw,2.1rem);font-weight:700;color:#16202e;letter-spacing:-.025em;margin-bottom:.5rem;">How we operate</h2>
                    <p class="o_editable" style="font-size:14px;color:#7a8a9a;line-height:1.65;">Six principles that shape every decision, from supplier selection to how we answer the phone.</p>
                </div>
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    <!-- Value 1 -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4">
                            <div class="values-icon d-flex align-items-center justify-content-center mb-3">
                                <i class="bi bi-search" style="font-size:1.35rem;"/>
                            </div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.4rem;">Rigorous testing</h3>
                            <p class="o_editable" style="font-size:13px;color:#7a8a9a;line-height:1.65;">Every batch is load-tested before dispatch. We publish WLL and breaking strength on each product page — no estimates, no guesswork.</p>
                        </div>
                    </div>
                    <!-- Value 2 -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4">
                            <div class="values-icon d-flex align-items-center justify-content-center mb-3">
                                <i class="bi bi-scissors" style="font-size:1.35rem;"/>
                            </div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.4rem;">Cut to length</h3>
                            <p class="o_editable" style="font-size:13px;color:#7a8a9a;line-height:1.65;">Order exactly what you need — from 1 m to a full reel. We cut with precision at no extra charge.</p>
                        </div>
                    </div>
                    <!-- Value 3 -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4">
                            <div class="values-icon d-flex align-items-center justify-content-center mb-3">
                                <i class="bi bi-patch-check" style="font-size:1.35rem;"/>
                            </div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.4rem;">Full certification</h3>
                            <p class="o_editable" style="font-size:13px;color:#7a8a9a;line-height:1.65;">CE, ISO 9001, UIAA 101, EN 13414 documentation ships with every qualified order — ready for site audits.</p>
                        </div>
                    </div>
                    <!-- Value 4 -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4">
                            <div class="values-icon d-flex align-items-center justify-content-center mb-3">
                                <i class="bi bi-truck" style="font-size:1.35rem;"/>
                            </div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.4rem;">48-hour dispatch</h3>
                            <p class="o_editable" style="font-size:13px;color:#7a8a9a;line-height:1.65;">Every in-stock order is cut, coiled, labeled, and dispatched within two working days — guaranteed.</p>
                        </div>
                    </div>
                    <!-- Value 5 -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4">
                            <div class="values-icon d-flex align-items-center justify-content-center mb-3">
                                <i class="bi bi-recycle" style="font-size:1.35rem;"/>
                            </div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.4rem;">Responsible sourcing</h3>
                            <p class="o_editable" style="font-size:13px;color:#7a8a9a;line-height:1.65;">Natural fibers from certified sustainable sources. All synthetic fibers meet REACH compliance.</p>
                        </div>
                    </div>
                    <!-- Value 6 -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4">
                            <div class="values-icon d-flex align-items-center justify-content-center mb-3">
                                <i class="bi bi-headset" style="font-size:1.35rem;"/>
                            </div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.4rem;">Real support</h3>
                            <p class="o_editable" style="font-size:13px;color:#7a8a9a;line-height:1.65;">Tell us your load, environment, and certification needs. We'll spec the exact rope — usually within one working day.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register in Website Builder under Cordage Ropes group -->
    <template id="s_values_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_values_grid"
               string="Core Values Grid"
               t-thumbnail="/theme_cordage/static/src/img/fav.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
