<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_stats_bar" name="Cordage Stats Bar">
        <section class="s_stats_bar o_colored_level" data-snippet="theme_cordage.s_stats_bar" data-name="Stats Bar" style="background:#e8641a;padding:26px 4rem;">
            <div class="container">
                <div class="row text-center row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                    <div class="col text-white">
                        <i class="bi bi-calendar-event" style="font-size:1.6rem;opacity:.85;margin-bottom:6px;display:block;"/>
                        <strong class="d-block o_editable" style="font-size:1.9rem;font-weight:800;line-height:1;">1971</strong>
                        <span class="d-block o_editable" style="font-size:11px;text-transform:uppercase;letter-spacing:.09em;opacity:.85;margin-top:3px;">Year founded</span>
                    </div>
                    <div class="col text-white">
                        <i class="bi bi-box-seam" style="font-size:1.6rem;opacity:.85;margin-bottom:6px;display:block;"/>
                        <strong class="d-block o_editable" style="font-size:1.9rem;font-weight:800;line-height:1;">12,000+</strong>
                        <span class="d-block o_editable" style="font-size:11px;text-transform:uppercase;letter-spacing:.09em;opacity:.85;margin-top:3px;">Orders shipped</span>
                    </div>
                    <div class="col text-white">
                        <i class="bi bi-globe" style="font-size:1.6rem;opacity:.85;margin-bottom:6px;display:block;"/>
                        <strong class="d-block o_editable" style="font-size:1.9rem;font-weight:800;line-height:1;">40+</strong>
                        <span class="d-block o_editable" style="font-size:11px;text-transform:uppercase;letter-spacing:.09em;opacity:.85;margin-top:3px;">Countries served</span>
                    </div>
                    <div class="col text-white">
                        <i class="bi bi-patch-check" style="font-size:1.6rem;opacity:.85;margin-bottom:6px;display:block;"/>
                        <strong class="d-block o_editable" style="font-size:1.9rem;font-weight:800;line-height:1;">ISO 9001</strong>
                        <span class="d-block o_editable" style="font-size:11px;text-transform:uppercase;letter-spacing:.09em;opacity:.85;margin-top:3px;">Certified quality</span>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register in Website Builder under Cordage Ropes group -->
    <template id="s_stats_bar_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_stats_bar"
               string="Stats Bar"
               t-thumbnail="/theme_cordage/static/src/img/fav.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
