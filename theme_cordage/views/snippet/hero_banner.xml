<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hero Banner Template -->
    <template id="s_hero_banner" name="Cordage Hero Banner">
        <section class="hero-section s_hero_banner o_colored_level" data-snippet="theme_cordage.s_hero_banner" data-name="Hero Banner">
            <div class="hero-bg">
                <img src="/theme_cordage/static/src/img/rope.jpg" class="img img-fluid o_we_custom_image" alt="Industrial rigging wire ropes heavy lifting equipment"/>
            </div>
            <div class="container z-3">
                <div class="row align-items-center">
                    <div class="col-lg-7 py-5 py-lg-0 text-start">
                        <!-- ISO Badge -->
                        <div class="section-eyebrow text-start mb-3">
                            <div class="eyebrow-line"/>
                            <span class="eyebrow-text text-white">ISO 9001 Certified Industrial Supplier</span>
                        </div>
                        <h1 class="text-white o_editable">Reliable Industrial<br/><span class="accent">Ropes &amp; Rigging</span><br/>Solutions</h1>
                        <p class="o_editable">Engineered for extreme conditions. Trusted by construction, marine, oil &amp; gas, and mining industries worldwide.</p>
                        <div class="d-flex gap-3 flex-wrap">
                            <a href="/shop" class="btn-primary-custom">
                                <i class="bi bi-cart3"/> Shop Now
                            </a>
                            <a href="/contactus" class="btn-outline-custom">
                                <i class="bi bi-file-earmark-text"/> Request Quote
                            </a>
                        </div>
                        <!-- Quick Stats strip inside Hero -->
                        <div class="hero-stats">
                            <div class="stat-item">
                                <strong>12,000+</strong>
                                <span>Orders Shipped</span>
                            </div>
                            <div class="stat-item">
                                <strong>200+</strong>
                                <span>Products in Stock</span>
                            </div>
                            <div class="stat-item">
                                <strong>ISO 9001</strong>
                                <span>Certified Quality</span>
                            </div>
                            <div class="stat-item">
                                <strong>48 hrs</strong>
                                <span>Dispatch Time</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register Hero Banner Snippet inside builder structure -->
    <template id="s_hero_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_hero_banner"
               string="Hero Banner"
               t-thumbnail="/theme_cordage/static/src/img/rope.jpg"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
