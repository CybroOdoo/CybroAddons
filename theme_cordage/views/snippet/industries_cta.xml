<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Snippet: Industries CTA (Call To Action)
        Full-width primary-color band with a headline, sub-copy, and two
        action buttons (Browse all ropes / Talk to our team).
        Mirrors the .in-cta block in cordage_example/industries.html.

        Distinct from s_quote_section (dark navy background, email form).
        This CTA is primary-amber, button-only — suitable for conversion
        points mid-page or at the bottom of the Industries page.

        Usage:
          <t t-call="theme_cordage.s_industries_cta"/>
          or drag from Website Builder → Cordage Ropes → Industries CTA.
    -->
    <template id="s_industries_cta" name="Cordage Industries CTA">
        <section class="in-cta section o_colored_level"
                 data-snippet="theme_cordage.s_industries_cta"
                 data-name="Industries CTA">
            <h2 class="o_editable">Not sure which rope fits your operation?</h2>
            <p class="o_editable">Our technical team specifies rope for procurement managers, site engineers, and riggers every day. Share your load and environment — we'll recommend the right product.</p>
            <div class="in-cta-btns">
                <a href="/shop" class="in-btn-w">
                    <i class="bi bi-tag"/> Browse all ropes
                </a>
                <a href="/contactus" class="in-btn-o">
                    <i class="bi bi-chat-dots"/> Talk to our team
                </a>
            </div>
        </section>
    </template>
    <!-- Register in Website Builder under Cordage Ropes group -->
    <template id="s_industries_cta_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_industries_cta"
               string="Industries CTA"
               t-thumbnail="/theme_cordage/static/src/img/fav.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
