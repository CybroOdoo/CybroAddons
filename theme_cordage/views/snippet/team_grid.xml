<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Team Grid-->
    <template id="s_team_grid" name="Cordage Team Grid">
        <section class="s_team_grid o_colored_level" data-snippet="theme_cordage.s_team_grid" data-name="Team Grid" style="padding:64px 4rem;background:#f7f2ea;">
            <div class="container">
                <div class="text-center mx-auto mb-5" style="max-width:580px;">
                    <h2 class="o_editable" style="font-size:clamp(1.5rem,3vw,2.1rem);font-weight:700;color:#16202e;letter-spacing:-.025em;margin-bottom:.5rem;">The team</h2>
                    <p class="o_editable" style="font-size:14px;color:#7a8a9a;line-height:1.65;">Engineers, sailors, climbers, and craftspeople — united by a shared obsession with rope quality.</p>
                </div>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                    <!-- Helen Carter -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4 text-center" style="background:#fffdf9 !important;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 text-white font-weight-bold" style="width:70px;height:70px;font-size:1.6rem;font-weight:800;background:linear-gradient(135deg,#e8641a,#cc5816);">H</div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.2rem;">Helen Carter</h3>
                            <div class="o_editable" style="font-size:11px;color:#e8641a;font-weight:700;text-transform:uppercase;letter-spacing:.07em;margin-bottom:.6rem;">Founder &amp; CEO</div>
                            <p class="o_editable" style="font-size:12px;color:#7a8a9a;line-height:1.6;">Third-generation rope supplier. Former marine engineer. Still personally approves every new product before it enters the catalogue.</p>
                        </div>
                    </div>
                    <!-- Tom Briggs -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4 text-center" style="background:#fffdf9 !important;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 text-white font-weight-bold" style="width:70px;height:70px;font-size:1.6rem;font-weight:800;background:linear-gradient(135deg,#1a4a80,#2e6898);">T</div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.2rem;">Tom Briggs</h3>
                            <div class="o_editable" style="font-size:11px;color:#e8641a;font-weight:700;text-transform:uppercase;letter-spacing:.07em;margin-bottom:.6rem;">Head of Operations</div>
                            <p class="o_editable" style="font-size:12px;color:#7a8a9a;line-height:1.6;">Runs the cutting floor and dispatch team. Responsible for the 48-hour commitment — and has never missed it in seven years.</p>
                        </div>
                    </div>
                    <!-- Priya Singh -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4 text-center" style="background:#fffdf9 !important;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 text-white font-weight-bold" style="width:70px;height:70px;font-size:1.6rem;font-weight:800;background:linear-gradient(135deg,#2f7d5b,#3aaa78);">P</div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.2rem;">Priya Singh</h3>
                            <div class="o_editable" style="font-size:11px;color:#e8641a;font-weight:700;text-transform:uppercase;letter-spacing:.07em;margin-bottom:.6rem;">Quality &amp; Testing</div>
                            <p class="o_editable" style="font-size:12px;color:#7a8a9a;line-height:1.6;">Materials engineer. Runs all load tests and manages supplier certification audits. The reason our WLL figures can be trusted.</p>
                        </div>
                    </div>
                    <!-- Luca Ferri -->
                    <div class="col">
                        <div class="h-100 bg-white border border-secondary border-opacity-10 rounded p-4 text-center" style="background:#fffdf9 !important;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 text-white font-weight-bold" style="width:70px;height:70px;font-size:1.6rem;font-weight:800;background:linear-gradient(135deg,#6a30a8,#9060d0);">L</div>
                            <h3 class="o_editable" style="font-size:15px;font-weight:700;color:#16202e;margin-bottom:.2rem;">Luca Ferri</h3>
                            <div class="o_editable" style="font-size:11px;color:#e8641a;font-weight:700;text-transform:uppercase;letter-spacing:.07em;margin-bottom:.6rem;">Product Development</div>
                            <p class="o_editable" style="font-size:12px;color:#7a8a9a;line-height:1.6;">Sources new rope categories and develops the fabric and craft range. Also an avid climber — he tests his own product.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register in Website Builder under Cordage Ropes group -->
    <template id="s_team_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_team_grid"
               string="Team Grid"
               t-thumbnail="/theme_cordage/static/src/img/fav.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
