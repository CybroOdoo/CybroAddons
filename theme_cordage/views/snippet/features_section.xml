<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Feature Strip Template -->
    <template id="s_features_section" name="Cordage Features Strip">
        <section class="features-section s_features_section o_colored_level" data-snippet="theme_cordage.s_features_section" data-name="Features Strip">
            <div class="container">
                <div class="row">
                    <div class="col-md-3 mb-4 mb-md-0">
                        <div class="feature-item">
                            <span class="feature-icon"><i class="bi bi-shield-check"/></span>
                            <div>
                                <strong class="o_editable">48-Hr Dispatch</strong>
                                <small class="o_editable">Cut to length &amp; shipped</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4 mb-md-0 border-start-lg border-secondary">
                        <div class="feature-item">
                            <span class="feature-icon"><i class="bi bi-patch-check"/></span>
                            <div>
                                <strong class="o_editable">Fully Certified</strong>
                                <small class="o_editable">ISO 9001 &amp; CE standards</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4 mb-md-0 border-start-lg border-secondary">
                        <div class="feature-item">
                            <span class="feature-icon"><i class="bi bi-truck"/></span>
                            <div>
                                <strong class="o_editable">Global Mooring Shipping</strong>
                                <small class="o_editable">Bulk freight available</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 border-start-lg border-secondary">
                        <div class="feature-item">
                            <span class="feature-icon"><i class="bi bi-gear-wide-connected"/></span>
                            <div>
                                <strong class="o_editable">Bespoke Specs</strong>
                                <small class="o_editable">Custom eyes, splicing &amp; sockets</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register Feature Strip Snippet in builder structure -->
    <template id="s_features_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_features_section"
               string="Features Strip"
               t-thumbnail="/theme_cordage/static/src/img/fav.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
