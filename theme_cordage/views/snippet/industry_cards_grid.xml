<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Snippet: Industry Cards Grid
        A 3-column grid of industry application cards.
        Each card has: icon, heading, description, product tags, and a shop link.
        Mirrors the cordage_example/industries.html sector grid exactly.

        Usage:
          <t t-call="theme_cordage.s_industry_cards_grid"/>
          or drag from the Website Builder under "Cordage Ropes → Industry Cards Grid".
    -->
    <template id="s_industry_cards_grid" name="Cordage Industry Cards Grid">
        <section class="in-sec section o_colored_level"
                 data-snippet="theme_cordage.s_industry_cards_grid"
                 data-name="Industry Cards Grid">
            <div class="container">
                <div class="in-sec-h">
                    <h2 class="o_editable">Applications by sector</h2>
                    <p class="o_editable">Select your industry to browse the right product range, or contact our team for a personalised specification.</p>
                </div>
                <div class="in-grid">
                    <!-- Oil & Gas -->
                    <div class="in-card">
                        <div class="in-card-icon">
                            <i class="bi bi-fire" style="font-size:1.6rem;"/>
                        </div>
                        <h3 class="o_editable">Oil &amp; Gas</h3>
                        <p class="o_editable">Offshore and onshore operations require ropes rated for extreme load, chemical exposure, and saltwater corrosion. Full certification supplied with every order.</p>
                        <div class="in-tags">
                            <span class="in-tag">Wire Rope</span>
                            <span class="in-tag">Mooring Lines</span>
                            <span class="in-tag">Hoist Slings</span>
                        </div>
                        <a href="/shop?search=industrial">
                            Shop industrial <i class="bi bi-arrow-right"/>
                        </a>
                    </div>
                    <!-- Construction -->
                    <div class="in-card">
                        <div class="in-card-icon">
                            <i class="bi bi-buildings" style="font-size:1.6rem;"/>
                        </div>
                        <h3 class="o_editable">Construction</h3>
                        <p class="o_editable">Cranes, hoists, scaffolding, and site lashing — all requiring CE-marked ropes with verifiable WLL ratings and documentation ready for site audits.</p>
                        <div class="in-tags">
                            <span class="in-tag">Hoist Rope</span>
                            <span class="in-tag">Cargo Lashing</span>
                            <span class="in-tag">Manila</span>
                        </div>
                        <a href="/shop?search=industrial">
                            Shop for construction <i class="bi bi-arrow-right"/>
                        </a>
                    </div>
                    <!-- Maritime -->
                    <div class="in-card">
                        <div class="in-card-icon">
                            <i class="fa fa-anchor" style="font-size:1.6rem;"/>
                        </div>
                        <h3 class="o_editable">Maritime</h3>
                        <p class="o_editable">UV-resistant, low-stretch marine braid for mooring and halyards. Shock-absorbing nylon for anchoring. Floating polypropylene for dock and safety lines.</p>
                        <div class="in-tags">
                            <span class="in-tag">Marine Braid</span>
                            <span class="in-tag">Anchor Rope</span>
                            <span class="in-tag">Dock Lines</span>
                        </div>
                        <a href="/shop?search=marine">
                            Shop marine <i class="bi bi-arrow-right"/>
                        </a>
                    </div>
                    <!-- Mining -->
                    <div class="in-card">
                        <div class="in-card-icon">
                            <i class="bi bi-minecart-loaded" style="font-size:1.6rem;"/>
                        </div>
                        <h3 class="o_editable">Mining</h3>
                        <p class="o_editable">High-WLL hoist ropes for shaft access and haulage. Abrasion-resistant construction for underground environments. Batch-tested and fully traceable.</p>
                        <div class="in-tags">
                            <span class="in-tag">Steel Core</span>
                            <span class="in-tag">High WLL</span>
                            <span class="in-tag">Haulage</span>
                        </div>
                        <a href="/shop?search=industrial">
                            Shop for mining <i class="bi bi-arrow-right"/>
                        </a>
                    </div>
                    <!-- Utilities & Access -->
                    <div class="in-card">
                        <div class="in-card-icon">
                            <i class="bi bi-lightning-charge" style="font-size:1.6rem;"/>
                        </div>
                        <h3 class="o_editable">Utilities &amp; Access</h3>
                        <p class="o_editable">Work-at-height ropes for tower access, wind turbine maintenance, and infrastructure inspection. CE EN1891 and UIAA certified for insurance compliance.</p>
                        <div class="in-tags">
                            <span class="in-tag">Static Rope</span>
                            <span class="in-tag">CE EN1891</span>
                            <span class="in-tag">UIAA 101</span>
                        </div>
                        <a href="/shop?search=climbing">
                            Shop safety ropes <i class="bi bi-arrow-right"/>
                        </a>
                    </div>
                    <!-- Logistics & Transport -->
                    <div class="in-card">
                        <div class="in-card-icon">
                            <i class="bi bi-truck" style="font-size:1.6rem;"/>
                        </div>
                        <h3 class="o_editable">Logistics &amp; Transport</h3>
                        <p class="o_editable">Lightweight, rot-proof polypropylene for securing cargo in transit by road, rail, or sea. Easy to handle and consistently rated — no minimum order.</p>
                        <div class="in-tags">
                            <span class="in-tag">Cargo Lashing</span>
                            <span class="in-tag">Polypropylene</span>
                            <span class="in-tag">Lightweight</span>
                        </div>
                        <a href="/shop?search=industrial">
                            Shop lashing ropes <i class="bi bi-arrow-right"/>
                        </a>
                    </div>
                </div><!-- /.in-grid -->
            </div>
        </section>
    </template>
    <!-- Register in Website Builder under Cordage Ropes group -->
    <template id="s_industry_cards_grid_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_industry_cards_grid"
               string="Industry Cards Grid"
               t-thumbnail="/theme_cordage/static/src/img/img10.webp"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
