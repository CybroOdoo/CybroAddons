<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Snippet: Certifications Band
        A 5-column row of certification badges (icon + name + description).
        Mirrors the .in-certs block in cordage_example/industries.html.

        Reusable on any page where trust/accreditation signals are needed
        (About, Product Detail, Industries).

        Usage:
          <t t-call="theme_cordage.s_certifications_band"/>
          or drag from Website Builder → Cordage Ropes → Certifications Band.
    -->
    <template id="s_certifications_band" name="Cordage Certifications Band">
        <section class="in-sec section o_colored_level"
                 data-snippet="theme_cordage.s_certifications_band"
                 data-name="Certifications Band">
            <div class="container">
                <div class="in-sec-h">
                    <h2 class="o_editable">Certifications your teams can rely on</h2>
                    <p class="o_editable">Every applicable product ships with certification documentation — no chasing paperwork before a site audit.</p>
                </div>
                <div class="in-certs">
                    <div class="in-cert">
                        <i class="bi bi-award" style="font-size:1.8rem;color:var(--c-primary);"/>
                        <div class="in-cert-n o_editable">ISO 9001:2015</div>
                        <div class="in-cert-d o_editable">Quality management — manufacturing &amp; supply</div>
                    </div>
                    <div class="in-cert">
                        <i class="bi bi-shield-check" style="font-size:1.8rem;color:var(--c-primary);"/>
                        <div class="in-cert-n o_editable">CE Certified</div>
                        <div class="in-cert-d o_editable">EU safety &amp; performance conformity</div>
                    </div>
                    <div class="in-cert">
                        <i class="bi bi-activity" style="font-size:1.8rem;color:var(--c-primary);"/>
                        <div class="in-cert-n o_editable">UIAA 101</div>
                        <div class="in-cert-d o_editable">Dynamic rope — climbing &amp; access</div>
                    </div>
                    <div class="in-cert">
                        <i class="bi bi-file-earmark-text" style="font-size:1.8rem;color:var(--c-primary);"/>
                        <div class="in-cert-n o_editable">EN 13414</div>
                        <div class="in-cert-d o_editable">Steel wire rope slings — lifting</div>
                    </div>
                    <div class="in-cert">
                        <i class="bi bi-shield-lock" style="font-size:1.8rem;color:var(--c-primary);"/>
                        <div class="in-cert-n o_editable">EN 1891 Type A</div>
                        <div class="in-cert-d o_editable">Static rope — rescue &amp; access</div>
                    </div>
                </div><!-- /.in-certs -->
            </div>
        </section>
    </template>
    <!-- Register in Website Builder under Cordage Ropes group -->
    <template id="s_certifications_band_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_certifications_band"
               string="Certifications Band"
               t-thumbnail="/theme_cordage/static/src/img/fav.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
