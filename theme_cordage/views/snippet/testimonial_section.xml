<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Testimonial Section Template -->
    <template id="s_testimonial_section" name="Cordage Testimonial Section">
        <section class="section o_colored_level" data-snippet="theme_cordage.s_testimonial_section" data-name="Testimonial Section" style="background-color: #f7f2ea;">
            <div class="container text-center">
                <div class="section-eyebrow justify-content-center mb-2">
                    <div class="eyebrow-line"/>
                    <span class="eyebrow-text">Customer Reviews</span>
                    <div class="eyebrow-line"/>
                </div>
                <h2 class="mb-5">Trusted by 12,000+ operators</h2>
                <div class="row">
                    <div class="col-lg-4 mb-4 mb-lg-0 text-start">
                        <div class="testimonial-card h-100">
                            <div class="stars">★★★★★</div>
                            <p class="o_editable">"Used for mooring our offshore supply vessel. Marine double-braid held perfectly - low stretch, UV resistant, and the certification pack was spot-on for our port authority audit."</p>
                            <div class="author">
                                <img src="/theme_cordage/static/src/img/img1.jpg" class="avatar" alt="James T." onerror="this.src='/theme_cordage/static/src/img/fav.png'"/>
                                <div>
                                    <strong class="o_editable">James T.</strong>
                                    <span class="o_editable">Marine Operations Manager, Portsmouth</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 mb-4 mb-lg-0 text-start">
                        <div class="testimonial-card h-100">
                            <div class="stars">★★★★★</div>
                            <p class="o_editable">"Ordered 300 m of steel-core hoist rope for a crane upgrade. Cut to our exact spec, full EN 13414 documentation included. Arrived in 48 hours. Will not use another supplier."</p>
                            <div class="author">
                                <img src="/theme_cordage/static/src/img/img2.jpg" class="avatar" alt="Sarah K." onerror="this.src='/theme_cordage/static/src/img/fav.png'"/>
                                <div>
                                    <strong class="o_editable">Sarah K.</strong>
                                    <span class="o_editable">Site Engineer, Balfour &amp; Co.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 text-start">
                        <div class="testimonial-card h-100">
                            <div class="stars">★★★★★</div>
                            <p class="o_editable">"The UIAA-certified dynamic rope is exceptional. Dry treatment, great handling, and the price per metre is unbeatable for CE-stamped product. Fast dispatch on a large order - very impressed."</p>
                            <div class="author">
                                <img src="/theme_cordage/static/src/img/img3.jpg" class="avatar" alt="Marcus R." onerror="this.src='/theme_cordage/static/src/img/fav.png'"/>
                                <div>
                                    <strong class="o_editable">Marcus R.</strong>
                                    <span class="o_editable">Head Guide, Alpine Access Ltd.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register Testimonials Snippet in builder structure -->
    <template id="s_testimonial_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_testimonial_section"
               string="Rigging Testimonials"
               t-thumbnail="/theme_cordage/static/src/img/fav.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
