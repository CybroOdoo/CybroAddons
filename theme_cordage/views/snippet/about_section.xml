<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- About Section Template -->
    <template id="s_about_section" name="Cordage About Banner">
        <section class="about-section s_about_section o_colored_level" data-snippet="theme_cordage.s_about_section" data-name="About Banner">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-5 mb-5 mb-lg-0 pe-lg-5 text-start">
                        <div class="section-eyebrow text-start mb-2">
                            <div class="eyebrow-line"/>
                            <span class="eyebrow-text">About CORDAGE</span>
                        </div>
                        <h2 class="about-title mb-4 o_editable">High Strength Rigging Solutions Since 1998</h2>
                        <p class="about-text o_editable">At CORDAGE, we specialize in high-performance ropes engineered for ultimate strength and durability. From offshore maritime operations to heavy construction lifting, we provide certified ropes that guarantee safety and absolute reliability in any environment.</p>
                        <a href="/aboutus" class="btn-dark-custom mt-3">Learn our story <i class="bi bi-arrow-right ms-2"/></a>
                    </div>
                    <div class="col-lg-7">
                        <img src="/theme_cordage/static/src/img/img11.webp" class="img img-fluid about-img o_we_custom_image" alt="Construction rigging wire ropes crane hooks"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register About Banner Snippet in builder structure -->
    <template id="s_about_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_about_section"
               string="About Banner"
               t-thumbnail="/theme_cordage/static/src/img/img11.webp"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
