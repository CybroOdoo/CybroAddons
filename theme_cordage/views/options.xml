<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Cordage Snippet Options
    ================================================================= -->
    <template id="snippet_options" inherit_id="website.snippet_options"
              name="Cordage Snippet Options">
        <xpath expr="." position="inside">
            <!-- Certifications options -->
            <div data-js="MultipleItems" data-selector=".s_cordage_certifications">
                <we-row string="Certification">
                    <we-button data-add-item="" data-item=".theme-cordage-certification-item:last" data-select-item="" data-no-preview="true" class="o_we_bg_brand_primary">
                        Add Certification
                    </we-button>
                </we-row>
            </div>
            <div data-selector=".theme-cordage-certification-item" data-drop-near=".theme-cordage-certification-item"/>
            <div data-selector=".s_cordage_hero">
                <we-select string="Hero Layout">
                    <we-button data-select-class="">Left</we-button>
                    <we-button data-select-class="s_cordage_hero--centered">
                        Centered
                    </we-button>
                </we-select>
                <we-select string="Hero Height">
                    <we-button data-select-class="">Large</we-button>
                    <we-button data-select-class="s_cordage_hero--compact">
                        Compact
                    </we-button>
                </we-select>
            </div>
            <div data-selector=".s_cordage_products">
                <we-select string="Product Tabs">
                    <we-button data-select-class="">Show</we-button>
                    <we-button
                            data-select-class="s_cordage_products--hide-tabs">
                        Hide
                    </we-button>
                </we-select>
                <we-select string="Cards">
                    <we-button data-select-class="">Detailed</we-button>
                    <we-button data-select-class="s_cordage_products--compact">
                        Compact
                    </we-button>
                </we-select>
            </div>
            <div data-selector=".s_cordage_testimonials">
                <we-select string="Testimonials">
                    <we-button data-select-class="">Light</we-button>
                    <we-button
                            data-select-class="s_cordage_testimonials--accent">
                        Accent
                    </we-button>
                </we-select>
            </div>
            <div data-selector=".s_cordage_quote">
                <we-select string="Quote Layout">
                    <we-button data-select-class="">Inline</we-button>
                    <we-button data-select-class="s_cordage_quote--stacked">
                        Stacked
                    </we-button>
                </we-select>
            </div>
        </xpath>
    </template>
</odoo>
