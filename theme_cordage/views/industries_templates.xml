<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the industries_templates views/templates for the theme_cordage module. -->
<odoo>
    <!--  Cordage Industries-->
    <template id="industries_page" key="theme_cordage.industries_page" name="Cordage Industries">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'industries'"/>
            <div id="wrap" class="oe_structure">
                <section data-snippet="s_industries_page_content" data-name="Industries Page">
                    <!-- HERO -->
                    <div class="bni-page-offset in-hero">
                        <nav class="in-bc">
                            <a href="/">Home</a>
                            <span>›</span>
                            <span style="color:var(--b-fg)">Industries</span>
                        </nav>
                        <h1>Industries We Serve</h1>
                        <p>Certified ropes for six sectors — from offshore platforms to logistics warehouses. Every
                            product load-rated, documented, and cut to your exact length.
                        </p>
                        <div class="in-hstats">
                            <div class="in-hstat">
                                <iconify-icon icon="tabler:building-factory-2"/>
                                <strong>6</strong>
                                <span>Industries</span>
                            </div>
                            <div class="in-hstat">
                                <iconify-icon icon="tabler:world"/>
                                <strong>40+</strong>
                                <span>Countries</span>
                            </div>
                            <div class="in-hstat">
                                <iconify-icon icon="tabler:certificate"/>
                                <strong>ISO 9001</strong>
                                <span>Certified</span>
                            </div>
                            <div class="in-hstat">
                                <iconify-icon icon="tabler:clock-check"/>
                                <strong>48 hrs</strong>
                                <span>Dispatch</span>
                            </div>
                        </div>
                    </div>
                    <!-- INDUSTRY CARDS -->
                    <section class="in-sec">
                        <div class="in-sec-h">
                            <h2>Applications by sector</h2>
                            <p>Select your industry to browse the right product range, or contact our team for a
                                personalized specification.
                            </p>
                        </div>
                        <div class="in-grid">
                            <div class="in-card">
                                <div class="in-card-icon">
                                    <iconify-icon icon="tabler:flame"/>
                                </div>
                                <h3>Oil &amp; Gas</h3>
                                <p>Offshore and onshore operations require ropes rated for extreme load, chemical
                                    exposure, and saltwater corrosion. Full certification supplied with every order.
                                </p>
                                <div class="in-tags">
                                    <span class="in-tag">Wire Rope</span>
                                    <span class="in-tag">Mooring Lines</span>
                                    <span class="in-tag">Hoist Slings</span>
                                </div>
                                <a href="shop.html?cat=industrial">Shop industrial
                                    <iconify-icon icon="tabler:arrow-right"/>
                                </a>
                            </div>
                            <div class="in-card">
                                <div class="in-card-icon">
                                    <iconify-icon icon="tabler:crane"/>
                                </div>
                                <h3>Construction</h3>
                                <p>Cranes, hoists, scaffolding, and site lashing — all requiring CE-marked ropes with
                                    verifiable WLL ratings and documentation ready for site audits.
                                </p>
                                <div class="in-tags">
                                    <span class="in-tag">Hoist Rope</span>
                                    <span class="in-tag">Cargo Lashing</span>
                                    <span class="in-tag">Manila</span>
                                </div>
                                <a href="shop.html?cat=industrial">Shop for construction
                                    <iconify-icon icon="tabler:arrow-right"/>
                                </a>
                            </div>
                            <div class="in-card">
                                <div class="in-card-icon">
                                    <iconify-icon icon="tabler:anchor"/>
                                </div>
                                <h3>Maritime</h3>
                                <p>UV-resistant, low-stretch marine braid for mooring and halyards. Shock-absorbing
                                    nylon for anchoring. Floating polypropylene for dock and safety lines.
                                </p>
                                <div class="in-tags">
                                    <span class="in-tag">Marine Braid</span>
                                    <span class="in-tag">Anchor Rope</span>
                                    <span class="in-tag">Dock Lines</span>
                                </div>
                                <a href="shop.html?cat=marine">Shop marine
                                    <iconify-icon icon="tabler:arrow-right"/>
                                </a>
                            </div>
                            <div class="in-card">
                                <div class="in-card-icon">
                                    <iconify-icon icon="tabler:pickaxe"/>
                                </div>
                                <h3>Mining</h3>
                                <p>High-WLL hoist ropes for shaft access and haulage. Abrasion-resistant construction
                                    for underground environments. Batch-tested and fully traceable.
                                </p>
                                <div class="in-tags">
                                    <span class="in-tag">Steel Core</span>
                                    <span class="in-tag">High WLL</span>
                                    <span class="in-tag">Haulage</span>
                                </div>
                                <a href="shop.html?cat=industrial">Shop for mining
                                    <iconify-icon icon="tabler:arrow-right"/>
                                </a>
                            </div>
                            <div class="in-card">
                                <div class="in-card-icon">
                                    <iconify-icon icon="tabler:bolt"/>
                                </div>
                                <h3>Utilities &amp; Access</h3>
                                <p>Work-at-height ropes for tower access, wind turbine maintenance, and infrastructure
                                    inspection. CE EN1891 and UIAA certified for insurance compliance.
                                </p>
                                <div class="in-tags">
                                    <span class="in-tag">Static Rope</span>
                                    <span class="in-tag">CE EN1891</span>
                                    <span class="in-tag">UIAA 101</span>
                                </div>
                                <a href="shop.html?cat=climbing">Shop safety ropes
                                    <iconify-icon icon="tabler:arrow-right"/>
                                </a>
                            </div>
                            <div class="in-card">
                                <div class="in-card-icon">
                                    <iconify-icon icon="tabler:truck-delivery"/>
                                </div>
                                <h3>Logistics &amp; Transport</h3>
                                <p>Lightweight, rot-proof polypropylene for securing cargo in transit by road, rail, or
                                    sea. Easy to handle and consistently rated — no minimum order.
                                </p>
                                <div class="in-tags">
                                    <span class="in-tag">Cargo Lashing</span>
                                    <span class="in-tag">Polypropylene</span>
                                    <span class="in-tag">Lightweight</span>
                                </div>
                                <a href="shop.html?cat=industrial">Shop lashing ropes
                                    <iconify-icon icon="tabler:arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </section>
