<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the product_page_override_templates views/templates for the theme_cordage module. -->
<odoo>
    <!-- Product Page -->
    <template id="cordage_product_page_override" inherit_id="website_sale.product" name="Cordage Product Page Layout">
        <!-- We replace the entire #product_detail_main to use our exact theme DOM structure -->
        <xpath expr="//div[@id='product_detail_main']" position="replace">
            <div id="product_detail_main" class="pdp-wrap">
                <!-- 1. GALLERY (Left Column) -->
                <div class="pdp-gallery w-100">
                    <t t-call="website_sale.shop_product_images"/>
                </div>
                <!-- 2. PRODUCT INFO (Right Column) -->
                <div class="pdp-info w-100" id="product_details">
                    <!-- Invisible hooks for Odoo Native JS & other modules (MUST EXIST TO PREVENT CRASHES) -->
                    <div id="product_attributes_simple" class="d-none"/>
                    <!-- Category Label -->
                    <div class="pdp-cat-label">
                        <t t-esc="product.public_categ_ids[0].name if product.public_categ_ids else (product.categ_id.name or 'INDUSTRIAL')"/>
                    </div>
                    <!-- Title -->
                    <h1 itemprop="name" t-field="product.name" class="mb-2">Product Name</h1>
                    <!-- Rating Placeholder -->
                    <div class="pdp-rating">
                        <span class="stars">★★★★★</span>
                        <strong style="color:var(--b-fg)">5.0</strong>
                        <span>(188 reviews)</span>
                    </div>
                    <!-- Price -->
                    <t t-call="website_sale.product_price"/>
                    <p class="pdp-short text-muted mt-3" t-field="product.description_sale" placeholder="A short description that will also appear on documents."/>
                    <!-- Odoo native Variant Picker & Add to Cart form -->
                    <div id="o_wsale_cta_wrapper" class="d-flex flex-column align-items-stretch w-100 mt-4">
                        <t t-if="product._is_add_to_cart_possible()">
                            <form t-if="product._is_add_to_cart_possible()" action="/shop/cart/update" method="POST">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" t-nocache="The csrf token must always be up to date."/>
                                <div class="js_product js_main_product mb-3">
                                    <t t-placeholder="select">
                                        <input type="hidden" class="product_id" name="product_id" t-att-value="product_variant.id" />
                                        <input type="hidden" class="product_template_id" name="product_template_id" t-att-value="product.id" />
                                        <input t-if="product.public_categ_ids.ids" type="hidden" class="product_category_id" name="product_category_id" t-att-value="product.public_categ_ids.ids[0]" />
                                        <input t-if="product.product_tag_ids.ids" type="hidden" class="product_tag_id" name="product_tag_id" t-att-value="product.product_tag_ids.ids[0]" />
                                        <t t-if="combination" t-call="website_sale.variants">
                                            <t t-set="ul_class" t-valuef="flex-column" />
                                            <t t-set="parent_combination" t-value="None" />
                                        </t>
                                        <t t-else="">
                                            <ul class="d-none js_add_cart_variants" t-att-data-attribute_exclusions="{'exclusions: []'}"/>
                                        </t>
                                    </t>
                                    <p t-if="True" class="css_not_available_msg alert alert-warning">This combination does not exist.</p>
                                    <div class="d-flex flex-column gap-3 w-100">
                                        <!-- Qty -->
                                        <div class="css_quantity input-group pdp-qty" contenteditable="false" style="max-width: 150px;">
                                            <a t-attf-href="#" class="btn btn-link js_add_cart_json" aria-label="Remove one" title="Remove one">
                                                <i class="fa fa-minus"/>
                                            </a>
                                            <input type="text" class="form-control quantity text-center" data-min="1" name="add_qty" t-att-value="add_qty or 1"/>
                                            <a t-attf-href="#" class="btn btn-link float_left js_add_cart_json" aria-label="Add one" title="Add one">
                                                <i class="fa fa-plus"/>
                                            </a>
                                        </div>
                                        <!-- Add to Cart -->
                                        <a data-animation-selector=".o_wsale_product_images" role="button" id="add_to_cart" t-attf-class="pdp-add-btn js_check_product a-submit flex-grow-1 w-100 text-center" href="#">
                                            <i class="fa fa-shopping-cart me-2"/> Add to Cart
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </t>
                        <t t-else="">
                            <p class="alert alert-warning">This product is no longer available.</p>
                        </t>
                        <!-- Features Checklist -->
                        <ul class="pdp-perks mt-4">
                            <li><i class="fa fa-check text-success me-2"/> Cut to your exact length</li>
                            <li><i class="fa fa-check text-success me-2"/> Dispatched within 48 hours</li>
                            <li><i class="fa fa-check text-success me-2"/> Free shipping over $150</li>
                            <li><i class="fa fa-check text-success me-2"/> 30-day no-fuss returns</li>
                        </ul>
                        <!-- Invisible hooks for Odoo native elements to prevent crashes -->
                        <div id="o_product_terms_and_share" class="d-none"/>
                        <div id="contact_us_wrapper" class="d-none"/>
                        <div id="product_documents" class="d-none"/>
                        <div class="d-none">
                            <div id="add_to_cart_wrap"/>
                        </div>
                        <div id="product_option_block" class="mt-3"/>
                    </div>
                </div>
            </div>
            <!-- TABS & RELATED PRODUCTS (Appended outside the main wrap) -->
            <section class="pdp-tabs-sec mt-5 w-100">
                <div style="max-width:800px;margin:0 auto" class="w-100">
                    <ul class="nav nav-tabs pdp-tab-bar border-bottom-0 mb-4" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link pdp-tab-btn active border-0" id="desc-tab" data-bs-toggle="tab" href="#tabDesc" role="tab" aria-controls="tabDesc" aria-selected="true">Description</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link pdp-tab-btn border-0" id="specs-tab" data-bs-toggle="tab" href="#tabSpecs" role="tab" aria-controls="tabSpecs" aria-selected="false">Specifications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link pdp-tab-btn border-0" id="reviews-tab" data-bs-toggle="tab" href="#tabReviews" role="tab" aria-controls="tabReviews" aria-selected="false">Reviews</a>
                        </li>
                    </ul>
                    <div class="tab-content w-100">
                        <div class="tab-pane fade show active" id="tabDesc" role="tabpanel" aria-labelledby="desc-tab">
                            <div id="product_full_description" t-field="product.website_description" class="oe_structure oe_empty mt16 pdp-tab-pane active"/>
                        </div>
                        <div class="tab-pane fade" id="tabSpecs" role="tabpanel" aria-labelledby="specs-tab">
                            <p class="text-muted">High-tenacity polypropylene braided rope resistant to rot, mildew, and most chemicals. Lightweight and easy to handle — perfect for warehouse lashing, site safety cordons, and outdoor applications. Does not absorb water, making it ideal for damp environments.</p>
                        </div>
                        <div class="tab-pane fade" id="tabReviews" role="tabpanel" aria-labelledby="reviews-tab">
                            <p class="text-muted">Excellent quality. Exactly as described and arrived on time.</p>
                        </div>
                    </div>
                </div>
            </section>
            <!-- RELATED PRODUCTS -->
            <section class="related-sec w-100 mt-5">
                <div style="max-width: 1300px; margin: 0 auto;">
                    <h2 class="related-head mb-4">You might also like</h2>
                    <div class="bni-prod-grid row g-4">
                        <t t-set="related_products" t-value="product.alternative_product_ids"/>
                        <t t-if="not related_products">
                            <p class="text-muted col-12">No similar products found.</p>
                        </t>
                        <t t-foreach="related_products[:4]" t-as="r_product">
                            <div class="col-md-3 col-sm-6">
                                <article class="bni-pcard h-100 d-flex flex-column" style="background:var(--b-surface);border:1px solid var(--b-border);border-radius:var(--b-radius);overflow:hidden;">
                                    <a t-att-href="r_product.website_url" style="display:block;text-decoration:none">
                                        <div class="bni-pcard__media" style="aspect-ratio:1/1;overflow:hidden;background:#f1f4f8;">
                                            <img t-att-src="'/web/image/product.template/%d/image_512' % r_product.id" class="w-100 h-100" style="object-fit:cover;"/>
                                        </div>
                                    </a>
                                    <div class="bni-pcard__body p-3 d-flex flex-column flex-grow-1">
                                        <div class="bni-pcard__cat" style="font-size:11px;color:var(--b-primary);font-weight:700;text-transform:uppercase;"><t t-esc="r_product.categ_id.name"/></div>
                                        <a t-att-href="r_product.website_url" class="bni-pcard__name mt-1" style="font-weight:700;color:var(--b-fg);text-decoration:none;"><t t-esc="r_product.name"/></a>
                                        <div class="bni-pcard__foot mt-auto pt-3 d-flex justify-content-between align-items-center">
                                            <span class="bni-pcard__price" style="font-weight:800;font-size:1.1rem;"><t t-esc="'$%.2f' % r_product.list_price"/></span>
                                            <a t-att-href="'/shop/cart/update?product_id=%d&amp;add_qty=1' % r_product.product_variant_id.id" class="bni-pcard__add btn btn-sm" style="background:var(--b-primary);color:#fff;border-radius:4px;">Add</a>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        </t>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
