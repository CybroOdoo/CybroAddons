<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Homepage placement with full dynamic Cordage blocks -->
    <template id="cordage_home_page" name="Cordage Homepage" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- 1. Hero banner with Stats -->
                <t t-call="theme_cordage.s_hero_banner"/>
                <!-- Spacer -->
                <div class="oe_structure oe_empty"/>
                <!-- 2. Features list strip -->
                <t t-call="theme_cordage.s_features_section"/>
                <!-- Spacer -->
                <div class="oe_structure oe_empty"/>
                <!-- 3. About us intro banner -->
                <t t-call="theme_cordage.s_about_section"/>
                <!-- Spacer -->
                <div class="oe_structure oe_empty"/>
                <!-- 4. Dynamic category grids -->
                <t t-call="theme_cordage.s_industries_grid"/>
                <!-- Spacer -->
                <div class="oe_structure oe_empty"/>
                <!-- 5. Featured product catalogue -->
                <t t-call="theme_cordage.s_products_carousel"/>
                <!-- Spacer -->
                <div class="oe_structure oe_empty"/>
                <!-- 6. Testimonial Reviews -->
                <t t-call="theme_cordage.s_testimonial_section"/>
                <!-- Spacer -->
                <div class="oe_structure oe_empty"/>
                <!-- 7. Volume quote CTA band -->
                <t t-call="theme_cordage.s_quote_section"/>
                <!-- Spacer -->
                <div class="oe_structure oe_empty"/>
            </div>
        </xpath>
    </template>
</odoo>
