<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the cart_drawer_templates views/templates for the theme_cordage module. -->
<odoo>
    <!-- Cart Drawer -->
    <template id="cordage_cart_drawer" inherit_id="website.layout" name="Cordage Cart Drawer">
        <xpath expr="//div[@id='wrapwrap']" position="after">
            <!-- Cart Sidebar Drawer -->
            <aside class="cart" id="cordageCustomCart" aria-hidden="true" style="background:var(--b-surface);border-left:1px solid var(--b-border)">
                <div class="cart__head" style="border-bottom-color:var(--b-border);background:var(--b-surface)">
                    <h3 style="font-family:var(--b-font-head);color:var(--b-fg)">Your cart</h3>
                    <button class="icon-btn" id="cordageCartClose" style="color:var(--b-accent)">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                </div>
                <div class="cart__body" id="cordageCartBody" style="background:var(--b-surface)">
                    <div class="cart__empty"><span>🪢</span>Loading...</div>
                </div>
                <div class="cart__foot" style="background:var(--b-surface-2);border-top-color:var(--b-border)">
                    <div class="cart__row" style="color:var(--b-fg)">
                        <span>Subtotal</span><strong id="cordageCartSubtotal">$0.00</strong>
                    </div>
                    <div class="cart__row cart__row--total" style="color:var(--b-fg);border-top-color:var(--b-border)">
                        <span>Total</span><strong id="cordageCartTotal">$0.00</strong>
                    </div>
                    <a href="/shop/checkout" class="btn btn--primary btn--block" id="cordageCheckoutBtn" style="background:var(--b-primary);border-radius:var(--b-radius);font-family:var(--b-font-body);text-decoration:none;text-align:center;display:block">Proceed to Checkout</a>
                    <button class="link-btn" id="cordageContinueBtn" style="color:var(--b-muted-fg);font-family:var(--b-font-body);width:100%">Continue shopping</button>
                </div>
            </aside>
            <div id="cordageCartOverlay" class="cart-overlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:99;"/>
        </xpath>
    </template>
</odoo>
