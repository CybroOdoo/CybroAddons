<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Industries Served Page
        Mirrors cordage_example/industries.html exactly.
        Uses theme-native .in-* CSS classes (already in style.scss).

        Snippets extracted from this page:
          - s_industry_cards_grid  → views/snippet/industry_cards_grid.xml
          - s_certifications_band  → views/snippet/certifications_band.xml
          - s_industries_cta       → views/snippet/industries_cta.xml
    -->
    <template id="cordage_industries_page" name="Industries page" key="theme_cordage.cordage_industries_page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- ══════════════════════════════════════════════════════
                     1. HERO / TITLE SECTION
                     Matches .in-hero in style.scss and cordage_example
                ══════════════════════════════════════════════════════ -->
                <div class="in-hero">
                    <!-- Breadcrumb -->
                    <nav class="in-bc">
                        <a href="/">Home</a>
                        <span>›</span>
                        <span style="color:var(--c-ink);">Industries</span>
                    </nav>
                    <h1>Industries We Serve</h1>
                    <p>Certified ropes for six sectors — from offshore platforms to logistics warehouses. Every product load-rated, documented, and cut to your exact length.</p>
                    <!-- Quick Stats -->
                    <div class="in-hstats">
                        <div class="in-hstat">
                            <i class="bi bi-building-gear" style="font-size:1.2rem;color:var(--c-primary);"/>
                            <strong>6</strong>
                            <span>Industries</span>
                        </div>
                        <div class="in-hstat">
                            <i class="bi bi-globe" style="font-size:1.2rem;color:var(--c-primary);"/>
                            <strong>40+</strong>
                            <span>Countries</span>
                        </div>
                        <div class="in-hstat">
                            <i class="bi bi-patch-check" style="font-size:1.2rem;color:var(--c-primary);"/>
                            <strong>ISO 9001</strong>
                            <span>Certified</span>
                        </div>
                        <div class="in-hstat">
                            <i class="bi bi-clock-history" style="font-size:1.2rem;color:var(--c-primary);"/>
                            <strong>48 hrs</strong>
                            <span>Dispatch</span>
                        </div>
                    </div>
                </div>
                <!-- ══════════════════════════════════════════════════════
                     2. APPLICATIONS BY SECTOR GRID
                     Extracted as snippet: s_industry_cards_grid
                ══════════════════════════════════════════════════════ -->
                <t t-call="theme_cordage.s_industry_cards_grid"/>
                <!-- ══════════════════════════════════════════════════════
                     3. ROPE × INDUSTRY REFERENCE TABLE
                     Inline — too data-specific to be a generic snippet
                ══════════════════════════════════════════════════════ -->
                <section class="in-sec in-sec--alt">
                    <div class="in-sec-h">
                        <h2>Rope by industry — quick reference</h2>
                        <p>The most commonly specified products across each sector.</p>
                    </div>
                    <div class="in-tbl-wrap container">
                        <table class="in-tbl">
                            <thead>
                                <tr>
                                    <th>Rope product</th>
                                    <th>Oil &amp; Gas</th>
                                    <th>Construction</th>
                                    <th>Maritime</th>
                                    <th>Mining</th>
                                    <th>Utilities</th>
                                    <th>Logistics</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Steel-Core Hoist Rope</td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-n">—</div></td>
                                </tr>
                                <tr>
                                    <td>Industrial Manila Rope</td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-n">—</div></td>
                                </tr>
                                <tr>
                                    <td>Polypropylene Utility Rope</td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                </tr>
                                <tr>
                                    <td>Marine Double-Braid</td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-n">—</div></td>
                                </tr>
                                <tr>
                                    <td>Nylon Anchor Rope</td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-n">—</div></td>
                                </tr>
                                <tr>
                                    <td>Static Rigging Rope</td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                </tr>
                                <tr>
                                    <td>Dynamic Climbing Rope</td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-n">—</div></td>
                                    <td><div class="ic-y"><i class="bi bi-check-lg"/></div></td>
                                    <td><div class="ic-n">—</div></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
                <!-- ══════════════════════════════════════════════════════
                     4. CERTIFICATIONS BAND
                     Extracted as snippet: s_certifications_band
                ══════════════════════════════════════════════════════ -->
                <t t-call="theme_cordage.s_certifications_band"/>
                <!-- ══════════════════════════════════════════════════════
                     5. CTA — TALK TO OUR TEAM
                     Extracted as snippet: s_industries_cta
                ══════════════════════════════════════════════════════ -->
                <t t-call="theme_cordage.s_industries_cta"/>
            </div>
        </t>
    </template>
    <!-- Register /industries route -->
    <record id="cordage_industries_theme_page" model="theme.website.page">
        <field name="url">/industries</field>
        <field name="view_id" ref="cordage_industries_page"/>
        <field name="is_published">True</field>
    </record>
    <!-- Industries Menu -->
    <record id="theme_cordage.theme_menu_industries" model="theme.website.menu">
        <field name="name">Industries</field>
        <field name="url">/industries</field>
        <field name="page_id" ref="cordage_industries_theme_page"/>
        <field name="use_main_menu_as_parent">True</field>
        <field name="sequence" type="int">30</field>
    </record>
</odoo>
