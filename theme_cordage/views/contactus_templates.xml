<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Cordage Contact Us Page
         Inherits website.contactus and replaces the default wrap content.
     ================================================================ -->
    <template id="theme_cordage_contactus"
              inherit_id="website.contactus"
              name="Cordage — Contact Us Page"
              customize_show="False">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="theme-cordage-contact-wrap">
                <!-- ── 1. HERO ── -->
                <section class="theme-cordage-ct-hero">
                    <div class="container">
                        <nav class="theme-cordage-ct-bc" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <span class="theme-cordage-ct-bc__sep">›</span>
                            <span>Contact</span>
                        </nav>
                        <h1 class="theme-cordage-ct-hero__title">Get in touch</h1>
                        <p class="theme-cordage-ct-hero__sub">
                            Need help choosing a rope, requesting a bulk quote, or opening
                            a trade account? We respond to every enquiry within one
                            business day.
                        </p>
                    </div>
                </section>
                <!-- ── 2. MAIN: FORM + SIDEBAR ── -->
                <section class="theme-cordage-ct-main-section" id="contact-form">
                    <div class="container">
                        <div class="row g-4 align-items-start">
                            <!-- LEFT: Contact Form (7/12 columns) -->
                            <div class="col-12 col-lg-7">
                                <div class="theme-cordage-ct-form-card">
                                    <h2 class="theme-cordage-ct-form-card__title">
                                        <i class="fa fa-paper-plane-o"/>
                                        Send us a message
                                    </h2>
                                    <form action="/cordage/contact/submit"
                                          method="post"
                                          enctype="multipart/form-data"
                                          class="theme-cordage-ct-form"
                                          id="cordageContactForm">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"
                                               t-nocache="The csrf token must always be up to date."/>
                                        <div class="row g-3">
                                            <div class="col-12 col-sm-6 theme-cordage-ct-field">
                                                <label for="ct_fname">First name</label>
                                                <input type="text" id="ct_fname" name="fname"
                                                       placeholder="Jane" required="required"
                                                       class="form-control theme-cordage-ct-input"/>
                                            </div>
                                            <div class="col-12 col-sm-6 theme-cordage-ct-field">
                                                <label for="ct_lname">Last name</label>
                                                <input type="text" id="ct_lname" name="lname"
                                                       placeholder="Maker"
                                                       class="form-control theme-cordage-ct-input"/>
                                            </div>
                                        </div>
                                        <div class="theme-cordage-ct-field">
                                            <label for="ct_email">
                                                Work email
                                                <span class="theme-cordage-ct-required">*</span>
                                            </label>
                                            <input type="email" id="ct_email" name="email_from"
                                                   placeholder="you@company.com" required="required"
                                                   class="form-control theme-cordage-ct-input"/>
                                        </div>
                                        <div class="theme-cordage-ct-field">
                                            <label for="ct_company">
                                                Company
                                                <span class="theme-cordage-ct-optional">(optional)</span>
                                            </label>
                                            <input type="text" id="ct_company" name="partner_name"
                                                   placeholder="Acme Rigging Ltd."
                                                   class="form-control theme-cordage-ct-input"/>
                                        </div>
                                        <div class="theme-cordage-ct-field">
                                            <label for="ct_subject">Subject</label>
                                            <select id="ct_subject" name="subject"
                                                    class="form-select theme-cordage-ct-input">
                                                <option value="Product enquiry">Product enquiry</option>
                                                <option value="Request a quote">Request a quote</option>
                                                <option value="Trade account application">Trade account application</option>
                                                <option value="Order support">Order support</option>
                                                <option value="Technical specification help">Technical specification help</option>
                                                <option value="Returns &amp; refunds">Returns &amp; refunds</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                        <div class="theme-cordage-ct-field">
                                            <label for="ct_message">Message</label>
                                            <textarea id="ct_message" name="description"
                                                      placeholder="Describe your application, load requirements, or question…"
                                                      rows="5" required="required"
                                                      class="form-control theme-cordage-ct-input"/>
                                        </div>
                                        <button type="submit"
                                                id="cordageContactSubmit"
                                                class="theme-cordage-ct-submit">
                                            <i class="fa fa-paper-plane-o"/>
                                            Send message
                                        </button>
                                        <p class="theme-cordage-ct-disclaimer">
                                            By submitting this form, you agree to our
                                            <a href="/privacy">Privacy Policy</a>.
                                        </p>
                                    </form>
                                </div>
                            </div><!-- /col-lg-7 -->
                            <!-- RIGHT: Info Sidebar (5/12 columns) -->
                            <div class="col-12 col-lg-5">
                                <div class="theme-cordage-ct-info">
                                    <!-- Response badge -->
                                    <div class="theme-cordage-ct-badge">
                                        <i class="fa fa-clock-o theme-cordage-ct-badge__icon"/>
                                        <span>
                                            Typical response:
                                            <strong>under 4 hours</strong>
                                            on business days
                                        </span>
                                    </div>
                                    <!-- Email -->
                                    <div class="theme-cordage-ct-info-card">
                                        <div class="theme-cordage-ct-info-icon">
                                            <i class="fa fa-envelope-o"/>
                                        </div>
                                        <div>
                                            <h4>Email</h4>
                                            <p>
                                                <a href="mailto:hello@cordage.com">hello@cordage.com</a><br/>
                                                <a href="mailto:trade@cordage.com">trade@cordage.com</a>
                                                <span class="theme-cordage-ct-info-tag">(wholesale)</span>
                                            </p>
                                        </div>
                                    </div>
                                    <!-- Phone -->
                                    <div class="theme-cordage-ct-info-card">
                                        <div class="theme-cordage-ct-info-icon">
                                            <i class="fa fa-phone"/>
                                        </div>
                                        <div>
                                            <h4>Phone</h4>
                                            <p>
                                                <a href="tel:+442392001234">+44 23 9200 1234</a><br/>
                                                Mon – Fri, 9 am – 5 pm GMT
                                            </p>
                                        </div>
                                    </div>
                                    <!-- Address -->
                                    <div class="theme-cordage-ct-info-card">
                                        <div class="theme-cordage-ct-info-icon">
                                            <i class="fa fa-map-marker"/>
                                        </div>
                                        <div>
                                            <h4>Address</h4>
                                            <p>
                                                12 Harbour Way<br/>
                                                Portsmouth, PO1 2AB<br/>
                                                United Kingdom
                                            </p>
                                        </div>
                                    </div>
                                    <!-- Dispatch -->
                                    <div class="theme-cordage-ct-info-card">
                                        <div class="theme-cordage-ct-info-icon">
                                            <i class="fa fa-truck"/>
                                        </div>
                                        <div>
                                            <h4>Dispatch &amp; returns</h4>
                                            <p>
                                                Orders dispatched within 48 hrs.<br/>
                                                30-day no-fuss return policy.
                                            </p>
                                        </div>
                                    </div>
                                    <!-- Trade accounts -->
                                    <div class="theme-cordage-ct-info-card">
                                        <div class="theme-cordage-ct-info-icon">
                                            <i class="fa fa-building"/>
                                        </div>
                                        <div>
                                            <h4>Trade accounts</h4>
                                            <p>
                                                Discounts from 10 – 30% on volume. Email
                                                <a href="mailto:trade@cordage.com">trade@cordage.com</a>
                                                to apply.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div><!-- /col-lg-5 -->
                        </div><!-- /row -->
                    </div><!-- /container -->
                </section>
                <!-- ── 3. FAQ ── -->
                <section class="theme-cordage-ct-faq" id="faq">
                    <div class="container">
                        <div class="theme-cordage-ct-faq-inner">
                            <div class="theme-cordage-ct-faq-head">
                                <h2>Frequently asked questions</h2>
                                <p>Quick answers to the questions we hear most often.</p>
                            </div>
                            <div class="theme-cordage-ct-faq-list" id="cordageFaqList">
                                <div class="theme-cordage-ct-faq-item">
                                    <button class="theme-cordage-ct-faq-q" type="button">
                                        Do you really cut rope to any length?
                                        <i class="fa fa-chevron-down theme-cordage-ct-faq-chevron"/>
                                    </button>
                                    <div class="theme-cordage-ct-faq-a">
                                        <p>
                                            Yes — every product is sold by the metre and cut to
                                            your exact specification at dispatch. Enter your required length at checkout. Minimum order is
                                            1 metre, there is no maximum.
                                        </p>
                                    </div>
                                </div>
                                <div class="theme-cordage-ct-faq-item">
                                    <button class="theme-cordage-ct-faq-q" type="button">
                                        How quickly will my order arrive?
                                        <i class="fa fa-chevron-down theme-cordage-ct-faq-chevron"/>
                                    </button>
                                    <div class="theme-cordage-ct-faq-a">
                                        <p>
                                            All in-stock orders are dispatched within 48 working
                                            hours. UK delivery typically takes 2 – 3 days after
                                            dispatch. We ship to over 40 countries — estimated transit times are shown at checkout.
                                        </p>
                                    </div>
                                </div>
                                <div class="theme-cordage-ct-faq-item">
                                    <button class="theme-cordage-ct-faq-q" type="button">
                                        What is WLL and how is it different from breaking strength?
                                        <i class="fa fa-chevron-down theme-cordage-ct-faq-chevron"/>
                                    </button>
                                    <div class="theme-cordage-ct-faq-a">
                                        <p>
                                            WLL (Working Load Limit) is the maximum safe load during
                                            normal use — it includes an appropriate safety factor. Breaking Strength is the load at which the rope
                                            will fail under test conditions, typically 3 – 4× the WLL.
                                            Always design to WLL, never to breaking strength.
                                        </p>
                                    </div>
                                </div>
                                <div class="theme-cordage-ct-faq-item">
                                    <button class="theme-cordage-ct-faq-q" type="button">
                                        Can I return a rope cut to my specification?
                                        <i class="fa fa-chevron-down theme-cordage-ct-faq-chevron"/>
                                    </button>
                                    <div class="theme-cordage-ct-faq-a">
                                        <p>
                                            Cut lengths cannot be returned unless there is a
                                            manufacturing fault. Unopened standard-length products
                                            can be returned within 30 days. Contact us within 48 hours of delivery if there is a problem and we will resolve it quickly.
                                        </p>
                                    </div>
                                </div>
                                <div class="theme-cordage-ct-faq-item">
                                    <button class="theme-cordage-ct-faq-q" type="button">
                                        Do you offer trade or wholesale pricing?
                                        <i class="fa fa-chevron-down theme-cordage-ct-faq-chevron"/>
                                    </button>
                                    <div class="theme-cordage-ct-faq-a">
                                        <p>
                                            Yes — trade accounts receive tiered discounts of 10 – 30%
                                            depending on annual volume. Apply by emailing
                                            <a href="mailto:trade@cordage.com">trade@cordage.com</a> with your company name, VAT number, and estimated annual spend.
                                        </p>
                                    </div>
                                </div>
                                <div class="theme-cordage-ct-faq-item">
                                    <button class="theme-cordage-ct-faq-q" type="button">
                                        I'm not sure which rope to specify — can you help?
                                        <i class="fa fa-chevron-down theme-cordage-ct-faq-chevron"/>
                                    </button>
                                    <div class="theme-cordage-ct-faq-a">
                                        <p>
                                            Absolutely. Send us a message describing your application, working load, environment (indoor / outdoor / marine), and any certification requirements. Our team specifies rope for engineers and riggers daily and will respond with a recommendation — usually within the same business day.
                                        </p>
                                    </div>
                                </div>
                                <div class="theme-cordage-ct-faq-item">
                                    <button class="theme-cordage-ct-faq-q" type="button">
                                        Do your products come with certification documentation?
                                        <i class="fa fa-chevron-down theme-cordage-ct-faq-chevron"/>
                                    </button>
                                    <div class="theme-cordage-ct-faq-a">
                                        <p>
                                            Yes. CE, ISO 9001, UIAA 101, EN 13414, and EN 1891
                                            documentation is supplied with every order where applicable. If you need a specific certificate format for a site audit or insurance requirement, mention it in your order notes and we'll include it.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ── 4. QUICK LINKS ── -->
                <section class="theme-cordage-ct-quick">
                    <div class="container">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <a href="/shop" class="theme-cordage-ct-quick-card">
                                    <div class="theme-cordage-ct-quick-icon">
                                        <i class="fa fa-tag"/>
                                    </div>
                                    <div>
                                        <div class="theme-cordage-ct-quick-title">Browse products</div>
                                        <div class="theme-cordage-ct-quick-desc">200+ certified rope products</div>
                                    </div>
                                </a>
                            </div>
                            <div class="col-12 col-md-4">
                                <a href="/industries" class="theme-cordage-ct-quick-card">
                                    <div class="theme-cordage-ct-quick-icon">
                                        <i class="fa fa-industry"/>
                                    </div>
                                    <div>
                                        <div class="theme-cordage-ct-quick-title">Industries we serve</div>
                                        <div class="theme-cordage-ct-quick-desc">Oil &amp; gas, marine, construction…</div>
                                    </div>
                                </a>
                            </div>
                            <div class="col-12 col-md-4">
                                <a href="/about-us" class="theme-cordage-ct-quick-card">
                                    <div class="theme-cordage-ct-quick-icon">
                                        <i class="fa fa-info-circle"/>
                                    </div>
                                    <div>
                                        <div class="theme-cordage-ct-quick-title">About CORDAGE</div>
                                        <div class="theme-cordage-ct-quick-desc">ISO 9001 certified since 1971</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Dedicated Drag-and-Drop Drop Zone -->
                <div class="oe_structure"/>
            </div>
        </xpath>
    </template>
</odoo>
