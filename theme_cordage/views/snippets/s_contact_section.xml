<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the s_contact_section views/templates for the theme_cordage module. -->
<odoo>
    <!-- ═══ CONTACT SECTION SNIPPET ═══ -->
    <template id="s_contact_section" name="Cordage Contact Section">
        <section class="s_contact_section bni-section o_colored_level" data-snippet="theme_cordage.s_contact_section"
                 data-name="Contact Section">
            <div style="max-width:1180px;margin:0 auto;padding:0 22px">
                <div class="bni-section__eyebrow">
                    <div class="bni-eyebrow-line"/>
                    <span class="bni-eyebrow-text o_editable">Get In Touch</span>
                </div>
                <h2 class="o_editable">We'd love to hear from you</h2>
                <div class="cnt-layout">
                    <!-- Contact Form -->
                    <div class="cnt-form-card">
                        <h3>Send us a message</h3>
                        <form class="cnt-form contact-form" method="post"
                              action="/cordage-contact/submit">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <div class="cnt-field-row">
                                <div class="cnt-field">
                                    <label>Name</label>
                                    <input type="text" name="name"
                                           placeholder="Your name" required="required"/>
                                </div>
                                <div class="cnt-field">
                                    <label>Email</label>
                                    <input type="email" name="email"
                                           placeholder="you@company.com" required="required"/>
                                </div>
                            </div>
                            <div class="cnt-field">
                                <label>Subject</label>
                                <input type="text" name="subject"
                                       placeholder="How can we help?"/>
                            </div>
                            <div class="cnt-field">
                                <label>Message</label>
                                <textarea name="message" rows="5"
                                          placeholder="Tell us about your requirements…"
                                          required="required"/>
                            </div>
                            <button class="bni-btn-primary" type="submit">
                                Send Message
                            </button>
                        </form>
                    </div>
                    <!-- Contact Info -->
                    <div class="cnt-info">
                        <div class="cnt-info-card">
                            <span class="i-icon">📞</span>
                            <div>
                                <h4 class="cnt-info-h o_editable">Phone</h4>
                                <p class="cnt-info-p o_editable">
                                    +44 (0)1234 567 890
                                </p>
                            </div>
                        </div>
                        <div class="cnt-info-card">
                            <span class="i-icon">✉️</span>
                            <div>
                                <h4 class="cnt-info-h o_editable">Email</h4>
                                <p class="cnt-info-p o_editable">
                                    sales@cordage.co.uk
                                </p>
                            </div>
                        </div>
                        <div class="cnt-info-card">
                            <span class="i-icon">📍</span>
                            <div>
                                <h4 class="cnt-info-h o_editable">Warehouse</h4>
                                <p class="cnt-info-p o_editable">
                                    Unit 14, Harbour Industrial Estate,<br/>
                                    Portsmouth, PO3 5AB, UK
                                </p>
                            </div>
                        </div>
                        <div class="cnt-info-card">
                            <span class="i-icon">🕐</span>
                            <div>
                                <h4 class="cnt-info-h o_editable">Hours</h4>
                                <p class="cnt-info-p o_editable">
                                    Mon–Fri: 08:00 – 17:30<br/>
                                    Sat: 09:00 – 13:00
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
<!--    Snippet: Contact Section-->
        <template id="snippet_s_contact_section" inherit_id="website.snippets" name="Snippet: Contact Section">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_contact_section"
               string="Contact Section"
               t-thumbnail="/theme_cordage/static/src/images/logo.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
