<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the s_testimonials views/templates for the theme_cordage module. -->
<odoo>
    <!-- ═══ TESTIMONIALS SNIPPET ═══ -->
    <template id="s_testimonials" name="Cordage Testimonials">
        <section class="s_testimonials bni-section bni-section--surface o_colored_level" id="cordage-testimonials"
                 data-snippet="theme_cordage.s_testimonials" data-name="Testimonials">
            <div style="max-width:1180px;margin:0 auto;padding:0 22px">
                <div class="bni-section__head--center">
                    <div class="bni-section__eyebrow bni-section__eyebrow--center">
                        <div class="bni-eyebrow-line"/>
                        <span class="bni-eyebrow-text o_editable">Customer Reviews</span>
                        <div class="bni-eyebrow-line"/>
                    </div>
                    <h2 class="o_editable">Trusted by 12,000+ operators</h2>
                </div>
                <div class="bni-testi-grid">
                    <!-- Testimonial 1 -->
                    <div class="bni-testi-card">
                        <div class="bni-testi-stars">★★★★★</div>
                        <p class="bni-testi-text o_editable">
                            "Used for mooring our offshore supply vessel.
                            Marine double-braid held perfectly — low stretch,
                            UV resistant, and the certification pack was
                            spot-on for our port authority audit."
                        </p>
                        <div class="bni-testi-author">
                            <div class="bni-testi-avatar"
                                 style="overflow:hidden;padding:0">
                                <img src="https://storage.googleapis.com/banani-avatars/avatar/male/35-50/European/0"
                                     alt="James T."
                                     style="width:100%;height:100%;object-fit:cover;border-radius:50%"
                                     onerror="this.parentElement.textContent='⛵'"/>
                            </div>
                            <div>
                                <div class="bni-testi-name o_editable">James T.</div>
                                <div class="bni-testi-role o_editable">
                                    Marine Operations Manager, Portsmouth
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Testimonial 2 -->
                    <div class="bni-testi-card">
                        <div class="bni-testi-stars">★★★★★</div>
                        <p class="bni-testi-text o_editable">
                            "Ordered 300 m of steel-core hoist rope for a crane
                            upgrade. Cut to our exact spec, full EN 13414
                            documentation included. Arrived in 48 hours.
                            Will not use another supplier."
                        </p>
                        <div class="bni-testi-author">
                            <div class="bni-testi-avatar"
                                 style="overflow:hidden;padding:0">
                                <img src="https://storage.googleapis.com/banani-avatars/avatar/female/35-50/South Asian/1"
                                     alt="Sarah K."
                                     style="width:100%;height:100%;object-fit:cover;border-radius:50%"
                                     onerror="this.parentElement.textContent='🏗️'"/>
                            </div>
                            <div>
                                <div class="bni-testi-name o_editable">Sarah K.</div>
                                <div class="bni-testi-role o_editable">
                                    Site Engineer, Balfour &amp; Co.
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Testimonial 3 -->
                    <div class="bni-testi-card">
                        <div class="bni-testi-stars">★★★★★</div>
                        <p class="bni-testi-text o_editable">
                            "The UIAA-certified dynamic rope is exceptional.
                            Dry treatment, great handling, and the price per
                            metre is unbeatable for CE-stamped product.
                            Fast dispatch on a large order — very impressed."
                        </p>
                        <div class="bni-testi-author">
                            <div class="bni-testi-avatar"
                                 style="overflow:hidden;padding:0">
                                <img src="https://storage.googleapis.com/banani-avatars/avatar/male/35-50/North American/2"
                                     alt="Marcus R."
                                     style="width:100%;height:100%;object-fit:cover;border-radius:50%"
                                     onerror="this.parentElement.textContent='🧗'"/>
                            </div>
                            <div>
                                <div class="bni-testi-name o_editable">Marcus R.</div>
                                <div class="bni-testi-role o_editable">
                                    Head Guide, Alpine Access Ltd.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
<!--    Snippet: Testimonials-->
        <template id="snippet_s_testimonials" inherit_id="website.snippets" name="Snippet: Testimonials">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_testimonials"
               string="Testimonials"
               t-thumbnail="/theme_cordage/static/src/images/logo.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
