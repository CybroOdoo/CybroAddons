<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the s_team views/templates for the theme_cordage module. -->
<odoo>
    <!-- ═══ TEAM SNIPPET ═══ -->
    <template id="s_team" name="Cordage Team Grid">
        <section class="s_team bni-section bni-section--surface o_colored_level"
                 data-snippet="theme_cordage.s_team" data-name="Team Grid">
            <div style="max-width:1180px;margin:0 auto;padding:0 22px">
                <div class="bni-section__head--center">
                    <div class="bni-section__eyebrow bni-section__eyebrow--center">
                        <div class="bni-eyebrow-line"/>
                        <span class="bni-eyebrow-text o_editable">Leadership Team</span>
                        <div class="bni-eyebrow-line"/>
                    </div>
                    <h2 class="o_editable">The people behind the rope</h2>
                </div>
                <div class="team-grid-dark">
                    <div class="team-card-dark">
                        <div class="team-avatar" style="font-size:2.4rem">👨‍💼</div>
                        <div class="team-name o_editable">Robert Harman</div>
                        <div class="team-role o_editable">CEO &amp; Founder</div>
                    </div>
                    <div class="team-card-dark">
                        <div class="team-avatar" style="font-size:2.4rem">👩‍🔬</div>
                        <div class="team-name o_editable">Dr. Priya Nair</div>
                        <div class="team-role o_editable">Head of Engineering</div>
                    </div>
                    <div class="team-card-dark">
                        <div class="team-avatar" style="font-size:2.4rem">👨‍⚓</div>
                        <div class="team-name o_editable">James Whitby</div>
                        <div class="team-role o_editable">Marine Division Lead</div>
                    </div>
                    <div class="team-card-dark">
                        <div class="team-avatar" style="font-size:2.4rem">👩‍💼</div>
                        <div class="team-name o_editable">Claire Sutton</div>
                        <div class="team-role o_editable">Operations Director</div>
                    </div>
                </div>
            </div>
        </section>
    </template>
<!--    Snippet: Team Grid-->
        <template id="snippet_s_team" inherit_id="website.snippets" name="Snippet: Team Grid">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_team"
               string="Team Grid"
               t-thumbnail="/theme_cordage/static/src/images/logo.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
