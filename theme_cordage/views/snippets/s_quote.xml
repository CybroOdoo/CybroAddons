<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the s_quote views/templates for the theme_cordage module. -->
<odoo>
    <!-- ═══ QUOTE BAND SNIPPET ═══ -->
    <template id="s_quote" name="Cordage Quote Request Band">
        <section class="s_quote bni-quote-band" id="cordage-quote"
                 data-snippet="theme_cordage.s_quote" data-name="Quote Request Band">
            <div>
                <h2 class="o_editable">Need a volume quote or custom spec?</h2>
                <p class="o_editable">
                    Trade accounts, bulk orders, and bespoke cut lengths —
                    our team will respond within one business day with a
                    full written quotation.
                </p>
            </div>
            <form class="bni-quote-form" id="cordageQuoteForm"
                  action="/cordage-contact/submit" method="post">
                <input type="hidden" name="csrf_token"
                       t-att-value="request.csrf_token()"/>
                <input class="bni-quote-input" type="text" name="name"
                       required="required" placeholder="Your name"
                       aria-label="Name"/>
                <input class="bni-quote-input" type="email" name="email"
                       required="required" placeholder="Work email"
                       aria-label="Email"/>
                <input class="bni-quote-input" type="text" name="message"
                       placeholder="Product / ref." aria-label="Product"/>
                <button class="bni-btn-primary" type="submit">
                    Send Request
                </button>
            </form>
            <small id="cordageQuoteMsg"
                   style="display:block;width:100%;color:#7ee8a2;font-size:13px;margin-top:.5rem;min-height:1.2em">
            </small>
        </section>
    </template>
<!--    Snippet: Quote Band-->
        <template id="snippet_s_quote" inherit_id="website.snippets" name="Snippet: Quote Band">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_quote"
               string="Quote Band"
               t-thumbnail="/theme_cordage/static/src/images/logo.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
