<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the s_industries views/templates for the theme_cordage module. -->
<odoo>
    <!-- ═══ INDUSTRIES SNIPPET ═══ -->
    <template id="s_industries" name="Cordage Industries Grid">
        <section class="s_industries bni-section bni-section--surface"
                 data-snippet="theme_cordage.s_industries" data-name="Industries Grid"
                 id="cordage-industries">
            <div style="max-width:1180px;margin:0 auto;padding:0 22px">
                <div class="bni-section__head--center">
                    <div class="bni-section__eyebrow bni-section__eyebrow--center">
                        <div class="bni-eyebrow-line"/>
                        <span class="bni-eyebrow-text o_editable">Industries We Serve</span>
                        <div class="bni-eyebrow-line"/>
                    </div>
                    <h2 class="o_editable">Engineered for every sector</h2>
                    <p class="bni-section__sub o_editable">
                        From offshore platforms to craft studios — if it needs
                        a rope, we have it certified and in stock.
                    </p>
                </div>
                <div class="bni-ind-grid">
                    <a href="/cordage-shop" class="bni-ind-card bni-ind-img"
                       style="background-image:url('/theme_cordage/static/src/images/img10.webp');background-size:cover;background-position:center">
                        <div class="bni-ind-card__icon">⚙️</div>
                        <div class="bni-ind-card__name o_editable">Oil &amp; Gas</div>
                        <div class="bni-ind-card__sub o_editable">Offshore · Onshore</div>
                    </a>
                    <a href="/cordage-shop" class="bni-ind-card bni-ind-img"
                       style="background-image:url('/theme_cordage/static/src/images/img11.webp');background-size:cover;background-position:center">
                        <div class="bni-ind-card__icon">🏗️</div>
                        <div class="bni-ind-card__name o_editable">Construction</div>
                        <div class="bni-ind-card__sub o_editable">Cranes · Scaffolding</div>
                    </a>
                    <a href="/cordage-shop" class="bni-ind-card bni-ind-img"
                       style="background-image:url('/theme_cordage/static/src/images/img12.webp');background-size:cover;background-position:center">
                        <div class="bni-ind-card__icon">⚓</div>
                        <div class="bni-ind-card__name o_editable">Maritime</div>
                        <div class="bni-ind-card__sub o_editable">Mooring · Rigging</div>
                    </a>
                    <a href="/cordage-shop" class="bni-ind-card bni-ind-img"
                       style="background-image:url('https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&amp;fit=crop&amp;w=480&amp;q=70');background-size:cover;background-position:center">
                        <div class="bni-ind-card__icon">⛏️</div>
                        <div class="bni-ind-card__name o_editable">Mining</div>
                        <div class="bni-ind-card__sub o_editable">Haulage · Lifting</div>
                    </a>
                    <a href="/cordage-shop" class="bni-ind-card bni-ind-img"
                       style="background-image:url('/theme_cordage/static/src/images/img13.webp');background-size:cover;background-position:center">
                        <div class="bni-ind-card__icon">⚡</div>
                        <div class="bni-ind-card__name o_editable">Utilities</div>
                        <div class="bni-ind-card__sub o_editable">Access · Safety</div>
                    </a>
                    <a href="/cordage-shop" class="bni-ind-card bni-ind-img"
                       style="background-image:url('/theme_cordage/static/src/images/img14.webp');background-size:cover;background-position:center">
                        <div class="bni-ind-card__icon">📦</div>
                        <div class="bni-ind-card__name o_editable">Logistics</div>
                        <div class="bni-ind-card__sub o_editable">Lashing · Securing</div>
                    </a>
                </div>
            </div>
        </section>
    </template>
<!--    Snippet: Industries Grid-->
        <template id="snippet_s_industries" inherit_id="website.snippets" name="Snippet: Industries Grid">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_industries"
               string="Industries Grid"
               t-thumbnail="/theme_cordage/static/src/images/logo.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
