<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the s_why_choose views/templates for the theme_cordage module. -->
<odoo>
    <!-- ═══ WHY CHOOSE US SNIPPET ═══ -->
    <template id="s_why_choose" name="Cordage Why Choose Us">
        <section class="s_why_choose bni-section o_colored_level" data-snippet="theme_cordage.s_why_choose"
                 data-name="Why Choose Us" id="cordage-why">
            <div style="max-width:1180px;margin:0 auto;padding:0 22px">
                <div class="bni-section__head--center">
                    <div class="bni-section__eyebrow bni-section__eyebrow--center">
                        <div class="bni-eyebrow-line"/>
                        <span class="bni-eyebrow-text o_editable">Why Choose CORDAGE</span>
                        <div class="bni-eyebrow-line"/>
                    </div>
                    <h2 class="o_editable">Built for industrial precision</h2>
                    <p class="bni-section__sub o_editable">
                        Every rope we supply meets rigorous international standards,
                        backed by full certification documentation.
                    </p>
                </div>
                <div class="bni-why-grid">
                    <div class="bni-why-card">
                        <div class="bni-why-card__icon">🏅</div>
                        <h3 class="o_editable">ISO 9001 Certified</h3>
                        <p class="o_editable">
                            Every product ships with full traceability documentation
                            — CE marks, UIAA certs, and EN test reports included.
                        </p>
                    </div>
                    <div class="bni-why-card">
                        <div class="bni-why-card__icon">✂️</div>
                        <h3 class="o_editable">Cut to Your Exact Length</h3>
                        <p class="o_editable">
                            Order any quantity from 1 m upward. We cut, coil, and
                            label every order to your specification.
                        </p>
                    </div>
                    <div class="bni-why-card">
                        <div class="bni-why-card__icon">🚚</div>
                        <h3 class="o_editable">48-Hour Dispatch</h3>
                        <p class="o_editable">
                            In-stock items leave our warehouse within two working
                            days. Express options available for urgent orders.
                        </p>
                    </div>
                    <div class="bni-why-card">
                        <div class="bni-why-card__icon">🌊</div>
                        <h3 class="o_editable">Marine &amp; Industrial Grade</h3>
                        <p class="o_editable">
                            UV-stable, salt-resistant, and rated for the harshest
                            offshore environments. Built to last.
                        </p>
                    </div>
                    <div class="bni-why-card">
                        <div class="bni-why-card__icon">💼</div>
                        <h3 class="o_editable">Trade Accounts</h3>
                        <p class="o_editable">
                            Volume pricing, net-30 terms, and a dedicated account
                            manager for approved trade customers.
                        </p>
                    </div>
                    <div class="bni-why-card">
                        <div class="bni-why-card__icon">🛡️</div>
                        <h3 class="o_editable">Technical Support</h3>
                        <p class="o_editable">
                            Our rope engineers are on hand to recommend the right
                            product for your load, environment, and application.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
<!--    Snippet: Why Choose Us-->
        <template id="snippet_s_why_choose" inherit_id="website.snippets" name="Snippet: Why Choose Us">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_why_choose"
               string="Why Choose Us"
               t-thumbnail="/theme_cordage/static/src/images/logo.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
