<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the s_hero views/templates for the theme_cordage module. -->
<odoo>
    <!-- ═══ HERO SNIPPET ═══ -->
    <template id="s_hero" name="Cordage Hero Banner">
        <section class="s_hero bni-hero o_colored_level" data-snippet="theme_cordage.s_hero"
                 data-name="Hero Banner" id="top">
            <!-- Background image — editable via website editor -->
            <div class="bni-hero__bg">
                <img src="/theme_cordage/static/src/images/rope.jpg"
                     alt="Industrial ropes and rigging equipment"
                     class="o_we_custom_image"
                     style="width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;z-index:0"/>
            </div>
            <div class="bni-hero__overlay"/>
            <div class="bni-hero__inner">
                <!-- ISO badge -->
                <div class="bni-hero__badge">
                    <div class="bni-hero__badge-line"/>
                    <span class="bni-hero__badge-text o_editable">
                        ISO 9001 Certified Industrial Supplier
                    </span>
                </div>
                <!-- Headline — editable -->
                <h1 class="o_editable">
                    Reliable Industrial<br/>
                    <span class="accent">Ropes &amp; Rigging</span><br/>
                    Solutions
                </h1>
                <!-- Sub-copy — editable -->
                <p class="bni-hero__sub o_editable">
                    Engineered for extreme conditions. Trusted by construction,
                    marine, oil &amp; gas, and mining industries worldwide.
                </p>
                <!-- CTA row -->
                <div class="bni-hero__cta">
                    <a href="/cordage-shop" class="bni-btn-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <path d="M16 10a4 4 0 0 1-8 0"/>
                        </svg>
                        Shop Now
                    </a>
                    <a href="/cordage-contact" class="bni-btn-outline">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8l6 6v12a2 2 0 0 1-2 2z"/>
                            <path d="M14 2v5a1 1 0 0 0 1 1h5M10 9H8m8 4H8m8 4H8"/>
                        </svg>
                        Request Quote
                    </a>
                    <button class="bni-btn-text" onclick="document.getElementById('cordage-why')?.scrollIntoView({behavior:'smooth'})">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <circle cx="12" cy="12" r="10"/>
                            <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/>
                        </svg>
                        Why CORDAGE
                    </button>
                </div>
                <!-- Stats -->
                <div class="bni-hero__stats">
                    <div class="bni-hero-stat">
                        <strong class="o_editable">12,000+</strong>
                        <span class="o_editable">Orders Shipped</span>
                    </div>
                    <div class="bni-hero-stat">
                        <strong class="o_editable">200+</strong>
                        <span class="o_editable">Products in Stock</span>
                    </div>
                    <div class="bni-hero-stat">
                        <strong class="o_editable">ISO 9001</strong>
                        <span class="o_editable">Certified Quality</span>
                    </div>
                    <div class="bni-hero-stat">
                        <strong class="o_editable">48 hrs</strong>
                        <span class="o_editable">Dispatch Time</span>
                    </div>
                </div>
            </div>
        </section>
    </template>
<!--    Snippet: Hero Banner-->
        <template id="snippet_s_hero" inherit_id="website.snippets" name="Snippet: Hero Banner">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_hero"
               string="Hero Banner"
               t-thumbnail="/theme_cordage/static/src/images/rope.jpg"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
