<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the snippet_groups views/templates for the theme_cordage module. -->
<odoo>
<!--    Cordage Snippet Groups-->
    <template id="cordage_snippet_groups" inherit_id="website.snippets"
              name="Cordage Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_cordage/static/src/images/logo.png"
               string="Cordage Sections"
               snippet-group="cordage_section"/>
        </xpath>
    </template>
</odoo>
