<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the s_about_story views/templates for the theme_cordage module. -->
<odoo>
    <!-- ═══ ABOUT STORY SNIPPET ═══ -->
    <template id="s_about_story" name="Cordage About Story">
        <section class="s_about_story bni-section o_colored_level" data-snippet="theme_cordage.s_about_story"
                 data-name="About Story">
            <div style="max-width:1180px;margin:0 auto;padding:0 22px">
                <div class="about-story">
                    <div class="about-story-img" style="font-size:6rem;display:flex;align-items:center;justify-content:center">
                        🪢
                    </div>
                    <div>
                        <div class="bni-section__eyebrow">
                            <div class="bni-eyebrow-line"/>
                            <span class="bni-eyebrow-text o_editable">Our Story</span>
                        </div>
                        <h2 class="o_editable">
                            Supplying industry since 1987
                        </h2>
                        <p class="o_editable" style="color:var(--muted);margin-bottom:1rem;line-height:1.7">
                            CORDAGE was founded by rope-makers who understood
                            the cost of failure. Every product we stock has been
                            tested, certified, and approved by our team of
                            engineers before it reaches your site.
                        </p>
                        <p class="o_editable" style="color:var(--muted);margin-bottom:1rem;line-height:1.7">
                            From a single workshop supplying local dockyards,
                            we've grown into a multinational supplier trusted
                            by construction firms, maritime operators, and
                            climbing federations worldwide.
                        </p>
                        <a href="/about" class="bni-btn-primary">
                            Read our story →
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
<!--    About-->
        <template id="snippet_s_about_story" inherit_id="website.snippets" name="Snippet: About Story">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_cordage.s_about_story"
               string="About Story"
               t-thumbnail="/theme_cordage/static/src/images/logo.png"
               group="cordage_section"/>
        </xpath>
    </template>
</odoo>
