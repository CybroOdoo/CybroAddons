<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the contact_templates views/templates for the theme_cordage module. -->
<odoo>
<!--Cordage Contact-->
    <template id="contact_page" key="theme_cordage.contact_page" name="Cordage Contact">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'contact'"/>
            <div id="wrap" class="oe_structure">
                <section data-snippet="s_contact_page_content" data-name="Contact Page">
                    <!-- HERO -->
                    <div class="bni-page-offset ct-hero">
                        <nav class="ct-bc">
                            <a href="/">Home</a>
                            <span>›</span>
                            <span style="color:var(--b-fg)">Contact</span>
                        </nav>
                        <h1>Get in touch</h1>
                        <p>Need help choosing a rope, requesting a bulk quote, or opening a trade account? We respond to
                            every enquiry within one business day.
                        </p>
                    </div>
                    <!-- MAIN CONTACT LAYOUT -->
                    <div class="ct-main" id="contact-form">
                        <!-- FORM -->
                        <div class="ct-form-card">
                            <h2>
                                <iconify-icon icon="tabler:send"/>
                                Send us a message
                            </h2>
                            <form class="ct-form" id="contactForm">
                                <div class="ct-row">
                                    <div class="ct-field">
                                        <label>First name</label>
                                        <input required="required" placeholder="Jane"/>
                                    </div>
                                    <div class="ct-field">
                                        <label>Last name</label>
                                        <input required="required" placeholder="Maker"/>
                                    </div>
                                </div>
                                <div class="ct-field">
                                    <label>Work email</label>
                                    <input type="email" required="required" placeholder="you@company.com"/>
                                </div>
                                <div class="ct-field">
                                    <label>Company
                                        <span style="font-weight:400;color:var(--b-muted-fg)">(optional)</span>
                                    </label>
                                    <input placeholder="Acme Rigging Ltd."/>
                                </div>
                                <div class="ct-field">
                                    <label>Subject</label>
                                    <select>
                                        <option>Product enquiry</option>
                                        <option>Request a quote</option>
                                        <option>Trade account application</option>
                                        <option>Order support</option>
                                        <option>Technical specification help</option>
                                        <option>Returns &amp; refunds</option>
                                        <option>Other</option>
                                    </select>
                                </div>
                                <div class="ct-field">
                                    <label>Message</label>
                                    <textarea required="required"
                                              placeholder="Describe your application, load requirements, or question…"/>
                                </div>
                                <button class="ct-submit" type="submit">
                                    <iconify-icon icon="tabler:send"/>
                                    Send message
                                </button>
                                <div class="ct-success" id="ctSuccess">
                                    <iconify-icon icon="tabler:circle-check"/>
                                    <strong>Message received!</strong>
                                    <span>We'll reply within one business day.</span>
                                </div>
                            </form>
                        </div>
                        <!-- INFO SIDEBAR -->
                        <div class="ct-info">
                            <div class="ct-badge">
                                <iconify-icon icon="tabler:clock"/>
                                <span>Typical response time: <strong>under 4 hours</strong> on business days
                                </span>
                            </div>
                            <div class="ct-info-card">
                                <div class="ct-info-icon">
                                    <iconify-icon icon="tabler:mail"/>
                                </div>
                                <div>
                                    <h4>Email</h4>
                                    <p>
                                        <a href="mailto:hello@CORDAGEcom">hello@CORDAGEcom</a>
                                        <br/>
                                        <a href="mailto:trade@CORDAGEcom">trade@CORDAGEcom</a>
                                        <span style="font-size:11px;color:var(--b-muted-fg)">(wholesale)</span>
                                    </p>
                                </div>
                            </div>
                            <div class="ct-info-card">
                                <div class="ct-info-icon">
                                    <iconify-icon icon="tabler:phone"/>
                                </div>
                                <div>
                                    <h4>Phone</h4>
                                    <p>
                                        <a href="tel:+442392001234">+44 23 9200 1234</a>
                                        <br/>Mon – Fri, 9 am – 5 pm GMT
                                    </p>
                                </div>
                            </div>
                            <div class="ct-info-card">
                                <div class="ct-info-icon">
                                    <iconify-icon icon="tabler:map-pin"/>
                                </div>
                                <div>
                                    <h4>Address</h4>
                                    <p>12 Harbour Way<br/>Portsmouth, PO1 2AB<br/>United Kingdom
                                    </p>
                                </div>
                            </div>
                            <div class="ct-info-card">
                                <div class="ct-info-icon">
                                    <iconify-icon icon="tabler:truck-delivery"/>
                                </div>
                                <div>
                                    <h4>Dispatch &amp; returns</h4>
                                    <p>Orders dispatched within 48 hrs.<br/>30-day no-fuss return policy.
                                    </p>
                                </div>
                            </div>
                            <div class="ct-info-card">
                                <div class="ct-info-icon">
                                    <iconify-icon icon="tabler:building"/>
                                </div>
                                <div>
                                    <h4>Trade accounts</h4>
                                    <p>Discounts from 10 – 30% on volume. Email <a href="mailto:trade@CORDAGEcom">
                                        trade@CORDAGEcom
                                    </a> to apply.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- FAQ -->
                    <section class="ct-faq-sec" id="faq">
                        <div class="ct-faq-inner">
                            <div class="ct-faq-h">
                                <h2>Frequently asked questions</h2>
                                <p>Quick answers to the questions we hear most often.</p>
                            </div>
                            <div class="ct-faq-list" id="faqList">
                                <div class="ct-faq-item">
                                    <button class="ct-faq-q">Do you really cut rope to any length?
                                        <iconify-icon icon="tabler:chevron-down"/>
                                    </button>
                                    <div class="ct-faq-a">
                                        <p>Yes — every product is sold by the metre and cut to your exact specification
                                            at dispatch. Enter your required length at checkout. Minimum order is 1
                                            metre, there is no maximum.
                                        </p>
                                    </div>
                                </div>
                                <div class="ct-faq-item">
                                    <button class="ct-faq-q">How quickly will my order arrive?
                                        <iconify-icon icon="tabler:chevron-down"/>
                                    </button>
                                    <div class="ct-faq-a">
                                        <p>All in-stock orders are dispatched within 48 working hours. UK delivery
                                            typically takes 2 – 3 days after dispatch. We ship to over 40 countries —
                                            estimated transit times are shown at checkout.
                                        </p>
                                    </div>
                                </div>
                                <div class="ct-faq-item">
                                    <button class="ct-faq-q">What is WLL and how is it different from breaking strength?
                                        <iconify-icon icon="tabler:chevron-down"/>
                                    </button>
                                    <div class="ct-faq-a">
                                        <p>WLL (Working Load Limit) is the maximum safe load during normal use — it
                                            includes an appropriate safety factor. Breaking Strength is the load at
                                            which the rope will fail under test conditions, typically 3 – 4× the WLL.
                                            Always design to WLL, never to breaking strength.
                                        </p>
                                    </div>
                                </div>
                                <div class="ct-faq-item">
                                    <button class="ct-faq-q">Can I return a rope cut to my specification?
                                        <iconify-icon icon="tabler:chevron-down"/>
                                    </button>
                                    <div class="ct-faq-a">
                                        <p>Cut lengths cannot be returned unless there is a manufacturing fault.
                                            Unopened standard-length products can be returned within 30 days. Contact us
                                            within 48 hours of delivery if there is a problem and we will resolve it
                                            quickly.
                                        </p>
                                    </div>
                                </div>
                                <div class="ct-faq-item">
                                    <button class="ct-faq-q">Do you offer trade or wholesale pricing?
                                        <iconify-icon icon="tabler:chevron-down"/>
                                    </button>
                                    <div class="ct-faq-a">
                                        <p>Yes — trade accounts receive tiered discounts of 10 – 30% depending on annual
                                            volume. Apply by emailing <a href="mailto:trade@CORDAGEcom">
                                                trade@CORDAGEcom
                                            </a> with your company name, VAT number, and estimated annual spend.
                                        </p>
                                    </div>
                                </div>
                                <div class="ct-faq-item">
                                    <button class="ct-faq-q">I'm not sure which rope to specify — can you help?
                                        <iconify-icon icon="tabler:chevron-down"/>
                                    </button>
                                    <div class="ct-faq-a">
                                        <p>Absolutely. Send us a message describing your application, working load,
                                            environment (indoor / outdoor / marine), and any certification requirements.
                                            Our team specifies rope for engineers and riggers daily and will respond
                                            with a recommendation — usually within the same business day.
                                        </p>
                                    </div>
                                </div>
                                <div class="ct-faq-item">
                                    <button class="ct-faq-q">Do your products come with certification documentation?
                                        <iconify-icon icon="tabler:chevron-down"/>
                                    </button>
                                    <div class="ct-faq-a">
                                        <p>Yes. CE, ISO 9001, UIAA 101, EN 13414, and EN 1891 documentation is supplied
                                            with every order where applicable. If you need a specific certificate format
                                            for a site audit or insurance requirement, mention it in your order notes
                                            and we'll include it.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- QUICK LINKS -->
                    <div class="ct-quick">
                        <a href="/cordage-shop" class="ct-quick-card">
                            <div class="ct-quick-icon">
                                <iconify-icon icon="tabler:tag"/>
                            </div>
                            <div>
                                <div class="ct-quick-t">Browse products</div>
                                <div class="ct-quick-d">12 certified rope products</div>
                            </div>
                        </a>
                        <a href="/industries" class="ct-quick-card">
                            <div class="ct-quick-icon">
                                <iconify-icon icon="tabler:building-factory-2"/>
                            </div>
                            <div>
                                <div class="ct-quick-t">Industries we serve</div>
                                <div class="ct-quick-d">Oil &amp; gas, marine, construction…</div>
                            </div>
                        </a>
                        <a href="/about" class="ct-quick-card">
                            <div class="ct-quick-icon">
                                <iconify-icon icon="tabler:info-circle"/>
                            </div>
                            <div>
                                <div class="ct-quick-t">About CORDAGE</div>
                                <div class="ct-quick-d">ISO 9001 certified since 1971</div>
                            </div>
                        </a>
                    </div>
                </section>
                <div class="oe_structure oe_empty" id="contact_extra_blocks"/>
            </div>
        </t>
    </template>
</odoo>
