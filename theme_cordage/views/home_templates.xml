<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the home_templates views/templates for the theme_cordage module. -->
<odoo>
    <!-- Home page: extends website.homepage and replaces the wrap with Cordage sections -->
    <template id="homepage" name="Cordage Home" inherit_id="website.homepage" priority="16">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <t t-call="theme_cordage.s_hero"/>
                <div class="oe_structure oe_empty"/>
                <t t-call="theme_cordage.s_stats_band"/>
                <div class="oe_structure oe_empty"/>
                <t t-call="theme_cordage.s_featured_products"/>
                <div class="oe_structure oe_empty"/>
                <t t-call="theme_cordage.s_industries"/>
                <div class="oe_structure oe_empty"/>
                <t t-call="theme_cordage.s_why_choose"/>
                <div class="oe_structure oe_empty"/>
                <t t-call="theme_cordage.s_testimonials"/>
                <div class="oe_structure oe_empty"/>
                <t t-call="theme_cordage.s_quote"/>
                <div class="oe_structure oe_empty"/>
            </div>
        </xpath>
    </template>
</odoo>
