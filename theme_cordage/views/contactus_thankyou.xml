<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Cordage Contact Thank-You Page
    ================================================================ -->
    <template id="contactus_thankyou_template"
              name="Cordage — Contact Thank You"
              key="theme_cordage.contactus_thankyou_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="theme-cordage-ct-thankyou">
                    <div class="theme-cordage-ct-thankyou__card">
                        <!-- Success icon -->
                        <div class="theme-cordage-ct-thankyou__icon">
                            <i class="fa fa-check-circle"/>
                        </div>
                        <h1>Message received!</h1>
                        <p>
                            Thank you for reaching out. A member of our team will
                            reply to your enquiry within one business day.
                        </p>
                        <!-- Action buttons -->
                        <div class="theme-cordage-ct-thankyou__actions">
                            <a href="/shop"
                               class="theme-cordage-btn theme-cordage-btn--primary">
                                <i class="fa fa-shopping-bag"/>
                                Browse Products
                            </a>
                            <a href="/"
                               class="theme-cordage-btn theme-cordage-btn--ghost">
                                <i class="fa fa-home"/>
                                Return Home
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
