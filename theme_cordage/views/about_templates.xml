<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the about_templates views/templates for the theme_cordage module. -->
<odoo>
    <!--  Cordage About-->
    <template id="about_page" key="theme_cordage.about_page" name="Cordage About">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'about'"/>
            <div id="wrap" class="oe_structure">
                <section data-snippet="s_about_page_content" data-name="About Page">
                    <!-- PAGE HERO -->
                    <div class="bni-page-offset ab-hero">
                        <nav class="ab-bc">
                            <a href="/">Home</a>
                            <span>›</span>
                            <span style="color:var(--b-fg)">About</span>
                        </nav>
                        <h1>About CORDAGE</h1>
                        <p>Supplying certified industrial, marine, fabric and climbing ropes since 1971. Every metre
                            tested, documented, and cut to your exact specification.
                        </p>
                    </div>
                    <!-- STATS -->
                    <div class="ab-stats">
                        <div class="ab-stat">
                            <iconify-icon icon="tabler:calendar-event"/>
                            <strong>1971</strong>
                            <span>Year founded</span>
                        </div>
                        <div class="ab-stat">
                            <iconify-icon icon="tabler:package"/>
                            <strong>12,000+</strong>
                            <span>Orders shipped</span>
                        </div>
                        <div class="ab-stat">
                            <iconify-icon icon="tabler:world"/>
                            <strong>40+</strong>
                            <span>Countries served</span>
                        </div>
                        <div class="ab-stat">
                            <iconify-icon icon="tabler:certificate"/>
                            <strong>ISO 9001</strong>
                            <span>Certified quality</span>
                        </div>
                    </div>
                    <!-- STORY -->
                    <section class="ab-story">
                        <div>
                            <h2>50 years of craft.<br/>One standard of quality.
                            </h2>
                            <p>CORDAGE began in 1971 as a small dockside supplier in Portsmouth — coiling and cutting
                                rope for fishermen and harbor workers. Every customer came through the door and knew us
                                by name.
                            </p>
                            <p>Fifty years later, we serve engineers, riggers, marine operators, climbers, and makers
                                across the globe. Our range has grown, but the standard has not moved a millimetre.
                            </p>
                            <blockquote>"If we wouldn't put it on our own boat or rigging, we won't sell it to you."
                            </blockquote>
                            <p>That principle shapes every buying decision, every supplier audit, and every load test we
                                run. It's why customers who placed their first order in 2002 are still with us today.
                            </p>
                        </div>
                        <div class="ab-card">
                            <div class="ab-card-badge">
                                <iconify-icon icon="tabler:anchor"/>
                                Est. Portsmouth, 1971
                            </div>
                            <div class="ab-fact">
                                <iconify-icon icon="tabler:cut"/>
                                <div>
                                    <div class="ab-fact-t">Cut to your exact length</div>
                                    <div class="ab-fact-d">1 metre to unlimited — no minimum, no waste charge</div>
                                </div>
                            </div>
                            <div class="ab-fact">
                                <iconify-icon icon="tabler:file-certificate"/>
                                <div>
                                    <div class="ab-fact-t">Full certification on every order</div>
                                    <div class="ab-fact-d">CE, ISO, UIAA, EN 13414 documentation included</div>
                                </div>
                            </div>
                            <div class="ab-fact">
                                <iconify-icon icon="tabler:clock-check"/>
                                <div>
                                    <div class="ab-fact-t">48-hour guaranteed dispatch</div>
                                    <div class="ab-fact-d">All in-stock orders — or we refund the shipping</div>
                                </div>
                            </div>
                            <div class="ab-fact">
                                <iconify-icon icon="tabler:test-pipe"/>
                                <div>
                                    <div class="ab-fact-t">Batch load-tested</div>
                                    <div class="ab-fact-d">WLL and breaking strength published per product</div>
                                </div>
                            </div>
                            <div class="ab-fact">
                                <iconify-icon icon="tabler:headset"/>
                                <div>
                                    <div class="ab-fact-t">Technical support</div>
                                    <div class="ab-fact-d">We spec rope for engineers and riggers daily</div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- VALUES -->
                    <section class="ab-sec ab-sec--alt">
                        <div class="ab-sec-h">
                            <h2>How we operate</h2>
                            <p>Six principles that shape every decision, from supplier selection to how we answer the
                                phone.
                            </p>
                        </div>
                        <div class="ab-val-grid">
                            <div class="ab-val">
                                <div class="ab-val-icon">
                                    <iconify-icon icon="tabler:microscope"/>
                                </div>
                                <h3>Rigorous testing</h3>
                                <p>Every batch is load-tested before dispatch. We publish WLL and breaking strength on
                                    each product page — no estimates, no guesswork.
                                </p>
                            </div>
                            <div class="ab-val">
                                <div class="ab-val-icon">
                                    <iconify-icon icon="tabler:cut"/>
                                </div>
                                <h3>Cut to length</h3>
                                <p>Order exactly what you need — from 1 m to a full reel. We cut with precision at no
                                    extra charge.
                                </p>
                            </div>
                            <div class="ab-val">
                                <div class="ab-val-icon">
                                    <iconify-icon icon="tabler:file-certificate"/>
                                </div>
                                <h3>Full certification</h3>
                                <p>CE, ISO 9001, UIAA 101, EN 13414 documentation ships with every qualified order —
                                    ready for site audits.
                                </p>
                            </div>
                            <div class="ab-val">
                                <div class="ab-val-icon">
                                    <iconify-icon icon="tabler:truck-delivery"/>
                                </div>
                                <h3>48-hour dispatch</h3>
                                <p>Every in-stock order is cut, coiled, labeled, and dispatched within two working days
                                    — guaranteed.
                                </p>
                            </div>
                            <div class="ab-val">
                                <div class="ab-val-icon">
                                    <iconify-icon icon="tabler:leaf"/>
                                </div>
                                <h3>Responsible sourcing</h3>
                                <p>Natural fibers from certified sustainable sources. All synthetic fibers meet REACH
                                    compliance.
                                </p>
                            </div>
                            <div class="ab-val">
                                <div class="ab-val-icon">
                                    <iconify-icon icon="tabler:headset"/>
                                </div>
                                <h3>Real support</h3>
                                <p>Tell us your load, environment, and certification needs. We'll spec the exact rope —
                                    usually within one working day.
                                </p>
                            </div>
                        </div>
                    </section>
                    <!-- CERTIFICATIONS -->
                    <section class="ab-sec">
                        <div class="ab-sec-h">
                            <h2>Certifications &amp; standards</h2>
                            <p>Independently certified to the standards required by the industries we serve.</p>
                        </div>
                        <div class="ab-cert-grid">
                            <div class="ab-cert">
                                <iconify-icon icon="tabler:certificate-2"/>
                                <div class="ab-cert-n">ISO 9001:2015</div>
                                <div class="ab-cert-d">Quality management — manufacturing &amp; supply</div>
                            </div>
                            <div class="ab-cert">
                                <iconify-icon icon="tabler:shield-check"/>
                                <div class="ab-cert-n">CE Certified</div>
                                <div class="ab-cert-d">EU safety &amp; performance conformity</div>
                            </div>
                            <div class="ab-cert">
                                <iconify-icon icon="tabler:mountain"/>
                                <div class="ab-cert-n">UIAA 101</div>
                                <div class="ab-cert-d">Dynamic rope — climbing &amp; mountaineering</div>
                            </div>
                            <div class="ab-cert">
                                <iconify-icon icon="tabler:file-description"/>
                                <div class="ab-cert-n">EN 13414</div>
                                <div class="ab-cert-d">Steel wire rope sling — industrial lifting</div>
                            </div>
                            <div class="ab-cert">
                                <iconify-icon icon="tabler:shield-lock"/>
                                <div class="ab-cert-n">EN 1891 Type A</div>
                                <div class="ab-cert-d">Static kernmantle — access &amp; rescue</div>
                            </div>
                        </div>
                    </section>
                    <!-- TEAM -->
                    <section class="ab-sec ab-sec--alt">
                        <div class="ab-sec-h">
                            <h2>The team</h2>
                            <p>Engineers, sailors, climbers, and craftspeople — united by a shared obsession with rope
                                quality.
                            </p>
                        </div>
                        <div class="ab-team-grid">
                            <div class="ab-member">
                                <div class="ab-av" style="background:linear-gradient(135deg,#e8641a,#f07020)">H</div>
                                <h3>Helen Carter</h3>
                                <div class="ab-member-role">Founder &amp; CEO</div>
                                <p class="ab-member-bio">Third-generation rope supplier. Former marine engineer. Still
                                    personally approves every new product before it enters the catalogue.
                                </p>
                            </div>
                            <div class="ab-member">
                                <div class="ab-av" style="background:linear-gradient(135deg,#1a4a80,#2e6898)">T</div>
                                <h3>Tom Briggs</h3>
                                <div class="ab-member-role">Head of Operations</div>
                                <p class="ab-member-bio">Runs the cutting floor and dispatch team. Responsible for the
                                    48-hour commitment — and has never missed it in seven years.
                                </p>
                            </div>
                            <div class="ab-member">
                                <div class="ab-av" style="background:linear-gradient(135deg,#2f7d5b,#3aaa78)">P</div>
                                <h3>Priya Singh</h3>
                                <div class="ab-member-role">Quality &amp; Testing</div>
                                <p class="ab-member-bio">Materials engineer. Runs all load tests and manages supplier
                                    certification audits. The reason our WLL figures can be trusted.
                                </p>
                            </div>
                            <div class="ab-member">
                                <div class="ab-av" style="background:linear-gradient(135deg,#6a30a8,#9060d0)">L</div>
                                <h3>Luca Ferri</h3>
                                <div class="ab-member-role">Product Development</div>
                                <p class="ab-member-bio">Sources new rope categories and develops the fabric and craft
                                    range. Also, an avid climber — he tests his own product.
                                </p>
                            </div>
                        </div>
                    </section>
                    <!-- TIMELINE -->
                    <section class="ab-sec">
                        <div class="ab-sec-h">
                            <h2>Company milestones</h2>
                        </div>
                        <div class="ab-tl">
                            <div class="ab-tl-item">
                                <div class="ab-tl-yr">1971</div>
                                <div class="ab-tl-title">Founded in Portsmouth</div>
                                <div class="ab-tl-desc">Started as a dockside rope supplier serving local fishermen and
                                    harbor workers. First year revenue: £4,200.
                                </div>
                            </div>
                            <div class="ab-tl-item">
                                <div class="ab-tl-yr">1989</div>
                                <div class="ab-tl-title">Synthetic rope manufacturing</div>
                                <div class="ab-tl-desc">Expanded into polypropylene and polyester production. Achieved
                                    first ISO quality certification.
                                </div>
                            </div>
                            <div class="ab-tl-item">
                                <div class="ab-tl-yr">2002</div>
                                <div class="ab-tl-title">Online ordering launches</div>
                                <div class="ab-tl-desc">First UK rope supplier to offer cut-to-length ordering online.
                                    1,400 orders placed in year one.
                                </div>
                            </div>
                            <div class="ab-tl-item">
                                <div class="ab-tl-yr">2011</div>
                                <div class="ab-tl-title">ISO 9001 certification</div>
                                <div class="ab-tl-desc">Full quality management system certified across manufacturing,
                                    testing, and supply operations.
                                </div>
                            </div>
                            <div class="ab-tl-item">
                                <div class="ab-tl-yr">2015</div>
                                <div class="ab-tl-title">Climbing &amp; safety rope range</div>
                                <div class="ab-tl-desc">UIAA-certified dynamic and static ropes added. CE certifications
                                    applied across the full catalogue.
                                </div>
                            </div>
                            <div class="ab-tl-item">
                                <div class="ab-tl-yr">2022</div>
                                <div class="ab-tl-title">Fabric &amp; craft range</div>
                                <div class="ab-tl-desc">Cotton, macramé, and colored rope range launched. Customer base
                                    exceeds 8,000 active accounts.
                                </div>
                            </div>
                            <div class="ab-tl-item">
                                <div class="ab-tl-yr">Today</div>
                                <div class="ab-tl-title">Shipping worldwide</div>
                                <div class="ab-tl-desc">12 core products, 40+ countries, 50+ years of expertise. The
                                    same principle as 1971.
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- CTA -->
                    <section class="ab-cta">
                        <h2>Ready to find the right rope?</h2>
                        <p>Browse our full catalogue or speak with our technical team. We'll spec the exact product for
                            your application.
                        </p>
                        <div class="ab-cta-btns">
                            <a href="/cordage-shop" class="ab-btn-w"><iconify-icon icon="tabler:tag"/>
                                Browse products
                            </a>
                            <a href="/cordage-contact" class="ab-btn-o"><iconify-icon
                                    icon="tabler:message"/>Contact our team
                            </a>
                        </div>
                    </section>
                </section>
                <div class="oe_structure oe_empty" id="about_extra_blocks"/>
            </div>
        </t>
    </template>
</odoo>
