<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════════
         1. PRODUCT PUBLIC CATEGORIES
         ════════════════════════════════════════════════════════════════════ -->
    <record id="cat_industrial" model="product.public.category">
        <field name="name">Industrial</field>
        <field name="sequence">10</field>
        <field name="image_1920" type="base64" file="theme_cordage/static/src/img/img10.webp"/>
    </record>
    <record id="cat_marine" model="product.public.category">
        <field name="name">Marine</field>
        <field name="sequence">20</field>
        <field name="image_1920" type="base64" file="theme_cordage/static/src/img/img12.webp"/>
    </record>
    <record id="cat_fabric" model="product.public.category">
        <field name="name">Fabric</field>
        <field name="sequence">30</field>
        <field name="image_1920" type="base64" file="theme_cordage/static/src/img/img14.webp"/>
    </record>
    <record id="cat_climbing" model="product.public.category">
        <field name="name">Climbing</field>
        <field name="sequence">40</field>
        <field name="image_1920" type="base64" file="theme_cordage/static/src/img/img13.webp"/>
    </record>
    <!-- ════════════════════════════════════════════════════════════════════
         2. PRODUCT ATTRIBUTES
         ════════════════════════════════════════════════════════════════════ -->
    <record id="attr_diameter" model="product.attribute">
        <field name="name">Diameter</field>
        <field name="display_type">radio</field>
        <field name="create_variant">no_variant</field>
    </record>
    <record id="attr_val_dia_4mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">4 mm</field>
        <field name="sequence">1</field>
    </record>
    <record id="attr_val_dia_6mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">6 mm</field>
        <field name="sequence">2</field>
    </record>
    <record id="attr_val_dia_8mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">8 mm</field>
        <field name="sequence">3</field>
    </record>
    <record id="attr_val_dia_9_8mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">9.8 mm</field>
        <field name="sequence">4</field>
    </record>
    <record id="attr_val_dia_10mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">10 mm</field>
        <field name="sequence">5</field>
    </record>
    <record id="attr_val_dia_11mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">11 mm</field>
        <field name="sequence">6</field>
    </record>
    <record id="attr_val_dia_12mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">12 mm</field>
        <field name="sequence">7</field>
    </record>
    <record id="attr_val_dia_14mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">14 mm</field>
        <field name="sequence">8</field>
    </record>
    <record id="attr_val_dia_16mm" model="product.attribute.value">
        <field name="attribute_id" ref="attr_diameter"/>
        <field name="name">16 mm</field>
        <field name="sequence">9</field>
    </record>
    <record id="attr_material" model="product.attribute">
        <field name="name">Rope Material</field>
        <field name="display_type">radio</field>
        <field name="create_variant">no_variant</field>
    </record>
    <record id="attr_val_mat_manila" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Natural Manila Fibre</field>
        <field name="sequence">1</field>
    </record>
    <record id="attr_val_mat_polypropylene" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Polypropylene (PP)</field>
        <field name="sequence">2</field>
    </record>
    <record id="attr_val_mat_steel_core" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Steel core</field>
        <field name="sequence">3</field>
    </record>
    <record id="attr_val_mat_polyester" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Polyester</field>
        <field name="sequence">4</field>
    </record>
    <record id="attr_val_mat_nylon" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Nylon (Polyamide)</field>
        <field name="sequence">5</field>
    </record>
    <record id="attr_val_mat_cotton" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">100% Natural Cotton</field>
        <field name="sequence">6</field>
    </record>
    <record id="attr_val_mat_dyed_cotton" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Dyed Cotton</field>
        <field name="sequence">7</field>
    </record>
    <record id="attr_val_mat_nylon_kernmantle" model="product.attribute.value">
        <field name="attribute_id" ref="attr_material"/>
        <field name="name">Nylon kernmantle</field>
        <field name="sequence">8</field>
    </record>
    <!-- ════════════════════════════════════════════════════════════════════
         3. MAILING LIST
         ════════════════════════════════════════════════════════════════════ -->
    <record id="cordage_trade_list" model="mailing.list">
        <field name="name">Cordage Trade &amp; Rigging Quotes</field>
        <field name="is_public">True</field>
    </record>
</odoo>
