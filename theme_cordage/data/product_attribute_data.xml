<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the product_attribute_data views/templates for the theme_cordage module. -->
<odoo>
    <data noupdate="1">
        <!-- Material Attribute -->
        <record id="attribute_material" model="product.attribute">
            <field name="name">Material</field>
            <field name="display_type">pills</field>
            <field name="create_variant">no_variant</field>
        </record>
        <!-- Material Values -->
<!--        Material - Natural Manila Fibre-->
        <record id="val_mat_manila" model="product.attribute.value">
            <field name="name">Natural Manila Fibre</field>
            <field name="attribute_id" ref="attribute_material"/>
        </record>
        <!--        Material - Polypropylene (PP)-->
        <record id="val_mat_pp" model="product.attribute.value">
            <field name="name">Polypropylene (PP)</field>
            <field name="attribute_id" ref="attribute_material"/>
        </record>
        <!--        Material - Steel core-->
        <record id="val_mat_steel" model="product.attribute.value">
            <field name="name">Steel core</field>
            <field name="attribute_id" ref="attribute_material"/>
        </record>
<!--        Material - Polyester-->
        <record id="val_mat_poly" model="product.attribute.value">
            <field name="name">Polyester</field>
            <field name="attribute_id" ref="attribute_material"/>
        </record>
<!--        Material - Nylon-->
        <record id="val_mat_nylon" model="product.attribute.value">
            <field name="name">Nylon (Polyamide)</field>
            <field name="attribute_id" ref="attribute_material"/>
        </record>
<!--        Material - 100% Natural Cotton-->
        <record id="val_mat_cotton" model="product.attribute.value">
            <field name="name">100% Natural Cotton</field>
            <field name="attribute_id" ref="attribute_material"/>
        </record>
<!--        Material - Dyed Cotton-->
        <record id="val_mat_dyed" model="product.attribute.value">
            <field name="name">Dyed Cotton</field>
            <field name="attribute_id" ref="attribute_material"/>
        </record>
<!--        Material - Nylon Kernmantle-->
        <record id="val_mat_kern" model="product.attribute.value">
            <field name="name">Nylon kernmantle</field>
            <field name="attribute_id" ref="attribute_material"/>
        </record>
        <!-- Diameter Attribute -->
        <record id="attribute_diameter" model="product.attribute">
            <field name="name">Diameter</field>
            <field name="display_type">pills</field>
            <field name="create_variant">no_variant</field>
        </record>
        <!-- Diameter Values -->
<!--        Diameter - 4mm-->
        <record id="val_dia_4" model="product.attribute.value">
            <field name="name">4 mm</field>
            <field name="attribute_id" ref="attribute_diameter"/>
        </record>
        <!--        Diameter - 6mm-->
        <record id="val_dia_6" model="product.attribute.value">
            <field name="name">6 mm</field>
            <field name="attribute_id" ref="attribute_diameter"/>
        </record>
        <!--        Diameter - 8mm-->
        <record id="val_dia_8" model="product.attribute.value">
            <field name="name">8 mm</field>
            <field name="attribute_id" ref="attribute_diameter"/>
        </record>
        <!--        Diameter - 9.8 mm-->
        <record id="val_dia_9_8" model="product.attribute.value">
            <field name="name">9.8 mm</field>
            <field name="attribute_id" ref="attribute_diameter"/>
        </record>
        <!--        Diameter - 10 mm-->
        <record id="val_dia_10" model="product.attribute.value">
            <field name="name">10 mm</field>
            <field name="attribute_id" ref="attribute_diameter"/>
        </record>
        <!--        Diameter - 11 mm-->
        <record id="val_dia_11" model="product.attribute.value">
            <field name="name">11 mm</field>
            <field name="attribute_id" ref="attribute_diameter"/>
        </record>
        <!--        Diameter - 12 mm-->
        <record id="val_dia_12" model="product.attribute.value">
            <field name="name">12 mm</field>
            <field name="attribute_id" ref="attribute_diameter"/>
        </record>
        <!--        Diameter - 14mm-->
        <record id="val_dia_14" model="product.attribute.value">
            <field name="name">14 mm</field>
            <field name="attribute_id" ref="attribute_diameter"/>
        </record>
        <!--        Diameter - 16 mm-->
        <record id="val_dia_16" model="product.attribute.value">
            <field name="name">16 mm</field>
            <field name="attribute_id" ref="attribute_diameter"/>
        </record>
    </data>
</odoo>
