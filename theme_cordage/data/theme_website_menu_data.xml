<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: This file defines the theme_website_menu_data views/templates for the theme_cordage module. -->
<odoo>
    <!-- Delete native Shop and Contact menus so they don't duplicate -->
    <data noupdate="0">
        <delete model="website.menu" search="[('url', 'in', ['/shop', '/contactus'])]"/>
    </data>
    <!-- ── Website page registrations ── -->
    <data noupdate="1">
        <!-- ── Website pages ── -->
        <!-- ── About page ── -->
        <record id="website_page_about" model="theme.website.page">
            <field name="url">/about</field>
            <field name="view_id" ref="theme_cordage.about_page"/>
            <field name="is_published">True</field>
        </record>
        <!-- ── Industries page ── -->
        <record id="website_page_industries" model="theme.website.page">
            <field name="url">/industries</field>
            <field name="view_id" ref="theme_cordage.industries_page"/>
            <field name="is_published">True</field>
        </record>
        <!-- ── Contact page ── -->
        <record id="website_page_contact" model="theme.website.page">
            <field name="url">/cordage-contact</field>
            <field name="view_id" ref="theme_cordage.contact_page"/>
            <field name="is_published">True</field>
        </record>
        <!-- ── Shop page ── -->
        <record id="website_page_shop" model="theme.website.page">
            <field name="url">/cordage-shop</field>
            <field name="view_id" ref="theme_cordage.shop_page"/>
            <field name="is_published">True</field>
        </record>
        <!-- ── Product page ── -->
        <record id="website_page_product" model="theme.website.page">
            <field name="url">/cordage-product</field>
            <field name="view_id" ref="theme_cordage.product_page"/>
            <field name="is_published">True</field>
        </record>
    </data>
<!--    Menu - products-->
    <record id="theme_menu_products" model="theme.website.menu">
        <field name="name">Products</field>
        <field name="url">/cordage-shop</field>
        <field name="use_main_menu_as_parent">True</field>
        <field name="sequence" type="int">20</field>
    </record>
<!--    Menu Industries-->
    <record id="theme_menu_industries" model="theme.website.menu">
        <field name="name">Industries</field>
        <field name="url">/industries</field>
        <field name="use_main_menu_as_parent">True</field>
        <field name="sequence" type="int">30</field>
    </record>
<!--    Menu About-->
    <record id="theme_menu_about" model="theme.website.menu">
        <field name="name">About</field>
        <field name="url">/about</field>
        <field name="use_main_menu_as_parent">True</field>
        <field name="sequence" type="int">40</field>
    </record>
<!--    Menu contact-->
    <record id="theme_menu_contact" model="theme.website.menu">
        <field name="name">Contact</field>
        <field name="url">/cordage-contact</field>
        <field name="use_main_menu_as_parent">True</field>
        <field name="sequence" type="int">50</field>
    </record>
</odoo>
