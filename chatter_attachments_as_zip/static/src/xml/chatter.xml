<?xml version="1.0" encoding="UTF-8"?>
<!--To add the download all attachments button in the chatter-->
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-AttachmentBox')]" position="inside">
            <div class="d-flex flex-column align-items-center mt-2">
                <button type="button" class="btn btn-link px-1"
                        t-on-click="(ev) => this.onClickDownloadAttachment(ev)">
                    <i class="oi me-1" data-icon="download"/>
                    Download All Attachments
                </button>
            </div>
        </xpath>
    </t>
</templates>
