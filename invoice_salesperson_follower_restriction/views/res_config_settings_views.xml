<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.invoice.salesperson.follower.restriction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Salesperson Restriction" id="salesperson_restriction_container">
                    <setting id="salesperson_follower_restriction" help="When enabled, if the Salesperson and the Sales Order creator are different users, the Salesperson will be removed from the follower list of the invoice.">
                        <field name="enable_salesperson_follower_restriction"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
