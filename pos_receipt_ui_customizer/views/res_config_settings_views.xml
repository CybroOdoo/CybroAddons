<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Inherit POS Settings Form to add Custom Receipt configuration -->
    <record id="view_pos_configuration_setting_form" model="ir.ui.view">
        <field name="name">pos.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>

        <!-- Extend the existing POS configuration settings view -->
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <!-- Insert the custom receipt setting inside the Bills and Receipts section -->
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">

                <!-- Custom Receipt Configuration -->
                <setting title="Customize the POS receipts"
                         string="Custom Receipt"
                         help="Use custom receipt designs">

                    <!-- Enable or disable custom receipt functionality -->
                    <field name="is_custom_receipt"/>

                    <!-- Receipt design selection (visible only when custom receipt is enabled) -->
                    <div class="content-group mt16">
                        <field name="receipt_design_id"
                               invisible="not is_custom_receipt"
                               required="True"/>
                    </div>

                </setting>

            </xpath>

        </field>
    </record>

</odoo>