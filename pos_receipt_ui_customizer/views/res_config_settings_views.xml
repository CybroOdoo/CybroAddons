<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Inherit POS Settings view to add Custom Receipt configuration -->
    <record id="view_pos_configuration_setting_form" model="ir.ui.view">
        <field name="name">pos.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>

        <!-- Extend the default POS configuration settings form -->
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <!-- Insert custom receipt settings inside Bills and Receipts section -->
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">

                <!-- Custom Receipt configuration -->
                <setting title="Customize the POS receipts"
                         string="Custom Receipt"
                         help="Use custom receipt designs">

                    <!-- Enable or disable custom receipt feature -->
                    <field name="is_custom_receipt"/>

                    <!-- Select receipt design (visible when custom receipt is enabled) -->
                    <div class="content-group mt16">
                        <field name="receipt_design_id"
                               invisible="not is_custom_receipt"
                               required="True"/>
                    </div>

                </setting>
            </xpath>
        </field>
    </record>
</odoo>