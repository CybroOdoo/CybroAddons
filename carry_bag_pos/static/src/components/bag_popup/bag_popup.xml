<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="carry_bag_pos.BagPopup">
        <Dialog title="this.props.title">
            <div t-if="this.bags.length" class="o_bag_popup_list row g-2">
                <div t-foreach="this.bags" t-as="bag" t-key="bag.template.id" class="col-6 col-md-4">
                    <article class="o_bag_item product btn btn-light d-flex flex-column align-items-center p-2 h-100"
                             t-on-click="() => this.onClickBag(bag.template)">
                        <div class="o_bag_item_img ratio ratio-1x1 w-50 mb-2 d-flex align-items-center justify-content-center">
                            <img t-if="bag.imageUrl"
                                 class="object-fit-contain"
                                 t-att-src="bag.imageUrl"
                                 t-att-alt="bag.template.display_name"/>
                            <i t-else="" class="fa fa-shopping-bag fa-2x text-muted" role="img" aria-label="Bag"/>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold small mb-1" t-out="bag.template.display_name"/>
                            <div class="o_bag_item_stock text-primary" t-out="bag.stock"/>
                        </div>
                    </article>
                </div>
            </div>
            <div t-else="" class="alert alert-danger">No bags available</div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
