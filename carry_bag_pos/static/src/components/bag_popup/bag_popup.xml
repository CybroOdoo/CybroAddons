<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="carry_bag_pos.BagPopup" owl="1">
        <Dialog title="'Available Bags'">
            <div class="modal-body">
                <div t-if="products.length" class="product-list row g-2">
                    <div t-foreach="products" t-as="product" t-key="product.id" class="col-6 col-md-4">
                        <article
                            class="product btn btn-light"
                            t-on-click="_onClickProduct"
                            t-att-data-product-id="product.id">
                            <!-- log what's being rendered -->
                            <t t-log="product.id"/>
                            <t t-log="product.display_name"/>
                            <span t-esc="product.display_name"/>
                        </article>
                    </div>
                </div>
                <div t-else="" class="alert alert-danger">No Bags available</div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
