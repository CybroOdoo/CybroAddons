<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Extends POS ControlButtons to add a button for selecting and adding carry bags to the order. -->
    <t t-name="carry_bag_pos.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <!-- Position your button BEFORE the showRemainingButtons condition -->
        <xpath expr="//t[@t-if='props.showRemainingButtons']"
               position="before">
            <button class="btn btn-light btn-lg"
                    t-on-click="() => this.onClickBagCharges()">
                <i class="fa fa-shopping-bag me-1" role="img"
                   aria-label="Bag Charges" title="Bag Charges"/>
                Add Bag
            </button>
        </xpath>
    </t>
</templates>