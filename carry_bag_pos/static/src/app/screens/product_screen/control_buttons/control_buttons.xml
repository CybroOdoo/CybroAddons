<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="carry_bag_pos.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']"
               position="before">
            <button t-if="this.pos.config.is_bag_charges"
                    class="btn btn-light btn-lg"
                    t-on-click="() => this.onClickBagCharges()">
                <i class="fa fa-shopping-bag me-1"
                   role="img"
                   aria-label="Add Bag"
                   title="Add Bag"/>
                Add Bag
            </button>
        </xpath>
    </t>
</templates>
