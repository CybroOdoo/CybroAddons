<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited view of the Point of Sale res.config.settings view -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.carry.bag.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_interface_section" position="inside">
                <setting id="is_pos_bag_charges"
                         string="Bag Charges"
                         help="Add carry bags to your order">
                    <field name="is_pos_bag_charges"/>
                    <div class="content-group mt-2"
                         invisible="not is_pos_bag_charges">
                        <div class="row">
                            <label for="pos_bag_category_id" string="Bag Category"
                                   class="col-lg-3 o_light_label"/>
                            <field name="pos_bag_category_id"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
