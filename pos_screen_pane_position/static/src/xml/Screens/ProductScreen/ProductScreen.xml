<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_screen_pane_position.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-screen')]" position="attributes">
            <attribute name="t-att-class">{'flex-row-reverse': this.pos.config.screen_view === 'right'}</attribute>
        </xpath>
    </t>
</templates>
