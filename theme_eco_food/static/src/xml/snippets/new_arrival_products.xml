<?xml version='1.0' encoding='UTF-8'?>
<templates id="template" xml:space="preserve">
<!--    template for new arrival products carousel-->
    <t t-name="theme_eco_food.eco_food_new_arrivals_carousel" name="Eco Food New Arrivals">
        <div class="eco_food_products">
            <div class="owl-carousel new_arrival_carousel">
                <t t-foreach="new_arrival" t-as="item" t-key="item.id">
                    <div class="best_products">
                        <div class="b_product">
                            <span class="new">
                                New
                            </span>
                            <div class="wrapper">
                                <div class="img_wrapper">
                                    <img t-attf-src="/web/image?model=product.template&amp;field=image_1920&amp;id=#{(item.id)}" style="min-height: 222px;"/>
                                    <div class="inner">
                                        <a t-attf-href="/shop/product/#{(item.id)}" itemprop="url" type="button" class="quick_view scale-in-center" aria-label="View product">
                                            <svg class="eco-food-card-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <circle cx="11" cy="11" r="6.5"/>
                                                <path d="m16 16 4 4"/>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                                <div class="product_info">
                                    <div class="p_category">
                                        <t t-out="item.category"/>
                                    </div>
                                    <div class="p_name">
                                        <t t-out="item.name"/>
                                    </div>
                                    <div class="p_rating ">
                                        <div class="o_website_rating_static" style="display:flex;" t-att-title="item.rating_avg || 0">
                                            <t t-call="portal_rating.rating_stars_static" val="item.rating_avg || 0" inline_mode="false">
                                                </t>
                                        </div>
                                    </div>
                                    <div class="p_price ">
                                        <span t-if="item.list_price">
                                            <t t-out="item.currency"/> <t t-out="item.list_price"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="product_bottom slide-in-bottom">
                                    <a t-attf-href="#" role="button" class="btn btn-primary cart-btn" t-att-data-product-template-id="item.id" t-att-data-product-id="item.product_id" t-att-data-product-type="item.product_type" aria-label="Shopping cart" title="Shopping cart">
                                        <span class="fa fa-shopping-cart"/>
                                    </a>
                                    <a t-attf-href="#" role="button" class="btn btn-primary o_add_wishlist" t-att-data-product-template-id="item.id" aria-label="Wishlist" title="Wishlist">
                                        <svg class="eco-food-card-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6l1.2 1.2L12 21l7.6-7.6 1.2-1.2a5.4 5.4 0 0 0 0-7.6Z"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
