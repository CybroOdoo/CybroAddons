<?xml version='1.0' encoding='UTF-8'?>
<templates id="template" xml:space="preserve">
    <!--    template for featured products carousel-->
    <t t-name="theme_eco_food.eco_food_featured_products_carousel" name="Eco Food Featured Products">
        <div class="featured_slider">
            <div class="wrapper">
                <div class="owl-carousel featured_eco_food favorite-carousel">
                    <t t-foreach="slides" t-as="slide" t-if="slides" t-key="slide">
                        <div class="row">
                            <t t-foreach="slides[slide]" t-as="item" t-if="slide" t-key="item.id">
                                <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                                    <div class="b_product">
                                        <div class="eco-food-card-content" t-attf-data-product-url="/shop/product/#{(item.id)}">
                                            <div class="wrapper">
                                                <div class="img_wrapper">
                                                    <a t-attf-href="/shop/product/#{(item.id)}" class="d-block" aria-label="View product">
                                                        <img t-attf-src="/web/image?model=product.template&amp;field=image_1920&amp;id=#{item.id}"/>
                                                    </a>
                                                    <div class="inner">
                                                        <a t-attf-href="/shop/product/#{(item.id)}" itemprop="url" type="button" class="quick_view scale-in-center" aria-label="View product">
                                                            <svg class="eco-food-card-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                                <circle cx="11" cy="11" r="6.5"/>
                                                                <path d="m16 16 4 4"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                                <a class="product_info d-block" t-attf-href="/shop/product/#{(item.id)}">
                                                    <div class="p_category">
                                                        <span t-if="slide" t-out="item.category"/>
                                                    </div>
                                                    <div class="p_name">
                                                        <span t-if="slide" t-out="item.name"/>
                                                    </div>
                                                    <div class="p_rating ">
                                                        <div class="p_rating ">
                                                            <div class="o_website_rating_static" style="display:flex;" t-att-title="item.rating_avg || 0">
                                                                <t t-call="portal_rating.rating_stars_static" val="item.rating_avg || 0" inline_mode="false">
                                                                    </t>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="p_price ">
                                                        <span t-if="slide">
                                                            <t t-out="item.currency"/>
                                                            <t t-out="item.list_price"/>
                                                        </span>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
