<?xml version='1.0' encoding='UTF-8'?>
<templates id="template" xml:space="preserve">
    <!--    template for best seller snippet-->
    <t t-name="theme_eco_food.eco_food_best_seller_snippet" name="EcoFood Best Seller">
        <div class="best_products">
            <t t-foreach="best_seller" t-as="bs" t-key="bs.id">
                <div class="b_product">
                    <div class="eco-food-card-content" t-attf-data-product-url="/shop/product/#{(bs.id)}">
                        <div class="wrapper">
                            <div class="img_wrapper">
                                <a t-attf-href="/shop/product/#{(bs.id)}" class="d-block" aria-label="View product">
                                    <img t-attf-src="/web/image?model=product.template&amp;field=image_1920&amp;id=#{bs.id}"/>
                                </a>
                                <div class="inner">
                                    <a t-attf-href="/shop/product/#{(bs.id)}" itemprop="url" type="button" class="quick_view scale-in-center" aria-label="View product">
                                        <svg class="eco-food-card-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <circle cx="11" cy="11" r="6.5"/>
                                            <path d="m16 16 4 4"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                            <a class="product_info d-block" t-attf-href="/shop/product/#{(bs.id)}">
                                <div class="p_category">
                                    <span t-if="best_seller" t-out="bs.category"/>
                                </div>
                                <div class="p_name">
                                    <span t-if="best_seller" t-out="bs.name"/>
                                </div>
                                <div class="p_rating ">
                                    <div class="o_website_rating_static" style="display:flex;" t-att-title="bs.rating_avg || 0">
                                        <t t-call="portal_rating.rating_stars_static" val="bs.rating_avg || 0" inline_mode="false">
                                            </t>
                                    </div>
                                </div>
                                <div class="p_price ">
                                    <span t-if="best_seller">
                                        <t t-out="bs.currency"/>
                                        <t t-out="bs.list_price"/>
                                    </span>
                                </div>
                            </a>
                            <div class="product_bottom slide-in-bottom">
                                <a t-attf-href="#" role="button" class="btn btn-primary cart-btn" t-att-data-product-template-id="bs.id" t-att-data-product-id="bs.product_id" t-att-data-product-type="bs.product_type" aria-label="Shopping cart" title="Shopping cart">
                                    <span class="fa fa-shopping-cart"/>
                                </a>
                                <a t-attf-href="#" role="button" class="btn btn-primary o_add_wishlist" t-att-data-product-template-id="bs.id" aria-label="Wishlist" title="Wishlist">
                                    <svg class="eco-food-card-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6l1.2 1.2L12 21l7.6-7.6 1.2-1.2a5.4 5.4 0 0 0 0-7.6Z"/>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
