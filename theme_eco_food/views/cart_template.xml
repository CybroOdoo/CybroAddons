<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="eco_food_cart" inherit_id="website_sale.cart_lines" name="Eco Food Cart">
        <xpath expr="//div[@id='cart_products']" position="attributes">
            <attribute name="class" add="eco-food-cart" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_cart_product')]" position="attributes">
            <attribute name="class" add="eco-food-cart-line rounded p-3 mb-3" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='cart_products']" position="after">
            <a href="/shop" class="btn btn-primary mt-3">Continue Shopping</a>
        </xpath>
    </template>
</odoo>
