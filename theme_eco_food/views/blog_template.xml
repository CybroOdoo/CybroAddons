<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="eco_food_blog_grid" inherit_id="website_blog.blog_post_short" name="Eco Food Blog Grid">
        <xpath expr="//t[@t-set='opt_blog_promoted_post']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
    </template>

    <template id="eco_food_blog_card" inherit_id="website_blog.blog_post_card" name="Eco Food Blog Card">
        <xpath expr="//article" position="attributes">
            <attribute name="t-attf-class" add="eco_food_blog_card" separator=" "/>
        </xpath>
    </template>
</odoo>
