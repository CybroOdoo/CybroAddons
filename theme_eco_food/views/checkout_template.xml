<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="eco_food_address" inherit_id="website_sale.address" name="Address">
        <xpath expr="//div[hasclass('o_customer_address_fill')]" position="attributes">
            <attribute name="class" add="Address" separator=" "/>
        </xpath>
        <xpath expr="//form[@name='address_form']" position="inside">
            <t t-call="portal.address_footer"/>
        </xpath>
    </template>
</odoo>
