<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!--    template for snippets-->
    <template id="theme_eco_food_snippets" inherit_id="website.snippets"
              name="theme eco food">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="theme_eco_food.eco_food_ad" snippet-group="theme_eco_food"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood_ad.jpg"/>
            <t t-snippet="theme_eco_food.ecofood_banner" snippet-group="eco_food_banner"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood-banner.jpg"/>
            <t t-snippet="theme_eco_food.eco_food_client" snippet-group="eco_client"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood-clients.jpg"/>
            <t t-snippet="theme_eco_food.eco_food_service" snippet-group="eco_food_service"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood-service.jpg"/>
            <t t-snippet="theme_eco_food.eco_food_website_ad" snippet-group="food_website_ad"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood-banner.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_eco_food.eco_food_ad" string="Title - Image" group="theme_eco_food"/>
            <t t-snippet="theme_eco_food.ecofood_banner" string="Food Banner - Image" group="eco_food_banner"/>
            <t t-snippet="theme_eco_food.eco_food_client" string="Food Client - Image" group="eco_client"/>
            <t t-snippet="theme_eco_food.eco_food_service" string="Food Service - Image" group="eco_food_service"/>
            <t t-snippet="theme_eco_food.eco_food_website_ad" string="Food Website - Image" group="food_website_ad"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="theme_eco_food.eco_food_best_seller" snippet-group="best_seller"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood-bestseller.jpg"/>
            <t t-snippet="theme_eco_food.eco_food_featured_products" snippet-group="features_product"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood-featured-products.jpg"/>
            <t t-snippet="theme_eco_food.eco_food_new_arrival" snippet-group="new_arrival"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood-new_arrivals.jpg"/>
            <t t-snippet="theme_eco_food.eco_food_recently_added_products" snippet-group="recently_added"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood_recently_added.jpg"/>
            <t t-snippet="theme_eco_food.eco_food_testimonial" snippet-group="testimonial"
               t-thumbnail="/theme_eco_food/static/src/images/images/ecofood-testimoinial.jpg"/>
        </xpath>
         <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_eco_food.eco_food_best_seller" string="Best - seller" group="best_seller"/>
            <t t-snippet="theme_eco_food.eco_food_featured_products" string="Feature Product - Image" group="features_product"/>
            <t t-snippet="theme_eco_food.eco_food_new_arrival" string="New Arrival - Image" group="new_arrival"/>
            <t t-snippet="theme_eco_food.eco_food_recently_added_products" string="Recently  Added - Image" group="recently_added"/>
            <t t-snippet="theme_eco_food.eco_food_testimonial" string="Testimonial  - Image" group="testimonial"/>
        </xpath>
    </template>
</odoo>
