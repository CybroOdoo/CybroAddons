<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Sale order report modern template-->
    <template id="report_saleorder_modern_document">
        <t t-call="web.external_layout">
            <t t-if="doc and 'company_id' in doc">
                <t t-set="company" t-value="doc.company_id"/>
            </t>
            <t t-if="not doc or not 'company_id' in doc">
                <t t-set="company" t-value="res_company"/>
            </t>
            <div class="header row mt-3 mb-3">
                <div class="page-header col-6">
                    <div t-if="company.logo" class="mb-2">
                        <img t-att-src="image_data_uri(company.logo)" style="max-height: 80px;"/>
                    </div>
                    <div t-attf-style="font:13px lucida-console,sans-serif; color:#{doc.theme_id.company_text_color} !important;">
                        <span t-field="company.partner_id.name"/><br/>
                        <span t-if="company.partner_id.street" t-field="company.partner_id.street"/><t t-if="company.partner_id.street"><br/></t>
                        <span t-if="company.partner_id.street2" t-field="company.partner_id.street2"/><t t-if="company.partner_id.street2"><br/></t>
                        <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>
                        <span t-if="company.partner_id.state_id" t-field="company.partner_id.state_id.code"/>
                        <span t-if="company.partner_id.zip" t-field="company.partner_id.zip"/><br/>
                        <span t-if="company.partner_id.country_id" t-field="company.partner_id.country_id.name"/><br/>
                        <span t-if="company.partner_id.vat" t-field="company.partner_id.vat"/>
                    </div>
                </div>
            </div>
            <t t-if="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            </t>
            <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
            <div class="page">
                <div class="oe_structure"/>

                <!-- Top Info Banner: Order Date and Salesperson -->
                <table class="w-100 mt-3 mb-3"
                       t-attf-style="background-color:#{doc.theme_id.base_color};color:#{doc.theme_id.heading_text_color};width:100%;border-collapse:collapse;">
                    <tr>
                        <td style="width: 50%; padding: 8px 12px; vertical-align: top;"
                            t-attf-style="color:#{doc.theme_id.heading_text_color};">
                            <strong t-if="doc.state in ['draft', 'sent']">Quotation Date:</strong>
                            <strong t-else="">Order Date:</strong>
                            <div t-field="doc.date_order" t-options='{"widget": "date"}'/>
                        </td>
                        <td style="width: 50%; padding: 8px 12px; vertical-align: top;"
                            t-attf-style="color:#{doc.theme_id.heading_text_color};"
                            t-if="doc.user_id.name">
                            <strong>Salesperson:</strong>
                            <div t-field="doc.user_id.name"/>
                        </td>
                    </tr>
                    <tr t-if="doc.client_order_ref or (doc.validity_date and doc.state in ['draft', 'sent'])">
                        <td style="width: 50%; padding: 0 12px 8px 12px; vertical-align: top;"
                            t-attf-style="color:#{doc.theme_id.heading_text_color};"
                            t-if="doc.client_order_ref">
                            <strong>Your Reference:</strong>
                            <div t-field="doc.client_order_ref"/>
                        </td>
                        <td style="width: 50%; padding: 0 12px 8px 12px; vertical-align: top;"
                            t-attf-style="color:#{doc.theme_id.heading_text_color};"
                            t-if="doc.validity_date and doc.state in ['draft', 'sent']">
                            <strong>Expiration:</strong>
                            <div t-field="doc.validity_date"/>
                        </td>
                    </tr>
                </table>

                <!-- Customer and Order Details Table -->
                <table class="table table-sm o_main_table mt-4 w-100" style="width: 100%; margin-bottom: 20px;">
                    <thead t-attf-style="background-color:#{doc.theme_id.base_color};color:#{doc.theme_id.heading_text_color};">
                        <tr>
                            <th style="width: 50%;">Customer</th>
                            <th style="width: 25%;" class="text-center">
                                <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice #</span>
                                <span t-elif="doc.state in ['draft','sent']">Quotation #</span>
                                <span t-else="">Order #</span>
                            </th>
                            <th style="width: 25%;" class="text-center">Payment Term</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-attf-style="color:#{doc.theme_id.customer_text_color} !important;">
                            <td style="width: 50%; vertical-align: top;">
                                <div t-field="doc.partner_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                                <p t-if="doc.partner_id.vat" class="m-0 mt-1">
                                    <t t-out="doc.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"/>:
                                    <span t-field="doc.partner_id.vat"/>
                                </p>
                            </td>
                            <td style="width: 25%; vertical-align: top;" class="text-center">
                                <span t-field="doc.name"/>
                            </td>
                            <td style="width: 25%; vertical-align: top;" class="text-center">
                                <span t-if="doc.payment_term_id" t-field="doc.payment_term_id.name"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Products Table -->
                <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
                <table class="table table-sm o_main_table mt-4 w-100" style="width: 100%;">
                    <thead t-attf-style="background-color:#{doc.theme_id.base_color};color:#{doc.theme_id.heading_text_color};">
                        <tr>
                            <th name="th_description" class="text-start">Description</th>
                            <th name="th_quantity" class="text-end">Quantity</th>
                            <th name="th_priceunit" class="text-end">Unit Price</th>
                            <th name="th_discount" t-if="display_discount" class="text-end"
                                groups="product.group_discount_per_so_line">
                                <span>Disc.%</span>
                            </th>
                            <th name="th_taxes" class="text-end">Taxes</th>
                            <th name="th_subtotal" class="text-end">
                                <span t-if="doc.company_price_include == 'tax_included'">Total Price</span>
                                <span t-else="">Amount</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-foreach="lines_to_report" t-as="line">
                            <t t-set="current_subtotal" t-value="current_subtotal + (line.price_total if doc.company_price_include == 'tax_included' else line.price_subtotal)"/>
                            <tr t-attf-style="color:#{doc.theme_id.customer_text_color} !important;"
                                t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type">
                                    <td name="td_name">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td name="td_quantity" class="text-end">
                                        <span t-field="line.product_uom_qty"/>
                                        <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                    </td>
                                    <td name="td_priceunit" class="text-end">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td t-if="display_discount" class="text-end"
                                        groups="product.group_discount_per_so_line">
                                        <span t-field="line.discount"/>
                                    </td>
                                    <t t-set="taxes" t-value="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                                    <td name="td_product_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                        <span t-out="taxes"/>
                                    </td>
                                    <td t-if="not line.is_downpayment" name="td_subtotal"
                                        class="text-end o_price_total">
                                        <span t-if="doc.company_price_include == 'tax_included'" t-field="line.price_total"/>
                                        <span t-else="" t-field="line.price_subtotal"/>
                                    </td>
                                </t>
                                <t t-elif="line.display_type == 'line_section'">
                                    <td name="td_section_line" colspan="99">
                                        <span t-field="line.name"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <td name="td_note_line" colspan="99">
                                        <span t-field="line.name"/>
                                    </td>
                                </t>
                            </tr>
                            <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section') and not line.is_downpayment">
                                <tr class="is-subtotal text-end">
                                    <td name="td_section_subtotal" colspan="99">
                                        <strong class="me-3">Subtotal</strong>
                                        <span t-out="current_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <!-- Totals Section (Right Aligned) -->
                <div class="clearfix mt-3 mb-3" name="so_total_summary">
                    <table class="table table-sm"
                           style="float: right; width: 40%; margin-bottom: 0;"
                           t-attf-style="background-color:#{doc.theme_id.base_color};color:#{doc.theme_id.heading_text_color};--bs-table-bg:#{doc.theme_id.base_color};--bs-table-color:#{doc.theme_id.heading_text_color};margin-bottom:0;float:right;width:40%;">
                        <!-- Tax totals -->
                        <t t-call="sale.document_tax_totals" tax_totals="doc.tax_totals" currency="doc.currency_id"/>
                    </table>
                </div>

                <div t-if="not is_html_empty(doc.payment_term_id.note) or doc.note" class="mt-4">
                    <p t-if="not is_html_empty(doc.payment_term_id.note)">
                        <span t-field="doc.payment_term_id.note"/>
                    </p>
                    <p t-if="doc.note" t-field="doc.note"/>
                </div>

                <div t-if="doc.signature" class="mt-4 ms-5 me-1" name="signature">
                    <div class="offset-8">
                        <strong>Signature</strong>
                    </div>
                    <div class="offset-8">
                        <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                    </div>
                    <div class="offset-8 text-center">
                        <p t-field="doc.signed_by"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
