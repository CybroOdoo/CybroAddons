<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="name">Invoices</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_advanced_report_templates.report_invoice_custom</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment">(object.state == 'posted') and ((object.name or 'INV').replace('/','_')+'.pdf')</field>
        <field name="binding_model_id" ref="model_account_move"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
        </record>
<!--    Custom invoice report template-->
    <template id="report_invoice_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-if="o._get_name_invoice_report() == 'base_advanced_report_templates.report_invoice_custom'"/>
                <t t-set="theme_style" t-value="o.theme_id.theme_style or ((o.theme_id.name or '').lower())"/>
                <t t-if="theme_style == 'traditional' or 'traditional' in theme_style">
                    <t t-call="base_advanced_report_templates.report_account_traditional_document" t-lang="lang"/>
                </t>
                <t t-elif="theme_style == 'standard' or 'standard' in theme_style">
                    <t t-call="base_advanced_report_templates.report_account_standard_document" t-lang="lang"/>
                </t>
                <t t-elif="theme_style == 'modern' or 'modern' in theme_style">
                    <t t-call="base_advanced_report_templates.report_account_modern_document" t-lang="lang"/>
                </t>
                <t t-elif="theme_style == 'attractive' or 'attractive' in theme_style">
                    <t t-call="base_advanced_report_templates.report_account_attractive_document" t-lang="lang"/>
                </t>
                <t t-elif="o.theme_id">
                    <t t-call="base_advanced_report_templates.report_account_traditional_document" t-lang="lang"/>
                </t>
                <t t-else="">
                    <t t-call="account.report_invoice_document" t-lang="lang"/>
                </t>
            </t>
        </t>
    </template>
<!--    Account report traditional template-->
    <template id="report_account_traditional_document">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <div class="header row my-4">
            <div class="page-header col-12">
                <div t-attf-class="float-start">
                    <t t-if="company.logo">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px;"/>
                    </t>
                </div>
                <div t-attf-class="float-start" t-attf-style="font:14px lucida-console,sans-serif; color:#{o.theme_id.company_text_color} !important;">
                    <span t-field="company.partner_id"/>
                    <br/>
                    <span t-field="company.partner_id.street"/>
                    <br/>
                    <span t-field="company.partner_id.street2"/>
                    <br/>
                    <span t-field="company.partner_id.city"/>
                    <br/>
                    <span t-field="company.partner_id.country_id"/>
                    <br/>
                    <span t-field="company.partner_id.vat"/>
                    <br/>
                </div>
            </div>
        </div>
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
            <div class="mt-4">
                <div class="page">
                    <!-- 1. Top Metadata Table: Invoice Date | Invoice Number | Due Date -->
                    <table class="table table-sm o_main_table mb-4" style="width: 100%;">
                        <thead t-attf-style="background-color:#{o.theme_id.base_color};color:#{o.theme_id.heading_text_color};">
                            <tr>
                                <th class="text-start" style="width: 33%;">
                                    <span t-if="o.move_type == 'out_refund'">Credit Note Date</span>
                                    <span t-elif="o.move_type == 'out_receipt'">Receipt Date</span>
                                    <span t-elif="o.move_type == 'in_invoice'">Bill Date</span>
                                    <span t-else="">Invoice Date</span>
                                </th>
                                <th class="text-center" style="width: 34%;">
                                    <span t-if="o.move_type == 'out_refund'">Credit Note Number</span>
                                    <span t-elif="o.move_type == 'in_invoice'">Bill Number</span>
                                    <span t-else="">Invoice Number</span>
                                </th>
                                <th class="text-end" style="width: 33%;">
                                    <span>Due Date</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-attf-style="color:#{o.theme_id.customer_text_color} !important;">
                                <td class="text-start">
                                    <span t-if="o.invoice_date" t-field="o.invoice_date"/>
                                </td>
                                <td class="text-center">
                                    <span t-if="o.name != '/'" t-field="o.name"/>
                                </td>
                                <td class="text-end">
                                    <span t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" t-field="o.invoice_date_due"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 2. Invoice Lines Table -->
                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                    <table class="table table-sm o_main_table" name="invoice_line_table">
                        <thead t-attf-style="background-color:#{o.theme_id.base_color};color:#{o.theme_id.heading_text_color};">
                            <tr>
                                <th name="th_description" class="text-start">
                                    <span>Description</span>
                                </th>
                                <th name="th_quantity" class="text-end">
                                    <span>Quantity</span>
                                </th>
                                <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span>Unit Price</span>
                                </th>
                                <th name="th_price_unit" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span>Disc.%</span>
                                </th>
                                <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span>Taxes</span>
                                </th>
                                <th name="th_subtotal" class="text-end">
                                    <span>Amount</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                            <t t-foreach="lines" t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                                <tr t-attf-style="color:#{o.theme_id.customer_text_color} !important;" t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="line.display_type == 'product' or not line.display_type" name="account_invoice_line_accountable">
                                        <td name="account_invoice_line_name">
                                            <span t-if="line.label" t-field="line.label" t-options="{'widget': 'text'}"/>
                                            <span t-elif="line.name" t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span class="text-nowrap" t-field="line.price_unit"/>
                                        </td>
                                        <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span class="text-nowrap" t-field="line.discount"/>
                                        </td>
                                        <td t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span t-out="', '.join(map(lambda x: (x.description or x.tax_label or x.name), line.tax_ids))" id="line_tax_ids"/>
                                        </td>
                                        <td class="text-end o_price_total">
                                            <span class="text-nowrap" t-field="line.price_subtotal"/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </t>
                                </tr>
                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                    <tr class="is-subtotal text-end">
                                        <td colspan="99">
                                            <strong class="me-3">Subtotal</strong>
                                            <span t-out="current_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- 3. Totals Section (Right Aligned) -->
                    <div class="clearfix mb-4">
                        <div id="total" class="row">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="table table-sm" t-attf-style="background-color:#{o.theme_id.base_color};color:#{o.theme_id.heading_text_color};">
                                    <!--Tax totals-->
                                    <t t-call="account.document_tax_totals" tax_totals="o.tax_totals" currency="o.currency_id"/>
                                    <!--Payments-->
                                    <t t-if="print_with_payments">
                                        <t t-if="o.payment_state != 'invoicing_legacy'">
                                            <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                            <t t-foreach="payments_vals" t-as="payment_vals">
                                                <tr t-if="payment_vals['is_exchange'] == 0">
                                                    <td>
                                                        <i class="oe_form_field text-end oe_payment_label">
                                                            Paid on
                                                            <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/>
                                                        </i>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="len(payments_vals) > 0">
                                                <tr class="border-black">
                                                    <td>
                                                        <strong>Amount Due</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="o.amount_residual"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Customer Box (Bottom) -->
                    <div class="p-3 mb-2"
                         t-attf-style="background-color:#{o.theme_id.base_color};color:#{o.theme_id.heading_text_color};">
                        <div style="font-weight: bold; font-size: 15px; margin-bottom: 6px;">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                            <span t-if="o.name != '/'" t-field="o.name"/>
                        </div>
                        <div style="font-weight: bold; font-size: 14px; margin-bottom: 4px;">
                            Customer
                        </div>
                        <div style="line-height: 1.4;">
                            <div t-if="o.partner_id.name" t-field="o.partner_id.name"/>
                            <div t-if="o.partner_id.street" t-field="o.partner_id.street"/>
                            <div t-if="o.partner_id.street2" t-field="o.partner_id.street2"/>
                            <div>
                                <span t-if="o.partner_id.city" t-field="o.partner_id.city"/>
                                <span t-if="o.partner_id.state_id" t-field="o.partner_id.state_id.code"/>
                                <span t-if="o.partner_id.zip" t-field="o.partner_id.zip"/>
                            </div>
                            <div t-if="o.partner_id.country_id" t-field="o.partner_id.country_id"/>
                            <div t-if="o.partner_id.phone">
                                📞 <span t-field="o.partner_id.phone"/>
                            </div>
                            <div t-if="o.partner_id.vat">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                                <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                            </div>
                        </div>
                    </div>

                    <!-- 5. Payment Communication & Payment Terms Banner (Bottom) -->
                    <div class="p-2 mb-4"
                         t-attf-style="background-color:#{o.theme_id.base_color};color:#{o.theme_id.heading_text_color};">
                        <div>
                            Please use the following communication for your payment : 
                            <b t-out="o.payment_reference or o.name"/>
                        </div>
                        <div t-if="o.invoice_payment_term_id">
                            <span>Payment terms: <span t-field="o.invoice_payment_term_id.name"/></span>
                        </div>
                    </div>

                    <!-- 6. Additional Notes & QR Code -->
                    <div t-if="not is_html_empty(o.narration)" name="comment" class="mt-2">
                        <span t-field="o.narration"/>
                    </div>
                    <p t-if="not is_html_empty(o.fiscal_position_id.note)" name="note">
                        <span t-field="o.fiscal_position_id.note"/>
                    </p>
                    <p t-if="o.invoice_incoterm_id" name="incoterm">
                        <strong>Incoterm:</strong>
                        <span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>
                    </p>
                    <div id="qrcode" t-if="o.display_qr_code and o.amount_residual > 0">
                        <p t-if="qr_code_urls.get(o.id)">
                            <strong class="text-center">Scan me with your banking app.</strong>
                            <br/><br/>
                            <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>
                        </p>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
