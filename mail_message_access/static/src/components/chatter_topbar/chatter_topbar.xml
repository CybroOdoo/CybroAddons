<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Replace the buttons with the condition if the user has access or not -->
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]"
               position="attributes">
            <attribute name="t-if">this.state.access_send_message_btn</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]"
               position="attributes">
            <attribute name="t-if">this.state.access_log_note_btn</attribute>
        </xpath>
    </t>
</templates>
