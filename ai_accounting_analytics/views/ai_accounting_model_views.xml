<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ai_accounting_model_view_list" model="ir.ui.view">
        <field name="name">ai.accounting.model.view.list</field>
        <field name="model">ai.accounting.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="technical_name"/>
                <field name="price_input"/>
                <field name="price_cached" optional="show"/>
                <field name="price_output"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ai_accounting_model_view_form" model="ir.ui.view">
        <field name="name">ai.accounting.model.view.form</field>
        <field name="model">ai.accounting.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Model">
                            <field name="provider_id"/>
                            <field name="technical_name"/>
                            <field name="max_output_tokens"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Pricing (USD / million tokens)">
                            <field name="price_input"/>
                            <field name="price_cached"/>
                            <field name="price_cache_write" invisible="provider_type != 'anthropic'"/>
                            <field name="price_output"/>
                        </group>
                    </group>
                    <group string="Advanced">
                        <field name="extra_params" widget="code" options="{'mode': 'javascript'}"
                               placeholder='{"generationConfig": {"thinkingConfig": {"thinkingLevel": "low"}}}'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_accounting_model_view_search" model="ir.ui.view">
        <field name="name">ai.accounting.model.view.search</field>
        <field name="model">ai.accounting.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="provider_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_accounting_model_action" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">ai.accounting.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_provider': 1}</field>
    </record>
</odoo>
