<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.accounting.analytics</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="before">
                <block title="AI Analytics" id="ai_accounting_analytics_settings"
                       groups="base_accounting_kit.group_account_chief">
                    <setting id="ai_accounting_default_model" string="Default AI Model"
                             help="Model preselected in AI Analytics. Users can switch per conversation.">
                        <field name="ai_accounting_default_model_id"/>
                        <div class="mt8">
                            <button name="%(ai_accounting_analytics.ai_accounting_provider_action)d" type="action"
                                    string="AI Providers" icon="east" class="btn-link"/>
                            <button name="%(ai_accounting_analytics.ai_accounting_api_key_action)d" type="action"
                                    string="My API Keys" icon="east" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="ai_accounting_token_saving" string="Token Budget"
                             help="Bound the tokens of every answer. Lower values are cheaper.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="ai_accounting_max_steps" class="col-lg-5 o_light_label"/>
                                <field name="ai_accounting_max_steps"/>
                            </div>
                            <div class="row">
                                <label for="ai_accounting_history_turns" class="col-lg-5 o_light_label"/>
                                <field name="ai_accounting_history_turns"/>
                            </div>
                            <div class="row">
                                <label for="ai_accounting_max_output_tokens" class="col-lg-5 o_light_label"/>
                                <field name="ai_accounting_max_output_tokens"/>
                            </div>
                            <div class="row">
                                <label for="ai_accounting_model_rows" class="col-lg-5 o_light_label"/>
                                <field name="ai_accounting_model_rows"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
