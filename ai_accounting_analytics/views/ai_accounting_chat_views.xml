<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ai_accounting_chat_view_list" model="ir.ui.view">
        <field name="name">ai.accounting.chat.view.list</field>
        <field name="model">ai.accounting.chat</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="last_message_date"/>
                <field name="model_id"/>
                <field name="total_tokens" sum="Total"/>
                <field name="total_cost" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="ai_accounting_chat_action" model="ir.actions.act_window">
        <field name="name">My AI Conversations</field>
        <field name="res_model">ai.accounting.chat</field>
        <field name="view_mode">list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <record id="ai_accounting_chat_action_client" model="ir.actions.client">
        <field name="name">AI Analytics</field>
        <field name="tag">ai_accounting_analytics.chat</field>
    </record>
</odoo>
