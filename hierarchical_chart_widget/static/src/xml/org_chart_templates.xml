<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!-- Template for Org Chart Widget -->
    <t t-name="hierarchical_chart_widget.CustomerChartWidget">
        <div class="org-chart">
            <span>
                <t t-if="this.OrgState.data?.parent || this.OrgState.data?.child?.length">
                    <p style="margin-top:20px;width:max-content;font-weight: 500;">
                        <u>HIERARCHY</u>
                    </p>
                </t>
            </span>
            <t t-if="this.OrgState.data?.parent">
                <div class="org-node parent-node">
                    <p style="width:max-content;font-weight: bold;margin-bottom: 0rem; cursor: pointer;"
                       t-on-click="() => this.onChildClick(this.OrgState.data.parent.id)">
                        <t t-out="this.OrgState.data.parent.name"/>
                    </p>
                </div>
            </t>
            <div class="org-parent">
                <div t-if="!this.OrgState.data?.parent"
                     class="org-node self-node"
                     style="margin-left:3px; margin-bottom: 0rem;font-size: 16px; font-weight: bold;">
                    <p style="margin-bottom:0rem;width:max-content; ">
                        <t t-if="this.OrgState.data?.self">
                            <t t-out="this.OrgState.data.self"/>
                        </t>
                    </p>
                </div>
                <div t-if="this.OrgState.data?.parent"
                     class="org-node self-node o_treeEntry"
                     style="margin-left:3px; margin-bottom: 0rem;">
                    <p style="margin-bottom:0rem;width:max-content;">
                        <t t-if="this.OrgState.data?.self">
                            <t t-out="this.OrgState.data.self"/>
                        </t>
                    </p>
                </div>
            </div>
            <t t-if="this.OrgState.data?.child?.length">
                <div class="org-children ">
                    <t t-foreach="this.OrgState.data.child" t-as="data"
                       t-key="data_index">
                        <div class="org-node child-node o_treeEntry"
                             style="margin-left:19px;width:max-content">
                            <p style="margin-bottom: 0rem; cursor: pointer;"
                               t-on-click="() => this.onChildClick(data.id)">
                                <t t-out="data.name"/>
                            </p>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
