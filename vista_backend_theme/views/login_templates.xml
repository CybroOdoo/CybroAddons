<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Always show the logo on the login card (as in version 19) -->
    <template id="login_layout" inherit_id="web.login_layout" name="Vista Login Layout">
        <xpath expr="//div[hasclass('border-bottom')][@t-if]" position="attributes">
            <attribute name="t-if">True</attribute>
        </xpath>
    </template>
</odoo>
