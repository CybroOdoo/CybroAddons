<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_backend_theme_data" model="ir.ui.view">
        <field name="name">theme.data.form</field>
        <field name="model">theme.data</field>
        <field name="arch" type="xml">
            <form create="0">
                <group>
                    <field name="name" widget="radio"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="vista_backend_theme_action" model="ir.actions.act_window">
        <field name="name">Backend Theme</field>
        <field name="res_model">theme.data</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="vista_backend_theme_data"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_change_theme"
              name="Change Backend Theme"
              parent="base.menu_administration"
              sequence="100"
              groups="base.group_system"
              action="vista_backend_theme_action"/>
</odoo>
