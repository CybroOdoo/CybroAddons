<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- The blue palette is the default one, declared in the manifest. The
         other themes swap the palette file; the active flag is what the
         theme wizard toggles, hence noupdate. -->
    <data noupdate="1">
        <record id="vista_theme_palette_green" model="ir.asset">
            <field name="name">Vista Backend Theme: Green palette</field>
            <field name="bundle">web._assets_primary_variables</field>
            <field name="directive">replace</field>
            <field name="target">vista_backend_theme/static/src/scss/palette_blue.scss</field>
            <field name="path">vista_backend_theme/static/src/scss/palette_green.scss</field>
            <field name="active" eval="False"/>
        </record>
        <record id="vista_theme_palette_black" model="ir.asset">
            <field name="name">Vista Backend Theme: Black palette</field>
            <field name="bundle">web._assets_primary_variables</field>
            <field name="directive">replace</field>
            <field name="target">vista_backend_theme/static/src/scss/palette_blue.scss</field>
            <field name="path">vista_backend_theme/static/src/scss/palette_black.scss</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
