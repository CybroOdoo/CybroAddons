<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="vista_backend_theme.ThemeSwitcher">
        <Dropdown>
            <button class="o_vista_theme_switcher" title="Change backend theme" data-hotkey="shift+t">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                     viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34a.996.996 0 0 0-1.41 0L9 12.25 11.75 15l10.96-10.96c.39-.39.39-1.02 0-1.41z"/>
                </svg>
            </button>
            <t t-set-slot="content">
                <DropdownItem t-foreach="this.themes" t-as="theme" t-key="theme.key"
                              onSelected="() => this.selectTheme(theme)">
                    <span class="o_vista_theme_dot" t-attf-style="background-color: {{ theme.color }}"/>
                    <t t-out="theme.label"/>
                </DropdownItem>
            </t>
        </Dropdown>
    </t>
</templates>
