<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Tags that tell the requests of the AeroCourt website apart in the CRM.
-->
<odoo noupdate="1">
    <record id="crm_tag_court" model="crm.tag">
        <field name="name">Court Booking</field>
    </record>
    <record id="crm_tag_session" model="crm.tag">
        <field name="name">Session Booking</field>
    </record>
    <record id="crm_tag_membership" model="crm.tag">
        <field name="name">Membership</field>
    </record>
    <record id="crm_tag_contact" model="crm.tag">
        <field name="name">Contact Message</field>
    </record>
</odoo>
