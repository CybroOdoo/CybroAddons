<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Menus of the AeroCourt navigation: About, Courts, Sessions, Journal and
    Contact, after the Home entry of the website.
-->
<odoo>
    <record id="menu_about" model="theme.website.menu">
        <field name="name">About</field>
        <field name="url">/about</field>
        <field name="page_id" ref="about_page_page"/>
        <field name="sequence" type="int">15</field>
    </record>
    <record id="menu_courts" model="theme.website.menu">
        <field name="name">Courts</field>
        <field name="url">/booking</field>
        <field name="page_id" ref="booking_page_page"/>
        <field name="sequence" type="int">20</field>
    </record>
    <record id="menu_sessions" model="theme.website.menu">
        <field name="name">Sessions</field>
        <field name="url">/sessions</field>
        <field name="page_id" ref="sessions_page_page"/>
        <field name="sequence" type="int">25</field>
    </record>
    <record id="menu_journal" model="theme.website.menu">
        <field name="name">Journal</field>
        <field name="url">/blog</field>
        <field name="sequence" type="int">30</field>
    </record>
    <record id="menu_contact" model="theme.website.menu">
        <field name="name">Contact</field>
        <field name="url">/contact</field>
        <field name="page_id" ref="contact_page_page"/>
        <field name="sequence" type="int">35</field>
    </record>
</odoo>
