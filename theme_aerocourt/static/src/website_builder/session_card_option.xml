<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Session cards of the website builder. A card is a block of the page: the
    builder clones it, deletes it and edits its text and photo; this option
    adds the one style switch of the card. A time slot is a block too: select
    it to duplicate it, delete it or retype the day and time. A testimonial
    slide of the carousel works the same way.
-->
<templates xml:space="preserve">

<t t-name="theme_aerocourt.SessionCardOption">
    <BuilderRow label.translate="Few spots left" applyTo="'.ac-session-card__spots'">
        <BuilderCheckbox classAction="'is-low'"/>
    </BuilderRow>
</t>

<t t-name="theme_aerocourt.TimeSlotOption">
    <BuilderRow label.translate="Time slot">
        <span class="small">Duplicate or delete it with the icons above, retype the day and time (for example Mon 18:30) in the card.</span>
    </BuilderRow>
</t>

<t t-name="theme_aerocourt.TestimonialOption">
    <BuilderRow label.translate="Testimonial">
        <span class="small">Duplicate or delete it with the icons above to add or remove a slide, then retype the quote and the member.</span>
    </BuilderRow>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <aerocourt_session_card_option
            template="theme_aerocourt.SessionCardOption"
            selector=".ac-session-card"/>
        <aerocourt_time_slot_option
            template="theme_aerocourt.TimeSlotOption"
            selector=".ac-time-chip"/>
        <aerocourt_testimonial_option
            template="theme_aerocourt.TestimonialOption"
            selector=".ac-testimonial"/>
    </xpath>
</t>

</templates>
