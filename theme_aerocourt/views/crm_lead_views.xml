<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Booking details of the leads created from the AeroCourt website.
-->
<odoo>
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.theme.aerocourt</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']" position="before">
                <page string="AeroCourt" name="aerocourt" invisible="not aerocourt_kind">
                    <group>
                        <group>
                            <field name="aerocourt_kind"/>
                            <field name="aerocourt_reference"/>
                            <field name="aerocourt_date"/>
                            <field name="aerocourt_slot"/>
                        </group>
                        <group>
                            <field name="aerocourt_court"/>
                            <field name="aerocourt_rental_count"/>
                            <field name="aerocourt_total"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_search" model="ir.ui.view">
        <field name="name">crm.lead.view.search.inherit.theme.aerocourt</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Court Bookings" name="aerocourt_court" domain="[('aerocourt_kind', '=', 'court')]"/>
                <filter string="Session Bookings" name="aerocourt_session" domain="[('aerocourt_kind', '=', 'session')]"/>
                <filter string="Memberships" name="aerocourt_membership" domain="[('aerocourt_kind', '=', 'membership')]"/>
                <filter string="Contact Messages" name="aerocourt_contact" domain="[('aerocourt_kind', '=', 'contact')]"/>
                <field name="aerocourt_reference"/>
            </xpath>
        </field>
    </record>
</odoo>
