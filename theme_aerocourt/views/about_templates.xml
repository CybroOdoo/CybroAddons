<?xml version="1.0" encoding="UTF-8" ?>
<!--
    About page of the AeroCourt theme, built from editable sections.
-->
<odoo>
    <template id="about_page" name="AeroCourt About">
        <t t-call="website.layout">
            <t t-set="additional_title">About</t>
            <t t-set="pageName" t-valuef="aerocourt_about"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="ac-page-hero ac-about-hero" id="page-top" aria-labelledby="aboutPageTitle">
                      <div class="ac-page-hero__media" aria-hidden="true">
                        <img data-parallax="" src="/theme_aerocourt/static/src/img/photos/1559369064-c4d65141e408.jpg" alt=""/>
                      </div>
                      <div class="ac-page-hero__overlay" aria-hidden="true"/>
                      <div class="ac-container ac-page-hero__inner">
                        <p class="ac-eyebrow ac-hero__eyebrow" data-hero-step="1"><span class="ac-eyebrow__index"><i class="ac-icon ac-i-boxicons-shuttlecock-filled" role="img" aria-hidden="true"/></span>About AeroCourt</p>
                        <h1 class="ac-page-hero__title" id="aboutPageTitle">
                          <span class="ac-hero__line"><span>A space to play.</span></span>
                          <span class="ac-hero__line"><span class="ac-accent">A community to grow.</span></span>
                        </h1>
                        <p class="ac-page-hero__text" data-hero-step="3">Since 2019 we’ve been building the kind of badminton club we always wanted to play in: great courts, honest coaching and people who love the game.</p>
                      </div>
                    </section>

    
                <section class="ac-section ac-story" aria-labelledby="storyTitle">
                      <div class="ac-container ac-story__layout">
                        <div class="ac-story__text">
                          <p class="ac-eyebrow" data-reveal=""><span class="ac-eyebrow__index">01</span> Our story</p>
                          <h2 class="ac-section-title ac-section-title--md" id="storyTitle" data-reveal="">Built by players, <span class="ac-accent">for players.</span></h2>
                          <p class="ac-story__lead" data-reveal="">AeroCourt started with a simple frustration: too many halls with slippery floors, poor lighting and nowhere to grow as a player.</p>
                          <div class="ac-story__body" data-reveal="">
                            <p>So a small group of club players and coaches set out to build something better: four dedicated badminton courts with tournament-standard flooring and lighting, a coaching programme for every level, and a lounge where games turn into friendships.</p>
                          </div>
                          <figure class="ac-story__quote" data-reveal="">
                            <blockquote>“We wanted a place where a beginner and a county player could share the same hall and both leave better.”</blockquote>
                            <figcaption><span class="ac-post-author__avatar" aria-hidden="true">LV</span> Lena V. · Co-founder &amp; Head of Performance</figcaption>
                          </figure>
                        </div>

                        <div class="ac-story__visual" aria-hidden="true">

                          <figure class="ac-story__photo ac-story__photo--main" data-reveal="clip">
                            <img data-parallax="" src="/theme_aerocourt/static/src/img/photos/1599474924187-334a4ae5bd3c.jpg" alt="" loading="lazy"/>
                          </figure>
                          <figure class="ac-story__photo ac-story__photo--inset" data-reveal="clip">
                            <img src="/theme_aerocourt/static/src/img/photos/1722087642932-9b070e9a066e.jpg" alt="" loading="lazy"/>
                          </figure>

     

                          <div class="ac-story__badge"><span>Est.</span><strong>2019</strong></div>
                        </div>
                      </div>
                    </section>

    
                <section class="ac-numbers" aria-label="AeroCourt in numbers">
                      <div class="ac-numbers__marquee" aria-hidden="true">
                        <span>Play well</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/><span>Keep improving</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/><span>One more rally</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/>
                        <span>Play well</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/><span>Keep improving</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/><span>One more rally</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/>
                      </div>
                      <div class="ac-container ac-numbers__grid" data-reveal-stagger="">
                        <div class="ac-numbers__item"><span class="ac-numbers__value"><span data-count="4" data-ac="courts" data-pad="2">04</span></span><span class="ac-numbers__label">Pro-spec courts</span></div>
                        <div class="ac-numbers__item"><span class="ac-numbers__value"><span data-count="1200">1200</span><small>+</small></span><span class="ac-numbers__label">Active members</span></div>
                        <div class="ac-numbers__item"><span class="ac-numbers__value"><span data-count="30">30</span><small>k</small></span><span class="ac-numbers__label">Hours played each year</span></div>
                        <div class="ac-numbers__item"><span class="ac-numbers__value"><span data-count="150">150</span><small>+</small></span><span class="ac-numbers__label">Juniors in the academy</span></div>
                      </div>
                    </section>

    
                <section class="ac-section ac-values" aria-labelledby="valuesTitle">
                      <div class="ac-container">
                        <header class="ac-section-head">
                          <div class="ac-section-head__main" data-reveal="">
                            <p class="ac-eyebrow"><span class="ac-eyebrow__index">02</span> What we stand for</p>
                            <h2 class="ac-section-title ac-section-title--md" id="valuesTitle">Four things we <span class="ac-accent">never compromise.</span></h2>
                          </div>
                          <p class="ac-section-head__text" data-reveal="">Every decision, from the floor we lay to the coaches we hire, comes back to these.</p>
                        </header>
                        <ul class="ac-value-grid" data-reveal-stagger="">
                          <li class="ac-value-card">
                            <span class="ac-value-card__icon"><i class="ac-icon ac-i-ph-medal-bold" role="img" aria-hidden="true"/></span>
                            <span class="ac-value-card__num">01</span>
                            <h3>Court first</h3>
                            <p>Cushioned mats, glare-free lighting and proper run-off space. Quality of play comes before everything else.</p>
                          </li>
                          <li class="ac-value-card">
                            <span class="ac-value-card__icon"><i class="ac-icon ac-i-ph-chalkboard-teacher-bold" role="img" aria-hidden="true"/></span>
                            <span class="ac-value-card__num">02</span>
                            <h3>Coaching that counts</h3>
                            <p>Small groups, certified coaches and clear feedback, so every session leaves you a little better.</p>
                          </li>
                          <li class="ac-value-card">
                            <span class="ac-value-card__icon"><i class="ac-icon ac-i-ph-hand-heart-bold" role="img" aria-hidden="true"/></span>
                            <span class="ac-value-card__num">03</span>
                            <h3>Open to all</h3>
                            <p>Juniors, beginners and competitors share the same hall and the same respect. No egos, just rallies.</p>
                          </li>
                          <li class="ac-value-card">
                            <span class="ac-value-card__icon"><i class="ac-icon ac-i-ph-users-three-bold" role="img" aria-hidden="true"/></span>
                            <span class="ac-value-card__num">04</span>
                            <h3>Community, always</h3>
                            <p>Social nights, club tournaments and a lounge that keeps people talking long after the last game.</p>
                          </li>
                        </ul>
                      </div>
                    </section>

    
                <section class="ac-section ac-journey" aria-labelledby="journeyTitle">
                      <div class="ac-container">
                        <header class="ac-section-head">
                          <div class="ac-section-head__main" data-reveal="">
                            <p class="ac-eyebrow"><span class="ac-eyebrow__index">03</span> Our journey</p>
                            <h2 class="ac-section-title ac-section-title--md" id="journeyTitle">From four nets <span class="ac-accent">to a club.</span></h2>
                          </div>
                        </header>
                        <ol class="ac-timeline" data-timeline="">
                          <li class="ac-timeline__item">
                            <span class="ac-timeline__year">2019</span>
                            <div class="ac-timeline__card"><h3>The doors open</h3><p>Four courts, one coach and a handful of founding members in a converted warehouse.</p></div>
                          </li>
                          <li class="ac-timeline__item">
                            <span class="ac-timeline__year">2020</span>
                            <div class="ac-timeline__card"><h3>Junior Academy launches</h3><p>Our first structured programme for young players, with 24 juniors in the first term.</p></div>
                          </li>
                          <li class="ac-timeline__item">
                            <span class="ac-timeline__year">2022</span>
                            <div class="ac-timeline__card"><h3>Pro-grade upgrade</h3><p>New cushioned court mats and tournament LED lighting across every court.</p></div>
                          </li>
                          <li class="ac-timeline__item">
                            <span class="ac-timeline__year">2024</span>
                            <div class="ac-timeline__card"><h3>1,000 members</h3><p>The community passes a thousand players, with sessions running seven days a week.</p></div>
                          </li>
                          <li class="ac-timeline__item ac-timeline__item--now">
                            <span class="ac-timeline__year">Today</span>
                            <div class="ac-timeline__card"><h3>Still growing</h3><p>Online booking, new coaching programmes and the same love for one more rally.</p></div>
                          </li>
                        </ol>
                        <p class="ac-muted-note">Club history shown is sample content.</p>
                      </div>
                    </section>

    
                <section class="ac-section ac-inside" aria-labelledby="insideTitle">
                      <div class="ac-container">
                        <header class="ac-section-head">
                          <div class="ac-section-head__main" data-reveal="">
                            <p class="ac-eyebrow"><span class="ac-eyebrow__index">04</span> Inside the club</p>
                            <h2 class="ac-section-title ac-section-title--md" id="insideTitle">Built for <span class="ac-accent">the game.</span></h2>
                          </div>
                          <p class="ac-section-head__text" data-reveal="">Pro-grade courts, a pro shop and proper changing rooms, all under one roof.</p>
                        </header>
                        <div class="ac-gallery" data-reveal-stagger="">
                          <figure class="ac-gallery__item ac-gallery__item--tall">
                            <img src="/theme_aerocourt/static/src/img/photos/1626224583764-f87db24ac4ea.jpg" alt="Player jumping for a smash under the hall lights" loading="lazy"/>
                            <figcaption>Championship-standard courts</figcaption>
                          </figure>
                          <figure class="ac-gallery__item ac-gallery__item--wide">
                            <img src="/theme_aerocourt/static/src/img/gallery-flooring.webp" alt="Close-up of cushioned court flooring with coloured court lines" loading="lazy"/>
                            <figcaption>Pro-grade court flooring</figcaption>
                          </figure>
                          <figure class="ac-gallery__item">
                            <img src="/theme_aerocourt/static/src/img/gallery-rentals.webp" alt="A feather shuttlecock resting on a racket" loading="lazy"/>
                            <figcaption>Pro shop &amp; rentals</figcaption>
                          </figure>
                          <figure class="ac-gallery__item ac-gallery__item--span2">
                            <img src="/theme_aerocourt/static/src/img/gallery-lockers.webp" alt="Changing room with numbered lockers and benches" loading="lazy"/>
                            <figcaption>Changing rooms &amp; lockers</figcaption>
                          </figure>
                        </div>
                      </div>
                    </section>


   
  
  
            </div>
        </t>
    </template>

    <record id="about_page_page" model="theme.website.page">
        <field name="url">/about</field>
        <field name="view_id" ref="about_page"/>
        <field name="is_published" eval="True"/>
        <field name="header_overlay" eval="True"/>
    </record>
</odoo>
