<!--
    Story With Stats: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_home_story" name="AeroCourt Story With Stats">
<section class="ac-section ac-story ac-home-story s_aerocourt_home_story" aria-labelledby="aboutTitle" data-name="Story With Stats" data-snippet="s_aerocourt_home_story">
                      <div class="ac-container ac-story__layout">
                        <div class="ac-story__visual" aria-hidden="true">
                          <svg class="ac-story__lines" viewbox="0 0 400 480" fill="none">
                            <rect x="1" y="1" width="398" height="478" rx="6"/>
                            <path d="M1 240h398M200 1v478M1 70h398M1 410h398M40 1v478M360 1v478"/>
                          </svg>
                          <figure class="ac-story__photo ac-story__photo--main" data-reveal="clip">
                            <img data-parallax="" src="/theme_aerocourt/static/src/img/photos/1626224583764-f87db24ac4ea.jpg" alt="" loading="lazy"/>
                          </figure>
                          <figure class="ac-story__photo ac-story__photo--inset" data-reveal="clip">
                            <img src="/theme_aerocourt/static/src/img/gallery-flooring.webp" alt="" loading="lazy"/>
                          </figure>
                          <div class="ac-story__card">
                            <span class="ac-story__card-avatars"><i>LV</i><i>AK</i><i>MR</i><i>+</i></span>
                            <strong>1,200+</strong>
                            <span>members on court</span>
                          </div>
                          <div class="ac-story__badge"><span>Est.</span><strong>2019</strong></div>
                        </div>

                        <div class="ac-story__text">
                          <p class="ac-eyebrow" data-reveal=""><span class="ac-eyebrow__index">03</span> Our story</p>
                          <h2 class="ac-section-title ac-section-title--md" id="aboutTitle" data-reveal="">A space to play. <span class="ac-accent">A community to grow.</span></h2>
                          <p class="ac-story__lead" data-reveal="">Built by players, for players. From first-time rallies to tournament prep, everyone shares the same hall and the same love for one more game.</p>
                          <div class="ac-home-story__stats" data-reveal-stagger="">
                            <div><strong><span data-count="1200">1200</span>+</strong><span>Active members</span></div>
                            <div><strong><span data-count="12">12</span></strong><span>Certified coaches</span></div>
                            <div><strong><span data-count="30">30</span>k</strong><span>Hours played yearly</span></div>
                          </div>
                          <p class="ac-muted-note">Sample figures.</p>
                          <a href="/about" class="ac-btn ac-btn--ghost" data-reveal="">Read our story <i class="ac-icon ac-i-ph-arrow-right-bold" role="img" aria-hidden="true"/></a>
                        </div>
                      </div>
                    </section>

    
                
    </template>
</odoo>
