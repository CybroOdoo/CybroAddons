<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Page Hero Short: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_page_hero_short" name="AeroCourt Page Hero Short">
<section class="ac-page-hero ac-page-hero--short ac-contact-hero s_aerocourt_page_hero_short" aria-labelledby="contactPageTitle" data-name="Page Hero Short" data-snippet="s_aerocourt_page_hero_short">
                      <div class="ac-page-hero__media" aria-hidden="true">
                        <img data-parallax="" src="/theme_aerocourt/static/src/img/gallery-rentals.webp" alt=""/>
                      </div>
                      <div class="ac-page-hero__overlay" aria-hidden="true"/>
                      <div class="ac-container ac-page-hero__inner">
                        <p class="ac-eyebrow ac-hero__eyebrow" data-hero-step="1"><span class="ac-eyebrow__index"><i class="ac-icon ac-i-ph-chat-circle-dots-bold" role="img" aria-hidden="true"/></span>Contact us</p>
                        <h1 class="ac-page-hero__title" id="contactPageTitle">
                          <span class="ac-hero__line"><span>Let’s talk</span></span>
                          <span class="ac-hero__line"><span class="ac-accent">badminton.</span></span>
                        </h1>
                        <p class="ac-page-hero__text" data-hero-step="3">Questions about courts, coaching or membership? Send us a message and we usually reply within one working day.</p>
                      </div>
                    </section>

    
                
    </template>
</odoo>
