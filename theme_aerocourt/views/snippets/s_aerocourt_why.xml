<!--
    Why Us Tiles: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_why" name="AeroCourt Why Us Tiles">
<section class="ac-section ac-why s_aerocourt_why" aria-labelledby="whyTitle" data-name="Why Us Tiles" data-snippet="s_aerocourt_why">
                      <div class="ac-container">
                        <header class="ac-section-head">
                          <div class="ac-section-head__main" data-reveal="">
                            <p class="ac-eyebrow"><span class="ac-eyebrow__index">01</span> Why AeroCourt</p>
                            <h2 class="ac-section-title" id="whyTitle">Everything<br/><span class="ac-accent">but excuses.</span></h2>
                          </div>
                          <p class="ac-section-head__text" data-reveal="">Pro-spec courts, simple pricing and coaches who care, all under one roof, open from early till late.</p>
                        </header>

                        <div class="ac-bento" data-reveal-stagger="">
                          <a class="ac-bento__tile ac-bento__tile--hero" href="/about">
                            <img src="/theme_aerocourt/static/src/img/photos/1599474924187-334a4ae5bd3c.jpg" alt="A player returning the shuttle on a blue indoor court" loading="lazy"/>
                            <span class="ac-bento__content">
                              <span class="ac-bento__big">04</span>
                              <strong>Pro-spec indoor courts</strong>
                              <span>Cushioned mats, tournament LED lighting and proper run-off space.</span>
                            </span>
                            <span class="ac-bento__go" aria-hidden="true"><i class="ac-icon ac-i-ph-arrow-up-right-bold" role="img" aria-hidden="true"/></span>
                          </a>

                          <a class="ac-bento__tile ac-bento__tile--lime" href="/booking">
                            <span class="ac-bento__label">Any court, any time</span>
                            <span class="ac-bento__price"><small><span data-ac="currency">$</span></small><span data-ac="rate">18</span><em>/hr</em></span>
                            <span class="ac-bento__foot">Book now <i class="ac-icon ac-i-ph-arrow-right-bold" role="img" aria-hidden="true"/></span>
                          </a>

                          <div class="ac-bento__tile ac-bento__tile--status">
                            <span class="ac-status-pill" data-open-status=""><span class="ac-status-pill__dot"/><span class="ac-status-pill__text">Open daily · <span data-ac="hours">06:00 – 23:00</span></span></span>
                            <span class="ac-bento__big ac-bento__big--sm"><span data-ac="hours-short">06–23</span></span>
                            <span class="ac-bento__text">Open every day of the year, early birds to night owls.</span>
                          </div>

                          <a class="ac-bento__tile ac-bento__tile--image" href="/booking">
                            <img src="/theme_aerocourt/static/src/img/gallery-rentals.webp" alt="A feather shuttlecock resting on a racket" loading="lazy"/>
                            <span class="ac-bento__content ac-bento__content--sm">
                              <strong>Racket &amp; shuttle rental</strong>
                              <span>Just bring your shoes.</span>
                            </span>
                          </a>

                          <a class="ac-bento__tile ac-bento__tile--coach" href="/sessions">
                            <i class="ac-icon ac-i-ph-chalkboard-teacher-bold" role="img" aria-hidden="true"/>
                            <span class="ac-bento__big ac-bento__big--sm">12</span>
                            <span class="ac-bento__text">Certified coaches for beginners, juniors and competitors.</span>
                            <span class="ac-bento__foot">Find a session <i class="ac-icon ac-i-ph-arrow-right-bold" role="img" aria-hidden="true"/></span>
                          </a>
                        </div>
                      </div>
                    </section>

    

    
                
    </template>
</odoo>
