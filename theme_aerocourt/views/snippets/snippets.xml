<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Building blocks of the AeroCourt theme, listed in their own group of the
    website builder.
-->
<odoo>
    <template id="snippets" inherit_id="website.snippets" name="AeroCourt Snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="aerocourt" t-snippet="website.s_snippet_group" string="AeroCourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_group_thumb.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_aerocourt.s_aerocourt_hero" string="Hero" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_hero_thumb.jpg">
                <keywords>hero, banner, cover, home, stats</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_page_hero" string="Page Hero" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_page_hero_thumb.jpg">
                <keywords>page hero, title, banner, header</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_page_hero_short" string="Page Hero Short" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_page_hero_short_thumb.jpg">
                <keywords>page hero, short, title, contact</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_why" string="Why Us Tiles" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_why_thumb.jpg">
                <keywords>why, features, bento, tiles, highlights</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_story" string="Story" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_story_thumb.jpg">
                <keywords>story, about, text, image</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_home_story" string="Story With Stats" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_home_story_thumb.jpg">
                <keywords>story, about, stats, figures</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_numbers" string="Numbers Strip" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_numbers_thumb.jpg">
                <keywords>numbers, stats, counters, figures</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_values" string="Values Grid" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_values_thumb.jpg">
                <keywords>values, principles, cards, features</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_journey" string="Timeline" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_journey_thumb.jpg">
                <keywords>timeline, journey, history, milestones</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_inside" string="Photo Gallery" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_inside_thumb.jpg">
                <keywords>gallery, photos, images, facilities</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_membership" string="Membership Plans" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_membership_thumb.jpg">
                <keywords>membership, pricing, plans, packages</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_testimonials" string="Testimonials Carousel" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_testimonials_thumb.jpg">
                <keywords>testimonials, reviews, quotes, carousel</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_faq" string="FAQ" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_faq_thumb.jpg">
                <keywords>faq, questions, accordion, help</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_contact" string="Contact Form" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_contact_thumb.jpg">
                <keywords>contact, form, visit, map, hours</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_sessions" string="Featured Sessions" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_sessions_thumb.jpg">
                <keywords>sessions, coaching, programmes, cards</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_programs" string="Session Finder" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_programs_thumb.jpg">
                <keywords>sessions, filter, programmes, finder</keywords>
            </t>
            <t t-snippet="theme_aerocourt.s_aerocourt_booking" string="Court Booking Calendar" group="aerocourt"
               t-thumbnail="/theme_aerocourt/static/src/img/snippets/s_aerocourt_booking_thumb.jpg">
                <keywords>booking, calendar, courts, reserve</keywords>
            </t>
        </xpath>
    </template>
</odoo>
