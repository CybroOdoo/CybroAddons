<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Timeline: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_journey" name="AeroCourt Timeline">
<section class="ac-section ac-journey s_aerocourt_journey" aria-labelledby="journeyTitle" data-name="Timeline" data-snippet="s_aerocourt_journey">
                      <div class="ac-container">
                        <header class="ac-section-head">
                          <div class="ac-section-head__main" data-reveal="">
                            <p class="ac-eyebrow"><span class="ac-eyebrow__index">03</span> Our journey</p>
                            <h2 class="ac-section-title ac-section-title--md" id="journeyTitle">From four nets <span class="ac-accent">to a club.</span></h2>
                          </div>
                        </header>
                        <ol class="ac-timeline" data-timeline="">
                          <li class="ac-timeline__item">
                            <span class="ac-timeline__year">2019</span>
                            <div class="ac-timeline__card"><h3>The doors open</h3><p>Four courts, one coach and a handful of founding members in a converted warehouse.</p></div>
                          </li>
                          <li class="ac-timeline__item">
                            <span class="ac-timeline__year">2020</span>
                            <div class="ac-timeline__card"><h3>Junior Academy launches</h3><p>Our first structured programme for young players, with 24 juniors in the first term.</p></div>
                          </li>
                          <li class="ac-timeline__item">
                            <span class="ac-timeline__year">2022</span>
                            <div class="ac-timeline__card"><h3>Pro-grade upgrade</h3><p>New cushioned court mats and tournament LED lighting across every court.</p></div>
                          </li>
                          <li class="ac-timeline__item">
                            <span class="ac-timeline__year">2024</span>
                            <div class="ac-timeline__card"><h3>1,000 members</h3><p>The community passes a thousand players, with sessions running seven days a week.</p></div>
                          </li>
                          <li class="ac-timeline__item ac-timeline__item--now">
                            <span class="ac-timeline__year">Today</span>
                            <div class="ac-timeline__card"><h3>Still growing</h3><p>Online booking, new coaching programmes and the same love for one more rally.</p></div>
                          </li>
                        </ol>
                        <p class="ac-muted-note">Club history shown is sample content.</p>
                      </div>
                    </section>

    
                
    </template>
</odoo>
