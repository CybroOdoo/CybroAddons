<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Featured Sessions: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_sessions" name="AeroCourt Featured Sessions">
<section class="ac-section ac-sessions s_aerocourt_sessions" aria-labelledby="sessionsTitle" data-name="Featured Sessions" data-snippet="s_aerocourt_sessions">
                      <div class="ac-container">
                        <header class="ac-programs__head">
                          <div data-reveal="">
                            <p class="ac-eyebrow"><span class="ac-eyebrow__index">02</span> Coaching</p>
                            <h2 class="ac-section-title ac-section-title--md" id="sessionsTitle">Train with <span class="ac-accent">purpose.</span></h2>
                          </div>
                          <a href="/sessions" class="ac-link-arrow" data-reveal="">All sessions &amp; timetable <i class="ac-icon ac-i-ph-arrow-up-right-bold" role="img" aria-hidden="true"/></a>
                        </header>
                        <div class="ac-session-grid ac-home-sessions" id="sessionGrid" data-reveal-stagger="">
                      <article class="ac-session-card">
                        <div class="ac-session-card__media">
                          <img src="/theme_aerocourt/static/src/img/photos/1521537634581-0dced2fee2ef.jpg" alt="Badminton racket and shuttlecock up close" loading="lazy"/>
                          <span class="ac-session-card__level">Beginner</span>
                          <span class="ac-session-card__spots">5 spots left</span>
                        </div>
                        <div class="ac-session-card__body">
                          <p class="ac-session-card__cat">Group coaching</p>
                          <h3 class="ac-session-card__title">Beginner Fundamentals</h3>
                          <p class="ac-session-card__desc">Learn grips, footwork, serving, and basic rallies.</p>
                          <div class="ac-session-card__meta">
                            <span class="ac-session-card__duration"><i class="ac-icon ac-i-ph-timer-bold" role="img" aria-hidden="true"/> 60 min</span>
                            <span class="ac-session-card__coach"><i class="ac-icon ac-i-ph-user-circle-bold" role="img" aria-hidden="true"/> Maya R.</span>
                            <span class="ac-session-card__price"><strong>$25</strong></span>
                          </div>
                          <fieldset>
                            <legend class="ac-session-card__times-label">Available times</legend>
                            <div class="ac-session-card__times">
                        <label class="ac-time-chip"><input type="radio" name="time-beginner" value="Mon 07:00"/><span>Mon 07:00</span></label>
                        <label class="ac-time-chip"><input type="radio" name="time-beginner" value="Wed 18:00"/><span>Wed 18:00</span></label>
                        <label class="ac-time-chip"><input type="radio" name="time-beginner" value="Sat 09:00"/><span>Sat 09:00</span></label>
                            </div>
                          </fieldset>
                          <button type="button" class="ac-btn ac-btn--ghost ac-btn--block ac-session-book">Book session</button>
                        </div>
                      </article>
                      <article class="ac-session-card">
                        <div class="ac-session-card__media">
                          <img src="/theme_aerocourt/static/src/img/photos/1599474924187-334a4ae5bd3c.jpg" alt="Player moving to return a shot on a blue court" loading="lazy"/>
                          <span class="ac-session-card__level">Intermediate</span>
                          <span class="ac-session-card__spots is-low">3 spots left</span>
                        </div>
                        <div class="ac-session-card__body">
                          <p class="ac-session-card__cat">Group coaching</p>
                          <h3 class="ac-session-card__title">Performance Training</h3>
                          <p class="ac-session-card__desc">Improve speed, agility, shot accuracy, and court positioning.</p>
                          <div class="ac-session-card__meta">
                            <span class="ac-session-card__duration"><i class="ac-icon ac-i-ph-timer-bold" role="img" aria-hidden="true"/> 75 min</span>
                            <span class="ac-session-card__coach"><i class="ac-icon ac-i-ph-user-circle-bold" role="img" aria-hidden="true"/> Arjun K.</span>
                            <span class="ac-session-card__price"><strong>$35</strong></span>
                          </div>
                          <fieldset>
                            <legend class="ac-session-card__times-label">Available times</legend>
                            <div class="ac-session-card__times">
                        <label class="ac-time-chip"><input type="radio" name="time-performance" value="Tue 18:30"/><span>Tue 18:30</span></label>
                        <label class="ac-time-chip"><input type="radio" name="time-performance" value="Thu 18:30"/><span>Thu 18:30</span></label>
                        <label class="ac-time-chip"><input type="radio" name="time-performance" value="Sun 10:00"/><span>Sun 10:00</span></label>
                            </div>
                          </fieldset>
                          <button type="button" class="ac-btn ac-btn--ghost ac-btn--block ac-session-book">Book session</button>
                        </div>
                      </article>
                      <article class="ac-session-card">
                        <div class="ac-session-card__media">
                          <img src="/theme_aerocourt/static/src/img/photos/1722087642932-9b070e9a066e.jpg" alt="Player leaping for a smash in an indoor hall" loading="lazy"/>
                          <span class="ac-session-card__level">Advanced</span>
                          <span class="ac-session-card__spots is-low">2 spots left</span>
                        </div>
                        <div class="ac-session-card__body">
                          <p class="ac-session-card__cat">Group coaching</p>
                          <h3 class="ac-session-card__title">Elite Coaching</h3>
                          <p class="ac-session-card__desc">Advanced drills, match strategy, and competitive preparation.</p>
                          <div class="ac-session-card__meta">
                            <span class="ac-session-card__duration"><i class="ac-icon ac-i-ph-timer-bold" role="img" aria-hidden="true"/> 90 min</span>
                            <span class="ac-session-card__coach"><i class="ac-icon ac-i-ph-user-circle-bold" role="img" aria-hidden="true"/> Lena V.</span>
                            <span class="ac-session-card__price"><strong>$55</strong></span>
                          </div>
                          <fieldset>
                            <legend class="ac-session-card__times-label">Available times</legend>
                            <div class="ac-session-card__times">
                        <label class="ac-time-chip"><input type="radio" name="time-elite" value="Mon 19:30"/><span>Mon 19:30</span></label>
                        <label class="ac-time-chip"><input type="radio" name="time-elite" value="Fri 06:30"/><span>Fri 06:30</span></label>
                        <label class="ac-time-chip"><input type="radio" name="time-elite" value="Sat 16:00"/><span>Sat 16:00</span></label>
                            </div>
                          </fieldset>
                          <button type="button" class="ac-btn ac-btn--ghost ac-btn--block ac-session-book">Book session</button>
                        </div>
                      </article>
                      <article class="ac-session-card">
                        <div class="ac-session-card__media">
                          <img src="/theme_aerocourt/static/src/img/photos/1617696618050-b0fef0c666af.jpg" alt="Shuttlecock on a green court" loading="lazy"/>
                          <span class="ac-session-card__level">Juniors</span>
                          <span class="ac-session-card__spots">6 spots left</span>
                        </div>
                        <div class="ac-session-card__body">
                          <p class="ac-session-card__cat">Junior academy</p>
                          <h3 class="ac-session-card__title">Junior Academy</h3>
                          <p class="ac-session-card__desc">Structured badminton coaching for young players.</p>
                          <div class="ac-session-card__meta">
                            <span class="ac-session-card__duration"><i class="ac-icon ac-i-ph-timer-bold" role="img" aria-hidden="true"/> 60 min</span>
                            <span class="ac-session-card__coach"><i class="ac-icon ac-i-ph-user-circle-bold" role="img" aria-hidden="true"/> Tom B.</span>
                            <span class="ac-session-card__price"><strong>$20</strong></span>
                          </div>
                          <fieldset>
                            <legend class="ac-session-card__times-label">Available times</legend>
                            <div class="ac-session-card__times">
                        <label class="ac-time-chip"><input type="radio" name="time-junior" value="Wed 16:30"/><span>Wed 16:30</span></label>
                        <label class="ac-time-chip"><input type="radio" name="time-junior" value="Fri 16:30"/><span>Fri 16:30</span></label>
                        <label class="ac-time-chip"><input type="radio" name="time-junior" value="Sat 11:00"/><span>Sat 11:00</span></label>
                            </div>
                          </fieldset>
                          <button type="button" class="ac-btn ac-btn--ghost ac-btn--block ac-session-book">Book session</button>
                        </div>
                      </article>
                        </div>
                      </div>
                    </section>

    
                
    </template>
</odoo>
