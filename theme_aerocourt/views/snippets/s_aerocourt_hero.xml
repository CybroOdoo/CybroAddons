<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Hero: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_hero" name="AeroCourt Hero">
<section class="ac-hero s_aerocourt_hero" aria-labelledby="heroTitle" data-name="Hero" data-snippet="s_aerocourt_hero">
                      <div class="ac-hero__media" data-parallax-hero="" aria-hidden="true">
                        <img class="ac-hero__img" src="/theme_aerocourt/static/src/img/photos/1626224583764-f87db24ac4ea.jpg" alt="" fetchpriority="high"/>
                      </div>
                      <div class="ac-hero__overlay" aria-hidden="true"/>

     

                      <div class="ac-container ac-hero__inner">
        
                        <p class="ac-eyebrow ac-hero__eyebrow" data-hero-step="1"><span class="ac-eyebrow__index"><i class="ac-icon ac-i-boxicons-shuttlecock-filled" role="img" aria-hidden="true"/></span>Your game. Your arena.</p>
                        <h1 class="ac-hero__title" id="heroTitle">
                          <span class="ac-hero__line"><span>Elevate</span></span>
                          <span class="ac-hero__line"><span>Your <em class="ac-accent">Game.</em></span></span>
                        </h1>
                        <p class="ac-hero__text" data-hero-step="3">Where passion meets precision. Experience premium indoor badminton courts, expert coaching, and a community built around the game.</p>
                        <div class="ac-hero__actions" data-hero-step="4">
                          <a href="/booking" class="ac-btn ac-btn--primary ac-btn--lg">Book your court <i class="ac-icon ac-i-ph-arrow-right-bold" role="img" aria-hidden="true"/></a>
                          <a href="#why" class="ac-btn ac-btn--ghost ac-btn--lg">Explore the club</a>
                        </div>
                      </div>

                      <div class="ac-hero__stats" data-hero-step="5">
                        <div class="ac-container ac-hero__stats-inner">
                          <div class="ac-stat">
                            <span class="ac-stat__value"><span data-count="4" data-pad="2">04</span></span>
                            <span class="ac-stat__label">Pro-spec courts</span>
                          </div>
                          <div class="ac-stat">
                            <span class="ac-stat__value"><span data-count="17">17</span><small>hrs</small></span>
                            <span class="ac-stat__label">Open every day</span>
                          </div>
                          <div class="ac-stat">
                            <span class="ac-stat__value"><span data-count="7">7</span><small>/7</small></span>
                            <span class="ac-stat__label">Days of coaching</span>
                          </div>
                          <div class="ac-stat">
                            <span class="ac-stat__value"><span data-count="40">40</span><small>+</small></span>
                            <span class="ac-stat__label">Weekly sessions</span>
                          </div>
                        </div>
                      </div>

                      <a href="#why" class="ac-scroll-indicator" aria-label="Scroll to the next section">
                        <span class="ac-scroll-indicator__track"><span class="ac-scroll-indicator__thumb"/></span>
                        <span class="ac-scroll-indicator__label">Scroll</span>
                      </a>
                    </section>

 

    
                
    </template>
</odoo>
