<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Numbers Strip: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_numbers" name="AeroCourt Numbers Strip">
<section class="ac-numbers s_aerocourt_numbers" aria-label="AeroCourt in numbers" data-name="Numbers Strip" data-snippet="s_aerocourt_numbers">
                      <div class="ac-numbers__marquee" aria-hidden="true">
                        <span>Play well</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/><span>Keep improving</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/><span>One more rally</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/>
                        <span>Play well</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/><span>Keep improving</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/><span>One more rally</span><i class="ac-icon ac-i-ph-star-four-fill ac-numbers__star" role="img" aria-hidden="true"/>
                      </div>
                      <div class="ac-container ac-numbers__grid" data-reveal-stagger="">
                        <div class="ac-numbers__item"><span class="ac-numbers__value"><span data-count="4" data-ac="courts" data-pad="2">04</span></span><span class="ac-numbers__label">Pro-spec courts</span></div>
                        <div class="ac-numbers__item"><span class="ac-numbers__value"><span data-count="1200">1200</span><small>+</small></span><span class="ac-numbers__label">Active members</span></div>
                        <div class="ac-numbers__item"><span class="ac-numbers__value"><span data-count="30">30</span><small>k</small></span><span class="ac-numbers__label">Hours played each year</span></div>
                        <div class="ac-numbers__item"><span class="ac-numbers__value"><span data-count="150">150</span><small>+</small></span><span class="ac-numbers__label">Juniors in the academy</span></div>
                      </div>
                    </section>

    
                
    </template>
</odoo>
