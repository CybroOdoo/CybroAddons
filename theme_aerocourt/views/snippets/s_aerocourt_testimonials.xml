<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Testimonials Carousel: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_testimonials" name="AeroCourt Testimonials Carousel">
<section class="ac-section ac-testimonials s_aerocourt_testimonials" aria-labelledby="testimonialsTitle" data-name="Testimonials Carousel" data-snippet="s_aerocourt_testimonials">
                      <div class="ac-container ac-testimonials__layout">
                        <header class="ac-testimonials__head">
                          <p class="ac-eyebrow" data-reveal=""><span class="ac-eyebrow__index">05</span> Members</p>
                          <h2 class="ac-section-title ac-section-title--md" id="testimonialsTitle" data-reveal="">Good games.<br/><span class="ac-accent">Great people.</span></h2>
                          <div class="ac-carousel__controls" data-reveal="">
                            <button type="button" class="ac-icon-btn" id="testiPrev" aria-label="Previous testimonial" aria-controls="testiTrack"><i class="ac-icon ac-i-ph-caret-left-bold" role="img" aria-hidden="true"/></button>
                            <span class="ac-carousel__count" id="testiCount" aria-hidden="true">01 / 03</span>
                            <button type="button" class="ac-icon-btn" id="testiNext" aria-label="Next testimonial" aria-controls="testiTrack"><i class="ac-icon ac-i-ph-caret-right-bold" role="img" aria-hidden="true"/></button>
                          </div>
                        </header>

                        <div class="ac-carousel" id="testimonialCarousel" role="region" aria-roledescription="carousel" aria-label="Member testimonials" tabindex="0" data-reveal="">
                          <div class="ac-carousel__viewport">
                            <ul class="ac-carousel__track" id="testiTrack" aria-live="polite">
                              <li class="ac-testimonial" role="group" aria-roledescription="slide" aria-label="1 of 3">
                                <i class="ac-icon ac-i-ph-quotes-fill ac-testimonial__icon" role="img" aria-hidden="true"/>
                                <blockquote class="ac-testimonial__quote">“The courts are immaculate and the lighting is the best I've played under. Booking a Tuesday night slot takes thirty seconds, then it's just me, my partner and a lot of long rallies.”</blockquote>
                                <footer class="ac-testimonial__author">
                                  <span class="ac-avatar" aria-hidden="true">P</span>
                                  <span><strong>Priya</strong><small>Club Member</small></span>
                                </footer>
                              </li>
                              <li class="ac-testimonial" role="group" aria-roledescription="slide" aria-label="2 of 3">
                                <i class="ac-icon ac-i-ph-quotes-fill ac-testimonial__icon" role="img" aria-hidden="true"/>
                                <blockquote class="ac-testimonial__quote">“Elite Coaching completely changed how I read the game. My footwork is sharper, my smash is heavier and I finally made a regional quarter-final.”</blockquote>
                                <footer class="ac-testimonial__author">
                                  <span class="ac-avatar" aria-hidden="true">D</span>
                                  <span><strong>Daniel</strong><small>Competitive Player</small></span>
                                </footer>
                              </li>
                              <li class="ac-testimonial" role="group" aria-roledescription="slide" aria-label="3 of 3">
                                <i class="ac-icon ac-i-ph-quotes-fill ac-testimonial__icon" role="img" aria-hidden="true"/>
                                <blockquote class="ac-testimonial__quote">“My daughter started in the Junior Academy barely able to serve. A year later she's playing in the Junior Smash Cup and can't wait for Saturday mornings.”</blockquote>
                                <footer class="ac-testimonial__author">
                                  <span class="ac-avatar" aria-hidden="true">S</span>
                                  <span><strong>Sara</strong><small>Junior Parent</small></span>
                                </footer>
                              </li>
                            </ul>
                          </div>
                          <div class="ac-carousel__dots" id="testiDots" role="group" aria-label="Choose testimonial">
                            <!-- Rendered by the AeroCourt interactions (static/src/interactions) -->
                          </div>
                        </div>
                      </div>
                      <p class="ac-container ac-muted-note ac-testimonials__note">Testimonials are fictional samples for this demo.</p>
                    </section>

   

   
  
            
    </template>
</odoo>
