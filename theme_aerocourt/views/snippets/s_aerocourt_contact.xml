<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Contact Form: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_contact" name="AeroCourt Contact Form">
<section class="ac-section ac-contact s_aerocourt_contact" aria-labelledby="contactFormTitle" data-name="Contact Form" data-snippet="s_aerocourt_contact">
                      <div class="ac-container ac-contact__layout">

                        <!-- Form -->
                        <div class="ac-contact-card ac-contact-form-card">
                          <div id="contactFormWrap">
                            <header class="ac-contact-card__head">
                              <p class="ac-eyebrow"><span class="ac-eyebrow__index">01</span> Send a message</p>
                              <h2 class="ac-contact-card__title" id="contactFormTitle">How can we help?</h2>
                            </header>

                            <form class="ac-contact-form" id="contactForm" novalidate="">
                              <fieldset class="ac-contact-topics">
                                <legend class="ac-field__label">What’s it about?</legend>
                                <div class="ac-contact-topics__list">
                                  <label class="ac-topic-chip"><input type="radio" name="topic" value="Court booking" required="" checked="checked"/><span><i class="ac-icon ac-i-ph-calendar-check-bold" role="img" aria-hidden="true"/> Court booking</span></label>
                                  <label class="ac-topic-chip"><input type="radio" name="topic" value="Coaching &amp; sessions"/><span><i class="ac-icon ac-i-ph-chalkboard-teacher-bold" role="img" aria-hidden="true"/> Coaching</span></label>
                                  <label class="ac-topic-chip"><input type="radio" name="topic" value="Group &amp; corporate"/><span><i class="ac-icon ac-i-ph-users-three-bold" role="img" aria-hidden="true"/> Groups</span></label>
                                  <label class="ac-topic-chip"><input type="radio" name="topic" value="Something else"/><span><i class="ac-icon ac-i-ph-dots-three-circle-bold" role="img" aria-hidden="true"/> Other</span></label>
                                </div>
                                <p class="ac-field__error" data-error-for="topic"/>
                              </fieldset>

                              <div class="ac-modal-form__grid">
                                <div class="ac-field">
                                  <label class="ac-field__label" for="c-name">Full name</label>
                                  <input class="ac-input" id="c-name" name="name" type="text" autocomplete="name" required="" aria-describedby="c-name-error"/>
                                  <p class="ac-field__error" id="c-name-error" data-error-for="name"/>
                                </div>
                                <div class="ac-field">
                                  <label class="ac-field__label" for="c-email">Email</label>
                                  <input class="ac-input" id="c-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required="" aria-describedby="c-email-error"/>
                                  <p class="ac-field__error" id="c-email-error" data-error-for="email"/>
                                </div>
                                <div class="ac-field ac-modal-form__full">
                                  <label class="ac-field__label" for="c-phone">Phone <small>(optional)</small></label>
                                  <input class="ac-input" id="c-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel"/>
                                </div>
                                <div class="ac-field ac-modal-form__full">
                                  <label class="ac-field__label" for="c-message">Message</label>
                                  <textarea class="ac-input ac-contact-form__message" id="c-message" name="message" rows="5" maxlength="600" required="" placeholder="Tell us a little about what you need…" aria-describedby="c-message-error c-message-count"/>
                                  <div class="ac-contact-form__meta">
                                    <p class="ac-field__error" id="c-message-error" data-error-for="message"/>
                                    <span class="ac-contact-form__count" id="c-message-count">0 / 600</span>
                                  </div>
                                </div>
                              </div>

                              <label class="ac-check">
                                <input type="checkbox" name="consent" required="" aria-describedby="c-consent-error"/>
                                <span>I’m happy for AeroCourt to contact me about this enquiry.</span>
                              </label>
                              <p class="ac-field__error" id="c-consent-error" data-error-for="consent"/>

                              <div class="ac-contact-form__actions">
                                <button type="submit" class="ac-btn ac-btn--primary ac-btn--lg"><span class="ac-btn__label">Send message</span> <i class="ac-icon ac-i-ph-paper-plane-tilt-bold" role="img" aria-hidden="true"/></button>
                                <p class="ac-contact-form__note"><i class="ac-icon ac-i-ph-info-bold" role="img" aria-hidden="true"/> <span>Your message goes straight to our team.</span></p>
                              </div>
                            </form>
                          </div>

                          <!-- Shown after a successful submit -->
                          <div class="ac-contact-success" id="contactSuccess" hidden="" tabindex="-1">
                            <span class="ac-success__icon"><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/></span>
                            <h2 class="ac-contact-card__title">Message sent.</h2>
                            <p id="contactSuccessText">Thanks for getting in touch. We’ll reply within one working day.</p>
                            <p class="ac-success__ref" id="contactRef"/>
                            <button type="button" class="ac-btn ac-btn--ghost" id="contactAgain">Send another message</button>
                          </div>
                        </div>

                        <!-- Details -->
                        <aside class="ac-contact-side" aria-label="Contact details">
                          <div class="ac-contact-card ac-contact-status">
                            <span class="ac-status-pill" data-open-status=""><span class="ac-status-pill__dot"/><span class="ac-status-pill__text">Open daily · <span data-ac="hours">06:00 – 23:00</span></span></span>
                            <dl class="ac-contact-hours">
                              <div><dt>Monday – Friday</dt><dd><span data-ac="hours">06:00 – 23:00</span></dd></div>
                              <div><dt>Saturday – Sunday</dt><dd><span data-ac="hours">06:00 – 23:00</span></dd></div>
                              <div><dt>Front desk</dt><dd>08:00 – 21:00</dd></div>
                            </dl>
                          </div>

                          <a class="ac-contact-method" href="tel:+10000000000">
                            <span class="ac-contact-method__icon"><i class="ac-icon ac-i-ph-phone-call-bold" role="img" aria-hidden="true"/></span>
                            <span class="ac-contact-method__text"><small>Call the front desk</small><strong>+1 (000) 000-0000</strong></span>
                            <i class="ac-icon ac-i-ph-arrow-up-right-bold ac-contact-method__arrow" role="img" aria-hidden="true"/>
                          </a>
                          <a class="ac-contact-method" href="mailto:hello@aerocourt.example">
                            <span class="ac-contact-method__icon"><i class="ac-icon ac-i-ph-envelope-simple-bold" role="img" aria-hidden="true"/></span>
                            <span class="ac-contact-method__text"><small>Email us</small><strong>hello@aerocourt.example</strong></span>
                            <i class="ac-icon ac-i-ph-arrow-up-right-bold ac-contact-method__arrow" role="img" aria-hidden="true"/>
                          </a>
                          <a class="ac-contact-method" href="https://www.google.com/maps/search/?api=1&amp;query=14+Rally+Lane" target="_blank" rel="noopener">
                            <span class="ac-contact-method__icon"><i class="ac-icon ac-i-ph-map-pin-bold" role="img" aria-hidden="true"/></span>
                            <span class="ac-contact-method__text"><small>Visit us</small><strong>14 Rally Lane, Your City</strong></span>
                            <i class="ac-icon ac-i-ph-arrow-up-right-bold ac-contact-method__arrow" role="img" aria-hidden="true"/>
                          </a>

                          <div class="ac-contact-card ac-contact-social">
                            <p class="ac-field__label">Follow the club</p>
                            <ul class="ac-socials">
                              <li><a href="#" aria-label="AeroCourt on Instagram (placeholder link)"><i class="ac-icon ac-i-ph-instagram-logo-bold" role="img" aria-hidden="true"/></a></li>
                              <li><a href="#" aria-label="AeroCourt on Facebook (placeholder link)"><i class="ac-icon ac-i-ph-facebook-logo-bold" role="img" aria-hidden="true"/></a></li>
                              <li><a href="#" aria-label="AeroCourt on YouTube (placeholder link)"><i class="ac-icon ac-i-ph-youtube-logo-bold" role="img" aria-hidden="true"/></a></li>
                              <li><a href="#" aria-label="AeroCourt on X (placeholder link)"><i class="ac-icon ac-i-ph-x-logo-bold" role="img" aria-hidden="true"/></a></li>
                            </ul>
                          </div>
                        </aside>
                      </div>
                      <p class="ac-container ac-muted-note ac-contact__note">Phone, email and address are placeholders.</p>
                    </section>

   

    
                
    </template>
</odoo>
