<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Membership Plans: building block of the AeroCourt theme.
-->
<odoo>
    <template id="s_aerocourt_membership" name="AeroCourt Membership Plans">
<section class="ac-section ac-membership s_aerocourt_membership" aria-labelledby="membershipTitle" data-name="Membership Plans" data-snippet="s_aerocourt_membership">
                      <div class="ac-container">
                        <header class="ac-section-head">
                          <div class="ac-section-head__main" data-reveal="">
                            <p class="ac-eyebrow"><span class="ac-eyebrow__index">04</span> Membership</p>
                            <h2 class="ac-section-title" id="membershipTitle">Play your<br/><span class="ac-accent">way.</span></h2>
                          </div>
                          <p class="ac-section-head__text" data-reveal="">Flexible plans for casual players, regulars and competitors. <span class="ac-muted-note">All prices are illustrative.</span></p>
                        </header>

                        <div class="ac-plans" data-reveal-stagger="">
                          <article class="ac-plan">
                            <header class="ac-plan__head">
                              <h3 class="ac-plan__name">Pay &amp; Play</h3>
                              <p class="ac-plan__desc">Turn up, book and play. No strings attached.</p>
                            </header>
                            <p class="ac-plan__price"><span class="ac-plan__currency">$</span><span class="ac-plan__amount">0</span><span class="ac-plan__period">/ month</span></p>
                            <p class="ac-plan__sub">Courts <span data-ac="currency">$</span><span data-ac="rate">18</span> per hour</p>
                            <ul class="ac-plan__list">
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> Flexible hourly court bookings</li>
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> Equipment rental options</li>
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> No long-term commitment</li>
                            </ul>
                            <button type="button" class="ac-btn ac-btn--ghost ac-btn--block" data-join="Pay &amp; Play" data-price="0">Join now</button>
                          </article>

                          <article class="ac-plan ac-plan--featured">
                            <span class="ac-plan__tag">Most popular</span>
                            <header class="ac-plan__head">
                              <h3 class="ac-plan__name">Club Member</h3>
                              <p class="ac-plan__desc">For regulars who want the best slots at the best rates.</p>
                            </header>
                            <p class="ac-plan__price"><span class="ac-plan__currency">$</span><span class="ac-plan__amount">39</span><span class="ac-plan__period">/ month</span></p>
                            <p class="ac-plan__sub">Courts $14 per hour</p>
                            <ul class="ac-plan__list">
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> Member booking rates</li>
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> Priority booking access</li>
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> Member-only events</li>
                            </ul>
                            <button type="button" class="ac-btn ac-btn--primary ac-btn--block" data-join="Club Member" data-price="39">Join now</button>
                          </article>

                          <article class="ac-plan">
                            <header class="ac-plan__head">
                              <h3 class="ac-plan__name">Performance Member</h3>
                              <p class="ac-plan__desc">For competitors training with intent.</p>
                            </header>
                            <p class="ac-plan__price"><span class="ac-plan__currency">$</span><span class="ac-plan__amount">89</span><span class="ac-plan__period">/ month</span></p>
                            <p class="ac-plan__sub">Includes all Club Member benefits</p>
                            <ul class="ac-plan__list">
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> Coaching benefits</li>
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> Training-session discounts</li>
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> Priority access to selected tournaments</li>
                            </ul>
                            <button type="button" class="ac-btn ac-btn--ghost ac-btn--block" data-join="Performance Member" data-price="89">Join now</button>
                          </article>
                        </div>
                      </div>
                    </section>

    
                
    </template>
</odoo>
