<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Settings of the AeroCourt booking pages, in the Website settings.
-->
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.theme.aerocourt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="AeroCourt Club" id="aerocourt_settings" invisible="not website_id">
                    <setting string="Opening Hours" help="Hours of the day that can be booked on the court calendar.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label class="col-lg-4" for="aerocourt_open_hour"/>
                                <field name="aerocourt_open_hour"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4" for="aerocourt_close_hour"/>
                                <field name="aerocourt_close_hour"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Courts" help="Number of identical courts, and how far ahead visitors can book.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label class="col-lg-4" for="aerocourt_court_count"/>
                                <field name="aerocourt_court_count"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4" for="aerocourt_booking_days"/>
                                <field name="aerocourt_booking_days"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Prices" help="Prices shown on the booking pages.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label class="col-lg-4" for="aerocourt_court_rate"/>
                                <field name="aerocourt_court_rate"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4" for="aerocourt_rental_fee"/>
                                <field name="aerocourt_rental_fee"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
