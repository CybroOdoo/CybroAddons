<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Book a Court page of the AeroCourt theme, built from editable sections.
-->
<odoo>
    <template id="booking_page" name="AeroCourt Book a Court">
        <t t-call="website.layout">
            <t t-set="additional_title">Book a Court</t>
            <t t-set="pageName" t-valuef="aerocourt_booking"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="ac-page-hero" id="page-top" aria-labelledby="bookingTitle">
                      <div class="ac-page-hero__media" aria-hidden="true">
                        <img data-parallax="" src="/theme_aerocourt/static/src/img/photos/1559369064-c4d65141e408.jpg" alt=""/>
                      </div>
                      <div class="ac-page-hero__overlay" aria-hidden="true"/>
                      <div class="ac-container ac-page-hero__inner">
                        <p class="ac-eyebrow ac-hero__eyebrow" data-hero-step="1"><span class="ac-eyebrow__index"><i class="ac-icon ac-i-boxicons-shuttlecock-filled" role="img" aria-hidden="true"/></span>Court booking</p>
                        <h1 class="ac-page-hero__title" id="bookingTitle">
                          <span class="ac-hero__line"><span>Your court.</span></span>
                          <span class="ac-hero__line"><span class="ac-accent">Your time.</span></span>
                        </h1>
                        <p class="ac-page-hero__text" data-hero-step="3">Choose your court, pick your slot, and get ready to play.</p>
                        <ul class="ac-page-hero__facts" data-hero-step="4">
                          <li><i class="ac-icon ac-i-ph-clock-bold" role="img" aria-hidden="true"/> Open daily <span data-ac="hours">06:00 – 23:00</span></li>
                          <li><i class="ac-icon ac-i-ph-tag-bold" role="img" aria-hidden="true"/> All courts <span data-ac="currency">$</span><span data-ac="rate">18</span> / hour</li>
                          <li><i class="ac-icon ac-i-ph-calendar-dots-bold" role="img" aria-hidden="true"/> Book up to <span data-ac="booking-days">30</span> days ahead</li>
                        </ul>
                      </div>
                    </section>

    
                <section class="ac-section ac-booking ac-booking--page" id="booking" aria-labelledby="calTitle">
                      <div class="ac-container ac-booking-cal">

                        <!-- Month calendar: availability is filled in by the AeroCourt interactions -->
                        <div class="ac-cal-card" id="bookingCalendar">
                          <header class="ac-cal-card__head">
                            <div>
                              <p class="ac-cal-card__kicker">Step 1 · Pick a date</p>
                              <h2 class="ac-cal-card__title" id="calTitle"><span id="calMonth">Month</span></h2>
                            </div>
                            <div class="ac-cal-card__nav">
                              <button type="button" class="ac-icon-btn ac-icon-btn--sm" id="calPrev" aria-label="Previous month"><i class="ac-icon ac-i-ph-caret-left-bold" role="img" aria-hidden="true"/></button>
                              <button type="button" class="ac-icon-btn ac-icon-btn--sm" id="calNext" aria-label="Next month"><i class="ac-icon ac-i-ph-caret-right-bold" role="img" aria-hidden="true"/></button>
                            </div>
                          </header>

                          <ul class="ac-cal-legend" aria-label="Legend">
                            <li><span class="ac-cal-legend__dot ac-cal-legend__dot--plenty"/>Plenty free</li>
                            <li><span class="ac-cal-legend__dot ac-cal-legend__dot--limited"/>Filling up</li>
                            <li><span class="ac-cal-legend__dot ac-cal-legend__dot--full"/>Fully booked</li>
                            <li class="ac-cal-legend__hint ac-cal-legend__hint--hover"><i class="ac-icon ac-i-ph-cursor-bold" role="img" aria-hidden="true"/> Hover a day for details</li>
                            <li class="ac-cal-legend__hint ac-cal-legend__hint--touch"><i class="ac-icon ac-i-ph-hand-tap-bold" role="img" aria-hidden="true"/> Tap a day to see times</li>
                          </ul>

                          <div class="ac-cal-weekdays" aria-hidden="true">
                            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                          </div>
                          <div class="ac-cal-grid" id="calGrid" role="grid" aria-labelledby="calTitle">
                            <!-- Rendered by the AeroCourt interactions (static/src/interactions) -->
                          </div>

                          <!-- Availability preview shown on hover / keyboard focus -->
                          <div class="ac-cal-tip" id="calTip" role="tooltip" hidden=""/>
                        </div>

                        <!-- Side panel -->
                        <aside class="ac-bk-aside" aria-label="How booking works">
                          <div class="ac-bk-aside__card">
                            <h2 class="ac-bk-aside__title">How it works</h2>
                            <ol class="ac-bk-how">
                              <li><span class="ac-bk-how__num">1</span><div><strong>Pick a date</strong><span>Hover or tap the calendar to see free slots.</span></div></li>
                              <li><span class="ac-bk-how__num">2</span><div><strong>Choose a time</strong><span>See how many courts are free. We assign one for you.</span></div></li>
                              <li><span class="ac-bk-how__num">3</span><div><strong>Confirm &amp; play</strong><span>Leave your name and number. We confirm by phone.</span></div></li>
                            </ol>
                          </div>

                          <div class="ac-bk-aside__card">
                            <h2 class="ac-bk-aside__title">Court rate</h2>
                            <p class="ac-bk-rate"><strong id="bkRate"><span data-ac="currency">$</span><span data-ac="rate">18</span></strong><span>per hour · any court</span></p>
                            <ul class="ac-bk-rate__list">
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> 4 identical pro-spec courts</li>
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> Cushioned mats &amp; LED lighting</li>
                              <li><i class="ac-icon ac-i-ph-check-bold" role="img" aria-hidden="true"/> A free court is assigned for you</li>
                            </ul>
                            <p class="ac-bk-aside__note"><i class="ac-icon ac-i-ph-info-bold" role="img" aria-hidden="true"/> <span>Bookings are 60 minutes, up to 4 players.</span></p>
                          </div>

                          <p class="ac-bk-aside__demo"><i class="ac-icon ac-i-ph-shield-check-bold" role="img" aria-hidden="true"/> <span>Our team confirms every booking by phone. Payment is taken at the club.</span></p>
                        </aside>
                      </div>
                    </section>
  
            </div>
        </t>
    </template>

    <record id="booking_page_page" model="theme.website.page">
        <field name="url">/booking</field>
        <field name="view_id" ref="booking_page"/>
        <field name="is_published" eval="True"/>
        <field name="header_overlay" eval="True"/>
    </record>
</odoo>
