<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the daily expense wizard view. -->
    <record id="daily_expense_wizard_view_form" model="ir.ui.view">
        <field name="name">daily.expense.wizard.view.form</field>
        <field name="model">daily.expense.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Expense">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="date"/>
                    <field name="task_employee_ids" invisible="1"/>
                    <field name="excluded_employee_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_create_expense" string="Create Expense"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
