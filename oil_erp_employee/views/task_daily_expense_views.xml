<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the task daily expense views. -->
    <record id="task_daily_expense_view_list" model="ir.ui.view">
        <field name="name">task.daily.expense.view.list</field>
        <field name="model">task.daily.expense</field>
        <field name="arch" type="xml">
            <list editable="top" string="Daily Expenses">
                <field name="employee_id"/>
                <field name="task_id"/>
                <field name="date"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="action_task_daily_expense" model="ir.actions.act_window">
        <field name="name">Daily Expenses</field>
        <field name="res_model">task.daily.expense</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
