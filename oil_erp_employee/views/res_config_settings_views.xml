<odoo>
    <record id="res_config_settings_view_form_inherit_oil_erp_employee" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.oil.erp.employee</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="oil_erp_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='module_oil_erp_employee']/ancestor::setting" position="inside">
                <div class="content-group" invisible="not module_oil_erp_employee">
                    <div class="mt8">
                        <label for="expense_journal_id" string="Employee Expense Journal" class="o_light_label"/>
                        <field name="expense_journal_id"/>
                    </div>
                </div>
            </xpath>

        </field>
    </record>

    <!-- Expense Categories Menu inside E&P Operations Configuration -->
    <menuitem id="menu_oil_expense_categories"
              name="Expense Categories"
              parent="oil_erp_base.menu_oil_config_upstream"
              action="hr_expense.hr_expense_product"
              sequence="45"/>
</odoo>