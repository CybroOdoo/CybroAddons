<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the employee task views. -->
    <record id="view_task_form_inherit_oil" model="ir.ui.view">
        <field name="name">project.task.form.inherit.oil</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_calculate_daily_expense"
                        string="Daily Expense"
                        type="object"
                        class="btn-secondary "/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_expenses"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money">
                    <field name="expense_count" widget="statinfo"
                           string="Daily Expenses"/>
                </button>
            </xpath>
            <xpath expr="//notebook/page[@name='well_drilling']"
                   position="after">
                <page name="employees" string="Employees" invisible="not is_oil_gas_well">
                    <field name="is_oil_gas_well" invisible="1"/>
                    <field name="employee_ids">
                        <list>
                            <field name="name"/>
                            <field name="department_id"/>
                            <field name="job_title"/>
                            <field name="parent_id"/>
                        </list>
                    </field>
                    <field name="expense_count" invisible="1"/>
                </page>
            </xpath>
            <!-- Target the timesheet one2many field -->
            <xpath expr="//field[@name='timesheet_ids']//field[@name='employee_id']"
                   position="attributes">
                <attribute name="domain">['|', ('id', 'in', parent.employee_ids), ('user_id', 'in', parent.user_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
