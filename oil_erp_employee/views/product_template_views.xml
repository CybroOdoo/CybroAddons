<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_expense_form_inherit_oil" model="ir.ui.view">
        <field name="name">product.template.expense.form.inherit.oil</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="hr_expense.view_product_hr_expense_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='can_be_expensed']" position="after">
                <field name="is_oil_gas_expense_category" invisible="not can_be_expensed"/>
                <label for="is_oil_gas_expense_category" invisible="not can_be_expensed"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_expense_form_view_inherit_oil" model="ir.ui.view">
        <field name="name">product.product.expense.form.inherit.oil</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="hr_expense.product_product_expense_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='standard_price']" position="before">
                <field name="is_oil_gas_expense_category"/>
            </xpath>
        </field>
    </record>
</odoo>
