<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Menus of the Propelle navigation: About Us, Buy, Rent, Sell and Projects,
    after the Home entry of the website.
-->
<odoo>
    <record id="menu_about" model="theme.website.menu">
        <field name="name">About Us</field>
        <field name="url">/about</field>
        <field name="page_id" ref="about_page_page"/>
        <field name="sequence" type="int">15</field>
    </record>
    <record id="menu_buy" model="theme.website.menu">
        <field name="name">Buy</field>
        <field name="url">/buy</field>
        <field name="sequence" type="int">20</field>
    </record>
    <record id="menu_rent" model="theme.website.menu">
        <field name="name">Rent</field>
        <field name="url">/rent</field>
        <field name="sequence" type="int">25</field>
    </record>
    <record id="menu_sell" model="theme.website.menu">
        <field name="name">Sell</field>
        <field name="url">/sell</field>
        <field name="page_id" ref="sell_page_page"/>
        <field name="sequence" type="int">30</field>
    </record>
    <record id="menu_projects" model="theme.website.menu">
        <field name="name">Projects</field>
        <field name="url">/projects</field>
        <field name="sequence" type="int">35</field>
    </record>
</odoo>
