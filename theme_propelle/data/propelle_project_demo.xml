<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Development projects of the Propelle design.
-->
<odoo noupdate="1">
    <record id="propelle_project_the_serrano_estates" model="propelle.project">
        <field name="name">The Serrano Estates</field>
        <field name="location">Bel Air, Los Angeles</field>
        <field name="description">Twelve detached homes on a gated hillside, each with its own pool and canyon views.</field>
        <field name="state">selling</field>
        <field name="availability_style">open</field>
        <field name="price_from">4800000</field>
        <field name="units_label">12 homes</field>
        <field name="completion_label">Completion 2026</field>
        <field name="is_featured" eval="True"/>
        <field name="image_1920" type="bytes" file="theme_propelle/static/src/img/content/1512917774080-9991f1c4c750.jpg"/>
        <field name="image_alt">Hillside house with terraces and a pool</field>
        <field name="sequence">10</field>
    </record>
