<?xml version="1.0" encoding="UTF-8" ?>
<!--
    About page of the Propelle theme, built from its editable building blocks.
-->
<odoo>
    <template id="about_page" name="Propelle About Us">
        <t t-call="website.layout">
            <t t-set="additional_title">About Us</t>
            <t t-set="pageName" t-valuef="propelle_about"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="pp-s s_propelle_about_hero pp-ab-hero" aria-labelledby="page-title" data-name="About Hero" data-snippet="s_propelle_about_hero">
                  <div class="pp-container pp-ab-hero__grid">
                    <div class="pp-ab-hero__text">
                      <nav class="pp-breadcrumb pp-breadcrumb--dark" aria-label="Breadcrumb">
                        <ol>
                          <li><a href="/">Home</a></li>
                          <li aria-current="page">About us</li>
                        </ol>
                      </nav>
                      <h1 class="pp-ab-hero__title" id="page-title">More Than Properties. <span>A Better Way to Live.</span></h1>
                      <p class="pp-ab-hero__lead">Two founders, one office on Pacific Coast Highway and a simple rule: the agent who lists a home is the one who shows it. Sixteen years later, that hasn't changed.</p>
                      <dl class="pp-ab-hero__facts">
                        <div><dd>2009</dd><dt>Founded</dt></div>
                        <div><dd>120</dd><dt>Agents</dt></div>
                        <div><dd>6</dd><dt>Offices</dt></div>
                        <div><dd>2,800</dd><dt>Families helped</dt></div>
                      </dl>
                    </div>
                    <div class="pp-ab-collage" aria-hidden="true">
                      <img class="pp-ab-collage__a" src="/theme_propelle/static/src/img/content/1600563438938-a9a27216b4f5.jpg" alt=""/>
                      <img class="pp-ab-collage__b" src="/theme_propelle/static/src/img/content/1600210491892-03d54c0aaf87.jpg" alt=""/>
                      <img class="pp-ab-collage__c" src="/theme_propelle/static/src/img/content/1600585152220-90363fe7e115.jpg" alt=""/>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_quote pp-ab-quote" id="story" data-name="Founder Quote" data-snippet="s_propelle_quote">
                  <div class="pp-container pp-ab-quote__grid">
                    <p class="pp-eyebrow">Our story</p>
                    <blockquote class="pp-ab-quote__text pp-reveal">“We wanted a company where clients always know who to call. If that means staying smaller in some places, that's fine with us.”</blockquote>
                    <div class="pp-ab-quote__side pp-reveal">
                      <figure class="pp-ab-quote__author">
                        <img src="/theme_propelle/static/src/img/content/1573496359142-b8d87734a5a2.jpg" alt=""/>
                        <figcaption><strong>Laura Bennett</strong>Co-founder, Malibu</figcaption>
                      </figure>
                      <p>Laura and Mark Holloway had both spent years at large brokerages. In 2009 they opened something smaller, where each client keeps one agent from the first viewing to closing.</p>
                      <p>Miami came in 2014 because clients were buying second homes there and asked us to help. New York, Austin, Aspen and San Francisco followed the same way.</p>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_history pp-section" id="history" data-name="History Timeline" data-snippet="s_propelle_history">
                  <div class="pp-container pp-ab-history">
                    <div class="pp-ab-history__aside">
                      <h2 class="pp-title">How we got here</h2>
                      <p>We opened each new office after clients moved there and asked us to keep helping them.</p>
                      <img src="/theme_propelle/static/src/img/content/1600607688969-a5bfcd646154.jpg" alt="Timber and black-clad house with a lawn" loading="lazy"/>
                    </div>
                    <ol class="pp-ab-timeline">
                      <li class="pp-reveal">
                        <span class="pp-ab-timeline__year">2009</span>
                        <div><h3>First office in Malibu</h3><p>Laura and Mark open on Pacific Coast Highway with two desks and a shared assistant.</p></div>
                      </li>
                      <li class="pp-reveal">
                        <span class="pp-ab-timeline__year">2014</span>
                        <div><h3>Miami</h3><p>A Brickell office opens to help Malibu clients buying second homes in Florida.</p></div>
                      </li>
                      <li class="pp-reveal">
                        <span class="pp-ab-timeline__year">2016</span>
                        <div><h3>New York</h3><p>We open in Tribeca and start selling new-build apartments for developers.</p></div>
                      </li>
                      <li class="pp-reveal">
                        <span class="pp-ab-timeline__year">2019</span>
                        <div><h3>Austin and Aspen</h3><p>Two smaller offices, one for family homes and one for seasonal rentals.</p></div>
                      </li>
                      <li class="pp-reveal">
                        <span class="pp-ab-timeline__year">2022</span>
                        <div><h3>San Francisco</h3><p>Our sixth office, with a team focused on commercial and mixed-use property.</p></div>
                      </li>
                      <li class="pp-reveal">
                        <span class="pp-ab-timeline__year">2025</span>
                        <div><h3>1,400 transactions</h3><p>Our busiest year so far, across sales, rentals and new developments.</p></div>
                      </li>
                    </ol>
                  </div>
                </section>
                <section class="pp-s s_propelle_values pp-section pp-section--tint" id="values" data-name="Values" data-snippet="s_propelle_values">
                  <div class="pp-container">
                    <div class="pp-head pp-head--split">
                      <div>
                        <h2 class="pp-title">How we work</h2>
                      </div>
                    </div>
                    <ol class="pp-ab-values">
                      <li class="pp-reveal"><h3>One agent, start to finish</h3><p>The person you meet at the first viewing is the person who handles your closing.</p></li>
                      <li class="pp-reveal"><h3>Fees in writing</h3><p>We agree our commission before any work starts. There are no extra charges at closing.</p></li>
                      <li class="pp-reveal"><h3>Honest advice</h3><p>If a home is overpriced or has problems, we'll tell you, even if it means a slower sale.</p></li>
                      <li class="pp-reveal"><h3>Quick replies</h3><p>We answer messages within one working day, and usually much sooner.</p></li>
                    </ol>
                  </div>
                </section>
                <section class="pp-s s_propelle_team pp-section" id="team" data-name="Team" data-snippet="s_propelle_team">
                  <div class="pp-container">
                    <div class="pp-head pp-head--split">
                      <div>
                        <h2 class="pp-title">Our team</h2>
                      </div>
                      <a href="/contactus" class="pp-text-link">Contact an agent <i class="pp-icon pp-icon--sm pp-i-arrow" role="img" aria-hidden="true"/></a>
                    </div>
                    <div class="pp-ab-team">
                      <article class="pp-ab-member pp-reveal">
                        <img src="/theme_propelle/static/src/img/content/1573496359142-b8d87734a5a2.jpg" alt="Laura Bennett" loading="lazy"/>
                        <div class="pp-ab-member__info">
                          <h3>Laura Bennett</h3>
                          <p>Co-founder · Malibu</p>
                          <a href="mailto:laura@propelle.com"><i class="pp-icon pp-icon--sm pp-i-mail" role="img" aria-hidden="true"/> laura@propelle.com</a>
                        </div>
                      </article>
                      <article class="pp-ab-member pp-reveal">
                        <img src="/theme_propelle/static/src/img/content/1560250097-0b93528c311a.jpg" alt="Mark Holloway" loading="lazy"/>
                        <div class="pp-ab-member__info">
                          <h3>Mark Holloway</h3>
                          <p>Co-founder, managing broker · Malibu</p>
                          <a href="mailto:mark@propelle.com"><i class="pp-icon pp-icon--sm pp-i-mail" role="img" aria-hidden="true"/> mark@propelle.com</a>
                        </div>
                      </article>
                      <article class="pp-ab-member pp-reveal">
                        <img src="/theme_propelle/static/src/img/content/1580489944761-15a19d654956.jpg" alt="Elena Ruiz" loading="lazy"/>
                        <div class="pp-ab-member__info">
                          <h3>Elena Ruiz</h3>
                          <p>Head of rentals · Miami</p>
                          <a href="mailto:elena@propelle.com"><i class="pp-icon pp-icon--sm pp-i-mail" role="img" aria-hidden="true"/> elena@propelle.com</a>
                        </div>
                      </article>
                      <article class="pp-ab-member pp-reveal">
                        <img src="/theme_propelle/static/src/img/content/1519085360753-af0119f7cbe7.jpg" alt="Daniel Price" loading="lazy"/>
                        <div class="pp-ab-member__info">
                          <h3>Daniel Price</h3>
                          <p>New developments · New York</p>
                          <a href="mailto:daniel@propelle.com"><i class="pp-icon pp-icon--sm pp-i-mail" role="img" aria-hidden="true"/> daniel@propelle.com</a>
                        </div>
                      </article>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_offices pp-section pp-section--tint" id="offices" data-name="Offices" data-snippet="s_propelle_offices">
                  <div class="pp-container">
                    <div class="pp-head">
                      <h2 class="pp-title">Where to find us</h2>
                    </div>
                    <ul class="pp-ab-offices">
                      <li class="pp-reveal">
                        <h3>Malibu</h3>
                        <span class="pp-ab-offices__focus">Head office</span>
                        <span class="pp-ab-offices__addr"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 22801 Pacific Coast Hwy, Malibu, CA 90265</span>
                        <a class="pp-ab-offices__phone" href="tel:+13105550148"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (310) 555-0148</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>Miami</h3>
                        <span class="pp-ab-offices__focus">Sales and rentals</span>
                        <span class="pp-ab-offices__addr"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 1101 Brickell Ave, Suite 400, Miami, FL 33131</span>
                        <a class="pp-ab-offices__phone" href="tel:+13055550192"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (305) 555-0192</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>New York</h3>
                        <span class="pp-ab-offices__focus">New developments</span>
