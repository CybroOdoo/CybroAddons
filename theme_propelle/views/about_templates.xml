                        <a class="pp-ab-offices__phone" href="tel:+12125550117"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (212) 555-0117</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>Austin</h3>
                        <span class="pp-ab-offices__focus">Family homes</span>
                        <span class="pp-ab-offices__addr"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 3700 Bee Cave Rd, Austin, TX 78746</span>
                        <a class="pp-ab-offices__phone" href="tel:+15125550163"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (512) 555-0163</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>Aspen</h3>
                        <span class="pp-ab-offices__focus">Seasonal rentals</span>
                        <span class="pp-ab-offices__addr"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 520 E Durant Ave, Aspen, CO 81611</span>
                        <a class="pp-ab-offices__phone" href="tel:+19705550184"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (970) 555-0184</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>San Francisco</h3>
                        <span class="pp-ab-offices__focus">Commercial</span>
                        <span class="pp-ab-offices__addr"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 1455 3rd St, San Francisco, CA 94158</span>
                        <a class="pp-ab-offices__phone" href="tel:+14155550139"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (415) 555-0139</a>
                      </li>
                    </ul>
                  </div>
                </section>
                <section class="pp-s s_propelle_careers pp-ab-careers" data-name="Careers Band" data-snippet="s_propelle_careers">
                  <div class="pp-container pp-ab-careers__grid">
                    <div>
                      <p class="pp-eyebrow">Careers</p>
                      <h2 class="pp-ab-careers__title">Work with us.</h2>
                    </div>
                    <div>
                      <p>We're hiring agents in Austin and San Francisco. If you'd rather know your clients than chase volume, we'd like to hear from you.</p>
                      <div class="pp-cta__buttons">
                        <a href="/contactus" class="pp-btn pp-btn--sand">Get in Touch <i class="pp-icon pp-icon--sm pp-i-arrow-up-right" role="img" aria-hidden="true"/></a>
                        <span class="pp-ab-careers__mail">careers@propelle.com</span>
                      </div>
                    </div>
                  </div>
                </section>
            </div>
        </t>
    </template>

    <record id="about_page_page" model="theme.website.page">
        <field name="url">/about</field>
        <field name="view_id" ref="about_page"/>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
