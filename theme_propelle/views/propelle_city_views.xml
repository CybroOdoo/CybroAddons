<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Backend views of the cities.
-->
<odoo>
    <record id="propelle_city_view_list" model="ir.ui.view">
        <field name="name">propelle.city.view.list</field>
        <field name="model">propelle.city</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state_code"/>
                <field name="property_count"/>
            </list>
        </field>
    </record>

    <record id="propelle_city_action" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">propelle.city</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="propelle_city_menu_configuration" name="Configuration" parent="propelle_property_menu_root" sequence="90"/>
    <menuitem id="propelle_city_menu" name="Cities" parent="propelle_city_menu_configuration" action="propelle_city_action" sequence="10"/>
</odoo>
