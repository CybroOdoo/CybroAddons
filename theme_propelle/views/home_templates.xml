<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Home page of the Propelle theme, built from its editable building blocks.
-->
<odoo>
    <template id="homepage" name="Propelle Home" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="pp-s s_propelle_hero pp-hero pp-hero--dusk pp-hero--framed" id="home" aria-label="Welcome" data-name="Hero Search" data-snippet="s_propelle_hero">
                  <div class="pp-hero__frame">
                    <div class="pp-hero__media">
                      <img src="/theme_propelle/static/src/img/img1.jpg" alt="Hillside villa with warm lights and an infinity pool at dusk" width="2000" height="1121" fetchpriority="high"/>
                    </div>
                    <div class="pp-hero__overlay" aria-hidden="true"/>

                    <div class="pp-container pp-hero__body">
                      <p class="pp-hero__eyebrow">Buy <span>·</span> Sell <span>·</span> Rent</p>
                      <h1 class="pp-hero__title">Find a Place That Feels<br/><em>Like Home.</em></h1>
                      <p class="pp-hero__text">Homes, apartments and new developments for sale and rent in Malibu, Miami, New York, Austin, Aspen and San Francisco.</p>
                      <div class="pp-hero__ctas">
                        <a href="/buy" class="pp-btn pp-btn--sand">Explore Properties <i class="pp-icon pp-icon--sm pp-i-arrow-up-right" role="img" aria-hidden="true"/></a>
                        <a href="/sell#valuation" class="pp-hero__link"><span class="pp-hero__link-circle"><i class="pp-icon pp-icon--sm pp-i-arrow-up-right" role="img" aria-hidden="true"/></span>List Your Property</a>
                      </div>
                    </div>

                    <!-- ============ SEARCH ============ -->
                    <div class="pp-container pp-hero__dock">
                    <form class="pp-search-panel" id="search-form" aria-label="Property search">
                      <div class="pp-seg" role="radiogroup" aria-label="Listing type">
                        <button type="button" class="pp-seg__btn pp-is-active" role="radio" aria-checked="true" data-status="sale">Buy</button>
                        <button type="button" class="pp-seg__btn" role="radio" aria-checked="false" data-status="rent">Rent</button>
                      </div>
                      <div class="pp-search-panel__fields">
                        <div class="pp-search-panel__field">
                          <label for="s-location">Location</label>
                          <select id="s-location" name="location" data-pp-options="cities">
                            <option value="all">All locations</option>
                            <option value="Malibu">Malibu, CA</option>
                            <option value="Miami">Miami, FL</option>
                            <option value="New York">New York, NY</option>
                            <option value="Austin">Austin, TX</option>
                            <option value="Aspen">Aspen, CO</option>
                            <option value="San Francisco">San Francisco, CA</option>
                          </select>
                        </div>
                        <div class="pp-search-panel__field">
                          <label for="s-type">Property type</label>
                          <select id="s-type" name="type" data-pp-options="types">
                            <option value="all">Any type</option>
                            <option value="villa">Villa</option>
                            <option value="apartment">Apartment</option>
                            <option value="house">Family home</option>
                            <option value="commercial">Commercial</option>
                          </select>
                        </div>
                        <div class="pp-search-panel__field">
                          <label for="s-budget">Budget</label>
                          <select id="s-budget" name="budget">
                            <option value="all">Any budget</option>
                          </select>
                        </div>
                        <button type="submit" class="pp-btn pp-btn--dark pp-search-panel__submit">
                          <i class="pp-icon pp-icon--sm pp-i-search" role="img" aria-hidden="true"/> Search
                        </button>
                      </div>
                    </form>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_intro pp-section" id="about" data-name="Intro and Figures" data-snippet="s_propelle_intro">
                  <div class="pp-container pp-intro2">
                    <div class="pp-intro2__text pp-reveal">
                      <h2 class="pp-intro2__title">An independent brokerage, run by people who live where they sell.</h2>
                      <p>Since 2009 we've helped around 2,800 families buy, sell and rent across six cities. One agent looks after you from the first viewing to closing.</p>
                      <a class="pp-btn pp-btn--outline" href="/about">Our Story <i class="pp-icon pp-icon--sm pp-i-arrow" role="img" aria-hidden="true"/></a>
                    </div>
                    <dl class="pp-intro2__stats pp-reveal">
                      <div><dt>Homes sold or let in 2025</dt><dd>1,400</dd></div>
                      <div><dt>Years in business</dt><dd>16</dd></div>
                      <div><dt>Licensed agents</dt><dd>120</dd></div>
                      <div><dt>Local offices</dt><dd>6</dd></div>
                    </dl>
                  </div>
                </section>
                <section class="pp-s s_propelle_routes pp-section pp-section--tint" id="routes" data-name="Service Tiles" data-snippet="s_propelle_routes">
                  <div class="pp-container">
                    <div class="pp-head pp-head--split">
                      <div>
                        <h2 class="pp-title">What are you looking for?</h2>
                      </div>
                    </div>
                    <div class="pp-services">
                      <a class="pp-svc pp-svc--buy pp-reveal" href="/buy">
                        <img src="/theme_propelle/static/src/img/content/1613977257363-707ba9348227.jpg" alt="White modern villa with a pool" loading="lazy"/>
                        <span class="pp-svc__body">
                          <span class="pp-svc__meta" data-pp-count="sale" data-one="home for sale" data-many="homes for sale">12 homes for sale</span>
                          <span class="pp-svc__title">Buy a home</span>
                          <span class="pp-svc__text">Villas, apartments, family homes and offices from $895,000.</span>
                        </span>
                      </a>
                      <a class="pp-svc pp-svc--rent pp-reveal" href="/rent">
                        <img src="/theme_propelle/static/src/img/content/1560448204-e02f11c3d0e2.jpg" alt="Sunlit apartment living room" loading="lazy"/>
                        <span class="pp-svc__body">
                          <span class="pp-svc__meta" data-pp-count="rent" data-one="home for rent" data-many="homes for rent">9 homes for rent</span>
                          <span class="pp-svc__title">Rent</span>
                        </span>
                      </a>
                      <a class="pp-svc pp-svc--sell pp-svc--plain pp-reveal" href="/sell">
                        <span class="pp-svc__body">
                          <span class="pp-svc__meta">Free valuation</span>
                          <span class="pp-svc__title">Sell your property</span>
                          <span class="pp-svc__text">A local agent, honest pricing and a 2.5% fee agreed in writing.</span>
                        </span>
                      </a>
                      <a class="pp-svc pp-svc--projects pp-reveal" href="/projects">
                        <img src="/theme_propelle/static/src/img/content/1515263487990-61b07816b324.jpg" alt="Residential tower with balconies" loading="lazy"/>
                        <span class="pp-svc__body">
                          <span class="pp-svc__meta" data-pp-count="projects" data-one="project" data-many="projects">6 projects</span>
                          <span class="pp-svc__title">New developments</span>
                        </span>
                      </a>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_cities pp-section" id="cities" data-name="City Carousel" data-snippet="s_propelle_cities">
                  <div class="pp-container">
                    <div class="pp-head pp-head--split">
                      <div>
                        <h2 class="pp-title">Six cities, six local offices</h2>
                      </div>
                      <div class="pp-carousel-nav" role="group" aria-label="Scroll cities">
                        <button type="button" class="pp-carousel-btn" data-carousel-prev="" aria-label="Previous cities"><i class="pp-icon pp-icon--sm pp-i-chev-left" role="img" aria-hidden="true"/></button>
                        <button type="button" class="pp-carousel-btn" data-carousel-next="" aria-label="Next cities"><i class="pp-icon pp-icon--sm pp-i-chev-right" role="img" aria-hidden="true"/></button>
                      </div>
                    </div>
                  </div>
                  <div class="pp-carousel" data-carousel="" tabindex="0" aria-label="Cities">
                    <div class="pp-carousel__track">
                      <a class="pp-place" href="/buy?location=Malibu">
                        <img src="/theme_propelle/static/src/img/content/1615571022219-eb45cf7faa9d.jpg" alt="Beach house on a cliff above the ocean" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Malibu</span>
                          <span class="pp-place__note">Beach houses, canyon estates</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=Miami">
                        <img src="/theme_propelle/static/src/img/content/1514214246283-d427a95c5d2f.jpg" alt="Palm trees and towers along Miami Beach" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Miami</span>
                          <span class="pp-place__note">Bayfront apartments</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=New%20York">
                        <img src="/theme_propelle/static/src/img/content/1534430480872-3498386e7856.jpg" alt="Manhattan skyline in daylight" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">New York</span>
                          <span class="pp-place__note">Lofts and penthouses</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=Austin">
                        <img src="/theme_propelle/static/src/img/content/1588993608283-7f0eda4438be.jpg" alt="Austin skyline above the river" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Austin</span>
                          <span class="pp-place__note">Family homes</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=Aspen">
                        <img src="/theme_propelle/static/src/img/content/1605540436563-5bca919ae766.jpg" alt="Skiers on a snowy slope" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Aspen</span>
                          <span class="pp-place__note">Ski homes and seasonal rentals</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=San%20Francisco">
                        <img src="/theme_propelle/static/src/img/content/1501594907352-04cda38ebc29.jpg" alt="Golden Gate Bridge over the bay" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">San Francisco</span>
                          <span class="pp-place__note">Flats and offices</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=Malibu">
                        <img src="/theme_propelle/static/src/img/content/1507525428034-b723cf961d3e.jpg" alt="Beach at sunrise with gentle waves" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Point Dume</span>
                          <span class="pp-place__note">Neighbourhood · Malibu</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=Miami">
                        <img src="/theme_propelle/static/src/img/content/1519046904884-53103b34b206.jpg" alt="Palm tree on a white sand beach" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Biscayne Bay</span>
                          <span class="pp-place__note">Neighbourhood · Miami</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=New%20York">
                        <img src="/theme_propelle/static/src/img/content/1500916434205-0c77489c6cf7.jpg" alt="Tree-lined Manhattan avenue with yellow cab" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Tribeca</span>
                          <span class="pp-place__note">Neighbourhood · New York</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=Austin">
                        <img src="/theme_propelle/static/src/img/content/1600585154340-be6161a56a0c.jpg" alt="Modern timber family house under a gum tree" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Westlake Hills</span>
                          <span class="pp-place__note">Neighbourhood · Austin</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=Aspen">
                        <img src="/theme_propelle/static/src/img/content/1501785888041-af3ef285b470.jpg" alt="Turquoise mountain lake below rocky peaks" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Red Mountain</span>
                          <span class="pp-place__note">Neighbourhood · Aspen</span>
                        </span>
                      </a>
                      <a class="pp-place" href="/buy?location=San%20Francisco">
                        <img src="/theme_propelle/static/src/img/content/1580587771525-78b9dba3b914.jpg" alt="Modern house with a pool and terraces" loading="lazy"/>
                        <span class="pp-place__body">
                          <span class="pp-place__name">Sea Cliff</span>
                          <span class="pp-place__note">Neighbourhood · San Francisco</span>
                        </span>
                      </a>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_praise pp-section pp-section--tint" id="testimonials" data-name="Client Reviews" data-snippet="s_propelle_praise">
                  <div class="pp-container">
                    <div class="pp-head">
                      <h2 class="pp-title">What our clients say</h2>
                    </div>
                    <div class="pp-praise">
                      <figure class="pp-praise__main pp-reveal">
                        <div class="pp-praise__score"><strong>4.9</strong><span><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><small>Average of 312 reviews</small></span></div>
                        <blockquote>“We saw eleven houses over two weekends and our agent was honest about the ones she didn't like. We bought the fourth one we'd seen.”</blockquote>
                        <figcaption>
                          <img src="/theme_propelle/static/src/img/content/1494790108377-be9c29b29330.jpg" alt="" loading="lazy"/>
                          <span><strong>Sophia Martinez</strong>Bought in Malibu, 2025</span>
                        </figcaption>
                      </figure>
                      <figure class="pp-praise__card pp-reveal">
                        <div class="pp-stars" role="img" aria-label="5 out of 5 stars"><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/></div>
                        <blockquote>“Our apartment sold in eleven days, a little over asking. The staging advice was simple and didn't cost much.”</blockquote>
                        <figcaption>
                          <img src="/theme_propelle/static/src/img/content/1507003211169-0a1dd7228f2d.jpg" alt="" loading="lazy"/>
                          <span><strong>James Whitfield</strong>Sold in Tribeca, 2024</span>
                        </figcaption>
                      </figure>
                      <figure class="pp-praise__card pp-reveal">
                        <div class="pp-stars" role="img" aria-label="4 out of 5 stars"><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-star--off pp-i-star" role="img" aria-hidden="true"/></div>
                        <blockquote>“I signed the lease from London without seeing the flat. The video tour was thorough and the place matched it.”</blockquote>
                        <figcaption>
                          <img src="/theme_propelle/static/src/img/content/1438761681033-6461ffad8d80.jpg" alt="" loading="lazy"/>
                          <span><strong>Amelia Chen</strong>Rented in Brickell, 2025</span>
                        </figcaption>
                      </figure>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_split_card pp-section" id="sell" data-name="Split Call to Action" data-snippet="s_propelle_split_card">
                  <div class="pp-container">
                    <div class="pp-split-card pp-reveal">
                      <div class="pp-split-card__body">
                        <h2 class="pp-split-card__title">Your Next Chapter Starts Here.</h2>
                        <p>Tell us what you're looking for and an agent from your nearest office will call you back, usually the same day.</p>
                        <div class="pp-cta__buttons">
                          <a href="/contactus" class="pp-btn pp-btn--dark">Talk to an Expert <i class="pp-icon pp-icon--sm pp-i-arrow-up-right" role="img" aria-hidden="true"/></a>
                          <a href="/buy" class="pp-btn pp-btn--outline">Find Your Property</a>
                        </div>
                        <p class="pp-split-card__phone"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (310) 555-0148 · Mon–Fri 9am–6pm</p>
                      </div>
                      <div class="pp-split-card__media">
                        <img src="/theme_propelle/static/src/img/content/1600566753086-00f18fb6b3ea.jpg" alt="Bright living room with a timber staircase" loading="lazy"/>
                      </div>
                    </div>
                  </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
