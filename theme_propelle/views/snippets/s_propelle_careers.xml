<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Careers Band: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_careers" name="Propelle Careers Band">
        <section class="pp-s s_propelle_careers pp-ab-careers" data-name="Careers Band">
          <div class="pp-container pp-ab-careers__grid">
            <div>
              <p class="pp-eyebrow">Careers</p>
              <h2 class="pp-ab-careers__title">Work with us.</h2>
            </div>
            <div>
              <p>We're hiring agents in Austin and San Francisco. If you'd rather know your clients than chase volume, we'd like to hear from you.</p>
              <div class="pp-cta__buttons">
                <a href="/contactus" class="pp-btn pp-btn--sand">Get in Touch <i class="pp-icon pp-icon--sm pp-i-arrow-up-right" role="img" aria-hidden="true"/></a>
                <span class="pp-ab-careers__mail">careers@propelle.com</span>
              </div>
            </div>
          </div>
        </section>
    </template>
</odoo>
