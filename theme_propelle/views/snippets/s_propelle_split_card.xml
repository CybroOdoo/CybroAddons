<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Split Call to Action: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_split_card" name="Propelle Split Call to Action">
        <section class="pp-s s_propelle_split_card pp-section" id="sell" data-name="Split Call to Action">
          <div class="pp-container">
            <div class="pp-split-card pp-reveal">
              <div class="pp-split-card__body">
                <h2 class="pp-split-card__title">Your Next Chapter Starts Here.</h2>
                <p>Tell us what you're looking for and an agent from your nearest office will call you back, usually the same day.</p>
                <div class="pp-cta__buttons">
                  <a href="/contactus" class="pp-btn pp-btn--dark">Talk to an Expert <i class="pp-icon pp-icon--sm pp-i-arrow-up-right" role="img" aria-hidden="true"/></a>
                  <a href="/buy" class="pp-btn pp-btn--outline">Find Your Property</a>
                </div>
                <p class="pp-split-card__phone"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (310) 555-0148 · Mon–Fri 9am–6pm</p>
              </div>
              <div class="pp-split-card__media">
                <img src="/theme_propelle/static/src/img/content/1600566753086-00f18fb6b3ea.jpg" alt="Bright living room with a timber staircase" loading="lazy"/>
              </div>
            </div>
          </div>
        </section>
    </template>
</odoo>
