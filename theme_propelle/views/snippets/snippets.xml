<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Building blocks of the Propelle theme, listed in their own group of the
    website builder.
-->
<odoo>
    <template id="snippets" inherit_id="website.snippets" name="Propelle Snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="propelle" t-snippet="website.s_snippet_group" string="Propelle"
               t-thumbnail="/theme_propelle/static/src/img/snippets/s_propelle_group.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_propelle.s_propelle_hero" string="Hero Search" group="propelle"
               t-thumbnail="/theme_propelle/static/src/img/snippets/s_propelle_hero.jpg">
                <keywords>hero, banner, cover, search, home</keywords>
            </t>
            <t t-snippet="theme_propelle.s_propelle_intro" string="Intro and Figures" group="propelle"
               t-thumbnail="/theme_propelle/static/src/img/snippets/s_propelle_intro.jpg">
                <keywords>intro, about, stats, figures, numbers</keywords>
            </t>
            <t t-snippet="theme_propelle.s_propelle_routes" string="Service Tiles" group="propelle"
               t-thumbnail="/theme_propelle/static/src/img/snippets/s_propelle_routes.jpg">
                <keywords>services, tiles, buy, rent, sell, projects</keywords>
            </t>
            <t t-snippet="theme_propelle.s_propelle_cities" string="City Carousel" group="propelle"
               t-thumbnail="/theme_propelle/static/src/img/snippets/s_propelle_cities.jpg">
                <keywords>cities, carousel, places, slider</keywords>
            </t>
            <t t-snippet="theme_propelle.s_propelle_praise" string="Client Reviews" group="propelle"
               t-thumbnail="/theme_propelle/static/src/img/snippets/s_propelle_praise.jpg">
                <keywords>reviews, testimonials, quotes, rating</keywords>
            </t>
            <t t-snippet="theme_propelle.s_propelle_split_card" string="Split Call to Action" group="propelle"
               t-thumbnail="/theme_propelle/static/src/img/snippets/s_propelle_split_card.jpg">
