<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Fee Cards: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_fees" name="Propelle Fee Cards">
        <section class="pp-s s_propelle_fees pp-section" id="fees" data-name="Fee Cards">
          <div class="pp-container pp-fees">
            <div class="pp-fees__intro pp-reveal">
              <p class="pp-eyebrow">Fees</p>
              <h2 class="pp-title">One fee, agreed up front</h2>
              <p class="pp-lead">You only pay when your home sells. There's nothing to pay at the start, and no extra charges at closing.</p>
            </div>
            <div class="pp-fee-cards">
              <div class="pp-fee-card pp-reveal">
                <p class="pp-fee-card__label">Homes and apartments</p>
                <p class="pp-fee-card__price">2.5%</p>
                <p class="pp-fee-card__note">of the final sale price, plus applicable tax</p>
                <ul class="pp-checklist">
                  <li>Everything listed above</li>
                  <li>No upfront or marketing costs</li>
                  <li>Cancel with 14 days' notice</li>
                </ul>
              </div>
              <div class="pp-fee-card pp-reveal">
                <p class="pp-fee-card__label">Commercial and land</p>
                <p class="pp-fee-card__price">Quoted</p>
                <p class="pp-fee-card__note">based on the property and how it's marketed</p>
                <ul class="pp-checklist">
                  <li>Investor and tenant marketing</li>
                  <li>Lease and yield reports</li>
                  <li>Fee confirmed in writing first</li>
                </ul>
              </div>
            </div>
          </div>
        </section>
    </template>
</odoo>
