<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Process Steps Dark: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_steps_dark" name="Propelle Process Steps Dark">
        <section class="pp-s s_propelle_steps_dark pp-section pp-section--dark" id="process" data-name="Process Steps Dark">
          <div class="pp-container">
            <div class="pp-head">
              <p class="pp-eyebrow">Renting with Propelle</p>
              <h2 class="pp-title">How it works</h2>
              <p>Most tenants move in two to three weeks after their first viewing.</p>
            </div>
            <ol class="pp-steps">
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">1</span>
                <h3>View</h3>
                <p>Book a viewing in person or by video. Your agent can line up several homes on the same day.</p>
              </li>
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">2</span>
                <h3>Apply</h3>
                <p>Send your application with ID and proof of income. We'll pass it to the landlord the same day.</p>
              </li>
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">3</span>
                <h3>Sign the lease</h3>
                <p>Review and sign online, then pay the first month's rent and the security deposit.</p>
              </li>
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">4</span>
                <h3>Move in</h3>
                <p>We walk through the home with you, record its condition and hand over the keys.</p>
              </li>
            </ol>
          </div>
        </section>
    </template>
</odoo>
