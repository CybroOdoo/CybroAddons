<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Process Steps: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_steps" name="Propelle Process Steps">
        <section class="pp-s s_propelle_steps pp-section pp-section--tint" id="process" data-name="Process Steps">
          <div class="pp-container">
            <div class="pp-head">
              <p class="pp-eyebrow">Buying with Propelle</p>
              <h2 class="pp-title">How it works</h2>
              <p>Most purchases take eight to twelve weeks from first viewing to keys. Here's what happens along the way.</p>
            </div>
            <ol class="pp-steps pp-steps--line">
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">1</span>
                <h3>Talk to an agent</h3>
                <p>Tell us your budget, areas and must-haves. We'll send a short list and book viewings.</p>
              </li>
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">2</span>
                <h3>Get pre-approved</h3>
                <p>A mortgage pre-approval shows sellers you're ready. We can introduce you to local lenders.</p>
              </li>
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">3</span>
                <h3>Make an offer</h3>
                <p>We'll pull recent sales nearby so your offer is based on real numbers, then negotiate for you.</p>
              </li>
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">4</span>
                <h3>Close</h3>
                <p>Inspection, appraisal and paperwork. Your agent keeps everyone on schedule until you get the keys.</p>
              </li>
            </ol>
          </div>
        </section>
    </template>
</odoo>
