<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Process Timeline: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_steps_vertical" name="Propelle Process Timeline">
        <section class="pp-s s_propelle_steps_vertical pp-section" id="off-plan" data-name="Process Timeline">
          <div class="pp-container">
            <div class="pp-head">
              <p class="pp-eyebrow">Buying off-plan</p>
              <h2 class="pp-title">How buying a new-build works</h2>
              <p>Buying before a building is finished can mean a better price and first choice of homes. Here's what to expect.</p>
            </div>
            <ol class="pp-steps pp-steps--vertical">
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">1</span>
                <h3>Reserve</h3>
                <p>Choose a home and pay a refundable reservation fee to take it off the market for 30 days.</p>
              </li>
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">2</span>
                <h3>Sign and pay the deposit</h3>
                <p>Your attorney reviews the contract. Deposits are usually 10 to 20 percent, held in escrow.</p>
              </li>
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">3</span>
                <h3>Follow the build</h3>
                <p>We send progress photos every quarter and arrange site visits at key stages.</p>
              </li>
              <li class="pp-step pp-reveal">
                <span class="pp-step__num">4</span>
                <h3>Inspect and complete</h3>
                <p>Walk through the finished home, sign off any snags, then pay the balance and collect the keys.</p>
              </li>
            </ol>
          </div>
        </section>
    </template>
</odoo>
