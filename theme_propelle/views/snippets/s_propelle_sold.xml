<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Recent Sales: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_sold" name="Propelle Recent Sales">
        <section class="pp-s s_propelle_sold pp-section pp-section--tint" id="sold" data-name="Recent Sales">
          <div class="pp-container">
            <div class="pp-head">
              <p class="pp-eyebrow">Recently sold</p>
              <h2 class="pp-title">Some of our recent sales</h2>
            </div>
            <div class="pp-dev-grid">
              <article class="pp-dev pp-reveal">
                <div class="pp-dev__media">
                  <img src="/theme_propelle/static/src/img/content/1599809275671-b5942cabc7a2.jpg" alt="Villa with a pool and spa at sunset" loading="lazy"/>
                  <span class="pp-availability pp-availability--sold">Sold</span>
                </div>
                <div class="pp-dev__body">
                  <h3>Latigo Canyon Road</h3>
                  <p class="pp-dev__loc">Malibu, CA</p>
                  <div class="pp-dev__meta"><span>Sold for <strong>$6,900,000</strong></span><span>103% of asking</span><span>Offer in 12 days</span></div>
                </div>
              </article>
              <article class="pp-dev pp-reveal">
                <div class="pp-dev__media">
                  <img src="/theme_propelle/static/src/img/content/1512918728675-ed5a9ecdebfd.jpg" alt="Bedroom with a padded headboard and timber floor" loading="lazy"/>
                  <span class="pp-availability pp-availability--sold">Sold</span>
                </div>
                <div class="pp-dev__body">
                  <h3>Greenwich Street Apartment</h3>
                  <p class="pp-dev__loc">Tribeca, New York, NY</p>
                  <div class="pp-dev__meta"><span>Sold for <strong>$2,450,000</strong></span><span>101% of asking</span><span>Offer in 9 days</span></div>
                </div>
              </article>
              <article class="pp-dev pp-reveal">
                <div class="pp-dev__media">
                  <img src="/theme_propelle/static/src/img/content/1600047509358-9dc75507daeb.jpg" alt="Modern family house with a front lawn" loading="lazy"/>
                  <span class="pp-availability pp-availability--sold">Sold</span>
                </div>
                <div class="pp-dev__body">
                  <h3>Bouldin Creek House</h3>
                  <p class="pp-dev__loc">Austin, TX</p>
                  <div class="pp-dev__meta"><span>Sold for <strong>$1,180,000</strong></span><span>106% of asking</span><span>Offer in 6 days</span></div>
                </div>
              </article>
            </div>
          </div>
        </section>
    </template>
</odoo>
