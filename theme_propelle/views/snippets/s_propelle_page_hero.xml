<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Page Hero: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_page_hero" name="Propelle Page Hero">
        <section class="pp-s s_propelle_page_hero pp-hero-plain" aria-labelledby="page-title" data-name="Page Hero">
          <div class="pp-container pp-hero-plain__grid">
            <div>
              <nav class="pp-breadcrumb pp-breadcrumb--dark" aria-label="Breadcrumb">
              <ol>
                <li><a href="/">Home</a></li>
                <li aria-current="page">Sell</li>
              </ol>
            </nav>
              <h1 class="pp-hero-plain__title" id="page-title">Sell your property</h1>
              <p class="pp-hero-plain__lead">A local agent, honest pricing and a fee agreed in writing before we start. Most valuations happen within a week of your call.</p>
              <div class="pp-hero-plain__ctas">
                <a href="/booking?type=sell" class="pp-btn pp-btn--dark">Book a Free Valuation</a>
                <a href="#process" class="pp-btn pp-btn--outline">How It Works</a>
              </div>
            </div>
            <dl class="pp-hero-plain__stats">
              <div><dt>Time to offer</dt><dd>21 days</dd></div>
              <div><dt>Price vs asking</dt><dd>101%</dd></div>
              <div><dt>Standard fee</dt><dd>2.5%</dd></div>
            </dl>
          </div>
        </section>
    </template>
</odoo>
