<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Rent Calculator: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_rent_calc" name="Propelle Rent Calculator">
        <section class="pp-s s_propelle_rent_calc pp-section" id="calculator" data-name="Rent Calculator">
          <div class="pp-container pp-calc">
            <div class="pp-calc__intro">
              <p class="pp-eyebrow">Rent calculator</p>
              <h2 class="pp-title">How much rent can you afford?</h2>
              <p class="pp-lead">A common guide is to spend no more than 30 percent of your gross income on rent.</p>
              <h3 class="pp-calc__subhead">Documents you'll need to apply</h3>
              <ul class="pp-checklist">
                <li>Photo ID for each adult on the lease</li>
                <li>Last two pay stubs or an employment letter</li>
                <li>Recent bank statements</li>
                <li>References from previous landlords, if you have them</li>
              </ul>
            </div>
            <form class="pp-calc__form" id="rent-calc" aria-label="Rent affordability calculator">
              <div class="pp-form-row">
                <div class="pp-field">
                  <label for="rc-income">Annual household income ($)</label>
                  <input id="rc-income" type="number" min="0" step="1000" value="180000" inputmode="numeric"/>
                </div>
                <div class="pp-field">
                  <label for="rc-debts">Monthly debt payments ($)</label>
                  <input id="rc-debts" type="number" min="0" step="50" value="500" inputmode="numeric"/>
                </div>
              </div>
              <div class="pp-field">
                <label for="rc-share">Share of income for rent</label>
                <select id="rc-share">
                  <option value="25">25% (comfortable)</option>
                  <option value="30" selected="selected">30% (typical)</option>
                  <option value="35">35% (stretch)</option>
                </select>
              </div>
              <div class="pp-calc__result" aria-live="polite">
                <p class="pp-calc__label">Suggested maximum rent</p>
                <p class="pp-calc__monthly" id="rc-max">$0</p>
                <dl class="pp-calc__breakdown pp-calc__breakdown--two">
                  <div><dt>Income landlords usually ask for (40× rent)</dt><dd id="rc-income-needed">$0</dd></div>
                  <div><dt>Move-in cost (first month + deposit)</dt><dd id="rc-deposit">$0</dd></div>
                </dl>
              </div>
              <p class="pp-calc__note">A rough guide only. Landlords set their own income and deposit requirements.</p>
            </form>
          </div>
        </section>
    </template>
</odoo>
