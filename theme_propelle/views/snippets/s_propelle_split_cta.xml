<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Photo Call to Action: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_split_cta" name="Propelle Photo Call to Action">
        <section class="pp-s s_propelle_split_cta pp-section" data-name="Photo Call to Action">
          <div class="pp-container">
            <div class="pp-split-cta pp-reveal">
              <img src="/theme_propelle/static/src/img/content/1600210492486-724fe5c67fb0.jpg" alt="Furnished living room with a leather sofa and plants" loading="lazy"/>
              <div class="pp-split-cta__body">
                <p class="pp-eyebrow">For landlords</p>
                <h2 class="pp-title">Have a home to rent out?</h2>
                <p>We find tenants, run the checks and can manage the property after they move in. Letting only, or full management from 8% of the monthly rent.</p>
                <div class="pp-cta__buttons">
                  <a href="/contactus" class="pp-btn pp-btn--dark">Talk to an Expert</a>
                  <a href="/sell#valuation" class="pp-btn pp-btn--outline">List Your Property</a>
                </div>
              </div>
            </div>
          </div>
        </section>
    </template>
</odoo>
