<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Hero Search: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_hero" name="Propelle Hero Search">
        <section class="pp-s s_propelle_hero pp-hero pp-hero--dusk pp-hero--framed" id="home" aria-label="Welcome" data-name="Hero Search">
          <div class="pp-hero__frame">
            <div class="pp-hero__media">
              <img src="/theme_propelle/static/src/img/img1.jpg" alt="Hillside villa with warm lights and an infinity pool at dusk" width="2000" height="1121" fetchpriority="high"/>
            </div>
            <div class="pp-hero__overlay" aria-hidden="true"/>

            <div class="pp-container pp-hero__body">
              <p class="pp-hero__eyebrow">Buy <span>·</span> Sell <span>·</span> Rent</p>
              <h1 class="pp-hero__title">Find a Place That Feels<br/><em>Like Home.</em></h1>
              <p class="pp-hero__text">Homes, apartments and new developments for sale and rent in Malibu, Miami, New York, Austin, Aspen and San Francisco.</p>
              <div class="pp-hero__ctas">
                <a href="/buy" class="pp-btn pp-btn--sand">Explore Properties <i class="pp-icon pp-icon--sm pp-i-arrow-up-right" role="img" aria-hidden="true"/></a>
                <a href="/sell#valuation" class="pp-hero__link"><span class="pp-hero__link-circle"><i class="pp-icon pp-icon--sm pp-i-arrow-up-right" role="img" aria-hidden="true"/></span>List Your Property</a>
              </div>
            </div>

            <!-- ============ SEARCH ============ -->
            <div class="pp-container pp-hero__dock">
            <form class="pp-search-panel" id="search-form" aria-label="Property search">
              <div class="pp-seg" role="radiogroup" aria-label="Listing type">
                <button type="button" class="pp-seg__btn pp-is-active" role="radio" aria-checked="true" data-status="sale">Buy</button>
                <button type="button" class="pp-seg__btn" role="radio" aria-checked="false" data-status="rent">Rent</button>
              </div>
              <div class="pp-search-panel__fields">
                <div class="pp-search-panel__field">
                  <label for="s-location">Location</label>
                  <select id="s-location" name="location" data-pp-options="cities">
                    <option value="all">All locations</option>
                    <option value="Malibu">Malibu, CA</option>
                    <option value="Miami">Miami, FL</option>
                    <option value="New York">New York, NY</option>
                    <option value="Austin">Austin, TX</option>
                    <option value="Aspen">Aspen, CO</option>
                    <option value="San Francisco">San Francisco, CA</option>
                  </select>
                </div>
                <div class="pp-search-panel__field">
                  <label for="s-type">Property type</label>
                  <select id="s-type" name="type" data-pp-options="types">
                    <option value="all">Any type</option>
                    <option value="villa">Villa</option>
                    <option value="apartment">Apartment</option>
                    <option value="house">Family home</option>
                    <option value="commercial">Commercial</option>
                  </select>
                </div>
                <div class="pp-search-panel__field">
                  <label for="s-budget">Budget</label>
                  <select id="s-budget" name="budget">
                    <option value="all">Any budget</option>
                  </select>
                </div>
                <button type="submit" class="pp-btn pp-btn--dark pp-search-panel__submit">
                  <i class="pp-icon pp-icon--sm pp-i-search" role="img" aria-hidden="true"/> Search
                </button>
              </div>
            </form>
            </div>
          </div>
        </section>
    </template>
</odoo>
