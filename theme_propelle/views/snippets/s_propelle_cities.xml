<?xml version="1.0" encoding="UTF-8" ?>
<!--
    City Carousel: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_cities" name="Propelle City Carousel">
        <section class="pp-s s_propelle_cities pp-section" id="cities" data-name="City Carousel">
          <div class="pp-container">
            <div class="pp-head pp-head--split">
              <div>
                <h2 class="pp-title">Six cities, six local offices</h2>
              </div>
              <div class="pp-carousel-nav" role="group" aria-label="Scroll cities">
                <button type="button" class="pp-carousel-btn" data-carousel-prev="" aria-label="Previous cities"><i class="pp-icon pp-icon--sm pp-i-chev-left" role="img" aria-hidden="true"/></button>
                <button type="button" class="pp-carousel-btn" data-carousel-next="" aria-label="Next cities"><i class="pp-icon pp-icon--sm pp-i-chev-right" role="img" aria-hidden="true"/></button>
              </div>
            </div>
          </div>
          <div class="pp-carousel" data-carousel="" tabindex="0" aria-label="Cities">
            <div class="pp-carousel__track">
              <a class="pp-place" href="/buy?location=Malibu">
                <img src="/theme_propelle/static/src/img/content/1615571022219-eb45cf7faa9d.jpg" alt="Beach house on a cliff above the ocean" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Malibu</span>
                  <span class="pp-place__note">Beach houses, canyon estates</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=Miami">
                <img src="/theme_propelle/static/src/img/content/1514214246283-d427a95c5d2f.jpg" alt="Palm trees and towers along Miami Beach" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Miami</span>
                  <span class="pp-place__note">Bayfront apartments</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=New%20York">
                <img src="/theme_propelle/static/src/img/content/1534430480872-3498386e7856.jpg" alt="Manhattan skyline in daylight" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">New York</span>
                  <span class="pp-place__note">Lofts and penthouses</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=Austin">
                <img src="/theme_propelle/static/src/img/content/1588993608283-7f0eda4438be.jpg" alt="Austin skyline above the river" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Austin</span>
                  <span class="pp-place__note">Family homes</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=Aspen">
                <img src="/theme_propelle/static/src/img/content/1605540436563-5bca919ae766.jpg" alt="Skiers on a snowy slope" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Aspen</span>
                  <span class="pp-place__note">Ski homes and seasonal rentals</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=San%20Francisco">
                <img src="/theme_propelle/static/src/img/content/1501594907352-04cda38ebc29.jpg" alt="Golden Gate Bridge over the bay" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">San Francisco</span>
                  <span class="pp-place__note">Flats and offices</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=Malibu">
                <img src="/theme_propelle/static/src/img/content/1507525428034-b723cf961d3e.jpg" alt="Beach at sunrise with gentle waves" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Point Dume</span>
                  <span class="pp-place__note">Neighbourhood · Malibu</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=Miami">
                <img src="/theme_propelle/static/src/img/content/1519046904884-53103b34b206.jpg" alt="Palm tree on a white sand beach" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Biscayne Bay</span>
                  <span class="pp-place__note">Neighbourhood · Miami</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=New%20York">
                <img src="/theme_propelle/static/src/img/content/1500916434205-0c77489c6cf7.jpg" alt="Tree-lined Manhattan avenue with yellow cab" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Tribeca</span>
                  <span class="pp-place__note">Neighbourhood · New York</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=Austin">
                <img src="/theme_propelle/static/src/img/content/1600585154340-be6161a56a0c.jpg" alt="Modern timber family house under a gum tree" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Westlake Hills</span>
                  <span class="pp-place__note">Neighbourhood · Austin</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=Aspen">
                <img src="/theme_propelle/static/src/img/content/1501785888041-af3ef285b470.jpg" alt="Turquoise mountain lake below rocky peaks" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Red Mountain</span>
                  <span class="pp-place__note">Neighbourhood · Aspen</span>
                </span>
              </a>
              <a class="pp-place" href="/buy?location=San%20Francisco">
                <img src="/theme_propelle/static/src/img/content/1580587771525-78b9dba3b914.jpg" alt="Modern house with a pool and terraces" loading="lazy"/>
                <span class="pp-place__body">
                  <span class="pp-place__name">Sea Cliff</span>
                  <span class="pp-place__note">Neighbourhood · San Francisco</span>
                </span>
              </a>
            </div>
          </div>
        </section>
    </template>
</odoo>
