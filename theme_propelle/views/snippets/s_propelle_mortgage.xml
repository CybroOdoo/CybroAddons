<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Mortgage Calculator: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_mortgage" name="Propelle Mortgage Calculator">
        <section class="pp-s s_propelle_mortgage pp-section" id="calculator" data-name="Mortgage Calculator">
          <div class="pp-container pp-calc">
            <div class="pp-calc__intro">
              <p class="pp-eyebrow">Mortgage calculator</p>
              <h2 class="pp-title">Estimate your monthly payment</h2>
              <p class="pp-lead">Change the numbers to see roughly what a mortgage would cost each month.</p>
              <p class="pp-calc__note">This is an estimate of principal and interest only. It doesn't include property tax, insurance or HOA fees. Speak to a lender for an exact quote.</p>
            </div>
            <form class="pp-calc__form" id="mortgage-form" aria-label="Mortgage calculator">
              <div class="pp-form-row">
                <div class="pp-field">
                  <label for="m-price">Home price ($)</label>
                  <input id="m-price" type="number" min="0" step="1000" value="1250000" inputmode="numeric"/>
                </div>
                <div class="pp-field">
                  <label for="m-down">Down payment (%)</label>
                  <input id="m-down" type="number" min="0" max="100" step="1" value="20" inputmode="decimal"/>
                </div>
              </div>
              <div class="pp-form-row">
                <div class="pp-field">
                  <label for="m-rate">Interest rate (%)</label>
                  <input id="m-rate" type="number" min="0" max="20" step="0.05" value="6.5" inputmode="decimal"/>
                </div>
                <div class="pp-field">
                  <label for="m-term">Loan term</label>
                  <select id="m-term">
                    <option value="30">30 years</option>
                    <option value="20">20 years</option>
                    <option value="15">15 years</option>
                  </select>
                </div>
              </div>
              <div class="pp-calc__result" aria-live="polite">
                <p class="pp-calc__label">Estimated monthly payment</p>
                <p class="pp-calc__monthly" id="m-monthly">$0</p>
                <dl class="pp-calc__breakdown">
                  <div><dt>Loan amount</dt><dd id="m-loan">$0</dd></div>
                  <div><dt>Down payment</dt><dd id="m-downpay">$0</dd></div>
                  <div><dt>Total interest</dt><dd id="m-interest">$0</dd></div>
                </dl>
              </div>
            </form>
          </div>
        </section>
    </template>
</odoo>
