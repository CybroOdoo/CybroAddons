<?xml version="1.0" encoding="UTF-8" ?>
<!--
    History Timeline: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_history" name="Propelle History Timeline">
        <section class="pp-s s_propelle_history pp-section" id="history" data-name="History Timeline">
          <div class="pp-container pp-ab-history">
            <div class="pp-ab-history__aside">
              <h2 class="pp-title">How we got here</h2>
              <p>We opened each new office after clients moved there and asked us to keep helping them.</p>
              <img src="/theme_propelle/static/src/img/content/1600607688969-a5bfcd646154.jpg" alt="Timber and black-clad house with a lawn" loading="lazy"/>
            </div>
            <ol class="pp-ab-timeline">
              <li class="pp-reveal">
                <span class="pp-ab-timeline__year">2009</span>
                <div><h3>First office in Malibu</h3><p>Laura and Mark open on Pacific Coast Highway with two desks and a shared assistant.</p></div>
              </li>
              <li class="pp-reveal">
                <span class="pp-ab-timeline__year">2014</span>
                <div><h3>Miami</h3><p>A Brickell office opens to help Malibu clients buying second homes in Florida.</p></div>
              </li>
              <li class="pp-reveal">
                <span class="pp-ab-timeline__year">2016</span>
                <div><h3>New York</h3><p>We open in Tribeca and start selling new-build apartments for developers.</p></div>
              </li>
              <li class="pp-reveal">
                <span class="pp-ab-timeline__year">2019</span>
                <div><h3>Austin and Aspen</h3><p>Two smaller offices, one for family homes and one for seasonal rentals.</p></div>
              </li>
              <li class="pp-reveal">
                <span class="pp-ab-timeline__year">2022</span>
                <div><h3>San Francisco</h3><p>Our sixth office, with a team focused on commercial and mixed-use property.</p></div>
              </li>
              <li class="pp-reveal">
                <span class="pp-ab-timeline__year">2025</span>
                <div><h3>1,400 transactions</h3><p>Our busiest year so far, across sales, rentals and new developments.</p></div>
              </li>
            </ol>
          </div>
        </section>
    </template>
</odoo>
