<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Project Spotlight: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_spotlight" name="Propelle Project Spotlight">
        <section class="pp-s s_propelle_spotlight pp-section pp-section--tint" id="spotlight" data-name="Project Spotlight">
          <div class="pp-container pp-spotlight">
            <div class="pp-spotlight__media pp-reveal">
              <img class="pp-spotlight__main" src="/theme_propelle/static/src/img/content/1600573472550-8090b5e0745e.jpg" alt="Show home at The Serrano Estates: glass walls opening onto the pool" loading="lazy"/>
              <img class="pp-spotlight__inset" src="/theme_propelle/static/src/img/content/1503174971373-b1f69850bded.jpg" alt="Open-plan living room with floor-to-ceiling glass" loading="lazy"/>
            </div>
            <div class="pp-spotlight__content pp-reveal">
              <p class="pp-eyebrow">Project spotlight</p>
              <h2 class="pp-title">The Serrano Estates</h2>
              <p class="pp-spotlight__loc">Bel Air, Los Angeles · Completion summer 2026</p>
              <p>Twelve detached homes on a gated hillside above Stone Canyon. Each home has its own pool, a two-car garage and views across the canyon. Construction started in 2024 and the first four homes are already framed.</p>
              <ul class="pp-spotlight__facts">
                <li><strong>Architect</strong><span>Hollis &amp; Grant</span></li>
                <li><strong>Deposit</strong><span>10% on contract</span></li>
                <li><strong>Homes left</strong><span>9 of 12</span></li>
              </ul>
              <div class="pp-table-wrap">
                <table class="pp-unit-table">
                  <caption class="pp-visually-hidden">Home types and prices at The Serrano Estates</caption>
                  <thead>
                    <tr><th scope="col">Home type</th><th scope="col">Beds</th><th scope="col">Size</th><th scope="col">From</th><th scope="col">Available</th></tr>
                  </thead>
                  <tbody>
                    <tr><th scope="row">Residence A</th><td>4</td><td>4,200 sq ft</td><td>$4,800,000</td><td>4</td></tr>
                    <tr><th scope="row">Residence B</th><td>5</td><td>5,600 sq ft</td><td>$6,400,000</td><td>3</td></tr>
                    <tr><th scope="row">Residence C</th><td>6</td><td>7,300 sq ft</td><td>$8,900,000</td><td>2</td></tr>
                  </tbody>
                </table>
              </div>
              <button type="button" class="pp-btn pp-btn--dark" data-register="The Serrano Estates">Request the brochure</button>
            </div>
          </div>
        </section>
    </template>
</odoo>
