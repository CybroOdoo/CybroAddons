<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Feature Grid: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_features" name="Propelle Feature Grid">
        <section class="pp-s s_propelle_features pp-section pp-section--tint" id="included" data-name="Feature Grid">
          <div class="pp-container">
            <div class="pp-head">
              <p class="pp-eyebrow">What's included</p>
              <h2 class="pp-title">Everything in the standard fee</h2>
            </div>
            <div class="pp-why-grid">
              <div class="pp-why-item pp-reveal">
                <i class="pp-icon pp-i-search" role="img" aria-hidden="true"/>
                <h3>Photography and floor plans</h3>
                <p>Professional photos, a video walkthrough and a measured floor plan for every home.</p>
              </div>
              <div class="pp-why-item pp-reveal">
                <i class="pp-icon pp-i-compass" role="img" aria-hidden="true"/>
                <h3>Listing everywhere buyers look</h3>
                <p>Our website, the main property portals and our list of registered buyers in your area.</p>
              </div>
              <div class="pp-why-item pp-reveal">
                <i class="pp-icon pp-i-phone" role="img" aria-hidden="true"/>
                <h3>Accompanied viewings</h3>
                <p>Your agent shows every buyer around, including evenings and weekends, so you don't have to.</p>
              </div>
              <div class="pp-why-item pp-reveal">
                <i class="pp-icon pp-i-doc" role="img" aria-hidden="true"/>
                <h3>Negotiation and closing</h3>
                <p>We vet offers, negotiate on your behalf and work with your attorney until the sale completes.</p>
              </div>
            </div>
          </div>
        </section>
    </template>
</odoo>
