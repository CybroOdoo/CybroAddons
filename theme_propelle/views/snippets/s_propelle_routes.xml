<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Service Tiles: building block of the Propelle theme.
-->
<odoo>
    <template id="s_propelle_routes" name="Propelle Service Tiles">
        <section class="pp-s s_propelle_routes pp-section pp-section--tint" id="routes" data-name="Service Tiles">
          <div class="pp-container">
            <div class="pp-head pp-head--split">
              <div>
                <h2 class="pp-title">What are you looking for?</h2>
              </div>
            </div>
            <div class="pp-services">
              <a class="pp-svc pp-svc--buy pp-reveal" href="/buy">
                <img src="/theme_propelle/static/src/img/content/1613977257363-707ba9348227.jpg" alt="White modern villa with a pool" loading="lazy"/>
                <span class="pp-svc__body">
                  <span class="pp-svc__meta" data-pp-count="sale" data-one="home for sale" data-many="homes for sale">12 homes for sale</span>
                  <span class="pp-svc__title">Buy a home</span>
                  <span class="pp-svc__text">Villas, apartments, family homes and offices from $895,000.</span>
                </span>
              </a>
              <a class="pp-svc pp-svc--rent pp-reveal" href="/rent">
                <img src="/theme_propelle/static/src/img/content/1560448204-e02f11c3d0e2.jpg" alt="Sunlit apartment living room" loading="lazy"/>
                <span class="pp-svc__body">
                  <span class="pp-svc__meta" data-pp-count="rent" data-one="home for rent" data-many="homes for rent">9 homes for rent</span>
                  <span class="pp-svc__title">Rent</span>
                </span>
              </a>
              <a class="pp-svc pp-svc--sell pp-svc--plain pp-reveal" href="/sell">
                <span class="pp-svc__body">
                  <span class="pp-svc__meta">Free valuation</span>
                  <span class="pp-svc__title">Sell your property</span>
                  <span class="pp-svc__text">A local agent, honest pricing and a 2.5% fee agreed in writing.</span>
                </span>
              </a>
              <a class="pp-svc pp-svc--projects pp-reveal" href="/projects">
                <img src="/theme_propelle/static/src/img/content/1515263487990-61b07816b324.jpg" alt="Residential tower with balconies" loading="lazy"/>
                <span class="pp-svc__body">
                  <span class="pp-svc__meta" data-pp-count="projects" data-one="project" data-many="projects">6 projects</span>
                  <span class="pp-svc__title">New developments</span>
                </span>
              </a>
            </div>
          </div>
        </section>
    </template>
</odoo>
