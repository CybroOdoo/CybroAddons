<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Layout of the Propelle theme: the standard header restyled as the floating
    glass bar of the design, the footer columns, and the toast and back to top
    button shared by every page.
-->
<odoo>
    <template id="layout" name="Propelle Layout" inherit_id="website.layout" priority="60">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="pp-wrap" separator=" "/>
        </xpath>
        <xpath expr="//header[@id='top']" position="before">
            <a t-if="not no_header" class="pp-skip-link" href="#wrap">Skip to content</a>
        </xpath>
        <xpath expr="//main" position="after">
            <t t-if="not no_header">
                <div class="pp-s pp-toast o_not_editable" role="status" aria-live="polite"/>
                <button class="pp-s pp-back-to-top o_not_editable" type="button" aria-label="Back to top">
                    <i class="pp-icon pp-icon--sm pp-i-up" role="img" aria-hidden="true"/>
                </button>
            </t>
        </xpath>
    </template>

    <!-- The default header template wears the classes of the design. They are
         set from the template itself, so another header template chosen in
         the website builder keeps the standard look, and Default brings the
         design back. `o_header_overlay_theme` tells the standard header that
         it floats over the page: no padding is added to the content. -->
    <template id="template_header_default" name="Propelle Header" inherit_id="website.template_header_default" priority="10">
        <xpath expr="//header[@id='top']" position="attributes">
            <attribute name="t-attf-class" add="pp-header o_header_overlay_theme" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']" position="attributes">
            <attribute name="t-attf-class" add="pp-nav pp-container" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/t[@t-call='website.placeholder_header_brand']" position="attributes">
            <attribute name="_link_class.f">pp-logo</attribute>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/t[@t-call='website.navbar_nav']" position="attributes">
            <attribute name="_nav_class.f">pp-nav__links</attribute>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/t[@t-call='website.navbar_nav']//t[@t-call='website.submenu']" position="attributes">
            <attribute name="link_class.f">nav-link pp-nav__link</attribute>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/ul[hasclass('navbar-nav')]" position="attributes">
            <attribute name="class" add="pp-nav__actions" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/ul[hasclass('navbar-nav')]/t[@t-call='website.placeholder_header_search_box']" position="before">
            <li class="pp-nav__search o_not_editable">
                <button class="pp-icon-btn pp-search-toggle" type="button" aria-label="Search properties">
                    <i class="pp-icon pp-i-search" role="img" aria-hidden="true"/>
                </button>
            </li>
        </xpath>
    </template>

    <!-- Mobile bar of the header: the search button of the design and its
         round menu button. The menu itself is the standard one. -->
    <template id="template_header_mobile" name="Propelle Header Mobile" inherit_id="website.template_header_mobile" priority="10">
        <xpath expr="//ul[hasclass('o_header_mobile_buttons_wrap')]" position="inside">
            <li class="pp-nav__search o_not_editable">
                <button class="pp-icon-btn pp-search-toggle" type="button" aria-label="Search properties">
                    <i class="pp-icon pp-i-search" role="img" aria-hidden="true"/>
                </button>
            </li>
        </xpath>
        <xpath expr="//button[@data-bs-target='#top_menu_collapse_mobile']" position="attributes">
            <attribute name="class" add="pp-hamburger" separator=" "/>
        </xpath>
        <xpath expr="//button[@data-bs-target='#top_menu_collapse_mobile']/span[hasclass('navbar-toggler-icon')]" position="after">
            <i class="pp-icon pp-hamburger__open pp-i-menu" role="img" aria-hidden="true"/>
            <i class="pp-icon pp-hamburger__close pp-i-close" role="img" aria-hidden="true"/>
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse_mobile']" position="attributes">
            <attribute name="t-attf-class" add="pp-mobile-menu" separator=" "/>
        </xpath>
    </template>

    <!-- Call to action of the header: the pill with the round arrow. -->
    <template id="header_call_to_action" name="Propelle Header Call to Action" inherit_id="website.header_call_to_action" priority="10">
        <xpath expr="//a[hasclass('btn_cta')]" position="replace">
            <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta pp-nav__contact">Contact Us
                <span class="pp-nav__contact-icon" aria-hidden="true"><i class="pp-icon pp-icon--sm pp-i-arrow" role="img" aria-hidden="true"/></span>
            </a>
        </xpath>
    </template>

    <!-- Footer: editable columns of the reference design. -->
    <template id="footer" name="Propelle Footer" inherit_id="website.layout" priority="60">
        <xpath expr="//footer[@id='bottom']" position="attributes">
            <attribute name="t-attf-class" add="pp-site-footer" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer">
                <section class="pp-s pp-footer s_propelle_footer" data-name="Footer Columns">
                    <div class="pp-container pp-footer__grid">
                        <div class="pp-footer__brand">
                            <a href="/" class="pp-logo pp-logo--light" aria-label="Home">
                                <img class="pp-logo__img" src="/theme_propelle/static/src/img/logo.png" alt="Propelle" width="1169" height="299"/>
                            </a>
                            <p>Independent real estate brokerage with offices in Malibu, Miami, New York, Austin, Aspen and San Francisco.</p>
                            <ul class="pp-socials" aria-label="Social media">
                                <li><a href="https://www.instagram.com/propellerealty/" target="_blank" rel="noopener" aria-label="Instagram"><i class="pp-icon pp-icon--sm pp-i-instagram" role="img" aria-hidden="true"/></a></li>
                                <li><a href="https://www.linkedin.com/company/propelle-realty/" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="pp-icon pp-icon--sm pp-i-linkedin" role="img" aria-hidden="true"/></a></li>
                                <li><a href="https://www.facebook.com/propellerealty" target="_blank" rel="noopener" aria-label="Facebook"><i class="pp-icon pp-icon--sm pp-i-facebook" role="img" aria-hidden="true"/></a></li>
                                <li><a href="https://www.youtube.com/@propellerealty" target="_blank" rel="noopener" aria-label="YouTube"><i class="pp-icon pp-icon--sm pp-i-youtube" role="img" aria-hidden="true"/></a></li>
                            </ul>
                        </div>
                        <nav class="pp-footer__col" aria-label="Quick links">
                            <h3>Company</h3>
                            <ul>
                                <li><a href="/buy">Homes for sale</a></li>
                                <li><a href="/rent">Homes for rent</a></li>
                                <li><a href="/projects">New developments</a></li>
                                <li><a href="/about">About us</a></li>
                                <li><a href="/sell">Sell with us</a></li>
                                <li><a href="/contactus">Contact</a></li>
                            </ul>
                        </nav>
                        <nav class="pp-footer__col" aria-label="Property types">
                            <h3>Property types</h3>
                            <ul>
                                <li><a href="/buy?type=villa">Villas</a></li>
                                <li><a href="/buy?type=apartment">Apartments</a></li>
                                <li><a href="/buy?type=house">Family homes</a></li>
                                <li><a href="/buy?type=commercial">Commercial</a></li>
                            </ul>
                        </nav>
                        <div class="pp-footer__col">
                            <h3>Malibu office</h3>
                            <ul>
                                <li><a href="tel:+13105550148">+1 (310) 555-0148</a></li>
                                <li><a href="mailto:hello@propelle.com">hello@propelle.com</a></li>
                                <li><a href="https://www.google.com/maps/search/?api=1&amp;query=22801+Pacific+Coast+Hwy%2C+Malibu%2C+CA+90265" target="_blank" rel="noopener">22801 Pacific Coast Hwy<br/>Malibu, CA 90265</a></li>
                            </ul>
                        </div>
                        <div class="pp-footer__col pp-footer__newsletter">
                            <h3>Newsletter</h3>
                            <p>New listings and price changes, once a month.</p>
                            <div class="js_subscribe" data-list-id="propelle_mailing_list" data-name="Newsletter Form">
                                <div class="js_subscribe_wrap">
                                    <div class="pp-newsletter">
                                        <input type="email" name="email" class="js_subscribe_value form-control" placeholder="Email address" aria-label="Email address" autocomplete="email" required=""/>
                                        <button type="button" class="pp-btn pp-btn--gold pp-btn--sm js_subscribe_btn">Subscribe</button>
                                    </div>
                                </div>
                                <p class="js_subscribed_wrap d-none pp-form-status pp-form-status--light pp-is-success">Thanks, you're subscribed.</p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_copyright')]/div[hasclass('container')]" position="replace">
            <div class="pp-s pp-container pp-footer__bottom">
                <p>© <span t-out="datetime.date.today().year"/> <span t-field="res_company.name">Propelle Realty</span>. All rights reserved.</p>
                <p>Malibu, California</p>
            </div>
        </xpath>
    </template>
</odoo>
