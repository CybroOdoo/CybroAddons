<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Sell page of the Propelle theme, built from its editable building blocks.
-->
<odoo>
    <template id="sell_page" name="Propelle Sell Your Property">
        <t t-call="website.layout">
            <t t-set="additional_title">Sell Your Property</t>
            <t t-set="pageName" t-valuef="propelle_sell"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="pp-s s_propelle_page_hero pp-hero-plain" aria-labelledby="page-title" data-name="Page Hero" data-snippet="s_propelle_page_hero">
                  <div class="pp-container pp-hero-plain__grid">
                    <div>
                      <nav class="pp-breadcrumb pp-breadcrumb--dark" aria-label="Breadcrumb">
                      <ol>
                        <li><a href="/">Home</a></li>
                        <li aria-current="page">Sell</li>
                      </ol>
                    </nav>
                      <h1 class="pp-hero-plain__title" id="page-title">Sell your property</h1>
                      <p class="pp-hero-plain__lead">A local agent, honest pricing and a fee agreed in writing before we start. Most valuations happen within a week of your call.</p>
                      <div class="pp-hero-plain__ctas">
                        <a href="/booking?type=sell" class="pp-btn pp-btn--dark">Book a Free Valuation</a>
                        <a href="#process" class="pp-btn pp-btn--outline">How It Works</a>
                      </div>
                    </div>
                    <dl class="pp-hero-plain__stats">
                      <div><dt>Time to offer</dt><dd>21 days</dd></div>
                      <div><dt>Price vs asking</dt><dd>101%</dd></div>
                      <div><dt>Standard fee</dt><dd>2.5%</dd></div>
                    </dl>
                  </div>
                </section>
                <section class="pp-s s_propelle_process pp-section" id="process" data-name="Process List" data-snippet="s_propelle_process">
                  <div class="pp-container pp-process">
                    <div class="pp-process__aside">
                      <p class="pp-eyebrow">Selling with Propelle</p>
                      <h2 class="pp-title">How it works</h2>
                      <p>From first visit to closing usually takes two to three months, with the same agent the whole way through.</p>
                      <img src="/theme_propelle/static/src/img/content/1600585152220-90363fe7e115.jpg" alt="Bright kitchen with an island and timber stools" loading="lazy"/>
                    </div>
                    <ol class="pp-process__list">
                      <li class="pp-reveal">
                        <span class="pp-process__num">1</span>
                        <div><h3>Valuation</h3><p>Your agent visits, looks at recent sales nearby and gives you a written price range. No obligation.</p></div>
                      </li>
                      <li class="pp-reveal">
                        <span class="pp-process__num">2</span>
                        <div><h3>Preparation</h3><p>We suggest any small fixes worth doing, then photograph, film and measure the home.</p></div>
                      </li>
                      <li class="pp-reveal">
                        <span class="pp-process__num">3</span>
                        <div><h3>Marketing and viewings</h3><p>Your home goes live on our site and the major portals. We run every viewing and report back after each one.</p></div>
                      </li>
                      <li class="pp-reveal">
                        <span class="pp-process__num">4</span>
                        <div><h3>Offers and closing</h3><p>We check each buyer's finances, negotiate the best terms and manage the paperwork through to closing.</p></div>
                      </li>
                    </ol>
                  </div>
                </section>
                <section class="pp-s s_propelle_features pp-section pp-section--tint" id="included" data-name="Feature Grid" data-snippet="s_propelle_features">
                  <div class="pp-container">
                    <div class="pp-head">
                      <p class="pp-eyebrow">What's included</p>
                      <h2 class="pp-title">Everything in the standard fee</h2>
                    </div>
                    <div class="pp-why-grid">
                      <div class="pp-why-item pp-reveal">
                        <i class="pp-icon pp-i-search" role="img" aria-hidden="true"/>
                        <h3>Photography and floor plans</h3>
                        <p>Professional photos, a video walkthrough and a measured floor plan for every home.</p>
                      </div>
                      <div class="pp-why-item pp-reveal">
                        <i class="pp-icon pp-i-compass" role="img" aria-hidden="true"/>
                        <h3>Listing everywhere buyers look</h3>
                        <p>Our website, the main property portals and our list of registered buyers in your area.</p>
                      </div>
                      <div class="pp-why-item pp-reveal">
                        <i class="pp-icon pp-i-phone" role="img" aria-hidden="true"/>
                        <h3>Accompanied viewings</h3>
                        <p>Your agent shows every buyer around, including evenings and weekends, so you don't have to.</p>
                      </div>
                      <div class="pp-why-item pp-reveal">
                        <i class="pp-icon pp-i-doc" role="img" aria-hidden="true"/>
                        <h3>Negotiation and closing</h3>
                        <p>We vet offers, negotiate on your behalf and work with your attorney until the sale completes.</p>
                      </div>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_fees pp-section" id="fees" data-name="Fee Cards" data-snippet="s_propelle_fees">
                  <div class="pp-container pp-fees">
                    <div class="pp-fees__intro pp-reveal">
                      <p class="pp-eyebrow">Fees</p>
                      <h2 class="pp-title">One fee, agreed up front</h2>
                      <p class="pp-lead">You only pay when your home sells. There's nothing to pay at the start, and no extra charges at closing.</p>
                    </div>
                    <div class="pp-fee-cards">
                      <div class="pp-fee-card pp-reveal">
                        <p class="pp-fee-card__label">Homes and apartments</p>
                        <p class="pp-fee-card__price">2.5%</p>
                        <p class="pp-fee-card__note">of the final sale price, plus applicable tax</p>
                        <ul class="pp-checklist">
                          <li>Everything listed above</li>
                          <li>No upfront or marketing costs</li>
                          <li>Cancel with 14 days' notice</li>
                        </ul>
                      </div>
                      <div class="pp-fee-card pp-reveal">
                        <p class="pp-fee-card__label">Commercial and land</p>
                        <p class="pp-fee-card__price">Quoted</p>
                        <p class="pp-fee-card__note">based on the property and how it's marketed</p>
                        <ul class="pp-checklist">
                          <li>Investor and tenant marketing</li>
                          <li>Lease and yield reports</li>
                          <li>Fee confirmed in writing first</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_sold pp-section pp-section--tint" id="sold" data-name="Recent Sales" data-snippet="s_propelle_sold">
                  <div class="pp-container">
                    <div class="pp-head">
                      <p class="pp-eyebrow">Recently sold</p>
                      <h2 class="pp-title">Some of our recent sales</h2>
                    </div>
                    <div class="pp-dev-grid">
                      <article class="pp-dev pp-reveal">
                        <div class="pp-dev__media">
                          <img src="/theme_propelle/static/src/img/content/1599809275671-b5942cabc7a2.jpg" alt="Villa with a pool and spa at sunset" loading="lazy"/>
                          <span class="pp-availability pp-availability--sold">Sold</span>
                        </div>
                        <div class="pp-dev__body">
                          <h3>Latigo Canyon Road</h3>
                          <p class="pp-dev__loc">Malibu, CA</p>
                          <div class="pp-dev__meta"><span>Sold for <strong>$6,900,000</strong></span><span>103% of asking</span><span>Offer in 12 days</span></div>
                        </div>
                      </article>
                      <article class="pp-dev pp-reveal">
                        <div class="pp-dev__media">
                          <img src="/theme_propelle/static/src/img/content/1512918728675-ed5a9ecdebfd.jpg" alt="Bedroom with a padded headboard and timber floor" loading="lazy"/>
                          <span class="pp-availability pp-availability--sold">Sold</span>
                        </div>
                        <div class="pp-dev__body">
                          <h3>Greenwich Street Apartment</h3>
                          <p class="pp-dev__loc">Tribeca, New York, NY</p>
                          <div class="pp-dev__meta"><span>Sold for <strong>$2,450,000</strong></span><span>101% of asking</span><span>Offer in 9 days</span></div>
                        </div>
                      </article>
                      <article class="pp-dev pp-reveal">
                        <div class="pp-dev__media">
                          <img src="/theme_propelle/static/src/img/content/1600047509358-9dc75507daeb.jpg" alt="Modern family house with a front lawn" loading="lazy"/>
                          <span class="pp-availability pp-availability--sold">Sold</span>
                        </div>
                        <div class="pp-dev__body">
                          <h3>Bouldin Creek House</h3>
                          <p class="pp-dev__loc">Austin, TX</p>
                          <div class="pp-dev__meta"><span>Sold for <strong>$1,180,000</strong></span><span>106% of asking</span><span>Offer in 6 days</span></div>
                        </div>
                      </article>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_reviews pp-section" id="seller-reviews" data-name="Seller Reviews" data-snippet="s_propelle_reviews">
                  <div class="pp-container">
                    <div class="pp-head">
                      <p class="pp-eyebrow">Reviews</p>
                      <h2 class="pp-title">What sellers say</h2>
                    </div>
                    <div class="pp-reviews pp-reviews--feature">
                      <figure class="pp-review pp-reveal">
                        <div class="pp-stars" role="img" aria-label="5 out of 5 stars"><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/></div>
                        <blockquote>“Our apartment sold in eleven days, a little over asking. The staging advice was simple and didn't cost much, which I appreciated.”</blockquote>
                        <figcaption>
                          <img src="/theme_propelle/static/src/img/content/1507003211169-0a1dd7228f2d.jpg" alt="James Whitfield" loading="lazy"/>
                          <div><strong>James Whitfield</strong><span>Sold in Tribeca, 2024</span></div>
                        </figcaption>
                      </figure>
                      <figure class="pp-review pp-reveal">
                        <div class="pp-stars" role="img" aria-label="4 out of 5 stars"><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-i-star" role="img" aria-hidden="true"/><i class="pp-icon pp-icon--sm pp-star--off pp-i-star" role="img" aria-hidden="true"/></div>
                        <blockquote>“The valuation was lower than another agent's, which annoyed me at first. They were right though, and we had two offers in the first week.”</blockquote>
                        <figcaption>
                          <img src="/theme_propelle/static/src/img/content/1472099645785-5658abf4ff4e.jpg" alt="Robert Klein" loading="lazy"/>
                          <div><strong>Robert Klein</strong><span>Sold in Westlake, Austin, 2025</span></div>
                        </figcaption>
                      </figure>
                    </div>
                  </div>
                </section>
                <section class="pp-s s_propelle_valuation pp-section pp-section--tint" id="valuation" data-name="Valuation Form" data-snippet="s_propelle_valuation">
                  <div class="pp-container pp-contact">
                    <div class="pp-contact__info">
                      <p class="pp-eyebrow">Free valuation</p>
                      <h2 class="pp-title">Find out what your home is worth</h2>
                      <p class="pp-lead">Tell us about the property and a local agent will be in touch within one working day to arrange a visit.</p>
                      <ul class="pp-checklist">
                        <li>Written price range based on recent nearby sales</li>
                        <li>Advice on timing and any work worth doing</li>
                        <li>No cost and no obligation to list with us</li>
                      </ul>
                    </div>

                    <form class="pp-contact-form" id="valuation-form" novalidate="">
                      <div class="pp-field">
                        <label for="v-address">Property address</label>
                        <input id="v-address" name="address" type="text" autocomplete="street-address" required=""/>
                        <span class="pp-field__error" aria-live="polite"/>
                      </div>
                      <div class="pp-form-row">
                        <div class="pp-field">
                          <label for="v-city">City</label>
                          <select id="v-city" name="city" data-pp-options="cities" data-pp-all="0">
                            <option value="Malibu">Malibu, CA</option><option value="Miami">Miami, FL</option><option value="New York">New York, NY</option><option value="Austin">Austin, TX</option><option value="Aspen">Aspen, CO</option><option value="San Francisco">San Francisco, CA</option>
                          </select>
                        </div>
                        <div class="pp-field">
                          <label for="v-type">Property type</label>
                          <select id="v-type" name="type">
                            <option value="house">House</option><option value="apartment">Apartment</option><option value="villa">Villa</option><option value="commercial">Commercial</option><option value="land">Land</option>
                          </select>
                        </div>
                      </div>
                      <div class="pp-form-row">
                        <div class="pp-field">
                          <label for="v-beds">Bedrooms</label>
                          <select id="v-beds" name="beds">
                            <option value="1">1</option><option value="2">2</option><option value="3" selected="selected">3</option><option value="4">4</option><option value="5">5 or more</option><option value="0">Not applicable</option>
                          </select>
                        </div>
                        <div class="pp-field">
                          <label for="v-timing">When are you looking to sell?</label>
                          <select id="v-timing" name="timing">
                            <option value="now">As soon as possible</option><option value="3m">In the next 3 months</option><option value="6m">In 3 to 6 months</option><option value="curious">Just curious for now</option>
                          </select>
                        </div>
                      </div>
                      <div class="pp-form-row">
                        <div class="pp-field">
                          <label for="v-name">Name</label>
                          <input id="v-name" name="name" type="text" autocomplete="name" required=""/>
                          <span class="pp-field__error" aria-live="polite"/>
                        </div>
                        <div class="pp-field">
                          <label for="v-email">Email</label>
                          <input id="v-email" name="email" type="email" autocomplete="email" required=""/>
                          <span class="pp-field__error" aria-live="polite"/>
                        </div>
                      </div>
                      <div class="pp-field">
                        <label for="v-phone">Phone <span class="pp-field__optional">(optional)</span></label>
                        <input id="v-phone" name="phone" type="tel" autocomplete="tel"/>
                        <span class="pp-field__error" aria-live="polite"/>
                      </div>
                      <button type="submit" class="pp-btn pp-btn--dark">Continue to choose a time</button>
                      <p class="pp-form-status" id="valuation-status" role="status"/>
                    </form>
                  </div>
                </section>
                <section class="pp-s s_propelle_faq pp-section" id="faq" data-name="FAQ Accordion" data-snippet="s_propelle_faq">
                  <div class="pp-container pp-faq-wrap">
                    <div class="pp-head">
                      <p class="pp-eyebrow">Questions</p>
                      <h2 class="pp-title">Selling FAQs</h2>
                      <p>Something else on your mind? <a class="pp-text-link" href="/contactus">Ask an agent</a></p>
                    </div>
                    <div class="pp-faq">
                      <details>
                        <summary>Is the valuation really free?</summary>
                        <p>Yes. There's no charge and no obligation to sell with us. You'll get a written price range you can keep, whatever you decide.</p>
                      </details>
                      <details>
                        <summary>How do you decide the asking price?</summary>
                        <p>We look at what similar homes nearby have actually sold for in the last six to twelve months, not just what's currently listed, and adjust for condition and features.</p>
                      </details>
                      <details>
                        <summary>Am I tied in to a long contract?</summary>
                        <p>No. Our agreement can be cancelled with 14 days' notice. If a buyer we introduced goes on to purchase within six months, the fee still applies.</p>
                      </details>
                      <details>
                        <summary>Do I need to be home for viewings?</summary>
                        <p>No. Your agent holds a key and shows every buyer around. Many sellers prefer to be out so buyers feel free to look properly.</p>
                      </details>
                      <details>
                        <summary>Can you sell a home that's currently rented?</summary>
                        <p>Yes. We can sell with the tenants in place to an investor, or plan the sale around the end of the lease. We'll talk through both options at the valuation.</p>
                      </details>
                    </div>
                  </div>
                </section>
            </div>
        </t>
    </template>

    <record id="sell_page_page" model="theme.website.page">
        <field name="url">/sell</field>
        <field name="view_id" ref="sell_page"/>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
