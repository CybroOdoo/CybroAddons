<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Contact page of the Propelle theme: the website form of Odoo in the card
    of the design, the offices and the common questions.
-->
<odoo>
    <template id="contactus" name="Propelle Contact Us" inherit_id="website.contactus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="pp-s s_propelle_page_hero pp-hero-plain" aria-labelledby="page-title" data-name="Page Hero" data-snippet="s_propelle_page_hero">
                  <div class="pp-container pp-hero-plain__grid">
                    <div>
                      <nav class="pp-breadcrumb pp-breadcrumb--dark" aria-label="Breadcrumb">
                        <ol>
                          <li><a href="/">Home</a></li>
                          <li aria-current="page">Contact</li>
                        </ol>
                      </nav>
                      <h1 class="pp-hero-plain__title" id="page-title">Contact us</h1>
                      <p class="pp-hero-plain__lead">Call, email or visit one of our six offices. A real person answers the phone, and we reply to every message within one working day.</p>
                      <div class="pp-hero-plain__ctas">
                        <a href="#contact" class="pp-btn pp-btn--dark">Send a Message</a>
                        <a href="#offices" class="pp-btn pp-btn--outline">Find an Office</a>
                      </div>
                    </div>
                    <dl class="pp-hero-plain__stats">
                      <div><dt>Reply time</dt><dd>Same day</dd></div>
                      <div><dt>Offices</dt><dd>6 cities</dd></div>
                      <div><dt>Open</dt><dd>Mon–Sat</dd></div>
                    </dl>
                  </div>
                </section>
                <section class="pp-s s_propelle_contact pp-section pp-section--tight" id="contact" data-name="Contact Form" data-snippet="s_propelle_contact">
                  <div class="pp-container pp-contact-page">
                    <section class="s_website_form pp-form-section" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                      <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_optional pp-contact-form" data-mark="(optional)" data-model_name="crm.lead" data-success-mode="message" data-pre-fill="true">
                        <h2 class="pp-contact-page__form-title">Send us a message</h2>
                        <div class="s_website_form_rows pp-form-rows">
                          <div class="s_website_form_field pp-field s_website_form_required" data-type="char" data-name="Field">
                            <label class="s_website_form_label" for="pp_contact_name"><span class="s_website_form_label_content">Name</span></label>
                            <input id="pp_contact_name" type="text" class="form-control s_website_form_input" name="contact_name" required="" autocomplete="name" data-fill-with="name"/>
                          </div>
                          <div class="s_website_form_field pp-field s_website_form_required" data-type="email" data-name="Field">
                            <label class="s_website_form_label" for="pp_contact_email"><span class="s_website_form_label_content">Email</span></label>
                            <input id="pp_contact_email" type="email" class="form-control s_website_form_input" name="email_from" required="" autocomplete="email" data-fill-with="email"/>
                          </div>
                          <div class="s_website_form_field pp-field" data-type="tel" data-name="Field">
                            <label class="s_website_form_label" for="pp_contact_phone"><span class="s_website_form_label_content">Phone</span><span class="s_website_form_mark pp-field__optional"> (optional)</span></label>
                            <input id="pp_contact_phone" type="tel" class="form-control s_website_form_input" name="phone" autocomplete="tel" data-fill-with="phone"/>
                          </div>
                          <div class="s_website_form_field pp-field s_website_form_custom" data-type="char" data-name="Field">
                            <label class="s_website_form_label" for="pp_contact_office"><span class="s_website_form_label_content">Nearest office</span></label>
                            <select id="pp_contact_office" class="form-select s_website_form_input" name="Nearest office">
                              <option value="Malibu">Malibu</option><option value="Miami">Miami</option><option value="New York">New York</option><option value="Austin">Austin</option><option value="Aspen">Aspen</option><option value="San Francisco">San Francisco</option>
                            </select>
                          </div>
                          <div class="s_website_form_field pp-field pp-field--full s_website_form_model_required" data-type="char" data-name="Field">
                            <label class="s_website_form_label" for="pp_contact_interest"><span class="s_website_form_label_content">I'm interested in</span></label>
                            <select id="pp_contact_interest" class="form-select s_website_form_input" name="name" required="">
                              <option value="Buying a property">Buying a property</option>
                              <option value="Renting a property">Renting a property</option>
                              <option value="Selling or letting my property">Selling or letting my property</option>
                              <option value="New developments">New developments</option>
                            </select>
                          </div>
                          <div class="s_website_form_field pp-field pp-field--full s_website_form_required" data-type="text" data-name="Field">
                            <label class="s_website_form_label" for="pp_contact_message"><span class="s_website_form_label_content">Message</span></label>
                            <textarea id="pp_contact_message" class="form-control s_website_form_input" name="description" required="" rows="5"/>
                          </div>
                          <div class="s_website_form_submit pp-field--full" data-name="Submit Button">
                            <div class="s_website_form_label"/>
                            <a href="#" role="button" class="btn btn-primary s_website_form_send pp-btn pp-btn--dark">Send message</a>
                            <span id="s_website_form_result"/>
                          </div>
                        </div>
                      </form>
                      <div class="s_website_form_end_message d-none">
                        <div class="pp-contact-form pp-form-done">
                          <h3>Thanks for your message.</h3>
                          <p>We'll get back to you within one working day.</p>
                        </div>
                      </div>
                    </section>

                    <aside class="pp-ct-aside">
                      <h2 class="pp-ct-aside__title">Other ways to reach us</h2>
                      <ul class="pp-ct-methods">
                        <li><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/><div><small>Call the Malibu office</small><a href="tel:+13105550148">+1 (310) 555-0148</a></div></li>
                        <li><i class="pp-icon pp-icon--sm pp-i-mail" role="img" aria-hidden="true"/><div><small>Email</small><a href="mailto:hello@propelle.com">hello@propelle.com</a></div></li>
                        <li><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/><div><small>Head office</small><span>22801 Pacific Coast Hwy, Malibu, CA 90265</span></div></li>
                      </ul>
                      <div class="pp-ct-hours">
                        <h3>Office hours</h3>
                        <dl class="pp-hours">
                          <div><dt>Monday to Friday</dt><dd>9am – 6pm</dd></div>
                          <div><dt>Saturday</dt><dd>10am – 4pm</dd></div>
                          <div><dt>Sunday</dt><dd>Viewings by appointment</dd></div>
                        </dl>
                      </div>
                      <p class="pp-ct-aside__note">Your message goes to the office you choose. An agent there replies, usually the same day, and stays your contact from then on.</p>
                    </aside>
                  </div>
                </section>
                <section class="pp-s s_propelle_offices pp-section pp-section--tint" id="offices" data-name="Offices" data-snippet="s_propelle_offices">
                  <div class="pp-container">
                    <div class="pp-head">
                      <h2 class="pp-title">Our offices</h2>
                    </div>
                    <ul class="pp-ab-offices">
                      <li class="pp-reveal">
                        <h3>Malibu</h3>
                        <span class="pp-ab-offices__focus">Head office</span>
                        <a class="pp-ab-offices__addr" href="https://www.google.com/maps/search/?api=1&amp;query=22801%20Pacific%20Coast%20Hwy%2C%20Malibu%2C%20CA%2090265" target="_blank" rel="noopener"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 22801 Pacific Coast Hwy, Malibu, CA 90265</a>
                        <a class="pp-ab-offices__phone" href="tel:+13105550148"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (310) 555-0148</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>Miami</h3>
                        <span class="pp-ab-offices__focus">Sales and rentals</span>
                        <a class="pp-ab-offices__addr" href="https://www.google.com/maps/search/?api=1&amp;query=1101%20Brickell%20Ave%2C%20Suite%20400%2C%20Miami%2C%20FL%2033131" target="_blank" rel="noopener"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 1101 Brickell Ave, Suite 400, Miami, FL 33131</a>
                        <a class="pp-ab-offices__phone" href="tel:+13055550192"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (305) 555-0192</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>New York</h3>
                        <span class="pp-ab-offices__focus">New developments</span>
                        <a class="pp-ab-offices__addr" href="https://www.google.com/maps/search/?api=1&amp;query=74%20Franklin%20St%2C%203rd%20Floor%2C%20New%20York%2C%20NY%2010013" target="_blank" rel="noopener"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 74 Franklin St, 3rd Floor, New York, NY 10013</a>
                        <a class="pp-ab-offices__phone" href="tel:+12125550117"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (212) 555-0117</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>Austin</h3>
                        <span class="pp-ab-offices__focus">Family homes</span>
                        <a class="pp-ab-offices__addr" href="https://www.google.com/maps/search/?api=1&amp;query=3700%20Bee%20Cave%20Rd%2C%20Austin%2C%20TX%2078746" target="_blank" rel="noopener"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 3700 Bee Cave Rd, Austin, TX 78746</a>
                        <a class="pp-ab-offices__phone" href="tel:+15125550163"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (512) 555-0163</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>Aspen</h3>
                        <span class="pp-ab-offices__focus">Seasonal rentals</span>
                        <a class="pp-ab-offices__addr" href="https://www.google.com/maps/search/?api=1&amp;query=520%20E%20Durant%20Ave%2C%20Aspen%2C%20CO%2081611" target="_blank" rel="noopener"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 520 E Durant Ave, Aspen, CO 81611</a>
                        <a class="pp-ab-offices__phone" href="tel:+19705550184"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (970) 555-0184</a>
                      </li>
                      <li class="pp-reveal">
                        <h3>San Francisco</h3>
                        <span class="pp-ab-offices__focus">Commercial</span>
                        <a class="pp-ab-offices__addr" href="https://www.google.com/maps/search/?api=1&amp;query=1455%203rd%20St%2C%20San%20Francisco%2C%20CA%2094158" target="_blank" rel="noopener"><i class="pp-icon pp-icon--sm pp-i-pin" role="img" aria-hidden="true"/> 1455 3rd St, San Francisco, CA 94158</a>
                        <a class="pp-ab-offices__phone" href="tel:+14155550139"><i class="pp-icon pp-icon--sm pp-i-phone" role="img" aria-hidden="true"/> +1 (415) 555-0139</a>
                      </li>
                    </ul>
                  </div>
                </section>
                <section class="pp-s s_propelle_faq pp-section" id="faq" data-name="FAQ Accordion" data-snippet="s_propelle_faq">
                  <div class="pp-container pp-faq-wrap">
                    <div class="pp-head">
                      <h2 class="pp-title">Common questions</h2>
                      <p>Can't find an answer? Send us a message above.</p>
                    </div>
                    <div class="pp-faq">
                      <details>
                        <summary>How quickly will someone reply?</summary>
                        <p>Within one working day, and usually the same day. Messages sent on Sunday are answered on Monday morning.</p>
                      </details>
                      <details>
                        <summary>Can I book a viewing outside office hours?</summary>
                        <p>Yes. Our agents run evening and weekend viewings by appointment. Mention the times that suit you in your message.</p>
                      </details>
                      <details>
                        <summary>Do you offer video calls?</summary>
                        <p>Yes. Any agent can walk you through a home or talk through a sale on a video call. Just ask when you get in touch.</p>
                      </details>
                      <details>
                        <summary>Which office should I contact?</summary>
                        <p>The one nearest the property you're interested in. If you're not sure, contact Malibu and we'll pass your message to the right team.</p>
                      </details>
                    </div>
                  </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
