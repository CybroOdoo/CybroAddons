<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="db_backup_history_view_list" model="ir.ui.view">
        <field name="name">db.backup.history.view.list</field>
        <field name="model">db.backup.history</field>
        <field name="arch" type="xml">
            <list string="Backup History" create="false"
                  decoration-success="status == 'success'"
                  decoration-danger="status == 'failed'">
                <field name="backup_date"/>
                <field name="configure_id"/>
                <field name="db_name"/>
                <field name="name"/>
                <field name="backup_destination"/>
                <field name="duration" widget="float_time" optional="show"/>
                <field name="is_manual" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="db_backup_history_view_form" model="ir.ui.view">
        <field name="name">db.backup.history.view.form</field>
        <field name="model">db.backup.history</field>
        <field name="arch" type="xml">
            <form string="Backup History" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="configure_id"/>
                            <field name="db_name"/>
                            <field name="backup_date"/>
                            <field name="backup_destination"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="is_manual"/>
                            <field name="duration" widget="float_time"/>
                            <field name="name"/>
                        </group>
                    </group>
                    <group string="Message"
                           invisible="not message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="db_backup_history_action" model="ir.actions.act_window">
        <field name="name">Backup History</field>
        <field name="res_model">db.backup.history</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No backups have run yet!
            </p>
        </field>
    </record>

    <menuitem id="db_backup_history_menu" parent="db_backup_menu_root"
              name="Backup History" action="db_backup_history_action"
              sequence="20"
              groups="auto_database_backup.group_auto_database_backup_manager"/>
</odoo>
