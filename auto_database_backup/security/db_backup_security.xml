<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Module category for the Automatic Database Backup access group -->
    <record id="module_category_auto_database_backup"
            model="ir.module.category">
        <field name="name">Automatic Database Backup</field>
        <field name="description">Manage automatic database backup
            configurations.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_auto_database_backup_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_auto_database_backup"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Users in this group can configure and manage
            automatic database backups, including their credentials and
            secrets.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_auto_database_backup_manager'))]"/>
    </record>
</odoo>
