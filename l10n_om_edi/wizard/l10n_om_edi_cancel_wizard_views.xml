<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_l10n_om_edi_cancel_wizard_form" model="ir.ui.view">
        <field name="name">l10n.om.edi.cancel.wizard.form</field>
        <field name="model">l10n.om.edi.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Oman E-Invoicing Document">
                <group>
                    <field name="document_id" invisible="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="button_confirm_cancel" string="Confirm Cancellation" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_om_edi_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Oman E-Invoicing Document</field>
        <field name="res_model">l10n.om.edi.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
