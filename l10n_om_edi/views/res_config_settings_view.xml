<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_om_edi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='peppol']" position="after">
                <block title="Oman E-Invoicing (Fawtara)" id="l10n_om_edi_settings" invisible="country_code != 'OM'">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_right_pane border-0">
                            <div class="text-muted oe_inline mb-3">
                                Oman's e-invoicing mandate requires routing through an Accredited Service
                                Provider (ASP) chosen via the Fawtara Portal. The configuration fields shown
                                below depend on the selected ASP - each connector declares only what that
                                vendor's own documentation confirms it needs.
                            </div>
                            <div class="row">
                                <label string="ASP Provider" for="l10n_om_edi_asp_provider" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_provider"/>
                            </div>

                            <field name="l10n_om_edi_asp_required_config" invisible="1"/>
                            <field name="l10n_om_edi_asp_config_status" invisible="1"/>
                            <field name="l10n_om_edi_asp_ota_accredited" invisible="1"/>

                            <div class="row">
                                <label string="API Base URL" for="l10n_om_edi_asp_base_url" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_base_url"/>
                            </div>

                            <div class="row" invisible="not l10n_om_edi_asp_required_config or 'client_id' not in l10n_om_edi_asp_required_config">
                                <label string="Client ID" for="l10n_om_edi_asp_client_id" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_client_id"/>
                            </div>
                            <div class="row" invisible="not l10n_om_edi_asp_required_config or 'client_secret' not in l10n_om_edi_asp_required_config">
                                <label string="Client Secret" for="l10n_om_edi_asp_client_secret" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_client_secret" password="True"/>
                            </div>
                            <div class="row" invisible="not l10n_om_edi_asp_required_config or 'api_key' not in l10n_om_edi_asp_required_config">
                                <label string="API Key" for="l10n_om_edi_asp_api_key" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_api_key" password="True"/>
                            </div>
                            <div class="row" invisible="not l10n_om_edi_asp_required_config or 'username' not in l10n_om_edi_asp_required_config">
                                <label string="Username" for="l10n_om_edi_asp_username" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_username"/>
                            </div>
                            <div class="row" invisible="not l10n_om_edi_asp_required_config or 'password' not in l10n_om_edi_asp_required_config">
                                <label string="Password" for="l10n_om_edi_asp_password" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_password" password="True"/>
                            </div>
                            <div class="row" invisible="not l10n_om_edi_asp_required_config or 'certificate_id' not in l10n_om_edi_asp_required_config">
                                <label string="Client Certificate" for="l10n_om_edi_asp_certificate_id" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_certificate_id"/>
                            </div>
                            <div class="row" invisible="not l10n_om_edi_asp_required_config or 'account_id' not in l10n_om_edi_asp_required_config">
                                <label string="Account / Tenant / Company ID" for="l10n_om_edi_asp_account_id" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_account_id"/>
                            </div>
                            <div class="row" invisible="not l10n_om_edi_asp_required_config or 'redirect_url' not in l10n_om_edi_asp_required_config">
                                <label string="OAuth Redirect URL" for="l10n_om_edi_asp_redirect_url" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_asp_redirect_url"/>
                            </div>

                            <div class="row">
                                <label string="Environment" for="l10n_om_edi_environment" class="col-lg-3 o_light_label"/>
                                <field name="l10n_om_edi_environment"/>
                            </div>

                            <div class="row mt-2" invisible="not l10n_om_edi_asp_provider">
                                <div class="col-lg-9 offset-lg-3">
                                    <button name="action_l10n_om_edi_test_connection" type="object"
                                            string="Test Connection" class="btn-secondary"/>
                                    <div class="text-muted mt-1">
                                        Currently supported for Flick Network only. Other providers
                                        will clearly state this feature isn't available yet.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
