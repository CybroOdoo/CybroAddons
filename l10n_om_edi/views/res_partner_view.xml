<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit_l10n_om_edi" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n_om_edi</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_om_cr_number" invisible="'OM' not in fiscal_country_codes" placeholder="1234567" readonly="parent_id"/>
            </xpath>
            <xpath expr="//field[@name='street2']" position="after">
                <field name="l10n_om_address_line3" invisible="'OM' not in fiscal_country_codes" placeholder="Address line 3"/>
            </xpath>
        </field>
    </record>
</odoo>
