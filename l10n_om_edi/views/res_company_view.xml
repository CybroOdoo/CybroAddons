<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_l10n_om_edi" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_om_edi</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="l10n_om_cr_number" invisible="country_code != 'OM'" placeholder="1234567"/>
                <field name="l10n_om_edi_asp_provider" invisible="country_code != 'OM'"/>
            </xpath>
            <xpath expr="//field[@name='street2']" position="after">
                <field name="l10n_om_address_line3" invisible="country_code != 'OM'" placeholder="Address line 3"/>
            </xpath>
        </field>
    </record>
</odoo>
