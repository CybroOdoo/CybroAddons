<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="personal_organiser.task">
        <div>
            <div>
                <h2 class="text-center m-0">Tasks</h2>
                <div>
                    <input type="text"
                           t-model.proxy="this.state.newTask"
                           class="mt-2 form-control"
                           placeholder="Add a new task"
                           required="True"/>
                    <input type="date"
                           t-model.proxy="this.state.date"
                           class="form-control mt-2"
                           placeholder="Date"
                           required="True"/>
                    <button t-on-click="this.addTask"
                            class="btn btn-primary mt-2"
                            t-att-disabled="!(this.state.newTask and this.state.date)">
                        Create
                    </button>
                </div>
                <div class="o_po_task_list mt-3">
                    <t t-foreach="this.state.tasks" t-as="task" t-key="task.id">
                        <div>
                            <div class="card o_po_task_card">
                                <div class="card-body p-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <textarea
                                            class="form-control"
                                            t-att-value="task.task_title"
                                            t-on-change="(event) => this.onInputChange(event, task, 'task_title')"
                                        />
                                    </div>
                                    <div class="d-flex justify-content-between align-items-start">
                                        <input type="date"
                                               class="form-control"
                                               t-att-value="task.date"
                                               t-on-change="(event) => this.onInputChange(event, task, 'date')"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-end">
                                        <button class="btn btn-sm"
                                                t-on-click="() => this.deleteTask(task)">
                                            <img src="/personal_organiser/static/src/img/bin.png"
                                                 alt="Delete"
                                                 aria-label="Delete"
                                                 class="o_po_bin_icon"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
