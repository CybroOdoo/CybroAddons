<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="personal_organiser.orgcontacts">
        <div>
           <div class="align-items-center mb-4">
               <h2 class="text-center mb-0">Contacts</h2>
                <!-- Create Contact Button -->
                    <button class="btn btn-primary mt-2" t-on-click="this.toggleInputFields">
                        <t t-if="!this.state.showInputFields">Create new contact</t>
                        <t t-else="">Cancel</t>
                    </button>
                <!-- Contacts Heading with flex-grow -->
           </div>
           <div t-if="this.state.showInputFields" class="mt-3 o_po_contact_form">
                <input type="text" class="form-control" placeholder="Name" t-model.proxy="this.state.name" />
                <input type="email" class="form-control" placeholder="Email" t-model.proxy="this.state.email" />
                <button class="btn btn-success" t-on-click="this.createContact"
                        t-att-disabled="!(this.state.name and this.state.email)">
                    Save
                </button>
           </div>
           <!--show contacts as cards-->
           <div>
                <div class="mt-2 o_po_contact_list">
                    <t t-foreach="this.state.contacts" t-as="contact"
                       t-key="contact.id"
                       class="list-group-item d-flex
                                 justify-content-between align-items-center">
                       <div class="card mb-2">
                            <div class="card-body align-items-center text-wrap">
                                <h5 class="mb-1 ps-1">
                                    <a t-att-href="'/odoo/res.partner/' + contact.id"
                                       t-out="contact.name"
                                       class="text-decoration-none"
                                       target="_blank">
                                    </a>
                                    <div t-if="contact.email" class="small text-body-secondary" t-out="contact.email"/>
                                </h5>
                            </div>
                       </div>
                    </t>
                </div>
           </div>
        </div>
    </t>
</templates>
