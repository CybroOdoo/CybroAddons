<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="personal_organiser.mini_calendar">
        <div class="mini-calendar">
            <div class="calendar-header">
                <h3>
                    <t t-out="this.currentDate.toLocaleString('default', { month: 'long' }) + ' ' + this.currentDate.getFullYear()"/>
                </h3>
            </div>
            <div class="calendar-days">
                <t t-if="this.state.daysInMonth.length > 0">
                    <t t-foreach="this.state.daysInMonth" t-as="day" t-key="day.date.getTime()">
                        <div
                            class="calendar-day"
                            t-att-class="day.hasEvent ? 'calendar-event' : ''"
                            t-on-click="() => this.selectDay(day)"
                        >
                            <t t-out="day.date.getDate()"/>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <p>No days to display.</p>
                </t>
            </div>
        </div>

        <!-- Display events for the selected day -->
        <t t-if="this.state.selectedDayEvents.length > 0">
            <div class="events-list">
                <br/>
                <h4>Events on <t t-out="this.state.selectedDate.toLocaleDateString()"/></h4>
                <div class="event-cards">
                    <t t-foreach="this.state.selectedDayEvents" t-as="event" t-key="event.id">
                        <div class="card mb-2">
                            <div class="card-body">
                                <h5 class="card-title" t-out="event.name"/>
                                <small class="text-muted" t-out="new Date(event.start_date).toLocaleDateString()"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
        <t t-else="">
            <p><br/>No events for this day.</p>
        </t>
    </t>
</templates>
