<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="personal_organiser.sidebar">
        <div class="sidebar_panel">
            <div class="sidebar transparent-sidebar">
                <div class="container-fluid">
                    <div class="row flex-nowrap">
                        <div class="d-flex flex-column align-items-left align-items-sm-start px-3 pt-2 text-white min-vh-100">
                            <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-left align-items-sm-start sidebar_menu"
                                id="menu">
                                <li class="nav-item">
                                    <a href="#" class="nav-link py-3 border-bottom"
                                       title="Tasks"
                                       t-on-click.prevent="() => this.showNewSidebar('task')">
                                        <img src="/personal_organiser/static/src/img/checklist.png" alt="Tasks"/>
                                        <span class="badge bg-danger" t-if="this.state.todaysTasks.length > 0">
                                            <t t-out="this.state.todaysTasks.length"/>
                                        </span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="#" class="nav-link py-3 border-bottom" title="Notes"
                                       t-on-click.prevent="() => this.showNewSidebar('note')">
                                        <img src="/personal_organiser/static/src/img/note-taking.png"
                                             alt="Notes"/>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="#" class="nav-link py-3 border-bottom" title="Calendar"
                                       t-on-click.prevent="() => this.showNewSidebar('calender')">
                                        <img src="/personal_organiser/static/src/img/weekend.png" alt="Calendar"/>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="#" class="nav-link py-3 border-bottom" title="Contacts"
                                       t-on-click.prevent="() => this.showNewSidebar('contacts')">
                                        <img src="/personal_organiser/static/src/img/support.png" alt="Contacts"/>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Task -->
        <div class="task o_po_panel" id="task" t-att-class="{'d-none': this.state.activePanel !== 'task'}">
                <button t-on-click="() => this.closePanel('task')"
                        class="btn btn-secondary mb-3 position-absolute o_po_close"
                        title="Close" aria-label="Close">
                    <i class="oi" data-icon="close"></i>
                </button>
            <div id="taskContent"><PersonalOrganizer/></div>
        </div>

        <!-- Note Maker -->
        <div class="note o_po_panel" id="note" t-att-class="{'d-none': this.state.activePanel !== 'note'}">
                <button t-on-click="() => this.closePanel('note')"
                        class="btn btn-secondary mb-3 position-absolute o_po_close"
                        title="Close" aria-label="Close">
                    <i class="oi" data-icon="close"></i>
                </button>
            <div id="noteContent"><NoteMaker/></div>
        </div>

        <!-- Contacts -->
        <div class="contacts o_po_panel" id="contacts" t-att-class="{'d-none': this.state.activePanel !== 'contacts'}">
                <button t-on-click="() => this.closePanel('contacts')"
                        class="btn btn-secondary mb-3 position-absolute o_po_close"
                        title="Close" aria-label="Close">
                    <i class="oi" data-icon="close"></i>
                </button>
            <div id="contactsContent"><OrgContacts/></div>
        </div>

        <!-- Calendar -->
        <div class="calender o_po_panel" id="calender" t-att-class="{'d-none': this.state.activePanel !== 'calender'}">
                <button t-on-click="() => this.closePanel('calender')"
                        class="btn btn-secondary mb-3 position-absolute o_po_close"
                        title="Close" aria-label="Close">
                    <i class="oi" data-icon="close"></i>
                </button>
            <div id="calenderContent">
                     <MiniCalendar/>
                </div>
        </div>
    </t>
</templates>
