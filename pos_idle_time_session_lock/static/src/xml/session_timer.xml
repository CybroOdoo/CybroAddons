<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_idle_time_session_lock.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'status-buttons')]" position="inside">
            <div t-if="this.pos?.config?.pos_lock and this.timerState?.time"
                 class="pos-timer d-flex align-items-center px-2 fw-bold text-muted small">
                <i class="oi oi-fw me-1" data-icon="schedule"/>
                <t t-out="this.timerState.time"/>
            </div>
        </xpath>
    </t>
</templates>
