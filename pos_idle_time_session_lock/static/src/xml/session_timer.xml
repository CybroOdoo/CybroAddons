<?xml version="1.0" encoding="UTF-8"?>
<!--Added time fields in the navbar.-->
<templates id="template" xml:space="preserve">
    <t t-name="pos_idle_time_session_lock.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension" owl="1">
            <xpath expr="//div[@class='status-buttons d-flex flex-grow-1 flex-basis-0 justify-content-end h-100']"
                   position="inside">
                <span id="times" t-ref="root"/>
                <t t-esc="this.timerState.time"/>
        </xpath>
    </t>
</templates>
