<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Offline Sales Navigation Configuration
        This file defines the URL action and menu structure used to access
        the Offline Sales application.-->
    <record id="action_offline_sale_ui" model="ir.actions.act_url">
        <field name="name">Offline Sales UI</field>
        <field name="url">/offline_sale/ui</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_offline_sale_hidden_root" 
              name="Offline Terminal" 
              parent="base.menu_administration"
              groups="base.group_no_one"
              sequence="100"/>

    <menuitem id="menu_offline_sale_ui" 
              name="Open Sales Interface" 
              parent="menu_offline_sale_hidden_root"
              action="action_offline_sale_ui"
              sequence="10"/>
</odoo>
