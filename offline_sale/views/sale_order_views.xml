<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Offline Reference field to the Sales Order form view -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.offline.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="offline_uid" readonly="1" invisible="not offline_uid"/>
            </xpath>
        </field>
    </record>
    <!-- Add Offline Reference field to the Sales Order search view -->
    <record id="view_sales_order_filter" model="ir.ui.view">
        <field name="name">sale.order.view.search.inherit.offline</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="offline_uid" string="Offline Reference"/>
            </xpath>
        </field>
    </record>
    <!-- Add Offline Reference column to the Sales Order tree view -->
    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="name">sale.order.view.tree.inherit.offline</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="offline_uid" optional="show" string="Offline ID"/>
            </xpath>
        </field>
    </record>
</odoo>
