<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!--Offline Sales Systray Button Template
        This template renders the Offline Sales shortcut icon in the Odoo
        systray. Clicking the icon opens the Offline Sales Terminal in a
        new browser tab, allowing users to access offline sales functionality
        without interrupting their current Odoo session-->
    <t t-name="offline_sale.SystrayButton" owl="1">
        <div class="o_offline_sale_systray_item cursor-pointer flex items-center px-3 hover:bg-gray-100 transition-colors h-100" 
             t-on-click="on_click" title="Go to Offline Sales Terminal">
            <span class="material-symbols-outlined text-[20px] text-[#004f45]">cloud_off</span>
        </div>
    </t>
</templates>
