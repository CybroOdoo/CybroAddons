<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_offline_receipt" model="mail.template">
            <field name="name">Offline Sale: Transaction Receipt</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Transaction Receipt - {{ object.offline_uid or '' }}</field>
            <field name="email_to">{{ ctx.get('email_to') or '' }}</field>
            <field name="body_html" type="html">
                <p>Dear Customer,</p>
                <p>Please find attached your transaction receipt for order <strong><t t-out="object.offline_uid or ''"/></strong>.</p>
                <p>Thank you for your business!</p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
