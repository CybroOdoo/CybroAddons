<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List, form, kanban, calendar view action for class.type -->
    <record id="class_type_action" model="ir.actions.act_window">
        <field name="name">Class</field>
        <field name="res_model">class.type</field>
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>

    <!-- Music school menu creation -->
    <menuitem id="music_school_institute_menu_root" name="Music School"
              web_icon="music_school_institute,static/description/icon.png"
              action="class_type_action"/>

    <!-- Class menu creation -->
    <menuitem
            id="class_type_menu_class_creation"
            name="Class"
            action="class_type_action"
            sequence="1"
            parent="music_school_institute_menu_root"/>

    <!-- Form view defined for class.type -->
    <record id="class_type_view_form" model="ir.ui.view">
        <field name="name">class.type.view.form</field>
        <field name="model">class.type</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_button_class_start" string="Start"
                            type="object" invisible="state != 'draft'"
                            class="btn btn-primary"
                            groups="music_school_institute.group_music_school_manager"/>
                    <button name="action_button_class_cancel" string="Cancel"
                            type="object" invisible="state not in ('draft', 'started')"
                            class="btn btn-secondary"
                            groups="music_school_institute.group_music_school_manager"/>
                    <button name="action_button_set_to_draft" string="Set to Draft"
                            type="object" invisible="state != 'canceled'"
                            class="btn btn-primary"
                            groups="music_school_institute.group_music_school_manager"/>
                    <button name="action_button_class_completed" string="Mark As Done"
                            type="object" invisible="state != 'started'"
                            class="btn btn-primary"
                            groups="music_school_institute.group_music_school_manager"/>
                    <button name="action_button_create_order" string="Invoice"
                            type="object" invisible="state != 'completed'"
                            class="btn btn-primary"
                            groups="music_school_institute.group_music_school_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="related_order" icon="edit_square">
                            <field string="Invoice" name="order_count"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="duration"/>
                            <field name="service_id"/>
                            <field name="instrument_id"
                                   context="{'default_music_instrument': True}"/>
                            <field name="teacher_id"
                                   context="{'default_teacher': True}"/>
                            <field name="location"/>
                            <field name="student_ids" widget="many2many_tags"
                                   context="{'default_student': True}"/>
                            <field name="repeats"/>
                        </group>
                        <group invisible="repeats != 'weekly'">
                            <field name="sunday"/>
                            <field name="monday"/>
                            <field name="tuesday"/>
                            <field name="wednesday"/>
                            <field name="thursday"/>
                            <field name="friday"/>
                            <field name="saturday"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lessons" name="Lessons">
                            <field name="lesson_ids" widget="one2many">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="hours"/>
                                    <field name="teacher_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view defined for class.type -->
    <record id="class_type_view_list" model="ir.ui.view">
        <field name="name">class.type.view.list</field>
        <field name="model">class.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="service_id"/>
                <field name="instrument_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Calendar view defined for class.type -->
    <record id="class_type_view_calendar" model="ir.ui.view">
        <field name="name">class.type.view.calendar</field>
        <field name="model">class.type</field>
        <field name="arch" type="xml">
            <calendar string="Class Scheduled" date_start="from_date"
                      color="instrument_id" mode="month"
                      quick_create="0"
                      event_open_popup="true">
                <field name="name"/>
                <field name="teacher_id"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban view defined for class.type -->
    <record id="class_type_view_kanban" model="ir.ui.view">
        <field name="name">class.type.view.kanban</field>
        <field name="model">class.type</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <span>Class:</span>
                                <field name="name"/>
                            </strong>
                            <div>
                                <span>Service:</span>
                                <field name="service_id"/>
                                <div>
                                    <span>From date:</span>
                                    <field name="from_date"/>
                                </div>
                                <div>
                                    <span>To date:</span>
                                    <field name="to_date"/>
                                </div>
                                <div>
                                    <field name="instrument_id"/>
                                </div>
                                <div>
                                    <span>Teacher:</span>
                                    <field name="teacher_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
