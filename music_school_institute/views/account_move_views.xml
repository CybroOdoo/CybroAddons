<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <!--This view extension adds the Class field to the account move formto link an invoice with its related
        music class.-->
        <field name="name">account.move.view.form.inherit.music.school.management</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auto_post']"
                   position="before">
                <field name="class_id"/>
            </xpath>
        </field>
    </record>
</odoo>
