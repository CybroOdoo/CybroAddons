<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Category for Music School -->
        <record id="module_category_music_school" model="ir.module.category">
            <field name="name">Music School</field>
            <field name="sequence">20</field>
        </record>

        <!-- Privilege for Music School -->
        <record id="group_music_school" model="res.groups.privilege">
            <field name="name">Music School</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_music_school"/>
        </record>

        <!-- User Group -->
        <record id="group_music_school_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="group_music_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- School Manager Group -->
        <record id="group_music_school_manager" model="res.groups">
            <field name="name">School Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="group_music_school"/>
            <field name="implied_ids" eval="[(4, ref('group_music_school_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
