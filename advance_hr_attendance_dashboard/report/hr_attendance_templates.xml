<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- QWeb template used to generate the HR Attendance PDF report -->
    <template id="report_hr_attendance">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Attendance Report</h2>
                    <p class="text-muted">Printed on: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/></p>
                    <table class="table mt-3">
                        <div t-raw="data['tHead']"/>
                        <div t-raw="data['tBody']"/>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
