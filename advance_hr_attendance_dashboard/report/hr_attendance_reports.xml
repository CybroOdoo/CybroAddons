<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <!-- Paper format configuration for HR Attendance Report in landscape orientation -->
    <record id="paperformat_hr_attendance_report" model="report.paperformat">
        <field name="name">HR Attendance Report</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">65</field>
        <field name="margin_bottom">23</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">60</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report action for HR Attendance PDF report -->
    <record id="action_report_hr_attendance" model="ir.actions.report">
        <field name="name">Attendance Report</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advance_hr_attendance_dashboard.report_hr_attendance</field>
        <field name="report_file">advance_hr_attendance_dashboard.report_hr_attendance</field>
        <field name="paperformat_id" ref="advance_hr_attendance_dashboard.paperformat_hr_attendance_report"/>
    </record>
</odoo>
