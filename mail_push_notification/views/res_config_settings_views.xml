<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inheriting the config setting and add the fields for connecting to Firebase -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail.push.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Push Notification From ChatBox"
                     string="Push Notification From ChatBox"
                     name="mail_push_notification">
                    <block title="Push Notification From ChatBox" name="mail_push_notification_setting_container">
                        <setting id="firebase_setting" help="Enable push notifications for chatter messages">
                            <field name="push_notification"/>
                            <div class="content-group" invisible="not push_notification">
                                <div class="row mt16">
                                    <label for="project_id_firebase" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="project_id_firebase" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="private_key_ref" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="private_key_ref" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="private_key" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="private_key" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="client_email" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="client_email" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="client_id_firebase" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="client_id_firebase" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="client_cert_url" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="client_cert_url" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="api_key" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="api_key" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="auth_domain" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="auth_domain" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="storage_bucket" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="storage_bucket" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="messaging_sender_id_firebase" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="messaging_sender_id_firebase" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="app_id_firebase" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="app_id_firebase" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="measurement_id_firebase" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="measurement_id_firebase" required="push_notification" password="1"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vapid" class="col-4 col-lg-3 o_light_label"/>
                                    <field name="vapid" required="push_notification" password="1"/>
                                </div>
                                <div class="mt16">
                                    <button name="test_connection" string="Test Connection" type="object" class="btn-primary"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
