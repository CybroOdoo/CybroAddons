<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--website pdf preview form template-->
    <template id="pdf_preview" name="PDF Preview">
        <section class="pdf_review_snippet py-5"
                 style="background-image: url(&quot;/web/image/website.s_quotes_carousel_demo_image_0&quot;);
                 background-position: 50% 50%; min-height: 438px;">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-8 text-center">
                        <h1 class="mb-4">
                            <b>Select Your Document Here</b>
                        </h1>
                        <form action="/file/uploaded/" method="post" id="file_upload_form"
                              enctype="multipart/form-data">
                            <div class="mb-3">
                                <label for="upload" class="col-form-label">Choose a PDF</label>
                                <input id="upload" name="attachment" class="form-control" accept="application/pdf"
                                       type="file" required="required"/>
                            </div>
                            <button name="click_btn" type="submit" class="btn btn-info mt-3">Preview</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!--    Alert template-->
    <template id="upload_error_template">
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong>
            Only PDF files are allowed.
        </div>
    </template>
    <!--Snippet View-->
    <template id="pdf_preview_snippet_inherit" inherit_id="website.snippets">
        <!-- Create the custom group -->
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t snippet-group="pdf_preview_group" t-snippet="website.s_snippet_group" string="PDF Preview"
               t-thumbnail="/website_pdf_preview_snippet/static/src/img/snippets/pdf-logo.png"/>
        </xpath>
        <!-- Add the actual PDF preview snippet -->
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="website_pdf_preview_snippet.pdf_preview" string="PDF Preview Snippet"
               group="pdf_preview_group"
               t-thumbnail="/website_pdf_preview_snippet/static/src/img/snippets/pdf-logo.png"/>
        </xpath>
    </template>
</odoo>
