<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        View: pos.order.form.inherit.mrp
        Model: pos.order
        Description: Adds a smart button linking to the generated Manufacturing Orders.
    -->
    <record id="pos_order_form_inherit_pos_mrp" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.mrp</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mrp_production"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-wrench"
                    groups="mrp.group_mrp_user"
                    invisible="mrp_production_count == 0">
                    <field name="mrp_production_count" widget="statinfo" string="Manufacturing"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
