<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add POS Manufacturing configuration fields. -->
    <record id="product_template_form_view_inherit_pos_mrp" model="ir.ui.view">
        <field name="name">product.template.form.inherit.mrp.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']/group[@name='sale']/group[@name='pos']"
                position="inside">
                <field name="to_create_mrp"/>
                <field name="create_mrp_done" invisible="not to_create_mrp"/>
            </xpath>
        </field>
    </record>
</odoo>
