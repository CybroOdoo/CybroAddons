<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        View: mrp.production.form.inherit.pos
        Model: mrp.production
        Description: Displays originating POS order on the manufacturing order form.
    -->
    <record id="mrp_production_form_view_inherit_pos" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.pos</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']//field[@name='origin']" position="after">
                <field name="pos_order_id" invisible="not pos_order_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
