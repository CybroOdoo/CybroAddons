<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_preview_default_purchase">
        <t t-call="web.html_container">
            <!-- Header -->
            <div class="row mt32 mb32 align-items-center">
                <div class="col-6">
                    <img t-if="company.logo"
                         t-attf-src="data:image/png;base64,{{ company.logo }}"
                         style="max-height: 80px;" />
                </div>
                <div class="col-6 text-end"
                     style="font: 14px lucida-console, sans-serif; color: #000;">
                    <div>
                        <span t-field="company.partner_id"/>
                    </div>
                    <div>
                        <span t-field="company.partner_id.street"/><br/>
                        <span t-field="company.partner_id.street2"/><br/>
                        <span t-field="company.partner_id.city"/><br/>
                        <span t-field="company.partner_id.country_id"/><br/>
                        <span t-field="company.partner_id.vat"/>
                    </div>
                </div>
            </div>

            <!-- Customer Address -->
            <div class="pt-3 pb-4">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-0" itemtype="http://schema.org/Organization">
                            <strong itemprop="name">Deco Addict</strong>
                            <div itemprop="address" itemtype="http://schema.org/PostalAddress">
                                <p class="mb-0" itemprop="streetAddress">
                                    77 Santa Barbara Rd<br/>
                                    Pleasant Hill CA 94523<br/>
                                    United States
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Purchase Info -->
            <div class="page">
                <h2 class="mb-4">
                    <span>Purchase Order# </span><span>P0007</span>
                </h2>

                <div id="informations" class="row mb-4">
                    <div class="col-auto">
                        <strong>Order Date:</strong>
                        <p class="m-0">07/08/2020</p>
                    </div>
                    <div class="col-auto">
                        <strong>Order Deadline:</strong>
                        <p class="m-0">08/07/2020</p>
                    </div>
                </div>

                <!-- Product Table -->
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-left">Product</th>
                            <th class="text-left">Description</th>
                            <th class="text-right">Quantity</th>
                            <th class="text-right d-none d-md-table-cell">Unit Price</th>
                            <th class="text-left d-none d-md-table-cell">Taxes</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <tr>
                            <td>Three-Seat Sofa</td>
                            <td>
                                <span>[FURN_8999] Three-Seat Sofa<br/>
                                Three Seater Sofa with Lounger in Steel Grey Colour</span>
                            </td>
                            <td class="text-right">5.000</td>
                            <td class="text-right d-none d-md-table-cell">1,500.00</td>
                            <td class="text-left d-none d-md-table-cell">15.00%</td>
                            <td class="text-right o_price_total">$<span class="oe_currency_value">7,500.00</span></td>
                        </tr>
                        <tr>
                            <td>Four Person Desk</td>
                            <td>
                                <span>[FURN_8220] Four Person Desk<br/>
                                Four person modern office workstation</span>
                            </td>
                            <td class="text-right">5.000</td>
                            <td class="text-right d-none d-md-table-cell">23,500.00</td>
                            <td class="text-left d-none d-md-table-cell">15.00%</td>
                            <td class="text-right o_price_total">$<span class="oe_currency_value">117,500.00</span></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Totals -->
                <div class="row justify-content-end mt-4">
                    <div class="col-sm-7 col-md-6">
                        <table class="table table-sm" style="page-break-inside: avoid;">
                            <tbody>
                                <tr class="border-black o_subtotal">
                                    <td><strong>Subtotal</strong></td>
                                    <td class="text-right">$ <span class="oe_currency_value">125,000.00</span></td>
                                </tr>
                                <tr>
                                    <td>Tax 15%</td>
                                    <td class="text-right">$ 18,750.00</td>
                                </tr>
                                <tr class="border-black o_total">
                                    <td><strong>Total</strong></td>
                                    <td class="text-right">$ <span class="oe_currency_value">143,750.00</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
