<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Create a template for display the pdf report design-->
    <template id="report_timesheet_employee">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="padding-bottom:20px !important;"
                             class="oe_structure"/>
                        <h2 align="center">Timesheet Report by Employees</h2>
                        <br/>
                        <table class="table table-condensed">
                            <tbody>
                                <tr t-if="data.get('employee_name')">
                                    <th>Employee Name</th>
                                    <td colspan="2">
                                        <span t-out="data.get('employee_name')"/>
                                    </td>
                                    <th>Company Name</th>
                                    <td>
                                        <span t-out="data.get('company_name')"/>
                                    </td>
                                </tr>
                                <tr t-if="data.get('employee_name')">
                                    <th>Timesheet Period</th>
                                    <td colspan="2">
                                        <span t-out="data.get('period')"/>
                                    </td>
                                    <th>Total Working Hours</th>
                                    <td>
                                        <span t-out="data.get('total')"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-condensed">
                            <tbody>
                                <tr>
                                    <th>Date</th>
                                    <th>Project</th>
                                    <th>Worked Time</th>
                                </tr>
                                <tr t-foreach="data.get('timesheets', [])" t-as="t">
                                    <td>
                                        <span t-out="t['date']"/>
                                    </td>
                                    <td>
                                        <span t-out="t['project']"/>
                                    </td>
                                    <td>
                                        <span t-out="t['duration']"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
