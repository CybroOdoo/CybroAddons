<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="portal_pets" model="portal.entry">
        <field name="name">Pets</field>
        <field name="description">View and check created pets</field>
        <field name="url">/my/pets</field>
        <field name="image" type="bytes" file="pet_shop_management/static/src/img/pets.svg"/>
        <field name="placeholder_count">pets_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="60"/>
    </record>

    <record id="portal_sittings" model="portal.entry">
        <field name="name">Pet Sitting Schedules</field>
        <field name="description">View and check scheduled Pet Sitting appointments</field>
        <field name="url">/my/sittings</field>
        <field name="image" type="bytes" file="pet_shop_management/static/src/img/pet_sitting.svg"/>
        <field name="placeholder_count">sittings_count</field>
        <field name="category">client_category</field>
        <field name="sequence" eval="70"/>
    </record>
</odoo>

