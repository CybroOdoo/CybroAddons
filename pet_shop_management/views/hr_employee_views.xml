<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- View for veterinarian -->
    <record id="hr_employee_action" model="ir.actions.act_window">
        <field name="name">Veterinarians</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[('is_veterinarian', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new veterinarian
            </p>
            <p>
                Manage clinic veterinarians eligible to perform pet health checks and vaccinations.
            </p>
        </field>
    </record>
    <!-- View for pet walker -->
    <record id="action_walker_sitters" model="ir.actions.act_window">
        <field name="name">Walker/Sitters</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[('is_walker_sitters', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new walker or sitter
            </p>
            <p>
                Manage employee walkers and sitters available for pet care appointments.
            </p>
        </field>
    </record>
    <!-- Inheriting employee to add new fields -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.pet.shop.management</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <group>
                    <field name="is_veterinarian"
                           groups="pet_shop_management.pet_shop_management_group_pet_manager"/>
                    <field name="is_walker_sitters"
                           groups="pet_shop_management.pet_shop_management_group_pet_manager"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>