<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--- Pets sitting schedule action -->
    <record id="sitting_schedule_action" model="ir.actions.act_window">
        <field name="name">Pet Sitting Schedule</field>
        <field name="res_model">sitting.schedule</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Generate Sitting Schedule
            </p>
        </field>
    </record>
    <!--- Pets sitting schedule tree view -->
    <record model="ir.ui.view" id="view_sitting_schedule_tree">
        <field name="name">Pet Sitting Schedule</field>
        <field name="model">sitting.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="number_id"/>
                <field name="date_start"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>
   <!--- Pets sitting schedule form view -->
    <record model="ir.ui.view" id="view_sitting_schedule_form">
        <field name="name">Pet Sitting Schedule</field>
        <field name="model">sitting.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="number_id"/>
                            <field name="attendees_ids"
                                   widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Meeting Details">
                        </page>
                        <page string="Service">
                            <field name="service_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="cost"/>
                                    <field name="sale_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pets">
                            <field name="pet_info_ids">
                                <list editable="bottom">
                                    <field name="num"/>
                                    <field name="pet_num"/>
                                    <field name="customer"/>
                                    <field name="age"/>
                                    <field name="sex"/>
                                    <field name="pet_type_id"/>
                                    <field name="color"/>
                                    <field name="stay"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!--- Pets sittings schedule calendar view -->
    <record id="view_task_calendar" model="ir.ui.view">
        <field name="name">Sitting Schedule Calender</field>
        <field name="model">sitting.schedule</field>
        <field eval="2" name="priority"/>
        <field name="arch" type="xml">
            <calendar
            string="Pet Sitting Schedule"
            date_start="date_start"
            date_stop="end_date"
            color="attendees_ids"
            event_open_popup="true"
            create="true"
            edit="true">
                <field name="number_id" filters="1"/>
                <field name="attendees_ids" widget="many2many_avatar_user"/>
                <field name="end_date"/>
            </calendar>
        </field>
    </record>
</odoo>