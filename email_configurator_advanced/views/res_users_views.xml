<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--View for the fields in user forms.-->
    <record id="view_users_form_simple_modif_inherit_email_configurator_advanced" model="ir.ui.view">
        <field name="name">res.users.view.form.email.configurator.advanced</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="replace">
                <group id="mail_server" string="Mail Server Settings">
                    <field name="email" widget="email"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='email']" position="after">
                <field name="pwd" password="True"/>
                <field name="provider" options="{'no_create':True}"/>
                <div class="d-inline-block">
                    <button class="btn btn-light" type="object"
                            name="action_confirm" id="confirm">
                        <i class="fa fa-desktop" aria-hidden="true"/>
                        Test Email
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_inherit_email_configurator_advanced" model="ir.ui.view">
        <field name="name">res.users.view.form.email.configurator.advanced</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='notification_type']" position="after">
                <field name="automail" invisible="1"/>
                <group string="Mail Server Settings">
                    <field name="email" widget="email" required="automail"/>
                    <field name="pwd" password="True" required="automail"/>
                    <field name="provider" options="{'no_create':True}" required="automail"/>
                    <div class="d-inline-block">
                        <button class="btn btn-light" type="object"
                                name="action_confirm" id="confirm">
                            <i class="fa fa-desktop" aria-hidden="true"/>
                            Test Email
                        </button>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
