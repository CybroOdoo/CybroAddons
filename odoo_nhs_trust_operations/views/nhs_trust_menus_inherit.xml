<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Adds Operations and Compliance sub-menus under the root NHS Trusts menu.
        The root menu (menu_nhs_trust_root) is defined in odoo_nhs_trust_management.
    -->

    <!-- ── Operations Parent Submenu ───────────────────────────────────── -->
    <menuitem id="menu_nhs_trust_operations"
              name="Operations"
              parent="odoo_nhs_trust_management.menu_nhs_trust_root"
              sequence="10"
              groups="odoo_nhs_trust_management.group_nhs_trust_user"/>

    <!-- Sites -->
    <menuitem id="menu_nhs_trust_site"
              name="Sites"
              parent="menu_nhs_trust_operations"
              action="action_nhs_trust_site"
              sequence="10"
              groups="odoo_nhs_trust_management.group_nhs_trust_user"/>

    <!-- Departments -->
    <menuitem id="menu_nhs_trust_department"
              name="Departments"
              parent="menu_nhs_trust_operations"
              action="action_nhs_trust_department"
              sequence="20"
              groups="odoo_nhs_trust_management.group_nhs_trust_user"/>

    <!-- ── Compliance Parent Submenu ────────────────────────────────────── -->
    <menuitem id="menu_nhs_trust_compliance"
              name="Compliance"
              parent="odoo_nhs_trust_management.menu_nhs_trust_root"
              sequence="20"
              groups="odoo_nhs_trust_management.group_nhs_trust_user"/>

    <!-- CQC Inspections -->
    <menuitem id="menu_nhs_trust_cqc"
              name="CQC Inspections"
              parent="menu_nhs_trust_compliance"
              action="action_nhs_trust_cqc_inspection"
              sequence="10"
              groups="odoo_nhs_trust_management.group_nhs_trust_user"/>

    <!-- State Change Audit -->
    <menuitem id="menu_nhs_trust_compliance_state_log"
              name="State Change Audit"
              parent="menu_nhs_trust_compliance"
              action="odoo_nhs_trust_management.action_nhs_trust_state_log"
              sequence="20"
              groups="odoo_nhs_trust_management.group_nhs_trust_user"/>

    <!-- ── Configuration extension — Clinical Specialties ──────────────── -->
    <menuitem id="menu_nhs_trust_specialty"
              name="Clinical Specialties"
              parent="odoo_nhs_trust_management.menu_nhs_trust_config"
              action="action_nhs_trust_specialty"
              sequence="60"
              groups="odoo_nhs_trust_management.group_nhs_trust_admin"/>
</odoo>
