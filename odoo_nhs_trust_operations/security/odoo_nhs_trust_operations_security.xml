<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ============================================================
             NHS TRUST SITE GEOGRAPHIC SCOPING
        ============================================================ -->
        <record id="rule_nhs_trust_site_user_scoping" model="ir.rule">
            <field name="name">NHS Trust Site User Allowed Scope Only</field>
            <field name="model_id" ref="model_nhs_trust_site"/>
            <field name="groups" eval="[(4, ref('odoo_nhs_trust_management.group_nhs_trust_user'))]"/>
            <field name="domain_force">['|', 
                '&amp;', 
                    ('trust_id.health_system', '=', 'nhs_england'), 
                    ('trust_id.icb_id', 'in', user.nhs_allowed_icb_ids.ids),
                '&amp;', 
                    ('trust_id.health_system', '=', 'nhs_scotland'), 
                    ('trust_id.health_board_id', 'in', user.nhs_allowed_health_board_ids.ids)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_nhs_trust_site_manager_global" model="ir.rule">
            <field name="name">NHS Trust Site Manager Global Access</field>
            <field name="model_id" ref="model_nhs_trust_site"/>
            <field name="groups" eval="[(4, ref('odoo_nhs_trust_management.group_nhs_trust_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

