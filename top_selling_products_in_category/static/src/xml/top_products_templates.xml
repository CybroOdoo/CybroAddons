<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="top_selling_products_in_category.products_category_wise">
        <div id="top_selling_products_carousel" class="container">
            <div>
                <div>
                    <t t-foreach="products_list" t-as="product_category" t-key="product_category.category.id">
                        <div class="product_list">
                            <div class="col-2">
                                <h2 t-out="product_category.category.name"/>
                                <a class="view-all-button"
                                   t-att-href="'/shop/category/' + product_category.category.name + '-' + product_category.category.id + '?from_view_all=true'"
                                   role="button">View All</a>
                            </div>
                            <t t-if="product_category.products.flat().includes('chunk')">
                                <div t-attf-id="top_selling_carousel_{{product_category.category.id}}"
                                     class="carousel slide col-md-10"
                                     data-bs-ride="false">
                                    <div class="carousel-inner row w-100 mx-auto"
                                         role="listbox">
                                        <t t-foreach="product_category.products"
                                           t-as="product_chunks" t-key="product_chunks_index">
                                            <div t-att-class="product_chunks.is_active ? 'carousel-item active top-carousel-item' : 'carousel-item top top-carousel-item'">
                                                <div class="row top_selling">
                                                    <t t-foreach="product_chunks"
                                                       t-as="product" t-key="product.id">
                                                        <t t-if="product.id">
                                                            <div class="d-flex flex-grow-0 flex-shrink-0 col-2 top-product-col">
                                                                <div class="o_carousel_product_card bg-transparent w-100 card border-0">
                                                                    <a class="o_carousel_product_img_link o_dynamic_product_hovered stretched-link"
                                                                       t-attf-href="/shop/product/{{product.id}}">
                                                                        <div class="overflow-hidden rounded">
                                                                            <img t-attf-src="/web/image/product.template/{{ product.id }}/image_1920"
                                                                                 class="top-product-img"
                                                                                 alt="Product image"/>
                                                                        </div>
                                                                    </a>
                                                                    <div class="o_carousel_product_card_body d-flex flex-wrap flex-column justify-content-between h-100 p-3">
                                                                        <div class="h6 card-title"
                                                                             t-out="product.name"/>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </t>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <a class="carousel-control-prev w-auto px-2"
                                       t-attf-href="#top_selling_carousel_{{product_category.category.id}}"
                                       t-attf-data-bs-target="#top_selling_carousel_{{product_category.category.id}}"
                                       role="button"
                                       data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon top-carousel-control-icon"
                                              aria-hidden="true"/>
                                        <span class="visually-hidden">Previous</span>
                                    </a>
                                    <a class="carousel-control-next w-auto px-2"
                                       t-attf-href="#top_selling_carousel_{{product_category.category.id}}"
                                       t-attf-data-bs-target="#top_selling_carousel_{{product_category.category.id}}"
                                       role="button"
                                       data-bs-slide="next">
                                        <span class="carousel-control-next-icon top-carousel-control-icon"
                                              aria-hidden="true"/>
                                        <span class="visually-hidden">Next</span>
                                    </a>
                                </div>
                            </t>
                            <t t-else="">
                                <t t-foreach="product_category.products"
                                   t-as="product_chunks" t-key="product_chunks_index">
                                    <t t-foreach="product_chunks"
                                       t-as="product" t-key="product.id">
                                        <div class="d-flex flex-grow-0 flex-shrink-0 col-2 top-product-col">
                                            <div class="o_carousel_product_card bg-transparent w-100 card border-0">
                                                <a class="o_carousel_product_img_link o_dynamic_product_hovered stretched-link"
                                                   t-attf-href="/shop/product/{{product.id}}">
                                                    <div class="overflow-hidden rounded">
                                                        <img t-attf-src="/web/image/product.template/{{ product.id }}/image_128"
                                                             class="top-product-img"
                                                             alt="Product image"/>
                                                    </div>
                                                </a>
                                                <div class="o_carousel_product_card_body d-flex flex-wrap flex-column justify-content-between h-100 p-3">
                                                    <div class="h6 card-title"
                                                         t-out="product.name"/>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
