<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit sale.order form view to make the date_order field editable in 'sale' state for authorized users -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.edit.order.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order'][@invisible=&quot;state in ['draft', 'sent']&quot;]" position="replace">
                <field name="date_order"
                       nolabel="1"
                       invisible="state in ['draft', 'sent']"
                       readonly="state in ['cancel', 'sale']"
                       groups="!edit_order_date.edit_order_date_group_user"/>
                <field name="date_order"
                       nolabel="1"
                       invisible="state in ['draft', 'sent']"
                       readonly="state in ['cancel']"
                       groups="edit_order_date.edit_order_date_group_user"/>
            </xpath>
        </field>
    </record>
</odoo>
