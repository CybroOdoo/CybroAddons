<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_product_stock.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="inside">
            <span t-if="this.displayStock"
                t-out="this.productStockQty"
                class="product-stock-qty position-absolute top-0 start-0 m-1 px-2 rounded text-white fs-5 fw-bolder"
                style="background-color: rgb(195, 216, 195); z-index: 1;"/>
        </xpath>
    </t>
</templates>