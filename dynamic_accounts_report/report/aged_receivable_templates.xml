<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Report template for Aged Receivable Report.-->
    <template id="aged_receivable">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">
                    <h3>
                        <center>
                            <b>
                                <span t-out="report_name"/>
                            </b>
                        </center>
                    </h3>
                    <br/>
                    <br/>
                    <div class="filters">
                        <table class="table table-sm table-reports">
                            <thead class="filter_table"
                                   style="background:#808080;">
                                <tr>
                                    <th>Date Range</th>
                                    <th>Partner</th>
                                </tr>
                            </thead>
                            <tbody style="font-size:11px;font-weight:100;">
                                <tr>
                                    <th>
                                        <t t-if="filters and filters.get('end_date')">
                                            <t t-out="filters['end_date']"/>
                                        </t>
                                    </th>
                                    <th>
                                        <t t-if="filters and filters.get('partner')">
                                            <t t-foreach="filters['partner']"
                                               t-as="selected_partner">
                                                <t t-out="selected_partner.get('display_name', '')"/>,
                                            </t>
                                        </t>
                                    </th>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <br/>
                    <br/>
                    <br/>
                    <t t-if="move_lines">
                        <t t-foreach="move_lines"
                           t-as="move_line">
                            <table class="table table-sm table-reports">
                                <thead style="background:#808080;">
                                    <tr>
                                        <th style="width:10%" colspan="6"/>
                                        <th style="width:10%">Invoice Date</th>
                                        <th style="width:10%">Amount Currency</th>
                                        <th style="width:10%">Currency</th>
                                        <th style="width:10%">Account</th>
                                        <th style="width:10%">Expected Date</th>
                                        <th style="width:10%">At Date</th>
                                        <th style="width:10%">1-30</th>
                                        <th style="width:10%">31-60</th>
                                        <th style="width:10%">61-90</th>
                                        <th style="width:10%">91-120</th>
                                        <th style="width:10%">Older</th>
                                        <th style="width:10%">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="border-bottom"
                                        style="background:#D3D3D3;">
                                        <th colspan="6"
                                            style="border:0px solid transparent;border-left: thin solid #dee2e6;">
                                            <div>
                                                <span class="fw-bolder">
                                                    <t t-out="move_line"/>
                                                </span>
                                            </div>
                                        </th>
                                        <th style="border:0px solid transparent;"/>
                                        <th style="border:0px solid transparent;"/>
                                        <th style="border:0px solid transparent;"/>
                                        <th style="border:0px solid transparent;"/>
                                        <th style="border:0px solid transparent;"/>
                                        <th style="border:0px solid transparent;font-size:11px;font-weight:100;">
                                            <span>
                                                <t t-if="total and move_line in total and total[move_line].get('diff0_sum') is not None"
                                                   t-out="total[move_line].get('currency_id', '')"/>
                                                <t t-if="total and move_line in total and total[move_line].get('diff0_sum') is not None"
                                                   t-out="total[move_line]['diff0_sum']"/>
                                            </span>
                                        </th>
                                        <th style="border:0px solid transparent;font-size:11px;font-weight:100;">
                                            <span>
                                                <t t-if="total and move_line in total and total[move_line].get('diff1_sum') is not None"
                                                   t-out="total[move_line].get('currency_id', '')"/>
                                                <t t-if="total and move_line in total and total[move_line].get('diff1_sum') is not None"
                                                   t-out="total[move_line]['diff1_sum']"/>
                                            </span>
                                        </th>
                                        <th style="border:0px solid transparent;font-size:11px;font-weight:100;">
                                            <span>
                                                <t t-if="total and move_line in total and total[move_line].get('diff2_sum') is not None"
                                                   t-out="total[move_line].get('currency_id', '')"/>
                                                <t t-if="total and move_line in total and total[move_line].get('diff2_sum') is not None"
                                                   t-out="total[move_line]['diff2_sum']"/>
                                            </span>
                                        </th>
                                        <th style="border:0px solid transparent;font-size:11px;font-weight:100;">
                                            <span>
                                                <t t-if="total and move_line in total and total[move_line].get('diff3_sum') is not None"
                                                   t-out="total[move_line].get('currency_id', '')"/>
                                                <t t-if="total and move_line in total and total[move_line].get('diff3_sum') is not None"
                                                   t-out="total[move_line]['diff3_sum']"/>
                                            </span>
                                        </th>
                                        <th style="border:0px solid transparent;font-size:11px;font-weight:100;">
                                            <span>
                                                <t t-if="total and move_line in total and total[move_line].get('diff4_sum') is not None"
                                                   t-out="total[move_line].get('currency_id', '')"/>
                                                <t t-if="total and move_line in total and total[move_line].get('diff4_sum') is not None"
                                                   t-out="total[move_line]['diff4_sum']"/>
                                            </span>
                                        </th>
                                        <th style="border:0px solid transparent;font-size:11px;font-weight:100;">
                                            <span>
                                                <t t-if="total and move_line in total and total[move_line].get('diff5_sum') is not None"
                                                   t-out="total[move_line].get('currency_id', '')"/>
                                                <t t-if="total and move_line in total and total[move_line].get('diff5_sum') is not None"
                                                   t-out="total[move_line]['diff5_sum']"/>
                                            </span>
                                        </th>
                                        <th style="border:0px solid transparent;border-right: thin solid #dee2e6;font-size:11px;font-weight:100;">
                                            <span class="fw-bolder">
                                                <t t-if="total and move_line in total and total[move_line].get('debit_sum') is not None"
                                                   t-out="total[move_line].get('currency_id', '')"/>
                                                <t t-if="total and move_line in total and total[move_line].get('debit_sum') is not None"
                                                   t-out="total[move_line]['debit_sum']"/>
                                            </span>
                                        </th>
                                    </tr>
                                    <t t-if="data and move_line in data">
                                        <t t-foreach="data[move_line]"
                                           t-as="valuelist">
                                            <tr class="border-bottom"
                                                style="font-size:11px;font-weight:100;">
                                                <th colspan="6">
                                                    <span>
                                                        <t t-if="valuelist.get('move_name')" t-out="valuelist['move_name']"/>
                                                        <t t-if="valuelist.get('name')" t-out="valuelist['name']"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-out="valuelist.get('date', '')"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-out="valuelist.get('amount_currency', '')"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-if="valuelist.get('currency_id') and len(valuelist['currency_id']) > 1" t-out="valuelist['currency_id'][1]"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-if="valuelist.get('account_id') and len(valuelist['account_id']) > 1" t-out="valuelist['account_id'][1]"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-if="valuelist.get('date_maturity')"
                                                           t-out="valuelist['date_maturity']"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-if="valuelist.get('diff0') and total and move_line in total"
                                                           t-out="total[move_line].get('currency_id', '')"/>
                                                        <t t-if="valuelist.get('diff0')"
                                                           t-out="valuelist['diff0']"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-if="valuelist.get('diff1') and total and move_line in total"
                                                           t-out="total[move_line].get('currency_id', '')"/>
                                                        <t t-if="valuelist.get('diff1')"
                                                           t-out="valuelist['diff1']"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-if="valuelist.get('diff2') and total and move_line in total"
                                                           t-out="total[move_line].get('currency_id', '')"/>
                                                        <t t-if="valuelist.get('diff2')"
                                                           t-out="valuelist['diff2']"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-if="valuelist.get('diff3') and total and move_line in total"
                                                           t-out="total[move_line].get('currency_id', '')"/>
                                                        <t t-if="valuelist.get('diff3')"
                                                           t-out="valuelist['diff3']"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-if="valuelist.get('diff4') and total and move_line in total"
                                                           t-out="total[move_line].get('currency_id', '')"/>
                                                        <t t-if="valuelist.get('diff4')"
                                                           t-out="valuelist['diff4']"/>
                                                    </span>
                                                </th>
                                                <th>
                                                    <span>
                                                        <t t-if="valuelist.get('diff5') and total and move_line in total"
                                                           t-out="total[move_line].get('currency_id', '')"/>
                                                        <t t-if="valuelist.get('diff5')"
                                                           t-out="valuelist['diff5']"/>
                                                    </span>
                                                </th>
                                                <th/>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </t>
                    <table class="table table-sm table-reports">
                        <tbody>
                            <tr>
                                <th style="width:60%;">Total</th>
                                <th style="width:10%">
                                    <t t-if="grand_total and grand_total.get('currency')" t-out="grand_total['currency']"/>
                                    <t t-if="grand_total and grand_total.get('diff0_sum') is not None" t-out="grand_total['diff0_sum']"/>
                                </th>
                                <th style="width:10%">
                                    <t t-if="grand_total and grand_total.get('currency')" t-out="grand_total['currency']"/>
                                    <t t-if="grand_total and grand_total.get('diff1_sum') is not None" t-out="grand_total['diff1_sum']"/>
                                </th>
                                <th style="width:10%">
                                    <t t-if="grand_total and grand_total.get('currency')" t-out="grand_total['currency']"/>
                                    <t t-if="grand_total and grand_total.get('diff2_sum') is not None" t-out="grand_total['diff2_sum']"/>
                                </th>
                                <th style="width:10%">
                                    <t t-if="grand_total and grand_total.get('currency')" t-out="grand_total['currency']"/>
                                    <t t-if="grand_total and grand_total.get('diff3_sum') is not None" t-out="grand_total['diff3_sum']"/>
                                </th>
                                <th style="width:10%">
                                    <t t-if="grand_total and grand_total.get('currency')" t-out="grand_total['currency']"/>
                                    <t t-if="grand_total and grand_total.get('diff4_sum') is not None" t-out="grand_total['diff4_sum']"/>
                                </th>
                                <th style="width:10%">
                                    <t t-if="grand_total and grand_total.get('currency')" t-out="grand_total['currency']"/>
                                    <t t-if="grand_total and grand_total.get('diff5_sum') is not None" t-out="grand_total['diff5_sum']"/>
                                </th>
                                <th style="width:10%">
                                    <t t-if="grand_total and grand_total.get('currency')" t-out="grand_total['currency']"/>
                                    <t t-if="grand_total and grand_total.get('total_debit') is not None" t-out="grand_total['total_debit']"/>
                                </th>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
