<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Hide duplicate report menu items from base_accounting_kit when
        dynamic_accounts_report is installed.  DAR provides its own dynamic
        versions of every report listed below under the
        "Dynamic Financial Reports" sub-menu, so the static BAK counterparts
        are redundant and would confuse users.

        Menus that are NOT hidden (no DAR equivalent):
          - Cash Flow Statement  (base_accounting_kit.menu_account_cash_flow_report)
          - Day Book             (base_accounting_kit.account_day_book_menu)
          - Journals Audit       (base_accounting_kit.menu_print_journal)
        Their parent section headers (Generic Statements, Daily Reports,
        Audit Reports) are also kept because those remaining children still
        need them.

        The Partner Reports and the Aged Partner Balance sub-menu are hidden
        because DAR covers both Aged Receivable and Aged Payable.
    -->

    <!-- Generic Statements section -->
    <record id="base_accounting_kit.account_financial_reports_profit_loss" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base_accounting_kit._account_financial_reports_balance_sheet" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Audit Reports section -->
    <record id="base_accounting_kit.menu_general_ledger" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base_accounting_kit.menu_Balance_report" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base_accounting_kit.menu_tax_report" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Partner Reports section — hide the leaf menu and the now-empty header -->
    <record id="base_accounting_kit.menu_partner_ledger" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base_accounting_kit.account_reports_partner" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Daily Reports section — Bank Book and Cash Book only (Day Book stays) -->
    <record id="base_accounting_kit.account_bank_book_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base_accounting_kit.account_cash_book_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Aged Partner Balance (top-level under Reporting) -->
    <record id="base_accounting_kit.menu_aged_trial_balance" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
