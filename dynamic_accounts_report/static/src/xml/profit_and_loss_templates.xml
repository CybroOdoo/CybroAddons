<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="dfr_template_new" owl="1">
        <div class="container">
            <div style="border-bottom: 1px solid #d8dadd;">
                <div class="filter_view_dfr pt-3 pb-5">
                    <div class="">
                        <h2 class="text-uppercase" style="padding:10px">
                            <t t-out="this.state.title"/>
                        </h2>
                    </div>
                    <div class="sub_container_right d-flex mx-2">
                        <t t-if="this.state.filter_data">
                            <div class="report_print">
                                <button type="button"
                                        class="btn btn-primary btn-report-print mr-2"
                                        t-on-click="this.print_pdf"
                                        style="margin-right: 8px;">
                                    Print (PDF)
                                </button>
                                <button type="button"
                                        class="btn btn-primary btn-report-print"
                                        t-on-click="this.print_xlsx"
                                        style="position: relative;">
                                    Export (XLSX)
                                </button>
                            </div>
                            <div class="filter d-flex ms-auto"
                                 style="gap: 1.5rem;">
                                <div class="time_range" style="">
                                    <a type="button" class="dropdown-toggle"
                                       data-bs-toggle="dropdown">
                                        <span class="oi oi-fw" data-icon="calendar_today"
                                              title="Dates"
                                              role="img"
                                              aria-label="Dates"/>
                                        Date Range
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <div class="list-group">
                                            <button class="report-filter-button"
                                                    t-att-data-value="'month'"
                                                    type="button"
                                                    t-on-click="this.apply_date">
                                                This Month
                                            </button>
                                            <button class="report-filter-button"
                                                    t-att-data-value="'quarter'"
                                                    type="button"
                                                    t-on-click="this.apply_date">
                                                This Quarter
                                            </button>
                                            <button class="report-filter-button"
                                                    t-att-data-value="'year'"
                                                    type="button"
                                                    t-on-click="this.apply_date">
                                                This Year
                                            </button>
                                            <div role="separator"
                                                 class="dropdown-divider"/>
                                            <button class="report-filter-button"
                                                    t-att-data-value="'last-month'"
                                                    type="button"
                                                    t-on-click="this.apply_date">
                                                Last month
                                            </button>
                                            <button class="report-filter-button"
                                                    t-att-data-value="'last-quarter'"
                                                    type="button"
                                                    t-on-click="this.apply_date">
                                                Last quarter
                                            </button>
                                            <button class="report-filter-button"
                                                    t-att-data-value="'last-year'"
                                                    type="button"
                                                    t-on-click="this.apply_date">
                                                Last year
                                            </button>
                                            <div role="separator"
                                                 class="dropdown-divider"/>
                                            <label class="" for="date_from">
                                                Start
                                                Date :
                                            </label>
                                            <div class="input-group date"
                                                 t-ref="this.date_from"
                                                 data-target-input="nearest">

                                                <input type="date"
                                                       id="start_date"
                                                       t-on-change="this.apply_date"
                                                       style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none;"
                                                       name="start_date"/>
                                            </div>

                                            <label class="" for="date_to">End
                                                Date
                                                :
                                            </label>
                                            <div class="input-group date"
                                                 t-ref="this.date_to"
                                                 data-target-input="nearest">
                                                <input type="date"
                                                       id="end_date"
                                                       t-on-change="this.apply_date"
                                                       style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none;"
                                                       name="end_date"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="comparison_range" style="">
                                <a type="button" class="dropdown-toggle"
                                   data-bs-toggle="dropdown">
                                    <span class="oi oi-fw" data-icon="bar_chart"
                                          title="Comparison"
                                          role="img"
                                          aria-label="Comparison"/>
                                    Comparison
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <div class="list-group">
                                        <button class="report-filter-button"
                                                t-att-data-value="'no comparison'"
                                                type="button"
                                                t-on-click="this.apply_comparison">
                                            No Comparison
                                        </button>
                                        <div role="separator"
                                             class="dropdown-divider"/>
                                        <label class="oi oi-fw" data-icon="arrow_right" for="periods"
                                               style="display: flex;padding: 4px 20px;color: #000;">
                                            Previous Period
                                            <br/>
                                            Number of Periods:
                                        </label>
                                        <div class="input-group comparison"
                                             data-target-input="nearest">

                                            <input type="number"
                                                   t-ref="this.period"
                                                   min="1"
                                                   t-on-input="this.onPeriodChange"
                                                   style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none;"
                                                   name="previous_period"/>
                                        </div>
                                        <button class="btn btn-primary"
                                                type="button"
                                                style="margin-left: 19px;margin-top: 4px;"
                                                t-on-click="this.applyComparisonPeriod">
                                            Apply
                                        </button>
                                        <div role="separator"
                                             class="dropdown-divider"/>
                                        <label class="" for="period_year"
                                               style="display: flex;padding: 4px 20px;color: #000;">
                                            Same Period Last Year
                                            <br/>
                                            Number of Periods:
                                        </label>
                                        <div class="input-group comparison"
                                             data-target-input="nearest">
                                            <input type="number"
                                                   t-ref="this.period_year"
                                                   t-on-input="this.onPeriodYearChange"
                                                   min="1"
                                                   style="border:none;border-bottom: 1px solid #000;padding: 5px;outline: none;"
                                                   name="period_year"/>
                                        </div>
                                        <button class="btn btn-primary"
                                                type="button"
                                                style="margin-left: 19px;margin-top: 4px;"
                                                t-on-click="this.applyComparisonYear">
                                            Apply
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="journals_filter dropdown" style="">
                                <a type="button" class="dropdown-toggle"
                                   data-bs-toggle="dropdown">
                                    <span class="oi oi-fw" data-icon="book"/>
                                    Journals:
                                    <span class="code"/>
                                </a>
                                <div class="dropdown-menu journals"
                                     name="states[]">
                                    <div role="separator"
                                         class="dropdown-divider"/>
                                    <t t-foreach="this.state.filter_data['journal']"
                                       t-as="journal" t-key="journal_index">
                                        <span class="dropdown-item"
                                              role="menuitem"
                                              t-on-click="this.apply_journal">
                                            <span t-out="journal.id"
                                                  class="d-none"/>
                                            <t t-out="journal.name"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <div class="accounts_filter">
                                <a type="button" class="dropdown-toggle"
                                   data-bs-toggle="dropdown" style="display: flex;text-wrap: wrap;
                                                                    flex-direction: row;
                                                                    align-items: center;
                                                                    justify-content: flex-start;
                                                                    min-width: 105px;">
                                    <span class="oi oi-fw" data-icon="book"/>
                                    Accounts:
                                    <span class="account"/>
                                </a>
                                <div class="dropdown-menu journals"
                                     name="states[]">
                                    <div role="separator"
                                         class="dropdown-divider"/>
                                    <t t-foreach="this.state.filter_data['account']"
                                       t-as="account" t-key="account_index">
                                        <span class="dropdown-item"
                                              role="menuitem"
                                              t-on-click="this.apply_account">
                                            <span t-out="account.id"
                                                  class="d-none"/>
                                            <t t-out="account.name"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <div class="analytic_filter" style="max-width:17%;">
                                <a type="button" class="dropdown-toggle"
                                   data-bs-toggle="dropdown" style="display: flex;
                                                            text-wrap: wrap;
                                                            flex-direction: row;
                                                            align-items: center;
                                                            justify-content: flex-start;
                                                            min-width: 105px;">
                                    <span class="oi oi-fw" data-icon="folder_open"/>
                                    Analytic Accounts:
                                    <span class="analytic"/>
                                </a>
                                <div class="dropdown-menu analytic_accounts"
                                     name="states[]">
                                    <div role="separator"
                                         class="dropdown-divider"/>
                                    <t t-foreach="this.state.filter_data['analytic']"
                                       t-as="analytic" t-key="analytic_index">
                                        <span class="dropdown-item"
                                              role="menuitem"
                                              t-on-click="this.apply_analytic_accounts">
                                            <span t-out="analytic.id"
                                                  class="d-none"/>
                                            <t t-out="analytic.name"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <div class="search_Target_move" style="">
                                <a type="button" class="dropdown-toggle"
                                   data-bs-toggle="dropdown">
                                    <span class="oi oi-fw" data-icon="filter_alt"/>
                                    Target Move:
                                    <span class="target"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <div class="list-group">
                                        <button class="report-filter-button"
                                                t-attf-value="posted"
                                                t-ref="this.posted"
                                                type="button"
                                                t-on-click="this.apply_entries">
                                            Posted Entries
                                        </button>
                                        <button class="report-filter-button"
                                                t-attf-value="draft"
                                                t-ref="this.draft"
                                                type="button"
                                                t-on-click="this.apply_entries">
                                            Include Draft Entries
                                        </button>
                                        <button class="report-filter-button"
                                                type="button"
                                                t-ref="this.unfoldButton"
                                                t-on-click="this.unfoldAll">
                                            Unfold All
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            <br/>
            <div>
                <div class="table_view_dfr" style="height: 650px; overflow-y: scroll;">
                    <div>
                        <div class="table_main_view">
                            <table cellspacing="0" width="100%">
                                <thead>
                                    <tr class="o_heading">
                                        <th colspan="6"/>
                                        <t t-if="this.state.year">
                                            <t t-foreach="this.state.year"
                                               t-as="periodData"
                                               t-key="periodData_index">
                                                <th class="text-end">
                                                    <t t-out="periodData"/>
                                                </th>
                                            </t>
                                        </t>
                                    </tr>
                                    <tr class="o_heading">
                                        <th colspan="6"/>
                                        <t t-if="this.state.year">
                                            <t t-foreach="this.state.year"
                                               t-as="periodData"
                                               t-key="periodData_index">
                                                <th class="text-end">Balance
                                                </th>
                                            </t>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody t-ref="this.tbody">
                                    <t t-if="this.state.datas">
                                        <tr class="gl-line">
                                            <th colspan="6">
                                                <span class="fw-bolder">
                                                    Net Profit
                                                </span>
                                            </th>
                                            <t t-foreach="this.state.datas"
                                               t-as="total"
                                               t-key="total_index">
                                                <th class="text-end">
                                                    <span class="fw-bolder">
                                                        <t t-if="total.total"
                                                           t-out="total.total.toFixed(2)"/>
                                                    </span>
                                                </th>
                                            </t>
                                        </tr>
                                        <tr class="border-bottom border-dark">
                                            <th colspan="6">
                                                <span class="fw-bolder ms-2">
                                                    Income
                                                </span>
                                            </th>
                                            <t t-foreach="this.state.datas"
                                               t-as="total_income"
                                               t-key="total_income_index">
                                                <th class="text-end">
                                                    <span class="fw-bolder">
                                                        <t t-out="total_income.total_income"/>
                                                    </span>
                                                </th>
                                            </t>
                                        </tr>
                                        <tr class="border-bottom border-gainsboro">
                                            <th colspan="6">
                                                <span class="fw-bolder ms-3">
                                                    Gross Profit
                                                </span>
                                            </th>
                                            <t t-foreach="this.state.datas"
                                               t-as="value"
                                               t-key="value_index">
                                                <th class="text-end">
                                                    <span>
                                                        <t t-out="this.sumGrossProfit(value.expense_direct_cost[1], value.income[1]).toFixed(2)"/>
                                                    </span>
                                                </th>
                                            </t>
                                        </tr>

                                        <!-- OPERATING INCOME -->
                                        <tr class="border-bottom border-gainsboro">
                                            <th colspan="6">
                                                <div data-bs-toggle="collapse"
                                                     data-bs-target=".collapseIncome"
                                                     class="ms-3 collapsed">
                                                    <a class="btn header">
                                                        <span class="toggle-icon">
                                                            <i class="oi oi-fw" data-icon="arrow_drop_down"/>
                                                        </span>
                                                        <span class="ms-3">
                                                            Operating Income
                                                        </span>
                                                    </a>
                                                </div>
                                            </th>
                                            <t t-foreach="this.state.datas"
                                               t-as="value"
                                               t-key="value_index">
                                                <th class="text-end">
                                                    <span>
                                                        <t t-out="value.income[1]"/>
                                                    </span>
                                                </th>
                                            </t>
                                        </tr>
                                        <t t-foreach="this.state.datas[0].income[0]"
                                           t-as="acc"
                                           t-key="acc.account_id">
                                            <tr class="border-bottom border-gainsboro collapse collapseIncome">
                                                <th colspan="6">
                                                    <span class="dropdown">
                                                        <a class="dropdown-toggle" data-bs-toggle="dropdown">
                                                            <span class="ms-5">
                                                                <t t-out="acc.name"/>
                                                            </span>
                                                        </a>
                                                        <span class="dropdown-menu">
                                                            <a role="menuitem"
                                                               t-att-data-id="acc.account_id"
                                                               t-on-click="this.show_gl"
                                                               class="show_gl">
                                                                General
                                                                Ledger
                                                            </a>
                                                        </span>
                                                    </span>
                                                </th>
                                                <t t-foreach="this.state.datas" t-as="period" t-key="period_index">
                                                    <th class="text-end">
                                                        <span>
                                                            <t t-foreach="period.income[0]" t-as="pacc"
                                                               t-key="pacc.account_id">
                                                                <t t-if="pacc.account_id == acc.account_id">
                                                                    <t t-out="pacc.amount"/>
                                                                </t>
                                                            </t>
                                                        </span>
                                                    </th>
                                                </t>
                                            </tr>
                                        </t>

                                        <!-- COST OF REVENUE -->
                                        <tr class="border-bottom border-gainsboro">
                                            <th colspan="6">
                                                <div data-bs-toggle="collapse"
                                                     data-bs-target=".collapseRevenue"
                                                     class="ms-3 collapsed">
                                                    <a class="btn header">
                                                        <span class="toggle-icon">
                                                            <i class="oi oi-fw" data-icon="arrow_drop_down"/>
                                                        </span>
                                                        <span class="ms-3">
                                                            Cost of Revenue
                                                        </span>
                                                    </a>
                                                </div>
                                            </th>
                                            <t t-foreach="this.state.datas" t-as="value" t-key="value_index">
                                                <th class="text-end">
                                                    <span><t t-out="value.expense_direct_cost[1]"/></span>
                                                </th>
                                            </t>
                                        </tr>
                                        <t t-foreach="this.state.datas[0].expense_direct_cost[0]"
                                           t-as="acc"
                                           t-key="acc.account_id">
                                            <tr class="border-bottom border-gainsboro collapse collapseRevenue">
                                                <th colspan="6">
                                                    <span class="dropdown">
                                                        <a class="dropdown-toggle" data-bs-toggle="dropdown">
                                                            <span class="ms-5">
                                                                <t t-out="acc.name"/>
                                                            </span>
                                                        </a>
                                                        <span class="dropdown-menu">
                                                            <a role="menuitem"
                                                               t-att-data-id="acc.account_id"
                                                               t-on-click="this.show_gl"
                                                               class="show_gl">
                                                                General
                                                                Ledger
                                                            </a>
                                                        </span>
                                                    </span>
                                                </th>
                                                <t t-foreach="this.state.datas" t-as="period" t-key="period_index">
                                                    <th class="text-end">
                                                        <span>
                                                            <t t-foreach="period.expense_direct_cost[0]" t-as="pacc"
                                                               t-key="pacc.account_id">
                                                                <t t-if="pacc.account_id == acc.account_id">
                                                                    <t t-out="pacc.amount"/>
                                                                </t>
                                                            </t>
                                                        </span>
                                                    </th>
                                                </t>
                                            </tr>
                                        </t>

                                        <!-- OTHER INCOME -->
                                        <tr class="border-bottom border-gainsboro">
                                            <th colspan="6">
                                                <div data-bs-toggle="collapse"
                                                     data-bs-target=".collapseOtherIncome"
                                                     class="ms-1 collapsed">
                                                    <a class="btn header">
                                                        <span class="toggle-icon">
                                                            <i class="oi oi-fw" data-icon="arrow_drop_down"/>
                                                        </span>
                                                        <span class="ms-3">
                                                            Other Income
                                                        </span>
                                                    </a>
                                                </div>
                                            </th>
                                            <t t-foreach="this.state.datas" t-as="value" t-key="value_index">
                                                <th class="text-end">
                                                    <span><t t-out="value.income_other[1]"/></span>
                                                </th>
                                            </t>
                                        </tr>
                                        <t t-foreach="this.state.datas[0].income_other[0]"
                                           t-as="acc"
                                           t-key="acc.account_id">
                                            <tr class="border-bottom border-gainsboro collapse collapseOtherIncome">
                                                <th colspan="6">
                                                    <span class="dropdown">
                                                        <a class="dropdown-toggle" data-bs-toggle="dropdown">
                                                            <span class="ms-4">
                                                                <t t-out="acc.name"/>
                                                            </span>
                                                        </a>
                                                        <span class="dropdown-menu">
                                                            <a role="menuitem"
                                                               t-att-data-id="acc.account_id"
                                                               t-on-click="this.show_gl"
                                                               class="show_gl">
                                                                General
                                                                Ledger
                                                            </a>
                                                        </span>
                                                    </span>
                                                </th>
                                                <t t-foreach="this.state.datas" t-as="period" t-key="period_index">
                                                    <th class="text-end">
                                                        <span>
                                                            <t t-foreach="period.income_other[0]" t-as="pacc"
                                                               t-key="pacc.account_id">
                                                                <t t-if="pacc.account_id == acc.account_id">
                                                                    <t t-out="pacc.amount"/>
                                                                </t>
                                                            </t>
                                                        </span>
                                                    </th>
                                                </t>
                                            </tr>
                                        </t>

                                        <tr class="border-bottom border-gainsboro">
                                            <th colspan="6">
                                                <span class="fw-bolder ms-2">
                                                    Total Income
                                                </span>
                                            </th>
                                            <t t-foreach="this.state.datas"
                                               t-as="total_income"
                                               t-key="total_income_index">
                                                <th class="text-end">
                                                    <span class="fw-bolder">
                                                        <t t-out="total_income.total_income"/>
                                                    </span>
                                                </th>
                                            </t>
                                        </tr>
                                        <tr class="border-bottom border-dark">
                                            <th colspan="6">
                                                <span class="fw-bolder ms-1">
                                                    Expenses
                                                </span>
                                            </th>
                                            <t t-foreach="this.state.datas"
                                               t-as="total_expense"
                                               t-key="total_expense_index">
                                                <th class="text-end">
                                                    <span class="fw-bolder">
                                                        <t t-out="total_expense.total_expense"/>
                                                    </span>
                                                </th>
                                            </t>
                                        </tr>

                                        <!-- EXPENSES -->
                                        <tr class="border-bottom border-gainsboro">
                                            <th colspan="6">
                                                <div data-bs-toggle="collapse"
                                                     data-bs-target=".collapseExpenses"
                                                     class="ms-2 collapsed">
                                                    <a class="btn header">
                                                        <span class="toggle-icon">
                                                            <i class="oi oi-fw" data-icon="arrow_drop_down"/>
                                                        </span>
                                                        <span class="ms-3">
                                                            Expenses
                                                        </span>
                                                    </a>
                                                </div>
                                            </th>
                                            <t t-foreach="this.state.datas" t-as="value" t-key="value_index">
                                                <th class="text-end">
                                                    <span><t t-out="value.expense[1]"/></span>
                                                </th>
                                            </t>
                                        </tr>
                                        <t t-foreach="this.state.datas[0].expense[0]"
                                           t-as="acc"
                                           t-key="acc.account_id">
                                            <tr class="border-bottom border-gainsboro collapse collapseExpenses">
                                                <th colspan="6">
                                                    <span class="dropdown">
                                                        <a class="dropdown-toggle" data-bs-toggle="dropdown">
                                                            <span class="ms-5">
                                                                <t t-out="acc.name"/>
                                                            </span>
                                                        </a>
                                                        <span class="dropdown-menu">
                                                            <a role="menuitem"
                                                               t-att-data-id="acc.account_id"
                                                               t-on-click="this.show_gl"
                                                               class="show_gl">
                                                                General
                                                                Ledger
                                                            </a>
                                                        </span>
                                                    </span>
                                                </th>
                                                <t t-foreach="this.state.datas" t-as="period" t-key="period_index">
                                                    <th class="text-end">
                                                        <span>
                                                            <t t-foreach="period.expense[0]" t-as="pacc"
                                                               t-key="pacc.account_id">
                                                                <t t-if="pacc.account_id == acc.account_id">
                                                                    <t t-out="pacc.amount"/>
                                                                </t>
                                                            </t>
                                                        </span>
                                                    </th>
                                                </t>
                                            </tr>
                                        </t>

                                        <!-- DEPRECIATION -->
                                        <tr class="border-bottom border-gainsboro">
                                            <th colspan="6">
                                                <div data-bs-toggle="collapse"
                                                     data-bs-target=".collapseDepreciation"
                                                     class="ms-2 collapsed">
                                                    <a class="btn header">
                                                        <span class="toggle-icon">
                                                            <i class="oi oi-fw" data-icon="arrow_drop_down"/>
                                                        </span>
                                                        <span class="ms-3">
                                                            Depreciation
                                                        </span>
                                                    </a>
                                                </div>
                                            </th>
                                            <t t-foreach="this.state.datas" t-as="value" t-key="value_index">
                                                <th class="text-end">
                                                    <span><t t-out="value.expense_depreciation[1]"/></span>
                                                </th>
                                            </t>
                                        </tr>
                                        <t t-foreach="this.state.datas[0].expense_depreciation[0]"
                                           t-as="acc"
                                           t-key="acc.account_id">
                                            <tr class="border-bottom border-gainsboro collapse collapseDepreciation">
                                                <th colspan="6">
                                                    <span class="dropdown">
                                                        <a class="dropdown-toggle" data-bs-toggle="dropdown">
                                                            <span class="ms-5">
                                                                <t t-out="acc.name"/>
                                                            </span>
                                                        </a>
                                                        <span class="dropdown-menu">
                                                            <a role="menuitem"
                                                               t-att-data-id="acc.account_id"
                                                               t-on-click="this.show_gl"
                                                               class="show_gl">
                                                                General
                                                                Ledger
                                                            </a>
                                                        </span>
                                                    </span>
                                                </th>
                                                <t t-foreach="this.state.datas" t-as="period" t-key="period_index">
                                                    <th class="text-end">
                                                        <span>
                                                            <t t-foreach="period.expense_depreciation[0]" t-as="pacc"
                                                               t-key="pacc.account_id">
                                                                <t t-if="pacc.account_id == acc.account_id">
                                                                    <t t-out="pacc.amount"/>
                                                                </t>
                                                            </t>
                                                        </span>
                                                    </th>
                                                </t>
                                            </tr>
                                        </t>

                                        <tr class="border-bottom border-gainsboro">
                                            <th colspan="6">
                                                <span class="fw-bolder ms-2">
                                                    Total
                                                    Expenses
                                                </span>
                                            </th>
                                            <t t-foreach="this.state.datas"
                                               t-as="total_expense"
                                               t-key="total_expense_index">
                                                <th class="text-end">
                                                    <span class="fw-bolder">
                                                        <t t-out="total_expense.total_expense"/>
                                                    </span>
                                                </th>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>