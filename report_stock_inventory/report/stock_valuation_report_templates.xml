<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock valuation pdf report template -->
    <template id="report_stock_valuation">
        <t t-call="web.html_container">
            <div class="article">
                <center>
                    <h2>STOCK VALUATION REPORT</h2>
                </center>
                <br/>
                <div class="header">
                    <div class="row text-left"
                         style="border-top: 1px solid black;">
                        <div class="col-3 offset-9 text-right">
                            <ul class="list-inline"
                                style="margin-top:10px;">
                                <li>
                                    <span class="page"/>
                                    /
                                    <span class="topage"/>
                                </li>
                            </ul>
                            <br/>
                            <div>
                                <span class="text-left"
                                      style="color:black;"
                                      t-out="company_name"/>
                                <br/>
                                <span class="text-left"
                                      style="color:black;"
                                      t-out="company_street"/>
                                <br/>
                                <span class="text-left"
                                      style="color:black;"
                                      t-out="state"/>
                                <span class="text-left"
                                      style="color:black;"
                                      t-out="country"/>
                                <br/>
                                <span class="text-left"
                                      style="color:black;"
                                      t-out="company_email"/>
                                <br/>
                            </div>
                        </div>
                    </div>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product Reference</th>
                            <th>Product Name</th>
                            <th>Description</th>
                            <th>Product Category</th>
                            <th>Company Name</th>
                            <th>Quantity</th>
                            <th>Unit Cost</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="stock_valuation" t-as="doc">
                            <tr>
                                <td class="text-center"
                                    style="width: 11%">
                                    <span t-out="doc['create_date']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 11%">
                                    <span t-out="doc['product_ref']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 11%">
                                    <span t-out="doc['name']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 11%">
                                    <span t-out="doc['description']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 11%">
                                    <span t-out="doc['complete_name']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 11%">
                                    <span t-out="doc['company_name']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 11%">
                                    <span t-out="doc['quantity']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 11%">
                                    <span t-out="doc['unit_cost']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 11%">
                                    <span t-out="doc['value']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
