<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    QWeb PDF report template for stock valuation report -->
    <template id="report_stock_valuation">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        .nowrap { white-space: nowrap; }
                        .table-bordered th, .table-bordered td {
                            border: 1px solid black !important;
                        }
                    </style>
                    <center>
                        <h2 class="mt-4">STOCK VALUATION REPORT</h2>
                    </center>
                    <table class="table table-bordered table-sm mt-4">
                        <thead>
                            <tr>
                                <th class="text-center">Date</th>
                                <th class="text-start">Product Name</th>
                                <th class="text-start">Description</th>
                                <th class="text-center">Product Category</th>
                                <th class="text-center">Company Name</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Unit Cost</th>
                                <th class="text-end">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="stock_valuation" t-as="item">
                                <tr>
                                    <td class="text-center">
                                        <span t-esc="item['create_date']"/>
                                    </td>
                                    <td class="text-start">
                                        <span t-esc="item['name']"/>
                                    </td>
                                    <td class="text-start">
                                        <span t-esc="item['description']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="item['complete_name']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="item['company_name']"/>
                                    </td>
                                    <td class="text-end nowrap">
                                        <span t-esc="item['quantity']"/>
                                    </td>
                                    <td class="text-end nowrap">
                                        <span t-esc="item['unit_cost']"/>
                                    </td>
                                    <td class="text-end nowrap">
                                        <span t-esc="item['value']"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
