<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    QWeb PDF report template for stock transfer report -->
    <template id="report_stock_transfer">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        .nowrap { white-space: nowrap; }
                        .table-bordered th, .table-bordered td {
                            border: 1px solid black !important;
                        }
                    </style>
                    <center>
                        <h2 class="mt-4">STOCK TRANSFER REPORT</h2>
                    </center>
                    <table class="table table-bordered table-sm mt-4" style="font-size: 10px;">
                        <thead>
                            <tr>
                                <th class="text-start">Reference</th>
                                <th class="text-start">Product</th>
                                <th class="text-center">Scheduled Date</th>
                                <th class="text-center">Deadline</th>
                                <th class="text-center">Effective Date</th>
                                <th class="text-center">Source Document</th>
                                <th class="text-center">Location</th>
                                <th class="text-center">Operation Type</th>
                                <th class="text-center">Company Name</th>
                                <th class="text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="stock_picking" t-as="item">
                                <tr>
                                    <td class="text-start nowrap">
                                        <span t-esc="item['picking_name']"/>
                                    </td>
                                    <td class="text-start">
                                        <span t-esc="item['product_name']"/>
                                    </td>
                                    <td class="text-center nowrap">
                                        <span t-esc="item['scheduled_date']"/>
                                    </td>
                                    <td class="text-center nowrap">
                                        <span t-esc="item['date_deadline']"/>
                                    </td>
                                    <td class="text-center nowrap">
                                        <span t-esc="item['date_done']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="item['origin']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="item['complete_name']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="item['display_name']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="item['company_name']"/>
                                    </td>
                                    <td class="text-end nowrap">
                                        <span t-esc="status.get(item['state'], item['state'])"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
