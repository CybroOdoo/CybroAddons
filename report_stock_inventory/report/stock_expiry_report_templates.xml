<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    QWeb PDF report template for stock expiry report -->
    <template id="report_stock_expiry">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        .nowrap { white-space: nowrap; }
                        .table-bordered th, .table-bordered td {
                            border: 1px solid black !important;
                        }
                    </style>
                    <center>
                        <h2 class="mt-4">STOCK EXPIRY REPORT</h2>
                        <p>Items expiring before: <span t-esc="expiry_date"/></p>
                    </center>
                    <table class="table table-bordered table-sm mt-4">
                        <thead>
                            <tr>
                                <th class="text-start">Product</th>
                                <th class="text-start">Lot/Serial Number</th>
                                <th class="text-center">Expiration Date</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-start">Location</th>
                                <th class="text-start">Company</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="expiry_data" t-as="item">
                                <tr>
                                    <td class="text-start">
                                        <span t-esc="item['product_name']"/>
                                    </td>
                                    <td class="text-start">
                                        <span t-esc="item['lot_name']"/>
                                    </td>
                                    <td class="text-center nowrap">
                                        <span t-esc="item['expiration_date']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="item['quantity']"/>
                                    </td>
                                    <td class="text-start">
                                        <span t-esc="item['location_name']"/>
                                    </td>
                                    <td class="text-start">
                                        <span t-esc="item['company_name']"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="not expiry_data">
                                <tr>
                                    <td colspan="6" class="text-center">No expiring items found for the selected criteria.</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
