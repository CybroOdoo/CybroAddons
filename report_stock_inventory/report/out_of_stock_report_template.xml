<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock valuation pdf report template -->
    <template id="report_out_of_stock">
        <t t-call="web.html_container">
            <div class="article">
                <center>
                    <h2>OUT OF STOCK REPORT</h2>
                </center>
                <br/>
                <div class="header">
                    <div class="row text-left"
                         style="border-top: 1px solid black;">
                        <div class="col-3 offset-9 text-right">
                            <ul class="list-inline"
                                style="margin-top:10px;">
                                <li>
                                    <span class="page"/>
                                    /
                                    <span class="topage"/>
                                </li>
                            </ul>
                            <br/>
                            <div>
                                <span class="text-left"
                                      style="color:black;"
                                      t-esc="company_name"/>
                                <br/>
                                <span class="text-left"
                                      style="color:black;"
                                      t-esc="company_street"/>
                                <br/>
                                <span class="text-left"
                                      style="color:black;"
                                      t-esc="state"/>
                                <span class="text-left"
                                      style="color:black;"
                                      t-esc="country"/>
                                <br/>
                                <span class="text-left"
                                      style="color:black;"
                                      t-esc="company_email"/>
                                <br/>
                            </div>
                        </div>
                    </div>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>Product Name</th>
                            <th>Product Category</th>
                            <th>Reference</th>
                            <th>Company Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="number" t-value="1"/>
                        <t t-foreach="product_stock" t-as="doc">
                            <tr>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-esc="number"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-esc="doc['name']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-esc="doc['complete_name']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-esc="doc['default_code']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-esc="doc['company_name']"/>
                                </td>
                                <t t-set="number"
                                   t-value="number + 1"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
