<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Report actions for stock inventory PDF reports -->
    <!-- Report action to print stock valuation report -->
    <record id="stock_valuation_report" model="ir.actions.report">
        <field name="name">Stock Valuation Report</field>
        <field name="model">stock.valuation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_stock_inventory.report_stock_valuation</field>
        <field name="report_file">report_stock_inventory.report_stock_valuation</field>
        <field name="binding_model_id" ref="model_stock_valuation_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report action to print stock transfer report -->
    <record id="stock_transfer_report" model="ir.actions.report">
        <field name="name">Stock Transfer Report</field>
        <field name="model">stock.transfer.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_stock_inventory.report_stock_transfer</field>
        <field name="report_file">report_stock_inventory.report_stock_transfer</field>
        <field name="binding_model_id" ref="model_stock_transfer_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report action to print stock expiry report -->
    <record id="stock_expiry_report" model="ir.actions.report">
        <field name="name">Stock Expiry Report</field>
        <field name="model">stock.expiry.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_stock_inventory.report_stock_expiry</field>
        <field name="report_file">report_stock_inventory.report_stock_expiry</field>
        <field name="binding_model_id" ref="model_stock_expiry_report"/>
        <field name="binding_type">report</field>
    </record>
    <!-- Report action to print out of stock report -->
    <record id="stock_out_of_stock_report" model="ir.actions.report">
        <field name="name">Out of Stock Report</field>
        <field name="model">stock.out.of.stock.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_stock_inventory.report_out_of_stock</field>
        <field name="report_file">report_stock_inventory.report_out_of_stock</field>
        <field name="binding_model_id" ref="model_stock_out_of_stock_report"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
