<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    QWeb PDF report template for out of stock report -->
    <template id="report_out_of_stock">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        .nowrap { white-space: nowrap; }
                        .table-bordered th, .table-bordered td {
                            border: 1px solid black !important;
                        }
                    </style>
                    <center>
                        <h2 class="mt-4">OUT OF STOCK REPORT</h2>
                        <p>Company: <span t-esc="company_name"/></p>
                        <t t-if="category_name != 'All Categories'">
                            <p>Category: <span t-esc="category_name"/></p>
                        </t>
                    </center>
                    <table class="table table-bordered table-sm mt-4" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-top: 2px solid black; border-bottom: 2px solid black;">
                                <th class="text-center" style="padding: 8px;">Sl No</th>
                                <th class="text-center" style="padding: 8px;">Product Name</th>
                                <th class="text-center" style="padding: 8px;">Product Category</th>
                                <th class="text-center" style="padding: 8px;">Reference</th>
                                <th class="text-center" style="padding: 8px;">Company Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="out_of_stock_data" t-as="item">
                                <tr>
                                    <td class="text-center" style="padding: 8px;">
                                        <span t-esc="item_index + 1"/>
                                    </td>
                                    <td class="text-center" style="padding: 8px;">
                                        <span t-esc="item['product_name']"/>
                                    </td>
                                    <td class="text-center" style="padding: 8px;">
                                        <span t-esc="item['category_name']"/>
                                    </td>
                                    <td class="text-center" style="padding: 8px;">
                                        <span t-esc="item['default_code']"/>
                                    </td>
                                    <td class="text-center" style="padding: 8px;">
                                        <span t-esc="item['company_name'] or company_name"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="not out_of_stock_data">
                                <tr>
                                    <td colspan="5" class="text-center" style="padding: 8px;">No out of stock items found for the selected criteria.</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
