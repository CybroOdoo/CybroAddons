<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Wizard form view and action for out of stock report -->
    <!-- Wizard form view for out of stock report -->
    <record id="view_out_of_stock_report_wizard" model="ir.ui.view">
        <field name="name">stock.out.of.stock.report.form</field>
        <field name="model">stock.out.of.stock.report</field>
        <field name="arch" type="xml">
            <form string="Out of Stock Report">
                <group>
                    <group>
                        <field name="category_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="action_print_xls_report" string="Print XLS" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for out of stock report wizard -->
    <record id="action_out_of_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">Out of Stock Report</field>
        <field name="res_model">stock.out.of.stock.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
