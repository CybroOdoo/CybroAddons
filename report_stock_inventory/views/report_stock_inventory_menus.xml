<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Menu items for inventory stock reports -->
    <!-- Root Menu for stocks reports (following warehouse_reports module pattern) -->
    <menuitem id="stock_report_root_menu" name="Stock Report"
              sequence="99"
              parent="stock.menu_stock_root">
    </menuitem>

    <!-- Sub-menu for stock valuation report -->
    <menuitem id="stock_valuation_report_menu" name="Stock Valuation Report"
              sequence="25"
              parent="stock_report_root_menu"
              action="stock_valuation_report_action">
    </menuitem>

    <!-- Sub-menu for stock transfer report -->
    <menuitem id="stock_transfer_report_menu" name="Stock Transfer Report"
              sequence="30"
              parent="stock_report_root_menu"
              action="stock_transfer_report_action">
    </menuitem>

    <!-- Sub-menu for stock expiry report -->
    <menuitem id="stock_expiry_report_menu" name="Stock Expiry Report"
              sequence="35"
              parent="stock_report_root_menu"
              action="action_stock_expiry_report_wizard">
    </menuitem>
    <!-- Sub-menu for out of stock report -->
    <menuitem id="out_of_stock_report_menu" name="Out of Stock Report"
              sequence="40"
              parent="stock_report_root_menu"
              action="action_out_of_stock_report_wizard">
    </menuitem>
</odoo>
