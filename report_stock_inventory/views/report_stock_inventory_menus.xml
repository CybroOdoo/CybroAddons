<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menus for stock inventory report -->
    <menuitem id="report_stock_inventory_root_menu" name="Stock Reports"
              sequence="99"
              parent="stock.menu_stock_root">
    </menuitem>
    <!-- Menu for stock valuation report print -->
    <menuitem id="stock_valuation_report_menu" name="Stock Valuation Report"
              sequence="10"
              parent="report_stock_inventory_root_menu"
              action="stock_valuation_report_action">
    </menuitem>
    <!-- Menus for transfer report print -->
    <menuitem id="stock_transfer_report_menu" name="Stock Transfer Report"
              sequence="1"
              parent="report_stock_inventory_root_menu"
              action="stock_transfer_report_action">
    </menuitem>
    <!-- Menus for stock expiry report print -->
    <menuitem id="stock_expiry_report_menu" name="Stock Expiry Report"
              sequence="15"
              parent="report_stock_inventory_root_menu"
              action="stock_expiry_report_action">
    </menuitem>
    <!-- Menu item for out of stock report -->
    <menuitem id="out_of_stock_report_menu" name="Out of Stock Report"
              sequence="15"
              parent="report_stock_inventory_root_menu"
              action="out_of_stock_report_action">
    </menuitem>
    <!-- Menu item for out of inventory at date -->
    <menuitem id="stock_quantity_history_report_menu"
              name="Inventory At Date"
              sequence="5"
              parent="report_stock_inventory_root_menu"
