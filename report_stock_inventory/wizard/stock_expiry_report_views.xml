<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard form view for stock expiry report -->
    <record id="stock_expiry_report_view_form" model="ir.ui.view">
        <field name="name">stock.expiry.report.view.form</field>
        <field name="model">stock.expiry.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_category_id"/>
                            <field name="from_date"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="to_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <!-- Buttons that helps to print excel and pdf reports -->
                    <button name="action_print_pdf_report" string="Print PDF"
                            class="oe_highlight" type="object"/>
                    <button name="action_print_xls_report" string="Print XLS"
                            class="oe_highlight" type="object"/>
                    <button name="cancel" string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--Action for stock expiry report wizard -->
    <record id="stock_expiry_report_action" model="ir.actions.act_window">
        <field name="name">Stock Expiry Report</field>
        <field name="res_model">stock.expiry.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Stock Expiry Report
            </p>
        </field>
    </record>
</odoo>
