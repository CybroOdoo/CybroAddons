<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    Point of Sale Product BOM  list-->
    <record id="pos_product_bom_view_list" model="ir.ui.view">
        <field name="name">pos.product.bom.view.list</field>
        <field name="model">pos.product.bom</field>
        <field name="arch" type="xml">
            <list name="POS Product BOM">
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="reference"/>
                <field name="product_uom_id"/>
            </list>
        </field>
    </record>
    <!--Point of Sale Product BOM form view-->
    <record id="pos_product_bom_view_form" model="ir.ui.view">
        <field name="name">pos.product.bom.view.form</field>
        <field name="model">pos.product.bom</field>
        <field name="arch" type="xml">
            <form string="POS Product Components">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm"
                            invisible="state in ['confirm', 'cancel']"
                            state="draft"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state == 'cancel'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state in ['confirm', 'draft']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" readonly="state in ['confirm', 'cancel']"/>
                            <field name="quantity" readonly="state in ['confirm', 'cancel']"/>
                        </group>
                        <group>
                            <field name="reference" readonly="state in ['confirm', 'cancel']"/>
                            <field name="product_uom_id" readonly="state in ['confirm', 'cancel']"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="POS BOM" name="pos bom">
                            <field name="bom_line_ids" widget="one2many" readonly="state in ['confirm', 'cancel']">
                                <list string="POS product BOM" editable="bottom" >
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!--Point of Sale Product BOM view action-->
    <record id="action_pos_product_bom" model="ir.actions.act_window">
        <field name="name">POS Product Bom</field>
        <field name="res_model">pos.product.bom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Product Components
            </p>
        </field>
    </record>

    <menuitem id="pos_product_bom_menu" parent="point_of_sale.pos_config_menu_catalog"
              name="POS Product Bom" action="action_pos_product_bom" sequence="25"/>
</odoo>