<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Inherited view form of website to add Company Data inside Contact Us-->
    <record id="view_website_form" model="ir.ui.view">
        <field name="name">website.view.form.inherit.website.custom.contact.us
        </field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contact Us" name="contact_us">
                    <group>
                        <group string="Company Data Visibility"
                               name="company_data">
                            <field name="is_company" widget="boolean_toggle"/>
                            <field name="is_address" widget="boolean_toggle"/>
                            <field name="is_phone" widget="boolean_toggle"/>
                            <field name="is_email" widget="boolean_toggle"/>
                            <field name="is_website" widget="boolean_toggle"/>
                            <field name="is_vat" widget="boolean_toggle"/>
                        </group>
                        <group string="Options" name="options">
                            <field name="is_address_in_online"
                                   widget="boolean_toggle"/>
                            <field name="is_hide_marker_icons"
                                   widget="boolean_toggle"/>
                            <field name="is_show_phone_icon"
                                   widget="boolean_toggle"
                                   invisible="is_hide_marker_icons == False"/>
                            <field name="is_country_flag"
                                   widget="boolean_toggle"/>
                        </group>
                    </group>
                    <div>
                        <group string="Social Links" name="social_links">
                            <group>
                                <group>
                                    <label for="is_facebook">Facebook</label>
                                    <div>
                                        <field name="is_facebook"
                                               style="margin-left: 30px;"
                                               widget="boolean_toggle"/>
                                    </div>
                                </group>
                                <group>
                                    <div style="margin-left: -115px !important;;margin-right: 17px;margin-bottom: 0px;padding-top: -4px; width: 240px">
                                        <field name="social_facebook"
                                               nolabel="1"/>
                                    </div>
                                </group>
                                <group>
                                    <label for="is_twitter">Twitter</label>
                                    <div>
                                        <field name="is_twitter"
                                               style="margin-left: 38px;"
                                               widget="boolean_toggle"/>
                                    </div>
                                </group>
                                <group>
                                    <div style="margin-bottom: 0px;padding-top: -4px; width: 200px; margin-left: -115px !important;">
                                        <field name="social_twitter"
                                               nolabel="1"/>
                                    </div>
                                </group>
                                <group>
                                    <label for="is_linked_in">LinkedIn</label>
                                    <div>
                                        <field name="is_linked_in"
                                               style="margin-left: 32px;"
                                               widget="boolean_toggle"/>
                                    </div>
                                </group>
                                <group>
                                    <div style="margin-left: -115px !important;margin-bottom: 0px;padding-top: -4px; width: 2600px">
                                        <field name="social_linked_in"
                                               nolabel="1"/>
                                    </div>
                                </group>
                                <group>
                                    <label for="is_instagram">Instagram</label>
                                    <div>
                                        <field name="is_instagram"
                                               style="margin-left: 22px;"
                                               widget="boolean_toggle"/>
                                    </div>
                                </group>
                                <group>
                                    <div style="margin-left: -115px !important;margin-right: 17px;margin-bottom: 0px;padding-top: -4px; width: 200px">
                                        <field name="social_instagram"
                                               nolabel="1"/>
                                    </div>
                                </group>
                                <group>
                                    <label for="is_git_hub">GitHub</label>
                                    <div>
                                        <field name="is_git_hub"
                                               style="margin-left: 40px;"
                                               widget="boolean_toggle"/>
                                    </div>
                                </group>
                                <group>
                                    <div style="margin-left: -115px !important;margin-right: 17px;margin-bottom: 0px;padding-top: -4px; width: 200px">
                                        <field name="social_git_hub"
                                               nolabel="1"/>
                                    </div>
                                </group>
                            </group>
                        </group>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
