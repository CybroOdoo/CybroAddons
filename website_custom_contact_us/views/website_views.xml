<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherited view form of website to add Company Data inside Contact Us -->
    <record id="view_website_form" model="ir.ui.view">
        <field name="name">website.view.form.inherit.website.custom.contact.us</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contact Us" name="contact_us">
                    <group>
                        <group string="Company Data Visibility" name="company_data">
                            <field name="is_company" widget="boolean_toggle"/>
                            <field name="is_address" widget="boolean_toggle"/>
                            <field name="is_phone" widget="boolean_toggle"/>
                            <field name="is_email" widget="boolean_toggle"/>
                            <field name="is_website" widget="boolean_toggle"/>
                            <field name="is_vat" widget="boolean_toggle"/>
                        </group>
                        <group string="Options" name="options">
                            <field name="is_address_in_oneline" widget="boolean_toggle"/>
                            <field name="is_hide_marker_icons" widget="boolean_toggle"/>
                            <field name="is_show_phone_icon" widget="boolean_toggle" invisible="is_hide_marker_icons"/>
                            <field name="is_country_flag" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Social Links" name="social_links">
                        <group>
                            <label for="is_facebook" string="Facebook"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="is_facebook" widget="boolean_toggle"/>
                                <field name="social_facebook" placeholder="https://www.facebook.com/yourpage"/>
                            </div>
                            <label for="is_twitter" string="Twitter / X"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="is_twitter" widget="boolean_toggle"/>
                                <field name="social_twitter" placeholder="https://twitter.com/youraccount"/>
                            </div>
                            <label for="is_linkedin" string="LinkedIn"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="is_linkedin" widget="boolean_toggle"/>
                                <field name="social_linkedin" placeholder="https://www.linkedin.com/company/yourcompany"/>
                            </div>
                            <label for="is_instagram" string="Instagram"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="is_instagram" widget="boolean_toggle"/>
                                <field name="social_instagram" placeholder="https://www.instagram.com/youraccount"/>
                            </div>
                            <label for="is_github" string="GitHub"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="is_github" widget="boolean_toggle"/>
                                <field name="social_github" placeholder="https://github.com/youraccount"/>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
