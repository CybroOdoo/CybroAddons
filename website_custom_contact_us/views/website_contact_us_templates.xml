<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited template view of website Contact us -->
    <template id="website_contact_template_inherited"
              inherit_id="website.contactus">
        <xpath expr="//img[hasclass('img')]"
               position="replace">
            <t t-set="company_data" t-value="website.company_id"/>
            <t t-set="website_data" t-value="website"/>
            <ul class="list-unstyled mb-0 ps-2">
                <li t-if="website_data.is_company and company_data.name">
                    <t t-out="company_data.name"/>
                </li>
                <li t-if="website_data.is_country_flag and company_data.country_id and company_data.country_id.image_url">
                    <img t-att-src="company_data.country_id.image_url" alt="Country Flag" style="max-height: 24px;"/>
                </li>
                <li t-if="website_data.is_address and (company_data.street or company_data.street2 or company_data.city or company_data.state_id or company_data.zip or company_data.country_id)">
                    <t t-if="not website_data.is_hide_marker_icons">
                        <i class="oi me-2" data-icon="location_on"/>
                    </t>
                    <t t-if="not website_data.is_address_in_oneline">
                        <span class="o_force_ltr">
                            <t t-out="company_data.street"/>
                            <t t-if="company_data.street2"> <t t-out="company_data.street2"/></t>
                            <br/>
                            <div style="margin-left:30px" t-if="company_data.city">
                                <t t-out="company_data.city"/>
                            </div>
                            <div style="margin-left:30px" t-if="company_data.state_id">
                                <t t-out="company_data.state_id.name"/>
                            </div>
                            <div style="margin-left:30px" t-if="company_data.zip">
                                <t t-out="company_data.zip"/>
                            </div>
                            <div style="margin-left:30px" t-if="company_data.country_id">
                                <t t-out="company_data.country_id.name"/>
                            </div>
                        </span>
                    </t>
                    <t t-if="website_data.is_address_in_oneline">
                        <span class="o_force_ltr">
                            <t t-out="company_data.street"/>
                            <t t-if="company_data.street2">, <t t-out="company_data.street2"/></t>
                            <t t-if="company_data.city">, <t t-out="company_data.city"/></t>
                            <t t-if="company_data.state_id">, <t t-out="company_data.state_id.name"/></t>
                            <t t-if="company_data.zip">, <t t-out="company_data.zip"/></t>
                            <t t-if="company_data.country_id">, <t t-out="company_data.country_id.name"/></t>
                        </span>
                    </t>
                </li>
                <li t-if="website_data.is_phone and company_data.phone">
                    <t t-if="not website_data.is_hide_marker_icons and website_data.is_show_phone_icon">
                        <i class="oi me-2" data-icon="phone"/>
                    </t>
                    <a class="o_force_ltr"
                       t-attf-href="tel:{{ company_data.phone }}">
                        <t t-out="company_data.phone"/>
                    </a>
                </li>
                <li t-if="website_data.is_email and company_data.email">
                    <t t-if="not website_data.is_hide_marker_icons">
                        <i class="oi me-2" data-icon="mail"/>
                    </t>
                    <a class="o_force_ltr"
                       t-attf-href="mailto:{{ company_data.email }}">
                        <t t-out="company_data.email"/>
                    </a>
                </li>
                <li t-if="website_data.is_website and company_data.website">
                    <t t-if="not website_data.is_hide_marker_icons">
                        <i class="oi me-2" data-icon="public"/>
                    </t>
                    <a class="o_force_ltr"
                       t-att-href="company_data.website"
                       target="_blank"
                       rel="noopener">
                        <t t-out="company_data.website"/>
                    </a>
                </li>
                <li t-if="website_data.is_vat and company_data.vat">
                    <span class="o_force_ltr">
                        <t t-out="company_data.vat"/>
                    </span>
                </li>
                <li t-if="website_data.is_facebook and website_data.social_facebook" class="mt-2">
                    <i class="oi me-2" data-icon="oi_facebook"/>
                    <a class="o_force_ltr"
                       t-att-href="website_data.social_facebook"
                       target="_blank"
                       rel="noopener">
                        <t t-out="website_data.social_facebook"/>
                    </a>
                </li>
                <li t-if="website_data.is_twitter and website_data.social_twitter">
                    <i class="oi me-2" data-icon="oi_twitter"/>
                    <a class="o_force_ltr"
                       t-att-href="website_data.social_twitter"
                       target="_blank"
                       rel="noopener">
                        <t t-out="website_data.social_twitter"/>
                    </a>
                </li>
                <li t-if="website_data.is_linkedin and website_data.social_linkedin">
                    <i class="oi me-2" data-icon="oi_linkedin"/>
                    <a class="o_force_ltr"
                       t-att-href="website_data.social_linkedin"
                       target="_blank"
                       rel="noopener">
                        <t t-out="website_data.social_linkedin"/>
                    </a>
                </li>
                <li t-if="website_data.is_instagram and website_data.social_instagram">
                    <i class="oi me-2" data-icon="oi_instagram"/>
                    <a class="o_force_ltr"
                       t-att-href="website_data.social_instagram"
                       target="_blank"
                       rel="noopener">
                        <t t-out="website_data.social_instagram"/>
                    </a>
                </li>
                <li t-if="website_data.is_github and website_data.social_github">
                    <i class="oi me-2" data-icon="oi_github"/>
                    <a class="o_force_ltr"
                       t-att-href="website_data.social_github"
                       target="_blank"
                       rel="noopener">
                        <t t-out="website_data.social_github"/>
                    </a>
                </li>
            </ul>
        </xpath>
    </template>
</odoo>
