<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Card of the personal data page in the customer portal -->
    <record id="portal_entry_gdpr" model="portal.entry">
        <field name="name">Personal Data</field>
        <field name="description">Download or delete your personal data</field>
        <field name="url">/my/data_management</field>
        <field name="image" type="bytes" file="portal/static/src/img/portal-connection.svg"/>
        <field name="is_config_card" eval="True"/>
    </record>
</odoo>
