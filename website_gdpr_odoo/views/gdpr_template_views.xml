<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List view of the GDPR templates -->
    <record id="gdpr_template_view_list" model="ir.ui.view">
        <field name="name">gdpr.template.view.list</field>
        <field name="model">gdpr.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="field_ids" widget="many2many_tags"/>
                <field name="allow_messages"/>
            </list>
        </field>
    </record>
    <!-- Form view of the GDPR templates -->
    <record id="gdpr_template_view_form" model="ir.ui.view">
        <field name="name">gdpr.template.view.form</field>
        <field name="model">gdpr.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="field_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="allow_messages"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Short Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action of the GDPR templates -->
    <record id="gdpr_template_action" model="ir.actions.act_window">
        <field name="name">GDPR Templates</field>
        <field name="res_model">gdpr.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a GDPR template</p>
            <p>Choose the contact fields that customers can download or
                delete from their portal.</p>
        </field>
    </record>
    <menuitem id="gdpr_main_root_template" name="GDPR Templates"
              parent="gdpr_main_root" action="gdpr_template_action"
              sequence="2"/>
</odoo>
