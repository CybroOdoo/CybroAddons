<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Personal data of the customer of a GDPR request -->
    <template id="download_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>GDPR Personal Data Report</h2>
                            <h4 class="text-muted" t-out="doc.name"/>
                        </div>
                        <table class="table table-borderless mb-4">
                            <tr>
                                <td class="w-50"><strong>Customer: </strong><span t-out="doc.partner_id.name"/></td>
                                <td class="w-50"><strong>Template: </strong><span t-out="doc.template_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Date: </strong><span t-out="doc.create_date" t-options="{'widget': 'date'}"/></td>
                                <td><strong>Request Type: </strong><span t-field="doc.req_type"/></td>
                            </tr>
                        </table>
                        <h4 class="mb-3">Exported Data</h4>
                        <table class="table table-sm table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th class="w-50">Field</th>
                                    <th class="w-50">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.get_gdpr_data()" t-as="item">
                                    <td><strong t-out="item['name']"/></td>
                                    <td t-out="item['data']"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
