<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    snippet inherit for adding  new snippets  -->
    <template id="theme_levelup_banner_snippet" inherit_id="website.snippets" name="Coffee banner">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]"
               position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_levelup/static/src/images/snippet.icon/Award.png" string="Awards" snippet-group="awards"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_levelup/static/src/images/snippet.icon/service.png" string="Service" snippet-group="service"/>
            <t t-snippet="website.s_snippet_group"
               string="Latest Features" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/feature.png" snippet-group="latest_features"/>
            <t t-snippet="website.s_snippet_group"
               string="Excited" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/excited.png" snippet-group="excited"/>
            <t t-snippet="website.s_snippet_group"
               string="Client" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/client.png" snippet-group="client"/>
            <t t-snippet="website.s_snippet_group"
               string="Client Testimonial" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/testimonial.png" snippet-group="client_testimonial"/>
            <t t-snippet="website.s_snippet_group"
               string="Banner" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/Banner.png" snippet-group="banner"/>
            <t t-snippet="website.s_snippet_group"
               string="Index About" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/About.png" snippet-group="index_about"/>
            <t t-snippet="website.s_snippet_group"
               string="Gallery" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/gallery.png" snippet-group="gallery"/>
            <t t-snippet="website.s_snippet_group"
               string="Latest Blog" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/Blog.png" snippet-group="latest_blog"/>

        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_levelup.awards" string="Awards" group="awards" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/Award.png"/>
            <t t-snippet="theme_levelup.service" string="Service" group="service" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/service.png"/>
            <t t-snippet="theme_levelup.latest_features" string="Latest Features" group="latest_features" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/feature.png"/>
            <t t-snippet="theme_levelup.excited" string="Excited" group="excited" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/excited.png"/>
            <t t-snippet="theme_levelup.client" string="Client" group="client" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/client.png"/>
            <t t-snippet="theme_levelup.client_testimonial" string="Client Testimonial" group="client_testimonial" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/testimonial.png"/>
            <t t-snippet="theme_levelup.banner" string="Banner" group="banner" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/Banner.png"/>
            <t t-snippet="theme_levelup.index_about" string="Index About" group="index_about" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/About.png"/>
            <t t-snippet="theme_levelup.gallery" string="Gallery" group="gallery" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/gallery.png"/>
            <t t-snippet="theme_levelup.latest_blog" string="Latest Blog" group="latest_blog" t-thumbnail="/theme_levelup/static/src/images/snippet.icon/Blog.png"/>
        </xpath>
    </template>
</odoo>