<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="latest_features" name="Features">
        <section class="awards p_top p_bottom" data-snippet="latest_features" data-name="Features">
            <div class="wrapper">
                <div class="container">
                    <div class="row p_top">
                        <div class="col-lg-3 col-md-3 col-12">
                            <h5 class="u_sub_heading_dark">Features</h5>
                        </div>
                        <div class="col-lg-9 col-md-9 col-12">
                            <div class="about_right">
                                <h3 class="bold_heading">
                                    We craft beautifully useful marketing and digital products.
                                </h3>
                                <p class="p_text">
                                    " Minim veniam nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. "
                                </p>
                                <div class="desc_img"></div>
                            </div>
                            <t t-set="uniq" t-value="datetime.datetime.now().microsecond"/>
                            <div class="features_accordion" t-attf-id="accordion_{{uniq}}">
                                <div class="accordion_item">
                                    <div class="accordion_header">
                                        <button class="accordion_btn" type="button" data-bs-toggle="collapse" t-attf-data-bs-target="#acc_content_1_{{uniq}}" aria-expanded="true" t-attf-aria-controls="acc_content_1_{{uniq}}">
                                            DIGITAL &amp; WEB
                                            <span class="accordion_icon"></span>
                                        </button>
                                    </div>
                                    <div t-attf-id="acc_content_1_{{uniq}}" class="accordion_content collapse show" t-attf-data-bs-parent="#accordion_{{uniq}}">
                                        <div class="row">
                                            <div class="col-lg-6 col-md-6 col-12">
                                                <ul>
                                                    <li>Visual Identity</li>
                                                    <li>Brand Messaging</li>
                                                    <li>Publication Design</li>
                                                </ul>
                                            </div>
                                            <div class="col-lg-6 col-md-6 col-12">
                                                <p>
                                                    Minim veniam nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion_item">
                                    <div class="accordion_header">
                                        <button class="accordion_btn collapsed" type="button" data-bs-toggle="collapse" t-attf-data-bs-target="#acc_content_2_{{uniq}}" aria-expanded="false" t-attf-aria-controls="acc_content_2_{{uniq}}">
                                            BRANDING &amp; GRAPHICS
                                            <span class="accordion_icon"></span>
                                        </button>
                                    </div>
                                    <div t-attf-id="acc_content_2_{{uniq}}" class="accordion_content collapse" t-attf-data-bs-parent="#accordion_{{uniq}}">
                                        <div class="row">
                                            <div class="col-12">
                                                <p>Content for Branding &amp; Graphics section goes here.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion_item">
                                    <div class="accordion_header">
                                        <button class="accordion_btn collapsed" type="button" data-bs-toggle="collapse" t-attf-data-bs-target="#acc_content_3_{{uniq}}" aria-expanded="false" t-attf-aria-controls="acc_content_3_{{uniq}}">
                                            MARKETING
                                            <span class="accordion_icon"></span>
                                        </button>
                                    </div>
                                    <div t-attf-id="acc_content_3_{{uniq}}" class="accordion_content collapse" t-attf-data-bs-parent="#accordion_{{uniq}}">
                                        <div class="row">
                                            <div class="col-lg-6 col-md-6 col-12">
                                                <ul>
                                                    <li>Social Media Strategy</li>
                                                    <li>Content Marketing</li>
                                                    <li>SEO Optimization</li>
                                                </ul>
                                            </div>
                                            <div class="col-lg-6 col-md-6 col-12">
                                                <p>
                                                    Marketing solutions to help your business grow and reach your target audience effectively.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion_item">
                                    <div class="accordion_header">
                                        <button class="accordion_btn collapsed" type="button" data-bs-toggle="collapse" t-attf-data-bs-target="#acc_content_4_{{uniq}}" aria-expanded="false" t-attf-aria-controls="acc_content_4_{{uniq}}">
                                            WEB DEVELOPMENT
                                            <span class="accordion_icon"></span>
                                        </button>
                                    </div>
                                    <div t-attf-id="acc_content_4_{{uniq}}" class="accordion_content collapse" t-attf-data-bs-parent="#accordion_{{uniq}}">
                                        <div class="row">
                                            <div class="col-12">
                                                <p>Full-stack web development services to bring your digital vision to life.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <style>
                                .features_accordion {
                                    border: 1px solid #e0e0e0;
                                    border-radius: 8px;
                                    overflow: hidden;
                                }

                                .accordion_item {
                                    border-bottom: 1px solid #e0e0e0;
                                }

                                .accordion_item:last-child {
                                    border-bottom: none;
                                }

                                .accordion_header {
                                    background: #f8f9fa;
                                }

                                .accordion_btn {
                                    width: 100%;
                                    padding: 15px 20px;
                                    background: none;
                                    border: none;
                                    text-align: left;
                                    font-weight: 600;
                                    font-size: 14px;
                                    color: #333;
                                    cursor: pointer;
                                    display: flex;
                                    justify-content: space-between;
                                    align-items: center;
                                    transition: background-color 0.3s ease;
                                }

                                .accordion_btn:hover,
                                .accordion_btn[aria-expanded="true"] {
                                    background: #e9ecef;
                                }

                                .accordion_icon {
                                    font-size: 18px;
                                    font-weight: bold;
                                    color: #007bff;
                                    transition: transform 0.3s ease;
                                }
                                
                                .accordion_icon::after {
                                    content: '+';
                                }
                                
                                .accordion_btn[aria-expanded="true"] .accordion_icon::after {
                                    content: '-';
                                }

                                .accordion_content {
                                    background: white;
                                }

                                .accordion_content.show {
                                    padding: 20px;
                                }

                                .accordion_content ul {
                                    list-style-type: none;
                                    padding: 0;
                                }

                                .accordion_content li {
                                    padding: 5px 0;
                                    border-bottom: 1px solid #f0f0f0;
                                }

                                .accordion_content li:last-child {
                                    border-bottom: none;
                                }
                            </style>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>