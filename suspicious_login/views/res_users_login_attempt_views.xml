<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Login Attempts Tree View -->
    <record id="res_users_login_attempt_view_tree" model="ir.ui.view">
        <field name="name">
            res.users.login.attempt.view.tree
        </field>
        <field name="model">res.users.login.attempt</field>
        <field name="arch" type="xml">
            <tree string="Login attempts" js_class="login_tree_view">
                <field name="user_id"/>
                <field name="status"/>
                <field name="failed_reason" width="7%"/>
                <field name="location"/>
                <field name="ip_address"/>
                <field name="login_time"/>
                <field name="timezone"/>
                <field name="platform" optional="hide"/>
                <field name="browser" optional="hide"/>
            </tree>
        </field>
    </record>
    <!-- Login Attempts Action Window -->
    <record id="res_users_login_attempt_action" model="ir.actions.act_window">
        <field name="name">Login attempts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.users.login.attempt</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No Login attempts.
            </p>
        </field>
    </record>
    <!-- User Login Menu -->
    <menuitem name="User login" id="res_user_menu"
              web_icon="suspicious_login,static/description/icon.png"/>
    <!-- Login Attempts Main Menu -->
    <menuitem name="Login attempts" id="res_users_login_attempt_menu"
              parent="res_user_menu"/>
    <menuitem name="Login attempts" id="res_users_login_attempt_menu_do_stuff"
              parent="res_users_login_attempt_menu"
              action="res_users_login_attempt_action"/>
</odoo>
