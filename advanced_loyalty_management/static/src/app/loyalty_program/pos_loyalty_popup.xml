<templates xml:space="preserve">
    <!-- popup when convert to loyalty is clicked   -->
    <t t-name="advanced_loyalty_management.CustomButtonPopup">
        <Dialog size="'md'" title.translate="Loyalty Cards">
            <div class="popup custom_popup">
                <t t-foreach="this.props.loyalty_points" t-as="card" t-key="card.couponId">
                    <div class="m-3 d-flex align-items-center justify-content-between">
                        <span class="fs-4"><t t-out="card.program.name"/></span>
                        <button class="btn btn-lg btn-primary ms-3"
                                t-on-click="() => this.convertToLoyalty(card.program.id)">Add</button>
                    </div>
                </t>
               <!-- Modal Footer -->
               <div class="footer footer-flex modal-footer justify-content-end">
                    <button type="button" class="btn btn-lg btn-secondary"
                            t-on-click="() => this.props.close()">
                       <t t-out="this.props.closePopup"/>
                    </button>
               </div>
            </div>
         </Dialog>
   </t>
</templates>