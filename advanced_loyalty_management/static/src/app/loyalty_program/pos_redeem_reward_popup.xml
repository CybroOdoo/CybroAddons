<templates xml:space="preserve">
    <!-- Popup when type of reward is redemption , to enter the details of points to get redeemed   -->
    <t t-name="advanced_loyalty_management.RedeemPoint">
        <Dialog size="'md'" title.translate="Redeem Points">
            <div class="popup custom_popup">
                <div class="modal-header justify-content-center">
                    <h2 class="modal-title">
                       <t t-out="this.props.title"/>
                    </h2>
                </div>
                <div class="modal-body custom-form-view">
                    <form>
                        <table class="table table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="p-2 text-start">Max Redemption Points</th>
                                    <th class="p-2 text-start">To redeem</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="p-2 align-middle">
                                        <t t-out="this.props.max_redemption_points"/>
                                    </td>
                                    <td class="p-2 align-middle">
                                        <input class="w-75 form-control" name="customer"
                                               t-on-change="() => this.toRedeem(this)"
                                               t-ref="this.points"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </form>
                </div>
                <div class="footer footer-flex modal-footer justify-content-end">
                    <button
                            class="button btn btn-lg btn-primary"
                            t-on-click="() => this.save(this.props,this)">Add</button>
                    <button
                        type="button"
                        class="button cancel btn btn-lg btn-secondary"
                        t-on-click="() => this.props.close()">
                        Cancel
                    </button>
                </div>
            </div>
       </Dialog>
    </t>
</templates>
