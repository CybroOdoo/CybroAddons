<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <!--a button is added to convert the change to loyalty points  -->
    <t t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-amount')]" position="after">
            <div class="align-self-center ms-5">
                <button class="btn btn-primary btn-lg" t-on-click="() => this.convertLoyalty()"
                        style="background-color: #4CAF50; color: white; border: none; border-radius: 5px;">
                    Convert to Loyalty
                </button>
            </div>
        </xpath>
    </t>
</templates>
