<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="advanced_loyalty_management.SelectPartnerButtonFix"
       t-inherit="point_of_sale.SelectPartnerButton"
       t-inherit-mode="extension">
        <xpath expr="//button/div[@t-elif='this.props.partner']" position="replace">
            <div t-if="this.props.partner and this.props.partner.name"
                 t-out="this.props.partner.name"
                 class="text-truncate text-action"/>
        </xpath>
    </t>
</templates>
