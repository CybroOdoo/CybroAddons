<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="advanced_loyalty_management.PaymentScreenPartnerFix"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//span[hasclass('partner-name')]" position="replace">
            <span class="partner-name">
                <t t-if="currentOrder.getPartner() and currentOrder.getPartner().name" t-esc="currentOrder.getPartner().name"/>
                <t t-else="">Customer</t>
            </span>
        </xpath>
    </t>
</templates>
