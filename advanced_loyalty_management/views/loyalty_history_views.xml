<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_history_view_tree" model="ir.ui.view">
        <field name="name">loyalty.history.view.list.advanced.loyalty.management</field>
        <field name="model">loyalty.history</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" string="Date"/>
                <field name="description"/>
                <field name="issued" sum="Total Issued"/>
                <field name="used" sum="Total Used"/>
                <field name="order_id"/>
            </list>
        </field>
    </record>
</odoo>
