<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Patch NotificationItem to add a star icon for marking favourites on top line above/beside date -->
    <t t-inherit="mail.NotificationItem" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o-mail-NotificationItem-line')][1]" position="inside">
            <t t-set="favChannelId" t-value="this.getChannelId()"/>
            <t t-if="favChannelId">
                <span
                    class="o_NotificationGroup_favourites cursor-pointer ms-2 flex-shrink-0 z-2 align-self-center d-inline-flex align-items-center"
                    t-att-title="this.isFavourite(favChannelId) ? 'Remove from Favourites' : 'Add to Favourites'"
                    t-on-click.stop.prevent="() => this.toggleFavourite(favChannelId)"
                >
                    <i class="oi fs-6" data-icon="star" t-att-class="{
                        'text-warning': this.isFavourite(favChannelId),
                        'text-muted opacity-50': !this.isFavourite(favChannelId)
                    }"/>
                </span>
            </t>
        </xpath>
    </t>
</templates>
