<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Export button on the task form -->
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.odoo.google.tasks.integration</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_sync_task_to_google"
                        string="Export to Google Task"
                        type="object" class="oe_highlight"
                        invisible="not id"/>
            </header>
        </field>
    </record>
    <!-- Export the selected tasks from the task list -->
    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.view.list.inherit.odoo.google.tasks.integration</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <list position="inside">
                <header>
                    <button name="action_sync_task_to_google" type="object"
                            string="Export to Google Task"/>
                </header>
            </list>
        </field>
    </record>
    <!-- Exported and imported tasks -->
    <record id="project_task_view_list" model="ir.ui.view">
        <field name="name">project.task.view.list.google.tasks</field>
        <field name="model">project.task</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_sync_task_to_google" type="object"
                            string="Export to Google Task"/>
                </header>
                <field name="name"/>
                <field name="project_id" optional="show"/>
                <field name="parent_id" optional="show"/>
                <field name="date_deadline"/>
                <field name="is_add_in_gtask"/>
                <field name="is_imported"/>
            </list>
        </field>
    </record>
    <record id="project_task_action" model="ir.actions.act_window">
        <field name="name">Synced and Imported Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('is_add_in_gtask', '=', True), ('is_imported', '=', True)]</field>
        <field name="context">{'create': False}</field>
    </record>
    <record id="action_project_task" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_task_view_list"/>
        <field name="act_window_id" ref="project_task_action"/>
    </record>
    <!-- Project > Google Tasks -->
    <menuitem id="project_task_menu" name="Google Tasks"
              parent="project.menu_main_pm" sequence="20"/>
    <menuitem id="project_task_menu_do_stuff" name="Tasks"
              parent="project_task_menu" sequence="1"
              action="project_task_action"/>
</odoo>
