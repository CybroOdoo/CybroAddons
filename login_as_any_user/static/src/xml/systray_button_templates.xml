<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Adding new button in systray to switch users -->
    <t t-name="login_as_any_user.UserSwitchSystray">
        <button type="button"
                class="o_nav_entry"
                title="Switch User"
                aria-label="Switch User"
                t-on-click="() => this._onClick()">
            <i class="oi oi-filled" data-icon="person" role="img"/>
        </button>
    </t>
</templates>

