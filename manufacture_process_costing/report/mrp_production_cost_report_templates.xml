<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mrp production cost report template -->
    <template id="production_cost_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <span style="font-size:30px;">
                            <strong>Manufacturing Orders -
                                <t t-out="o.name"/>
                            </strong>
                        </span>
                        <table class="table table-borderless">
                            <tr>
                                <td>
                                    <p>
                                        <strong>Product :</strong>
                                        <t t-out="o.product_id.display_name"/>
                                    </p>
                                </td>
                                <td>
                                    <p>
                                        <strong>Deadline Start :</strong>
                                        <t t-out="o.date_start"/>
                                    </p>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <p>
                                        <strong>Quantity To Produce :</strong>
                                        <t t-out="o.product_qty"/>
                                    </p>
                                </td>
                                <td>
                                    <p>
                                        <strong>Responsible :</strong>
                                        <t t-out="o.user_id.name"/>
                                    </p>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <p>
                                        <strong>Bill Of Material :</strong>
                                        <t t-out="o.bom_id.product_tmpl_id.name if o.bom_id else ''"/>
                                    </p>
                                </td>
                                <td>
                                    <p>
                                        <strong>Company :</strong>
                                        <t t-out="o.company_id.name"/>
                                    </p>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <p>
                                        <strong>Source :</strong>
                                        <t t-out="o.origin or ''"/>
                                    </p>
                                </td>
                            </tr>
                        </table>
                        <br/>
                        <span style="font-size:25px;">
                            <strong>Consumed Materials</strong>
                        </span>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Unit Of Measure</th>
                                    <th>To Consume</th>
                                    <th>Consumed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.move_raw_ids" t-as="rec">
                                    <td>
                                        <t t-out="rec.product_id.display_name"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.uom_id.name"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.product_uom_qty"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.quantity"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <br/>
                        <t t-if="o.state == 'done'">
                            <span style="font-size:25px;">
                                <strong>Finished Products</strong>
                            </span>
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Unit Of Measure</th>
                                        <th>Produced</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <t t-out="o.product_id.display_name"/>
                                        </td>
                                        <td>
                                            <t t-out="o.uom_id.name"/>
                                        </td>
                                        <td>
                                            <t t-out="o.qty_produced"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <br/>
                        </t>
                        <span style="font-size:25px;">
                            <strong>Manufacturing Material Cost</strong>
                        </span>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Planned Quantity</th>
                                    <th>Actual Quantity</th>
                                    <th>UOM</th>
                                    <th>Cost/Unit</th>
                                    <th>Total Cost</th>
                                    <th>Total Actual Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.material_cost_ids"
                                    t-as="rec">
                                    <td>
                                        <t t-out="rec.product_id.display_name"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.planned_qty"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.actual_quantity"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.uom_id.name"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.cost_unit"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.total_cost"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.total_actual_cost"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <h6 class="oe_subtotal_footer oe_right">Total Material
                            Cost :
                            <strong>
                                <t t-out="o.total_material_cost"/>
                            </strong>
                        </h6>
                        <h6 class="oe_subtotal_footer oe_right">Total Actual
                            Material Cost :
                            <strong>
                                <t t-out="o.total_actual_material_cost"/>
                            </strong>
                        </h6>
                        <br/>
                        <span style="font-size:25px;">
                            <strong>Manufacturing Labour Cost</strong>
                        </span>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Operation</th>
                                    <th>Work Center</th>
                                    <th>Planned Minute</th>
                                    <th>Actual Minute</th>
                                    <th>Cost/Minute</th>
                                    <th>Total Cost</th>
                                    <th>Total Actual Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.labour_cost_ids"
                                    t-as="rec">
                                    <td>
                                        <t t-out="rec.operation"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.work_center_id.name"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.planned_minute"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.actual_minute"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.cost_minute"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.total_cost"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.total_actual_cost"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <h6 class="oe_subtotal_footer oe_right">Total Labour
                            Cost :
                            <strong>
                                <t t-out="o.total_labour_cost"/>
                            </strong>
                        </h6>
                        <h6 class="oe_subtotal_footer oe_right">Total Actual
                            Labour Cost :
                            <strong>
                                <t t-out="o.total_actual_labour_cost"/>
                            </strong>
                        </h6>
                        <br/>
                        <span style="font-size:25px;">
                            <strong>Manufacturing Overhead Cost</strong>
                        </span>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Operation</th>
                                    <th>Work Center</th>
                                    <th>Planned Minute</th>
                                    <th>Actual Minute</th>
                                    <th>Cost/Minute</th>
                                    <th>Total Cost</th>
                                    <th>Total Actual Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.overhead_cost_ids"
                                    t-as="rec">
                                    <td>
                                        <t t-out="rec.operation"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.work_center_id.name"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.planned_minute"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.actual_minute"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.cost_minute"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.total_cost"/>
                                    </td>
                                    <td>
                                        <t t-out="rec.total_actual_cost"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <h6 class="oe_subtotal_footer oe_right">Total Overhead
                            Cost :
                            <strong>
                                <t t-out="o.total_overhead_cost"/>
                            </strong>
                        </h6>
                        <h6 class="oe_subtotal_footer oe_right">Total Actual
                            Overhead Cost :
                            <strong>
                                <t t-out="o.total_actual_overhead_cost"/>
                            </strong>
                        </h6>
                        <br/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>