<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb template used to generate the Bill Of Materials Cost report -->
    <template id="report_bom_cost">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <span style="font-size:30px;">
                            <strong>Bill Of Materials</strong>
                        </span>
                        <table class="table table-borderless">
                            <tr>
                                <td><p><strong>Product :</strong> <t t-out="o.product_tmpl_id.display_name"/></p></td>
                                <td><p><strong>Reference :</strong> <t t-out="o.code"/></p></td>
                            </tr>
                            <tr>
                                <td><p><strong>Product Variant :</strong> <t t-out="o.product_id.display_name or ''"/></p></td>
                                <td><p><strong>Bom Type :</strong> <t t-out="dict(o._fields['type'].selection).get(o.type, o.type)"/></p></td>
                            </tr>
                            <tr>
                                <td><p><strong>Quantity :</strong> <t t-out="o.product_qty"/></p></td>
                                <td><p><strong>Company :</strong> <t t-out="o.company_id.name"/></p></td>
                            </tr>
                        </table>
                        <br/>
                        <span style="font-size:25px;"><strong>Components</strong></span>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Product Quantity</th>
                                    <th>Product UOM</th>
                                    <th>Variants</th>
                                    <th>Consumed In Operation</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.bom_line_ids" t-as="rec">
                                    <td><t t-out="rec.product_id.display_name"/></td>
                                    <td><t t-out="rec.product_qty"/></td>
                                    <td><t t-out="rec.uom_id.name"/></td>
                                    <td><t t-out="rec.product_tmpl_id.name"/></td>
                                    <td><t t-out="rec.operation_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <br/>
                        <span style="font-size:25px;"><strong>Direct Material Cost</strong></span>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Planned Quantity</th>
                                    <th>UOM</th>
                                    <th>Cost/Unit</th>
                                    <th>Total Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.material_cost_ids" t-as="rec">
                                    <td><t t-out="rec.product_id.display_name"/></td>
                                    <td><t t-out="rec.planned_qty"/></td>
                                    <td><t t-out="rec.uom_id.name"/></td>
                                    <td><t t-out="rec.cost_unit"/></td>
                                    <td><t t-out="rec.total_cost"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h6 class="oe_subtotal_footer oe_right">Total Material Cost :
                            <strong><t t-out="o.total_material_cost"/></strong>
                        </h6>
                        <br/>
                        <span style="font-size:25px;"><strong>Direct Labour Cost</strong></span>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Operation</th>
                                    <th>Work Center</th>
                                    <th>Planned Minute</th>
                                    <th>Cost/Minute</th>
                                    <th>Total Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.labour_cost_ids" t-as="rec">
                                    <td><t t-out="rec.operation"/></td>
                                    <td><t t-out="rec.work_center_id.name"/></td>
                                    <td><t t-out="rec.planned_minute"/></td>
                                    <td><t t-out="rec.cost_minute"/></td>
                                    <td><t t-out="rec.total_cost"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h6 class="oe_subtotal_footer oe_right">Total Labour Cost :
                            <strong><t t-out="o.total_labour_cost"/></strong>
                        </h6>
                        <br/>
                        <span style="font-size:25px;"><strong>Direct Overhead Cost</strong></span>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Operation</th>
                                    <th>Work Center</th>
                                    <th>Planned Minute</th>
                                    <th>Cost/Minute</th>
                                    <th>Total Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.overhead_cost_ids" t-as="rec">
                                    <td><t t-out="rec.operation"/></td>
                                    <td><t t-out="rec.work_center_id.name"/></td>
                                    <td><t t-out="rec.planned_minute"/></td>
                                    <td><t t-out="rec.cost_minute"/></td>
                                    <td><t t-out="rec.total_cost"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h6 class="oe_subtotal_footer oe_right">Total Overhead Cost :
                            <strong><t t-out="o.total_overhead_cost"/></strong>
                        </h6>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>