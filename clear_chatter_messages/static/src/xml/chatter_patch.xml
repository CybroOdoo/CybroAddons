<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[@class='o-mail-Followers d-flex me-1']" position="after">
        <button type="button"
                class="btn btn-link text-action"
                aria-label="Clear Messages"
                title="Clear Messages"
                t-on-click="onClickClearMessages">
                <i class="fa fa-eraser" role="img"/>
            </button>
        </xpath>
    </t>
</templates>