<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Design System page template displaying colors, typography, components, and iconography -->
    <template id="view_design_system" name="Design System">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_vx_feature_hero">
                    <div class="container text-center">
                        <div class="vx-fh-badge mb-3">
                            <i class="bi bi-palette2"/> Foundation
                        </div>
                        <h1 class="vx-fh-title mb-3">
                            Design <span class="gradient-text">System.</span>
                        </h1>
                        <p class="vx-fh-desc mx-auto">
                            The visual language and building blocks of the VoyageX
                            experience. A cohesive set of components, typography, and colors.
                        </p>
                    </div>
                </section>
                <section class="py-5">
                    <div class="container">
                        <h2 class="vx-ds-section-title">Colors</h2>
                        <p class="vx-ds-section-desc mb-4">
                            Our palette is intentionally constrained to keep the focus
                            on travel photography and mapping.
                        </p>
                        <hr class="vx-ds-hr mb-4"/>
                        <div class="row g-3 mb-4">
                            <div class="col-lg-3 col-md-6">
                                <div class="vx-ds-color-card">
                                    <div class="vx-ds-color-swatch" style="background: #0ea5a5;"/>
                                    <div class="vx-ds-color-info">
                                        <div class="vx-ds-color-name">Primary</div>
                                        <div class="vx-ds-color-hex">#0ea5a5</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="vx-ds-color-card">
                                    <div class="vx-ds-color-swatch" style="background: linear-gradient(135deg, #0ea5a5, #e8458b);"/>
                                    <div class="vx-ds-color-info">
                                        <div class="vx-ds-color-name">Accent</div>
                                        <div class="vx-ds-color-hex">#e8458b</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="vx-ds-color-card">
                                    <div class="vx-ds-color-swatch" style="background: #f0fdfa;"/>
                                    <div class="vx-ds-color-info">
                                        <div class="vx-ds-color-name">Background</div>
                                        <div class="vx-ds-color-hex">#f0fdfa</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="vx-ds-color-card">
                                    <div class="vx-ds-color-swatch" style="background: #ffffff; border: 1px solid #eeeeee;"/>
                                    <div class="vx-ds-color-info">
                                        <div class="vx-ds-color-name">Card Surface</div>
                                        <div class="vx-ds-color-hex">#fff</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-lg-3 col-md-6">
                                <div class="vx-ds-color-card">
                                    <div class="vx-ds-color-swatch" style="background: #0f172a;"/>
                                    <div class="vx-ds-color-info">
                                        <div class="vx-ds-color-name">Dark / Text</div>
                                        <div class="vx-ds-color-hex">#0f172a</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="vx-ds-color-card">
                                    <div class="vx-ds-color-swatch" style="background: #64748b;"/>
                                    <div class="vx-ds-color-info">
                                        <div class="vx-ds-color-name">Muted Text</div>
                                        <div class="vx-ds-color-hex">#64748b</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="vx-ds-color-card">
                                    <div class="vx-ds-color-swatch" style="background: #ccfbf1;"/>
                                    <div class="vx-ds-color-info">
                                        <div class="vx-ds-color-name">Border</div>
                                        <div class="vx-ds-color-hex">#ccfbf1</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="vx-ds-color-card">
                                    <div class="vx-ds-color-swatch" style="background: #cb528e;"/>
                                    <div class="vx-ds-color-info">
                                        <div class="vx-ds-color-name">Badge</div>
                                        <div class="vx-ds-color-hex">#cb528e</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5 vx-bg-light">
                    <div class="container">
                        <h2 class="vx-ds-section-title">Typography</h2>
                        <p class="vx-ds-section-desc mb-4">
                            We rely on DM Sans for headings and Inter for body text
                            to ensure maximum readability and personality.
                        </p>
                        <hr class="vx-ds-hr mb-5"/>
                        <div class="vx-ds-type-row">
                            <div class="vx-ds-type-label">Display · 56px / 800</div>
                            <div class="vx-ds-type-sample" style="font-family:'DM Sans',sans-serif; font-size: 48px; font-weight: 800; letter-spacing: -1.5px; line-height: 1.1;">
                                Explore the world.
                            </div>
                        </div>
                        <div class="vx-ds-type-row">
                            <div class="vx-ds-type-label">Heading 1 · 42px / 700</div>
                            <div class="vx-ds-type-sample" style="font-family:'DM Sans',sans-serif; font-size: 36px; font-weight: 700; letter-spacing: -1px; line-height: 1.15;">
                                Plan your next trip.
                            </div>
                        </div>
                        <div class="vx-ds-type-row">
                            <div class="vx-ds-type-label">Heading 2 · 32px / 700</div>
                            <div class="vx-ds-type-sample" style="font-family:'DM Sans',sans-serif; font-size: 28px; font-weight: 700; line-height: 1.2;">
                                Saved Destinations
                            </div>
                        </div>
                        <div class="vx-ds-type-row">
                            <div class="vx-ds-type-label">Body Text · 16px / 400</div>
                            <div class="vx-ds-type-sample" style="font-family:'Inter',sans-serif; font-size: 16px; font-weight: 400; color: #64748b; line-height: 1.7; max-width: 520px;">
                                Discover the beautifully designed interfaces that make
                                VoyageX the ultimate travel companion.
                            </div>
                        </div>
                        <div class="vx-ds-type-row">
                            <div class="vx-ds-type-label">Small · 14px / 500</div>
                            <div class="vx-ds-type-sample" style="font-family:'Inter',sans-serif; font-size: 14px; font-weight: 500;">
                                Download on the App Store
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5">
                    <div class="container">
                        <h2 class="vx-ds-section-title">Components</h2>
                        <p class="vx-ds-section-desc mb-4">
                            Reusable building blocks that construct the VoyageX interface.
                        </p>
                        <hr class="vx-ds-hr mb-4"/>
                        <div class="row g-4">

                            <div class="col-lg-6">
                                <div class="vx-ds-component-card">
                                    <div class="vx-ds-component-label">BUTTONS</div>
                                    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
                                        <a href="#" class="vx-btn-ios" style="font-size:13px; padding: 10px 22px;">
                                            Primary Button
                                        </a>
                                        <a href="#" class="vx-ds-btn-outline">Outline Button</a>
                                        <a href="#" class="vx-ds-btn-ghost">Ghost Button</a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="vx-ds-component-card">
                                    <div class="vx-ds-component-label">BADGES</div>
                                    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
                                        <div class="vx-fh-badge" style="font-size:12px; padding: 4px 14px;">
                                            <i class="bi bi-phone"/> App Gallery
                                        </div>
                                        <div class="vx-fh-badge" style="font-size:12px; padding: 4px 14px;">
                                            <i class="bi bi-stars"/> New Feature
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="vx-ds-component-card">
                                    <div class="vx-ds-component-label">FORM ELEMENTS</div>
                                    <div class="mt-3 d-flex flex-column gap-3" style="max-width: 260px;">
                                        <input type="text" class="vx-ds-input" placeholder="Enter destination..." readonly="readonly"/>
                                        <div class="vx-ds-select">
                                            <span>Tokyo, Japan</span>
                                            <i class="bi bi-chevron-down"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="vx-ds-component-card">
                                    <div class="vx-ds-component-label">SURFACE CARDS</div>
                                    <div class="mt-3">
                                        <div class="vx-ds-surface-card">
                                            <h6 class="mb-1" style="font-family:'DM Sans',sans-serif; font-weight:700; font-size:14px;">
                                                Shinjuku Gyoen National Garden
                                            </h6>
                                            <p class="mb-0" style="font-size:12px; color: #64748b; line-height:1.5;">
                                                A large park and garden in Shinjuku and Shibuya,
                                                Tokyo, Japan.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="py-5 vx-bg-light">
                    <div class="container">
                        <h2 class="vx-ds-section-title">Iconography</h2>
                        <p class="vx-ds-section-desc mb-4">
                            Using the Bootstrap icon set for a clean, consistent, and
                            recognizable visual language.
                        </p>
                        <hr class="vx-ds-hr mb-4"/>
                        <div class="row g-3 mb-3">
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-send"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-building"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-compass"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-airplane"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-calendar3"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-people"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-file-earmark"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-camera"/></div></div>
                        </div>
                        <div class="row g-3">
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-gear"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-bell"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-heart"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-search"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-box-arrow-up"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-three-dots"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-check-circle"/></div></div>
                            <div class="col"><div class="vx-ds-icon-card"><i class="bi bi-plus-lg"/></div></div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <record id="page_design_system" model="theme.website.page">
        <field name="view_id" ref="view_design_system"/>
        <field name="is_published" eval="True"/>
        <field name="url">/design-system</field>
    </record>

</odoo>
