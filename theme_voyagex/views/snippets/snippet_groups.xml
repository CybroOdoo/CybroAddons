<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="voyagex_snippet_groups" inherit_id="website.snippets" name="VoyageX Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_hero.svg"
               string="VoyageX"
               snippet-group="voyagex"/>
        </xpath>
    </template>
</odoo>
