<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX Feature Right Snippet: Content layout with text on left and image on right -->
    <template id="s_vx_feature_right" name="VoyageX Feature Right">
        <section class="o_colored_level s_vx_feature_right py-5 vx-bg-light" data-snippet="theme_voyagex.s_vx_feature_right" data-name="VX Feature Right">
            <div class="container py-4">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6 order-lg-1 order-2">
                        <div class="vx-feature-phone-device">
                            <img src="/theme_voyagex/static/src/img/screen-discovery.png"
                                 alt="Interactive Discovery Map"
                                 class="vx-phone-screen-img"/>
                        </div>
                    </div>
                    <div class="col-lg-6 order-lg-2 order-1">
                        <p class="vx-section-label mb-2">Discovery</p>
                        <h2 class="vx-section-title mb-3">Interactive discovery map</h2>
                        <p class="vx-section-description mb-4">
                            Explore your destination visually. See your saved spots,
                            booked hotels, and recommended areas on an elegant,
                            custom-styled map that makes exploration effortless.
                        </p>
                        <ul class="vx-feature-list">
                            <li><span class="vx-check-circle"/> Custom map pins and colors</li>
                            <li><span class="vx-check-circle"/> Neighborhood safety guides</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
