<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX brand feature section snippet showing press logos -->
    <template id="s_vx_featured" name="VoyageX Featured By">
        <section class="o_colored_level s_vx_featured py-4" data-snippet="theme_voyagex.s_vx_featured" data-name="VX Featured By">
            <div class="oe_structure"/>
            <div class="container">
                <div class="d-flex flex-wrap align-items-center justify-content-center gap-4 gap-lg-5">
                    <span class="vx-featured-label">Featured by</span>
                    <span class="vx-featured-brand">Wanderlust</span>
                    <span class="vx-featured-brand">NomadDaily</span>
                    <span class="vx-featured-brand">The Explorer</span>
                    <span class="vx-featured-brand">AtlasPress</span>
                </div>
            </div>
        </section>
    </template>

    <template id="s_vx_featured_snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_voyagex.s_vx_featured"
               string="VX Featured By"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_featured.svg"
              >
            </t>
        </xpath>
    </template>
</odoo>
