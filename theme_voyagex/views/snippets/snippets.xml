<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX Snippets Registration: Defines the snippet group and structure in the website editor -->
    <template id="voyagex_snippets" inherit_id="website.snippets" name="VoyageX Snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t t-snippet="website.s_snippet_group"
               string="VoyageX"
               snippet-group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_hero.svg"/>
        </xpath>

        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_voyagex.s_vx_hero" string="VX Hero" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_hero.svg">
                <keywords>hero, header, travel</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_featured" string="VX Featured By" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_featured.svg">
                <keywords>featured, brands, logos</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_feature_left" string="VX Feature Left" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_feature_left.svg">
                <keywords>feature, image left, text right</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_feature_right" string="VX Feature Right" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_feature_right.svg">
                <keywords>feature, image right, text left</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_collab_visual" string="VX Collaboration" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_collab_visual.svg">
                <keywords>collaboration, sync, friends</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_gallery" string="VX App Gallery" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_gallery.svg">
                <keywords>gallery, screenshot, carousel</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_cta" string="VX CTA" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_cta.svg">
                <keywords>call to action, download, store</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_feature_hero" string="VX Feature Hero" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_feature_hero.svg">
                <keywords>feature hero, main features</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_more_features" string="VX More Features" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_more_features.svg">
                <keywords>features, grid, icon</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_screen_showcase" string="VX Screen Showcase" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_screen_showcase.svg">
                <keywords>screen, showcase, phone</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_screen_showcase_alt" string="VX Screen Showcase Alt" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_screen_showcase_alt.svg">
                <keywords>screen, showcase, tilt</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_getapp_hero" string="VX Get App Hero" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_getapp_hero.svg">
                <keywords>get app, download, hero</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_qr_download" string="VX QR Download" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_qr_download.svg">
                <keywords>qr code, download, scanner</keywords>
            </t>
            <t t-snippet="theme_voyagex.s_vx_requirements" string="VX Requirements" group="voyagex"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_requirements.svg">
                <keywords>requirements, system, list</keywords>
            </t>
        </xpath>
    </template>
</odoo>
