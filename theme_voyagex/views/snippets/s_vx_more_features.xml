<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX More Features Snippet: Grid of feature cards with icons and descriptions -->
    <template id="s_vx_more_features" name="VoyageX More Features">
        <section class="o_colored_level s_vx_more_features py-5 my-5" data-snippet="theme_voyagex.s_vx_more_features" data-name="VX More Features">
            <div class="container">
                <div class="text-center mb-5">
                    <h2 class="vx-section-title mb-3">And so much more</h2>
                    <p class="vx-section-description mx-auto" style="max-width:480px;">
                        Every little detail considered to make your journey smoother,
                        down to the last pixel.
                    </p>
                </div>
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-more-feature-card">
                            <div class="vx-mf-icon vx-mf-icon-teal">
                                <i class="bi bi-cloud-slash"/>
                            </div>
                            <h5 class="vx-mf-title">Offline Mode</h5>
                            <p class="vx-mf-desc">
                                Access your entire itinerary, maps, and tickets without
                                an internet connection, anywhere in the world.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-more-feature-card">
                            <div class="vx-mf-icon vx-mf-icon-pink">
                                <i class="bi bi-file-earmark-lock2"/>
                            </div>
                            <h5 class="vx-mf-title">Document Vault</h5>
                            <p class="vx-mf-desc">
                                Keep your passport copies, visas, and booking confirmations
                                securely encrypted in one place.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-more-feature-card">
                            <div class="vx-mf-icon vx-mf-icon-purple">
                                <i class="bi bi-stars"/>
                            </div>
                            <h5 class="vx-mf-title">AI Suggestions</h5>
                            <p class="vx-mf-desc">
                                Get personalized, contextual suggestions for restaurants
                                and activities based on your taste and location.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-more-feature-card">
                            <div class="vx-mf-icon vx-mf-icon-teal">
                                <i class="bi bi-smartwatch"/>
                            </div>
                            <h5 class="vx-mf-title">Apple Watch App</h5>
                            <p class="vx-mf-desc">
                                Glance at your wrist for next activity, upcoming flight
                                gate number, or quick walking directions.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-more-feature-card">
                            <div class="vx-mf-icon vx-mf-icon-orange">
                                <i class="bi bi-cloud-sun"/>
                            </div>
                            <h5 class="vx-mf-title">Live Weather</h5>
                            <p class="vx-mf-desc">
                                Smart itinerary adjustments and outfit suggestions based
                                on up-to-date weather predictions.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-more-feature-card">
                            <div class="vx-mf-icon vx-mf-icon-pink">
                                <i class="bi bi-box-arrow-up-right"/>
                            </div>
                            <h5 class="vx-mf-title">Export &amp; Share</h5>
                            <p class="vx-mf-desc">
                                Generate beautiful PDF summaries of your trip to share
                                with family or print out for your records.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
