<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX app screens gallery section snippet -->
    <template id="s_vx_gallery" name="VoyageX App Gallery">
        <section class="o_colored_level s_vx_gallery py-5 my-3" data-snippet="theme_voyagex.s_vx_gallery" data-name="VX App Gallery">
            <div class="oe_structure"/>
            <div class="container text-center">
                <div class="vx-feature-hero-badge mb-3">
                    <i class="bi bi-phone"/> App Gallery
                </div>
                <h2 class="vx-feature-hero-title mb-3">
                    Designed to feel <span class="gradient-text">effortless.</span>
                </h2>
                <p class="vx-feature-hero-desc mx-auto mb-5">
                    Every screen in VoyageX is crafted with obsessive attention
                    to typography, spacing, and interaction design.
                </p>
                <div class="row g-4">
                    <div class="col-lg-3 col-md-6">
                        <div class="vx-gallery-phone mb-3">
                            <img src="/theme_voyagex/static/src/img/gallery-dashboard.png"
                                 alt="Trip Dashboard"
                                 class="vx-gallery-screen-img" loading="lazy"/>
                        </div>
                        <div class="d-flex align-items-center justify-content-between px-1">
                            <div class="text-start">
                                <div class="vx-gallery-item-name">Trip Dashboard</div>
                                <div class="vx-gallery-item-desc">Your daily overview at a glance</div>
                            </div>
                            <i class="bi bi-bookmark text-secondary"/>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="vx-gallery-phone mb-3">
                            <img src="/theme_voyagex/static/src/img/gallery-discover.png"
                                 alt="Discover"
                                 class="vx-gallery-screen-img" loading="lazy"/>
                        </div>
                        <div class="d-flex align-items-center justify-content-between px-1">
                            <div class="text-start">
                                <div class="vx-gallery-item-name">Discover</div>
                                <div class="vx-gallery-item-desc">Find local spots and guides</div>
                            </div>
                            <i class="bi bi-compass text-secondary"/>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="vx-gallery-phone mb-3">
                            <img src="/theme_voyagex/static/src/img/gallery-bookings.png"
                                 alt="Bookings"
                                 class="vx-gallery-screen-img" loading="lazy"/>
                        </div>
                        <div class="d-flex align-items-center justify-content-between px-1">
                            <div class="text-start">
                                <div class="vx-gallery-item-name">Bookings</div>
                                <div class="vx-gallery-item-desc">All reservations in one place</div>
                            </div>
                            <i class="bi bi-calendar3 text-secondary"/>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="vx-gallery-phone mb-3">
                            <img src="/theme_voyagex/static/src/img/gallery-memories.png"
                                 alt="Memories"
                                 class="vx-gallery-screen-img" loading="lazy"/>
                        </div>
                        <div class="d-flex align-items-center justify-content-between px-1">
                            <div class="text-start">
                                <div class="vx-gallery-item-name">Memories</div>
                                <div class="vx-gallery-item-desc">Your past trips archived</div>
                            </div>
                            <i class="bi bi-image text-secondary"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_vx_gallery_snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_voyagex.s_vx_gallery"
               string="VX App Gallery"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_gallery.svg"
              >
            </t>
        </xpath>
    </template>
</odoo>
