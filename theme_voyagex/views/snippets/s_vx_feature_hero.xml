<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX feature hero section snippet -->
    <template id="s_vx_feature_hero" name="VoyageX Feature Hero">
        <section class="o_colored_level s_vx_feature_hero py-5" data-snippet="theme_voyagex.s_vx_feature_hero" data-name="VX Feature Hero">
            <div class="oe_structure"/>
            <div class="container text-center py-5">
                <div class="vx-fh-badge mb-3">
                    <i class="bi bi-gear-wide-connected"/> Complete Toolkit
                </div>
                <h1 class="vx-fh-title mb-3">
                    Powerful tools beautifully <span class="gradient-text">designed.</span>
                </h1>
                <p class="vx-fh-desc mx-auto" style="max-width: 600px;">
                    Discover every feature that makes VoyageX the ultimate travel
                    companion. From planning to experiencing, we've got you covered.
                </p>
            </div>
        </section>
    </template>

    <template id="s_vx_feature_hero_snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_voyagex.s_vx_feature_hero"
               string="VX Feature Hero"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_feature_hero.svg"
              >
            </t>
        </xpath>
    </template>
</odoo>
