<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX Requirements Snippet: System requirements list for the mobile app -->
    <template id="s_vx_requirements" name="VoyageX Requirements">
        <section class="o_colored_level s_vx_requirements py-5 vx-bg-light" data-snippet="theme_voyagex.s_vx_requirements" data-name="VX Requirements">
            <div class="container py-5">
                <div class="text-center mb-5">
                    <h2 class="vx-section-title mb-3">System requirements</h2>
                </div>
                <div class="row g-4 justify-content-center">
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-req-card">
                            <div class="vx-req-icon">
                                <i class="bi bi-apple"/>
                            </div>
                            <h5 class="vx-mf-title">iOS</h5>
                            <ul class="vx-req-list">
                                <li>iOS 16.0 or later</li>
                                <li>iPhone, iPad, iPod touch</li>
                                <li>Apple Watch support</li>
                                <li>120 MB storage</li>
                            </ul>
                            <a href="#" class="vx-req-btn">
                                <i class="bi bi-apple"/> Download for iOS
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-req-card">
                            <div class="vx-req-icon vx-req-icon-green">
                                <i class="bi bi-google-play"/>
                            </div>
                            <h5 class="vx-mf-title">Android</h5>
                            <ul class="vx-req-list">
                                <li>Android 10 or later</li>
                                <li>Phones and tablets</li>
                                <li>Wear OS support</li>
                                <li>95 MB storage</li>
                            </ul>
                            <a href="#" class="vx-req-btn vx-req-btn-outline">
                                <i class="bi bi-google-play"/> Download for Android
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
