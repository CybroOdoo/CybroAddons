<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX collaboration snippet showcasing real-time sync with friends -->
    <template id="s_vx_collab_visual" name="VoyageX Collaboration">
        <section class="o_colored_level s_vx_collab_visual py-5 my-5" data-snippet="theme_voyagex.s_vx_collab_visual" data-name="VX Collaboration">
            <div class="oe_structure"/>
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-5">
                        <p class="vx-section-label mb-2">Collaboration</p>
                        <h2 class="vx-section-title mb-3">Real-time sync with friends</h2>
                        <p class="vx-section-description mb-4">
                            Invite friends to your trip. Everyone can add places,
                            vote on activities, and share expenses in real-time.
                            No more messy spreadsheets or endless chat groups.
                        </p>
                        <ul class="vx-feature-list">
                            <li><span class="vx-check-circle"/> Shared expense tracking</li>
                            <li><span class="vx-check-circle"/> Activity voting system</li>
                        </ul>
                    </div>
                    <div class="col-lg-7">
                        <div class="vx-collab-visual">

                            <div class="vx-collab-board-card">
                                <div class="vx-collab-card-header">Shared inspiration board</div>
                                <div class="vx-collab-board-grid">
                                    <div class="vx-collab-board-thumb" style="background: linear-gradient(135deg, #99f6e4, #0ea5a5);"/>
                                    <div class="vx-collab-board-thumb" style="background: linear-gradient(135deg, #67e8f9, #06b6d4);"/>
                                    <div class="vx-collab-board-thumb" style="background: linear-gradient(135deg, #f9a8d4, #e8458b);"/>
                                    <div class="vx-collab-board-thumb" style="background: linear-gradient(135deg, #a7f3d0, #10b981);"/>
                                </div>
                            </div>

                            <div class="vx-collab-voters-card">
                                <div class="vx-collab-voters-label">Trip collaborators</div>
                                <div class="vx-collab-voters-sub">Votes</div>
                                <div class="vx-collab-voters-title">Beach club shortlist</div>
                                <div class="d-flex align-items-center mb-2">
                                    <span class="vx-avatar-circle vx-av-1"/>
                                    <span class="vx-avatar-circle vx-av-2"/>
                                    <span class="vx-avatar-circle vx-av-3"/>
                                    <span class="vx-avatar-circle vx-av-4"/>
                                </div>
                                <div class="vx-friends-online">
                                    <span class="vx-green-dot"/> 3 friends online
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_vx_collab_visual_snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_voyagex.s_vx_collab_visual"
               string="VX Collaboration"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_collab_visual.svg"
              >
            </t>
        </xpath>
    </template>
</odoo>
