<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX Call To Action (CTA) snippet for downloading the application -->
    <template id="s_vx_cta" name="VoyageX CTA">
        <section class="o_colored_level s_vx_cta px-3 my-5" data-snippet="theme_voyagex.s_vx_cta" data-name="VX CTA">
            <div class="oe_structure"/>
            <div class="container">
                <div class="vx-cta-section p-5">
                    <div class="row align-items-center">
                        <div class="col-lg-6 mb-4 mb-lg-0">
                            <h2 class="vx-cta-title">Ready to transform<br/>how you travel?</h2>
                            <p class="vx-cta-description">
                                Join thousands of modern explorers who have upgraded
                                their travel planning experience with VoyageX.
                            </p>
                        </div>
                        <div class="col-lg-6 text-lg-end">
                            <div class="d-flex gap-3 justify-content-lg-end justify-content-center flex-wrap">
                                <a href="/get-app" class="vx-store-btn vx-store-btn-apple">
                                    <i class="bi bi-apple fs-4"/>
                                    <div>
                                        <span class="vx-store-btn-label">Download on the</span>
                                        <span class="vx-store-btn-name">App Store</span>
                                    </div>
                                </a>
                                <a href="/get-app" class="vx-store-btn vx-store-btn-google">
                                    <i class="bi bi-google-play fs-4"/>
                                    <div>
                                        <span class="vx-store-btn-label">Get it on</span>
                                        <span class="vx-store-btn-name">Google Play</span>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_vx_cta_snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_voyagex.s_vx_cta"
               string="VX CTA"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_cta.svg"
              >
            </t>
        </xpath>
    </template>
</odoo>
