<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX alternative phone frame screen showcase row snippet -->
    <template id="s_vx_screen_showcase_alt" name="VoyageX Screen Showcase Alt">
        <section class="o_colored_level s_vx_screen_showcase_alt py-5 vx-bg-light" data-snippet="theme_voyagex.s_vx_screen_showcase_alt" data-name="VX Screen Showcase Alt">
            <div class="oe_structure"/>
            <div class="container py-5">
                <div class="row g-4 justify-content-center">
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-screen-showcase-card">
                            <div class="screen-showcase-phone">
                                <div class="vx-phone-frame">
                                    <img src="/theme_voyagex/static/src/img/screen-collab.png"
                                         alt="Real-time Sync"
                                         class="vx-phone-screen-img" loading="lazy"/>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h5 class="vx-screen-showcase-name">Real-time Sync</h5>
                            <p class="vx-screen-showcase-desc">
                                Invite friends to add places, vote on activities,
                                and share expenses in real-time.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-screen-showcase-card">
                            <div class="screen-showcase-phone">
                                <div class="vx-phone-frame">
                                    <img src="/theme_voyagex/static/src/img/screen-vault.png"
                                         alt="Document Vault"
                                         class="vx-phone-screen-img" loading="lazy"/>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h5 class="vx-screen-showcase-name">Document Vault</h5>
                            <p class="vx-screen-showcase-desc">
                                Keep your passport copies, visas, and booking
                                confirmations securely encrypted.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-screen-showcase-card">
                            <div class="screen-showcase-phone">
                                <div class="vx-phone-frame">
                                    <img src="/theme_voyagex/static/src/img/screen-ai.png"
                                         alt="AI Suggestions"
                                         class="vx-phone-screen-img" loading="lazy"/>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h5 class="vx-screen-showcase-name">AI Suggestions</h5>
                            <p class="vx-screen-showcase-desc">
                                Get personalized, contextual suggestions for restaurants
                                and activities based on taste.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_vx_screen_showcase_alt_snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_voyagex.s_vx_screen_showcase_alt"
               string="VX Screen Showcase Alt"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_screen_showcase_alt.svg"
              >
            </t>
        </xpath>
    </template>
</odoo>
