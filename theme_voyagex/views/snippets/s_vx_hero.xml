<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX Hero Snippet: Main landing page hero section with phone mockups and CTAs -->
    <template id="s_vx_hero" name="VoyageX Hero">
        <section class="o_colored_level s_vx_hero pt0 pb0" data-snippet="theme_voyagex.s_vx_hero" data-name="VX Hero">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-5 mb-lg-0">
                        <div class="vx-hero-badge mb-3">
                            <i class="bi bi-layers"/> The premium travel planner
                        </div>
                        <h1 class="mb-3">Plan beautiful<br/>trips with one<br/>travel app.</h1>
                        <p class="vx-hero-description mb-4">
                            VoyageX helps modern explorers discover stays, build
                            day-by-day itineraries, and keep every booking
                        </p>
                        <div class="d-flex align-items-center gap-3 mb-5">
                            <a href="/get-app" class="vx-btn-ios">
                                <i class="bi bi-apple"/> Download for iOS
                            </a>
                            <a href="#" class="vx-btn-watch">
                                <span class="vx-play-icon">
                                    <i class="bi bi-play-fill"/>
                                </span>
                                Watch Tour
                            </a>
                        </div>
                        <div class="d-flex gap-5">
                            <div class="vx-stat">
                                <h3>4.9</h3>
                                <p>App Store Rating</p>
                            </div>
                            <div class="vx-stat">
                                <h3>2M+</h3>
                                <p>Trips Planned</p>
                            </div>
                            <div class="vx-stat">
                                <h3>120</h3>
                                <p>Countries</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="vx-hero-phones">
                            <div class="vx-destination-label vx-label-amalfi">
                                <span class="vx-dest-dot"/> Amalfi Coast
                            </div>
                            <div class="vx-destination-label vx-label-sea">
                                <span class="vx-dest-dot"/> Live Route
                            </div>
                            <div class="vx-phone-mockup vx-hero-phone-left">
                                <img src="/theme_voyagex/static/src/img/screen-map.png"
                                     alt="Map Discovery Screen"
                                     class="vx-phone-screen-img"/>
                            </div>
                            <div class="vx-phone-mockup vx-hero-phone-main">
                                <img src="/theme_voyagex/static/src/img/screen-explore.png"
                                     alt="Explore Screen"
                                     class="vx-phone-screen-img"/>
                            </div>
                            <div class="vx-phone-mockup vx-hero-phone-right">
                                <img src="/theme_voyagex/static/src/img/screen-itinerary.png"
                                     alt="Itinerary Screen"
                                     class="vx-phone-screen-img"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
