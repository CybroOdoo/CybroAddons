<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX feature section snippet with visual on the right -->
    <template id="s_vx_feature_left" name="VoyageX Feature Left">
        <section class="o_colored_level s_vx_feature_left py-5 my-5" data-snippet="theme_voyagex.s_vx_feature_left" data-name="VX Feature Left">
            <div class="oe_structure"/>
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <p class="vx-section-label mb-2">Planning</p>
                        <h2 class="vx-section-title mb-3">Visual itinerary builder</h2>
                        <p class="vx-section-description mb-4">
                            Drag and drop locations to build your daily route.
                            VoyageX automatically calculates travel times and organizes
                            your bookings into a beautiful, coherent timeline.
                        </p>
                        <ul class="vx-feature-list">
                            <li><span class="vx-check-circle"/> Smart travel time calculation</li>
                            <li><span class="vx-check-circle"/> Automatic booking imports</li>
                            <li><span class="vx-check-circle"/> Offline access everywhere</li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <div class="vx-feature-phone-device">
                            <img src="/theme_voyagex/static/src/img/screen-planner.png"
                                 alt="Visual Itinerary Builder"
                                 class="vx-phone-screen-img" loading="lazy"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_vx_feature_left_snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_voyagex.s_vx_feature_left"
               string="VX Feature Left"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_feature_left.svg"
              >
            </t>
        </xpath>
    </template>
</odoo>
