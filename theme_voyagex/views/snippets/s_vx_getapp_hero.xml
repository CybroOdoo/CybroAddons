<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX Get App page hero section snippet -->
    <template id="s_vx_getapp_hero" name="VoyageX Get App Hero">
        <section class="o_colored_level s_vx_getapp_hero py-5" data-snippet="theme_voyagex.s_vx_getapp_hero" data-name="VX Get App Hero">
            <div class="oe_structure"/>
            <div class="container py-5">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6 text-center text-lg-start">
                        <div class="vx-fh-badge mb-3">
                            <i class="bi bi-download"/> Download Now
                        </div>
                        <h1 class="vx-getapp-title mb-3">
                            Get VoyageX<br/>on your <span class="gradient-text">device.</span>
                        </h1>
                        <p class="vx-getapp-desc mb-4">
                            Download VoyageX for free and start planning your next
                            adventure. Available on iOS and Android.
                        </p>
                        <div class="d-flex gap-3 flex-wrap justify-content-center justify-content-lg-start mb-5">
                            <a href="#" class="vx-getapp-store-btn">
                                <i class="bi bi-apple"/>
                                <div>
                                    <span class="vx-getapp-store-label">Download on the</span>
                                    <span class="vx-getapp-store-name">App Store</span>
                                </div>
                            </a>
                            <a href="#" class="vx-getapp-store-btn vx-getapp-store-btn-outline">
                                <i class="bi bi-google-play"/>
                                <div>
                                    <span class="vx-getapp-store-label">Get it on</span>
                                    <span class="vx-getapp-store-name">Google Play</span>
                                </div>
                            </a>
                        </div>
                        <div class="d-flex gap-4 justify-content-center justify-content-lg-start">
                            <div>
                                <div class="vx-getapp-stat-value">4.9 <i class="bi bi-star-fill" style="font-size: 14px; color: #fbbf24;"/></div>
                                <div class="vx-getapp-stat-label">App Store Rating</div>
                            </div>
                            <div class="vx-getapp-stat-divider"/>
                            <div>
                                <div class="vx-getapp-stat-value">2M+</div>
                                <div class="vx-getapp-stat-label">Downloads</div>
                            </div>
                            <div class="vx-getapp-stat-divider"/>
                            <div>
                                <div class="vx-getapp-stat-value">120</div>
                                <div class="vx-getapp-stat-label">Countries</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="vx-getapp-phone-wrap">
                            <div class="vx-getapp-phone">
                                <img src="/theme_voyagex/static/src/img/screen-explore.png"
                                     alt="VoyageX App"
                                     class="vx-phone-screen-img" loading="lazy"/>
                            </div>
                            <div class="vx-getapp-float-badge vx-getapp-float-1">
                                <i class="bi bi-geo-alt-fill" style="color: #0ea5a5;"/>
                                <span>Plan trips</span>
                            </div>
                            <div class="vx-getapp-float-badge vx-getapp-float-2">
                                <i class="bi bi-people-fill" style="color: #e8458b;"/>
                                <span>Collaborate</span>
                            </div>
                            <div class="vx-getapp-float-badge vx-getapp-float-3">
                                <i class="bi bi-map-fill" style="color: #f97316;"/>
                                <span>Discover</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_vx_getapp_hero_snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="theme_voyagex.s_vx_getapp_hero"
               string="VX Get App Hero"
               t-thumbnail="/theme_voyagex/static/src/img/snippets/s_vx_getapp_hero.svg"
              >
            </t>
        </xpath>
    </template>
</odoo>
