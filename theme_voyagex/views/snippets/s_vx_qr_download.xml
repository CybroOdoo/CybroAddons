                                    </div>
                                    <p class="vx-qr-label mt-2">Scan to download</p>
                                </div>
                                <div class="col-md-8">
                                    <h3 class="vx-qr-title">Scan the QR code</h3>
                                    <p class="vx-qr-desc mb-3">
                                        Point your phone camera at the QR code to download
                                        VoyageX instantly. No searching required.
                                    </p>
                                    <div class="d-flex flex-column gap-2">
                                        <div class="vx-qr-step">
                                            <span class="vx-step-num">1</span>
                                            <span>Open your phone camera</span>
                                        </div>
                                        <div class="vx-qr-step">
                                            <span class="vx-step-num">2</span>
                                            <span>Point at the QR code</span>
                                        </div>
                                        <div class="vx-qr-step">
                                            <span class="vx-step-num">3</span>
                                            <span>Tap the notification to download</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
