<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX QR Download Snippet: Section with QR code for quick app store access -->
    <template id="s_vx_qr_download" name="VoyageX QR Download">
        <section class="o_colored_level s_vx_qr_download py-5 vx-bg-light" data-snippet="theme_voyagex.s_vx_qr_download" data-name="VX QR Download">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="vx-qr-card">
                            <div class="row align-items-center g-4">
                                <div class="col-md-4 text-center">
                                    <div class="vx-qr-box">
                                        <svg width="140" height="140" viewBox="0 0 140 140" fill="none">
                                            <rect width="140" height="140" rx="8" fill="white"/>
                                            <rect x="12" y="12" width="36" height="36" rx="4" fill="#0f172a"/>
                                            <rect x="18" y="18" width="24" height="24" rx="2" fill="white"/>
                                            <rect x="24" y="24" width="12" height="12" rx="1" fill="#0f172a"/>
                                            <rect x="92" y="12" width="36" height="36" rx="4" fill="#0f172a"/>
                                            <rect x="98" y="18" width="24" height="24" rx="2" fill="white"/>
                                            <rect x="104" y="24" width="12" height="12" rx="1" fill="#0f172a"/>
                                            <rect x="12" y="92" width="36" height="36" rx="4" fill="#0f172a"/>
