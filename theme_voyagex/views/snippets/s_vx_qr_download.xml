                                            <rect x="68" y="40" width="8" height="8" rx="1" fill="#0ea5a5"/>
                                            <rect x="80" y="40" width="8" height="8" rx="1" fill="#0f172a"/>
                                            <rect x="56" y="56" width="8" height="8" rx="1" fill="#0ea5a5"/>
                                            <rect x="68" y="56" width="8" height="8" rx="1" fill="#0f172a"/>
                                            <rect x="80" y="56" width="8" height="8" rx="1" fill="#0ea5a5"/>
                                            <rect x="92" y="56" width="8" height="8" rx="1" fill="#0f172a"/>
                                            <rect x="56" y="80" width="8" height="8" rx="1" fill="#0ea5a5"/>
                                            <rect x="68" y="80" width="8" height="8" rx="1" fill="#0f172a"/>
