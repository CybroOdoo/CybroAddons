<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VoyageX Screen Showcase Snippet: Card layout with phone mockup and 3D hover effects -->
    <template id="s_vx_screen_showcase" name="VoyageX Screen Showcase">
        <section class="o_colored_level s_vx_screen_showcase py-5" data-snippet="theme_voyagex.s_vx_screen_showcase" data-name="VX Screen Showcase">
            <div class="container">
                <div class="row g-4 justify-content-center">
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-screen-showcase-card">
                            <div class="screen-showcase-phone">
                                <div class="vx-phone-frame">
                                    <img src="/theme_voyagex/static/src/img/screen-discovery.png"
                                         alt="Interactive Map"
                                         class="vx-phone-screen-img"/>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h5 class="vx-screen-showcase-name">Interactive Map</h5>
                            <p class="vx-screen-showcase-desc">
                                Explore destinations visually with our elegant,
                                custom-styled map and saved spots.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-screen-showcase-card">
                            <div class="screen-showcase-phone">
                                <div class="vx-phone-frame">
                                    <img src="/theme_voyagex/static/src/img/screen-planner.png"
                                         alt="Visual Itinerary"
                                         class="vx-phone-screen-img"/>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h5 class="vx-screen-showcase-name">Visual Itinerary</h5>
                            <p class="vx-screen-showcase-desc">
                                Drag and drop locations to build your daily route
                                into a beautiful, coherent timeline.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="vx-screen-showcase-card">
                            <div class="screen-showcase-phone">
                                <div class="vx-phone-frame">
                                    <img src="/theme_voyagex/static/src/img/screen-budget.png"
                                         alt="Budget Tracking"
                                         class="vx-phone-screen-img"/>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h5 class="vx-screen-showcase-name">Budget Tracking</h5>
                            <p class="vx-screen-showcase-desc">
                                Keep your travel expenses in check without the math.
                                Set a budget and log expenses.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
