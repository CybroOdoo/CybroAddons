<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VoyageX Features Page Template: Provides a detailed overview of theme features such as planning, discovery, and collaboration -->
    <template id="view_features" name="Features">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure"/>
                <!-- Feature Hero -->
                <t t-snippet-call="theme_voyagex.s_vx_feature_hero"/>

                <div class="oe_structure"/>

                <!-- Planning — Feature Left -->
                <t t-snippet-call="theme_voyagex.s_vx_feature_left"/>

                <!-- Discovery — Feature Right -->
                <t t-snippet-call="theme_voyagex.s_vx_feature_right"/>

                <div class="oe_structure"/>

                <!-- Collaboration -->
                <t t-snippet-call="theme_voyagex.s_vx_collab_visual"/>

                <!-- Finance — Feature Right (reuse with budget screen) -->
                <section class="s_vx_feature_right py-5 my-3 vx-bg-light">
                    <div class="container py-4">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-6 order-lg-1 order-2">
                                <div class="vx-feature-phone-device">
                                    <img src="/theme_voyagex/static/src/img/screen-budget.png"
                                         alt="Smart Budget Tracking"
                                         class="vx-phone-screen-img" loading="lazy"/>
                                </div>
                            </div>
                            <div class="col-lg-6 order-lg-2 order-1">
                                <p class="vx-section-label mb-2">Finance</p>
                                <h2 class="vx-section-title mb-3">Smart budget tracking</h2>
                                <p class="vx-section-description mb-4">
                                    Keep your travel expenses in check without the math.
                                    Set a trip budget, log expenses in multiple currencies,
                                    and let VoyageX handle the conversions and split costs
                                    among friends.
                                </p>
                                <ul class="vx-feature-list">
                                    <li><span class="vx-check-circle"/> Automatic currency conversion</li>
                                    <li><span class="vx-check-circle"/> Split bills with one tap</li>
                                    <li><span class="vx-check-circle"/> Visual spending analytics</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure"/>

                <!-- More Features Grid -->
                <t t-snippet-call="theme_voyagex.s_vx_more_features"/>

                <!-- CTA -->
                <t t-snippet-call="theme_voyagex.s_vx_cta"/>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    <record id="page_features" model="theme.website.page">
        <field name="view_id" ref="view_features"/>
        <field name="is_published" eval="True"/>
        <field name="url">/features</field>
    </record>
</odoo>
