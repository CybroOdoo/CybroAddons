<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VoyageX Get App Page Template: Landing page for app downloads, including QR codes and system requirements -->
    <template id="view_getapp" name="Get the App">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure"/>
                <!-- Get App Hero -->
                <t t-snippet-call="theme_voyagex.s_vx_getapp_hero"/>
                
                <div class="oe_structure"/>

                <!-- QR Code Section -->
                <t t-snippet-call="theme_voyagex.s_vx_qr_download"/>

                <!-- Why Download VoyageX -->
                <section class="s_vx_more_features py-5">
                    <div class="container">
                        <div class="text-center mb-5">
                            <h2 class="vx-section-title mb-3">Why download VoyageX?</h2>
                            <p class="vx-section-description mx-auto" style="max-width: 480px;">
                                Everything you need for the perfect trip, right in your pocket.
                            </p>
                        </div>
                        <div class="row g-4">
                            <div class="col-lg-4 col-md-6">
                                <div class="vx-more-feature-card text-center">
                                    <div class="vx-mf-icon vx-mf-icon-teal mx-auto">
                                        <i class="bi bi-map"/>
                                    </div>
                                    <h5 class="vx-mf-title">Plan Visually</h5>
                                    <p class="vx-mf-desc">
                                        Build day-by-day itineraries with drag and drop.
                                        See your entire trip at a glance on a beautiful timeline.
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <div class="vx-more-feature-card text-center">
                                    <div class="vx-mf-icon vx-mf-icon-pink mx-auto">
                                        <i class="bi bi-people"/>
                                    </div>
                                    <h5 class="vx-mf-title">Travel Together</h5>
                                    <p class="vx-mf-desc">
                                        Invite friends, vote on activities, split expenses,
                                        and share moments all in one place.
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <div class="vx-more-feature-card text-center">
                                    <div class="vx-mf-icon vx-mf-icon-orange mx-auto">
                                        <i class="bi bi-cloud-slash"/>
                                    </div>
                                    <h5 class="vx-mf-title">Works Offline</h5>
                                    <p class="vx-mf-desc">
                                        Access your itinerary, maps, and tickets even without
                                        internet. Perfect for international travel.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                
                <div class="oe_structure"/>

                <!-- System Requirements -->
                <t t-snippet-call="theme_voyagex.s_vx_requirements"/>

                <!-- CTA -->
                <t t-snippet-call="theme_voyagex.s_vx_cta"/>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    <record id="page_getapp" model="theme.website.page">
        <field name="view_id" ref="view_getapp"/>
        <field name="is_published" eval="True"/>
        <field name="url">/get-app</field>
    </record>
</odoo>
