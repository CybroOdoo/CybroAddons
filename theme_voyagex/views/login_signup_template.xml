<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Login Layout to apply VoyageX design to all auth pages -->
    <template id="login_layout" inherit_id="web.login_layout" name="VoyageX Login Layout" priority="99">
        <xpath expr="." position="replace">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <section class="vx-login-section">
                        <div class="container">
                            <div class="row justify-content-center align-items-center">
                                <div class="col-lg-5 col-md-7 col-sm-10">
                                    <div class="vx-login-card">
                                        <div class="text-center mb-4">
                                            <div class="vx-login-avatar mb-3">
                                                <i t-attf-class="bi {{ 'bi-person-plus' if '/signup' in request.httprequest.path else ('bi-shield-lock' if '/reset_password' in request.httprequest.path else 'bi-person') }}"/>
                                            </div>
                                            <h2 class="vx-login-title">
                                                <t t-if="'/signup' in request.httprequest.path">Create your account</t>
                                                <t t-elif="'/reset_password' in request.httprequest.path">Reset Password</t>
                                                <t t-else="">Log in to VoyageX</t>
                                            </h2>
                                            <p class="vx-login-subtitle">
                                                <t t-if="'/signup' in request.httprequest.path">Start planning your next adventure</t>
                                                <t t-elif="'/reset_password' in request.httprequest.path">Enter your email to reset your password</t>
                                                <t t-else="">Enter your credentials to continue</t>
                                            </p>
                                        </div>

                                        <t t-out="0"/>
                                        
                                        <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                                            <t t-if="not disable_database_manager">
                                                <a class="border-end pe-2 me-1" href="/web/database/manager">Manage Databases</a>
                                            </t>
                                            <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" target="_blank">Powered by <span>Odoo</span></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Styling the Login Form -->
    <template id="login" inherit_id="web.login" name="VoyageX Login Style">
        <xpath expr="//form" position="attributes">
            <attribute name="class" add="vx-login-form" separator=" "/>
        </xpath>
        <xpath expr="//label[@for='login']" position="attributes">
            <attribute name="class" add="vx-login-label" separator=" "/>
        </xpath>
        <xpath expr="//input[@id='login']" position="attributes">
            <attribute name="class" add="vx-login-input-simple" separator=" "/>
        </xpath>
        <xpath expr="//label[@for='password']" position="attributes">
            <attribute name="class" add="vx-login-label" separator=" "/>
        </xpath>
        <xpath expr="//input[@id='password']" position="attributes">
            <attribute name="class" add="vx-login-input-simple" separator=" "/>
        </xpath>
        <xpath expr="//button[@type='submit']" position="attributes">
            <attribute name="class" add="vx-login-submit-btn w-100" separator=" "/>
        </xpath>
    </template>

    <!-- Styling the Signup Form -->
    <template id="signup" inherit_id="auth_signup.signup" name="VoyageX Signup Style">
        <xpath expr="//form" position="attributes">
            <attribute name="class" add="vx-login-form" separator=" "/>
        </xpath>
        <xpath expr="//button[@type='submit']" position="attributes">
            <attribute name="class" add="vx-login-submit-btn w-100" separator=" "/>
        </xpath>
    </template>

    <!-- Styling the Fields (used in signup and reset password) -->
    <template id="fields" inherit_id="auth_signup.fields" name="VoyageX Fields Style">
        <xpath expr="//label" position="attributes">
            <attribute name="class" add="vx-login-label" separator=" "/>
        </xpath>
        <xpath expr="//input" position="attributes">
            <attribute name="class" add="vx-login-input-simple" separator=" "/>
        </xpath>
    </template>
</odoo>
