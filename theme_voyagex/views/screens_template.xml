<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Screens page template showcasing various application interface mockups -->
    <template id="view_screens" name="Screens">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_vx_feature_hero">
                    <div class="container text-center">
                        <div class="vx-fh-badge mb-3">
                            <i class="bi bi-phone"/> App Gallery
                        </div>
                        <h1 class="vx-fh-title mb-3">
                            Explore the <span class="gradient-text">screens.</span>
                        </h1>
                        <p class="vx-fh-desc mx-auto">
                            Discover the beautifully designed interfaces that make
                            VoyageX the ultimate travel companion. Clean, intuitive,
                            and built for modern explorers.
                        </p>
                    </div>
                </section>
                <t t-call="theme_voyagex.s_vx_screen_showcase"/>
                <t t-call="theme_voyagex.s_vx_screen_showcase_alt"/>
                <t t-call="theme_voyagex.s_vx_cta"/>
            </div>
        </t>
    </template>

    <record id="page_screens" model="theme.website.page">
        <field name="view_id" ref="view_screens"/>
        <field name="is_published" eval="True"/>
        <field name="url">/screens</field>
    </record>

</odoo>
