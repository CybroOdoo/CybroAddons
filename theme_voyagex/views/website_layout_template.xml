<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bootstrap Icons CDN: Includes the Bootstrap icons library in the website head -->
    <template id="vx_bootstrap_icons" inherit_id="website.layout" name="VoyageX Bootstrap Icons">
        <xpath expr="//head" position="inside">
            <link rel="stylesheet"
                  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
        </xpath>
    </template>
</odoo>
