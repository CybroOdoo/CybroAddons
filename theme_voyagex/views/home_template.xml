<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Homepage template calling the VoyageX hero, features, collaboration, and gallery snippets -->
    <template id="view_home" name="VoyageX Home">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <t t-call="theme_voyagex.s_vx_hero"/>
                <t t-call="theme_voyagex.s_vx_featured"/>
                <t t-call="theme_voyagex.s_vx_feature_left"/>
                <t t-call="theme_voyagex.s_vx_feature_right"/>
                <t t-call="theme_voyagex.s_vx_collab_visual"/>
                <t t-call="theme_voyagex.s_vx_gallery"/>
                <t t-call="theme_voyagex.s_vx_cta"/>
            </div>
        </t>
    </template>

    <record id="page_home" model="theme.website.page">
        <field name="view_id" ref="view_home"/>
        <field name="is_published" eval="True"/>
        <field name="url">/</field>
    </record>

</odoo>
