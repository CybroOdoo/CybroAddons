<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VoyageX Homepage Template: Main landing page configured as a theme.website.page for Odoo 18 compatibility -->
    <template id="view_home" name="VoyageX Home">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure"/>
                <!-- Hero Section -->
                <t t-snippet-call="theme_voyagex.s_vx_hero"/>
                
                <!-- Featured By -->
                <t t-snippet-call="theme_voyagex.s_vx_featured"/>
                
                <div class="oe_structure"/>

                <!-- Planning — Feature Left (text left, phone right) -->
                <t t-snippet-call="theme_voyagex.s_vx_feature_left"/>

                <!-- Discovery — Feature Right (phone left, text right) -->
                <t t-snippet-call="theme_voyagex.s_vx_feature_right"/>
                
                <div class="oe_structure"/>

                <!-- Collaboration -->
                <t t-snippet-call="theme_voyagex.s_vx_collab_visual"/>

                <!-- App Gallery -->
                <t t-snippet-call="theme_voyagex.s_vx_gallery"/>
                
                <div class="oe_structure"/>

                <!-- CTA -->
                <t t-snippet-call="theme_voyagex.s_vx_cta"/>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    <record id="page_home" model="theme.website.page">
        <field name="view_id" ref="view_home"/>
        <field name="is_published" eval="True"/>
        <field name="url">/</field>
    </record>
</odoo>
