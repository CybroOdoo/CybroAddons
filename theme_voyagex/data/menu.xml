<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         NAVIGATION MENU
         Design navbar: Overview | Features | Screens | Design System
         Note: Rename the default "Home" to "Overview" via the
         website editor after installation.
         ============================================================ -->

    <record id="menu_features" model="website.menu">
        <field name="name">Features</field>
        <field name="url">/features</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">20</field>
    </record>

    <record id="menu_screens" model="website.menu">
        <field name="name">Screens</field>
        <field name="url">/screens</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">30</field>
    </record>

    <record id="menu_design_system" model="website.menu">
        <field name="name">Design System</field>
        <field name="url">/design-system</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">40</field>
    </record>

</odoo>
