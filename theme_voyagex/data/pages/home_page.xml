<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         HOMEPAGE — Inherits website.homepage
         Sections: Hero → Featured → Planning → Discovery →
                   Collaboration → App Gallery → CTA
         ============================================================ -->
    <template id="view_home" inherit_id="website.homepage" name="VoyageX Home">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="oe_structure" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="inside">
            <!-- Hero Section -->
            <t t-snippet-call="theme_voyagex.s_vx_hero"/>

            <!-- Featured By -->
            <t t-snippet-call="theme_voyagex.s_vx_featured"/>

            <!-- Planning — Feature Left (text left, phone right) -->
            <t t-snippet-call="theme_voyagex.s_vx_feature_left"/>

            <!-- Discovery — Feature Right (phone left, text right) -->
            <t t-snippet-call="theme_voyagex.s_vx_feature_right"/>

            <!-- Collaboration -->
            <t t-snippet-call="theme_voyagex.s_vx_collab_visual"/>

            <!-- App Gallery -->
            <t t-snippet-call="theme_voyagex.s_vx_gallery"/>

            <!-- CTA -->
            <t t-snippet-call="theme_voyagex.s_vx_cta"/>
        </xpath>
    </template>

</odoo>
