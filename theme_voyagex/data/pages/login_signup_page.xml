<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         LOGIN PAGE — theme.website.page (standalone themed login)
         This is a visual page, not overriding the actual auth flow.
         Uses Odoo's built-in /web/login for actual auth.
         ============================================================ -->
    <template id="view_login" name="Login">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">

                <section class="vx-login-section">
                    <div class="container">
                        <div class="row justify-content-center align-items-center">
                            <div class="col-lg-5 col-md-7 col-sm-10">
                                <div class="vx-login-card">
                                    <div class="text-center mb-4">
                                        <div class="vx-login-avatar mb-3">
                                            <i class="bi bi-person"/>
                                        </div>
                                        <h2 class="vx-login-title">Log in to VoyageX</h2>
                                        <p class="vx-login-subtitle">Enter your credentials to continue</p>
                                    </div>

                                    <!-- Social login -->
                                    <div class="d-flex flex-column gap-2 mb-4">
                                        <button class="vx-login-social-btn" type="button">
                                            <i class="bi bi-google"/> Continue with Google
                                        </button>
                                    </div>

                                    <!-- Divider -->
                                    <div class="vx-login-divider mb-4">
                                        <span>or</span>
                                    </div>

                                    <!-- Form -->
                                    <div class="mb-3">
                                        <label class="vx-login-label">Email address</label>
                                        <div class="vx-login-input-wrap">
                                            <i class="bi bi-envelope"/>
                                            <input type="email" class="vx-login-input"
                                                   placeholder="you@example.com"/>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <label class="vx-login-label">Password</label>
                                            <a href="#" class="vx-login-forgot">Forgot password?</a>
                                        </div>
                                        <div class="vx-login-input-wrap">
                                            <i class="bi bi-lock"/>
                                            <input type="password" class="vx-login-input vx-password-input"
                                                   placeholder="Enter your password"/>
                                            <button type="button" class="vx-login-eye-btn">
                                                <i class="bi bi-eye-slash"/>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Remember me -->
                                    <div class="d-flex align-items-center gap-2 mb-4">
                                        <input type="checkbox" class="vx-login-checkbox"/>
                                        <label class="vx-login-label" style="margin-bottom:0;">
                                            Remember me
                                        </label>
                                    </div>

                                    <!-- Submit -->
                                    <a href="/web/login" class="vx-login-submit-btn w-100 mb-3 text-center d-block text-decoration-none">
                                        Log in
                                    </a>

                                    <!-- Sign up link -->
                                    <p class="text-center vx-login-signup-text">
                                        Don't have an account?
                                        <a href="/signup" class="vx-login-signup-link">Sign up free</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <record id="page_login" model="theme.website.page">
        <field name="view_id" ref="view_login"/>
        <field name="is_published" eval="True"/>
        <field name="url">/login</field>
    </record>

    <!-- ============================================================
         SIGNUP PAGE — theme.website.page
         ============================================================ -->
    <template id="view_signup" name="Sign Up">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">

                <section class="vx-login-section">
                    <div class="container">
                        <div class="row justify-content-center align-items-center">
                            <div class="col-lg-5 col-md-7 col-sm-10">
                                <div class="vx-login-card">
                                    <div class="text-center mb-4">
                                        <div class="vx-login-avatar mb-3">
                                            <i class="bi bi-person-plus"/>
                                        </div>
                                        <h2 class="vx-login-title">Create your account</h2>
                                        <p class="vx-login-subtitle">Start planning your next adventure</p>
                                    </div>

                                    <!-- Social signup -->
                                    <div class="d-flex flex-column gap-2 mb-4">
                                        <button class="vx-login-social-btn" type="button">
                                            <i class="bi bi-google"/> Sign up with Google
                                        </button>
                                    </div>

                                    <div class="vx-login-divider mb-4">
                                        <span>or</span>
                                    </div>

                                    <!-- Full name -->
                                    <div class="mb-3">
                                        <label class="vx-login-label">Full name</label>
                                        <div class="vx-login-input-wrap">
                                            <i class="bi bi-person"/>
                                            <input type="text" class="vx-login-input"
                                                   placeholder="John Doe"/>
                                        </div>
                                    </div>

                                    <!-- Email -->
                                    <div class="mb-3">
                                        <label class="vx-login-label">Email address</label>
                                        <div class="vx-login-input-wrap">
                                            <i class="bi bi-envelope"/>
                                            <input type="email" class="vx-login-input"
                                                   placeholder="you@example.com"/>
                                        </div>
                                    </div>

                                    <!-- Password -->
                                    <div class="mb-3">
                                        <label class="vx-login-label">Password</label>
                                        <div class="vx-login-input-wrap">
                                            <i class="bi bi-lock"/>
                                            <input type="password" class="vx-login-input vx-password-input"
                                                   placeholder="Create a password"/>
                                            <button type="button" class="vx-login-eye-btn">
                                                <i class="bi bi-eye-slash"/>
                                            </button>
                                        </div>
                                        <div class="vx-login-hint mt-1">Must be at least 8 characters</div>
                                    </div>

                                    <!-- Terms -->
                                    <div class="d-flex align-items-start gap-2 mb-4">
                                        <input type="checkbox" class="vx-login-checkbox mt-1"/>
                                        <label class="vx-login-label" style="margin-bottom:0; font-weight:400; color: #64748b;">
                                            I agree to the
                                            <a href="#" class="vx-login-signup-link">Terms of Service</a>
                                            and
                                            <a href="#" class="vx-login-signup-link">Privacy Policy</a>
                                        </label>
                                    </div>

                                    <!-- Submit -->
                                    <a href="/web/signup" class="vx-login-submit-btn w-100 mb-3 text-center d-block text-decoration-none">
                                        Create account
                                    </a>

                                    <p class="text-center vx-login-signup-text">
                                        Already have an account?
                                        <a href="/login" class="vx-login-signup-link">Log in</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <record id="page_signup" model="theme.website.page">
        <field name="view_id" ref="view_signup"/>
        <field name="is_published" eval="True"/>
        <field name="url">/signup</field>
    </record>

</odoo>
