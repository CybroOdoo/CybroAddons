<?xml version="1.0" encoding="UTF-8"?>
<!--Rearranged the DiscussSidebarCategories template-->
<templates id="template" xml:space="preserve">
        <t name="mail.DiscussSidebarCategoriesAdvanced"
           t-inherit="mail.DiscussSidebarCategories"
           t-inherit-mode="extension"
           owl="1">
            <xpath expr="//t[@t-call='mail.DiscussSidebarCategories.category']"
                   position="replace">
                <t t-if="cat.isVisible"
                   t-call="mail.DiscussionSidebarCategoryAdvanced">
                    <t t-set="category" t-value="cat"/>
                </t>
            </xpath>
        </t>
    <!--    New discuss sidebar categories template-->
    <t t-name="mail.DiscussionSidebarCategoryAdvanced">
        <t t-if="category.id == this.props.sidebar">
            <div class="search">
                <DiscussSidebarCategory category="category"/>
            </div>
            <t t-if="category.open">
                <DiscussSidebarChannel
                        t-foreach="filteredThreads(category.threads)"
                        t-as="thread" t-key="thread.localId" thread="thread"/>
            </t>
            <DiscussSidebarChannel
                    t-elif="store.discuss.thread?.in(category.threads)"
                    thread="store.discuss.thread"/>
            <DiscussSidebarChannel
                    t-elif="store.discuss.thread?.parent_channel_id?.in(category.threads)"
                    thread="store.discuss.thread.parent_channel_id"/>
        </t>
    </t>
</templates>
