<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Filter pricelist selection dropdown on product template form to show only displayable pricelists -->
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pricelist.display</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fixed_pricelist_rule_ids']//field[@name='pricelist_id']" position="attributes">
                <attribute name="domain">[('company_id', 'in', (False, parent.company_id)), ('display_pricelist', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
