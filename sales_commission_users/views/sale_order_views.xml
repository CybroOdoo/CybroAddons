<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Sales Commission tab to sale order form view -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sales.commission.users</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Sales Commission" name="sales_commission">
                    <field name="commission_ids">
                        <list create="0">
                            <field name="date"/>
                            <field name="description"/>
                            <field name="commission_amount" sum="Total"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-success="state == 'invoiced'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
