<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_trust_state_change_wizard_form" model="ir.ui.view">
        <field name="name">nhs.trust.state.change.wizard.form</field>
        <field name="model">nhs.trust.state.change.wizard</field>
        <field name="arch" type="xml">
            <form string="NHS Trust State Transition Confirmation">
                <sheet>
                    <group>
                        <field name="trust_id" readonly="1" force_save="1"/>
                        <group>
                            <field name="current_state"/>
                        </group>
                        <group>
                            <field name="new_state" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <group string="Auditable Justification Narrative">
                        <field name="reason" nolabel="1" placeholder="Provide an explanation/justification for this state change (minimum 5 characters is required)..." colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Execute State Change" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
