<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Merger Wizard Form View -->
    <record id="view_nhs_trust_merge_wizard_form" model="ir.ui.view">
        <field name="name">nhs.trust.merge.wizard.form</field>
        <field name="model">nhs.trust.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="NHS Trust Merger Process">
                <sheet>
                    <group>
                        <group string="Entities Involved">
                            <field name="source_trust_id" force_save="1"/>
                            <field name="source_region_id" invisible="1"/>
                            <field name="target_trust_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <group string="Execution Details">
                            <field name="merge_date"/>
                        </group>
                    </group>
                    <group string="Transition Settings">
                        <field name="transfer_sites" widget="boolean_toggle"/>
                        <field name="transfer_board_members" widget="boolean_toggle"/>
                    </group>
                    <group string="Merger Reason / Legal Justification">
                        <field name="reason" placeholder="Provide details of the merger / legal order (minimum 5 characters)..." nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_merge" string="Execute Merger &amp; Transfer" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Dissolution Wizard Form View -->
    <record id="view_nhs_trust_dissolve_wizard_form" model="ir.ui.view">
        <field name="name">nhs.trust.dissolve.wizard.form</field>
        <field name="model">nhs.trust.dissolve.wizard</field>
        <field name="arch" type="xml">
            <form string="NHS Trust Dissolution Process">
                <sheet>
                    <group>
                        <group string="Entity Info">
                            <field name="trust_id" force_save="1"/>
                        </group>
                        <group string="Execution Details">
                            <field name="dissolve_date"/>
                        </group>
                    </group>
                    <group string="Estates &amp; Facilities">
                        <field name="archive_sites" widget="boolean_toggle"/>
                    </group>
                    <group string="Dissolution Reason / Justification">
                        <field name="reason" placeholder="Provide details of the dissolution (minimum 5 characters)..." nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_dissolve" string="Confirm Dissolution" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions to open the wizards -->
    <record id="action_nhs_trust_merge_wizard" model="ir.actions.act_window">
        <field name="name">NHS Trust Merger</field>
        <field name="res_model">nhs.trust.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_source_trust_id': active_id}</field>
    </record>

    <record id="action_nhs_trust_dissolve_wizard" model="ir.actions.act_window">
        <field name="name">NHS Trust Dissolution</field>
        <field name="res_model">nhs.trust.dissolve.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_trust_id': active_id}</field>
    </record>
</odoo>
