<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_nhs_trust_type_tree" model="ir.ui.view">
        <field name="name">nhs.trust.type.tree</field>
        <field name="model">nhs.trust.type</field>
        <field name="arch" type="xml">
            <list string="NHS Trust Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="health_system"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nhs_trust_type_form" model="ir.ui.view">
        <field name="name">nhs.trust.type.form</field>
        <field name="model">nhs.trust.type</field>
        <field name="arch" type="xml">
            <form string="NHS Trust Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Teaching Trust"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. TEACHING"/>
                            <field name="sequence"/>
                            <field name="health_system"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Provide detailed definitions/responsibilities of this trust type..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_nhs_trust_type" model="ir.actions.act_window">
        <field name="name">NHS Trust Types</field>
        <field name="res_model">nhs.trust.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a new NHS Trust Type classification.
            </p>
        </field>
    </record>
</odoo>
