<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for Smart Button (Board Members) -->
    <record id="action_nhs_board_members_from_trust" model="ir.actions.act_window">
        <field name="name">Board Members</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('nhs_trust_id', '=', active_id), ('is_nhs_board_member', '=', True)]</field>
        <field name="context">{'default_nhs_trust_id': active_id, 'default_is_nhs_board_member': True}</field>
    </record>

    <!-- Tree View -->
    <record id="view_nhs_trust_tree" model="ir.ui.view">
        <field name="name">nhs.trust.tree</field>
        <field name="model">nhs.trust</field>
        <field name="arch" type="xml">
            <list string="NHS Trusts" decoration-info="state == 'under_review'" decoration-success="state == 'active'" decoration-warning="state in ('special_measures', 'suspended')" decoration-muted="state in ('merging', 'dissolved')">
                <field name="ods_code"/>
                <field name="name"/>
                <field name="health_system"/>
                <field name="region_id"/>
                <field name="trust_type_id"/>
                <field name="foundation_trust" widget="boolean"/>
                <field name="state" widget="badge" decoration-info="state == 'under_review'" decoration-success="state == 'active'" decoration-warning="state in ('special_measures', 'suspended')" decoration-danger="state == 'dissolved'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_nhs_trust_kanban" model="ir.ui.view">
        <field name="name">nhs.trust.kanban</field>
        <field name="model">nhs.trust</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" record_draggable="false" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="ods_code"/>
                <field name="health_system"/>
                <field name="region_id"/>
                <field name="trust_type_id"/>
                <field name="state"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="oe_kanban_details d-flex flex-column justify-content-between h-100">
                                <div>
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title" style="font-size: 1.1em; color: #1e3a8a;"><field name="name"/></strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body mt-2">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="badge text-bg-primary" style="font-size: 0.85em; padding: 4px 8px;"><field name="ods_code"/></span>
                                            <span class="text-muted" style="font-size: 0.85em;"><field name="trust_type_id"/></span>
                                        </div>
                                        <div class="mt-2 text-muted" style="font-size: 0.9em;">
                                            <i class="fa fa-map-marker mr-1" style="color: #ef4444;" title="Region"/> <field name="region_id"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-3 d-flex justify-content-between align-items-center" style="border-top: 1px solid #f3f4f6; padding-top: 8px;">
                                    <span t-attf-class="badge #{record.health_system.raw_value == 'nhs_england' ? 'text-bg-info' : 'text-bg-success'}" style="font-size: 0.8em; padding: 3px 6px;">
                                        <t t-out="record.health_system.value"/>
                                    </span>
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nhs_trust_form" model="ir.ui.view">
        <field name="name">nhs.trust.form</field>
        <field name="model">nhs.trust</field>
        <field name="arch" type="xml">
            <form string="NHS Trust Management">
                <header>
                    <!-- Submit for Review -->
                    <button name="action_open_state_change_wizard" string="Submit for Review" type="object" class="oe_highlight" context="{'default_new_state': 'under_review'}" invisible="state != 'draft'" groups="odoo_nhs_trust_management.group_nhs_trust_manager,odoo_nhs_trust_management.group_nhs_trust_admin"/>
                    <!-- Approve & Activate -->
                    <button name="action_open_state_change_wizard" string="Approve &amp; Activate" type="object" class="oe_highlight" context="{'default_new_state': 'active'}" invisible="state != 'under_review'" groups="odoo_nhs_trust_management.group_nhs_trust_manager,odoo_nhs_trust_management.group_nhs_trust_admin"/>
                    <!-- Escalate to Special Measures -->
                    <button name="action_open_state_change_wizard" string="Escalate to Special Measures" type="object" class="oe_highlight" context="{'default_new_state': 'special_measures'}" invisible="state not in ('active', 'suspended') or health_system == 'nhs_scotland'" groups="odoo_nhs_trust_management.group_nhs_trust_manager,odoo_nhs_trust_management.group_nhs_trust_admin"/>
                    <!-- Suspend Trust -->
                    <button name="action_open_state_change_wizard" string="Suspend Trust" type="object" class="oe_highlight" context="{'default_new_state': 'suspended'}" invisible="state not in ('active', 'special_measures')" groups="odoo_nhs_trust_management.group_nhs_trust_manager,odoo_nhs_trust_management.group_nhs_trust_admin"/>
                    <!-- Revert to Active -->
                    <button name="action_open_state_change_wizard" string="Revert to Active" type="object" class="oe_highlight" context="{'default_new_state': 'active'}" invisible="state not in ('special_measures', 'suspended') or (state == 'special_measures' and health_system == 'nhs_scotland')" groups="odoo_nhs_trust_management.group_nhs_trust_manager,odoo_nhs_trust_management.group_nhs_trust_admin"/>
                    
                    <!-- Merge Trust Wizard -->
                    <button name="%(odoo_nhs_trust_management.action_nhs_trust_merge_wizard)d" string="Merge Trust" type="action" class="oe_highlight" invisible="state not in ('active', 'special_measures', 'suspended')" groups="odoo_nhs_trust_management.group_nhs_trust_manager,odoo_nhs_trust_management.group_nhs_trust_admin"/>
                    <!-- Dissolve Trust Wizard -->
                    <button name="%(odoo_nhs_trust_management.action_nhs_trust_dissolve_wizard)d" string="Dissolve Trust" type="action" class="oe_highlight" invisible="state not in ('active', 'special_measures', 'suspended', 'merging')" groups="odoo_nhs_trust_management.group_nhs_trust_manager,odoo_nhs_trust_management.group_nhs_trust_admin"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,under_review,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_nhs_board_members_from_trust)d" type="action" class="oe_stat_button" icon="fa-users">
                            <field name="board_member_count" string="Board Members" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Leeds Teaching Hospitals NHS Trust"/>
                        </h1>
                        <h3>
                            <label for="ods_code" string="ODS Code" class="oe_edit_only"/>
                            <field name="ods_code" placeholder="e.g. RGT" style="width: 150px; text-transform: uppercase;"/>
                            <span class="oe_inline"> - </span>
                            <field name="short_name" placeholder="Short Name (e.g. Leeds Teaching)" style="width: 300px;"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Core Classification" name="class_info">
                            <field name="health_system" widget="radio" options="{'horizontal': true}"/>
                            <field name="trust_type_id" options="{'no_open': True, 'no_create': True}" domain="[('health_system', 'in', (health_system, 'both'))]"/>
                            <field name="foundation_trust" widget="boolean_toggle" invisible="health_system != 'nhs_england'"/>
                            <field name="foundation_authorised_date" invisible="health_system != 'nhs_england' or not foundation_trust"/>
                        </group>
                        <group string="NHS Governance Scope" name="geo_scope">
                            <field name="region_id" options="{'no_open': True, 'no_create': True}" domain="[('health_system', '=', health_system)]"/>
                            <field name="icb_id" invisible="health_system != 'nhs_england'" required="health_system == 'nhs_england'" domain="[('region_id', '=', region_id)]" options="{'no_open': True, 'no_create': True}"/>
                            <field name="ics_id" invisible="health_system != 'nhs_england'" domain="[('icb_id', '=', icb_id)]" options="{'no_open': True, 'no_create': True}"/>
                            <field name="health_board_id" invisible="health_system != 'nhs_scotland'" required="health_system == 'nhs_scotland'" domain="[('region_id', '=', region_id)]" options="{'no_open': True, 'no_create': True}"/>
                            <field name="establishment_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General Info &amp; Corporate" name="general_info">
                            <group>
                                <group name="headquarters_address">
                                    <label for="street" string="Address"/>
                                    <div class="o_address_format">
                                        <field name="street" placeholder="Street..." class="o_address_street"/>
                                        <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                        <field name="city" placeholder="City" class="o_address_city"/>
                                        <field name="state_id" placeholder="State" class="o_address_state"
                                               options="{'no_open': True, 'no_quick_create': True}"
                                               context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                        <field name="zip" placeholder="Postcode" class="o_address_zip"/>
                                        <div name="trust_address_country" class="d-flex justify-content-between">
                                            <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                        </div>
                                    </div>
                                </group>
                                <group string="Corporate Registrations">
                                    <field name="companies_house_number" placeholder="e.g. 01234567" invisible="not foundation_trust"/>
                                    <field name="vat_number" placeholder="e.g. GB123456789"/>
                                </group>
                            </group>
                            <group>
                                <group string="Contact Channels">
                                    <field name="phone" widget="phone"/>
                                    <field name="email" widget="email"/>
                                    <field name="website" widget="url" placeholder="e.g. https://www.leedsth.nhs.uk"/>
                                </group>
                                <group string="Odoo Scope">
                                    <field name="company_id" groups="base.group_multi_company" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page string="Governance Leadership" name="governance_leaders">
                            <group string="Statutory Executive Board Members">
                                <group>
                                    <field name="chair_id" domain="[('nhs_trust_id', '=', id), ('is_nhs_board_member', '=', True)]" options="{'no_create': True}"/>
                                    <field name="chief_executive_id" domain="[('nhs_trust_id', '=', id), ('is_nhs_board_member', '=', True)]" options="{'no_create': True}"/>
                                    <field name="medical_director_id" domain="[('nhs_trust_id', '=', id), ('is_nhs_board_member', '=', True)]" options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="director_of_nursing_id" domain="[('nhs_trust_id', '=', id), ('is_nhs_board_member', '=', True)]" options="{'no_create': True}"/>
                                    <field name="finance_director_id" domain="[('nhs_trust_id', '=', id), ('is_nhs_board_member', '=', True)]" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Board Members List" name="board_members_tab">
                            <field name="board_member_ids">
                                <list edit="true" editable="bottom">
                                    <field name="name"/>
                                    <field name="nhs_board_role"/>
                                    <field name="is_voting_member" widget="boolean_toggle"/>
                                    <field name="term_start_date"/>
                                    <field name="term_end_date"/>
                                    <field name="is_term_active" string="Active"/>
                                </list>
                            </field>
                        </page>


                    </notebook>
                </sheet>
                <!-- Chatter & Activities -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_nhs_trust_search" model="ir.ui.view">
        <field name="name">nhs.trust.search</field>
        <field name="model">nhs.trust</field>
        <field name="arch" type="xml">
            <search string="Search NHS Trusts">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('short_name', 'ilike', self), ('ods_code', 'ilike', self)]"/>
                <field name="ods_code"/>
                <field name="region_id"/>
                <field name="icb_id"/>
                <field name="health_board_id"/>
                <separator/>
                <!-- Health Systems Quick Filters -->
                <filter string="NHS England System" name="england_system" domain="[('health_system', '=', 'nhs_england')]"/>
                <filter string="NHS Scotland System" name="scotland_system" domain="[('health_system', '=', 'nhs_scotland')]"/>
                <separator/>
                <!-- Active/Inactive States -->
                <filter string="Active Trusts" name="state_active" domain="[('state', '=', 'active')]"/>
                <filter string="Under Review" name="state_review" domain="[('state', '=', 'under_review')]"/>
                <filter string="Special Measures" name="state_measures" domain="[('state', '=', 'special_measures')]"/>
                <separator/>
                <filter string="Foundation Trusts" name="foundation" domain="[('foundation_trust', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Health System" name="group_by_system" context="{'group_by': 'health_system'}"/>
                    <filter string="NHS Region" name="group_by_region" context="{'group_by': 'region_id'}"/>
                    <filter string="Trust Type" name="group_by_type" context="{'group_by': 'trust_type_id'}"/>
                    <filter string="Workflow State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_nhs_trust" model="ir.actions.act_window">
        <field name="name">NHS Trusts</field>
        <field name="res_model">nhs.trust</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_nhs_trust_search"/>
        <field name="context">{'search_default_england_system': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new NHS Trust core profile.
            </p>
            <p>
                Manage geographic scope, governance executives, and audit trail changes here.
            </p>
        </field>
    </record>
</odoo>
