    <menuitem id="menu_nhs_trust_type"
              name="NHS Trust Types"
              parent="menu_nhs_trust_config"
              action="action_nhs_trust_type"
              sequence="20"/>

    <menuitem id="menu_nhs_icb"
              name="NHS ICBs"
              parent="menu_nhs_trust_config"
              action="action_nhs_icb"
              sequence="30"/>

    <menuitem id="menu_nhs_ics"
              name="NHS ICSs"
              parent="menu_nhs_trust_config"
              action="action_nhs_ics"
              sequence="40"/>

    <menuitem id="menu_nhs_health_board"
              name="NHS Health Boards"
              parent="menu_nhs_trust_config"
              action="action_nhs_health_board"
              sequence="50"/>
</odoo>
