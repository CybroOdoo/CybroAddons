<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_nhs_trust_root"
              name="Trust Management"
              web_icon="odoo_nhs_trust_management,static/description/icon.png"
              sequence="45"
              groups="odoo_nhs_trust_management.group_nhs_trust_user"/>

    <!-- Submenus -->
    <menuitem id="menu_nhs_trust"
              name="Trusts"
              parent="menu_nhs_trust_root"
              action="action_nhs_trust"
              sequence="5"/>

    <menuitem id="menu_nhs_board_members"
              name="Board Members"
              parent="menu_nhs_trust_root"
              action="action_nhs_board_members"
              sequence="15"
              groups="odoo_nhs_trust_management.group_nhs_trust_user"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_nhs_trust_config"
              name="Configuration"
              parent="menu_nhs_trust_root"
