<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action: open NHS Trust form in create mode from Settings -->
    <record id="action_nhs_trust_settings_create" model="ir.actions.act_window">
        <field name="name">NHS Trusts</field>
        <field name="res_model">nhs.trust</field>
        <field name="view_mode">form,list</field>
        <field name="view_id" ref="view_nhs_trust_form"/>
    </record>

    <!-- Settings > Users & Companies > NHS -->
    <menuitem id="menu_settings_nhs_trust"
              name="NHS Trusts"
              parent="base.menu_users"
              action="action_nhs_trust_settings_create"
              sequence="20"
              groups="odoo_nhs_trust_management.group_nhs_trust_admin"/>
</odoo>
