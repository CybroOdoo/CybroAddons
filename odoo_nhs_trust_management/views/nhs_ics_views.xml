<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_nhs_ics_tree" model="ir.ui.view">
        <field name="name">nhs.ics.tree</field>
        <field name="model">nhs.ics</field>
        <field name="arch" type="xml">
            <list string="NHS Integrated Care Systems (ICSs)">
                <field name="code"/>
                <field name="name"/>
                <field name="icb_id"/>
                <field name="region_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nhs_ics_form" model="ir.ui.view">
        <field name="name">nhs.ics.form</field>
        <field name="model">nhs.ics</field>
        <field name="arch" type="xml">
            <form string="NHS Integrated Care System (ICS)">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. West Yorkshire ICS"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Core Details">
                            <field name="code" placeholder="e.g. QWO-SUB"/>
                            <field name="icb_id"/>
                        </group>
                        <group string="Geographics">
                            <field name="region_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Clinical Notes / Geographic Details">
                        <field name="description" nolabel="1" placeholder="Specify geographic scope, core populations, or structural notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_nhs_ics" model="ir.actions.act_window">
        <field name="name">NHS Integrated Care Systems (ICSs)</field>
        <field name="res_model">nhs.ics</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a new Integrated Care System (ICS) subdivision.
            </p>
        </field>
    </record>
</odoo>
