<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================
             NHS ENGLAND TRUST TYPES
        ============================================================ -->
        <record id="type_england_acute" model="nhs.trust.type">
            <field name="name">Acute Trust</field>
            <field name="code">ACUTE</field>
            <field name="sequence">10</field>
            <field name="health_system">nhs_england</field>
            <field name="description">Provides general hospital services including emergency care,
                surgeries, and routine outpatient treatments.</field>
        </record>

        <record id="type_england_teaching" model="nhs.trust.type">
            <field name="name">Teaching Trust</field>
            <field name="code">TEACHING</field>
            <field name="sequence">20</field>
            <field name="health_system">nhs_england</field>
            <field name="description">Acute hospitals affiliated with universities providing
                comprehensive medical training and research programs.</field>
        </record>

        <record id="type_england_mental" model="nhs.trust.type">
            <field name="name">Mental Health Trust</field>
            <field name="code">MENTAL</field>
            <field name="sequence">30</field>
            <field name="health_system">nhs_england</field>
            <field name="description">Provides specialist mental health care,
                psychological therapies, and addiction services.</field>
        </record>

        <record id="type_england_community" model="nhs.trust.type">
            <field name="name">Community Trust</field>
            <field name="code">COMMUNITY</field>
            <field name="sequence">40</field>
            <field name="health_system">nhs_england</field>
            <field name="description">Delivers physical health services in clinics, schools,
                and patients' homes, focusing on rehabilitation and local care.</field>
        </record>

        <record id="type_england_ambulance" model="nhs.trust.type">
            <field name="name">Ambulance Trust</field>
            <field name="code">AMBULANCE</field>
            <field name="sequence">50</field>
            <field name="health_system">nhs_england</field>
            <field name="description">Provides emergency medical response and patient transport services.</field>
        </record>

        <record id="type_england_specialist" model="nhs.trust.type">
            <field name="name">Specialist Trust</field>
            <field name="code">SPECIALIST</field>
            <field name="sequence">60</field>
            <field name="health_system">nhs_england</field>
            <field name="description">Provides advanced, highly focused care for specific conditions
                or patient groups (e.g., cancer centers, children's hospitals).</field>
        </record>

        <record id="type_england_care" model="nhs.trust.type">
            <field name="name">Care Trust</field>
            <field name="code">CARE</field>
            <field name="sequence">70</field>
            <field name="health_system">nhs_england</field>
            <field name="description">Combines health services and social services to deliver integrated community care packages.</field>
        </record>

        <!-- ============================================================
             NHS SCOTLAND TRUST TYPES
        ============================================================ -->
        <record id="type_scotland_territorial" model="nhs.trust.type">
            <field name="name">Territorial Health Board</field>
            <field name="code">SCO-TERRITORIAL</field>
            <field name="sequence">110</field>
            <field name="health_system">nhs_scotland</field>
            <field name="description">Responsible for planning and delivering healthcare services
                to residents within a specific geographical territory in Scotland.</field>
        </record>

        <record id="type_scotland_national" model="nhs.trust.type">
            <field name="name">National Health Board</field>
            <field name="code">SCO-NATIONAL</field>
            <field name="sequence">120</field>
            <field name="health_system">nhs_scotland</field>
            <field name="description">Provides specialized national support services across Scotland
                (e.g., NHS 24, Scottish Ambulance Service, Public Health Scotland).</field>
        </record>
    </data>
</odoo>