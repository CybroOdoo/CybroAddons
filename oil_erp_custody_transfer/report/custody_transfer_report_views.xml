<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_custody_transfer_pdf" model="ir.actions.report">
        <field name="name">Custody Transfer Report</field>
        <field name="model">custody.transfer.reporting.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">oil_erp_custody_transfer.report_custody_transfer_wizard_template</field>
        <field name="report_file">oil_erp_custody_transfer.report_custody_transfer_wizard_template</field>
        <field name="print_report_name">'Custody Transfer Report'</field>
    </record>

    <!-- QWeb PDF Template -->
    <template id="report_custody_transfer_wizard_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <t t-set="records" t-value="wizard.get_report_records()"/>
                    <t t-set="filters" t-value="wizard.get_filters_basis_chunks()"/>
                    <div class="page">

                        <!-- Report Title -->
                        <div class="row mb-3" style="border-bottom: 2px solid #dee2e6; padding-bottom: 10px;">
                            <div class="col-12 text-center">
                                <h3 style="font-weight:bold; color:#343a40; margin:0;">
                                    CUSTODY TRANSFER REPORT
                                </h3>
                                <p style="color:#6c757d; margin-top:4px; font-size:12px;">
                                    Generated on:
                                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                </p>
                            </div>
                        </div>

                        <!-- Applied Filters -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <h5 style="color:#495057; border-bottom:1px solid #dee2e6; padding-bottom:4px;">
                                    Applied Filters
                                </h5>
                                <t t-foreach="filters" t-as="chunk">
                                    <div class="row">
                                        <t t-foreach="chunk" t-as="item">
                                            <div class="col-4">
                                                <strong><t t-esc="item[0]"/>:</strong>
                                                <span t-esc="item[1]"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Summary Stats -->
                        <div class="row mb-3">
                            <div class="col-3 text-center"
                                 style="background:#f8f9fa; border:1px solid #dee2e6; padding:10px; margin-right:4px;">
                                <div style="font-size:11px; color:#6c757d; text-transform:uppercase;">
                                    Total Transfers
                                </div>
                                <div style="font-size:20px; font-weight:bold;">
                                    <t t-esc="len(records)"/>
                                </div>
                            </div>
                            <div class="col-3 text-center"
                                 style="background:#f8f9fa; border:1px solid #dee2e6; padding:10px; margin-right:4px;">
                                <div style="font-size:11px; color:#6c757d; text-transform:uppercase;">
                                    Total Planned Qty
                                </div>
                                <div style="font-size:20px; font-weight:bold;">
                                    <t t-esc="'%.2f' % sum(records.mapped('total_planned_qty'))"/>
                                </div>
                            </div>
                            <div class="col-3 text-center"
                                 style="background:#f8f9fa; border:1px solid #dee2e6; padding:10px;">
                                <div style="font-size:11px; color:#6c757d; text-transform:uppercase;">
                                    Total Actual Qty
                                </div>
                                <div style="font-size:20px; font-weight:bold;">
                                    <t t-esc="'%.2f' % sum(records.mapped('total_actual_qty'))"/>
                                </div>
                            </div>
                        </div>

                        <!-- Records Table -->
                        <table class="table table-sm table-bordered" style="font-size:10px; width:100%;">
                            <thead>
                                <tr style="background-color:#f2f2f2; color:#000;">
                                    <th>Transfer #</th>
                                    <th>Date</th>
                                    <th>Purpose</th>
                                    <th>Operation Type</th>
                                    <th>Legal Owner</th>
                                    <th>Custodian</th>
                                    <th>Carrier</th>
                                    <th style="text-align:right;">Planned Qty</th>
                                    <th style="text-align:right;">Actual Qty</th>
                                    <th style="text-align:right;">Variance</th>
                                    <th style="text-align:center;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="records">
                                    <t t-foreach="records" t-as="r">
                                        <tr>
                                            <td><t t-esc="r.name"/></td>
                                            <td>
                                                <t t-esc="r.transfer_date.strftime('%Y-%m-%d') if r.transfer_date else ''"/>
                                            </td>
                                            <td>
                                                <t t-esc="dict([('commercial_sale','Commercial Sale'),('inter_facility','Inter-Facility'),('emergency','Emergency'),('intercompany','Intercompany'),('pipeline_injection','Pipeline Injection'),('other','Other')]).get(r.transfer_purpose or '', '-')"/>
                                            </td>
                                            <td><t t-esc="r.picking_type_id.name or '-'"/></td>
                                            <td><t t-esc="r.owner_partner_id.name or '-'"/></td>
                                            <td><t t-esc="r.custodian_partner_id.name or '-'"/></td>
                                            <td><t t-esc="r.carrier_partner_id.name or '-'"/></td>
                                            <td style="text-align:right;">
                                                <t t-esc="'%.2f' % r.total_planned_qty"/>
                                            </td>
                                            <td style="text-align:right;">
                                                <t t-esc="'%.2f' % r.total_actual_qty"/>
                                            </td>
                                            <td style="text-align:right;">
                                                <t t-esc="'%.2f' % r.total_variance_qty"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="r.state.replace('_', ' ').upper()"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Totals -->
                                    <tr style="background-color:#f2f2f2; font-weight:bold;">
                                        <td colspan="7" style="text-align:right;">TOTAL</td>
                                        <td style="text-align:right;">
                                            <t t-esc="'%.2f' % sum(records.mapped('total_planned_qty'))"/>
                                        </td>
                                        <td style="text-align:right;">
                                            <t t-esc="'%.2f' % sum(records.mapped('total_actual_qty'))"/>
                                        </td>
                                        <td style="text-align:right;">
                                            <t t-esc="'%.2f' % sum(records.mapped('total_variance_qty'))"/>
                                        </td>
                                        <td/>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="11" style="text-align:center; color:#6c757d;">
                                            No records found for the selected filters.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
