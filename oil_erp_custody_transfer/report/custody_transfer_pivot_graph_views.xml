<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pivot view: Custody Transfer -->
    <record id="view_custody_transfer_reporting_pivot" model="ir.ui.view">
        <field name="name">custody.transfer.reporting.pivot</field>
        <field name="model">custody.transfer</field>
        <field name="arch" type="xml">
            <pivot string="Custody Transfer Analysis">
                <field name="transfer_purpose" type="row"/>
                <field name="transfer_date" interval="month" type="col"/>
                <field name="total_planned_qty" type="measure"/>
                <field name="total_actual_qty" type="measure"/>
                <field name="total_variance_qty" type="measure"/>
                <field name="demurrage_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view: Custody Transfer -->
    <record id="view_custody_transfer_reporting_graph" model="ir.ui.view">
        <field name="name">custody.transfer.reporting.graph</field>
        <field name="model">custody.transfer</field>
        <field name="arch" type="xml">
            <graph string="Custody Transfer Analysis" type="bar">
                <field name="transfer_purpose"/>
                <field name="total_actual_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action: Custody Transfer Analysis Pivot/Graph -->
    <record id="action_custody_transfer_reporting_pivot_graph" model="ir.actions.act_window">
        <field name="name">Custody Transfer Analysis</field>
        <field name="res_model">custody.transfer</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <!-- Reporting Menu: Custody Transfer Analysis (global) -->
    <menuitem id="menu_oil_reporting_custody_transfer_analysis"
              name="Custody Transfer Analysis"
              parent="oil_erp_base.menu_oil_reporting_midstream"
              action="action_custody_transfer_reporting_pivot_graph"
              sequence="31"/>
</odoo>
