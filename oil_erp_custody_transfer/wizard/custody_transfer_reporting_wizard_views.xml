<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_custody_transfer_reporting_wizard_form" model="ir.ui.view">
        <field name="name">custody.transfer.reporting.wizard.form</field>
        <field name="model">custody.transfer.reporting.wizard</field>
        <field name="arch" type="xml">
            <form string="Custody Transfer Report">
                <group>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filters">
                        <field name="state" placeholder="All Statuses"/>
                        <field name="transfer_purpose" placeholder="All Purposes"/>
                        <field name="picking_type_id" placeholder="All Operation Types"/>
                    </group>
                </group>
                <group string="Party Filters">
                    <group>
                        <field name="owner_partner_id" placeholder="All Legal Owners"/>
                        <field name="custodian_partner_id" placeholder="All Custodians"/>
                    </group>
                    <group>
                        <field name="carrier_partner_id" placeholder="All Carriers"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_print_xlsx" string="Export XLSX" type="object"
                            class="btn-primary" data-hotkey="w"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_custody_transfer_reporting_wizard" model="ir.actions.act_window">
        <field name="name">Custody Transfer Report</field>
        <field name="res_model">custody.transfer.reporting.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
