<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- This file defines the menu hierarchy for the custody transfer module. -->

    <!-- ================================================================== -->
    <!-- TOP-LEVEL CUSTODY TRANSFER SUBMENU (under Midstream root)           -->
    <!-- ================================================================== -->
    <menuitem
        id="menu_custody_transfer_root"
        name="Custody Transfer"
        parent="oil_erp_base.menu_oil_midstream_root"
        sequence="25"
        groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"/>

    <!-- ================================================================== -->
    <!-- TRANSFERS                                                            -->
    <!-- ================================================================== -->
    <menuitem
        id="menu_custody_transfer_all"
        name="All Transfers"
        parent="menu_custody_transfer_root"
        action="action_custody_transfer"
        sequence="10"
        groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"/>

    <menuitem
        id="menu_custody_transfer_active"
        name="Active Transfers"
        parent="menu_custody_transfer_root"
        action="action_custody_transfer_active"
        sequence="20"
        groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"/>

    <menuitem
        id="menu_custody_transfer_completed"
        name="Completed Transfers"
        parent="menu_custody_transfer_root"
        action="action_custody_transfer_completed"
        sequence="30"
        groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"/>

    <!-- ================================================================== -->
    <!-- REPORTING / AUDIT                                                   -->
    <!-- ================================================================== -->
    <menuitem
        id="menu_custody_transfer_audit"
        name="Audit Trail"
        parent="menu_custody_transfer_root"
        action="action_custody_transfer_event"
        sequence="40"
        groups="oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"/>

</odoo>