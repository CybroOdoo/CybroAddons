<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- This file defines views for the custody transfer party model. -->

    <record id="view_custody_transfer_party_list" model="ir.ui.view">
        <field name="name">custody.transfer.party.list</field>
        <field name="model">custody.transfer.party</field>
        <field name="arch" type="xml">
            <list string="Transfer Parties">
                <field name="transfer_id"/>
                <field name="partner_id"/>
                <field name="role"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <record id="view_custody_transfer_party_form" model="ir.ui.view">
        <field name="name">custody.transfer.party.form</field>
        <field name="model">custody.transfer.party</field>
        <field name="arch" type="xml">
            <form string="Transfer Party">
                <sheet>
                    <group>
                        <group>
                            <field name="transfer_id"/>
                            <field name="partner_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="reference"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Optional notes about this party's participation..."/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>