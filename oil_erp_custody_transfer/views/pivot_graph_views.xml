<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
    <!-- Pivot view for custody.transfer.event -->
    <record id="view_custody_transfer_event_pivot" model="ir.ui.view">
        <field name="name">custody.transfer.event.pivot</field>
        <field name="model">custody.transfer.event</field>
        <field name="arch" type="xml">
            <pivot string="Custody Transfer Event Analysis">
            <field name="create_date" interval="month" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view for custody.transfer.event -->
    <record id="view_custody_transfer_event_graph" model="ir.ui.view">
        <field name="name">custody.transfer.event.graph</field>
        <field name="model">custody.transfer.event</field>
        <field name="arch" type="xml">
            <graph string="Custody Transfer Event Analysis" type="bar">
                <field name="create_date" interval="month"/>
            </graph>
        </field>
    </record>
    <!-- Pivot view for custody.transfer -->
    <record id="view_custody_transfer_pivot" model="ir.ui.view">
        <field name="name">custody.transfer.pivot</field>
        <field name="model">custody.transfer</field>
        <field name="arch" type="xml">
            <pivot string="Custody Transfer Analysis">
            <field name="transfer_purpose" type="row"/>
            <field name="create_date" interval="month" type="row"/>
            <field name="total_planned_qty" type="measure"/>
            <field name="demurrage_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view for custody.transfer -->
    <record id="view_custody_transfer_graph" model="ir.ui.view">
        <field name="name">custody.transfer.graph</field>
        <field name="model">custody.transfer</field>
        <field name="arch" type="xml">
            <graph string="Custody Transfer Analysis" type="bar">
                <field name="transfer_purpose"/>
                <field name="demurrage_cost" type="measure"/>
            </graph>
        </field>
    </record>
    </data>
</odoo>