<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ================================================================== -->
    <!-- LIST VIEW                                                            -->
    <!-- ================================================================== -->
    <record id="view_custody_transfer_list" model="ir.ui.view">
        <field name="name">custody.transfer.list</field>
        <field name="model">custody.transfer</field>
        <field name="arch" type="xml">
            <list string="Custody Transfers"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'completed'"
                  decoration-warning="state == 'in_progress'"
                  decoration-danger="state in ('cancelled', 'disputed')">
                <field name="name"/>
                <field name="transfer_date"/>
                <field name="picking_type_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="owner_partner_id"/>
                <field name="measurement_method" optional="hide"/>
                <field name="total_planned_qty"/>
                <field name="total_actual_qty"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('approved', 'in_progress')"
                       decoration-success="state == 'completed'"
                       decoration-danger="state in ('cancelled', 'disputed')"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- FORM VIEW                                                            -->
    <!-- ================================================================== -->
    <record id="view_custody_transfer_form" model="ir.ui.view">
        <field name="name">custody.transfer.form</field>
        <field name="model">custody.transfer</field>
        <field name="arch" type="xml">
            <form string="Custody Transfer">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            invisible="state != 'draft' or (approval_policy == 'dual' and first_approver_id)"/>
                    <button name="action_second_approve" type="object" string="Second Approval"
                            class="btn-primary"
                            invisible="state != 'draft' or approval_policy != 'dual' or not first_approver_id or second_approver_id"/>
                    <button name="action_start" type="object" string="Start Transfer"
                            invisible="state != 'approved'"/>
                    <button name="action_complete" type="object" string="Complete"
                            class="btn-primary"
                            invisible="state not in ('approved', 'in_progress')"/>
                    <button name="action_dispute" type="object" string="Raise Dispute"
                            invisible="state not in ('approved', 'in_progress', 'completed')"/>
                    <button name="action_resolve_dispute" type="object" string="Resolve Dispute"
                            class="btn-primary"
                            invisible="state != 'disputed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('cancelled', 'disputed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,in_progress,completed"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Stock Transfer</span>
                            </div>
                        </button>
                        <button name="action_view_gate_pass" type="object"
                                class="oe_stat_button" icon="fa-id-card"
                                invisible="not gate_pass_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Gate Pass</span>
                            </div>
                        </button>
                        <button name="action_view_account_moves" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="account_move_count == 0">
                            <field name="account_move_count" widget="statinfo"
                                   string="Journal Entries"/>
                        </button>
                    </div>

                    <!-- Banners -->
                    <div class="alert alert-warning" role="alert" invisible="not is_locked">
                        <i class="fa fa-lock" title="Lock"/> This transfer is locked. No further edits are permitted.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'disputed'">
                        <i class="fa fa-exclamation-triangle" title="Warning"/>
                        <strong> Disputed: </strong>
                        <field name="dispute_reason" nolabel="1"/>
                    </div>

                    <!-- Title -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Main fields -->
                    <group>
                        <group string="Transfer Details">
                            <field name="picking_type_id"
                                   readonly="state in ('completed', 'cancelled') or is_locked"/>
                            <field name="transfer_date"
                                   readonly="state in ('completed', 'cancelled') or is_locked"/>
                            <field name="approval_policy" readonly="state != 'draft'"/>
                            <field name="reference" readonly="is_locked"/>
                            <field name="seal_number" readonly="is_locked"/>
                            <field name="transfer_purpose" readonly="is_locked"/>
                            <field name="bill_of_lading_ref" readonly="is_locked"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Locations">
                            <field name="source_location_id"
                                   readonly="state not in ('draft', 'approved') or is_locked"/>
                            <field name="destination_location_id"
                                   readonly="state not in ('draft', 'approved') or is_locked"/>
                        </group>
                    </group>

                    <!-- Measurement conditions -->
                    <group string="Measurement Conditions">
                        <group>
                            <field name="is_scada_installed" invisible="1"/>
                            <field name="picking_code" invisible="1"/>
                            <field name="measurement_method" readonly="is_locked"/>
                            <div class="alert alert-warning" role="alert" colspan="2"
                                 invisible="is_scada_installed or measurement_method != 'auto'">
                                <i class="fa fa-exclamation-triangle mr-1" title="Warning"/> SCADA Integration module is not installed. SCADA telemetry auto-population is disabled.
                            </div>
                            <div class="alert alert-warning" role="alert" colspan="2"
                                 invisible="picking_code != 'incoming' or measurement_method != 'auto'">
                                <i class="fa fa-exclamation-triangle mr-1" title="Warning"/> SCADA telemetry auto-population does not affect receipt orders. Fallbacking to manual entry.
                            </div>
                        </group>
                        <group>
                            <div colspan="2" class="text-muted small">
                                Base reference temperature, pressure and standardisation are
                                taken from each line's product (defaulted from its category,
                                but overridable per product). Each line uses its own product's
                                configuration to compute VCF.
                            </div>
                        </group>
                    </group>

                    <!-- Stock Transfer linkage + Update button -->
                    <group string="Linked Stock Transfer">
                        <group>
                            <field name="picking_id"
                                   readonly="1"
                                   widget="many2one"/>
                        </group>
                        <group>
                            <field name="gate_pass_id" readonly="is_locked"/>
                            <field name="contract_id" readonly="is_locked"/>
                            <field name="nomination_id" invisible="not nomination_id"/>
                        </group>
                    </group>

                    <!-- Bill of Lading document -->
                    <group string="Bill of Lading" invisible="not bill_of_lading_ref and not bill_of_lading_attachment">
                        <group>
                            <field name="bill_of_lading_attachment"
                                   widget="many2many_binary"
                                   readonly="is_locked"
                                   nolabel="1"
                                   colspan="2"/>
                        </group>
                    </group>

                    <!-- Ownership -->
                    <group>
                        <group string="Ownership">
                            <field name="owner_partner_id" readonly="is_locked"/>
                            <field name="custodian_partner_id" readonly="is_locked"/>
                            <field name="operator_partner_id" readonly="is_locked"/>
                            <field name="carrier_partner_id" readonly="is_locked"/>
                        </group>
                        <!-- Approval info -->
                        <group string="Approval Information"
                               invisible="state == 'draft' and not first_approver_id">
                            <field name="first_approver_id" readonly="1"/>
                            <field name="first_approval_date" readonly="1"/>
                            <field name="second_approver_id" readonly="1"
                                   invisible="approval_policy != 'dual'"/>
                            <field name="second_approval_date" readonly="1"
                                   invisible="approval_policy != 'dual'"/>
                        </group>
                    </group>

                    <!-- Completion info -->
                    <group string="Completion Information"
                           invisible="state not in ('completed', 'disputed')">
                        <group>
                            <field name="completed_by" readonly="1"/>
                            <field name="completed_date" readonly="1"/>
                        </group>
                        <group invisible="not dispute_resolved_by">
                            <field name="dispute_resolved_by" readonly="1"/>
                            <field name="dispute_resolved_date" readonly="1"/>
                        </group>
                    </group>

                    <!-- Demurrage -->
                    <group string="Demurrage">
                        <group>
                            <field name="demurrage_hours" readonly="is_locked"/>
                            <field name="demurrage_rate" readonly="is_locked"/>
                        </group>
                        <group>
                            <field name="demurrage_cost" readonly="1"/>
                        </group>
                    </group>

                    <!-- Crude Quality at Loading / Arrival -->
                    <group string="Crude Quality">
                        <group>
                            <field name="api_gravity_loading" readonly="is_locked"/>
                        </group>
                        <group>
                            <field name="api_gravity_arrival" readonly="is_locked"/>
                        </group>
                    </group>

                    <!-- Notebook -->
                    <notebook>
                        <!-- Transfer Lines -->
                        <page string="Transfer Lines" name="lines">
                            <field name="line_ids"
                                   readonly="is_locked or state in ('completed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_id" optional="show"/>
                                    <field name="planned_qty"/>
                                    <field name="hpm_required_actual_qty" readonly="1" string="Required Actual Qty" optional="show"/>
                                    <field name="actual_qty"/>
                                    <field name="loss_qty" readonly="1"
                                           decoration-danger="loss_qty &gt; 0"
                                           optional="show"/>
                                    <field name="gain_qty" readonly="1"
                                           decoration-success="gain_qty &gt; 0"
                                           optional="show"/>
                                    <field name="hpm_net_standard_volume" readonly="1"
                                           string="Net Std Vol"
                                           optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_planned_qty" readonly="1"/>
                                <field name="total_actual_qty" readonly="1"/>
                                <field name="total_variance_qty" readonly="1"/>
                            </group>
                        </page>

                        <!-- Measurement Data -->
                        <page string="Measurement Data" name="measurement">
                            <field name="line_ids"
                                   readonly="is_locked or state in ('completed', 'cancelled')">
                                <list editable="bottom" string="Measurement per Product"  create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="actual_qty"/>
                                    <!-- Temperature, Pressure & VCF -->
                                    <field name="hpm_observed_temperature" string="Temp (°F)" optional="show"/>
                                    <field name="hpm_observed_pressure" string="Press (psi)" optional="show"/>
                                    <field name="hpm_ctl" string="CTL" readonly="1" optional="hide"/>
                                    <field name="hpm_cpl" string="CPL" readonly="1" optional="hide"/>
                                    <field name="hpm_compressibility" string="Z" readonly="1" optional="hide"/>
                                    <field name="hpm_vcf" string="VCF" readonly="1" optional="show"/>
                                    <field name="hpm_standard_volume" string="Std Volume" readonly="1" optional="show"/>
                                    <!-- Quality -->
                                    <field name="hpm_observed_api_gravity" string="API Gravity" optional="show"/>
                                    <field name="hpm_density_at_15c" string="Density @ 15°C" optional="hide"/>
                                    <field name="hpm_water_content" string="BSW %" optional="show"/>
                                    <field name="hpm_sulfur_content" string="Sulfur %" optional="hide"/>
                                    <field name="hpm_required_actual_qty" string="Req Actual Qty" readonly="1" optional="show"/>
                                    <field name="hpm_net_standard_volume" string="Net Std Vol" readonly="1"
                                           decoration-success="hpm_net_standard_volume &gt; 0"
                                           optional="show"/>
                                </list>
                            </field>
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle" title="Info"/>
                                <strong>VCF Calculation:</strong>
                                Computed per line from the line's product. The product
                                inherits standardisation and reference conditions from its
                                category, so every product in the same category shares the
                                same standard by default. Formulas live in the
                                <em>oil_erp_hpc_standard</em> calculation engine. All
                                temperatures and pressures are in °F / psi.
                            </div>
                        </page>



                        <!-- Parties -->
                        <page string="Parties" name="parties">
                            <field name="party_ids"
                                   readonly="is_locked or state in ('completed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="role"/>
                                    <field name="partner_id"/>
                                    <field name="reference"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>



                        <!-- Notes -->
                        <page string="Notes" name="notes_page">
                            <field name="notes" readonly="is_locked"/>
                        </page>

                        <!-- Documents -->
                        <page string="Documents &amp; Audit" name="documents">
                            <group string="Bill of Lading">
                                <group>
                                    <field name="bill_of_lading_ref" readonly="is_locked"/>
                                </group>
                            </group>
                            <group string="Crude Quality Parameters">
                                <group>
                                    <field name="api_gravity_loading" readonly="is_locked"/>
                                </group>
                                <group>
                                    <field name="api_gravity_arrival" readonly="is_locked"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- SEARCH VIEW                                                          -->
    <!-- ================================================================== -->
    <record id="view_custody_transfer_search" model="ir.ui.view">
        <field name="name">custody.transfer.search</field>
        <field name="model">custody.transfer</field>
        <field name="arch" type="xml">
            <search string="Custody Transfers">
                <filter string="My Records" name="my_records" domain="[('create_uid', '=', uid)]"/>
                <field name="name" string="Transfer Number"/>
                <field name="picking_type_id" string="Operation Type"/>
                <field name="owner_partner_id" string="Owner"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="reference"/>
                <field name="picking_id" string="Stock Transfer"/>
                <field name="nomination_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <filter name="disputed" string="Disputed" domain="[('state','=','disputed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="filter_commercial_sale"
                        string="Commercial Sale"
                        domain="[('transfer_purpose', '=', 'commercial_sale')]"/>
                <filter name="filter_inter_facility"
                        string="Inter-Facility"
                        domain="[('transfer_purpose', '=', 'inter_facility')]"/>
                <filter name="filter_pipeline_injection"
                        string="Pipeline Injection"
                        domain="[('transfer_purpose', '=', 'pipeline_injection')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_type" string="Operation Type" context="{'group_by':'picking_type_id'}"/>
                    <filter name="group_method" string="Measurement Method" context="{'group_by':'measurement_method'}"/>
                    <filter name="group_owner" string="Legal Owner" context="{'group_by':'owner_partner_id'}"/>
                    <filter name="group_purpose" string="Transfer Purpose" context="{'group_by':'transfer_purpose'}"/>
                    <filter name="group_date" string="Transfer Date" context="{'group_by':'transfer_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- KANBAN VIEW                                                          -->
    <!-- ================================================================== -->
    <record id="view_custody_transfer_kanban" model="ir.ui.view">
        <field name="name">custody.transfer.kanban</field>
        <field name="model">custody.transfer</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="picking_type_id"/>
                <field name="transfer_date"/>
                <field name="owner_partner_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="total_planned_qty"/>
                <field name="total_actual_qty"/>
                <field name="measurement_method"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="name"/></strong>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-warning="state in ('approved','in_progress')"
                                   decoration-success="state == 'completed'"
                                   decoration-danger="state in ('cancelled','disputed')"/>
                        </div>
                        <div><span class="text-muted"><field name="picking_type_id"/></span></div>
                        <div><i class="fa fa-calendar" title="Transfer Date"/> <field name="transfer_date" widget="date"/></div>
                        <div t-if="record.owner_partner_id.value">
                            <i class="fa fa-user" title="Owner"/> <field name="owner_partner_id"/>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span>Planned: <field name="total_planned_qty"/></span>
                            <span>Actual: <field name="total_actual_qty"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- ACTIONS                                                              -->
    <!-- ================================================================== -->
    <record id="action_custody_transfer" model="ir.actions.act_window">
        <field name="name">All Transfers</field>
        <field name="res_model">custody.transfer</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_custody_transfer_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first custody transfer</p>
            <p>Custody transfers track the legal and operational handover of product custody between locations and parties.</p>
        </field>
    </record>

    <record id="action_custody_transfer_active" model="ir.actions.act_window">
        <field name="name">Active Transfers</field>
        <field name="res_model">custody.transfer</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_custody_transfer_search"/>
        <field name="domain">[('state', 'in', ['draft', 'approved', 'in_progress', 'disputed'])]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_custody_transfer_completed" model="ir.actions.act_window">
        <field name="name">Done Transfers</field>
        <field name="res_model">custody.transfer</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_custody_transfer_search"/>
        <field name="domain">[('state', '=', 'completed')]</field>
        <field name="context">{}</field>
    </record>

</odoo>