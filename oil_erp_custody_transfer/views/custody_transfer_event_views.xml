<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- This file defines views for the custody transfer event (audit) model. -->

    <record id="view_custody_transfer_event_list" model="ir.ui.view">
        <field name="name">custody.transfer.event.list</field>
        <field name="model">custody.transfer.event</field>
        <field name="arch" type="xml">
            <list string="Audit Events" create="false" delete="false">
                <field name="event_date"/>
                <field name="event_type"/>
                <field name="user_id"/>
                <field name="description"/>
                <field name="old_value"/>
                <field name="new_value"/>
            </list>
        </field>
    </record>

    <record id="view_custody_transfer_event_form" model="ir.ui.view">
        <field name="name">custody.transfer.event.form</field>
        <field name="model">custody.transfer.event</field>
        <field name="arch" type="xml">
            <form string="Audit Event" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="transfer_id"/>
                            <field name="event_type"/>
                            <field name="event_date"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="old_value"/>
                            <field name="new_value"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custody_transfer_event_search" model="ir.ui.view">
        <field name="name">custody.transfer.event.search</field>
        <field name="model">custody.transfer.event</field>
        <field name="arch" type="xml">
            <search string="Audit Events">
                <filter string="My Records" name="my_records" domain="[('user_id', '=', uid)]"/>
                <field name="transfer_id"/>
                <field name="user_id"/>
                <field name="description"/>
                <filter name="approval" string="Approvals"
                        domain="[('event_type', '=', 'approval')]"/>
                <filter name="state_change" string="State Changes"
                        domain="[('event_type', '=', 'state_change')]"/>
                <filter name="dispute" string="Disputes"
                        domain="[('event_type', 'in', ['dispute', 'dispute_resolved'])]"/>
                <group>
                    <filter name="group_type" string="Event Type"
                            context="{'group_by': 'event_type'}"/>
                    <filter name="group_transfer" string="Transfer"
                            context="{'group_by': 'transfer_id'}"/>
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_custody_transfer_event" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">custody.transfer.event</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_custody_transfer_event_search"/>
    </record>

</odoo>