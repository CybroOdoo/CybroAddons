<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Adds a Custody Transfer smart button to the stock picking form. -->

    <record id="view_stock_picking_custody_inherit" model="ir.ui.view">
        <field name="name">stock.picking.custody.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_custody_transfer"
                        type="object"
                        string="Create Custody Transfer"
                        class="oe_highlight"
                        invisible="not is_oil_gas_transfer or custody_transfer_id or state != 'assigned'"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_custody_transfer"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not custody_transfer_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Custody Transfer</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>