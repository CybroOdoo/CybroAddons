<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_anomaly" model="ir.module.category">
        <field name="name">AI Anomaly Detection</field>
        <field name="description">Manage anomaly detection for accounting.</field>
        <field name="sequence">100</field>
    </record>

    <record model="res.groups.privilege" id="res_group_privilege_anomaly">
        <field name="name">Anomaly detection</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_anomaly"/>
    </record>

    <record id="group_anomaly_viewer" model="res.groups">
        <field name="name">Auditor (View Only)</field>
        <field name="privilege_id" ref="account_anomaly_detector.res_group_privilege_anomaly"/>
        <field name="comment">Can view anomaly alerts and reports.</field>
    </record>

    <record id="group_anomaly_investigator" model="res.groups">
        <field name="name">Investigator</field>
        <field name="privilege_id" ref="account_anomaly_detector.res_group_privilege_anomaly"/>
        <field name="implied_ids" eval="[(4, ref('account_anomaly_detector.group_anomaly_viewer'))]"/>
        <field name="comment">Can investigate and resolve anomaly alerts.
        </field>
    </record>

    <record id="group_anomaly_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="account_anomaly_detector.res_group_privilege_anomaly"/>
        <field name="implied_ids" eval="[(4, ref('account_anomaly_detector.group_anomaly_investigator'))]"/>
        <field name="comment">Full access including configuration.</field>
    </record>
</odoo>
