<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="account_anomaly_detector.AnomalyDashboard">
        <div class="ad-dashboard" t-ref="rootRef">

            <!-- Loading overlay -->
            <t t-if="state.loading">
                <div class="ad-loading-overlay">
                    <div class="ad-spinner"></div>
                    <p>Loading audit data…</p>
                </div>
            </t>

            <t t-else="">
                <!-- ── Header Bar ───────────────────────────────────── -->
                <div class="ad-header">
                    <div class="ad-header-left">
                        <span class="ad-header-icon">
                            <!-- Shield SVG icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="40" height="40">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l6 2.67V11c0 3.88-2.61 7.52-6 8.87-3.39-1.35-6-4.99-6-8.87V7.67L12 5z"/>
                            </svg>
                        </span>
                        <div>
                            <h1 class="ad-header-title">AI Internal Audit Dashboard</h1>
                            <p class="ad-header-sub">Real-time anomaly detection · <span t-esc="state.lastUpdated"/></p>
                        </div>
                    </div>
                    <div class="ad-header-right">
                        <button class="ad-btn-refresh" t-on-click="onRefresh">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
                            Refresh
                        </button>
                        <!-- Theme toggle button: shows moon in light mode, sun in dark mode -->
                        <button class="ad-btn-theme-toggle" t-on-click="toggleTheme" t-att-title="state.isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode'">
                            <t t-if="state.isDark">
                                <!-- Sun icon for dark mode (click to go light) -->
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .38-.39.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .39-.38.39-1.03 0-1.41l-1.06-1.06zm1.06-12.37l-1.06 1.06c-.39.39-.39 1.03 0 1.41.39.38 1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41-.38-.39-1.03-.39-1.41 0zM7.05 18.36l-1.06 1.06c-.39.39-.39 1.03 0 1.41.39.39 1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0z"/>
                                </svg>
                            </t>
                            <t t-else="">
                                <!-- Moon icon for light mode (click to go dark) -->
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"/>
                                </svg>
                            </t>
                        </button>
                        <button class="ad-btn-scan" t-on-click="() => this.action.doAction('account_anomaly_detector.action_anomaly_scan_wizard')">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                            Run Scan
                        </button>
                    </div>
                </div>

                <!-- ── KPI Cards ─────────────────────────────────────── -->
                <div class="ad-kpi-grid">
                    <!-- Total -->
                    <div class="ad-kpi-card ad-kpi-total" t-on-click="openAll">
                        <div class="ad-kpi-svg ad-kpi-svg-total">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                        </div>
                        <div class="ad-kpi-value" t-esc="state.kpi.total"></div>
                        <div class="ad-kpi-label">Total Alerts</div>
                        <div class="ad-kpi-sub">All time</div>
                    </div>
                    <!-- Critical -->
                    <div class="ad-kpi-card ad-kpi-critical" t-on-click="openCritical">
                        <div class="ad-kpi-svg ad-kpi-svg-critical">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                        </div>
                        <div class="ad-kpi-value" t-esc="state.kpi.critical"></div>
                        <div class="ad-kpi-label">Critical</div>
                        <div class="ad-kpi-sub"><t t-esc="criticalPct"/>% of total</div>
                    </div>
                    <!-- High -->
                    <div class="ad-kpi-card ad-kpi-high" t-on-click="openHigh">
                        <div class="ad-kpi-svg ad-kpi-svg-high">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                        </div>
                        <div class="ad-kpi-value" t-esc="state.kpi.high"></div>
                        <div class="ad-kpi-label">High Risk</div>
                        <div class="ad-kpi-sub"><t t-esc="highPct"/>% of total</div>
                    </div>
                    <!-- Open -->
                    <div class="ad-kpi-card ad-kpi-open" t-on-click="openOpen">
                        <div class="ad-kpi-svg ad-kpi-svg-open">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M20 6h-2.18c.07-.44.18-.88.18-1.35C18 2.53 15.47 0 12.35 0c-1.98 0-3.6 1.15-4.35 2.85L6 6H4C2.9 6 2 6.9 2 8v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8 13l-5-5 1.41-1.41L12 16.17l7.59-7.59L21 10l-9 9z"/></svg>
                        </div>
                        <div class="ad-kpi-value" t-esc="state.kpi.open"></div>
                        <div class="ad-kpi-label">Open</div>
                        <div class="ad-kpi-sub">Needs review</div>
                    </div>
                    <!-- Investigating -->
                    <div class="ad-kpi-card ad-kpi-investigating">
                        <div class="ad-kpi-svg ad-kpi-svg-inv">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 0 0 9.5 3 6.5 6.5 0 0 0 3 9.5 6.5 6.5 0 0 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                        </div>
                        <div class="ad-kpi-value" t-esc="state.kpi.investigating"></div>
                        <div class="ad-kpi-label">Investigating</div>
                        <div class="ad-kpi-sub">In progress</div>
                    </div>
                    <!-- Escalated -->
                    <div class="ad-kpi-card ad-kpi-escalated" t-on-click="openEscalated">
                        <div class="ad-kpi-svg ad-kpi-svg-esc">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M13 3v10.38l2.29-2.3 1.42 1.42L12 17.17l-4.71-4.67 1.42-1.42L11 13.38V3h2zM5 21h14v-2H5v2z" transform="rotate(180, 12, 12)"/></svg>
                        </div>
                        <div class="ad-kpi-value" t-esc="state.kpi.escalated"></div>
                        <div class="ad-kpi-label">Escalated</div>
                        <div class="ad-kpi-sub">Urgent</div>
                    </div>
                </div>

                <!-- ── Risk Breakdown + Type Distribution ─────────────── -->
                <div class="ad-mid-grid">

                    <!-- Risk Breakdown -->
                    <div class="ad-panel">
                        <div class="ad-panel-header">
                            <span class="ad-panel-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                            </span>
                            <h2>Risk Level Breakdown</h2>
                        </div>
                        <div class="ad-risk-breakdown">
                            <!-- Critical -->
                            <div class="ad-risk-row">
                                <span class="ad-risk-label ad-risk-critical-txt">Critical</span>
                                <div class="ad-risk-bar-wrap">
                                    <div class="ad-risk-bar ad-risk-bar-critical"
                                         t-attf-style="width: {{criticalPct}}%"></div>
                                </div>
                                <span class="ad-risk-count" t-esc="state.kpi.critical"></span>
                            </div>
                            <!-- High -->
                            <div class="ad-risk-row">
                                <span class="ad-risk-label ad-risk-high-txt">High</span>
                                <div class="ad-risk-bar-wrap">
                                    <div class="ad-risk-bar ad-risk-bar-high"
                                         t-attf-style="width: {{highPct}}%"></div>
                                </div>
                                <span class="ad-risk-count" t-esc="state.kpi.high"></span>
                            </div>
                            <!-- Medium -->
                            <div class="ad-risk-row">
                                <span class="ad-risk-label ad-risk-medium-txt">Medium</span>
                                <div class="ad-risk-bar-wrap">
                                    <div class="ad-risk-bar ad-risk-bar-medium"
                                         t-attf-style="width: {{mediumPct}}%"></div>
                                </div>
                                <span class="ad-risk-count" t-esc="state.kpi.medium"></span>
                            </div>
                            <!-- Low -->
                            <div class="ad-risk-row">
                                <span class="ad-risk-label ad-risk-low-txt">Low</span>
                                <div class="ad-risk-bar-wrap">
                                    <div class="ad-risk-bar ad-risk-bar-low"
                                         t-attf-style="width: {{lowPct}}%"></div>
                                </div>
                                <span class="ad-risk-count" t-esc="state.kpi.low"></span>
                            </div>
                        </div>

                        <!-- Status summary dots -->
                        <div class="ad-risk-summary">
                            <div class="ad-risk-summary-item" t-on-click="() => this.openAlerts([['state','=','open']])">
                                <span class="ad-dot ad-dot-open"></span>
                                <span>Open: <strong t-esc="state.kpi.open"/></span>
                            </div>
                            <div class="ad-risk-summary-item">
                                <span class="ad-dot ad-dot-inv"></span>
                                <span>Investigating: <strong t-esc="state.kpi.investigating"/></span>
                            </div>
                            <div class="ad-risk-summary-item" t-on-click="() => this.openAlerts([['state','=','escalated']])">
                                <span class="ad-dot ad-dot-esc"></span>
                                <span>Escalated: <strong t-esc="state.kpi.escalated"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- Alert Type Distribution -->
                    <div class="ad-panel">
                        <div class="ad-panel-header">
                            <span class="ad-panel-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M11 2v20c-5.07-.5-9-4.79-9-10s3.93-9.5 9-10zm2.03 0v8.99H22c-.47-4.74-4.24-8.52-8.97-8.99zm0 11.01V22c4.74-.47 8.5-4.25 8.97-8.99h-8.97z"/></svg>
                            </span>
                            <h2>Alert Type Distribution</h2>
                        </div>
                        <div class="ad-type-list">
                            <t t-foreach="state.byType" t-as="item" t-key="item.key">
                                <div class="ad-type-row">
                                    <span class="ad-type-label" t-esc="item.label"></span>
                                    <div class="ad-type-bar-wrap">
                                        <div class="ad-type-bar" t-attf-style="width: {{item.pct}}%"></div>
                                    </div>
                                    <span class="ad-type-count" t-esc="item.count"></span>
                                </div>
                            </t>
                            <t t-if="!state.byType.length">
                                <div class="ad-empty-state">
                                    <p>No alerts found. Run a scan to detect anomalies.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- ── Recent Alerts Feed ─────────────────────────────── -->
                <div class="ad-panel ad-panel-full">
                    <div class="ad-panel-header">
                        <span class="ad-panel-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
                        </span>
                        <h2>Active Alerts Feed</h2>
                        <button class="ad-btn-link ms-auto" t-on-click="openAll">View all →</button>
                    </div>
                    <t t-if="state.recentAlerts.length">
                        <div class="ad-alert-table-wrap">
                            <table class="ad-alert-table">
                                <thead>
                                    <tr>
                                        <th>Alert</th>
                                        <th>Risk</th>
                                        <th>Score</th>
                                        <th>Type</th>
                                        <th>Partner</th>
                                        <th>Detected</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.recentAlerts" t-as="alert" t-key="alert.id">
                                        <tr class="ad-alert-row" t-on-click="() => this.openAlert(alert.id)">
                                            <td class="ad-alert-title">
                                                <t t-esc="alert.title"/>
                                            </td>
                                            <td>
                                                <span t-att-class="'ad-badge ' + riskBadgeClass(alert.risk_level)"
                                                      t-esc="(alert.risk_level || '').toUpperCase()"/>
                                            </td>
                                            <td>
                                                <div class="ad-score-wrap">
                                                    <div class="ad-score-bar-bg">
                                                        <div class="ad-score-bar-fill"
                                                             t-attf-style="width: {{alert.anomaly_score}}%; background: {{scoreGradient(alert.anomaly_score)}}"></div>
                                                    </div>
                                                    <span class="ad-score-num" t-esc="alert.anomaly_score"/>
                                                </div>
                                            </td>
                                            <td class="ad-type-chip" t-esc="alert.alert_type"/>
                                            <td class="ad-partner" t-esc="alert.partner || '—'"/>
                                            <td class="ad-date" t-esc="alert.detected_date"/>
                                            <td>
                                                <span t-att-class="'ad-state ' + stateBadgeClass(alert.state)"
                                                      t-esc="alert.state"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="ad-empty-state ad-empty-state-lg">
                            <div class="ad-empty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="56" height="56"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="#10b981"/></svg>
                            </div>
                            <h3>All clear! No active alerts.</h3>
                            <p>Run an anomaly scan to check your General Ledger for suspicious transactions.</p>
                            <button class="ad-btn-scan" t-on-click="() => this.action.doAction('account_anomaly_detector.action_anomaly_scan_wizard')">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                                Run Anomaly Scan
                            </button>
                        </div>
                    </t>
                </div>
            </t><!-- end t-else loading -->
        </div>
    </t>
</templates>
