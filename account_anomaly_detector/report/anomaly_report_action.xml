<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_anomaly_report" model="ir.actions.report">
        <field name="name">Anomaly Detection Report</field>
        <field name="model">account.anomaly.alert</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_anomaly_detector.report_anomaly_alerts_document</field>
        <field name="report_file">account_anomaly_detector.report_anomaly_alerts_document</field>
        <field name="print_report_name">'Anomaly_Report_%s' % (time.strftime('%Y-%m-%d'))</field>
        <field name="binding_model_id" ref="account_anomaly_detector.model_account_anomaly_alert"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
