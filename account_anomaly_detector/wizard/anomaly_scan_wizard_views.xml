<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_anomaly_scan_wizard_form" model="ir.ui.view">
        <field name="name">account.anomaly.scan.wizard.form</field>
        <field name="model">account.anomaly.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Anomaly Scan">
                <sheet>
                    <div class="oe_title">
                        <h1>🤖 AI Anomaly Detection Scan</h1>
                        <p class="text-muted">
                            Scan your General Ledger for suspicious transactions,
                            duplicate bills, and spending pattern deviations.
                        </p>
                    </div>

                    <group string="Scan Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_ids" widget="many2many_tags"
                               groups="base.group_multi_company"/>
                        <field name="scan_all"/>
                    </group>

                    <group string="Detection Algorithms to Run">
                        <group>
                            <field name="scan_amount_outliers"/>
                            <field name="scan_duplicates"/>
                            <field name="scan_round_numbers"/>
                            <field name="scan_velocity"/>
                            <field name="scan_timing"/>
                        </group>
                        <group>
                            <field name="scan_spending"/>
                            <field name="scan_benfords"/>
                            <field name="scan_account_combos"/>
                            <field name="scan_concentration"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run_scan" type="object"
                            string="🚀 Run Scan" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_anomaly_scan_wizard" model="ir.actions.act_window">
        <field name="name">Run Anomaly Scan</field>
        <field name="res_model">account.anomaly.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
