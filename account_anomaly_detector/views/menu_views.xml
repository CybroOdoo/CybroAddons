<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        NOTE: This file is loaded LAST in __manifest__.py so that all
        action records referenced here already exist in the database.
        Every action= attribute must use module-prefixed IDs.
    -->

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Top-level App Menu                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <menuitem id="menu_anomaly_root"
              name="Internal Auditor"
              sequence="99"
              web_icon="account_anomaly_detector,static/src/img/icon.png"
              groups="account_anomaly_detector.group_anomaly_viewer"/>

    <!-- ─────────── Dashboard ─────────── -->
    <menuitem id="menu_anomaly_dashboard"
              name="Dashboard"
              parent="account_anomaly_detector.menu_anomaly_root"
              action="account_anomaly_detector.action_anomaly_dashboard_client"
              sequence="10"
              groups="account_anomaly_detector.group_anomaly_viewer"/>

    <!-- ─────────── Alerts ─────────── -->
    <menuitem id="menu_anomaly_alerts_parent"
              name="Alerts"
              parent="account_anomaly_detector.menu_anomaly_root"
              sequence="20"
              groups="account_anomaly_detector.group_anomaly_viewer"/>

    <menuitem id="menu_anomaly_open_alerts"
              name="Active Alerts"
              parent="account_anomaly_detector.menu_anomaly_alerts_parent"
              action="account_anomaly_detector.action_anomaly_alerts"
              sequence="10"
              groups="account_anomaly_detector.group_anomaly_viewer"/>

    <menuitem id="menu_anomaly_all_alerts"
              name="All Alerts"
              parent="account_anomaly_detector.menu_anomaly_alerts_parent"
              action="account_anomaly_detector.action_all_anomaly_alerts"
              sequence="20"
              groups="account_anomaly_detector.group_anomaly_viewer"/>

    <menuitem id="menu_run_anomaly_scan"
              name="🔍 Run Anomaly Scan"
              parent="account_anomaly_detector.menu_anomaly_alerts_parent"
              action="account_anomaly_detector.action_anomaly_scan_wizard"
              sequence="30"
              groups="account_anomaly_detector.group_anomaly_investigator"/>

    <!-- ─────────── Analytics ─────────── -->
    <menuitem id="menu_anomaly_analytics"
              name="Analytics"
              parent="account_anomaly_detector.menu_anomaly_root"
              action="account_anomaly_detector.action_anomaly_analytics"
              sequence="30"
              groups="account_anomaly_detector.group_anomaly_viewer"/>

    <!-- ─────────── Reports ─────────── -->
    <menuitem id="menu_anomaly_reports"
              name="Reports"
              parent="account_anomaly_detector.menu_anomaly_root"
              sequence="40"
              groups="account_anomaly_detector.group_anomaly_viewer"/>

    <menuitem id="menu_anomaly_report_print"
              name="Anomaly Report"
              parent="account_anomaly_detector.menu_anomaly_reports"
              action="account_anomaly_detector.action_anomaly_report"
              sequence="10"
              groups="account_anomaly_detector.group_anomaly_viewer"/>

    <!-- ─────────── Configuration ─────────── -->
    <menuitem id="menu_anomaly_config_parent"
              name="Configuration"
              parent="account_anomaly_detector.menu_anomaly_root"
              sequence="90"
              groups="account_anomaly_detector.group_anomaly_manager"/>

    <menuitem id="menu_anomaly_config"
              name="Settings"
              parent="account_anomaly_detector.menu_anomaly_config_parent"
              action="account_anomaly_detector.action_anomaly_config_settings"
              sequence="10"
              groups="account_anomaly_detector.group_anomaly_manager"/>

    <menuitem id="menu_anomaly_rules"
              name="Detection Rules"
              parent="account_anomaly_detector.menu_anomaly_config_parent"
              action="account_anomaly_detector.action_anomaly_rules"
              sequence="20"
              groups="account_anomaly_detector.group_anomaly_manager"/>

</odoo>
