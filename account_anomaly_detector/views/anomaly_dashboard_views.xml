<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- OWL Client Action – Dashboard                          -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="action_anomaly_dashboard_client" model="ir.actions.client">
        <field name="name">Audit Dashboard</field>
        <field name="tag">account_anomaly_detector.anomaly_dashboard_action</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- GRAPH VIEW – Alerts by Type                             -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="view_anomaly_alert_graph" model="ir.ui.view">
        <field name="name">account.anomaly.alert.graph</field>
        <field name="model">account.anomaly.alert</field>
        <field name="arch" type="xml">
            <graph string="Anomaly Alerts by Type" type="bar">
                <field name="alert_type" type="row"/>
                <field name="anomaly_score" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- PIVOT VIEW                                              -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="view_anomaly_alert_pivot" model="ir.ui.view">
        <field name="name">account.anomaly.alert.pivot</field>
        <field name="model">account.anomaly.alert</field>
        <field name="arch" type="xml">
            <pivot string="Anomaly Analysis">
                <field name="risk_level" type="row"/>
                <field name="alert_type" type="col"/>
                <field name="anomaly_score" type="measure"/>
                <field name="move_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- ANALYTICS WINDOW ACTION                                 -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <record id="action_anomaly_analytics" model="ir.actions.act_window">
        <field name="name">Analytics</field>
        <field name="res_model">account.anomaly.alert</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_active_alerts': 0}</field>
    </record>
</odoo>
