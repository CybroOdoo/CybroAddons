<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_anomaly_rule_list" model="ir.ui.view">
        <field name="name">account.anomaly.rule.list</field>
        <field name="model">account.anomaly.rule</field>
        <field name="arch" type="xml">
            <list string="Anomaly Rules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="min_amount"/>
                <field name="max_amount"/>
                <field name="risk_level" widget="badge"
                       decoration-danger="risk_level == 'critical'"
                       decoration-warning="risk_level == 'high'"
                       decoration-info="risk_level == 'medium'"
                       decoration-success="risk_level == 'low'"/>
                <field name="score"/>
                <field name="hits_count" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_anomaly_rule_form" model="ir.ui.view">
        <field name="name">account.anomaly.rule.form</field>
        <field name="model">account.anomaly.rule</field>
        <field name="arch" type="xml">
            <form string="Anomaly Rule">
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Rule Name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rule_type"/>
                            <field name="risk_level"/>
                            <field name="score"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Alert Template">
                            <field name="alert_title"/>
                            <field name="description_template"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Amount Threshold"
                              invisible="rule_type != 'amount_threshold'">
                            <group>
                                <field name="min_amount"/>
                                <field name="max_amount"
                                       help="Leave 0 for no upper limit"/>
                            </group>
                        </page>
                        <page string="Account Filter"
                              invisible="rule_type != 'account_type'">
                            <field name="account_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Partner Filter"
                              invisible="rule_type != 'partner'">
                            <field name="partner_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Keywords"
                              invisible="rule_type != 'keyword'">
                            <field name="keywords"
                                   placeholder="cash, urgent, personal, no receipt"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_anomaly_rules" model="ir.actions.act_window">
        <field name="name">Detection Rules</field>
        <field name="res_model">account.anomaly.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
