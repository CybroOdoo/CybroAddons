<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit POS general settings view -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.refund.password</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="global_refund_security" string="Global Refund Password"
                         help="Set a global security password for refunds in Point of Sale.">
                    <field name="global_refund_security" password="True"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
