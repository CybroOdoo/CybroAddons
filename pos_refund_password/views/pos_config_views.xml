<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit POS configuration form view -->
    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.pos.refund.password</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <setting id="other_devices" position="after">
                <setting id="refund_security" string="Refund Password"
                         help="Set a security password for refunds in this Point of Sale.">
                    <field name="refund_security" password="True"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
