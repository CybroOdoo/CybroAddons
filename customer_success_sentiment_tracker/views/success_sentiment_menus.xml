<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Dashboard -->
    <record id="action_customer_success_sentiments_dashboard"
            model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">action_sentiments_dashboard</field>
    </record>

    <!-- Helpdesk -->
    <record id="action_helpdesk_ticket"
            model="ir.actions.act_window">
        <field name="name">Helpdesk Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Customers -->
    <record id="action_res_partner"
            model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- AI Settings -->
    <record id="action_customer_sentiment_settings"
            model="ir.actions.act_window">
        <field name="name">AI Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_sentiment"/>
        <field name="view_mode">form</field>
        <field name="context">
            {'module': 'customer_success_sentiment_tracker', 'bin_size': False }
        </field>
    </record>

    <!-- Root -->
    <menuitem
            id="menu_customer_sentiment_root"
            name="Customer Sentiments Tracker"
            sequence="10"
            groups="helpdesk.group_helpdesk_user"
            web_icon="customer_success_sentiment_tracker,static/description/icon.png"
    />

    <!-- Dashboard -->
    <menuitem
            id="customer_sentiment_dashboard"
            name="Dashboard"
            parent="menu_customer_sentiment_root"
            action="action_customer_success_sentiments_dashboard"
            sequence="1"

    />

    <!-- Configuration -->
    <menuitem
            id="menu_customer_sentiment_data"
            name="Configuration"
            parent="menu_customer_sentiment_root"
            sequence="3"

    />

    <!-- Tickets -->
    <menuitem
            id="customer_sentiment_helpdesk_ticket_menu"
            name="Helpdesk Tickets"
            parent="menu_customer_sentiment_data"
            action="action_helpdesk_ticket"
            sequence="3"
    />

    <!-- Customers -->
    <menuitem
            id="customer_sentiment_customer_menu"
            name="Customers"
            parent="menu_customer_sentiment_data"
            action="action_res_partner"
            sequence="2"
    />

    <!-- AI Settings -->
    <menuitem
            id="customer_sentiment_settings_menu"
            name="AI Settings"
            parent="menu_customer_sentiment_data"
            action="action_customer_sentiment_settings"
            sequence="1"
            groups="helpdesk.group_helpdesk_manager"
    />

</odoo>
