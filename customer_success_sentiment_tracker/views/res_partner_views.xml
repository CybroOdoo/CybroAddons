<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.customer.success.sentiment.tracker</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Customer Health" groups="helpdesk.group_helpdesk_user">

                    <group>
                        <group>
                            <field name="customer_health_label"
                                   widget="badge"
                                   decoration-danger="customer_health_score &lt;= 30"
                                   decoration-warning="customer_health_score &lt;= 45"
                                   decoration-success="customer_health_score &gt; 70"/>

                            <field name="customer_health_score"/>
                        </group>

                        <group>
                            <field name="is_at_risk" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert"
                         invisible="not is_at_risk">
                        <strong>⚠️ At Risk</strong> — This customer has a high
                        risk index based on recent helpdesk sentiment analysis.
                    </div>

                </page>
            </xpath>

        </field>
    </record>
</odoo>
