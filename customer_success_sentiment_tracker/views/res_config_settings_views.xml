<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--settings view-->
    <record id="res_config_settings_view_form_sentiment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.customer.success.sentiment.tracker</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Customer Sentiment"
                     string="Customer Sentiment"
                     name="customer_success_sentiment_tracker">
                    <block title="AI Configuration" name="sentiment_ai_settings">
                        <setting id="enable_ai_sentiment"
                                 string="Enable AI Sentiment Analysis">
                            <field name="enable_ai_sentiment"/>
                        </setting>
                        <setting id="openai_api_key"
                                 string="OpenAI API Key"
                                 invisible="not enable_ai_sentiment">
                            <div class="d-flex flex-column gap-2">
                                <field name="openai_api_key" password="True"/>
                                <div class="mt-2">
                                    <button name="action_test_openai_connection"
                                            type="object"
                                            string="Test Connection"
                                            class="btn btn-primary"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="model_id"
                                 string="OpenAI Model"
                                 invisible="not enable_ai_sentiment">
                            <field name="model_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
