<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit the production wizard form to add:
          • royalty_id      — Many2one to oil.royalty (optional)
          • royalty_line_date — period date for generated royalty lines
    -->
    <record id="view_production_wizard_form_royalty_inherit" model="ir.ui.view">
        <field name="name">production.wizard.form.royalty.inherit</field>
        <field name="model">production.wizard</field>
        <field name="inherit_id" ref="oil_erp_project.view_production_wizard_form"/>
        <field name="arch" type="xml">

            <!-- Add royalty_id and royalty_line_date inside a clean group
                 placed right after the existing two-column header groups   -->
            <xpath expr="//group[field[@name='production_date']]" position="after">
                <group string="Royalty Integration" name="group_royalty_fields">
                    <group>
                        <field name="royalty_id"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>