<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Royalty smart button to Lease form -->
    <record id="oil_lease_agreement_view_form_inherit_royalty" model="ir.ui.view">
        <field name="name">oil.lease.agreement.view.form.inherit.royalty</field>
        <field name="model">oil.lease.agreement</field>
        <field name="inherit_id" ref="oil_erp_lease.oil_lease_agreement_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_royalties"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money">
                    <field name="royalty_count" widget="statinfo" string="Royalties"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>