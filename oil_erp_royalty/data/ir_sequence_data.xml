<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file loads the ir sequence data. -->
    <data noupdate="1">
        <record id="seq_oil_royalty" model="ir.sequence">
            <field name="name">Royalty</field>
            <field name="code">oil.royalty</field>
            <field name="prefix">ROY/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
