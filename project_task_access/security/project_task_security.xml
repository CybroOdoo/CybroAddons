<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Group : Allows users to view limited projects and tasks -->
    <record id="group_view_limited_projects_and_tasks" model="res.groups">
        <field name="name">View Limited Projects and Tasks</field>
    </record>
    <!-- Record rule "Project Task Visible Users" -->
    <record id="project_task_rule_user" model="ir.access">
        <field name="name">Project Task Visible Users</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain">['|', ('task_access_user_ids', 'in', user.id), ('task_access_user_ids', '=', False)] if user.has_group('project_task_access.group_view_limited_projects_and_tasks') else []</field>
        <field name="group_id" eval="False"/>
        <field name="operation">crud</field>
        <field name="active" eval="True"/>
    </record>
    <!-- Record rule "Project Visible Users" -->
    <record id="project_project_rule_user" model="ir.access">
        <field name="name">Project Project Visible Users</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain">['|', ('project_access_user_ids', 'in', user.id), ('project_access_user_ids', '=', False)] if user.has_group('project_task_access.group_view_limited_projects_and_tasks') else []</field>
        <field name="group_id" eval="False"/>
        <field name="operation">crud</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
