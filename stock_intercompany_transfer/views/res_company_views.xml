<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.stock.inter.company</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[1]" position="after">
                <page name="inter_company" string="Inter Company Transfer">
                    <group>
                        <group>
                            <field name="enable_inter_company_transfer"/>
                            <field name="apply_transfer_type" widget="radio"
                                   invisible="not enable_inter_company_transfer"/>
                            <field name="id" invisible="1"/>
                            <field name="destination_warehouse_id"
                                   domain="[('company_id', '=', id)]"
                                   invisible="not enable_inter_company_transfer"
                                   required="enable_inter_company_transfer"/>
                        </group>
                        <div invisible="not enable_inter_company_transfer">
                            <div class="alert alert-info">
                                <div>
                                    <field name="message"/>
                                </div>
                            </div>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
