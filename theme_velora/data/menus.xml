<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Rename Contact Us to Contact -->
        <record id="website.menu_contactus" model="website.menu">
            <field name="name">Contact</field>
        </record>
        
        <!-- Add new menus -->
        <record id="menu_collections" model="website.menu">
            <field name="name">Collections</field>
            <field name="url">/collections</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
        </record>

        <record id="menu_shop" model="website.menu">
            <field name="name">Best Sellers</field>
            <field name="url">/bestsellers</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">30</field>
        </record>

        <record id="menu_aboutus" model="website.menu">
            <field name="name">Our Story</field>
            <field name="url">/about</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
