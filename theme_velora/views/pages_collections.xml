<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_collections" name="Collections">
        <t t-call="website.layout">
            <t t-set="additional_title">Collections</t>
            <div id="wrap" class="oe_structure" data-name="Collections Page Content">

                <div class="oe_structure oe_empty oe_editable">
                    <section class="page-banner">
                        <div class="page-banner-bg"></div>

                        <div class="page-banner-content container">
                            <p class="hero-eyebrow reveal"><span class="hero-eyebrow-line"></span>Crafted for Every Occasion<span class="hero-eyebrow-line"></span></p>
                            <h1 class="page-banner-title hero-title reveal">Our latest <em>Collections</em></h1>
                            <nav class="breadcrumb reveal" aria-label="Breadcrumb">
                                <a href="/">Home</a>
                                <span aria-hidden="true">/</span>
                                <span aria-current="page">Collections</span>
                            </nav>
                        </div>
                    </section>
                </div>

                <div class="oe_structure oe_empty oe_editable">
                    <section class="collections-page collections section">
                        <div class="container">
                            <div class="section-header reveal">
                                <p class="eyebrow">Signature Collection</p>
                                <h2 class="section-title">Explore Every Fragrance Story</h2>
                                <p class="section-sub">
                                    Every perfume is carefully crafted to express elegance, confidence, and individuality. Discover timeless scents inspired by nature, luxury, and unforgettable moments.
                                </p>
                            </div>

                            <div class="collection-grid">
                                <article class="collection-card reveal">
                                    <div class="collection-image">
                                        <img src="/theme_velora/static/src/img/men.jpg" alt="Men's Collection"/>
                                    </div>
                                    <div class="collection-content">
                                        <span>01</span>
                                        <h3>Men's Collection</h3>
                                        <p>Rich woody accords blended with leather, amber and fresh citrus for the modern gentleman.</p>
                                        <a t-attf-href="/shop/category/#{request.env.ref('theme_velora.theme_velora_category_mens').id}" class="btn-outline">Explore Collection</a>
                                    </div>
                                </article>

                                <article class="collection-card reveal reverse">
                                    <div class="collection-image">
                                        <img src="/theme_velora/static/src/img/women.jpg" alt="Women's Collection"/>
                                    </div>
                                    <div class="collection-content">
                                        <span>02</span>
                                        <h3>Women's Collection</h3>
                                        <p>Elegant floral compositions with jasmine, rose and vanilla, created for timeless sophistication.</p>
                                        <a t-attf-href="/shop/category/#{request.env.ref('theme_velora.theme_velora_category_womens').id}" class="btn-outline">Explore Collection</a>
                                    </div>
                                </article>

                                <article class="collection-card reveal">
                                    <div class="collection-image">
                                        <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="Unisex Collection"/>
                                    </div>
                                    <div class="collection-content">
                                        <span>03</span>
                                        <h3>Unisex Collection</h3>
                                        <p>Contemporary unisex blends featuring fresh citrus, clean musks, and green notes for universal appeal.</p>
                                        <a t-attf-href="/shop/category/#{request.env.ref('theme_velora.theme_velora_category_unisex').id}" class="btn-outline">Explore Collection</a>
                                    </div>
                                </article>
                            </div>
                        </div>
                    </section>
                </div>

            </div>
        </t>
    </template>

    <record id="page_collections_theme" model="theme.website.page">
        <field name="url">/collections</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="template_collections"/>
    </record>
</odoo>
