    <template id="s_velora_about_story" name="Velora About Story">
        <section class="about-story section s_velora_about_story" id="about"
                 style="background-color: var(--color-bg-light, #FAF9F6);"
                 data-snippet="s_velora_about_story"
                 data-name="Velora About Story">
            <div class="container">
                <div class="about-grid">

                    <!-- Left: Image with Inner Border Effect -->
                    <div class="about-image reveal">
                        <img src="/theme_velora/static/src/img/img1.jpg"
                             alt="Velora signature gold perfume bottle"
                             loading="lazy"/>
                    </div>

                    <!-- Right: Content & Stats -->
                    <div class="about-content reveal">
                        <p class="eyebrow"
                           style="letter-spacing: 0.2em; color: var(--color-text-soft); font-size: 0.8rem; margin-bottom: 1rem; text-transform: uppercase;">
                            Since 1998
                        </p>
                        <h2 class="section-title"
                            style="font-size: 3.5rem; line-height: 1.1; margin-bottom: 1.5rem; color: var(--color-black); font-family: 'Playfair Display', serif;">
                            The Art of<br/>Fine Perfumery
                        </h2>
                        <p style="font-size: 1.05rem; line-height: 1.8; color: var(--color-text-soft); margin-bottom: 1.5rem;">
                            Velora was born from a singular obsession:
                            to bottle emotion. In our Grasse atelier,
                            master perfumers blend the rarest absolutes
                            and precious woods, aging every composition
                            to perfection before it ever reaches you.
                        </p>
                        <p style="font-size: 1.05rem; line-height: 1.8; color: var(--color-text-soft); margin-bottom: 2rem;">
                            Every bottle is a promise — of
                            craftsmanship, of heritage, and of a scent
                            that becomes unmistakably yours.
                        </p>

                        <!-- Stats Section -->
                        <div class="stats-grid">
                            <div class="stat">
                                <span class="stat-number"
                                      data-count="27"
                                      style="color: var(--color-gold-dark);">
                                    0
                                </span>
                                <span class="stat-label"
                                      style="font-size: 0.75rem; color: var(--color-text-soft); margin-top: 0.5rem;">
                                    Years of Heritage
                                </span>
                            </div>
                            <div class="stat">
                                <span class="stat-number"
                                      data-count="150"
                                      style="color: var(--color-gold-dark);">
                                    0
                                </span>
                                <span class="stat-label"
                                      style="font-size: 0.75rem; color: var(--color-text-soft); margin-top: 0.5rem;">
                                    Signature Scents
                                </span>
                            </div>
                            <div class="stat">
                                <span class="stat-number"
                                      data-count="2400"
                                      style="color: var(--color-gold-dark);">
                                    0
                                </span>
                                <span class="stat-label"
                                      style="font-size: 0.75rem; color: var(--color-text-soft); margin-top: 0.5rem;">
                                    Happy Customers
                                </span>
                            </div>
                            <div class="stat">
                                <span class="stat-number"
                                      data-count="48"
                                      style="color: var(--color-gold-dark);">
                                    0
                                </span>
                                <span class="stat-label"
                                      style="font-size: 0.75rem; color: var(--color-text-soft); margin-top: 0.5rem;">
                                    Countries Reached
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_velora_why_us" name="Velora Why Us">
        <section class="why-us section s_velora_why_us"
                 data-snippet="s_velora_why_us" data-name="Velora Why Us">
            <!-- <img src="/theme_velora/static/src/img/bg.jpg" alt="" loading="lazy"/> -->
            <div class="why-us-overlay"></div>
            <div class="container">
                <div class="section-head reveal">
                    <p class="eyebrow">The Velora Promise</p>
                    <h2 class="section-title">Why Choose Us</h2>
                </div>

                <div class="feature-grid">
                    <div class="feature-card reveal">
                        <i class="fa-solid fa-certificate"></i>
                        <h3>Authentic Products</h3>
                        <p>100% genuine fragrances sourced directly from
                            the house of Velora.
                        </p>
                    </div>
                    <div class="feature-card reveal">
                        <i class="fa-solid fa-box-open"></i>
                        <h3>Luxury Packaging</h3>
                        <p>Every order arrives wrapped in signature
                            velvet and gold foil detailing.
                        </p>
                    </div>
                    <div class="feature-card reveal">
                        <i class="fa-solid fa-lock"></i>
                        <h3>Secure Payment</h3>
