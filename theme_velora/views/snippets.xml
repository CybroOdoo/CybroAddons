                    </a>
                    <a class="category-card reveal"
                       t-attf-href="#{request.env.ref('theme_velora.theme_velora_category_citrus', raise_if_not_found=False) and ('/shop/category/' + str(request.env.ref('theme_velora.theme_velora_category_citrus').id)) or ('/theme_velora/category/Citrus')}"
                       data-note="Citrus">
                        <i class="fa-solid fa-lemon"></i>
                        <span>Citrus</span>
                    </a>
                    <a class="category-card reveal"
                       t-attf-href="#{request.env.ref('theme_velora.theme_velora_category_amber', raise_if_not_found=False) and ('/shop/category/' + str(request.env.ref('theme_velora.theme_velora_category_amber').id)) or ('/theme_velora/category/Amber')}"
                       data-note="Amber">
                        <i class="fa-solid fa-gem"></i>
                        <span>Amber</span>
                    </a>
                    <a class="category-card reveal"
                       t-attf-href="#{request.env.ref('theme_velora.theme_velora_category_musk', raise_if_not_found=False) and ('/shop/category/' + str(request.env.ref('theme_velora.theme_velora_category_musk').id)) or ('/theme_velora/category/Musk')}"
                       data-note="Musk">
                        <i class="fa-solid fa-feather"></i>
                        <span>Musk</span>
                    </a>
                    <a class="category-card reveal"
                       t-attf-href="#{request.env.ref('theme_velora.theme_velora_category_oriental', raise_if_not_found=False) and ('/shop/category/' + str(request.env.ref('theme_velora.theme_velora_category_oriental').id)) or ('/theme_velora/category/Oriental')}"
                       data-note="Oriental">
                        <i class="fa-solid fa-moon"></i>
                        <span>Oriental</span>
                    </a>
                    <a class="category-card reveal"
                       t-attf-href="#{request.env.ref('theme_velora.theme_velora_category_aquatic', raise_if_not_found=False) and ('/shop/category/' + str(request.env.ref('theme_velora.theme_velora_category_aquatic').id)) or ('/theme_velora/category/Aquatic')}"
                       data-note="Aquatic">
                        <i class="fa-solid fa-water"></i>
