<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="velora_snippets" inherit_id="website.snippets"
              name="Velora Snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="velora" t-snippet="website.s_snippet_group"
               string="Theme Velora"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_group.svg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_velora.s_velora_hero" string="Velora Hero"
               group="velora" label="Hero"
               t-thumbnail="/theme_velora/static/src/img/snippets_thumbs/hero.png"
               t-image-preview="/theme_velora/static/src/img/snippets_thumbs/hero.png"/>
            <t t-snippet="theme_velora.s_velora_collections"
               string="Velora Collections" group="velora" label="Collections"
               t-thumbnail="/theme_velora/static/src/img/snippets_thumbs/collections.png"
               t-image-preview="/theme_velora/static/src/img/snippets_thumbs/collections.png"/>
            <t t-snippet="theme_velora.s_velora_bestsellers"
               string="Velora Bestsellers" group="velora" label="Bestsellers"
               t-thumbnail="/theme_velora/static/src/img/snippets_thumbs/bestsellers.png"
               t-image-preview="/theme_velora/static/src/img/snippets_thumbs/bestsellers.png"/>
            <t t-snippet="theme_velora.s_velora_categories"
               string="Velora Categories" group="velora" label="Categories"
               t-thumbnail="/theme_velora/static/src/img/snippets_thumbs/categories.png"
               t-image-preview="/theme_velora/static/src/img/snippets_thumbs/categories.png"/>
            <t t-snippet="theme_velora.s_velora_about_story"
               string="Velora About Story" group="velora" label="About Story"
               t-thumbnail="/theme_velora/static/src/img/snippets_thumbs/about_velora.png"
               t-image-preview="/theme_velora/static/src/img/snippets_thumbs/about_velora.png"/>
            <t t-snippet="theme_velora.s_velora_why_us" string="Velora Why Us"
               group="velora" label="Why Us"
               t-thumbnail="/theme_velora/static/src/img/snippets_thumbs/why_us.png"
               t-image-preview="/theme_velora/static/src/img/snippets_thumbs/why_us.png"/>
            <t t-snippet="theme_velora.s_velora_testimonials"
               string="Velora Testimonials" group="velora" label="Testimonials"
               t-thumbnail="/theme_velora/static/src/img/snippets_thumbs/testimonials.png"
               t-image-preview="/theme_velora/static/src/img/snippets_thumbs/testimonials.png"/>
            <t t-snippet="theme_velora.s_velora_faq" string="Velora FAQ"
               group="velora" label="FAQ"
               t-thumbnail="/theme_velora/static/src/img/snippets_thumbs/faq.png"
               t-image-preview="/theme_velora/static/src/img/snippets_thumbs/faq.png"/>
            <t t-snippet="theme_velora.s_velora_newsletter"
               string="Velora Newsletter" group="velora" label="Newsletter"
               t-thumbnail="/theme_velora/static/src/img/snippets_thumbs/newsletter_subscribe_form.png"
               t-image-preview="/theme_velora/static/src/img/snippets_thumbs/newsletter_subscribe_form.png"/>
        </xpath>
    </template>

    <template id="s_velora_hero" name="Velora Hero">
        <section class="hero s_velora_hero" id="hero"
                 data-snippet="s_velora_hero" data-name="Velora Hero">
            <div class="hero-bg">
                <img src="/theme_velora/static/src/img/hero.webp"
                     alt="Velora signature perfume bottle on marble surface with golden light"
                     loading="eager"/>
                <div class="hero-overlay"></div>
            </div>

            <div class="hero-text-top">
                <!-- <p class="hero-eyebrow reveal"><span class="hero-eyebrow-line"></span>Maison de Parfum<span class="hero-eyebrow-line"></span></p> -->
                <h1 class="hero-title">
                    <span class="title-line reveal">Discover Your</span>
                    <br/>
                    <em class="title-line title-line-gold reveal">
                        Signature<br/>Scent
                    </em>
                </h1>
            </div>

            <div class="hero-text-bottom">
                <p class="hero-desc reveal">Exquisitely crafted
                    fragrances born from rare botanicals and precious
                    woods — an olfactory journey designed for those who
                    leave a lasting impression.
                </p>
                <div class="hero-actions reveal">
                    <a href="/bestsellers" class="btn btn-primary">
                        <span>Shop Best Sellers</span>
                    </a>
                    <a href="/about" class="btn btn-outline-light">
                        <span>Explore Our Story</span>
                    </a>
                </div>
            </div>


        </section>
    </template>

    <template id="s_velora_collections" name="Velora Collections">
        <section class="collections section s_velora_collections"
                 id="collections"
                 style="background-color: var(--color-bg-light, #FAF9F6);"
                 data-snippet="s_velora_collections"
                 data-name="Velora Collections">
            <div class="container">
                <div class="section-head reveal">
                    <p class="eyebrow">Curated For You</p>
                    <h2 class="section-title">Featured Collections</h2>
                    <p class="section-sub">Each collection tells a
                        different story — find the one that speaks to
                        you.
                    </p>
                </div>

                <div class="collection-grid">
                    <article class="collection-card reveal large">
                        <img src="https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?q=80&amp;w=1200&amp;auto=format&amp;fit=crop"
                             alt="Men's fragrance collection bottle"
                             loading="lazy"/>
                        <div class="collection-overlay">
                            <h3>Men's Collection</h3>
                            <p>Bold, woody &amp; magnetic</p>
                            <a t-attf-href="/shop/category/#{request.env.ref('theme_velora.theme_velora_category_mens').id}"
                               class="btn btn-gold-outline">Shop Now
                            </a>
                        </div>
                    </article>

                    <article class="collection-card reveal">
                        <img src="https://images.unsplash.com/photo-1587017539504-67cfbddac569?q=80&amp;w=1200&amp;auto=format&amp;fit=crop"
                             alt="Women's fragrance collection bottle"
                             loading="lazy"/>
                        <div class="collection-overlay">
                            <h3>Women's Collection</h3>
                            <p>Floral, radiant &amp; timeless</p>
                            <a t-attf-href="/shop/category/#{request.env.ref('theme_velora.theme_velora_category_womens').id}"
                               class="btn btn-gold-outline">Shop Now
                            </a>
                        </div>
                    </article>

                    <article class="collection-card reveal">
                        <img src="https://images.unsplash.com/photo-1523293182086-7651a899d37f?q=80&amp;w=1200&amp;auto=format&amp;fit=crop"
                             alt="Unisex fragrance collection bottle"
                             loading="lazy"/>
                        <div class="collection-overlay">
                            <h3>Unisex</h3>
                            <p>Fluid, modern &amp; bold</p>
                            <a t-attf-href="/shop/category/#{request.env.ref('theme_velora.theme_velora_category_unisex').id}"
                               class="btn btn-gold-outline">Shop Now
                            </a>
                        </div>
                    </article>

                    <article class="collection-card reveal">
                        <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?q=80&amp;w=800&amp;auto=format&amp;fit=crop"
                             alt="Luxury gift set of perfumes"
                             loading="lazy"/>
                        <div class="collection-overlay">
                            <h3>Luxury Gift Sets</h3>
                            <p>Curated with elegance</p>
                            <a t-attf-href="/shop/category/#{request.env.ref('theme_velora.theme_velora_category_gift_sets').id}"
                               class="btn btn-gold-outline">Shop Now
                            </a>
                        </div>
                    </article>

                    <article class="collection-card reveal">
                        <img src="https://images.unsplash.com/photo-1615529182904-14819c35db37?q=80&amp;w=1200&amp;auto=format&amp;fit=crop"
                             alt="Limited edition perfume bottle"
                             loading="lazy"/>
                        <div class="collection-overlay">
                            <h3>Limited Editions</h3>
                            <p>Rare &amp; exclusive releases</p>
                            <a t-attf-href="/shop/category/#{request.env.ref('theme_velora.theme_velora_category_limited_editions').id}"
                               class="btn btn-gold-outline">Shop Now
                            </a>
                        </div>
                    </article>
                </div>
            </div>
        </section>
    </template>

    <template id="s_velora_bestsellers" name="Velora Bestsellers">
        <section class="bestsellers section s_velora_bestsellers"
                 id="bestsellers" data-snippet="s_velora_bestsellers"
                 data-name="Velora Bestsellers">
            <div class="container">
                <div class="section-head reveal">
                    <p class="eyebrow">Adored Worldwide</p>
                    <h2 class="section-title">Best Sellers</h2>
                    <p class="section-sub">The fragrances our
                        connoisseurs return to again and again.
                    </p>
                </div>

                <div class="product-grid">
                    <t t-set="products"
                       t-value="request.env['product.template'].sudo().search([('website_published', '=', True), ('sale_ok', '=', True)], limit=3, order='create_date desc')"/>
                    <t t-foreach="products" t-as="product">
                        <article class="product-card reveal">
                            <div class="product-media">
                                <t t-set="ribbon"
                                   t-value="product.website_ribbon_id"/>
                                <span class="discount-badge"
                                      t-if="ribbon"
                                      t-out="ribbon.name"/>
                                <button type="button" class="wishlist-btn o_add_wishlist"
                                        t-att-data-product-product-id="product.product_variant_id.id or product._get_first_possible_variant_id()"
                                        t-att-data-product-template-id="product.id"
                                        data-action="o_wishlist"
                                        aria-label="Add to wishlist">
                                    <i class="fa-regular fa-heart"></i>
                                </button>
                                <a t-attf-href="/shop/#{product.id}">
                                    <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                                         t-att-alt="product.name"
                                         loading="lazy"/>
                                </a>
                            </div>
                            <div class="product-info">
                                <span class="product-brand">Velora
                                    Maison
                                </span>
                                <h3 class="product-name">
                                    <a t-attf-href="/shop/#{product.id}"
                                       t-field="product.name"/>
                                </h3>
                                <p class="product-desc">A luxurious
                                    fragrance crafted with the finest
                                    ingredients.
                                </p>

                                <div class="product-rating">
                                    <span aria-hidden="true"
                                          style="color:var(--color-gold)">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star-half-stroke"></i>
                                    </span>
                                    <span>4.8 (97)</span>
                                </div>

                                <div class="product-price-row">
                                    <div class="price-group">
                                        <span class="price-current"
                                              t-field="product.list_price"
                                              t-options="{'widget': 'monetary', 'display_currency': request.env.company.currency_id}"/>
                                    </div>
                                    <button class="add-cart-btn btn-full-text"
                                            t-att-data-product-id="product.product_variant_id.id"
                                            t-att-data-template-id="product.id"
                                            t-attf-aria-label="Add #{product.name} to cart">
                                        ADD TO CART
                                    </button>
                                </div>
                            </div>
                        </article>
                    </t>
                </div>
            </div>
        </section>
    </template>

    <template id="s_velora_categories" name="Velora Categories">
        <section class="categories section s_velora_categories" id="categories"
                 data-snippet="s_velora_categories"
                 data-name="Velora Categories">
            <div class="container">
                <div class="section-head reveal">
                    <p class="eyebrow">Find Your Note</p>
                    <h2 class="section-title">Fragrance Categories</h2>
                    <p class="section-sub">Every scent tells a story.
                        Which one is yours?
                    </p>
                </div>

                <div class="category-grid">
                    <a class="category-card reveal"
                       t-attf-href="#{request.env.ref('theme_velora.theme_velora_category_floral', raise_if_not_found=False) and ('/shop/category/' + str(request.env.ref('theme_velora.theme_velora_category_floral').id)) or ('/theme_velora/category/Floral')}"
                       data-note="Floral">
