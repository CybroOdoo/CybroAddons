    <template id="s_velora_testimonials" name="Velora Testimonials">
        <section class="testimonials section s_velora_testimonials"
                 id="testimonials" data-snippet="s_velora_testimonials"
                 data-name="Velora Testimonials">
            <div class="container">
                <div class="section-head reveal">
                    <p class="eyebrow">Loved By Many</p>
                    <h2 class="section-title">What Our Clients Say</h2>
                </div>

                <div class="testimonial-track-wrap reveal">
                    <div class="testimonial-track"
                         id="testimonialTrack">
                        <article class="testimonial-card">
                            <div class="stars"
                                 aria-label="5 out of 5 stars">★★★★★
                            </div>
                            <p>"Velora Noir Oud has become my identity.
                                I receive compliments every single time
                                I wear it. The packaging alone feels
                                like a luxury gift."
                            </p>
                            <div class="testimonial-author">
                                <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&amp;w=200&amp;auto=format&amp;fit=crop"
                                     alt="Portrait of Amara S."
                                     loading="lazy"/>
                                <div>
                                    <strong>Amara S.</strong>
                                    <span>Dubai, UAE</span>
                                </div>
                            </div>
                        </article>

                        <article class="testimonial-card">
                            <div class="stars"
                                 aria-label="5 out of 5 stars">★★★★★
                            </div>
                            <p>"The longevity is unmatched. A single
                                spritz of Velora Rose Elixir lasts me
                                the entire day. Truly a masterpiece of
                                perfumery."
                            </p>
                            <div class="testimonial-author">
                                <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&amp;w=200&amp;auto=format&amp;fit=crop"
                                     alt="Portrait of Julien M."
                                     loading="lazy"/>
                                <div>
                                    <strong>Julien M.</strong>
                                    <span>Paris, France</span>
                                </div>
                            </div>
                        </article>

                        <article class="testimonial-card">
                            <div class="stars"
                                 aria-label="5 out of 5 stars">★★★★★
                            </div>
                            <p>"From unboxing to first spray, everything
                                about Velora feels premium. Fast
                                shipping and the gift wrap made my
                                anniversary gift unforgettable."
                            </p>
                            <div class="testimonial-author">
                                <img src="https://images.unsplash.com/photo-1531123897727-8f129e1688ce?q=80&amp;w=200&amp;auto=format&amp;fit=crop"
                                     alt="Portrait of Sophia L."
                                     loading="lazy"/>
                                <div>
                                    <strong>Sophia L.</strong>
                                    <span>New York, USA</span>
                                </div>
                            </div>
                        </article>

                        <article class="testimonial-card">
