                        <span>Floral</span>
                    </a>
                    <a class="category-card reveal"
                       t-attf-href="#{request.env.ref('theme_velora.theme_velora_category_woody', raise_if_not_found=False) and ('/shop/category/' + str(request.env.ref('theme_velora.theme_velora_category_woody').id)) or ('/theme_velora/category/Woody')}"
                       data-note="Woody">
                        <i class="fa-solid fa-tree"></i>
                        <span>Woody</span>
                    </a>
                    <a class="category-card reveal"
                       t-attf-href="#{request.env.ref('theme_velora.theme_velora_category_fresh', raise_if_not_found=False) and ('/shop/category/' + str(request.env.ref('theme_velora.theme_velora_category_fresh').id)) or ('/theme_velora/category/Fresh')}"
                       data-note="Fresh">
                        <i class="fa-solid fa-wind"></i>
