<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override Login Layout -->
    <template id="theme_velora_login_layout" inherit_id="web.login_layout" name="Theme Velora Login Layout">
        <!-- Change background color from bg-100 to default -->
        <xpath expr="//t[@t-set='body_classname']" position="attributes">
            <attribute name="t-value">''</attribute>
        </xpath>
        <!-- Replace the default card container with the Velora banner and contact form wrapper -->
        <xpath expr="//div[hasclass('container', 'py-5')]" position="replace">
            <section class="page-banner">
                <div class="page-banner-bg"></div>
                <div class="page-banner-content container">
                    <h1 class="page-banner-title hero-title reveal">
                        Welcome <em>Back</em>
                    </h1>
                </div>
            </section>
            <section class="section">
                <div class="container" style="max-width: 600px; margin: 0 auto;">
                    <div class="contact-form reveal">
                        <div class="section-head" style="margin-bottom: 2rem;">
                            <h2 class="section-title" style="font-size: 2rem;">Sign In</h2>
                            <p>Enter your email and password to access your account.</p>
                        </div>
                        <t t-out="0"/>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!-- Override Login Form -->
    <template id="theme_velora_login" inherit_id="web.login" name="Theme Velora Login Form">
        <xpath expr="//form" position="attributes">
            <attribute name="class" add="form-wrapper" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]" position="attributes">
            <attribute name="class" add="form-field" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="attributes">
            <attribute name="class" add="form-field" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]//button[@type='submit']" position="attributes">
            <attribute name="class" add="btn-full" separator=" "/>
        </xpath>
    </template>
</odoo>
