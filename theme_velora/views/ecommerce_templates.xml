<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override Shop Layout -->
    <template id="theme_velora_products" inherit_id="website_sale.products"
              name="Theme Velora Products">
        <!-- Add Page Banner above the main container -->
        <xpath expr="//div[@id='o_wsale_container']" position="before">
            <div class="oe_structure oe_empty oe_editable">
                <section class="page-banner">
                    <div class="page-banner-bg"></div>
                    <div class="page-banner-content container">
                        <p class="hero-eyebrow reveal">
                            <span class="hero-eyebrow-line"></span>
                            <t t-if="search">Search Results</t>
                            <t t-else="">Luxury Fragrances</t>
                            <span class="hero-eyebrow-line"></span>
                        </p>
                        <h1 class="page-banner-title hero-title reveal">
                            <t t-if="search">
                                Search
                                <em>Results</em>
                            </t>
                            <t t-elif="category">
                                <t t-out="category.name"/>
                            </t>
                            <t t-else="">
                                Shop
                                <em>Fragrances</em>
                            </t>
                        </h1>
                        <nav class="breadcrumb reveal">
                            <a href="/">Home</a>
                            <span>/</span>
                            <t t-if="search">
                                <a href="/shop">Shop</a>
                                <span>/</span>
                                <span t-out="'Search: %s' % search"/>
                            </t>
                            <t t-elif="category">
                                <a href="/shop">Shop</a>
                                <span>/</span>
                                <span t-out="category.name"/>
                            </t>
                            <t t-else="">
                                <span>Shop</span>
                            </t>
                        </nav>
                    </div>
                </section>
            </div>
        </xpath>

        <!-- Odoo 20 dropped the pricelist dropdown from the shop toolbar (it now lives in the
             default website header/footer, which this theme replaces). Restore it before "Sort by". -->
        <xpath expr="//div[contains(@t-attf-class, 'o_wsale_products_header_dropdown_wrap')]/t[@t-call='website_sale.sort']" position="before">
            <div t-if="not hide_pricelist_selector and website_sale_pricelists and len(website_sale_pricelists) &gt; 1"
                 class="o_wsale_pricelist_selector dropdown d-flex align-items-center">
                <t t-set="active_pricelist" t-value="website.pricelist_id"/>
                <a role="button" href="#" class="dropdown-toggle btn px-2" data-bs-toggle="dropdown">
                    <small class="d-none d-md-inline opacity-75">Pricelist:</small>
                    <span class="text-truncate" t-out="active_pricelist.name"/>
                </a>
                <div class="dropdown-menu dropdown-menu-end" role="menu">
                    <a t-foreach="website_sale_pricelists" t-as="pricelist"
                       t-attf-class="dropdown-item {{pricelist == active_pricelist and 'active'}}"
                       t-attf-href="/shop/change_pricelist/#{pricelist.id}">
                        <span t-out="pricelist.name"/>
                    </a>
                </div>
            </div>
        </xpath>

    </template>

    <!-- Override Product Item (Card) -->
    <template id="theme_velora_products_item"
              inherit_id="website_sale.products_item"
              name="Theme Velora Product Item">
        <xpath expr="//article" position="replace">
            <t t-set="template_price_vals"
               t-value="template_price_vals or get_product_prices(product)"/>
            <t t-set="variant_id"
               t-value="product_variant.id if product_variant else product.product_variant_id.id"/>
            <article class="product-card reveal oe_product_cart h-100"
                     t-att-data-publish="product.website_published and 'on' or 'off'"
                     t-att-aria-label="product.name"
                     t-att-data-product-tracking-info="json.dumps((product_tracking_infos or {}).get(product.id, {}))"
                     t-att-data-product-ga-currency="website.currency_id.name">

                <div class="product-media">
                    <span t-if="show_ribbons and ribbon" class="discount-badge" t-out="ribbon.name"/>
                    <span t-if="not product.website_published" class="discount-badge"
                          style="background-color: #dc3545;">Unpublished
                    </span>

                    <t t-if="extra_actions">
                        <button type="button" class="wishlist-btn o_wish_rm"
                                t-att-data-wish-id="wish.id if wish else ''"
                                title="Remove from wishlist"
                                aria-label="Remove from wishlist">
                            <i class="oi oi-filled" data-icon="close"></i>
                        </button>
                    </t>
                    <t t-else="">
                        <button type="button" class="wishlist-btn velora-wish-add"
                                t-att-data-product-product-id="variant_id"
                                t-att-data-product-template-id="product.id"
                                aria-label="Add to wishlist">
                            <i class="oi" data-icon="favorite"></i>
                        </button>
                    </t>
                    <a t-att-href="product_href">
                        <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                             t-att-alt="product.name" loading="lazy"/>
                    </a>
                </div>

                <div class="product-info">
                    <span class="product-brand">Velora Maison</span>
                    <h3 class="product-name">
                        <a t-att-href="product_href" t-field="product.name"/>
                    </h3>
                    <p class="product-desc" t-if="product.description_sale"
                       t-field="product.description_sale"/>

                    <div class="product-price-row">
                        <div class="price-group">
                            <span class="price-current"
                                  t-out="template_price_vals['price_reduce']"
                                  t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            <del t-if="'base_price' in template_price_vals and template_price_vals['base_price'] &gt; template_price_vals['price_reduce']"
                                 class="price-old text-muted ms-2">
                                <small t-out="template_price_vals['base_price']"
                                       t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            </del>
                        </div>
                        <button type="button"
                                t-attf-class="add-cart-btn btn-full-text #{'o_wish_add' if extra_actions else 'a-submit'}"
                                t-att-data-product-id="variant_id"
                                t-att-data-product-product-id="variant_id"
                                t-att-data-template-id="product.id"
                                t-att-data-product-template-id="product.id"
                                t-att-data-product-type="product.type"
                                t-attf-aria-label="Add #{product.name} to cart">
                            ADD TO CART
                        </button>
                    </div>
                </div>
            </article>
        </xpath>
    </template>

    <!-- Order confirmation: add the Velora banner but keep Odoo's payment status,
         order summary and tracking content. -->
    <template id="theme_velora_confirmation"
              inherit_id="website_sale.confirmation"
              name="Theme Velora Confirmation">
        <xpath expr="//t[@t-call='website_sale.checkout_layout']" position="before">
            <div class="oe_structure oe_empty oe_editable">
                <section class="page-banner">
                    <div class="page-banner-bg"></div>
                    <div class="page-banner-content container">
                        <p class="hero-eyebrow reveal">
                            <span class="hero-eyebrow-line"></span>
                            Thank You
                            <span class="hero-eyebrow-line"></span>
                        </p>
                        <h1 class="page-banner-title hero-title reveal">
                            Order <em>Confirmed</em>
                        </h1>
                        <nav class="breadcrumb reveal" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <span aria-hidden="true">/</span>
                            <span aria-current="page">Confirmation</span>
                        </nav>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- Override Wishlist Layout -->
    <template id="theme_velora_wishlist" inherit_id="website_sale.product_wishlist"
              name="Theme Velora Wishlist">
        <xpath expr="//div[hasclass('oe_website_sale')]" position="before">
            <div class="oe_structure oe_empty oe_editable">
                <section class="page-banner">
                    <div class="page-banner-bg"></div>
                    <div class="page-banner-content container">
                        <p class="hero-eyebrow reveal">
                            <span class="hero-eyebrow-line"></span>
                            Your Curated Favorites
                            <span class="hero-eyebrow-line"></span>
                        </p>
                        <h1 class="page-banner-title hero-title reveal">
                            My
                            <em>Wishlist</em>
                        </h1>
                        <nav class="breadcrumb reveal" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <span aria-hidden="true">/</span>
                            <span aria-current="page">Wishlist</span>
                        </nav>
                    </div>
                </section>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_wishlist_products_header')]" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
    </template>
</odoo>