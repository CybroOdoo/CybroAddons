<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- home page -->
    <template id="theme_velora_homepage" inherit_id="website.homepage"
              name="Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
             <div id="wrap" class="oe_structure oe_empty o_editable">
                 <div class="oe_structure oe_empty o_editable">
              <section class="hero section s_velora_hero" id="velora_hero" data-snippet="s_velora_hero" data-name="Velora Hero">
                <div class="oe_structure"/>
                <div class="hero-bg">
                    <img src="/theme_velora/static/src/img/hero.webp"
                         alt="Velora signature perfume bottle on marble surface with golden light"
                         loading="eager"/>
                    <div class="hero-overlay"></div>
                </div>

                <div class="hero-text-top">
                    <h1 class="hero-title">
                        <span class="title-line reveal">Discover Your</span>
                        <br/>
                        <em class="title-line title-line-gold reveal">
                            Signature<br/>Scent
                        </em>
                    </h1>
                </div>

                <div class="hero-text-bottom">
                    <p class="hero-desc reveal">Exquisitely crafted
                        fragrances born from rare botanicals and precious
                        woods — an olfactory journey designed for those who
                        leave a lasting impression.
                    </p>
                    <div class="hero-actions reveal">
                        <a href="/bestsellers" class="btn btn-primary">
                            <span>Shop Best Sellers</span>
                        </a>
                        <a href="/about-us" class="btn btn-outline-light">
                            <span>Explore Our Story</span>
                        </a>
                    </div>

                </div>
            </section>
                 </div>
                <div class="oe_structure oe_empty o_editable">
                <section class="collections section s_velora_collections" id="velora_collections"
                         style="background-color: var(&#45;&#45;color-bg-light, #FAF9F6);" data-snippet="s_velora_collections" data-name="Velora Collections">
                    <div class="oe_structure"/>
                    <div class="container">
                        <div class="section-head reveal">
                            <p class="eyebrow">Curated For You</p>
                            <h2 class="section-title">Featured Collections</h2>
                            <p class="section-sub">Each collection tells a
                                different story — find the one that speaks to
                                you.
                            </p>
                        </div>

                        <div class="collection-grid">
                            <article class="collection-card reveal large">
                                <img src="https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?q=80&amp;w=1200&amp;auto=format&amp;fit=crop"
                                     alt="Men's fragrance collection bottle"
                                     loading="lazy"/>
                                <div class="collection-overlay">
                                    <h3>Men's Collection</h3>
                                    <p>Bold, woody &amp; magnetic</p>
                                    <a href="/collections/redirect?name=Men%27s%20Collection"
                                       class="btn btn-gold-outline">Shop Now
                                    </a>
                                </div>
                            </article>

                            <article class="collection-card reveal">
                                <img src="https://images.unsplash.com/photo-1587017539504-67cfbddac569?q=80&amp;w=1200&amp;auto=format&amp;fit=crop"
                                     alt="Women's fragrance collection bottle"
                                     loading="lazy"/>
                                <div class="collection-overlay">
                                    <h3>Women's Collection</h3>
                                    <p>Floral, radiant &amp; timeless</p>
                                    <a href="/collections/redirect?name=Women%27s%20Collection"
                                       class="btn btn-gold-outline">Shop Now
                                    </a>
                                </div>
                            </article>

                            <article class="collection-card reveal">
                                <img src="https://images.unsplash.com/photo-1523293182086-7651a899d37f?q=80&amp;w=1200&amp;auto=format&amp;fit=crop"
                                     alt="Unisex fragrance collection bottle"
                                     loading="lazy"/>
                                <div class="collection-overlay">
                                    <h3>Unisex</h3>
                                    <p>Fluid, modern &amp; bold</p>
                                    <a href="/collections/redirect?name=Unisex"
                                       class="btn btn-gold-outline">Shop Now
                                    </a>
                                </div>
                            </article>

                            <article class="collection-card reveal">
                                <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?q=80&amp;w=800&amp;auto=format&amp;fit=crop"
                                     alt="Luxury gift set of perfumes"
                                     loading="lazy"/>
                                <div class="collection-overlay">
                                    <h3>Luxury Gift Sets</h3>
                                    <p>Curated with elegance</p>
                                    <a href="/collections/redirect?name=Luxury%20Gift%20Sets"
                                       class="btn btn-gold-outline">Shop Now
                                    </a>
                                </div>
                            </article>

                            <article class="collection-card reveal">
                                <img src="https://images.unsplash.com/photo-1615529182904-14819c35db37?q=80&amp;w=1200&amp;auto=format&amp;fit=crop"
                                     alt="Limited edition perfume bottle"
                                     loading="lazy"/>
                                <div class="collection-overlay">
                                    <h3>Limited Editions</h3>
                                    <p>Rare &amp; exclusive releases</p>
                                    <a href="/collections/redirect?name=Limited%20Editions"
                                       class="btn btn-gold-outline">Shop Now
                                    </a>
                                </div>
                            </article>
                        </div>
                    </div>
                </section>
                </div>

                <section class="bestsellers section s_velora_bestsellers" id="velora_bestsellers" data-snippet="s_velora_bestsellers" data-name="Velora Bestsellers">
                    <div class="oe_structure"/>
                    <div class="container">
                        <div class="section-head reveal">
                            <p class="eyebrow">Adored Worldwide</p>
                            <h2 class="section-title">Best Sellers</h2>
                            <p class="section-sub">The fragrances our
                                connoisseurs return to again and again.
                            </p>
                        </div>

                        <div class="product-grid">
<!--                            Fetch published products sorted by sales_count in Python (non-stored field)-->
                            <t t-set="products" t-value="request.env['product.template'].sudo().search(
                                [('website_published', '=', True), ('sale_ok', '=', True)]
                            ).sorted('sales_count', reverse=True)[:3]"/>
                            <t t-foreach="products" t-as="product">
                                <article class="product-card reveal">
                                    <div class="product-media">
                                        <t t-set="ribbon"
                                           t-value="product.website_ribbon_id"/>
                                        <span class="discount-badge"
                                              t-if="ribbon"
                                              t-out="ribbon.name"/>
                                        <button class="wishlist-btn"
                                                t-att-data-product-product-id="product.product_variant_id.id"
                                                t-att-data-product-template-id="product.id"
                                                aria-label="Add to wishlist">
                                            <i class="fa-regular fa-heart"></i>
                                        </button>
                                        <a t-attf-href="/shop/#{product.id}">
                                            <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id"
                                                 t-att-alt="product.name"
                                                 loading="lazy"/>
                                        </a>
                                    </div>
                                    <div class="product-info">
                                        <span class="product-brand">Velora
                                            Maison
                                        </span>
                                        <h3 class="product-name">
                                            <a t-attf-href="/shop/#{product.id}"
                                               t-field="product.name"/>
                                        </h3>
                                        <p class="product-desc">A luxurious
                                            fragrance crafted with the finest
                                            ingredients.
                                        </p>

                                        <div class="product-rating">
                                            <span aria-hidden="true"
                                                  style="color:var(&#45;&#45;color-gold)">
                                                <i class="fa-solid fa-star"></i>
                                                <i class="fa-solid fa-star"></i>
                                                <i class="fa-solid fa-star"></i>
                                                <i class="fa-solid fa-star"></i>
                                                <i class="fa-solid fa-star-half-stroke"></i>
                                            </span>
                                            <span>4.8 (97)</span>
                                        </div>

                                        <div class="product-price-row">
                                            <div class="price-group">
                                                <span class="price-current"
                                                      t-field="product.list_price"
                                                      t-options="{'widget': 'monetary', 'display_currency': request.env.company.currency_id}"/>
                                            </div>
                                            <button class="add-cart-btn"
                                                    t-att-data-product-id="product.product_variant_id.id"
                                                    t-att-data-template-id="product.id"
                                                    t-attf-aria-label="Add #{product.name} to cart">
                                                <i class="fa-solid fa-bag-shopping"></i>
                                            </button>
                                        </div>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </div>
                </section>
                <div class="oe_structure oe_empty o_editable">
                <section class="categories section s_velora_categories" id="velora_categories" data-snippet="s_velora_categories" data-name="Velora Categories">
                     <div class="oe_structure"/>
                    <div class="container">
                        <div class="section-head reveal">
                            <p class="eyebrow">Find Your Note</p>
                            <h2 class="section-title">Fragrance Categories</h2>
                            <p class="section-sub">Every scent tells a story.
                                Which one is yours?
                            </p>
                        </div>

                        <div class="category-grid">
                            <button class="category-card reveal"
                                    data-note="Floral">
                                <i class="fa-solid fa-fan"></i>
                                <span>Floral</span>
                            </button>
                            <button class="category-card reveal"
                                    data-note="Woody">
                                <i class="fa-solid fa-tree"></i>
                                <span>Woody</span>
                            </button>
                            <button class="category-card reveal"
                                    data-note="Fresh">
                                <i class="fa-solid fa-wind"></i>
                                <span>Fresh</span>
                            </button>
                            <button class="category-card reveal"
                                    data-note="Citrus">
                                <i class="fa-solid fa-lemon"></i>
                                <span>Citrus</span>
                            </button>
                            <button class="category-card reveal"
                                    data-note="Amber">
                                <i class="fa-solid fa-gem"></i>
                                <span>Amber</span>
                            </button>
                            <button class="category-card reveal"
                                    data-note="Musk">
                                <i class="fa-solid fa-feather"></i>
                                <span>Musk</span>
                            </button>
                            <button class="category-card reveal"
                                    data-note="Oriental">
                                <i class="fa-solid fa-moon"></i>
                                <span>Oriental</span>
                            </button>
                            <button class="category-card reveal"
                                    data-note="Aquatic">
                                <i class="fa-solid fa-water"></i>
                                <span>Aquatic</span>
                            </button>
                        </div>
                    </div>
                </section>
                </div>
                <div class="oe_structure oe_empty o_editable">
                <section class="about section s_velora_about_story" id="velora_about_story"
                         style="background-color: var(&#45;&#45;color-bg-light, #FAF9F6);" data-snippet="s_velora_about_story" data-name="Velora About Story">
                    <div class="oe_structure"/>
                    <div class="container">
                        <div class="row align-items-center about-grid">
                            <div class="col-lg-6 mb-4 mb-lg-0">
                                <div class="about-media reveal">
                                    <img src="/theme_velora/static/src/img/img1.jpg"
                                         alt="Velora perfumer crafting fragrance in atelier"
                                         loading="lazy"/>
                                    <div class="about-frame" aria-hidden="true"/>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="about-content reveal">
                                    <p class="eyebrow">Since 1998</p>
                                    <h2 class="section-title">The Art of<br/>Fine Perfumery</h2>
                                    <p>Velora was born from a singular obsession:
                                        to bottle emotion. In our Grasse atelier,
                                        master perfumers blend the rarest absolutes
                                        and precious woods, aging every composition
                                        to perfection before it ever reaches you.
                                    </p>
                                    <p>Every bottle is a promise — of
                                        craftsmanship, of heritage, and of a scent
                                        that becomes unmistakably yours.
                                    </p>

                                    <div class="stats-grid">
                                        <div class="stat">
                                            <span class="stat-number" data-count="27">0</span>
                                            <span class="stat-label">Years of Heritage</span>
                                        </div>
                                        <div class="stat">
                                            <span class="stat-number" data-count="150">0</span>
                                            <span class="stat-label">Signature Scents</span>
                                        </div>
                                        <div class="stat">
                                            <span class="stat-number" data-count="2400">0</span>
                                            <span class="stat-label">Happy Customers</span>
                                        </div>
                                        <div class="stat">
                                            <span class="stat-number" data-count="48">0</span>
                                            <span class="stat-label">Countries Reached</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                    </div>
                 <div class="oe_structure oe_empty o_editable">
                <section class="why-us section s_velora_why_us" data-snippet="s_velora_why_us" data-name="Velora Why Us">
                    <img src="/theme_velora/static/src/img/bg.jpg" alt="" loading="lazy"/>
                    <div class="oe_structure"/>
                    <div class="why-us-overlay"></div>
                    <div class="container">
                        <div class="section-head reveal">
                            <p class="eyebrow">The Velora Promise</p>
                            <h2 class="section-title">Why Choose Us</h2>
                        </div>

                        <div class="feature-grid">
                            <div class="feature-card reveal">
                                <i class="fa-solid fa-certificate"></i>
                                <h3>Authentic Products</h3>
                                <p>100% genuine fragrances sourced directly from
                                    the house of Velora.
                                </p>
                            </div>
                            <div class="feature-card reveal">
                                <i class="fa-solid fa-box-open"></i>
                                <h3>Luxury Packaging</h3>
                                <p>Every order arrives wrapped in signature
                                    velvet and gold foil detailing.
                                </p>
                            </div>
                            <div class="feature-card reveal">
                                <i class="fa-solid fa-lock"></i>
                                <h3>Secure Payment</h3>
                                <p>Bank-level encryption protects every
                                    transaction, every time.
                                </p>
                            </div>
                            <div class="feature-card reveal">
                                <i class="fa-solid fa-truck-fast"></i>
                                <h3>Fast Shipping</h3>
                                <p>Complimentary express delivery on all orders
                                    over $150.
                                </p>
                            </div>
                            <div class="feature-card reveal">
                                <i class="fa-solid fa-gift"></i>
                                <h3>Gift Wrapping</h3>
                                <p>Add a personalised note and hand-tied ribbon
                                    to any order.
                                </p>
                            </div>
                            <div class="feature-card reveal">
                                <i class="fa-solid fa-rotate-left"></i>
                                <h3>Easy Returns</h3>
                                <p>30-day hassle-free returns on every unopened
                                    fragrance.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
                 </div>
                <div class="oe_structure oe_empty o_editable">
                <section class="testimonials section s_velora_testimonials" id="velora_testimonials" data-snippet="s_velora_testimonials" data-name="Velora Testimonials">
                    <div class="oe_structure"/>
                    <div class="container">
                        <div class="section-head reveal">
                            <p class="eyebrow">Loved By Many</p>
                            <h2 class="section-title">What Our Clients Say</h2>
                        </div>

                        <div class="testimonial-track-wrap reveal">
                            <div class="testimonial-track"
                                 id="testimonialTrack">
                                <article class="testimonial-card">
                                    <div class="stars"
                                         aria-label="5 out of 5 stars">★★★★★
                                    </div>
                                    <p>"Velora Noir Oud has become my identity.
                                        I receive compliments every single time
                                        I wear it. The packaging alone feels
                                        like a luxury gift."
                                    </p>
                                    <div class="testimonial-author">
                                        <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&amp;w=200&amp;auto=format&amp;fit=crop"
                                             alt="Portrait of Amara S."
                                             loading="lazy"/>
                                        <div>
                                            <strong>Amara S.</strong>
                                            <span>Dubai, UAE</span>
                                        </div>
                                    </div>
                                </article>

                                <article class="testimonial-card">
                                    <div class="stars"
                                         aria-label="5 out of 5 stars">★★★★★
                                    </div>
                                    <p>"The longevity is unmatched. A single
                                        spritz of Velora Rose Elixir lasts me
                                        the entire day. Truly a masterpiece of
                                        perfumery."
                                    </p>
                                    <div class="testimonial-author">
                                        <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&amp;w=200&amp;auto=format&amp;fit=crop"
                                             alt="Portrait of Julien M."
                                             loading="lazy"/>
                                        <div>
                                            <strong>Julien M.</strong>
                                            <span>Paris, France</span>
                                        </div>
                                    </div>
                                </article>

                                <article class="testimonial-card">
                                    <div class="stars"
                                         aria-label="5 out of 5 stars">★★★★★
                                    </div>
                                    <p>"From unboxing to first spray, everything
                                        about Velora feels premium. Fast
                                        shipping and the gift wrap made my
                                        anniversary gift unforgettable."
                                    </p>
                                    <div class="testimonial-author">
                                        <img src="https://images.unsplash.com/photo-1531123897727-8f129e1688ce?q=80&amp;w=200&amp;auto=format&amp;fit=crop"
                                             alt="Portrait of Sophia L."
                                             loading="lazy"/>
                                        <div>
                                            <strong>Sophia L.</strong>
                                            <span>New York, USA</span>
                                        </div>
                                    </div>
                                </article>

                                <article class="testimonial-card">
                                    <div class="stars"
                                         aria-label="5 out of 5 stars">★★★★★
                                    </div>
                                    <p>"I've tried many designer perfumes, but
                                        Velora's Amber Mystique has a depth and
                                        warmth I haven't found anywhere else."
                                    </p>
                                    <div class="testimonial-author">
                                        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&amp;w=200&amp;auto=format&amp;fit=crop"
                                             alt="Portrait of Rehan K."
                                             loading="lazy"/>
                                        <div>
                                            <strong>Rehan K.</strong>
                                            <span>London, UK</span>
                                        </div>
                                    </div>
                                </article>
                            </div>

                            <div class="testimonial-dots"
                                 id="testimonialDots"></div>
                        </div>
                    </div>
                </section>
                </div>
                <div class="oe_structure oe_empty o_editable">
                <section class="faq section s_velora_faq" id="velora_faq" data-snippet="s_velora_faq" data-name="Velora FAQ">
                    <div class="oe_structure"/>
                    <div class="container">
                        <div class="section-head reveal" style="text-align: center;">
                            <p class="eyebrow">Need Help?</p>
                            <h2 class="section-title">Frequently Asked Questions</h2>
                        </div>

                        <div class="accordion reveal" id="accordion">
                            <div class="accordion-item">
                                <button class="accordion-header" aria-expanded="false">
                                    <span>How long does shipping take?</span>
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                                <div class="accordion-panel">
                                    <p>Standard delivery takes 3–5 business days. Express shipping (1–2 days) is complimentary on all orders over $150.</p>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <button class="accordion-header" aria-expanded="false">
                                    <span>Are Velora fragrances cruelty-free?</span>
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                                <div class="accordion-panel">
                                    <p>Yes. All Velora products are cruelty-free and never tested on animals, certified by international ethical beauty standards.</p>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <button class="accordion-header" aria-expanded="false">
                                    <span>Can I return an opened bottle?</span>
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                                <div class="accordion-panel">
                                    <p>For hygiene reasons we can only accept returns on unopened, unused bottles within 30 days of delivery in original packaging.</p>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <button class="accordion-header" aria-expanded="false">
                                    <span>Do you offer gift wrapping?</span>
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                                <div class="accordion-panel">
                                    <p>Absolutely. Add luxury gift wrapping with a hand-tied ribbon and personalised note at checkout for a small fee.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                </div>
                <div class="oe_structure oe_empty o_editable">
                <section class="newsletter section s_velora_newsletter" id="velora_newsletter" data-snippet="s_velora_newsletter" data-name="Velora Newsletter">
                    <div class="oe_structure"/>
                    <div class="newsletter-bg" aria-hidden="true"></div>
                    <div class="container newsletter-content reveal">
                        <span class="logo-mark large">&amp;#10022;</span>
                        <h2 class="section-title light">Join the Velora Circle
                        </h2>
                        <p>Be the first to discover new fragrances, exclusive
                            offers, and invitations to private launches.
                        </p>
                        <form class="newsletter-form" id="newsletterForm"
                              novalidate="novalidate">
                            <label for="newsletterEmail" class="sr-only">Email
                                address
                            </label>
                            <input type="email" id="newsletterEmail"
                                   placeholder="Enter your email address"
                                   required="required" aria-required="true"/>
                            <button type="submit" class="btn btn-gold">
                                <span>Subscribe</span>
                            </button>
                        </form>
                        <p class="form-message" id="formMessage" role="status" aria-live="polite"/>
                    </div>
                </section>
                </div>
             </div>


<!--                 Area reserved for blocks added through the Website Builder. -->
            <div class="oe_structure oe_empty" data-name="Additional Content" style="min-height: 1px;"/>
            </xpath>
    </template>
</odoo>
