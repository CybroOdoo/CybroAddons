<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="theme_velora_aboutus" name="Our Story">
        <t t-call="website.layout">
            <t t-set="additional_title">Our Story</t>
            <div id="wrap" class="about-page oe_structure" data-name="About Page Content">

                <div class="oe_structure oe_empty oe_editable">
                    <section class="page-banner">
                        <div class="page-banner-bg"></div>
                        <div class="page-banner-content container">
                            <p class="hero-eyebrow reveal">
                                <span class="hero-eyebrow-line"></span>
                                Maison de Parfum
                                <span class="hero-eyebrow-line"></span>
                            </p>
                            <h1 class="page-banner-title hero-title reveal">
                                Our
                                <em>Story</em>
                            </h1>
                            <nav class="breadcrumb reveal">
                                <a href="/">Home</a>
                                <span>/</span>
                                <span>About</span>
                            </nav>
                        </div>
                    </section>
                </div>

                <div class="oe_structure oe_empty oe_editable">
                    <section class="about-story section">
                        <div class="container about-grid">
                            <div class="about-image reveal">
                                <img src="/theme_velora/static/src/img/men.jpg" alt="Velora Perfume"/>
                            </div>

                            <div class="about-content reveal">
                                <p class="eyebrow">Maison Velora</p>
                                <h2 class="section-title">Where Every Fragrance Tells A Story</h2>
                                <p class="section-sub">
                                    Founded with a passion for fine perfumery, Velora believes that fragrance is more than a scent—it is an expression of identity, emotion, and timeless elegance.
                                </p>
                                <p>
                                    Every bottle is thoughtfully crafted using exceptional ingredients, refined artistry, and meticulous attention to detail. From delicate florals to rich woody accords, our collections celebrate the beauty of individuality and the memories that fragrances create.
                                </p>
                                <a href="/shop" class="btn btn-primary">Explore Collection</a>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="oe_structure oe_empty oe_editable">
                    <section class="about-stats" style="padding: 90px 0; background-image: url('/theme_velora/static/src/img/img2.jpg'); background-size: cover; background-attachment: fixed; position: relative; z-index: 1;">
                        <div class="stats-overlay" style="position: absolute; inset: 0; background-color: rgba(0,0,0,0.55); z-index: -1;"></div>
                        <div class="container">
                            <div class="d-flex justify-content-between align-items-center flex-wrap" style="border-top: 1px solid rgba(255,255,255,0.3); border-bottom: 1px solid rgba(255,255,255,0.3); padding: 3.5rem 0;">
                                <div class="stat text-center reveal" style="flex: 1 1 200px;">
                                    <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(3rem, 4vw, 4rem); color: #D4AF37; margin-bottom: 10px;">28+</h2>
                                    <span style="color: #fff; letter-spacing: 1px; font-size: 0.95rem;">Years of Excellence</span>
                                </div>
                                <div class="stat text-center reveal" style="flex: 1 1 200px;">
                                    <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(3rem, 4vw, 4rem); color: #D4AF37; margin-bottom: 10px;">150+</h2>
                                    <span style="color: #fff; letter-spacing: 1px; font-size: 0.95rem;">Luxury Fragrances</span>
                                </div>
                                <div class="stat text-center reveal" style="flex: 1 1 200px;">
                                    <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(3rem, 4vw, 4rem); color: #D4AF37; margin-bottom: 10px;">40+</h2>
                                    <span style="color: #fff; letter-spacing: 1px; font-size: 0.95rem;">Countries Served</span>
                                </div>
                                <div class="stat text-center reveal" style="flex: 1 1 200px;">
                                    <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(3rem, 4vw, 4rem); color: #D4AF37; margin-bottom: 10px;">250K+</h2>
                                    <span style="color: #fff; letter-spacing: 1px; font-size: 0.95rem;">Happy Customers</span>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="oe_structure oe_empty oe_editable">
                    <section class="brand-philosophy section">
                        <div class="container">
                            <div class="section-header reveal">
                                <p class="eyebrow">Our Philosophy</p>
                                <h2 class="section-title">Luxury Crafted With Purpose</h2>
                                <p class="section-sub">Every fragrance is created to inspire confidence, elegance and unforgettable memories.</p>
                            </div>

                            <div class="philosophy-grid">
                                <div class="philosophy-card reveal">
                                    <i class="fa-solid fa-gem"></i>
                                    <h3>Timeless Elegance</h3>
                                    <p>We design fragrances that transcend trends and become lifelong signatures.</p>
                                </div>

                                <div class="philosophy-card reveal">
                                    <i class="fa-solid fa-leaf"></i>
                                    <h3>Natural Ingredients</h3>
                                    <p>Every perfume begins with carefully selected botanicals, rare woods and luxurious oils.</p>
                                </div>

                                <div class="philosophy-card reveal">
                                    <i class="fa-solid fa-award"></i>
                                    <h3>Exceptional Craftsmanship</h3>
                                    <p>Master perfumers combine tradition and innovation to create fragrances with lasting character.</p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

            </div>
        </t>
    </template>

    <record id="page_about_theme" model="theme.website.page">
        <field name="url">/about</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="theme_velora_aboutus"/>
    </record>
</odoo>
