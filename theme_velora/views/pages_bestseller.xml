<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="theme_velora_bestsellers" name="Best Sellers">
        <t t-call="website.layout">
            <t t-set="additional_title">Best Sellers</t>
            <div id="wrap" class="oe_structure" data-name="Best Sellers Page Content">

                <div class="oe_structure oe_empty oe_editable">
                    <section class="page-banner">
                        <div class="page-banner-bg"></div>
                        <div class="page-banner-content container">
                            <p class="hero-eyebrow reveal">
                                <span class="hero-eyebrow-line"></span>
                                Chosen by Connoisseurs
                                <span class="hero-eyebrow-line"></span>
                            </p>
                            <h1 class="page-banner-title hero-title reveal">
                                Our Bestselling <em>Fragrances</em>
                            </h1>
                            <nav class="breadcrumb reveal">
                                <a href="/">Home</a>
                                <span>/</span>
                                <span>Best Sellers</span>
                            </nav>
                        </div>
                    </section>
                </div>

                <div class="oe_structure oe_empty oe_editable">
                    <section class="best-sellers section" id="bestsellers">
                        <div class="container">
                            <div class="section-header reveal">
                                <p class="eyebrow">Best Sellers</p>
                                <h2 class="section-title">Our Most Loved Fragrances</h2>
                                <p class="section-sub">
                                    Discover the perfumes our customers return to time and time again.
                                    Crafted with exceptional ingredients and timeless elegance, these
                                    signature fragrances define the essence of Velora.
                                </p>
                            </div>

                            <!-- Dynamic product grid from Odoo -->
                            <div class="product-grid">
                                <t t-set="products" t-value="request.env['product.template'].sudo().search([('website_published', '=', True), ('sale_ok', '=', True)], limit=6, order='create_date desc')"/>
                                <t t-foreach="products" t-as="product">
                                    <article class="product-card reveal">
                                        <div class="product-media">
                                            <t t-set="ribbon" t-value="product.website_ribbon_id"/>
                                            <span class="discount-badge" t-if="ribbon" t-out="ribbon.name"/>
                                            <button type="button" class="wishlist-btn o_add_wishlist" t-att-data-product-product-id="product.product_variant_id.id or product._get_first_possible_variant_id()" t-att-data-product-template-id="product.id" data-action="o_wishlist" aria-label="Add to wishlist"><i class="fa-regular fa-heart"></i></button>
                                            <a t-attf-href="/shop/#{product.id}">
                                                <img t-att-src="'/web/image/product.template/%s/image_1024' % product.id" t-att-alt="product.name" loading="lazy"/>
                                            </a>
                                        </div>
                                        <div class="product-info">
                                            <span class="product-brand">Velora Maison</span>
                                            <h3 class="product-name">
                                                <a t-attf-href="/shop/#{product.id}" t-field="product.name"/>
                                            </h3>
                                            <p class="product-desc" t-if="product.description_sale" t-field="product.description_sale"/>

                                            <div class="product-price-row">
                                                <div class="price-group">
                                                    <span class="price-current" t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': request.env.company.currency_id}"/>
                                                </div>
                                                <button class="add-cart-btn btn-full-text" t-att-data-product-id="product.product_variant_id.id" t-att-data-template-id="product.id" t-attf-aria-label="Add #{product.name} to cart">
                                                    ADD TO CART
                                                </button>
                                            </div>
                                        </div>
                                    </article>
                                </t>

                                <!-- Fallback if no products -->
                                <t t-if="not products">
                                    <div class="no-products-message" style="grid-column: 1 / -1; text-align: center; padding: 60px 20px;">
                                        <i class="fa-solid fa-gem" style="font-size: 3rem; color: #c8a55a; margin-bottom: 20px;"></i>
                                        <h3 style="font-family: 'Playfair Display', serif; color: #111; margin-bottom: 15px;">Coming Soon</h3>
                                        <p style="color: #666;">Our bestselling fragrances are being curated. Check back soon.</p>
                                        <a href="/shop" class="btn btn-primary" style="margin-top: 20px;">Browse All Fragrances</a>
                                    </div>
                                </t>
                            </div>

                            <!-- View All CTA -->
                            <div class="bestseller-cta reveal" style="text-align: center; margin-top: 80px;">
                                <a href="/shop" class="btn btn-primary">
                                    View All Fragrances
                                </a>
                            </div>
                        </div>
                    </section>
                </div>

            </div>
        </t>
    </template>

    <record id="page_bestsellers_theme" model="theme.website.page">
        <field name="url">/bestsellers</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="theme_velora_bestsellers"/>
    </record>
</odoo>
