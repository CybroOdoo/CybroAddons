<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="pos_hr.CashierSelectionPopup" t-inherit-mode="extension">
        <xpath expr="//Dialog" position="after">
            <div id="WebCamModal" t-ref="this.webCamModalRef"
                 class="pos-face-recognition-modal-overlay">
                <div class="card shadow-lg p-3 bg-white text-center pos-face-recognition-modal-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="m-0 fw-bold">Face Recognition Login</h5>
                        <button type="button" class="btn-close" aria-label="Close" t-on-click="() => this.cancelFaceRecognition()"/>
                    </div>
                    <div class="position-relative overflow-hidden rounded bg-black pos-face-recognition-video-container">
                        <video id="video" t-ref="this.videoRef" class="pos-face-recognition-video" autoplay="autoplay" playsinline="playsinline"/>
                        <img id="employee_image" t-ref="this.employeeImageRef" class="pos-face-recognition-hidden-image"/>
                    </div>
                    <div class="mt-3 d-flex justify-content-end">
                        <button type="button" class="btn btn-secondary px-4" t-on-click="() => this.cancelFaceRecognition()">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
