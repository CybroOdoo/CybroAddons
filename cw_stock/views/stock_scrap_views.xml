<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Scrap form: in Odoo 20 scrap is a stock.move (is_scrap), not stock.scrap -->
    <record id="view_scrap_move_form" model="ir.ui.view">
        <field name="name">stock.scrap.move.form.inherit.cw.stock</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_scrap_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_row')]" position="after">
                <field name="cw_hide" invisible="1"/>
                <label for="cw_done" string="CW-Quantity"
                       invisible="not cw_hide"/>
                <div class="o_row" invisible="not cw_hide">
                    <field name="cw_done" readonly="state in ('done', 'cancel')"
                           required="cw_hide"/>
                    <field name="cw_uom_id" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
