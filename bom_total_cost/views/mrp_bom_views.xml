<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit MRP BOM form view to display BOM total cost and cost per unit -->
    <record id="mrp_bom_form_view" model="ir.ui.view">
        <field name="name">mrp.bom.view.form.inherit.bom.total.cost</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']/parent::div" position="after">
                <field name="currency_id" invisible="1"/>
                <field name="bom_cost" widget="monetary"/>
                <field name="total_bom_cost" widget="monetary"/>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_id']"
                   position="after">
                <field name="cost" widget="monetary"/>
            </xpath>
        </field>
    </record>
</odoo>
