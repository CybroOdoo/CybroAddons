<?xml version="1.0" encoding="UTF-8"?>
<!--inherited to add quantity in each product card-->
<templates id="template" xml:space="preserve">
    <t t-name="pos_restrict_product_stock.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="after">
            <t t-if="this.pos?.config?.is_display_stock and this.props.product">
                <t t-if="this.pos.config.stock_type == 'qty_on_hand'">
                    <div id="qty_display"
                         t-attf-class="display_qty #{(this.props.product.qty_available || 0) &lt;= 0 ? 'not-available' : ''}">
                        <t t-out="this.props.product.qty_available ?? 0"/>
                    </div>
                </t>
                <t t-if="this.pos.config.stock_type == 'virtual_qty'">
                    <div t-attf-class="display_virtual #{(this.props.product.virtual_available || 0) &lt;= 0 ? 'not-available' : ''}">
                        <t t-out="this.props.product.virtual_available ?? 0"/>
                    </div>
                </t>
                <t t-if="this.pos.config.stock_type == 'both'">
                    <div id="qty_display"
                         t-attf-class="display_qty #{(this.props.product.qty_available || 0) &lt;= 0 ? 'not-available' : ''}">
                        <t t-out="this.props.product.qty_available ?? 0"/>
                    </div>
                    <div t-attf-class="display_virtual #{(this.props.product.virtual_available || 0) &lt;= 0 ? 'not-available' : ''}">
                        <t t-out="this.props.product.virtual_available ?? 0"/>
                    </div>
                </t>
            </t>
        </xpath>
    </t>
</templates>
