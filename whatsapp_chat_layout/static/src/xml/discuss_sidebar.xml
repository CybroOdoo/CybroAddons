<?xml version="1.0" encoding="UTF-8"?>
<!--
    WhatsApp Chat Layout - MessagingMenu Extension for Odoo 20
    Injects WhatsApp-style icon tab bar + user avatar ABOVE the
    native Odoo 20 MessagingMenu sidebar search container.
    Uses Odoo 20 native 'oi' (Odoo Icons) syntax.
-->
<templates xml:space="preserve">

    <t t-name="whatsapp_chat_layout.MessagingMenuSidebar"
       t-inherit="mail.MessagingMenu"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('o-mail-MessagingMenu-searchContainer')]" position="before">
            <div t-if="this.env.inDiscussApp" class="wa-sidebar-header d-flex flex-column flex-shrink-0">

                <!-- User avatar row -->
                <div class="wa-sidebar-avatar-container d-flex align-items-center px-3 pt-3 pb-2">
                    <img class="wa-user-avatar rounded-circle o_object_fit_cover"
                         t-att-src="this.waAvatarSrc"
                         alt="User Avatar"/>
                </div>

                <!-- Icon tab bar: Mail / Chat / Channels / Video using Odoo 20 native icons -->
                <div class="wa-sidebar-tabs d-flex justify-content-around pb-2">

                    <button class="wa-tab-btn btn btn-link p-0"
                            t-att-class="{ 'wa-tab-active': this.isMailTabActive }"
                            title="Mail / Inbox"
                            t-on-click="() => this._onWaSelectTab('notification')">
                        <i class="oi oi-fw wa-tab-icon" data-icon="mail"/>
                    </button>

                    <button class="wa-tab-btn btn btn-link p-0"
                            t-att-class="{ 'wa-tab-active': this.activeTab().id === 'chat' }"
                            title="Chats"
                            t-on-click="() => this._onWaSelectTab('chat')">
                        <i class="oi oi-fw wa-tab-icon" data-icon="chat_bubble"/>
                    </button>

                    <button class="wa-tab-btn btn btn-link p-0"
                            t-att-class="{ 'wa-tab-active': this.activeTab().id === 'channel' }"
                            title="Channels"
                            t-on-click="() => this._onWaSelectTab('channel')">
                        <i class="oi oi-fw wa-tab-icon" data-icon="tag"/>
                    </button>

                    <button class="wa-tab-btn btn btn-link p-0"
                            t-att-class="{ 'wa-tab-active': this.activeTab().id === 'meeting' }"
                            title="Video Calls"
                            t-on-click="() => this._onWaSelectTab('meeting')">
                        <i class="oi oi-fw wa-tab-icon" data-icon="videocam"/>
                    </button>

                </div>
            </div>
        </xpath>

    </t>

</templates>
