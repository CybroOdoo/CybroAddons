<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp.chat.layout</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='activities_setting']" position="after">
                <setting id="discuss_background_color_setting" string="Background Color" help="Select the background color for Discuss.">
                    <field name="background_color" widget="color"/>
                </setting>
                <setting id="discuss_layout_color_setting" string="Layout Color" help="Select the layout color for Discuss.">
                    <field name="layout_color" widget="color"/>
                </setting>
                <setting id="discuss_background_image_setting" string="Background Image" help="Select the background image for Discuss.">
                    <field name="chat_background" widget="image"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
