<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_groups_privilege_estimated_delivery_time" model="res.groups.privilege">
        <field name="name">Estimated Delivery Time</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <!-- Groups -->
    <record id="website_estimated_delivery_time_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="website_estimated_delivery_time.res_groups_privilege_estimated_delivery_time"/>
        <field name="implied_by_ids" eval="[(5,0,0)]"/>
    </record>

    <record id="website_estimated_delivery_time_group_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="website_estimated_delivery_time.res_groups_privilege_estimated_delivery_time"/>
        <field name="implied_ids" eval="[(4, ref('website_estimated_delivery_time_group_user'))]"/>
    </record>

</odoo>
