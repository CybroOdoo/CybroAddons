<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_estimated_delivery_time"
              inherit_id="website_sale.product"
              customize_show="True">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]"
               position="after">
            <div id="search_website_pin_number"
                 class="d-flex flex-wrap align-items-center mt-3">
                <input type="text"
                       placeholder="Enter The PIN Code"
                       id="pin_number"
                       class="o_website_delivery_pin_input" />
                <input type="hidden" id="product_template_id" t-att-value="product.id"/>
                <input type="hidden" id="product_variant_id" t-att-value="product_variant.id"/>
                <button type="button"
                        id="search_button"
                        class="btn btn-secondary ms-2 o_website_delivery_search_button">
                    Search
                </button>
            </div>

        </xpath>
    </template>

    <template id="delivery_time_modals" inherit_id="website.layout">
        <xpath expr="//body" position="inside">
            <!-- NOT AVAILABLE -->
            <div id="NotAvailableModal"
                 class="modal fade"
                 tabindex="-1"
                 data-bs-backdrop="static"
                 data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-body text-center p-4">
                            <p id="message_to_show_unavailable" class="mb-3"></p>
                            <button class="btn btn-primary w-100" data-bs-dismiss="modal">
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- AVAILABLE -->
            <div id="AvailableModal"
                 class="modal fade"
                 tabindex="-1"
                 data-bs-backdrop="static"
                 data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-body text-center p-4">
                            <p id="message_to_show_available" class="mb-3"></p>
                            <button class="btn btn-primary w-100" data-bs-dismiss="modal">
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
    <template id="product_custom_text"
              inherit_id="website_sale.product">
        <xpath expr="//t[@t-call='website_sale.product_terms_and_conditions']"
               position="replace">
            <div id="o_product_terms_and_share"
                 class="d-flex justify-content-between flex-column flex-md-row align-items-md-end mb-3">
                <p class="text-muted mb-0">
                    <a href="/terms" class="text-muted"><u>Terms and Conditions</u></a><br/>
                    30-day money-back guarantee<br/>
                </p>
            </div>
        </xpath>
    </template>
</odoo>
