<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form - Estimated Delivery Time fields under Website field -->
    <record id="view_product_template_form_inherit_estimated_delivery" model="ir.ui.view">
        <field name="name">product.template.form.inherit.website.estimated.delivery.time</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_price']" position="after">
                <page name="estimated_delivery_time_page" string="PIN Codes &amp; Estimated Delivery Time (Days)"
                      groups="website_estimated_delivery_time.website_estimated_delivery_time_group_administrator">
                    <div class="d-flex align-items-center gap-2 mb-3 mt-2">
                        <label for="overwrite_existing_config" string="Overwrite Existing Configuration" class="fw-bold"/>
                        <field name="overwrite_existing_config" nolabel="1"/>
                    </div>
                    <field name="product_estimated_delivery_time_ids"
                           invisible="overwrite_existing_config == False"
                           colspan="2">
                        <list editable="bottom">
                            <field name="name" string="Name"/>
                            <field name="pin" string="PIN"/>
                            <field name="days" string="Available Within (Days)"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
