<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thank-you page of the textile inquiry form -->
    <template id="thankyou_template" name="Textile Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="bg-light">

                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">

                            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                                <div class="row g-0">

                                    <!-- LEFT IMAGE -->
                                    <div class="col-md-5 d-none d-md-block"
                                         style="background:
                                         linear-gradient(rgba(60,40,55,0.7), rgba(60,40,55,0.7)),
                                         url('/textile_management/static/src/img/textile_thankyou.jpg');
                                         background-size:cover;
                                         background-position:center;">
                                    </div>

                                    <!-- RIGHT CONTENT -->
                                    <div class="col-md-7 p-5 text-center">

                                        <div class="mb-4">
                                            <i class="oi oi-filled" data-icon="check_circle"
                                               style="color:#6b465d; font-size: 4rem;" aria-hidden="true"/>
                                        </div>

                                        <h2 class="fw-bold mb-3">Thank You!</h2>

                                        <p class="fs-5 text-muted mb-3">
                                            Your inquiry has been successfully
                                            submitted.
                                        </p>

                                        <p class="text-muted">
                                            Our textile experts will review your
                                            request and contact you shortly.
                                        </p>

                                        <a href="/shop"
                                           class="btn btn-lg rounded-pill mt-4 text-white"
                                           style="background:#6b465d;">
                                            Browse Our Products
                                        </a>

                                        <div t-if="company_mail or company_phone" class="mt-4 text-muted">
                                            <small>
                                                <span t-if="company_mail">📧 <t t-out="company_mail"/></span>
                                                <span t-if="company_mail and company_phone">&#160;|&#160;</span>
                                                <span t-if="company_phone">📞 <t t-out="company_phone"/></span>
                                            </small>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </t>
    </template>
</odoo>
