<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Templates-->
    <template id="thankyou_template" name="Textile Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="bg-light">

                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">

                            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                                <div class="row g-0">

                                    <!-- LEFT IMAGE -->
                                    <div class="col-md-5 d-none d-md-block"
                                         style="background:
                                         linear-gradient(rgba(60,40,55,0.7), rgba(60,40,55,0.7)),
                                         url('/textile_management/static/src/img/textile_thankyou.jpg');
                                         background-size:cover;
                                         background-position:center;">
                                    </div>

                                    <!-- RIGHT CONTENT -->
                                    <div class="col-md-7 p-5 text-center">

                                        <div class="mb-4">
                                            <i class="fa fa-check-circle fa-4x"
                                               style="color:#6b465d;"></i>
                                        </div>

                                        <h2 class="fw-bold mb-3">Thank You!</h2>

                                        <p class="fs-5 text-muted mb-3">
                                            Your inquiry has been successfully
                                            submitted.
                                        </p>

                                        <p class="text-muted">
                                            Our textile experts will review your
                                            request and contact you shortly.
                                        </p>

                                        <a href="/shop"
                                           class="btn btn-lg rounded-pill mt-4 text-white"
                                           style="background:#6b465d;">
                                            Browse Our Products
                                        </a>

                                        <div class="mt-4 text-muted">
                                            <small>
                                                📧 support@yourcompany.com &#160;
                                                | &#160;
                                                📞 +1 555-555-5556
                                            </small>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </t>
    </template>
</odoo>
