<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Add the textile flag to the purchase order -->
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.textile.management</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="is_textile_purchase_order" invisible="1"/>
            </xpath>
            <!-- Textile orders only offer textile products on their lines -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']"
                   position="attributes">
                <attribute name="domain">[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', 'parent_of', parent.company_id)] + ([('is_textile_product', '=', True)] if parent.is_textile_purchase_order else [])</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']"
                   position="attributes">
                <attribute name="domain">[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)] + ([('is_textile_product', '=', True)] if parent.is_textile_purchase_order else [])</attribute>
            </xpath>
        </field>
    </record>
</odoo>
