<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Website Inquiry Form-->
    <template id="textile_inquiry_form" name="Textile Inquiry">
        <t t-call="website.layout">
            <div id="wrap" class="bg-light">

                <div class="container-fluid py-5">
                    <div class="row g-0 shadow-lg rounded-4 overflow-hidden"
                         style="max-width:1100px;margin:auto;background:#fff;">

                        <!-- LEFT PANEL : Textile Branding -->
                        <div class="col-lg-6 d-none d-lg-block"
                             style="background:
                         linear-gradient(rgba(60,40,55,0.7), rgba(60,40,55,0.7)),
                         url('/textile_management/static/src/img/textile.jpg');
                         background-size:cover;
                         background-position:center;
                         padding:70px;">

                            <div class="text-white h-100 d-flex flex-column justify-content-center">
                                <h1 class="fw-bold mb-3">Premium Textile
                                    Solutions
                                </h1>
                                <p class="fs-5">
                                    We supply quality fabrics, yarns, and
                                    textile products
                                    tailored to your business needs.
                                </p>
                                <ul class="mt-4 fs-5">
                                    <li>✔ Cotton, Polyester, Silk, Blends</li>
                                    <li>✔ Bulk &amp; Custom Orders</li>
                                    <li>✔ Fast Global Delivery</li>
                                </ul>
                            </div>
                        </div>

                        <!-- RIGHT PANEL : Form -->
                        <div class="col-lg-6 p-5">
                            <h2 class="fw-bold mb-2">Inquiry Form</h2>
                            <p class="text-muted mb-4">
                                Tell us what you need. Our textile experts will
                                contact you shortly.
                            </p>

                            <form action="/textile/inquiry/form/submit"
                                  method="POST">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Full
                                        Name
                                    </label>
                                    <input type="text" name="name"
                                           class="form-control form-control-lg"
                                           placeholder="Your full name"
                                           required="1"/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Email
                                    </label>
                                    <input type="email" name="email"
                                           class="form-control form-control-lg"
                                           placeholder="your@email.com"
                                           required="1"/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Phone
                                    </label>
                                    <input type="tel" name="number"
                                           class="form-control form-control-lg"
                                           placeholder="+1 234 567 890"/>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Your
                                        Requirement
                                    </label>
                                    <textarea name="description" rows="4"
                                              class="form-control form-control-lg"
                                              placeholder="Tell us about fabric type, quantity, or custom requirements"
                                              required="1"></textarea>
                                </div>

                                <button type="submit"
                                        class="btn w-100 btn-lg rounded-pill text-white"
                                        style="background:#6b465d;">
                                    Submit Inquiry
                                </button>
                            </form>
                        </div>

                    </div>
                </div>

            </div>
        </t>
    </template>


</odoo>
