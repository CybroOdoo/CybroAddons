<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website Inquiry Form -->
    <template id="textile_inquiry_form" name="Textile Inquiry">
        <t t-call="website.layout">
            <div id="wrap" class="bg-light">

                <!-- Inline CSS fix for Odoo 19 height issue -->
                <style>
                    /* Odoo 19 homepage fit fix */
                    .inquiry-wrapper {
                        max-height: calc(100vh - 140px); /* header + margin */
                    }
                    .inquiry-image {
                        min-height: 100%;
                    }
                    .inquiry-form {
                        padding: 2rem;
                        overflow-y: auto;
                    }
                    .inquiry-form .form-control {
                        padding: 0.6rem 0.75rem;
                    }
                </style>

                <section class="container-fluid py-4">
                    <div class="row justify-content-center">
                        <div class="col-xl-10 col-lg-11">

                            <div class="card shadow-lg border-0 rounded-4 overflow-hidden inquiry-wrapper">
                                <div class="row g-0">

                                    <!-- LEFT PANEL : Textile Branding -->
                                    <div class="col-lg-6 d-none d-lg-flex inquiry-image"
                                         style="
                                         background:
                                         linear-gradient(rgba(60,40,55,0.7), rgba(60,40,55,0.7)),
                                         url('/textile_management/static/src/img/textile.jpg');
                                         background-size:cover;
                                         background-position:center;
                                         padding:50px;
                                         ">
                                        <div class="text-white d-flex flex-column justify-content-center">
                                            <h1 class="fw-bold mb-3">
                                                Premium Textile Solutions
                                            </h1>
                                            <p class="fs-5">
                                                We supply quality fabrics, yarns, and textile products
                                                tailored to your business needs.
                                            </p>
                                            <ul class="mt-3 fs-5">
                                                <li>✔ Cotton, Polyester, Silk, Blends</li>
                                                <li>✔ Bulk &amp; Custom Orders</li>
                                                <li>✔ Fast Global Delivery</li>
                                            </ul>
                                        </div>
                                    </div>

                                    <!-- RIGHT PANEL : Form -->
                                    <div class="col-lg-6 inquiry-form">
                                        <h2 class="fw-bold mb-2">Inquiry Form</h2>
                                        <p class="text-muted mb-3">
                                            Tell us what you need. Our textile experts will contact you shortly.
                                        </p>

                                        <form action="/textile/inquiry/form/submit" method="POST">
                                            <input type="hidden" name="csrf_token"
                                                   t-att-value="request.csrf_token()"/>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">
                                                    Full Name
                                                </label>
                                                <input type="text"
                                                       name="name"
                                                       class="form-control form-control-lg"
                                                       placeholder="Your full name"
                                                       required="1"/>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">
                                                    Email
                                                </label>
                                                <input type="email"
                                                       name="email"
                                                       class="form-control form-control-lg"
                                                       placeholder="your@email.com"
                                                       required="1"/>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">
                                                    Phone
                                                </label>
                                                <input type="tel"
                                                       name="number"
                                                       class="form-control form-control-lg"
                                                       placeholder="+1 234 567 890"/>
                                            </div>

                                            <div class="mb-4">
                                                <label class="form-label fw-semibold">
                                                    Your Requirement
                                                </label>
                                                <textarea name="description"
                                                          rows="3"
                                                          class="form-control form-control-lg"
                                                          placeholder="Tell us about fabric type, quantity, or custom requirements"
                                                          required="1"/>
                                            </div>

                                            <button type="submit"
                                                    class="btn w-100 btn-lg rounded-pill text-white"
                                                    style="background:#6b465d;">
                                                Submit Inquiry
                                            </button>
                                        </form>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>
</odoo>
