<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template for adding review and rating for the products -->
    <template id="customer_feedback" inherit_id="website_sale.payment"
              name="Customer Feedback">
        <!-- FIX: position="after" on website_sale_non_free_cart breaks the
             t-if/t-elif chain in the parent template. Inject inside
             payment_method div instead — it is a safe neutral anchor. -->
        <xpath expr="//div[@id='payment_method']" position="after">
            <div class="wrapper"
                 style="border: 1px solid rgba(0, 0, 0, 0.125);">
                <div class="master">
                    <div class="feedback-card">

                        <div class="feedback-header">
                            <h3>Rate your experience</h3>
                            <p>We'd love to know how your order went</p>
                        </div>

                        <div class="rating-component">
                            <div class="status-msg"/>

                            <div class="stars-box">
                                <i class="star fa fa-star" data-value="1"
                                   data-message="Poor"/>
                                <i class="star fa fa-star" data-value="2"
                                   data-message="Average"/>
                                <i class="star fa fa-star" data-value="3"
                                   data-message="Nice"/>
                                <i class="star fa fa-star" data-value="4"
                                   data-message="Excellent"/>
                            </div>

                            <input type="hidden" class="rate-value"/>
                            <input type="hidden" class="rating_msg"/>

                            <input type="text" class="feedback-input"
                                   name="comment"
                                   rows="3"
                                   placeholder="Tell us what you liked or what we could improve..."/>
                        </div>

                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>