<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Customer feedback (rating and comment) on the payment step of the
    checkout, saved on the order while it is a quotation -->
    <template id="customer_feedback" inherit_id="website_sale.payment"
              name="Customer Feedback">
        <xpath expr="//div[@id='payment_method']" position="after">
            <div class="o_textile_feedback card mb-3"
                 t-att-data-rating="website_sale_order.rating">
                <div class="card-body">
                    <h5 class="card-title mb-1">Rate your experience</h5>
                    <p class="text-muted small mb-2">We'd love to know how your order went</p>
                    <div class="o_textile_feedback_stars d-flex justify-content-center gap-3 my-2">
                    <i class="oi o_textile_feedback_star" data-icon="star" role="button"
                       data-value="1" data-message="Poor" title="Poor"/>
                    <i class="oi o_textile_feedback_star" data-icon="star" role="button"
                       data-value="2" data-message="Average" title="Average"/>
                    <i class="oi o_textile_feedback_star" data-icon="star" role="button"
                       data-value="3" data-message="Nice" title="Nice"/>
                    <i class="oi o_textile_feedback_star" data-icon="star" role="button"
                       data-value="4" data-message="Excellent" title="Excellent"/>
                    </div>
                    <div class="o_textile_feedback_status text-center fw-semibold"/>
                    <input type="text" name="comment" maxlength="500"
                           t-att-value="website_sale_order.comment"
                           class="o_textile_feedback_comment form-control mt-3"
                           placeholder="Tell us what you liked or what we could improve..."/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
