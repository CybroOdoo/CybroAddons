<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Textile customer / vendor report -->
    <template id="report_textile_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-if="type == 'customer'">
                        <h2 class="text-center">Customer: <t t-out="customer"/></h2>
                        <p t-if="date_begin or date_end" class="text-center">
                            <strong>Period:</strong>
                            <t t-out="date_begin or '…'"/> - <t t-out="date_end or '…'"/>
                        </p>
                        <table class="table table-sm o_main_table mt-4">
                            <thead>
                                <tr>
                                    <th class="text-start">#</th>
                                    <th class="text-start">Sale Order</th>
                                    <th class="text-start">Date</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-start">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="customer_details" t-as="detail">
                                    <td><t t-out="detail_index + 1"/></td>
                                    <td><t t-out="detail['sale']"/></td>
                                    <td><t t-out="detail['create_date']"/></td>
                                    <td class="text-end"><t t-out="detail['amount']"/></td>
                                    <td><t t-out="detail['status']"/></td>
                                </tr>
                                <tr t-if="not customer_details">
                                    <td colspan="5" class="text-center text-muted">No textile orders found.</td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="type == 'vendor'">
                        <h2 class="text-center">Vendor: <t t-out="vendor"/></h2>
                        <p t-if="date_begin or date_end" class="text-center">
                            <strong>Period:</strong>
                            <t t-out="date_begin or '…'"/> - <t t-out="date_end or '…'"/>
                        </p>
                        <table class="table table-sm o_main_table mt-4">
                            <thead>
                                <tr>
                                    <th class="text-start">#</th>
                                    <th class="text-start">Purchase Order</th>
                                    <th class="text-start">Date</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-start">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="vendor_details" t-as="detail">
                                    <td><t t-out="detail_index + 1"/></td>
                                    <td><t t-out="detail['purchase']"/></td>
                                    <td><t t-out="detail['create_date']"/></td>
                                    <td class="text-end"><t t-out="detail['amount']"/></td>
                                    <td><t t-out="detail['status']"/></td>
                                </tr>
                                <tr t-if="not vendor_details">
                                    <td colspan="5" class="text-center text-muted">No textile orders found.</td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
