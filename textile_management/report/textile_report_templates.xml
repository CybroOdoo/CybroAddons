<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    Template for textile report-->
    <template id="report_textile_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-if="type == 'customer'">
                        <center>
                            <h1 style="font-family: monospace;">Customer::
                                <t t-esc="customer"/>
                            </h1>
                        </center>
                        <t t-if="date_begin or date_end">
                            <span>
                                <strong>Period::
                                    <t t-esc="date_begin"/>
                                    -
                                    <t
                                            t-esc="date_end"/>
                                </strong>
                            </span>
                        </t>
                        <table style="width:100%;border-collapse: separate;
                            border-spacing: 0 1em;">
                            <thead>
                                <tr>
                                    <th>Sl No</th>
                                    <th>Sale Order</th>
                                    <th>Create Date</th>
                                    <th>Amount</th>
                                    <th>status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="index" t-value="0"/>
                                <t t-foreach="customer_details"
                                   t-as="detail">
                                    <tr style="padding-bottom:30px;">
                                        <t t-set="index"
                                           t-value="index + 1"/>
                                        <td
                                                style="text-align:center;">
                                            <t t-esc="index"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="detail.get('sale')"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="detail.get('create_date')"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="detail.get('amount')"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="{'sale': 'Sale Order', 'draft': 'Quotation', 'sent': 'Quotation sent',  'cancel': 'Cancelled'} [detail['status']]"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-if="type == 'vendor'">
                        <center>
                            <h1 style="font-family: monospace;">Vendor::
                                <t t-esc="vendor"/>
                            </h1>
                        </center>
                        <t t-if="date_begin or date_end">
                            <span>
                                <strong>Period::
                                    <t t-esc="date_begin"/>
                                    -
                                    <t t-esc="date_end"/>
                                </strong>
                            </span>
                        </t>
                        <table style="width:100%;border-collapse: separate;border-spacing: 0 1em;">
                            <thead>
                                <tr>
                                    <th>Sl No</th>
                                    <th>Purchase Order</th>
                                    <th>Create Date</th>
                                    <th>Amount</th>
                                    <th>status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="index" t-value="0"/>
                                <t t-foreach="vendor_details"
                                   t-as="detail">
                                    <tr style="padding-bottom:30px;">
                                        <t t-set="index"
                                           t-value="index + 1"/>
                                        <td style="text-align:center;">
                                            <t t-esc="index"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="detail.get('purchase')"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="detail.get('create_date')"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="detail.get('amount')"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="{'done':'Locked', 'to_approve': 'To Approve', 'draft': 'RFQ', 'sent': 'RFQ sent',  'cancel': 'Cancelled', 'purchase':'Purchase Order'} [detail['status']]"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
