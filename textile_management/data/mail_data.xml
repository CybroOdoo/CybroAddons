<?xml version = "1.0" encoding = "UTF-8" ?>
<odoo>
    <!--        Email Template-->
    <record id="mail_template_website_inquiry" model="mail.template">
        <field name="name">Website Inquiry</field>
        <field name="model_id"
               ref="textile_management.model_website_inquiry"/>
        <field name="subject">Textile Industry: Website Inquiry</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;background-color:#f2f2f2;
                height:auto">
                Thanks For your inquiry…We Will Contact You Soon..
                <br/>
                <br/>
                <center>
                <div style="background-color:#BCE2F8;height:150px;width:750px;text-align:left;font-family: cursive;">
                    <div style="color:#021310; font-size: 20px;  margin-left:10px;">
                        <span>
                            <strong>Name
                                :</strong>
                        </span>
                        <br/>
                        <span>
                            <strong>email:</strong>
                        </span>
                        <br/>
                        <span>
                            <strong>Phone Number:</strong>
                        </span>
                        <br/>
                        <span>
                            <strong>Description:</strong>
                        </span>
                    </div>
                </div>
                </center>
                <br/>
            </div>
        </field>
    </record>
</odoo>
