<?xml version="1.0" encoding="UTF-8"?>
<!-- Record rules for salon booking access. -->
<odoo>
    <record id="salon_booking_rule_user" model="ir.rule">
        <field name="name">Salon Booking: POS Users</field>
        <field name="model_id" ref="model_salon_booking"/>
        <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
</odoo>