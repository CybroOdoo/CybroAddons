<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_salon.SalonCommissionPopup">
        <t t-if="state.showCommissionPopup">
            <div class="modal-backdrop fade show"/>
            <div class="modal d-block" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fa fa-money me-2"/>Commission</h5>
                            <button type="button" class="btn-close" t-on-click="() => props.actions.closeCommissionPopup()"/>
                        </div>
                        <div class="modal-body">
                            <p class="mb-1">Specialist: <strong><t t-out="state.commissionBooking.specialist_name"/></strong></p>
                            <p class="mb-3">Booking amount: <t t-out="props.actions.formatAmount(state.commissionBooking.amount_total)"/></p>
                            <label class="form-label fw-semibold">Commission amount:</label>
                            <input type="number" min="0" step="0.01" class="form-control"
                                   t-att-value="state.commissionAmount"
                                   t-on-input="(ev) => props.actions.setCommissionAmount(ev.target.value)"/>
                            <div t-if="state.commissionWarning" class="alert alert-warning mt-3 mb-0">
                                <t t-out="state.commissionWarning"/>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" t-on-click="() => props.actions.closeCommissionPopup()">Close</button>
                            <button type="button" class="btn btn-success" t-on-click="() => props.actions.confirmCommission()">Continue to Payment</button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </t>
</templates>