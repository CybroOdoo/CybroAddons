<?xml version="1.0" encoding="UTF-8"?>
<!-- Main salon dashboard template. -->
<templates xml:space="preserve">
    <t t-name="pos_salon.SalonScreen">
        <div class="salon-screen screen h-100 d-flex flex-column align-items-center justify-content-start p-3">

        <!-- Top buttons -->
            <div class="d-flex gap-2 mb-4">
                <button class="btn btn-outline-pink" t-on-click="openBookAppointment">BOOK APPOINTMENTS</button>
                <button t-if="pos.config.show_appointments" class="btn btn-outline-pink"
                        t-on-click="() => pos.router.navigate('ShowAppointmentsScreen')"> SHOW APPOINTMENTS
                </button>
                <button class="btn btn-outline-pink"
                        t-on-click="openWalkInAppointments"> WALK-IN
                </button>
                <button class="btn btn-outline-pink"
                        t-on-click="() => pos.router.navigate('RunningAppointmentsScreen')">
                    RUNNING APPOINTMENTS
                </button>
                <button t-if="pos.config.show_appointments and pos.config.show_all_appointments" class="btn btn-outline-pink" t-on-click="openTrackAllAppointments"> TRACK ALL APPOINTMENTS
                </button>
                <button t-if="pos.config.apply_commission" class="btn btn-outline-pink"
                        t-on-click="openCommission"> COMMISSION
                </button>
            </div>

          <!-- Center content -->
            <div class="text-center mt-5">
                <h2>Refresh, Relax, and Revive with Us</h2>
                <p class="text-muted">Elevate your self-care with our high-end salon experiences</p>
            </div>

        </div>
    </t>
</templates>