<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for tracking all salon appointments. -->
<templates xml:space="preserve">
    <t t-name="pos_salon.TrackAllAppointmentsScreen">
        <div class="track-all-screen h-100 d-flex flex-column bg-light">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center p-3 bg-white border-bottom shadow-sm">
                <button class="btn btn-light" t-on-click="back">
                    <i class="fa fa-arrow-left me-2"/> Back
                </button>
                <h3 class="m-0 text-primary fw-bold">
                    <i class="fa fa-list-alt me-2"/> All Appointments
                </h3>
                <button class="btn btn-primary" t-on-click="refresh">
                    <i class="fa fa-refresh me-2"/> Refresh
                </button>
            </div>

            <!-- Loading -->
            <t t-if="state.loading">
                <div class="flex-grow-1 d-flex align-items-center justify-content-center">
                    <div class="text-center">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted">Loading all appointments...</p>
                    </div>
                </div>
            </t>

            <!-- Error -->
            <t t-if="!state.loading and state.error">
                <div class="flex-grow-1 d-flex align-items-center justify-content-center">
                    <div class="text-center p-4">
                        <i class="fa fa-exclamation-triangle text-warning" style="font-size: 3rem;"/>
                        <h4 class="mt-3 text-danger">Error Loading Appointments</h4>
                        <p class="text-muted mb-3"><t t-out="state.error"/></p>
                        <button class="btn btn-primary" t-on-click="refresh">
                            <i class="fa fa-refresh me-2"/> Try Again
                        </button>
                    </div>
                </div>
            </t>

            <!-- Empty -->
            <t t-if="!state.loading and !state.error and state.appointments.length === 0">
                <div class="flex-grow-1 d-flex align-items-center justify-content-center">
                    <div class="text-center p-4">
                        <i class="fa fa-calendar-o text-muted" style="font-size: 4rem; opacity: 0.3;"/>
                        <h4 class="mt-3 text-muted">No Appointments Found</h4>
                        <p class="text-muted">You can create new bookings from the salon screen.</p>
                    </div>
                </div>
            </t>

            <!-- Table -->
            <t t-if="!state.loading and !state.error and state.appointments.length > 0">
                <div class="flex-grow-1 overflow-auto p-4">
                    <div class="card mb-3 border-0 shadow-sm">
                        <div class="card-body bg-primary text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-0 text-white">Total Appointments</h5>
                                    <p class="mb-0 small opacity-75 text-white">All bookings, all dates</p>
                                </div>
                                <div class="display-4 fw-bold">
                                    <t t-out="state.appointments.length"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4"><i class="fa fa-hashtag me-2"/>ID</th>
                                            <th class="py-3 px-4"><i class="fa fa-user me-2"/>Customer</th>
                                            <th class="py-3 px-4"><i class="fa fa-phone me-2"/>Phone</th>
                                            <th class="py-3 px-4"><i class="fa fa-calendar me-2"/>Date</th>
                                            <th class="py-3 px-4"><i class="fa fa-clock-o me-2"/>Slot</th>
                                            <th class="py-3 px-4"><i class="fa fa-scissors me-2"/>Service</th>
                                            <th class="py-3 px-4"><i class="fa fa-flag me-2"/>Status</th>
                                            <th class="py-3 px-4"><i class="fa fa-money me-2"/>Amount</th>
                                            <th class="py-3 px-4"><i class="fa fa-money me-2"/>Payment</th>
                                            <th class="py-3 px-4"><i class="fa fa-star me-2"/>Review</th>
                                            <th class="py-3 px-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.appointments" t-as="appt" t-key="appt.id">
                                            <tr>
                                                <td class="py-3 px-4 fw-semibold text-primary">#<t t-out="appt.id"/></td>
                                                <td class="py-3 px-4"><strong><t t-out="appt.customer_name"/></strong></td>
                                                <td class="py-3 px-4"><t t-out="appt.customer_phone"/></td>
                                                <td class="py-3 px-4"><t t-out="formatDate(appt.date)"/></td>
                                                <td class="py-3 px-4">
                                                    <span t-attf-class="badge px-3 py-2 {{formatSlot(appt.slot) === 'Walk-in' ? 'bg-warning' : 'bg-info'}}">
                                                        <t t-out="formatSlot(appt.slot)"/>
                                                    </span>
                                                    <div t-if="appt.time_period and (appt.slot || '').trim() === 'Walk-in'" class="small fw-semibold mt-1">
                                                        <i class="fa fa-clock-o me-1"/><t t-out="appt.time_period"/>
                                                    </div>
                                                </td>
                                                <td class="py-3 px-4">
                                                    <t t-out="appt.service_name"/>
                                                    <div t-if="appt.specialist_name" class="text-muted small"><i class="fa fa-user me-1"/><t t-out="appt.specialist_name"/></div>
                                                    <div t-if="appt.amenity_names" class="text-muted small"><i class="fa fa-plus-circle me-1"/><t t-out="appt.amenity_names"/></div>
                                                </td>
                                                <td class="py-3 px-4">
                                                    <span t-attf-class="badge px-3 py-2 {{appt.state === 'confirmed' ? 'text-bg-success' : appt.state === 'done' ? 'text-bg-primary' : appt.state === 'cancelled' ? 'text-bg-danger' : appt.state === 'rescheduled' ? 'text-bg-secondary' : 'text-bg-warning'}}">
                                                        <t t-out="stateLabel(appt.state)"/>
                                                    </span>
                                                </td>
                                                <td class="py-3 px-4 fw-semibold text-nowrap"><t t-out="formatAmount(appt.amount_payable)"/></td>
                                                <td class="py-3 px-4">
                                                    <span t-attf-class="badge px-3 py-2 {{appt.payment_state === 'paid' ? 'text-bg-success' : appt.payment_state === 'partial' ? 'text-bg-warning' : 'text-bg-danger'}}">
                                                        <t t-out="paymentLabel(appt.payment_state)"/>
                                                    </span>
                                                </td>
                                                <td class="py-3 px-4 text-nowrap">
                                                    <span t-if="appt.rating" class="text-warning" t-out="'★'.repeat(appt.rating)"/>
                                                    <span t-elif="appt.review_mail_sent" class="text-muted small">Review pending</span>
                                                    <span t-elif="appt.state === 'done' and !appt.customer_email" class="text-muted small">No email</span>
                                                    <span t-else="" class="text-muted">-</span>
                                                </td>
                                                <td class="py-3 px-4">
                                                    <div class="d-flex flex-wrap gap-2">
                                                        <button t-if="['confirmed', 'done'].includes(appt.state) and appt.payment_state !== 'paid'"
                                                                class="btn btn-sm btn-primary"
                                                                t-on-click="() => this.payBooking(appt)">
                                                            <i class="fa fa-credit-card me-1"/>Pay <t t-out="formatAmount(appt.amount_due)"/>
                                                        </button>
                                                        <button t-if="appt.state === 'confirmed'"
                                                                class="btn btn-sm btn-success"
                                                                t-on-click="() => this.changeState(appt.id, 'action_done')">
                                                            <i class="fa fa-check me-1"/>Complete
                                                        </button>
                                                        <button t-if="appt.state === 'confirmed' and appt.payment_state === 'unpaid'"
                                                                class="btn btn-sm btn-outline-danger"
                                                                t-on-click="() => this.changeState(appt.id, 'action_cancel')">
                                                            Cancel
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
            <t t-if="state.showCommissionPopup">
                <div class="modal-backdrop fade show"/>
                <div class="modal d-block" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title"><i class="fa fa-money me-2"/>Commission</h5>
                                <button type="button" class="btn-close" t-on-click="closeCommissionPopup"/>
                            </div>
                            <div class="modal-body">
                                <p class="mb-1">Specialist: <strong><t t-out="state.commissionBooking.specialist_name"/></strong></p>
                                <p class="mb-3">Booking amount: <t t-out="formatAmount(state.commissionBooking.amount_total)"/></p>
                                <label class="form-label fw-semibold">Commission amount:</label>
                                <input type="number" min="0" step="0.01" class="form-control"
                                       t-model="state.commissionAmount"/>
                                <div t-if="state.commissionWarning" class="alert alert-warning mt-3 mb-0">
                                    <t t-out="state.commissionWarning"/>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" t-on-click="closeCommissionPopup">Cancel</button>
                                <button type="button" class="btn btn-success" t-on-click="confirmCommission">Continue to Payment</button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
