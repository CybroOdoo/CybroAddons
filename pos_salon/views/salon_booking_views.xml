<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bookings -->
    <record id="view_salon_booking_list" model="ir.ui.view">
        <field name="name">salon.booking.list</field>
        <field name="model">salon.booking</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
                <field name="date"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="service_name"/>
                <field name="specialist_id"/>
                <field name="amount_payable" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="payment_state" widget="badge"/>
                <field name="rating_stars" string="Review"/>
            </list>
        </field>
    </record>

    <record id="view_salon_booking_form" model="ir.ui.view">
        <field name="name">salon.booking.form</field>
        <field name="model">salon.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_review_mail" type="object" string="Send Review Mail"
                            invisible="state != 'done' or review_date or not customer_email"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <field name="commission_enabled" invisible="1"/>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="customer_email"/>
                        </group>
                        <group string="Booking">
                            <field name="date"/>
                            <field name="slot"/>
                            <field name="time_period"/>
                            <field name="service_name"/>
                            <field name="specialist_id"/>
                            <field name="config_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Payment">
                            <field name="amount_total"/>
                            <field name="amount_payable"/>
                            <field name="amount_due"/>
                            <field name="payment_state"/>
                            <field name="pos_order_id"/>
                        </group>
                        <group string="Commission" invisible="not commission_enabled">
                            <field name="commission_amount"/>
                        </group>
                    </group>
                    <group string="Review">
                        <field name="review_mail_sent"/>
                        <field name="rating_stars"/>
                        <field name="review_note"/>
                        <field name="review_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_salon_booking_search" model="ir.ui.view">
        <field name="name">salon.booking.search</field>
        <field name="model">salon.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="specialist_id"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <filter name="paid" string="Paid" domain="[('payment_state', '=', 'paid')]"/>
                <filter name="reviewed" string="Reviewed" domain="[('rating', '>', 0)]"/>
                <filter name="review_pending" string="Review Pending"
                        domain="[('review_mail_sent', '=', True), ('rating', '=', 0)]"/>
                <group>
                    <filter name="group_specialist" string="Specialist" context="{'group_by': 'specialist_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:month'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_salon_booking_pivot" model="ir.ui.view">
        <field name="name">salon.booking.pivot</field>
        <field name="model">salon.booking</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="specialist_id" type="row"/>
                <field name="rating" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Commission views -->
    <record id="view_salon_commission_list" model="ir.ui.view">
        <field name="name">salon.booking.commission.list</field>
        <field name="model">salon.booking</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="customer_name"/>
                <field name="specialist_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="commission_amount" sum="Total Commission"/>
                <field name="state" widget="badge"/>
                <field name="payment_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_salon_commission_pivot" model="ir.ui.view">
        <field name="name">salon.booking.commission.pivot</field>
        <field name="model">salon.booking</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="specialist_id" type="row"/>
                <field name="amount_total" type="measure"/>
                <field name="commission_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_salon_booking" model="ir.actions.act_window">
        <field name="name">Salon Bookings</field>
        <field name="res_model">salon.booking</field>
        <field name="view_mode">list,form,pivot</field>
    </record>

    <record id="action_salon_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">salon.booking</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('rating', '>', 0)]</field>
        <field name="context">{'search_default_group_specialist': 1}</field>
    </record>

    <record id="action_salon_commission" model="ir.actions.act_window">
        <field name="name">Commission</field>
        <field name="res_model">salon.booking</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('config_id.apply_commission', '=', True), ('specialist_id', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_salon_commission_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_salon_commission_pivot')})]"/>
    </record>

    <!-- Menus -->
    <menuitem id="menu_salon_root" name="Salon" parent="point_of_sale.menu_point_root"
              sequence="30" groups="point_of_sale.group_pos_user"/>
    <menuitem id="menu_salon_booking" name="Bookings" parent="menu_salon_root"
              action="action_salon_booking" sequence="1"/>
    <menuitem id="menu_salon_review" name="Reviews" parent="menu_salon_root"
              action="action_salon_review" sequence="2"
              groups="point_of_sale.group_pos_manager"/>
    <menuitem id="menu_salon_commission" name="Commission" parent="menu_salon_root"
              action="action_salon_commission" sequence="3"
              groups="point_of_sale.group_pos_manager"/>
</odoo>