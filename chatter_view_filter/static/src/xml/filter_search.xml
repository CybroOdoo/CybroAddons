<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="FilterChatter" t-inherit="mail.SearchMessagesPanel"
       t-inherit-mode="extension">
        <xpath expr="//*[contains(@class, 'o_searchview_input_container')]"
               position="inside">
            <Dropdown
                    togglerClass="'o_search_chatter_dropdown_toggler d-print-none btn btn-outline-secondary o-no-caret rounded-start-0 h-100'">
                <t t-set-slot="toggler">
                    <i class="fa fa-filter" aria-hidden="true"
                       title="Toggle Search Panel"/>
                </t>
                <div class="follower_menu">
                    Followers
                </div>
                <DropdownItem t-if="props.thread.selfFollower"
                              onSelected.bind="()=>this.onAddUserFilterClick(props.thread.selfFollower.id)">
                           <div class="dropdown-item o-mail-Follower d-flex justify-content-between p-0">
                                <span class="flex-shrink text-truncate"
                                      t-esc="props.thread.selfFollower.name"/>
                            </div>
                    </DropdownItem>
                <t t-foreach="props.thread.followers" t-as="follower"
                   t-key="follower.id">
                        <DropdownItem t-esc="follower.partner.name"
                                      onSelected.bind="()=>this.onAddUserFilterClick(follower.id)"/>

                    </t>
                <div role="separator" class="dropdown-divider"/>
                <t>
                    <div class="date_filter_values">
                        Date
                    </div>
                    <DateTimeInput
                            value="date"
                            type="'date'"
                            placeholder="fromPlaceholder"
                            onChange.bind="onChanged"/>
                    <DropdownItem>
                           <button class="chatter_date_search_button btn-primary"
                                   style="'padding: 2px;
                           border-radius: 4px; position: fixed;'"
                                   t-on-click="()=>this.DateMessageSearch()">
                               search</button>
                        </DropdownItem>

                    </t>
            </Dropdown>
        </xpath>
    </t>
</templates>
