<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Basic salary rule: use the worked hours for hourly employees and
     keep the contract wage for everybody else. -->
    <record id="hr_payroll_community.hr_rule_basic" model="hr.salary.rule">
        <field name="amount_python_compute">result = employee.hourly_cost * payslip.total_hours if employee.hourly_payslip else contract.wage</field>
    </record>
</odoo>
