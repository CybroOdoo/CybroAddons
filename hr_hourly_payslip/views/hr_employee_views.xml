<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited form view of hr.employee in order to add new fields -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.hr.hourly.payslip</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='application_group']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//group[@name='application_group']//div[@name='hourly_cost']" position="after">
                <field name="hourly_payslip"/>
            </xpath>
        </field>
    </record>
</odoo>