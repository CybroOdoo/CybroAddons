<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View of asset.account.product -->
    <record id="asset_account_product_view_form" model="ir.ui.view">
        <field name="name">asset.account.product.view.form</field>
        <field name="model">asset.account.product</field>
        <field name="arch" type="xml">
            <form string="Asset Account">
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="account_type_id" required="1"/>
                </group>
                <footer>
                    <button string="Export" name="action_export_products"
                            class="btn-primary" type="object"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
