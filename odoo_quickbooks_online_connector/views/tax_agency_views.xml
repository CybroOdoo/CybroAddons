<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Action of tax.agency -->
    <record id="tax_agency_action" model="ir.actions.act_window">
        <field name="name">Tax Agency</field>
        <field name="res_model">tax.agency</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': 0}</field>
    </record>
    <!-- Menu items -->
    <menuitem id="tax_agency_menu" name="Tax Agency" sequence="3"
              parent="account.account_account_menu"
              action="tax_agency_action"/>
    <!-- Form view of tax agency -->
    <record id="tax_agency_view_form" model="ir.ui.view">
        <field name="name">tax.agency.view.form</field>
        <field name="model">tax.agency</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tax_agency"/>
                        <field name="qbooks_agency" readonly="1"/>
                        <field name="qbooks_sync_token" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- list view of tax agency -->
    <record id="tax_agency_view_tree" model="ir.ui.view">
        <field name="name">tax.agency.view.list</field>
        <field name="model">tax.agency</field>
        <field name="arch" type="xml">
            <list>
                <field name="tax_agency"/>
                <field name="qbooks_agency"/>
                <field name="qbooks_sync_token"/>
            </list>
        </field>
    </record>
</odoo>
