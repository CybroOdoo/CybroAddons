<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="qbooks_logs_view_list" model="ir.ui.view">
        <field name="name">qbooks.logs.view.list</field>
        <field name="model">qbooks.logs</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'failed'"
                  decoration-success="status == 'success'" create="false">
                <field name="create_date" string="Date"/>
                <field name="operation_type"/>
                <field name="name"/>
                <field name="message"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'failed'"
                       decoration-success="status == 'success'"/>
                <button name="action_open_record" type="object"
                        string="View Record" icon="fa-external-link"
                        invisible="not res_model"
                />
            </list>
        </field>
    </record>

    <record id="qbooks_logs_action" model="ir.actions.act_window">
        <field name="name">Qbooks Logs</field>
        <field name="res_model">qbooks.logs</field>
        <field name="view_mode">list</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first record
            </p>
        </field>
    </record>

    <menuitem id="qbooks_logs_menu"
              name="Qbooks Logs"
              parent="odoo_quickbooks_online_connector.quickbooks_menu_configuration"
              action="qbooks_logs_action"
              sequence="1"/>
</odoo>
