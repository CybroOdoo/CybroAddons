<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form view of product.category inherited -->
    <record id="product_category_form_view" model="ir.ui.view">
        <field name="name">product.category.view.form.inherit.odoo.quickbooks.online.connector</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <group name="qbook" string="QuickBooks Data">
                        <field name="qbooks_product_category" readonly="1"/>
                        <field name="qbooks_sync_token" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_quickbook_product_category" model="ir.actions.act_window">
        <field name="name">Product Category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qbooks_product_category', '!=', False)]</field>
        <field name="context">{'create': 0}</field>
    </record>
</odoo>
