<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited res_partner model form view to add fields related to quickbook -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.odoo.quickbooks.online.connector</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
<!--            <xpath expr="//group[@name='container_row_stock']" position="after">-->
            <xpath expr="//group[@name='container_row_2']" position="after">
                <group>
                    <group name="qbook" string="QuickBooks Data">
                        <field name="qbooks_customer" readonly="1"/>
                        <field name="qbooks_vendor" readonly="1"/>
                        <field name="qbooks_sync_token" readonly="1"/>
                        <field name="qbooks_tax_exempt" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <!--Fetch customers that are imported from Quickbook.-->
    <record id="action_quickbook_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qbooks_customer', '!=', False)]</field>
        <field name="context">{'create': 0}</field>
    </record>
    <!--Fetch vendors that are imported from Quickbook.-->
    <record id="action_quickbook_vendors" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qbooks_vendor', '!=', False)]</field>
        <field name="context">{'create': 0}</field>
    </record>
</odoo>
