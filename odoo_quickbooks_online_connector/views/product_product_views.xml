<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited product_product model form view to add fields related to quickbook -->
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">
            product.product.view.form.inherit.odoo.quickbooks.online.connector
        </field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <group string="QuickBooks Data">
                    <field name="qbooks_product"/>
                    <field name="qbooks_sync_token"/>
                </group>
            </xpath>
        </field>
    </record>
    <!--Fetch products that are imported from Quickbook.-->
    <record id="action_quickbook_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qbooks_product', '!=', False)]</field>
        <field name="context">{'create': 0}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a Document Format
            </p>
        </field>
    </record>
</odoo>
