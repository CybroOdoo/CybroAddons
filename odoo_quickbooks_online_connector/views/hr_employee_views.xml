<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited hr_employee model form view to add fields related to quickbook -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">
            hr.employee.view.form.inherit.odoo.quickbooks.online.connector
        </field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
<!--            <xpath expr="//div[@id='o_work_employee_main']" position="inside">-->
            <xpath expr="//div[@id='o_work_information']" position="inside">
                <group name="qbook" string="QuickBooks Data">
                    <field name="qbooks_employee" readonly="1"/>
                    <field name="qbooks_sync_token" readonly="1"/>
                    <field name="family_name"/>
                </group>
            </xpath>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_quickbook_employees" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qbooks_employee', '!=', False)]</field>
        <field name="context">{'create': 0}</field>
    </record>
</odoo>
