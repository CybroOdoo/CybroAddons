<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited sale_order model form view to add fields related to quickbook -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">
            sale.order.view.form.inherit.odoo.quickbooks.online.connector
        </field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="inside">
                <group>
                    <group name="qbook" string="QuickBooks Data">
                        <field name="qbooks_sale" readonly="1"/>
                        <field name="qbooks_sync_token" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <!--Fetch sale orders that are imported from Quickbook.-->
    <record id="action_sale_orders" model="ir.actions.act_window">
        <field name="name">Sale Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qbooks_sale', '!=', False)]</field>
        <field name="context">{'create': 0}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a Document Format
            </p>
        </field>
    </record>
</odoo>
