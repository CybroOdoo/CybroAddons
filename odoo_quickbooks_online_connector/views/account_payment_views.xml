<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Fetch Vendor payments that are imported from Quickbook.-->
    <record id="action_quickbook_vendor_payments" model="ir.actions.act_window">
        <field name="name">Vendor Payments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qbooks_payment', '!=', False), ('partner_type', '=', 'supplier')]</field>
        <field name="context">{'create': 0}</field>
    </record>
    <!--Fetch Customer payments that are imported from Quickbook.-->
    <record id="action_quickbook_customer_payments" model="ir.actions.act_window">
        <field name="name">Customer Payments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qbooks_payment', '!=', False), ('partner_type', '=', 'customer')]</field>
        <field name="context">{'create': 0}</field>
    </record>
</odoo>
