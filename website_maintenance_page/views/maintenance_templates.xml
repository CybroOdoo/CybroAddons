<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Replace the website with the maintenance page for public users -->
    <template inherit_id="portal.frontend_layout"
              id="website_maintenance" name="Maintenance Page">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-if">not user_id._is_public() or not
                website.under_maintenance or
                request.httprequest.path == '/web/login'
            </attribute>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <div t-if="user_id._is_public() and website.under_maintenance and request.httprequest.path != '/web/login'"
                 class="o_maintenance_page">
                <style>
                    .o_maintenance_wrap {
                        position: relative;
                        width: 100%;
                        height: calc(100vh - 64px);
                        overflow: hidden;
                    }
                    .o_maintenance_wrap img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        display: block;
                    }
                    .o_maintenance_text {
                        position: absolute;
                        top: 50%;
                        left: 50%;
                        transform: translate(-50%, -50%);
                        z-index: 9;
                        text-align: center;
                        width: 90%;
                    }
                </style>
                <nav class="navbar navbar-expand navbar-light bg-light">
                    <div class="container">
                        <a href="/" class="navbar-brand logo">
                            <img t-att-src="'/logo.png?company=%s' % res_company.id"
                                 t-att-alt="'Logo of %s' % res_company.name"
                                 t-att-title="res_company.name"/>
                        </a>
                        <ul id="top_menu" class="nav navbar-nav ms-auto">
                            <t t-call="portal.placeholder_user_sign_in">
                                <t t-set="_item_class" t-value="'nav-item'"/>
                                <t t-set="_link_class" t-value="'nav-link'"/>
                            </t>
                        </ul>
                    </div>
                </nav>
                <div class="o_maintenance_wrap">
                    <img t-if="website.maintenance_img"
                         t-att-src="image_data_uri(website.maintenance_img)"
                         alt="Under maintenance"/>
                    <div class="o_maintenance_text">
                        <h2 t-att-style="'color: %s;' % website.maintenance_hdr_color if website.maintenance_hdr_color else None">
                            <t t-out="website.maintenance_hdr"/>
                        </h2>
                        <span t-att-style="'color: %s;' % website.maintenance_cont_color if website.maintenance_cont_color else None">
                            <t t-out="website.maintenance_msg"/>
                        </span>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
    <!-- Standalone page rendered by the /maintenance route -->
    <template id="maintenance_page" name="Website Maintenance">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5 text-center o_maintenance_preview">
                    <h2 t-out="website.maintenance_hdr or 'Website Under Maintenance'"/>
                    <p t-out="website.maintenance_msg"/>
                </section>
            </div>
        </t>
    </template>
</odoo>
