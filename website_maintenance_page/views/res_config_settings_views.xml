<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Website settings: add the maintenance mode block -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.maintenance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_info_settings" position="after">
                <block title="Website Maintenance" id="website_maintenance_settings">
                    <setting id="website_maintenance_setting"
                             string="Under Maintenance"
                             help="Show a maintenance page to visitors who are not signed in">
                        <field name="is_under_maintenance"/>
                        <div class="content-group" invisible="not is_under_maintenance">
                            <div class="row mt8">
                                <label class="col-lg-4" for="maintenance_header"/>
                                <field name="maintenance_header"/>
                            </div>
                            <div class="row mt8">
                                <label class="col-lg-4" for="maintenance_hdr_color"/>
                                <field name="maintenance_hdr_color" widget="color"/>
                            </div>
                            <div class="row mt8">
                                <label class="col-lg-4" for="maintenance_message"/>
                                <field name="maintenance_message"/>
                            </div>
                            <div class="row mt8">
                                <label class="col-lg-4" for="maintenance_cont_color"/>
                                <field name="maintenance_cont_color" widget="color"/>
                            </div>
                            <div class="row mt8">
                                <label class="col-lg-4" for="maintenance_img"/>
                                <field name="maintenance_img" widget="image"
                                       class="float-start oe_avatar"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
    <!-- Website form: add the maintenance fields -->
    <record id="view_website_form" model="ir.ui.view">
        <field name="name">website.view.form.inherit.website.maintenance</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <field name="language_ids" position="after">
                <field name="under_maintenance"/>
                <field name="maintenance_hdr" invisible="not under_maintenance"/>
                <field name="maintenance_hdr_color" widget="color"
                       invisible="not under_maintenance"/>
                <field name="maintenance_msg" invisible="not under_maintenance"/>
                <field name="maintenance_cont_color" widget="color"
                       invisible="not under_maintenance"/>
                <field name="maintenance_img" widget="image"
                       class="oe_avatar w-auto float-start"
                       invisible="not under_maintenance"/>
            </field>
        </field>
    </record>
</odoo>
