<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.contacts.email.validator</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='contacts_setting_container']" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box"
                     title="Enable this option to validate email addresses before saving them in contacts."
                     id="partner_autocomplete">
                    <div class="o_setting_left_pane">
                        <field name="email_validation_enabled"/>
                    </div>
                    <div class="o_setting_right_pane" id="email_validation_enabled">
                        <label for="email_validation_enabled"/>
                        <div class="text-muted">
                            Email Validation
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
