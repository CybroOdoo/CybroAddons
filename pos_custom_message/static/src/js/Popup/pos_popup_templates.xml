<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Custom Message Alert Popup -->
    <t t-name="pos_custom_message.CustomMessageAlertPopup" owl="1">
        <Dialog size="'md'" header="false" footer="false" bodyClass="'p-0'" contentClass="'overflow-hidden'">
            <div class="modal-header"
                 style="background-color:pink; display:flex; align-items:center; justify-content:center;">
                <h4 class="modal-title mb-0">
                    <b><i class="fa fa-bell"/> <t t-esc="props.title"/></b>
                </h4>
            </div>
            <div class="modal-body">
                <main class="body">
                    <t t-esc="props.body"/>
                </main>
            </div>
            <footer class="footer footer-flex modal-footer">
                <button class="btn btn-primary btn-lg ms-auto" t-on-click="cancel">
                    <t t-esc="props.confirmText"/>
                </button>
            </footer>
        </Dialog>
    </t>

    <!-- Custom Message Info Popup -->
    <t t-name="pos_custom_message.CustomMessageInfoPopup" owl="1">
        <Dialog size="'md'" header="false" footer="false" bodyClass="'p-0'" contentClass="'overflow-hidden'">
            <div class="modal-header"
                 style="background-color:bisque; display:flex; align-items:center; justify-content:center;">
                <h4 class="modal-title mb-0">
                    <i class="fa fa-exclamation-circle"/> <t t-esc="props.title"/>
                </h4>
            </div>
            <div class="modal-body">
                <main class="body">
                    <t t-esc="props.body"/>
                </main>
            </div>
            <footer class="footer footer-flex modal-footer">
                <button class="btn btn-primary btn-lg ms-auto" t-on-click="cancel">
                    <t t-esc="props.confirmText"/>
                </button>
            </footer>
        </Dialog>
    </t>

    <!-- Custom Message Warning Popup -->
    <t t-name="pos_custom_message.CustomMessageWarnPopup" owl="1">
        <Dialog size="'md'" header="false" footer="false" bodyClass="'p-0'" contentClass="'overflow-hidden'">
            <div class="modal-header"
                 style="background-color:darksalmon; display:flex; align-items:center; justify-content:center;">
                <h4 class="modal-title mb-0">
                    <i class="fa fa-exclamation-triangle"/> <t t-esc="props.title"/>
                </h4>
            </div>
            <div class="modal-body">
                <main class="body">
                    <t t-esc="props.body"/>
                </main>
            </div>
            <footer class="footer footer-flex modal-footer">
                <button class="btn btn-primary btn-lg ms-auto" t-on-click="cancel">
                    <t t-esc="props.confirmText"/>
                </button>
            </footer>
        </Dialog>
    </t>
</templates>
