<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_message.AlertPopup">
        <Dialog size="'md'" modalRef="modalRef" header="false" bodyClass="'p-0'">
            <div class="bg-danger text-white text-center py-3 fs-4 fw-bolder rounded-top">
                <i class="fa fa-bell me-2" role="img" aria-label="Alert" title="Alert"/>
                <t t-out="props.title"/>
            </div>
            <div class="p-4 text-center fs-5 text-prewrap">
                <t t-out="props.body"/>
            </div>
            <t t-set-slot="footer">
                <div class="w-100 text-center">
                    <button class="btn btn-primary btn-lg px-5" t-on-click="_confirm" t-att-class="props.confirmClass" t-esc="props.confirmLabel"/>
                </div>
            </t>
        </Dialog>
    </t>
</templates>