<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Configuration Settings Form view-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.website.order.delivery.tracking
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_setting_container']"
                   position="before">
                <block title="Delivery Tracking"
                       name="delivery_tracking_setting_container">
                    <setting id="delivery_tracking_api_key_setting"
                             string="Delivery Tracking API Key"
                             help="Set the API key used by delivery partners to update the delivery status.">
                        <field name="delivery_tracking_api_key"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
