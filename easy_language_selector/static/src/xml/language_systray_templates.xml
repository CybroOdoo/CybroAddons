<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="LanguageSystray">
        <div class="new_icon">
            <div class="o-dropdown dropdown">
                <div id="language_select_div" class="toggle-icon" role="button">
                    <select id="language_selector"
                            style="color:#000;background-color: transparent;border-color:transparent"
                            t-on-change="this.onChangeLang">
                        <option class="language_options" value="0">Select Language</option>
                        <t t-foreach="this.languages.value" t-as="lang" t-key="lang.code">
                            <option class="language_options" t-att-value="lang.code" t-out="lang.name"/>
                        </t>
                        <option t-if="this.canAddLanguage" class="language_options"
                                value="add_extra_lang">Add Language</option>
                    </select>
                </div>
            </div>
        </div>
    </t>
</templates>
