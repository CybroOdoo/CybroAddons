<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Adds the resize handle to backend dialogs -->
    <t t-inherit="web.Dialog" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('modal-dialog')]" position="attributes">
            <attribute name="t-att-class">{ o_dialog_resized: this.isResizable and this.contentSize.width }</attribute>
        </xpath>
        <xpath expr="//div[hasclass('modal-content')]" position="inside">
            <span t-if="this.isResizable" class="o_dialog_resize_handle" title="Resize" aria-hidden="true"
                  t-on-pointerdown="(ev) => this.onResizeStart(ev)"/>
        </xpath>
    </t>
</templates>
