<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Inherit res config settings view-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.google.search.in.odoo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="recaptcha" position="after">
                <setting id="google_search_setting"
                         string="Google Search"
                         help="Enable Google web search in the systray">
                    <field name="google_search"/>
                    <div class="content-group" invisible="not google_search">
                        <div class="mt16 row">
                            <label for="ser_client_api" string="API Key" class="col-3 col-lg-3 o_light_label"/>
                            <field name="ser_client_api" password="True"/>
                        </div>
                        <div class="mt16">
                            <a role="button"
                               href="https://exa.ai/"
                               target="_blank"
                               class="btn btn-link btn-success o_activity_link">
                                <i class="fa fa-arrow-right me-1"/>
                                Get API Key from Exa
                            </a>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
