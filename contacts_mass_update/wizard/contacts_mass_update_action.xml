<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--     Wizard Action -->
    <record id="action_contacts_mass_update" model="ir.actions.act_window">
        <field name="name">Contacts Mass Update</field>
        <field name="res_model">contacts.mass.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
    </record>

<!--     Menu Item under Contacts -->
    <menuitem id="menu_contacts_mass_update"
              name="Mass Update"
              parent="contacts.menu_contacts"
              action="action_contacts_mass_update"
              sequence="50"/>

<!--    Server action to perform on specific partners-->
    <record id="action_open_contacts_mass_update" model="ir.actions.server">
        <field name="name">Contacts Mass Update</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'res_model': 'contacts.mass.update',
                'context': {
                    'active_model': 'res.partner',
                    'active_ids': records.ids,
                }
            }
        </field>
    </record>

</odoo>