<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Inherited view for the account move -->
    <record id="view_move_form_inherit_odoo_contact_approval" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.odoo.contact.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create_edit': True, 'no_create': True}</attribute>
                <attribute name="domain">[('company_id', 'in', (False, company_id)), ('state', '=', 'approve')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
