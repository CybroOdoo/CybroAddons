<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_approve_contacts" model="res.groups.privilege">
        <field name="name">Allow Approve Contacts</field>
        <field name="sequence">17</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <!--    Group for the Contact approval manager     -->
    <record id="group_contacts_approval" model="res.groups">
        <field name="name">Contacts Approval Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_approve_contacts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_partner_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
