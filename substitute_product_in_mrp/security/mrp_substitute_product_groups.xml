<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Creating substitute product category group -->
        <record id="mrp_substitute_product_category" model="ir.module.category">
            <field name="name">Substitute Group</field>
        </record>
        <!-- Creating substitute product group -->

        <record model="res.groups.privilege" id="res_groups_privilege_mrp_substitute">
            <field name="name">Allow Substitute Privilege</field>
            <field name="category_id" ref="mrp_substitute_product_category"/>
            <field name="sequence">7</field>
        </record>

        <record id="mrp_substitute_product_group" model="res.groups">
            <field name="name">Allow Substitute Product(MRP)</field>
            <field name="privilege_id" ref="res_groups_privilege_mrp_substitute"/>
        </record>
    </data>
</odoo>