<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Product list View inherits and added a field -->
    <record id="product_product_list_view" model="ir.ui.view">
        <field name="name">product.product.view.list.inherit.all.in.one.website.kit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="after">
                <field name="website_hide_variants"/>
            </field>
        </field>
    </record>
<!--    Product Normal Form view inherited and add fields-->
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.view.form.inherit.all.in.one.website.kit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_ok']/.." position="after">
                <span class="d-inline-block">
                    <field name="website_hide_variants"/>
                    <label class="o_form_label" for="website_hide_variants">
                        Hide On Website
                        <sup class="btn-link p-1">?</sup>
                    </label>
                </span>
            </xpath>
        </field>
    </record>
</odoo>