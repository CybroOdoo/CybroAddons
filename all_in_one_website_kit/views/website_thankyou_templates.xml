<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<!--    Website thank page template-->
    <template id="customers_request_thank_page" name="Customer Request Thank">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure" id="oe_structure_website_thank_you_header"/>
                <div class="container mt-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card shadow-sm border-0">
                                <div class="card-body text-center p-5">
                                    <div class="mb-4">
                                        <i class="fa fa-check-circle text-success fa-5x"/>
                                    </div>
                                    <h1 class="mb-3">Thank You!</h1>
                                    <div class="alert alert-success d-inline-block px-4 py-2" role="alert">
                                        <i class="fa fa-info-circle me-2"/>Your return request has been submitted successfully.
                                    </div>
                                    <p class="lead mb-4 mt-3 text-muted">
                                        We have received your request and will get back to you shortly.
                                    </p>
                                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                                        <a href="/" class="btn btn-primary px-4 gap-3">
                                            <i class="fa fa-home me-2"/>Back to Home
                                        </a>
                                        <a href="/my/return_orders" class="btn btn-outline-secondary px-4">
                                            View Returns
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="oe_structure" id="oe_structure_website_thank_you_footer"/>
            </div>
        </t>
    </template>
</odoo>