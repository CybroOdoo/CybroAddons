<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- This template used to hide price from wishlist page-->
    <template id="wishlist_hide_price" inherit_id="website_sale_wishlist.product_wishlist">
        <!-- Intercept Price rendering: if price_call is true, do nothing, skipping the else block -->
        <xpath expr="//div[hasclass('o_wish_price')]" position="before">
            <t t-elif="wish.product_id.price_call"/>
        </xpath>
        
        <!-- Intercept Add to Cart rendering: if price_call is true, do nothing, skipping the else block -->
        <xpath expr="//button[hasclass('o_wish_add')]" position="before">
            <t t-elif="wish.product_id.price_call"/>
        </xpath>
    </template>
</odoo>