<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<!-- This template used to hide the price form the comparison page-->
    <template id="compare_hide_price" inherit_id="website_sale_comparison.product_compare">
        <!-- Sticky Header Price: Hide if price_call is true -->
        <xpath expr="//div[@id='miniStickyComparison']//div[hasclass('text-wrap')]" position="attributes">
            <attribute name="t-if">not combination_info['prevent_zero_price_sale'] and not product.price_call</attribute>
        </xpath>
        
        <!-- Main Table Price: Hide if price_call is true -->
        <xpath expr="//div[@id='o_comparelist_product_name']/span" position="attributes">
            <attribute name="t-if">not combination_info['prevent_zero_price_sale'] and not product.price_call</attribute>
        </xpath>

        <!-- Main Table Actions (Add to Cart / Contact Us): Hide if price_call is true -->
        <xpath expr="//div[@id='o_comparelist_product_name']//div[hasclass('mt-auto')]" position="attributes">
            <attribute name="t-if">not product.price_call</attribute>
        </xpath>
    </template>
</odoo>