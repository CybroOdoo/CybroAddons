<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--Website Product template inherited and add attachments-->
    <template id="product_attachments" inherit_id="website_sale.product" name="product attachments">
        <xpath expr="//div[@id='o_wsale_product_details_content']" position="inside">
            <div t-if="attachments" class="o_wsale_product_details_content_section o_wsale_product_details_content_section_attachments mb-4">
                <span><strong>Related Documents:</strong></span>
                <br/>
                <t t-foreach="attachments" t-as="attachment">
                    <a t-att-href="'/attachment/download?attachment_id=%i' % attachment.id" target="_blank" t-att-download="attachment.name" class="d-inline-block me-3 mb-2">
                        <i class="fa fa-download me-1"/>
                        <span t-esc="attachment.name"/>
                    </a>
                </t>
            </div>
        </xpath>
    </template>
</odoo>