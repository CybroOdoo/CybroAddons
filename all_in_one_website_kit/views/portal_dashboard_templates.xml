<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    The Dashboard portal replaced template-->
    <template id="replace_dashboard_portal_view">
        <t t-call="portal.frontend_layout">
            <div class="o_portal_dashboard container mt-3">
                <!-- User Welcome -->
                <div class="d-flex justify-content-end mb-3">
                    <a href="/my/account" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-user me-1"/> My Profile
                    </a>
                </div>

                <!-- KPI Cards -->
                <div class="row g-3 mb-5">
                    <!-- Quotations -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex align-items-center">
                                <div class="bg-light rounded-circle p-3 me-3">
                                    <img src="/all_in_one_website_kit/static/src/images/q1.png" alt="Quotations" style="width: 32px; height: 32px; object-fit: contain;"/>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Quotations</h6>
                                    <h3 class="fw-bold mb-0"><t t-esc="len(quotation_portal)"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-end">
                                <a href="/my/quotes" class="text-decoration-none small stretched-link">View <i class="fa fa-arrow-right ms-1"/></a>
                            </div>
                        </div>
                    </div>
                     <!-- RFQ -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex align-items-center">
                                <div class="bg-light rounded-circle p-3 me-3">
                                    <img src="/all_in_one_website_kit/static/src/images/rfq.png" alt="RFQ" style="width: 32px; height: 32px; object-fit: contain;"/>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">RFQ</h6>
                                    <h3 class="fw-bold mb-0"><t t-esc="len(rfq_portal)"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-end">
                                <a href="/my/rfq" class="text-decoration-none small stretched-link">View <i class="fa fa-arrow-right ms-1"/></a>
                            </div>
                        </div>
                    </div>
                    <!-- Sale Orders -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex align-items-center">
                                <div class="bg-light rounded-circle p-3 me-3">
                                    <img src="/all_in_one_website_kit/static/src/images/so.png" alt="Sale Orders" style="width: 32px; height: 32px; object-fit: contain;"/>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Sale Orders</h6>
                                    <h3 class="fw-bold mb-0"><t t-esc="len(sale_order_portal)"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-end">
                                <a href="/my/orders" class="text-decoration-none small stretched-link">View <i class="fa fa-arrow-right ms-1"/></a>
                            </div>
                        </div>
                    </div>
                    <!-- Purchase Orders -->
                     <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex align-items-center">
                                <div class="bg-light rounded-circle p-3 me-3">
                                    <img src="/all_in_one_website_kit/static/src/images/po.png" alt="Purchase Orders" style="width: 32px; height: 32px; object-fit: contain;"/>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Purchase Orders</h6>
                                    <h3 class="fw-bold mb-0"><t t-esc="len(purchase_orders_portal)"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-end">
                                <a href="/my/purchase" class="text-decoration-none small stretched-link">View <i class="fa fa-arrow-right ms-1"/></a>
                            </div>
                        </div>
                    </div>
                    <!-- Projects -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex align-items-center">
                                <div class="bg-light rounded-circle p-3 me-3">
                                    <img src="/all_in_one_website_kit/static/src/images/project.png" alt="Projects" style="width: 32px; height: 32px; object-fit: contain;"/>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Projects</h6>
                                    <h3 class="fw-bold mb-0"><t t-esc="len(projects_portal)"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-end">
                                <a href="/my/projects" class="text-decoration-none small stretched-link">View <i class="fa fa-arrow-right ms-1"/></a>
                            </div>
                        </div>
                    </div>
                     <!-- Tasks -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex align-items-center">
                                <div class="bg-light rounded-circle p-3 me-3">
                                    <img src="/all_in_one_website_kit/static/src/images/task.png" alt="Tasks" style="width: 32px; height: 32px; object-fit: contain;"/>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Tasks</h6>
                                    <h3 class="fw-bold mb-0"><t t-esc="len(tasks_portal)"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-end">
                                <a href="/my/tasks" class="text-decoration-none small stretched-link">View <i class="fa fa-arrow-right ms-1"/></a>
                            </div>
                        </div>
                    </div>
                    <!-- Bills & Invoices -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex align-items-center">
                                <div class="bg-light rounded-circle p-3 me-3">
                                    <img src="/all_in_one_website_kit/static/src/images/bill.png" alt="Invoices" style="width: 32px; height: 32px; object-fit: contain;"/>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Invoices &amp; Bills</h6>
                                    <h3 class="fw-bold mb-0"><t t-esc="len(invoices_portal)"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-end">
                                <a href="/my/invoices" class="text-decoration-none small stretched-link">View <i class="fa fa-arrow-right ms-1"/></a>
                            </div>
                        </div>
                    </div>
                     <!-- Returns -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex align-items-center">
                                <div class="bg-light rounded-circle p-3 me-3">
                                    <img src="/all_in_one_website_kit/static/src/images/return.png" alt="Returns" style="width: 32px; height: 32px; object-fit: contain;"/>
                                </div>
                                <div>
                                    <h6 class="card-title text-muted mb-1">Returns</h6>
                                    <!-- Use len(sale_return_portal) if available or pass count from controller. Assumed key. -->
                                     <h3 class="fw-bold mb-0">View</h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-end">
                                <a href="/my/return_orders" class="text-decoration-none small stretched-link">View <i class="fa fa-arrow-right ms-1"/></a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Sale Activity -->
                <t t-if="show_so_q">
                    <div class="row mb-5">
                        <div class="col-12 col-lg-6 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom-0 pt-3">
                                    <h5 class="card-title mb-0">Latest Quotations</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-nowrap mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-top-0">Order Number</th>
                                                    <th class="border-top-0">Order Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="quotations_limited" t-as="quotation">
                                                    <tr>
                                                        <td><a t-attf-href="/my/orders/#{quotation.id}" class="text-decoration-none fw-bold"><t t-esc="quotation.name"/></a></td>
                                                        <td><span class="text-muted"><t t-esc="quotation.date_order" t-options='{"widget": "date"}'/></span></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                         <div class="col-12 col-lg-6 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom-0 pt-3">
                                    <h5 class="card-title mb-0">Latest Sale Orders</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-nowrap mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-top-0">Order Number</th>
                                                    <th class="border-top-0">Order Date</th>
                                                    <th class="border-top-0 text-end">State</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="sale_orders_limited" t-as="order_id">
                                                    <tr>
                                                        <td><a t-attf-href="/my/orders/#{order_id.id}" class="text-decoration-none fw-bold"><t t-esc="order_id.name"/></a></td>
                                                        <td><span class="text-muted"><t t-esc="order_id.date_order" t-options='{"widget": "date"}'/></span></td>
                                                        <td class="text-end"><span class="badge bg-light text-dark border"><t t-esc="order_id.state"/></span></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                
                 <!-- Sales Chart -->
                <div class="row mb-5 justify-content-center">
                   <div class="col-12 col-md-8 col-lg-6">
                        <div class="card shadow-sm border-0">
                             <div class="card-header bg-transparent border-bottom-0 text-center">
                                <h5 class="card-title mb-0">Sales Overview</h5>
                            </div>
                            <div class="card-body">
                                <canvas id="sales_pie" style="max-height: 300px;"/>
                            </div>
                        </div>
                   </div>
                </div>

                <!-- Recent Purchase Activity -->
                <t t-if="show_po_rfq">
                    <div class="row mb-5">
                        <div class="col-12 col-lg-6 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom-0 pt-3">
                                    <h5 class="card-title mb-0">Latest RFQ</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-nowrap mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-top-0">Reference</th>
                                                    <th class="border-top-0">Order Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="rfq_limited" t-as="rfq">
                                                    <tr>
                                                        <td><a t-attf-href="/my/purchase/#{rfq.id}" class="text-decoration-none fw-bold"><t t-esc="rfq.name"/></a></td>
                                                        <td><span class="text-muted"><t t-esc="rfq.date_order" t-options='{"widget": "date"}'/></span></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                         <div class="col-12 col-lg-6 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom-0 pt-3">
                                    <h5 class="card-title mb-0">Latest Purchase Orders</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-nowrap mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-top-0">Reference</th>
                                                    <th class="border-top-0">Order Date</th>
                                                    <th class="border-top-0 text-end">State</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="purchase_orders_limited" t-as="purchase_order">
                                                    <tr>
                                                        <td><a t-attf-href="/my/purchase/#{purchase_order.id}" class="text-decoration-none fw-bold"><t t-esc="purchase_order.name"/></a></td>
                                                        <td><span class="text-muted"><t t-esc="purchase_order.date_approve" t-options='{"widget": "date"}'/></span></td>
                                                        <td class="text-end"><span class="badge bg-light text-dark border"><t t-esc="purchase_order.state"/></span></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                 <!-- Purchase Chart -->
                <div class="row mb-5 justify-content-center">
                   <div class="col-12 col-md-8 col-lg-6">
                        <div class="card shadow-sm border-0">
                             <div class="card-header bg-transparent border-bottom-0 text-center">
                                <h5 class="card-title mb-0">Purchase Overview</h5>
                            </div>
                            <div class="card-body">
                                <canvas id="purchase_pie" style="max-height: 300px;"/>
                            </div>
                        </div>
                   </div>
                </div>

                <!-- Recent Accounting Activity -->
                <t t-if="show_account">
                    <div class="row mb-5">
                       <div class="col-12">
                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-transparent border-bottom-0 pt-3">
                                    <h5 class="card-title mb-0">Latest Invoices</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-nowrap mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-top-0">Invoice #</th>
                                                    <th class="border-top-0">Invoice Date</th>
                                                    <th class="border-top-0">Due Date</th>
                                                    <th class="border-top-0">Status</th>
                                                    <th class="border-top-0 text-end">Amount Due</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="invoices_limited" t-as="invoice">
                                                    <tr>
                                                        <td><a t-attf-href="/my/invoices/#{invoice.id}" class="text-decoration-none fw-bold"><t t-esc="invoice.name"/></a></td>
                                                        <td><span class="text-muted"><t t-esc="invoice.invoice_date" t-options='{"widget": "date"}'/></span></td>
                                                        <td><span class="text-muted"><t t-esc="invoice.invoice_date_due" t-options='{"widget": "date"}'/></span></td> <!-- Approximated due date -->
                                                        <td><span class="badge bg-light text-dark border"><t t-esc="invoice.state"/></span></td>
                                                        <td class="text-end fw-bold"><t t-esc="invoice.amount_residual" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                       </div>
                    </div>
                </t>

                <!-- Accounting Chart -->
                <div class="row mb-5 justify-content-center">
                   <div class="col-12 col-md-8 col-lg-6">
                        <div class="card shadow-sm border-0">
                             <div class="card-header bg-transparent border-bottom-0 text-center">
                                <h5 class="card-title mb-0">Accounting Overview</h5>
                            </div>
                            <div class="card-body">
                                <canvas id="account_pie" style="max-height: 300px;"/>
                            </div>
                        </div>
                   </div>
                </div>

                 <!-- Recent Projects Activity -->
                <t t-if="show_project">
                    <div class="row mb-5">
                        <div class="col-12 col-lg-6 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom-0 pt-3">
                                    <h5 class="card-title mb-0">Latest Projects</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-nowrap mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-top-0">Project</th>
                                                    <th class="border-top-0">Start Date</th>
                                                    <th class="border-top-0">Expiry Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="projects_limited" t-as="project">
                                                    <tr>
                                                        <td><a t-attf-href="/my/projects/#{project.id}" class="text-decoration-none fw-bold"><t t-esc="project.name"/></a></td>
                                                        <td><span class="text-muted"><t t-esc="project.date_start" t-options='{"widget": "date"}'/></span></td>
                                                        <td><span class="text-muted"><t t-esc="project.date" t-options='{"widget": "date"}'/></span></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                         <div class="col-12 col-lg-6 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom-0 pt-3">
                                    <h5 class="card-title mb-0">Latest Tasks</h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-nowrap mb-0 align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-top-0">Task</th>
                                                    <th class="border-top-0">Project</th>
                                                    <th class="border-top-0">Deadline</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="tasks_limited" t-as="task">
                                                    <tr>
                                                        <td><a t-attf-href="/my/task/#{task.id}" class="text-decoration-none fw-bold"><t t-esc="task.name"/></a></td>
                                                        <td><span class="text-muted"><t t-esc="task.project_id.name"/></span></td>
                                                        <td><span class="text-muted"><t t-esc="task.date_deadline" t-options='{"widget": "date"}'/></span></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

            </div>
        </t>
    </template>
</odoo>