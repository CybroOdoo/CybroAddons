<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Define the list view for hr.leave.lop model -->
    <record id="hr_leave_lop_view_list" model="ir.ui.view">
        <field name="name">hr.leave.lop.view.list </field>
        <field name="model">hr.leave.lop</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="leave_type"/>
                <field name="no_of_days" string="Min (Before/After)"
                       invisible="leave_type == 'between_holidays'"/>
                <field name="no_of_days_before"
                       invisible="leave_type != 'between_holidays'"/>
                <field name="no_of_days_after"
                       invisible="leave_type != 'between_holidays'"/>
                <field name="deduction_amount"/>
            </list>
        </field>
    </record>
    <!-- Define the search view for hr.leave.lop model -->
    <record id="hr_leave_lop_view_search" model="ir.ui.view">
        <field name="name">hr.leave.lop.view.search</field>
        <field name="model">hr.leave.lop</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="leave_type"/>
                <field name="deduction_amount"/>
            </search>
        </field>
    </record>
    <!-- Form View for Time Off LOP -->
    <record id="hr_leave_lop_view_form" model="ir.ui.view">
        <field name="name">hr.leave.lop.view.form</field>
        <field name="model">hr.leave.lop</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="leave_type"/>
                        <field name="no_of_days"
                               invisible="leave_type == 'between_holidays'"
                               required="leave_type != 'between_holidays'"/>
                        <field name="no_of_days_before"
                               invisible="leave_type != 'between_holidays'"
                               required="leave_type == 'between_holidays'"/>
                        <field name="no_of_days_after"
                               invisible="leave_type != 'between_holidays'"
                               required="leave_type == 'between_holidays'"/>
                        <field name="deduction_amount"/>
                    </group>
                </sheet>
            <chatter/>

            </form>
        </field>
    </record>
    <!-- Window Action for Time Off LOP -->
    <record id="hr_leave_lop_action" model="ir.actions.act_window">
        <field name="name">Time Off LOP</field>
        <field name="res_model">hr.leave.lop</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Menu Item for Time Off LOP -->
    <menuitem id="hr_leave_lop_menu_root" action="hr_leave_lop_action"
              parent="hr_holidays.menu_hr_holidays_configuration"
              name="Time Off LOP"/>
</odoo>
