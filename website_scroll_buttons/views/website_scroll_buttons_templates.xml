<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_scroll_buttons"
              inherit_id="website.layout"
              name="Website Scroll Bottom To Top" active="True">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <div class="o_scroll_buttons website_scroll_buttons d-print-none">
                <div class="scroll_icon_bottom">
                    <button type="button" class="scroll_to_bottom"
                            title="Scroll to bottom" aria-label="Scroll to bottom">
                        <i class="oi oi-fw" data-icon="keyboard_arrow_down"/>
                    </button>
                </div>
                <div class="scroll_icon">
                    <button type="button" class="scroll_to_top"
                            title="Scroll to top" aria-label="Scroll to top">
                        <i class="oi oi-fw" data-icon="keyboard_arrow_up"/>
                    </button>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
