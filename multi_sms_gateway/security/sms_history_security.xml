<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-Company access rule for SMS History -->
    <record id="sms_history_rule_company" model="ir.access">
        <field name="name">SMS History: Multi-company</field>
        <field name="model_id" ref="multi_sms_gateway.model_sms_history"/>
        <field name="group_id" ref="multi_sms_gateway.multi_sms_gateway_group_manager"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>