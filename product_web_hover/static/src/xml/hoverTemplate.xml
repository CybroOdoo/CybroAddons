<?xml version="1.0" encoding="UTF-8" ?>
<template id="product_detail_widget_templates" xml:space="preserve">

    <!-- ICON HOVER WIDGET -->
    <t t-name="product_web_hover.productDetail">
        <a
            t-on-mouseenter="onMouseEnter"
            t-on-mouseleave="onMouseLeave"
            class="fa fa-info-circle"
            style="cursor: pointer;"
        />
    </t>

    <!-- POPOVER CONTENT -->
    <t t-name="product_web_hover.productDetailPopover">
        <div style="background-color:#000; color:#fff; border:1px solid #ccc;
                    border-radius:5px; padding:15px; max-width:300px;">

            <table class="table table-borderless table-sm">
                <tr>
                    <td>

                        <!-- IMAGE -->
                        <img t-if="props.productDetails and props.productDetails.image_1920"
                             t-att-src="'data:image/png;base64,' + props.productDetails.image_1920"
                             style="width:60px;" class="img-fluid"/>

                        <br/><br/>

                        <!-- PRODUCT NAME -->
                        <span><b>Name:</b> <t t-esc="props.productDetails and props.productDetails.name"/></span><br/>

                        <!-- REFERENCE -->
                        <span><b>Reference:</b>
                            <t t-esc="props.productDetails and props.productDetails.default_code"/>
                        </span><br/>

                        <!-- CATEGORY -->
                        <span><b>Category:</b>
                            <t t-if="props.productDetails and props.productDetails.categ_id">
                                <t t-esc="props.productDetails.categ_id[1]"/>
                            </t>
                        </span><br/>

                        <!-- COST -->
                        <span><b>Cost:</b>
                            <t t-esc="props.productDetails and props.productDetails.standard_price"/>
                        </span><br/>

                        <!-- ORDER QUANTITY -->
                        <span><b>Quantity (Order):</b>
                            <t t-esc="props.record.data.product_uom_qty"/>
                        </span><br/>

                        <!-- PRICE -->
                        <span><b>Price:</b>
                            <t t-esc="props.record.data.price_unit"/>
                        </span><br/>

                        <!-- STOCK -->
                        <span><b>Available:</b>
                            <t t-esc="props.productDetails and props.productDetails.qty_available"/>
                        </span><br/>

                    </td>
                </tr>
            </table>

        </div>
    </t>

</template>
