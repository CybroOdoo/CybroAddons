<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Widget to display product details in a popover -->
    <record id="sale_order_view_form_product_web_hover" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.product.web.hover</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//column[@name='product_and_description']" position="before">
                <widget name="product_detail_popover_widget" width="24px"/>
            </xpath>
        </field>
    </record>
</odoo>
