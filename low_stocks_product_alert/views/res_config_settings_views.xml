<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Inherited the res.config setting to add the fields-->
    <record id="res_config_settings_view_form_low_stock" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.low.stocks.product.alert
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='product_attributes']" position="after">
                <setting id="low_stock_setting" string="Low Stock Alert" help="Minimum stock quantity to trigger low stock alert background color.">
                    <field name="is_low_stock_alert"/>
                    <div class="content-group" invisible="not is_low_stock_alert">
                        <div class="row mt16">
                            <label for="min_low_stock_alert" class="col-lg-4 o_light_label"/>
                            <field name="min_low_stock_alert" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
