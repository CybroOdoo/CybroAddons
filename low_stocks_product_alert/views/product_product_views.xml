<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Inherit product.product form view to add field-->
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.view.form.inherit.low.stocks.product.alert</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lst_price']" position="after">
                <field name="alert_tag"/>
            </xpath>
        </field>
    </record>

    <!--Inherit product.product tree view-->
    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.view.list.inherit.low.stocks.product.alert</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="alert_state" column_invisible="True"/>
            </xpath>
            <list position="attributes">
                <attribute name="decoration-danger">alert_state == True</attribute>
            </list>
        </field>
    </record>

    <!--Inherit product.product kanban view-->
    <record id="product_kanban_view" model="ir.ui.view">
        <field name="name">product.product.view.kanban.inherit.low.stocks.product.alert</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="alert_state"/>
                <field name="color_field"/>
            </xpath>
            <xpath expr="//t[@t-name='card']/main" position="attributes">
                <attribute name="t-att-style">record.alert_state.raw_value ? 'background-color: #fdc6c673 !important;' : ''</attribute>
                <attribute name="t-attf-class">{{ record.alert_state.raw_value ? 'low-stock-alert' : '' }}</attribute>
            </xpath>
            <xpath expr="//t[@t-name='card']/aside" position="attributes">
                <attribute name="t-att-style">record.alert_state.raw_value ? 'background-color: #fdc6c673 !important;' : ''</attribute>
                <attribute name="t-attf-class">{{ record.alert_state.raw_value ? 'low-stock-alert' : '' }}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
