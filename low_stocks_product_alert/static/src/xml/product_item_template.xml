<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Extension for point_of_sale.ProductCard template to display low stock alert badge only for products with stock below threshold -->
    <t t-name="low_stocks_product_alert.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//article" position="attributes">
            <attribute name="t-att-style">this.props.product &amp;&amp; this.displayStockAlert ? 'background-color: #fdc6c673 !important; --bs-btn-bg: #fdc6c673 !important;' : ''</attribute>
            <attribute name="t-att-class">{'low-stock-alert': this.props.product &amp;&amp; this.displayStockAlert}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product-content')]" position="inside">
            <span t-if="this.props.product &amp;&amp; this.displayStockAlert"
                t-out="this.productStockQty"
                class="product-stock-qty position-absolute top-0 start-0 m-1 px-2 rounded text-white fs-5 fw-bolder bg-danger"
                style="background-color: red !important; z-index: 10;"/>
        </xpath>
    </t>
</templates>

