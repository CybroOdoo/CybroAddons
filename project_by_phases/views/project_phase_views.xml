<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Action for model-->
    <record id="project_phase_action" model="ir.actions.act_window">
        <field name="name">Project Phases</field>
        <field name="res_model">project.phase</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <!--    Form view for the model project.phase-->
    <record id="project_phase_view_form" model="ir.ui.view">
        <field name="name">project.phase.view.form</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <form string="Project Phase">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="get_project_tasks" type="object"
                                class="oe_stat_button" icon="check" string="Tasks">
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="start_date"/>
                            <field name="responsible_user_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="end_date"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Internal Note">
                            <field name="internal_notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!--    Kanban view of model project.phase-->
    <record id="project_phase_view_kanban" model="ir.ui.view">
        <field name="name">project.phase.view.kanban</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="row mb4">
                                <div>
                                    <h3>
                                        <field name="name" class="me-3"/>
                                    </h3>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <div>
                                        <p>Project:
                                            <field name="project_id"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <button name="get_project_tasks" string="Tasks"
                                    type="object" class="btn btn-secondary btn-sm"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--    List view of the model project.phase-->
    <record id="project_phase_view_list" model="ir.ui.view">
        <field name="name">project.phase.view.list</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <list string="Project Phases">
                <field name="name"/>
                <field name="project_id"/>
                <field name="responsible_user_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <!--    Search view of the model project.phase-->
    <record id="project_phase_view_search" model="ir.ui.view">
        <field name="name">project.phase.view.search</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <search string="Search Project Phases">
                <field name="name" string="Phase"/>
                <field name="project_id"/>
                <field name="responsible_user_id"/>
                <group>
                    <filter string="Project" name="group_by_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Responsible User" name="group_by_responsible"
                            context="{'group_by': 'responsible_user_id'}"/>
                    <filter string="Company" name="group_by_company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--    Menu item for show it in project module-->
    <menuitem name="Project Phases"
              id="project_phases_main_menu"
              parent="project.menu_main_pm"/>
    <menuitem id="project_phase_menu_action"
              name="Project Phases"
              action="project_phase_action"
              parent="project_by_phases.project_phases_main_menu"/>
</odoo>
