<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Template for Video section-->
    <template id="video_section" name="Video Section">
        <section class="home_about o_colored_level">
            <div class="wrapper">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-12 s_col_no_bgcolor">
                            <div class="upshift-video-wrapper">
                                <div class="media_iframe_video o_editable_media"
                                     data-oe-expression="theme_upshift/static/src/img/video/dummy.mp4"
                                     data-src="theme_upshift/static/src/img/video/dummy.mp4">
                                    <div class="css_editable_mode_display">&amp;nbsp;</div>
                                    <div class="media_iframe_video_size">&amp;nbsp;</div>
                                    <iframe src="theme_upshift/static/src/img/video/dummy.mp4"
                                            frameborder="0"
                                            allowfullscreen="allowfullscreen"
                                            aria-label="Video"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-12">
                            <div class="about_right anime_video_right">
                                <img src="theme_upshift/static/src/img/icons/wave.svg"
                                     class="wave" alt="wave"/>
                                <h3>The core mission behind all our work
                                </h3>
                                <p>
                                    Lorem ipsum dolor sit amet, consectetur
                                    adipiscing elit, sed
                                    do eiusmod tempor incididunt ut labore
                                    et dolore magna
                                    aliqua minim veniam.
                                </p>
                                <div class="results">
                                    <div class="result_numbers">
                                        <h4>330+</h4>
                                        <p>Companies helped</p>
                                    </div>
                                    <div class="result_numbers">
                                        <h4>330+</h4>
                                        <p>Companies helped</p>
                                    </div>
                                </div>
                                <a href="#" class="btn btn-secondary">
                                    <span>Learn more</span>
                                    <i class="oi oi-arrow-right upshift-arrow-icon"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="video_section_snippet" inherit_id="website.snippets"
              priority="8">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_upshift.video_section" string="Video" group="section"
               t-thumbnail="/theme_upshift/static/description/images/icons/video-section.png"/>
        </xpath>
    </template>
</odoo>