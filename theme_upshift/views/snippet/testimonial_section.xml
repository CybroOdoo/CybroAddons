<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="testimonial_section" name="Testimonial Section">
        <section class="s_carousel_wrapper o_colored_level bg-black text-white" data-vcss="001" data-snippet="s_carousel" data-name="Carousel">
            <div id="testimonialCarousel" class="s_carousel s_carousel_default carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
                <!-- Indicators -->
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                </div>
                
                <!-- Content -->
                <div class="carousel-inner">
                    <!-- Slide 1 -->
                    <div class="carousel-item active" data-name="Slide">
                        <div class="container">
                            <div class="row content">
                                <div class="col-lg-12">
                                    <div class="testimonial-content text-center">
                                        <div class="s_image mb-4" data-name="Image">
                                            <img src="/theme_upshift/static/src/img/testimonial/test1.png" class="rounded-circle img-fluid" alt="Testimonial" style="width: 150px; height: 150px; object-fit: cover;"/>
                                        </div>
                                        <div class="s_text_block mb-4" data-name="Text">
                                            <p class="testimonial-text text-white">
                                                "Be genuine in your assessment, and provide constructive feedback to benefit both potential customers and the company providing the product or service."
                                            </p>
                                        </div>
                                        <div class="s_title mb-1" data-name="Title">
                                            <h5 class="testimonial-author text-white">Jacqueline Miller</h5>
                                        </div>
                                        <div class="s_text_block" data-name="Text">
                                            <p class="testimonial-position text-white">CEO of Eduport</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Slide 2 -->
                    <div class="carousel-item" data-name="Slide">
                        <div class="container">
                            <div class="row content">
                                <div class="col-lg-12">
                                    <div class="testimonial-content text-center">
                                        <div class="s_image mb-4" data-name="Image">
                                            <img src="/theme_upshift/static/src/img/testimonial/test1.png" class="rounded-circle img-fluid" alt="Testimonial" style="width: 150px; height: 150px; object-fit: cover;"/>
                                        </div>
                                        <div class="s_text_block mb-4" data-name="Text">
                                            <p class="testimonial-text text-white">
                                                "Our experience with this company has been outstanding. Their attention to detail and customer service is unparalleled in the industry."
                                            </p>
                                        </div>
                                        <div class="s_title mb-1" data-name="Title">
                                            <h5 class="testimonial-author text-white">Robert Johnson</h5>
                                        </div>
                                        <div class="s_text_block" data-name="Text">
                                            <p class="testimonial-position text-white">CTO of TechInnovate</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Controls -->
                <button class="carousel-control-prev o_not_editable" contenteditable="false" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev" aria-label="Previous" title="Previous">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next o_not_editable" contenteditable="false" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next" aria-label="Next" title="Next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </section>
    </template>

    <template id="testimonial_section_snippet" inherit_id="website.snippets" priority="8">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_upshift.testimonial_section" string="Testimonial" group="section" t-thumbnail="/theme_upshift/static/description/images/icons/tesimonail-section.png"/>
        </xpath>
    </template>
</odoo>