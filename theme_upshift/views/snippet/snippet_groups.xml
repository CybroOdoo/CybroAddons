<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="theme_upshift_snippet_groups" inherit_id="website.snippets" name="Coffee banner">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]"
               position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_upshift/static/description/images/icons/about-section.png" string="Banners" snippet-group="banner"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_upshift/static/description/images/icons/process-section.png" string="Sections" snippet-group="section"/>
            <t t-snippet="website.s_snippet_group"
               string="Others" t-thumbnail="/theme_upshift/static/description/images/icons/location.png" snippet-group="others"/>
        </xpath>
    </template>

</odoo>