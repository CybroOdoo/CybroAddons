<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Category -->
        <record id="module_category_login_restriction" model="ir.module.category">
            <field name="name">Login Restriction</field>
            <field name="description">Manage working hours based login restrictions for users.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Security Groups -->
        <record id="group_login_restriction_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_login_restriction"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">User can view their own login restriction configuration.</field>
        </record>

        <record id="group_login_restriction_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_login_restriction"/>
            <field name="implied_ids" eval="[(4, ref('group_login_restriction_user'))]"/>
            <field name="comment">Manager can create, edit and delete login restriction configurations for all users.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Record Rules for login.restriction.config -->

        <!-- Regular users can only read their own restriction config -->
        <record id="login_restriction_config_rule_user_own" model="ir.rule">
            <field name="name">Login Restriction Config: Read Own</field>
            <field name="model_id" ref="model_login_restriction_config"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Managers can read/write/create/delete all restriction configs -->
        <record id="login_restriction_config_rule_manager_all" model="ir.rule">
            <field name="name">Login Restriction Config: Manager All Access</field>
            <field name="model_id" ref="model_login_restriction_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('group_login_restriction_manager'))]"/>
        </record>
    </data>
</odoo>
