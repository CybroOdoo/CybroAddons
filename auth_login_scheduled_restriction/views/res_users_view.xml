<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Extend res.users form view to add login restrictions -->
        <record id="view_users_form_login_restriction" model="ir.ui.view">
            <field name="name">res.users.form.login.restriction</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form" />
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']" position="after">
                    <page string="Login Restrictions" name="login_restrictions">
                        <group>
                            <field name="login_restriction_id" nolabel="1">
                                <list>
                                    <field name="is_restricted" />
                                    <field name="allow_admin_bypass" />
                                </list>
                                <form string="Login Restriction">
                                    <group>
                                        <field name="is_restricted" />
                                        <field name="allow_admin_bypass" />
                                    </group>
                                    <separator string="Working Hours" />
                                    <group cols="4">
                                        <group string="Monday">
                                            <field name="monday_from" />
                                            <field name="monday_to" />
                                        </group>
                                        <group string="Tuesday">
                                            <field name="tuesday_from" />
                                            <field name="tuesday_to" />
                                        </group>
                                        <group string="Wednesday">
                                            <field name="wednesday_from" />
                                            <field name="wednesday_to" />
                                        </group>
                                        <group string="Thursday">
                                            <field name="thursday_from" />
                                            <field name="thursday_to" />
                                        </group>
                                        <group string="Friday">
                                            <field name="friday_from" />
                                            <field name="friday_to" />
                                        </group>
                                        <group string="Saturday">
                                            <field name="saturday_from" />
                                            <field name="saturday_to" />
                                        </group>
                                        <group string="Sunday">
                                            <field name="sunday_from" />
                                            <field name="sunday_to" />
                                        </group>
                                    </group>
                                    <field name="error_message" nolabel="1" />
                                </form>
                            </field>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
