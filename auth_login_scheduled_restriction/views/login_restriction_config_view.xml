<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Login Restriction Config Form View -->
        <record id="view_login_restriction_config_form" model="ir.ui.view">
            <field name="name">login.restriction.config.form</field>
            <field name="model">login.restriction.config</field>
            <field name="arch" type="xml">
                <form string="Login Restriction Configuration">
                    <sheet>
                        <group>
                            <group string="General Information">
                                <field name="user_id" />
                                <field name="is_restricted" />
                                <field name="allow_admin_bypass" />
                            </group>
                            <group string="Error Message">
                                <field name="error_message" nolabel="1" />
                            </group>
                        </group>
                        <separator string="Working Hours" />
                        <group>
                            <group string="Monday">
                                <field name="monday_from" />
                                <field name="monday_to" />
                            </group>
                            <group string="Tuesday">
                                <field name="tuesday_from" />
                                <field name="tuesday_to" />
                            </group>
                        </group>
                        <group>
                            <group string="Wednesday">
                                <field name="wednesday_from" />
                                <field name="wednesday_to" />
                            </group>
                            <group string="Thursday">
                                <field name="thursday_from" />
                                <field name="thursday_to" />
                            </group>
                        </group>
                        <group>
                            <group string="Friday">
                                <field name="friday_from" />
                                <field name="friday_to" />
                            </group>
                            <group string="Saturday">
                                <field name="saturday_from" />
                                <field name="saturday_to" />
                            </group>
                        </group>
                        <group>
                            <group string="Sunday">
                                <field name="sunday_from" />
                                <field name="sunday_to" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Login Restriction Config list View -->
        <record id="view_login_restriction_config_list" model="ir.ui.view">
            <field name="name">login.restriction.config.list</field>
            <field name="model">login.restriction.config</field>
            <field name="arch" type="xml">
                <list string="Login Restrictions">
                    <field name="user_id" />
                    <field name="is_restricted" />
                    <field name="allow_admin_bypass" />
                </list>
            </field>
        </record>
        <!-- Login Restriction Config Action -->
        <record id="action_login_restriction_config" model="ir.actions.act_window">
            <field name="name">Login Restrictions</field>
            <field name="res_model">login.restriction.config</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No login restrictions found. Create one to restrict user logins outside working hours.
                </p>
            </field>
        </record>
        <!-- Menu item for Login Restriction -->
        <menuitem
            id="menu_login_restriction_config"
            name="Login Restrictions"
            parent="base.menu_administration"
            action="action_login_restriction_config"
            sequence="50"
        />
    </data>
</odoo>
