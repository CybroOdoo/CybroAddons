<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="product_image_360" name="Product 360 view"
              inherit_id="website_sale.product">
        <xpath expr="//t[@t-call='website_sale.shop_product_images']"
               position="before">
            <t t-if="product.is_boolean">
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-primary view_360">
                        360° <i class="oi" data-icon="autorenew"/>
                    </button>
                    <button type="button" class="btn btn-primary d-none stop_view">
                        Stop
                    </button>
                </div>
                <div id="image_360" class="menu d-none">
                    <ul class="list list-unstyled m-0">
                        <t t-foreach="product.image_view_ids" t-as="webimg">
                            <li>
                                <img t-attf-src="/web/image/image.view/{{webimg.id}}/image_130/1024x1024"
                                     class="img img-fluid o_image_130"/>
                            </li>
                        </t>
                    </ul>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
