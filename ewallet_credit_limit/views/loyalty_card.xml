<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_card_view_form" model="ir.ui.view">
        <field name="name">loyalty.card.view.form.inherit.ewallet.credit.limit</field>
        <field name="model">loyalty.card</field>
        <field name="inherit_id" ref="loyalty.loyalty_card_view_form"/>
        <field name="arch" type="xml">
            <!-- Add fields to an existing group or position -->
            <xpath expr="//group/group" position="after">
                <group string="Limit Settings">
                    <field name="set_limit"/>
                    <field name="limit" invisible="set_limit == False"/>
                    <field name="balance_limit_amount" readonly="1" invisible="set_limit == False"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>