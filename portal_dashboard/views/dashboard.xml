<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="replace_dashboard_portal_view">
        <t t-call="portal.frontend_layout">
            <div class="portal_dashboard py-4 container">
                <!-- Metrics KPI Cards -->
                <div class="row g-3 mb-4 justify-content-center">
                    <!-- Quotations -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 portal_kpi_card">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <img src="/portal_dashboard/static/src/images/q1.png" alt="Quotations" class="kpi_icon"/>
                                <div class="text-end">
                                    <span class="text-muted small text-uppercase">Quotations</span>
                                    <h3 class="mb-0 fw-bold"><t t-out="count_quotation"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0 pb-3 text-center">
                                <a href="/my/quotes" class="btn btn-sm btn-outline-primary w-75">View</a>
                            </div>
                        </div>
                    </div>

                    <!-- RFQs -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 portal_kpi_card">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <img src="/portal_dashboard/static/src/images/rfq.png" alt="RFQs" class="kpi_icon"/>
                                <div class="text-end">
                                    <span class="text-muted small text-uppercase">RFQs</span>
                                    <h3 class="mb-0 fw-bold"><t t-out="count_rfq"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0 pb-3 text-center">
                                <a href="/my/rfq" class="btn btn-sm btn-outline-primary w-75">View</a>
                            </div>
                        </div>
                    </div>

                    <!-- Sales Orders -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 portal_kpi_card">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <img src="/portal_dashboard/static/src/images/so.png" alt="Sales Orders" class="kpi_icon"/>
                                <div class="text-end">
                                    <span class="text-muted small text-uppercase">Sales Orders</span>
                                    <h3 class="mb-0 fw-bold"><t t-out="count_so"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0 pb-3 text-center">
                                <a href="/my/orders" class="btn btn-sm btn-outline-primary w-75">View</a>
                            </div>
                        </div>
                    </div>

                    <!-- Purchase Orders -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 portal_kpi_card">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <img src="/portal_dashboard/static/src/images/po.png" alt="Purchase Orders" class="kpi_icon"/>
                                <div class="text-end">
                                    <span class="text-muted small text-uppercase">Purchase Orders</span>
                                    <h3 class="mb-0 fw-bold"><t t-out="count_po"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0 pb-3 text-center">
                                <a href="/my/purchase" class="btn btn-sm btn-outline-primary w-75">View</a>
                            </div>
                        </div>
                    </div>

                    <!-- Projects -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 portal_kpi_card">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <img src="/portal_dashboard/static/src/images/project.png" alt="Projects" class="kpi_icon"/>
                                <div class="text-end">
                                    <span class="text-muted small text-uppercase">Projects</span>
                                    <h3 class="mb-0 fw-bold"><t t-out="count_project"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0 pb-3 text-center">
                                <a href="/my/projects" class="btn btn-sm btn-outline-primary w-75">View</a>
                            </div>
                        </div>
                    </div>

                    <!-- Tasks -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 portal_kpi_card">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <img src="/portal_dashboard/static/src/images/task.png" alt="Tasks" class="kpi_icon"/>
                                <div class="text-end">
                                    <span class="text-muted small text-uppercase">Tasks</span>
                                    <h3 class="mb-0 fw-bold"><t t-out="count_task"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0 pb-3 text-center">
                                <a href="/my/tasks" class="btn btn-sm btn-outline-primary w-75">View</a>
                            </div>
                        </div>
                    </div>

                    <!-- Invoices -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 portal_kpi_card">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <img src="/portal_dashboard/static/src/images/inv.png" alt="Invoices" class="kpi_icon"/>
                                <div class="text-end">
                                    <span class="text-muted small text-uppercase">Invoices</span>
                                    <h3 class="mb-0 fw-bold"><t t-out="count_invoice"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0 pb-3 text-center">
                                <a href="/my/invoices?filterby=invoices" class="btn btn-sm btn-outline-primary w-75">View</a>
                            </div>
                        </div>
                    </div>

                    <!-- Vendor Bills -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 portal_kpi_card">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <img src="/portal_dashboard/static/src/images/bill.png" alt="Bills" class="kpi_icon"/>
                                <div class="text-end">
                                    <span class="text-muted small text-uppercase">Bills</span>
                                    <h3 class="mb-0 fw-bold"><t t-out="count_bill"/></h3>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0 pb-3 text-center">
                                <a href="/my/invoices?filterby=bills" class="btn btn-sm btn-outline-primary w-75">View</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Sales & Quotations Section -->
                <t t-if="show_so_q">
                    <div class="card shadow-sm border-0 mb-4 portal_section_card">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0 fw-semibold">Recent Sales Activity</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-primary fw-bold mb-3">Latest Quotations (<t t-out="number_so_portal"/>)</h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Order Number</th>
                                                    <th>Order Date</th>
                                                </tr>
                                            </thead>
                                            <tbody id="table_body_quotations">
                                                <t t-foreach="quotations_limited" t-as="quotation">
                                                    <tr>
                                                        <td class="fw-medium"><t t-out="quotation.name"/></td>
                                                        <td><t t-out="quotation.date_order"/></td>
                                                    </tr>
                                                </t>
                                                <tr t-if="not quotations_limited">
                                                    <td colspan="2" class="text-center text-muted py-3">No quotations available</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-primary fw-bold mb-3">Latest Sales Orders (<t t-out="number_so_portal"/>)</h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Order Number</th>
                                                    <th>Order Date</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody id="table_body_sale_orders">
                                                <t t-foreach="sale_orders_limited" t-as="sale_order">
                                                    <tr>
                                                        <td class="fw-medium"><t t-out="sale_order.name"/></td>
                                                        <td><t t-out="sale_order.date_order"/></td>
                                                        <td>
                                                            <span class="badge bg-info text-dark">
                                                                <t t-if="sale_order.state == 'sale'">Sales Order</t>
                                                                <t t-elif="sale_order.state == 'done'">Locked</t>
                                                                <t t-elif="sale_order.state == 'cancel'">Cancelled</t>
                                                                <t t-else=""><t t-out="sale_order.state.title()"/></t>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </t>
                                                <tr t-if="not sale_orders_limited">
                                                    <td colspan="3" class="text-center text-muted py-3">No sales orders available</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Sales Analysis Chart -->
                <div class="row justify-content-center mb-4" id="analysis_sales_container">
                    <div class="col-12 col-md-8 col-lg-6">
                        <div class="card shadow-sm border-0 portal_chart_card">
                            <div class="card-body p-4 text-center">
                                <div class="chart_canvas_wrapper">
                                    <canvas id="sales_pie"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Purchase & RFQs Section -->
                <t t-if="show_po_rfq">
                    <div class="card shadow-sm border-0 mb-4 portal_section_card">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0 fw-semibold">Recent Purchase Activity</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-primary fw-bold mb-3">Latest RFQs (<t t-out="number_po_portal"/>)</h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Reference</th>
                                                    <th>Order Date</th>
                                                </tr>
                                            </thead>
                                            <tbody id="table_body_rfqs">
                                                <t t-foreach="rfq_limited" t-as="rfq_item">
                                                    <tr>
                                                        <td class="fw-medium"><t t-out="rfq_item.name"/></td>
                                                        <td><t t-out="rfq_item.date_order"/></td>
                                                    </tr>
                                                </t>
                                                <tr t-if="not rfq_limited">
                                                    <td colspan="2" class="text-center text-muted py-3">No RFQs available</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-primary fw-bold mb-3">Latest Purchase Orders (<t t-out="number_po_portal"/>)</h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Reference</th>
                                                    <th>Order Date</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody id="table_body_purchase_orders">
                                                <t t-foreach="purchase_orders_limited" t-as="po_item">
                                                    <tr>
                                                        <td class="fw-medium"><t t-out="po_item.name"/></td>
                                                        <td><t t-out="po_item.date_approve or po_item.date_order"/></td>
                                                        <td>
                                                            <span class="badge bg-secondary">
                                                                <t t-if="po_item.state == 'purchase'">Purchase Order</t>
                                                                <t t-elif="po_item.state == 'done'">Locked</t>
                                                                <t t-elif="po_item.state == 'to approve'">To Approve</t>
                                                                <t t-elif="po_item.state == 'cancel'">Cancelled</t>
                                                                <t t-else=""><t t-out="po_item.state.title()"/></t>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </t>
                                                <tr t-if="not purchase_orders_limited">
                                                    <td colspan="3" class="text-center text-muted py-3">No purchase orders available</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Purchase Analysis Chart -->
                <div class="row justify-content-center mb-4" id="analysis_purchase_container">
                    <div class="col-12 col-md-8 col-lg-6">
                        <div class="card shadow-sm border-0 portal_chart_card">
                            <div class="card-body p-4 text-center">
                                <div class="chart_canvas_wrapper">
                                    <canvas id="purchase_pie"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Invoices & Bills Section -->
                <t t-if="show_account">
                    <div class="card shadow-sm border-0 mb-4 portal_section_card">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0 fw-semibold">Recent Accounting Activity</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-primary fw-bold mb-3">Latest Invoices (<t t-out="number_account_portal"/>)</h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Number</th>
                                                    <th>Invoice Date</th>
                                                    <th>Due Date</th>
                                                    <th>Status</th>
                                                    <th>Total</th>
                                                </tr>
                                            </thead>
                                            <tbody id="table_body_invoices">
                                                <t t-foreach="invoices_limited" t-as="invoice">
                                                    <tr>
                                                        <td class="fw-medium"><t t-out="invoice.name"/></td>
                                                        <td><t t-out="invoice.invoice_date"/></td>
                                                        <td><t t-out="invoice.invoice_date_due"/></td>
                                                        <td>
                                                            <span class="badge bg-success">
                                                                <t t-if="invoice.state == 'posted'">Posted</t>
                                                                <t t-elif="invoice.state == 'draft'">Draft</t>
                                                                <t t-elif="invoice.state == 'cancel'">Cancelled</t>
                                                                <t t-else=""><t t-out="invoice.state.title()"/></t>
                                                            </span>
                                                        </td>
                                                        <td class="fw-bold"><t t-out="invoice.amount_total_signed"/></td>
                                                    </tr>
                                                </t>
                                                <tr t-if="not invoices_limited">
                                                    <td colspan="5" class="text-center text-muted py-3">No invoices available</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-primary fw-bold mb-3">Latest Vendor Bills (<t t-out="number_account_portal"/>)</h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Number</th>
                                                    <th>Bill Date</th>
                                                    <th>Due Date</th>
                                                    <th>Status</th>
                                                    <th>Total</th>
                                                </tr>
                                            </thead>
                                            <tbody id="table_body_bills">
                                                <t t-foreach="bills_limited" t-as="bill_item">
                                                    <tr>
                                                        <td class="fw-medium"><t t-out="bill_item.name"/></td>
                                                        <td><t t-out="bill_item.invoice_date"/></td>
                                                        <td><t t-out="bill_item.invoice_date_due"/></td>
                                                        <td>
                                                            <span class="badge bg-warning text-dark">
                                                                <t t-if="bill_item.state == 'posted'">Posted</t>
                                                                <t t-elif="bill_item.state == 'draft'">Draft</t>
                                                                <t t-elif="bill_item.state == 'cancel'">Cancelled</t>
                                                                <t t-else=""><t t-out="bill_item.state.title()"/></t>
                                                            </span>
                                                        </td>
                                                        <td class="fw-bold"><t t-out="bill_item.amount_total_signed"/></td>
                                                    </tr>
                                                </t>
                                                <tr t-if="not bills_limited">
                                                    <td colspan="5" class="text-center text-muted py-3">No bills available</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Accounting Analysis Chart -->
                <div class="row justify-content-center mb-4" id="analysis_account_container">
                    <div class="col-12 col-md-8 col-lg-6">
                        <div class="card shadow-sm border-0 portal_chart_card">
                            <div class="card-body p-4 text-center">
                                <div class="chart_canvas_wrapper">
                                    <canvas id="account_pie"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Projects & Tasks Section -->
                <t t-if="show_project">
                    <div class="card shadow-sm border-0 mb-4 portal_section_card">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0 fw-semibold">Recent Projects &amp; Tasks</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-primary fw-bold mb-3">Latest Projects (<t t-out="number_project_portal"/>)</h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Project</th>
                                                    <th>Start Date</th>
                                                    <th>End Date</th>
                                                </tr>
                                            </thead>
                                            <tbody id="table_body_projects">
                                                <t t-foreach="projects_limited" t-as="project_item">
                                                    <tr>
                                                        <td class="fw-medium"><t t-out="project_item.name"/></td>
                                                        <td><t t-out="project_item.date_start"/></td>
                                                        <td><t t-out="project_item.date"/></td>
                                                    </tr>
                                                </t>
                                                <tr t-if="not projects_limited">
                                                    <td colspan="3" class="text-center text-muted py-3">No projects available</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <h6 class="text-primary fw-bold mb-3">Latest Tasks (<t t-out="number_project_portal"/>)</h6>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Task</th>
                                                    <th>Project</th>
                                                    <th>Deadline</th>
                                                </tr>
                                            </thead>
                                            <tbody id="table_body_tasks">
                                                <t t-foreach="tasks_limited" t-as="task_item">
                                                    <tr>
                                                        <td class="fw-medium"><t t-out="task_item.name"/></td>
                                                        <td><t t-out="task_item.project_id.name"/></td>
                                                        <td><t t-out="task_item.date_deadline"/></td>
                                                    </tr>
                                                </t>
                                                <tr t-if="not tasks_limited">
                                                    <td colspan="3" class="text-center text-muted py-3">No tasks available</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
