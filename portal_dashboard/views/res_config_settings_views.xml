<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.portal.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="after">
                <block title="Portal Dashboard" id="portal_dashboard_settings">
                    <setting id="setting_portal_so_q"
                             string="Quotations &amp; Sales Orders"
                             help="Display recent quotations and sales orders in the customer portal dashboard.">
                        <field name="is_show_recent_so_q"/>
                        <div class="content-group mt-2" invisible="not is_show_recent_so_q">
                            <div class="row">
                                <label for="sale_count" class="col-lg-5 o_light_label" string="Max Records to Show"/>
                                <field name="sale_count" class="col-lg-3"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="setting_portal_po_rfq"
                             string="RFQs &amp; Purchase Orders"
                             help="Display recent RFQs and purchase orders in the customer portal dashboard.">
                        <field name="is_show_recent_po_rfq"/>
                        <div class="content-group mt-2" invisible="not is_show_recent_po_rfq">
                            <div class="row">
                                <label for="purchase_count" class="col-lg-5 o_light_label" string="Max Records to Show"/>
                                <field name="purchase_count" class="col-lg-3"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="setting_portal_project_task"
                             string="Projects &amp; Tasks"
                             help="Display recent projects and tasks in the customer portal dashboard.">
                        <field name="is_show_project"/>
                        <div class="content-group mt-2" invisible="not is_show_project">
                            <div class="row">
                                <label for="project_count" class="col-lg-5 o_light_label" string="Max Records to Show"/>
                                <field name="project_count" class="col-lg-3"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="setting_portal_invoice_bill"
                             string="Invoices &amp; Bills"
                             help="Display recent customer invoices and vendor bills in the customer portal dashboard.">
                        <field name="is_show_recent_invoice_bill"/>
                        <div class="content-group mt-2" invisible="not is_show_recent_invoice_bill">
                            <div class="row">
                                <label for="account_count" class="col-lg-5 o_light_label" string="Max Records to Show"/>
                                <field name="account_count" class="col-lg-3"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
