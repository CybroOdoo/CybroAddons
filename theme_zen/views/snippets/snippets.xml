<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="theme_zen_snippets" inherit_id="website.snippets"
              name="Theme Zen snippets">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]"
               position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/about-1.png" string="Index About" snippet-group="index_about"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/banner_section-1.png" string="Banner" snippet-group="banner"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/blog-1.png" string="Zen Blog" snippet-group="zen_blog"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/client-1.png" string="Zen Client" snippet-group="zen_client"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/recent-1.png" string="Zen Recent" snippet-group="zen_recent"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/testimonial-1.png" string="Zen Members" snippet-group="zen_members"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/Video.png" string="Zen Video" snippet-group="zen_video"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]"
               position="after">

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/about-1.png" string="Headings" snippet-group="headings"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/blog-1.png" string="Blog Banner" snippet-group="blog_banner"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/Portfolio.png" string="Portfolio Banner" snippet-group="portfolio_banner"/>

            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_zen/static/src/img/snippets/service_page.png" string="Heading" snippet-group="heading"/>
        </xpath>

        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_zen.index_about" string="Index About" group="index_about" t-thumbnail="/theme_zen/static/src/img/snippets/about-1.png"/>
            <t t-snippet="theme_zen.banner" string="Banner" group="banner" t-thumbnail="/theme_zen/static/src/img/snippets/banner_section-1.png"/>
            <t t-snippet="theme_zen.zen_blog" string="Zen Blog" group="zen_blog" t-thumbnail="/theme_zen/static/src/img/snippets/blog-1.png"/>
            <t t-snippet="theme_zen.zen_client" string="Zen Client" group="zen_client" t-thumbnail="/theme_zen/static/src/img/snippets/client-1.png"/>
            <t t-snippet="theme_zen.zen_recent" string="Zen Recent" group="zen_recent" t-thumbnail="/theme_zen/static/src/img/snippets/recent-1.png"/>
            <t t-snippet="theme_zen.zen_members" string="Zen Members" group="zen_members" t-thumbnail="/theme_zen/static/src/img/snippets/testimonial-1.png"/>
            <t t-snippet="theme_zen.zen_video" string="Zen Video" group="zen_video" t-thumbnail="/theme_zen/static/src/img/snippets/Video.png"/>
            <t t-snippet="theme_zen.headings" string="Headings" group="headings" t-thumbnail="/theme_zen/static/src/img/snippets/about-1.png"/>
            <t t-snippet="theme_zen.blog_banner" string="Blog Banner" group="blog_banner" t-thumbnail="/theme_zen/static/src/img/snippets/blog-1.png"/>
            <t t-snippet="theme_zen.portfolio_banner" string="Portfolio Banner" group="portfolio_banner" t-thumbnail="/theme_zen/static/src/img/snippets/Portfolio.png"/>
            <t t-snippet="theme_zen.services_headings" string="Heading" group="heading" t-thumbnail="/theme_zen/static/src/img/snippets/service_page.png"/>
        </xpath>
    </template>
</odoo>