<?xml version="1.0" encoding="UTF-8"?>
<!--Introducing a new button named Schedule Mail in chatter-->
<templates id="template" xml:space="preserve">
    <t name="schedule_mail_to_send.Chatter"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension">
       <xpath expr="//button[hasclass('o-mail-Chatter-activity')]"
              position="after">
             <button class="o-mail-Chatter-ScheduleActivity btn btn-secondary text-nowrap my-2 ms-1"
                     type="button"
                     t-on-click="this.onClickScheduleMail"
                     data-hotkey="shift+m">
                    <i class="fa fa-envelope-o"/>
                    <span> Schedule Mail</span>
             </button>
        </xpath>
    </t>
</templates>
