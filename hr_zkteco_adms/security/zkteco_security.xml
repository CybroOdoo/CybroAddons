<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Multi-company access rule for ZKTeco devices.
        Allows users to access devices belonging to their enabled companies
        or devices that are not assigned to any company.
    -->

    <record id="zkteco_device_rule_multi_company" model="ir.rule">
        <field name="name">ZKTeco Device: multi-company</field>
        <field name="model_id" ref="model_zkteco_device"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!--
        Multi-company access rule for ZKTeco attendance punch logs.
        Allows access to logs belonging to the user's enabled companies
        or logs without a company assignment.
    -->

    <record id="zkteco_attendance_log_rule_multi_company" model="ir.rule">
        <field name="name">ZKTeco Punch Log: multi-company</field>
        <field name="model_id" ref="model_zkteco_attendance_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!--
        Multi-company access rule for ZKTeco device users.
        Restricts device users to the user's enabled companies or
        company-independent records.
    -->

    <record id="zkteco_device_user_rule_multi_company" model="ir.rule">
        <field name="name">ZKTeco Device User: multi-company</field>
        <field name="model_id" ref="model_zkteco_device_user"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!--
        Multi-company access rule for ZKTeco device commands.
        Allows users to access commands for their enabled companies or
        commands without a company assignment.
    -->

    <record id="zkteco_device_command_rule_multi_company" model="ir.rule">
        <field name="name">ZKTeco Device Command: multi-company</field>
        <field name="model_id" ref="model_zkteco_device_command"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!--
        Multi-company access rule for ZKTeco biometric data.
        Restricts biometric records to the user's enabled companies or
        records without a company assignment.
    -->

    <record id="zkteco_biometric_template_rule_multi_company" model="ir.rule">
        <field name="name">ZKTeco Biometric Data: multi-company</field>
        <field name="model_id" ref="model_zkteco_biometric_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!--
        Multi-company access rule for ZKTeco status codes.
        Allows users to access status codes belonging to their enabled
        companies or status codes without a company assignment.
    -->

    <record id="zkteco_status_code_rule_multi_company" model="ir.rule">
        <field name="name">ZKTeco Status Code: multi-company</field>
        <field name="model_id" ref="model_zkteco_status_code"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
