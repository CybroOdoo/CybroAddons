<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Status code list view -->
    <record id="zkteco_status_code_view_list" model="ir.ui.view">
        <field name="name">zkteco.status.code.view.list</field>
        <field name="model">zkteco.status.code</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="punch_type"/>
                <field name="color"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <!-- Status code form view -->
    <record id="zkteco_status_code_view_form" model="ir.ui.view">
        <field name="name">zkteco.status.code.view.form</field>
        <field name="model">zkteco.status.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="punch_type"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Status code action -->

    <record id="zkteco_status_code_action" model="ir.actions.act_window">
        <field name="name">Punch Status Codes</field>
        <field name="res_model">zkteco.status.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define what each device status code means
            </p>
            <p>
                ZKTeco firmwares disagree on what the numbers in a punch mean.
                Map each code to a check-in, a check-out, or let the device
                decide. A code with a company set overrides the shared one.
            </p>
        </field>
    </record>

</odoo>
