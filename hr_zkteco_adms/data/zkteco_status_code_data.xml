<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The codes stock ZKTeco firmwares emit in the status column of an
         ATTLOG line. Rows have no company, so they act as the fallback for
         every company; add a company-specific row to override one code. -->
    <data noupdate="1">

        <record id="zkteco_status_code_0" model="zkteco.status.code">
            <field name="sequence">10</field>
            <field name="code">0</field>
            <field name="name">Check In</field>
            <field name="punch_type">in</field>
            <field name="color">success</field>
        </record>

        <record id="zkteco_status_code_1" model="zkteco.status.code">
            <field name="sequence">20</field>
            <field name="code">1</field>
            <field name="name">Check Out</field>
            <field name="punch_type">out</field>
            <field name="color">danger</field>
        </record>

        <record id="zkteco_status_code_2" model="zkteco.status.code">
            <field name="sequence">30</field>
            <field name="code">2</field>
            <field name="name">Break Out</field>
            <field name="punch_type">out</field>
            <field name="color">warning</field>
        </record>

        <record id="zkteco_status_code_3" model="zkteco.status.code">
            <field name="sequence">40</field>
            <field name="code">3</field>
            <field name="name">Break In</field>
            <field name="punch_type">in</field>
            <field name="color">info</field>
        </record>

        <record id="zkteco_status_code_4" model="zkteco.status.code">
            <field name="sequence">50</field>
            <field name="code">4</field>
            <field name="name">Overtime In</field>
            <field name="punch_type">in</field>
            <field name="color">info</field>
        </record>

        <record id="zkteco_status_code_5" model="zkteco.status.code">
            <field name="sequence">60</field>
            <field name="code">5</field>
            <field name="name">Overtime Out</field>
            <field name="punch_type">out</field>
            <field name="color">warning</field>
        </record>

        <record id="zkteco_status_code_255" model="zkteco.status.code">
            <field name="sequence">99</field>
            <field name="code">255</field>
            <field name="name">Device Decides</field>
            <field name="punch_type">auto</field>
            <field name="color">muted</field>
        </record>

    </data>
</odoo>
