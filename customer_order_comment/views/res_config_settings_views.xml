<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherits Settings form view to add new toggle setting for the feature -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.customer.order.comment</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="after">
                <block id="customer_order_comment_block" title="Customer Order Comment">
                    <setting id="comment_configuration" string="Customer Comment &amp; Rating" help="Allow customers to add comments and ratings on their orders.">
                        <field name="comment_configuration"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

