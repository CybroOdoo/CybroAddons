<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_weight_manual.ScaleScreenManual">
        <Dialog size="'md'" title="this.props.productName || 'Unnamed Product'">
            <t t-set-slot="header">
                <h4 class="modal-title text-break text-center w-100">
                    <t t-out="this.props.productName || 'Unnamed Product'"/>
                </h4>
                <button type="button" class="btn-close" aria-label="Close" t-on-click="this.props.close"/>
            </t>

            <div class="d-flex flex-column align-items-center px-4">
                <!-- Weight Input -->
                <div class="d-flex align-items-center mb-3 w-100">
                    <label class="fs-4 me-2">Weight:</label>
                    <input type="number"
                           step="any"
                           class="form-control text-end pos-manual-weight-input"
                           style="max-width: 120px;"
                           autofocus="autofocus"
                           t-att-value="this.state.weight ? this.state.weight : ''"
                           t-on-input="this.handleInputChange"
                           t-on-change="this.handleInputChange"/>
                    <span class="ms-2 fs-4" t-out="this.props.uomName"/>
                </div>

                <!-- Computed Price -->
                <div class="d-flex justify-content-between w-100 mb-3">
                    <div class="fs-5">
                         <t t-out="this.unitPriceString"/> / <t t-out="this.props.uomName"/>
                    </div>
                    <div class="fs-5 fw-bold text-primary">
                        <t t-out="this.computedPriceString"/>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-lg btn-primary d-flex justify-content-center align-items-center w-100" t-on-click="this.confirm">
                    Order
                    <i class="oi ms-2" data-icon="keyboard_double_arrow_right"/>
                </button>
            </t>
        </Dialog>
    </t>
</templates>
