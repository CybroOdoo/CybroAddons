<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited form view of res config settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.weight.manual</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_connected_devices_section']" position="inside">
                <setting id="is_allow_manual_weight_id"
                         help="Allow manual weight entry for products sold by weight.">
                    <field name="pos_is_allow_manual_weight"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
