<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Template for insurance report -->
    <data>
        <template id="insurance_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            <div>
                                <h2>Insurance Report</h2>
                                <table class="table table-condensed">
                                    <tr>
                                        <td><strong>Insurance Number:</strong></td>
                                        <td><t t-esc="doc.insurance_no or ''"/></td>
                                    </tr>
                                </table>

                                <h3>Policy Holder Details</h3>
                                <table class="table table-condensed">
                                    <tr>
                                        <td><strong>Policy Holder:</strong></td>
                                        <td><t t-esc="doc.policy_holder_id.name or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Email:</strong></td>
                                        <td><t t-esc="doc.email or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Phone:</strong></td>
                                        <td><t t-esc="doc.phone or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Gender:</strong></td>
                                        <td><t t-esc="doc.gender or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Date of Birth:</strong></td>
                                        <td><t t-esc="doc.dob or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Age:</strong></td>
                                        <td><t t-esc="doc.age or ''"/></td>
                                    </tr>
                                </table>

                                <h3>Policy Details</h3>
                                <table class="table table-condensed">
                                    <tr>
                                        <td><strong>Policy Category:</strong></td>
                                        <td><t t-esc="doc.policy_category_id.name or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Issue Date:</strong></td>
                                        <td><t t-esc="doc.issue_date or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Expiry Date:</strong></td>
                                        <td><t t-esc="doc.expiry_date or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Insurance Policy:</strong></td>
                                        <td><t t-esc="doc.insurance_policy_id.insurance_policy_id.name or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Policy Provider:</strong></td>
                                        <td><t t-esc="doc.policy_provider_id.name or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Payment Type:</strong></td>
                                        <td><t t-esc="doc.payment_type or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Policy Amount</strong></td>
                                        <td><t t-esc="doc.total_policy_amount or ''"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Manager:</strong></td>
                                        <td><t t-esc="doc.manager_id.name or ''"/></td>
                                    </tr>
                                </table>
                                <t t-if="doc.agent_required">
                                    <h3>Agent Details</h3>
                                    <table class="table table-condensed">
                                        <tr>
                                            <td><strong>Agent:</strong></td>
                                            <td><t t-esc="doc.agent_id.name or ''"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Phone:</strong></td>
                                            <td><t t-esc="doc.agent_phone or ''"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Commission Type:</strong></td>
                                            <td><t t-esc="doc.commission_type or ''"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Commission Amount</strong></td>
                                            <td><t t-esc="doc.fixed_amount or ''"/></td>
                                        </tr>
                                    </table>
                                </t>
                                <t t-if="doc.invoice_ids">
                                    <h3>Monthly Installment</h3>
                                    <table class="table table-condensed">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Installment Date</th>
                                                <th>Installment Amount</th>
                                                <th>Invoice</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="doc.invoice_ids" t-as="invoice">
                                                <tr>
                                                    <td>Installment</td>
                                                    <td><t t-esc="invoice.invoice_date or ''"/></td>
                                                    <td><t t-esc="invoice.amount_total or ''"/></td>
                                                    <td><t t-esc="invoice.name or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-if="doc.insurance_nominee_line_ids">
                                    <h3>Insurance Nominee</h3>
                                    <table class="table table-condensed">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Relation with Policy Holder</th>
                                                <th>Date of Birth</th>
                                                <th>Age</th>
                                                <th>Percentage</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="doc.insurance_nominee_line_ids" t-as="nominee">
                                                <tr>
                                                    <td><t t-esc="nominee.nominee_id.name or ''"/></td>
                                                    <td><t t-esc="nominee.relation_with_policy_holder_id or ''"/></td>
                                                    <td><t t-esc="nominee.dob or ''"/></td>
                                                    <td><t t-esc="nominee.age or ''"/></td>
                                                    <td><t t-esc="nominee.percentage or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-if="doc.policy_description">
                                    <h3>Policy Descriptions</h3>
                                    <div t-field="doc.policy_description"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
