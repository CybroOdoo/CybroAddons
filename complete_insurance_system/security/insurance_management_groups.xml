<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--  Created the category Dental Clinic to set the Groups  -->
    <record id="module_category_insurance_management" model="ir.module.category">
        <field name="name">Insurance Management</field>
        <field name="sequence">18</field>
    </record>
    <!--  Created the Groups as Own Documents Only and this groups will be only access their own datas  -->
    <record id="group_insurance_user" model="res.groups">
        <field name="name">User: Own Documents Only</field>
        <field name="category_id" ref="module_category_insurance_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">the user will have access to his own data in the insurance management.</field>
    </record>
    <!--  Created the Groups as OManager and this groups can we view all the datas  -->
    <record id="group_insurance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">the user will have an access to all the Insurance configuration.</field>
        <field name="category_id" ref="module_category_insurance_management"/>
        <field name="implied_ids" eval="[(4, ref('group_insurance_user'))]"/>
    </record>
</odoo>