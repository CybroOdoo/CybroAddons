<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View for Insurance Policy Categories -->
    <record id="view_insurance_policy_category_view_tree" model="ir.ui.view">
        <field name="name">insurance.policy.category.view.tree</field>
        <field name="model">insurance.policy.category</field>
        <field name="arch" type="xml">
            <tree string="Insurance Policy Categories" editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <!-- Search View for Insurance Policy Categories -->
    <record id="view_insurance_policy_category_view_search" model="ir.ui.view">
        <field name="name">insurance.policy.category.view.search</field>
        <field name="model">insurance.policy.category</field>
        <field name="arch" type="xml">
            <search string="Search Insurance Policy Categories">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>
    <!-- Action for Insurance Policy Category -->
    <record id="insurance_policy_category_action" model="ir.actions.act_window">
        <field name="name">Policy Categories</field>
        <field name="res_model">insurance.policy.category</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="configuration_menu"
              name="Configurations"
              parent="insurance_management_menu_root"
              sequence="6"
              groups="complete_insurance_system.group_insurance_manager"
    />
    <menuitem id="category_menu"
              name="Category"
              action="insurance_policy_category_action"
              parent="configuration_menu" sequence="1"
              groups="complete_insurance_system.group_insurance_manager"
    />
</odoo>
