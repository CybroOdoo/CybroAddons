<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View for Policy Sub Categories -->
    <record id="view_policy_sub_category_view_tree" model="ir.ui.view">
        <field name="name">policy.sub.category.view.tree</field>
        <field name="model">insurance.policy.sub.category</field>
        <field name="arch" type="xml">
            <tree string="Policy Sub Categories" editable="bottom">
                <field name="name"/>
                <field name="category_id"/>
            </tree>
        </field>
    </record>

    <!-- Search View for Policy Sub Categories -->
    <record id="view_policy_sub_category_view_search" model="ir.ui.view">
        <field name="name">policy.sub.category.view.search</field>
        <field name="model">insurance.policy.sub.category</field>
        <field name="arch" type="xml">
            <search string="Search Policy Sub Categories">
                <field name="category_id"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action for Policy Sub Categories -->
    <record id="policy_sub_category_action" model="ir.actions.act_window">
        <field name="name">Policy Sub Categories</field>
        <field name="res_model">insurance.policy.sub.category</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="sub_category_menu"
              name="Sub Category"
              action="policy_sub_category_action"
              parent="configuration_menu" sequence="2" groups="complete_insurance_system.group_insurance_manager"/>
</odoo>
