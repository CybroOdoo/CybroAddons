<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View for Insurance Policy -->
    <record id="insurance_policy_view_tree" model="ir.ui.view">
        <field name="name">insurance.policy.view.tree</field>
        <field name="model">insurance.policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="insurance_policy_id"/>
                <field name="policy_number"/>
                <field name="policy_category_id"/>
                <field name="insurance_amount"/>
                <field name="claim_amount"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Insurance Policy -->
    <record id="insurance_policy_view_form" model="ir.ui.view">
        <field name="name">insurance.policy.view.form</field>
        <field name="model">insurance.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="insurance_policy_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="INSURANCE POLICY">
                            <field name="policy_category_id"/>
                            <field name="policy_number"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="insurance_amount"/>
                            <field name="claim_amount"/>
                        </group>
                    </group>
                    <group string="Policy Document">
                        <group>
                            <field name="policy_document_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="claim_document_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Policy Description">
                            <field name="policy_description"/>
                        </page>
                        <page string="Terms and Conditions">
                            <field name="terms_condition"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Insurance Policy -->
    <record id="insurance_policy_view_search" model="ir.ui.view">
        <field name="name">insurance.policy.view.search</field>
        <field name="model">insurance.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="insurance_policy_id"/>
                <field name="policy_number"/>
                <field name="policy_category_id"/>
                <group expand="0" string="Group By">
                    <filter string="Policy Category" name="group_by_category" context="{'group_by': 'policy_category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action to display Insurance Policies -->
    <record id="insurance_policy_action" model="ir.actions.act_window">
        <field name="name">Insurance Policies</field>
        <field name="res_model">insurance.policy</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="insurance_policy_menu"
              name="Insurance Policy"
              action="insurance_policy_action"
              parent="configuration_menu" sequence="3" groups="complete_insurance_system.group_insurance_manager"/>
</odoo>
