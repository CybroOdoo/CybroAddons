<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit the res.partner form view -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add the 'agent' field after the 'vat' field -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="agent"/>
            </xpath>
            <!-- Add a new page 'Insurance Details' before the 'contact_addresses' page -->
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page string="Insurance Details" name="insurance_line_ids">
                    <field name="insurance_line_ids">
                        <tree>
                            <field name="insurance_id"/>
                            <field name="policy_holder_id"/>
                            <field name="policy_category_id"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="commission_bill_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
