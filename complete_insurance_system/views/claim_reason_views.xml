<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for claim reason -->
    <record id="claim_reason_view_tree" model="ir.ui.view">
        <field name="name">claim.reason.view.tree</field>
        <field name="model">claim.reason</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <!-- Fields displayed in the tree view -->
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <!-- Action for claim reason -->
    <record id="claim_reason_action" model="ir.actions.act_window">
        <field name="name">Claim Reason</field>
        <field name="res_model">claim.reason</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="claim_reason_menu"
              name="Claim Reason"
              action="claim_reason_action"
              parent="configuration_menu" sequence="6" groups="complete_insurance_system.group_insurance_manager"/>

</odoo>
