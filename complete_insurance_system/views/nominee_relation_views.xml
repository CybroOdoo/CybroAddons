<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for nominee relation -->
    <record id="nominee_relation_view_tree" model="ir.ui.view">
        <field name="name">nominee.relation.view.tree</field>
        <field name="model">nominee.relation</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <!-- Fields displayed in the tree view -->
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Action for nominee relation -->
    <record id="nominee_relation_action" model="ir.actions.act_window">
        <field name="name">Nominees Relation</field>
        <field name="res_model">nominee.relation</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="nominee_relation_menu"
              name="Nominees Relation"
              action="nominee_relation_action"
              parent="configuration_menu" sequence="7"/>

</odoo>
