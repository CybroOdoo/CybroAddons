<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for insured.document -->
    <record id="insured_document_view_tree" model="ir.ui.view">
        <field name="name">insured.document.view.tree</field>
        <field name="model">insured.document</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <!-- Fields displayed in the tree view -->
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <!-- Action for insured document -->
    <record id="insured_document_action" model="ir.actions.act_window">
        <field name="name">Insured Document</field>
        <field name="res_model">insured.document</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="document_details_menu"
              name="Document Details"
              parent="configuration_menu"
              sequence="5"
              groups="complete_insurance_system.group_insurance_manager"/>
    <menuitem id="insured_document_menu"
              name="Insured Document"
              action="insured_document_action"
              parent="document_details_menu" sequence="1" groups="complete_insurance_system.group_insurance_manager"/>

</odoo>
