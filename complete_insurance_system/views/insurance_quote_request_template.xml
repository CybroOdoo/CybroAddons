<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Insurance Quote Request Form -->
    <template id="insurance_quote_request_form" name="Insurance Quote Request">
        <t t-call="website.layout">
            <div class="container ins-main-body mt-4">
                <h2 class="text-center mb-4">Insurance Quote Request</h2>

                <!-- Form to submit insurance quote request -->
                <form action="/insurance/request/form/submit" method="post" class="o_mark_required" data-mark="*">
                    <!-- CSRF token for security -->
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <h4 class="mt-4">Personal Information</h4>
                    <div class="row">
                        <!-- Policy Holder selection -->
                        <div class="col-md-6 form-group">
                            <label for="name">Policy Holder</label>
                            <select name="holder" id="holder" class="form-control link-style">
                                <t t-foreach="policy_holder" t-as="holder">
                                    <option t-att-value="holder.id">
                                        <t t-esc="holder.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <!-- Email input -->
                        <div class="col-md-6 form-group">
                            <label for="email">Email *</label>
                            <input type="email" id="email" name="email" class="form-control bg-light" />
                        </div>
                    </div>

                    <div class="row">
                        <!-- Date of Birth input -->
                        <div class="col-md-4 form-group">
                            <label for="date_of_birth">Date of Birth *</label>
                            <input type="date" id="date_of_birth" name="date_of_birth" class="date-of-birth form-control bg-light" value="2012-05-02"/>
<!--                             onchange="calculateAge()"-->
                        </div>
                        <!-- Age input -->
                        <div class="col-md-2 form-group">
                            <label for="age">Age</label>
                            <input type="number" id="age" name="age" class="form-control bg-light" required="True"/>
                        </div>
                        <!-- Phone input -->
                        <div class="col-md-6 form-group">
                            <label for="phone">Phone *</label>
                            <input type="tel" id="phone" name="phone" class="form-control bg-light" value=""/>
                        </div>
                    </div>

                    <!-- Gender selection -->
                    <div class="form-group">
                        <label for="gender">Gender *</label>
                        <select id="gender" name="gender" class="form-control bg-light">
                            <option value="male" selected="selected">Male</option>
                            <option value="female">Female</option>
                        </select>
                    </div>

                    <h4 class="mt-4">Insurance Type</h4>

                    <!-- Policy Provider selection -->
                    <div class="form-group">
                        <label for="policy_provider">Policy Provider *</label>
                        <select name="provider" id="provider" class="form-control link-style">
                            <t t-foreach="policy_provider" t-as="provider">
                                <option t-att-value="provider.id">
                                    <t t-esc="provider.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <!-- Insurance Policy selection -->
                    <div class="form-group">
                        <label for="insurance_policy">Insurance Policy *</label>
                        <select name="policy" id="policy" class="form-control link-style">
                            <t t-foreach="insurance_policy" t-as="policy">
                                <option t-att-value="policy.id">
                                    <t t-esc="policy.insurance_policy_id.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <!-- Notes textarea -->
                    <div class="form-group">
                        <label for="notes">Notes</label>
                        <textarea id="notes" name="notes" class="form-control bg-light" rows="4">Insurance provides financial protection against unforeseen events such as accidents, natural disasters, illness, and death. By paying regular premiums, individuals or entities receive coverage that helps mitigate financial losses, ensuring peace of mind and stability. Whether it's health, life, auto, or home insurance, the goal is to manage risks and provide a safety net for policyholders and their beneficiaries.</textarea>
                    </div>

                    <!-- Terms and Conditions checkbox -->
                    <div class="form-group form-check mt-4">
                        <input type="checkbox" id="terms_conditions" name="terms_conditions" class="form-check-input"/>
                        <label class="form-check-label" for="terms_conditions">I agree to the Terms &amp; Conditions</label>
                    </div>

                    <!-- Submit button -->
                    <div class="text-right mt-4 mb-4">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>
