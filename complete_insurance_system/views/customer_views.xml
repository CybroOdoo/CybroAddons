<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="insurance_management_policy_holder_kanban_view" model="ir.actions.act_window">
        <field name="name">Policy Holder</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('agent', '=', False)]</field>
        <field name="context">{'default_agent': True,'create': True,
            'edit': True, 'delete': False}</field>
    </record>
    <record id="insurance_management_agent_kanban_view" model="ir.actions.act_window">
        <field name="name">Agent</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('agent', '=', True)]</field>
        <field name="context">{'default_agent': True,'create': True,
            'edit': True, 'delete': False}</field>
    </record>
    <menuitem id="customer_menu"
              name="Customer"
              parent="insurance_management_menu_root"
              sequence="4"
              groups="complete_insurance_system.group_insurance_manager,complete_insurance_system.group_insurance_user"/>
    <menuitem id="policy_holder_menu"
              name="Policy Holder"
              action="insurance_management_policy_holder_kanban_view"
              parent="customer_menu"
              sequence="1"
              groups="complete_insurance_system.group_insurance_manager,complete_insurance_system.group_insurance_user"/>
    <menuitem id="agent_menu"
              name="Agent"
              action="insurance_management_agent_kanban_view"
              parent="customer_menu"
              sequence="2"
              groups="complete_insurance_system.group_insurance_manager,complete_insurance_system.group_insurance_user"/>
</odoo>
