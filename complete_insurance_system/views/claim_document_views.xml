<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for claim document -->
    <record id="claim_document_view_tree" model="ir.ui.view">
        <field name="name">claim.document.view.tree</field>
        <field name="model">claim.document</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <!-- Fields displayed in the tree view -->
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <!-- Action for claim document -->
    <record id="claim_document_action" model="ir.actions.act_window">
        <field name="name">Claim Document</field>
        <field name="res_model">claim.document</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="claim_document_menu"
              name="Claim Document"
              action="claim_document_action"
              parent="document_details_menu" sequence="2" groups="complete_insurance_system.group_insurance_manager"/>

</odoo>
