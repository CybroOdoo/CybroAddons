<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="insurance_for_view_tree" model="ir.ui.view">
        <field name="name">insurance.for.view.tree</field>
        <field name="model">insurance.for</field>
        <field name="arch" type="xml">
            <tree string="Insurance For" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="insurance_for_view_search" model="ir.ui.view">
        <field name="name">insurance.for.view.search</field>
        <field name="model">insurance.for</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="insurance_for_action" model="ir.actions.act_window">
        <field name="name">Insurance For</field>
        <field name="res_model">insurance.for</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="buying_for_menu"
              name="Insurance For"
              action="insurance_for_action"
              parent="configuration_menu" sequence="4" groups="complete_insurance_system.group_insurance_manager"/>
</odoo>