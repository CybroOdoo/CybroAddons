<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Insurance IDs -->
        <record id="insurance_sequence_id" model="ir.sequence">
            <field name="name">Insurance Id</field>
            <field name="code">insurance.sequence</field>
            <field name="prefix">INS/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>

        <!-- Sequence for Claim IDs -->
        <record id="claim_sequence_id" model="ir.sequence">
            <field name="name">Claim Id</field>
            <field name="code">claim.sequence</field>
            <field name="prefix">CL/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
    </data>
</odoo>
