<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the oil project views. -->
    <record id="project_project_view_form_simplified_footer" model="ir.ui.view">
        <field name="name">project.project.kanabn.form.view.inherit.oil</field>
        <field name="model">project.project</field>
        <field name="inherit_id"
               ref="project.project_project_view_form_simplified_footer"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='alias_def']" position="after">
                <field name="is_oil_gas_project" invisible="1"/>

                <label for="warehouse_id" invisible="not is_oil_gas_project"/>

                <field name="warehouse_id"
                       invisible="not is_oil_gas_project"
                       required="is_oil_gas_project"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="edit_project_inherit_oil" model="ir.ui.view">
        <field name="name">project.project.form.inherit.oil</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[@name='action_view_tasks']"
                   position="replace">
                <button class="oe_stat_button" type="object" name="action_view_tasks"
                        icon="fa-check" invisible="is_oil_gas_project">
                    <div class="o_field_widget o_stat_info">
                        <field name="label_tasks" readonly="1"/>
                        <span class="o_stat_value">
                            <field name="closed_task_count"/>
                            /
                            <field name="task_count"/>
                            (<field name="task_completion_percentage"
                                    widget="percentage"
                                    options="{'digits': [1, 0]}"/>)
                        </span>
                    </div>
                </button>
                <button class="oe_stat_button" type="object" name="action_view_tasks"
                        icon="fa-check" invisible="not is_oil_gas_project">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Wells</span>
                        <span class="o_stat_value">
                            <field name="closed_task_count"/>/
                            <field name="task_count"/>
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[@name='button_box']/button[@name='project_update_all_action']"
                   position="replace">
                <button class="oe_stat_button" name="project_update_all_action"
                        type="object" groups="project.group_project_user"
                        context="{'active_id': id}"
                        invisible="is_template or is_oil_gas_project">
                    <field name="last_update_color" invisible="1"/>
                    <div class="o_stat_info">
                        <field name="update_count" invisible="1"/>
                        <field name="last_update_status" readonly="1"
                               widget="status_with_color"
                               status_label="Dashboard" hideStatusName="True"/>
                    </div>
                </button>
                <button class="oe_stat_button" name="project_update_all_action"
                        type="object" groups="project.group_project_user"
                        context="{'active_id': id}"
                        invisible="is_template or not is_oil_gas_project">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Dashboard</span>
                        <span class="o_stat_value">
                            <field name="update_count"/>
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_storage_locations" type="object"
                        class="oe_stat_button" icon="fa-list"
                        invisible="not is_oil_gas_project or not storage_location_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Products</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="storage_location_id"/>
                <field name="warehouse_id"
                       invisible="not is_oil_gas_project"
                       required="is_oil_gas_project"
                       options="{'no_create': True}"/>
                <field name="is_oil_gas_project"/>
                <field name="project_code" invisible="not is_oil_gas_project"/>
                <field name="operator_id" invisible="not is_oil_gas_project"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Oil &amp; Gas Details" name="oil_gas_details"
                      invisible="not is_oil_gas_project">
                    <group>
                        <group string="Location &amp; Block">
                            <field name="block_number"/>
                            <field name="country_id"/>
                            <field name="state_id"/>
                            <field name="field_name"/>
                        </group>
                        <group string="Reservoir &amp; Geology">
                            <field name="primary_fluid_type_id"/>
                            <field name="formation"/>
                        </group>
                    </group>
                    <group>
                        <group string="Commercial &amp; Contract">
                            <field name="license_number"/>
                            <field name="license_expiry"/>
                            <field name="working_interest"/>
                            <field name="net_revenue_interest"/>
                            <field name="contract_type"/>
                        </group>
                        <group string="Joint Venture Partners"
                               invisible="contract_type != 'jv'">
                            <field name="jv_partner_ids" nolabel="1"
                                   widget="many2many_tags"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="open_view_project_oil" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="path">project-oil</field>
        <field name="res_model">project.project</field>
        <field name="domain">[("is_template", "=", False), ("is_oil_gas_project", "=", True)]</field>
        <field name="context">{'display_milestone_deadline': True, 'default_is_oil_gas_project': True}</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="project.view_project_kanban"/>
        <field name="search_view_id" ref="project.view_project_project_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No projects found. Let's create one!
            </p>
            <p>
                Create projects to organize your tasks. Define a different workflow for each project.
            </p>
        </field>
    </record>

    <menuitem id="menu_oil_upstream_dashboard_project"
              name="Dashboard"
              parent="oil_erp_base.menu_oil_upstream_root"
              action="oil_erp_base.action_oil_dashboard_upstream"
              sequence="0"/>

    <menuitem id="menu_oil_project"
              name="Projects"
              parent="oil_erp_base.menu_oil_upstream_root"
              action="open_view_project_oil"
              sequence="10"/>
</odoo>
