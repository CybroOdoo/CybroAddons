<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- This file defines the project task type views. -->
    <record id="task_type_tree_inherited" model="ir.ui.view">
        <field name="name">project.task.type.list.inherit</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_tree_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="before">
                <field name="is_oil_gas_task_stage"/>
                <field name="is_production"/>
                <field name="is_closed"/>
            </xpath>
            <xpath expr="//field[@name='project_ids']" position="attributes">
                <attribute name="domain">[('is_oil_gas_project', '=', is_oil_gas_task_stage)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="task_type_edit" model="ir.ui.view">
        <field name="name">project.task.type.form.inherit</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <field name="is_oil_gas_task_stage"/>
                <field name="is_production"/>
                <field name="is_closed"/>
            </xpath>
            <xpath expr="//field[@name='project_ids']" position="attributes">
                <attribute name="domain">[('is_oil_gas_project', '=', is_oil_gas_task_stage)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="open_task_type_form_oil" model="ir.actions.act_window">
        <field name="name">Well Stages</field>
        <field name="res_model">project.task.type</field>
        <field name="path">well-stages-oil</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="project.task_type_tree_inherited"/>
        <field name="domain">[('user_id', '=', False), ('is_oil_gas_task_stage', '=', True)]</field>
        <field name="context">{'default_user_id': False, 'default_is_oil_gas_task_stage': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stages found. Let's create one!
            </p>
            <p>
                Define the steps your tasks move through from creation to completion.
            </p>
        </field>
    </record>

    <menuitem id="menu_oil_project_task_stages"
              name="Well Stages"
              parent="oil_erp_base.menu_oil_config_upstream"
              action="open_task_type_form_oil"
              sequence="10"/>
</odoo>