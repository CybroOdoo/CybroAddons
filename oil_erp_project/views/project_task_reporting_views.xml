<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pivot View for project.task (Wells) -->
    <record id="view_project_task_well_pivot" model="ir.ui.view">
        <field name="name">project.task.well.pivot</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pivot string="Well Status Distribution" display_quantity="1" sample="1">
                <field name="stage_id" type="row"/>
                <field name="well_type" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View for project.task (Wells) -->
    <record id="view_project_task_well_graph" model="ir.ui.view">
        <field name="name">project.task.well.graph</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <graph string="Well Status Distribution" type="pie" sample="1">
                <field name="stage_id"/>
            </graph>
        </field>
    </record>

    <!-- Action for Well Reporting -->
    <record id="action_well_reporting" model="ir.actions.act_window">
        <field name="name">Well Status Distribution</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('is_oil_gas_well', '=', True)]</field>
        <field name="context">{'search_default_oil_wells': 1, 'group_by': ['stage_id']}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_project_task_well_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_project_task_well_graph')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No wells found for reporting.
            </p>
            <p>
                Ensure your tasks are marked as "Is Oil and Gas Well".
            </p>
        </field>
    </record>

    <!-- Menu Item in Reporting > Upstream -->
    <menuitem id="menu_oil_reporting_upstream_wells"
              name="Well Status Distribution"
              parent="oil_erp_base.menu_oil_reporting_upstream"
              action="action_well_reporting"
              sequence="10"/>
</odoo>
