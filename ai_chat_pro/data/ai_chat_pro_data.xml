<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="config_parameter_model" model="ir.config_parameter">
        <field name="key">ai_chat_pro.model</field>
        <field name="value">~typesafe/jev-latest</field>
    </record>

    <record id="config_parameter_use_olg" model="ir.config_parameter">
        <field name="key">ai_chat_pro.use_olg</field>
        <field name="value">True</field>
    </record>

    <record id="config_parameter_chart_olg" model="ir.config_parameter">
        <field name="key">ai_chat_pro.chart_olg</field>
        <field name="value">True</field>
    </record>

    <record id="config_parameter_allow_create" model="ir.config_parameter">
        <field name="key">ai_chat_pro.allow_create</field>
        <field name="value">True</field>
    </record>

    <record id="config_parameter_deep_analysis" model="ir.config_parameter">
        <field name="key">ai_chat_pro.deep_analysis</field>
        <field name="value">True</field>
    </record>

    <record id="config_parameter_max_rows" model="ir.config_parameter">
        <field name="key">ai_chat_pro.max_rows</field>
        <field name="value">50</field>
    </record>

</odoo>
