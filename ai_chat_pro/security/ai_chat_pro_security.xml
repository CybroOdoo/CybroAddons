<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_ai_chat_pro" model="res.groups.privilege">
        <field name="name">AI Chat Pro</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_ai_chat_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">User: Can chat with the AI assistant about the data they can access.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_chat_pro"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ai_chat_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator: Can review every conversation and set up the assistant.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_chat_pro"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_chat_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- the configuration of the assistant is for the administrators of Odoo, who manage it -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ai_chat_manager'))]"/>
    </record>

    <!-- users only reach their own conversations; administrators read and delete them all -->
    <record id="ai_chat_conversation_rule_user" model="ir.rule">
        <field name="name">AI Chat Conversation: own conversations</field>
        <field name="model_id" ref="model_ai_chat_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chat_user'))]"/>
    </record>

    <record id="ai_chat_conversation_rule_manager" model="ir.rule">
        <field name="name">AI Chat Conversation: all conversations</field>
        <field name="model_id" ref="model_ai_chat_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chat_manager'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>

    <record id="ai_chat_message_rule_user" model="ir.rule">
        <field name="name">AI Chat Message: messages of own conversations</field>
        <field name="model_id" ref="model_ai_chat_message"/>
        <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chat_user'))]"/>
    </record>

    <record id="ai_chat_message_rule_manager" model="ir.rule">
        <field name="name">AI Chat Message: all messages</field>
        <field name="model_id" ref="model_ai_chat_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chat_manager'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>

    <record id="ai_chat_transcription_rule_user" model="ir.rule">
        <field name="name">AI Chat Transcription: own transcriptions</field>
        <field name="model_id" ref="model_ai_chat_transcription"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chat_user'))]"/>
    </record>

    <record id="ai_chat_transcription_rule_manager" model="ir.rule">
        <field name="name">AI Chat Transcription: all transcriptions</field>
        <field name="model_id" ref="model_ai_chat_transcription"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_chat_manager'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>

</odoo>
