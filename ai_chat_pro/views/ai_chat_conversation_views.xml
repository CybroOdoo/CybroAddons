<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_chat_action_client" model="ir.actions.client">
        <field name="name">AI Chat</field>
        <field name="tag">ai_chat_pro.chat</field>
    </record>

    <record id="ai_chat_conversation_view_list" model="ir.ui.view">
        <field name="name">ai.chat.conversation.view.list</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="message_count" string="Messages"/>
                <field name="prompt_tokens" optional="show"/>
                <field name="completion_tokens" optional="show"/>
                <field name="cost" optional="show"/>
                <field name="write_date" string="Last Activity"/>
            </list>
        </field>
    </record>

    <record id="ai_chat_conversation_view_form" model="ir.ui.view">
        <field name="name">ai.chat.conversation.view.form</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="write_date" string="Last Activity"/>
                        </group>
                        <group>
                            <field name="prompt_tokens"/>
                            <field name="completion_tokens"/>
                            <field name="cost"/>
                        </group>
                    </group>
                    <field name="message_ids">
                        <list>
                            <field name="create_date" string="Date"/>
                            <field name="role"/>
                            <field name="content"/>
                            <field name="source" optional="show"/>
                            <field name="decision_model" optional="show"/>
                            <field name="used_olg" optional="show"/>
                            <field name="text_model" optional="show"/>
                            <field name="prompt_tokens" optional="hide"/>
                            <field name="completion_tokens" optional="hide"/>
                            <field name="cost" optional="show"/>
                            <field name="is_error" optional="show"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_chat_conversation_view_search" model="ir.ui.view">
        <field name="name">ai.chat.conversation.view.search</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="my_conversations" string="My Conversations" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_chat_conversation_action" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">ai.chat.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No conversation yet</p>
            <p>The conversations of the users with the AI assistant are listed here, with the tokens they cost.</p>
        </field>
    </record>

</odoo>
