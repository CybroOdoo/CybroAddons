<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem
        id="ai_chat_pro_menu_root"
        name="AI Assistant"
        web_icon="ai_chat_pro,static/description/icon.svg"
        groups="group_ai_chat_user"
        sequence="240"/>

    <menuitem
        id="ai_chat_menu_chat"
        name="Chat"
        parent="ai_chat_pro_menu_root"
        action="ai_chat_action_client"
        sequence="10"/>

    <!-- administrators only; the "-" drops the group older versions gave it, as updates only add groups -->
    <menuitem
        id="ai_chat_menu_configuration"
        name="Configuration"
        parent="ai_chat_pro_menu_root"
        groups="-group_ai_chat_manager,base.group_system"
        sequence="90"/>

    <menuitem
        id="ai_chat_menu_settings"
        name="Settings"
        parent="ai_chat_menu_configuration"
        action="action_ai_chat_pro_settings"
        groups="base.group_system"
        sequence="10"/>

    <menuitem
        id="ai_chat_menu_conversations"
        name="Conversations"
        parent="ai_chat_menu_configuration"
        action="ai_chat_conversation_action"
        groups="base.group_system"
        sequence="20"/>

</odoo>
