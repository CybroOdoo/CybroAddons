<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- printed from the chat only: not bound to the Print menu of the messages -->
    <record id="action_report_ai_answer" model="ir.actions.report">
        <field name="name">AI Report</field>
        <field name="model">ai.chat.message</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ai_chat_pro.report_ai_answer</field>
        <field name="print_report_name">object._get_report_file_name()</field>
    </record>

    <template id="report_ai_answer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="report" t-value="reports[o.id]"/>
                <t t-call="web.external_layout">
                    <div class="page o_ai_chat_report">
                        <h2 class="mb-1" t-out="report['title']"/>
                        <p class="text-muted mb-4">
                            <t t-if="report['subtitle'] and report['subtitle'] != report['title']">
                                <t t-out="report['subtitle']"/> ·
                            </t>
                            Prepared for <t t-out="report['author']"/>
                            on <span t-out="report['date']" t-options="{'widget': 'datetime'}"/>
                        </p>

                        <div t-if="report['summary']['text']" class="mb-4">
                            <h5 class="text-uppercase small fw-bold text-muted mb-1">Summary</h5>
                            <p class="mb-2" t-out="report['summary']['text']"/>
                            <ul t-if="report['summary']['insights']" class="mb-0">
                                <li t-foreach="report['summary']['insights']" t-as="insight" t-out="insight"/>
                            </ul>
                        </div>

                        <p t-if="report['tags']" class="small mb-3">
                            <span class="text-muted">Filters:</span>
                            <t t-out="', '.join(report['tags'])"/>
                        </p>

                        <table t-if="report['figures']" class="table table-borderless mb-4">
                            <tr>
                                <td t-foreach="report['figures']" t-as="figure" class="border text-center p-3">
                                    <div class="small text-muted" t-out="figure['label']"/>
                                    <div class="fs-3 fw-bold" t-out="figure['value']"/>
                                </td>
                            </tr>
                        </table>

                        <div t-if="report['chart']" class="mb-4 text-center" style="page-break-inside: avoid;">
                            <img t-att-src="report['chart']" style="max-width: 100%; max-height: 380px;" alt="Chart"/>
                        </div>

                        <t t-if="report['rows'] and not report['figures']">
                            <h5 class="text-uppercase small fw-bold text-muted mb-1">Data</h5>
                            <table class="table table-sm o_main_table mb-1">
                                <thead>
                                    <tr>
                                        <th t-foreach="report['columns']" t-as="column"
                                            t-att-class="'text-end' if column.get('numeric') else 'text-start'"
                                            t-out="column['label']"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="report['rows']" t-as="row">
                                        <td t-foreach="row['cells']" t-as="cell"
                                            t-att-class="'text-end' if report['columns'][cell_index].get('numeric') else ''"
                                            t-out="cell"/>
                                    </tr>
                                </tbody>
                            </table>
                            <p t-if="report['total'] > len(report['rows'])" class="small text-muted">
                                <t t-out="len(report['rows'])"/> of <t t-out="report['total']"/> records shown.
                            </p>
                        </t>

                        <p class="small text-muted mt-4 mb-0">
                            Generated by AI Chat Pro from the records <t t-out="printed_by"/> can access.
                            The summary is written by AI from these figures: check them before relying on it.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
