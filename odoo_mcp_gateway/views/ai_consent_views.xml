<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_consent_view_tree" model="ir.ui.view">
        <field name="name">ai.consent.view.tree</field>
        <field name="model">ai.consent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'granted'" decoration-danger="state == 'denied'"/>
            </list>
        </field>
    </record>

    <record id="ai_consent_view_form" model="ir.ui.view">
        <field name="name">ai.consent.view.form</field>
        <field name="model">ai.consent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_grant" string="Grant Consent" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_deny" string="Deny Consent" type="object" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tool_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Request Details">
                        <field name="request_payload" widget="ace" options="{'language': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_consent_action" model="ir.actions.act_window">
        <field name="name">AI Tool Consents</field>
        <field name="res_model">ai.consent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
