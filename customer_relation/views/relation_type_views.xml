<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree (List) View -->
    <record id="relation_type_view_tree" model="ir.ui.view">
        <field name="name">relation.type.list</field>
        <field name="model">relation.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="category_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="relation_type_view_form" model="ir.ui.view">
        <field name="name">relation.type.form</field>
        <field name="model">relation.type</field>
        <field name="arch" type="xml">
            <form string="Relation Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="relation_type_action" model="ir.actions.act_window">
        <field name="name">Relation Types</field>
        <field name="res_model">relation.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_relation_type"
              name="Relation Types"
              parent="contacts.res_partner_menu_config"
              action="relation_type_action"
              sequence="4"/>
</odoo>
