<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree (List) View -->
    <record id="relation_type_category_view_tree" model="ir.ui.view">
        <field name="name">relation.type.category.view.tree</field>
        <field name="model">relation.type.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="relation_type_category_action" model="ir.actions.act_window">
        <field name="name">Relation Type Categories</field>
        <field name="res_model">relation.type.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_relation_type_category"
              name="Relation Type Categories"
              parent="contacts.res_partner_menu_config"
              action="relation_type_category_action"
              sequence="4"/>
</odoo>
