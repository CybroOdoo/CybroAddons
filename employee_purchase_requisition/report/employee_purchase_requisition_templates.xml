<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    purchase requisition report template-->
    <template id="report_purchase_requisition">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="rec">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="rec"/>
                    <div class="page"
                         style="font-family: 'Arial', sans-serif; font-size: 10pt; color: #333;">
                        <h3 style="color: #4CAF50; text-align: center; margin-bottom: 20px;">
                            Purchase Requisition: <span t-field="rec.name"/>
                        </h3>
                        <table style="width: 100%; margin-bottom: 20px; border-collapse: collapse;">
                            <tr>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Employee:</th>
                                <td style="padding: 8px;"><span t-field="rec.employee_id"/></td>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Requisition Date:</th>
                                <td style="padding: 8px;"><span t-field="rec.requisition_date"/></td>
                            </tr>
                            <tr>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Department:</th>
                                <td style="padding: 8px;"><span t-field="rec.dept_id"/></td>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Received Date:</th>
                                <td style="padding: 8px;"><span t-field="rec.receive_date"/></td>
                            </tr>
                            <tr>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Requisition Responsible:</th>
                                <td style="padding: 8px;"><span t-field="rec.user_id"/></td>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Requisition Deadline:</th>
                                <td style="padding: 8px;"><span t-field="rec.requisition_deadline"/></td>
                            </tr>
                        </table>
                        <h4 style="color: #4CAF50; margin-top: 20px; margin-bottom: 10px;">Other Information</h4>
                        <table style="width: 100%; margin-bottom: 20px; border-collapse: collapse;">
                            <tr>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Confirmed By:</th>
                                <td style="padding: 8px;"><span t-field="rec.confirm_id"/></td>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Confirmed Date:</th>
                                <td style="padding: 8px;"><span t-field="rec.confirmed_date"/></td>
                            </tr>
                            <tr>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Department Manager:</th>
                                <td style="padding: 8px;"><span t-field="rec.manager_id"/></td>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Department Approval Date:</th>
                                <td style="padding: 8px;"><span t-field="rec.department_approval_date"/></td>
                            </tr>
                            <tr>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Approved By:</th>
                                <td style="padding: 8px;"><span t-field="rec.requisition_head_id"/></td>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Approved Date:</th>
                                <td style="padding: 8px;"><span t-field="rec.approval_date"/></td>
                            </tr>
                            <tr>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Rejected By:</th>
                                <td style="padding: 8px;"><span t-field="rec.rejected_user_id"/></td>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Rejected Date:</th>
                                <td style="padding: 8px;"><span t-field="rec.reject_date"/></td>
                            </tr>
                        </table>
                        <h4 style="color: #4CAF50; margin-top: 20px; margin-bottom: 10px;">Picking Details</h4>
                        <table style="width: 100%; margin-bottom: 20px; border-collapse: collapse;">
                            <tr>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Source Location:</th>
                                <td style="padding: 8px;"><span t-field="rec.source_location_id"/></td>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Destination Location:</th>
                                <td style="padding: 8px;"><span t-field="rec.destination_location_id"/></td>
                            </tr>
                            <tr>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Delivery To:</th>
                                <td style="padding: 8px;"><span t-field="rec.delivery_type_id"/></td>
                                <th style="font-weight:bold;background-color: #f2f2f2; padding: 8px; text-align: left;">Internal Transfer:</th>
                                <td style="padding: 8px;"><span t-field="rec.internal_picking_id"/></td>
                            </tr>
                        </table>
                        <h4 style="color: #4CAF50; margin-top: 20px; margin-bottom: 10px;">Requisition Lines</h4>
                        <table style="width: 100%; margin-bottom: 20px; border-collapse: collapse; border: 1px solid #ddd;">
                            <thead style="background-color: #4CAF50; color: white;">
                                <tr>
                                    <th style="padding: 8px;">Requisition Action</th>
                                    <th style="padding: 8px;">Product</th>
                                    <th style="padding: 8px;">Description</th>
                                    <th style="padding: 8px;">Quantity</th>
                                    <th style="padding: 8px;">Unit Of Measure</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rec.requisition_order_ids" t-as="line">
                                    <td style="padding: 8px;"><span t-field="line.requisition_type"/></td>
                                    <td style="padding: 8px;"><span t-field="line.product_id"/></td>
                                    <td style="padding: 8px;"><span t-field="line.description"/></td>
                                    <td style="padding: 8px;"><span t-field="line.quantity"/></td>
                                    <td style="padding: 8px;"><span t-field="line.uom"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="margin-top: 30px;">
                            <h5 style="color: #333;">Employee Signature:</h5>
                            <h5 style="color: #333;">Manager Signature:</h5>
                            <h5 style="color: #333;">Approve Signature:</h5>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
