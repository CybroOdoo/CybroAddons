<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Action to print requisition report from purchase order-->
    <record id="action_print_requisition_from_purchase_order" model="ir.actions.server">
        <field name="name">Purchase Requisition</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">action = records.action_print_requisition_report()</field>
    </record>
    <!--purchase requisition report-->
    <record id="action_report_purchase_requisition" model="ir.actions.report">
        <field name="name">Material Purchase Requisition Report</field>
        <field name="model">employee.purchase.requisition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_purchase_requisition.report_purchase_requisition</field>
        <field name="binding_model_id" ref="model_employee_purchase_requisition"/>
        <field name="binding_type">report</field>
    </record>
</odoo>