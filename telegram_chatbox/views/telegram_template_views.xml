<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- tree view -->
    <record id="telegram_template_view_tree" model="ir.ui.view">
        <field name="name">telegram.template.view.tree</field>
        <field name="model">telegram.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!-- form view -->
    <record id="telegram_template_view_form" model="ir.ui.view">
        <field name="name">telegram.template.view.form</field>
        <field name="model">telegram.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                     <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" required="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="header_attachment_ids"
                                            widget="many2many_binary"/>
<!--                            <field name=""/>-->
                        </group>
                    </group>
                    <notebook>
                        <page id="message" name="Message">
                            <field name="message"
                                placeholder="Your whatsapp message, use {{customer_name}}, {{customer_order}} as placeholders for dynamic variable"/>
                        </page>
                        <page id="dynamic_variable" name="Dynamic Variables">
                            <field name="dynamic_variable_ids">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="name" readonly="1" force_save="1" placeholder="E.g. customer_name"/>
                                    <field name="model_id"/>
                                    <field name="field_id" domain="[('model_id', '=', model_id)]"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>