<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_telegram" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.telegram</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_telegram" string="Send via Telegram" class="btn-secondary" type="object" attrs="{'invisible': ['|', ('state', '!=', 'posted'), ('move_type', 'not in', ('out_invoice', 'out_refund'))]}"/>
            </xpath>
        </field>
    </record>
</odoo>
