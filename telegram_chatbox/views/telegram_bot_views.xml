<?xml version="1.0" encoding="utf-8"?>
<!--
    Views for configuring and managing Telegram Bots.
    Includes form view for token and webhook setup, and list view for status monitoring.
-->
<odoo>
    <!-- Telegram Bot Form View -->
    <record id="telegram_bot_view_form" model="ir.ui.view">
        <field name="name">telegram.bot.view.form</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <form string="Telegram Bot">
                <header>
                    <button type="object" name="action_set_webhook"
                            string="Set Webhook" class="btn-primary"
                            groups="telegram_chatbox.telegram_group_admin"/>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="text-break"
                                   options="{'line_breaks': False}"
                                   widget="text"
                                   placeholder="e.g. Telegram Bot"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="token"/>
                            <field name="webhook_url"/>
                            <field name="last_error_message" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_sync"/>
                            <field name="timeout"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Telegram Bot List View -->
    <record id="telegram_bot_view_list" model="ir.ui.view">
        <field name="name">telegram.bot.view.list</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="webhook_url"/>
                <field name="status"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>
</odoo>
