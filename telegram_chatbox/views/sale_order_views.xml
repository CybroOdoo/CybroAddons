<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_telegram_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.telegram.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_telegram" type="object" string="Send via Telegram" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
