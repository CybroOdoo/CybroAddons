<?xml version="1.0" encoding="utf-8"?>
<!--
    Menu architecture and action definitions for Telegram Chatbox.
    Configures top-level Telegram app menu, submenus, and action bindings.
-->
<odoo>
    <!-- Window Actions -->
    <record id="telegram_bot_action" model="ir.actions.act_window">
        <field name="name">Telegram Bots</field>
        <field name="res_model">telegram.bot</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="telegram_message_action" model="ir.actions.act_window">
        <field name="name">Telegram Messages</field>
        <field name="res_model">telegram.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="telegram_template_action" model="ir.actions.act_window">
        <field name="name">Telegram Message Templates</field>
        <field name="res_model">telegram.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Structure -->
    <menuitem id="telegram_menu_root" name="Telegram" sequence="70" groups="telegram_chatbox.telegram_group_user" web_icon="telegram_chatbox,static/description/icon.png"/>

    <menuitem id="telegram_templates_menu" name="Telegram Templates"
              parent="telegram_menu_root"
              action="telegram_chatbox.telegram_template_action" sequence="1" groups="telegram_chatbox.telegram_group_user"/>

    <menuitem id="telegram_messages_menu" name="Messages"
              parent="telegram_menu_root"
              action="telegram_chatbox.telegram_message_action" sequence="2" groups="telegram_chatbox.telegram_group_user"/>

    <menuitem id="telegram_configuration_menu" name="Configuration"
              parent="telegram_menu_root" sequence="3" groups="telegram_chatbox.telegram_group_admin"/>

    <menuitem id="menu_telegram_bots" name="Bots"
              parent="telegram_configuration_menu"
              action="telegram_chatbox.telegram_bot_action"/>
</odoo>
