<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_telegram" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.telegram</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_telegram" string="Send via Telegram" type="object" class="btn-secondary" invisible="state in ('cancel', 'done')"/>
            </xpath>
        </field>
    </record>
</odoo>
