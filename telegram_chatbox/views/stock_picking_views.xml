<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_telegram" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit.telegram</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_telegram" string="Send via Telegram" class="btn-secondary" type="object" invisible="state != 'done'"/>
            </xpath>
        </field>
    </record>
</odoo>
