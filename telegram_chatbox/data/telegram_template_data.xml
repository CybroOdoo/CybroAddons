<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="telegram_template_sale_order" model="telegram.template">
        <field name="name">Sale Order Confirmation</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="message">Hi {{customer_name}}, your order {{order_number}} for {{amount_total}} has been confirmed.</field>
        <field name="dynamic_variable_ids" eval="[
            (0, 0, {
                'name': 'customer_name',
                'model_id': ref('sale.model_sale_order'),
                'field_id': ref('sale.field_sale_order__partner_id')
            }),
            (0, 0, {
                'name': 'order_number',
                'model_id': ref('sale.model_sale_order'),
                'field_id': ref('sale.field_sale_order__name')
            }),
            (0, 0, {
                'name': 'amount_total',
                'model_id': ref('sale.model_sale_order'),
                'field_id': ref('sale.field_sale_order__amount_total')
            })
        ]"/>
    </record>

