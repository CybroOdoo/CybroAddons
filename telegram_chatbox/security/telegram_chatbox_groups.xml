<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="telegram_privilege_admin">
        <field name="name">Telegram</field>
        <field name="category_id" ref="telegram_chatbox.module_telegram_chatbox"/>
    </record>

    <record id="telegram_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="telegram_privilege_admin"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="telegram_group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="telegram_privilege_admin"/>
        <field name="implied_ids" eval="[Command.link(ref('telegram_group_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
