<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security rules for crop request -->
    <record id="rule_own_doc" model="ir.access">
        <field name="name">View Own Docs</field>
        <field name="model_id" ref="model_crop_request"/>
        <field name="group_id" ref="agriculture_management_odoo.group_agriculture_user"/>
        <field name="operation">cru</field>
        <field name="domain">['|', ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_all_doc" model="ir.access">
        <field name="name">View All Docs</field>
        <field name="model_id" ref="model_crop_request"/>
        <field name="group_id" ref="agriculture_management_odoo.group_agriculture_admin"/>
        <field name="operation">crud</field>
    </record>

    <!-- Multi-company rules -->
    <record id="crop_request_comp_rule" model="ir.access">
        <field name="name">Crop Request multi company rule</field>
        <field name="model_id" ref="model_crop_request"/>
        <field name="operation">crud</field>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

