<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <!-- Added eye button below leftpane to hide/show numpad -->
    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//Numpad" position="attributes">
            <attribute name="t-if">!this.state.isNumpadHidden and (!this.currentOrder?.isEmpty() and this.pos.getOrder()?.uiState.selected_orderline_uuid)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('leftpane')]" position="inside">
            <div class="d-flex justify-content-center align-items-center py-2 border-top bg-view">
                <button type="button"
                        class="btn btn-light border d-flex align-items-center justify-content-center px-4 py-1 pos-numpad-toggle-button"
                        t-on-click="() => this.toggleNumpad()"
                        title="Show/Hide Numpad"
                        aria-label="Toggle Numpad">
                    <i class="oi oi-fw fs-4"
                       t-att-data-icon="this.state.isNumpadHidden ? 'visibility_off' : 'visibility'"
                       role="img"
                       t-att-aria-label="this.state.isNumpadHidden ? 'Show Numpad' : 'Hide Numpad'"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
