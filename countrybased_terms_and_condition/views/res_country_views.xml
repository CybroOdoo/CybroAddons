<?xml version="1.0" encoding="utf-8"?>
<!--To add the field in the country for terms and conditions-->
<odoo>
    <record id="view_country_form" model="ir.ui.view">
        <field name="name">res.country.form.inherit.countrybased.terms.and.condition</field>
        <field name="model">res.country</field>
        <field name="inherit_id" ref="base.view_country_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="terms_and_conditions" string="Terms and Conditions">
                    <field name="sale_terms_condition" placeholder="Terms and conditions..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
