<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="dropbox_integration.DropboxDashboard">
        <section class="o_dropbox_dashboard o_dropbox_section">
            <img src="/dropbox_integration/static/src/img/dropbox_icon.png"
                 alt="Dropbox"
                 class="o_dropbox_logo"/>
            <input class="btn o_dropbox_upload_btn" type="button" value="Upload"
                   t-on-click="this.upload"/>
            <input type="search" class="o_dropbox_search_input"
                   placeholder="Search Files"
                   t-on-input="this.search_file"/>
            <div class="col row o_dropbox_files">
                <t t-foreach="this.filteredFiles" t-as="file" t-key="file.name">
                    <div class="col-sm-6 card o_dropbox_card text-center">
                        <a class="o_dropbox_text" t-att-href="file.url">
                            <img class="card-img-top o_dropbox_image mx-auto d-block"
                                 t-att-src="file.url"
                                 t-att-alt="file.name"
                                 t-on-error="this.onImageError"/>
                            <br/>
                            <br/>
                            <t t-out="file.name"/>
                        </a>
                    </div>
                </t>
            </div>
        </section>
    </t>
</templates>
