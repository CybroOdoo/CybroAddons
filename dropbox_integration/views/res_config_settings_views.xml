<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Setup Authentication view on settings    -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.dropbox.integration
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="dropbox_setting" string="Dropbox" help="Synchronize with Dropbox">
                    <field name="dropbox_button"/>
                    <div class="content-group" invisible="not dropbox_button">
                        <div class="mt16 row">
                            <label for="dropbox_client_id" class="col-lg-3 o_light_label" string="Client ID"/>
                            <field name="dropbox_client_id"/>
                        </div>
                        <div class="mt8 row">
                            <label for="dropbox_client_secret" class="col-lg-3 o_light_label" string="Client Secret"/>
                            <field name="dropbox_client_secret" password="True"/>
                        </div>
                        <div class="mt8">
                            <button name="action_get_dropbox_auth_code"
                                    type="object"
                                    string="Setup Access Token"
                                    class="btn-link"
                                    icon="fa-arrow-right"/>
                        </div>
                        <div class="mt8 row">
                            <label for="dropbox_folder_id" class="col-lg-3 o_light_label" string="Folder ID"/>
                            <field name="dropbox_folder_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
