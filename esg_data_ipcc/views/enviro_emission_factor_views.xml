<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add an IPCC filter to the emission factor search view -->
    <record id="enviro_emission_factor_ipcc_search" model="ir.ui.view">
        <field name="name">enviro.emission.factor.ipcc.search</field>
        <field name="model">enviro.emission.factor</field>
        <field name="inherit_id" ref="esg_emission_management.enviro_emission_factor_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='scope1']" position="before">
                <filter name="ipcc" string="IPCC Factors"
                        domain="[('code', '=like', 'EFDB-%')]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Extend emission factor form: IPCC tab -->
    <record id="enviro_emission_factor_ipcc_form" model="ir.ui.view">
        <field name="name">enviro.emission.factor.ipcc.form</field>
        <field name="model">enviro.emission.factor</field>
        <field name="inherit_id" ref="esg_emission_management.enviro_emission_factor_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="IPCC EFDB" invisible="not is_ipcc_factor">
                    <group>
                        <group string="Source">
                            <field name="source_id" readonly="1"/>
                            <field name="code" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
