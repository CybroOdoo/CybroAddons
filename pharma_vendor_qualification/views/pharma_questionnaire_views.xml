<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view for questionnaire templates. -->
    <record id="pharma_questionnaire_template_view_list" model="ir.ui.view">
        <field name="name">pharma.questionnaire.template.list</field>
        <field name="model">pharma.questionnaire.template</field>
        <field name="arch" type="xml">
            <list string="Questionnaire Templates">
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <!-- Form view for a questionnaire template. -->
    <record id="pharma_questionnaire_template_view_form" model="ir.ui.view">
        <field name="name">pharma.questionnaire.template.form</field>
        <field name="model">pharma.questionnaire.template</field>
        <field name="arch" type="xml">
            <form string="Questionnaire Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Standard GMP Questionnaire"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="questions" string="Questions">
                            <field name="question_ids">
                            </field>
                        </page>
                        <page name="description" string="Description">
                            <field name="description" placeholder="Template description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action opening questionnaire templates. -->
    <record id="pharma_questionnaire_template_action" model="ir.actions.act_window">
        <field name="name">Questionnaire Templates</field>
        <field name="res_model">pharma.questionnaire.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Questionnaire Template
            </p>
            <p>
                Templates are used to structure questions sent to vendors during qualification.
            </p>
        </field>
    </record>

</odoo>
