<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Limits BoM components to approved vendors. -->
    <record id="mrp_bom_form_pharma_avl" model="ir.ui.view">
        <field name="name">mrp.bom.form.pharma.avl</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="pharmaceutical_base.mrp_bom_form_pharma"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('tracking', '=', 'lot')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
