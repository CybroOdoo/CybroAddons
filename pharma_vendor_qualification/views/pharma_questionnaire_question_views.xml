<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Editable list view for questionnaire questions. -->
    <record id="pharma_questionnaire_question_view_list" model="ir.ui.view">
        <field name="name">pharma.questionnaire.question.list</field>
        <field name="model">pharma.questionnaire.question</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="section"/>
                <field name="question_text"/>
                <field name="answer_type"/>
            </list>
        </field>
    </record>
</odoo>
