<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view for vendor questionnaire answers. -->
    <record id="pharma_vendor_qualification_response_view_list" model="ir.ui.view">
        <field name="name">pharma.vendor.qualification.response.list</field>
        <field name="model">pharma.vendor.qualification.response</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="question_id" column_invisible="True"/>
                <field name="sequence" widget="handle"/>
                <field name="section" readonly="1" optional="show"/>
                <field name="question_text" readonly="1"/>
                <field name="answer_type" column_invisible="True"/>
                <field name="answer_yes_no" readonly="answer_type != 'yes_no'"
                       column_invisible="parent.template_id == False"/>
                <field name="answer_text" readonly="answer_type != 'text'"
                       column_invisible="parent.template_id == False"/>
                <field name="answer_number" readonly="answer_type != 'number'"
                       column_invisible="parent.template_id == False"/>
            </list>
        </field>
    </record>
</odoo>
