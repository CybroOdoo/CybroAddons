<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view of the qualification confirm wizard. -->
    <record id="pharma_vendor_qualification_confirm_wizard_view_form" model="ir.ui.view">
        <field name="name">pharma.vendor.qualification.confirm.wizard.form</field>
        <field name="model">pharma.vendor.qualification.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation Required">
                <field name="qualification_id" invisible="1"/>
                <div class="mb-3" role="alert">
                    <field name="message" readonly="1" nolabel="1" class="fw-bold"/>
                </div>
                <footer>
                    <button name="action_confirm_disqualify" string="Mark Not Qualified" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
