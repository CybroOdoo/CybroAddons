<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_payment_risk_ai" model="ir.ui.view">
        <field name="name">res.config.settings.payment.risk.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <div class="app_settings_block" data-string="Payment Risk AI"
                     string="Payment Risk AI" data-key="predict_late_payment">
                    <h2>
                        Payment Risk AI — Powered by Google Gemini
                    </h2>
                    <div class="row mt16 o_settings_container">
                        <p class="text-muted">
                            Uses <strong>Google Gemini</strong> to analyse customer
                            payment behaviour and generate risk scores, AI reasoning, and
                            follow-up emails.
                        </p>
                        <!-- Step 1: Get API Key -->
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <span class="badge rounded-circle text-bg-primary"
                                      style="width:28px;height:28px;font-size:1rem;
                                             display:inline-flex;align-items:center;
                                             justify-content:center;">1</span>
                            </div>
                            <div class="o_setting_right_pane">
                                <span string="Get Your Free Gemini API Key"/>
                                <div class="text-muted mb-2">
                                    Get a key from Google AI Studio.
                                </div>
                                <button name="action_get_gemini_key"
                                        type="object"
                                        string="Get Free API Key at aistudio.google.com"
                                        class="btn btn-outline-primary btn-sm"
                                        icon="fa-external-link"/>
                            </div>
                        </div>

                        <!-- Step 2: Paste Key -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <span class="badge rounded-circle text-bg-primary"
                                      style="width:28px;height:28px;font-size:1rem;
                                             display:inline-flex;align-items:center;
                                             justify-content:center;">2</span>
                            </div>
                            <div class="o_setting_right_pane">
                                <field name="gemini_api_key"
                                       password="True" placeholder="Paste API Key"/>
                                <div class="text-muted mt-1">
                                    Stored securely as a system parameter.
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Choose Model -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <span class="badge rounded-circle text-bg-primary"
                                      style="width:28px;height:28px;font-size:1rem;
                                             display:inline-flex;align-items:center;
                                             justify-content:center;">3</span>
                            </div>
                            <div class="o_setting_right_pane">
                                <span for="gemini_model" string="Choose Model"/>
                                <field name="gemini_model"/>
                                <div class="text-muted mt-1">
                                    Select a model.
                                </div>
                            </div>
                        </div>

                        <!-- Step 4: Test -->
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <span class="badge rounded-circle text-bg-primary"
                                      style="width:28px;height:28px;font-size:1rem;
                                             display:inline-flex;align-items:center;
                                             justify-content:center;">4</span>
                            </div>
                            <div class="o_setting_right_pane">
                                <span string="Test Connection"/>
                                <div class="text-muted mb-2">
                                    Save settings first, then test that Gemini is reachable.
                                </div>
                                <button name="action_test_gemini_connection"
                                        type="object"
                                        string="Test Gemini Connection"
                                        class="btn btn-primary"
                                        icon="fa-plug"/>
                            </div>
                        </div>

                        <!-- Free tier info box -->
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="p-3 rounded"
                                     style="background:#e8f0fe; border-left:4px solid #4285F4;">
                                    <p class="mb-1 fw-bold" style="color:#4285F4;">
                                        <i class="fa fa-info-circle me-1"/>
                                        Free Tier Limits (Gemini 2.5 Flash)
                                    </p>
                                    <p class="mb-1 text-muted">
                                        • <strong>250 requests/day</strong> free —
                                          enough for ~250 customers per daily cron run
                                    </p>
                                    <p class="mb-1 text-muted">
                                        • <strong>Paid rate:</strong> ~$0.30/1M input tokens
                                          — scoring 1,000 customers costs roughly $0.05
                                    </p>
                                    <p class="mb-0 text-muted">
                                        • <strong>Fallback:</strong> If quota is exceeded,
                                          the module automatically uses statistical scoring
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
