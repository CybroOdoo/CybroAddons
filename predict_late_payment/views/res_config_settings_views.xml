<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_payment_risk_ai" model="ir.ui.view">
        <field name="name">res.config.settings.payment.risk.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Payment Risk AI" string="Payment Risk AI" name="predict_late_payment">
                    <block title="Payment Risk AI — Powered by Google Gemini" id="payment_risk_ai">
                        <setting string="Gemini API Configuration" help="Uses Google Gemini to analyze customer payment behavior and generate risk scores, AI reasoning, and follow-up emails.">
                            <div class="content-group mt16">
                                <!-- Step 1: Get API Key -->
                                <div class="mb-3">
                                    <span class="badge rounded-circle text-bg-primary me-2" style="width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;">1</span>
                                    <strong>Get Your Free Gemini API Key</strong>
                                    <div class="text-muted small mb-1">Get a key from Google AI Studio.</div>
                                    <button name="action_get_gemini_key" type="object" string="Get Free API Key at aistudio.google.com" class="btn btn-outline-primary btn-sm" icon="east"/>
                                </div>

                                <!-- Step 2: Paste Key -->
                                <div class="mb-3">
                                    <span class="badge rounded-circle text-bg-primary me-2" style="width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;">2</span>
                                    <label for="gemini_api_key"/>
                                    <field name="gemini_api_key" password="True" placeholder="Paste API Key"/>
                                    <div class="text-muted small">Stored securely as a system parameter.</div>
                                </div>

                                <!-- Step 3: Choose Model -->
                                <div class="mb-3">
                                    <span class="badge rounded-circle text-bg-primary me-2" style="width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;">3</span>
                                    <label for="gemini_model"/>
                                    <field name="gemini_model"/>
                                </div>

                                <!-- Step 4: Test -->
                                <div class="mb-3">
                                    <span class="badge rounded-circle text-bg-primary me-2" style="width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;">4</span>
                                    <strong>Test Connection</strong>
                                    <div class="text-muted small mb-1">Save settings first, then test that Gemini is reachable.</div>
                                    <button name="action_test_gemini_connection" type="object" string="Test Gemini Connection" class="btn btn-primary" icon="extension"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
