<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scheduled action: recompute all risk scores nightly -->
    <record id="cron_compute_payment_risk_scores" model="ir.cron">
        <field name="name">Predict Late Payments: Recompute Risk Scores</field>
        <field name="model_id" ref="model_payment_risk_score"/>
        <field name="state">code</field>
        <field name="code">model.compute_all_partners()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
