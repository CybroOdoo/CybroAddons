<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_send_followup_wizard_form" model="ir.ui.view">
        <field name="name">send.followup.wizard.form</field>
        <field name="model">send.followup.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Follow-up Communication">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="subject"/>
                    <field name="send_email"/>
                    <field name="attach_statement"/>
                </group>
                <group string="Overdue Invoices" invisible="not overdue_invoices">
                    <field name="overdue_invoices" nolabel="1" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="invoice_date_due"/>
                            <field name="amount_residual_signed"/>
                            <field name="currency_id" invisible="1"/>
                        </list>
                    </field>
                </group>
                <group string="Message">
                    <field name="message" nolabel="1" widget="html" colspan="2"/>
                </group>
                <footer>
                    <button name="action_send" type="object"
                            string="Send" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
