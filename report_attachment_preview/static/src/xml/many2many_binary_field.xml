<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Open the attachments of binary fields in a new browser tab instead
    of downloading them.-->
    <t t-name="report_attachment_preview.Many2XBinary.attachment_preview"
       t-inherit="web.Many2XBinary.attachment_preview"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_image_box')]/a" position="attributes">
            <attribute name="target">_blank</attribute>
            <attribute name="download"/>
        </xpath>
        <xpath expr="//div[hasclass('caption')]/a" position="attributes">
            <attribute name="target">_blank</attribute>
            <attribute name="download"/>
        </xpath>
        <xpath expr="//div[hasclass('caption', 'small')]/a" position="attributes">
            <attribute name="target">_blank</attribute>
            <attribute name="download"/>
        </xpath>
    </t>
    <!-- Open the attachments of the mail composer in a new browser tab
    instead of the current one.-->
    <t t-name="report_attachment_preview.MailComposerAttachmentBinary"
       t-inherit="mail.MailComposerAttachmentBinary"
       t-inherit-mode="extension">
        <xpath expr="//li/a" position="attributes">
            <attribute name="target">_blank</attribute>
        </xpath>
    </t>
</templates>
