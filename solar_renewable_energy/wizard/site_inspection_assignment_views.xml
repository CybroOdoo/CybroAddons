<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Form view for Site Inspection Assignment-->
    <record id="site_inspection_assignment_view_form" model="ir.ui.view">
        <field name="name">site.inspection.assignment.view.form</field>
        <field name="model">site.inspection.assignment</field>
        <field name="arch" type="xml">
            <form string="Site Inspection">
                <sheet>
                    <group string="Survey Team Details">
                        <group>
                            <field name="survey_team_id"/>
                            <field name="survey_member_id"/>
                            <field name="service_type_id"/>
                        </group>
                        <group>
                            <field name="date_of_inspection"/>
                            <field name="lead_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_site_inspection" type="object" string="Create Site Inspection"
                            class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
