<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rule for site inspection -->
    <record id="solar_renewable_energy_site_inspection_rule" model="ir.rule">
        <field name="name">Solar Renewable Energy Site Inspection Rule</field>
        <field name="model_id" ref="model_site_inspection"/>
        <field name="domain_force">[('survey_team_member_id.member_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('solar_renewable_energy.group_energy_user'))]"/>
    </record>
</odoo>
