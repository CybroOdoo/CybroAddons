<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category for renewable energy management -->
    <record model="ir.module.category" id="module_category_renewable_energy">
        <field name="name">Renewable Energy Management</field>
        <field name="description">Category for renewable energy management</field>
        <field name="sequence">30</field>
    </record>
    <!-- Group: Manager -->
    <record id="group_energy_manager" model="res.groups">
        <field name="name">Energy Manager</field>
        <field name="category_id" ref="solar_renewable_energy.module_category_renewable_energy"/>
    </record>
    <!-- Group: Subcontractor -->
    <record id="group_energy_subcontractor" model="res.groups">
        <field name="name">Energy Subcontractor</field>
        <field name="category_id" ref="solar_renewable_energy.module_category_renewable_energy"/>
    </record>
    <!-- Group: User -->
    <record id="group_energy_user" model="res.groups">
        <field name="name">Energy User</field>
        <field name="category_id" ref="solar_renewable_energy.module_category_renewable_energy"/>
    </record>
</odoo>