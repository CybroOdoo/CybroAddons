<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Action to open contract demand-->
    <record id="renewable_contract_demands_action" model="ir.actions.act_window">
        <field name="name">Contract Demands</field>
        <field name="res_model">contract.demand</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!--Tree view for contract demand-->
    <record id="contract_demand_view_tree" model="ir.ui.view">
        <field name="name">contract.demand.view.tree</field>
        <field name="model">contract.demand</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
</odoo>