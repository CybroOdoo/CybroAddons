<odoo>
    <!-- Action for the Installation Team -->
    <record id="renewable_installation_team_action" model="ir.actions.act_window">
        <field name="name">Installation Team</field>
        <field name="res_model">installation.team</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!--   Form view for Installation Team -->
    <record id="installation_team_view_form" model="ir.ui.view">
        <field name="name">installation.team.view.form</field>
        <field name="model">installation.team</field>
        <field name="arch" type="xml">
            <form string="Installation Team">
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="project_manager_id"/>
                        <field name="company_id"/>
                    </group>
                </group>
                <notebook>
                    <page string="Team Members">
                        <field name="team_member_ids">
                            <tree editable="bottom">
                                <field name="member_id"/>
                                <field name="phone"/>
                                <field name="email"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>
    <!--    Tree view for Installation Team-->
    <record id="installation_team_view_tree" model="ir.ui.view">
        <field name="name">installation.team.view.tree</field>
        <field name="model">installation.team</field>
        <field name="arch" type="xml">
            <tree string="Installation Teams">
                <field name="name"/>
                <field name="project_manager_id"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>
</odoo>
