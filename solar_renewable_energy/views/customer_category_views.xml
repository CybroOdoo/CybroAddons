<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Action for Customer Category-->
    <record id="renewable_customer_category_action" model="ir.actions.act_window">
        <field name="name">Customer Category</field>
        <field name="res_model">customer.category</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!--    Tree view for Customer Category-->
    <record id="customer_category_view_tree" model="ir.ui.view">
        <field name="name">customer.category.view.tree</field>
        <field name="model">customer.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
</odoo>
