<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Dashboard action for Renewable Energy-->
    <record id="renewable_dashboard_action" model="ir.actions.client">
        <field name="name">Renewable Energy Dashboard</field>
        <field name="tag">renewable_energy_dashboard_tag</field>
    </record>

    <!-- Renewable Energy Root Menu -->
    <menuitem id="renewable_energy_root" name="Renewable Energy"
              web_icon="solar_renewable_energy,static/description/icon.png"/>

    <!-- Dashboard Menu -->
    <menuitem id="renewable_dashboard_menu" name="Dashboard" parent="renewable_energy_root"
              action="renewable_dashboard_action"
              sequence="0" groups="solar_renewable_energy.group_energy_manager"/>

    <!-- Leads Menu -->
    <menuitem id="renewable_leads_menu" name="Leads" parent="renewable_energy_root" sequence="1"
              groups="solar_renewable_energy.group_energy_manager"
    />

    <!-- Request Menu -->
    <menuitem id="renewable_request_menu" name="Request"
              parent="renewable_leads_menu" action="renewable_request_action"/>

    <!-- Pipeline Menu -->
    <menuitem id="renewable_pipeline_menu" name="Pipeline"
              parent="renewable_leads_menu" action="renewable_pipeline_action"/>

    <!-- Site Inspections Menu -->
    <menuitem id="renewable_site_inspections_menu" name="Site Inspections" sequence="2"
              parent="renewable_energy_root" action="renewable_site_inspections_action"
              groups="solar_renewable_energy.group_energy_manager,solar_renewable_energy.group_energy_user"/>

    <!-- REN Orders Menu -->
    <menuitem id="renewable_ren_orders_menu" name="REN Orders" parent="renewable_energy_root" sequence="3"
              action="renewable_ren_orders_action" groups="solar_renewable_energy.group_energy_manager"/>

    <!-- Sub Contractors Menu -->
    <menuitem id="renewable_sub_contractors_menu" name="Sub Contractor" parent="renewable_energy_root"
              action="renewable_sub_contractor_action" groups="solar_renewable_energy.group_energy_manager"
    />

    <!-- Subcontract Menu -->
    <menuitem id="renewable_subcontract_menu" name="Subcontract" parent="renewable_energy_root" sequence="5"
              groups="solar_renewable_energy.group_energy_manager,solar_renewable_energy.group_energy_subcontractor"/>

    <!-- Subcontract Installation Task Submenu -->
    <menuitem id="renewable_subcontract_installation_task_menu" name="Installation Task"
              parent="renewable_subcontract_menu"
              action="renewable_subcontract_installation_task_action"/>

    <!-- QA Task Submenu -->
    <menuitem id="renewable_subcontract_qa_task_menu" name="QA Task" parent="renewable_subcontract_menu"
              action="renewable_subcontract_qa_task_action"/>

    <!-- Customers Menu -->
    <menuitem id="renewable_customers_menu" name="Customers" parent="renewable_energy_root"
              action="renewable_customers_action" groups="solar_renewable_energy.group_energy_manager"/>

    <!-- Bill of Material Menu -->
    <menuitem id="renewable_bom_menu" name="Bill of Material" parent="renewable_energy_root"
              action="renewable_bom_action" groups="solar_renewable_energy.group_energy_manager"/>

    <!-- Teams Menu -->
    <menuitem id="renewable_teams_menu" name="Teams" parent="renewable_energy_root" sequence="4"
              groups="solar_renewable_energy.group_energy_manager"/>

    <!-- Survey Team Submenu -->
    <menuitem id="renewable_survey_team_menu" name="Survey Teams" parent="renewable_teams_menu"
              action="renewable_survey_team_action"/>

    <!-- Installation Team Submenu -->
    <menuitem id="renewable_installation_team_menu" name="Installation Teams" parent="renewable_teams_menu"
              action="renewable_installation_team_action"/>

    <!-- QA Team Submenu -->
    <menuitem id="renewable_qa_team_menu" name="QA Teams" parent="renewable_teams_menu"
              action="renewable_qa_team_action"/>

    <!-- Tasks Menu -->
    <menuitem id="renewable_tasks_menu" name="Tasks" parent="renewable_energy_root"
              groups="solar_renewable_energy.group_energy_manager,solar_renewable_energy.group_energy_user"
    />

    <!-- Tasks Installation Submenu -->
    <menuitem id="renewable_installation_team_task_menu" name="Installation Task" parent="renewable_tasks_menu"
              action="renewable_installation_team_task_action"/>

    <!-- Tasks QA Submenu -->
    <menuitem id="renewable_qa_team_task_menu" name="QA Task" parent="renewable_tasks_menu"
              action="renewable_qa_team_task_action"/>

    <!-- Maintenance Requests Menu -->
    <menuitem id="renewable_maintenance_requests_menu" name="Maintenance Requests"
              parent="renewable_energy_root" action="renewable_maintenance_requests_action"
              groups="solar_renewable_energy.group_energy_manager"/>

    <!-- Configurations Menu -->
    <menuitem id="renewable_configurations_menu" name="Configurations" parent="renewable_energy_root" sequence="30"
              groups="solar_renewable_energy.group_energy_manager"/>

    <!-- Service Types Submenu -->
    <menuitem id="renewable_service_types_menu" name="Service Types"
              parent="renewable_configurations_menu" action="renewable_service_types_action"/>

    <!-- Property Types Submenu -->
    <menuitem id="renewable_property_types_menu" name="Property Types"
              parent="renewable_configurations_menu" action="renewable_property_types_action"/>

    <!-- Contract Demands Submenu -->
    <menuitem id="renewable_contract_demands_menu" name="Contract Demands"
              parent="renewable_configurations_menu" action="renewable_contract_demands_action"/>

    <!-- Customer Category Submenu -->
    <menuitem id="renewable_customer_category_menu" name="Customer Category"
              parent="renewable_configurations_menu" action="renewable_customer_category_action"/>
</odoo>
