<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Action for Subcontract Installation team task-->
    <record id="renewable_subcontract_installation_task_action" model="ir.actions.act_window">
        <field name="name">Subcontract Installation Team Task</field>
        <field name="res_model">subcontract.installation.team.task</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'group_by': 'installation_stage'}</field>
    </record>
    <!--    Kanban view for Subcontract Installation team task-->
    <record id="subcontract_installation_team_task_view_kanban" model="ir.ui.view">
        <field name="name">subcontract.installation.team.task.view.kanban</field>
        <field name="model">subcontract.installation.team.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="installation_stage">
                <field name="installation_stage"/>
                <field name="customer_id"/>
                <field name="priority"/>
                <field name="subcontractor_id"/>
                <field name="service_type_id"/>
                <field name="installation_start_date"/>
                <field name="installation_end_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_card">
                                    <div>
                                        <b>
                                            <field name="name"/>
                                        </b>
                                    </div>
                                    <div class="text-muted">
                                        <field name="customer_id" widget="res_partner_many2one"/>
                                    </div>
                                    <div class="text-muted">
                                        <strong>Subcontractor:</strong>
                                        <field name="subcontractor_id"/>
                                    </div>
                                    <div class="text-muted" t-if="record.installation_start_date.raw_value">
                                        <strong>Start Date:</strong>
                                        <field name="installation_start_date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--    Form view for subcontract Installation Team Task-->
    <record id="subcontract_installation_team_task_view_form" model="ir.ui.view">
        <field name="name">subcontract.installation.team.task.view.form</field>
        <field name="model">subcontract.installation.team.task</field>
        <field name="arch" type="xml">
            <form string="Subcontract Installation Team Task">
                <header>
                    <field name="installation_stage" widget="statusbar" statusbar_visible="new,in_progress,completed"/>
                    <button name="action_in_progress" type="object" string="In Progress" class="oe_highlight"
                            invisible="installation_stage != 'new'"/>
                    <button name="action_completed" type="object" string="Completed" class="oe_highlight"
                            invisible="installation_stage != 'in_progress'"/>
                </header>
                <sheet>
                    <group>
                        <group string="ORDER DETAILS">
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="priority"/>
                        </group>
                        <group string="SUBCONTRACTOR DETAILS">
                            <field name="subcontractor_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="SERVICE DETAILS">
                            <field name="service_type_id"/>
                            <field name="service_description"/>
                            <field name="contract_demand_id"/>
                        </group>
                        <group string="TASK DETAILS">
                            <group>
                                <field name="installation_start_date"/>
                                <field name="installation_end_date"/>
                            </group>
                            <group>
                                <field name="installation_period"/>
                                <field name="allocated_time"/>
                            </group>
                        </group>
                    </group>
                    <group string="SITE DETAILS">
                        <group>
                            <field name="site_usage"/>
                            <field name="property_type_id"/>
                            <field name="age_of_property"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <group string="BILL OF MATERIALS">
                        <field name="bom_ids">
                            <tree>
                                <field name="product_id"/>
                                <field name="product_qty"/>
                                <field name="product_uom_id"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>