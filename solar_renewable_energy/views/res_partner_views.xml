<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Action for Partners-->
    <record id="renewable_customers_action" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <!--    Action for Sub Contractor-->
    <record id="renewable_sub_contractor_action" model="ir.actions.act_window">
        <field name="name">Sub Contractor</field>
        <field name="res_model">res.partner</field>
        <field name="domain">[('is_subcontractor', '=', True)]</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <!--    Inherit Res Partner for Renewable Energy-->
    <record id="res_partner_view_form_inherit_solar_renewable_energy" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.odoo.renewable.energy</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_subcontractor"/>
            </xpath>
        </field>
    </record>
</odoo>
