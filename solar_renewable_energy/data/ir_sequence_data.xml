<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- REN Order Sequence-->
    <record id="ren_order_sequence" model="ir.sequence">
        <field name="name">ren.order.sequence</field>
        <field name="code">ren.order</field>
        <field name="prefix">REN/%(year)s/%(month)s/%(day)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
    </record>
</odoo>