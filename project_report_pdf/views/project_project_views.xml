<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Adds the Print button to the project form -->
    <record id="edit_project_view_form_inherit_project_report_pdf" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.project.report.pdf</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(project_report_pdf.project_report_action)d"
                    type="action"
                    string="Print"
                    class="oe_highlight"
                />
            </xpath>
        </field>
    </record>
</odoo>
