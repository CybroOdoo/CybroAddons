<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_project_project">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h1 class="mt-4">Project: <span t-out="name"/></h1>
                    <p class="fw-bold mb-1">Project Manager: <span t-out="manager"/></p>
                    <p class="fw-bold mb-1">Start Date: <span t-out="date_start"/></p>
                    <p class="fw-bold">End Date: <span t-out="date_end"/></p>
                    <h2>Tasks</h2>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th class="text-start">Task</th>
                                <th class="text-start">Assigned</th>
                                <th class="text-start">Stage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="vals" t-as="res">
                                <td><span t-out="res['name']"/></td>
                                <td><span t-out="res['user_id']"/></td>
                                <td><span t-out="res['stage_id']"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
