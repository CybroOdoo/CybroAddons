<odoo>
    <!-- Access rule for multi-company -->
    <record id="website_seo_multi_company" model="ir.access">
        <field name="name">Multi-company access for SEO generation</field>
        <field name="model_id" ref="model_seo_generate"/>
        <field name="operation">crud</field>
        <field name="domain">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
