<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Arqora contact page: page hero, contact details and the standard website form.
-->
<odoo>
    <template id="contactus" name="Arqora Contact Us" inherit_id="website.contactus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
<header data-snippet="s_arqora_contact_hero" class="aq-s s_arqora_contact_hero aq-page-hero aq-page-hero--compact" data-name="Page Hero">
  <div class="aq-container">
    <nav class="aq-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Contact</span></nav>
    <h1 class="aq-hd" data-split="">Let’s talk about light.</h1>
    <p class="aq-page-hero__lead" data-reveal="">Tell us about your project. We reply within one working day.</p>
  </div>
</header>
<section data-snippet="s_arqora_contact" class="aq-s s_arqora_contact aq-container aq-contact" id="contact" data-name="Contact">
  <aside class="aq-contact__info" data-reveal="">
    <dl>
      <div><dt>Email</dt><dd><a href="mailto:studio@arqora.com">studio@arqora.com</a></dd></div>
      <div><dt>Phone</dt><dd><a href="tel:+390245678900">+39 02 4567 8900</a></dd></div>
      <div><dt>Studio</dt><dd>Via Tortona 31<br/>20144 Milano, Italy</dd></div>
      <div><dt>Hours</dt><dd>Mon–Fri, 9:00–18:00 CET</dd></div>
    </dl>
  </aside>
  <div class="aq-contact__form">
    <div class="aq-enquiry-tabs" role="tablist" aria-label="Enquiry category">
      <button type="button" class="aq-enquiry-tab is-active" role="tab" aria-selected="true" data-aq-key="architect" data-aq-type="Architect enquiry" data-aq-intro="Technical guidance, lighting calculations and project pricing." data-aq-company="Practice / studio">Architects</button>
      <button type="button" class="aq-enquiry-tab" role="tab" aria-selected="false" data-aq-key="designer" data-aq-type="Interior designer enquiry" data-aq-intro="Finish samples, trade pricing and bespoke finishes." data-aq-company="Studio">Interior Designers</button>
      <button type="button" class="aq-enquiry-tab" role="tab" aria-selected="false" data-aq-key="contractor" data-aq-type="Contractor enquiry" data-aq-intro="Lead times, installation support and trade terms." data-aq-company="Company">Contractors</button>
      <button type="button" class="aq-enquiry-tab" role="tab" aria-selected="false" data-aq-key="customer" data-aq-type="Customer enquiry" data-aq-intro="Product questions, showroom visits and private consultations." data-aq-company="Company (optional)">Customers</button>
    </div>
    <p class="aq-enquiry-intro" aria-live="polite">Technical guidance, lighting calculations and project pricing.</p>
    
<div class="s_website_form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
  <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_optional" data-mark="(optional)" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
    <div class="s_website_form_rows aq-field-rows">
      <div class="s_website_form_field aq-field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
        <label class="s_website_form_label" for="aq_contact_name"><span class="s_website_form_label_content">Name</span></label>
        <input id="aq_contact_name" type="text" class="form-control s_website_form_input" name="contact_name" required="1" autocomplete="name" data-fill-with="name"/>
      </div>
      <div class="s_website_form_field aq-field s_website_form_model_required" data-type="email" data-name="Field">
        <label class="s_website_form_label" for="aq_contact_email"><span class="s_website_form_label_content">Email</span></label>
        <input id="aq_contact_email" type="email" class="form-control s_website_form_input" name="email_from" required="" autocomplete="email" data-fill-with="email"/>
      </div>
      <div class="s_website_form_field aq-field s_website_form_custom" data-type="char" data-name="Field">
        <label class="s_website_form_label" for="aq_contact_company"><span class="s_website_form_label_content">Company</span></label>
        <input id="aq_contact_company" type="text" class="form-control s_website_form_input" name="partner_name" autocomplete="organization" data-fill-with="commercial_company_name"/>
      </div>
      <div class="s_website_form_field aq-field s_website_form_model_required" data-type="char" data-name="Field">
        <label class="s_website_form_label" for="aq_contact_subject"><span class="s_website_form_label_content">I am a</span></label>
        <select id="aq_contact_subject" class="form-select s_website_form_input" name="name" required="">
          <option value="">Select</option><option value="Architect enquiry">Architect</option><option value="Interior designer enquiry">Interior designer</option><option value="Contractor enquiry">Contractor</option><option value="Customer enquiry">Customer</option>
        </select>
      </div>
      <div class="s_website_form_field aq-field s_website_form_custom" data-type="char" data-name="Field">
        <label class="s_website_form_label" for="aq_contact_type"><span class="s_website_form_label_content">Project type</span></label>
        <select id="aq_contact_type" class="form-select s_website_form_input" name="project_type">
          <option value="">Select</option><option>Private residence</option><option>Hotel &amp; hospitality</option><option>Restaurant &amp; bar</option><option>Workspace &amp; office</option><option>Retail &amp; showroom</option><option>Other</option>
        </select>
      </div>
      <div class="s_website_form_field aq-field s_website_form_custom" data-type="char" data-name="Field">
        <label class="s_website_form_label" for="aq_contact_location"><span class="s_website_form_label_content">Project location</span></label>
        <input id="aq_contact_location" type="text" class="form-control s_website_form_input" name="project_location" placeholder="City, country" autocomplete="address-level2"/>
      </div>
      <!-- The product of a quotation request: shown as a card, sent with the enquiry. -->
      <div class="aq-product-ref aq-field--full" hidden="">
        <img class="aq-product-ref__image" src="" alt=""/>
        <div>
          <span class="aq-product-ref__label">Quotation for</span>
          <strong class="aq-product-ref__name"/>
          <span class="aq-product-ref__meta"/>
        </div>
      </div>
      <div class="s_website_form_field s_website_form_custom s_website_form_dnone" data-type="char" data-name="Field">
        <input id="aq_contact_product" type="hidden" class="form-control s_website_form_input" name="product"/>
      </div>
      <div class="s_website_form_field aq-field aq-field--full s_website_form_custom" data-type="char" data-name="Field">
        <label class="s_website_form_label" for="aq_contact_scale"><span class="s_website_form_label_content">Estimated requirements</span></label>
        <select id="aq_contact_scale" class="form-select s_website_form_input" name="requirements">
          <option value="">Select project scale</option><option>1–10 fixtures</option><option>10–50 fixtures</option><option>50–200 fixtures</option><option>200+ fixtures</option><option>Bespoke / one-off piece</option>
        </select>
      </div>
      <div class="s_website_form_field aq-field aq-field--full s_website_form_model_required" data-type="text" data-name="Field">
        <label class="s_website_form_label" for="aq_contact_message"><span class="s_website_form_label_content">Message</span></label>
        <textarea id="aq_contact_message" class="form-control s_website_form_input" name="description" required="" rows="4"/>
      </div>
      <div class="s_website_form_submit aq-field--full" data-name="Submit Button">
        <div class="s_website_form_label"/>
        <a href="#" role="button" class="aq-btn s_website_form_send">Send Enquiry</a>
        <span id="s_website_form_result"/>
      </div>
    </div>
  </form>
</div>
  </div>
</section>
            </div>
        </xpath>
    </template>

    <!-- Thank-you page reached after the enquiry form is sent. -->
    <template id="contactus_thanks" name="Arqora Contact Thank You" inherit_id="website.contactus_thanks_ir_ui_view">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <header data-snippet="s_arqora_thanks" class="aq-s aq-page-hero aq-page-hero--compact" data-name="Thank You">
                    <div class="aq-container">
                        <nav class="aq-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Enquiry sent</span></nav>
                        <h1 class="aq-hd" data-split="">Thank you.</h1>
                        <p class="aq-page-hero__lead" data-reveal="">Your enquiry is with our project team. We will reply within one working day.</p>
                        <div class="aq-thanks__actions">
                            <a href="/shop" class="aq-btn">Explore the collections</a>
                            <a href="/" class="aq-btn aq-btn--outline">Back to home</a>
                        </div>
                    </div>
                </header>
            </div>
        </xpath>
    </template>
</odoo>
