<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Header: the standard website header, so every header template and option of
    the website builder keeps working, dressed in the Arqora design. The light
    wordmark is added next to the standard logo; it shows over a hero.
-->
<odoo>
    <template id="header_brand_logo" name="Arqora Header Light Logo" inherit_id="website.option_header_brand_logo">
        <xpath expr="//a[@data-name='Navbar Logo']" position="inside">
            <img class="aq-logo-light" src="/theme_arqora/static/src/img/logo-light.png" alt="" aria-hidden="true" height="38"/>
        </xpath>
    </template>

    <!--
        Marks the default header template. The Arqora styles and the "+" menu
        only apply to a header carrying the marker: another template picked in
        the website builder disables this view and shows the standard Odoo
        header, and picking the default one again brings the design back.
    -->
    <template id="header_default_marker" name="Arqora Header Marker" inherit_id="website.template_header_default">
        <xpath expr="//div[@id='o_main_nav']" position="attributes">
            <attribute name="t-attf-class" add="aq-nav" separator=" "/>
        </xpath>
    </template>
</odoo>
