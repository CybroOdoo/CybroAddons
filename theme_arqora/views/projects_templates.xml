<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Arqora Projects page, built from the markup of the Arqora snippets, inlined so the page body stays editable in the website builder.
-->
<odoo>
    <template id="projects_page" name="Arqora Projects">
        <t t-call="website.layout">
            <t t-set="additional_title">Projects</t>
            <div id="wrap" class="oe_structure oe_empty">
<header data-snippet="s_arqora_projects_hero" class="aq-s s_arqora_projects_hero aq-page-hero aq-page-hero--image" data-name="Page Hero">
  <div class="aq-page-hero__bg"><img data-aq-parallax="0.08" src="/theme_arqora/static/src/img/content/projects-hero.jpg" alt="A contemporary residence glowing at dusk" fetchpriority="high"/></div>
  <div class="aq-container aq-page-hero__grid">
    <div class="aq-page-hero__title">
      <nav class="aq-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Projects</span></nav>
      <span class="aq-eyebrow aq-eyebrow--line">Portfolio</span>
      <h1 class="aq-display" style="margin-top:28px" data-split="">Light in<br/><em>architecture.</em></h1>
    </div>
    <p class="aq-page-hero__aside" data-reveal="">From private villas to Belle Époque hotels and harbour pavilions, every ARQORA project is lit in close dialogue with its architects, revealing structure, material and atmosphere.</p>
  </div>
</header>
<section data-snippet="s_arqora_project_list" class="aq-s s_arqora_project_list aq-sec" style="padding-top:clamp(56px,7vw,100px)" data-name="Project List">
  <div class="aq-container">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;padding-bottom:28px;border-bottom:1px solid var(--aq-line)">
      <span class="aq-caps aq-muted">Selected works</span><span class="aq-caps aq-muted">9 projects</span>
    </div>
    <div class="aq-project-list"><article class="aq-project-row"><div class="aq-project-row__media"><div class="aq-media"><img src="/theme_arqora/static/src/img/content/project-the-residence.jpg" alt="The Residence, Lake Como, Italy" loading="lazy"/></div></div><div class="aq-project-row__body"><span class="aq-eyebrow">Luxury Residential</span><h2 class="aq-project-row__name">The Residence</h2><p class="aq-project-row__summary">A lakeside villa where light follows the day, from bright, open mornings to intimate evenings at the water’s edge.</p><dl class="aq-facts"><div><dt>Location</dt><dd>Lake Como, Italy</dd></div><div><dt>Year</dt><dd>2026</dd></div><div><dt>Architect</dt><dd>Studio Ferrante Architetti</dd></div><div><dt>Area</dt><dd>820 m²</dd></div></dl></div></article><article class="aq-project-row aq-is-flipped"><div class="aq-project-row__media"><div class="aq-media"><img src="/theme_arqora/static/src/img/content/project-the-atelier.jpg" alt="The Atelier, Milan, Italy" loading="lazy"/></div></div><div class="aq-project-row__body"><span class="aq-eyebrow">Contemporary Workspace</span><h2 class="aq-project-row__name">The Atelier</h2><p class="aq-project-row__summary">A former textile mill transformed into a creative headquarters lit for focus, collaboration and craft.</p><dl class="aq-facts"><div><dt>Location</dt><dd>Milan, Italy</dd></div><div><dt>Year</dt><dd>2025</dd></div><div><dt>Architect</dt><dd>Officina Brera</dd></div><div><dt>Area</dt><dd>1,450 m²</dd></div></dl></div></article><article class="aq-project-row"><div class="aq-project-row__media"><div class="aq-media"><img src="/theme_arqora/static/src/img/content/project-the-grand.jpg" alt="The Grand, Vienna, Austria" loading="lazy"/></div></div><div class="aq-project-row__body"><span class="aq-eyebrow">Boutique Hospitality</span><h2 class="aq-project-row__name">The Grand</h2><p class="aq-project-row__summary">A Belle Époque landmark reborn as a 48-suite boutique hotel with a deeply atmospheric lighting identity.</p><dl class="aq-facts"><div><dt>Location</dt><dd>Vienna, Austria</dd></div><div><dt>Year</dt><dd>2025</dd></div><div><dt>Architect</dt><dd>Atelier Weiss &amp; Partner</dd></div><div><dt>Area</dt><dd>6,200 m² · 48 suites</dd></div></dl></div></article><article class="aq-project-row aq-is-flipped"><div class="aq-project-row__media"><div class="aq-media"><img src="/theme_arqora/static/src/img/content/project-the-pavilion.jpg" alt="The Pavilion, Copenhagen, Denmark" loading="lazy"/></div></div><div class="aq-project-row__body"><span class="aq-eyebrow">Modern Commercial Architecture</span><h2 class="aq-project-row__name">The Pavilion</h2><p class="aq-project-row__summary">A sculptural cultural pavilion on the harbour, lit to read as a lantern from across the water.</p><dl class="aq-facts"><div><dt>Location</dt><dd>Copenhagen, Denmark</dd></div><div><dt>Year</dt><dd>2024</dd></div><div><dt>Architect</dt><dd>Holm Lindqvist Arkitekter</dd></div><div><dt>Area</dt><dd>3,800 m²</dd></div></dl></div></article><article class="aq-project-row"><div class="aq-project-row__media"><div class="aq-media"><img src="/theme_arqora/static/src/img/content/project-villa-serra.jpg" alt="Villa Serra, Mallorca, Spain" loading="lazy"/></div></div><div class="aq-project-row__body"><span class="aq-eyebrow">Private Residence</span><h2 class="aq-project-row__name">Villa Serra</h2><p class="aq-project-row__summary">A whitewashed Mediterranean villa where travertine, linen and brass glow in the evening light.</p><dl class="aq-facts"><div><dt>Location</dt><dd>Mallorca, Spain</dd></div><div><dt>Year</dt><dd>2025</dd></div><div><dt>Architect</dt><dd>Ruiz Bauzà Arquitectes</dd></div><div><dt>Area</dt><dd>540 m²</dd></div></dl></div></article><article class="aq-project-row aq-is-flipped"><div class="aq-project-row__media"><div class="aq-media"><img src="/theme_arqora/static/src/img/content/project-maison-clair.jpg" alt="Maison Clair, Paris, France" loading="lazy"/></div></div><div class="aq-project-row__body"><span class="aq-eyebrow">Haussmannian Apartment</span><h2 class="aq-project-row__name">Maison Clair</h2><p class="aq-project-row__summary">Contemporary chandeliers set against restored mouldings in a seventh-arrondissement apartment.</p><dl class="aq-facts"><div><dt>Location</dt><dd>Paris, France</dd></div><div><dt>Year</dt><dd>2026</dd></div><div><dt>Architect</dt><dd>Studio Delorme Intérieurs</dd></div><div><dt>Area</dt><dd>310 m²</dd></div></dl></div></article><article class="aq-project-row"><div class="aq-project-row__media"><div class="aq-media"><img src="/theme_arqora/static/src/img/content/project-hotel-lumen.jpg" alt="Hotel Lumen, Comporta, Portugal" loading="lazy"/></div></div><div class="aq-project-row__body"><span class="aq-eyebrow">Resort Hospitality</span><h2 class="aq-project-row__name">Hotel Lumen</h2><p class="aq-project-row__summary">A low-rise coastal resort lit entirely in warm, amber tones to protect the night sky and the dunes.</p><dl class="aq-facts"><div><dt>Location</dt><dd>Comporta, Portugal</dd></div><div><dt>Year</dt><dd>2024</dd></div><div><dt>Architect</dt><dd>Atelier Costa Mendes</dd></div><div><dt>Area</dt><dd>9,400 m² · 36 villas</dd></div></dl></div></article><article class="aq-project-row aq-is-flipped"><div class="aq-project-row__media"><div class="aq-media"><img src="/theme_arqora/static/src/img/content/project-osteria-nera.jpg" alt="Osteria Nera, London, United Kingdom" loading="lazy"/></div></div><div class="aq-project-row__body"><span class="aq-eyebrow">Restaurant &amp; Bar</span><h2 class="aq-project-row__name">Osteria Nera</h2><p class="aq-project-row__summary">A dark, intimate Italian restaurant in Mayfair where every table sits in its own pool of light.</p><dl class="aq-facts"><div><dt>Location</dt><dd>London, United Kingdom</dd></div><div><dt>Year</dt><dd>2026</dd></div><div><dt>Architect</dt><dd>Marsh &amp; Pellegrini</dd></div><div><dt>Area</dt><dd>420 m² · 90 covers</dd></div></dl></div></article><article class="aq-project-row"><div class="aq-project-row__media"><div class="aq-media"><img src="/theme_arqora/static/src/img/content/project-nord-gallery.jpg" alt="Nord Gallery, Oslo, Norway" loading="lazy"/></div></div><div class="aq-project-row__body"><span class="aq-eyebrow">Gallery &amp; Retail</span><h2 class="aq-project-row__name">Nord Gallery</h2><p class="aq-project-row__summary">A flexible gallery and design store where lighting adapts to every exhibition.</p><dl class="aq-facts"><div><dt>Location</dt><dd>Oslo, Norway</dd></div><div><dt>Year</dt><dd>2025</dd></div><div><dt>Architect</dt><dd>Fjeld Arkitektur</dd></div><div><dt>Area</dt><dd>1,100 m²</dd></div></dl></div></article></div>
  </div>
</section>
<section data-snippet="s_arqora_cta" class="aq-s s_arqora_cta aq-sec aq-sec--surface" data-name="Call to Action">
  <div class="aq-container aq-split">
    <div class="aq-split__text aq-split__text--wide">
      <span class="aq-eyebrow aq-eyebrow--line" data-reveal="">Collaborate</span>
      <h2 class="aq-h1" data-split="">Your project,<br/><em>illuminated.</em></h2>
    </div>
    <div class="aq-split__text aq-split__text--side">
      <p class="aq-body-lg" data-reveal="">Our project team supports architects and interior designers from concept to commissioning: lighting concepts, calculations, mock-ups, bespoke fixtures and on-site focusing.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap" data-reveal="">
        <a class="aq-btn" href="/contactus">Start a Project</a>
        <a class="aq-btn aq-btn--outline" href="/resources">Technical Resources</a>
      </div>
    </div>
  </div>
</section>
            </div>
        </t>
    </template>

    <record id="projects_page_page" model="theme.website.page">
        <field name="url">/projects</field>
        <field name="view_id" ref="projects_page"/>
        <field name="is_published" eval="True"/>
        <field name="header_overlay" eval="True"/>
    </record>
</odoo>
