<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Cards of the dynamic blocks of the home page (Collections, Objects of
    Light), rendered from the shop categories and products.
-->
<odoo>
    <template id="collection_tiles" name="Arqora Collection Tiles">
        <t t-foreach="collections" t-as="collection">
            <a class="aq-lamp" t-att-href="collection['url']">
                <img t-att-src="collection['image']" t-att-alt="collection['name']" loading="lazy"/>
                <span class="aq-lamp__top"><span t-out="'%02d' % (collection_index + 1)"/><span class="aq-lamp__led" aria-hidden="true"/></span>
                <span class="aq-lamp__body">
                    <span class="aq-lamp__name" t-out="collection['name']"/>
                    <span class="aq-lamp__meta"><t t-out="collection['count']"/> designs<t t-if="collection['from_price']"> · from <t t-out="collection['from_price']"/></t></span>
                    <span class="aq-link-arrow">Explore Collection
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg>
                    </span>
                </span>
            </a>
        </t>
    </template>

    <template id="signature_cards" name="Arqora Signature Cards">
        <t t-foreach="products" t-as="product">
            <a t-attf-class="aq-obj #{'aq-obj--feature' if product_index == 0 else ''}" t-att-href="product['url']">
                <span class="aq-obj__img">
                    <img t-att-src="product['image']" t-att-alt="product['name']" loading="lazy"/>
                    <span class="aq-obj__go" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M7 17 17 7M8 7h9v9"/></svg>
                    </span>
                </span>
                <span class="aq-obj__body">
                    <span class="aq-obj__cat" t-out="product['category']"/>
                    <span class="aq-obj__title"><b t-out="product['name']"/></span>
                    <span t-if="product_index == 0 and product['tagline']" class="aq-obj__tag" t-out="product['tagline']"/>
                    <span class="aq-obj__foot"><span class="aq-obj__price">From <t t-out="product['price']"/></span></span>
                    <span t-if="product_index == 0" class="aq-link-arrow">View details
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg>
                    </span>
                </span>
            </a>
        </t>
    </template>
</odoo>
