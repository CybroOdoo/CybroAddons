<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Arqora layout: the footer columns of the design (an editable zone) and the
    copyright line. The header, its templates and options stay those of the
    website builder.
-->
<odoo>
    <template id="layout" name="Arqora Layout" inherit_id="website.layout" priority="60">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="aq-wrap" separator=" "/>
        </xpath>
    </template>

    <template id="footer" name="Arqora Footer" inherit_id="website.layout" priority="60">
        <xpath expr="//footer[@id='bottom']" position="attributes">
            <attribute name="t-attf-class" add="aq-s aq-site-footer" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer">
                <section class="aq-s s_arqora_footer" data-name="Footer Columns">
                    <div class="aq-container aq-foot">
                        <div class="aq-foot__head">
                            <div class="aq-foot__brand">
                                <a href="/" class="aq-logo" aria-label="Home">
                                    <img src="/theme_arqora/static/src/img/logo-light.png" alt="ARQORA" width="720" height="143" style="height:48px;width:auto"/>
                                </a>
                                <p class="aq-foot__tagline">Light shapes the space.</p>
                            </div>
                            <dl class="aq-foot__contact">
                                <div><dt>Studio</dt><dd>Via Tortona 31<br/>20144 Milano, Italy</dd></div>
                                <div><dt>Call</dt><dd><a href="tel:+390245678900">+39 02 4567 8900</a></dd></div>
                                <div><dt>Write</dt><dd><a href="mailto:studio@arqora.com">studio@arqora.com</a></dd></div>
                            </dl>
                        </div>
                        <nav class="aq-foot__cols" aria-label="Footer">
                            <div class="aq-foot__col">
                                <h4>Collections</h4>
                                <ul>
                                    <li><a href="/shop?search=pendant">Pendant Lights</a></li>
                                    <li><a href="/shop?search=chandelier">Chandeliers</a></li>
                                    <li><a href="/shop?search=wall">Wall Lights</a></li>
                                    <li><a href="/shop?search=floor">Floor Lamps</a></li>
                                    <li><a href="/shop?search=table">Table Lamps</a></li>
                                    <li><a href="/shop?search=architectural">Architectural Lighting</a></li>
                                </ul>
                            </div>
                            <div class="aq-foot__col">
                                <h4>Explore</h4>
                                <ul>
                                    <li><a href="/services">Services</a></li>
                                    <li><a href="/projects">Projects</a></li>
                                    <li><a href="/materials">Materials</a></li>
                                    <li><a href="/about">The Studio</a></li>
                                    <li><a href="/#journal">Journal</a></li>
                                    <li><a href="/shop?order=create_date+desc">New designs</a></li>
                                </ul>
                            </div>
                            <div class="aq-foot__col">
                                <h4>Technical Resources</h4>
                                <ul>
                                    <li><a href="/resources#library">Catalogues</a></li>
                                    <li><a href="/resources#library">Installation manuals</a></li>
                                    <li><a href="/resources#library">Care and maintenance</a></li>
                                    <li><a href="/resources#library">Warranty</a></li>
                                </ul>
                            </div>
                            <div class="aq-foot__col">
                                <h4>Designer Support</h4>
                                <ul>
                                    <li><a href="/contactus">Designer enquiry</a></li>
                                    <li><a href="/contactus">Finish samples</a></li>
                                    <li><a href="/resources#support">Lighting calculations</a></li>
                                    <li><a href="/contactus">Trade &amp; contractors</a></li>
                                    <li><a href="/contactus">Contact</a></li>
                                </ul>
                            </div>
                            <div class="aq-foot__col">
                                <h4>Showrooms</h4>
                                <ul>
                                    <li><a href="/about#showroom-milano">Milano</a></li>
                                    <li><a href="/about#showroom-london">London</a></li>
                                    <li><a href="/about#showroom-new-york">New York</a></li>
                                    <li><a href="/about#showroom-paris">Paris · by appointment</a></li>
                                </ul>
                            </div>
                        </nav>
                    </div>
                </section>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_copyright')]/div[hasclass('container')]" position="replace">
            <div class="aq-container aq-foot" style="padding-top:0">
                <div class="aq-foot__row aq-foot__row--meta">
                    <span>© <span t-out="datetime.date.today().year"/> <span t-field="res_company.name">ARQORA Lighting</span> · All rights reserved</span>
                    <nav class="aq-foot__links" aria-label="Legal and social">
                        <a href="/legal#privacy">Privacy</a><a href="/legal#terms">Terms</a><a href="/legal#cookies">Cookies</a>
                        <i aria-hidden="true"/>
                        <a href="https://www.instagram.com/" target="_blank" rel="noopener">Instagram</a>
                        <a href="https://www.pinterest.com/" target="_blank" rel="noopener">Pinterest</a>
                        <a href="https://www.linkedin.com/" target="_blank" rel="noopener">LinkedIn</a>
                    </nav>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
