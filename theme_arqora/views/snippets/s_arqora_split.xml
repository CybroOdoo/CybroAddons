<odoo>
    <template id="s_arqora_split" name="Arqora Image and Text">
<section class="aq-s s_arqora_split aq-sec aq-sec--surface" data-name="Image and Text" id="story">
  <div class="aq-container aq-split">
    <div class="aq-split__media aq-media aq-ratio-45" data-reveal="image">
      <img src="/theme_arqora/static/src/img/content/studio.jpg" alt="Prototype brass pendant lights in the ARQORA studio" loading="lazy"/>
    </div>
    <div class="aq-split__text">
      <span class="aq-eyebrow aq-eyebrow--line" data-reveal="">Our story</span>
      <h2 class="aq-h2" data-split="">From a small<br/><em>atelier</em> in Tortona.</h2>
      <p class="aq-body-lg" data-reveal="">ARQORA was founded in 1998 by architect Giulia Ferraro and engineer Marco Valli in a former foundry in Milan’s Tortona district. Their idea was simple: lighting should be designed with the same rigour as the buildings it serves.</p>
      <p class="aq-body-lg" data-reveal="">Today the studio brings together forty designers, engineers and lighting specialists, working with a close network of metal spinners in Lombardy, glass blowers in Murano and Bohemia, and stone masons in Tivoli.</p>
      <a class="aq-link-arrow" href="/projects">See our projects <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>
    </template>
    <template id="s_arqora_samples" name="Arqora Samples">
<section class="aq-s s_arqora_samples aq-sec aq-sec--surface" data-name="Samples">
  <div class="aq-container aq-split">
    <div class="aq-split__media aq-media aq-ratio-45" data-reveal="image">
      <img src="/theme_arqora/static/src/img/content/materials-samples.jpg" alt="Hand-finished ceramic and stone objects" loading="lazy"/>
    </div>
    <div class="aq-split__text">
      <span class="aq-eyebrow aq-eyebrow--line" data-reveal="">Samples</span>
      <h2 class="aq-h2" data-split="">Touch before<br/>you <em>specify.</em></h2>
      <p class="aq-body-lg" data-reveal="">Architects and designers can request a complimentary finish box with all eight materials, or individual samples matched to a project palette. Bespoke patinas and colour-matched powder coats are available on request.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap" data-reveal="">
        <a class="aq-btn" href="/contactus">Request Samples</a>
        <a class="aq-btn aq-btn--outline" href="/shop">Browse by Finish</a>
      </div>
    </div>
  </div>
</section>
    </template>
    <template id="s_arqora_cta" name="Arqora Call to Action">
<section class="aq-s s_arqora_cta aq-sec aq-sec--surface" data-name="Call to Action">
  <div class="aq-container aq-split">
    <div class="aq-split__text aq-split__text--wide">
      <span class="aq-eyebrow aq-eyebrow--line" data-reveal="">Collaborate</span>
      <h2 class="aq-h1" data-split="">Your project,<br/><em>illuminated.</em></h2>
    </div>
    <div class="aq-split__text aq-split__text--side">
      <p class="aq-body-lg" data-reveal="">Our project team supports architects and interior designers from concept to commissioning: lighting concepts, calculations, mock-ups, bespoke fixtures and on-site focusing.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap" data-reveal="">
        <a class="aq-btn" href="/contactus">Start a Project</a>
        <a class="aq-btn aq-btn--outline" href="/resources">Technical Resources</a>
      </div>
    </div>
  </div>
</section>
