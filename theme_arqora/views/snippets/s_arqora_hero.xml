<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="s_arqora_hero" name="Arqora Hero Room">
<section class="aq-s s_arqora_hero aq-dim" id="hero" aria-label="Introduction" data-name="Hero Room">
  <div class="aq-dim__room">
    <img class="aq-dim__base" src="/theme_arqora/static/src/img/content/hero-room.jpg" alt="A living room with a sculptural, cove-lit ceiling, a globe pendant and floor-to-ceiling windows" fetchpriority="high"/>
    <img class="aq-dim__lit" src="/theme_arqora/static/src/img/content/hero-room.jpg" alt="" aria-hidden="true"/>
    <span class="aq-dim__glow" aria-hidden="true"/>
  </div>
  <a class="aq-dim__tag" href="/shop">
    <i aria-hidden="true"/>
    <span><b>LINEA Cove Profile</b><small>14 W/m · 3000 K · 1,500 lm/m</small></span>
  </a>
  <div class="aq-container aq-dim__content">
    <h1 class="aq-dim__title" data-split="">Light shapes<br/>the space.</h1>
    <div class="aq-dim__side" data-reveal="" style="--aq-delay:.4s">
      <p>Discover a new perspective on illumination through sculptural forms, refined materials and architectural precision.</p>
      <div class="aq-dim__actions">
        <a class="aq-btn aq-btn--light" href="/shop">Explore Collections</a>
        <a class="aq-btn aq-btn--outline-light" href="/projects">View Our Projects</a>
      </div>
    </div>
  </div>
  <div class="aq-dim__bar">
    <div class="aq-container aq-dim__bar-inner">
      <span class="aq-dim__hint">Move across the room to light it</span>
      <label class="aq-dimmer">
        <span>Dimmer</span>
        <input type="range" min="0" max="100" value="18" aria-label="Room brightness"/>
        <output>18%</output>
      </label>
      <button type="button" class="aq-dim__switch" aria-pressed="false"><i aria-hidden="true"/><span>Lights on</span></button>
    </div>
  </div>
</section>
    </template>
</odoo>
