<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Registers the Arqora snippets in the website builder, in their own "Arqora" group.
-->
<odoo>
    <template id="snippets" inherit_id="website.snippets" name="Arqora Snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="arqora" t-snippet="website.s_snippet_group" string="Arqora"
               t-thumbnail="/theme_arqora/static/src/img/snippets/s_arqora_group.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_arqora.s_arqora_hero" string="Hero Room" group="arqora"
               t-thumbnail="/theme_arqora/static/src/img/snippets/s_arqora_hero.jpg">
                <keywords>arqora, hero room</keywords>
            </t>
            <t t-snippet="theme_arqora.s_arqora_intro" string="Introduction" group="arqora"
               t-thumbnail="/theme_arqora/static/src/img/snippets/s_arqora_intro.jpg">
                <keywords>arqora, introduction</keywords>
            </t>
            <t t-snippet="theme_arqora.s_arqora_collections" string="Collections" group="arqora"
               t-thumbnail="/theme_arqora/static/src/img/snippets/s_arqora_collections.jpg">
                <keywords>arqora, collections</keywords>
