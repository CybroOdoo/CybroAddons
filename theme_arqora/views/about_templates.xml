<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Arqora About page, built from the markup of the Arqora snippets, inlined so the page body stays editable in the website builder.
-->
<odoo>
    <template id="about_page" name="Arqora About">
        <t t-call="website.layout">
            <t t-set="additional_title">About</t>
            <div id="wrap" class="oe_structure oe_empty">
<header data-snippet="s_arqora_page_hero" class="aq-s s_arqora_page_hero aq-page-hero aq-page-hero--image" data-name="Page Hero">
  <div class="aq-page-hero__bg"><img data-aq-parallax="0.08" src="/theme_arqora/static/src/img/content/about-hero.jpg" alt="A deep blue living room with a sculptural brass chandelier" fetchpriority="high"/></div>
  <div class="aq-container aq-page-hero__grid">
    <div class="aq-page-hero__title">
      <nav class="aq-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>About</span></nav>
      <span class="aq-eyebrow aq-eyebrow--line">The Studio · Milano, since 1998</span>
      <h1 class="aq-display" style="margin-top:28px" data-split="">We design<br/>with <em>light.</em></h1>
    </div>
    <p class="aq-page-hero__aside" data-reveal="">ARQORA is a contemporary architectural lighting studio specialising in sculptural fixtures, decorative illumination and lighting solutions for luxury residential, hospitality and commercial architecture.</p>
  </div>
</header>
<section data-snippet="s_arqora_manifesto" class="aq-s s_arqora_manifesto aq-sec" data-name="Manifesto">
  <div class="aq-container">
    <span class="aq-eyebrow aq-eyebrow--line" data-reveal="" style="margin-bottom:40px">Our belief</span>
    <p class="aq-manifesto" data-reveal="">Light is the first material of architecture. It gives a room its <em>scale</em>, a surface its <em>texture</em> and a moment its <em>mood</em>. We make objects that serve the light, never the other way around.</p>
  </div>
</section>
<section data-snippet="s_arqora_split" class="aq-s s_arqora_split aq-sec aq-sec--surface" data-name="Image and Text" id="story">
  <div class="aq-container aq-split">
    <div class="aq-split__media aq-media aq-ratio-45" data-reveal="image">
      <img src="/theme_arqora/static/src/img/content/studio.jpg" alt="Prototype brass pendant lights in the ARQORA studio" loading="lazy"/>
    </div>
    <div class="aq-split__text">
      <span class="aq-eyebrow aq-eyebrow--line" data-reveal="">Our story</span>
      <h2 class="aq-h2" data-split="">From a small<br/><em>atelier</em> in Tortona.</h2>
      <p class="aq-body-lg" data-reveal="">ARQORA was founded in 1998 by architect Giulia Ferraro and engineer Marco Valli in a former foundry in Milan’s Tortona district. Their idea was simple: lighting should be designed with the same rigour as the buildings it serves.</p>
      <p class="aq-body-lg" data-reveal="">Today the studio brings together forty designers, engineers and lighting specialists, working with a close network of metal spinners in Lombardy, glass blowers in Murano and Bohemia, and stone masons in Tivoli.</p>
      <a class="aq-link-arrow" href="/projects">See our projects <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>
<section data-snippet="s_arqora_process" class="aq-s s_arqora_process aq-sec aq-sec--dark" id="process" data-name="Process">
  <div class="aq-container">
    <header class="aq-sheet"><b>B–02</b><span>Process</span><span>Eighteen months to three years</span></header>
    <div class="aq-sec__head">
      <h2 class="aq-hd">From sketch to light.</h2>
      <p>Each ARQORA design takes between eighteen months and three years to develop and passes through more than forty hands.</p>
    </div>
    <div class="aq-timeline" data-stagger="">
      <div class="aq-timeline__item"><span class="aq-timeline__year">01</span><h3 class="aq-timeline__title">Concept &amp; Sketch</h3><p class="aq-timeline__text">Ideas start as pencil sketches and paper models, studied against architectural plans and real interiors.</p></div>
      <div class="aq-timeline__item"><span class="aq-timeline__year">02</span><h3 class="aq-timeline__title">Prototyping</h3><p class="aq-timeline__text">Full-scale prototypes are spun, cast and blown by our artisan partners. AUREL went through forty-two versions.</p></div>
      <div class="aq-timeline__item"><span class="aq-timeline__year">03</span><h3 class="aq-timeline__title">Engineering</h3><p class="aq-timeline__text">Our engineers design LED engines, optics and thermal management, then measure every photometric curve in our lab.</p></div>
      <div class="aq-timeline__item"><span class="aq-timeline__year">04</span><h3 class="aq-timeline__title">Craft &amp; Assembly</h3><p class="aq-timeline__text">Each fixture is finished, assembled and tested by hand in Milan before being individually numbered and packed.</p></div>
    </div>
  </div>
</section>
<section data-snippet="s_arqora_team" class="aq-s s_arqora_team aq-sec aq-sec--surface" data-name="Team">
  <div class="aq-container">
    <header class="aq-sheet"><b>B–01</b><span>Leadership</span><span>The studio</span></header>
    <div class="aq-sec__head">
      <h2 class="aq-hd">The studio.</h2>
      <p>Designers, architects and engineers working side by side in one studio.</p>
      <a class="aq-link-arrow" href="/contactus">Join or contact the team <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg></a>
    </div>
    <div class="aq-team" data-stagger="">
      <div class="aq-team__member"><div class="aq-team__initials">GF</div><h3>Giulia Ferraro</h3><p>Co-founder · Creative Director</p></div>
      <div class="aq-team__member"><div class="aq-team__initials">MV</div><h3>Marco Valli</h3><p>Co-founder · Head of Engineering</p></div>
      <div class="aq-team__member"><div class="aq-team__initials">EM</div><h3>Elena Moretti</h3><p>Senior Product Designer</p></div>
      <div class="aq-team__member"><div class="aq-team__initials">KA</div><h3>Kenji Arata</h3><p>Product Designer</p></div>
    </div>
  </div>
</section>
<section data-snippet="s_arqora_showrooms" class="aq-s s_arqora_showrooms aq-sec" id="showrooms" data-name="Showrooms">
  <div class="aq-container">
    <header class="aq-sheet"><b>B–03</b><span>Showrooms</span><span>Visit us</span></header>
    <div class="aq-sec__head">
      <h2 class="aq-hd">Visit us.</h2>
      <p>Experience the collections in person and book a private consultation with our lighting specialists.</p>
    </div>
    <div class="aq-showrooms" data-stagger=""><div class="aq-showroom" id="showroom-milano"><h3>Milano</h3><address>Via Tortona 31<br/>20144 Milano, Italy<br/>Mon–Sat · 10:00–19:00</address><a class="aq-link-arrow" href="/contactus">Book a visit <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg></a></div><div class="aq-showroom" id="showroom-london"><h3>London</h3><address>28 Bruton Place<br/>London W1J 6NG, UK<br/>Mon–Fri · 10:00–18:00</address><a class="aq-link-arrow" href="/contactus">Book a visit <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg></a></div><div class="aq-showroom" id="showroom-new-york"><h3>New York</h3><address>155 Wooster Street<br/>New York, NY 10012<br/>Mon–Sat · 10:00–18:00</address><a class="aq-link-arrow" href="/contactus">Book a visit <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg></a></div><div class="aq-showroom" id="showroom-paris"><h3>Paris</h3><address>By appointment<br/>Saint-Germain-des-Prés<br/>Partner gallery</address><a class="aq-link-arrow" href="/contactus">Book a visit <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg></a></div></div>
  </div>
</section>
            </div>
        </t>
    </template>

    <record id="about_page_page" model="theme.website.page">
        <field name="url">/about</field>
        <field name="view_id" ref="about_page"/>
        <field name="is_published" eval="True"/>
        <field name="header_overlay" eval="True"/>
    </record>
</odoo>
