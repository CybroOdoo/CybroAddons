<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Arqora top menu: Collections (the shop), Services, Projects, Materials,
    About, Resources and Contact. They are copied on every website using the
    theme and removed with it.
-->
<odoo>
    <record id="menu_collections" model="theme.website.menu">
        <field name="name">Collections</field>
        <field name="url">/shop</field>
        <field name="sequence" type="int">20</field>
    </record>
    <record id="menu_services" model="theme.website.menu">
        <field name="name">Services</field>
        <field name="url">/services</field>
        <field name="page_id" ref="services_page_page"/>
        <field name="sequence" type="int">30</field>
    </record>
    <record id="menu_projects" model="theme.website.menu">
        <field name="name">Projects</field>
        <field name="url">/projects</field>
        <field name="page_id" ref="projects_page_page"/>
        <field name="sequence" type="int">40</field>
    </record>
    <record id="menu_materials" model="theme.website.menu">
        <field name="name">Materials</field>
        <field name="url">/materials</field>
        <field name="page_id" ref="materials_page_page"/>
        <field name="sequence" type="int">50</field>
    </record>
    <record id="menu_about" model="theme.website.menu">
        <field name="name">About</field>
        <field name="url">/about</field>
        <field name="page_id" ref="about_page_page"/>
        <field name="sequence" type="int">60</field>
    </record>
    <record id="menu_resources" model="theme.website.menu">
        <field name="name">Resources</field>
        <field name="url">/resources</field>
        <field name="page_id" ref="resources_page_page"/>
        <field name="sequence" type="int">70</field>
    </record>
    <record id="menu_contact" model="theme.website.menu">
        <field name="name">Contact</field>
        <field name="url">/contactus</field>
        <field name="sequence" type="int">80</field>
    </record>
</odoo>
