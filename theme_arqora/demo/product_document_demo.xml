<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Documents of the demo products sold on quotation. They show in the
    Downloads of their product page (Sales > Products > Documents).
-->
<odoo>
    <record id="document_orion_installation" model="product.document">
        <field name="name">ORION - Installation manual.pdf</field>
        <field name="raw" type="bytes" file="theme_arqora/static/src/documents/installation-pendants-chandeliers.pdf"/>
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_orion"/>
        <field name="attached_on_sale">shown_on_product_page</field>
        <field name="sequence" eval="10"/>
    </record>
