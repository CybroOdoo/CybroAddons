<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-inherit="web.Many2One" t-inherit-mode="extension">
    <!--  Attach tooltip to readonly link (the <a> tag) -->
    <xpath expr="//a[contains(@class, 'o_form_uri')]" position="attributes">
      <attribute name="data-tooltip-template">dynamic_hover_on_related_fields.RelatedFieldTooltip</attribute>
      <attribute name="t-att-data-tooltip-info">tooltipInfo</attribute>
      <attribute name="data-tooltip-touch-tap-to-show">true</attribute>
    </xpath>
    <!--  Attach tooltip also in editable mode (the input container) -->
    <xpath expr="//div[contains(@class, 'o_field_many2one_selection')]" position="attributes">
      <attribute name="data-tooltip-template">dynamic_hover_on_related_fields.RelatedFieldTooltip</attribute>
      <attribute name="t-att-data-tooltip-info">tooltipInfo</attribute>
      <attribute name="data-tooltip-touch-tap-to-show">true</attribute>
    </xpath>

  </t>
</templates>
