<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
   <!--
        This template extends the behavior of the web.BadgeTag component (Odoo 20+).
        It adds data attributes required for the dynamic hover tooltip on many2many tags.
        In Odoo 20, the tag span was moved out of web.TagsList into dedicated
        web.BadgeTag and web.AvatarTag component templates, so we extend those instead.
    -->
    <t t-inherit="web.BadgeTag" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_tag')]" position="attributes">
            <attribute name="t-att-data-tooltip-template">this.props.tooltipTemplate or undefined</attribute>
            <attribute name="t-att-data-tooltip-info">this.props.tooltipInfo or undefined</attribute>
            <attribute name="data-tooltip-touch-tap-to-show">true</attribute>
        </xpath>
    </t>
</templates>
