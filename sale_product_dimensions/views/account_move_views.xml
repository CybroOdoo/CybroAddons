<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Inheriting account.move model to add the custom fields -->
    <record id="view_account_move_line_form_inherit" model="ir.ui.view">
        <field name="name">account.move.line.form.dimensions</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="before">
                <field name="length_mm"/>
                <field name="width_mm"/>
                <field name="area_m2"/>
                <field name="price_per_m2"/>
            </xpath>
        </field>
    </record>
</odoo>