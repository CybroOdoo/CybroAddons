<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Inheriting sale.order model to add the custom fields -->
    <record id="view_order_form_inherit_dimensions" model="ir.ui.view">
        <field name="name">sale.order.form.dimensions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="length_mm"/>
                <field name="width_mm"/>
                <field name="area_m2"/>
                <field name="price_per_m2"/>
            </xpath>
        </field>
    </record>
</odoo>
