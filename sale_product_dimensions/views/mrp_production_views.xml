<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Inheriting mrp.production model to add the custom fields -->
    <record id="view_mrp_production_form_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.dimensions</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="length_mm"/>
                <field name="width_mm"/>
                <field name="area_m2" readonly="True"/>
            </xpath>
        </field>
    </record>
</odoo>