<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Inheriting the production PDF report to add the length, width and area. -->
    <template id="report_mrporder" inherit_id="mrp.report_mrporder">
            <xpath expr="//div[@t-if='o.workorder_ids']" position="before">

            <div class="row mt32 mb32" t-if="o.length_mm and o.width_mm" >
                <div class="col-3">
                    <strong>Length (mm):</strong>
                    <span t-field="o.length_mm"/>
                </div>
                <div class="col-3">
                    <strong>Width (mm):</strong>
                    <span t-field="o.width_mm"/>
                </div>
                <div class="col-3">
                    <strong>Area (m²):</strong>
                    <span t-field="o.area_m2"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>