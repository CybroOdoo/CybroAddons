<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Inheriting production pdf reports for adding length,width and area along with the product. -->
    <template id="report_mrporder" inherit_id="mrp.report_mrporder">
            <xpath expr="//div[@t-if='o.workorder_ids']" position="before">

            <div class="row mt32 mb32" t-if="o.length_mm and o.width_mm" >
                <div class="col-3">
                    <strong>Length (mm):</strong>
                    <span t-field="o.length_mm">Laptop Model X</span>
                </div>
                <div class="col-3">
                    <strong>Width (mm):</strong>
                    <span t-field="o.width_mm">Laptop Model X</span>
                </div>
                <div class="col-3">
                    <strong>Area (m2):</strong>
                    <span t-field="o.area_m2">Laptop Model X</span>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
