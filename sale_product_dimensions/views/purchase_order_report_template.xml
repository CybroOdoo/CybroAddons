<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Inheriting the purchase order PDF report to add the length, width,
         area and price per m². -->
    <template id="report_purchaseorder_document"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//table[hasclass('o_has_total_table')]/thead/tr/th[@name='th_description']" position="after">
            <th name="th_length_mm" class="text-end"><strong>Length (mm)</strong></th>
            <th name="th_width_mm" class="text-end"><strong>Width (mm)</strong></th>
            <th name="th_area_m2" class="text-end"><strong>Area (m²)</strong></th>
            <th name="th_price_per_m2" class="text-end"><strong>Price / m²</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td class="text-end"><span t-field="line.length_mm"/></td>
            <td class="text-end"><span t-field="line.width_mm"/></td>
            <td class="text-end"><span t-field="line.area_m2" t-options="{'widget': 'float', 'precision': 4}"/></td>
            <td class="text-end"><span t-field="line.price_per_m2"/></td>
        </xpath>

        <xpath expr="//td[@id='section']" position="attributes">
            <attribute name="colspan">9</attribute>
        </xpath>
    </template>
</odoo>
