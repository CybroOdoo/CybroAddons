<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Inheriting production pdf reports for adding length,width and area
        along with the product. -->
    <template id="report_purchaseorder_document"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//table[hasclass('o_has_total_table')]" position="replace">
            <table class="o_has_total_table table o_main_table table-borderless">
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_description" class="text-start">
                            <strong>Description</strong>
                        </th>
                        <th name="th_length" class="text-end">
                            <strong>Length (mm)</strong>
                        </th>
                        <th name="th_width" class="text-end">
                            <strong>Width (mm)</strong>
                        </th>
                        <th name="th_area" class="text-end">
                            <strong>Area (m²)</strong>
                        </th>
                        <th name="th_area" class="text-end">
                            <strong>Price Per Area</strong>
                        </th>
                        <th name="th_quantity" class="text-end">
                            <strong>Qty</strong>
                        </th>
                        <th name="th_price_unit" class="text-end">
                            <strong>Unit Price</strong>
                        </th>
                        <th name="th_discount" class="text-end">
                            <strong>Disc.</strong>
                        </th>
                        <th name="th_taxes" class="text-end">
                            <strong>Taxes</strong>
                        </th>
                        <th name="th_subtotal" class="text-end">
                            <strong>Amount</strong>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)"
                       t-as="line">
                        <t t-set="current_subtotal"
                           t-value="current_subtotal + line.price_subtotal"/>

                        <tr t-att-class="'fw-bolder o_line_section' if line.display_type == 'line_section' else 'fw-bold o_line_subsection' if line.display_type == 'line_subsection' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">

                            <t t-if="not line.display_type">
                                <td id="product" class="text-start">
                                    <span t-field="line.name"/>
                                </td>

                                <!-- New Columns -->
                                <td class="text-end">
                                    <span t-field="line.length_mm"
                                          t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.width_mm"
                                          t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.area_m2"
                                          t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_per_m2"
                                          t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                                </td>
                                <!-- Existing Columns -->
                                <td class="text-end">
                                    <span t-field="line.product_qty"/>
                                    <span t-field="line.product_uom.name"
                                          groups="uom.group_uom"/>
                                    <span t-if="line.product_uom != line.product_id.uom_id"
                                          class="text-muted small">
                                        <br/>
                                        <span t-field="line.product_uom_qty"
                                              t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                                        <span t-field="line.product_id.uom_id"/>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_unit"/>
                                </td>
                                <td class="text-end">
                                    <span><span t-field="line.discount"/>%
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span t-out="', '.join(tax.invoice_label for tax in line.taxes_id if tax.invoice_label)"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </t>
                            <!-- Section / Note Handling -->
                            <t t-if="line.display_type in ('line_section', 'line_subsection')">
                                <td colspan="99" id="section">
                                    <span t-field="line.name"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99" id="note">
                                    <span t-field="line.name"/>
                                </td>
                            </t>
                        </tr>
                        <!-- Subtotal Row -->
                        <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type in ('line_section', 'line_subsection'))">
                            <tr class="is-subtotal text-end">
                                <td colspan="99" id="subtotal">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-out="current_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
