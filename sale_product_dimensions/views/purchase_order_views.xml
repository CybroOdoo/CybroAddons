<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Inheriting purchase.order model to add the custom fields -->
    <record id="view_purchase_order_line_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.line.form.dimensions</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='products']/field[@name='order_line']/tree/field[@name='product_qty']" position="after">
                <field name="length_mm"/>
                <field name="width_mm"/>
                <field name="area_m2"/>
                <field name="price_per_m2"/>
            </xpath>
        </field>
    </record>
</odoo>