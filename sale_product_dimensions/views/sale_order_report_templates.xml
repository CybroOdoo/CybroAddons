<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Inheriting sale pdf reports for adding length,width and area along with the product. -->
    <template id="report_saleorder_document"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//table[hasclass('o_has_total_table')]/thead/tr/th[1]"
               position="after">
            <th name="th_quantity" class="text-end text-nowrap">Length (mm)</th>
            <th name="th_quantity" class="text-end text-nowrap">Width (mm)</th>
            <th name="th_quantity" class="text-end text-nowrap">Area (mm)</th>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_name']" position="after">
            <td  class="text-end text-nowrap">
                <span t-field="line.length_mm"/>
            </td>
            <td  class="text-end text-nowrap">
                <span t-field="line.width_mm"/>
            </td>
            <td  class="text-end text-nowrap">
                <span t-field="line.area_m2"/>
            </td>
        </xpath>
    </template>
</odoo>
