<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Inheriting the sales order PDF report to add the length, width, area and price per m². -->
    <template id="report_saleorder_document"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//table[hasclass('o_has_total_table')]/thead/tr/th[@name='th_description']" position="after">
            <th name="th_length_mm" class="text-end text-nowrap">
                <t t-set="colspan_count" t-value="colspan_count + 4"/>
                Length (mm)
            </th>
            <th name="th_width_mm" class="text-end text-nowrap">Width (mm)</th>
            <th name="th_area_m2" class="text-end text-nowrap">Area (m²)</th>
            <th name="th_price_per_m2" class="text-end text-nowrap">Price / m²</th>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_name']" position="after">
            <td name="td_product_length" class="text-end text-nowrap">
                <span t-field="line.length_mm"/>
            </td>
            <td name="td_product_width" class="text-end text-nowrap">
                <span t-field="line.width_mm"/>
            </td>
            <td name="td_product_area" class="text-end text-nowrap">
                <span t-field="line.area_m2" t-options="{'widget': 'float', 'precision': 4}"/>
            </td>
            <td name="td_product_price_per" class="text-end text-nowrap">
                <span t-field="line.price_per_m2"/>
            </td>
        </xpath>
    </template>
</odoo>
