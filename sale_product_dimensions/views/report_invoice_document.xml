<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Inheriting invoice pdf reports for adding length,width and area along with the product. -->
    <template id="report_invoice_document"
              inherit_id="account.report_invoice_document">
        <xpath expr="//table[contains(@class, 'o_has_total_table')]/thead/tr/th[@name='th_description']"
               position="after">
            <th name="th_length" class="text-end text-nowrap">Length (mm)</th>
            <th name="th_width" class="text-end text-nowrap">Width (mm)</th>
            <th name="th_area" class="text-end text-nowrap">Area (m²)</th>
            <th name="th_price_per_m2" class="text-end text-nowrap">Price / m²
            </th>
        </xpath>
        <xpath expr="//t[@name='account_invoice_line_accountable']/td[@name='account_invoice_line_name']"
               position="after">
            <td class="text-end text-nowrap">
                <span t-field="line.length_mm"/>
            </td>
            <td class="text-end text-nowrap">
                <span t-field="line.width_mm"/>
            </td>
            <td class="text-end text-nowrap">
                <span t-field="line.area_m2"/>
            </td>
            <td class="text-end text-nowrap">
                <span t-field="line.price_per_m2"/>
            </td>
        </xpath>
    </template>
</odoo>
