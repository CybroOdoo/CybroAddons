<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="product_brand_saas.BrandDashboard">
        <div class="o_action_manager w-100 h-100 p-4 overflow-auto brand-dashboard-container" 
             style="padding: 2rem !important;">

            <style>
                .brand-dashboard-container {
                    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                    background-color: #f8fafc !important;
                    color: #0f172a;
                }
                
                /* KPI Card Styles */
                .kpi-card {
                    border: none !important;
                    border-radius: 16px !important;
                    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03) !important;
                    transition: transform 0.25s ease, box-shadow 0.25s ease !important;
                    cursor: pointer;
                    overflow: hidden;
                    position: relative;
                }
                .kpi-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
                }
                
                .kpi-value-stat {
                    background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%) !important; /* Bright Rose */
                    color: #ffffff !important;
                }
                .kpi-brands-stat {
                    background: linear-gradient(135deg, #06b6d4 0%, #0e7490 100%) !important; /* Bright Cyan */
                    color: #ffffff !important;
                }
                .kpi-products-stat {
                    background: linear-gradient(135deg, #10b981 0%, #047857 100%) !important; /* Emerald Green */
                    color: #ffffff !important;
                }
                .kpi-priority-stat {
                    background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%) !important; /* Bright Indigo */
                    color: #ffffff !important;
                }
                
                .kpi-card .kpi-title {
                    font-size: 0.875rem;
                    font-weight: 600;
                    letter-spacing: 0.025em;
                    color: rgba(255, 255, 255, 0.95) !important;
                }
                .kpi-card .kpi-value {
                    font-size: 1.875rem;
                    font-weight: 800;
                    margin-top: 0.5rem;
                    margin-bottom: 0.5rem;
                    color: #ffffff !important;
                }
                .kpi-card .kpi-icon-bg {
                    font-size: 1.1rem;
                    color: #ffffff !important;
                }
                
                /* Modern Card containers for Charts and Tables */
                .dashboard-card {
                    background-color: #ffffff !important;
                    border: none !important;
                    border-radius: 16px !important;
                    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03) !important;
                    padding: 1.5rem !important;
                }
                
                .text-muted-custom {
                    color: #475569 !important;
                }
                .text-dark-custom {
                    color: #0f172a !important;
                }
                .text-secondary-custom {
                    color: #334155 !important;
                }
                
                /* Styled Buttons */
                .btn-action-custom {
                    background-color: #ffffff !important;
                    color: #334155 !important;
                    border: 1px solid #e2e8f0 !important;
                    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
                    border-radius: 8px !important;
                    font-size: 0.8125rem;
                    font-weight: 500;
                    transition: all 0.2s ease;
                }
                .btn-action-custom:hover {
                    background-color: #f8fafc !important;
                    color: #0f172a !important;
                    border-color: #cbd5e1 !important;
                }
                
                /* Table Styling */
                .table-custom th {
                    color: #475569 !important;
                    font-size: 0.75rem !important;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    font-weight: 700 !important;
                    border-bottom: 2px solid #f1f5f9 !important;
                    padding-top: 1rem !important;
                    padding-bottom: 1rem !important;
                }
                .table-custom td {
                    color: #334155 !important;
                    font-size: 0.875rem !important;
                    padding-top: 1rem !important;
                    padding-bottom: 1rem !important;
                    border-bottom: 1px solid #f1f5f9 !important;
                }
                .table-custom tbody tr {
                    transition: background-color 0.15s ease;
                }
                .table-custom tbody tr:hover {
                    background-color: #f8fafc !important;
                }
                
                /* Tab Filters styling */
                .tab-filter {
                    color: #64748b !important;
                    font-weight: 500;
                    cursor: pointer;
                    padding-bottom: 0.75rem;
                    position: relative;
                    transition: color 0.2s ease;
                }
                .tab-filter:hover {
                    color: #0f172a !important;
                }
                .tab-filter.active {
                    color: #6366f1 !important;
                    font-weight: 700;
                }
                .tab-filter.active::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    background-color: #6366f1 !important;
                    border-radius: 9999px;
                }
            </style>

            <!-- Top Dashboard Header with Search and Profile -->
            <div class="d-flex justify-content-between align-items-center mb-4.5" style="margin-bottom: 2rem;">
                <div>
                    <h4 class="fw-bold mb-0 text-dark-custom" style="font-weight: 700; letter-spacing: -0.015em;">Brands Dashboard</h4>
                    <small class="text-muted-custom" style="font-size: 0.78rem;">Home / Brands / Dashboard</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative" style="min-width: 320px;">
                        <span class="position-absolute top-50 translate-middle-y start-0 ps-3 text-muted-custom" style="font-size: 0.85rem; pointer-events: none;">
                            <i class="fa fa-search"/>
                        </span>
                        <input type="text" 
                               class="form-control ps-5 py-2 text-dark-custom bg-white border" 
                               style="border-radius: 8px; font-size: 0.85rem; border-color: #cbd5e1 !important; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);"
                               placeholder="Search brands or codes..." 
                               t-att-value="this.state.searchQuery"
                               t-on-input="this.onSearchInput"/>
                    </div>
                    <button class="btn btn-primary d-flex align-items-center gap-2 px-3.5 py-2" 
                            style="border-radius: 8px; font-size: 0.85rem; font-weight: 600;" 
                            t-on-click="this.createBrand">
                        <i class="fa fa-plus"/> Create Brand
                    </button>
                </div>
            </div>

            <!-- Overview Section Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold text-dark-custom mb-0" style="font-weight: 700;">Performance Overview</h5>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-action-custom px-3.5 py-1.5 d-flex align-items-center gap-2" t-on-click="this.loadData">
                        <i class="fa fa-refresh text-muted-custom"/> Sync Data
                    </button>
                </div>
            </div>

            <!-- Top Row: 4 KPI Cards -->
            <div class="row g-4 mb-4">
                <!-- Card 1: Total Brands -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card kpi-brands-stat p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="d-flex align-items-center gap-2 kpi-title">
                                <i class="fa fa-globe kpi-icon-bg"/> Total Brands
                            </span>
                            <i class="fa fa-info-circle" style="font-size: 0.85rem; opacity: 0.85;" title="Count of registered brand profiles."/>
                        </div>
                        <h3 class="kpi-value" t-out="this.state.stats.totalBrands"/>
                    </div>
                </div>

                <!-- Card 2: Total Categories -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card kpi-value-stat p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="d-flex align-items-center gap-2 kpi-title">
                                <i class="fa fa-folder-open kpi-icon-bg"/> Total Categories
                            </span>
                            <i class="fa fa-info-circle" style="font-size: 0.85rem; opacity: 0.85;" title="Count of registered brand categories."/>
                        </div>
                        <h3 class="kpi-value" t-out="this.state.stats.totalCategories"/>
                    </div>
                </div>

                <!-- Card 3: Associated Products -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card kpi-products-stat p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="d-flex align-items-center gap-2 kpi-title">
                                <i class="fa fa-tags kpi-icon-bg"/> Associated Products
                            </span>
                            <i class="fa fa-info-circle" style="font-size: 0.85rem; opacity: 0.85;" title="Total count of products linked to brands."/>
                        </div>
                        <h3 class="kpi-value" t-out="this.state.stats.totalProducts"/>
                    </div>
                </div>

                <!-- Card 4: Total Tags -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card kpi-priority-stat p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="d-flex align-items-center gap-2 kpi-title">
                                <i class="fa fa-tag kpi-icon-bg"/> Total Tags
                            </span>
                            <i class="fa fa-info-circle" style="font-size: 0.85rem; opacity: 0.85;" title="Count of registered brand tags."/>
                        </div>
                        <h3 class="kpi-value" t-out="this.state.stats.totalTags"/>
                    </div>
                </div>
            </div>

            <!-- Middle Row: Charts -->
            <div class="row g-4 mb-4">
                <!-- Bar Chart: Products by Brand -->
                <div class="col-12 col-xl-7">
                    <div class="card dashboard-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="text-muted-custom small fw-medium" style="font-size: 0.78rem;">Product Distribution</span>
                                <h4 class="fw-bold text-dark-custom mb-0 mt-1" style="font-weight: 800;">Products by Brand</h4>
                            </div>
                        </div>
                        <div class="position-relative" style="height: 250px; width: 100%;">
                            <canvas t-custom-ref="brandBarChart"/>
                        </div>
                    </div>
                </div>
                <!-- Doughnut Chart: Brand Category Wise -->
                <div class="col-12 col-xl-5">
                    <div class="card dashboard-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="text-muted-custom small fw-medium" style="font-size: 0.78rem;">Category Distribution</span>
                                <h4 class="fw-bold text-dark-custom mb-0 mt-1" style="font-weight: 800;">Brands by Category</h4>
                            </div>
                        </div>
                        <div class="position-relative" style="height: 250px; width: 100%;">
                            <canvas t-custom-ref="brandPieChart"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Row: Recent Brands Table -->
            <div class="card dashboard-card">
                <h5 class="fw-bold text-dark-custom mb-4" style="font-weight: 700;">Brand Directory</h5>

                <!-- Filter Header -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
                    <!-- Filter Tabs -->
                    <div class="d-flex gap-4" style="font-size: 0.88rem;">
                        <span t-attf-class="tab-filter {{ this.state.filterStage == 'all' ? 'active' : '' }}"
                              t-on-click="() => this.changeFilterStage('all')">All Brands</span>
                        <t t-foreach="this.state.stages" t-as="stage" t-key="stage.id">
                            <span t-attf-class="tab-filter {{ this.state.filterStage == stage.id ? 'active' : '' }}"
                                  t-on-click="() => this.changeFilterStage(stage.id)">
                                <t t-out="stage.x_name"/>
                            </span>
                        </t>
                    </div>
                </div>

                <!-- Custom Table -->
                <div class="table-responsive">
                    <table class="table table-custom align-middle mb-0" style="cursor: pointer;">
                        <thead>
                            <tr>
                                <th class="py-3">Brand Name</th>
                                <th class="py-3">Code</th>
                                <th class="py-3">Category</th>
                                <th class="py-3 text-center">Products Linked</th>
                                <th class="py-3 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="filteredBrands" t-value="this.getFilteredBrands()"/>
                            <t t-if="filteredBrands.length == 0">
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted-custom small">No records found.</td>
                                </tr>
                            </t>
                            <t t-else="">
                                <t t-foreach="filteredBrands" t-as="brand" t-key="brand.id">
                                    <tr t-on-click="() => this.openBrand(brand.id)">
                                        <!-- Brand Name -->
                                        <td class="py-3.5">
                                            <span class="fw-semibold text-dark-custom" style="font-size: 0.88rem;" t-out="brand.x_name"/>
                                        </td>
                                        <!-- Code -->
                                        <td class="py-3.5 text-secondary-custom" style="font-size: 0.85rem;" t-out="brand.x_studio_brand_code || 'N/A'"/>
                                        <!-- Category -->
                                        <td class="py-3.5 text-secondary-custom" style="font-size: 0.85rem;" t-out="brand.x_studio_category ? brand.x_studio_category[1] : 'Uncategorized'"/>
                                        <!-- Products Linked -->
                                        <td class="py-3.5 text-center text-dark-custom fw-semibold" style="font-size: 0.85rem;" t-out="brand.x_x_studio_brands_product_template_count || 0"/>
                                        <!-- Status Badge -->
                                        <td class="py-3.5 text-center">
                                            <t t-set="stageName" t-value="brand.x_studio_stage_id ? brand.x_studio_stage_id[1] : 'New'"/>
                                            <span class="badge px-3 py-1.5 rounded-pill" 
                                                  t-att-style="this.getStageBadgeStyle(stageName)">
                                                • <t t-out="stageName"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Footer pagination UI -->
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top" style="font-size: 0.8rem;">
                    <span class="text-secondary-custom">Showing 1 to <t t-out="filteredBrands.length"/> of <t t-out="filteredBrands.length"/> results</span>
                </div>
            </div>

        </div>
    </t>
</templates>
