  <record id="odoo_studio_studio_c_980c2e55-0ba3-4369-8257-25ef90326602" model="ir.ui.view" context="{'studio': True}">
    <field name="arch" type="xml">
      <data>
        <xpath expr="/t[@t-name='studio_report_document']//t[@t-call='web.external_layout']" position="replace" meta-t-call="web.external_layout">
          <t t-call="web.external_layout">
            <div class="page">
              <!-- Standard Studio drop zone -->
              <div class="oe_structure"/>
              <!-- Standard Odoo Header Title -->
              <h2 class="mt-4 mb-4">Brand Details: 
                <span t-field="doc.x_name"/>
        </h2>
              <!-- Standard Odoo Info Grid -->
              <div class="row mt32 mb32" id="informations">
                <!-- Brand Name -->
                <div t-if="doc.x_name" class="col-auto col-3 mw-100 mb-2">
                  <strong>Brand Name:</strong>
                  <p class="m-0" t-field="doc.x_name"/>
                </div>
                <!-- Brand Code -->
                <div t-if="doc.x_studio_brand_code" class="col-auto col-3 mw-100 mb-2">
                  <strong>Brand Code:</strong>
                  <p class="m-0" t-field="doc.x_studio_brand_code"/>
                </div>
                <!-- Category -->
                <div t-if="doc.x_studio_category" class="col-auto col-3 mw-100 mb-2">
                  <strong>Category:</strong>
                  <p class="m-0" t-field="doc.x_studio_category"/>
                </div>
                <!-- Brand Tags -->
                <div t-if="doc.x_studio_many2many_1" class="col-auto col-3 mw-100 mb-2">
                  <strong>Brand Tags:</strong>
                  <div class="mt-1">
                    <t t-foreach="doc.x_studio_many2many_1" t-as="tag">
                      <span class="badge rounded-pill bg-light text-dark border px-2 py-1 me-1 mb-1" style="font-size: 0.85rem; font-weight: 500;">
                        <span t-field="tag.display_name"/>
                      </span>
                    </t>
                  </div>
                </div>
              </div>
              <!-- Standard Studio drop zone -->
              <div class="oe_structure"/>
              <!-- Associated Products Section Title with a Divider Line -->
              <h4 class="mt-4 mb-3" style="font-weight: bold; border-bottom: 2px solid #dee2e6; padding-bottom: 8px; color: #212529;">
            Associated Products
        </h4>
              <!-- Professional Table Layout -->
              <table class="table table-sm o_main_table mt-3">
                <thead>
                  <!-- bg-100 adds a standard light-gray block background for the headers -->
                  <tr class="bg-100">
                    <th name="th_index" class="text-center" style="width: 10%; font-weight: bold; text-transform: uppercase; font-size: 0.8rem; color: #495057;">#</th>
                    <th name="th_product" class="text-start" style="font-weight: bold; text-transform: uppercase; font-size: 0.8rem; color: #495057;">Product</th>
                  </tr>
                </thead>
                <tbody class="tbody">
                  <t t-foreach="doc.x_studio_products" t-as="product">
                    <tr class="align-middle">
                      <!-- Centered and muted index number -->
                      <td class="text-center text-muted" style="font-size: 0.95rem; font-weight: 500;">
                        <span t-esc="product_index + 1"/>
                      </td>
                      <!-- Clean, clear product name -->
                      <td class="text-start" style="font-size: 0.95rem; font-weight: 500; color: #212529;">
                        <span t-field="product.display_name"/>
                      </td>
                    </tr>
                  </t>
                </tbody>
              </table>
              <!-- Standard Studio drop zone -->
              <div class="oe_structure"/>
            </div>
          </t>
        </xpath>
      </data>
    </field>
    <field name="inherit_id" ref="studio_report_docume_17f922ce-9ac0-4648-982a-8f80573f72e1"/>
    <field name="key">web_studio.report_editor_customization_diff.view.product_brand_saas.studio_report_docume_17f922ce-9ac0-4648-982a-8f80573f72e1_document</field>
