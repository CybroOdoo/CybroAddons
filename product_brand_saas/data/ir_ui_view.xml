  <record id="default_kanban_view__938cf313-db2e-4bce-897e-eec7eb89fd10" model="ir.ui.view" context="{'studio': True}">
    <field name="arch" type="xml">
      <kanban default_group_by="x_studio_stage_id" highlight_color="x_color" sample="1">
        <field name="x_color"/>
        <field name="x_studio_brand_code"/>
        <field name="x_studio_category"/>
        <field name="x_studio_many2many_1"/>
        <field name="x_x_studio_brands_product_template_count"/>
        <field name="activity_ids"/>
        <field name="activity_state"/>
        <progressbar field="x_studio_kanban_state" colors="{&quot;normal&quot;: &quot;200&quot;, &quot;done&quot;: &quot;success&quot;, &quot;blocked&quot;: &quot;danger&quot;}"/>
        <templates>
          <t t-name="menu">
            <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
            <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
            <field widget="kanban_color_picker" name="x_color"/>
          </t>
          <t t-name="card" class="flex-row">
            <aside class="pe-2">
              <field name="x_studio_image" widget="image" options="{&quot;zoom&quot;: true, &quot;background&quot;: true, &quot;preventClicks&quot;: false}" class="o_kanban_image_large"/>
            </aside>
            <main class="w-100 ps-1">
              <div name="studio_auto_kanban_header" class="d-flex align-items-baseline justify-content-between mb-1">
                <div class="d-flex align-items-center gap-1">
                  <span class="h5 fw-bold text-truncate mb-0"><field name="x_name"/></span>
                </div>
                <span class="badge text-bg-light border text-muted" style="font-size: 0.7rem; font-weight: 500;" t-if="record.x_studio_brand_code.raw_value">
                  <field name="x_studio_brand_code"/>
                </span>
              </div>
              <div class="mb-1 text-muted" style="font-size: 0.85rem;" t-if="record.x_studio_category.raw_value">
                <i class="fa fa-folder-open-o me-1" title="Category"/>
                <field name="x_studio_category"/>
              </div>
              <div class="mb-2" t-if="record.x_studio_many2many_1.raw_value">
                <field name="x_studio_many2many_1" widget="many2many_tags"/>
              </div>
              <footer class="d-flex align-items-center justify-content-between pt-1 border-top">
                <div class="d-flex align-items-center gap-1 text-primary" style="font-size: 0.82rem; font-weight: 500;" t-if="record.x_x_studio_brands_product_template_count.raw_value">
                  <i class="fa fa-cubes" title="Products Count"/>
                  <span class="fw-bold"><field name="x_x_studio_brands_product_template_count"/></span> products
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                  <field name="activity_ids" widget="kanban_activity"/>
                  <field name="x_studio_kanban_state" widget="state_selection"/>
                </div>
              </footer>
            </main>
          </t>
        </templates>
      </kanban>
    </field>
    <field name="key">product_brand_saas.default_kanban_view__938cf313-db2e-4bce-897e-eec7eb89fd10</field>
    <field name="model">x_brands</field>
    <field name="name">Default kanban view for x_brands</field>
    <field name="type">kanban</field>
  </record>
