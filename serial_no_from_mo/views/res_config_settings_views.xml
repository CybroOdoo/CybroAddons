<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- This XML configuration extends the Odoo settings view for Manufacturing
    Configuration. It introduces a new section for Serial Number Selection
    settings. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.serial.no.from.mo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="process_mrp_barcodes" position="before">
                <setting id="serial_no_sel" string="Serial Number Selection" help="Allow manufacturing users to add lot/serial sequences">
                    <field name="is_serial_selection"/>
                    <div class="content-group" invisible="not is_serial_selection">
                        <div class="mt16">
                            <label for="serial_selection" string="Choose Method" class="o_form_label d-block"/>
                            <field name="serial_selection" widget="radio" class="o_light_label mt4"/>
                        </div>
                        <div class="mt16" invisible="serial_selection != 'global'">
                            <label for="mo_serial_digit" class="o_form_label d-block"/>
                            <field name="mo_serial_digit" class="mt4"/>
                        </div>
                        <div class="mt16" invisible="serial_selection != 'global'">
                            <label for="mo_serial_prefix" class="o_form_label d-block"/>
                            <field name="mo_serial_prefix" class="mt4"/>
                        </div>
                        <div class="mt8" invisible="serial_selection != 'product_wise'">
                            <button name="%(product.product_template_action)d"
                                    icon="oi-arrow-right" type="action"
                                    string="Configure on Products" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
