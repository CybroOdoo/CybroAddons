<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Pantry deduction salary rule -->
        <record id="pantry_rule" model="hr.salary.rule">
            <field name="code">PR</field>
            <field name="name">Pantry</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.PR and - (inputs.PR.amount)</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="sequence" eval="190"/>
        </record>
        <!-- Input used by the rule, filled with the pantry orders of the period -->
        <record id="pantry_rule_input" model="hr.rule.input">
            <field name="code">PR</field>
            <field name="name">Pantry</field>
            <field name="input_id" ref="pantry_rule"/>
        </record>
        <!-- Add the rule to the base salary structure. Child structures
             inherit the rules of their parent structure. -->
        <record id="hr_payroll_community.structure_base" model="hr.payroll.structure">
            <field name="rule_ids" eval="[(4, ref('pantry_rule'))]"/>
        </record>
    </data>
</odoo>
