<?xml version="1.0" encoding="UTF-8" ?>
<templates id="responsive_web" xml:space="preserve">
    <!-- Adding new attribute to o_pivot class div -->
    <t t-name="responsive_web.PivotRenderer" t-inherit="web.PivotRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pivot')]" position="attributes">
            <attribute name="style">overflow-x:unset</attribute>
        </xpath>
    </t>
</templates>

