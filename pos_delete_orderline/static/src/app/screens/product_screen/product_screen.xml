<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Template for adding clear icon in orderline -->
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//li" position="inside">
            <i class="fa fa-times-circle text-danger delete-orderline-icon"
               style="cursor: pointer; font-size: 1.0em; margin-left: auto; margin-right: 10px;"
               t-on-click.stop="() => window.posDeleteOrderLine(props.line.id, env.services.pos)"/>
        </xpath>
    </t>
</templates>