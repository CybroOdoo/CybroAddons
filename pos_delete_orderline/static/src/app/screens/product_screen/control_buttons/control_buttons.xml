<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Clear All button next to the Note button of the product screen. -->
    <t t-name="pos_delete_orderline.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//InternalNoteButton" position="after">
            <button class="o_pos_clear_lines_btn btn btn-secondary btn-lg lh-lg text-danger"
                    t-att-disabled="this.pos.getOrder()?.isEmpty()"
                    t-on-click="() => this.onClickClearLines()">
                <i class="oi me-1" data-icon="ink_eraser" aria-hidden="true"/>Clear All
            </button>
        </xpath>
    </t>
</templates>
