<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Mark the cart lines so only they show the delete button, not the
    lines of receipts, the orders list or the customer display. -->
    <t t-name="pos_delete_orderline.OrderSummary"
       t-inherit="point_of_sale.OrderSummary"
       t-inherit-mode="extension">
        <xpath expr="//Orderline" position="attributes">
            <attribute name="class">{'o_pos_delete_orderline': true}</attribute>
        </xpath>
    </t>
</templates>
