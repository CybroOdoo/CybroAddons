<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_delete_orderline.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//InternalNoteButton" position="after">
            <button class="btn btn-light text-bg-danger border-0"
                    style="font-size: 1rem; padding: 0.2rem 0.3rem;"
                    t-on-click="() => this.onClearLines()">
                <i class="fa fa-eraser"/> Clear All
            </button>
        </xpath>
    </t>
</templates>