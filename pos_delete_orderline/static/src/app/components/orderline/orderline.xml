<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Delete button at the end of each cart line. Pointer events are
    stopped so pressing it does not also select or long-press the line. -->
    <t t-name="pos_delete_orderline.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">
        <xpath expr="//li[hasclass('orderline')]" position="inside">
            <button t-if="this.showDeleteButton"
                    class="o_pos_delete_orderline_btn btn btn-link flex-shrink-0 px-2"
                    title="Remove line" aria-label="Remove line"
                    t-on-pointerdown.stop="() => {}"
                    t-on-pointerup.stop="() => {}"
                    t-on-click.stop="() => this.onClickDeleteLine()">
                <i class="oi text-danger" data-icon="cancel" aria-hidden="true"/>
            </button>
        </xpath>
    </t>
</templates>
