<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
	<t t-name="pos_all_orders.CustomALLOrdrScreen" owl="1">
		<div class="ticket-screen screen h-100 bg-100">
			<div class="screen-full-width d-flex w-100 h-100">
				<div class="rightpane pane-border d-flex flex-column flex-grow-1 w-100 h-100 bg-view">
					<div class="controls d-flex align-items-center justify-content-between p-2 border-bottom bg-view">
						<div class="buttons d-flex gap-2">
							<button class="btn btn-lg btn-secondary" t-on-click="back">
								<i class="oi oi-chevron-left me-1"/>
								Back
							</button>
						</div>
						<div class="fs-4 fw-bold">All Orders</div>
						<div/> <!-- Spacer -->
					</div>
					<div class="orders overflow-y-auto flex-grow-1">
						<table class="table table-striped table-hover">
							<thead class="sticky-top bg-view border-bottom">
								<tr class="text-bg-700 fw-bolder">
									<th class="p-2">Order Reference</th>
									<th class="p-2">Receipt Reference</th>
									<th class="p-2">Customer</th>
									<th class="p-2">Order Date</th>
								</tr>
							</thead>
							<tbody>
								<t t-foreach="this.state.order" t-as="order" t-key="order.id">
									<tr class="order-row">
										<td class="p-2 align-middle">
											<div class="fw-bolder" t-esc="order.pos_reference"/>
										</td>
										<td class="p-2 align-middle">
											<div t-esc="order.name"/>
										</td>
										<td class="p-2 align-middle">
											<div t-esc="order.partner_id or ''"/>
										</td>
										<td class="p-2 align-middle text-muted small">
											<div t-esc="order.date_order"/>
										</td>
									</tr>
								</t>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</t>
</templates>