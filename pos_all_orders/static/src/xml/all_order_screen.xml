<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
	<t t-name="pos_all_orders.CustomALLOrdrScreen">
		<div class="ticket-screen screen h-100 bg-100">
			<div class="screen-full-width d-flex w-100 h-100">
				<div class="rightpane pane-border d-flex flex-column flex-grow-1 w-100 h-100 bg-view">
					<div class="controls d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 border-bottom bg-view">
						<div class="buttons d-flex align-items-center gap-2">
							<button class="btn btn-lg btn-secondary d-flex align-items-center" t-on-click="() => this.back()">
								<i class="oi oi-chevron-left me-1"/>
								<span>Back</span>
							</button>
							<div class="fs-4 fw-bold ms-2 d-flex align-items-center gap-2">
								<span>All Orders</span>
								<span class="badge rounded-pill text-bg-primary fs-6" t-out="this.filteredOrders.length"/>
							</div>
						</div>

						<div class="search-bar-container d-flex align-items-center flex-grow-1 mx-2" style="max-width: 420px;">
							<div class="input-group">
								<span class="input-group-text bg-view border-end-0">
									<i class="oi" data-icon="search"/>
								</span>
								<input
									type="text"
									class="form-control border-start-0 shadow-none"
									placeholder="Search reference, customer, date..."
									t-att-value="this.state.searchWord"
									t-on-input="(ev) => this.onSearchInput(ev)"
								/>
								<button
									t-if="this.state.searchWord"
									class="btn btn-outline-secondary border-start-0"
									t-on-click="() => this.clearSearch()"
									title="Clear search"
								>
									<i class="oi oi-close"/>
								</button>
							</div>
						</div>

						<div class="d-flex align-items-center gap-2">
							<button class="btn btn-lg btn-secondary d-flex align-items-center gap-1" t-on-click="() => this.loadOrders()" title="Refresh Orders">
								<i class="oi" data-icon="refresh" aria-hidden="true"/>
								<span class="d-none d-sm-inline">Refresh</span>
							</button>
						</div>
					</div>

					<div t-if="this.state.loading" class="d-flex flex-column align-items-center justify-content-center p-5 text-muted flex-grow-1">
						<div class="spinner-border text-primary mb-3" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
						<div class="fs-5">Loading orders...</div>
					</div>

					<div t-else="" class="orders overflow-y-auto flex-grow-1">
						<table class="table table-striped table-hover align-middle mb-0">
							<thead class="sticky-top bg-view border-bottom">
								<tr class="text-bg-700 fw-bolder">
									<th class="p-3">Order Reference</th>
									<th class="p-3">Receipt Reference</th>
									<th class="p-3">Customer</th>
									<th class="p-3">Order Date</th>
									<th class="p-3 text-end">Total</th>
									<th class="p-3 text-center">Status</th>
								</tr>
							</thead>
							<tbody>
								<t t-foreach="this.filteredOrders" t-as="order" t-key="order.id">
									<tr class="order-row">
										<td class="p-3">
											<div class="fw-bold" t-out="order.pos_reference"/>
										</td>
										<td class="p-3">
											<div t-out="order.name"/>
										</td>
										<td class="p-3">
											<div t-out="order.partner_id || '-'"/>
										</td>
										<td class="p-3 text-muted small">
											<div t-out="order.date_order"/>
										</td>
										<td class="p-3 text-end fw-bold">
											<span t-out="this.formatOrderTotal(order.total)"/>
										</td>
										<td class="p-3 text-center">
											<span t-attf-class="badge text-uppercase {{ this.getStatusBadgeClass(order.state) }}" t-out="order.state"/>
										</td>
									</tr>
								</t>
								<tr t-if="!this.filteredOrders.length">
									<td colspan="6" class="text-center p-5 text-muted">
										<div class="fs-5 mb-1">No orders found</div>
										<div class="small" t-if="this.state.searchWord">No orders match "<t t-out="this.state.searchWord"/>"</div>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</t>
</templates>