<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Template for adding clear all button in pos -->
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='!this.props.showRemainingButtons']//InternalNoteButton" position="after">
           <button class="btn btn-secondary btn-lg lh-lg text-truncate w-auto" t-on-click="() => this.onAllOrdersClick()">
                 <i class="oi me-1" data-icon="receipt_long" aria-hidden="true"/>
                 <span>All Orders</span>
           </button>
        </xpath>
   </t>
</templates>