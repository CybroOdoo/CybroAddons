<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dynamic_link_snippet.DynamicLinkOption">
        <BuilderRow label.translate="Enter Link">
            <BuilderTextInput action="'dynamicLink'" placeholder.translate="Paste a page or video link"/>
        </BuilderRow>
    </t>

    <t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
        <xpath expr="//t[@id='snippet_specific_options']" position="after">
            <dynamic_link_option selector=".s_dynamic_link"/>
        </xpath>
    </t>
</templates>
