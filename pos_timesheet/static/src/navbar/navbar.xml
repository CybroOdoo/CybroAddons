<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-name="pos_timesheet.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//CashierName" position="before">
            <div t-if="this.pos?.config?.module_pos_hr and this.pos?.config?.time_log" class="d-flex flex-column align-items-center justify-content-center me-3 text-nowrap" style="line-height: 1.25;">
                <div class="fw-bolder text-primary text-center fs-5 mb-1">
                    <span t-out="this.totalWorkedTime"/>
                </div>
                <div class="text-secondary d-flex align-items-center justify-content-center gap-1" style="font-size: 0.85rem;">
                    <span>Last checked in</span>
                    <span class="fw-bold text-dark fs-6 ms-1" t-out="this.checkInTime"/>
                    <span class="badge bg-primary-subtle text-primary fw-bolder ms-1" style="font-size: 1.15rem; padding: 0.25rem 0.5rem;" t-out="this.workedTime"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>