<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Sequence for Bookings -->
        <record id="hotel_management_saas.seq_x_booking" model="ir.sequence">
            <field name="name">Hotel Booking Sequence</field>
            <field name="code">x_booking.sequence</field>
            <field name="prefix">BKG-</field>
            <field name="padding">4</field>
            <field name="number_next">1001</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Folios -->
        <record id="hotel_management_saas.seq_x_folios" model="ir.sequence">
            <field name="name">Hotel Folio Sequence</field>
            <field name="code">x_folios.sequence</field>
            <field name="prefix">FOL-</field>
            <field name="padding">4</field>
            <field name="number_next">1001</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
