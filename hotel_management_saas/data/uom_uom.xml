<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <record id="uom.product_uom_hour" model="uom.uom" forcecreate="1">
    <field name="name">Hours</field>
    <field name="sequence">100</field>
    <field name="factor">1.0</field>
    <field name="unece_code">HUR</field>
  </record>
  <record id="uom.product_uom_minute" model="uom.uom" forcecreate="1">
    <field name="name">Minutes</field>
    <field name="relative_factor">0.0166667</field>
    <field name="sequence">1</field>
    <field name="relative_uom_id" ref="uom.product_uom_hour"/>
    <field name="factor">0.0166667</field>
    <field name="unece_code">MIN</field>
  </record>
  <record id="uom.product_uom_unit" model="uom.uom" forcecreate="1">
    <field name="name">Units</field>
    <field name="sequence">100</field>
    <field name="factor">1.0</field>
    <field name="unece_code">C62</field>
  </record>
  <record id="uom.product_uom_millimeter" model="uom.uom" forcecreate="1">
    <field name="name">mm</field>
    <field name="sequence">100</field>
    <field name="factor">1.0</field>
    <field name="unece_code">MMT</field>
  </record>
  <record id="uom.product_uom_square_meter" model="uom.uom" forcecreate="1">
    <field name="name">m²</field>
    <field name="sequence">100</field>
    <field name="factor">1.0</field>
    <field name="unece_code">MTK</field>
  </record>
  <record id="uom.product_uom_milliliter" model="uom.uom" forcecreate="1">
    <field name="name">ml</field>
    <field name="sequence">100</field>
    <field name="factor">1.0</field>
    <field name="unece_code">MLT</field>
  </record>
  <record id="uom.product_uom_gram" model="uom.uom" forcecreate="1">
    <field name="name">g</field>
    <field name="sequence">100</field>
    <field name="factor">1.0</field>
    <field name="unece_code">GRM</field>
  </record>
  <record id="uom.product_uom_kwh" model="uom.uom" forcecreate="1">
    <field name="name">KWH</field>
    <field name="sequence">100</field>
    <field name="factor">1.0</field>
    <field name="unece_code">KWH</field>
  </record>
  <record id="uom.product_uom_pack_6" model="uom.uom" forcecreate="1">
    <field name="name">Pack of 6</field>
    <field name="relative_factor">6.0</field>
    <field name="sequence">600</field>
    <field name="relative_uom_id" ref="uom.product_uom_unit"/>
    <field name="factor">6.0</field>
    <field name="unece_code">P6</field>
  </record>
  <record id="uom.product_uom_day" model="uom.uom" forcecreate="1">
    <field name="name">Days</field>
    <field name="relative_factor">8.0</field>
    <field name="sequence">800</field>
    <field name="relative_uom_id" ref="uom.product_uom_hour"/>
    <field name="factor">8.0</field>
    <field name="unece_code">DAY</field>
  </record>
  <record id="uom.product_uom_litre" model="uom.uom" forcecreate="1">
    <field name="name">L</field>
    <field name="relative_factor">1000.0</field>
    <field name="sequence">1000</field>
    <field name="relative_uom_id" ref="uom.product_uom_milliliter"/>
    <field name="factor">1000.0</field>
    <field name="unece_code">LTR</field>
  </record>
  <record id="uom.product_uom_kgm" model="uom.uom" forcecreate="1">
    <field name="name">kg</field>
    <field name="relative_factor">1000.0</field>
    <field name="sequence">1000</field>
    <field name="relative_uom_id" ref="uom.product_uom_gram"/>
    <field name="factor">1000.0</field>
    <field name="unece_code">KGM</field>
  </record>
  <record id="uom.product_uom_meter" model="uom.uom" forcecreate="1">
    <field name="name">m</field>
    <field name="relative_factor">100.0</field>
    <field name="sequence">1000</field>
    <field name="relative_uom_id" ref="uom.product_uom_cm"/>
    <field name="factor">1000.0</field>
    <field name="unece_code">MTR</field>
  </record>
  <record id="uom.product_uom_ton" model="uom.uom" forcecreate="1">
    <field name="name">t</field>
    <field name="relative_factor">1000.0</field>
    <field name="sequence">1000</field>
    <field name="relative_uom_id" ref="uom.product_uom_kgm"/>
    <field name="factor">1000000.0</field>
    <field name="unece_code">TNE</field>
  </record>
</odoo>
