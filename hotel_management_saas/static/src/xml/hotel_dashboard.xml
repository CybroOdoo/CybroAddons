<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="hotel_management_saas.HotelDashboard">
        <div class="o_action_manager w-100 h-100 p-4 overflow-auto hotel-dashboard-container" 
             style="padding: 2rem !important;">

            <style>
                /* Custom CSS for Hotel Booking Dashboard */
                .hotel-dashboard-container {
                    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                    background-color: #f8fafc !important; /* Lighter, cleaner background */
                    color: #0f172a;
                }
                
                /* KPI Card Styles */
                .kpi-card {
                    border: none !important;
                    border-radius: 16px !important;
                    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03) !important;
                    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
                    cursor: pointer;
                    overflow: hidden;
                    position: relative;
                }
                .kpi-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
                }
                
                /* KPI card gradients and text colors */
                .kpi-revenue {
                    background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%) !important; /* Teal */
                    color: #ffffff !important;
                }
                .kpi-bookings {
                    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important; /* Royal Blue */
                    color: #ffffff !important;
                }
                .kpi-guests {
                    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%) !important; /* Violet */
                    color: #ffffff !important;
                }
                .kpi-rooms {
                    background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%) !important; /* Orange/Amber */
                    color: #ffffff !important;
                }
                
                /* Card Text Styling for high visibility */
                .kpi-card .kpi-title {
                    font-size: 0.875rem;
                    font-weight: 600;
                    letter-spacing: 0.025em;
                    color: rgba(255, 255, 255, 0.95) !important;
                }
                .kpi-card .kpi-value {
                    font-size: 1.875rem;
                    font-weight: 800;
                    margin-top: 0.5rem;
                    margin-bottom: 0.5rem;
                    color: #ffffff !important;
                }
                .kpi-card .kpi-badge {
                    display: inline-flex;
                    align-items: center;
                    padding: 0.25rem 0.625rem;
                    border-radius: 9999px;
                    font-size: 0.75rem;
                    font-weight: 600;
                    background-color: rgba(255, 255, 255, 0.2) !important;
                    color: #ffffff !important;
                    backdrop-filter: blur(4px);
                }
                .kpi-card .kpi-icon-bg {
                    font-size: 1.1rem;
                    color: #ffffff !important;
                }
                
                /* Modern Card containers for Charts and Tables */
                .dashboard-card {
                    background-color: #ffffff !important;
                    border: none !important;
                    border-radius: 16px !important;
                    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03) !important;
                    padding: 1.5rem !important;
                }
                
                /* Text elements contrast styling */
                .text-muted-custom {
                    color: #475569 !important; /* Slate 600 - much more readable than standard text-muted */
                }
                .text-dark-custom {
                    color: #0f172a !important; /* Slate 900 - very crisp */
                }
                .text-secondary-custom {
                    color: #334155 !important; /* Slate 700 */
                }
                
                /* Styled Buttons */
                .btn-action-custom {
                    background-color: #ffffff !important;
                    color: #334155 !important;
                    border: 1px solid #e2e8f0 !important;
                    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
                    border-radius: 8px !important;
                    font-size: 0.8125rem;
                    font-weight: 500;
                    transition: all 0.2s ease;
                }
                .btn-action-custom:hover {
                    background-color: #f8fafc !important;
                    color: #0f172a !important;
                    border-color: #cbd5e1 !important;
                }
                
                /* Table Styling */
                .table-custom th {
                    color: #475569 !important;
                    font-size: 0.75rem !important;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    font-weight: 700 !important;
                    border-bottom: 2px solid #f1f5f9 !important;
                    padding-top: 1rem !important;
                    padding-bottom: 1rem !important;
                }
                .table-custom td {
                    color: #334155 !important;
                    font-size: 0.875rem !important;
                    padding-top: 1rem !important;
                    padding-bottom: 1rem !important;
                    border-bottom: 1px solid #f1f5f9 !important;
                }
                .table-custom tbody tr {
                    transition: background-color 0.15s ease;
                }
                .table-custom tbody tr:hover {
                    background-color: #f8fafc !important;
                }
                
                /* Tab Filters styling */
                .tab-filter {
                    color: #64748b !important;
                    font-weight: 500;
                    cursor: pointer;
                    padding-bottom: 0.75rem;
                    position: relative;
                    transition: color 0.2s ease;
                }
                .tab-filter:hover {
                    color: #0f172a !important;
                }
                .tab-filter.active {
                    color: #2563eb !important;
                    font-weight: 700;
                }
                .tab-filter.active::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    background-color: #2563eb !important;
                    border-radius: 9999px;
                }
            </style>

            <!-- Top Dashboard Header with Search and Profile -->
            <div class="d-flex justify-content-between align-items-center mb-4.5" style="margin-bottom: 2rem;">
                <div>
                    <h4 class="fw-bold mb-0 text-dark-custom" style="font-weight: 700; letter-spacing: -0.015em;">Dashboard</h4>
                    <small class="text-muted-custom" style="font-size: 0.78rem;">Home / Dashboard</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative" style="min-width: 320px;">
                        <span class="position-absolute top-50 translate-middle-y start-0 ps-3 text-muted-custom" style="font-size: 0.85rem; pointer-events: none;">
                            <i class="fa fa-search"/>
                        </span>
                        <input type="text" 
                               class="form-control ps-5 py-2 text-dark-custom bg-white border shadow-sm" 
                               style="border-radius: 8px; font-size: 0.85rem; border-color: #cbd5e1 !important;"
                               placeholder="Search bookings..." 
                               t-att-value="this.state.searchQuery"
                               t-on-input="this.onSearchInput"/>
                    </div>
                </div>
            </div>

            <!-- Dashboard Filter Banner and Overview title -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold text-dark-custom mb-0" style="font-weight: 700;">Overview</h5>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-action-custom px-3.5 py-1.5 d-flex align-items-center gap-2">
                        02 Feb 2026 - 07 March <i class="fa fa-calendar text-muted-custom"/>
                    </button>
                    <button class="btn btn-action-custom px-3.5 py-1.5 d-flex align-items-center gap-2" t-on-click="this.loadData">
                        <i class="fa fa-download text-muted-custom"/> Export
                    </button>
                </div>
            </div>

            <!-- Top Row: 4 KPI Cards -->
            <div class="row g-4 mb-4">
                <!-- Card 1: Booking Revenue -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card kpi-revenue p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="d-flex align-items-center gap-2 kpi-title">
                                <i class="fa fa-credit-card kpi-icon-bg"/> Booking Revenue
                            </span>
                            <i class="fa fa-question-circle-o" style="font-size: 0.85rem; opacity: 0.85;"/>
                        </div>
                        <h3 class="kpi-value" t-out="this.formatCurrency(this.currentStats.totalRevenue)"/>
                    </div>
                </div>

                <!-- Card 2: Bookings -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card kpi-bookings p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="d-flex align-items-center gap-2 kpi-title">
                                <i class="fa fa-bookmark-o kpi-icon-bg"/> Total Bookings
                            </span>
                            <i class="fa fa-question-circle-o" style="font-size: 0.85rem; opacity: 0.85;"/>
                        </div>
                        <h3 class="kpi-value" t-out="this.currentStats.totalBookings"/>
                    </div>
                </div>

                <!-- Card 3: Today's Bookings -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card kpi-guests p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="d-flex align-items-center gap-2 kpi-title">
                                <i class="fa fa-calendar kpi-icon-bg"/> Today's Bookings
                            </span>
                            <i class="fa fa-question-circle-o" style="font-size: 0.85rem; opacity: 0.85;"/>
                        </div>
                        <h3 class="kpi-value" t-out="this.currentStats.todayBookings"/>
                    </div>
                </div>

                <!-- Card 4: Today's Checkout -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card kpi-card kpi-rooms p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="d-flex align-items-center gap-2 kpi-title">
                                <i class="fa fa-sign-out kpi-icon-bg"/> Today's Checkout
                            </span>
                            <i class="fa fa-question-circle-o" style="font-size: 0.85rem; opacity: 0.85;"/>
                        </div>
                        <h3 class="kpi-value" t-out="this.currentStats.todayCheckouts"/>
                    </div>
                </div>
            </div>

            <!-- Middle Row: Charts -->
            <div class="row g-4 mb-4">
                <!-- Left Column (Bar Chart): Total Booking -->
                <div class="col-12 col-xl-7">
                    <div class="card dashboard-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="text-muted-custom small fw-medium" style="font-size: 0.78rem;">Total Booking Revenue</span>
                                <h3 class="fw-bold text-dark-custom mb-0 mt-1" style="font-weight: 800; font-size: 1.6rem;" t-out="this.formatCurrency(this.state.stats.totalRevenue)"/>
                                <span class="text-success small fw-semibold" style="font-size: 0.72rem;">
                                    <t t-out="this.state.stats.revenueGrowthPercent"/> from last month
                                </span>
                            </div>
                            <div class="btn-group shadow-sm rounded overflow-hidden" style="border: 1px solid #E2E8F0;">
                                <button t-attf-class="btn btn-sm py-1 px-3 border-0 {{ this.state.chartMode === 'daily' ? 'btn-primary text-white' : 'bg-white text-dark' }}"
                                        style="font-size: 0.75rem; font-weight: 600; cursor: pointer;"
                                        t-on-click="() => this.changeChartMode('daily')">Daily</button>
                                <button t-attf-class="btn btn-sm py-1 px-3 border-0 {{ this.state.chartMode === 'monthly' ? 'btn-primary text-white' : 'bg-white text-dark' }}"
                                        style="font-size: 0.75rem; font-weight: 600; cursor: pointer;"
                                        t-on-click="() => this.changeChartMode('monthly')">Monthly</button>
                            </div>
                        </div>
                        <div class="position-relative" style="height: 240px; width: 100%;">
                            <canvas t-custom-ref="hotelBarChart"/>
                        </div>
                    </div>
                </div>

                <!-- Right Column (Line Chart): Booking Revenue -->
                <div class="col-12 col-xl-5">
                    <div class="card dashboard-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="text-muted-custom small fw-medium" style="font-size: 0.78rem;">Revenue by Room Type</span>
                                <h3 class="fw-bold text-dark-custom mb-0 mt-1" style="font-weight: 800; font-size: 1.5rem;" t-out="this.formatCurrency(this.state.stats.totalRevenue)"/>
                                <span class="text-success small fw-semibold" style="font-size: 0.72rem;">
                                    <t t-out="this.state.stats.revenueGrowthPercent"/> from last month
                                </span>
                            </div>
                        </div>
                        <div class="position-relative" style="height: 240px; width: 100%;">
                            <canvas t-custom-ref="hotelLineChart"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Row: Recent Bookings Table -->
            <div class="card dashboard-card">
                
                <h5 class="fw-bold text-dark-custom mb-4" style="font-weight: 700;">Recent Bookings</h5>

                <!-- Table Tabs / Filter Header -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
                    <!-- Filter Tabs -->
                    <div class="d-flex gap-4" style="font-size: 0.88rem;">
                        <span t-attf-class="tab-filter {{ this.state.filterStage == 'all' ? 'active' : '' }}"
                              t-on-click="() => this.changeFilterStage('all')">All Bookings</span>
                        <t t-foreach="this.state.stages" t-as="stage" t-key="stage.id">
                            <span t-attf-class="tab-filter {{ this.state.filterStage == stage.id ? 'active' : '' }}"
                                  t-on-click="() => this.changeFilterStage(stage.id)">
                                <t t-out="stage.x_name"/>
                            </span>
                        </t>
                    </div>
                    <!-- Right Actions -->
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-action-custom px-3 py-1.5 d-flex align-items-center gap-1.5">
                            <i class="fa fa-eye text-muted-custom"/> View All
                        </button>
                        <button class="btn btn-action-custom px-3 py-1.5 d-flex align-items-center gap-1.5">
                            Last 30 days <i class="fa fa-calendar text-muted-custom"/>
                        </button>
                        <button class="btn btn-action-custom px-3 py-1.5 d-flex align-items-center gap-1.5" t-on-click="this.loadData">
                            <i class="fa fa-download text-muted-custom"/> Export
                        </button>
                    </div>
                </div>

                <!-- Custom Table -->
                <div class="table-responsive">
                    <table class="table table-custom align-middle mb-0" style="cursor: pointer;">
                        <thead>
                            <tr>
                                <th class="py-3">Guest Name</th>
                                <th class="py-3">Check-in <i class="fa fa-arrows-v ms-1" style="font-size: 0.65rem;"/></th>
                                <th class="py-3">Check-out</th>
                                <th class="py-3">Room Number</th>
                                <th class="py-3 text-center">Nights</th>
                                <th class="py-3 text-end">Booking Value</th>
                                <th class="py-3 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="filteredBookings" t-value="this.getFilteredBookings()"/>
                            <t t-if="filteredBookings.length == 0">
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted-custom small">No records found.</td>
                                </tr>
                            </t>
                            <t t-else="">
                                <t t-foreach="filteredBookings" t-as="booking" t-key="booking.id">
                                    <tr t-on-click="() => this.openBooking(booking.id)">
                                        <!-- Guest Name -->
                                        <td class="py-3.5">
                                            <span class="fw-semibold text-dark-custom" style="font-size: 0.88rem;" t-out="booking.x_studio_partner_id ? booking.x_studio_partner_id[1] : 'Guest'"/>
                                        </td>
                                        <!-- Check-in Date -->
                                        <td class="py-3.5 text-secondary-custom" style="font-size: 0.85rem;" t-out="booking.x_studio_check_in"/>
                                        <!-- Check-out Date -->
                                        <td class="py-3.5 text-secondary-custom" style="font-size: 0.85rem;" t-out="booking.x_studio_check_out"/>
                                        <!-- Room Number -->
                                        <td class="py-3.5">
                                            <span class="text-dark-custom fw-medium" style="font-size: 0.85rem;" t-out="booking.x_studio_room_no ? booking.x_studio_room_no[1] : 'Unassigned'"/>
                                        </td>
                                        <!-- Nights -->
                                        <td class="py-3.5 text-center text-dark-custom fw-semibold" style="font-size: 0.85rem;" t-out="this.getNights(booking.x_studio_check_in, booking.x_studio_check_out)"/>
                                        <!-- Total Amount -->
                                        <td class="py-3.5 text-end font-monospace fw-bold text-dark-custom" style="font-size: 0.85rem;" t-out="this.formatCurrency(booking.x_studio_value)"/>
                                        <!-- Status Badge -->
                                        <td class="py-3.5 text-center">
                                            <t t-set="stageName" t-value="booking.x_studio_stage_id ? booking.x_studio_stage_id[1] : 'Reserved'"/>
                                            <span class="badge px-3 py-1.5 rounded-pill" 
                                                  t-att-style="this.getStageBadgeStyle(stageName)">
                                                • <t t-out="stageName"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Footer Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top" style="font-size: 0.8rem;">
                    <span class="text-secondary-custom">Showing 1 to 10 of <t t-out="filteredBookings.length"/> results</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-secondary-custom cursor-pointer">&lt; Previous</span>
                        <span class="text-secondary-custom cursor-pointer">Next &gt;</span>
                    </div>
                </div>

            </div>

        </div>
    </t>
</templates>
