<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--Kanban View of payment provider-->
        <record id="payment_provider_network_international" model="payment.provider">
            <field name="code">network_international</field>
            <field name="name">NetworkInternational</field>
            <field name="redirect_form_view_id" ref="redirect_form"/>
            <field name="image_128" type="base64"
                   file="network_international_gateway/static/src/image/network_international_logo.png"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="payment_method_ids"
                   eval="[Command.set([ref('network_international_gateway.payment_method_network_international'),])]"
            />
            <field name="module_id"
                   ref="base.module_network_international_gateway"/>
        </record>
    </data>
</odoo>
