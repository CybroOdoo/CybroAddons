<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Creating Network International payment method -->
    <record id="payment_method_network_international" model="payment.method">
        <field name="name">Network International</field>
        <field name="code">network_international</field>
                 <field name="image"
               type="base64"
               file="network_international_gateway/static/src/image/network_international.png"/>
        <field name="sequence">2</field>
        <field name="support_tokenization">True</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
    </record>
</odoo>
