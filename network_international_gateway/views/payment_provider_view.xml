<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherits payment.provider form view to conditionally display fields for "network_international" provider. -->
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">
            payment.provider.view.form.inherited.odoo.network.international
        </field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="model">payment.provider</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='credentials']" position="inside">
                <group invisible="code != 'network_international'">
                    <field name="api_key"/>
                    <field name="outlet_reference"/>
                    <field name="api_endpoint"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
