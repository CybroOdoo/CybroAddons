<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Adding a whatsapp icon in systray.-->
    <t t-name="whatsapp_mail_messaging.whatsapp_icon">
        <div class="o_nav_entry d-flex align-items-center" t-on-click="() => this.onclick_whatsapp_icon()" title="Send Message Through Whatsapp">
            <button class="btn border-0 text-reset p-1" type="button">
                <i class="oi" data-icon="oi_whatsapp" aria-label="Send Message Through Whatsapp"/>
            </button>
        </div>
    </t>
</templates>
