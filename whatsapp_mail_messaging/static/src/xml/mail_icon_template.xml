<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Adding a mail icon in systray-->
    <t t-name="whatsapp_mail_messaging.mail_icon">
        <div class="o_nav_entry d-flex align-items-center" t-on-click="() => this.onclick_mail_icon()" title="Send a Message Through Mail">
            <button class="btn border-0 text-reset p-1" type="button">
                <i class="oi" data-icon="mail" aria-label="Send a Message Through Mail"/>
            </button>
        </div>
    </t>
</templates>
