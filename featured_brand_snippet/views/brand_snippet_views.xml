<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product Brand Snippet Template -->
    <template id="product_brand_snippet" name="Product Brand">

        <section class="s_product_brand dynamic_snippet_brand pt48 pb48"
                 data-name="Product Brand"
                 data-snippet="s_product_brand">

            <div class="container">
                <h2 class="text-center mb-4">Product Brands</h2>

                <!--
                    Static demo shown in the "Insert a block" preview and in the
                    editor. Edit it to choose the layout: on the live website the
                    widget replaces it with the real featured brands and shows as
                    many brands per slide as there are demo cards left.
                -->
                <div id="brands" class="o_brand_demo">
                    <div class="position-relative px-3">
                        <div class="row justify-content-center gx-2">
                            <div class="col-10 col-sm-6 col-md-4 col-lg-3 mb-4 mx-auto">
                                <div class="card h-100 o_brand_demo_card" style="min-height: 320px;">
                                    <div class="d-flex align-items-center justify-content-center p-3" style="height: 200px;">
                                        <img class="card-img-top img-fluid p-3" src="/featured_brand_snippet/static/src/img/snippets/demo_brand_1.png" alt="Timber Craft logo" style="max-height: 180px; object-fit: contain;"/>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title text-center mb-2">Timber Craft</h5>
                                        <a href="#" class="btn btn-primary mt-auto align-self-center" style="pointer-events: none;">View Products</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-10 col-sm-6 col-md-4 col-lg-3 mb-4 mx-auto">
                                <div class="card h-100 o_brand_demo_card" style="min-height: 320px;">
                                    <div class="d-flex align-items-center justify-content-center p-3" style="height: 200px;">
                                        <img class="card-img-top img-fluid p-3" src="/featured_brand_snippet/static/src/img/snippets/demo_brand_2.png" alt="Brew House logo" style="max-height: 180px; object-fit: contain;"/>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title text-center mb-2">Brew House</h5>
                                        <a href="#" class="btn btn-primary mt-auto align-self-center" style="pointer-events: none;">View Products</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-10 col-sm-6 col-md-4 col-lg-3 mb-4 mx-auto">
                                <div class="card h-100 o_brand_demo_card" style="min-height: 320px;">
                                    <div class="d-flex align-items-center justify-content-center p-3" style="height: 200px;">
                                        <img class="card-img-top img-fluid p-3" src="/featured_brand_snippet/static/src/img/snippets/demo_brand_3.png" alt="Pure Bloom logo" style="max-height: 180px; object-fit: contain;"/>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title text-center mb-2">Pure Bloom</h5>
                                        <a href="#" class="btn btn-primary mt-auto align-self-center" style="pointer-events: none;">View Products</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-10 col-sm-6 col-md-4 col-lg-3 mb-4 mx-auto">
                                <div class="card h-100 o_brand_demo_card" style="min-height: 320px;">
                                    <div class="d-flex align-items-center justify-content-center p-3" style="height: 200px;">
                                        <img class="card-img-top img-fluid p-3" src="/featured_brand_snippet/static/src/img/snippets/demo_brand_4.png" alt="Tech Nova logo" style="max-height: 180px; object-fit: contain;"/>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title text-center mb-2">Tech Nova</h5>
                                        <a href="#" class="btn btn-primary mt-auto align-self-center" style="pointer-events: none;">View Products</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <span class="fa fa-chevron-circle-left fa-2x position-absolute top-50 start-0 translate-middle-y"
                              style="color: #000;"/>
                        <span class="fa fa-chevron-circle-right fa-2x position-absolute top-50 end-0 translate-middle-y"
                              style="color: #000;"/>
                    </div>
                </div>
            </div>

        </section>

    </template>

    <!-- Register Product Brand Category and Snippet -->
    <template id="external_snippets"
              inherit_id="website.snippets"
              name="Product Brand Snippets">

        <!-- Register Product Brand Category -->
        <xpath expr="//snippets[@id='snippet_groups']/*[1]"
               position="before">

            <t snippet-group="product_brand"
               t-snippet="website.s_snippet_group"
               string="Product Brand"
               t-thumbnail="/featured_brand_snippet/static/src/img/snippets/brands.jpg"/>

        </xpath>

        <!-- Register Product Brand Snippet -->
        <xpath expr="//snippets[@id='snippet_structure']/*[1]"
               position="before">

            <t t-snippet="featured_brand_snippet.product_brand_snippet"
               string="Product Brand"
               group="product_brand">

                <keywords>Product Brand, Featured Brand, Brands</keywords>

            </t>

        </xpath>

    </template>

</odoo>
