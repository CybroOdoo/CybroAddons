<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-name="featured_brand_snippet.brand_snippet_carousel">

        <div class="position-relative px-3">

            <!-- Main Carousel -->
            <div t-att-id="carouselId"
                 class="carousel slide"
                 data-bs-ride="carousel"
                 data-bs-interval="5000">

                <div class="carousel-inner">

                    <t t-foreach="chunks"
                       t-as="chunk"
                       t-key="chunk_index">

                        <div t-attf-class="carousel-item {{ chunk_index === 0 ? 'active' : '' }}">

                            <div class="row gx-2">

                                    <t t-foreach="chunk"
                                       t-as="item"
                                       t-key="item.id">

                                        <t t-if="item.empty">
                                            <div t-attf-class="{{ colClass }} mb-4 invisible d-none d-lg-block"
                                                 aria-hidden="true"/>
                                        </t>
                                        <t t-else="">
                                        <div t-attf-class="{{ colClass }} mb-4">

                                            <div class="card h-100"
                                                 style="min-height: 320px; display: flex; flex-direction: column;">

                                                <!-- Brand Image -->
                                                <div style="height: 200px;
                                                            display: flex;
                                                            align-items: center;
                                                            justify-content: center;
                                                            padding: 15px;
                                                            flex-shrink: 0;">

                                                    <img class="card-img-top img-fluid p-3"
                                                         t-att-src="'/web/image/product.brand/' + item.id + '/brand_image'"
                                                         t-att-alt="item.name"
                                                         style="max-height: 180px; object-fit: contain;"/>

                                                </div>

                                                <!-- Brand Details -->
                                                <div class="card-body d-flex flex-column"
                                                     style="flex-grow: 1;">

                                                    <h5 class="card-title text-center mb-2">
                                                        <t t-out="item.name"/>
                                                    </h5>

                                                    <a t-att-href="'/shop/brand/' + item.id"
                                                       class="btn btn-primary mt-auto align-self-center">
                                                        View Products
                                                    </a>

                                                </div>

                                            </div>

                                        </div>
                                        </t>

                                    </t>

                            </div>

                        </div>

                    </t>

                </div>

                <t t-if="chunks.length &gt; 1">

                <!-- Previous Button -->
                <button class="carousel-control-prev"
                        t-att-data-bs-target="'#' + carouselId"
                        data-bs-slide="prev"
                        type="button"
                        aria-label="Previous"
                        style="left: -15px; width: auto;">

                    <span class="fa fa-chevron-circle-left fa-2x"
                          style="color: #000;"/>

                    <span class="visually-hidden">Previous</span>

                </button>

                <!-- Next Button -->
                <button class="carousel-control-next"
                        t-att-data-bs-target="'#' + carouselId"
                        data-bs-slide="next"
                        type="button"
                        aria-label="Next"
                        style="right: -15px; width: auto;">

                    <span class="fa fa-chevron-circle-right fa-2x"
                          style="color: #000;"/>

                    <span class="visually-hidden">Next</span>

                </button>

                </t>

            </div>

        </div>

    </t>

</templates>