<templates id="template" xml:space="preserve">
    <t t-name="featured_brand_snippet.brand_snippet_carousel">
        <div class="position-relative px-3">
            <!-- Main Carousel Container -->
            <div id="course_carousel" class="carousel slide"
                 data-bs-ride="carousel" t-att-data-bs-interval="interval">
               <div class="carousel-inner">
                  <t t-foreach="chunks" t-as="chunk" t-key="chunk_index">
                       <div t-attf-class="carousel-item {{chunk_index == 0 ? 'active' : ''}}">
                            <div class="container">
                                <div class="row justify-content-center gx-2">
                                    <t t-foreach="chunk" t-as="item" t-key="item.index">
                                        <div class="col-10 col-sm-6 col-md-4 col-lg-3 mb-4 mx-auto">
                                            <div class="card h-100" style="min-height: 320px; display: flex; flex-direction: column;">
                                                <div style="height:200px; display:flex; align-items:center; justify-content:center; padding:15px; flex-shrink:0;">
                                                    <img class="card-img-top img-fluid p-3"
                                                     t-attf-src="data:image/png;base64,{{item.brand_image}}"/>
                                                </div>
                                                <div class="card-body d-flex flex-column" style="flex-grow: 1;">
                                                    <h5 class="card-title mb-2" t-esc="item.name"/>
                                                    <a t-attf-href="/shop/brand/{{item.id}}"
                                                       class="btn btn-primary mt-auto align-self-center">
                                                        View Products
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                  </t>
               </div>
            </div>
            <!-- Navigation Arrows -->
            <button class="carousel-control-prev"
               data-bs-target="#course_carousel"
               data-bs-slide="prev" role="button" aria-label="Previous"
               title="Previous" style="left: -15px; width: auto;">
                <span class="fa fa-chevron-circle-left fa-2x" style="color: #000;"/>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next"
               data-bs-target="#course_carousel"
               data-bs-slide="next" role="button" aria-label="Next" title="Next"
               style="right: -15px; width: auto;">
                <span class="fa fa-chevron-circle-right fa-2x"
                      style="color: #000;"/>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </t>
</templates>
