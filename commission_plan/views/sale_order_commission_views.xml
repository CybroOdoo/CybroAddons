<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_commission_view_list" model="ir.ui.view">
        <field name="name">sale.order.commission.list</field>
        <field name="model">sale.order.commission</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="commission_type == 'return'">
                <field name="order_id"/><field name="order_date"/>
                <field name="user_id"/><field name="team_id"/>
                <field name="commission_id"/>
                <field name="plan_source" widget="badge"/>
                <field name="product_id"/>
                <field name="category_id"/><field name="commission_type"/>
                <field name="return_move_id"/><field name="revenue"/>
                <field name="rate" string="Rate (%)"/><field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="sale_order_commission_view_form" model="ir.ui.view">
        <field name="name">sale.order.commission.form</field>
        <field name="model">sale.order.commission</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group><group>
                        <field name="order_id"/><field name="order_date"/>
                        <field name="commission_id"/>
                        <field name="plan_source" widget="badge"/>
                        <field name="currency_id" invisible="1"/>
                    </group><group>
                        <field name="user_id"/><field name="team_id"/>
                        <field name="product_id"/><field name="category_id"/>
                    </group></group>
                    <group string="Commission">
                        <field name="commission_type"/>
                        <field name="return_move_id" invisible="commission_type != 'return'"/>
                        <field name="origin_commission_id" invisible="commission_type != 'return'"/>
                        <field name="revenue"/><field name="rate" string="Rate (%)"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sale_order_commission_view_search" model="ir.ui.view">
        <field name="name">sale.order.commission.search</field>
        <field name="model">sale.order.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/><field name="user_id"/>
                <field name="team_id"/><field name="commission_id"/>
                <field name="plan_source"/>
                <filter name="filter_earned" string="Earned" domain="[('commission_type','=','earned')]"/>
                <filter name="filter_return" string="Returns" domain="[('commission_type','=','return')]"/>
                <filter name="filter_current_month" string="Current Month" domain="[('create_date', '&gt;=', '=1d'),('create_date', '&lt;', '=1d +1m')]"/>
                <filter name="filter_last_month" string="Last Month" domain="[('create_date', '&gt;=', '=1d -1m'),('create_date', '&lt;', '=1d')]"/>
                <separator/>
                <filter name="group_team_id" string="Sales Team" context="{'group_by': 'team_id'}"/>
                <filter name="group_user_id" string="Salesperson" context="{'group_by': 'user_id'}"/>
                <filter name="group_order_id" string="Sale Order" context="{'group_by': 'order_id'}"/>
                <filter name="group_commission_type" string="Type" context="{'group_by': 'commission_type'}"/>
                <filter name="group_plan_source" string="Plan Source" context="{'group_by': 'plan_source'}"/>
            </search>
        </field>
    </record>
    <record id="sale_team_commission_action" model="ir.actions.act_window">
        <field name="name">Sales Team Commissions</field>
        <field name="res_model">sale.order.commission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_team_id': 1}</field>
    </record>
    <record id="sale_person_commission_action" model="ir.actions.act_window">
        <field name="name">Sales Person Commissions</field>
        <field name="res_model">sale.order.commission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_user_id': 1}</field>
    </record>
    <!-- Parent menu: visible to all internal users so they can reach
         "Sales Person" (their own commissions). The "Sales Team" child
         below is further restricted to Commission Managers, and Odoo
         will hide this parent for a given user if none of its children
         are visible to them. -->
    <menuitem id="sale_commission_menu" name="Sales Commissions"
              parent="sale.sale_menu_root" groups="base.group_user" sequence="35"/>
    <!-- Managers/above only: full cross-team visibility. -->
    <menuitem id="sale_team_commission_menu" name="Sales Team"
              parent="sale_commission_menu" action="sale_team_commission_action"
              groups="group_commission_manager" sequence="10"/>
    <!-- All internal users: the underlying ir.rule
         (sale_order_commission_rule_own) scopes non-managers to rows
         where user_id = the logged-in user, so a regular user only ever
         sees their own commission records here. -->
    <menuitem id="sale_person_commission_menu" name="Sales Person"
              parent="sale_commission_menu" action="sale_person_commission_action"
              groups="base.group_user" sequence="20"/>
</odoo>
