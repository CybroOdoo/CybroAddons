<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_view_form_commission" model="ir.ui.view">
        <field name="name">sale.order.form.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='customer_signature']" position="after">
                <page name="commission_page" string="Commissions" invisible="not commission_line_ids">
                    <field name="commission_line_ids" readonly="1">
                        <list decoration-danger="commission_type == 'return'">
                            <field name="user_id"/><field name="team_id"/>
                            <field name="commission_id"/>
                            <field name="plan_source" widget="badge"/>
                            <field name="product_id"/>
                            <field name="category_id"/><field name="commission_type"/>
                            <field name="return_move_id"/><field name="revenue"/>
                            <field name="rate" string="Rate (%)"/><field name="amount"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer"><field name="commission_amount"/></group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
