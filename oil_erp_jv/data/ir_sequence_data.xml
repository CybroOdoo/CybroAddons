<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_oil_jv_agreement" model="ir.sequence">
            <field name="name">Joint Operating Agreement</field>
            <field name="code">oil.jv.agreement</field>
            <field name="prefix">JOA/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_oil_afe" model="ir.sequence">
            <field name="name">Authority for Expenditure</field>
            <field name="code">oil.afe</field>
            <field name="prefix">AFE/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_oil_jv_cash_call" model="ir.sequence">
            <field name="name">JV Cash Call</field>
            <field name="code">oil.jv.cash.call</field>
            <field name="prefix">CC/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_oil_jv_jib" model="ir.sequence">
            <field name="name">Joint Interest Billing</field>
            <field name="code">oil.jv.jib</field>
            <field name="prefix">JIB/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_oil_jv_revenue" model="ir.sequence">
            <field name="name">JV Revenue Distribution</field>
            <field name="code">oil.jv.revenue</field>
            <field name="prefix">REV/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>