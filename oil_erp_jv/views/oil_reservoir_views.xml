<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add JV Agreements smart button to Reservoir form -->
    <record id="oil_reservoir_view_form_inherit_jv" model="ir.ui.view">
        <field name="name">oil.reservoir.view.form.inherit.jv</field>
        <field name="model">oil.reservoir</field>
        <field name="inherit_id" ref="oil_erp_reservoir.view_oil_reservoir_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_jv_agreements" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="jv_agreement_count == 0">
                    <field name="jv_agreement_count" widget="statinfo"
                           string="JV Agreements"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
