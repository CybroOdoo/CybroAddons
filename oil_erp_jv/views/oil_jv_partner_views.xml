<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- JV Partner List View (standalone) -->
    <record id="oil_jv_partner_view_list" model="ir.ui.view">
        <field name="name">oil.jv.partner.view.list</field>
        <field name="model">oil.jv.partner</field>
        <field name="arch" type="xml">
            <list string="JV Partners">
                <field name="agreement_id"/>
                <field name="partner_id"/>
                <field name="working_interest"/>
                <field name="net_revenue_interest"/>
                <field name="is_operator"/>
                <field name="jv_receivable_account_id" optional="hide"/>
                <field name="jv_payable_account_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- JV Partner Form View -->
    <record id="oil_jv_partner_view_form" model="ir.ui.view">
        <field name="name">oil.jv.partner.view.form</field>
        <field name="model">oil.jv.partner</field>
        <field name="arch" type="xml">
            <form string="JV Partner">
                <sheet>
                    <group>
                        <group string="Partner Details">
                            <field name="agreement_id"/>
                            <field name="partner_id"/>
                            <field name="is_operator"/>
                        </group>
                        <group string="Interest &amp; Accounts">
                            <field name="working_interest"/>
                            <field name="net_revenue_interest"/>
                            <field name="jv_receivable_account_id"/>
                            <field name="jv_payable_account_id"/>
                            <field name="jv_revenue_account_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notes about this partner's participation..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- JV Partner Search View -->
    <record id="oil_jv_partner_view_search" model="ir.ui.view">
        <field name="name">oil.jv.partner.view.search</field>
        <field name="model">oil.jv.partner</field>
        <field name="arch" type="xml">
            <search string="Search JV Partners">
                <field name="partner_id"/>
                <field name="agreement_id"/>
                <filter string="Operator" name="is_operator" domain="[('is_operator', '=', True)]"/>
                <group name="group_by">
                    <filter string="Agreement" name="group_by_agreement" context="{'group_by': 'agreement_id'}"/>
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- JV Partner Action -->
    <record id="action_oil_jv_partner" model="ir.actions.act_window">
        <field name="name">JV Partners</field>
        <field name="res_model">oil.jv.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="oil_jv_partner_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No JV partners found.
            </p>
            <p>
                JV Partners are managed through Joint Operating Agreements.
            </p>
        </field>
    </record>
</odoo>