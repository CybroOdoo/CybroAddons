<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- JV Agreement Search View -->
    <record id="oil_jv_agreement_view_search" model="ir.ui.view">
        <field name="name">oil.jv.agreement.view.search</field>
        <field name="model">oil.jv.agreement</field>
        <field name="arch" type="xml">
            <search string="Search JOAs">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="operator_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <group name="group_by">
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Operator" name="group_by_operator" context="{'group_by': 'operator_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- JV Agreement List View -->
    <record id="oil_jv_agreement_view_list" model="ir.ui.view">
        <field name="name">oil.jv.agreement.view.list</field>
        <field name="model">oil.jv.agreement</field>
        <field name="arch" type="xml">
            <list string="Joint Operating Agreements"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-muted="state in ('expired', 'terminated')">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="operator_id"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
                <field name="total_wi"/>
                <field name="accounting_method"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'terminated'"
                       decoration-muted="state == 'expired'"/>
            </list>
        </field>
    </record>

    <!-- JV Agreement Form View -->
    <record id="oil_jv_agreement_view_form" model="ir.ui.view">
        <field name="name">oil.jv.agreement.view.form</field>
        <field name="model">oil.jv.agreement</field>
        <field name="arch" type="xml">
            <form string="Joint Operating Agreement">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_royalty"
                            string="Create Royalty"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_expire" string="Mark Expired"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_terminate" string="Terminate"
                            type="object"
                            invisible="state not in ('draft', 'active')"/>
                    <button name="action_set_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('expired', 'terminated')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_afes" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="afe_count" widget="statinfo"
                                   string="AFEs"/>
                        </button>
                        <button name="action_view_cash_calls" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="cash_call_count == 0">
                            <field name="cash_call_count" widget="statinfo"
                                   string="Cash Calls"/>
                        </button>
                        <button name="action_view_jibs" type="object"
                                class="oe_stat_button" icon="fa-list-alt"
                                invisible="jib_count == 0">
                            <field name="jib_count" widget="statinfo"
                                   string="JIBs"/>
                        </button>
                        <button name="action_view_revenues" type="object"
                                class="oe_stat_button" icon="fa-bar-chart"
                                invisible="revenue_count == 0">
                            <field name="revenue_count" widget="statinfo"
                                   string="Revenue Dist."/>
                        </button>
                        <button name="action_view_royalties" type="object"
                                class="oe_stat_button" icon="fa-percent"
                                invisible="royalty_count == 0">
                            <field name="royalty_count" widget="statinfo"
                                   string="Royalties"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   invisible="name == 'New'"
                                   readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Agreement Details">
                            <field name="title" readonly="state != 'draft'"/>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="operator_id" readonly="state != 'draft'"/>
                            <field name="accounting_method" readonly="state != 'draft'"/>
                        </group>
                        <group string="Dates &amp; Currency">
                            <field name="effective_date" readonly="state != 'draft'"/>
                            <field name="expiry_date" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"
                                   groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="partners" string="JV Partners">
                            <div class="alert alert-warning" role="alert"
                                 invisible="not validation_warnings">
                                <strong>Warning:</strong>
                                <field name="validation_warnings" nolabel="1"/>
                            </div>
                            <field name="partner_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="working_interest"/>
                                    <field name="net_revenue_interest"/>
                                    <field name="is_operator"/>
                                    <field name="jv_receivable_account_id" optional="hide"/>
                                    <field name="jv_payable_account_id" optional="hide"/>
                                    <field name="jv_revenue_account_id" optional="hide"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_wi" class="oe_subtotal_footer_separator"/>
                                <field name="total_nri"/>
                            </group>
                        </page>
                        <page name="notes" string="Notes &amp; Terms">
                            <field name="notes"
                                   placeholder="Additional terms, clauses, or notes about this JOA..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- JV Agreement Action -->
    <record id="action_oil_jv_agreement" model="ir.actions.act_window">
        <field name="name">Joint Operating Agreements</field>
        <field name="res_model">oil.jv.agreement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="oil_jv_agreement_view_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Joint Operating Agreement!
            </p>
            <p>
                Define JV partners and their Working Interest percentages for oil &amp; gas projects.
            </p>
        </field>
    </record>
</odoo>