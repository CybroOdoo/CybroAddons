<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cash Call Search View -->
    <record id="oil_jv_cash_call_view_search" model="ir.ui.view">
        <field name="name">oil.jv.cash.call.view.search</field>
        <field name="model">oil.jv.cash.call</field>
        <field name="arch" type="xml">
            <search string="Search Cash Calls">
                <field name="name"/>
                <field name="agreement_id"/>
                <field name="afe_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Invoiced" name="invoiced" domain="[('state', '=', 'invoiced')]"/>
                <separator/>
                <group name="group_by">
                    <filter string="JOA" name="group_by_agreement" context="{'group_by': 'agreement_id'}"/>
                    <filter string="Period" name="group_by_period" context="{'group_by': 'period_date:month'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Cash Call List View -->
    <record id="oil_jv_cash_call_view_list" model="ir.ui.view">
        <field name="name">oil.jv.cash.call.view.list</field>
        <field name="model">oil.jv.cash.call</field>
        <field name="arch" type="xml">
            <list string="Cash Calls"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirmed'"
                  decoration-success="state == 'invoiced'">
                <field name="name"/>
                <field name="agreement_id"/>
                <field name="afe_id" optional="show"/>
                <field name="period_date"/>
                <field name="due_date"/>
                <field name="total_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="invoice_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'invoiced'"/>
            </list>
        </field>
    </record>

    <!-- Cash Call Form View -->
    <record id="oil_jv_cash_call_view_form" model="ir.ui.view">
        <field name="name">oil.jv.cash.call.view.form</field>
        <field name="model">oil.jv.cash.call</field>
        <field name="arch" type="xml">
            <form string="Cash Call">
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_invoices"
                            string="Generate Invoices"
                            type="object" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button name="action_set_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,invoiced"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not expiry_warning">
                        <strong>Warning:</strong>
                        <field name="expiry_warning" nolabel="1"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo"
                                   string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   invisible="name == 'New'"
                                   readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Cash Call Details">
                            <field name="agreement_id" readonly="state != 'draft'"/>
                            <field name="afe_id" readonly="state != 'draft'"/>
                            <field name="period_date" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Amount">
                            <field name="total_amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Partner Breakdown">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="working_interest"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount"/>
                                    <field name="invoice_id" readonly="1" optional="show"/>
                                    <field name="payment_status" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page name="description" string="Description &amp; Notes">
                            <group>
                                <field name="description"
                                       placeholder="Description of budgeted expenditure for this period..."/>
                            </group>
                            <group>
                                <field name="notes"
                                       placeholder="Additional notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Cash Call Action -->
    <record id="action_oil_jv_cash_call" model="ir.actions.act_window">
        <field name="name">Cash Calls</field>
        <field name="res_model">oil.jv.cash.call</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="oil_jv_cash_call_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Cash Call!
            </p>
            <p>
                Issue monthly cash calls to JV partners based on their Working Interest.
            </p>
        </field>
    </record>
</odoo>
