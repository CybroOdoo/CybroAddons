<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add JV Agreement field to Contract form -->
    <record id="oil_contract_view_form_inherit_jv" model="ir.ui.view">
        <field name="name">oil.contract.view.form.inherit.jv</field>
        <field name="model">oil.contract</field>
        <field name="inherit_id" ref="oil_erp_contract.view_oil_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='end_date']" position="after">
                <field name="jv_agreement_id"/>
            </xpath>
        </field>
    </record>

    <!-- Add JV Agreement column to Contract list -->
    <record id="oil_contract_view_list_inherit_jv" model="ir.ui.view">
        <field name="name">oil.contract.view.list.inherit.jv</field>
        <field name="model">oil.contract</field>
        <field name="inherit_id" ref="oil_erp_contract.view_oil_contract_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='end_date']" position="after">
                <field name="jv_agreement_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
