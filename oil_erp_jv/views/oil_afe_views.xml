<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AFE Search View -->
    <record id="oil_afe_view_search" model="ir.ui.view">
        <field name="name">oil.afe.view.search</field>
        <field name="model">oil.afe</field>
        <field name="arch" type="xml">
            <search string="Search AFEs">
                <field name="name"/>
                <field name="title"/>
                <field name="agreement_id"/>
                <field name="project_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <separator/>
                <filter string="CAPEX" name="capex" domain="[('afe_type', '=', 'capex')]"/>
                <filter string="OPEX" name="opex" domain="[('afe_type', '=', 'opex')]"/>
                <separator/>
                <group name="group_by">
                    <filter string="JOA" name="group_by_agreement" context="{'group_by': 'agreement_id'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'afe_type'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- AFE List View -->
    <record id="oil_afe_view_list" model="ir.ui.view">
        <field name="name">oil.afe.view.list</field>
        <field name="model">oil.afe</field>
        <field name="arch" type="xml">
            <list string="AFEs"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state in ('approved', 'in_progress')"
                  decoration-muted="state in ('closed', 'rejected')">
                <field name="name"/>
                <field name="title"/>
                <field name="agreement_id"/>
                <field name="project_id"/>
                <field name="afe_type"/>
                <field name="estimated_amount"/>
                <field name="actual_amount"/>
                <field name="variance"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ('approved', 'in_progress')"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- AFE Form View -->
    <record id="oil_afe_view_form" model="ir.ui.view">
        <field name="name">oil.afe.view.form</field>
        <field name="model">oil.afe</field>
        <field name="arch" type="xml">
            <form string="Authority for Expenditure">
                <header>
                    <button name="action_submit" string="Submit for Approval"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'submitted'"/>
                    <button name="action_start" string="Start Work"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_close" string="Close AFE"
                            type="object" class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reject" string="Reject"
                            type="object"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_set_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('submitted', 'rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not expiry_warning">
                        <strong>Warning:</strong>
                        <field name="expiry_warning" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   invisible="name == 'New'"
                                   readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="AFE Details">
                            <field name="title" readonly="state != 'draft'"/>
                            <field name="agreement_id" readonly="state != 'draft'"/>
                            <field name="project_id"/>
                            <field name="afe_type" readonly="state != 'draft'"/>
                        </group>
                        <group string="Financial Summary">
                            <field name="estimated_amount" readonly="state != 'draft'"/>
                            <field name="actual_amount"/>
                            <field name="variance"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="submission_date"/>
                            <field name="approval_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="cost_lines" string="Cost Estimate">
                            <field name="line_ids" readonly="state not in ('draft', 'in_progress')">
                                <list editable="bottom">
                                    <field name="cost_category"/>
                                    <field name="description"/>
                                    <field name="account_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="estimated_amount"/>
                                    <field name="actual_amount"
                                           readonly="parent.state not in ('in_progress', 'closed')"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_estimated"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page name="approvals" string="Partner Approvals">
                            <field name="approval_ids">
                                <list editable="bottom">
                                    <field name="partner_id" readonly="1"/>
                                    <field name="working_interest" readonly="1"/>
                                    <field name="status" widget="badge"
                                           decoration-warning="status == 'pending'"
                                           decoration-success="status == 'approved'"
                                           decoration-danger="status == 'rejected'"/>
                                    <field name="vote_date"/>
                                    <field name="notes"/>
                                    <button name="action_vote_approve" string="Approve"
                                            type="object" class="btn-success"
                                            invisible="status != 'pending'"/>
                                    <button name="action_vote_reject" string="Reject"
                                            type="object" class="btn-danger"
                                            invisible="status != 'pending'"/>
                                </list>
                            </field>
                        </page>
                        <page name="description" string="Scope &amp; Notes">
                            <group>
                                <field name="description"
                                       placeholder="Detailed scope of work and justification..."/>
                            </group>
                            <group>
                                <field name="notes"
                                       placeholder="Additional notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- AFE Action -->
    <record id="action_oil_afe" model="ir.actions.act_window">
        <field name="name">AFEs</field>
        <field name="res_model">oil.afe</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="oil_afe_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Authority for Expenditure!
            </p>
            <p>
                AFEs track budgeted expenditures with JV partner approval workflow.
            </p>
        </field>
    </record>
</odoo>