<?xml version="1.0" encoding="UTF-8" ?>
<template id="expiry_dashboard_template">
    <t t-name="odoo_product_expiry_dashboard.expiry_dashboard_template">
        <div class="o_action_manager"
             style="height:100%; overflow-y: scroll; overflow-x: hidden;" t-ref="root">
            <section class="dashboard_main_section" id="main_section_manager">
                <!-- Dashboard Header-->
                <div class="dashboard-heading shadow-sm">
                    <center>
                        <div style="width: 450px">
                            <h1 class="banner-heading">
                                Product Expiry Dashboard
                            </h1>
                        </div>
                    </center>
                    <div class="col-4 col-sm-4 col-md-4"
                         style="float: right;color: white; margin-top: -40px;">
                        <form class="form-group">
                            <span>Start Date:</span>
                            <input type="date" id="start_date"
                                   name="start_date" t-on-change="FilterDate"/>
                            <span>End Date:</span>
                            <input type="date" id="end_date" name="end_date" t-on-change="FilterDate"/>
                        </form>
                    </div>
                </div>
                <br/>
                <div class="card-group">
                <!--Dashboard Tiles-->
                    <div class="card">
                        <div class="card-body">
                            <div class="container">
                                <div class="row">
                                    <div class="col-md-2 col-xl-6"
                                         style="float: left">
                                        <div class="card bg-c-red order-card">
                                            <div class="card-block expired" t-on-click="expired_click">
                                                <h2 style="color:white;
                                                 text-align:center;">
                                                    Expired
                                                </h2>
                                                <center>
                                                <span style="font-size: xxx-large;" id="expired"><t t-esc="this.state.expire_quantity['expired']"/></span></center>
                                                <hr/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-xl-6"
                                         style="float: right">
                                        <div class="card bg-c-lavender
                                        order-card">
                                            <div class="card-block today" t-on-click="today_click">
                                                <h2 style="color:white;
                                                text-align:center;">
                                                    Expire Today
                                                </h2>
                                                <center>
                                                <span style="font-size: xxx-large;" id="expired"><t t-esc="this.state.expire_quantity['today']"/></span></center>
                                                <hr/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-xl-6"
                                         style="float: left">
                                        <div class="card bg-c-blue order-card">
                                            <div class="card-block one-day" t-on-click="one_day_click">
                                                <h2 style="color:white;
                                                text-align:center;">
                                                    Expire
                                                    in 1 Day
                                                </h2>
                                                <center>
                                                <span style="font-size: xxx-large;" id="expired"><t t-esc="this.state.expire_quantity['one_day']"/></span></center>
                                                <hr/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-xl-6"
                                         style="float: right">
                                        <div class="card bg-c-green order-card">
                                            <div class="card-block seven-day" t-on-click="seven_day_click">
                                                <h2 style="color:white;
                                                text-align:center;">
                                                    Expire
                                                    in 7 Days
                                                </h2>
                                                <center>
                                                <span style="font-size: xxx-large;" id="expired"><t t-esc="this.state.expire_quantity['seven_day']"/></span></center>
                                                <hr/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-xl-6"
                                         style="float: left">
                                        <div class="card bg-c-yellow
                                        order-card">
                                            <div class="card-block thirty-day" t-on-click="thirty_day_click">
                                                <h2 style="color:white;
                                                 text-align:center;">
                                                    Expire
                                                    in 30 Days
                                                </h2>
                                                <center>
                                                <span style="font-size: xxx-large;" id="expired"><t t-esc="this.state.expire_quantity['thirty_day']"/></span></center>
                                                <hr/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-xl-6"
                                         style="float: right">
                                        <div class="card bg-c-pink order-card">
                                            <div class="card-block
                                            one-twenty-day" t-on-click="one_twenty_day_click">
                                                <h2 style="color:white;
                                                 text-align:center;">
                                                    Expire
                                                    in 120 Days
                                                </h2>
                                                                                                <center>
                                                <span style="font-size: xxx-large;" id="expired"><t t-esc="this.state.expire_quantity['one_twenty_day']"/></span></center>
                                                <hr/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <!-- Graph of Expired Products-->
                        <div class="card-body">
                            <center>
                                <h2 class="card-title">Expired Products</h2>
                                <div style="max-width: 300px;
                                margin-right: 120px;">
                                    <canvas id="expired_product_count"/>
                                </div>
                                <span class ="expired_produt_count_chart"> No data to display.</span>
                            </center>
                        </div>
                        <br/>
                        <br/>
                        <!--  Graph of Expired Products by Category-->
                        <div class="card-body">
                            <center>
                                <h2 class="card-title">Expired Products by
                                    Category
                                </h2>
                                <div style="max-width: 500px;
                                margin-right: 120px;">
                                    <canvas
                                            id="expired_product_category_count"/>
                                </div>
                                <span class ="expired_product_catg_count"> No data to display.</span>
                            </center>
                        </div>
                    </div>
                     <div class="card">
                        <!--   Graph of Products Expiring in 7 Days-->
                        <div class="card-body">
                            <center>
                                <h2 class="card-title"> Products Expiring in 7 Days</h2>
                                <div style="max-width: 300px;
                                margin-right: 120px;">
                                    <canvas id="nearby_expire_product"/>
                                </div>
                                <span class ="nearby_expire_prod"> No data to display.</span>
                            </center>
                        </div>
                        <br/>
                        <br/>
                       <!--  Graph of Category of Products expiring of in 7 Days-->
                        <div class="card-body">
                            <center>
                                <h2 class="card-title">
                                Category Products Expiring of in 7Days
                                </h2>
                                <div style="max-width: 500px;
                                margin-right: 120px;">
                                    <canvas id="nearby_expire_catg"/>
                                </div>
                                <span class ="nearby_expire_cat"> No data to display.</span>
                            </center>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <!--  Graph of location of Products expiring of in 7 Days-->
                    <div class="col-sm-6">
                        <div class="card">
                            <div class="card-body">
                                <center>
                                    <h2>Location of
                                        Products Expiring in 7 Days
                                    </h2>
                                    <div style="max-width: 500px;
                                     margin-right: 120px;">
                                        <canvas id="nearby_expire_location"/>
                                    </div>
                                    <span class ="nearby_expire_loc"> No data to display.</span>
                                </center>
                            </div>
                        </div>
                    </div>
                    <!--  Graph of warehouse of Products expiring of in 7 Days-->
                    <div class="col-sm-6" >
                        <div class="card">
                            <div class="card-body">
                                <center>
                                    <h2 >Warehouse of
                                        Products
                                        Expiring in 7 Days
                                    </h2>
                                    <div style="max-width: 500px;
                                     margin-right: 120px;">
                                        <canvas id="nearby_expire_warehouse"/>
                                    </div>
                                    <span class ="nearby_expire_wh"> No data to display.</span>
                                </center>

                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </t>
</template>
