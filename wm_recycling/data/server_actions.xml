<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Server action bound to recycling.order's form view gear (⚙️) menu.
        binding_model_id + binding_view_types="form" is the native Odoo pattern
        for injecting custom entries into the gear dropdown alongside Duplicate /
        Delete.  The code block calls action_print_report() on each selected
        record, which returns an ir.actions.report action to the client.
    -->
    <record id="action_server_recycling_print_report" model="ir.actions.server">
        <field name="name">Print Report</field>
        <field name="model_id" ref="wm_recycling.model_recycling_order"/>
        <field name="binding_model_id" ref="wm_recycling.model_recycling_order"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records[0].action_print_report()
</field>
    </record>
</odoo>
