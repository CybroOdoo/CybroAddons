<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Multi-Company Record Rules for Recycling Orders -->
        <record id="rule_recycling_order_company" model="ir.rule">
            <field name="name">Recycling Order Multi-Company</field>
            <field name="model_id" ref="model_recycling_order"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_recycling_line_company" model="ir.rule">
            <field name="name">Recycling Line Multi-Company</field>
            <field name="model_id" ref="model_recycling_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('order_id.company_id', '=', False), ('order_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_wm_recycling_efficiency_report_company" model="ir.rule">
            <field name="name">Recycling Efficiency Report Multi-Company</field>
            <field name="model_id" ref="model_wm_recycling_efficiency_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_wm_carbon_accounting_report_company" model="ir.rule">
            <field name="name">Carbon Accounting Report Multi-Company</field>
            <field name="model_id" ref="model_wm_carbon_accounting_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
</data>
</odoo>
