<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--  Record rules for Car Rental Contract multi-company -->
    <record id="car_rental_contract_multi_company_rule_user" model="ir.access">
        <field name="name">Car Rental Contract multi-company user</field>
        <field name="model_id" ref="fleet_rental.model_car_rental_contract"/>
        <field name="group_id" ref="fleet_rental_group_user"/>
        <field name="operation">crud</field>
        <field name="domain">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
    <record id="car_rental_contract_multi_company_rule_manager" model="ir.access">
        <field name="name">Car Rental Contract multi-company manager</field>
        <field name="model_id" ref="fleet_rental.model_car_rental_contract"/>
        <field name="group_id" ref="fleet.fleet_group_manager"/>
        <field name="operation">crud</field>
        <field name="domain">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
    <!--  Record rules for Car Rental Checklist multi-company -->
    <record id="car_rental_checklist_multi_company_rule_user" model="ir.access">
        <field name="name">Car Rental Checklist multi-company user</field>
        <field name="model_id" ref="fleet_rental.model_car_rental_checklist"/>
        <field name="group_id" ref="fleet_rental_group_user"/>
        <field name="operation">crud</field>
        <field name="domain">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
    <record id="car_rental_checklist_multi_company_rule_manager" model="ir.access">
        <field name="name">Car Rental Checklist multi-company manager</field>
        <field name="model_id" ref="fleet_rental.model_car_rental_checklist"/>
        <field name="group_id" ref="fleet.fleet_group_manager"/>
        <field name="operation">crud</field>
        <field name="domain">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
    <!--    Group User-->
    <record id="fleet_rule_vehicle_visibility_user" model="ir.access">
        <field name="name">User can only see his/her vehicle</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="operation">cru</field>
        <field name="group_id" ref="fleet_rental_group_user"/>
        <field name="domain">[('driver_id', '=', user.partner_id.id)]</field>
    </record>
</odoo>
