<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML data records for the adding menu to website.menu model.
-->
<odoo>
    <data>
        <!-- Fleet Menu -->
        <record id="menu_fleet" model="theme.website.menu">
            <field name="name">Fleet</field>
            <field name="url">/fleet</field>
            <field name="page_id" ref="drivex_fleet_page_page"/>
            <field name="sequence" type="int">10</field>
        </record>
        <!-- Services Menu -->
        <record id="menu_services" model="theme.website.menu">
            <field name="name">Services</field>
            <field name="url">/services</field>
            <field name="page_id" ref="drivex_services_page_page"/>
            <field name="sequence" type="int">20</field>
        </record>
        <!-- About Us Menu -->
        <record id="menu_about" model="theme.website.menu">
            <field name="name">About Us</field>
            <field name="url">/about</field>
            <field name="page_id" ref="drivex_about_page_page"/>
            <field name="sequence" type="int">30</field>
        </record>
    </data>
</odoo>
