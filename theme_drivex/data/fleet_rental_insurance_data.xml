<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the data records for the fleet.rental.insurance model. -->
<odoo>
    <data noupdate="1">
        <!-- INSURANCE PLANS -->
        <record id="ins_basic" model="fleet.rental.insurance">
            <field name="name">Basic Coverage</field>
            <field name="description">Third-party liability only.</field>
            <field name="price_per_day">0.0</field>
            <field name="is_default">True</field>
        </record>
        <record id="ins_comprehensive" model="fleet.rental.insurance">
            <field name="name">Comprehensive Plus</field>
            <field name="description">Full coverage + zero excess.</field>
            <field name="price_per_day">25.0</field>
            <field name="is_default">False</field>
        </record>
    </data>
</odoo>
