<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the views and actions  records for the fleet.rental.insurance model in theme_drivex module. -->
<odoo>
    <!-- FLEET RENTAL INSURANCE  -->
    <record id="fleet_rental_insurance_view_list" model="ir.ui.view">
        <field name="name">fleet.rental.insurance.view.list</field>
        <field name="model">fleet.rental.insurance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="price_per_day"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>
    <record id="action_fleet_rental_insurance" model="ir.actions.act_window">
        <field name="name">Insurance Plans</field>
        <field name="res_model">fleet.rental.insurance</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_rental_insurance" name="Insurance Plans" parent="fleet.fleet_configuration" action="action_fleet_rental_insurance" sequence="110"/>
</odoo>
