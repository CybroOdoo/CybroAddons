<?xml version="1.0" encoding="UTF-8" ?>
<!--
    This file contains the list view, action and menu for the fleet.rental.insurance model.
-->
<odoo>
    <record id="fleet_rental_insurance_view_list" model="ir.ui.view">
        <field name="name">fleet.rental.insurance.view.list</field>
        <field name="model">fleet.rental.insurance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="price_per_day"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>
    <record id="fleet_rental_insurance_action" model="ir.actions.act_window">
        <field name="name">Insurance Plans</field>
        <field name="res_model">fleet.rental.insurance</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="fleet_rental_insurance_menu" name="Insurance Plans"
              parent="fleet.fleet_configuration"
              action="fleet_rental_insurance_action" sequence="110"/>
</odoo>
