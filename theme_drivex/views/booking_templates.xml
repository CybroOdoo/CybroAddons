<?xml version="1.0" encoding="utf-8"?>
<!--
    DriveX Theme - Booking Templates
    This file contains the XML template and record  for the Booking Page of the DriveX website theme.
-->
<odoo>
    <template id="drivex_booking_page" name="DriveX Booking">
        <t t-call="website.layout">
            <t t-set="title">Book a Car — DriveX Premium Car Rental</t>
            <div id="wrap" style="background:#0a0e1a;padding-top:80px;">

                <!-- Page Title -->
                <div class="bw-page-title-bar">
                    <div class="container-inner">
                        <div class="bw-page-breadcrumb">
                            <a href="/">Home</a><i class="fa-solid fa-chevron-right"/>
                            <a href="/fleet">Fleet</a><i class="fa-solid fa-chevron-right"/>
                            <span>Book Now</span>
                        </div>
                        <h1>Book Your <span>Dream Car</span></h1>
                    </div>
                </div>
                <!-- Progress Bar -->
                <div class="bw-progress-wrap">
                    <div class="bw-progress">
                        <div class="bw-step active">
                            <div class="bw-step-num">1</div>
                            <span class="bw-step-label">Choose Dates</span>
                        </div>
                        <div class="bw-step-line"/>
                        <div class="bw-step">
                            <div class="bw-step-num">2</div>
                            <span class="bw-step-label">Driver Info</span>
                        </div>
                        <div class="bw-step-line"/>
                        <div class="bw-step">
                            <div class="bw-step-num">3</div>
                            <span class="bw-step-label">Extras</span>
                        </div>
                        <div class="bw-step-line"/>
                        <div class="bw-step">
                            <div class="bw-step-num"><i class="fa-solid fa-check"/></div>
                            <span class="bw-step-label">Confirmed</span>
                        </div>
                    </div>
                </div>
                <!-- Wizard Body -->
                <div class="bw-body">
                    <div class="bw-panels">
                        <!-- Step 1: Dates -->
                        <div class="step1 bw-step-panel active">
                            <!-- Selected Vehicle card -->
                            <div class="bw-card">
                                <div class="bw-card-title"><i class="fa-solid fa-car-side"/> Selected Vehicle</div>
                                <t t-if="not demo_fallback">
                                    <div class="bw-vehicle-row" t-if="vehicle" t-att-data-vehicle-id="vehicle.id">
                                        <img t-attf-src="/web/image/fleet.vehicle/#{vehicle.id}/image_128" t-att-alt="vehicle.model_id.name" class="bw-vehicle-img"/>
                                        <div class="bw-vehicle-info">
                                            <h3><t t-esc="vehicle.model_id.brand_id.name"/> <t t-esc="vehicle.model_id.name"/></h3>
                                            <p class="bw-vi-sub">
                                                <t t-if="vehicle.category_id"><t t-esc="vehicle.category_id.name"/> &#160;·&#160; </t>
                                                <t t-if="vehicle.model_year"><t t-esc="vehicle.model_year"/></t>
                                            </p>
                                            <span class="bw-vi-badge" t-if="vehicle.category_id"><t t-esc="vehicle.category_id.name"/></span>
                                            <div class="bw-vi-rate">$<span class="vehicleDailyRate"><t t-esc="vehicle.daily_rate"/></span> <span>/day</span></div>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="bw-vehicle-row" data-vehicle-id="0">
                                        <img src="https://images.unsplash.com/photo-1555215695-3004980ad54e?q=80&amp;w=300&amp;auto=format&amp;fit=crop" alt="BMW M4" class="bw-vehicle-img"/>
                                        <div class="bw-vehicle-info">
                                            <h3>BMW M4 Competition</h3>
                                            <p class="bw-vi-sub">Luxury Sports &#160;&#183;&#160; 2026</p>
                                            <span class="bw-vi-badge">Luxury Sports</span>
                                            <div class="bw-vi-rate">$<span class="vehicleDailyRate">180</span> <span>/day</span></div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <!-- Choose Your Trip Dates -->
                            <div class="bw-card">
                                <div class="bw-section-label">Choose Your Trip Dates</div>
                                <!-- data-vehicle-id lets JS fetch booked ranges only when no URL params -->
                                <div class="bw-form-grid" id="bwDateGrid"
                                     t-att-data-vehicle-id="vehicle.id if not demo_fallback else 0">
                                    <!-- Pickup Date -->
                                    <div class="bw-field">
                                        <label>Pickup Date &amp; Time <span class="req">*</span></label>
                                        <div class="date-field tripPickupField">
                                            <div class="date-display placeholder tripPickupDisplay">
                                                <span class="dd-day">DD</span> <span class="dd-month">Mon</span> <span class="dd-year">YYYY</span>
                                                <span class="dd-sep">·</span>
                                                <span class="dd-time">HH:MM</span>
                                            </div>
                                            <div class="dp-panel tripPickupPanel">
                                                <div class="dp-header">
                                                    <button class="dp-prev" type="button">&#8249;</button>
                                                    <span class="dp-my"></span>
                                                    <button class="dp-next" type="button">&#8250;</button>
                                                </div>
                                                <div class="dp-weekdays"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
                                                <div class="dp-grid"></div>
                                                <div class="dp-time">
                                                    <div class="dp-time-col">
                                                        <button class="dp-tc" type="button">▲</button>
                                                        <span class="dp-hh">12</span>
                                                        <button class="dp-tc" type="button">▼</button>
                                                    </div>
                                                    <span class="dp-tsep">:</span>
                                                    <div class="dp-time-col">
                                                        <button class="dp-tc" type="button">▲</button>
                                                        <span class="dp-mm">00</span>
                                                        <button class="dp-tc" type="button">▼</button>
                                                    </div>
                                                </div>
                                                <button class="dp-confirm-btn" type="button">Confirm</button>
                                            </div>
                                            <input type="hidden" class="tripPickup" required="required"/>
                                        </div>
                                    </div>
                                    <!-- Return Date -->
                                    <div class="bw-field">
                                        <label>Return Date &amp; Time <span class="req">*</span></label>
                                        <div class="date-field tripReturnField">
                                            <div class="date-display placeholder tripReturnDisplay">
                                                <span class="dd-day">DD</span> <span class="dd-month">Mon</span> <span class="dd-year">YYYY</span>
                                                <span class="dd-sep">·</span>
                                                <span class="dd-time">HH:MM</span>
                                            </div>
                                            <div class="dp-panel tripReturnPanel">
                                                <div class="dp-header">
                                                    <button class="dp-prev" type="button">&#8249;</button>
                                                    <span class="dp-my"></span>
                                                    <button class="dp-next" type="button">&#8250;</button>
                                                </div>
                                                <div class="dp-weekdays"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
                                                <div class="dp-grid"></div>
                                                <div class="dp-time">
                                                    <div class="dp-time-col">
                                                        <button class="dp-tc" type="button">▲</button>
                                                        <span class="dp-hh">12</span>
                                                        <button class="dp-tc" type="button">▼</button>
                                                    </div>
                                                    <span class="dp-tsep">:</span>
                                                    <div class="dp-time-col">
                                                        <button class="dp-tc" type="button">▲</button>
                                                        <span class="dp-mm">00</span>
                                                        <button class="dp-tc" type="button">▼</button>
                                                    </div>
                                                </div>
                                                <button class="dp-confirm-btn" type="button">Confirm</button>
                                            </div>
                                            <input type="hidden" class="tripReturn" required="required"/>
                                        </div>
                                    </div>
                                    <div class="bw-field">
                                        <label>Pickup Time <span class="req">*</span></label>
                                        <select class="tripPickupTime" required="required">
                                            <option value="">Select time</option>
                                            <option>06:00 AM</option><option>07:00 AM</option><option>08:00 AM</option>
                                            <option>09:00 AM</option><option>10:00 AM</option><option>11:00 AM</option>
                                            <option selected="selected">12:00 PM</option><option>01:00 PM</option><option>02:00 PM</option>
                                            <option>03:00 PM</option><option>04:00 PM</option><option>05:00 PM</option>
                                            <option>06:00 PM</option><option>07:00 PM</option><option>08:00 PM</option>
                                        </select>
                                    </div>
                                    <div class="bw-field">
                                        <label>Return Time <span class="req">*</span></label>
                                        <select class="tripReturnTime" required="required">
                                            <option value="">Select time</option>
                                            <option>06:00 AM</option><option>07:00 AM</option><option>08:00 AM</option>
                                            <option>09:00 AM</option><option>10:00 AM</option><option>11:00 AM</option>
                                            <option>12:00 PM</option><option>01:00 PM</option><option>02:00 PM</option>
                                            <option>03:00 PM</option><option>04:00 PM</option><option>05:00 PM</option>
                                            <option selected="selected">06:00 PM</option><option>07:00 PM</option><option>08:00 PM</option>
                                        </select>
                                    </div>
                                </div>
                                <!-- Pickup &amp; Return Locations -->
                                <div style="margin-top:20px;">
                                    <div class="bw-section-label">Pickup &amp; Return Locations</div>
                                    <div class="bw-form-grid">
                                        <div class="bw-field">
                                            <label>Pickup Location <span class="req">*</span></label>
                                            <select class="tripPickupLoc" required="required">
                                                <option value="">Select location</option>
                                                <t t-foreach="locations" t-as="loc">
                                                    <option t-att-value="loc.id"><t t-esc="loc.name"/></option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="bw-field">
                                            <label>Return Location</label>
                                            <select class="tripReturnLoc">
                                                <option value="same">Same as pickup</option>
                                                <t t-foreach="locations" t-as="loc">
                                                    <option t-att-value="loc.id"><t t-esc="loc.name"/></option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="bw-nav">
                                <a href="/fleet" class="bw-btn-back"><i class="fa-solid fa-arrow-left"/> Back to Fleet</a>
                                <button class="bw-btn-next bw-btn-next-action" data-next-step="1">Continue <i class="fa-solid fa-arrow-right"/></button>
                            </div>
                        </div>
                        <!-- Step 2: Driver Info -->
                        <div class="step2 bw-step-panel">
                            <div class="bw-card">
                                <div class="bw-card-title"><i class="fa-solid fa-user"/> Driver Details</div>
                                <div class="bw-section-label">Personal Information</div>
                                <div class="bw-form-grid">
                                    <div class="bw-field">
                                        <label>First Name <span class="req">*</span></label>
                                        <input type="text" class="driverFname" placeholder="John" required="required" t-att-value="driver_defaults and driver_defaults.get('fname') or None"/>
                                    </div>
                                    <div class="bw-field">
                                        <label>Last Name <span class="req">*</span></label>
                                        <input type="text" class="driverLname" placeholder="Doe" required="required" t-att-value="driver_defaults and driver_defaults.get('lname') or None"/>
                                    </div>
                                    <div class="bw-field">
                                        <label>Email Address <span class="req">*</span></label>
                                        <input type="email" class="driverEmail" placeholder="john@example.com" required="required" t-att-value="driver_defaults and driver_defaults.get('email') or None"/>
                                    </div>
                                    <div class="bw-field">
                                        <label>Phone Number <span class="req">*</span></label>
                                        <input type="tel" class="driverPhone" placeholder="+91 98765 43210" required="required" t-att-value="driver_defaults and driver_defaults.get('phone') or None"/>
                                    </div>
                                    <div class="bw-field">
                                        <label>Date of Birth <span class="req">*</span></label>
                                        <div class="date-field dobField">
                                            <div class="date-display placeholder dobDisplay">
                                                <span class="dd-day">DD</span> <span class="dd-month">Mon</span> <span class="dd-year">YYYY</span>
                                            </div>
                                            <div class="dp-panel dobPanel">
                                                <div class="dp-header">
                                                    <button class="dp-prev" type="button">&#8249;</button>
                                                    <span class="dp-my"></span>
                                                    <button class="dp-next" type="button">&#8250;</button>
                                                </div>
                                                <div class="dp-weekdays"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
                                                <div class="dp-grid"></div>
                                                <button class="dp-confirm-btn" type="button">Confirm</button>
                                            </div>
                                            <input type="hidden" class="driverDob" required="required"/>
                                        </div>
                                    </div>
                                    <div class="bw-field">
                                        <label>Age</label>
                                        <input type="text" class="driverAge" readonly="readonly" placeholder="Auto-calculated" style="background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.5);cursor:default;"/>
                                    </div>
                                    <div class="bw-field">
                                        <label>Nationality</label>
                                        <select class="driverNationality">
                                            <option>Indian</option>
                                            <option>American</option>
                                            <option>British</option>
                                            <option>Other</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="bw-section-label" style="margin-top:24px;">Driving Licence</div>
                                <div class="bw-form-grid">
                                    <div class="bw-field">
                                        <label>Licence Number <span class="req">*</span></label>
                                        <input type="text" class="driverLicense" placeholder="MH 1234567890123" required="required"/>
                                    </div>
                                    <div class="bw-field">
                                        <label>Expiry Date <span class="req">*</span></label>
                                        <div class="date-field licExpiryField">
                                            <div class="date-display placeholder licExpiryDisplay">
                                                <span class="dd-day">DD</span> <span class="dd-month">Mon</span> <span class="dd-year">YYYY</span>
                                            </div>
                                            <div class="dp-panel licExpiryPanel">
                                                <div class="dp-header">
                                                    <button class="dp-prev" type="button">&#8249;</button>
                                                    <span class="dp-my"></span>
                                                    <button class="dp-next" type="button">&#8250;</button>
                                                </div>
                                                <div class="dp-weekdays"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
                                                <div class="dp-grid"></div>
                                                <button class="dp-confirm-btn" type="button">Confirm</button>
                                            </div>
                                            <input type="hidden" class="driverLicenseExpiry" required="required"/>
                                        </div>
                                    </div>
                                    <div class="bw-field">
                                        <label>Issuing Country <span class="req">*</span></label>
                                        <select class="driverIssuingCountry">
                                            <option>India</option>
                                            <option>USA</option>
                                            <option>UK</option>
                                        </select>
                                    </div>
                                    <div class="bw-field">
                                        <label>Issuing State</label>
                                        <input type="text" class="driverLicenseState" placeholder="Maharashtra"/>
                                    </div>
                                </div>
                            </div>
                            <div class="bw-nav">
                                <button class="bw-btn-back bw-btn-back-action" data-prev-step="2"><i class="fa-solid fa-arrow-left"/> Back</button>
                                <button class="bw-btn-next bw-btn-next-action" data-next-step="2">Continue <i class="fa-solid fa-arrow-right"/></button>
                            </div>
                        </div>
                        <!-- Step 3: Extras -->
                        <div class="step3 bw-step-panel">
                            <div class="bw-card">
                                <div class="bw-card-title"><i class="fa-solid fa-shield-halved"/> Insurance Options</div>
                                <div style="display:flex;flex-direction:column;gap:12px;" class="insuranceOptions">
                                    <t t-if="not demo_fallback">
                                        <t t-foreach="insurances" t-as="ins">
                                            <div t-attf-class="bw-ins-card #{'selected' if ins.is_default else ''}" 
                                                 t-att-data-id="ins.id" t-att-data-price="ins.price_per_day"
                                                  
                                                 style="border:2px solid rgba(255,255,255,.08);border-radius:12px;padding:20px;cursor:pointer;transition:all .25s;">
                                                <div style="display:flex;justify-content:space-between;align-items:center;">
                                                    <div>
                                                        <h4 style="color:#fff;font-size:.95rem;font-weight:700;"><t t-esc="ins.name"/></h4>
                                                        <p style="color:rgba(255,255,255,.45);font-size:.82rem;margin-top:4px;"><t t-esc="ins.description"/></p>
                                                    </div>
                                                    <div style="color:var(--accent);font-weight:800;font-size:1.1rem;">
                                                        <t t-if="ins.price_per_day == 0">Included</t>
                                                        <t t-else="">+$<t t-esc="ins.price_per_day"/><span style="font-size:.7rem;color:rgba(255,255,255,.4);font-weight:400;">/day</span></t>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="bw-ins-card selected" data-id="basic" data-price="0"  style="border:2px solid rgba(255,255,255,.08);border-radius:12px;padding:20px;cursor:pointer;transition:all .25s;">
                                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                                <div>
                                                    <h4 style="color:#fff;font-size:.95rem;font-weight:700;">Basic Cover</h4>
                                                    <p style="color:rgba(255,255,255,.45);font-size:.82rem;margin-top:4px;">Third-party liability. $800 excess on own damage. Required by law.</p>
                                                </div>
                                                <div style="color:var(--accent);font-weight:800;font-size:1.1rem;">Included</div>
                                            </div>
                                        </div>
                                        <div class="bw-ins-card" data-id="comprehensive" data-price="20"  style="border:2px solid rgba(255,255,255,.08);border-radius:12px;padding:20px;cursor:pointer;transition:all .25s;">
                                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                                <div>
                                                    <h4 style="color:#fff;font-size:.95rem;font-weight:700;">Comprehensive</h4>
                                                    <p style="color:rgba(255,255,255,.45);font-size:.82rem;margin-top:4px;">Covers own vehicle damage. $200 excess. Roadside assistance included.</p>
                                                </div>
                                                <div style="color:var(--accent);font-weight:800;font-size:1.1rem;">+$20<span style="font-size:.7rem;color:rgba(255,255,255,.4);font-weight:400;">/day</span></div>
                                            </div>
                                        </div>
                                        <div class="bw-ins-card" data-id="premium" data-price="40"  style="border:2px solid rgba(255,255,255,.08);border-radius:12px;padding:20px;cursor:pointer;transition:all .25s;">
                                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                                <div>
                                                    <h4 style="color:#fff;font-size:.95rem;font-weight:700;">Zero Excess</h4>
                                                    <p style="color:rgba(255,255,255,.45);font-size:.82rem;margin-top:4px;">Full coverage, zero excess. Includes windscreen, tyres &amp; personal effects.</p>
                                                </div>
                                                <div style="color:var(--accent);font-weight:800;font-size:1.1rem;">+$40<span style="font-size:.7rem;color:rgba(255,255,255,.4);font-weight:400;">/day</span></div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <div class="bw-card">
                                <div class="bw-card-title"><i class="fa-solid fa-plus"/> Add-Ons</div>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;" class="addonOptions">
                                    <t t-if="not demo_fallback">
                                        <t t-foreach="addons" t-as="add">
                                            <div class="bw-addon" t-att-data-id="add.id" t-att-data-price="add.price" t-att-data-type="add.charge_type"  style="border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px;cursor:pointer;transition:all .25s;">
                                                <div style="display:flex;justify-content:space-between;">
                                                    <span style="color:#fff;font-size:.88rem;font-weight:600;">
                                                        <i t-attf-class="fa-solid #{add.icon or 'fa-plus'}" style="color:var(--accent);margin-right:8px;"/>
                                                        <t t-esc="add.name"/>
                                                    </span>
                                                    <span style="color:var(--accent);font-weight:700;">+$<t t-esc="add.price"/><t t-if="add.charge_type == 'per_day'">/day</t><t t-else=""> flat</t></span>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="bw-addon" data-price="5" data-type="per_day"  style="border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px;cursor:pointer;transition:all .25s;">
                                            <div style="display:flex;justify-content:space-between;">
                                                <span style="color:#fff;font-size:.88rem;font-weight:600;"><i class="fa-solid fa-map-location-dot" style="color:var(--accent);margin-right:8px;"/>GPS Navigator</span>
                                                <span style="color:var(--accent);font-weight:700;">+$5/day</span>
                                            </div>
                                        </div>
                                        <div class="bw-addon" data-price="8" data-type="per_day"  style="border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px;cursor:pointer;transition:all .25s;">
                                            <div style="display:flex;justify-content:space-between;">
                                                <span style="color:#fff;font-size:.88rem;font-weight:600;"><i class="fa-solid fa-baby" style="color:var(--accent);margin-right:8px;"/>Child Safety Seat</span>
                                                <span style="color:var(--accent);font-weight:700;">+$8/day</span>
                                            </div>
                                        </div>
                                        <div class="bw-addon" data-price="25" data-type="per_day"  style="border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px;cursor:pointer;transition:all .25s;">
                                            <div style="display:flex;justify-content:space-between;">
                                                <span style="color:#fff;font-size:.88rem;font-weight:600;"><i class="fa-solid fa-user-plus" style="color:var(--accent);margin-right:8px;"/>Extra Driver</span>
                                                <span style="color:var(--accent);font-weight:700;">+$25/day</span>
                                            </div>
                                        </div>
                                        <div class="bw-addon" data-price="12" data-type="flat"  style="border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px;cursor:pointer;transition:all .25s;">
                                            <div style="display:flex;justify-content:space-between;">
                                                <span style="color:#fff;font-size:.88rem;font-weight:600;"><i class="fa-solid fa-gas-pump" style="color:var(--accent);margin-right:8px;"/>Pre-paid Fuel</span>
                                                <span style="color:var(--accent);font-weight:700;">+$12 flat</span>
                                            </div>
                                        </div>
                                        <div class="bw-addon" data-price="10" data-type="per_day"  style="border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px;cursor:pointer;transition:all .25s;">
                                            <div style="display:flex;justify-content:space-between;">
                                                <span style="color:#fff;font-size:.88rem;font-weight:600;"><i class="fa-solid fa-wifi" style="color:var(--accent);margin-right:8px;"/>Mobile WiFi Hotspot</span>
                                                <span style="color:var(--accent);font-weight:700;">+$10/day</span>
                                            </div>
                                        </div>
                                        <div class="bw-addon" data-price="15" data-type="flat"  style="border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px;cursor:pointer;transition:all .25s;">
                                            <div style="display:flex;justify-content:space-between;">
                                                <span style="color:#fff;font-size:.88rem;font-weight:600;"><i class="fa-solid fa-camera" style="color:var(--accent);margin-right:8px;"/>Dashcam</span>
                                                <span style="color:var(--accent);font-weight:700;">+$15 flat</span>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <div style="margin-top: 20px; font-size: 0.85rem; color: #ccc;">
                                <input type="checkbox" class="termsCheck" style="margin-right: 8px;"/>
                                <label for="termsCheck">I agree to the <a href="/terms" style="color: var(--accent);">Terms and Conditions</a></label>
                            </div>
                            <div class="bw-nav">
                                <button class="bw-btn-back bw-btn-back-action" data-prev-step="3"><i class="fa-solid fa-arrow-left"/> Back</button>
                                <button class="bw-btn-next bw-btn-confirm-action" style="background:#1a7a3a;">
                                    <i class="fa-solid fa-check"/> Confirm Booking
                                </button>
                            </div>
                        </div>
                        <!-- Step 4: Confirmation -->
                        <div class="step4 bw-step-panel">
                            <div class="bw-card" style="text-align:center;padding:60px 40px;">
                                <div style="width:80px;height:80px;background:rgba(26,122,58,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;"><i class="fa-solid fa-circle-check" style="font-size:2.5rem;color:#1a7a3a;"/></div>
                                <h2 style="font-size:1.8rem;font-weight:800;color:#fff;margin-bottom:10px;">Booking Confirmed!</h2>
                                <p style="color:rgba(255,255,255,.5);font-size:.95rem;margin-bottom:28px;">Your reservation is confirmed. A confirmation email has been sent to <strong class="confirmEmail" style="color:#fff;">your inbox</strong>.</p>
                                <div style="background:#071021;border-radius:12px;padding:20px;margin-bottom:28px;display:inline-block;">
                                    <div style="font-size:.72rem;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px;">Booking Reference</div>
                                    <div class="bookingRef" style="font-size:1.6rem;font-weight:800;color:var(--accent);letter-spacing:.08em;">DRX-12345678</div>
                                </div>
                                <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
                                    <button class="bw-btn-copy-ref bw-btn-back"><i class="fa-solid fa-copy"/> Copy Reference</button>
                                    <a href="/fleet" class="bw-btn-next" style="text-decoration:none;"><i class="fa-solid fa-car"/> Browse More Cars</a>
                                </div>
                            </div>
                        </div>
                    </div><!-- /.bw-panels -->
                    <!-- Summary Sidebar -->
                    <div class="bw-summary">
                        <t t-if="not demo_fallback">
                            <div class="bw-summary-card" t-if="vehicle">
                                <img t-attf-src="/web/image/fleet.vehicle/#{vehicle.id}/image_128" t-att-alt="vehicle.model_id.name" class="bw-sum-img"/>
                                <div class="bw-sum-body">
                                    <div class="bw-sum-car-name"><t t-esc="vehicle.model_id.brand_id.name"/> <t t-esc="vehicle.model_id.name"/></div>
                                    <div class="bw-sum-car-sub">
                                        <t t-if="vehicle.category_id"><t t-esc="vehicle.category_id.name"/> &#xb7; </t>
                                        <t t-if="vehicle.model_year"><t t-esc="vehicle.model_year"/></t>
                                    </div>
                                    <div class="bw-sum-row"><span class="bw-sr-label">Base Rate</span><span class="bw-sr-val">$<span class="sumBaseRate"><t t-esc="vehicle.daily_rate"/></span> / day</span></div>
                                    <div class="bw-sum-row"><span class="bw-sr-label">Rental Duration</span><span class="bw-sr-val sumDays">1 day</span></div>
                                    <div class="bw-sum-row"><span class="bw-sr-label">Insurance</span><span class="bw-sr-val sumInsurance">+$0/day</span></div>
                                    <div class="bw-sum-row"><span class="bw-sr-label">Add-ons</span><span class="bw-sr-val sumAddons">$0</span></div>
                                    <div class="bw-sum-row" style="display:none;"><span class="bw-sr-label">Taxes &amp; Fees</span><span class="bw-sr-val sumTaxes">$0</span></div>
                                    <div class="bw-sum-divider"/>
                                    <div class="bw-sum-total-row">
                                        <span class="bw-sum-total-label">Total</span>
                                        <span class="bw-sum-total-val sumTotal">$<t t-esc="vehicle.daily_rate"/></span>
                                    </div>
                                    <div class="bw-sum-note">Price includes all taxes. No hidden charges.</div>
                                    <div class="bw-sum-features">
                                        <div class="bw-sf-item"><i class="fa-solid fa-check"/> Free cancellation up to 24h</div>
                                        <div class="bw-sf-item"><i class="fa-solid fa-check"/> 24/7 roadside assistance</div>
                                        <div class="bw-sf-item"><i class="fa-solid fa-check"/> Comprehensive insurance</div>
                                        <div class="bw-sf-item"><i class="fa-solid fa-check"/> Flexible pickup locations</div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="bw-summary-card">
                                <img src="https://images.unsplash.com/photo-1555215695-3004980ad54e?q=80&amp;w=600&amp;auto=format&amp;fit=crop"
                                     alt="BMW M4 Competition" class="bw-sum-img sumImg"/>
                                <div class="bw-sum-body">
        <div class="bw-sum-car-name sumCarName">BMW M4 Competition</div>
        <div class="bw-sum-car-sub sumCarSub">Luxury Sports · 2026</div>
        <div class="bw-sum-row">
          <span class="bw-sr-label">Pickup</span>
          <span class="bw-sr-val sumPickup">—</span>
        </div>
        <div class="bw-sum-row">
          <span class="bw-sr-label">Return</span>
          <span class="bw-sr-val sumReturn">—</span>
        </div>
        <div class="bw-sum-row">
          <span class="bw-sr-label">Duration</span>
          <span class="bw-sr-val sumDays">— days</span>
        </div>
        <div class="bw-sum-divider"></div>
        <div class="bw-sum-row">
          <span class="bw-sr-label">Base rate</span>
          <span class="bw-sr-val">$<span class="sumBaseRate">180</span>/day</span>
        </div>
        <div class="bw-sum-row sumInsRow" style="display:none">
          <span class="bw-sr-label">Insurance</span>
          <span class="bw-sr-val sumInsVal">+$0/day</span>
        </div>
        <div class="bw-sum-row sumAddonsRow" style="display:none">
          <span class="bw-sr-label">Add-ons</span>
          <span class="bw-sr-val sumAddonsVal">$0</span>
        </div>
        <div class="bw-sum-row">
          <span class="bw-sr-label">Taxes &amp; fees</span>
          <span class="bw-sr-val">Included</span>
        </div>
        <div class="bw-sum-total-row">
          <span class="bw-sum-total-label">Total</span>
          <span class="bw-sum-total-val sumTotal">$180</span>
        </div>
        <div class="bw-sum-note">1 day · No hidden charges</div>
        <div class="bw-sum-features">
          <div class="bw-sf-item"><i class="fa-solid fa-check"></i> Free cancellation (24hrs)</div>
          <div class="bw-sf-item"><i class="fa-solid fa-check"></i> 24/7 roadside assistance</div>
          <div class="bw-sf-item"><i class="fa-solid fa-check"></i> No card surcharge</div>
          <div class="bw-sf-item"><i class="fa-solid fa-check"></i> Instant confirmation</div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
                </div><!-- /.bw-body -->
            </div>
        </t>
    </template>
    <record id="drivex_booking_page_page" model="website.page">
        <field name="name">DriveX Booking</field>
        <field name="url">/booking</field>
        <field name="type">qweb</field>
        <field name="key">theme_drivex.drivex_booking_page</field>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
        <field name="arch" type="xml">
            <t t-call="theme_drivex.drivex_booking_page"/>
        </field>
    </record>
