<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================
         SNIPPET: CTA Banner
    ============================================================ -->
    <template id="drivex_cta_banner" name="DriveX CTA Banner">
        <section class="cta-banner" data-snippet="theme_drivex.drivex_cta_banner" data-name="CTA Banner">
            <div class="container cta-content">
                <div class="cta-text">
                    <h2 class="o_editable">Ready to Hit the Road?</h2>
                    <p class="o_editable">Book your dream car today and get 10% off your first rental.</p>
                </div>
                <div class="cta-actions">
                    <a href="/booking" class="btn-red"><i class="fa-solid fa-bolt"/> Book Now</a>
                    <a href="/contact" class="btn-outline-white"><i class="fa-solid fa-phone"/> Call Us</a>
                </div>
            </div>
        </section>
    </template>
</odoo>
