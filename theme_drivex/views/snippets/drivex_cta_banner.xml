<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML templates for the Drivex Cta Banner of the DriveX website theme.
-->
<odoo>
    <template id="drivex_cta_banner" name="DriveX CTA Banner">
        <section class="cta-banner" data-snippet="theme_drivex.drivex_cta_banner" data-name="CTA Banner">
            <div class="container cta-content">
                <div class="cta-text">
                    <h2 class="o_editable">Ready to Hit the Road?</h2>
                    <p class="o_editable">Book your dream car today and get 10% off your first rental.</p>
                </div>
                <div class="cta-actions">
                    <a href="/booking" class="btn-red"><i class="fa-solid fa-bolt"/> Book Now</a>
                    <a href="/contactus" class="btn-outline-white"><i class="fa-solid fa-phone"/> Call Us</a>
                </div>
            </div>
        </section>
    </template>
    <template id="drivex_cta_banner_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_drivex.drivex_cta_banner" string="CTA Banner" t-thumbnail="/theme_drivex/static/src/img/car.svg" group="drivex_homepage"/>
        </xpath>
    </template>
</odoo>
