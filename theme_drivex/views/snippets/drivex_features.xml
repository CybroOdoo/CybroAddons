<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================
         SNIPPET: Why Choose Us
    ============================================================ -->
    <template id="drivex_features" name="DriveX Features">
        <section class="features" id="features" data-snippet="theme_drivex.drivex_features" data-name="Why Choose Us">
            <div class="container">
                <span class="section-badge dark o_editable">Why Us</span>
                <h2 class="o_editable">Why Choose DriveX</h2>
                <p class="section-sub o_editable">Everything you need for a perfect driving experience</p>
                <div class="feature-grid">
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-car-side"/></div>
                        <h3 class="o_editable">Wide Range of Vehicles</h3>
                        <p class="o_editable">From economy to luxury sports cars — 5,000+ options at your fingertips.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-tag"/></div>
                        <h3 class="o_editable">Transparent Pricing</h3>
                        <p class="o_editable">No hidden fees, no surprises. What you see is exactly what you pay.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-bolt"/></div>
                        <h3 class="o_editable">Instant Booking</h3>
                        <p class="o_editable">Confirm your reservation in under 60 seconds, anytime, anywhere.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-shield-halved"/></div>
                        <h3 class="o_editable">Fully Insured</h3>
                        <p class="o_editable">Every vehicle comes with comprehensive insurance for complete peace of mind.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-location-dot"/></div>
                        <h3 class="o_editable">Multiple Locations</h3>
                        <p class="o_editable">Pickup from 50+ airports, hotels and city centers across the country.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-headset"/></div>
                        <h3 class="o_editable">24/7 Support</h3>
                        <p class="o_editable">Round-the-clock customer service — call, chat, or email us anytime.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
