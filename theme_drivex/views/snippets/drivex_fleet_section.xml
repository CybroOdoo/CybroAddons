<?xml version="1.0" encoding="UTF-8"?>
<!--
    Description: This file defines the drivex_fleet_section views/templates for the theme_drivex module.
-->
<odoo>
    <template id="drivex_fleet_section" name="DriveX Fleet Section">
        <section class="fleet-section" id="fleet" data-snippet="theme_drivex.drivex_fleet_section" data-name="Fleet Section">
            <div class="fleet-header">
                <span class="section-badge o_editable">Our Fleet</span>
                <h2 class="o_editable">Premium Vehicles for Every Journey</h2>
                <p class="o_editable">Choose from our wide selection of high-end vehicles, perfectly<br/>maintained and ready for your next adventure.</p>
            </div>
            <div class="fleet-filter" id="snippetFleetFilter">
                <button class="filter-btn active" data-filter="all">All</button>
                <!-- category filter buttons populated by JS via /homepage/data -->
            </div>
            <div class="fleet-grid" id="snippetFleetGrid">
                <!-- vehicle cards populated by JS via /homepage/data -->
            </div>
            <div class="fleet-cta">
                <a href="/fleet" class="btn-outline-white">View All Vehicles <i class="fa-solid fa-arrow-right"/></a>
            </div>
        </section>
    </template>
    <template id="drivex_fleet_section_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_drivex.drivex_fleet_section" string="Fleet Section" t-thumbnail="/theme_drivex/static/src/img/car1.svg" group="drivex_homepage"/>
        </xpath>
    </template>
</odoo>
