<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML templates for the Drivex Rental Terms component
    of the DriveX website theme.
-->
<odoo>
    <!-- SNIPPET: Rental Terms -->
    <template id="drivex_rental_terms" name="DriveX Rental Terms">
        <section class="detail-desc-section s_drivex_rental_terms"
                 data-snippet="theme_drivex.drivex_rental_terms"
                 data-name="Rental Terms">
            <div class="container">
                <h2 class="o_editable"><i class="fa-solid fa-file-contract"
                                          style="color:var(--accent);margin-right:10px"/>Rental Terms
                </h2>
                <div style="display:flex;flex-direction:column;gap:10px;" class="o_editable">
                    <div class="feat-item">
                        <i class="fa-solid fa-check" style="color:var(--accent)"/>
                        Minimum rental age: 25 years
                    </div>
                    <div class="feat-item">
                        <i class="fa-solid fa-check" style="color:var(--accent)"/>
                        Driving licence held for 3+ years
                    </div>
                    <div class="feat-item">
                        <i class="fa-solid fa-check" style="color:var(--accent)"/>
                        Security deposit: $800 (fully refundable)
                    </div>
                    <div class="feat-item">
                        <i class="fa-solid fa-check" style="color:var(--accent)"/>
                        Comprehensive insurance included
                    </div>
                    <div class="feat-item">
                        <i class="fa-solid fa-check" style="color:var(--accent)"/>
                        300 km/day included (extra km charged)
                    </div>
                    <div class="feat-item">
                        <i class="fa-solid fa-check" style="color:var(--accent)"/>
                        24/7 roadside assistance
                    </div>
                    <div class="feat-item">
                        <i class="fa-solid fa-check" style="color:var(--accent)"/>
                        Free cancellation up to 24 hrs before pickup
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
