<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================
         SNIPPET: Contact Info Cards (Phone, Email, Address, Hours)
    ============================================================ -->
    <template id="drivex_contact_info" name="DriveX Contact Info Cards">
        <section class="contact-info-section s_drivex_contact_info"
                 data-snippet="theme_drivex.drivex_contact_info"
                 data-name="Contact Info">
            <div class="container">
                <div class="contact-info-grid o_editable">
                    <div class="contact-info-card">
                        <div class="contact-info-icon"><i class="fa-solid fa-phone"/></div>
                        <h3>Call Us</h3>
                        <p>Our support team is available 24/7 for urgent enquiries.</p>
                        <a href="tel:+918001234567" class="contact-info-link">+91 800 123 4567</a>
                        <a href="tel:+918001234568" class="contact-info-link contact-info-link--secondary">+91 800 123 4568</a>
                    </div>
                    <div class="contact-info-card">
                        <div class="contact-info-icon"><i class="fa-solid fa-envelope"/></div>
                        <h3>Email Us</h3>
                        <p>We aim to respond within 2 business hours.</p>
                        <a href="mailto:hello@drivex.in" class="contact-info-link">hello@drivex.in</a>
                        <a href="mailto:support@drivex.in" class="contact-info-link contact-info-link--secondary">support@drivex.in</a>
                    </div>
                    <div class="contact-info-card">
                        <div class="contact-info-icon"><i class="fa-solid fa-location-dot"/></div>
                        <h3>Headquarters</h3>
                        <p>Visit us at our main office in the heart of Mumbai.</p>
                        <span class="contact-info-link">12th Floor, Bandra Kurla Complex</span>
                        <span class="contact-info-link contact-info-link--secondary">Mumbai, Maharashtra 400051</span>
                    </div>
                    <div class="contact-info-card">
                        <div class="contact-info-icon"><i class="fa-solid fa-clock"/></div>
                        <h3>Office Hours</h3>
                        <p>Walk-in enquiries by appointment.</p>
                        <span class="contact-info-link">Mon – Fri: 9:00 AM – 7:00 PM</span>
                        <span class="contact-info-link contact-info-link--secondary">Sat – Sun: 10:00 AM – 4:00 PM</span>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- ============================================================
         SNIPPET: Contact Form + Map Side Panel
    ============================================================ -->
    <template id="drivex_contact_form" name="DriveX Contact Form">
        <section class="contact-main-section s_drivex_contact_form"
                 data-snippet="theme_drivex.drivex_contact_form"
                 data-name="Contact Form">
            <div class="contact-form-layout">
                <!-- Form column -->
                <div class="contact-form-wrap">
                    <span class="section-badge dark o_editable">Send a Message</span>
                    <h2 class="o_editable">How Can We Help You?</h2>
                    <p class="form-sub o_editable">Fill in the details below and one of our team members will get back to you within 2 hours.</p>
                    <form class="contact-form" id="contactForm">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="cFirstName">First Name <span class="required">*</span></label>
                                <input type="text" id="cFirstName" name="first_name" placeholder="John" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="cLastName">Last Name <span class="required">*</span></label>
                                <input type="text" id="cLastName" name="last_name" placeholder="Doe" required="required"/>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="cEmail">Email Address <span class="required">*</span></label>
                                <input type="email" id="cEmail" name="email" placeholder="john@example.com" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="cPhone">Phone Number</label>
                                <input type="tel" id="cPhone" name="phone" placeholder="+91 98765 43210"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="cSubject">Subject <span class="required">*</span></label>
                            <select id="cSubject" name="subject" required="required">
                                <option value="" disabled="disabled">Select a topic</option>
                                <option value="booking">Booking Enquiry</option>
                                <option value="corporate">Corporate / Fleet Solutions</option>
                                <option value="support">Support / Issue</option>
                                <option value="feedback">Feedback</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="cMessage">Message <span class="required">*</span></label>
                            <textarea id="cMessage" name="description" rows="6" placeholder="Tell us how we can help you..." required="required"/>
                        </div>
                        <button type="submit" class="form-submit-btn">
                            <i class="fa-solid fa-paper-plane"/> Send Message
                        </button>
                    </form>
                </div>
                <!-- Side column: map + social channels -->
                <div class="contact-side">
                    <div class="contact-map">
                        <div class="map-placeholder">
                            <div class="map-inner o_editable">
                                <i class="fa-solid fa-location-dot"/>
                                <strong>DriveX HQ</strong>
                                <span>Bandra Kurla Complex, Mumbai</span>
                                <a href="https://maps.google.com" target="_blank" rel="noopener" class="map-link">
                                    Open in Google Maps <i class="fa-solid fa-arrow-up-right-from-square"/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="contact-quick">
                        <h3 class="o_editable">Other Ways to Reach Us</h3>
                        <div class="quick-channels o_editable">
                            <a href="#" class="quick-channel">
                                <div class="qc-icon qc-whatsapp"><i class="fa-brands fa-whatsapp"/></div>
                                <div><strong>WhatsApp</strong><span>Chat instantly with our team</span></div>
                                <i class="fa-solid fa-arrow-right qc-arrow"/>
                            </a>
                            <a href="#" class="quick-channel">
                                <div class="qc-icon qc-twitter"><i class="fa-brands fa-x-twitter"/></div>
                                <div><strong>Twitter / X</strong><span>Reach us @DriveXIndia</span></div>
                                <i class="fa-solid fa-arrow-right qc-arrow"/>
                            </a>
                            <a href="#" class="quick-channel">
                                <div class="qc-icon qc-instagram"><i class="fa-brands fa-instagram"/></div>
                                <div><strong>Instagram</strong><span>DM us @drivex.in</span></div>
                                <i class="fa-solid fa-arrow-right qc-arrow"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- ============================================================
         SNIPPET: Our Locations Grid
    ============================================================ -->
    <template id="drivex_locations" name="DriveX Locations">
        <section class="locations-section s_drivex_locations"
                 data-snippet="theme_drivex.drivex_locations"
                 data-name="Our Locations">
            <div class="container">
                <span class="section-badge o_editable">Find Us</span>
                <h2 class="o_editable">Our Locations</h2>
                <p class="section-sub o_editable">Pickup and drop-off available at all branches</p>
                <div class="locations-grid o_editable">
                    <div class="location-card">
                        <div class="location-city"><i class="fa-solid fa-location-dot"/><h3>Mumbai</h3></div>
                        <p>12th Floor, BKC, Bandra East</p>
                        <span><i class="fa-solid fa-clock"/> Open 24/7</span>
                        <a href="tel:+912212345678" class="location-phone">+91 22 1234 5678</a>
                    </div>
                    <div class="location-card">
                        <div class="location-city"><i class="fa-solid fa-location-dot"/><h3>Delhi</h3></div>
                        <p>Connaught Place, New Delhi</p>
                        <span><i class="fa-solid fa-clock"/> Open 24/7</span>
                        <a href="tel:+911112345678" class="location-phone">+91 11 1234 5678</a>
                    </div>
                    <div class="location-card">
                        <div class="location-city"><i class="fa-solid fa-location-dot"/><h3>Bangalore</h3></div>
                        <p>MG Road, Bangalore Central</p>
                        <span><i class="fa-solid fa-clock"/> Open 24/7</span>
                        <a href="tel:+918012345678" class="location-phone">+91 80 1234 5678</a>
                    </div>
                    <div class="location-card">
                        <div class="location-city"><i class="fa-solid fa-location-dot"/><h3>Chennai</h3></div>
                        <p>Anna Salai, Chennai</p>
                        <span><i class="fa-solid fa-clock"/> 6 AM – 11 PM</span>
                        <a href="tel:+914412345678" class="location-phone">+91 44 1234 5678</a>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register all contact snippets -->
</odoo>
