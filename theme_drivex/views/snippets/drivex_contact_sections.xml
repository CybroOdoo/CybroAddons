<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML templates for the snippets of Drivex Contact Page of
    the DriveX website theme.
-->
<odoo>
    <!-- SNIPPET: Contact Info Cards (Phone, Email, Address, Hours) -->
    <template id="drivex_contact_info" name="DriveX Contact Info Cards">
        <section class="contact-info-section s_drivex_contact_info"
                 data-snippet="theme_drivex.drivex_contact_info"
                 data-name="Contact Info">
            <div class="container">
                <div class="contact-info-grid o_editable">
                    <div class="contact-info-card">
                        <div class="contact-info-icon">
                            <i class="fa-solid fa-phone"/>
                        </div>
                        <h3>Call Us</h3>
                        <p>Our support team is available 24/7 for urgent enquiries.</p>
                        <a href="tel:+918001234567" class="contact-info-link">+91 800 123 4567</a>
                        <a href="tel:+918001234568" class="contact-info-link contact-info-link--secondary">+91 800 123
                            4568
                        </a>
                    </div>
                    <div class="contact-info-card">
                        <div class="contact-info-icon">
                            <i class="fa-solid fa-envelope"/>
                        </div>
                        <h3>Email Us</h3>
                        <p>We aim to respond within 2 business hours.</p>
                        <a href="mailto:hello@drivex.in" class="contact-info-link">hello@drivex.in</a>
                        <a href="mailto:support@drivex.in" class="contact-info-link contact-info-link--secondary">
                            support@drivex.in
                        </a>
                    </div>
                    <div class="contact-info-card">
                        <div class="contact-info-icon">
                            <i class="fa-solid fa-location-dot"/>
                        </div>
                        <h3>Headquarters</h3>
                        <p>Visit us at our main office in the heart of Mumbai.</p>
                        <span class="contact-info-link">12th Floor, Bandra Kurla Complex</span>
                        <span class="contact-info-link contact-info-link--secondary">Mumbai, Maharashtra 400051</span>
                    </div>
                    <div class="contact-info-card">
                        <div class="contact-info-icon">
                            <i class="fa-solid fa-clock"/>
                        </div>
                        <h3>Office Hours</h3>
                        <p>Walk-in enquiries by appointment.</p>
                        <span class="contact-info-link">Mon – Fri: 9:00 AM – 7:00 PM</span>
                        <span class="contact-info-link contact-info-link--secondary">Sat – Sun: 10:00 AM – 4:00 PM
                        </span>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- ============================================================
         SNIPPET: Contact Form + Map Side Panel
    ============================================================ -->
    <template id="drivex_contact_form" name="DriveX Contact Form">
        <section class="contact-main-section s_drivex_contact_form"
                 data-snippet="theme_drivex.drivex_contact_form"
                 data-name="Contact Form">
            <div class="contact-main-grid"
                 style="max-width:1200px;margin:0 auto;padding:60px 40px;box-sizing:border-box;">
                <!-- Form column -->
                <div class="contact-form-wrap" style="min-width:0;">
                    <span class="section-badge dark">Send a Message</span>
                    <h2>How Can We Help You?</h2>
                    <p class="form-sub">Fill in the details below and one of our team members will get back to you
                        within 2 hours.
                    </p>

                    <!-- Native Odoo s_website_form snippet — builder-editable form -->
                    <section class="s_website_form pt16 pb16" data-vcss="001" data-snippet="s_website_form">
                        <div class="container-fluid">
                            <form id="drivex_contact_form"
                                  action="/website/form/" method="post"
                                  enctype="multipart/form-data"
                                  class="o_mark_required"
                                  data-mark="*"
                                  data-model_name="crm.lead"
                                  data-success-mode="redirect"
                                  data-success-page="/contactus-thank-you"
                                  data-pre-fill="true">
                                <div class="s_website_form_rows row s_col_no_bgcolor">
                                    <!-- Hidden email_to field -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label class="col-form-label col-sm-auto s_website_form_label"
                                                   style="width: 200px">
                                                <span class="s_website_form_label_content"/>
                                            </label>
                                            <div class="col-sm">
                                                <input type="hidden" class="form-control s_website_form_input"
                                                       name="email_to"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Your Name -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required"
                                         data-type="char">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label class="col-form-label col-sm-auto s_website_form_label"
                                                   style="width: 200px" for="dx_contact_name">
                                                <span class="s_website_form_label_content">Your Name</span>
                                                <span class="s_website_form_mark">*</span>
                                            </label>
                                            <div class="col-sm">
                                                <input id="dx_contact_name" class="form-control s_website_form_input"
                                                       type="text" name="contact_name" required="1"
                                                       data-fill-with="name" placeholder="Full Name"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Email -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-3 col-lg-6 s_website_form_required s_website_form_model_required"
                                         data-type="email">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label class="col-form-label col-sm-auto s_website_form_label"
                                                   style="width: 200px" for="dx_email">
                                                <span class="s_website_form_label_content">Email</span>
                                                <span class="s_website_form_mark">*</span>
                                            </label>
                                            <div class="col-sm">
                                                <input id="dx_email" class="form-control s_website_form_input"
                                                       type="email" name="email_from" required="" data-fill-with="email"
                                                       placeholder="you@example.com"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Phone -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-3 col-lg-6 s_website_form_custom"
                                         data-type="tel">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label class="col-form-label col-sm-auto s_website_form_label"
                                                   style="width: 200px" for="dx_phone">
                                                <span class="s_website_form_label_content">Phone</span>
                                            </label>
                                            <div class="col-sm">
                                                <input id="dx_phone" class="form-control s_website_form_input"
                                                       type="tel" name="phone" data-fill-with="phone"
                                                       placeholder="+91 98765 43210"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Subject -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-3 col-12 s_website_form_custom"
                                         data-type="many2one" data-translated-name="Custom Text">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label class="col-form-label col-sm-auto s_website_form_label"
                                                   style="width: 200px" for="dx_subject">
                                                <span class="s_website_form_label_content">Subject</span>
                                                <span class="s_website_form_mark">*</span>
                                            </label>
                                            <div class="col-sm">
                                                <select id="dx_subject" class="form-control s_website_form_input"
                                                        name="name" required="1">
                                                    <option value="" disabled="disabled" selected="selected">Select a
                                                        topic
                                                    </option>
                                                    <option value="Booking Enquiry">Booking Enquiry</option>
                                                    <option value="Corporate / Fleet Solutions">Corporate / Fleet
                                                        Solutions
                                                    </option>
                                                    <option value="Chauffeur Service">Chauffeur Service</option>
                                                    <option value="Events &amp; Weddings">Events &amp; Weddings</option>
                                                    <option value="Support / Issue">Support / Issue</option>
                                                    <option value="Feedback">Feedback</option>
                                                    <option value="Other">Other</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Message -->
                                    <div data-name="Field"
                                         class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required"
                                         data-type="text">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label class="col-form-label col-sm-auto s_website_form_label"
                                                   style="width: 200px" for="dx_message">
                                                <span class="s_website_form_label_content">Message</span>
                                                <span class="s_website_form_mark">*</span>
                                            </label>
                                            <div class="col-sm">
                                                <textarea id="dx_message" class="form-control s_website_form_input"
                                                          name="description" required="1" rows="6"
                                                          placeholder="Tell us how we can help…"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Privacy checkbox -->
                                    <div class="form-check col-12 mb-2">
                                        <input type="checkbox" id="cAgree" name="agree_privacy"
                                               class="s_website_form_input" required="1"/>
                                        <label for="cAgree">I agree to DriveX's <a href="/privacy-policy"
                                                                                   target="_blank">Privacy Policy
                                        </a> and consent to being contacted regarding my enquiry.
                                        </label>
                                    </div>
                                    <!-- Submit Button -->
                                    <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label"
                                         data-name="Submit Button">
                                        <div style="width: 200px;" class="s_website_form_label"/>
                                        <span id="s_website_form_result"/>
                                        <a href="#" role="button" class="btn btn-primary s_website_form_send">
                                            <i class="fa-solid fa-paper-plane me-2"/>
                                            Send Message
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </section>
                    <!-- End s_website_form -->
                </div>
                <!-- Side column: map + social channels -->
                <div class="contact-side" style="min-width:0;">
                    <div class="contact-map">
                        <div class="map-placeholder">
                            <div class="map-inner o_editable">
                                <i class="fa-solid fa-location-dot"/>
                                <strong>DriveX HQ</strong>
                                <span>Bandra Kurla Complex, Mumbai</span>
                                <a href="https://maps.google.com" target="_blank" rel="noopener" class="map-link">
                                    Open in Google Maps
                                    <i class="fa-solid fa-arrow-up-right-from-square"/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="contact-quick">
                        <h3 class="o_editable">Other Ways to Reach Us</h3>
                        <div class="quick-channels o_editable">
                            <a href="#" class="quick-channel">
                                <div class="qc-icon qc-whatsapp">
                                    <i class="fa-brands fa-whatsapp"/>
                                </div>
                                <div>
                                    <strong>WhatsApp</strong>
                                    <span>Chat instantly with our team</span>
                                </div>
                                <i class="fa-solid fa-arrow-right qc-arrow"/>
                            </a>
                            <a href="#" class="quick-channel">
                                <div class="qc-icon qc-twitter">
                                    <i class="fa-brands fa-x-twitter"/>
                                </div>
                                <div>
                                    <strong>Twitter / X</strong>
                                    <span>Reach us @DriveXIndia</span>
                                </div>
                                <i class="fa-solid fa-arrow-right qc-arrow"/>
                            </a>
                            <a href="#" class="quick-channel">
                                <div class="qc-icon qc-instagram">
                                    <i class="fa-brands fa-instagram"/>
                                </div>
                                <div>
                                    <strong>Instagram</strong>
                                    <span>DM us @drivex.in</span>
                                </div>
                                <i class="fa-solid fa-arrow-right qc-arrow"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- ============================================================
         SNIPPET: Our Locations Grid
    ============================================================ -->
    <template id="drivex_locations" name="DriveX Locations">
        <section class="locations-section s_drivex_locations"
                 data-snippet="theme_drivex.drivex_locations"
                 data-name="Our Locations">
            <div class="container">
                <span class="section-badge o_editable">Find Us</span>
                <h2 class="o_editable">Our Locations</h2>
                <p class="section-sub o_editable">Pickup and drop-off available at all branches</p>
                <div class="locations-grid o_editable">
                    <div class="location-card">
                        <div class="location-city">
                            <i class="fa-solid fa-location-dot"/>
                            <h3>Mumbai</h3>
                        </div>
                        <p>12th Floor, BKC, Bandra East</p>
                        <span>
                            <i class="fa-solid fa-clock"/>
                            Open 24/7
                        </span>
                        <a href="tel:+912212345678" class="location-phone">+91 22 1234 5678</a>
                    </div>
                    <div class="location-card">
                        <div class="location-city">
                            <i class="fa-solid fa-location-dot"/>
                            <h3>Delhi</h3>
                        </div>
                        <p>Connaught Place, New Delhi</p>
                        <span>
                            <i class="fa-solid fa-clock"/>
                            Open 24/7
                        </span>
                        <a href="tel:+911112345678" class="location-phone">+91 11 1234 5678</a>
                    </div>
                    <div class="location-card">
                        <div class="location-city">
                            <i class="fa-solid fa-location-dot"/>
                            <h3>Bangalore</h3>
                        </div>
                        <p>MG Road, Bangalore Central</p>
                        <span>
                            <i class="fa-solid fa-clock"/>
                            Open 24/7
                        </span>
                        <a href="tel:+918012345678" class="location-phone">+91 80 1234 5678</a>
                    </div>
                    <div class="location-card">
                        <div class="location-city">
                            <i class="fa-solid fa-location-dot"/>
                            <h3>Chennai</h3>
                        </div>
                        <p>Anna Salai, Chennai</p>
                        <span>
                            <i class="fa-solid fa-clock"/>
                            6 AM – 11 PM
                        </span>
                        <a href="tel:+914412345678" class="location-phone">+91 44 1234 5678</a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>