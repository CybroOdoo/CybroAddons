<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================
         SNIPPET: About This Vehicle
         Rich-text editable description block. In production this is
         pre-filled from vehicle.website_description (HTML field).
         Editors can fully rewrite it via the website builder.
    ============================================================ -->
    <template id="drivex_vehicle_about" name="DriveX Vehicle About">
        <section class="detail-desc-section s_drivex_vehicle_about"
                 data-snippet="theme_drivex.drivex_vehicle_about"
                 data-name="About This Vehicle">
            <div class="container">
                <h2 class="o_editable"><i class="fa-solid fa-circle-info" style="color:var(--accent);margin-right:10px"/>About This Vehicle</h2>
                <div class="detail-desc o_editable">
                    <p>This premium vehicle delivers an unmatched combination of performance, comfort and cutting-edge technology. Whether you're planning a weekend getaway or a business trip, this car offers everything you need for an exceptional driving experience.</p>
                    <p>Meticulously maintained to the highest standards, every journey is smooth, safe and unforgettable. Experience the difference of driving a truly world-class automobile.</p>
                </div>
            </div>
        </section>
    </template>
</odoo>
