<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML templates for the Drivex Reviews component of the
    DriveX website theme.
-->
<odoo>
    <template id="drivex_reviews" name="DriveX Reviews">
        <section class="reviews" id="reviews" data-snippet="theme_drivex.drivex_reviews" data-name="Reviews">
            <div class="container">
                <span class="section-badge dark o_editable">Testimonials</span>
                <h2 class="o_editable">What Our Customers Say</h2>
                <p class="section-sub o_editable">Join thousands of satisfied drivers</p>
                <div class="review-grid">
                    <div class="review">
                        <div class="review-stars"><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/></div>
                        <p class="o_editable">"Best car rental experience I have ever had. The BMW M4 was in perfect condition and the booking was seamless. Highly recommend DriveX!"</p>
                        <div class="reviewer">
                            <div class="reviewer-avatar">MT</div>
                            <div><h4 class="o_editable">Michael T.</h4><span class="o_editable">Business Traveler</span></div>
                        </div>
                    </div>
                    <div class="review">
                        <div class="review-stars"><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/></div>
                        <p class="o_editable">"The Tesla Model 3 was incredible! Clean, fully charged, and delivered on time. DriveX made our road trip absolutely perfect."</p>
                        <div class="reviewer">
                            <div class="reviewer-avatar">SJ</div>
                            <div><h4 class="o_editable">Sarah J.</h4><span class="o_editable">Road Trip Enthusiast</span></div>
                        </div>
                    </div>
                    <div class="review">
                        <div class="review-stars"><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-regular fa-star"/></div>
                        <p class="o_editable">"Transparent pricing — exactly as advertised. No surprise charges at checkout. Will definitely use DriveX again for my next trip."</p>
                        <div class="reviewer">
                            <div class="reviewer-avatar">DO</div>
                            <div><h4 class="o_editable">David O.</h4><span class="o_editable">Weekend Adventurer</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="drivex_reviews_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_drivex.drivex_reviews" string="Reviews" t-thumbnail="/theme_drivex/static/src/img/car.svg" group="drivex_about"/>
        </xpath>
    </template>
</odoo>
