<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML templates for the Drivex About Page of
    the DriveX website theme.
-->
<odoo>
    <!-- ============================================================
         SNIPPET: Page Hero Banner
         Reusable page-top banner with breadcrumb, heading and subtitle.
         Used by About, Contact, Fleet, etc.
    ============================================================ -->
    <template id="drivex_page_hero" name="DriveX Page Hero">
        <section class="page-hero s_drivex_page_hero"
                 data-snippet="theme_drivex.drivex_page_hero"
                 data-name="Page Hero">
            <div class="page-hero-overlay"/>
            <div class="container page-hero-content">
                <nav class="breadcrumb">
                    <a href="/" class="o_editable">Home</a>
                    <i class="fa-solid fa-chevron-right"/>
                    <span class="o_editable">Page Name</span>
                </nav>
                <h1 class="o_editable">Our <span class="hero-accent">Story</span></h1>
                <p class="o_editable">Built on a passion for driving — and a commitment to delivering more.</p>
            </div>
        </section>
    </template>
    <!-- ============================================================
         SNIPPET: Our Story Section (About page)
    ============================================================ -->
    <template id="drivex_about_story" name="DriveX Our Story">
                <section class="about-story" style="padding:80px 0;">
                    <div style="display:flex;flex-direction:row;align-items:center;gap:60px;max-width:1200px;margin:0 auto;padding:0 40px;box-sizing:border-box;">
                        <!-- Text column -->
                        <div class="about-story-text" style="flex:1 1 0;min-width:0;">
                            <span class="section-badge dark">Who We Are</span>
                            <h2>Premium Car Rental,<br/>Reimagined</h2>
                            <p>DriveX was founded in 2018 with a single mission: make premium car rental accessible, transparent, and genuinely enjoyable. We were tired of hidden fees, long queues, and tired fleets — so we built something better.</p>
                            <p>Today, DriveX operates across 50+ cities in India, offering a curated selection of over 5,000 vehicles — from everyday city runabouts to head-turning supercars. Every car is immaculately maintained, every price is what you actually pay, and every booking takes under 60 seconds.</p>
                            <div class="story-highlights">
                                <div class="highlight">
                                    <i class="fa-solid fa-calendar-days"/>
                                    <div><strong>Founded in 2018</strong><span>Mumbai, India</span></div>
                                </div>
                                <div class="highlight">
                                    <i class="fa-solid fa-users"/>
                                    <div><strong>120+ Team Members</strong><span>Across all locations</span></div>
                                </div>
                                <div class="highlight">
                                    <i class="fa-solid fa-car"/>
                                    <div><strong>5,000+ Vehicles</strong><span>Luxury to economy</span></div>
                                </div>
                            </div>
                        </div>
                        <!-- Image column -->
                        <div class="about-story-visual" style="flex:1 1 0;min-width:0;position:relative;">
                            <div class="about-img-stack" style="position:relative;">
                                <img src="https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?q=80&amp;w=1470&amp;auto=format&amp;fit=crop" alt="DriveX fleet" class="about-img-main" style="width:100%;border-radius:16px;display:block;"/>
                                <div class="about-img-badge" style="position:absolute;bottom:-20px;left:-20px;">
                                    <strong>8+</strong>
                                    <span>Years of Excellence</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
    </template>
    <!-- ============================================================
         SNIPPET: Core Values / Mission
    ============================================================ -->
    <template id="drivex_core_values" name="DriveX Core Values">
        <section class="values-section s_drivex_core_values"
                 data-snippet="theme_drivex.drivex_core_values"
                 data-name="Core Values">
            <div class="container">
                <div class="values-header">
                    <span class="section-badge dark o_editable">What Drives Us</span>
                    <h2 class="o_editable">Our Core Values</h2>
                    <p class="section-sub o_editable">The principles we live by — every booking, every mile</p>
                </div>
                <div class="values-grid o_editable">
                    <div class="value-card">
                        <div class="value-icon"><i class="fa-solid fa-handshake"/></div>
                        <h3>Integrity First</h3>
                        <p>No hidden fees, no fine print surprises. We believe honest pricing builds lasting trust.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon"><i class="fa-solid fa-star"/></div>
                        <h3>Relentless Quality</h3>
                        <p>Every vehicle undergoes a 25-point inspection before it reaches your hands.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon"><i class="fa-solid fa-bolt"/></div>
                        <h3>Speed &amp; Simplicity</h3>
                        <p>From search to keys in under 60 seconds. We respect your time above all else.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon"><i class="fa-solid fa-leaf"/></div>
                        <h3>Sustainability</h3>
                        <p>30% of our fleet is electric or hybrid. We're driving toward a greener tomorrow.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon"><i class="fa-solid fa-headset"/></div>
                        <h3>Always There</h3>
                        <p>Our support team is available 24/7 — by phone, chat, or email, wherever you are.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon"><i class="fa-solid fa-shield-halved"/></div>
                        <h3>Your Safety</h3>
                        <p>Comprehensive insurance and roadside assistance included in every rental.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- ============================================================
         SNIPPET: Leadership / Team Section
    ============================================================ -->
    <template id="drivex_team_section" name="DriveX Team Section">
        <section class="team-section s_drivex_team_section"
                 data-snippet="theme_drivex.drivex_team_section"
                 data-name="Our Team">
            <div class="container">
                <span class="section-badge dark o_editable">The People</span>
                <h2 class="o_editable">Meet Our Leadership</h2>
                <p class="section-sub o_editable">The team behind DriveX's mission</p>
                <div class="team-grid o_editable">
                    <div class="team-card">
                        <div class="team-photo">
                            <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&amp;w=400&amp;auto=format&amp;fit=crop" alt="Arjun Mehta"/>
                        </div>
                        <div class="team-info">
                            <h3>Arjun Mehta</h3>
                            <span class="team-role">Co-Founder &amp; CEO</span>
                            <p>15+ years in automotive and mobility. Previously VP at Avis India.</p>
                            <div class="team-social">
                                <a href="#"><i class="fa-brands fa-linkedin-in"/></a>
                                <a href="#"><i class="fa-brands fa-x-twitter"/></a>
                            </div>
                        </div>
                    </div>
                    <div class="team-card">
                        <div class="team-photo">
                            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&amp;w=400&amp;auto=format&amp;fit=crop" alt="Priya Sharma"/>
                        </div>
                        <div class="team-info">
                            <h3>Priya Sharma</h3>
                            <span class="team-role">Co-Founder &amp; COO</span>
                            <p>Operations veteran with a background scaling logistics across Southeast Asia.</p>
                            <div class="team-social">
                                <a href="#"><i class="fa-brands fa-linkedin-in"/></a>
                                <a href="#"><i class="fa-brands fa-x-twitter"/></a>
                            </div>
                        </div>
                    </div>
                    <div class="team-card">
                        <div class="team-photo">
                            <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&amp;w=400&amp;auto=format&amp;fit=crop" alt="Rahul Desai"/>
                        </div>
                        <div class="team-info">
                            <h3>Rahul Desai</h3>
                            <span class="team-role">Chief Technology Officer</span>
                            <p>Ex-Google engineer who architected our booking platform from the ground up.</p>
                            <div class="team-social">
                                <a href="#"><i class="fa-brands fa-linkedin-in"/></a>
                                <a href="#"><i class="fa-brands fa-github"/></a>
                            </div>
                        </div>
                    </div>
                    <div class="team-card">
                        <div class="team-photo">
                            <img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&amp;w=400&amp;auto=format&amp;fit=crop" alt="Neha Kapoor"/>
                        </div>
                        <div class="team-info">
                            <h3>Neha Kapoor</h3>
                            <span class="team-role">Head of Customer Experience</span>
                            <p>Obsessed with the details that turn a good rental into an unforgettable one.</p>
                            <div class="team-social">
                                <a href="#"><i class="fa-brands fa-linkedin-in"/></a>
                                <a href="#"><i class="fa-brands fa-instagram"/></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register: Page Hero → both about + contact groups -->
    <template id="drivex_page_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_drivex.drivex_page_hero"    string="Page Hero"     t-thumbnail="/theme_drivex/static/src/img/car.svg"  group="drivex_about"/>
            <t t-snippet="theme_drivex.drivex_page_hero"    string="Page Hero"     t-thumbnail="/theme_drivex/static/src/img/car.svg"  group="drivex_contact"/>
            <t t-snippet="theme_drivex.drivex_about_story"  string="Our Story"     t-thumbnail="/theme_drivex/static/src/img/car2.svg" group="drivex_about"/>
            <t t-snippet="theme_drivex.drivex_core_values"  string="Core Values"   t-thumbnail="/theme_drivex/static/src/img/car3.svg" group="drivex_about"/>
            <t t-snippet="theme_drivex.drivex_team_section" string="Team Section"  t-thumbnail="/theme_drivex/static/src/img/car1.svg" group="drivex_about"/>
        </xpath>
    </template>
</odoo>
