<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML templates for the Drivex How It Works component
    of the DriveX website theme.
-->
<odoo>
    <template id="drivex_how_it_works" name="DriveX How It Works">
        <section class="steps" id="steps" data-snippet="theme_drivex.drivex_how_it_works" data-name="How It Works">
            <div class="container">
                <span class="section-badge dark o_editable">Simple Process</span>
                <h2 class="o_editable">How It Works</h2>
                <p class="section-sub o_editable">Get behind the wheel in three easy steps</p>
                <div class="step-grid">
                    <div class="step">
                        <div class="step-number">01</div>
                        <div class="step-icon"><i class="fa-solid fa-magnifying-glass"/></div>
                        <h3 class="o_editable">Choose Your Car</h3>
                        <p class="o_editable">Browse our premium fleet and pick the vehicle that matches your style and budget.</p>
                    </div>
                    <div class="step-connector"/>
                    <div class="step">
                        <div class="step-number">02</div>
                        <div class="step-icon"><i class="fa-regular fa-calendar-check"/></div>
                        <h3 class="o_editable">Book Instantly</h3>
                        <p class="o_editable">Select your dates, enter your details, and confirm your booking in seconds.</p>
                    </div>
                    <div class="step-connector"/>
                    <div class="step">
                        <div class="step-number">03</div>
                        <div class="step-icon"><i class="fa-solid fa-key"/></div>
                        <h3 class="o_editable">Drive Away</h3>
                        <p class="o_editable">Pick up your car at the agreed location and enjoy the open road.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="drivex_how_it_works_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_drivex.drivex_how_it_works" string="How It Works" t-thumbnail="/theme_drivex/static/src/img/car3.svg" group="drivex_homepage"/>
        </xpath>
    </template>
</odoo>
