<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================
         SNIPPET: Vehicle Specifications
         Auto-populates from fleet.vehicle fields (horsepower, seats,
         doors, transmission, fuel_type, co2) passed via t-att-data-*
         attributes on the parent section. All spec items are editable
         in the website builder.
    ============================================================ -->
    <template id="drivex_vehicle_specs" name="DriveX Vehicle Specs">
        <section class="detail-specs-section s_drivex_vehicle_specs"
                 data-snippet="theme_drivex.drivex_vehicle_specs"
                 data-name="Vehicle Specifications">
            <div class="container">
                <h2 class="o_editable"><i class="fa-solid fa-gauge-high" style="color:var(--accent);margin-right:10px"/>Vehicle Specifications</h2>
                <div class="spec-grid">
                    <div class="spec-item">
                        <i class="fa-solid fa-horse"/>
                        <strong class="o_editable spec-value-horsepower">— HP</strong>
                        <span class="o_editable">Power</span>
                    </div>
                    <div class="spec-item">
                        <i class="fa-solid fa-sliders"/>
                        <strong class="o_editable spec-value-transmission">Auto</strong>
                        <span class="o_editable">Transmission</span>
                    </div>
                    <div class="spec-item">
                        <i class="fa-solid fa-users"/>
                        <strong class="o_editable spec-value-seats">5 Seats</strong>
                        <span class="o_editable">Capacity</span>
                    </div>
                    <div class="spec-item">
                        <i class="fa-solid fa-door-open"/>
                        <strong class="o_editable spec-value-doors">4 Doors</strong>
                        <span class="o_editable">Configuration</span>
                    </div>
                    <div class="spec-item">
                        <i class="fa-solid fa-gas-pump"/>
                        <strong class="o_editable spec-value-fuel">Petrol</strong>
                        <span class="o_editable">Fuel Type</span>
                    </div>
                    <div class="spec-item">
                        <i class="fa-solid fa-cloud"/>
                        <strong class="o_editable spec-value-co2">— g/km</strong>
                        <span class="o_editable">Emissions</span>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register in website builder snippet panel -->
</odoo>
