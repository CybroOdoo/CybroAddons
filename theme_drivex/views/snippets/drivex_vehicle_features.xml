<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML templates for the Drivex Vehicle Features component
    of the DriveX website theme.
-->
<odoo>
    <!-- ============================================================
         SNIPPET: Features &amp; Equipment
         Default items are editable. In production, this block is
         pre-populated via JavaScript from the vehicle's feature_ids.
         Editors can add/remove/edit feature tags directly in the
         website builder.
    ============================================================ -->
    <template id="drivex_vehicle_features" name="DriveX Vehicle Features">
        <section class="detail-features-section s_drivex_vehicle_features"
                 data-snippet="theme_drivex.drivex_vehicle_features"
                 data-name="Features &amp; Equipment">
            <div class="container">
                <h2 class="o_editable"><i class="fa-solid fa-star" style="color:var(--accent);margin-right:10px"/>Features &amp; Equipment</h2>
                <div class="features-grid o_editable">
                    <div class="feat-item"><i class="fa-solid fa-check"/> Air Conditioning</div>
                    <div class="feat-item"><i class="fa-solid fa-check"/> Bluetooth Audio</div>
                    <div class="feat-item"><i class="fa-solid fa-check"/> GPS Navigation</div>
                    <div class="feat-item"><i class="fa-solid fa-check"/> Parking Sensors</div>
                    <div class="feat-item"><i class="fa-solid fa-check"/> Reverse Camera</div>
                    <div class="feat-item"><i class="fa-solid fa-check"/> Cruise Control</div>
                    <div class="feat-item"><i class="fa-solid fa-check"/> Heated Seats</div>
                    <div class="feat-item"><i class="fa-solid fa-check"/> Apple CarPlay</div>
                </div>
            </div>
        </section>
    </template>
    <template id="drivex_vehicle_features_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_drivex.drivex_vehicle_features"
               string="Vehicle Features"
               t-thumbnail="/theme_drivex/static/src/img/car.svg"
               group="drivex_car_detail"/>
        </xpath>
    </template>
</odoo>
