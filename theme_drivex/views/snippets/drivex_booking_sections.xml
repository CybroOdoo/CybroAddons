<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================
         SNIPPET: How To Book — 3-step process for Booking page
    ============================================================ -->
    <template id="drivex_booking_steps" name="DriveX How It Works">
        <section class="steps"
                 data-snippet="theme_drivex.drivex_booking_steps"
                 data-name="How It Works">
            <div class="container">
                <span class="section-badge dark o_editable">Simple Process</span>
                <h2 class="o_editable">How It Works</h2>
                <p class="section-sub o_editable">Get behind the wheel in three easy steps</p>
                <div class="step-grid">
                    <div class="step">
                        <div class="step-number">01</div>
                        <div class="step-icon"><i class="fa-solid fa-magnifying-glass"/></div>
                        <h3>Choose Your Car</h3>
                        <p>Browse our premium fleet and pick the vehicle that matches your style and budget.</p>
                    </div>
                    <div class="step-connector"/>
                    <div class="step">
                        <div class="step-number">02</div>
                        <div class="step-icon"><i class="fa-regular fa-calendar-check"/></div>
                        <h3>Book Instantly</h3>
                        <p>Select your dates, enter your details, and confirm your booking in seconds.</p>
                    </div>
                    <div class="step-connector"/>
                    <div class="step">
                        <div class="step-number">03</div>
                        <div class="step-icon"><i class="fa-solid fa-key"/></div>
                        <h3>Drive Away</h3>
                        <p>Pick up your car at the agreed location and enjoy the open road.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- ============================================================
         SNIPPET: Insurance Options overview
    ============================================================ -->
    <template id="drivex_insurance_options" name="DriveX Insurance Options">
        <section class="s_drivex_insurance_options"
                 data-snippet="theme_drivex.drivex_insurance_options"
                 data-name="Insurance Options">
            <div class="container">
                <div class="section-header" style="text-align:center;margin-bottom:40px;">
                    <span class="section-badge o_editable">Protection Plans</span>
                    <h2 class="o_editable">Choose Your Coverage</h2>
                    <p class="section-sub o_editable">All plans include mandatory third-party liability</p>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px;" class="o_editable">
                    <div class="value-card">
                        <div class="value-icon"><i class="fa-solid fa-shield"/></div>
                        <h3>Basic</h3>
                        <p><strong>Included</strong> — Third-party liability, 24/7 roadside assistance. Excess: $1,500.</p>
                    </div>
                    <div class="value-card" style="border-color:var(--accent);">
                        <div class="value-icon"><i class="fa-solid fa-shield-halved"/></div>
                        <h3>Comprehensive <span style="color:var(--accent);font-size:0.75rem;font-weight:700;"> +$20/day</span></h3>
                        <p>Collision damage waiver + theft protection. Excess reduced to $500.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon"><i class="fa-solid fa-shield-heart"/></div>
                        <h3>Premium Zero Excess <span style="color:var(--accent);font-size:0.75rem;font-weight:700;"> +$40/day</span></h3>
                        <p>Full coverage, zero excess, glass &amp; tyre protection included.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- ============================================================
         SNIPPET: Booking FAQ
    ============================================================ -->
    <template id="drivex_booking_faq" name="DriveX Booking FAQ">
        <section class="s_drivex_booking_faq"
                 data-snippet="theme_drivex.drivex_booking_faq"
                 data-name="Booking FAQ">
            <div class="container">
                <div class="section-header" style="text-align:center;margin-bottom:40px;">
                    <span class="section-badge o_editable">FAQ</span>
                    <h2 class="o_editable">Frequently Asked Questions</h2>
                </div>
                <div class="faq-list o_editable">
                    <div class="faq-item">
                        <div class="faq-question"><span>What documents do I need to rent?</span><i class="fa-solid fa-chevron-down"/></div>
                        <div class="faq-answer"><p>A valid driving license (held for 3+ years), a government-issued photo ID, and a credit or debit card for the security deposit.</p></div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question"><span>Can I cancel or modify my booking?</span><i class="fa-solid fa-chevron-down"/></div>
                        <div class="faq-answer"><p>Yes. Free cancellation is available up to 24 hours before pickup. Modifications can be made up to 12 hours before pickup subject to availability.</p></div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question"><span>Is fuel included in the rental price?</span><i class="fa-solid fa-chevron-down"/></div>
                        <div class="faq-answer"><p>Vehicles are provided with a full tank. You are expected to return the car with the same fuel level, or a refueling fee will apply.</p></div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question"><span>What is the minimum rental age?</span><i class="fa-solid fa-chevron-down"/></div>
                        <div class="faq-answer"><p>The minimum rental age is 25 years for most vehicles. Select economy cars are available from age 21 with a young driver surcharge.</p></div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- ============================================================
         SNIPPET: Why Book With Us — Trust signals for booking page
    ============================================================ -->
    <template id="drivex_booking_trust" name="DriveX Why Choose Us">
        <section class="features"
                 data-snippet="theme_drivex.drivex_booking_trust"
                 data-name="Why Choose DriveX">
            <div class="container">
                <span class="section-badge dark o_editable">Why Us</span>
                <h2 class="o_editable">Why Choose DriveX</h2>
                <p class="section-sub o_editable">Everything you need for a perfect driving experience</p>
                <div class="feature-grid">
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-car-side"/></div>
                        <h3>Wide Range of Vehicles</h3>
                        <p>From economy to luxury sports cars — 5,000+ options at your fingertips.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-tag"/></div>
                        <h3>Transparent Pricing</h3>
                        <p>No hidden fees, no surprises. What you see is exactly what you pay.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-bolt"/></div>
                        <h3>Instant Booking</h3>
                        <p>Confirm your reservation in under 60 seconds, anytime, anywhere.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-shield-halved"/></div>
                        <h3>Fully Insured</h3>
                        <p>Every vehicle comes with comprehensive insurance for complete peace of mind.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-location-dot"/></div>
                        <h3>Multiple Locations</h3>
                        <p>Pickup from 50+ airports, hotels and city centers across the country.</p>
                    </div>
                    <div class="feature">
                        <div class="feature-icon"><i class="fa-solid fa-headset"/></div>
                        <h3>24/7 Support</h3>
                        <p>Round-the-clock customer service — call, chat, or email us anytime.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register booking snippets -->
</odoo>
