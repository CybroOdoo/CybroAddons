<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML templates for the Drivex Stats Bar component of
    the DriveX website theme.
-->
<odoo>
    <template id="drivex_stats_bar" name="DriveX Stats Bar">
        <section class="stats-bar" data-snippet="theme_drivex.drivex_stats_bar" data-name="Stats Bar">
            <div class="container">
                <div class="stats-grid">
                    <div class="stat"><h3>5,000+</h3><p>Vehicles Available</p></div>
                    <div class="stat"><h3>50+</h3><p>Cities Covered</p></div>
                    <div class="stat"><h3>98%</h3><p>Customer Satisfaction</p></div>
                    <div class="stat"><h3>24/7</h3><p>Support Available</p></div>
                </div>
            </div>
        </section>
    </template>
    <template id="drivex_stats_bar_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_drivex.drivex_stats_bar" string="Stats Bar" t-thumbnail="/theme_drivex/static/src/img/car.svg" group="drivex_homepage"/>
        </xpath>
    </template>
</odoo>
