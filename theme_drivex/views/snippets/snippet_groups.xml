<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file contains the XML template for website.snippets to add snippet groups.
-->
<odoo>
    <!--
        DriveX Snippet Groups
        =====================
        Defines 5 page-specific groups in the website builder sidebar.
        Each group appears as a labelled tab so editors instantly know
        which snippets belong to which page.
    -->
    <template id="drivex_snippet_groups" inherit_id="website.snippets" name="DriveX Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <!-- 1. Homepage Sections -->
            <t t-snippet="website.s_snippet_group"
               string="Homepage"
               t-thumbnail="/theme_drivex/static/src/img/hero-car.svg"
               snippet-group="drivex_homepage"/>
            <!-- 2. About Us Sections -->
            <t t-snippet="website.s_snippet_group"
               string="About Us"
               t-thumbnail="/theme_drivex/static/src/img/car2.svg"
               snippet-group="drivex_about"/>
            <!-- 3. Car Detail Sections -->
            <t t-snippet="website.s_snippet_group"
               string="Car Detail"
               t-thumbnail="/theme_drivex/static/src/img/car1.svg"
               snippet-group="drivex_car_detail"/>
            <!-- 4. Contact Page Sections -->
            <t t-snippet="website.s_snippet_group"
               string="Contact"
               t-thumbnail="/theme_drivex/static/src/img/car3.svg"
               snippet-group="drivex_contact"/>
            <!-- 5. Booking Page Sections -->
            <t t-snippet="website.s_snippet_group"
               string="Booking"
               t-thumbnail="/theme_drivex/static/src/img/car.svg"
               snippet-group="drivex_booking"/>
        </xpath>
    </template>
</odoo>
