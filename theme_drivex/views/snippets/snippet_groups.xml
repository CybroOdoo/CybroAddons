<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        DriveX Snippets Registration for Odoo 17
        ==========================================
        Creates dedicated "DriveX" panel groups in the Website Builder
        sidebar using Odoo 17's native panel layout structure.
    -->
    <template id="drivex_snippets_registration" inherit_id="website.snippets" priority="16">
        <xpath expr="//div[@id='snippet_structure']" position="after">
            <!-- DriveX - Home Panel -->
            <div id="drivex_homepage" class="o_panel">
                <div class="o_panel_header">DriveX - Home</div>
                <div class="o_panel_body">
                    <t t-snippet="theme_drivex.drivex_hero" string="Hero Section" t-thumbnail="/theme_drivex/static/src/img/hero-car.svg"/>
                    <t t-snippet="theme_drivex.drivex_stats_bar" string="Stats Bar" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_fleet_section" string="Fleet Section" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_features" string="Features Section" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_how_it_works" string="How it Works" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_reviews" string="Reviews Section" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_cta_banner" string="CTA Banner" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                </div>
            </div>
            <!-- DriveX - Pages Panel -->
            <div id="drivex_pages" class="o_panel">
                <div class="o_panel_header">DriveX - Pages</div>
                <div class="o_panel_body">
                    <t t-snippet="theme_drivex.drivex_page_hero" string="Page Hero" t-thumbnail="/theme_drivex/static/src/img/hero-car.svg"/>
                    <t t-snippet="theme_drivex.drivex_about_story" string="About Story" t-thumbnail="/theme_drivex/static/src/img/car2.svg"/>
                    <t t-snippet="theme_drivex.drivex_core_values" string="Core Values" t-thumbnail="/theme_drivex/static/src/img/car3.svg"/>
                    <t t-snippet="theme_drivex.drivex_team_section" string="Team Section" t-thumbnail="/theme_drivex/static/src/img/car1.svg"/>
                    <t t-snippet="theme_drivex.drivex_contact_info" string="Contact Info" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_contact_form" string="Contact Form" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_locations" string="Locations Map" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                </div>
            </div>
            <!-- DriveX - Booking & Vehicles Panel -->
            <div id="drivex_vehicles" class="o_panel">
                <div class="o_panel_header">DriveX - Booking &amp; Vehicles</div>
                <div class="o_panel_body">
                    <t t-snippet="theme_drivex.drivex_booking_steps" string="Booking Steps" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_insurance_options" string="Insurance Options" t-thumbnail="/theme_drivex/static/src/img/car2.svg"/>
                    <t t-snippet="theme_drivex.drivex_booking_faq" string="Booking FAQ" t-thumbnail="/theme_drivex/static/src/img/car3.svg"/>
                    <t t-snippet="theme_drivex.drivex_booking_trust" string="Booking Trust Elements" t-thumbnail="/theme_drivex/static/src/img/car1.svg"/>
                    <t t-snippet="theme_drivex.drivex_vehicle_specs" string="Vehicle Specs" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_vehicle_features" string="Vehicle Features" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_vehicle_about" string="Vehicle About" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_rental_terms" string="Rental Terms" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                    <t t-snippet="theme_drivex.drivex_similar_vehicles" string="Similar Vehicles" t-thumbnail="/theme_drivex/static/src/img/car.svg"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
