<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════
         Services
    ═══════════════════════════════════════════════ -->
    <template id="drivex_services_page" name="DriveX Services">
        <t t-call="website.layout">
            <t t-set="title">Services — DriveX</t>
            <div id="wrap" class="oe_structure">
                <!-- PAGE HERO -->
                <section class="page-hero">
                    <div class="page-hero-overlay"/>
                    <div class="container page-hero-content">
                        <nav class="breadcrumb">
                            <a href="/">Home</a>
                            <i class="fa-solid fa-chevron-right"/>
                            <span>Services</span>
                        </nav>
                        <h1>What We <span class="hero-accent">Offer</span></h1>
                        <p>Every service designed around one thing — your perfect journey.</p>
                    </div>
                </section>
                <!-- SERVICES GRID -->
                <section class="services-section">
                    <div class="container">
                        <span class="section-badge dark">Our Services</span>
                        <h2>Everything You Need on the Road</h2>
                        <p class="section-sub">From a weekend drive to a long-term corporate solution</p>
                        <div class="services-grid">
                            <div class="service-card">
                                <div class="service-icon"><i class="fa-solid fa-car-side"/></div>
                                <h3>Self-Drive Rental</h3>
                                <p>Take the wheel yourself. Choose from economy hatchbacks to exotic supercars, with flexible daily, weekly, and monthly rates.</p>
                                <ul class="service-features">
                                    <li><i class="fa-solid fa-check"/> 5,000+ vehicles</li>
                                    <li><i class="fa-solid fa-check"/> Instant online booking</li>
                                    <li><i class="fa-solid fa-check"/> Pickup from 50+ locations</li>
                                </ul>
                                <a href="/fleet" class="service-link">Explore Fleet <i class="fa-solid fa-arrow-right"/></a>
                            </div>
                            <div class="service-card">
                                <div class="service-icon"><i class="fa-solid fa-plane-arrival"/></div>
                                <h3>Airport Transfers</h3>
                                <p>Land and go. Pre-book your pickup from any major airport — your driver will be waiting at arrivals, sign in hand.</p>
                                <ul class="service-features">
                                    <li><i class="fa-solid fa-check"/> Meet &amp; greet service</li>
                                    <li><i class="fa-solid fa-check"/> Flight tracking</li>
                                    <li><i class="fa-solid fa-check"/> Free wait time</li>
                                </ul>
                                <a href="/contact" class="service-link">Book Transfer <i class="fa-solid fa-arrow-right"/></a>
                            </div>
                            <div class="service-card">
                                <div class="service-icon"><i class="fa-solid fa-user-tie"/></div>
                                <h3>Chauffeur Service</h3>
                                <p>Sit back and arrive in style. Our professional, uniformed chauffeurs handle the driving while you focus on what matters.</p>
                                <ul class="service-features">
                                    <li><i class="fa-solid fa-check"/> Luxury vehicles</li>
                                    <li><i class="fa-solid fa-check"/> Background-checked drivers</li>
                                    <li><i class="fa-solid fa-check"/> Hourly or full-day packages</li>
                                </ul>
                                <a href="/contact" class="service-link">Book Chauffeur <i class="fa-solid fa-arrow-right"/></a>
                            </div>
                            <div class="service-card">
                                <div class="service-icon"><i class="fa-solid fa-building"/></div>
                                <h3>Corporate Leasing</h3>
                                <p>Streamline your company's travel with a managed fleet. Dedicated account manager, monthly billing, and detailed reporting.</p>
                                <ul class="service-features">
                                    <li><i class="fa-solid fa-check"/> Dedicated account manager</li>
                                    <li><i class="fa-solid fa-check"/> Consolidated invoicing</li>
                                    <li><i class="fa-solid fa-check"/> Custom fleet management</li>
                                </ul>
                                <a href="/contact" class="service-link">Talk to Sales <i class="fa-solid fa-arrow-right"/></a>
                            </div>
                            <div class="service-card">
                                <div class="service-icon"><i class="fa-solid fa-calendar-check"/></div>
                                <h3>Long-Term Rental</h3>
                                <p>Need a car for a month or more? Lock in our best rates with our monthly subscription plans — no commitment beyond your term.</p>
                                <ul class="service-features">
                                    <li><i class="fa-solid fa-check"/> Save up to 40% vs. daily rate</li>
                                    <li><i class="fa-solid fa-check"/> Swap vehicles mid-term</li>
                                    <li><i class="fa-solid fa-check"/> Maintenance included</li>
                                </ul>
                                <a href="/contact" class="service-link">Get a Quote <i class="fa-solid fa-arrow-right"/></a>
                            </div>
                            <div class="service-card">
                                <div class="service-icon"><i class="fa-solid fa-champagne-glasses"/></div>
                                <h3>Events &amp; Weddings</h3>
                                <p>Make your special day unforgettable. Our curated collection of luxury and vintage vehicles turns every occasion into a grand affair.</p>
                                <ul class="service-features">
                                    <li><i class="fa-solid fa-check"/> Decorating available</li>
                                    <li><i class="fa-solid fa-check"/> Professional chauffeurs</li>
                                    <li><i class="fa-solid fa-check"/> Custom packages</li>
                                </ul>
                                <a href="/contact" class="service-link">Plan Your Event <i class="fa-solid fa-arrow-right"/></a>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- PRICING -->
                <section class="pricing-section">
                    <div class="container">
                        <span class="section-badge">Pricing</span>
                        <h2>Simple, Transparent Plans</h2>
                        <p class="section-sub">No hidden fees. Cancel anytime. Pay only for what you use.</p>
                        <div class="pricing-grid">
                            <div class="pricing-card">
                                <div class="pricing-header">
                                    <span class="pricing-label">Standard</span>
                                    <div class="pricing-price">$59<span>/day</span></div>
                                    <p>Best for casual weekend drives and city trips.</p>
                                </div>
                                <ul class="pricing-features">
                                    <li><i class="fa-solid fa-check"/> Economy &amp; hatchback vehicles</li>
                                    <li><i class="fa-solid fa-check"/> 200 km/day included</li>
                                    <li><i class="fa-solid fa-check"/> Basic insurance</li>
                                    <li><i class="fa-solid fa-check"/> 24/7 roadside assistance</li>
                                    <li><i class="fa-solid fa-check"/> Free cancellation (24 hrs)</li>
                                    <li class="disabled"><i class="fa-solid fa-xmark"/> Priority support</li>
                                    <li class="disabled"><i class="fa-solid fa-xmark"/> Luxury vehicles</li>
                                </ul>
                                <a href="/fleet" class="pricing-btn-outline">Book Standard</a>
                            </div>
                            <div class="pricing-card pricing-featured">
                                <div class="pricing-badge-top">Most Popular</div>
                                <div class="pricing-header">
                                    <span class="pricing-label">Premium</span>
                                    <div class="pricing-price">$129<span>/day</span></div>
                                    <p>Perfect for business travel and special occasions.</p>
                                </div>
                                <ul class="pricing-features">
                                    <li><i class="fa-solid fa-check"/> All vehicle categories</li>
                                    <li><i class="fa-solid fa-check"/> Unlimited km</li>
                                    <li><i class="fa-solid fa-check"/> Comprehensive insurance</li>
                                    <li><i class="fa-solid fa-check"/> 24/7 roadside assistance</li>
                                    <li><i class="fa-solid fa-check"/> Free cancellation (anytime)</li>
                                    <li><i class="fa-solid fa-check"/> Priority support</li>
                                    <li class="disabled"><i class="fa-solid fa-xmark"/> Dedicated account manager</li>
                                </ul>
                                <a href="/fleet" class="pricing-btn">Book Premium</a>
                            </div>
                            <div class="pricing-card">
                                <div class="pricing-header">
                                    <span class="pricing-label">Enterprise</span>
                                    <div class="pricing-price">Custom<span/></div>
                                    <p>Tailored solutions for teams and corporations.</p>
                                </div>
                                <ul class="pricing-features">
                                    <li><i class="fa-solid fa-check"/> Managed fleet</li>
                                    <li><i class="fa-solid fa-check"/> Unlimited km</li>
                                    <li><i class="fa-solid fa-check"/> Full coverage insurance</li>
                                    <li><i class="fa-solid fa-check"/> 24/7 roadside assistance</li>
                                    <li><i class="fa-solid fa-check"/> Free cancellation (anytime)</li>
                                    <li><i class="fa-solid fa-check"/> Priority support</li>
                                    <li><i class="fa-solid fa-check"/> Dedicated account manager</li>
                                </ul>
                                <a href="/contact" class="pricing-btn-outline">Contact Sales</a>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- FAQ -->
                <section class="faq-section">
                    <div class="container">
                        <span class="section-badge dark">FAQ</span>
                        <h2>Frequently Asked Questions</h2>
                        <p class="section-sub">Everything you need to know before booking</p>
                        <div class="faq-list">
                            <div class="faq-item">
                                <button class="faq-question">What documents do I need to rent a car? <i class="fa-solid fa-chevron-down"/></button>
                                <div class="faq-answer"><p>You need a valid driving license (minimum 1-year-old), a government-issued photo ID (Aadhaar, Passport, or PAN card), and a credit or debit card for the security deposit. International renters also need a passport and an International Driving Permit.</p></div>
                            </div>
                            <div class="faq-item">
                                <button class="faq-question">Is insurance included in the rental price? <i class="fa-solid fa-chevron-down"/></button>
                                <div class="faq-answer"><p>Yes, all DriveX rentals include basic third-party liability insurance. You can upgrade to comprehensive coverage at checkout, which covers accidental damage, theft, and windscreen replacement with zero excess.</p></div>
                            </div>
                            <div class="faq-item">
                                <button class="faq-question">Can I modify or cancel my booking? <i class="fa-solid fa-chevron-down"/></button>
                                <div class="faq-answer"><p>Standard plan bookings can be canceled free of charge up to 24 hours before pickup. Premium and Enterprise bookings offer free cancellation at any time. Modifications can be made through your account dashboard or by calling our 24/7 support line.</p></div>
                            </div>
                            <div class="faq-item">
                                <button class="faq-question">What happens if the car breaks down? <i class="fa-solid fa-chevron-down"/></button>
                                <div class="faq-answer"><p>Every rental includes 24/7 roadside assistance. In the event of a breakdown, call our dedicated helpline, and we'll dispatch a technician to your location. If the vehicle cannot be repaired on-site, we'll arrange a replacement vehicle at no extra charge.</p></div>
                            </div>
                            <div class="faq-item">
                                <button class="faq-question">Is there a mileage limit? <i class="fa-solid fa-chevron-down"/></button>
                                <div class="faq-answer"><p>Standard plan rentals include 200 km per day. Premium and Enterprise plans include unlimited kilometres. If you exceed the mileage allowance on a Standard plan, an additional ₹8 per km applies.</p></div>
                            </div>
                            <div class="faq-item">
                                <button class="faq-question">Can I take the car to another city or state? <i class="fa-solid fa-chevron-down"/></button>
                                <div class="faq-answer"><p>Yes. Inter-city and interstate travel is permitted on all plans. Simply inform us at the time of booking or update your trip details in your account. One-way rentals are also available — drop the car at any DriveX location.</p></div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- CTA -->
                <section class="cta-banner">
                    <div class="container cta-content">
                        <div class="cta-text">
                            <h2>Not Sure Which Plan Fits?</h2>
                            <p>Our team will help you find the perfect option for your needs.</p>
                        </div>
                        <div class="cta-actions">
                            <a href="/contact" class="btn-red"><i class="fa-solid fa-headset"/> Talk to Us</a>
                            <a href="/fleet" class="btn-outline-white"><i class="fa-solid fa-car-side"/> Browse Fleet</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
<!--DriveX Services link-->
    <record id="drivex_services_page_page" model="website.page">
        <field name="name">DriveX Services</field>
        <field name="url">/services</field>
        <field name="view_id" ref="drivex_services_page"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>
</odoo>
