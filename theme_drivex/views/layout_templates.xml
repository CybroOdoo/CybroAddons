<?xml version="1.0" encoding="UTF-8" ?>
<!--
    This file contains the XML templates extending the website layout.
    The header is Odoo's standard header (styled by theme.scss) so the website
    builder options, the menu editor and the eCommerce header elements keep
    working. The footer content is editable from the website builder.
-->
<odoo>
    <template id="drivex_layout" inherit_id="website.layout" name="DriveX Layout">
        <!-- Inject Fonts + FontAwesome -->
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
        </xpath>
        <!-- Copyright bar -->
        <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
            <span class="o_footer_copyright_name">© 2026 DriveX. All rights reserved.</span>
        </xpath>
        <xpath expr="//footer//t[@t-call='web.brand_promotion']/.." position="before">
            <div class="col-md text-center text-sm-end">
                <div class="payment-icons">
                    <i class="fa-brands fa-cc-visa"/>
                    <i class="fa-brands fa-cc-mastercard"/>
                    <i class="fa-brands fa-cc-amex"/>
                    <i class="fa-brands fa-cc-paypal"/>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Header: user dropdown shown as a bordered button with the avatar -->
    <template id="drivex_header_default" inherit_id="website.template_header_default" name="DriveX Header">
        <xpath expr="//t[@t-call='portal.user_dropdown']" position="attributes">
            <attribute name="_avatar">True</attribute>
            <attribute name="_avatar_class.f">flex-shrink-0</attribute>
            <attribute name="_link_class.f">{{_additional_btn_color or 'nav-link o_nav_link_btn'}} d-flex align-items-center gap-2</attribute>
        </xpath>
    </template>

    <!-- Footer: DriveX content for the default footer template -->
    <template id="drivex_footer" inherit_id="website.footer_custom" name="DriveX Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo text-break" t-ignore="true" t-if="not no_footer">
                <section class="s_text_block drivex-footer pt72" data-snippet="s_text_block" data-name="Footer">
                    <div class="container footer-top">
                        <div class="footer-brand">
                            <a href="/" class="d-inline-block">
                                <img src="/theme_drivex/static/src/img/logo.svg" alt="DriveX Logo" class="footer-logo"/>
                            </a>
                            <p>Experience luxury on every mile. DriveX brings you the finest vehicles with unmatched service.</p>
                            <div class="s_social_media social-links no_icon_color text-start o_not_editable" data-snippet="s_social_media" data-name="Social Media" contenteditable="false">
                                <h5 class="s_social_media_title d-none" contenteditable="true">Follow us</h5>
                                <a href="#" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                    <i class="oi o_editable_media" data-icon="oi_facebook"/>
                                </a>
                                <a href="#" class="s_social_media_instagram" target="_blank" aria-label="Instagram">
                                    <i class="oi o_editable_media" data-icon="oi_instagram"/>
                                </a>
                                <a href="#" class="s_social_media_twitter" target="_blank" aria-label="X">
                                    <i class="oi o_editable_media" data-icon="oi_x"/>
                                </a>
                                <a href="#" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                    <i class="oi o_editable_media" data-icon="oi_linkedin"/>
                                </a>
                            </div>
                        </div>
                        <div class="footer-col">
                            <h4>Company</h4>
                            <ul>
                                <li><a href="/about">About Us</a></li>
                                <li><a href="#">Careers</a></li>
                                <li><a href="#">Press</a></li>
                                <li><a href="#">Blog</a></li>
                            </ul>
                        </div>
                        <div class="footer-col">
                            <h4>Fleet</h4>
                            <ul>
                                <li><a href="/fleet">Luxury Cars</a></li>
                                <li><a href="/fleet">Sports Cars</a></li>
                                <li><a href="/fleet">Electric Vehicles</a></li>
                                <li><a href="/fleet">SUVs</a></li>
                                <li><a href="/fleet">Economy</a></li>
                            </ul>
                        </div>
                        <div class="footer-col">
                            <h4>Legal</h4>
                            <ul>
                                <li><a href="#">Privacy Policy</a></li>
                                <li><a href="#">Terms of Service</a></li>
                                <li><a href="#">Cookie Policy</a></li>
                                <li><a href="/services">Pricing</a></li>
                            </ul>
                        </div>
                        <div class="footer-col">
                            <h4>Contact</h4>
                            <ul>
                                <li><a href="tel:+918001234567"><i class="fa-solid fa-phone"/> +91 800 123 4567</a></li>
                                <li><a href="mailto:hello@drivex.in"><i class="fa-solid fa-envelope"/> hello@drivex.in</a></li>
                                <li><a href="#"><i class="fa-solid fa-location-dot"/> Mumbai, India</a></li>
                            </ul>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
