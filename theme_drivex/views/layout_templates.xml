<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════
         Layout
    ═══════════════════════════════════════════════ -->
    <template id="drivex_layout" inherit_id="website.layout" name="DriveX Layout">
        <!-- Inject Fonts + FontAwesome -->
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
        </xpath>
        <!-- Replace Header -->
        <xpath expr="//header" position="replace">
            <header class="header" id="header">
                <div class="container nav">
                    <a href="/" class="logo">
                        <img src="/theme_drivex/static/src/img/logo.svg" alt="DriveX"/>
                    </a>
                    <ul class="menu" id="menu">
                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                            <t t-if="submenu.is_visible">
                                <li>
                                    <a t-att-href="submenu._clean_url()" t-attf-class="#{submenu._is_active() and 'active'}">
                                        <span t-field="submenu.name"/>
                                    </a>
                                </li>
                            </t>
                        </t>
                    </ul>
                    <div class="nav-right">
                        <t t-if="request.env.user._is_public()">
                            <a href="/web/login" class="btn-signin">Sign In</a>
                        </t>
                        <t t-else="">
                            <t t-call="portal.user_dropdown">
                                <t t-set="_avatar" t-value="true"/>
                                <t t-set="_user_name" t-value="true"/>
                                <t t-set="_item_class" t-value="'list-unstyled mb-0 dropdown o_no_autohide_item d-inline-block'"/>
                                <t t-set="_link_class" t-value="'btn-signin dropdown-toggle d-flex align-items-center gap-2'"/>
                                <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end'"/>
                            </t>
                        </t>
                        <button class="hamburger" id="hamburger" aria-label="Toggle menu">
                            <span/><span/><span/>
                        </button>
                    </div>
                </div>
            </header>
        </xpath>
        <!-- Replace Footer -->
        <xpath expr="//footer" position="replace">
            <footer class="footer">
                <div class="container footer-top">
                    <div class="footer-brand">
                        <img src="/theme_drivex/static/src/img/logo.svg" alt="DriveX Logo" class="footer-logo"/>
                        <p>Experience luxury on every mile. DriveX brings you the finest vehicles with unmatched service.</p>
                        <div class="social-links">
                            <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"/></a>
                            <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"/></a>
                            <a href="#" aria-label="X"><i class="fa-brands fa-x-twitter"/></a>
                            <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"/></a>
                        </div>
                    </div>
                    <div class="footer-col">
                        <h4>Company</h4>
                        <ul>
                            <li><a href="/about">About Us</a></li>
                            <li><a href="#">Careers</a></li>
                            <li><a href="#">Press</a></li>
                            <li><a href="#">Blog</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Fleet</h4>
                        <ul>
                            <li><a href="/fleet?category=Luxury">Luxury Cars</a></li>
                            <li><a href="/fleet?category=Sports">Sports Cars</a></li>
                            <li><a href="/fleet?category=Electric">Electric Vehicles</a></li>
                            <li><a href="/fleet?category=SUV">SUVs</a></li>
                            <li><a href="/fleet?category=Economy">Economy</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Legal</h4>
                        <ul>
                            <li><a href="#">Privacy Policy</a></li>
                            <li><a href="#">Terms of Service</a></li>
                            <li><a href="#">Cookie Policy</a></li>
                            <li><a href="/services">Pricing</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Contact</h4>
                        <ul>
                            <li><a href="tel:+918001234567"><i class="fa-solid fa-phone"/> +91 800 123 4567</a></li>
                            <li><a href="mailto:hello@drivex.in"><i class="fa-solid fa-envelope"/> hello@drivex.in</a></li>
                            <li><a href="#"><i class="fa-solid fa-location-dot"/> Mumbai, India</a></li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom container">
                    <p>© 2026 DriveX. All rights reserved.</p>
                    <div class="payment-icons">
                        <i class="fa-brands fa-cc-visa"/>
                        <i class="fa-brands fa-cc-mastercard"/>
                        <i class="fa-brands fa-cc-amex"/>
                        <i class="fa-brands fa-cc-paypal"/>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
