<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the layout_templates views/templates for the theme_drivex module. -->
<odoo>
    <!-- Layout: Inject Fonts + FontAwesome into head and add header drivexHeader classes -->
    <record id="drivex_layout" model="theme.ir.ui.view">
        <field name="name">DriveX Layout</field>
        <field name="key">theme_drivex.drivex_layout</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="arch" type="xml">
            <!-- Inject Fonts + FontAwesome -->
            <xpath expr="//head" position="inside">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap"
                      rel="stylesheet"/>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
            </xpath>
            <!-- Add DriveX header styling classes to the header element across all templates -->
            <xpath expr="//header" position="attributes">
                <attribute name="t-attf-class" add="header drivexHeader" separator=" "/>
            </xpath>
        </field>
    </record>

    <!-- Header: DriveX Default Header (customizes website.template_header_default so changing header template in website editor works smoothly) -->
    <record id="drivex_template_header_default" model="theme.ir.ui.view">
        <field name="name">DriveX Header Default</field>
        <field name="key">theme_drivex.drivex_template_header_default</field>
        <field name="inherit_id" ref="website.template_header_default"/>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-call='website.navbar']" position="replace">
                <nav class="container nav" id="header">
                    <a href="/" class="logo">
                        <img src="/theme_drivex/static/src/img/logo.svg" alt="DriveX"/>
                    </a>
                    <ul class="menu menu-loading" id="menu">
                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                            <t t-if="submenu.is_visible">
                                <li>
                                    <a t-att-href="submenu._clean_url()"
                                       t-attf-class="#{submenu._is_active() and 'active'}">
                                        <span t-field="submenu.name"/>
                                    </a>
                                </li>
                            </t>
                        </t>
                    </ul>
                    <!-- Mobile-only account links, toggled open/closed by JS alongside the menu -->
                    <div class="mobile-account-links" id="mobileAccountLinks">
                        <div class="mobile-menu-divider"/>
                        <t t-if="not request.env.user._is_public()">
                            <a href="/my/home" class="mobile-menu-account">
                                <i class="fa-regular fa-user"/>
                                My Account
                            </a>
                            <a href="/web/session/logout?redirect=/" class="mobile-menu-account">
                                <i class="fa-solid fa-arrow-right-from-bracket"/>
                                Logout
                            </a>
                        </t>
                        <t t-if="request.env.user._is_public()">
                            <a href="/web/login" class="mobile-menu-account">
                                <i class="fa-regular fa-user"/>
                                Sign In
                            </a>
                        </t>
                    </div>
                    <div class="nav-right">
                        <t t-call="website.placeholder_header_search_box">
                            <t t-set="_layout" t-valuef="modal"/>
                        </t>
                        <t t-if="request.env.user._is_public()">
                            <a href="/web/login" class="btn-signin">Sign In</a>
                        </t>
                        <t t-else="">
                            <t t-call="portal.user_dropdown">
                                <t t-set="_avatar" t-value="true"/>
                                <t t-set="_user_name" t-value="true"/>
                                <t t-set="_item_class"
                                   t-value="'list-unstyled mb-0 dropdown o_no_autohide_item d-inline-block mobile-user-dropdown-hide'"/>
                                <t t-set="_link_class"
                                   t-value="'btn-signin dropdown-toggle d-flex align-items-center gap-2'"/>
                                <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end'"/>
                            </t>
                        </t>
                        <button class="hamburger" id="hamburger" aria-label="Toggle menu">
                            <span/>
                            <span/>
                            <span/>
                        </button>
                    </div>
                </nav>
            </xpath>
            <xpath expr="//t[@t-call='website.template_header_mobile']" position="replace"/>
        </field>
    </record>

    <!-- Footer: DriveX Default Footer (customizes website.footer_custom so changing footer template in website editor works smoothly) -->
    <record id="drivex_template_footer_default" model="theme.ir.ui.view">
        <field name="name">DriveX Footer Default</field>
