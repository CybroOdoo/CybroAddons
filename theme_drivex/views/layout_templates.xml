                                <li>
                                    <a href="tel:+918001234567">
                                        <i class="fa-solid fa-phone"/>
                                        +91 800 123 4567
                                    </a>
                                </li>
                                <li>
                                    <a href="mailto:hello@drivex.in">
                                        <i class="fa-solid fa-envelope"/>
