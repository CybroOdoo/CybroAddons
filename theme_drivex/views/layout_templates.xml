                                </li>
                                <li>
                                    <a href="/fleet?category=Sports">Sports Cars</a>
                                </li>
                                <li>
                                    <a href="/fleet?category=Electric">Electric Vehicles</a>
                                </li>
                                <li>
                                    <a href="/fleet?category=SUV">SUVs</a>
                                </li>
                                <li>
                                    <a href="/fleet?category=Economy">Economy</a>
                                </li>
                            </ul>
                        </div>
                        <div class="footer-col">
                            <h4>Legal</h4>
                            <ul>
                                <li>
                                    <a href="#">Privacy Policy</a>
                                </li>
                                <li>
