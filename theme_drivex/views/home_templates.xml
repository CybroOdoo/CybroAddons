<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the home_templates views/templates for the theme_drivex module. -->
<odoo>
    <template id="drivex_homepage" inherit_id="website.homepage" name="DriveX Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- ═══════════════════════════════════════════════
                     HERO SECTION  (full inline — no snippet call)
                ═══════════════════════════════════════════════ -->
                <section class="hero" data-name="Hero">
                    <div class="hero-content">
                        <div class="hero-badge">
                            <i class="fa-solid fa-star"/> Premium Car Rental
                        </div>
                        <h1 class="hero-title">
                            Drive Your <span class="hero-accent">Dream Car</span><br/>
                            Today
                        </h1>
                        <p class="hero-sub">
                            Rent luxury, sports, and economy vehicles in minutes.<br/>
                            Experience premium service and an unforgettable journey.
                        </p>

                        <!-- Search Box -->
                        <div class="search-box">

                            <!-- Pickup Location -->
                            <div class="input-group">
                                <label><i class="fa-solid fa-location-dot"/> Pickup Location</label>
                                <div class="cs-wrap locationSelect" id="locationSelect">
                                    <div class="cs-trigger">
                                        <i class="fa-solid fa-location-dot field-icon"/>
                                        <span class="cs-val">Pick a city</span>
                                        <i class="fa-solid fa-chevron-down cs-arrow"/>
                                    </div>
                                    <div class="cs-menu" id="locationOptions">
                                        <!-- Location options will be populated by JavaScript -->
                                    </div>
                                </div>
                            </div>

                            <!-- Pickup Date -->
                            <div class="input-group">
                                <label><i class="fa-regular fa-calendar"/> Pickup Date</label>
                                <div class="date-field pickupField" id="pickupField">
                                    <i class="fa-regular fa-calendar field-icon"/>
                                    <div class="date-display dp-placeholder" id="pickupDisplay">
                                        <span class="dd-day">Day</span>
                                        <span class="dd-sep">/</span>
                                        <span class="dd-month">Month</span>
                                        <span class="dd-sep">/</span>
                                        <span class="dd-year">Year</span>
                                        <span class="dd-time">00:00</span>
                                    </div>
                                    <div class="dp-panel" id="pickupPanel">
                                        <div class="dp-header">
                                            <button class="dp-nav dp-prev" type="button"><i class="fa-solid fa-chevron-left"/></button>
                                            <span class="dp-my"/>
                                            <button class="dp-nav dp-next" type="button"><i class="fa-solid fa-chevron-right"/></button>
                                        </div>
                                        <div class="dp-day-names">
                                            <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                                        </div>
                                        <div class="dp-grid"/>
                                        <div class="dp-time-row">
                                            <div class="dp-time-col">
                                                <button class="dp-tc dp-tc-up" type="button"><i class="fa-solid fa-chevron-up"/></button>
                                                <span class="dp-hh">12</span>
                                                <button class="dp-tc dp-tc-dn" type="button"><i class="fa-solid fa-chevron-down"/></button>
                                            </div>
                                            <span class="dp-colon">:</span>
                                            <div class="dp-time-col">
                                                <button class="dp-tc dp-tc-up" type="button"><i class="fa-solid fa-chevron-up"/></button>
                                                <span class="dp-mm">00</span>
                                                <button class="dp-tc dp-tc-dn" type="button"><i class="fa-solid fa-chevron-down"/></button>
                                            </div>
                                        </div>
                                        <button class="dp-confirm-btn" type="button">Confirm <i class="fa-solid fa-check"/></button>
                                    </div>
                                </div>
                            </div>

                            <!-- Return Date -->
                            <div class="input-group">
                                <label><i class="fa-regular fa-calendar-check"/> Return Date</label>
                                <div class="date-field returnField" id="returnField">
                                    <i class="fa-regular fa-calendar-check field-icon"/>
                                    <div class="date-display dp-placeholder" id="returnDisplay">
                                        <span class="dd-day">Day</span>
                                        <span class="dd-sep">/</span>
                                        <span class="dd-month">Month</span>
                                        <span class="dd-sep">/</span>
                                        <span class="dd-year">Year</span>
                                        <span class="dd-time">00:00</span>
                                    </div>
                                    <div class="dp-panel dp-panel--right" id="returnPanel">
                                        <div class="dp-header">
                                            <button class="dp-nav dp-prev" type="button"><i class="fa-solid fa-chevron-left"/></button>
                                            <span class="dp-my"/>
                                            <button class="dp-nav dp-next" type="button"><i class="fa-solid fa-chevron-right"/></button>
                                        </div>
                                        <div class="dp-day-names">
                                            <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                                        </div>
                                        <div class="dp-grid"/>
                                        <div class="dp-time-row">
                                            <div class="dp-time-col">
                                                <button class="dp-tc dp-tc-up" type="button"><i class="fa-solid fa-chevron-up"/></button>
                                                <span class="dp-hh">12</span>
                                                <button class="dp-tc dp-tc-dn" type="button"><i class="fa-solid fa-chevron-down"/></button>
                                            </div>
                                            <span class="dp-colon">:</span>
                                            <div class="dp-time-col">
                                                <button class="dp-tc dp-tc-up" type="button"><i class="fa-solid fa-chevron-up"/></button>
                                                <span class="dp-mm">00</span>
                                                <button class="dp-tc dp-tc-dn" type="button"><i class="fa-solid fa-chevron-down"/></button>
                                            </div>
                                        </div>
                                        <button class="dp-confirm-btn" type="button">Confirm <i class="fa-solid fa-check"/></button>
                                    </div>
                                </div>
                            </div>

                            <!-- Car Type -->
                            <div class="input-group">
                                <label><i class="fa-solid fa-car"/> Car Type</label>
                                <div class="cs-wrap carTypeSelect" id="carTypeSelect">
                                    <div class="cs-trigger">
                                        <i class="fa-solid fa-car-side field-icon"/>
                                        <span class="cs-val">All Vehicles</span>
                                        <i class="fa-solid fa-chevron-down cs-arrow"/>
                                    </div>
                                    <div class="cs-menu cs-menu--right" id="carTypeOptions">
                                        <div class="cs-opt cs-opt--active" data-value="all"><span class="cs-opt-icon"><i class="fa-solid fa-car-side"/></span>All Vehicles</div>
                                        <!-- Car type options will be populated by JavaScript -->
                                    </div>
                                </div>
                            </div>

                            <button class="search-btn"><i class="fa-solid fa-magnifying-glass"/> Search</button>
                        </div>

                        <div class="action-btns">
                            <a href="/fleet" class="btn-white"><i class="fa-solid fa-car-side"/> Browse Fleet</a>
                            <a href="/booking" class="btn-red"><i class="fa-solid fa-bolt"/> Book Now</a>
                        </div>
                    </div>
                </section>
                <!-- ═══════════════════════════════════════════════
                     STATS BAR  (inline — no container wrapper issues)
                ═══════════════════════════════════════════════ -->
                <section class="stats-bar" data-name="Stats Bar" style="background:#0a0e1a;padding:44px 0;">
                    <div style="display:flex;flex-direction:row;align-items:stretch;width:100%;max-width:1300px;margin:0 auto;padding:0 24px;box-sizing:border-box;text-align:center;">
                        <div class="stat" style="flex:1 1 0;padding:12px 20px;border-right:1px solid rgba(255,255,255,0.07);">
                            <h3 style="font-size:2.4rem;font-weight:800;color:#fff;margin:0 0 5px;letter-spacing:-1px;">5,000+</h3>
                            <p style="font-size:0.83rem;color:rgba(255,255,255,0.5);margin:0;">Vehicles Available</p>
                        </div>
                        <div class="stat" style="flex:1 1 0;padding:12px 20px;border-right:1px solid rgba(255,255,255,0.07);">
                            <h3 style="font-size:2.4rem;font-weight:800;color:#fff;margin:0 0 5px;letter-spacing:-1px;">50+</h3>
                            <p style="font-size:0.83rem;color:rgba(255,255,255,0.5);margin:0;">Cities Covered</p>
                        </div>
                        <div class="stat" style="flex:1 1 0;padding:12px 20px;border-right:1px solid rgba(255,255,255,0.07);">
                            <h3 style="font-size:2.4rem;font-weight:800;color:#fff;margin:0 0 5px;letter-spacing:-1px;">98%</h3>
                            <p style="font-size:0.83rem;color:rgba(255,255,255,0.5);margin:0;">Customer Satisfaction</p>
                        </div>
                        <div class="stat" style="flex:1 1 0;padding:12px 20px;">
                            <h3 style="font-size:2.4rem;font-weight:800;color:#fff;margin:0 0 5px;letter-spacing:-1px;">24/7</h3>
                            <p style="font-size:0.83rem;color:rgba(255,255,255,0.5);margin:0;">Support Available</p>
                        </div>
                    </div>
                </section>
                <!-- ═══════════════════════════════════════════════
                     FLEET SECTION
                ═══════════════════════════════════════════════ -->
                <section class="fleet-section" id="fleet" data-name="Fleet">
                    <div class="fleet-header">
                        <span class="section-badge">Our Fleet</span>
                        <h2>Premium Vehicles for Every Journey</h2>
                        <p>Choose from our wide selection of high-end vehicles, perfectly<br/>maintained and ready for your next adventure.</p>
                    </div>
                    <div class="fleet-filter" id="fleetFilter">
                        <button class="filter-btn active" data-filter="all">All</button>
                        <!-- Filter buttons will be populated by JavaScript -->
                    </div>
                    <div class="fleet-grid" id="fleetGrid">
                        <!-- Vehicle cards will be populated by JavaScript -->
                    </div>
                    <div class="fleet-cta">
                        <a href="/fleet" class="btn-outline-white">View All Vehicles <i class="fa-solid fa-arrow-right"/></a>
                    </div>
                </section>
                <!-- ═══════════════════════════════════════════════
                     FEATURES
                ═══════════════════════════════════════════════ -->
                <section class="features" id="features" data-name="Features">
                    <div class="container">
                        <span class="section-badge dark">Why Us</span>
                        <h2>Why Choose DriveX</h2>
                        <p class="section-sub">Everything you need for a perfect driving experience</p>
                        <div class="feature-grid">
                            <div class="feature"><div class="feature-icon"><i class="fa-solid fa-car-side"/></div><h3>Wide Range of Vehicles</h3><p>From economy to luxury sports cars — 5,000+ options at your fingertips.</p></div>
                            <div class="feature"><div class="feature-icon"><i class="fa-solid fa-tag"/></div><h3>Transparent Pricing</h3><p>No hidden fees, no surprises. What you see is exactly what you pay.</p></div>
                            <div class="feature"><div class="feature-icon"><i class="fa-solid fa-bolt"/></div><h3>Instant Booking</h3><p>Confirm your reservation in under 60 seconds, anytime, anywhere.</p></div>
                            <div class="feature"><div class="feature-icon"><i class="fa-solid fa-shield-halved"/></div><h3>Fully Insured</h3><p>Every vehicle comes with comprehensive insurance for complete peace of mind.</p></div>
                            <div class="feature"><div class="feature-icon"><i class="fa-solid fa-location-dot"/></div><h3>Multiple Locations</h3><p>Pickup from 50+ airports, hotels and city centres across the country.</p></div>
                            <div class="feature"><div class="feature-icon"><i class="fa-solid fa-headset"/></div><h3>24/7 Support</h3><p>Round-the-clock customer service — call, chat, or email us anytime.</p></div>
                        </div>
                    </div>
                </section>
                <!-- ═══════════════════════════════════════════════
                     HOW IT WORKS
                ═══════════════════════════════════════════════ -->
                <section class="steps" id="steps" data-name="How It Works">
                    <div class="container">
                        <span class="section-badge dark">Simple Process</span>
                        <h2>How It Works</h2>
                        <p class="section-sub">Get behind the wheel in three easy steps</p>
                        <div class="step-grid">
                            <div class="step">
                                <div class="step-number">01</div>
                                <div class="step-icon"><i class="fa-solid fa-magnifying-glass"/></div>
                                <h3>Choose Your Car</h3>
                                <p>Browse our premium fleet and pick the vehicle that matches your style and budget.</p>
                            </div>
                            <div class="step-connector"/>
                            <div class="step">
                                <div class="step-number">02</div>
                                <div class="step-icon"><i class="fa-regular fa-calendar-check"/></div>
                                <h3>Book Instantly</h3>
                                <p>Select your dates, enter your details, and confirm your booking in seconds.</p>
                            </div>
                            <div class="step-connector"/>
                            <div class="step">
                                <div class="step-number">03</div>
                                <div class="step-icon"><i class="fa-solid fa-key"/></div>
                                <h3>Drive Away</h3>
                                <p>Pick up your car at the agreed location and enjoy the open road.</p>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ═══════════════════════════════════════════════
                     REVIEWS
                ═══════════════════════════════════════════════ -->
                <section class="reviews" id="reviews" data-name="Reviews">
                    <div class="container">
                        <span class="section-badge dark">Testimonials</span>
                        <h2>What Our Customers Say</h2>
                        <p class="section-sub">Join thousands of satisfied drivers</p>
                        <div class="review-grid">
                            <div class="review">
                                <div class="review-stars"><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/></div>
                                <p>"Best car rental experience I've ever had. The BMW M4 was in perfect condition and the booking was seamless. Highly recommend DriveX!"</p>
                                <div class="reviewer"><div class="reviewer-avatar">MT</div><div><h4>Michael T.</h4><span>Business Traveler</span></div></div>
                            </div>
                            <div class="review">
                                <div class="review-stars"><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/></div>
                                <p>"The Tesla Model 3 was incredible! Clean, fully charged, and delivered on time. DriveX made our road trip absolutely perfect."</p>
                                <div class="reviewer"><div class="reviewer-avatar">SJ</div><div><h4>Sarah J.</h4><span>Road Trip Enthusiast</span></div></div>
                            </div>
                            <div class="review">
                                <div class="review-stars"><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-solid fa-star"/><i class="fa-regular fa-star"/></div>
                                <p>"Transparent pricing — exactly as advertised. No surprise charges at checkout. Will definitely use DriveX again for my next trip."</p>
                                <div class="reviewer"><div class="reviewer-avatar">DO</div><div><h4>David O.</h4><span>Weekend Adventurer</span></div></div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ═══════════════════════════════════════════════
                     CTA BANNER
                ═══════════════════════════════════════════════ -->
                <section class="cta-banner" data-name="CTA Banner">
                    <div class="container cta-content">
                        <div class="cta-text">
                            <h2>Ready to Hit the Road?</h2>
                            <p>Book your dream car in under 60 seconds. No hidden fees, no hassle.</p>
                        </div>
                        <div class="cta-actions">
                            <a href="/booking" class="btn-red"><i class="fa-solid fa-calendar-check"/> Book Now</a>
                            <a href="/contactus" class="btn-outline-white"><i class="fa-solid fa-phone"/> Call Us</a>
                        </div>
                    </div>
                </section>
                <div class="oe_structure"/>
            </div>
        </xpath>
    </template>
</odoo>
