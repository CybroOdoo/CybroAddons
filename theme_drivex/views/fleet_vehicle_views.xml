<?xml version="1.0" encoding="utf-8"?>
<!--
    This file contains the XML templates, data records for the Fleet Vehicle model, menuitems and actions.
-->
<odoo>
    <!-- Inherit Fleet Vehicle Form to add Website fields -->
    <record id="fleet_vehicle_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.view.form.inherit.theme.drivex</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Website Rental" name="website_rental">
                    <group>
                        <group>
                            <field name="is_available_on_website" widget="boolean_toggle"/>
                            <field name="publish_on_homepage" widget="boolean_toggle" invisible="not is_available_on_website"/>
                            <field name="daily_rate"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="feature_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <group string="Website Description">
                        <field name="website_description" nolabel="1" widget="html"/>
                    </group>
                    <group string="Gallery Images">
                        <field name="vehicle_image_ids" mode="kanban" nolabel="1">
                            <kanban string="Vehicle Images">
                                <field name="id"/>
                                <field name="image"/>
                                <field name="sequence"/>
                                <templates>
                                    <t t-name="card">
                                        <div class="oe_kanban_global_click" style="width: 150px; height: 150px; display: flex; align-items: center; justify-content: center;">
                                            <div class="o_kanban_image" style="width: 100%; height: 100%;">
                                                <img t-attf-src="/web/image/fleet.vehicle.image/#{record.id.raw_value}/image" alt="Vehicle Image" style="max-width:100%; max-height:100%; object-fit:contain;"/>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                            <form string="Vehicle Image">
                                <group>
                                    <field name="name"/>
                                    <field name="sequence"/>
                                </group>
                                <group>
                                    <field name="image" widget="image" class="oe_avatar"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!-- Rental Feature Views -->
    <record id="view_fleet_vehicle_feature_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.feature.view.form</field>
        <field name="model">fleet.vehicle.feature</field>
        <field name="arch" type="xml">
            <form string="Rental Feature">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="icon" placeholder="e.g. fa-wifi"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_fleet_vehicle_feature_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.feature.view.list</field>
        <field name="model">fleet.vehicle.feature</field>
        <field name="arch" type="xml">
            <list string="Rental Features" editable="bottom">
                <field name="name"/>
                <field name="icon"/>
            </list>
        </field>
    </record>
    <record id="action_fleet_vehicle_feature" model="ir.actions.act_window">
        <field name="name">Rental Features</field>
        <field name="res_model">fleet.vehicle.feature</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fleet_rental_feature"
              name="Rental Features"
              parent="fleet.fleet_configuration"
              action="action_fleet_vehicle_feature"
              sequence="60"/>
</odoo>
