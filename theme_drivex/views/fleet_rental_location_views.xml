<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the views and actions records for the fleet.rental.location model in theme_drivex module. -->
<odoo>
    <!-- FLEET RENTAL LOCATION   -->
    <record id="fleet_rental_location_view_list" model="ir.ui.view">
        <field name="name">fleet.rental.location.view.list</field>
        <field name="model">fleet.rental.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <record id="action_fleet_rental_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">fleet.rental.location</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_rental_locations" name="Rental Locations" parent="fleet.fleet_configuration" action="action_fleet_rental_location" sequence="100"/>
</odoo>
