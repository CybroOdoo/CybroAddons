<?xml version="1.0" encoding="UTF-8" ?>
<!--
    This file contains the list view, action and menu for the fleet.rental.location model.
-->
<odoo>
    <record id="fleet_rental_location_view_list" model="ir.ui.view">
        <field name="name">fleet.rental.location.view.list</field>
        <field name="model">fleet.rental.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <record id="fleet_rental_location_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">fleet.rental.location</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="fleet_rental_location_menu" name="Rental Locations"
              parent="fleet.fleet_configuration"
              action="fleet_rental_location_action" sequence="100"/>
</odoo>
