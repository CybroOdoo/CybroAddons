<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fleet Vehicle Feature Views -->
<record id="fleet_vehicle_feature_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.feature.form</field>
        <field name="model">fleet.vehicle.feature</field>
        <field name="arch" type="xml">
            <form string="Rental Feature">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="icon" placeholder="e.g. fa-wifi" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
<!--Fleet vehicle tree-->
    <record id="fleet_vehicle_feature_view_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.feature.tree</field>
        <field name="model">fleet.vehicle.feature</field>
        <field name="arch" type="xml">
            <tree string="Rental Features" editable="bottom">
                <field name="name" />
                <field name="icon" />
            </tree>
        </field>
    </record>
<!--Fleet vehicle action-->
    <record id="action_fleet_vehicle_feature" model="ir.actions.act_window">
        <field name="name">Rental Features</field>
        <field name="res_model">fleet.vehicle.feature</field>
        <field name="view_mode">tree,form</field>
    </record>
<!--Menu-->
    <menuitem id="menu_fleet_rental_feature" name="Rental Features" parent="fleet.fleet_configuration" action="action_fleet_vehicle_feature" sequence="60" />
</odoo>
