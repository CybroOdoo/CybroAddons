<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the records, menuitems and actions  for model fleet.vehicle.feature in theme_drivex module. -->
<odoo>
    <!-- 
        Vehicle Feature Views 
        Provides form and list views for the fleet vehicle features used in website rental.
    -->
    <record id="fleet_vehicle_feature_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.feature.view.form</field>
        <field name="model">fleet.vehicle.feature</field>
        <field name="arch" type="xml">
            <form string="Rental Feature">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="icon" placeholder="e.g. fa-wifi"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fleet_vehicle_feature_view_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.feature.view.list</field>
        <field name="model">fleet.vehicle.feature</field>
        <field name="arch" type="xml">
            <list string="Rental Features" editable="bottom">
                <field name="name"/>
                <field name="icon"/>
            </list>
        </field>
    </record>
    <record id="action_fleet_vehicle_feature" model="ir.actions.act_window">
        <field name="name">Rental Features</field>
        <field name="res_model">fleet.vehicle.feature</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fleet_rental_feature" 
              name="Rental Features" 
              parent="fleet.fleet_configuration" 
              action="action_fleet_vehicle_feature" 
              sequence="60"/>
</odoo>
