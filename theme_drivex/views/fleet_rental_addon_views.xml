<?xml version="1.0" encoding="utf-8"?>
<!-- Description: This file defines the  views and actions records  for the fleet.rental.addon model in theme_drivex module. -->
<odoo>
    <!-- FLEET RENTAL ADDON      -->
    <record id="fleet_rental_addon_view_list" model="ir.ui.view">
        <field name="name">fleet.rental.addon.view.list</field>
        <field name="model">fleet.rental.addon</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="charge_type"/>
                <field name="price"/>
            </list>
        </field>
    </record>
    <record id="action_fleet_rental_addon" model="ir.actions.act_window">
        <field name="name">Add-ons</field>
        <field name="res_model">fleet.rental.addon</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_rental_addons" name="Add-ons" parent="fleet.fleet_configuration" action="action_fleet_rental_addon" sequence="120"/>
</odoo>
