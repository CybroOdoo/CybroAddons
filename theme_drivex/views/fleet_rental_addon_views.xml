<?xml version="1.0" encoding="UTF-8" ?>
<!--
    This file contains the list view, action and menu for the fleet.rental.addon model.
-->
<odoo>
    <record id="fleet_rental_addon_view_list" model="ir.ui.view">
        <field name="name">fleet.rental.addon.view.list</field>
        <field name="model">fleet.rental.addon</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="charge_type"/>
                <field name="price"/>
            </list>
        </field>
    </record>
    <record id="fleet_rental_addon_action" model="ir.actions.act_window">
        <field name="name">Add-ons</field>
        <field name="res_model">fleet.rental.addon</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="fleet_rental_addon_menu" name="Add-ons"
              parent="fleet.fleet_configuration"
              action="fleet_rental_addon_action" sequence="120"/>
</odoo>
