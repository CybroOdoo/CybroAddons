<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Used to set the dealer's price and quantity-->
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.view.form.inherit.customers.dealers.quantity</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='upsell']"
                   position="inside">
                <group string="Dealers">
                    <field name="price" widget="monetary" options="{'currency_field': 'cost_currency_id'}"/>
                    <field name="minimum_quantity"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
