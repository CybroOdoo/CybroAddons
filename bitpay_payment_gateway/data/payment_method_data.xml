<?xml version="1.0" encoding="utf-8"?>
<!-- BitPay payment method record data -->
<odoo noupdate="1">
    <record id="payment_method_bitpay" model="payment.method">
        <field name="name">BitPay</field>
        <field name="code">bitpay</field>
        <field name="sequence">300</field>
        <field name="image" type="base64" file="bitpay_payment_gateway/static/description/assets/images/bitpay.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">none</field>
    </record>
</odoo>
