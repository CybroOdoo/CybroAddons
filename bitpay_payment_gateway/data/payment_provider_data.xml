        <field name="code">bitpay</field>
        <field name="module_id" ref="base.module_bitpay_payment_gateway"/>
        <field name="redirect_form_view_id" ref="bitpay_payment_gateway.redirect_form"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_method_bitpay')])]"/>
    </record>
</odoo>
