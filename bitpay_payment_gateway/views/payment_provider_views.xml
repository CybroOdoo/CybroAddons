<?xml version="1.0" encoding="utf-8"?>
<!-- BitPay payment provider form view inheritance -->
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.bitpay.payment.gateway</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group name="bitpay_credentials" invisible="code != 'bitpay'">
                    <field name="bitpay_pos_token"
                           string="POS Token"
                           required="code == 'bitpay'"
                           password="True"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
