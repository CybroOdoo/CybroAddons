<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Define an action for the Inventory All In One Report -->
    <record id="action_report_inventory_all_in_one" model="ir.actions.report">
        <field name="name">Inventory All In One Report</field>
        <field name="model">dynamic.inventory.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inventory_report_generator.inventory_pdf_report</field>
        <field name="binding_type">report</field>
    </record>
    <!-- Define a template for the Inventory PDF Report -->
    <template id="inventory_pdf_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-if="Filters.get('report_type')=='Report By Transfers'">
                    <t t-call="inventory_report_generator.report_by_transfers"/>
                </t>
                <t t-if="Filters.get('report_type')=='Report By Categories'">
                    <t t-call="inventory_report_generator.report_by_categories"/>
                </t>

                <t t-if="Filters.get('report_type')=='Report By Warehouse'">
                    <t t-call="inventory_report_generator.report_by_warehouse"/>
                </t>
                <t t-if="Filters.get('report_type')=='Report By Location'">
                    <t t-call="inventory_report_generator.report_by_location"/>
                </t>
            </t>
        </t>
    </template>
    <!-- Define a template for the 'Report By Transfers' -->
    <template id="report_by_transfers">
        <div class="page">
            <div class="oe_structure"/>
            <span t-if="Dates.get('date_from')">
                <strong>From:</strong>
                <t t-out="Dates['date_from']"/>
            </span>
            <span t-if="Dates.get('date_to')">
                <strong>To:</strong>
                <t t-out="Dates['date_to']"/>
            </span>
            <div>
                <div style="width:100%;">
                    <div style="text-align:center;" class="row">
                        <div class="col-2">
                            <strong>Report Type:</strong>
                            <t t-out="Filters.get('report_type')"/>
                        </div>
                    </div>
                </div>
                <br/>
                <table class="table table-sm table-reports">
                    <thead>
                        <tr>
                            <th colspan="6" class="text-start">Reference</th>
                            <th colspan="6" class="text-center">Scheduled
                                Date
                            </th>
                            <th colspan="6" class="text-end">Source
                                Document
                            </th>
                            <th colspan="6" class="text-end">Company</th>
                            <th colspan="6" class="text-center">Delivery
                                Address
                            </th>
                            <th colspan="6" class="text-start">State</th>
                        </tr>
                    </thead>
                    <tbody class="text-start">
                        <t t-foreach="report_main_line_data" t-as="main">
                            <tr style="font-weight: bold;">
                                <td colspan="6">
                                    <span t-out="main['name']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['scheduled_date']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['origin']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['company']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['partner']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['state']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <br/>
        </div>
    </template>
    <!-- Template for 'Report By Categories' -->
    <template id="report_by_categories">
        <div class="page">
            <div class="oe_structure"/>
            <span t-if="Dates.get('date_from')">
                <strong>From:</strong>
                <t t-out="Dates['date_from']"/>
            </span>
            <span t-if="Dates.get('date_to')">
                <strong>To:</strong>
                <t t-out="Dates['date_to']"/>
            </span>
            <div>
                <div style="width:100%;">
                    <div style="text-align:center;" class="row">

                        <div class="col-2">
                            <strong>Report Type:</strong>
                            <t t-out="Filters.get('report_type')"/>
                        </div>
                    </div>
                </div>
                <br/>
                <table class="table table-sm table-reports">
                    <thead>
                        <tr class="text-start">
                            <th colspan="6">Category</th>
                            <th colspan="6">Product Name</th>
                            <th colspan="6" class="text-end">Create Date</th>
                            <th colspan="6" class="text-center">Product Cost
                            </th>
                            <th colspan="6" class="text-center">Location
                            </th>
                            <th colspan="6" class="text-center">On Hand Qty
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="report_main_line_data" t-as="main">
                            <tr class="text-center" style="font-weight: bold;">
                                <td colspan="6">
                                    <span t-out="main['category']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['name']['en_US']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['create_date']"/>
                                </td>
                                <td colspan="6">
                                    <t t-if="main['value_float']">
                                        <span t-out="main['value_float'].get(str(company.id)) or list(main['value_float'].values())[0] if isinstance(main['value_float'], dict) else main['value_float']"/>
                                    </t>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['location']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['quantity']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <br/>
        </div>
    </template>
    <!-- Template for 'Report By Warehouse' -->
    <template id="report_by_warehouse">
        <div class="page">
            <div class="oe_structure"/>
            <span t-if="Dates.get('date_from')">
                <strong>From:</strong>
                <t t-out="Dates['date_from']"/>
            </span>
            <span t-if="Dates.get('date_to')">
                <strong>To:</strong>
                <t t-out="Dates['date_to']"/>
            </span>
            <div>
                <div style="width:100%;">
                    <div style="text-align:center;" class="row">

                        <div class="col-2">
                            <strong>Report Type:</strong>
                            <t t-out="Filters.get('report_type')"/>
                        </div>
                    </div>
                </div>
                <br/>
                <table class="table table-sm table-reports">
                    <thead>
                        <tr>
                            <th colspan="6" class="text-start">Warehouse</th>
                            <th colspan="6" class="text-center">Date</th>
                            <th colspan="6" class="text-end">Company</th>
                            <th colspan="6" class="text-end">Location</th>
                            <th colspan="6" class="text-center">Route</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="report_main_line_data" t-as="main">
                            <tr style="font-weight: bold;">
                                <td colspan="6">
                                    <span t-out="main['name']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['write_date']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['company']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['location']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="list(main['route'].values())[0]"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <br/>
        </div>
    </template>
    <!-- Template for 'Report By Location' -->
    <template id="report_by_location">
        <div class="page">
            <div class="oe_structure"/>
            <span t-if="Dates.get('date_from')">
                <strong>From:</strong>
                <t t-out="Dates['date_from']"/>
            </span>
            <span t-if="Dates.get('date_to')">
                <strong>To:</strong>
                <t t-out="Dates['date_to']"/>
            </span>
            <div>
                <div style="width:100%;">
                    <div style="text-align:center;" class="row">
                        <div class="col-2">
                            <strong>Report Type:</strong>
                            <t t-out="Filters.get('report_type')"/>
                        </div>
                    </div>
                </div>
                <br/>
                <table class="table table-sm table-reports">
                    <thead>
                        <tr>
                            <th colspan="6">Location</th>
                            <th colspan="6">Location Type</th>
                            <th colspan="6">Create Date</th>
                            <th colspan="6">Company</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="report_main_line_data" t-as="main">
                            <tr style="font-weight: bold;">
                                <td colspan="6">
                                    <span t-out="main['complete_name']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['location_type']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['create_date']"/>
                                </td>
                                <td colspan="6">
                                    <span t-out="main['company']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <br/>
        </div>
    </template>
</odoo>
