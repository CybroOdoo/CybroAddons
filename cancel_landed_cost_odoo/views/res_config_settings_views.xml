<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--        Inherited the res.config.setting to add the fields-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cancel.landed.cost.odoo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='valuation_setting_container']" position="after">
                <block title="Landed Cost Cancel Configuration" name="landed_cost_cancel_container">
                    <setting id="landed_cost_cancel" string="Option to Cancel Landed Cost">
                        <field name="land_cost_cancel_modes" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
