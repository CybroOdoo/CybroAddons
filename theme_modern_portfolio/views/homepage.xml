<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Default Homepage Template -->
    <template id="homepage" name="Modern Portfolio Homepage">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero Section -->
                <t t-snippet="theme_modern_portfolio.s_portfolio_hero" t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/hero_block.jpg"/>

                <!-- Welcome Text Section -->
                <t t-snippet="theme_modern_portfolio.s_portfolio_welcome" t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/welcome_block.jpg"/>

                <!-- Stats Counter Section -->
                <t t-snippet="theme_modern_portfolio.s_portfolio_stats" t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/stats_block.jpg"/>

                <!-- Portfolio Grid Section -->
                <t t-snippet="theme_modern_portfolio.s_portfolio_grid" t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/portfolio_grid_block.jpg"/>
            </div>
        </t>
    </template>

    <!-- About Page Template -->
    <template id="about_page_template" name="About Us">
        <t t-call="website.layout">
            <div id="wrap">
                <!-- Breadcrumb Banner -->
                <div class="cmpad">
                    <div class="banner inbanner">
                        <nav aria-label="breadcrumb" class="breadcrumb-container">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/">Home</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">About</li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <!-- About Section -->
                <t t-snippet="theme_modern_portfolio.s_portfolio_about" t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/about_block.jpg"/>

                <!-- Features Section -->
                <t t-snippet="theme_modern_portfolio.s_portfolio_features" t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/features_block.jpg"/>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <!-- Projects Page Template -->
    <template id="projects_page_template" name="Projects">
        <t t-call="website.layout">
            <div id="wrap">
                <!-- Breadcrumb Banner -->
                <div class="cmpad">
                    <div class="banner inbanner">
                        <nav aria-label="breadcrumb" class="breadcrumb-container">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/">Home</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">Projects</li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <!-- Portfolio Grid -->
                <t t-snippet="theme_modern_portfolio.s_portfolio_grid"/>

                <!-- Featured Projects -->
                <t t-snippet="theme_modern_portfolio.s_portfolio_featured_project"/>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>

</odoo>
