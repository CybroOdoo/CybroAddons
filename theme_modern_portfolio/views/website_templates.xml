<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Header Template - Inherits from website.layout -->
    <template id="modern_portfolio_layout" inherit_id="website.layout" name="Modern Portfolio Layout">
        <xpath expr="//header[@id='top']" position="replace">
            <header id="top" class="o_header_standard header-shadow" data-name="Header">
                <div class="cmpad w-100">
                    <div class="headmain">
                        <div class="logocol">
                            <a href="/">
                                <img src="/web/binary/company_logo" alt="Logo" width="250"/>
                            </a>
                        </div>
                        <div class="menucol">
                            <ul>
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <li>
                                        <a t-att-href="submenu._clean_url()"><span t-field="submenu.name"/></a>
                                    </li>
                                </t>
                            </ul>
                        </div>
                        <div class="header-actions">
                            <a href="#projects" class="bttn bttn2">
                                Get Started
                                <span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                                        <path fill="currentColor"  d="M9 15V4.156l4.854 4.107l1.292-1.526L8 .69L.854 6.737l1.292 1.526L7 4.156V15z"/>
                                    </svg>
                                </span>
                            </a>
                            <button class="menu-toggle" type="button" aria-label="Toggle navigation">
                                <span/>
                                <span/>
                                <span/>
                            </button>
                        </div>
                    </div>
                </div>
            </header>
        </xpath>

        <!-- Footer Template -->
        <xpath expr="//footer[@id='bottom']" position="replace">
            <footer id="bottom" class="o_footer" data-name="Footer">
                <div class="cmpad">
                    <section class="contact-section">
                        <div class="header-row">
                            <h2 class="section-title">Get In Touch</h2>
                            <nav class="social-links">
                                <a href="#">behance</a>
                                <a href="#">dribbble</a>
                                <a href="#">github</a>
                                <a href="#">linkedin</a>
                                <a href="#">youtube</a>
                            </nav>
                        </div>

                        <form class="form-grid o_mark_required s_contact_form" action="/website/contact/form" method="post" enctype="multipart/form-data">
                            <!-- Left column -->
                            <input type="hidden" name="discuss" id="discuss_input"/>
                            <input type="hidden" name="timeline" id="timeline_input"/>
                            <input type="hidden" name="source" id="source_input"/>
                            <input type="hidden" name="email_to" t-att-value="res_company.email"/>
                            <div class="form-group">
                                <div class="dropdown-field">
                                    <div class="field-row dropdown-header">
                                        <span>I'd like to discuss</span>
                                        <span class="plus">+</span>
                                    </div>
                                    <t t-set="tags" t-value="request.env['portfolio.project.tag'].sudo().search([], limit=5)"/>
                                    <div class="dropdown-menu discuss-field">
                                        <t t-foreach="tags" t-as="tag">
                                            <div class="dropdown-option" t-att-data-value="tag.name" t-esc="tag.name"/>
                                        </t>
                                        <div class="dropdown-option" t-att-data-value="other">Other</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right column -->
                            <div class="form-group">
                                <div class="dropdown-field">
                                    <div class="field-row dropdown-header">
                                        <span>Timeline</span>
                                        <span class="plus">+</span>
                                    </div>
                                    <div class="dropdown-menu timeline-field">
                                        <div class="dropdown-option">ASAP</div>
                                        <div class="dropdown-option">This week</div>
                                        <div class="dropdown-option">This month</div>
                                        <div class="dropdown-option">In a few months</div>
                                        <div class="dropdown-option">Flexible</div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="dropdown-field">
                                    <div class="field-row dropdown-header">
                                        <span>How did you find me?</span>
                                        <span class="plus">+</span>
                                    </div>
                                    <div class="dropdown-menu source-field">
                                        <div class="dropdown-option">Google</div>
                                        <div class="dropdown-option">Social Media</div>
                                        <div class="dropdown-option">Referral</div>
                                        <div class="dropdown-option">Portfolio Site</div>
                                        <div class="dropdown-option">Other</div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <input id="contact1" class="s_website_form_model_required" name="name" required="" data-fill-with="name" type="text" placeholder="First and Last Name"/>
                            </div>

                            <div class="form-group">
                                <input id="contact4" name="company" data-fill-with="commercial_company_name" type="text" placeholder="Company (optional)"/>
                            </div>

                            <div class="form-group">
                                <input id="contact3" class="s_website_form_model_required" type="email" name="email_from" required="" data-fill-with="email" placeholder="Enter your email"/>
                            </div>

                            <div class="message-area">
                                <textarea id="contact6" placeholder="Your message (optional)" name="description"/>
                            </div>

                            <div class="form-bottom">
                                <div class="checkboxes">
                                    <label class="checkbox-label">
                                        <input type="checkbox" name="authority"/>
                                        By checking this box, you authorize us to process your personal data.
                                    </label>
                                    <label class="checkbox-label">
                                        <input type="checkbox" name="newsletter"/>
                                        Subscribe to the newsletter!
                                    </label>
                                </div>
                                <button class="submit-btn s_website_form_send">submit</button>
                            </div>
                        </form>
                    </section>

                    <div class="footer-bar">
                        <span class="copy">Scott Eastwood &#160;|&#160; Copyright 2024 &#160;|&#160; ID 02472870209
                            &#160;|&#160; New York, USA and everywhere
                        </span>
                        <div class="footer-links">
                            <a href="#">Terms of Service</a>
                            <span class="sep">|</span>
                            <a href="#">Data Protection Policy</a>
                            <span class="sep">|</span>
                            <a href="#">Update cookie</a>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
