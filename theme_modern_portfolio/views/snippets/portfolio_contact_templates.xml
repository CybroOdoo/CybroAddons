<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Contact Form Snippet -->
    <template id="s_portfolio_contact" name="Contact Form">
        <section class="s_portfolio_contact cmpad py-5">
            <section class="contact-section contact-section--dark">
                <div class="header-row">
                    <h2 class="section-title">Connect With Me</h2>
                </div>
                <form class="form-grid" onsubmit="return false;">
                    <!-- Left column -->
                    <div class="form-group">
                        <div class="dropdown-field">
                            <div class="field-row dropdown-header">
                                <span>I'd like to discuss</span>
                                <span class="plus">+</span>
                            </div>
                            <div class="dropdown-menu">
                                <div class="dropdown-option">Web Design</div>
                                <div class="dropdown-option">Web Development</div>
                                <div class="dropdown-option">UI/UX Design</div>
                                <div class="dropdown-option">Mobile App</div>
                                <div class="dropdown-option">Other Project</div>
                            </div>
                        </div>
                    </div>

                    <!-- Right column -->
                    <div class="form-group">
                        <div class="dropdown-field">
                            <div class="field-row dropdown-header">
                                <span>Timeline</span>
                                <span class="plus">+</span>
                            </div>
                            <div class="dropdown-menu">
                                <div class="dropdown-option">ASAP</div>
                                <div class="dropdown-option">This week</div>
                                <div class="dropdown-option">This month</div>
                                <div class="dropdown-option">In a few months</div>
                                <div class="dropdown-option">Flexible</div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="dropdown-field">
                            <div class="field-row dropdown-header">
                                <span>How did you find me?</span>
                                <span class="plus">+</span>
                            </div>
                            <div class="dropdown-menu">
                                <div class="dropdown-option">Google</div>
                                <div class="dropdown-option">Social Media</div>
                                <div class="dropdown-option">Referral</div>
                                <div class="dropdown-option">Portfolio Site</div>
                                <div class="dropdown-option">Other</div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <input type="text" placeholder="First and Last Name" />
                    </div>

                    <div class="form-group">
                        <input type="text" placeholder="Company (optional)" />
                    </div>

                    <div class="form-group">
                        <input type="email" placeholder="Enter your email" />
                    </div>

                    <div class="message-area">
                        <textarea placeholder="Your message (optional)"></textarea>
                    </div>

                    <div class="form-bottom">
                        <a href="#" class="bttn bttn2">Submit
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                                    <path fill="currentColor" d="M9 15V4.156l4.854 4.107l1.292-1.526L8 .69L.854 6.737l1.292 1.526L7 4.156V15z"></path>
                                </svg>
                            </span>
                        </a>
                    </div>
                </form>
            </section>
        </section>
    </template>
</odoo>
