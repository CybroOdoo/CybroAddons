<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="theme_modern_portfolio_snippet_groups" inherit_id="website.snippets" name="Modern Portfolio Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/hero_block.jpg"
               string="Portfolio Sections"
               snippet-group="portfolio_sections"/>
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/hero_block.jpg"
               string="Project Sections"
               snippet-group="project_sections"/>
        </xpath>
    </template>
</odoo>
