<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="project_layout" name="Project Layout">
        <section class="s_project_layout cmpad py-5">
            <div class="row">
                <div class="col-md-5">
                    <div class="photo-wrapper" style="position: sticky; top: 5rem">
                        <img class="js_project_layout_image" src="/theme_modern_portfolio/static/src/images/portfolio/8.jpg" alt="Mark" style="border-radius: 10px"/>
                    </div>
                </div>

                <div class="col-md-7 pt-3 d-flex align-items-center">
                    <div class="content">
                        <div class="badge mb-3">Project Overview</div>
                        <h1 class="inhead js_project_layout_name">
                            Project Name
                        </h1>
                        <p class="intro js_project_layout_description">
                            Project Description
                        </p>

                        <div class="features"/>

                        <!-- Call to action -->
                        <div class="mt-4 d-flex flex-wrap align-items-center gap-3">
                            <a href="/projects" class="bttn bttn2">View Other Projects
                                <span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                                        <path fill="currentColor"
                                              d="M9 15V4.156l4.854 4.107l1.292-1.526L8 .69L.854 6.737l1.292 1.526L7 4.156V15z"/>
                                    </svg>
                                </span>
                            </a>
                            <span class="feature-text mb-0">
                                Interested in something similar?
                                <a href="/contactus">Let’s talk about your project.</a>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>