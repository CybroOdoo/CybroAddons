<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="project_steps" name="Project Steps">
        <div class="o_snippet_drop_in_only row g-3 mt-4">
            <div class="col-md-4">
                <div class="border rounded-4 p-3 h-100">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge rounded-pill text-uppercase me-2 mb-0">01</span>
                        <span class="small text-muted d-flex align-items-center process-step-label">
                            Discover
                        </span>
                    </div>
                    <p class="feature-text mb-0">
                        Understand goals, audience, and constraints to define a
                        clear project direction.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded-4 p-3 h-100">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge rounded-pill text-uppercase me-2 mb-0">02</span>
                        <span class="small text-muted d-flex align-items-center process-step-label">
                            Design &amp; Build
                        </span>
                    </div>
                    <p class="feature-text mb-0">
                        Translate ideas into wireframes, polished UI, and
                        accessible, performant code.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded-4 p-3 h-100">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge rounded-pill text-uppercase me-2 mb-0">03</span>
                        <span class="small text-muted d-flex align-items-center process-step-label">

                            Launch &amp; Iterate
                        </span>
                    </div>
                    <p class="feature-text mb-0">
                        Ship, monitor, and refine based on analytics and real user
                        feedback.
                    </p>
                </div>
            </div>
        </div>
    </template>
</odoo>