<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="modern_portfolio_snippets_content" inherit_id="website.snippets" name="Modern Portfolio Snippets">
        <xpath expr="//snippets[@id='snippet_content']/*[last()]" position="after">
            <t t-snippet="theme_modern_portfolio.project_feature_content"
               string="Project Feature"/>
            <t t-snippet="theme_modern_portfolio.project_two_column"
               string="Project 2 Column"/>
            <t t-snippet="theme_modern_portfolio.project_three_column"
               string="Project 3 Column"/>
            <t t-snippet="theme_modern_portfolio.project_steps"
               string="Project Steps"/>
            <t t-snippet="theme_modern_portfolio.s_portfolio_tech_image"
               string="Technology Image"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_modern_portfolio.s_portfolio_hero"
               string="Hero Banner"
               group="portfolio_sections"
               t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/hero_block.jpg"/>
            
            <t t-snippet="theme_modern_portfolio.s_portfolio_welcome"
               string="Welcome Text"
               group="portfolio_sections"
               t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/welcome_block.jpg"/>
            
            <t t-snippet="theme_modern_portfolio.s_portfolio_stats"
               string="Stats Counter"
               group="portfolio_sections"
               t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/stats_block.jpg"/>
            
            <t t-snippet="theme_modern_portfolio.s_portfolio_grid"
               string="Portfolio Grid"
               group="portfolio_sections"
               t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/portfolio_grid_block.jpg"/>
            
            <t t-snippet="theme_modern_portfolio.s_portfolio_about"
               string="About Section"
               group="portfolio_sections"
               t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/about_block.jpg"/>
            
            <t t-snippet="theme_modern_portfolio.s_portfolio_features"
               string="Features Grid"
               group="portfolio_sections"
               t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/features_block.jpg"/>
            
            <t t-snippet="theme_modern_portfolio.s_portfolio_contact"
               string="Contact Form"
               group="portfolio_sections"
               t-thumbnail="/theme_modern_portfolio/static/src/images/snippets/contact_block.jpg"/>

            <t t-snippet="theme_modern_portfolio.s_portfolio_featured_project"
               string="Featured Projects"
               group="portfolio_sections"/>

            <t t-snippet="theme_modern_portfolio.s_portfolio_tech"
               string="Technologies"
               group="portfolio_sections"/>

            <t t-snippet="theme_modern_portfolio.project_layout"
               string="Project Layout"
               group="project_sections"/>
        </xpath>

    </template>
</odoo>
