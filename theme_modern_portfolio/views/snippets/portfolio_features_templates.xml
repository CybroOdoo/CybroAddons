<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Features/Services Grid Snippet -->
    <template id="s_portfolio_features" name="Features Grid">
        <section class="s_portfolio_features cmpad py-5">
            <section class="section">
                <span class="badge mx-sm-auto">Our Work Gallery</span>

                <div class="portfolio-header cen mt-4">
                    <h1 class="portfolio-title">Highlighted Creations</h1>
                    <p class="portfolio-desc">
                        Discover our diverse range of services, including custom web development and digital marketing strategies, all designed to elevate your brand.
                    </p>
                </div>

                <div class="grid">
                    <!-- Web Development -->
                    <div class="incard">
                        <div class="icon-wrap blue">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5b6af0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="16 18 22 12 16 6"/>
                                <polyline points="8 6 2 12 8 18"/>
                            </svg>
                        </div>
                        <h3>Web Development</h3>
                        <p>Creating visually appealing and user-friendly websites tailored to your brand. Transforming your vision into developed and functioning amazing products.</p>
                    </div>

                    <!-- E-Commerce Development -->
                    <div class="incard">
                        <div class="icon-wrap purple">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9b5de5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1"/>
                                <circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                            </svg>
                        </div>
                        <h3>E-Commerce Development</h3>
                        <p>Building powerful online stores that drive sales. Professional e-commerce solutions to help you grow your business online.</p>
                    </div>

                    <!-- Website Design -->
                    <div class="incard">
                        <div class="icon-wrap pink">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e05aa0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72m2.54-15.38c-3.72 4.35-8.94 5.66-16.88 5.85m19.5 1.9c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"/>
                            </svg>
                        </div>
                        <h3>Website Design</h3>
                        <p>Crafting beautiful, user-centered designs that capture your brand essence and engage your audience effectively.</p>
                    </div>

                    <!-- Custom Web Development -->
                    <div class="incard">
                        <div class="icon-wrap orange">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ff6b35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="3" width="20" height="14" rx="2"/>
                                <line x1="8" y1="21" x2="16" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                            </svg>
                        </div>
                        <h3>Custom Web Development</h3>
                        <p>Tailored solutions built from scratch. Every line of code crafted specifically for your unique project requirements.</p>
                    </div>

                    <!-- Frontend Management System -->
                    <div class="incard">
                        <div class="icon-wrap green">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                            </svg>
                        </div>
                        <h3>Frontend Management System</h3>
                        <p>Custom management solutions with easily customizable structures that make your digital organization efficient and powerful.</p>
                    </div>

                    <!-- Web App Development -->
                    <div class="incard">
                        <div class="icon-wrap indigo">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                <path d="M2 17l10 5 10-5"/>
                                <path d="M2 12l10 5 10-5"/>
                            </svg>
                        </div>
                        <h3>Web App Development</h3>
                        <p>Creating beautiful web applications and platforms that integrate seamlessly and lead you to success.</p>
                    </div>
                </div>
            </section>
        </section>
    </template>
</odoo>
