<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Portfolio Grid Snippet with Tabs -->
    <template id="s_portfolio_grid" name="Portfolio Grid">
        <section class="s_portfolio_grid cmpad py-5">
            <div class="portfolio-section">
                <div class="portfolio-header">
                    <h1 class="portfolio-title">Portfolio</h1>
                    <p class="portfolio-desc">
                        A modern eCommerce platform designed to deliver a smooth shopping experience with clean UI and design elements.
                    </p>
                </div>

                <!-- Bootstrap Nav Tabs -->
                <ul class="nav nav-tabs" id="portfolioTabs" role="tablist">
                    <li class="nav-item tab-all-item" role="presentation">
                        <button class="nav-link active filter-tab" data-filter="all" type="button" role="tab">All</button>
                    </li>
                    <!-- Dynamic tabs appended here -->
                </ul>

                <div class="portfolio-grid mt-4" id="portfolioGridContent">
                    <!-- Dynamic cards appended here -->
                </div>
            </div>
        </section>
    </template>
</odoo>
