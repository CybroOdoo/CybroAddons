<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- About Section Snippet -->
    <template id="s_portfolio_about" name="About Section">
        <section class="s_portfolio_about cmpad py-5">
            <div class="row">
                <div class="col-md-6 pb-5 pb-md-0">
                    <div class="photo-wrapper">
                        <img src="/theme_modern_portfolio/static/src/images/about/inabt.jpg" alt="About" class="img-fluid rounded-4"/>
                    </div>
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <div class="content">
                        <div class="badge">About</div>
                        <h1 class="inhead">
                            Turning ideas into<br/>
                            powerful web solutions.
                        </h1>
                        <p class="intro">
                            I'm a passionate Web Developer focused on building fast, scalable, and user-friendly digital experiences. I transform ideas into powerful web applications using modern technologies and clean, maintainable code.
                        </p>

                        <div class="features">
                            <div>
                                <div class="feature-title">Efficient</div>
                                <p class="feature-text">
                                    I develop optimized, high-performance websites that load quickly and run smoothly across all devices. Clean architecture and performance-first coding are always my priority.
                                </p>
                            </div>
                            <div>
                                <div class="feature-title">Professional</div>
                                <p class="feature-text">
                                    From planning to deployment, I maintain clear communication, structured workflows, and pixel-perfect execution to deliver professional results that meet business goals.
                                </p>
                            </div>
                            <div>
                                <div class="feature-title">Experienced</div>
                                <p class="feature-text">
                                    With hands-on experience in modern frameworks and full-stack development, I build responsive, secure, and scalable solutions tailored to client needs.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
