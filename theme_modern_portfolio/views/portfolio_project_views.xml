<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portfolio Project List View -->
    <record id="portfolio_project_view_tree" model="ir.ui.view">
        <field name="name">portfolio.project.view.tree</field>
        <field name="model">portfolio.project</field>
        <field name="arch" type="xml">
            <list string="Portfolio Projects" action="open_website_url" type="object">
                <field name="name"/>
                <field name="website_url"/>
                <field name="image_1920"/>
                <button name="action_open_form_view" type="object" string="Edit"/>
            </list>
        </field>
    </record>

    <!-- Portfolio Project Form View -->
    <record id="portfolio_project_view_form" model="ir.ui.view">
        <field name="name">portfolio.project.view.form</field>
        <field name="model">portfolio.project</field>
        <field name="arch" type="xml">
            <form string="Portfolio Project">
                <sheet>
                    <field
                        name="image_1920"
                        widget="image"
                        class="oe_avatar"
                        options="{'convert_to_webp': True, 'preview_image': 'image_128'}"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Title"/>
                        </h1>
                    </div>
                    <group>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Content" name="content_sections">
                            <field name="content"/>
                        </page>
                        <page string="Description" name="description_sections">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Portfolio Projects -->
    <record id="portfolio_project_action" model="ir.actions.act_window">
        <field name="name">Portfolio Projects</field>
        <field name="res_model">portfolio.project</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first portfolio project!
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="portfolio_project_menu_root"
              name="Portfolio"
              web_icon="theme_modern_portfolio,static/description/icon.png"
              sequence="10"/>

    <menuitem id="portfolio_project_menu_main"
              name="Projects"
              parent="portfolio_project_menu_root"
              action="portfolio_project_action"
              sequence="10"/>
</odoo>
