<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="project_detail_content" name="Project content">
        <t t-call="website.layout">
            <div class="cmpad js_portfolio_project">
                <input type="hidden" name="project_name" t-att-value="project.name"/>
                <input type="hidden" name="project_description" t-att-value="project.description"/>
                <input type="hidden" name="project_image" t-att-value="project.image_1920"/>
                <div class="banner inbanner">
                    <!-- breadcrumb -->
                    <nav aria-label="breadcrumb" class="breadcrumb-container">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/">Home</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                <t t-out="project.name"/>
                            </li>
                        </ol>
                    </nav>
                </div>

            </div>
            <t t-set="editor_message">WRITE HERE OR DRAG BUILDING BLOCKS</t>
            <div t-field="project.content"
                 t-att-data-editor-message="editor_message"
            />
        </t>
    </template>
</odoo>