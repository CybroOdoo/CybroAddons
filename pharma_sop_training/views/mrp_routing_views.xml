<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds the SOP link to the operation form. -->
    <record id="mrp_routing_workcenter_form_pharma" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form.pharma</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='description']" position="inside">
                <field name="allowed_sop_ids" invisible="1"/>
                <field name="sop_id" required="1" domain="[('id', 'in', allowed_sop_ids)]"/>
            </xpath>
        </field>
    </record>

    <!-- Adds the SOP column to the operation list. -->
    <record id="mrp_routing_workcenter_tree_pharma" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.tree.pharma</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="allowed_sop_ids" column_invisible="True"/>
                <field name="sop_id" optional="show" required="1" domain="[('id', 'in', allowed_sop_ids)]"/>
            </xpath>
        </field>
    </record>

    <!-- Adds the SOP column to the BoM operation list. -->
    <record id="mrp_routing_workcenter_bom_tree_pharma" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.bom.tree.pharma</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_bom_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="allowed_sop_ids" column_invisible="True"/>
                <field name="sop_id" optional="show" required="1" domain="[('id', 'in', allowed_sop_ids)]"/>
            </xpath>
        </field>
    </record>
</odoo>
