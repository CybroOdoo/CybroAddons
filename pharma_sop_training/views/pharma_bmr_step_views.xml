<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds SOP and training fields to the BMR step form. -->
    <record id="pharma_bmr_step_form_sop" model="ir.ui.view">
        <field name="name">pharma.bmr.step.form.sop</field>
        <field name="model">pharma.bmr.step</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_bmr_step_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="after">
                <field name="sop_id"/>
            </xpath>
        </field>
    </record>

    <!-- Adds SOP columns to the BMR step list. -->
    <record id="pharma_bmr_step_list_sop" model="ir.ui.view">
        <field name="name">pharma.bmr.step.list.sop</field>
        <field name="model">pharma.bmr.step</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_bmr_step_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='description']" position="after">
                <field name="sop_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
