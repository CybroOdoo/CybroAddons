<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily cron expiring training records. -->
        <record id="ir_cron_pharma_expire_trainings" model="ir.cron">
            <field name="name">Pharma: Expire Training Records</field>
            <field name="model_id" ref="model_pharma_training"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_trainings()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
