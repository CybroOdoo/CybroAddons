<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for SOP numbers. -->
    <record id="seq_pharma_sop" model="ir.sequence">
        <field name="name">Standard Operating Procedure</field>
        <field name="code">pharma.sop.sequence</field>
        <field name="prefix">SOP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
