<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inheriting the stock scrap move form -->
    <record id="view_scrap_move_form_inherit_company_scrap_management" model="ir.ui.view">
        <field name="name">stock.move.view.form.inherit.company.scrap.management</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_scrap_move_form"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="bill_of_material_id" invisible="not is_scrap"/>
                <field name="product_tmpl_id" invisible="1"/>
                <field name="state_management" invisible="1"/>
                <field name="typ_of_reuse" widget="radio"
                       invisible="not is_scrap or not bill_of_material_id"/>
            </field>
        </field>
    </record>
</odoo>
