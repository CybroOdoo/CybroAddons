<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Users can only access their own dashboard config -->
        <record id="dashboard_config_own_rule" model="ir.rule">
            <field name="name">Dashboard Config: Own Record Only</field>
            <field name="model_id" ref="model_account_dashboard_config"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_user'))]"/>
        </record>

        <!-- Managers can see all configs (for admin purposes) -->
        <record id="dashboard_config_manager_rule" model="ir.rule">
            <field name="name">Dashboard Config: Manager Full Access</field>
            <field name="model_id" ref="model_account_dashboard_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>
    </data>
</odoo>
