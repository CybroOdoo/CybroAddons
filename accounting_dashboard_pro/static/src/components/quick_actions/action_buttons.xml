<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="accounting_dashboard_pro.QuickActions">
        <div class="adp-quick-actions">
            <div class="adp-card-header">
                <h3><i class="oi" data-icon="flash_on"/> Quick Actions</h3>
            </div>
            <div class="adp-actions-grid">
                <!-- Billing Clerk & higher -->
                <t t-if="this.props.userGroups.is_invoicing">
                    <button class="adp-action-btn adp-action-blue" t-on-click="() => this.props.onAction('new_invoice')">
                        <i class="oi" data-icon="add_circle"/>
                        <span>New Invoice</span>
                    </button>
                    <button class="adp-action-btn adp-action-green" t-on-click="() => this.props.onAction('new_payment')">
                        <i class="oi" data-icon="payments"/>
                        <span>New Payment</span>
                    </button>
                </t>
                <!-- Jr. Accountant & higher -->
                <t t-if="this.props.userGroups.is_basic">
                    <button class="adp-action-btn adp-action-purple" t-on-click="() => this.props.onAction('reconciliation')">
                        <i class="oi" data-icon="check_circle"/>
                        <span>Reconcile Bank</span>
                    </button>
                    <button class="adp-action-btn adp-action-indigo" t-on-click="() => this.props.onAction('journal_entry')">
                        <i class="oi" data-icon="list_alt"/>
                        <span>New Journal Entry</span>
                    </button>
                </t>
                <!-- Accountant & higher -->
                <t t-if="this.props.userGroups.is_user">
                    <button class="adp-action-btn adp-action-blue" t-on-click="() => this.props.onAction('lock_date')">
                        <i class="oi" data-icon="lock"/>
                        <span>Lock Period</span>
                    </button>
                    <button class="adp-action-btn adp-action-green" t-on-click="() => this.props.onAction('generate_reports')">
                        <i class="oi" data-icon="description"/>
                        <span>Generate Reports</span>
                    </button>
                </t>
                <!-- CFO & higher -->
                <t t-if="this.props.userGroups.is_manager">
                    <button class="adp-action-btn adp-action-orange" t-on-click="() => this.props.onAction('configure_settings')">
                        <i class="oi" data-icon="settings"/>
                        <span>Configure Settings</span>
                    </button>
                    <button class="adp-action-btn adp-action-indigo" t-on-click="() => this.props.onAction('export_all_data')">
                        <i class="oi" data-icon="download"/>
                        <span>Export All Data</span>
                    </button>
                </t>
            </div>
        </div>
    </t>

    <t t-name="accounting_dashboard_pro.AlertsFeed">
        <div class="adp-alerts-feed">
            <div class="adp-card-header">
                <h3><i class="oi" data-icon="notifications"/> Smart Alerts</h3>
                <span class="adp-badge-info" t-if="this.props.alerts.length">
                    <t t-out="this.props.alerts.length"/>
                </span>
            </div>
            <div class="adp-alerts-list">
                <t t-if="!this.props.alerts.length">
                    <div class="adp-list-empty">
                        <i class="oi text-success" data-icon="check_circle" style="font-size:28px;display:block;margin-bottom:8px"/>
                        <span>All clear — no alerts!</span>
                    </div>
                </t>
                <t t-foreach="this.props.alerts" t-as="alert" t-key="alert_index">
                    <div t-att-class="'adp-alert-item adp-alert-' + alert.type" t-on-click="() => this.props.onAction(alert.action, true)">
                        <div class="adp-alert-icon">
                            <i class="oi" t-att-data-icon="alert.icon"/>
                        </div>
                        <div class="adp-alert-content">
                            <div class="adp-alert-title" t-out="alert.title"/>
                            <div class="adp-alert-subtitle" t-out="alert.subtitle"/>
                        </div>
                        <div class="adp-alert-arrow">
                            <i class="oi" data-icon="east"/>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
