<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="accounting_dashboard_pro.RevenueExpenseChart">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="show_chart" style="color:#10b981"/> Revenue vs Expenses</h3>
            </div>
            <div class="adp-chart-body">
                <canvas t-ref="this.canvasRef"/>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.CashflowForecast">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="area_chart" style="color:#3b82f6"/> Cash Flow Forecast (90 days)</h3>
            </div>
            <div class="adp-chart-body">
                <canvas t-ref="this.canvasRef"/>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.AgingChart">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="bar_chart" style="color:#f59e0b"/> Aging Analysis</h3>
            </div>
            <div class="adp-chart-body">
                <canvas t-ref="this.canvasRef"/>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.TopExpensesChart">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="pie_chart" style="color:#8b5cf6"/> Top Expenses</h3>
            </div>
            <div class="adp-chart-body" style="min-height:260px">
                <canvas t-ref="this.canvasRef"/>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.IncomeExpensePie">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="pie_chart" style="color:#ec4899"/> Income vs Expense</h3>
            </div>
            <div class="adp-chart-body" style="min-height:260px">
                <t t-if="!this.props.revenue and !this.props.expenses">
                    <div class="adp-chart-placeholder">
                        <i class="oi" data-icon="info"/>
                        <span>No income or expense data for this period</span>
                    </div>
                </t>
                <t t-else="">
                    <canvas t-ref="this.canvasRef"/>
                </t>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.ProfitTrendChart">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="show_chart" style="color:#818cf8"/> P&amp;L Trend (12 months)</h3>
            </div>
            <div class="adp-chart-body">
                <canvas t-ref="this.canvasRef"/>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.ExpenseBreakdownChart">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="pie_chart" style="color:#fb923c"/> Expense Breakdown</h3>
            </div>
            <div class="adp-chart-body" style="min-height:260px">
                <t t-if="!this.props.data or !this.props.data.labels or !this.props.data.labels.length">
                    <div class="adp-chart-placeholder">
                        <i class="oi" data-icon="info"/>
                        <span>No expense data for this period</span>
                    </div>
                </t>
                <t t-else="">
                    <canvas t-ref="this.canvasRef"/>
                </t>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.BudgetVsActualChart">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="bar_chart" style="color:#22c55e"/> Budget vs Actual</h3>
            </div>
            <div class="adp-chart-body">
                <t t-if="this.props.data and this.props.data.available === false">
                    <div class="adp-chart-placeholder">
                        <i class="oi" data-icon="info"/>
                        <span>Budget module not installed</span>
                    </div>
                </t>
                <t t-elif="this.props.data and this.props.data.labels and !this.props.data.labels.length">
                    <div class="adp-chart-placeholder">
                        <i class="oi" data-icon="info"/>
                        <span>No active budgets found</span>
                    </div>
                </t>
                <t t-else="">
                    <canvas t-ref="this.canvasRef"/>
                </t>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.MonthlyCashflowBars">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="swap_horiz" style="color:#38bdf8"/> Monthly Cash Inflow / Outflow</h3>
            </div>
            <div class="adp-chart-body">
                <canvas t-ref="this.canvasRef"/>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.CashflowWaterfallChart">
        <div class="adp-chart-card">
            <div class="adp-chart-header">
                <h3><i class="oi" data-icon="bar_chart" style="color:#0ea5e9"/> Cashflow Waterfall</h3>
            </div>
            <div class="adp-chart-body">
                <t t-if="!this.props.data or !this.props.data.labels or !this.props.data.labels.length">
                    <div class="adp-chart-placeholder">
                        <i class="oi" data-icon="info"/>
                        <span>No cashflow data for this period</span>
                    </div>
                </t>
                <t t-else="">
                    <canvas t-ref="this.canvasRef"/>
                </t>
            </div>
        </div>
    </t>
    <t t-name="accounting_dashboard_pro.JournalBalanceChart">
        <div class="adp-chart-card adp-journal-chart">
            <!-- Journal selector tabs -->
            <div class="adp-journal-tabs">
                <t t-foreach="this.props.journals" t-as="j" t-key="j.journal_id">
                    <button t-att-class="'adp-journal-tab ' + (j_index === this.state.selectedIndex ? 'active' : '') + ' ' + j.journal_type"
                            t-on-click="() => this.selectJournal(j_index)">
                        <i class="oi" t-att-data-icon="j.journal_type === 'bank' ? 'account_balance' : 'payments'"/>
                        <t t-out="j.journal_name"/>
                    </button>
                </t>
            </div>
            <!-- Selected journal header -->
            <div class="adp-chart-header" t-if="this.selectedJournal">
                <h3>
                    <i class="oi"
                       t-att-data-icon="this.selectedJournal.journal_type === 'bank' ? 'account_balance' : 'payments'"
                       t-att-style="'color:' + (this.selectedJournal.journal_type === 'bank' ? '#0ea5e9' : '#22c55e')"/>
                    <t t-out="this.selectedJournal.journal_name"/>
                    <span class="adp-journal-badge" t-att-class="this.selectedJournal.journal_type">
                        <t t-out="this.selectedJournal.journal_type === 'bank' ? 'Bank' : 'Cash'"/>
                    </span>
                </h3>
                <div class="adp-journal-balance">
                    <span class="label">Current Balance:</span>
                    <span class="value" t-out="this.props.formatCurrency(this.selectedJournal.current_balance)"/>
                </div>
            </div>
            <div class="adp-chart-body">
                <canvas t-ref="this.canvasRef"/>
            </div>
        </div>
    </t>
</templates>
