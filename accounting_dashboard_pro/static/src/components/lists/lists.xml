<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="accounting_dashboard_pro.OverdueInvoices">
        <div class="adp-list-card list-overdue">
            <div class="adp-list-header">
                <div class="adp-list-title">
                    <i class="oi" data-icon="warning"/>
                    Overdue Invoices
                </div>
                <span class="adp-list-badge" t-if="this.props.data.length" t-out="this.props.data.length"/>
            </div>
            <div class="adp-list-body">
                <t t-if="!this.props.data.length">
                    <div class="adp-list-empty">
                        <i class="oi" data-icon="check_circle" style="color:#34d399;font-size:22px;display:block;margin-bottom:6px"/>
                        No overdue invoices!
                    </div>
                </t>
                <t t-foreach="this.props.data" t-as="item" t-key="item.id">
                    <div class="adp-list-item" t-on-click="() => this.onClick(item.id)">
                        <div class="adp-list-item-info">
                            <div class="name" t-out="item.name"/>
                            <div class="partner" t-out="item.partner_name || 'N/A'"/>
                        </div>
                        <div class="adp-list-item-right">
                            <div class="amount" t-out="this.props.formatCurrency(item.amount)"/>
                            <div class="badge badge-danger">
                                <t t-out="item.days_overdue"/> days
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <t t-name="accounting_dashboard_pro.UpcomingBills">
        <div class="adp-list-card list-bills">
            <div class="adp-list-header">
                <div class="adp-list-title">
                    <i class="oi" data-icon="calendar_today"/>
                    Upcoming Bills
                </div>
                <span class="adp-list-badge" t-if="this.props.data.length" t-out="this.props.data.length"/>
            </div>
            <div class="adp-list-body">
                <t t-if="!this.props.data.length">
                    <div class="adp-list-empty">
                        <i class="oi" data-icon="check_circle" style="color:#34d399;font-size:22px;display:block;margin-bottom:6px"/>
                        No upcoming bills
                    </div>
                </t>
                <t t-foreach="this.props.data" t-as="item" t-key="item.id">
                    <div class="adp-list-item" t-on-click="() => this.onClick(item.id)">
                        <div class="adp-list-item-info">
                            <div class="name" t-out="item.name"/>
                            <div class="partner" t-out="item.partner_name || 'N/A'"/>
                        </div>
                        <div class="adp-list-item-right">
                            <div class="amount" t-out="this.props.formatCurrency(item.amount)"/>
                            <div class="badge badge-warning">
                                <t t-if="item.days_until_due === 0">Due today</t>
                                <t t-elif="item.days_until_due === 1">in 1 day</t>
                                <t t-else="">in <t t-out="item.days_until_due"/> days</t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <t t-name="accounting_dashboard_pro.RecentPayments">
        <div class="adp-list-card list-payments">
            <div class="adp-list-header">
                <div class="adp-list-title">
                    <i class="oi" data-icon="credit_card"/>
                    Recent Payments
                </div>
            </div>
            <div class="adp-list-body">
                <t t-if="!this.props.data.length">
                    <div class="adp-list-empty">
                        <i class="oi" data-icon="info" style="font-size:22px;display:block;margin-bottom:6px"/>
                        No recent payments
                    </div>
                </t>
                <t t-foreach="this.props.data" t-as="item" t-key="(item.res_model || 'pay') + '_' + item.id">
                    <div class="adp-list-item" t-on-click="() => this.onClick(item)">
                        <div class="adp-list-item-info">
                            <div class="name" t-out="item.name"/>
                            <div class="partner" t-out="item.partner_name || 'N/A'"/>
                        </div>
                        <div class="adp-list-item-right">
                            <div t-att-class="'amount ' + (item.payment_type === 'inbound' ? 'text-success' : 'text-danger')">
                                <t t-if="item.payment_type === 'inbound'">+</t>
                                <t t-else="">-</t>
                                <t t-out="this.props.formatCurrency(item.amount)"/>
                            </div>
                            <div class="badge badge-info" t-out="item.journal_name"/>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
