<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Dashboard Client Action -->
    <record id="action_it_hardware_dashboard_client" model="ir.actions.client">
        <field name="name">IT Hardware Dashboard</field>
        <field name="tag">it_hardware_dashboard</field>
    </record>

    <!-- Sales Actions (Phase 2) -->
    <record id="quotations_7628fe83-e36f-41dd-b316-fa60893612aa"
            model="ir.actions.act_window" context="{'studio': True}">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="domain">[('state', 'in', ['draft', 'sent'])]</field>
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="orders_f095c64f-ed31-4f7e-906e-e16ef6578208"
            model="ir.actions.act_window" context="{'studio': True}">
        <field name="name">Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="domain">[('state', 'not in', ['draft', 'sent','cancel'])]</field>
        <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    </record>

    <record id="customers_3177ac71-7433-4b8b-9ff8-d19eb2a81f0d"
            model="ir.actions.act_window" context="{'studio': True}">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,activity</field>
    </record>

    <record id="action_sales_products" model="ir.actions.act_window" context="{'studio': True}">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="service_requests_43124b9e-b1cc-4e63-8c80-e19811fec507"
            model="ir.actions.act_window">
        <field name="name">Service Requests</field>
        <field name="res_model">project.task</field>
        <field name="domain">[]</field>
        <field name="context">{'studio': True}</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
    </record>

    <record id="action_repair_order" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Repairs</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
    </record>

    <record id="action_it_installations" model="ir.actions.act_window"
            context="{'default_x_service_type': 'installation', 'studio': True}">
        <field name="name">Installations</field>
        <field name="res_model">project.task</field>
        <field name="domain">[('x_service_type', '=', 'installation')]</field>
        <field name="view_mode">list,kanban,form,calendar</field>
    </record>


    <record id="action_service_contracts_amc" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Service Contracts / AMC</field>
        <field name="res_model">sale.order</field>
        <field name="domain">[('x_service_level', '!=', False)]</field>
        <field name="view_mode">list,form,kanban,pivot</field>
    </record>

    <!-- Inventory Actions (Phase 9) -->
    <record id="action_hardware_products" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Hardware Products</field>
        <field name="res_model">product.template</field>
        <field name="domain">[('x_is_hardware', '=', True)]</field>
        <field name="context">{'default_x_is_hardware': True, 'studio': True}</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_spare_parts_products" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Spare Parts</field>
        <field name="res_model">product.template</field>
        <field name="domain">[('x_is_spare_part', '=', True)]</field>
        <field name="context">{'default_x_is_spare_part': True, 'studio': True}</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_incoming_pickings" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Receipts</field>
        <field name="res_model">stock.picking</field>
        <field name="domain">[('picking_type_code', '=', 'incoming')]</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_outgoing_pickings" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="domain">[('picking_type_code', '=', 'outgoing')]</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_internal_pickings" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Internal Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="domain">[('picking_type_code', '=', 'internal')]</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- Reporting Actions (Phase 21) -->
    <record id="action_report_sales_analysis" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Sales Analysis</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">graph,pivot</field>
    </record>

    <record id="action_report_service_analysis" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Service Analysis</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">graph,pivot,cohort</field>
    </record>

    <record id="action_report_repair_analysis" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Repair Analysis</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">graph,pivot</field>
    </record>


    <record id="action_report_amc_analysis" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">AMC Analysis</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">graph,pivot</field>
    </record>

    <!-- Configuration Actions (Phase 3, 11, 16, 22) -->
    <record id="action_product_category" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Product Categories</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_helpdesk_team" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Helpdesk Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_stock_location" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Warehouses &amp; Locations</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- CRM Lead / Opportunity Action -->
    <record id="action_crm_lead_opportunity" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Pipeline &amp; Opportunities</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
    </record>

    <record id="action_it_hardware_settings" model="ir.actions.act_window"
            context="{'studio': True}">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
