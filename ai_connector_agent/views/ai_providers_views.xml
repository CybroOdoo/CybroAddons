<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="ai_providers_list" model="ir.ui.view">
        <field name="name">ai.providers.list.view</field>
        <field name="model">ai.providers</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="ai_providers_form" model="ir.ui.view">
        <field name="name">ai.providers.form.views</field>
        <field name="model">ai.providers</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_fetch_models" string="Fetch models" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="provider_image" widget="image" class="oe_avatar"
                           options="{'accept': 'image/*', 'size': [90, 90]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Gemini AI"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="api_key" password="True" placeholder="***********************"/>
                        </group>
                        <group>
                            <field name="api_base_url" placeholder="https://generativelanguage.googleapis.com"/>
                            <field name="fetch_model_endpoint" placeholder="v1beta/models"/>
                            <field name="ai_model_ids" widget="many2many_tags"
                                   options="{'no_create_edit': True,'no_create':True}"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="model_config_action" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">ai.providers</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="ai_connector_configuration_menu" name="Configuration" parent="ai_connector_menu_root"/>
    <menuitem id="model_config_menu" name="Configure model" action="model_config_action"
              parent="ai_connector_configuration_menu"/>
</odoo>