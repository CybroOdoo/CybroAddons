<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- AI Chat Session Record Rules -->
        <record id="ai_chat_session_user_rule" model="ir.rule">
            <field name="name">AI Chat Session: User can only access own sessions</field>
            <field name="model_id" ref="model_ai_chat_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="ai_chat_session_manager_rule" model="ir.rule">
            <field name="name">AI Chat Session: Manager can access all sessions</field>
            <field name="model_id" ref="model_ai_chat_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- AI Chat Message Record Rules -->
        <record id="ai_chat_message_user_rule" model="ir.rule">
            <field name="name">AI Chat Message: User can only access own session messages</field>
            <field name="model_id" ref="model_ai_chat_message"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="ai_chat_message_manager_rule" model="ir.rule">
            <field name="name">AI Chat Message: Manager can access all messages</field>
            <field name="model_id" ref="model_ai_chat_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
