<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="ai_connector_agent.ai_chatter_screen">
        <div class="ai_chatter_main">
            <div class="app-container">
                <button class="mobile-menu-toggle" id="mobileMenuToggle" t-on-click="toggleSidebar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3 6h18v2H3V6m0 5h18v2H3v-2m0 5h18v2H3v-2Z"/>
                    </svg>
                </button>

                <!-- Side Panel -->
                <div class="side-panel" t-att-class="state.sidebarOpen ? 'open' : ''" id="sidePanel">
                    <div class="panel-header">
                        <div class="logo">
                            <div class="logo-icon">🤖</div>
                            <div class="logo-text">AI Assistant</div>
                        </div>
                        <button class="new-chat-btn" t-on-click="newChat">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                            </svg>
                            New Chat
                        </button>
                    </div>

                    <div class="chat-history">
                        <!-- Today -->
                        <t t-if="state.sessions.today.length">
                            <div class="history-section">
                                <div class="section-title">Today</div>
                                <t t-foreach="state.sessions.today" t-as="s" t-key="s.id">
                                    <div t-att-class="'chat-item' + (state.activeSessionId === s.id ? ' active' : '')"
                                         t-on-click="() => this.loadSession(s)">
                                        <div class="chat-title" t-esc="s.name"/>
                                        <div class="chat-preview" t-esc="s.preview"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <!-- Yesterday -->
                        <t t-if="state.sessions.yesterday.length">
                            <div class="history-section">
                                <div class="section-title">Yesterday</div>
                                <t t-foreach="state.sessions.yesterday" t-as="s" t-key="s.id">
                                    <div t-att-class="'chat-item' + (state.activeSessionId === s.id ? ' active' : '')"
                                         t-on-click="() => this.loadSession(s)">
                                        <div class="chat-title" t-esc="s.name"/>
                                        <div class="chat-preview" t-esc="s.preview"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <!-- Last Week -->
                        <t t-if="state.sessions.last_week.length">
                            <div class="history-section">
                                <div class="section-title">Last Week</div>
                                <t t-foreach="state.sessions.last_week" t-as="s" t-key="s.id">
                                    <div t-att-class="'chat-item' + (state.activeSessionId === s.id ? ' active' : '')"
                                         t-on-click="() => this.loadSession(s)">
                                        <div class="chat-title" t-esc="s.name"/>
                                        <div class="chat-preview" t-esc="s.preview"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <!-- Older -->
                        <t t-if="state.sessions.older.length">
                            <div class="history-section">
                                <div class="section-title">Older</div>
                                <t t-foreach="state.sessions.older" t-as="s" t-key="s.id">
                                    <div t-att-class="'chat-item' + (state.activeSessionId === s.id ? ' active' : '')"
                                         t-on-click="() => this.loadSession(s)">
                                        <div class="chat-title" t-esc="s.name"/>
                                        <div class="chat-preview" t-esc="s.preview"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <!-- Empty state -->
                        <t t-if="!state.sessions.today.length and !state.sessions.yesterday.length and !state.sessions.last_week.length and !state.sessions.older.length">
                            <div style="padding: 20px; color: rgba(255,255,255,0.4); font-size: 13px; text-align: center;">
                                No chat history yet. Start a new conversation!
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Main Chat Area -->
                <div class="main-chat">
                    <div class="chat-header">
                        <div class="assistant-info">
                            <div class="assistant-avatar">🤖</div>
                            <div class="assistant-details">
                                <h3 t-esc="state.aiAgentName || 'AI Assistant'"/>
                                <p><span class="status-dot"/>Online</p>
                            </div>
                        </div>
                        <div class="header-actions">
                            <!-- Home button -->
                            <button class="header-btn" title="Home" t-on-click="goBack">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                                </svg>
                            </button>

                            <!-- Clear Chat button -->
                            <button class="header-btn" title="Clear Chat" t-on-click="clearChat">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                </svg>
                            </button>

                        </div>
                    </div>

                    <div class="messages-container" id="messagesContainer" t-ref="messagesContainer">
                        <t t-foreach="state.messages" t-as="message" t-key="message.id">
                            <div t-att-class="'message ' + message.type">
                                <div class="message-avatar">
                                    <t t-if="message.type === 'ai'">AI</t>
                                    <t t-else="">You</t>
                                </div>
                                <div class="message-content">
                                    <div class="message-bubble">
                                        <t t-if="message.type === 'ai'">
                                            <div t-out="formatMarkdown(message.content)" class="markdown-content ai-markdown"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="message.content"/>
                                        </t>
                                        <div t-if="message.attachments and message.attachments.length" class="message-attachments">
                                            <t t-foreach="message.attachments" t-as="attach" t-key="attach.id">
                                                <div class="message-attachment-item" t-on-click="() => this.openAttachment(attach)">
                                                    <img t-att-src="attach.url" t-att-alt="attach.name" loading="lazy"/>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="message-time">
                                        <t t-esc="formatTime(message.timestamp)"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="typing-indicator" t-if="state.isTyping" id="typingIndicator">
                        <div class="message-avatar"
                             style="background: linear-gradient(135deg, #714B67 0%, #8B5A7C 100%); color: white; box-shadow: 0 4px 16px rgba(113, 75, 103, 0.3);">
                            AI
                        </div>
                        <div class="typing-dots">
                            <div class="typing-dot"/>
                            <div class="typing-dot"/>
                            <div class="typing-dot"/>
                        </div>
                    </div>

                    <div class="input-container">
                        <div t-if="state.attachments.length" class="attachment-preview-container">
                            <t t-foreach="state.attachments" t-as="attach" t-key="attach.id || attach.name">
                                <div class="attachment-preview-item">
                                    <img t-att-src="attach.data" />
                                    <button class="remove-attachment" t-on-click="() => this.removeAttachment(attach)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </t>
                        </div>
                        <div class="input-wrapper">
                            <button class="attachment-btn" title="Attach Image" t-on-click="triggerFileInput">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.31 2.69 6 6 6s6-2.69 6-6V6h-1.5z"/>
                                </svg>
                            </button>
                            <input type="file" 
                                   t-ref="fileInput" 
                                   style="display: none;" 
                                   accept="image/*" 
                                   multiple="true" 
                                   t-on-change="onFileChange"/>
                            <textarea class="message-input"
                                      t-ref="messageInput"
                                      id="messageInput"
                                      placeholder="Type your message here..."
                                      rows="1"
                            />
                            <button class="send-button" id="sendButton" t-on-click="sendMessage">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
