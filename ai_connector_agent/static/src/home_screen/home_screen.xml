<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-name="ai_connector_agent.ai_chatter_home">
        <div class="ai_main_container">
            <div class="floating-elements"/>
            <div class="ai_container container">
                <div class="logo"></div>

                <h1>AI Chat Connector</h1>
                <p class="subtitle">Connect with intelligent AI assistants for seamless conversations</p>

                <div class="welcome-text">
                    <h3>👋 Welcome!</h3>
                    <p>Configure your AI chat settings below and start engaging with our advanced AI system. Choose your
                        preferred model and language to get started.
                    </p>
                </div>

                <form>
                    <div class="form-group">
                        <label for="ai-agents">AI Agents</label>
                        <select id="ai-agents" name="ai-agents" t-model="state.selectedAgent">
                            <option value="">Select AI Agent</option>
                            <t t-if='state.aiAgents'>
                                <t t-foreach="state.aiAgents" t-as="aiAgent" t-key="aiAgent_index">
                                    <option t-att-value="aiAgent.id">
                                        <t t-esc="aiAgent.name"/>
                                    </option>
                                </t>
                            </t>
                        </select>
                    </div>

                    <div class="form-group" t-if="state.selectedAgent">
                        <label for="ai-model">Model</label>
                        <select id="ai-model" name="ai-model" t-model="state.selectedModel">
                            <option value="">Select Model</option>
                            <t t-foreach="state.aiModels" t-as="aiModel" t-key="aiModel_index">
                                <option t-att-value="aiModel.id">
                                    <t t-esc="aiModel.modelId"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <button t-if="state.selectedAgent" type="button" class="start-btn" t-on-click="startChat">
                        Start Chat
                    </button>

                </form>


            </div>
        </div>
    </t>

</templates>

