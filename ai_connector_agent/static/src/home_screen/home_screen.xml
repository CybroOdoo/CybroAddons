<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-name="ai_connector_agent.ai_chatter_home">
        <div class="ai_main_container">
            <div class="floating-elements"/>
            <div class="ai_container container">
                <div class="logo"></div>

                <h1>AI Agent Connector</h1>
                <p class="subtitle">Connect with intelligent AI assistants for seamless conversations</p>

                <div class="welcome-text">
                    <h3>👋 Welcome!</h3>
                    <p>Configure your AI chat settings below and start engaging with our advanced AI system.
                        Choose your preferred provider and model to get started.
                    </p>
                </div>

                <form>
                    <div class="form-group">
                        <label for="ai-agents">AI Agents</label>
                        <select id="ai-agents" name="ai-agents" t-model.proxy="this.state.selectedAgent">
                            <option value="">Select AI Agent</option>
                            <t t-if='this.state.aiAgents'>
                                <t t-foreach="this.state.aiAgents" t-as="aiAgent" t-key="aiAgent_index">
                                    <option t-att-value="aiAgent.id">
                                        <t t-esc="aiAgent.name"/>
                                    </option>
                                </t>
                            </t>
                        </select>
                    </div>

                    <div class="form-group" t-if="this.state.selectedAgent">
                        <label for="ai-model">Model</label>
                        <select id="ai-model" name="ai-model" t-model.proxy="this.state.selectedModel">
                            <option value="">Select Model</option>
                            <t t-foreach="this.state.aiModels" t-as="aiModel" t-key="aiModel_index">
                                <option t-att-value="aiModel.id">
                                    <t t-esc="aiModel.model_ref_id"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <button t-if="this.state.selectedAgent" type="button" class="start-btn" t-on-click="this.startChat">
                        Start Chat
                    </button>

                </form>


            </div>
        </div>
    </t>

</templates>
