        <div class="o_systray_item d-flex align-items-center" t-on-click="toggleChat" style="cursor: pointer; padding: 0 10px;">
            <a class="dropdown-toggle o-no-caret d-flex align-items-center gap-1" href="#" role="button" t-att-aria-expanded="state.isOpen ? 'true' : 'false'">
                <i class="fa fa-lg fa-robot" role="img" aria-label="AI Chat" style="color: #714B67;"/>
