<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Main Builder Template -->
    <t t-name="api_workflow_builder.WorkflowBuilder" owl="1">
        <div class="workflow-builder-container">

            <!-- 1. LEFT PANEL (Node Library) -->
            <!-- Toggle class 'closed' if state.leftPanelOpen is false -->
            <!-- 1. LEFT PANEL (Node Library) -->
            <div class="node-library"
                 t-att-class="{'closed': !state.leftPanelOpen}"
                 t-attf-style="width: {{ state.leftPanelWidth }}px; flex-shrink: 0;">

                <div class="library-header">
                    <div class="library-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill="currentColor" d="M5.33 3.272a3.5 3.5 0 0 1 4.472 4.473L20.647 18.59l-2.122 2.122L7.68 9.867a3.5 3.5 0 0 1-4.472-4.474L5.444 7.63a1.5 1.5 0 0 0 2.121-2.121zm10.367 1.883l3.182-1.768l1.414 1.415l-1.768 3.182l-1.768.353l-2.12 2.121l-1.415-1.414l2.121-2.121zm-7.071 7.778l2.121 2.122l-4.95 4.95A1.5 1.5 0 0 1 3.58 17.99l.097-.107z"/></svg>
                        Actions
                        <span class="float-end cursor-pointer d-md-none" t-on-click="toggleLeftPanel">×</span>
                    </div>
                </div>

               <!-- CATEGORY 1: API SETUP -->
                <div class="node-category">
                    <div class="category-title">
                       API Setup
                    </div>

                    <!-- 1. Endpoint Node -->
                    <div class="node-template" draggable="true" data-type="endpoint" t-on-dragstart="onDragStart">
                        <div class="node-template-header">
                            <span class="node-template-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9 9 0 1 0 0-18a9 9 0 0 0 0 18m0 0c2.761 0 3.941-5.163 3.941-9S14.761 3 12 3m0 18c-2.761 0-3.941-5.163-3.941-9S9.239 3 12 3M3.5 9h17m-17 6h17"/></svg>
                            </span>
                            <span class="node-template-name">API Endpoint</span>
                        </div>
                    </div>

                    <!-- 2. Auth Node -->
                    <div class="node-template" draggable="true" data-type="auth" t-on-dragstart="onDragStart">
                        <div class="node-template-header">
                            <span class="node-template-icon">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
</svg>                            </span>
                            <span class="node-template-name">Authentication</span>
                        </div>
                    </div>
                </div>

                <!-- CATEGORY 2: HTTP METHODS -->
                <div class="node-category">
                    <div class="category-title">
                        HTTP Methods
                    </div>

                    <!-- 1. GET (Retrieve) -->
                    <div class="node-template" draggable="true" data-type="get" t-on-dragstart="onDragStart">
                        <div class="node-template-header">
                            <span class="node-template-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="30" viewBox="0 0 24 24"><path fill="currentColor" d="M11 14.17L8.41 11.6L7 13l5 5l5-5l-1.41-1.42L13 14.17V5h-2v9.17M19 19H5v-2h14v2Z"/></svg>
                            </span>
                            <span class="node-template-name">GET Request</span>
                        </div>
                    </div>

                    <!-- 2. POST (Send) -->
                    <div class="node-template" draggable="true" data-type="post" t-on-dragstart="onDragStart">
                        <div class="node-template-header">
                            <span class="node-template-icon">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="m22 2-7 20-4-9-9-4Z"/>
    <path d="M22 2 11 13"/>
</svg>                            </span>
                            <span class="node-template-name">POST Request</span>
                        </div>
                    </div>

                    <!-- 3. PUT (Update) -->
                    <div class="node-template" draggable="true" data-type="put" t-on-dragstart="onDragStart">
                        <div class="node-template-header">
                            <span class="node-template-icon">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
    <polyline points="17 8 12 3 7 8"/>
    <line x1="12" x2="12" y1="3" y2="15"/>
</svg>                            </span>
                            <span class="node-template-name">PUT Request</span>
                        </div>
                    </div>

                    <!-- 4. DELETE (Remove) -->
                    <div class="node-template" draggable="true" data-type="delete" t-on-dragstart="onDragStart">
                        <div class="node-template-header">
                            <span class="node-template-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19 4h-3.5l-1-1h-5l-1 1H5v2h14M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12Z"/></svg>
                            </span>
                            <span class="node-template-name">DELETE Request</span>
                        </div>
                    </div>
                </div>

                <!-- CATEGORY 3: LOGIC & DATA -->
                <div class="node-category">
                    <div class="category-title">
                      Logic &amp; Data
                    </div>

                    <!-- Condition -->
                    <div class="node-template" draggable="true" data-type="condition" t-on-dragstart="onDragStart">
                        <div class="node-template-header">
                             <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill="currentColor" d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10s-4.477 10-10 10m0-2a8 8 0 1 0 0-16a8 8 0 0 0 0 16m-1-5h2v2h-2zm2-1.645V14h-2v-1.5a1 1 0 0 1 1-1a1.5 1.5 0 1 0-1.471-1.794l-1.962-.393A3.501 3.501 0 1 1 13 13.355"/></svg>
                             <span class="node-template-name">Condition</span>
                        </div>
<!--                        <div class="node-template-desc">If/Else Branching</div>-->
                    </div>

                    <!-- Loop -->
                    <div class="node-template" draggable="true" data-type="loop" t-on-dragstart="onDragStart">
                        <div class="node-template-header">
                             <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill="currentColor" d="M22 7.73a6 6 0 0 0-6.85-1.18a5.84 5.84 0 0 0-2.29 2L9.09 14a3.5 3.5 0 0 1-1.31 1.2a3.53 3.53 0 1 1 1-5.69a1.25 1.25 0 0 0 1.77-1.77A6 6 0 0 0 .26 12a6 6 0 0 0 6 6a6.1 6.1 0 0 0 2.58-.58a5.9 5.9 0 0 0 2.29-2L14.91 10a3.4 3.4 0 0 1 1.31-1.2a3.53 3.53 0 1 1-1 5.69a1.25 1.25 0 0 0-1.77 1.76A6 6 0 0 0 22 7.73"/></svg>
                             <span class="node-template-name">Loop</span>
                        </div>
<!--                        <div class="node-template-desc">Iterate over Lists</div>-->
                    </div>

                    <!-- ORM -->
                    <div class="node-template" draggable="true" data-type="orm" t-on-dragstart="onDragStart">
                        <div class="node-template-header">
                            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill="currentColor" d="M12 16c1.1 0 2 .9 2 2s-.9 2-2 2s-2-.9-2-2s.9-2 2-2m0-12c1.1 0 2 .9 2 2s-.9 2-2 2s-2-.9-2-2s.9-2 2-2M6 16c1.1 0 2 .9 2 2s-.9 2-2 2s-2-.9-2-2s.9-2 2-2m0-6c1.1 0 2 .9 2 2s-.9 2-2 2s-2-.9-2-2s.9-2 2-2m0-6c1.1 0 2 .9 2 2s-.9 2-2 2s-2-.9-2-2s.9-2 2-2m12 12c1.1 0 2 .9 2 2s-.9 2-2 2s-2-.9-2-2s.9-2 2-2m0-6c1.1 0 2 .9 2 2s-.9 2-2 2s-2-.9-2-2s.9-2 2-2m0-6c1.1 0 2 .9 2 2s-.9 2-2 2s-2-.9-2-2s.9-2 2-2"/></svg>
                             <span class="node-template-name">ORM Action</span>
                        </div>
<!--                        <div class="node-template-desc">Create, Search, Write</div>-->
                    </div>
                </div>

            </div>

            <!-- Resizer (Hidden if closed) -->
            <div class="resizer" t-if="state.leftPanelOpen" t-on-mousedown="(ev) => this.startResize('left', ev)"></div>


            <!-- 2. CENTER PANEL (Canvas) -->
            <div class="canvas-container" style="position: relative; overflow: hidden; display: flex; flex-direction: column; flex-grow: 1;">

                <!-- 🆕 FLOATING TOGGLE BUTTONS -->
                <button class="panel-toggle-btn left-toggle"
                        t-on-click="toggleLeftPanel"
                        t-att-title="state.leftPanelOpen ? 'Close Library' : 'Open Library'">
                    <i t-attf-class="fa {{state.leftPanelOpen ? 'fa-chevron-left' : 'fa-chevron-right'}}"></i>
                </button>

                <button class="panel-toggle-btn right-toggle"
                        t-on-click="toggleRightPanel"
                        t-att-title="state.rightPanelOpen ? 'Close Config' : 'Open Config'">
                    <i t-attf-class="fa {{state.rightPanelOpen ? 'fa-chevron-right' : 'fa-chevron-left'}}"></i>
                </button>
                <!-- ============================ -->
 <div class="workflow-controls">
<!--                        <div class="vr mx-2 bg-secondary" style="opacity: 0.5;"></div>-->
                        <!-- Clear -->
                        <button class="control-btn" t-on-click="clearWorkflowCanvas" title="Clear Canvas">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M7 21q-.825 0-1.412-.587T5 19V6q-.425 0-.712-.288T4 5t.288-.712T5 4h4q0-.425.288-.712T10 3h4q.425 0 .713.288T15 4h4q.425 0 .713.288T20 5t-.288.713T19 6v13q0 .825-.587 1.413T17 21zM17 6H7v13h10zm-6.287 10.713Q11 16.425 11 16V9q0-.425-.288-.712T10 8t-.712.288T9 9v7q0 .425.288.713T10 17t.713-.288m4 0Q15 16.426 15 16V9q0-.425-.288-.712T14 8t-.712.288T13 9v7q0 .425.288.713T14 17t.713-.288M7 6v13z"/></svg>
                        </button>

                        <!-- Execution -->
                        <button class="control-btn" t-on-click="testWorkflow" title="Test Workflow">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="m13.293 2.707l.818.818L3.318 14.318C2.468 15.168 2 16.298 2 17.5s.468 2.332 1.318 3.183C4.169 21.532 5.299 22 6.5 22s2.331-.468 3.182-1.318L20.475 9.889l.818.818l1.414-1.414l-8-8zm3.182 8.354l-2.403-2.404l-1.414 1.414l2.403 2.404l-1.414 1.415l-.99-.99l-1.414 1.414l.99.99l-1.415 1.415l-2.403-2.404L7 15.728l2.403 2.404l-1.136 1.136c-.945.944-2.59.944-3.535 0C4.26 18.795 4 18.168 4 17.5s.26-1.295.732-1.768L15.525 4.939l3.535 3.535z"/></svg>
                        </button>


                        <button class="control-btn" t-on-click="exportWorkflow" title="Export to JSON">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="m12 14l-.707.707l.707.707l.707-.707zm1-9a1 1 0 1 0-2 0zM6.293 9.707l5 5l1.414-1.414l-5-5zm6.414 5l5-5l-1.414-1.414l-5 5zM13 14V5h-2v9z"/><path stroke="currentColor" stroke-width="2" d="M5 16v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1"/></g></svg>
                        </button>

                        <label class="control-btn" style="cursor: pointer; margin-bottom: 0;" title="Import from JSON">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="m12 5l-.707-.707l.707-.707l.707.707zm1 9a1 1 0 1 1-2 0zM6.293 9.293l5-5l1.414 1.414l-5 5zm6.414-5l5 5l-1.414 1.414l-5-5zM13 5v9h-2V5z"/><path stroke="currentColor" stroke-width="2" d="M5 16v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1"/></g></svg>
                            <!-- Hidden input for file selection -->
                            <input type="file" accept=".json" style="display: none;" t-on-change="importWorkflow"/>
                        </label>
                        <!-- ========================== -->

     <!-- Save -->
     <button class="control-btn" t-on-click="saveWorkflow" title="Save to Odoo">
         <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
             <path fill="currentColor"
                   d="M21 7v12q0 .825-.587 1.413T19 21H5q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h12zm-6.875 10.125Q15 16.25 15 15t-.875-2.125T12 12t-2.125.875T9 15t.875 2.125T12 18t2.125-.875M6 10h9V6H6z"/>
         </svg>
     </button>
     <button class="control-btn" t-on-click="openSettings" title="Automation and Triggers">
         <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32">
             <path fill="currentColor"
                   d="M16 27c-3.6 0-7.1-1.8-9.2-5H12v-2H4v8h2v-3.7c2.5 3 6.1 4.7 10 4.7zm15-4v-2h-2.1c-.1-.6-.4-1.2-.7-1.8l1.5-1.5l-1.4-1.4l-1.5 1.5c-.5-.3-1.1-.6-1.8-.7V15h-2v2.1c-.6.1-1.2.4-1.8.7l-1.5-1.5l-1.4 1.4l1.5 1.5c-.3.5-.6 1.1-.7 1.8H17v2h2.1c.1.6.4 1.2.7 1.8l-1.5 1.5l1.4 1.4l1.5-1.5c.5.3 1.1.6 1.8.7V29h2v-2.1c.6-.1 1.2-.4 1.8-.7l1.5 1.5l1.4-1.4l-1.5-1.5c.3-.5.6-1.1.7-1.8zm-7 2c-1.7 0-3-1.3-3-3s1.3-3 3-3s3 1.3 3 3s-1.3 3-3 3m-4-15h5.2C21.9 4.9 15.1 3.5 10 6.8c-3.1 2-5 5.5-5 9.2H3C3 8.8 8.8 3 16 3c3.9 0 7.5 1.7 10 4.7V4h2v8h-8z"/>
         </svg>

     </button>


     <button class="control-btn bttn-suc" t-on-click="runWorkflowReal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.906 4.537A.6.6 0 0 0 6 5.053v13.894a.6.6 0 0 0 .906.516l11.723-6.947a.6.6 0 0 0 0-1.032z"/></svg>
                            Run Once
                        </button>
                    </div>


                <!-- Scroll Wrapper -->
                <div class="canvas-scroll-wrapper" t-ref="canvasWrapper"
                     style="flex-grow: 1; overflow: auto; background-color: #ECECEC; cursor: grab;"
                     t-on-mousedown="onCanvasMouseDown"
                     t-on-mousemove="onCanvasMouseMove"
                     t-on-mouseup="onCanvasMouseUp">



                    <!-- Scalable Canvas -->
                    <div class="canvas" t-ref="canvas"
                         t-attf-style="transform: scale({{ state.zoomLevel }}); transform-origin: 0 0; width: {{ 100 / state.zoomLevel }}%; height: {{ 100 / state.zoomLevel }}%; min-width: 2000px; min-height: 2000px;"
                         t-on-drop="onDrop"
                         t-on-dragover="onDragOver"
                         t-on-click="deselectAllNodes">

                         <!-- Nodes rendered here -->
                    </div>
                </div>

                <!-- Zoom Controls -->
                <div class="zoom-controls">
                     <button class="" t-on-click="undo" title="Undo (Ctrl+Z)">
                         <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M7.18 4L8.6 5.44L6.06 8h9.71a6 6 0 0 1 0 12h-2v-2h2a4 4 0 0 0 0-8H6.06l2.54 2.51l-1.42 1.41L2.23 9Z"/></svg>
                     </button>
                     <button class="" t-on-click="redo" title="Redo (Ctrl+Y)">
                            <svg style="transform: rotateY(180deg);" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M7.18 4L8.6 5.44L6.06 8h9.71a6 6 0 0 1 0 12h-2v-2h2a4 4 0 0 0 0-8H6.06l2.54 2.51l-1.42 1.41L2.23 9Z"/></svg>
                     </button>
                    <button class="first" t-on-click="zoomOut">-</button>
                    <span><t t-esc="Math.round(state.zoomLevel * 100) + '%'"/></span>
                    <button class="" t-on-click="zoomIn">+</button>
                </div>
            </div>

            <!-- Resizer -->
            <div class="resizer" t-if="state.rightPanelOpen" t-on-mousedown="(ev) => this.startResize('right', ev)"></div>


            <!-- 3. RIGHT PANEL (Configuration) -->
            <div class="config-panel"
                 t-ref="config-panel"
                 t-att-class="{'closed': !state.rightPanelOpen}"
                 t-attf-style="width: {{ state.rightPanelWidth }}px; flex-shrink: 0;">
                <t t-call="api_workflow_builder.WorkflowBuilderConfig"/>
            </div>

        </div>
    </t>



</odoo>