<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Menus of the Aquere navigation: Our Story, Our Water, Our Process, Our
    Planet and Contact, after the Home entry of the website.
-->
<odoo>
    <record id="menu_story" model="theme.website.menu">
        <field name="name">Our Story</field>
        <field name="url">/our-story</field>
        <field name="page_id" ref="story_page_page"/>
        <field name="sequence" type="int">15</field>
    </record>
    <record id="menu_water" model="theme.website.menu">
        <field name="name">Our Water</field>
        <field name="url">/our-water</field>
        <field name="page_id" ref="water_page_page"/>
        <field name="sequence" type="int">20</field>
    </record>
    <record id="menu_process" model="theme.website.menu">
        <field name="name">Our Process</field>
        <field name="url">/our-process</field>
        <field name="page_id" ref="process_page_page"/>
        <field name="sequence" type="int">25</field>
    </record>
    <record id="menu_planet" model="theme.website.menu">
        <field name="name">Our Planet</field>
        <field name="url">/our-planet</field>
        <field name="page_id" ref="planet_page_page"/>
        <field name="sequence" type="int">30</field>
    </record>
    <record id="menu_contact" model="theme.website.menu">
        <field name="name">Contact</field>
        <field name="url">/contact</field>
        <field name="page_id" ref="contact_page_page"/>
        <field name="sequence" type="int">35</field>
    </record>
</odoo>
