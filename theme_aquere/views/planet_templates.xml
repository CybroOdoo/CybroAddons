<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Our Planet page of the Aquere theme, built from editable sections.
-->
<odoo>
    <template id="planet_page" name="Our Planet">
        <t t-call="website.layout">
            <t t-set="additional_title">Our Planet</t>
            <t t-set="pageName" t-valuef="aquere_planet"/>
            <div id="wrap" class="oe_structure oe_empty aq-page-planet">
                <section class="aq-planet-hero s_aquere_planet_hero" data-snippet="s_aquere_planet_hero" data-name="Planet Hero">
                    <div class="aq-planet-hero-bg" aria-hidden="true">
                        <img src="/theme_aquere/static/src/img/photos/pexels-5326922-1600.jpg" alt=""/>
                    </div>
                    <div class="aq-container aq-planet-hero-inner">
                        <nav class="aq-crumbs aq-crumbs--light aq-reveal" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <i class="aq-icon aq-i-ph-caret-right-light" role="img" aria-hidden="true"/>
                            <span aria-current="page">Our Planet</span>
                        </nav>
                        <h1 class="aq-planet-title aq-reveal" data-delay="1">A Better Future,<br/><em>One Drop at a Time.</em></h1>
                        <p class="aq-planet-lead aq-reveal" data-delay="2">
          Clean water is one of the most precious resources we share. Producing it responsibly is part of
          everything we do, from how we purify to how every bottle is made.
        </p>
                        <a href="#pillars" class="aq-planet-scroll aq-reveal" data-delay="3" aria-label="Scroll to our commitments">
          <i class="aq-icon aq-i-ph-arrow-down-light" role="img" aria-hidden="true"/>
        </a>
                    </div>
                </section>

                <section class="aq-manifesto aq-planet-statement s_aquere_manifesto" aria-label="Our belief" data-snippet="s_aquere_manifesto" data-name="Manifesto">
                    <div class="aq-container">
                        <p class="aq-eyebrow aq-reveal">Our Belief</p>
                        <p class="aq-manifesto-text" data-words="">
          As a drinking water company, we carry a special responsibility. We aim to use water wisely,
          package it thoughtfully and keep finding better ways to reduce our impact on the planet.
        </p>
                        <div class="aq-manifesto-foot aq-reveal">
                            <span class="aq-manifesto-line" aria-hidden="true"/>
                            <span>Progress and targets will be shared here as they are confirmed</span>
                        </div>
                    </div>
                </section>

                <section class="aq-pillars aq-section s_aquere_pillars" id="pillars" data-snippet="s_aquere_pillars" data-name="Pillars">
                    <div class="aq-container">
                        <div class="aq-split-head">
                            <div>
                                <p class="aq-eyebrow aq-reveal">Our Commitments</p>
                                <h2 class="aq-section-title aq-reveal" data-delay="1">Four Ways<br/><em>We Take Care.</em></h2>
                            </div>
                            <p class="aq-split-text aq-reveal" data-delay="2">
            Four areas guide how we work today and where we want to improve tomorrow.
          </p>
                        </div>
                        <div class="aq-pillar-grid">
                            <figure class="aq-pillar-img aq-pillar-img--tall aq-reveal">
                                <img src="/theme_aquere/static/src/img/photos/pexels-8101056-1000.jpg" alt="A reusable glass water bottle beside an olive branch" loading="lazy"/>
                                <figcaption>Thoughtful packaging</figcaption>
                            </figure>
                            <article class="aq-pillar aq-reveal" data-delay="1">
                                <div class="aq-pillar-top">
                                    <i class="aq-icon-wrap aq-i-ph-recycle-light" role="img" aria-hidden="true"/>
                                    <span>01</span>
                                </div>
                                <h3>Responsible Packaging</h3>
                                <p>Using recyclable materials wherever possible and continually reviewing how our bottles are made.</p>
                                <ul>
                                    <li>Recyclable materials</li>
                                    <li>Regular packaging reviews</li>
                                </ul>
                            </article>
                            <article class="aq-pillar aq-pillar--blue aq-reveal" data-delay="2">
                                <div class="aq-pillar-top">
                                    <i class="aq-icon-wrap aq-i-ph-drop-half-bottom-light" role="img" aria-hidden="true"/>
                                    <span>02</span>
                                </div>
                                <h3>Water Conservation</h3>
                                <p>Working to reduce water wastage across every stage of our purification process.</p>
                                <ul>
                                    <li>Careful water management</li>
                                    <li>Less wastage in purification</li>
                                </ul>
                            </article>
                            <article class="aq-pillar aq-reveal" data-delay="1">
                                <div class="aq-pillar-top">
                                    <i class="aq-icon-wrap aq-i-ph-lightning-light" role="img" aria-hidden="true"/>
                                    <span>03</span>
                                </div>
                                <h3>Energy Efficiency</h3>
                                <p>Seeking more efficient ways to run our plant, storage and distribution.</p>
                                <ul>
                                    <li>Efficient operations</li>
                                    <li>Smarter distribution</li>
                                </ul>
                            </article>
                            <article class="aq-pillar aq-reveal" data-delay="2">
                                <div class="aq-pillar-top">
                                    <i class="aq-icon-wrap aq-i-ph-hand-heart-light" role="img" aria-hidden="true"/>
                                    <span>04</span>
                                </div>
                                <h3>Recycling Awareness</h3>
                                <p>Encouraging responsible disposal and recycling of every empty bottle.</p>
                                <ul>
                                    <li>Customer awareness</li>
                                    <li>Clean surroundings</li>
                                </ul>
                            </article>
                            <figure class="aq-pillar-img aq-reveal" data-delay="3">
                                <img src="/theme_aquere/static/src/img/photos/pexels-36110366-1000.jpg" alt="Clean water flowing from a tap into cupped hands" loading="lazy"/>
                                <figcaption>Every drop counts</figcaption>
                            </figure>
                        </div>
                    </div>
                </section>

                <section class="aq-yourpart-wrap s_aquere_yourpart_wrap" data-snippet="s_aquere_yourpart_wrap" data-name="Your Part">
                    <div class="aq-yourpart">
                        <div class="aq-container">
                            <div class="aq-yourpart-head">
                                <div>
                                    <p class="aq-eyebrow aq-eyebrow--light aq-reveal">Your Part</p>
                                    <h2 class="aq-standard-title aq-reveal" data-delay="1">Small Steps,<br/><em>Big Difference.</em></h2>
                                </div>
                                <p class="aq-yourpart-text aq-reveal" data-delay="2">
              Protecting the planet is a shared effort. Here are a few simple ways to help, every time you
              enjoy a bottle of AQUÉRÉ.
            </p>
                            </div>
                            <ol class="aq-tips">
                                <li class="aq-reveal" data-delay="1">
                                    <span class="aq-tip-no">01</span>
                                    <h3>Recycle Every Bottle</h3>
                                    <p>Empty bottles belong in the recycling bin, never in nature.</p>
                                </li>
                                <li class="aq-reveal" data-delay="2">
                                    <span class="aq-tip-no">02</span>
                                    <h3>Choose Larger Sizes</h3>
                                    <p>For homes and offices, larger formats mean less packaging per litre.</p>
                                </li>
                                <li class="aq-reveal" data-delay="3">
                                    <span class="aq-tip-no">03</span>
                                    <h3>Reuse Glass</h3>
                                    <p>Reserve glass bottles can find a second life around your home.</p>
                                </li>
                                <li class="aq-reveal" data-delay="4">
                                    <span class="aq-tip-no">04</span>
                                    <h3>Leave No Trace</h3>
                                    <p>Keep beaches, parks and trails as clean as you found them.</p>
                                </li>
                            </ol>
                        </div>
                    </div>
                </section>

                <section class="aq-pledges aq-section s_aquere_pledges" data-snippet="s_aquere_pledges" data-name="Pledges">
                    <div class="aq-container aq-pledge-grid">
                        <div class="aq-pledge-aside">
                            <p class="aq-eyebrow aq-reveal">Our Pledge</p>
                            <h2 class="aq-section-title aq-reveal" data-delay="1">What We<br/><em>Promise.</em></h2>
                            <p class="aq-split-text aq-reveal" data-delay="2">
            Clear commitments that shape our decisions, today and in the years ahead.
          </p>
                        </div>
                        <ul class="aq-pledge-list">
                            <li class="aq-reveal" data-delay="1"><i class="aq-icon aq-i-ph-check-circle-light" role="img" aria-hidden="true"/>Use recyclable materials wherever possible</li>
                            <li class="aq-reveal" data-delay="2"><i class="aq-icon aq-i-ph-check-circle-light" role="img" aria-hidden="true"/>Keep reducing water wastage in purification</li>
                            <li class="aq-reveal" data-delay="3"><i class="aq-icon aq-i-ph-check-circle-light" role="img" aria-hidden="true"/>Run our operations more efficiently</li>
                            <li class="aq-reveal" data-delay="1"><i class="aq-icon aq-i-ph-check-circle-light" role="img" aria-hidden="true"/>Encourage recycling in our community</li>
                            <li class="aq-reveal" data-delay="2"><i class="aq-icon aq-i-ph-check-circle-light" role="img" aria-hidden="true"/>Review our packaging regularly</li>
                            <li class="aq-reveal" data-delay="3"><i class="aq-icon aq-i-ph-check-circle-light" role="img" aria-hidden="true"/>Share our progress openly</li>
                        </ul>
                    </div>
                </section>

                <section class="aq-story-cta aq-section s_aquere_story_cta" data-snippet="s_aquere_story_cta" data-name="Call to Action">
                    <div class="aq-container">
                        <p class="aq-eyebrow aq-reveal">Together</p>
                        <h2 class="aq-story-cta-title aq-reveal" data-delay="1">Every Drop <em>Counts.</em></h2>
                        <div class="aq-story-cta-actions aq-reveal" data-delay="2">
                            <a href="/our-water" class="aq-btn aq-btn-primary">Explore Our Water <i class="aq-icon aq-i-ph-arrow-up-right-light aq-arrow" role="img" aria-hidden="true"/></a>
                            <a href="/contact" class="aq-link-line">Get in Touch</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="planet_page_page" model="theme.website.page">
        <field name="url">/our-planet</field>
        <field name="view_id" ref="planet_page"/>
        <field name="is_published" eval="True"/>
        <field name="header_overlay" eval="True"/>
    </record>
</odoo>
