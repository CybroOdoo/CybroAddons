<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Layout of the Aquere theme: the standard header restyled as the floating
    pill of the design, its call to action, and the footer with columns and
    oversized wordmark.
-->
<odoo>
    <template id="layout" name="Aquere Layout" inherit_id="website.layout" priority="60">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="aq-wrap" separator=" "/>
        </xpath>
    </template>

    <!-- The default header wears the classes of the design. They are set
         from the template itself, so another header template chosen in the
         website builder keeps the standard look, and Default brings the
         design back. -->
    <template id="template_header_default" name="Aquere Header" inherit_id="website.template_header_default" priority="10">
        <xpath expr="//header[@id='top']" position="attributes">
            <attribute name="t-attf-class" add="aq-header" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']" position="attributes">
            <attribute name="t-attf-class" add="aq-nav" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/t[@t-call='website.placeholder_header_brand']" position="attributes">
            <attribute name="_link_class.f">aq-logo</attribute>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/t[@t-call='website.navbar_nav']" position="attributes">
            <attribute name="_nav_class.f">aq-main-nav</attribute>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/t[@t-call='website.navbar_nav']//t[@t-call='website.submenu']" position="attributes">
            <attribute name="link_class.f">nav-link aq-main-nav__link</attribute>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/ul[hasclass('navbar-nav')]" position="attributes">
            <attribute name="class" add="aq-header-tools" separator=" "/>
        </xpath>
    </template>

    <!-- Mobile bar: the round menu button of the design. The menu itself is
         the standard one. -->
    <template id="template_header_mobile" name="Aquere Header Mobile" inherit_id="website.template_header_mobile" priority="10">
        <xpath expr="//button[@data-bs-target='#top_menu_collapse_mobile']" position="attributes">
            <attribute name="class" add="aq-nav-toggle" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse_mobile']" position="attributes">
            <attribute name="t-attf-class" add="aq-mobile-menu" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse_mobile']//t[@t-call='website.submenu']" position="attributes">
            <attribute name="link_class.f">nav-link p-3 text-wrap aq-main-nav__link</attribute>
        </xpath>
    </template>

    <!-- Call to action of the header: the blue pill of the design. -->
    <template id="header_call_to_action" name="Aquere Header Call to Action" inherit_id="website.header_call_to_action" priority="10">
        <xpath expr="//a[hasclass('btn_cta')]" position="replace">
            <a href="/our-water#collection" class="oe_unremovable btn btn-primary btn_cta aq-btn aq-btn-primary aq-btn-sm">Discover Our Water <span class="aq-btn-dot"/></a>
        </xpath>
    </template>

    <!-- Footer: editable columns and wordmark of the design. -->
    <template id="footer" name="Aquere Footer" inherit_id="website.layout" priority="60">
        <xpath expr="//footer[@id='bottom']" position="attributes">
            <attribute name="t-attf-class" add="aq-site-footer" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer">
                <section class="aq-footer-section" data-name="Footer Columns">
                    <div class="aq-container">
                        <div class="aq-footer-grid">
                            <div class="aq-footer-brand">
                                <a href="/" class="aq-logo aq-logo--light" aria-label="AQUÉRÉ home"><img src="/theme_aquere/static/src/img/logo.png" alt="AQUÉRÉ" width="1365" height="636" loading="lazy"/></a>
                                <p>Pure Origins. Exceptional Hydration. Premium packaged drinking water, purified with care and hygienically sealed.</p>
                                <ul class="aq-socials" aria-label="Social media">
                                    <li><a href="#" aria-label="Instagram"><i class="aq-icon aq-i-ph-instagram-logo-light" role="img" aria-hidden="true"/></a></li>
                                    <li><a href="#" aria-label="Facebook"><i class="aq-icon aq-i-ph-facebook-logo-light" role="img" aria-hidden="true"/></a></li>
                                    <li><a href="#" aria-label="LinkedIn"><i class="aq-icon aq-i-ph-linkedin-logo-light" role="img" aria-hidden="true"/></a></li>
                                    <li><a href="#" aria-label="Pinterest"><i class="aq-icon aq-i-ph-pinterest-logo-light" role="img" aria-hidden="true"/></a></li>
                                </ul>
                            </div>
                            <div class="aq-footer-col">
                                <h4>Explore</h4>
                                <ul>
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/our-story">Our Story</a></li>
                                    <li><a href="/our-process">Our Process</a></li>
                                    <li><a href="/our-planet">Our Planet</a></li>
                                </ul>
                            </div>
                            <div class="aq-footer-col">
                                <h4>Products</h4>
                                <ul>
                                    <li><a href="/our-water#still">AQUÉRÉ Still</a></li>
                                    <li><a href="/our-water#sparkling">AQUÉRÉ Sparkling</a></li>
                                    <li><a href="/our-water#reserve">AQUÉRÉ Reserve</a></li>
                                </ul>
                            </div>
                            <div class="aq-footer-col">
                                <h4>Contact</h4>
                                <ul>
                                    <li>[Company Address Line]<br/>[City, Country]</li>
                                    <li><a href="mailto:hello@example.com">hello@example.com</a></li>
                                    <li><a href="tel:+000000000000">+00 (0) 000 000 000</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="aq-footer-wordmark" aria-hidden="true">AQUÉRÉ</div>
                    </div>
                </section>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_copyright')]/div[hasclass('container')]" position="replace">
            <div class="aq-container">
                <div class="aq-footer-bottom">
                    <p>© <span t-out="datetime.date.today().year"/> AQUÉRÉ. All rights reserved.</p>
                    <ul>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms and Conditions</a></li>
                    </ul>
                    <a href="#top" class="aq-to-top">Back to top ↑</a>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
