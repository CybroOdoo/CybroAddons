<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Contact page of the Aquere theme, built from editable sections.
-->
<odoo>
    <template id="contact_page" name="Contact">
        <t t-call="website.layout">
            <t t-set="additional_title">Contact</t>
            <t t-set="pageName" t-valuef="aquere_contact"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="aq-page-hero aq-contact-hero s_aquere_page_hero" data-snippet="s_aquere_page_hero" data-name="Page Hero">
                    <div class="aq-container">
                        <nav class="aq-crumbs aq-reveal" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <i class="aq-icon aq-i-ph-caret-right-light" role="img" aria-hidden="true"/>
                            <span aria-current="page">Contact</span>
                        </nav>
                        <div class="aq-page-hero-head">
                            <h1 class="aq-page-title aq-reveal" data-delay="1">Let's Talk<br/><em>Water.</em></h1>
                            <div class="aq-page-hero-side aq-reveal" data-delay="2">
                                <p>
              Whether you are ordering for your home, supplying an office or planning an event, our team
              is here to help you find the right AQUÉRÉ for every need.
            </p>
                                <a href="#enquiry" class="aq-link-line">Send an Enquiry</a>
                            </div>
                        </div>
                        <div class="aq-quick-contact">
                            <a href="tel:+000000000000" class="aq-qc aq-reveal" data-delay="1">
            <i class="aq-icon-wrap aq-i-ph-phone-light aq-qc-icon" role="img" aria-hidden="true"/>
            <span class="aq-qc-text"><small>Call Us</small>+00 (0) 000 000 000</span>
            <i class="aq-icon aq-i-ph-arrow-up-right-light aq-qc-arrow" role="img" aria-hidden="true"/>
          </a>
                            <a href="mailto:hello@example.com" class="aq-qc aq-reveal" data-delay="2">
            <i class="aq-icon-wrap aq-i-ph-envelope-simple-light aq-qc-icon" role="img" aria-hidden="true"/>
            <span class="aq-qc-text"><small>Email Us</small>hello@example.com</span>
            <i class="aq-icon aq-i-ph-arrow-up-right-light aq-qc-arrow" role="img" aria-hidden="true"/>
          </a>
                            <a href="https://wa.me/000000000000" class="aq-qc aq-qc--blue aq-reveal" data-delay="3" target="_blank" rel="noopener">
            <i class="aq-icon-wrap aq-i-ph-whatsapp-logo-light aq-qc-icon" role="img" aria-hidden="true"/>
            <span class="aq-qc-text"><small>Chat on WhatsApp</small>Message our team</span>
            <i class="aq-icon aq-i-ph-arrow-up-right-light aq-qc-arrow" role="img" aria-hidden="true"/>
          </a>
                        </div>
                        <p class="aq-hours-line aq-reveal" data-delay="3"><i class="aq-icon aq-i-ph-clock-light" role="img" aria-hidden="true"/><span>Working Hours</span>[Days] · [Opening Hours]</p>
                    </div>
                </section>

                <section class="aq-contact-main aq-section s_aquere_contact_main" id="enquiry" data-snippet="s_aquere_contact_main" data-name="Contact Form">
                    <div class="aq-container aq-contact-grid">
                        <div class="aq-contact-info">
                            <p class="aq-eyebrow aq-reveal">How It Works</p>
                            <h2 class="aq-section-title aq-reveal" data-delay="1">We'd Love to<br/><em>Hear from You.</em></h2>
                            <p class="aq-split-text aq-reveal" data-delay="2">
            Three simple steps from your first message to fresh AQUÉRÉ on your table.
          </p>
                            <ol class="aq-steps-list">
                                <li class="aq-reveal" data-delay="1">
                                    <span class="aq-sl-no">01</span>
                                    <div>
                                        <h3>Send Your Enquiry</h3>
                                        <p>Tell us what you need, including products, sizes and how often.</p>
                                    </div>
                                </li>
                                <li class="aq-reveal" data-delay="2">
                                    <span class="aq-sl-no">02</span>
                                    <div>
                                        <h3>We Get in Touch</h3>
                                        <p>Our team reviews your request and gets back to you personally.</p>
                                    </div>
                                </li>
                                <li class="aq-reveal" data-delay="3">
                                    <span class="aq-sl-no">03</span>
                                    <div>
                                        <h3>Fresh Water, Delivered</h3>
                                        <p>We confirm the details and arrange supply that suits your schedule.</p>
                                    </div>
                                </li>
                            </ol>
                            <ul class="aq-socials aq-socials--dark aq-reveal" aria-label="Social media">
                                <li>
                                    <a href="#" aria-label="Instagram"><i class="aq-icon aq-i-ph-instagram-logo-light" role="img" aria-hidden="true"/></a>
                                </li>
                                <li>
                                    <a href="#" aria-label="Facebook"><i class="aq-icon aq-i-ph-facebook-logo-light" role="img" aria-hidden="true"/></a>
                                </li>
                                <li>
                                    <a href="#" aria-label="LinkedIn"><i class="aq-icon aq-i-ph-linkedin-logo-light" role="img" aria-hidden="true"/></a>
                                </li>
                                <li>
                                    <a href="#" aria-label="Pinterest"><i class="aq-icon aq-i-ph-pinterest-logo-light" role="img" aria-hidden="true"/></a>
                                </li>
                            </ul>
                        </div>
                        <div class="aq-form-wrap aq-reveal" data-delay="2">
                            <section class="s_website_form aq-contact-form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                <form id="aq_contact_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                    <div class="aq-form-head">
                                        <div>
                                            <h3 class="aq-form-title">Send an Enquiry</h3>
                                            <p class="aq-form-intro">Fields marked * are required.</p>
                                        </div>
                                        <span class="aq-form-badge"><i class="aq-icon aq-i-ph-lock-simple-light" role="img" aria-hidden="true"/> Private &amp; secure</span>
                                    </div>
                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                        <div class="s_website_form_field col-lg-6 s_website_form_required aq-f-field" data-type="char" data-name="Field">
                <label class="s_website_form_label" for="aq_f_name"><span class="s_website_form_label_content">Full Name</span><span class="s_website_form_mark"> *</span></label>
                <input id="aq_f_name" type="text" class="s_website_form_input" name="contact_name" required="" autocomplete="name" data-fill-with="name"/>
            </div>
                                        <div class="s_website_form_field col-lg-6 s_website_form_required s_website_form_model_required aq-f-field" data-type="email" data-name="Field">
                <label class="s_website_form_label" for="aq_f_email"><span class="s_website_form_label_content">Email Address</span><span class="s_website_form_mark"> *</span></label>
                <input id="aq_f_email" type="email" class="s_website_form_input" name="email_from" required="" autocomplete="email" data-fill-with="email"/>
            </div>
                                        <div class="s_website_form_field col-lg-6 aq-f-field" data-type="char" data-name="Field">
                <label class="s_website_form_label" for="aq_f_phone"><span class="s_website_form_label_content">Phone Number</span></label>
                <input id="aq_f_phone" type="tel" class="s_website_form_input" name="phone" autocomplete="tel" data-fill-with="phone"/>
            </div>
                                        <div class="s_website_form_field col-lg-6 s_website_form_required s_website_form_model_required aq-f-field" data-type="char" data-name="Field">
                <label class="s_website_form_label" for="aq_f_type"><span class="s_website_form_label_content">Enquiry Type</span></label>
                <select id="aq_f_type" class="s_website_form_input" name="name" required="">
                    <option>General Enquiry</option>
                    <option>Home Delivery</option>
                    <option>Office Supply</option>
                    <option>Hospitality &amp; Events</option>
                    <option>Distribution &amp; Partnership</option>
                </select>
            </div>
                                        <div class="s_website_form_field col-12 s_website_form_required aq-f-field aq-f-message" data-type="text" data-name="Field">
                <label class="s_website_form_label" for="aq_f_message"><span class="s_website_form_label_content">Message</span><span class="s_website_form_mark"> *</span></label>
                <textarea id="aq_f_message" class="s_website_form_input" name="description" rows="5" maxlength="1000" required="" placeholder="Tell us what you need, including products, sizes and quantities if known."/>
                <small class="aq-char-count" aria-live="polite">0 / 1000</small>
            </div>
                                        <div class="s_website_form_field s_website_form_dnone">
                <input type="hidden" class="s_website_form_input" name="email_to"/>
            </div>
                                        <div class="col-12 s_website_form_submit s_website_form_no_submit_label aq-form-foot" data-name="Submit Button">
                                            <p class="aq-form-legal-dark">By sending this form you agree to our Privacy Policy.</p>
                                            <div class="s_website_form_label"/>
                                            <span id="s_website_form_result"/>
                                            <a href="#" role="button" class="aq-btn aq-btn-primary s_website_form_send">Send Enquiry <i class="aq-icon aq-arrow aq-i-ph-paper-plane-tilt-light" role="img" aria-hidden="true"/></a>
                                        </div>
                                    </div>
                                </form>
                            </section>
                        </div>
                    </div>
                </section>

                <section class="aq-faq aq-section aq-contact-faq s_aquere_faq" data-snippet="s_aquere_faq" data-name="FAQ">
                    <div class="aq-container aq-faq-grid">
                        <div class="aq-faq-aside">
                            <p class="aq-eyebrow aq-reveal">Before You Ask</p>
                            <h2 class="aq-section-title aq-reveal" data-delay="1">Quick<br/><em>Answers.</em></h2>
                            <p class="aq-split-text aq-reveal" data-delay="2">
            A few things customers often ask before getting in touch.
          </p>
                            <a href="/our-water" class="aq-link-line aq-reveal" data-delay="3">Explore Our Water</a>
                        </div>
                        <ul class="aq-accordion">
                            <li class="aq-acc-item is-open aq-reveal" data-delay="1">
                                <button class="aq-acc-head" aria-expanded="true">
              <span class="aq-acc-num">01</span>Do you deliver to my area?<i class="aq-icon-wrap aq-i-ph-plus-light aq-acc-plus" role="img" aria-hidden="true"/>
            </button>
                                <div class="aq-acc-body">
                                    <p>Share your location in the enquiry form and our team will confirm delivery availability for your area.</p>
                                </div>
                            </li>
                            <li class="aq-acc-item aq-reveal" data-delay="2">
                                <button class="aq-acc-head" aria-expanded="false">
              <span class="aq-acc-num">02</span>Can I set up a regular supply?<i class="aq-icon-wrap aq-i-ph-plus-light aq-acc-plus" role="img" aria-hidden="true"/>
            </button>
                                <div class="aq-acc-body">
                                    <p>Yes. Tell us how much water you use and how often, and we will suggest a schedule that suits your home or business.</p>
                                </div>
                            </li>
                            <li class="aq-acc-item aq-reveal" data-delay="3">
                                <button class="aq-acc-head" aria-expanded="false">
              <span class="aq-acc-num">03</span>Do you supply hotels and events?<i class="aq-icon-wrap aq-i-ph-plus-light aq-acc-plus" role="img" aria-hidden="true"/>
            </button>
                                <div class="aq-acc-body">
                                    <p>We welcome hospitality and event enquiries. AQUÉRÉ Reserve, our premium glass edition, is designed especially for the table.</p>
                                </div>
                            </li>
                            <li class="aq-acc-item aq-reveal" data-delay="4">
                                <button class="aq-acc-head" aria-expanded="false">
              <span class="aq-acc-num">04</span>How can I become a distributor?<i class="aq-icon-wrap aq-i-ph-plus-light aq-acc-plus" role="img" aria-hidden="true"/>
            </button>
                                <div class="aq-acc-body">
                                    <p>Select "Distribution &amp; Partnership" as the enquiry type in the form, tell us about your business, and our partnerships team will follow up.</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                </section>

                <section class="aq-location-wrap s_aquere_location_wrap" data-snippet="s_aquere_location_wrap" data-name="Location">
                    <div class="aq-location">
                        <div class="aq-map-art" aria-hidden="true">
                            <span class="aq-map-road aq-map-road--1"/>
                            <span class="aq-map-road aq-map-road--2"/>
                            <span class="aq-map-road aq-map-road--3"/>
                            <span class="aq-map-river"/>
                            <span class="aq-map-pin"><i class="aq-icon aq-i-ph-drop-fill" role="img" aria-hidden="true"/></span>
                        </div>
                        <div class="aq-location-card aq-glass-card aq-reveal">
                            <span class="aq-gc-label">Visit Us</span>
                            <h2 class="aq-location-title">AQUÉRÉ Headquarters</h2>
                            <p>[Company Address Line]<br/>[City, Country]</p>
                            <p class="aq-location-note">An interactive map will be added here once the address is confirmed.</p>
                            <a href="#" class="aq-btn aq-btn-primary aq-btn-sm">Get Directions <i class="aq-icon aq-i-ph-arrow-up-right-light aq-arrow" role="img" aria-hidden="true"/></a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="contact_page_page" model="theme.website.page">
        <field name="url">/contact</field>
        <field name="view_id" ref="contact_page"/>
        <field name="is_published" eval="True"/>
        <field name="header_overlay" eval="True"/>
    </record>
</odoo>
