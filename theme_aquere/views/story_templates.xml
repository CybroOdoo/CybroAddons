<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Our Story page of the Aquere theme, built from editable sections.
-->
<odoo>
    <template id="story_page" name="Our Story">
        <t t-call="website.layout">
            <t t-set="additional_title">Our Story</t>
            <t t-set="pageName" t-valuef="aquere_story"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="aq-story-hero s_aquere_story_hero" data-snippet="s_aquere_story_hero" data-name="Story Hero">
                    <div class="aq-container aq-story-hero-grid">
                        <div class="aq-sh-copy">
                            <nav class="aq-crumbs aq-reveal" aria-label="Breadcrumb">
                                <a href="/">Home</a>
                                <i class="aq-icon aq-i-ph-caret-right-light" role="img" aria-hidden="true"/>
                                <span aria-current="page">Our Story</span>
                            </nav>
                            <h1 class="aq-page-title aq-reveal" data-delay="1">Born from Nature.<br/><em>Crafted by Purity.</em></h1>
                            <p class="aq-sh-text aq-reveal" data-delay="2">
            AQUÉRÉ is premium packaged drinking water, created to bring clean, safe and refreshing water
            to every home, office and table, purified with care and sealed with confidence.
          </p>
                            <div class="aq-sh-actions aq-reveal" data-delay="3">
                                <a href="#belief" class="aq-btn aq-btn-primary">Begin the Story <i class="aq-icon aq-i-ph-arrow-down-light aq-arrow" role="img" aria-hidden="true"/></a>
                                <a href="/our-process" class="aq-link-line">See Our Process</a>
                            </div>
                        </div>
                        <div class="aq-sh-media aq-reveal" data-delay="2">
                            <figure class="aq-sh-main">
                                <img src="/theme_aquere/static/src/img/photos/pexels-39326833-1200.jpg" alt="Clear, fresh water tumbling over rock"/>
                            </figure>
                            <figure class="aq-sh-small">
                                <img src="/theme_aquere/static/src/img/photos/unsplash-1512138664757-360e0aad5132-700.jpg" alt="Gentle ripples spreading across still water"/>
                            </figure>
                            <div class="aq-sh-badge aq-glass-card">
                                <span class="aq-gc-label">Our Promise</span>
                                <span class="aq-gc-value">Clean, safe water in every bottle.</span>
                            </div>
                            <span class="aq-sh-ring" aria-hidden="true"/>
                        </div>
                    </div>
                </section>

                <section class="aq-manifesto aq-story-belief s_aquere_manifesto" id="belief" aria-label="Our founding belief" data-snippet="s_aquere_manifesto" data-name="Manifesto">
                    <div class="aq-container">
                        <p class="aq-eyebrow aq-reveal">Our Founding Belief</p>
                        <p class="aq-manifesto-text" data-words="">
          AQUÉRÉ was founded on a simple belief: everyone deserves drinking water they never have to
          think twice about. Clean, safe and refreshing, in every single bottle.
        </p>
                        <div class="aq-manifesto-foot aq-reveal">
                            <span class="aq-manifesto-line" aria-hidden="true"/>
                            <span>The Beginning of AQUÉRÉ</span>
                        </div>
                    </div>
                </section>

                <section class="aq-chapters aq-section s_aquere_chapters" data-snippet="s_aquere_chapters" data-name="Story Chapters">
                    <div class="aq-container">
                        <article class="aq-chapter-row">
                            <figure class="aq-cr-media aq-reveal">
                                <img src="/theme_aquere/static/src/img/photos/pexels-7787078-1200.jpg" alt="A glass of clear water with a slice of lemon in soft sunlight" loading="lazy"/>
                            </figure>
                            <div class="aq-cr-body">
                                <span class="aq-cr-no aq-reveal" aria-hidden="true">01</span>
                                <p class="aq-eyebrow aq-reveal">Chapter One · Our Purpose</p>
                                <h2 class="aq-cr-title aq-reveal" data-delay="1">Water You Never<br/><em>Think Twice About.</em></h2>
                                <p class="aq-cr-text aq-reveal" data-delay="2">
              We started AQUÉRÉ to bring clean, safe and refreshing drinking water to every home, office and
              table. Water people can rely on, every day, without a second thought.
            </p>
                                <ul class="aq-cr-points aq-reveal" data-delay="3">
                                    <li><i class="aq-icon aq-i-ph-house-line-light" role="img" aria-hidden="true"/>Homes &amp; families</li>
                                    <li><i class="aq-icon aq-i-ph-briefcase-light" role="img" aria-hidden="true"/>Workplaces</li>
                                    <li><i class="aq-icon aq-i-ph-wine-light" role="img" aria-hidden="true"/>Hospitality</li>
                                </ul>
                            </div>
                        </article>
                        <article class="aq-chapter-row aq-chapter-row--flip">
                            <figure class="aq-cr-media aq-reveal">
                                <img src="/theme_aquere/static/src/img/photos/pexels-4667189-1200.jpg" alt="A clear glass of chilled water against a dark background" loading="lazy"/>
                            </figure>
                            <div class="aq-cr-body">
                                <span class="aq-cr-no aq-reveal" aria-hidden="true">02</span>
                                <p class="aq-eyebrow aq-reveal">Chapter Two · Our Approach</p>
                                <h2 class="aq-cr-title aq-reveal" data-delay="1">Purified with<br/><em>Precision.</em></h2>
                                <p class="aq-cr-text aq-reveal" data-delay="2">
              We start with carefully selected raw water and take it through a controlled, multi-stage
              purification process, removing impurities while keeping the water light and pleasant to drink.
            </p>
                                <a href="/our-process" class="aq-btn aq-btn-outline aq-reveal" data-delay="3">See the Full Process <i class="aq-icon aq-i-ph-arrow-up-right-light aq-arrow" role="img" aria-hidden="true"/></a>
                            </div>
                        </article>
                        <article class="aq-chapter-row">
                            <figure class="aq-cr-media aq-reveal">
                                <img src="/theme_aquere/static/src/img/photos/pexels-7664096-1200.jpg" alt="A crystal glass of water catching the light" loading="lazy"/>
                            </figure>
                            <div class="aq-cr-body">
                                <span class="aq-cr-no aq-reveal" aria-hidden="true">03</span>
                                <p class="aq-eyebrow aq-reveal">Chapter Three · Our Promise</p>
                                <h2 class="aq-cr-title aq-reveal" data-delay="1">The Same Standard,<br/><em>Every Bottle.</em></h2>
                                <p class="aq-cr-text aq-reveal" data-delay="2">
              From our production floor to your table, every step follows the same discipline of hygiene,
              testing and care, so each bottle carrying the AQUÉRÉ name meets the same high standard.
            </p>
                                <ul class="aq-cr-points aq-reveal" data-delay="3">
                                    <li><i class="aq-icon aq-i-ph-shield-check-light" role="img" aria-hidden="true"/>Hygienic</li>
                                    <li><i class="aq-icon aq-i-ph-flask-light" role="img" aria-hidden="true"/>Tested</li>
                                    <li><i class="aq-icon aq-i-ph-seal-check-light" role="img" aria-hidden="true"/>Sealed</li>
                                </ul>
                            </div>
                        </article>
                    </div>
                </section>

                <section class="aq-story-quote-wrap s_aquere_story_quote_wrap" data-snippet="s_aquere_story_quote_wrap" data-name="Quote Band">
                    <div class="aq-story-quote">
                        <img src="/theme_aquere/static/src/img/photos/pexels-3653963-1600.jpg" alt="" aria-hidden="true" loading="lazy"/>
                        <blockquote class="aq-story-quote-inner">
                            <p class="aq-eyebrow aq-eyebrow--light aq-reveal">Our Philosophy</p>
                            <p class="aq-story-quote-text aq-reveal" data-delay="1">Purity is never <em>left to chance.</em></p>
                            <p class="aq-story-quote-sub aq-reveal" data-delay="2">
            Every batch is purified, tested and sealed with the same discipline, so you can trust every bottle.
          </p>
                        </blockquote>
                    </div>
                </section>

                <section class="aq-values aq-section s_aquere_values" data-snippet="s_aquere_values" data-name="Values Panels">
                    <div class="aq-container">
                        <div class="aq-split-head">
                            <div>
                                <p class="aq-eyebrow aq-reveal">Our Values</p>
                                <h2 class="aq-section-title aq-reveal" data-delay="1">What We<br/><em>Stand For.</em></h2>
                            </div>
                            <p class="aq-split-text aq-reveal" data-delay="2">
            The principles that guide every decision, from how we purify our water to how each bottle
            reaches your table.
          </p>
                        </div>
                        <div class="aq-value-panels aq-reveal">
                            <article class="aq-vp is-open" tabindex="0">
                                <img src="/theme_aquere/static/src/img/photos/pexels-12987477-1000.jpg" alt="" loading="lazy"/>
                                <div class="aq-vp-inner">
                                    <span class="aq-vp-no">01</span>
                                    <i class="aq-icon-wrap aq-i-ph-drop-light aq-vp-icon" role="img" aria-hidden="true"/>
                                    <h3>Purity</h3>
                                    <p>Every drop is carefully purified to deliver clean, fresh-tasting drinking water.</p>
                                </div>
                            </article>
                            <article class="aq-vp" tabindex="0">
                                <img src="/theme_aquere/static/src/img/photos/pexels-4667177-1000.jpg" alt="" loading="lazy"/>
                                <div class="aq-vp-inner">
                                    <span class="aq-vp-no">02</span>
                                    <i class="aq-icon-wrap aq-i-ph-shield-check-light aq-vp-icon" role="img" aria-hidden="true"/>
                                    <h3>Safety</h3>
                                    <p>Hygiene and regular quality testing guide everything we do, without exception.</p>
                                </div>
                            </article>
                            <article class="aq-vp" tabindex="0">
                                <img src="/theme_aquere/static/src/img/photos/pexels-9946170-1000.jpg" alt="" loading="lazy"/>
                                <div class="aq-vp-inner">
                                    <span class="aq-vp-no">03</span>
                                    <i class="aq-icon-wrap aq-i-ph-target-light aq-vp-icon" role="img" aria-hidden="true"/>
                                    <h3>Consistency</h3>
                                    <p>The same high standard in every bottle, batch after batch.</p>
                                </div>
                            </article>
                            <article class="aq-vp" tabindex="0">
                                <img src="/theme_aquere/static/src/img/photos/pexels-36110366-1000.jpg" alt="" loading="lazy"/>
                                <div class="aq-vp-inner">
                                    <span class="aq-vp-no">04</span>
                                    <i class="aq-icon-wrap aq-i-ph-hand-heart-light aq-vp-icon" role="img" aria-hidden="true"/>
                                    <h3>Care</h3>
                                    <p>From our production floor to your table, every bottle is handled with care.</p>
                                </div>
                            </article>
                        </div>
                    </div>
                </section>

                <section class="aq-story-strip s_aquere_story_strip" aria-hidden="true" data-snippet="s_aquere_story_strip" data-name="Photo Strip">
                    <div class="aq-strip-track">
                        <img src="/theme_aquere/static/src/img/photos/pexels-13092692-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-8765283-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-13723906-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-4612341-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-14564811-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-11206902-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-13092692-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-8765283-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-13723906-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-4612341-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-14564811-600.jpg" alt="" loading="lazy"/>
                        <img src="/theme_aquere/static/src/img/photos/pexels-11206902-600.jpg" alt="" loading="lazy"/>
                    </div>
                </section>

                <section class="aq-story-cta aq-section s_aquere_story_cta" data-snippet="s_aquere_story_cta" data-name="Call to Action">
                    <div class="aq-container">
                        <p class="aq-eyebrow aq-reveal">The Story Continues</p>
                        <h2 class="aq-story-cta-title aq-reveal" data-delay="1">Taste the <em>Purity.</em></h2>
                        <div class="aq-story-cta-actions aq-reveal" data-delay="2">
                            <a href="/our-water" class="aq-btn aq-btn-primary">Explore Our Water <i class="aq-icon aq-i-ph-arrow-up-right-light aq-arrow" role="img" aria-hidden="true"/></a>
                            <a href="/our-process" class="aq-link-line">See Our Process</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="story_page_page" model="theme.website.page">
        <field name="url">/our-story</field>
        <field name="view_id" ref="story_page"/>
        <field name="is_published" eval="True"/>
        <field name="header_overlay" eval="True"/>
    </record>
</odoo>
