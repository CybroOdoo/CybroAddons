<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Our Water page of the Aquere theme, built from editable sections.
-->
<odoo>
    <template id="water_page" name="Our Water">
        <t t-call="website.layout">
            <t t-set="additional_title">Our Water</t>
            <t t-set="pageName" t-valuef="aquere_water"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="aq-page-hero aq-water-hero s_aquere_page_hero" data-snippet="s_aquere_page_hero" data-name="Page Hero">
                    <div class="aq-container aq-water-hero-grid">
                        <div class="aq-water-hero-copy">
                            <nav class="aq-crumbs aq-reveal" aria-label="Breadcrumb">
                                <a href="/">Home</a>
                                <i class="aq-icon aq-i-ph-caret-right-light" role="img" aria-hidden="true"/>
                                <span aria-current="page">Our Water</span>
                            </nav>
                            <h1 class="aq-page-title aq-reveal" data-delay="1">Pure Water,<br/><em>Made for You.</em></h1>
                            <p class="aq-water-hero-text aq-reveal" data-delay="2">
            One standard of purity, three ways to enjoy it. Every AQUÉRÉ bottle is purified through a
            controlled multi-stage process, quality tested and hygienically sealed.
          </p>
                            <ul class="aq-water-jump aq-reveal" data-delay="3">
                                <li>
                                    <a href="#still"><span>01</span>Still</a>
                                </li>
                                <li>
                                    <a href="#sparkling"><span>02</span>Sparkling</a>
                                </li>
                                <li>
                                    <a href="#reserve"><span>03</span>Reserve</a>
                                </li>
                            </ul>
                        </div>
                        <figure class="aq-water-hero-media aq-reveal" data-delay="2">
                            <img src="/theme_aquere/static/src/img/photos/pexels-3500006-1400.jpg" alt="Clear drinking water being poured from a jug into a glass"/>
                            <figcaption class="aq-glass-card aq-water-hero-badge">
                                <span class="aq-gc-label">Every Bottle</span>
                                <span class="aq-gc-value">Purified · Tested · Sealed</span>
                            </figcaption>
                        </figure>
                    </div>
                </section>

                <section class="aq-products aq-section s_aquere_products" aria-label="The AQUÉRÉ range" data-snippet="s_aquere_products" data-name="Products">
                    <div class="aq-container">
                        <article class="aq-product-row" id="still">
                            <figure class="aq-pr-media aq-reveal">
                                <img src="/theme_aquere/static/src/img/photos/pexels-8765283-1400.jpg" alt="AQU&#xC9;R&#xC9; Still in a frosted bottle with glasses on a white table" loading="lazy"/>
                                <span class="aq-pr-no" aria-hidden="true">01</span>
                            </figure>
                            <div class="aq-pr-body">
                                <p class="aq-eyebrow aq-reveal">Signature · Everyday</p>
                                <h2 class="aq-pr-title aq-reveal" data-delay="1">AQUÉRÉ <em>Still</em></h2>
                                <p class="aq-pr-sub aq-reveal" data-delay="1">Purified Drinking Water</p>
                                <p class="aq-pr-desc aq-reveal" data-delay="2">
              Clean, light and refreshing. Our everyday drinking water, purified through a controlled
              multi-stage process and hygienically sealed for complete peace of mind, at home, at work
              or on the move.
            </p>
                                <dl class="aq-pr-specs aq-reveal" data-delay="2">
                                    <div>
                                        <dt>Type</dt>
                                        <dd>Packaged drinking water</dd>
                                    </div>
                                    <div>
                                        <dt>Sizes</dt>
                                        <dd>500 ml · 750 ml</dd>
                                    </div>
                                    <div>
                                        <dt>Taste</dt>
                                        <dd>Clean, light &amp; fresh</dd>
                                    </div>
                                    <div>
                                        <dt>Best for</dt>
                                        <dd>Everyday hydration</dd>
                                    </div>
                                </dl>
                                <div class="aq-pr-actions aq-reveal" data-delay="3">
                                    <a href="#enquire" class="aq-btn aq-btn-primary">Enquire Now <i class="aq-icon aq-i-ph-arrow-up-right-light aq-arrow" role="img" aria-hidden="true"/></a>
                                </div>
                            </div>
                        </article>
                        <article class="aq-product-row aq-product-row--flip" id="sparkling">
                            <figure class="aq-pr-media aq-reveal">
                                <img src="/theme_aquere/static/src/img/photos/pexels-4612341-1400.jpg" alt="AQU&#xC9;R&#xC9; Sparkling in a fine wine glass with bubbles rising" loading="lazy"/>
                                <span class="aq-pr-no" aria-hidden="true">02</span>
                            </figure>
                            <div class="aq-pr-body">
                                <p class="aq-eyebrow aq-reveal">Fine Bubbles · Dining</p>
                                <h2 class="aq-pr-title aq-reveal" data-delay="1">AQUÉRÉ <em>Sparkling</em></h2>
                                <p class="aq-pr-sub aq-reveal" data-delay="1">Carbonated Drinking Water</p>
                                <p class="aq-pr-desc aq-reveal" data-delay="2">
              Our purified water with fine, lively bubbles and a crisp, clean finish. A refreshing
              companion at the table and an elegant alternative to sugary drinks.
            </p>
                                <dl class="aq-pr-specs aq-reveal" data-delay="2">
                                    <div>
                                        <dt>Type</dt>
                                        <dd>Carbonated drinking water</dd>
                                    </div>
                                    <div>
                                        <dt>Sizes</dt>
                                        <dd>330 ml · 750 ml</dd>
                                    </div>
                                    <div>
                                        <dt>Taste</dt>
                                        <dd>Crisp &amp; lively</dd>
                                    </div>
                                    <div>
                                        <dt>Best for</dt>
                                        <dd>Meals &amp; refreshment</dd>
                                    </div>
                                </dl>
                                <div class="aq-pr-actions aq-reveal" data-delay="3">
                                    <a href="#enquire" class="aq-btn aq-btn-primary">Enquire Now <i class="aq-icon aq-i-ph-arrow-up-right-light aq-arrow" role="img" aria-hidden="true"/></a>
                                </div>
                            </div>
                        </article>
                        <article class="aq-product-row aq-product-row--dark" id="reserve">
                            <figure class="aq-pr-media aq-reveal">
                                <img src="/theme_aquere/static/src/img/photos/pexels-11206902-1400.jpg" alt="AQU&#xC9;R&#xC9; Reserve served in a crystal glass under a single light" loading="lazy"/>
                                <span class="aq-pr-no" aria-hidden="true">03</span>
                            </figure>
                            <div class="aq-pr-body">
                                <p class="aq-eyebrow aq-eyebrow--light aq-reveal">Limited · Premium</p>
                                <h2 class="aq-pr-title aq-reveal" data-delay="1">AQUÉRÉ <em>Reserve</em></h2>
                                <p class="aq-pr-sub aq-reveal" data-delay="1">Premium Glass Edition</p>
                                <p class="aq-pr-desc aq-reveal" data-delay="2">
              Our purified drinking water presented in an elegant glass bottle. Created for fine dining,
              hotels, hospitality and the occasions where every detail on the table matters.
            </p>
                                <dl class="aq-pr-specs aq-reveal" data-delay="2">
                                    <div>
                                        <dt>Type</dt>
                                        <dd>Packaged drinking water</dd>
                                    </div>
                                    <div>
                                        <dt>Sizes</dt>
                                        <dd>750 ml · 1 L</dd>
                                    </div>
                                    <div>
                                        <dt>Bottle</dt>
                                        <dd>Premium glass</dd>
                                    </div>
                                    <div>
                                        <dt>Best for</dt>
                                        <dd>Fine dining &amp; events</dd>
                                    </div>
                                </dl>
                                <div class="aq-pr-actions aq-reveal" data-delay="3">
                                    <a href="#enquire" class="aq-btn aq-btn-light">Enquire Now <i class="aq-icon aq-i-ph-arrow-up-right-light aq-arrow" role="img" aria-hidden="true"/></a>
                                </div>
                            </div>
                        </article>
                    </div>
                </section>

                <section class="aq-standard-wrap s_aquere_standard_wrap" data-snippet="s_aquere_standard_wrap" data-name="Standard Band">
                    <div class="aq-standard">
                        <div class="aq-container">
                            <div class="aq-standard-head">
                                <p class="aq-eyebrow aq-eyebrow--light aq-reveal">The AQUÉRÉ Standard</p>
                                <h2 class="aq-standard-title aq-reveal" data-delay="1">Every Bottle,<br/><em>the Same Promise.</em></h2>
                            </div>
                            <ul class="aq-standard-grid">
                                <li class="aq-reveal" data-delay="1">
                                    <i class="aq-icon-wrap aq-i-ph-funnel-light" role="img" aria-hidden="true"/>
                                    <h3>Multi-Stage Purified</h3>
                                    <p>Filtered and disinfected through a carefully controlled process.</p>
                                </li>
                                <li class="aq-reveal" data-delay="2">
                                    <i class="aq-icon-wrap aq-i-ph-flask-light" role="img" aria-hidden="true"/>
                                    <h3>Quality Tested</h3>
                                    <p>Checked at key stages, from raw water to the finished bottle.</p>
                                </li>
                                <li class="aq-reveal" data-delay="3">
                                    <i class="aq-icon-wrap aq-i-ph-shield-check-light" role="img" aria-hidden="true"/>
                                    <h3>Hygienically Sealed</h3>
                                    <p>Filled and sealed in a clean, controlled environment.</p>
                                </li>
                                <li class="aq-reveal" data-delay="4">
                                    <i class="aq-icon-wrap aq-i-ph-target-light" role="img" aria-hidden="true"/>
                                    <h3>Consistent Taste</h3>
                                    <p>The same clean, fresh taste in every bottle, batch after batch.</p>
                                </li>
                            </ul>
                        </div>
                    </div>
                </section>

                <section class="aq-occasions aq-section s_aquere_occasions" data-snippet="s_aquere_occasions" data-name="Occasions">
                    <div class="aq-container">
                        <div class="aq-split-head">
                            <div>
                                <p class="aq-eyebrow aq-reveal">Made for Every Moment</p>
                                <h2 class="aq-section-title aq-reveal" data-delay="1">Wherever You<br/><em>Need Water.</em></h2>
                            </div>
                            <p class="aq-split-text aq-reveal" data-delay="2">
            From the kitchen table to the boardroom and the banquet hall, AQUÉRÉ brings the same clean,
            dependable quality to every setting.
          </p>
                        </div>
                        <div class="aq-occasion-grid">
                            <figure class="aq-occasion aq-reveal" data-delay="1">
                                <img src="/theme_aquere/static/src/img/photos/pexels-6210568-900.jpg" alt="A glass bottle of water with glasses on a kitchen counter" loading="lazy"/>
                                <figcaption><span>01</span><b>Home</b>Everyday hydration for the whole family.</figcaption>
                            </figure>
                            <figure class="aq-occasion aq-reveal" data-delay="2">
                                <img src="/theme_aquere/static/src/img/photos/pexels-17752147-900.jpg" alt="A hand holding a bottle of water at a desk" loading="lazy"/>
                                <figcaption><span>02</span><b>Office</b>Fresh, reliable water for teams and meetings.</figcaption>
                            </figure>
                            <figure class="aq-occasion aq-reveal" data-delay="3">
                                <img src="/theme_aquere/static/src/img/photos/pexels-7566096-900.jpg" alt="A crystal glass of water held at a restaurant table" loading="lazy"/>
                                <figcaption><span>03</span><b>Hospitality</b>Elegant service for hotels, cafés and restaurants.</figcaption>
                            </figure>
                            <figure class="aq-occasion aq-reveal" data-delay="4">
                                <img src="/theme_aquere/static/src/img/photos/pexels-4252723-900.jpg" alt="A glass water bottle with upturned glasses by a window" loading="lazy"/>
                                <figcaption><span>04</span><b>Events</b>Polished presentation for weddings and celebrations.</figcaption>
                            </figure>
                        </div>
                    </div>
                </section>

                <section class="aq-enquire s_aquere_enquire" id="enquire" data-snippet="s_aquere_enquire" data-name="Enquiry Band">
                    <div class="aq-container">
                        <div class="aq-enquire-box aq-reveal">
                            <div class="aq-nl-ripples" aria-hidden="true">
                                <span/>
                                <span/>
                                <span/>
                            </div>
                            <div>
                                <p class="aq-eyebrow aq-eyebrow--light">For Homes &amp; Businesses</p>
                                <h2 class="aq-enquire-title">Ready to Order <em>AQUÉRÉ?</em></h2>
                                <p class="aq-enquire-text">Tell us what you need, from a few cases for home to regular supply for your business, and we will get back to you.</p>
                            </div>
                            <div class="aq-enquire-actions">
                                <a href="mailto:hello@example.com" class="aq-btn aq-btn-light"><i class="aq-icon aq-i-ph-envelope-simple-light" role="img" aria-hidden="true"/> Email Us</a>
                                <a href="tel:+000000000000" class="aq-btn aq-btn-ghost"><i class="aq-icon aq-i-ph-phone-light" role="img" aria-hidden="true"/> Call Us</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="water_page_page" model="theme.website.page">
        <field name="url">/our-water</field>
        <field name="view_id" ref="water_page"/>
        <field name="is_published" eval="True"/>
        <field name="header_overlay" eval="True"/>
    </record>
</odoo>
