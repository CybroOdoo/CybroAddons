<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Our Process page of the Aquere theme, built from editable sections.
-->
<odoo>
    <template id="process_page" name="Our Process">
        <t t-call="website.layout">
            <t t-set="additional_title">Our Process</t>
            <t t-set="pageName" t-valuef="aquere_process"/>
            <div id="wrap" class="oe_structure oe_empty aq-page-process">
                <section class="aq-process-hero s_aquere_process_hero" data-snippet="s_aquere_process_hero" data-name="Process Hero">
                    <div class="aq-process-hero-bg" aria-hidden="true">
                        <img src="/theme_aquere/static/src/img/photos/pexels-36996794-1600.jpg" alt=""/>
                    </div>
                    <div class="aq-container aq-process-hero-inner">
                        <nav class="aq-crumbs aq-crumbs--light aq-reveal" aria-label="Breadcrumb">
                            <a href="/">Home</a>
                            <i class="aq-icon aq-i-ph-caret-right-light" role="img" aria-hidden="true"/>
                            <span aria-current="page">Our Process</span>
                        </nav>
                        <h1 class="aq-process-title aq-reveal" data-delay="1">From Source<br/><em>to Sealed Bottle.</em></h1>
                        <p class="aq-process-lead aq-reveal" data-delay="2">
          Six carefully controlled stages stand between raw water and the AQUÉRÉ bottle in your hand.
          Each one is monitored, so every drop meets the same standard of purity and safety.
        </p>
                        <ol class="aq-process-rail aq-reveal" data-delay="3">
                            <li>
                                <a href="#stage-1"><span>01</span>Intake</a>
                            </li>
                            <li>
                                <a href="#stage-2"><span>02</span>Filtration</a>
                            </li>
                            <li>
                                <a href="#stage-3"><span>03</span>Reverse Osmosis</a>
                            </li>
                            <li>
                                <a href="#stage-4"><span>04</span>Disinfection</a>
                            </li>
                            <li>
                                <a href="#stage-5"><span>05</span>Filling</a>
                            </li>
                            <li>
                                <a href="#stage-6"><span>06</span>Final Check</a>
                            </li>
                        </ol>
                    </div>
                </section>

                <section class="aq-stages aq-section s_aquere_stages" data-snippet="s_aquere_stages" data-name="Process Stages">
                    <div class="aq-container aq-stages-grid">
                        <aside class="aq-stage-tracker" aria-hidden="true">
                            <p class="aq-eyebrow">The Process</p>
                            <div class="aq-tracker-no">
                                <span class="aq-tracker-current">01</span>
                                <small>/ 06</small>
                            </div>
                            <p class="aq-tracker-name">Intake &amp; Testing</p>
                            <div class="aq-tracker-bar">
                                <span/>
                            </div>
                        </aside>
                        <ol class="aq-stage-list">
                            <li class="aq-stage aq-reveal" id="stage-1" data-name="Intake &amp; Testing">
                                <div class="aq-stage-head">
                                    <span class="aq-stage-icon"><i class="aq-icon aq-i-ph-drop-light" role="img" aria-hidden="true"/></span>
                                    <span class="aq-stage-no">Stage 01</span>
                                </div>
                                <h2>Raw Water Intake &amp; Testing</h2>
                                <p>Every journey begins with carefully selected raw water. Before it enters our plant, it is tested so that purification starts from a known, controlled baseline.</p>
                                <ul class="aq-stage-points">
                                    <li>Carefully selected water source</li>
                                    <li>Tested before treatment begins</li>
                                </ul>
                            </li>
                            <li class="aq-stage aq-reveal" id="stage-2" data-name="Multi-Media Filtration">
                                <div class="aq-stage-head">
                                    <span class="aq-stage-icon"><i class="aq-icon aq-i-ph-funnel-light" role="img" aria-hidden="true"/></span>
                                    <span class="aq-stage-no">Stage 02</span>
                                </div>
                                <h2>Multi-Media Filtration</h2>
                                <p>Sand and activated carbon filters remove suspended particles, sediment, odour and unwanted taste, preparing the water for fine purification.</p>
                                <ul class="aq-stage-points">
                                    <li>Sand filtration for particles and sediment</li>
                                    <li>Activated carbon for odour and taste</li>
                                </ul>
                            </li>
                            <li class="aq-stage aq-reveal" id="stage-3" data-name="Reverse Osmosis">
                                <div class="aq-stage-head">
                                    <span class="aq-stage-icon"><i class="aq-icon aq-i-ph-circles-three-light" role="img" aria-hidden="true"/></span>
                                    <span class="aq-stage-no">Stage 03</span>
                                </div>
                                <h2>Reverse Osmosis</h2>
                                <p>Water is pushed through fine semi-permeable membranes that hold back dissolved impurities, bringing every batch to a clean and consistent standard.</p>
                                <ul class="aq-stage-points">
                                    <li>Fine membrane purification</li>
                                    <li>Consistent quality, batch after batch</li>
                                </ul>
                            </li>
                            <li class="aq-stage aq-reveal" id="stage-4" data-name="UV &amp; Ozonation">
                                <div class="aq-stage-head">
                                    <span class="aq-stage-icon"><i class="aq-icon aq-i-ph-sun-light" role="img" aria-hidden="true"/></span>
                                    <span class="aq-stage-no">Stage 04</span>
                                </div>
                                <h2>UV Treatment &amp; Ozonation</h2>
                                <p>Ultraviolet treatment and ozonation act as disinfection steps, helping to keep the purified water safe and fresh all the way to the bottle.</p>
                                <ul class="aq-stage-points">
                                    <li>Ultraviolet disinfection</li>
                                    <li>Ozonation for lasting freshness</li>
                                </ul>
                            </li>
                            <li class="aq-stage aq-reveal" id="stage-5" data-name="Hygienic Filling">
                                <div class="aq-stage-head">
                                    <span class="aq-stage-icon"><i class="aq-icon aq-i-ph-shield-check-light" role="img" aria-hidden="true"/></span>
                                    <span class="aq-stage-no">Stage 05</span>
                                </div>
                                <h2>Hygienic Filling &amp; Sealing</h2>
                                <p>Clean bottles are filled and sealed in a controlled environment, minimising handling so the water reaches you exactly as it left our purification line.</p>
                                <ul class="aq-stage-points">
                                    <li>Clean, controlled filling area</li>
                                    <li>Securely sealed caps</li>
                                </ul>
                            </li>
                            <li class="aq-stage aq-reveal" id="stage-6" data-name="Final Quality Check">
                                <div class="aq-stage-head">
                                    <span class="aq-stage-icon"><i class="aq-icon aq-i-ph-seal-check-light" role="img" aria-hidden="true"/></span>
                                    <span class="aq-stage-no">Stage 06</span>
                                </div>
                                <h2>Final Quality Check</h2>
                                <p>Finished bottles are inspected and checked for quality before they are packed and dispatched, the last step in our promise of purity.</p>
                                <ul class="aq-stage-points">
                                    <li>Inspection of finished bottles</li>
                                    <li>Checked before dispatch</li>
                                </ul>
                            </li>
                        </ol>
                    </div>
                </section>

                <section class="aq-checkpoints aq-section s_aquere_checkpoints" data-snippet="s_aquere_checkpoints" data-name="Checkpoints">
                    <div class="aq-container">
                        <div class="aq-split-head">
                            <div>
                                <p class="aq-eyebrow aq-reveal">Quality Control</p>
                                <h2 class="aq-section-title aq-reveal" data-delay="1">Checked at<br/><em>Every Stage.</em></h2>
                            </div>
                            <p class="aq-split-text aq-reveal" data-delay="2">
            Quality is not a single test at the end. It is built in from the first drop to the sealed bottle.
            <span class="aq-note">Test parameters, laboratory and certification details will be published here once confirmed.</span>
          </p>
                        </div>
                        <div class="aq-checkpoint-grid">
                            <article class="aq-checkpoint aq-reveal" data-delay="1">
                                <span class="aq-cp-tag">Before</span>
                                <i class="aq-icon-wrap aq-i-ph-drop-light aq-cp-icon" role="img" aria-hidden="true"/>
                                <h3>Raw Water</h3>
                                <p>Incoming water is checked before purification begins.</p>
                            </article>
                            <article class="aq-checkpoint aq-checkpoint--blue aq-reveal" data-delay="2">
                                <span class="aq-cp-tag">During</span>
                                <i class="aq-icon-wrap aq-i-ph-gauge-light aq-cp-icon" role="img" aria-hidden="true"/>
                                <h3>In-Process</h3>
                                <p>Each purification stage is monitored to keep quality consistent.</p>
                            </article>
                            <article class="aq-checkpoint aq-reveal" data-delay="3">
                                <span class="aq-cp-tag">After</span>
                                <i class="aq-icon-wrap aq-i-ph-seal-check-light aq-cp-icon" role="img" aria-hidden="true"/>
                                <h3>Finished Product</h3>
                                <p>Sealed bottles are inspected before they leave our plant.</p>
                            </article>
                        </div>
                    </div>
                </section>

                <section class="aq-hygiene aq-section s_aquere_hygiene" data-snippet="s_aquere_hygiene" data-name="Hygiene">
                    <div class="aq-container aq-hygiene-grid">
                        <figure class="aq-hygiene-media aq-reveal">
                            <img src="/theme_aquere/static/src/img/photos/pexels-4667174-1200.jpg" alt="Close-up of clear, fresh water in a glass with fine bubbles" loading="lazy"/>
                            <figcaption class="aq-glass-card aq-hygiene-badge">
                                <span class="aq-gc-label">Our Standard</span>
                                <span class="aq-gc-value">Clean at every touchpoint.</span>
                            </figcaption>
                        </figure>
                        <div class="aq-hygiene-content">
                            <p class="aq-eyebrow aq-reveal">Hygiene First</p>
                            <h2 class="aq-section-title aq-reveal" data-delay="1">Clean by<br/><em>Design.</em></h2>
                            <p class="aq-hygiene-lead aq-reveal" data-delay="2">
            Purification only matters if the water stays clean afterwards. That is why hygiene is built
            into every part of how we work.
          </p>
                            <ul class="aq-hygiene-list">
                                <li class="aq-reveal" data-delay="1">
                                    <i class="aq-icon-wrap aq-i-ph-buildings-light" role="img" aria-hidden="true"/>
                                    <div>
                                        <h3>Controlled Production Areas</h3>
                                        <p>Clean, organised spaces dedicated to purification and filling.</p>
                                    </div>
                                </li>
                                <li class="aq-reveal" data-delay="2">
                                    <i class="aq-icon-wrap aq-i-ph-hand-soap-light" role="img" aria-hidden="true"/>
                                    <div>
                                        <h3>Clean Bottles &amp; Caps</h3>
                                        <p>Packaging is cleaned and handled with care before filling.</p>
                                    </div>
                                </li>
                                <li class="aq-reveal" data-delay="3">
                                    <i class="aq-icon-wrap aq-i-ph-users-three-light" role="img" aria-hidden="true"/>
                                    <div>
                                        <h3>Hygiene-Conscious Team</h3>
                                        <p>Every team member follows strict handling practices.</p>
                                    </div>
                                </li>
                                <li class="aq-reveal" data-delay="4">
                                    <i class="aq-icon-wrap aq-i-ph-lock-simple-light" role="img" aria-hidden="true"/>
                                    <div>
                                        <h3>Sealed for Protection</h3>
                                        <p>Each bottle is sealed so it stays protected until you open it.</p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </section>

                <section class="aq-story-cta aq-section s_aquere_story_cta" data-snippet="s_aquere_story_cta" data-name="Call to Action">
                    <div class="aq-container">
                        <p class="aq-eyebrow aq-reveal">The Result</p>
                        <h2 class="aq-story-cta-title aq-reveal" data-delay="1">Taste the <em>Purity.</em></h2>
                        <div class="aq-story-cta-actions aq-reveal" data-delay="2">
                            <a href="/our-water" class="aq-btn aq-btn-primary">Explore Our Water <i class="aq-icon aq-i-ph-arrow-up-right-light aq-arrow" role="img" aria-hidden="true"/></a>
                            <a href="/our-water#enquire" class="aq-link-line">Place an Order</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="process_page_page" model="theme.website.page">
        <field name="url">/our-process</field>
        <field name="view_id" ref="process_page"/>
        <field name="is_published" eval="True"/>
        <field name="header_overlay" eval="True"/>
    </record>
</odoo>
