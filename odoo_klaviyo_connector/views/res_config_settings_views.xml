<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Inherited view of res config settings to add the configuration details for the authentication-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.odoo.klaviyo.connector
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[hasclass('oe_form_configuration')]" position="inside">
                <app string="Klaviyo" name="odoo_klaviyo_connector">
                    <block title="Authentication" id="klaviyo_auth_settings">
                        <setting id="api_key_setting" string="API Key">
                            <div class="content-group">
                                <field name="api_key"
                                       class="text-center oe_inline"/>
                                <div class="mt16">
                                    <button class="btn btn-primary"
                                            type="object"
                                            name="action_test_connection"
                                            string="Test"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Configuration" id="klaviyo_config_settings">
                        <setting id="import_data_setting" string="Import Data"
                                 help="Enable if you want to import data from Klaviyo">
                            <field name="import_data"
                                   widget="boolean_toggle"/>
                        </setting>
                        <setting id="export_data_setting" string="Export Data"
                                 help="Enable if you want to export data to Klaviyo">
                            <field name="export_data"
                                   widget="boolean_toggle"/>
                        </setting>
                        <setting id="execute_operations_setting">
                            <button type="object"
                                    string="Execute Operation(s)"
                                    name="action_execute_operation"
                                    class="btn btn-primary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
