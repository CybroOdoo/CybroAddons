<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Inherited view of res config settings to add the configuration details for the authentication-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo.klaviyo.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Klaviyo" string="Klaviyo"
                     name="odoo_klaviyo_connector">
                    <block title="Authentication" name="Authentication">
                        <setting
                                title="This tool is advised if your marketing campaign is composed of several emails."
                                help="Manage mass mailing campaigns">
                            <field name="api_key" password="True"
                                   widget="password"/>
                            <button class="btn btn-primary"
                                    type="object"
                                    name="action_test_connection"
                                    string="Test"/>
                        </setting>
                    </block>
                    <block title="Configuration" name="Configuration">
                        <div class="row mt16 o_settings_container d-flex justify-content-between">
                            <div class="col-lg-6 o_setting_box d-flex align-items-center">
                                <div class="o_setting_left_pane me-2">
                                    <field name="import_data"
                                           widget="boolean_toggle"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="import_data"
                                           string="Import Data"/>
                                    <div class="text-muted">Enable if you want
                                        to import data from Klaviyo
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 o_setting_box d-flex align-items-center">
                                <div class="o_setting_left_pane me-2">
                                    <field name="export_data"
                                           widget="boolean_toggle"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="export_data"
                                           string="Export Data"/>
                                    <div class="text-muted">Enable if you want
                                        to export data to Klaviyo
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container">
                            <div class="col-lg-6 o_setting_box">
                                <button type="object"
                                        string="Execute Operation(s)"
                                        name="action_execute_operation"
                                        class="btn btn-primary"/>
                            </div>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
