<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Tracks sensitive actions like order deletion, orderline deletion, and session closing for audit purposes. -->
    <record id="pos_action_log_view_list" model="ir.ui.view">
        <field name="name">pos.action.log.view.tree</field>
        <field name="model">pos.action.log</field>
        <field name="arch" type="xml">
            <tree string="Manager Approval" create="0" delete="0">
                <field name="create_date"/>
                <field name="order_ref"/>
                <field name="user_id"/>
                <field name="approved_by"/>
                <field name="action_type" widget="badge"
                       decoration-info="action_type == 'delete_order' or action_type == 'session_close'"
                       decoration-danger="action_type == 'orderline_delete'"/>
            </tree>
        </field>
    </record>

 <!-- Search view providing filters and grouping options for manager approval logs. -->
    <record id="pos_action_log_view_search" model="ir.ui.view">
        <field name="name">pos.action.log.view.search</field>
        <field name="model">pos.action.log</field>
        <field name="arch" type="xml">
            <search string="Search Manager Approval">
                <field name="user_id"/>
                <field name="order_ref"/>
                <field name="action_type"/>
                <filter string="Order Deleted" name="order_deleted" domain="[('action_type', '=', 'delete_order')]"/>
                <filter string="Orderline Deleted" name="orderline_deleted" domain="[('action_type', '=', 'orderline_delete')]"/>
                <filter string="Session Close" name="session_close" domain="[('action_type', '=', 'session_close')]"/>
                <filter string="Action Type" name="group_by_action_type" domain="[]" context="{'group_by': 'action_type'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="pos_action_log_action" model="ir.actions.act_window">
        <field name="name">Manager Approval</field>
        <field name="res_model">pos.action.log</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="pos_action_log_view_search"/>
    </record>

    <!-- Menu Item (Under Orders) -->
    <menuitem id="menu_pos_manager_approval"
              name="Manager Approval"
              parent="point_of_sale.menu_point_of_sale"
              action="pos_action_log_action"
              sequence="20"/>
</odoo>