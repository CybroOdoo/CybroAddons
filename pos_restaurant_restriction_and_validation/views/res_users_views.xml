<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds POS security PIN field to user form for restricting sensitive Point of Sale operations. -->
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.pos.restaurant.restriction.and.validation</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//group" position="inside">
                <group string="Point of Sale Security">
                    <field name="pos_security_pin" password="True"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
