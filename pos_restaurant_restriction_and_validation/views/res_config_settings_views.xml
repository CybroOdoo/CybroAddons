<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <!-- Adds POS restaurant restriction settings to control operations like order edit, delete, and session close after kitchen submission. -->   
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.restaurant.restriction.and.validation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_restaurant.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='iface_splitbill']" position="after">
                <setting id="restaurant_restriction" help="Enable restriction on some operations once the order has been sent to the kitchen">
                    <field name="pos_restaurant_restriction" string="Restaurant Restriction"/>
                    <div class="content-group" invisible="not pos_restaurant_restriction">
                        <div class="mt8">
                            <field name="pos_orderline_quantity_update" class="oe_inline"/>
                            <label for="pos_orderline_quantity_update" string="Orderline Quantity Update"/>
                        </div>
                        <div class="mt8">
                            <field name="pos_orderline_delete" class="oe_inline"/>
                            <label for="pos_orderline_delete" string="Orderline Delete"/>
                        </div>
                        <div class="mt8">
                            <field name="pos_order_delete" class="oe_inline"/>
                            <label for="pos_order_delete" string="Order Delete"/>
                        </div>
                        <div class="mt8">
                            <field name="pos_session_close" class="oe_inline"/>
                            <label for="pos_session_close" string="Session Close"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
