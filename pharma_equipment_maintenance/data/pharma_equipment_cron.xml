<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily: refresh calibration states and remind ahead of the due date. -->
    <record id="ir_cron_pharma_calibration_due" model="ir.cron">
        <field name="name">Pharma: Equipment Calibration Due</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_pharma_calibration_due()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Daily: refresh qualification states and remind ahead of requalification. -->
    <record id="ir_cron_pharma_qualification_due" model="ir.cron">
        <field name="name">Pharma: Equipment Requalification Due</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_pharma_qualification_due()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Hourly: expire clean and sterile holds that have run out. -->
    <record id="ir_cron_pharma_hold_expiry" model="ir.cron">
        <field name="name">Pharma: Equipment Hold Expiry</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_pharma_hold_expiry()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
