<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- GMP defaults on the equipment category. -->
    <record id="maintenance_equipment_category_view_form_pharma" model="ir.ui.view">
        <field name="name">maintenance.equipment.category.form.pharma</field>
        <field name="model">maintenance.equipment.category</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='technician_user_id']" position="before">
                <field name="equipment_class"/>
                <field name="pharma_sterile" invisible="equipment_class != 'manufacturing'"
                       groups="pharma_equipment_maintenance.group_pharma_sterile_mfg"/>
                <field name="gmp_critical"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_equipment_category_view_list_pharma" model="ir.ui.view">
        <field name="name">maintenance.equipment.category.list.pharma</field>
        <field name="model">maintenance.equipment.category</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_category_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='technician_user_id']" position="before">
                <field name="equipment_class"/>
                <field name="pharma_sterile" optional="show"
                       groups="pharma_equipment_maintenance.group_pharma_sterile_mfg"/>
                <field name="gmp_critical"/>
            </xpath>
        </field>
    </record>

    <record id="pharma_equipment_category_action" model="ir.actions.act_window">
        <field name="name">Equipment Categories</field>
        <field name="res_model">maintenance.equipment.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="maintenance.hr_equipment_category_view_tree"/>
    </record>
</odoo>
