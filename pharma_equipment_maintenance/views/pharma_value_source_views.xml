<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Equipment a registered device belongs to. -->
    <record id="pharma_value_source_list_equipment" model="ir.ui.view">
        <field name="name">pharma.value.source.list.equipment</field>
        <field name="model">pharma.value.source</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_value_source_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_type']" position="after">
                <field name="equipment_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
