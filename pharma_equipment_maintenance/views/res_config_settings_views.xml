<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Equipment settings, shown under the Equipment toggle. -->
    <record id="res_config_settings_view_form_pharma_equipment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pharma.equipment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pharmaceutical_base.res_config_settings_view_form_pharmaceutical_base"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pharmaceutical_base_module_equipment_maintenance']" position="after">
                <setting id="pharma_equipment_check" string="Equipment Check"
                         help="On confirming a manufacturing order on unfit equipment, or entering a result on an instrument out of calibration. Block stops it (QA can override an order); Warn lets it through and records it."
                         invisible="not module_pharma_equipment_maintenance">
                    <field name="pharma_equipment_check" widget="radio" options="{'horizontal': true}"/>
                </setting>
                <setting id="pharma_sterile_mfg" string="Sterile Manufacturing"
                         help="Injectables and other sterile products: equipment must be clean and sterile. Off, no sterile field, menu or rule appears anywhere."
                         invisible="not module_pharma_equipment_maintenance">
                    <field name="group_pharma_sterile_mfg"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
