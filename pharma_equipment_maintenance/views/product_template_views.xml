<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sterile product flag, on sterile sites only. -->
    <record id="product_template_form_pharma_sterile" model="ir.ui.view">
        <field name="name">product.template.form.pharma.sterile</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="pharmaceutical_base.product_template_form_pharma"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pharmacopoeial_ref']" position="after">
                <field name="pharma_sterile_product"
                       groups="pharma_equipment_maintenance.group_pharma_sterile_mfg"/>
            </xpath>
        </field>
    </record>
</odoo>
