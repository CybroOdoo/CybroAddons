<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maintenance activity by type and GMP status. -->
    <record id="pharma_maintenance_request_report_pivot" model="ir.ui.view">
        <field name="name">maintenance.request.pivot.pharma</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Activity" sample="1">
                <field name="maintenance_type" type="row"/>
                <field name="pharma_state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="pharma_maintenance_request_report_graph" model="ir.ui.view">
        <field name="name">maintenance.request.graph.pharma</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <graph string="Maintenance Activity" type="bar" stacked="1" sample="1">
                <field name="request_date" interval="month"/>
                <field name="maintenance_type"/>
            </graph>
        </field>
    </record>

    <record id="pharma_maintenance_request_report_action" model="ir.actions.act_window">
        <field name="name">Maintenance Activity</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('pharma_maintenance_request_report_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('pharma_maintenance_request_report_pivot')})]"/>
    </record>

    <!-- Equipment fitness across the register. -->
    <record id="pharma_equipment_report_pivot" model="ir.ui.view">
        <field name="name">maintenance.equipment.pivot.pharma</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <pivot string="Equipment Status" sample="1">
                <field name="equipment_class" type="row"/>
                <field name="calibration_state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="pharma_equipment_report_action" model="ir.actions.act_window">
        <field name="name">Equipment Status</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="context">{'search_default_gmp_critical': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('pharma_equipment_report_pivot')})]"/>
    </record>

    <menuitem id="menu_pharma_report_maintenance" name="Maintenance Activity"
              parent="pharmaceutical_base.menu_pharma_reporting"
              action="pharma_maintenance_request_report_action" sequence="70"/>

    <menuitem id="menu_pharma_report_equipment" name="Equipment Status"
              parent="pharmaceutical_base.menu_pharma_reporting"
              action="pharma_equipment_report_action" sequence="75"/>
</odoo>
