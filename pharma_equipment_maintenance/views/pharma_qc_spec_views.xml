<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Suggested instrument per test parameter. -->
    <record id="pharma_qc_spec_line_view_list_instrument" model="ir.ui.view">
        <field name="name">pharma.qc.spec.line.list.instrument</field>
        <field name="model">pharma.qc.spec.line</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_qc_spec_line_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='test_method']" position="after">
                <field name="default_instrument_id" optional="show" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
