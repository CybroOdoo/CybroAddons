<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- GMP equipment checked for orders routed through the work centre. -->
    <record id="mrp_workcenter_form_pharma_equipment" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.pharma.equipment</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="GMP Equipment" name="pharma_equipment">
                    <field name="pharma_equipment_ids"
                           domain="[('equipment_class', '!=', 'testing')]">
                        <list>
                            <field name="equipment_code"/>
                            <field name="name"/>
                            <field name="equipment_class"/>
                            <field name="gmp_critical"/>
                            <field name="qualification_state"/>
                            <field name="calibration_state"/>
                            <field name="cleaning_state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
