<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="pharmaceutical_base.PharmaDashboard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('top-columns-grid')]" position="after">
            <div class="o_pharma_equipment_tiles" t-if="this.state.equipmentAvailable">
                <div class="card-box qms-kpi-card" t-on-click="() => this.openEquipmentTile('gmp')">
                    <div class="kpi-header-row">
                        <div class="kpi-icon"><i class="oi" data-icon="settings"/></div>
                        <span class="kpi-title">GMP Equipment</span>
                    </div>
                    <div class="kpi-footer-row">
                        <span class="kpi-value"><t t-out="this.state.eqGmpCritical"/></span>
                        <span class="kpi-subtext">GMP-critical items in the register</span>
                    </div>
                </div>
                <div class="card-box qms-kpi-card" t-on-click="() => this.openEquipmentTile('maintenance')">
                    <div class="kpi-header-row">
                        <div class="kpi-icon"><i class="oi" data-icon="build"/></div>
                        <span class="kpi-title">Under Maintenance</span>
                    </div>
                    <div class="kpi-footer-row">
                        <span class="kpi-value"><t t-out="this.state.eqUnderMaintenance"/></span>
                        <span class="kpi-subtext">With open work not yet QA verified</span>
                    </div>
                </div>
                <div class="card-box qms-kpi-card" t-on-click="() => this.openEquipmentTile('calibration')">
                    <div class="kpi-header-row">
                        <div class="kpi-icon"><i class="oi" data-icon="speed"/></div>
                        <span class="kpi-title">Calibrations Due</span>
                    </div>
                    <div class="kpi-footer-row">
                        <span class="kpi-value"><t t-out="this.state.eqCalibrationDue"/></span>
                        <span class="kpi-subtext">Due soon or out of calibration</span>
                    </div>
                </div>
                <div class="card-box qms-kpi-card" t-on-click="() => this.openEquipmentTile('preventive')">
                    <div class="kpi-header-row">
                        <div class="kpi-icon"><i class="oi" data-icon="event_available"/></div>
                        <span class="kpi-title">Preventive Tasks</span>
                    </div>
                    <div class="kpi-footer-row">
                        <span class="kpi-value"><t t-out="this.state.eqPreventiveOpen"/></span>
                        <span class="kpi-subtext">Open preventive maintenance</span>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
