<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QA requalifies qualified equipment now, without waiting for the due date. -->
    <record id="pharma_equipment_requalify_wizard_view_form" model="ir.ui.view">
        <field name="name">pharma.equipment.requalify.wizard.form</field>
        <field name="model">pharma.equipment.requalify.wizard</field>
        <field name="arch" type="xml">
            <form string="Requalify Equipment">
                <div class="alert alert-info" role="alert">
                    Record an approved requalification. The qualification is renewed from
                    the date below, and your name, the protocol and the reason are recorded
                    on the equipment.
                </div>
                <group>
                    <group>
                        <field name="equipment_id"/>
                        <field name="previous_qualification_date"/>
                        <field name="previous_requalification_date"/>
                    </group>
                    <group>
                        <field name="requalified_on"/>
                        <field name="next_requalification_date" required="1"/>
                        <field name="protocol_ref"/>
                    </group>
                </group>
                <group>
                    <field name="reason" placeholder="Periodic requalification, relocation, major repair, change of use..."/>
                </group>
                <footer>
                    <button name="action_requalify" type="object" string="Requalify"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="pharma_equipment_requalify_wizard_action" model="ir.actions.act_window">
        <field name="name">Requalify Equipment</field>
        <field name="res_model">pharma.equipment.requalify.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_equipment_id': active_id}</field>
        <field name="group_ids" eval="[(4, ref('pharmaceutical_base.group_pharma_qa_manager'))]"/>
    </record>
</odoo>
