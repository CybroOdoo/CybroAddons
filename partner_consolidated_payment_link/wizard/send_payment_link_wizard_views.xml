<?xml version="1.0" encoding="UTF-8" ?>
<!-- View and action definitions for Send Payment Link Wizard -->
<odoo>
    <record id="send_payment_link_wizard_view_form" model="ir.ui.view">
        <field name="name">send.payment.link.wizard.view.form</field>
        <field name="model">send.payment.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Payment Link">
                <div class="o_dialog_confirmation p-3">
                    <field name="partner_id" invisible="1"/>
                    <p class="mb-0" style="font-size: 14px; line-height: 1.6;">
                        Are you sure you want to send a payment link email to
                        <strong><field name="partner_id" readonly="1" class="oe_inline"/></strong>?
                    </p>
                </div>
                <footer>
                    <button name="action_send_mail" string="Send Email" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="send_payment_link_wizard_action" model="ir.actions.act_window">
        <field name="name">Send Payment Link</field>
        <field name="res_model">send.payment.link.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>
</odoo>