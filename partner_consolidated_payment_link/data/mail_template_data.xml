<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Email Template for the Payment Link -->
    <record id="email_template_payment_link" model="mail.template">
        <field name="name">Consolidated Payment Link for Customer</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Consolidated Payment Link from {{ object.company_id.name }}</field>
        <field name="email_from">"{{ object.company_id.name }}" &lt;{{ object.company_id.email or user.email }}&gt;</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.name or ''"/>,
                    <br/><br/>
                    Thank you for your business with <t t-out="object.company_id.name or ''"/>.
                    <br/><br/>
                    You can view and pay your outstanding balance by clicking the link below:
                    <br/><br/>
                    <div style="text-align: center; margin-top: 16px;">
                        <a t-att-href="ctx.get('payment_link')"
                           style="background-color: #875A7B; padding: 10px 20px; color: #FFFFFF; text-decoration: none; border-radius: 5px; font-size: 14px;">
                            Pay Now
                        </a>
                    </div>
                    <br/><br/>
                    If you have any questions, please do not hesitate to contact us.
                    <br/><br/>
                    Best regards,
                    <br/>
                    <t t-out="object.company_id.name or ''"/> Team
                </p>
            </div>
        </field>
        <field name="lang">{{ object.lang }}</field>
    </record>
</odoo>
