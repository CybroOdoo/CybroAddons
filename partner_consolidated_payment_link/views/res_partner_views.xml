<?xml version="1.0" encoding="UTF-8" ?>
<!-- View definition for inheriting partner form to add Send Consolidated Payment Link stat button -->
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.partner.consolidated.payment.link</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button"
                        type="action"
                        name="%(partner_consolidated_payment_link.send_payment_link_wizard_action)d"
                        icon="fa-money"
                        invisible="type != 'contact'">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Send Consolidated Payment</span>
                        <span class="o_stat_text">Link</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>