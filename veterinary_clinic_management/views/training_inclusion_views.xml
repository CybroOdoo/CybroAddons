<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View for Training Inclusions -->
    <record id="training_inclusion_view_list" model="ir.ui.view">
        <field name="name">training.inclusion.view.list</field>
        <field name="model">training.inclusion</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <!-- Fields displayed in the list view -->
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <!-- Action for Training Inclusions -->
    <record id="training_inclusion_action" model="ir.actions.act_window">
        <field name="name">Training Inclusion</field>
        <field name="res_model">training.inclusion</field>
        <field name="view_mode">list</field>
    </record>
    <!-- Menu Items for Training Inclusions -->
    <menuitem id="medicine_details_menu" name="Medicine Details" parent="configuration_menu"/>
    <menuitem id="training_inclusion_menu" name="Inclusions" action="training_inclusion_action"
              parent="medicine_details_menu" sequence="1" />
</odoo>
