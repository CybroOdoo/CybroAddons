<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- list view definition for case.appointments model -->
    <record id="case_appointments_view_list" model="ir.ui.view">
        <field name="name">case.appointments.view.list</field>
        <field name="model">case.appointments</field>
        <field name="arch" type="xml">
            <list string="Animal">
                <!-- Fields to be displayed in the list view -->
                <field name="case_no"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="nurse_id"/>
            </list>
        </field>
    </record>
    <!-- Form view definition for case.appointments model -->
    <record id="case_appointments_view_form" model="ir.ui.view">
        <field name="name">case.appointments.appointment.form</field>
        <field name="model">case.appointments</field>
        <field name="arch" type="xml">
            <form string="Animal">
                <header>
                    <!-- Buttons for different actions based on state -->
                    <button name="action_confirm" string="Confirm Appointment" class="oe_highlight" type="object" invisible=" state != 'draft'"/>
                    <button name="action_create_prescription" string="Create prescription" class="oe_highlight" type="object" invisible=" state != 'in-consultation'"/>
                    <button name="action_schedule_surgery" string="Schedule Surgery" class="oe_highlight" type="object" invisible=" state != 'in-consultation'"/>
                    <button name="action_cancel" string="Cancel" class="btn-secondary" type="object"/>
                    <!-- Status bar for appointment state -->
                    <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Buttons for viewing invoices, surgery records, and prescription records -->
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" string="Invoices" invisible="invoice_count in [0]">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_get_surgery_record" class="oe_stat_button" type="object" icon="fa-user-md">
                            <field string="Surgery" name="surgery_count" widget="statinfo"/>
                        </button>
                        <button name="action_get_prescription_record" class="oe_stat_button" type="object" icon="fa-thumb-tack">
                            <field string="Prescription" name="prescription_count" widget="statinfo"/>
                        </button>
                    </div>
                    <!-- Ribbon widget for payment status -->
                    <field name="payment_ribbon" invisible='1'/>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="payment_ribbon != 'paid'"/>
                    <!-- Case number field -->
                    <field name="case_no" readonly="True" style="font-size:50px;color:black;"/>
                    <group string="ANIMAL DETAILS">
                        <group>
                            <!-- Fields for patient, doctor, and owner details -->
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="owner_id" invisible="1"/>
                        </group>
                        <group>
                            <!-- Fields for appointment date and nurse details -->
                            <field name="appointment_date"/>
                            <field name="closed_date" invisible="state != 'close'"/>
                            <field name="nurse_id"/>
                        </group>
                    </group>
                    <!-- Procedure details group (visible only in 'in-consultation' state) -->
                    <group string="PROCEDURE DETAILS" invisible="state != 'in-consultation'">
                        <group>
                            <!-- Checkboxes for treatment and vaccination -->
                            <field name="is_treated" widget="checkbox"/>
                            <field name="is_vaccinated" widget="checkbox"/>
                        </group>
                        <group>
                            <!-- Checkbox for admission status -->
                            <field name="is_admitted" widget="checkbox"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Disease Details page -->
                        <page string="Disease Details">
                            <group>
                                <!-- Fields for disease name and description -->
                                <field name="disease_name_ids" widget="many2many_tags"/>
                                <field name="disease_desc" placeholder="Disease Description"/>
                            </group>
                        </page>
                        <!-- Treatment page (visible only if treatment is checked) -->
                        <page string="Treatment" name="treatment_line_ids" invisible="not is_treated">
                            <field name="treatment_line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="precaution"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="charges"/>
                                </list>
                            </field>
                            <group>
                                <div style="margin-left:980px;" string="Total">
                                    <!-- Fields for currency and total treatment charges -->
                                    <field name="currency_id" invisible="1"/>
                                    <field name="treatment_total"/>
                                </div>
                            </group>
                        </page>
                        <!-- Medical Reports page -->
                        <page string="Medical Tests" name="medical_report_line_ids">
                            <button name="action_create_medical_report" string="Create Medical Test" class="btn-primary" type="object"/>
                            <field name="medical_report_line_ids">
                                <list editable="bottom">
                                    <field name="report_id"/>
                                    <field name="date"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="lab_technician_id"/>
                                    <field name="document"/>
                                    <field name="stages"/>
                                    <field name="price"/>
                                </list>
                            </field>
                        </page>
                        <!-- Admit Details page (visible only if admitted) -->
                        <page string="Admit Details" invisible="not is_admitted">
                            <group>
                                <group>
                                    <!-- Fields for room, admit date, and total hours -->
                                    <field name="room_id"/>
                                    <field name="admit_date"/>
                                    <field name="total_hours"/>
                                </group>
                                <group>
                                    <!-- Fields for table number, discharge date, room charge, and total amount -->
                                    <field name="table_no"/>
                                    <field name="discharge_date"/>
                                    <field name="room_charge"/>
                                    <field name="total_amount"/>
                                </group>
                            </group>
                        </page>
                        <!-- Vaccination page (visible only if vaccination is checked) -->
                        <page string="Vaccination" name="procedure_vaccination_history_line_ids" invisible="not is_vaccinated">
                            <field name="procedure_vaccination_history_line_ids">
                                <list editable="bottom">
                                    <field name="vaccine_id"/>
                                    <field name="vaccination_date"/>
                                    <field name="description"/>
                                    <field name="charge"/>
                                </list>
                            </field>
                            <group>
                                <div style="margin-left:980px;" string="Total">
                                    <!-- Fields for currency and total vaccination charges -->
                                    <field name="currency_id" invisible="1"/>
                                    <field name="vaccine_total"/>
                                </div>
                            </group>
                        </page>
                        <!-- Medical Bill page -->
                        <page string="Medical Bill" name="medical_bill_line_ids">
                            <field name="is_invoiced" invisible="1"/>
                            <button name="action_create_invoice" string="Create Invoice" class="btn-primary" type="object"
                                    invisible=" state != 'in-consultation' or is_invoiced"/>
                            <field name="medical_bill_line_ids">
                                <list editable="bottom">
                                    <field name="service_type_id"/>
                                    <field name="invoice_for"/>
                                    <field name="date"/>
                                    <field name="description"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter widget for messages and followers -->
                <chatter/>
            </form>
        </field>
    </record>
    <!-- Search view definition for case.appointments model -->
    <record id="case_appointments_view_search" model="ir.ui.view">
        <field name="name">case.appointments.appointment.search</field>
        <field name="model">case.appointments</field>
        <field name="arch" type="xml">
            <search>
                <!-- Fields available for search -->
                <field name="case_no"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="nurse_id"/>
            </search>
        </field>
    </record>
    <!-- Action to open case.appointments model views -->
    <record id="case_appointments_action" model="ir.actions.act_window">
        <field name="name">Appointment Cases</field>
        <field name="res_model">case.appointments</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Menu item for Appointment/Cases under Procedure menu -->
    <menuitem id="appointment_menu" name="Appointments" parent="veterinary_clinic_management_menu_root" sequence="2">
        <menuitem id="case_appointments_menu" action="case_appointments_action" name="Appointment/Cases" sequence="1"/>
    </menuitem>
</odoo>