<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- list View Definition for medical.report Model -->
        <record id="medical_report_view_list" model="ir.ui.view">
            <field name="name">medical.report.view.list</field>
            <field name="model">medical.report</field>
            <field name="arch" type="xml">
                <list default_group_by="report_type_id">
                    <!-- Fields to be displayed in the list view -->
                    <field name="patient_id"/>
                    <field name="case_id"/>
                    <field name="report_type_id"/>
                    <field name="price"/>
                    <field name="report_date"/>
                    <field name="lab_technician_id"/>
                </list>
            </field>
        </record>
        <!-- Form View Definition for medical.report Model -->
        <record id="medical_report_view_form" model="ir.ui.view">
            <field name="name">medical.report.view.form</field>
            <field name="model">medical.report</field>
            <field name="arch" type="xml">
                <form string="Medical Report">
                    <header>
                        <!-- Status bar for report state -->
                        <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                        <!-- Button to confirm the report -->
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                                invisible=" state != 'new'"/>
                        <field name="is_invoiced" invisible="1"/>
                        <!-- Button to create an invoice -->
                        <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight"
                                invisible=" state != 'in-progress' or is_invoiced"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <!-- Button to view invoices -->
                            <button name="action_view_invoice" type="object" class="oe_stat_button"
                                    icon="fa-pencil-square-o" string="Invoices" invisible="invoice_count in [0]">
                                <field name="invoice_count" widget="statinfo" string="Invoices"/>
                            </button>
                        </div>
                        <!-- Ribbon to indicate payment status -->
                        <field name="payment_ribbon" invisible='1'/>
                        <widget name="web_ribbon" title="Paid" bg_color="text-bg-success"
                                invisible="payment_ribbon != 'paid'"/>
                        <!-- Group for report details -->
                        <group string="REPORT DETAILS">
                            <group>
                                <field name="patient_id"/>
                                <field name="case_id"/>
                                <field name="report_type_id"/>
                                <field name="price"/>
                                <field name="document" filename="document_filename"/>
                            </group>
                            <group>
                                <field name="report_date"/>
                                <field name="lab_technician_id"/>
                            </group>
                        </group>
                        <!-- Group for patient details -->
                        <group string="Patient Details">
                            <group>
                                <field name="pet_name_id"/>
                                <field name="pet_type_id"/>
                                <field name="breed_id"/>
                                <field name="gender"/>
                                <field name="age"/>
                            </group>
                            <group>
                                <field name="behavior"/>
                                <field name="weight"/>
                                <field name="height"/>
                                <field name="blood_type"/>
                                <field name="rh"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Action to Open medical.report Model Views -->
        <record id="medical_report_action" model="ir.actions.act_window">
            <field name="name">Medical Reports</field>
            <field name="res_model">medical.report</field>
            <field name="view_mode">list,form</field>
        </record>
        <!-- Menu Item for Medical Reports -->
        <menuitem id="medical_report_menu" name="Medical Tests" action="medical_report_action"
                  parent="veterinary_clinic_management_menu_root" sequence="7"/>
    </data>
</odoo>
