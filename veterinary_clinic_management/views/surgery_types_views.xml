<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--List View for Surgery Types -->
    <record id="surgery_types_view_list" model="ir.ui.view">
        <field name="name">surgery.types.view.list</field>
        <field name="model">surgery.types</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <!-- Fields displayed in the list view -->
                <field name="name"/>
                <field name="charge"/>
            </list>
        </field>
    </record>
    <!-- Action for Surgery Types -->
    <record id="surgery_types_menu_action" model="ir.actions.act_window">
        <field name="name">Surgery Types</field>
        <field name="res_model">surgery.types</field>
        <field name="view_mode">list</field>
    </record>
    <!-- Menu Item for Surgery Types -->
    <menuitem id="surgery_types_menu" action="surgery_types_menu_action" name="Surgery Details"
              parent="configuration_types_menu" sequence="5"/>
</odoo>
