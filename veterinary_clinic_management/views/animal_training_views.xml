<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- list view definition for animal.training model -->
    <record id="animal_training_view_list" model="ir.ui.view">
        <field name="name">animal.training.view.list</field>
        <field name="model">animal.training</field>
        <field name="arch" type="xml">
            <list string="Animal" default_group_by="package_id">
                <!-- Fields to be displayed in the list view -->
                <field name="training_no"/>
                <field name="appointment_date"/>
                <field name="animal_id"/>
                <field name="package_id"/>
                <field name="charge"/>
                <field name="training_emp_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <!-- Form view definition for animal.training model -->
    <record id="animal_training_view_form" model="ir.ui.view">
        <field name="name">animal.training.view.form</field>
        <field name="model">animal.training</field>
        <field name="arch" type="xml">
            <form string="Training">
                <header>
                    <!-- Statusbar for state field -->
                    <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                    <field name="is_invoice" invisible="1"/>
                    <!-- Button to create invoice, visible based on conditions -->
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight" invisible="state != 'in-consultation' or is_invoice"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Button to view invoices, visible when there are invoices -->
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" string="Invoices" invisible="invoice_count in [0]">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <!-- Ribbon widget for paid status -->
                    <field name="payment_ribbon" invisible='1'/>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="payment_ribbon != 'paid'"/>
                    <!-- Display training number prominently -->
                    <field name="training_no" readonly="True" style="font-size:50px;color:black;"/>
                    <group string="APPOINTMENT DETAILS">
                        <group>
                            <field name="appointment_date"/>
                            <field name="closed_date" invisible="state != 'close'"/>
                            <field name="training_emp_id"/>
                        </group>
                        <group>
                            <field name="animal_id"/>
                            <field name="animal_type_id"/>
                            <field name="breed_id"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Page for Training Package details -->
                        <page string="Training Package">
                            <group>
                                <group>
                                    <field name="package_id"/>
                                    <field name="package_duration"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="charge"/>
                                    <field name="training_invoice_id"/>
                                </group>
                                <group>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="signature" widget="signature" class="oe_sign"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!-- Action to open animal.training model views -->
    <record id="animal_training_action" model="ir.actions.act_window">
        <field name="name">Training</field>
        <field name="res_model">animal.training</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Menu items for the Training module -->
    <menuitem id="training_appointment_menu" action="animal_training_action" name="Training"
                  parent="appointment_menu" sequence="3"/>
</odoo>
