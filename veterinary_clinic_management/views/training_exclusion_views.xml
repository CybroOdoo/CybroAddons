<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View for Training Exclusions -->
    <record id="training_exclusion_view_list" model="ir.ui.view">
        <field name="name">training.exclusion.view.list</field>
        <field name="model">training.exclusion</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <!-- Fields displayed in the list view -->
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <!-- Action for Training Exclusions -->
    <record id="training_exclusion_action" model="ir.actions.act_window">
        <field name="name">Training Exclusion</field>
        <field name="res_model">training.exclusion</field>
        <field name="view_mode">list</field>
    </record>
    <!-- Menu Item for Training Exclusions -->
    <menuitem id="training_exclusion_menu" name="Exclusions" action="training_exclusion_action"
              parent="medicine_details_menu" sequence="2" />
</odoo>
