<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <!-- This XML file defines a modification to the account.move form view in Odoo -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.veterinary.clinic.management</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']"
                   position="after">
                <field name="medical_bill_invoice_id" invisible="1"/>
                <field name="grooming_bill_invoice_id" invisible="1"/>
                <field name="training_bill_invoice_id" invisible="1"/>
                <field name="maintenance_bill_invoice_id" invisible="1"/>
                <field name="medical_test_bill_invoice_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
