<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Search view for animal.grooming model -->
    <record id="animal_grooming_view_search" model="ir.ui.view">
        <field name="name">animal.grooming.view.search</field>
        <field name="model">animal.grooming</field>
        <field name="arch" type="xml">
            <search>
                <!-- Search fields -->
                <field name="patient_name_id"/>
                <field name="grooming_employee_id"/>
                <field name="state"/>
                <!-- Group By options -->
                <group expand="1" string="Group By">
                    <filter string="Animal" name="patient_name_id" context="{'group_by':'patient_name_id'}"/>
                    <filter string="Grooming Employee" name="grooming_employee_id" context="{'group_by':'grooming_employee_id'}"/>
                    <filter string="State" name="breed_id" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <!-- list view for animal.grooming model -->
    <record id="animal_grooming_view_list" model="ir.ui.view">
        <field name="name">animal.grooming.view.list</field>
        <field name="model">animal.grooming</field>
        <field name="arch" type="xml">
            <list string="Animal" default_group_by="patient_name_id">
                <!-- list view fields -->
                <field name="appointment_date"/>
                <field name="patient_name_id"/>
                <field name="grooming_employee_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <!-- Form view for animal.grooming model -->
    <record id="animal_grooming_view_form" model="ir.ui.view">
        <field name="name">animal.grooming.view.form</field>
        <field name="model">animal.grooming</field>
        <field name="arch" type="xml">
            <form string="Animal">
                <header>
                    <!-- Statusbar for state field -->
                    <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                    <field name="is_invoice" invisible="1"/>
                    <!-- Button to create invoice, visible based on conditions -->
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight"
                            invisible="state != 'in-consultation' or is_invoice"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Button to view invoices, visible when there are invoices -->
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" string="Invoices" invisible="invoice_count in [0]">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <!-- Ribbon widget for paid status -->
                    <field name="payment_ribbon" invisible='1'/>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="payment_ribbon != 'paid'"/>
                    <!-- Display grooming number prominently -->
                    <field name="grooming_no" readonly="True" style="font-size:50px;color:black;"/>
                    <group string="APPOINTMENT DETAILS">
                        <group>
                            <field name="appointment_date"/>
                            <field name="closed_date" invisible="state != 'close'"/>
                        </group>
                        <group>
                            <field name="patient_name_id"/>
                        </group>
                    </group>
                    <group string="GROOMING DETAILS">
                        <group>
                            <field name="grooming_employee_id"/>
                        </group>
                        <group>
                            <field name="grooming_invoice_id"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Page for Grooming Services -->
                        <page string="Grooming Services" name="grooming_line_ids">
                            <field name="grooming_line_ids">
                                <list editable="bottom">
                                    <field name="service_id"
                                           context ="{'default_type': 'service', 'default_grooming_product': True}"/>
                                    <field name="description"/>
                                    <field name="price"/>
                                </list>
                            </field>
                            <group>
                                <!-- Total grooming cost -->
                                <div style="margin-left:1400px;" string="Total">
                                    <field name="grooming_total"/>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!-- Action to open animal.grooming model views -->
    <record id="animal_grooming_action" model="ir.actions.act_window">
        <field name="name">Grooming</field>
        <field name="res_model">animal.grooming</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Action to open product.template model views for grooming products -->
    <record id="product_template_menu_action" model="ir.actions.act_window">
        <field name="name">Grooming Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('type', '=', 'service'), ('is_grooming_product', '=', True)]</field>
        <field name="context">{'default_type': 'service', 'create': True, 'edit': True, 'delete': False, 'default_grooming_product': True}</field>
    </record>
    <!-- Menu for Grooming Products -->
    <menuitem id="grooming_product_menu" name="Grooming Products"
              action="product_template_menu_action" parent="configuration_types_menu" sequence="9"/>
    <!-- submenu for Grooming Appointments -->
    <menuitem id="grooming_cases_menu" action="animal_grooming_action" name="Grooming" parent="appointment_menu" sequence="2"/>
</odoo>