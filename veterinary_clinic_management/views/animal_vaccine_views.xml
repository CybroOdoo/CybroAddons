<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view definition for animal.vaccine model -->
    <record id="animal_vaccine_view_list" model="ir.ui.view">
        <field name="name">animal.vaccine.view.list</field>
        <field name="model">animal.vaccine</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <!-- Fields to be displayed in the list view -->
                <field name="name"/>
                <field name="charge"/>
            </list>
        </field>
    </record>
    <!-- Action to open animal.vaccine model views -->
    <record id="animal_vaccine_action" model="ir.actions.act_window">
        <field name="name">Vaccine</field>
        <field name="res_model">animal.vaccine</field>
        <field name="view_mode">list</field>
    </record>
    <!-- Menu item for Vaccine Types under Configuration Types menu -->
    <menuitem id="vaccine_menu" action="animal_vaccine_action" name="Vaccine Types"
              parent="configuration_types_menu" sequence="6"/>
</odoo>
