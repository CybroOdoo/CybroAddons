<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Breed Types List View -->
    <record id="breed_types_view_list" model="ir.ui.view">
        <field name="name">breed.types.view.list</field>
        <field name="model">breed.types</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="animal_type_id"/>
            </list>
        </field>
    </record>

    <!-- Breed Types Window Action -->
    <record id="breed_types_action" model="ir.actions.act_window">
          <field name="name">Breed Types</field>
          <field name="res_model">breed.types</field>
          <field name="view_mode">list</field>
    </record>

    <!-- Breed Types Configuration Menu -->
    <menuitem id="breed_type_menu" name="Breed Types" action="breed_types_action" parent="configuration_types_menu"/>
</odoo>