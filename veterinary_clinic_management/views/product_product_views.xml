<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Modify Product Form View -->
    <record id="product_normal_view_form" model="ir.ui.view">
        <field name="name">product.product.view.form.veterinary.clinic.management</field> <!-- View name for product form -->
        <field name="model">product.product</field> <!-- Model associated with the view -->
        <field name="inherit_id" ref="product.product_normal_form_view"/> <!-- Inherit from existing view -->
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="before"> <!-- Insert before options div -->
                <!-- New field to hide in the product form -->
                <div>
                    <field name="is_medical_bill_product" invisible="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
