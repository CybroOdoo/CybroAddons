<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- View for Veterinary Appointment Form -->
    <record id="veterinary_appointment_view_form" model="ir.ui.view">
        <field name="name">veterinary.appointment.view.form</field>
        <field name="model">veterinary.appointment</field>
        <field name="arch" type="xml">
            <!-- Form view layout for creating veterinary appointments -->
            <form string="Create Appointment">
                <!-- Radio buttons for selecting service type -->
                <group>
                    <field name="service_type" widget="radio" options="{'horizontal': true}"/>
                </group>
                <!-- Appointment details section -->
                <group string="APPOINTMENT DETAILS">
                    <group>
                        <field name="appointment_time"/>
                    </group>
                    <group>
                        <field name="doctor_id"
                               invisible="service_type != 'procedures'"
                               required="service_type == 'procedures'"/>
                    </group>
                </group>
                <!-- Footer buttons for actions -->
                <footer>
                    <!-- Button to create appointment -->
                    <button string="Create Appointment" type="object" name="action_create_appointment" class="btn-primary"/>
                    <!-- Cancel button -->
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Action for Veterinary Appointment -->
    <record id="veterinary_appointment_action" model="ir.actions.act_window">
        <field name="name">Create Appointment</field>
        <field name="res_model">veterinary.appointment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> <!-- Opens in a new window -->
        <field name="binding_model_id" ref="veterinary_clinic_management.model_res_patient"/> <!-- Binds to the res.patient model -->
        <field name="binding_view_types">list</field> <!-- Binds to list view type -->
    </record>
</odoo>
