<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- View for Veterinary Clinic Management Form -->
    <record id="veterinary_clinic_management_view_form" model="ir.ui.view">
        <field name="name">veterinary.clinic.management.view.form</field>
        <field name="model">veterinary.clinic.management</field>
        <field name="arch" type="xml">
            <!-- Form view layout for managing veterinary appointments -->
            <form string="Appointment Details">
                <!-- Radio buttons for selecting service type -->
                <group>
                    <field name="service_type" widget="radio" options="{'horizontal': true}"/>
                </group>
                <!-- Group for appointment start date -->
                <group>
                    <group>
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                </group>
                <!-- Footer buttons for actions -->
                <footer>
                    <!-- Button to generate PDF report -->
                    <button string="Print Pdf Report" type="object" name="action_pdf_report" class="btn-primary"/>
                    <!-- Cancel button -->
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Action for Veterinary clinic Management Report -->
    <record id="veterinary_clinic_management_report_action" model="ir.actions.act_window">
        <field name="name">Veterinary Report</field>
        <field name="res_model">veterinary.clinic.management</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> <!-- Opens in a new window -->
    </record>
    <!-- Menu item for accessing the Veterinary Report -->
    <menuitem id="report_menu"
              name="Report"
              action="veterinary_clinic_management_report_action"
              parent="veterinary_clinic_management_menu_root"
              sequence="11"/>
</odoo>
