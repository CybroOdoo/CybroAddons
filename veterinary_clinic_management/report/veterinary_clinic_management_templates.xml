<odoo>
        <!--  Pdf template of  Report  in veterinary -->
    <data>
        <template id="veterinary_report_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                            <style>
                            /* Table Styling */
                            table {
                                width: 100%;
                                border-collapse: collapse;
                                margin: 20px 0;
                                box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
                            }
                            th, td {
                                border: 1px solid #ccc;
                                padding: 12px;
                                text-align: left;
                            }
                            th {
                                background-color: #f4f4f4;
                                color: #333;
                                font-weight: bold;
                            }
                            td {
                                background-color: #fff;
                                color: #555;
                            }

                            /* Header Styling */
                            h1, h3 {
                                text-align: center;
                                margin: 10px 0;
                                color: #333;
                            }
                            h1 {
                                font-size: 24px;
                            }
                            h3 {
                                font-size: 18px;
                                color: #666;
                            }
                        </style>
                        <h1>Veterinary
                            <t t-esc="service_type"/>
                        Report</h1>
                        <t t-if="start_date">
                            <h3>Start Date:<t t-esc="start_date"/></h3>
                        </t>
                        <t t-if="end_date">
                            <h3>End Date:<t t-esc="end_date"/></h3>
                        </t>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Case Number</th>
                                    <th>Patient</th>
                                    <th t-if="service_type == 'procedures'">Doctor</th>
                                    <th t-if="service_type == 'grooming'">Grooming Employee</th>
                                    <th t-if="service_type == 'training'">Training Employee</th>
                                    <th>Appointment Date</th>
                                    <th t-if="service_type == 'procedures'">Treatment</th>
                                    <th t-if="service_type == 'procedures'">Is Admitted</th>
                                    <th t-if="service_type == 'procedures'">Vaccination</th>
                                    <th t-if="service_type == 'training'">Package</th>
                                    <th t-if="service_type == 'training'">Animal Type</th>
                                    <th t-if="service_type == 'training'">Breed</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="records" t-as="appt">
                                    <td t-esc="appt['case_number'] or ''"/>
                                    <td t-esc="appt['patient_name'] or ''"/>
                                    <td t-esc="appt['doctor_name'] or ''"/>
                                    <td t-esc="appt['appointment_date'] or ''"/>
                                    <td t-if="service_type == 'procedures'">
                                        <t t-if="not appt['treatment']">
                                            <p>No</p>
                                        </t>
                                        <t t-else="">
                                            <p>Yes</p>
                                        </t>
                                    </td>
                                    <td t-if="service_type == 'procedures'">
                                        <t t-if="not appt['is_admit']">
                                            <p>No</p>
                                        </t>
                                        <t t-else="">
                                            <p>Yes</p>
                                        </t>
                                    </td>
                                    <td t-if="service_type == 'procedures'">
                                        <t t-if="not appt['vaccination']">
                                            <p>No</p>
                                        </t>
                                        <t t-else="">
                                            <p>Yes</p>
                                        </t>
                                    </td>
                                    <t t-if="service_type == 'training'">
                                        <td t-esc="appt['package'] or ''"/>
                                    </t>
                                    <t t-if="service_type == 'training'">
                                        <td t-esc="appt['animal_type'] or ''"/>
                                    </t>
                                    <t t-if="service_type == 'training'">
                                        <td t-esc="appt['breed'] or ''"/>
                                    </t>
                                    <t t-if="appt['status']">
                                        <td t-esc="appt['status'] or ''"/>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>