        <field name="name">Veterinary report</field>
        <field name="model">veterinary.clinic.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">veterinary_clinic_management.veterinary_report_template</field>
        <field name="report_file">veterinary_clinic_management.veterinary_report_template</field>
    </record>
</odoo>