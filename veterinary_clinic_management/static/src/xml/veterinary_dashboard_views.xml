<templates>
    <t t-name="veterinary_clinic_management.VeterinaryDashboard">
        <style>
            html .o_web_client > .o_action_manager{
            overflow-y: scroll;
            }
            .dashboard-container {
            font-family: Arial, sans-serif;
            padding: 20px;
            }

            .dashboard-title {
            font-size: 32px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 30px;
            }

            .section-title {
            font-size: 20px;
            font-weight: bold;
            margin: 20px 0;
            }

            .stat-card {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            transition: transform 0.3s ease;
            }

            .stat-card:hover {
            transform: translateY(-5px);
            }

            .card-body {
            padding: 20px;
            height: 150px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            }

            .stat-icon {
            font-size: 36px;
            margin-bottom: 10px;
            }

            .stat-count {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
            }

            .stat-head {
            font-size: 14px;
            }

            /* Dark bluish and yellowish gradients */
            #grooming-card { background: linear-gradient(45deg, #0f2027,
            #203a43, #2c5364); }
            #procedure-card { background: linear-gradient(180deg, #1f4037,
            #99f2c8); }
            #training-card { background: linear-gradient(135deg, #0f0c29,
            #302b63, #24243e); }
            #doctors-card { background: linear-gradient(135deg, #1a2a6c,
            #b21f1f, #fdbb2d); }
            #nurses-card { background: linear-gradient(135deg, #141E30,
            #243B55); }
            #surgeries-card { background: linear-gradient(135deg, #000046,
            #1CB5E0); }

            #today-grooming-card { background: linear-gradient(135deg, #0B486B,
            #F56217); }
            #today-procedure-card { background: linear-gradient(135deg, #3A6073,
            #16222A); }
            #today-training-card { background: linear-gradient(135deg, #1D4350,
            #A43931); }
            #today-doctors-card { background: linear-gradient(135deg, #003973,
            #E5E5BE); }
            #today-nurses-card { background: linear-gradient(135deg, #136a8a,
            #267871); }
            #today-surgeries-card { background: linear-gradient(135deg, #0f2027,
            #203a43, #2c5364); }
        </style>

        <div class="dashboard-container">
            <h1 class="dashboard-title">Veterinary Dashboard</h1>

            <h4 class="section-title">Overall Statistics</h4>
            <div class="row">
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-cut"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.totalGrooming"/>
                            </div>
                            <div class="stat-head">Grooming</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-stethoscope"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.totalProcedure"/>
                            </div>
                            <div class="stat-head">Procedure</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-graduation-cap"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.totalTraining"/>
                            </div>
                            <div class="stat-head">Training</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-user-md"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.totalDoctors"/>
                            </div>
                            <div class="stat-head">Doctors</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-heartbeat"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.totalNurses"/>
                            </div>
                            <div class="stat-head">Nurses</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-hospital-o"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.totalSurgeries"/>
                            </div>
                            <div class="stat-head">Surgeries</div>
                        </div>
                    </div>
                </div>
            </div>

            <h4 class="section-title">Today's Statistics</h4>
            <div class="row">
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-cut"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.todayGrooming"/>
                            </div>
                            <div class="stat-head">Today Grooming</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-stethoscope"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.todayProcedure"/>
                            </div>
                            <div class="stat-head">Today Procedure</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-graduation-cap"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.todayTraining"/>
                            </div>
                            <div class="stat-head">Today Training</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-user-md"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.todayDoctors"/>
                            </div>
                            <div class="stat-head">Today Doctors</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-heartbeat"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.todayNurses"/>
                            </div>
                            <div class="stat-head">Today Nurses</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-2 mb-4">
                    <div class="stat-card">
                        <div class="card-body">
                            <div class="stat-icon">
                                <i class="fa fa-hospital-o"/>
                            </div>
                            <div class="stat-count">
                                <t t-esc="state.countData.todaySurgeries"/>
                            </div>
                            <div class="stat-head">Today Surgeries</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="shadow-sm border m-2 p-4 bg-white">
                        <div class="d-flex align-items-center justify-content-between">
                            <h3 style="color:black;">Monthly Appointment</h3>
                        </div>
                        <canvas t-ref="chart"/>
                    </div>
                </div>
                <div class="col-md-3" style="width: 400px; height: 400px;">
                    <div class="shadow-sm border m-2 p-4 bg-white"
                         style="height: 450px;">
                        <h4 style="padding-bottom:15px;">Top 5 Grooming
                            Products
                        </h4>
                        <canvas t-ref="top_grooming_products"
                                style="width: 50%;height:370px;"/>
                    </div>
                </div>
                <div class="col-md-4" style="width: 400px; height: 400px;">
                    <div class="shadow-sm border m-2 p-4 bg-white"
                         style="height: 450px;">
                        <h4 style="padding-bottom:15px;">Top 5 Medicines</h4>
                        <canvas t-ref="top_medicines"
                                style="width: 50%; height: 300px;"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>