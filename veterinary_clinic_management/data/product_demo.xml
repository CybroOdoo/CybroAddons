<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Data records for defining medical service products -->
    <data noupdate="1">
        <!-- Consultancy Product -->
        <record id="product_product_consultancy_product" model="product.product">
            <field name="name">Consultancy</field>
            <field name="description">Consultancy Charge for doctor</field>
            <field name="type">service</field> <!-- Type of product: service -->
            <field name="sale_ok" eval="True"/> <!-- Can be sold -->
            <field name="purchase_ok" eval="False"/> <!-- Cannot be purchased -->
            <field name="list_price">0.0</field> <!-- Default list price -->
            <field name="is_medical_bill_product" eval="True"/> <!-- Used in medical billing -->
        </record>
        <!-- Treatment Product -->
        <record id="product_product_treatment_product" model="product.product">
            <field name="name">Treatment</field>
            <field name="description">Treatment provided including Medication and Procedure</field>
            <field name="type">service</field> <!-- Type of product: service -->
            <field name="sale_ok" eval="True"/> <!-- Can be sold -->
            <field name="purchase_ok" eval="False"/> <!-- Cannot be purchased -->
            <field name="list_price">0.0</field> <!-- Default list price -->
            <field name="is_medical_bill_product" eval="True"/> <!-- Used in medical billing -->
        </record>
        <!-- Admit Product -->
        <record id="product_product_admit_product" model="product.product">
            <field name="name">Admit</field>
            <field name="description">Admit Charges for patient care</field>
            <field name="type">service</field> <!-- Type of product: service -->
            <field name="sale_ok" eval="True"/> <!-- Can be sold -->
            <field name="purchase_ok" eval="False"/> <!-- Cannot be purchased -->
            <field name="list_price">0.0</field> <!-- Default list price -->
            <field name="is_medical_bill_product" eval="True"/> <!-- Used in medical billing -->
        </record>
        <!-- Surgery Product -->
        <record id="product_product_surgery_product" model="product.product">
            <field name="name">Surgery</field>
            <field name="description">Charge for surgical procedure</field>
            <field name="type">service</field> <!-- Type of product: service -->
            <field name="sale_ok" eval="True"/> <!-- Can be sold -->
            <field name="purchase_ok" eval="False"/> <!-- Cannot be purchased -->
            <field name="list_price">0.0</field> <!-- Default list price -->
            <field name="is_medical_bill_product" eval="True"/> <!-- Used in medical billing -->
        </record>
        <!-- Vaccines Product -->
        <record id="product_product_vaccine_product" model="product.product">
            <field name="name">Vaccines</field>
            <field name="description">Charge for Vaccines Injected to patient</field>
            <field name="type">service</field> <!-- Type of product: service -->
            <field name="sale_ok" eval="True"/> <!-- Can be sold -->
            <field name="purchase_ok" eval="False"/> <!-- Cannot be purchased -->
            <field name="list_price">0.0</field> <!-- Default list price -->
            <field name="is_medical_bill_product" eval="True"/> <!-- Used in medical billing -->
        </record>
        <!-- Training Product -->
        <record id="product_product_training_product" model="product.product">
            <field name="name">Training</field>
            <field name="description">Charge for Training Animal</field>
            <field name="type">service</field> <!-- Type of product: service -->
            <field name="sale_ok" eval="False"/> <!-- Cannot be sold -->
            <field name="purchase_ok" eval="False"/> <!-- Cannot be purchased -->
        </record>
    </data>
</odoo>