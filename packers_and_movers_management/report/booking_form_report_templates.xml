<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Template used to show the booking forms-->
    <template id="form_truck_booking_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div>
                            <h1 style="font-size:30px">
                                <span t-out="doc.reference_no or ''"/>
                            </h1>
                            <h3 style="font-size:20px">Customer:
                                <span t-out="doc.partner_id.name or ''"/>
                            </h3>
                        </div>
                        <br/>
                        <br/>
                        <div class="row">
                            <table class="table" style="height: 362px;">
                                <tr>
                                    <th>From Location</th>
                                    <td><span t-out="doc.from_location or ''"/></td>
                                    <th>Truck Type</th>
                                    <td><span t-out="doc.truck_id.name or ''"/></td>
                                </tr>
                                <tr>
                                    <th>To Location</th>
                                    <td><span t-out="doc.to_location or ''"/></td>
                                    <th>Goods Type</th>
                                    <td><span t-out="doc.goods_type_id.name or ''"/></td>
                                </tr>
                                <tr>
                                    <th>Date</th>
                                    <td><span t-out="doc.date or ''"/></td>
                                    <th>Distance</th>
                                    <td><span t-out="doc.distance"/> KM</td>
                                </tr>
                                <tr>
                                    <th>Weight / Unit</th>
                                    <td><span t-out="doc.weight"/> / <span t-out="doc.unit or ''"/></td>
                                    <th>Total Amount</th>
                                    <td><span t-out="doc.amount"/></td>
                                </tr>
                                <tr>
                                    <th>State</th>
                                    <td>
                                        <span>
                                            <t t-if="doc.state == 'draft'">Draft</t>
                                            <t t-elif="doc.state == 'confirm'">Confirm</t>
                                            <t t-elif="doc.state == 'invoice'">Invoiced</t>
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
