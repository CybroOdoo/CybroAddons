<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Template used to create form for the booking report-->
    <template id="report_truck_booking">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center">
                        <h1 style="font-size:30px">Packers And Movers
                            Management
                        </h1>
                    </div>
                    <br/>
                    <br/>
                    <div class="row">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>References</th>
                                    <th>Date</th>
                                    <th>Customer</th>
                                    <th>From Location</th>
                                    <th>To Location</th>
                                    <th>Distance</th>
                                    <th>Truck Type</th>
                                    <th>Goods Type</th>
                                    <th>Weight / Unit</th>
                                    <th>Total Amount</th>
                                    <th>State</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="report" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-out="line.get('reference_no') or ''"/>
                                        </td>
                                        <td>
                                            <span t-out="line.get('date') or ''"/>
                                        </td>
                                        <td>
                                            <span t-out="line.get('name') or ''"/>
                                        </td>
                                        <td>
                                            <span t-out="line.get('from_location') or ''"/>
                                        </td>
                                        <td>
                                            <span t-out="line.get('to_location') or ''"/>
                                        </td>
                                        <td>
                                            <span t-out="line.get('distance')"/> KM
                                        </td>
                                        <td>
                                            <span t-out="line.get('truck') or ''"/>
                                        </td>
                                        <td>
                                            <span t-out="line.get('goods') or ''"/>
                                        </td>
                                        <td>
                                            <span t-out="line.get('weight')"/> / <span t-out="line.get('unit') or ''"/>
                                        </td>
                                        <td>
                                            <span t-out="line.get('amount')"/>
                                        </td>
                                        <td>
                                            <span>
                                                <t t-if="line.get('state') == 'draft'">Draft</t>
                                                <t t-elif="line.get('state') == 'confirm'">Confirm</t>
                                                <t t-elif="line.get('state') == 'invoice'">Invoiced</t>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
