<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="index_website_snippet" inherit_id="website.snippets" name="index_website_snippet">
        <!-- CREATE SNIPPET GROUPS -->
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">

            <t t-snippet="website.s_snippet_group"
               snippet-group="best_seller"
               string="Best Seller"
               t-thumbnail="/theme_splash/static/src/images/snippets/feature-block-1.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="index_service"
               string="Service"
               t-thumbnail="/theme_splash/static/src/images/snippets/services-tab-block.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="banner"
               string="Banner"
               t-thumbnail="/theme_splash/static/src/images/snippets/banner.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="index_highlight_banner"
               string="Highlight Banner"
               t-thumbnail="/theme_splash/static/src/images/snippets/highlight-banner-block.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="index_expect_feature"
               string="Expect Feature"
               t-thumbnail="/theme_splash/static/src/images/snippets/feature-block-3.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="index_partner"
               string="Partner"
               t-thumbnail="/theme_splash/static/src/images/snippets/suppliers-block.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="index_experience"
               string="Experience"
               t-thumbnail="/theme_splash/static/src/images/snippets/experience-block.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="s_service"
               string="Service Page"
               t-thumbnail="/theme_splash/static/src/images/snippets/services.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="s_about"
               string="About Page"
               t-thumbnail="/theme_splash/static/src/images/snippets/about-feature-block-1.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="index_service_tab"
               string="Service Tab"
               t-thumbnail="/theme_splash/static/src/images/snippets/services-block.png"/>

            <t t-snippet="website.s_snippet_group"
               snippet-group="index_testmonial"
               string="Testimonial"
               t-thumbnail="/theme_splash/static/src/images/snippets/testimonials.png"/>

        </xpath>
        <!-- REGISTER SNIPPETS -->
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">

            <t t-snippet="theme_splash.index_about_feature1" string="About Feature" group="best_seller"/>
            <t t-snippet="theme_splash.index_service" string="Service" group="index_service"/>
            <t t-snippet="theme_splash.banner" string="Banner" group="banner"/>
            <t t-snippet="theme_splash.index_highlight_banner" string="Highlight Banner" group="index_highlight_banner"/>
            <t t-snippet="theme_splash.index_expect_feature" string="Expect Feature" group="index_expect_feature"/>
            <t t-snippet="theme_splash.index_partner" string="Partner" group="index_partner"/>
            <t t-snippet="theme_splash.index_experience" string="Experience" group="index_experience"/>
            <t t-snippet="theme_splash.s_service" string="Service Page" group="s_service"/>
            <t t-snippet="theme_splash.s_about" string="About Page" group="s_about"/>
            <t t-snippet="theme_splash.index_service_tab" string="Service Tab" group="index_service_tab"/>
            <t t-snippet="theme_splash.index_testmonial" string="Testimonial" group="index_testmonial"/>

        </xpath>
    </template>
</odoo>
