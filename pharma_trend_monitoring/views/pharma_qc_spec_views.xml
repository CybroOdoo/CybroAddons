<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Watch tick on specification parameters, locked with the specification. -->
    <record id="pharma_qc_spec_line_view_list_trend" model="ir.ui.view">
        <field name="name">pharma.qc.spec.line.list.trend</field>
        <field name="model">pharma.qc.spec.line</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_qc_spec_line_view_list"/>
        <field name="arch" type="xml">
            <field name="acceptance_criteria" position="after">
                <field name="is_trended" widget="boolean_toggle"
                       readonly="not (min_value or max_value)"
                       help="Watch this parameter: results outside its approved normal range are flagged on the test order. Only quantitative parameters can be watched."/>
            </field>
        </field>
    </record>

    <!-- Note under the specification parameters. -->
    <record id="pharma_qc_spec_form_view_trend" model="ir.ui.view">
        <field name="name">pharma.qc.spec.form.trend</field>
        <field name="model">pharma.qc.spec</field>
        <field name="inherit_id" ref="pharmaceutical_base.pharma_qc_spec_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='parameters']" position="inside">
                <div class="text-muted small mt-2">
                    <i class="fa fa-line-chart me-1"/>Watched parameters are
                    set in draft and locked when the specification is approved.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
