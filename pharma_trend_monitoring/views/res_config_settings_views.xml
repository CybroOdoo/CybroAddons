<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Per-site trend monitoring settings, right under the switch that enables them. -->
    <record id="res_config_settings_view_form_pharma_trend" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pharma.trend</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pharmaceutical_base.res_config_settings_view_form_pharmaceutical_base"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pharmaceutical_base_module_trend_monitoring']" position="after">
                <setting id="pharma_trend_history" string="Results Before Trending Starts"
                         help="Approved results a watched parameter needs before QA can approve its normal range. Until then nothing is flagged."
                         invisible="not module_pharma_trend_monitoring">
                    <field name="pharma_trend_min_history" required="module_pharma_trend_monitoring"/>
                </setting>
                <setting id="pharma_trend_sigma" string="Normal Range Width"
                         help="Standard deviations either side of the mean. The range never extends beyond the specification."
                         invisible="not module_pharma_trend_monitoring">
                    <field name="pharma_trend_range_sigma" required="module_pharma_trend_monitoring"/> σ
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
