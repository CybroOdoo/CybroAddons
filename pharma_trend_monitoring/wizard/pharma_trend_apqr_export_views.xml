<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form of the APQR trending export. -->
    <record id="pharma_trend_apqr_export_view_form" model="ir.ui.view">
        <field name="name">pharma.trend.apqr.export.form</field>
        <field name="model">pharma.trend.apqr.export</field>
        <field name="arch" type="xml">
            <form string="APQR Trending Export">
                <div class="alert alert-info" role="status">
                    Exports the <strong>trending section</strong> of the Annual Product
                    Quality Review as a spreadsheet: per watched parameter, the results,
                    mean and standard deviation, the normal range that applied, the count
                    of flagged results and the trend chart. It is <strong>not a complete
                    APQR</strong> — batches made, yields, deviations, CAPAs, change
                    controls, complaints, returns and stability are not included.
                </div>
                <group>
                    <group>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="company_id" groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <field name="parameter_ids" widget="many2many_tags"
                       placeholder="All watched parameters of the product"
                       options="{'no_create': True}"/>
                <footer>
                    <button name="action_export" type="object" string="Export XLSX"
                            class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action opening the APQR trending export. -->
    <record id="pharma_trend_apqr_export_action" model="ir.actions.act_window">
        <field name="name">APQR Trending Export</field>
        <field name="res_model">pharma.trend.apqr.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
