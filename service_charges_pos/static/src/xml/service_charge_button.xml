<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Template for adding clear all button in pos -->
    <t t-name="service_charges_pos.ControlButtons"
       t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
           <button class="btn btn-secondary btn-lg lh-lg text-truncate w-auto"
                   t-on-click="onClick" t-if="this.pos.config.is_service_charges">
                 <i class="fa fa-calculator" role="img"
                    aria-label="Service Charge"
                    title="Service Charge" />
            <span>Service Charge</span>
           </button>
        </xpath>
   </t>
</templates>
