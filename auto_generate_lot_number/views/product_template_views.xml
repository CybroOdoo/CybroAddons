<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited the product.template form view for adding new fields related to the traceability-->
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">
            product.template.view.form.inherit.auto.generate.lot.number
        </field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
             <xpath expr="//group[@name='group_lots_and_weight']" position="after">
                <field name="is_auto_generate" invisible="1"/>
                <group string="Lot/Serial Auto Generation" invisible="is_auto_generate != True or tracking == 'none'" name="auto_generate_lot">
                    <field name="digits"
                           invisible="is_auto_generate != True or tracking == 'none'"
                           required="is_auto_generate == True and tracking != 'none'"/>
                    <field name="prefix"
                           invisible="is_auto_generate != True or tracking == 'none'"
                           required="is_auto_generate == True and tracking != 'none'"/>
                    <field name="number_next" invisible="1"
                           groups="base.group_no_one"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
