<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inheriting website settings to add Icecat credentials configuration -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo.icecat.connector</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="inside">
                <setting id="icecat_user_setting" string="Icecat Connector" help="Configure your Icecat credentials to import product details and images">
                    <div class="content-group">
                        <div class="row mt8">
                            <label class="col-lg-3" string="Icecat User ID" for="user_id_icecat"/>
                            <field name="user_id_icecat"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
