<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Adding Time and Timezone field in res_partner-->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.contacts.timezone
        </field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <label for="contact_local_time_tz" string="Local Time"/>
                <div>
                    <field name="contact_local_time_tz" class="oe_inline"/>
                    <button name="action_compute_contact_local_time_tz" icon="fa-clock-o" class="far fa-calendar-check"
                            type="object"/>
                </div>
                <field name="contact_local_tz"/>
            </xpath>
        </field>
    </record>

</odoo>