<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock move pdf report template -->
    <template id="report_stock_move">
        <t t-call="web.html_container">
            <div class="article">
                <h2 class="text-center">STOCK MOVE REPORT</h2>
                <br/>
                <div class="header">
                        <div class="row text-left"
                             style="border-top: 1px solid black;">
                            <div class="offset-9 col-3 text-end">
                                <ul class="list-inline"
                                    style="margin-top:10px;">
                                    <li>
                                        <span class="page"/>
                                        /
                                        <span class="topage"/>
                                    </li>
                                </ul>
                                <br/>
                                <div>
                                    <span class="text-left"
                                          style="color:black;"
                                          t-out="company_name"/>
                                    <br/>
                                    <span class="text-left"
                                          style="color:black;"
                                          t-out="company_street"/>
                                    <br/>
                                    <span class="text-left"
                                          style="color:black;"
                                          t-out="state"/>
                                    <span class="text-left"
                                          style="color:black;"
                                          t-out="country"/>
                                    <br/>
                                    <span class="text-left"
                                          style="color:black;"
                                          t-out="company_email"/>
                                    <br/>
                                </div>
                            </div>
                        </div>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Reference</th>
                            <th>Product</th>
                            <th>Location</th>
                            <th>Quantity</th>
                            <th>Company</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="stock_move" t-as="doc">
                            <tr>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-out="doc['date']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-out="doc['reference']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-out="doc['product_name']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-out="doc['complete_name']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-out="doc['product_uom_qty']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-out="doc['name']"/>
                                </td>
                                <td class="text-center"
                                    style="width: 15%">
                                    <span t-out="status[doc['state']]"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
