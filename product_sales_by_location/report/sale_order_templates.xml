<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_inherit_product_sales_by_location"
              inherit_id="sale.report_saleorder_document">
        <th name="th_quantity" position="before">
            <th name="th_location" class="text-end text-nowrap">
                <span t-translation="on">Location</span>
                <t t-set="colspan_count" t-value="colspan_count + 1"/>
            </th>
        </th>
        <td name="td_product_quantity" position="before">
            <td name="td_location" class="text-end">
                <span t-field="line.line_location_id.name"/>
            </td>
        </td>
    </template>
</odoo>
