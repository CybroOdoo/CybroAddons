<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--This XML code extends the "sale.order" form view by adding the "line_location_id" field after the "product_and_description" column in the order line list.-->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">
            sale.order.view.form.inherit.product.sales.by.location
        </field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']"
                   position="after">
                <field name="line_location_id"/>
            </xpath>
        </field>
    </record>
</odoo>
