<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_content_inherit_product_sales_by_location"
              name="location in sale order portal"
              inherit_id="sale.sale_order_portal_content">
        <xpath expr="//th[@id='product_qty_header']"
               position="before">
            <th class="text-end" id="location_header">
                <span t-translation="on">Location</span>
            </th>
        </xpath>
        <td name="td_product_quantity" position="before">
            <td id="location_id" class="text-end">
                <span t-field="line.line_location_id.name"/>
            </td>
        </td>
    </template>
</odoo>
