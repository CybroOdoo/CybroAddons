<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="camera_in_discuss.CameraDialog" owl="1">
        <Dialog title="'Camera'" technical="true">
            <div t-if="state.error" class="alert alert-danger" role="alert">
                <t t-esc="state.error"/>
            </div>
            <div t-else="" class="d-flex flex-column align-items-center">
                <video t-ref="video" autoplay="true" class="w-100 mb-2" style="max-height: 400px; object-fit: cover; transform: scaleX(-1);"/>
                <canvas t-ref="canvas" style="display: none;"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="capture" t-att-disabled="!!state.error">Capture</button>
                <button class="btn btn-secondary" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
