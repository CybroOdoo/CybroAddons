<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the oil transfer security rules and groups. -->
    <data noupdate="1">
        <record id="stock_picking_oil_transfer_user_write_rule" model="ir.rule">
            <field name="name">Oil Transfer: Read/Create Only for Users</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('is_oil_gas_transfer', '=', True)]</field>
            <field name="groups" eval="[(4, ref('oil_erp_base.group_oil_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="stock_picking_oil_transfer_manager_rule" model="ir.rule">
            <field name="name">Oil Transfer: Manager Full Access</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oil_erp_base.group_oil_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
