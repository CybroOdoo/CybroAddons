<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the stock picking views. -->
    <record id="view_picking_form_inherit_oil_erp_transfers" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.oil.erp.transfers</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="is_oil_gas_transfer" readonly="state in ['done', 'cancel']"
                />
            </xpath>
            <xpath expr="//notebook/page[@name='extra']" position="after">
                <page string="Transport Details" name="oil_gas_transport"
                      invisible="not is_oil_gas_transfer">
                    <group>
                        <group string="Transfer Control">
                            <field name="product_type_id"
                                   invisible="not is_oil_gas_transfer"
                                   required="is_oil_gas_transfer"
                                   readonly="state in ['done', 'cancel']"/>
                        </group>
                        <group string="Transport Assignment"
                               invisible="not is_oil_gas_transfer">
                            <field name="vehicle_id"
                                   required="is_oil_gas_transfer"
                                   readonly="state in ['done', 'cancel']"
                                   context="{'default_is_oil_gas_fleet': True}"/>
                            <field name="driver_id"
                                   required="is_oil_gas_transfer"
                                   readonly="state in ['done', 'cancel']"/>
                            <field name="vehicle_allowable_payload"
                                   readonly="1"/>
                            <field name="vehicle_tank_capacity" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="not is_oil_gas_transfer">
                        <group string="Load Measurements">
                            <field name="temperature_f"
                                   readonly="state in ['done', 'cancel']"/>
                        </group>
                        <group string="Transfer Schedule">
                            <field name="departure_time"
                                   readonly="state in ['done', 'cancel']"/>
                            <field name="arrival_time"
                                   readonly="state in ['done', 'cancel']"/>
                        </group>
                    </group>
                </page>
                <page string="Delivery Validation" name="delivery_validation"
                      invisible="not is_oil_gas_transfer">
                    <group>
                        <group string="Arrival Info">
                            <field name="delivery_arrival_time"/>
                            <field name="delivery_start_time"/>
                            <field name="delivery_end_time"/>
                            <field name="delivery_duration"/>
                        </group>
                        <group string="Measurement Values">
                            <field name="loading_temperature"/>
                            <field name="arrival_temperature"/>
                            <field name="gross_weight_loaded"/>
                            <field name="gross_weight_empty"/>
                            <field name="tank_volume_before"/>
                            <field name="tank_volume_after"/>
                            <field name="actual_qty"/>
                            <field name="delivery_status"/>
                        </group>
                    </group>
                    <group>
                        <group string="Computed Differences">
                            <field name="temperature_difference"/>
                            <field name="net_weight"/>
                            <field name="delivered_volume"/>
                            <field name="planned_qty" readonly="1"/>
                            <field name="quantity_loss" readonly="1"/>
                        </group>
                        <group string="Validation Notes">
                            <field name="remarks" readonly="1"
                                   placeholder="Record loss reasons, temperature deviations, damage notes, or other delivery observations..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_picking_tree_inherit_oil_erp_transfers" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.oil.erp.transfers</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="is_oil_gas_transfer" optional="show"/>
                <field name="product_type_id" optional="hide"/>
                <field name="vehicle_id" optional="hide"/>
                <field name="driver_id" optional="hide"/>
                <field name="net_weight" optional="hide"/>
                <field name="delivery_status" optional="hide"/>
                <field name="departure_time" optional="hide"/>
                <field name="arrival_time" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_picking_search_inherit_oil_erp_transfers" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.oil.erp.transfers</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="product_type_id"/>
            </field>
            <xpath expr="//filter[@name='status']" position="after">
                <filter name="oil_gas_transfers" string="Oil and Gas Transfers"
                        domain="[('is_oil_gas_transfer', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
