<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- This file defines the fleet vehicle views. -->
<record id="view_fleet_vehicle_search_inherit_oil_erp_transfers" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.inherit.oil.erp.transfers</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='available']" position="after">
                <filter name="oil_gas_fleet_only" string="Oil and Gas Fleet"
                        domain="[('is_oil_gas_fleet', '=', True)]"/>
                <filter name="oil_gas_available_only" string="Available for Transfer"
                        domain="[('is_oil_gas_fleet', '=', True), ('is_available', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_tree_inherit_oil_erp_transfers" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.inherit.oil.erp.transfers</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="is_oil_gas_fleet" optional="show"/>
                <field name="is_available" optional="show"/>
                <field name="tank_capacity" optional="hide"/>
                <field name="tare_weight" optional="hide"/>
                <field name="max_gross_weight" optional="hide"/>
                <field name="allowable_payload" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_fleet_vehicle_form_inherit_oil_erp_transfers" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.oil.erp.transfers</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_transfers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="not is_oil_gas_fleet">
                    <field name="transfer_count" widget="statinfo" string="Transfers"/>
                </button>
            </xpath>
            <xpath expr="//group[.//field[@name='driver_id']]" position="inside">
                <group string="Transport Control">
                    <field name="is_oil_gas_fleet"/>
                    <field name="is_available" invisible="not is_oil_gas_fleet"/>
                </group>
            </xpath>
            <xpath expr="//group[.//field[@name='category_id']]" position="inside">
                <group string="Weight and Capacity" invisible="not is_oil_gas_fleet">
                    <field name="tank_capacity"/>
                    <field name="tare_weight"/>
                    <field name="max_gross_weight"/>
                    <field name="allowable_payload" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
