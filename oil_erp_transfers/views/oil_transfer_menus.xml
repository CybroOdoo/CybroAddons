<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the oil transfer menus. -->
    <record id="action_oil_gas_transfer" model="ir.actions.act_window">
        <field name="name">Transfer</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="domain">[('is_oil_gas_transfer', '=', True),
            ('picking_type_code', '=', 'internal')]
        </field>
        <field name="context">{'contact_display': 'partner_address',
            'restricted_picking_type_code': 'internal',
            'search_default_internal': 1, 'default_is_oil_gas_transfer': 1}
        </field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an oil and gas internal transfer.</p>
            <p>Use this menu to manage internal stock pickings that require vehicle and driver assignment.</p>
        </field>
    </record>

    <record id="action_oil_gas_fleet" model="ir.actions.act_window">
        <field name="name">Fleet</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">kanban,list,form,pivot,activity</field>
        <field name="domain">[('is_oil_gas_fleet', '=', True)]</field>
        <field name="context">{'default_is_oil_gas_fleet': 1,
            'search_default_oil_gas_fleet_only': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an oil and gas fleet vehicle.</p>
            <p>Only vehicles flagged for oil and gas transport are shown here.</p>
        </field>
    </record>

    <menuitem
            id="menu_oil_midstream_transfer"
            name="Transfer"
            parent="oil_erp_base.menu_oil_midstream_root"
            action="action_oil_gas_transfer"
            sequence="10"/>

    <!-- Use parent defined in oil_erp_base -->

    <menuitem
            id="menu_oil_config_pipeline_transport_fleet"
            name="Fleet"
            parent="oil_erp_base.menu_oil_config_midstream"
            groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"
            action="action_oil_gas_fleet"
            sequence="10"/>
</odoo>
