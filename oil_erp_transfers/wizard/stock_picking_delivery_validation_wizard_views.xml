<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the stock picking delivery validation wizard view. -->
    <record id="view_stock_picking_delivery_validation_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.delivery.validation.wizard.form</field>
        <field name="model">stock.picking.delivery.validation.wizard</field>
        <field name="arch" type="xml">
            <form string="Delivery Validation">
                <field name="picking_id" invisible="1"/>
                <group col="2">
                    <group string="Arrival Info">
                        <field name="delivery_arrival_time"/>
                        <field name="delivery_start_time"/>
                        <field name="delivery_end_time"/>
                    </group>
                    <group string="Measurement Values">
                        <field name="loading_temperature"/>
                        <field name="arrival_temperature"/>
                        <field name="gross_weight_loaded"/>
                        <field name="gross_weight_empty"/>
                        <field name="tank_volume_before"/>
                        <field name="tank_volume_after"/>
                        <field name="delivery_status"/>
                    </group>
                </group>
                <separator string="Transferred Products"/>
                <field name="line_ids" nolabel="1" colspan="2">
                    <list editable="bottom" create="0" delete="0">
                        <field name="move_id" column_invisible="True" force_save="1"/>
                        <field name="product_id" force_save="1"/>
                        <field name="planned_qty" force_save="1"/>
                        <field name="actual_qty"/>
                        <field name="uom_id" force_save="1"/>
                        <field name="remark"/>
                    </list>
                </field>
                <group>
                    <field name="actual_qty" readonly="1"/>
                    <field name="base_remarks" invisible="1"/>
                    <field name="remarks"
                           placeholder="Record loss reasons, temperature deviations, damage notes, or other delivery observations..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Save and Validate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
