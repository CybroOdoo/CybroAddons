<?xml version="1.0" encoding="utf-8"?>
<!-- Sequence data definitions for JTL FFN returns and tracking references. -->
<odoo>
    <data noupdate="1">
        <record id="seq_jtl_ffn_return" model="ir.sequence">
            <field name="name">JTL FFN Return</field>
            <field name="code">jtl.ffn.return</field>
            <field name="prefix">RET</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_jtl_ffn_tracking" model="ir.sequence">
            <field name="name">JTL FFN Tracking</field>
            <field name="code">jtl.ffn.tracking</field>
            <field name="prefix">SH</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
