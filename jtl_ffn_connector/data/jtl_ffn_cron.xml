<?xml version="1.0" encoding="utf-8"?>
<!-- Scheduled actions (cron jobs) for JTL FFN product, stock, order, tracking, and return synchronization. -->
<odoo>

    <data noupdate="1">
        <record id="cron_jtl_ffn_product_stock_sync" model="ir.cron">
            <field name="name">JTL FFN: Product &amp; Stock Sync</field>
            <field name="model_id" ref="model_jtl_ffn_product_sync"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_all()</field>
            <field name="interval_number" eval="30"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_jtl_ffn_order_push" model="ir.cron">
            <field name="name">JTL FFN: Push Pending Orders</field>
            <field name="model_id" ref="model_jtl_ffn_order_sync"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.cron_push_orders()</field>
            <field name="interval_number" eval="10"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_jtl_ffn_tracking_pull" model="ir.cron">
            <field name="name">JTL FFN: Pull Tracking Numbers</field>
            <field name="model_id" ref="model_jtl_ffn_tracking"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.cron_pull_tracking()</field>
            <field name="interval_number" eval="15"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_jtl_ffn_returns_pull" model="ir.cron">
            <field name="name">JTL FFN: Pull Returns</field>
            <field name="model_id" ref="model_jtl_ffn_return"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.cron_pull_returns()</field>
            <field name="interval_number" eval="60"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_jtl_ffn_refresh_tokens" model="ir.cron">
            <field name="name">JTL FFN: Proactive Token Refresh</field>
            <field name="model_id" ref="model_jtl_ffn_config"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_tokens()</field>
            <field name="interval_number" eval="10"/>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>

</odoo>
