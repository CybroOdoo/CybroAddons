<?xml version="1.0" encoding="utf-8"?>
<!-- Form and list views for JTL FFN configuration profiles and API settings. -->
<odoo>

    <record id="jtl_ffn_config_form_view" model="ir.ui.view">
        <field name="name">jtl.ffn.config.form.view</field>
        <field name="model">jtl.ffn.config</field>
        <field name="arch" type="xml">
            <form string="JTL FFN Settings">
                <header>
                    <button name="action_test_connection"
                            string="Test Connection"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_run_full_sync"
                            string="Run Full Sync Now"
                            type="object"
                            class="btn-secondary"/>
                    <field name="connection_state" widget="statusbar"
                           statusbar_visible="not_tested,ok,error"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-secondary" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Profile Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Target Gateway &amp; API Credentials">
                            <field name="environment" widget="radio"/>
                            <field name="client_id"/>
                            <field name="client_secret"/>
                        </group>
                        <group string="OAuth Token Setup">
                            <field name="refresh_token" widget="password" readonly="connection_state == 'ok'"/>
                            <label for="auth_code" string="OAuth Auth Code Helper"/>
                            <div class="o_row">
                                <field name="auth_code" placeholder="Paste redirect code here..."/>
                                <button name="action_exchange_auth_code" type="object" string="Exchange Code" class="btn-secondary"/>
                            </div>
                        </group>
                    </group>

                    <group string="Sync Options">
                        <group>
                            <field name="sync_products"/>
                            <field name="sync_stock"/>
                            <field name="sync_orders"/>
                        </group>
                        <group>
                            <field name="sync_tracking"/>
                            <field name="sync_returns"/>
                        </group>
                    </group>
                    <group string="Fallback Shipping">
                        <group>
                            <field name="fallback_shipping_method_id" placeholder="e.g. 944H0AFJSRQFEQZX"/>
                            <field name="fallback_shipping_type"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Authentication State">
                            <group>
                                <field name="access_token" readonly="1" widget="text"/>
                                <field name="token_expiry"  readonly="1"/>
                                <field name="connection_error" readonly="1"
                                       invisible="not connection_error"/>
                            </group>
                        </page>

                        <page string="Fulfillment Warehouses">
                            <field name="warehouse_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="odoo_warehouse_id"/>
                                    <field name="ffn_warehouse_id"/>
                                    <field name="ffn_warehouse_name"/>
                                    <field name="is_default"/>
                                    <field name="last_sync"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="jtl_ffn_config_tree_view" model="ir.ui.view">
        <field name="name">jtl.ffn.config.tree.view</field>
        <field name="model">jtl.ffn.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="environment"/>
                <field name="connection_state" widget="badge"
                       decoration-success="connection_state == 'ok'"
                       decoration-danger="connection_state == 'error'"
                       decoration-muted="connection_state == 'not_tested'"/>
                <field name="token_expiry"/>
            </list>
        </field>
    </record>

    <record id="jtl_ffn_config_search_view" model="ir.ui.view">
        <field name="name">jtl.ffn.config.search.view</field>
        <field name="model">jtl.ffn.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="jtl_ffn_config_view_action" model="ir.actions.act_window">
        <field name="name">JTL FFN Config</field>
        <field name="res_model">jtl.ffn.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first JTL FFN connection profile!
            </p>
        </field>
    </record>

</odoo>
