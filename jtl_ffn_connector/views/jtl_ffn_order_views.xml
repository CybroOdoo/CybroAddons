<?xml version="1.0" encoding="utf-8"?>
<!-- Views and actions for JTL FFN order fulfillment logs and shipment tracking. -->
<odoo>

    <record id="jtl_ffn_order_sync_list_view" model="ir.ui.view">
        <field name="name">jtl.ffn.order.sync.list.view</field>
        <field name="model">jtl.ffn.order.sync</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="push_state == 'error'"
                  decoration-success="push_state == 'shipped'">
                <header>
                    <button name="action_sync_all" string="Push Orders" type="object" class="btn-primary" display="always"/>
                </header>
                <field name="sale_order_id"/>
                <field name="config_id"/>
                <field name="warehouse_id"/>
                <field name="ffn_order_id"/>
                <field name="pushed_at"/>
                <field name="push_state" widget="badge"
                       decoration-success="push_state == 'shipped'"
                       decoration-info="push_state == 'confirmed'"
                       decoration-warning="push_state in ('pending','sent')"
                       decoration-danger="push_state == 'error'"/>
                <field name="retry_count" optional="show"/>
                <field name="push_error"  optional="show"/>
            </list>
        </field>
    </record>

    <record id="jtl_ffn_order_sync_form_view" model="ir.ui.view">
        <field name="name">jtl.ffn.order.sync.form.view</field>
        <field name="model">jtl.ffn.order.sync</field>
        <field name="arch" type="xml">
            <form string="FFN Order Sync Record" create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="config_id"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="ffn_order_id"/>
                            <field name="ffn_jfsku"/>
                            <field name="push_state"/>
                            <field name="pushed_at"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group invisible="not push_error">
                        <field name="push_error" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="jtl_ffn_tracking_list_view" model="ir.ui.view">
        <field name="name">jtl.ffn.tracking.list.view</field>
        <field name="model">jtl.ffn.tracking</field>
        <field name="arch" type="xml">
            <list create="0">
                <header>
                    <button name="action_sync_all" string="Pull Tracking" type="object" class="btn-primary" display="always"/>
                </header>
                <field name="sale_order_id"/>
                <field name="picking_id"/>
                <field name="carrier_name"/>
                <field name="tracking_number"/>
                <field name="tracking_url" widget="url" optional="show"/>
                <field name="shipped_at"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'notified'"
                       decoration-info="state == 'applied'"
                       decoration-warning="state == 'new'"/>
            </list>
        </field>
    </record>

    <record id="jtl_ffn_tracking_form_view" model="ir.ui.view">
        <field name="name">jtl.ffn.tracking.form.view</field>
        <field name="model">jtl.ffn.tracking</field>
        <field name="arch" type="xml">
            <form string="Shipment Tracking" create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="order_sync_id"/>
                            <field name="picking_id"/>
                            <field name="config_id"/>
                        </group>
                        <group>
                            <field name="ffn_shipment_id"/>
                            <field name="carrier_name"/>
                            <field name="tracking_number"/>
                            <field name="tracking_url" widget="url"/>
                            <field name="shipped_at"/>
                            <field name="imported_at"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="jtl_ffn_order_sync_action" model="ir.actions.act_window">
        <field name="name">Order Fulfillment Log</field>
        <field name="res_model">jtl.ffn.order.sync</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="jtl_ffn_tracking_action" model="ir.actions.act_window">
        <field name="name">Shipment Tracking</field>
        <field name="res_model">jtl.ffn.tracking</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
