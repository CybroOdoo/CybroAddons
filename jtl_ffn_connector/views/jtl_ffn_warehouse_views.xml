<?xml version="1.0" encoding="utf-8"?>
<!-- Views and actions for JTL FFN fulfillment warehouse mappings. -->
<odoo>

    <record id="jtl_ffn_warehouse_form_view" model="ir.ui.view">
        <field name="name">jtl.ffn.warehouse.form.view</field>
        <field name="model">jtl.ffn.warehouse</field>
        <field name="arch" type="xml">
            <form string="FFN Warehouse Mapping">
                <sheet>
                    <group>
                        <group string="Mapping">
                            <field name="config_id"/>
                            <field name="name"/>
                            <field name="is_default"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Warehouse IDs">
                            <field name="odoo_warehouse_id"/>
                            <field name="ffn_warehouse_id"/>
                            <field name="ffn_warehouse_name"/>
                        </group>
                    </group>
                    <group string="Country Routing Rules">
                        <field name="route_country_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Stock Snapshot">
                            <field name="stock_line_ids">
                                <list>
                                    <field name="sku"/>
                                    <field name="product_id"/>
                                    <field name="ffn_quantity"/>
                                    <field name="last_updated"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="jtl_ffn_warehouse_list_view" model="ir.ui.view">
        <field name="name">jtl.ffn.warehouse.list.view</field>
        <field name="model">jtl.ffn.warehouse</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="config_id"/>
                <field name="odoo_warehouse_id"/>
                <field name="ffn_warehouse_id"/>
                <field name="is_default"/>
                <field name="last_sync"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="jtl_ffn_warehouse_action" model="ir.actions.act_window">
        <field name="name">FFN Warehouses</field>
        <field name="res_model">jtl.ffn.warehouse</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
