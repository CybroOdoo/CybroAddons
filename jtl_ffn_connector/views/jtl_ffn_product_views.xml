<?xml version="1.0" encoding="utf-8"?>
<!-- Views and actions for JTL FFN product synchronization and stock tracking. -->
<odoo>

    <record id="jtl_ffn_product_sync_list_view" model="ir.ui.view">
        <field name="name">jtl.ffn.product.sync.list.view</field>
        <field name="model">jtl.ffn.product.sync</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="sync_state == 'error'"
                  decoration-success="sync_state == 'synced'">
                <header>
                    <button name="action_sync_all" string="Sync Products" type="object" class="btn-primary" display="always"/>
                </header>
                <field name="product_id"/>
                <field name="sku"/>
                <field name="config_id"/>
                <field name="ffn_product_id"/>
                <field name="last_pushed"/>
                <field name="last_pulled"/>
                <field name="sync_state" widget="badge"
                       decoration-success="sync_state == 'synced'"
                       decoration-danger="sync_state == 'error'"
                       decoration-warning="sync_state == 'pending'"/>
                <field name="sync_error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="jtl_ffn_product_sync_form_view" model="ir.ui.view">
        <field name="name">jtl.ffn.product.sync.form.view</field>
        <field name="model">jtl.ffn.product.sync</field>
        <field name="arch" type="xml">
            <form string="FFN Product Sync Record" create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="product_id"/>
                            <field name="sku"/>
                        </group>
                        <group>
                            <field name="ffn_product_id"/>
                            <field name="sync_state"/>
                            <field name="last_pushed"/>
                            <field name="last_pulled"/>
                        </group>
                    </group>
                    <group invisible="not sync_error">
                        <field name="sync_error" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="jtl_ffn_product_sync_action" model="ir.actions.act_window">
        <field name="name">Product Sync Register</field>
        <field name="res_model">jtl.ffn.product.sync</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
