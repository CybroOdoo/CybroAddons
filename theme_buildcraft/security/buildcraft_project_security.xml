<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website visitors and portal users only see the published projects -->
    <record id="buildcraft_project_rule_published" model="ir.rule">
        <field name="name">BuildCraft Project: published projects</field>
        <field name="model_id" ref="model_buildcraft_project"/>
        <field name="domain_force">[('is_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>
</odoo>
