<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buildcraft_project_tree" model="ir.ui.view">
        <field name="name">buildcraft.project.tree</field>
        <field name="model">buildcraft.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="location"/>
                <field name="value"/>
                <field name="year"/>
                <field name="is_published"/>
            </list>
        </field>
    </record>

    <record id="view_buildcraft_project_form" model="ir.ui.view">
        <field name="name">buildcraft.project.form</field>
        <field name="model">buildcraft.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="location"/>
                            <field name="client"/>
                            <field name="area"/>
                        </group>
                        <group>
                            <field name="value"/>
                            <field name="year"/>
                            <field name="duration"/>
                            <field name="is_published"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_buildcraft_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">buildcraft.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_buildcraft_project_root" name="BuildCraft Projects" sequence="100" web_icon="theme_buildcraft,static/description/icon.png"/>
    <menuitem id="menu_buildcraft_project" name="Projects" parent="menu_buildcraft_project_root" action="action_buildcraft_project" sequence="10"/>

</odoo>
