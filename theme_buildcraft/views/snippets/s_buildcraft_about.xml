                                    <span data-file="/screens/BuildCraftHome.jsx" data-idx="19">Our Vision</span>
                                </h4>
                                <p class="text-sm text-muted-foreground leading-relaxed">
                                    <span data-file="/screens/BuildCraftHome.jsx" data-idx="20">To be the world's most
                                        trusted construction partner,
                                        building responsibly for future generations.
                                    </span>
                                </p>
                            </div>
                            <div class="p-5 rounded-lg border border-border bg-light flex flex-col gap-3">
                                <div class="w-9 h-9 rounded-md bg-secondary flex items-center justify-center">
                                    <span class="icon icon-16 icon-primary" data-component="@globalComponents/Icon.jsx"
                                          data-icon="target">
                                        <svg height="16px" viewbox="0 0 24 24" width="16px">
