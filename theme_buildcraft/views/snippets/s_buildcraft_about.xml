<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_buildcraft_about" name="BuildCraft About">
        <section class="s_buildcraft_about pt0 pb0" data-snippet="s_buildcraft_about" data-name="BuildCraft About">
            <div class="px-24 py-24 bg-background">
