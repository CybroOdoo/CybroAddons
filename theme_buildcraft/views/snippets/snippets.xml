<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="theme_buildcraft_snippets" inherit_id="website.snippets" name="BuildCraft Snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="s_buildcraft_hero" t-snippet="theme_buildcraft.s_buildcraft_hero"
               t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_hero.png"/>
            <t snippet-group="s_buildcraft_about" t-snippet="theme_buildcraft.s_buildcraft_about"
               t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_about.png"/>
            <t snippet-group="s_buildcraft_services" t-snippet="theme_buildcraft.s_buildcraft_services"
               t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_services.png"/>
            <t snippet-group="s_buildcraft_projects" t-snippet="theme_buildcraft.s_buildcraft_projects"
               t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_project.png"/>
            <t snippet-group="s_buildcraft_process" t-snippet="theme_buildcraft.s_buildcraft_process"
               t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_process.png"/>
            <t snippet-group="s_buildcraft_cta" t-snippet="theme_buildcraft.s_buildcraft_cta"
               t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_team.png"/>
            <t snippet-group="s_buildcraft_testimonials" t-snippet="theme_buildcraft.s_buildcraft_testimonials"
               t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_testimonials.png"/>
            <t snippet-group="s_buildcraft_blog" t-snippet="theme_buildcraft.s_buildcraft_blog"
               t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_blog.png"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
                <t t-snippet="theme_buildcraft.s_buildcraft_hero" string="Hero" group="s_buildcraft_hero"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_about" string="About Us" group="s_buildcraft_about"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_services" string="About Us" group="s_buildcraft_services"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_projects" string="About Us" group="s_buildcraft_projects"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_process" string="About Us" group="s_buildcraft_process"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_cta" string="About Us" group="s_buildcraft_cta"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_testimonials" string="About Us" group="s_buildcraft_testimonials"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_blog" string="About Us" group="s_buildcraft_blog"/>
        </xpath>
    </template>
</odoo>