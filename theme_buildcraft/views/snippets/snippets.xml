<odoo>
    <template id="theme_buildcraft_snippets" inherit_id="website.snippets" name="BuildCraft Snippets">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]" position="inside">
                <t t-snippet="theme_buildcraft.s_buildcraft_hero" string="Hero" t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_hero.png"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_about" string="About Us" t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_about.png"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_services" string="Services" t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_about.png"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_projects" string="Projects" t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_project.png"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_process" string="Process" t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_process.png"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_cta" string="CTA" t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_testimonials.png"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_testimonials" string="Team" t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_team.png"/>
                <t t-snippet="theme_buildcraft.s_buildcraft_blog" string="Blog" t-thumbnail="/theme_buildcraft/static/src/images/snippets/b_blog.png"/>
        </xpath>
    </template>
</odoo>
