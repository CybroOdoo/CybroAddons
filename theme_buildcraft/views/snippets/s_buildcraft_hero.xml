<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="s_buildcraft_hero" name="BuildCraft Hero">
        <section class="s_buildcraft_hero pt0 pb0" data-snippet="s_buildcraft_hero" data-name="BuildCraft Hero">
            <div class="relative min-h-0 hero-section-height">
                <div class="absolute inset-0">
                    <img class="w-full h-full object-cover img-ratio-21-9" data-aspect-ratio="21:9"
                         data-component="@globalComponents/Image.jsx"
                         data-query="luxury construction site skyscraper aerial view night city lights golden steel beams dramatic sky"
                         src="https://storage.googleapis.com/banani-generated-images/generated-images/30e5d813-e90e-4f38-b947-90efa9eab728.jpg"/>
                </div>
                <div class="absolute inset-0 hero-overlay"/>
                <div class="absolute inset-0 flex flex-col justify-center px-24 pt-20">
                    <div class="max-w-2xl flex flex-col gap-7">
                        <h1 class="font-headings font-bold text-7xl text-white leading-tight hero-fade-1">
                            <span data-file="/screens/BuildCraftHome.jsx" data-idx="1">Building</span>
                            <br/>
                            <span class="text-primary">
                                <span data-file="/screens/BuildCraftHome.jsx" data-idx="2">Landmarks.</span>
                            </span>
                            <br/>
                            <span data-file="/screens/BuildCraftHome.jsx" data-idx="3">Creating Futures.</span>
                        </h1>
                        <p class="text-lg text-white/70 leading-relaxed max-w-xl hero-fade-2">
                            <span data-file="/screens/BuildCraftHome.jsx" data-idx="4">Delivering exceptional
                                residential, commercial, and
                                infrastructure projects with innovation, quality, and
                                trust.
                            </span>
                        </p>
                        <div class="flex items-center gap-4 mt-2 hero-fade-3">
                            <a class="bg-primary text-primary-foreground px-7 py-3.5 rounded-full font-semibold text-base"
                               href="projects.html">View Projects
                            </a>
                            <a class="btn-ghost text-black border border-white/30 text-white px-7 py-3.5 rounded-full font-medium text-base flex items-center gap-2"
                               href="contact.html">
                                Request Consultation
                                <svg fill="none" height="16" stroke="currentColor" stroke-linecap="round"
                                     stroke-linejoin="round" stroke-width="3" viewbox="0 0 24 24" width="16">
                                    <path d="M5 12h14m-7-7 7 7-7 7"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                    <div class="mt-10 flex items-center gap-16 border-t border-white/10 pt-10">
                        <div class="flex flex-col gap-1" data-component="@components/StatBadge.jsx">
                            <span class="font-headings font-bold text-4xl text-primary">
                                <span data-file="/screens/BuildCraftHome.jsx" data-idx="7">500+</span>
                            </span>
                            <span class="text-sm font-body text-white/60">
                                <span data-file="/screens/BuildCraftHome.jsx" data-idx="8">Projects Completed</span>
                            </span>
                        </div>
                        <div class="w-px h-10 bg-white/10"/>
                        <div class="flex flex-col gap-1" data-component="@components/StatBadge.jsx">
                            <span class="font-headings font-bold text-4xl text-primary">
                                <span data-file="/screens/BuildCraftHome.jsx" data-idx="9">25+</span>
                            </span>
                            <span class="text-sm font-body text-white/60">
                                <span data-file="/screens/BuildCraftHome.jsx" data-idx="10">Years Experience</span>
                            </span>
                        </div>
                        <div class="w-px h-10 bg-white/10"/>
                        <div class="flex flex-col gap-1" data-component="@components/StatBadge.jsx">
                            <span class="font-headings font-bold text-4xl text-primary">
                                <span data-file="/screens/BuildCraftHome.jsx" data-idx="11">1,000+</span>
                            </span>
                            <span class="text-sm font-body text-white/60">
                                <span data-file="/screens/BuildCraftHome.jsx" data-idx="12">Happy Clients</span>
                            </span>
                        </div>
                        <div class="w-px h-10 bg-white/10"/>
                        <div class="flex flex-col gap-1" data-component="@components/StatBadge.jsx">
                            <span class="font-headings font-bold text-4xl text-primary">
                                <span data-file="/screens/BuildCraftHome.jsx" data-idx="13">50+</span>
                            </span>
                            <span class="text-sm font-body text-white/60">
                                <span data-file="/screens/BuildCraftHome.jsx" data-idx="14">Expert Engineers</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>