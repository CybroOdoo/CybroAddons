<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="aboutus_template" name="About Us">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty theme_buildcraft_wrap font-body bg-background text-foreground">
                <!-- Page Hero -->
                <section class="page-hero px-24">
                  <div class="max-w-3xl relative z-10">
                    <div class="badge hero-fade-1"><span class="dot"/>About BuildCraft</div>
                    <h1 class="font-headings font-bold text-5xl text-white leading-tight mb-6 hero-fade-2">
                      Building with Purpose,<br /><span class="text-gradient">Delivering Excellence</span>
                    </h1>
                    <p class="text-lg text-white/60 leading-relaxed max-w-2xl hero-fade-3">
                      For over 25 years, BuildCraft Developers has been at the forefront of construction excellence in the UAE and beyond — transforming visions into iconic structures.
                    </p>
                  </div>
                </section>

                <!-- Our Story -->
                <section class="px-24 py-24 bg-white">
                  <div class="flex gap-20 items-center">
                    <div class="flex-1 reveal-left">
                      <div class="badge badge-dark mb-6"><span class="dot"/>Our Story</div>
                      <h2 class="font-headings font-bold text-5xl text-foreground leading-tight mb-6 sec-head">
                        25 Years of Building <span class="text-gradient">Landmarks</span>
                      </h2>
                      <p class="text-base text-muted-foreground leading-relaxed mb-5">
                        Founded in 1999 by James Hartwell in Dubai, BuildCraft began as a boutique residential contractor with a single mission: deliver craftsmanship that stands the test of time. With each project, we earned the trust of clients who demanded nothing short of exceptional.
                      </p>
                      <p class="text-base text-muted-foreground leading-relaxed mb-5">
                        By 2008, we had expanded into commercial construction, completing landmark towers across the DIFC skyline. Today, BuildCraft operates across 30 countries, employing over 1,200 engineers, architects, and skilled tradespeople.
                      </p>
                      <p class="text-base text-muted-foreground leading-relaxed">
                        Our portfolio spans luxury villas, corporate headquarters, mixed-use developments, and infrastructure — each delivered on time, within budget, and to the highest standard.
                      </p>
                    </div>
                    <div class="flex-1 reveal-right">
                      <div class="relative">
                        <img src="https://storage.googleapis.com/banani-generated-images/generated-images/30e5d813-e90e-4f38-b947-90efa9eab728.jpg"
                          class="w-full img-frame" style="height:500px;object-fit:cover;" alt="BuildCraft history" />
                        <div class="absolute -bottom-6 -left-6 bg-primary rounded-xl p-6 shadow-xl">
                          <div class="font-headings font-bold text-4xl text-secondary">1999</div>
                          <div class="text-secondary font-medium text-sm mt-1">Year Founded</div>
                        </div>
                        <div class="absolute -top-6 -right-6 bg-dark rounded-xl p-6 shadow-xl border border-white/10">
                          <div class="font-headings font-bold text-4xl text-primary">850+</div>
                          <div class="text-white/70 font-medium text-sm mt-1">Projects Delivered</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </section>

                <!-- Stats -->
                <section class="bg-subtle px-24 py-20">
                  <div class="grid grid-cols-4 gap-8 stagger">
                    <div class="card-accent-top reveal flex flex-col items-center text-center p-8">
                      <div class="stat-num mb-2">850+</div>
                      <div class="font-semibold text-foreground text-base">Projects Completed</div>
                      <div class="text-muted-foreground text-sm mt-1">Across 6 continents</div>
                    </div>
                    <div class="card-accent-top reveal flex flex-col items-center text-center p-8">
                      <div class="stat-num mb-2">25+</div>
                      <div class="font-semibold text-foreground text-base">Years Experience</div>
                      <div class="text-muted-foreground text-sm mt-1">Since 1999</div>
                    </div>
                    <div class="card-accent-top reveal flex flex-col items-center text-center p-8">
                      <div class="stat-num mb-2">1,200+</div>
                      <div class="font-semibold text-foreground text-base">Team Members</div>
                      <div class="text-muted-foreground text-sm mt-1">Engineers &amp; specialists</div>
                    </div>
                    <div class="card-accent-top reveal flex flex-col items-center text-center p-8">
                      <div class="stat-num mb-2">30</div>
                      <div class="font-semibold text-foreground text-base">Countries</div>
                      <div class="text-muted-foreground text-sm mt-1">Global operations</div>
                    </div>
                  </div>
                </section>

                <!-- Mission, Vision, Values -->
                <section class="px-24 py-24 bg-white">
                  <div class="text-center mb-16 reveal">
                    <div class="badge badge-dark mb-5" style="display:inline-flex;"><span class="dot"/>What Drives Us</div>
                    <h2 class="font-headings font-bold text-5xl text-foreground sec-head-center">
                      Mission, Vision &amp; <span class="text-gradient">Values</span>
                    </h2>
                  </div>
                  <div class="grid grid-cols-3 gap-8 stagger">
                    <div class="card-accent-top reveal p-8 flex flex-col gap-5">
                      <div class="icon-box-grad">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2d4f1e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                      </div>
                      <h3 class="font-headings font-bold text-xl text-foreground">Our Mission</h3>
                      <p class="text-muted-foreground leading-relaxed">To deliver construction projects that exceed expectations in quality, safety, and sustainability — creating lasting value for our clients and communities.</p>
                    </div>
                    <div class="card-accent-top reveal p-8 flex flex-col gap-5">
                      <div class="icon-box-grad">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2d4f1e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                      </div>
                      <h3 class="font-headings font-bold text-xl text-foreground">Our Vision</h3>
                      <p class="text-muted-foreground leading-relaxed">To be the most trusted construction company in the world — known for transforming skylines, lives, and communities through innovation and integrity.</p>
                    </div>
                    <div class="card-accent-top reveal p-8 flex flex-col gap-5">
                      <div class="icon-box-grad">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2d4f1e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      </div>
                      <h3 class="font-headings font-bold text-xl text-foreground">Our Values</h3>
                      <p class="text-muted-foreground leading-relaxed">Quality without compromise. Safety above all. Transparency with every client. Innovation that drives progress. Sustainability that respects the planet.</p>
                    </div>
                  </div>
                </section>

                <!-- Why Choose Us -->
                <section class="px-24 py-24 why-section-bg">
                  <div class="flex gap-20 items-center">
                    <div class="flex-1 reveal-left">
                      <div class="badge mb-6"><span class="dot"/>Why BuildCraft</div>
                      <h2 class="font-headings font-bold text-5xl text-white leading-tight mb-10 sec-head">
                        Why Clients Choose Us<br /><span class="text-gradient">Over the Competition</span>
                      </h2>
                      <div class="flex flex-col gap-5">
                        <div class="feat-item">
                          <div class="feat-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2d4f1e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          </div>
                          <div>
                            <h4 class="font-bold text-white mb-1">On-Time Delivery Guarantee</h4>
                            <p class="text-white/60 text-sm leading-relaxed">98.7% of our projects are delivered on or ahead of schedule. We use advanced project management software and dedicated site coordinators to ensure zero delays.</p>
                          </div>
                        </div>
                        <div class="feat-item">
                          <div class="feat-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2d4f1e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          </div>
                          <div>
                            <h4 class="font-bold text-white mb-1">ISO 9001:2015 Certified Quality</h4>
                            <p class="text-white/60 text-sm leading-relaxed">Our quality management system is globally certified. Every material, process, and finish meets the highest international standards.</p>
                          </div>
                        </div>
                        <div class="feat-item">
                          <div class="feat-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2d4f1e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          </div>
                          <div>
                            <h4 class="font-bold text-white mb-1">Transparent Fixed Pricing</h4>
                            <p class="text-white/60 text-sm leading-relaxed">No hidden costs. We provide detailed line-item quotes and lock pricing before groundbreaking. Your budget is protected from day one.</p>
                          </div>
                        </div>
                        <div class="feat-item">
                          <div class="feat-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2d4f1e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          </div>
                          <div>
                            <h4 class="font-bold text-white mb-1">5-Year Structural Warranty</h4>
                            <p class="text-white/60 text-sm leading-relaxed">Every building we construct comes with a comprehensive 5-year warranty on structural integrity and a 2-year warranty on finishes.</p>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="flex-1 reveal-right">
                      <img src="https://storage.googleapis.com/banani-generated-images/generated-images/2052cd32-c489-4c5c-8499-36e88adda90e.jpg"
                        class="w-full img-frame" style="height:560px;object-fit:cover;" alt="Quality construction" />
                    </div>
                  </div>
                </section>

                <!-- CTA -->
                <section class="px-24 py-24 bg-dark text-center">
                  <div class="max-w-2xl mx-auto reveal">
                    <div class="badge mb-6" style="display:inline-flex;"><span class="dot"/>Get Started</div>
                    <h2 class="font-headings font-bold text-5xl text-white mb-5">
                      Ready to Start Your <span class="text-gradient">Project?</span>
                    </h2>
                    <p class="text-white/60 leading-relaxed mb-10 text-lg">Let's discuss your vision. Our team is ready to provide a free consultation and feasibility assessment.</p>
                    <div class="flex items-center justify-center gap-4">
                      <a href="/contactus" class="bg-primary text-primary-foreground px-8 py-4 rounded-full font-semibold text-base">Get Free Consultation</a>
                      <a href="/projects" class="btn-ghost px-8 py-4 flex items-center gap-2">
                        View Our Work
                        <span class="icon icon-16"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></span>
                      </a>
                    </div>
                  </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
