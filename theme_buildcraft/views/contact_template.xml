<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="theme_buildcraft_contactus" inherit_id="website.contactus" name="BuildCraft Contact Us" priority="200">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty theme_buildcraft_wrap font-body bg-background text-foreground">
                
                <!-- Page Hero -->
                <section class="page-hero px-24">
                  <div class="max-w-3xl relative z-10">
                    <span class="badge hero-fade-1 mb-6 inline-flex"><span class="dot"/> Get In Touch</span>
                    <h1 class="font-headings font-bold text-5xl text-white leading-tight mb-6 hero-fade-2">
                      Let's Build <span class="text-gradient">Something</span> Together
                    </h1>
                    <p class="text-lg text-white/60 leading-relaxed max-w-2xl hero-fade-3">
                      Whether you're planning a residential home, a commercial complex, or a large-scale infrastructure project — our team is ready to make it a reality.
                    </p>
                  </div>
                </section>

                <!-- Contact Info Cards -->
                <section class="px-24 py-24 bg-white">
                  <div class="grid grid-cols-3 gap-8 mb-20">

                    <div class="card-accent-top reveal rounded-xl p-8 border border-border bg-card flex flex-col gap-5">
                      <div class="icon-box-grad w-12 h-12 rounded-xl flex items-center justify-center">
                        <span class="icon icon-22" style="color:#2d4f1e;"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.55 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
                      </div>
                      <div>
                        <h3 class="font-headings font-bold text-lg text-foreground mb-1">Call Us</h3>
                        <p class="text-sm text-muted-foreground mb-3">Available Mon–Sat, 8AM–8PM GST</p>
                        <p class="font-semibold text-foreground">+971 4 123 4567</p>
                        <p class="text-sm text-muted-foreground">+971 55 987 6543</p>
                      </div>
                    </div>

                    <div class="card-accent-top reveal rounded-xl p-8 border border-border bg-card flex flex-col gap-5">
                      <div class="icon-box-grad w-12 h-12 rounded-xl flex items-center justify-center">
                        <span class="icon icon-22" style="color:#2d4f1e;"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
                      </div>
                      <div>
                        <h3 class="font-headings font-bold text-lg text-foreground mb-1">Email Us</h3>
                        <p class="text-sm text-muted-foreground mb-3">We reply within 24 hours</p>
                        <p class="font-semibold text-foreground">info@buildcraftdev.com</p>
                        <p class="text-sm text-muted-foreground">projects@buildcraftdev.com</p>
                      </div>
                    </div>

                    <div class="card-accent-top reveal rounded-xl p-8 border border-border bg-card flex flex-col gap-5">
                      <div class="icon-box-grad w-12 h-12 rounded-xl flex items-center justify-center">
                        <span class="icon icon-22" style="color:#2d4f1e;"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg></span>
                      </div>
                      <div>
                        <h3 class="font-headings font-bold text-lg text-foreground mb-1">Visit Us</h3>
                        <p class="text-sm text-muted-foreground mb-3">Main office &amp; showroom</p>
                        <p class="font-semibold text-foreground">DIFC, Sheikh Zayed Road</p>
                        <p class="text-sm text-muted-foreground">Dubai, UAE, 00000</p>
                      </div>
                    </div>
                  </div>

                  <!-- Contact Form + Sidebar -->
                  <div class="grid grid-cols-2 gap-16 items-start">
                    <div class="reveal-left">
                      <span class="badge badge-dark mb-6 inline-flex"><span class="dot"/> Send a Message</span>
                      <h2 class="font-headings font-bold text-3xl text-foreground mb-2">Request a Free Consultation</h2>
                      <p class="text-muted-foreground mb-8">Tell us about your project and we'll get back to you with a tailored proposal.</p>

                      <t t-if="request.params.get('submitted')">
                        <div class="alert alert-success mt-4 p-4 rounded-xl bg-primary/10 border border-primary text-secondary mb-6">
                            Thank you! Your message has been sent successfully. We will get back to you shortly.
                        </div>
                      </t>
                      <form class="flex flex-col gap-4" action="/contactus/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="grid grid-cols-2 gap-4">
                          <div class="flex flex-col gap-1.5">
                            <label class="text-sm font-semibold text-foreground">First Name *</label>
                            <input type="text" name="contact_first_name" placeholder="John" class="form-input w-full bg-light border border-border rounded-xl px-4 py-3 text-sm" required="required" />
                          </div>
                          <div class="flex flex-col gap-1.5">
                            <label class="text-sm font-semibold text-foreground">Last Name *</label>
                            <input type="text" name="contact_last_name" placeholder="Smith" class="form-input w-full bg-light border border-border rounded-xl px-4 py-3 text-sm" required="required" />
                          </div>
                        </div>
                        <div class="flex flex-col gap-1.5">
                          <label class="text-sm font-semibold text-foreground">Email Address *</label>
                          <input type="email" name="email_from" placeholder="john@company.com" class="form-input w-full bg-light border border-border rounded-xl px-4 py-3 text-sm" required="required" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                          <label class="text-sm font-semibold text-foreground">Phone Number *</label>
                          <input type="tel" name="phone" placeholder="+971 5x xxx xxxx" class="form-input w-full bg-light border border-border rounded-xl px-4 py-3 text-sm" required="required" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                          <label class="text-sm font-semibold text-foreground">Project Type *</label>
                          <select name="project_type" class="form-input w-full bg-light border border-border rounded-xl px-4 py-3 text-sm text-foreground" required="required">
                            <option value="">Select project type...</option>
                            <option>Residential Construction</option>
                            <option>Commercial Development</option>
                            <option>Luxury Villa</option>
                            <option>Infrastructure</option>
                            <option>Renovation &amp; Remodeling</option>
                            <option>Interior Design</option>
                          </select>
                        </div>
                        <div class="flex flex-col gap-1.5">
                          <label class="text-sm font-semibold text-foreground">Budget Range *</label>
                          <select name="budget" class="form-input w-full bg-light border border-border rounded-xl px-4 py-3 text-sm text-foreground" required="required">
                            <option value="">Select budget range...</option>
                            <option>Under AED 500,000</option>
                            <option>AED 500K – 2M</option>
                            <option>AED 2M – 10M</option>
                            <option>AED 10M – 50M</option>
                            <option>Over AED 50M</option>
                          </select>
                        </div>
                        <div class="flex flex-col gap-1.5">
                          <label class="text-sm font-semibold text-foreground">Project Details *</label>
                          <textarea name="description" rows="4" placeholder="Tell us more about your project, timeline, and any specific requirements..." class="form-input w-full bg-light border border-border rounded-xl px-4 py-3 text-sm resize-none" required="required"></textarea>
                        </div>
                        <button type="submit" class="bg-primary text-primary-foreground px-8 py-3.5 rounded-full font-bold text-sm w-full mt-2 hover:-translate-y-1 transition-transform">Send Message &amp; Get Free Quote →</button>
                      </form>
                    </div>

                    <!-- Sidebar -->
                    <div class="reveal-right flex flex-col gap-6">
                      <!-- Office Hours Card -->
                      <div class="dark-card rounded-2xl p-8 flex flex-col gap-5">
                        <div class="flex items-center gap-3 mb-2">
                          <div class="icon-box-grad w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2d4f1e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                          </div>
                          <h3 class="font-headings font-bold text-lg text-foreground">Office Hours</h3>
                        </div>
                        <div class="flex flex-col gap-3">
                          <div class="flex items-center justify-between py-2 border-b border-border">
                            <span class="text-sm text-muted-foreground">Monday – Thursday</span>
                            <span class="text-sm font-semibold text-foreground">8:00 AM – 6:00 PM</span>
                          </div>
                          <div class="flex items-center justify-between py-2 border-b border-border">
                            <span class="text-sm text-muted-foreground">Friday</span>
                            <span class="text-sm font-semibold text-foreground">8:00 AM – 1:00 PM</span>
                          </div>
                          <div class="flex items-center justify-between py-2 border-b border-border">
                            <span class="text-sm text-muted-foreground">Saturday</span>
                            <span class="text-sm font-semibold text-foreground">9:00 AM – 4:00 PM</span>
                          </div>
                          <div class="flex items-center justify-between py-2">
                            <span class="text-sm text-muted-foreground">Sunday</span>
                            <span class="text-sm font-medium text-muted-foreground">Closed</span>
                          </div>
                        </div>
                      </div>

                      <!-- WhatsApp Card -->
                      <div class="rounded-2xl border border-primary/30 p-7 bg-primary/5 flex flex-col gap-4">
                        <div class="flex items-start gap-4">
                          <span class="icon icon-20 flex-shrink-0 mt-0.5" style="color:#25d366;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg></span>
                        </div>
                        <div>
                          <h3 class="font-headings font-bold text-base text-foreground mb-1">WhatsApp Us</h3>
                          <p class="text-sm text-muted-foreground mb-3">Quick questions? Chat with our project advisors instantly.</p>
                          <a href="https://wa.me/971551234567" target="_blank" class="arrow-link inline-flex items-center gap-1.5 text-sm font-semibold text-secondary">
                            Start WhatsApp Chat
                            <span class="icon icon-14"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></span>
                          </a>
                        </div>
                      </div>
                    </div>

                    <!-- Testimonial Quote -->
                    <div class="rounded-2xl border border-border bg-card p-7 flex flex-col gap-4">
                      <div class="flex gap-1 mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#bef547"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#bef547"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#bef547"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#bef547"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#bef547"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      </div>
                      <p class="text-sm text-muted-foreground leading-relaxed italic">"BuildCraft turned our vision into reality ahead of schedule and under budget. The team's professionalism and attention to detail is unmatched in the UAE market."</p>
                      <div class="flex items-center gap-3 mt-1">
                        <img src="https://storage.googleapis.com/banani-avatars/avatar/male/35-50/South Asian/1" class="w-9 h-9 rounded-full object-cover" alt="Ahmed Al Rashid" />
                        <div>
                          <p class="text-sm font-semibold text-foreground">Ahmed Al Rashid</p>
                          <p class="text-xs text-muted-foreground">CEO, Rashid Group Holdings</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </section>

                <!-- FAQ Section -->
                <section class="bg-subtle px-24 py-24">
                  <div class="max-w-3xl mx-auto">
                    <div class="text-center mb-14 reveal">
                      <span class="badge badge-dark mb-5 inline-flex"><span class="dot"/> Common Questions</span>
                      <h2 class="sec-head-center font-headings font-bold text-4xl text-foreground">Frequently Asked Questions</h2>
                    </div>
                    <div class="flex flex-col gap-3">

                      <div class="faq-item reveal rounded-xl border border-border bg-card overflow-hidden">
                        <button class="faq-trigger w-full text-left px-6 py-5 flex items-center justify-between gap-4">
                          <span class="font-semibold text-foreground text-sm">How do I get started with a new construction project?</span>
                          <span class="icon icon-16 text-secondary flex-shrink-0 faq-arrow transition-transform duration-200"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-body px-6 pb-5 hidden">
                          <p class="text-sm text-muted-foreground leading-relaxed">Getting started is simple — fill out our consultation form or give us a call. One of our project advisors will contact you within 24 hours to schedule a free initial consultation, where we'll discuss your vision, site, timeline, and budget.</p>
                        </div>
                      </div>

                      <div class="faq-item reveal rounded-xl border border-border bg-card overflow-hidden">
                        <button class="faq-trigger w-full text-left px-6 py-5 flex items-center justify-between gap-4">
                          <span class="font-semibold text-foreground text-sm">What is the typical timeline for a residential construction project?</span>
                          <span class="icon icon-16 text-secondary flex-shrink-0 faq-arrow transition-transform duration-200"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-body px-6 pb-5 hidden">
                          <p class="text-sm text-muted-foreground leading-relaxed">A standard villa typically takes 18–24 months from concept to handover. This includes design and permitting (3–6 months), structural work (6–9 months), and finishing (4–6 months). Timelines vary depending on the size, complexity, and site conditions.</p>
                        </div>
                      </div>

                      <div class="faq-item reveal rounded-xl border border-border bg-card overflow-hidden">
                        <button class="faq-trigger w-full text-left px-6 py-5 flex items-center justify-between gap-4">
                          <span class="font-semibold text-foreground text-sm">Do you handle all permits and regulatory approvals?</span>
                          <span class="icon icon-16 text-secondary flex-shrink-0 faq-arrow transition-transform duration-200"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-body px-6 pb-5 hidden">
                          <p class="text-sm text-muted-foreground leading-relaxed">Yes. Our team manages the complete regulatory process — DDA approvals, municipality permits, NOCs, and utility connections. We have established relationships with Dubai's key authorities, which helps us streamline approvals faster than the industry average.</p>
                        </div>
                      </div>

                      <div class="faq-item reveal rounded-xl border border-border bg-card overflow-hidden">
                        <button class="faq-trigger w-full text-left px-6 py-5 flex items-center justify-between gap-4">
                          <span class="font-semibold text-foreground text-sm">What payment structures do you offer for large projects?</span>
                          <span class="icon icon-16 text-secondary flex-shrink-0 faq-arrow transition-transform duration-200"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-body px-6 pb-5 hidden">
                          <p class="text-sm text-muted-foreground leading-relaxed">We offer milestone-based payment schedules tied to construction progress — typically 10% on signing, 30% on foundation completion, 40% during structural phase, and 20% on handover. We also work with leading UAE banks for construction financing packages.</p>
                        </div>
                      </div>

                      <div class="faq-item reveal rounded-xl border border-border bg-card overflow-hidden">
                        <button class="faq-trigger w-full text-left px-6 py-5 flex items-center justify-between gap-4">
                          <span class="font-semibold text-foreground text-sm">Do you offer post-construction warranty and maintenance?</span>
                          <span class="icon icon-16 text-secondary flex-shrink-0 faq-arrow transition-transform duration-200"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-body px-6 pb-5 hidden">
                          <p class="text-sm text-muted-foreground leading-relaxed">All our projects come with a comprehensive 10-year structural warranty and a 1-year defects liability period. We also offer annual maintenance packages covering MEP systems, facades, and common areas for residential and commercial buildings.</p>
                        </div>
                      </div>

                    </div>
                  </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
