<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Register the About Us Page Route -->
        <record id="theme_aboutus_page_buildcraft" model="theme.website.page">
            <field name="url">/about</field>
            <field name="view_id" ref="theme_buildcraft.aboutus_template"/>
            <field name="is_published">True</field>
        </record>

        <!-- Add About Us to Main Menu -->
        <record id="theme_menu_aboutus_buildcraft" model="theme.website.menu">
            <field name="name">About</field>
            <field name="url">/about</field>
            <field name="use_main_menu_as_parent" eval="True"/>
            <field name="sequence" type="int">20</field>
        </record>

        <!-- Register the Services Page Route -->
        <record id="theme_services_page_buildcraft" model="theme.website.page">
            <field name="url">/services</field>
            <field name="view_id" ref="theme_buildcraft.services_template"/>
            <field name="is_published">True</field>
        </record>

        <!-- Add Services to Main Menu -->
        <record id="theme_menu_services_buildcraft" model="theme.website.menu">
            <field name="name">Services</field>
            <field name="url">/services</field>
            <field name="use_main_menu_as_parent" eval="True"/>
            <field name="sequence" type="int">30</field>
        </record>

        <!-- Register the Projects Page Route -->
        <record id="theme_projects_page_buildcraft" model="theme.website.page">
            <field name="url">/projects</field>
            <field name="view_id" ref="theme_buildcraft.projects_template"/>
            <field name="is_published">True</field>
        </record>

        <!-- Add Projects to Main Menu -->
        <record id="theme_menu_projects_buildcraft" model="theme.website.menu">
            <field name="name">Projects</field>
            <field name="url">/projects</field>
            <field name="use_main_menu_as_parent" eval="True"/>
            <field name="sequence" type="int">40</field>
        </record>

        <!-- Register the Team Page Route -->
        <record id="theme_team_page_buildcraft" model="theme.website.page">
            <field name="url">/team</field>
            <field name="view_id" ref="theme_buildcraft.team_template"/>
            <field name="is_published">True</field>
        </record>

        <!-- Add Team to Main Menu -->
        <record id="theme_menu_team_buildcraft" model="theme.website.menu">
            <field name="name">Team</field>
            <field name="url">/team</field>
            <field name="use_main_menu_as_parent" eval="True"/>
            <field name="sequence" type="int">50</field>
        </record>
    </data>
</odoo>