<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Users only see the Google Drive files of their own attachments -->
    <record id="google_drive_attachment_rule_user" model="ir.rule">
        <field name="name">Google Drive Attachment: own files only</field>
        <field name="model_id" ref="model_google_drive_attachment"/>
        <field name="domain_force">[('attachment_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- Administrators see the Google Drive files of all users -->
    <record id="google_drive_attachment_rule_system" model="ir.rule">
        <field name="name">Google Drive Attachment: all files</field>
        <field name="model_id" ref="model_google_drive_attachment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
