<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Google Drive Account List View -->
    <record id="google_drive_account_view_list" model="ir.ui.view">
        <field name="name">google.drive.account.view.list</field>
        <field name="model">google.drive.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Google Drive Account Form View -->
    <record id="google_drive_account_view_form" model="ir.ui.view">
        <field name="name">google.drive.account.view.form</field>
        <field name="model">google.drive.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                    <button
                        name="action_connect"
                        type="object"
                        string="Connect Google Drive"
                        class="btn-primary"
                        invisible="state == 'connected'"/>
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="client_id"/>
                        <field name="client_secret" password="True"/>
                        <field name="drive_folder_id"/>
                        <field name="keep_local_copy"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Google Drive Account Window Action -->
    <record id="action_google_drive_config" model="ir.actions.act_window">
        <field name="name">Google Drive</field>
        <field name="res_model">google.drive.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_google_drive_root"
              name="Google Drive Connector"
              web_icon="google_drive_odoo_connector,static/description/icon.png"/>
    <menuitem
        id="menu_google_drive_config"
        name="Configuration"
        parent="menu_google_drive_root"
        action="action_google_drive_config"
        groups="base.group_system"
        sequence="2"/>
</odoo>
