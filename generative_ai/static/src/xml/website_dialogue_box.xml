<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="generative_ai.generate_button" t-inherit="html_builder.AddSnippetDialog"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'overflow-hidden')]" position="after">
            <div class="o_add_snippet_dialog_wrapper position-relative h-100">
                <button type="button"
                        class="btn btn-primary generate_with_ai"
                        style="position: absolute; bottom: 0; right: 15px; margin-bottom: 15px; white-space: nowrap;"
                        t-on-click="_onGenerateClick">
                    Generate with AI
                </button>
            </div>
        </xpath>
    </t>
</templates>