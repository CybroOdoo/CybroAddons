<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_receipt_invoice_send_whatsapp.FeedbackScreen"
       t-inherit="point_of_sale.FeedbackScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('desktop-format')]" position="attributes">
            <attribute name="class" add="flex-wrap align-items-start" separator=" "/>
        </xpath>
        <!-- Add WhatsApp Send buttons to desktop format FeedbackScreen -->
        <xpath expr="//div[hasclass('desktop-format')]/button[hasclass('send-receipt')]" position="after">
            <div t-if="this.pos.config.pos_whatsapp_enabled and (this.pos.config.apply_send_receipt_or_invoice == 'send_invoice' or this.pos.config.apply_send_receipt_or_invoice == 'both' or !this.pos.config.apply_send_receipt_or_invoice)"
                 class="d-flex flex-column flex-basis-25 text-start">
                <button t-att-disabled="this.loading() || this.currentOrder.state == 'draft' || (this.isSendingInvoice and this.isSendingInvoice()) || (this.isSendingReceipt and this.isSendingReceipt())"
                        class="button btn btn-secondary btn-lg lh-lg text-truncate w-100 py-3 rounded-3 send-whatsapp-invoice"
                        t-on-click.stop="() => this.sendInvoiceOnWhatsapp()">
                    <i t-if="this.isSendingInvoice and this.isSendingInvoice()" class="oi oi-fw oi-spin me-2" data-icon="autorenew" role="img" aria-label="Loading" style="font-size: 1.2rem;"/>
                    <i t-else="" class="oi oi-lg text-success me-2" data-icon="oi_whatsapp" role="img" aria-label="WhatsApp" style="font-size: 1.2rem;"/>
                    Send Invoice
                </button>
                <div class="notice mt-2">
                    <div t-if="this.whatsappInvoiceNotice and this.whatsappInvoiceNotice()"
                         t-attf-class="{{ this.whatsappInvoiceSuccessful and this.whatsappInvoiceSuccessful() ? 'successful text-success' : 'failed text-danger' }}"
                         style="font-size: 0.85rem; line-height: 1.3;">
                        <t t-out="this.whatsappInvoiceNotice()"/>
                    </div>
                </div>
            </div>
            <div t-if="this.pos.config.pos_whatsapp_enabled and (this.pos.config.apply_send_receipt_or_invoice == 'send_receipt' or this.pos.config.apply_send_receipt_or_invoice == 'both' or !this.pos.config.apply_send_receipt_or_invoice)"
                 class="d-flex flex-column flex-basis-25 text-start">
                <button t-att-disabled="this.loading() || this.currentOrder.state == 'draft' || (this.isSendingReceipt and this.isSendingReceipt()) || (this.isSendingInvoice and this.isSendingInvoice())"
                        class="button btn btn-secondary btn-lg lh-lg text-truncate w-100 py-3 rounded-3 send-whatsapp-receipt"
                        t-on-click.stop="() => this.sendReceiptOnWhatsapp()">
                    <i t-if="this.isSendingReceipt and this.isSendingReceipt()" class="oi oi-fw oi-spin me-2" data-icon="autorenew" role="img" aria-label="Loading" style="font-size: 1.2rem;"/>
                    <i t-else="" class="oi oi-lg text-success me-2" data-icon="oi_whatsapp" role="img" aria-label="WhatsApp" style="font-size: 1.2rem;"/>
                    Send Receipt
                </button>
                <div class="notice mt-2">
                    <div t-if="this.whatsappReceiptNotice and this.whatsappReceiptNotice()"
                         t-attf-class="{{ this.whatsappReceiptSuccessful and this.whatsappReceiptSuccessful() ? 'successful text-success' : 'failed text-danger' }}"
                         style="font-size: 0.85rem; line-height: 1.3;">
                        <t t-out="this.whatsappReceiptNotice()"/>
                    </div>
                </div>
            </div>
        </xpath>
        <!-- Add WhatsApp Send buttons to mobile format FeedbackScreen -->
        <xpath expr="//div[hasclass('mobile-format')]" position="inside">
            <div t-if="this.pos.config.pos_whatsapp_enabled" class="d-flex w-100 gap-1 flex-column">
                <div class="d-flex w-100 gap-1">
                    <div t-if="this.pos.config.apply_send_receipt_or_invoice == 'send_invoice' or this.pos.config.apply_send_receipt_or_invoice == 'both' or !this.pos.config.apply_send_receipt_or_invoice"
                         class="d-flex flex-column flex-grow-1 text-start">
                        <button t-att-disabled="this.loading() || this.currentOrder.state == 'draft' || (this.isSendingInvoice and this.isSendingInvoice()) || (this.isSendingReceipt and this.isSendingReceipt())"
                                class="btn btn-secondary btn-lg lh-lg text-truncate w-100 send-whatsapp-invoice"
                                t-on-click.stop="() => this.sendInvoiceOnWhatsapp()">
                            <i t-if="this.isSendingInvoice and this.isSendingInvoice()" class="oi oi-fw oi-spin me-2" data-icon="autorenew" role="img" aria-label="Loading"/>
                            <i t-else="" class="oi oi-lg text-success me-2" data-icon="oi_whatsapp" role="img" aria-label="WhatsApp"/>
                            Send Invoice
                        </button>
                        <div class="notice mt-1">
                            <div t-if="this.whatsappInvoiceNotice and this.whatsappInvoiceNotice()"
                                 t-attf-class="{{ this.whatsappInvoiceSuccessful and this.whatsappInvoiceSuccessful() ? 'successful text-success' : 'failed text-danger' }}"
                                 style="font-size: 0.8rem; line-height: 1.2;">
                                <t t-out="this.whatsappInvoiceNotice()"/>
                            </div>
                        </div>
                    </div>
                    <div t-if="this.pos.config.apply_send_receipt_or_invoice == 'send_receipt' or this.pos.config.apply_send_receipt_or_invoice == 'both' or !this.pos.config.apply_send_receipt_or_invoice"
                         class="d-flex flex-column flex-grow-1 text-start">
                        <button t-att-disabled="this.loading() || this.currentOrder.state == 'draft' || (this.isSendingReceipt and this.isSendingReceipt()) || (this.isSendingInvoice and this.isSendingInvoice())"
                                class="btn btn-secondary btn-lg lh-lg text-truncate w-100 send-whatsapp-receipt"
                                t-on-click.stop="() => this.sendReceiptOnWhatsapp()">
                            <i t-if="this.isSendingReceipt and this.isSendingReceipt()" class="oi oi-fw oi-spin me-2" data-icon="autorenew" role="img" aria-label="Loading"/>
                            <i t-else="" class="oi oi-lg text-success me-2" data-icon="oi_whatsapp" role="img" aria-label="WhatsApp"/>
                            Send Receipt
                        </button>
                        <div class="notice mt-1">
                            <div t-if="this.whatsappReceiptNotice and this.whatsappReceiptNotice()"
                                 t-attf-class="{{ this.whatsappReceiptSuccessful and this.whatsappReceiptSuccessful() ? 'successful text-success' : 'failed text-danger' }}"
                                 style="font-size: 0.8rem; line-height: 1.2;">
                                <t t-out="this.whatsappReceiptNotice()"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
