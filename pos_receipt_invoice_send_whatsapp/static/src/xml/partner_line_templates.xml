<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_whatsapp_integration.PartnerLine"
       t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension" owl="1">
        <!--Inherit point_of_sale.PartnerLine to incorporate the partner's
        WhatsApp number into the partner line.-->
        <xpath expr="//div[hasclass('partner-line-email')]" position="inside">
            <div t-if="props.partner.whatsapp_number" class="email-field mb-1 d-flex align-items-center">
                <i class="fa fa-whatsapp me-2 text-success" style="font-size: 16px;"/>
                <t t-esc="props.partner.whatsapp_number"/>
            </div>
        </xpath>
        <xpath expr="//td[hasclass('partner-line-email')]" position="inside">
            <div t-if="props.partner.whatsapp_number" class="email-field d-flex align-items-center mt-1">
                <i class="fa fa-whatsapp me-2 text-success" style="font-size: 16px;"/>
                <t t-esc="props.partner.whatsapp_number"/>
            </div>
        </xpath>
    </t>
</templates>
