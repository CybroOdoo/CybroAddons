<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Record Rule to Restrict Access for group_pos_user -->
        <record id="restrict_whatsapp_user" model="ir.access">
            <field name="name">Restrict Whatsapp Message for Users</field>
            <field name="model_id" ref="model_whatsapp_message"/>
            <field name="group_id" ref="point_of_sale.group_pos_user"/>
            <field name="operation">crud</field>
            <field name="domain">[('from_user_id', '=', user.id)]</field>
        </record>

        <!-- Record Rule to Allow Access for group_pos_manager -->
        <record id="allow_whatsapp_manager" model="ir.access">
            <field name="name">Allow Whatsapp Message for Managers</field>
            <field name="model_id" ref="model_whatsapp_message"/>
            <field name="group_id" ref="point_of_sale.group_pos_manager"/>
            <field name="operation">crud</field>
        </record>
    </data>
</odoo>
