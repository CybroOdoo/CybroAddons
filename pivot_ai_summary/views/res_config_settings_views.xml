<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_res_config_settings_pivot_ai" model="ir.ui.view">
        <field name="name">res.config.settings.pivot.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="pivot_ai_summary" string="Pivot AI Settings" web_icon="static/description/icon.png">
                    <block title="AI Configuration">

                        <setting string="Enable Summary">
                            <field name="enable_pivot_ai_summary"/>

                            <div class="content-group mt-3"
                                 invisible="not enable_pivot_ai_summary">

                                <group>
                                    <field name="generative_ai_systems"/>
                                    <field name="api_key" password="True"
                                           invisible="generative_ai_systems not in ['openai', 'openrouter','gemini']"/>

                                    <field name="model_id"
                                           invisible="generative_ai_systems != 'openai'"/>

                                    <field name="openrouter_model_id"
                                           invisible="generative_ai_systems != 'openrouter'"/>

                                    <field name="gemini_model_id"
                                           invisible="generative_ai_systems != 'gemini'"/>
                                    <div colspan="2" class="text-muted" invisible="generative_ai_systems != 'odoo'">
                                        <i class="fa fa-info-circle"/>
                                        Uses Odoo's internal AI service. Requires a registered database.
                                    </div>
                                </group>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>