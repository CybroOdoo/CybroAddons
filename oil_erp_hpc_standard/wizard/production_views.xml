<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_production_wizard_form_hpm" model="ir.ui.view">
        <field name="name">production.wizard.form.inherit.hpm</field>
        <field name="model">production.wizard</field>
        <field name="inherit_id" ref="oil_erp_project.view_production_wizard_form"/>
        <field name="arch" type="xml">

            <!-- Header defaults auto-filled from tank telemetry -->
            <xpath expr="//field[@name='storage_location_id']" position="after">
                <field name="api_gravity" string="Default API Gravity"/>
                <field name="temperature" string="Default Temp (°F)"/>
                <field name="pressure"    string="Default Press (psi)"/>
            </xpath>

            <!-- Hidden helper column -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_id']" position="after">
                <field name="is_hpm_enabled" column_invisible="True"/>
            </xpath>

            <!-- HPM measurement columns before produced_qty -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='produced_qty']" position="before">
                <field name="observed_qty"  string="Observed Qty"
                       decoration-bf="is_hpm_enabled"/>
                <field name="temperature"   string="Temp (°F)"
                       invisible="not is_hpm_enabled"
                       required="is_hpm_enabled"/>
                <field name="pressure"      string="Press (psi)"
                       invisible="not is_hpm_enabled"
                       required="is_hpm_enabled"/>
                <field name="api_gravity"   string="API Gravity"
                       invisible="not is_hpm_enabled"
                       required="is_hpm_enabled"/>
                <field name="water_content" string="BSW %"
                       invisible="not is_hpm_enabled" optional="show"/>
                <field name="sulfur_content" string="Sulfur %"
                       invisible="not is_hpm_enabled" optional="hide"/>
                <field name="vcf"           string="VCF"
                       invisible="not is_hpm_enabled"
                       readonly="True" force_save="True"/>
                <!-- VCF range warnings — show as orange badge when non-empty -->
                <field name="vcf_warnings"  string="⚠ Range"
                       invisible="not is_hpm_enabled or not vcf_warnings"
                       readonly="True" optional="show"
                       widget="text"/>
            </xpath>

            <!-- Relabel produced_qty column; make readonly when HPM drives it -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='produced_qty']"
                   position="attributes">
                <attribute name="string">Standard Qty</attribute>
                <attribute name="readonly">is_hpm_enabled</attribute>
                <attribute name="force_save">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>