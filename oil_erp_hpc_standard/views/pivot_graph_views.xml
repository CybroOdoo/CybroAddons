<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
    <!-- Pivot view for product.category -->
    <record id="view_product_category_pivot" model="ir.ui.view">
        <field name="name">product.category.pivot</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <pivot string="Product Category Analysis">
            <field name="create_date" interval="month" type="row"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view for product.category -->
    <record id="view_product_category_graph" model="ir.ui.view">
        <field name="name">product.category.graph</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <graph string="Product Category Analysis" type="bar">
                <field name="create_date" interval="month"/>
            </graph>
        </field>
    </record>
    </data>
</odoo>