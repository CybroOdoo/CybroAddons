<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_template_form_hpm" model="ir.ui.view">
        <field name="name">product.template.form.inherit.hpm</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">

                <field name="is_hpm_enabled" string="HPM Volume Correction"/>
                <field name="hpm_standardisation" invisible="not is_hpm_enabled"/>

                <!-- API product group — liquid standards only -->
                <field name="hpm_api_product_group"
                       invisible="not is_hpm_enabled or
                                  hpm_standardisation not in
                                  ('ASTM-D1250','OIML-R117','SAES-Y-100','AGES-SP-11-01')"/>

                <!-- Reference conditions -->
                <field name="hpm_standard_temperature" invisible="not is_hpm_enabled"/>
                <field name="hpm_standard_pressure"    invisible="not is_hpm_enabled"/>
                <field name="hpm_standard_api_gravity" invisible="not is_hpm_enabled"/>
                <field name="hpm_water_content"        invisible="not is_hpm_enabled"/>
                <field name="hpm_sulfur_content"       invisible="not is_hpm_enabled"/>

                <!-- Gas composition — AGA-8 only -->
                <field name="hpm_gas_y_ch4"
                       invisible="not is_hpm_enabled or
                                  hpm_standardisation not in ('AGA-8','AGA-3','ISO-6976')"
                       string="CH₄ mol%"/>
                <field name="hpm_gas_y_c2h6"
                       invisible="not is_hpm_enabled or
                                  hpm_standardisation not in ('AGA-8','AGA-3','ISO-6976')"
                       string="C₂H₆ mol%"/>
                <field name="hpm_gas_y_c3h8"
                       invisible="not is_hpm_enabled or
                                  hpm_standardisation not in ('AGA-8','AGA-3','ISO-6976')"
                       string="C₃H₈ mol%"/>
                <field name="hpm_gas_y_co2"
                       invisible="not is_hpm_enabled or
                                  hpm_standardisation not in ('AGA-8','AGA-3','ISO-6976')"
                       string="CO₂ mol%"/>
                <field name="hpm_gas_y_n2"
                       invisible="not is_hpm_enabled or
                                  hpm_standardisation not in ('AGA-8','AGA-3','ISO-6976')"
                       string="N₂ mol%"/>
                <field name="hpm_gas_y_h2s"
                       invisible="not is_hpm_enabled or
                                  hpm_standardisation not in ('AGA-8','AGA-3','ISO-6976')"
                       string="H₂S mol%"/>

                <!-- Playground outputs -->
                <field name="hpm_observed_temperature" invisible="not is_hpm_enabled"/>
                <field name="hpm_observed_pressure"    invisible="not is_hpm_enabled"/>
                <field name="hpm_observed_api_gravity" invisible="not is_hpm_enabled"/>
                <field name="hpm_observed_volume"      invisible="not is_hpm_enabled"/>
                <field name="hpm_ctl"          readonly="1" invisible="not is_hpm_enabled"/>
                <field name="hpm_cpl"          readonly="1" invisible="not is_hpm_enabled"/>
                <field name="hpm_vcf"          readonly="1" invisible="not is_hpm_enabled"/>
                <field name="hpm_compressibility" readonly="1" invisible="not is_hpm_enabled"/>
                <field name="hpm_standard_volume" readonly="1" invisible="not is_hpm_enabled"/>

                <!-- VCF range warnings banner -->
                <div class="alert alert-warning" role="alert"
                     invisible="not is_hpm_enabled or not hpm_vcf_warnings">
                    <i class="fa fa-exclamation-triangle" title="Warning"/>
                    <field name="hpm_vcf_warnings" readonly="1" nolabel="1"
                           widget="text" style="border:none;background:transparent;"/>
                </div>

                <button name="action_reset_hpm_to_category"
                        type="object"
                        string="Reset to Category Defaults"
                        class="btn-link"
                        invisible="not is_hpm_enabled or not categ_id"/>
            </xpath>
        </field>
    </record>
</odoo>