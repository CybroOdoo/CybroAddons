<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_category_form_inherit_hpm_oilbase" model="ir.ui.view">
        <field name="name">product.category.form.inherit.hpm.oilbase</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="oil_erp_base.view_oil_product_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Hydrocarbon Product Measurement (HPM)" name="hpm_group">
                    <group string="Standard Selection">
                        <field name="is_hpm_enabled"/>
                        <field name="hpm_standardisation"
                               invisible="not is_hpm_enabled"
                               required="is_hpm_enabled"/>
                        <!-- API product group — liquid standards only -->
                        <field name="hpm_api_product_group"
                               invisible="not is_hpm_enabled or
                                          hpm_standardisation not in
                                          ('ASTM-D1250','OIML-R117',
                                           'SAES-Y-100','AGES-SP-11-01')"/>
                        <field name="hpm_k0_display"
                               string="K0 Constant (informational)"
                               readonly="1"
                               invisible="not is_hpm_enabled or
                                          hpm_standardisation not in
                                          ('ASTM-D1250','OIML-R117',
                                           'SAES-Y-100','AGES-SP-11-01')"/>
                    </group>
                    <group string="Reference Conditions">
                        <field name="hpm_standard_temperature"
                               invisible="not is_hpm_enabled"/>
                        <field name="hpm_standard_pressure"
                               invisible="not is_hpm_enabled"/>
                        <field name="hpm_standard_api_gravity"
                               invisible="not is_hpm_enabled"/>
                        <field name="hpm_water_content"
                               invisible="not is_hpm_enabled"/>
                        <field name="hpm_sulfur_content"
                               invisible="not is_hpm_enabled"/>
                    </group>

                    <!-- Gas composition — AGA-8 only -->
                    <group string="Gas Composition (AGA-8)"
                           invisible="not is_hpm_enabled or
                                      hpm_standardisation not in ('AGA-8','AGA-3','ISO-6976')">
                        <group>
                            <field name="hpm_gas_y_ch4"  string="Methane CH₄ (mol%)"/>
                            <field name="hpm_gas_y_c2h6" string="Ethane C₂H₆ (mol%)"/>
                            <field name="hpm_gas_y_c3h8" string="Propane C₃H₈ (mol%)"/>
                        </group>
                        <group>
                            <field name="hpm_gas_y_co2"  string="CO₂ (mol%)"/>
                            <field name="hpm_gas_y_n2"   string="N₂ (mol%)"/>
                            <field name="hpm_gas_y_h2s"  string="H₂S (mol%)"/>
                            <field name="hpm_gas_composition_total"
                                   string="Total (mol%)" readonly="1"
                                   decoration-danger="hpm_gas_composition_total != 100.0"/>
                        </group>
                        <div class="alert alert-info" role="alert"
                             invisible="hpm_gas_composition_total == 100.0">
                            <i class="fa fa-info-circle"/> Mole percentages do not sum to 100%.
                            Values are normalized internally before use — adjust to avoid silent errors.
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Product Categories action / menu -->
    <record id="action_product_category_hpm" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first product category</p>
            <p>
                Product categories drive HPM volume correction defaults —
                standardization, API product group (A–F), reference conditions,
                and gas composition — for every product they contain.
            </p>
        </field>
    </record>
</odoo>