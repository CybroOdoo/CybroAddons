<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- About page: the sections are copies of the Voltro snippets, so they
         belong to this page and can be edited or removed in the editor -->
    <template id="about_page" name="About">
        <t t-set="additional_title">About</t>
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section data-snippet="sub_banner" data-name="Page Banner" class="sub_banner about_banner"
                         style="background-image: url('/theme_voltro/static/src/images/banner/about-banner.png');">
                    <div class="wrapper">
                        <div class="container">
                            <div class="sub_banner_content">
                                <h3>About</h3>
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item">
                                            <a href="/">Home</a>
                                            <svg width="9" height="13"
                                                 viewBox="0 0 9 13" fill="none"
                                                 xmlns="http://www.w3.org/2000/svg">
                                                <path
                                                        d="M8.56628 6.99805L2.88269 12.7109C2.58972 12.9746 2.15027 12.9746 1.8866 12.7109L1.21277 12.0371C0.949097 11.7734 0.949097 11.334 1.21277 11.041L5.72449 6.5L1.21277 1.98828C0.949097 1.69531 0.949097 1.25586 1.21277 0.992188L1.8866 0.318359C2.15027 0.0546875 2.58972 0.0546875 2.88269 0.318359L8.56628 6.03125C8.82996 6.29492 8.82996 6.73438 8.56628 6.99805Z"
                                                        fill="white"/>
                                            </svg>
                                        </li>
                                        <li class="breadcrumb-item active"
                                            aria-current="page">
                                            About
                                        </li>
                                    </ol>
                                </nav>
                            </div>
                        </div>
                    </div>
                </section>
                <section data-snippet="services_banner" data-name="Services" class="about_page">
                    <div class="wrapper">
                        <div class="container">
                            <div class="row g-4 service">
                                <div class="col-md-4 service_wrapprer">
                                    <img src="/theme_voltro/static/src/images/about/Services.svg" alt="Delivery"/>
                                    <h5>FREE AND FAST DELIVERY</h5>
                                    <p>Free delivery for all orders over $140</p>
                                </div>
                                <div class="col-md-4 service_wrapprer">
                                    <img src="/theme_voltro/static/src/images/about/Services (3).svg" alt="Support"/>
                                    <h5>24/7 CUSTOMER SERVICE</h5>
                                    <p>Friendly 24/7 customer support</p>
                                </div>
                                <div class="col-md-4 service_wrapprer">
                                    <img src="/theme_voltro/static/src/images/about/Services (4).svg" alt="Guarantee"/>
                                    <h5>MONEY BACK GUARANTEE</h5>
                                    <p>We return money within 30 days</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section data-snippet="about_story" data-name="Our Story" class="about_story">
                    <div class="wrapper">
                        <div class="container">
                            <!-- Our Story -->
                            <div class="our_story">
                                <div class="row">
                                    <div class="col-lg-6 col-12">
                                        <div class="our_story_right">
                                            <h3>Our Story</h3>
                                            <p>
                                                Launched in 2015, TechMart is South
                                                Asia's leading online marketplace
                                                for
                                                gadgets, with a strong presence in
                                                Bangladesh. Offering a wide range
                                                of
                                                innovative marketing, data,
                                                and service solutions, TechMart
                                                features 10,500 sellers and 300 top
                                                brands,
                                                serving 3 million tech enthusiasts
                                                across the region.
                                            </p>
                                            <p>
                                                Exclusive has more than 1 Million
                                                products to offer, growing very fast.
                                                Exclusive offers a diverse
                                                assortment
                                                in categories ranging from
                                                consumer.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-12">
                                        <div class="our_story_left">
                                            <img src="/theme_voltro/static/src/images/about/about-1.png"
                                                 alt=""/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section data-snippet="about_achievements" data-name="Achievements" class="about_achievements">
                    <div class="wrapper">
                        <div class="container">
                            <div class="achievements">
                                <div class="row g-4 stats_wrapp">
                                    <div class="col-lg-3 col-sm-6">
                                        <div class="stat">
                                            <img src="/theme_voltro/static/src/images/about/1.svg" alt="Sellers"/>
                                            <h2 class="number" data-target="10">0</h2>
                                            <p class="type">Sellers active on our site</p>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-sm-6">
                                        <div class="stat">
                                            <img src="/theme_voltro/static/src/images/about/2.svg" alt="Sales"/>
                                            <h2 class="number" data-target="99">0</h2>
                                            <p class="type">Monthly product sales</p>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-sm-6">
                                        <div class="stat active">
                                            <img src="/theme_voltro/static/src/images/about/3.svg" alt="Customers"/>
                                            <h2 class="number" data-target="60">0</h2>
                                            <p class="type">Customers active on our site</p>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-sm-6">
                                        <div class="stat">
                                            <img src="/theme_voltro/static/src/images/about/Services.png" alt="Revenue"/>
                                            <h2 class="number" data-target="30">0</h2>
                                            <p class="type">Annual gross sales on our site</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section data-snippet="about_team" data-name="Team" class="about_team">
                    <div class="wrapper">
                        <div class="container">
                            <div class="row g-5 team">
                                <div class="col-lg-4 col-md-6">
                                    <div class="card_wrapper">
                                        <div class="img_wrapper">
                                            <img src="/theme_voltro/static/src/images/about/Frame 874.png" alt="Jacob Thomas"/>
                                        </div>
                                        <div class="card_bottom">
                                            <div class="name">Jacob Thomas</div>
                                            <div class="position">Founder &amp; Chairman</div>
                                            <div class="icons">
                                                <img src="/theme_voltro/static/src/images/about/Icon-Twitter.png" alt="Twitter"/>
                                                <img src="/theme_voltro/static/src/images/about/icon-instagram.png" alt="Instagram"/>
                                                <img src="/theme_voltro/static/src/images/about/Icon-Linkedin.png" alt="LinkedIn"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6">
                                    <div class="card_wrapper">
                                        <div class="img_wrapper">
                                            <img src="/theme_voltro/static/src/images/about/Frame 874.png" alt="Jacob Thomas"/>
                                        </div>
                                        <div class="card_bottom">
                                            <div class="name">Jacob Thomas</div>
                                            <div class="position">Founder &amp; Chairman</div>
                                            <div class="icons">
                                                <img src="/theme_voltro/static/src/images/about/Icon-Twitter.png" alt="Twitter"/>
                                                <img src="/theme_voltro/static/src/images/about/icon-instagram.png" alt="Instagram"/>
                                                <img src="/theme_voltro/static/src/images/about/Icon-Linkedin.png" alt="LinkedIn"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6">
                                    <div class="card_wrapper">
                                        <div class="img_wrapper">
                                            <img src="/theme_voltro/static/src/images/about/Frame 874.png" alt="Jacob Thomas"/>
                                        </div>
                                        <div class="card_bottom">
                                            <div class="name">Jacob Thomas</div>
                                            <div class="position">Founder &amp; Chairman</div>
                                            <div class="icons">
                                                <img src="/theme_voltro/static/src/images/about/Icon-Twitter.png" alt="Twitter"/>
                                                <img src="/theme_voltro/static/src/images/about/icon-instagram.png" alt="Instagram"/>
                                                <img src="/theme_voltro/static/src/images/about/Icon-Linkedin.png" alt="LinkedIn"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="about_page_page" model="theme.website.page">
        <field name="url">/about</field>
        <field name="view_id" ref="about_page"/>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
