<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Header Template-->
    <template id="theme_voltro_header" name="Voltro Header" inherit_id="website.layout">
        <xpath expr="//header" position="replace">
            <header class="navigation" id="top">
                <div class="wrapper bg-dark">
                    <div class="container">
                        <nav class="navbar navbar-expand-lg w-100">
                            <div class="container-fluid p-0">
                                <a class="navbar-brand" href="/">
                                    <img src="/theme_voltro/static/src/images/Logo/voltro_logo.png"
                                         alt="Voltro"/>
                                </a>
                                <button class="navbar-toggler collapsed" type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#navbarSupportedContent"
                                        aria-controls="navbarSupportedContent"
                                        aria-expanded="false"
                                        aria-label="Toggle navigation">
                                    <i class="bi bi-list"/>
                                    <i class="bi bi-x-lg"/>
                                </button>
                                <div class="collapse navbar-collapse"
                                     id="navbarSupportedContent">
                                    <ul id="top_menu" class="nav navbar-nav top_menu me-auto">
                                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                            <t t-call="website.submenu"
                                               item_class.f="nav-item"
                                               link_class.f="nav-link"/>
                                        </t>
                                    </ul>
                                </div>
                                <div class="nav_icons d-block">
                                    <ul>
                                        <t t-call="website_sale.header_cart_link"
                                           _icon="True"
                                           _item_class.f="nav-item ms-lg-3"
                                           _link_class.f="nav-link btn position-relative p-1 rounded-circle text-reset"
                                           _badge_class.f="position-absolute top-0 end-0 rounded-pill mt-n1 me-n1"/>
                                        <t t-call="website_sale.header_wishlist_link"
                                           _icon="True"
                                           _item_class.f="nav-item ms-lg-3"
                                           _link_class.f="nav-link btn position-relative p-1 rounded-circle text-reset"
                                           _badge_class.f="position-absolute top-0 end-0 rounded-pill mt-n1 me-n1"/>
                                        <li>
                                            <!-- Search Bar -->
                                            <t t-call="website.placeholder_header_search_box"
                                               _layout.f="modal"
                                               _input_classes.f="border border-end-0 p-3"
                                               _submit_classes.f="border border-start-0 px-4 bg-o-color-4"
                                               _button_classes.f="o_navlink_background text-reset"/>
                                        </li>
                                        <li>
                                            <t t-call="portal.placeholder_user_sign_in"
                                               _link_class.f="btn btn-outline-secondary"/>
                                        </li>
                                        <li>
                                            <t t-call="portal.user_dropdown"
                                               _user_name="True"
                                               _item_class.f="dropdown"
                                               _link_class.f="btn-outline-secondary border-0 fw-bold"
                                               _user_name_class.f="small"
                                               _dropdown_menu_class.f="dropdown-menu-end"/>
                                        </li>
                                        <li>
                                            <t t-call="website.placeholder_header_language_selector"
                                               _btn_class.f="btn-outline-secondary border-0"
                                               _txt_class.f="small"
                                               _dropdown_menu_class.f="dropdown-menu-end"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </nav>
                    </div>
                </div>
            </header>
        </xpath>
    </template>
</odoo>
