<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Footer -->
    <template id="theme_voltro_footer" inherit_id="website.layout" name="Voltro Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo voltro_footer" t-ignore="true" t-if="not no_footer">
                <section class="voltro_footer_main">
                    <div class="container">
                        <div class="row g-5">
                            <div class="col-lg-4 col-md-6">
                                <a class="voltro_footer_brand" href="/">
                                    <img src="/theme_voltro/static/src/images/Logo/voltro_logo.png" alt="Voltro"/>
                                </a>
                                <p class="voltro_footer_text">
                                    Premium gadgets, audio and smart devices, picked for people
                                    who love great technology.
                                </p>
                                <ul class="voltro_footer_social list-unstyled">
                                    <li><a href="#" aria-label="Facebook" title="Facebook"><i class="bi bi-facebook"/></a></li>
                                    <li><a href="#" aria-label="X" title="X"><i class="bi bi-twitter-x"/></a></li>
                                    <li><a href="#" aria-label="Instagram" title="Instagram"><i class="bi bi-instagram"/></a></li>
                                    <li><a href="#" aria-label="LinkedIn" title="LinkedIn"><i class="bi bi-linkedin"/></a></li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-3 col-6">
                                <h5 class="voltro_footer_title">Shop</h5>
                                <ul class="voltro_footer_links list-unstyled">
                                    <li><a href="/shop">All Products</a></li>
                                    <li><a href="/shop/wishlist">Wishlist</a></li>
                                    <li><a href="/shop/compare">Compare</a></li>
                                    <li><a href="/shop/cart">Cart</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-3 col-6">
                                <h5 class="voltro_footer_title">Company</h5>
                                <ul class="voltro_footer_links list-unstyled">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/about">About Us</a></li>
                                    <li><a href="/contactus">Contact</a></li>
                                    <li><a href="/my">My Account</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <h5 class="voltro_footer_title">Contact Us</h5>
                                <ul class="voltro_footer_contact list-unstyled">
                                    <li><i class="bi bi-geo-alt"/><span>Lumbung Hidup, East Java</span></li>
                                    <li><i class="bi bi-telephone"/><a href="tel:+123456789">+123 456 789</a></li>
                                    <li><i class="bi bi-envelope"/><a href="mailto:support@voltro.com">support@voltro.com</a></li>
                                </ul>
                                <a href="/contactus" class="btn btn-secondary">Get in Touch</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="replace">
            <div t-if="not no_copyright" class="o_footer_copyright voltro_footer_bottom">
                <div class="container">
                    <div class="voltro_footer_bottom_row">
                        <p class="mb-0">
                            &amp;copy; <t t-out="datetime.date.today().year"/>
                            <span t-field="res_company.name"/>. All rights reserved.
                        </p>
                        <ul class="list-unstyled mb-0">
                            <li><a href="#">Disclaimer</a></li>
                            <li><a href="#">Privacy Policy</a></li>
                            <li><a href="#">Terms of Use</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
