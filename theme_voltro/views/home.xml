<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Home page: the sections are copies of the Voltro snippets, so they
         belong to this page and can be edited or removed in the editor -->
    <template id="voltro_home_page" name="Voltro Home Page" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <section data-snippet="home_banner" data-name="Home Banner" class="home_banner">
                    <div class="wrapper">
                        <div class="container">
                            <div class="slider_grid">
                                <!-- Main Carousel -->
                                <div class="splide main_carousel">
                                    <div class="splide__track">
                                        <ul class="splide__list">
                                            <li class="splide__slide">
                                                <img src="/theme_voltro/static/src/images/banner/1.png"
                                                     class="rotating-image"
                                                     alt="Slide 1"/>
                                            </li>
                                            <li class="splide__slide">
                                                <img src="/theme_voltro/static/src/images/banner/2.png"
                                                     class="rotating-image"
                                                     alt="Slide 2"/>
                                            </li>
                                            <li class="splide__slide">
                                                <img src="/theme_voltro/static/src/images/banner/3.png"
                                                     class="rotating-image"
                                                     alt="Slide 3"/>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="right animeMian">
                                    <div class="banner_right">
                                        <div class="offer">
                                            Flat 30% off on all Digital
                                        </div>
                                        <div class="banner_heading">
                                            <h1 data-speed="0.95"
                                                class="split-text">Bowers &amp;
                                                Wilkins
                                            </h1>
                                            <h1 data-speed="0.9"
                                                class="split-text">
                                                Bowers &amp; Wilkins
                                            </h1>
                                            <h1 data-speed="0.85"
                                                class="split-text">Bowers &amp;
                                                Wilkins
                                            </h1>
                                            <h1 data-speed="0.8"
                                                class="split-text">
                                                Bowers &amp; Wilkins
                                            </h1>
                                            <h1 data-speed="0.75"
                                                class="split-text">Bowers &amp;
                                                Wilkins
                                            </h1>
                                            <h1 data-speed="0.7"
                                                class="split-text">
                                                Bowers &amp; Wilkins
                                            </h1>
                                        </div>
                                        <p>Allow yourself to be immersed in
                                            sound.
                                            Don't let the ordinary confine you.
                                        </p>
                                        <a href="/shop" class="btn btn-primary">
                                            SHOP
                                            NOW
                                        </a>
                                    </div>
                                    <!-- Thumbnail Carousel -->
                                    <div class="splide thumbnail_carousel">
                                        <div class="splide__track">
                                            <ul class="splide__list">
                                                <li class="splide__slide">
                                                    <img src="/theme_voltro/static/src/images/banner/1.png"
                                                         alt="Thumbnail 1"/>
                                                </li>
                                                <li class="splide__slide">
                                                    <img src="/theme_voltro/static/src/images/banner/2.png"
                                                         alt="Thumbnail 2"/>
                                                </li>
                                                <li class="splide__slide">
                                                    <img src="/theme_voltro/static/src/images/banner/3.png"
                                                         alt="Thumbnail 3"/>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section data-snippet="product_categories" data-name="Featured Categories" class="featured_categories">
                    <div class="container o_not_editable voltro_dynamic_placeholder">Loading product categories...</div>
                </section>
                <section data-snippet="offer_product" data-name="Offer Banner" class="offer_section">
                    <div class="wrapper">
                        <div class="container">
                            <div class="offer_bg">
                                <img src="/theme_voltro/static/src/images/offer/offer_bg.png"
                                     class="img img-fluid offer_bg_img"
                                     alt="Offer"/>
                                <div class="content">
                                    <p class="p_top">Are you a gamer</p>
                                    <h4>Ultrawide High-Refresh Monitor</h4>
                                    <p class="p_bottom">34" Curved Monitor | 3K 165Hz Display | Stereo SoundBar</p>
                                    <a href="/shop" class="btn btn-primary product_offer_shop_button">SHOP NOW</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section data-snippet="arrival_product" data-name="New Arrivals" class="new_arrivals">
                    <div class="container o_not_editable voltro_dynamic_placeholder">Loading new arrivals...</div>
                </section>
                <section data-snippet="launches_banner" data-name="New Launches" class="launches">
                    <div class="wrapper">
                        <div class="container">
                            <div class="section_left_heading w-100">
                                <div class="ft_wrapp">
                                    <h3 class="pb-2">New Launches</h3>
                                    <p>Be the first to get the latest gadgets, launched this season and ready to ship.</p>
                                </div>
                                <div class="right_btn_wrapp">
                                    <a href="/shop" class="btn btn-secondary">All Products</a>
                                </div>
                            </div>
                            <div class="row grid">
                                <div class="div1 grid-item">
                                    <div class="img_wrapper">
                                        <img src="/theme_voltro/static/src/images/launches/1 (2).png"
                                             alt=""/>
                                        <div class="grid_info">
                                            <h6>Galaxy S24 Ultra</h6>
                                            <p>Titanium build, 200MP camera and a built-in S Pen.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="div2 grid-item">
                                    <div class="img_wrapper">
                                        <img src="/theme_voltro/static/src/images/launches/1 (3).png"
                                             alt=""/>
                                        <div class="grid_info">
                                            <h6>Sky Mini Drone</h6>
                                            <p>Pocket-sized 4K drone with 34 minutes of flight time.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="div3 grid-item">
                                    <div class="img_wrapper">
                                        <img src="/theme_voltro/static/src/images/launches/1 (4).png"
                                             alt=""/>
                                        <div class="grid_info">
                                            <h6>Sky Pro Drone</h6>
                                            <p>Tri-camera system for cinematic aerial shots.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="div4 grid-item">
                                    <div class="img_wrapper">
                                        <img src="/theme_voltro/static/src/images/launches/1 (1).png"
                                             alt=""/>
                                        <div class="grid_info">
                                            <h6>Pro Camera Kit</h6>
                                            <p>Full-frame mirrorless body with a fast prime lens.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section data-snippet="brand_logos" data-name="Brand Logos" class="brands">
                    <div class="wrapper">
                        <div class="container">
                            <div class="splide brands_carousel">
                                <div class="splide__track">
                                    <ul class="splide__list">
                                        <li class="splide__slide">
                                            <div class="fix_height">
                                                <div class="img_wrapper">
                                                    <img src="/theme_voltro/static/src/images/brand/logo-14 1.png"
                                                         alt=""/>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="splide__slide">
                                            <div class="fix_height">
                                                <div class="img_wrapper">
                                                    <img src="/theme_voltro/static/src/images/brand/logo-16 1.png"
                                                         alt=""/>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="splide__slide">
                                            <div class="fix_height">
                                                <div class="img_wrapper">
                                                    <img src="/theme_voltro/static/src/images/brand/logo-25 1.png"
                                                         alt=""/>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="splide__slide">
                                            <div class="fix_height">
                                                <div class="img_wrapper">
                                                    <img src="/theme_voltro/static/src/images/brand/logo-26 1.png"
                                                         alt=""/>
                                                </div>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section data-snippet="contact_us_banner" data-name="Contact Banner" class="subscribe">
                    <div class="container">
                        <div class="wrapper">
                            <div class="sub_text">
                                <span class="sub_eyebrow">Need help choosing?</span>
                                <h3>Essentials, redefined. Discover gadgets that fit your life.</h3>
                            </div>
                            <a href="/contactus" class="btn btn-secondary btn-lg">Contact Us</a>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
