<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Show the product highlights below the eCommerce description -->
    <template id="voltro_product_highlights" name="Voltro Product Highlights"
              inherit_id="website_sale.product_title">
        <xpath expr="//div[@t-field='product.description_ecommerce']" position="after">
            <p t-if="product.product_highlights"
               t-field="product.product_highlights"
               class="voltro_product_highlights text-muted mb-3"/>
        </xpath>
    </template>
</odoo>
