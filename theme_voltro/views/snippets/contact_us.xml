<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="contact_us_banner" name="Contact Banner">
        <section class="subscribe">
            <div class="container">
                <div class="wrapper">
                    <div class="sub_text">
                        "Essentials, Redefined. Discover Gadgets That Fit
                        Your Life."
                    </div>
                    <a href="/contactus" class="btn-primary">
                        Contact Us
                    </a>
                </div>
            </div>
        </section>
    </template>
    <template id="contact_us_snippet_thumbnail"
              inherit_id="website.snippets"
              priority="8">
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
            <t snippet-group="contact_us_banner" t-snippet="theme_voltro.contact_us_banner"
               t-thumbnail="/theme_voltro/static/src/snippets/contact.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_voltro.contact_us_banner" string="Title - Image" group="contact_us_banner"/>
        </xpath>
    </template>
</odoo>