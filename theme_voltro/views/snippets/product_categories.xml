<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Placeholder filled by the product_categories interaction -->
    <template id="product_categories" name="Product Categories">
        <section class="featured_categories">
            <div class="container o_not_editable voltro_dynamic_placeholder">Loading product categories...</div>
        </section>
    </template>

    <!-- Content returned by /theme_voltro/product_categories -->
    <template id="product_categories_show" name="Product Categories Content">
        <div class="wrapper">
            <div class="container">
                <div class="section_left_heading w-100">
                    <div class="ft_wrapp">
                        <h3 class="pb-2">Featured Categories</h3>
                        <p>
                            Experience cutting-edge technology and seamless performance
                            with our latest gadgets, designed to elevate your everyday life.
                        </p>
                    </div>
                    <div class="right_btn_wrapp">
                        <a href="/shop" class="btn btn-secondary">All Products</a>
                    </div>
                </div>
                <div class="featured_content">
                    <div class="splide horizontal featured_product_carousel">
                        <div class="splide__track">
                            <ul class="splide__list">
                                <li t-foreach="categories" t-as="category" class="splide__slide">
                                    <div class="fearured_product_card">
                                        <a t-att-href="category.website_url" class="block">
                                            <div class="img_wrapper product-card">
                                                <img t-att-src="'/web/image/product.public.category/%s/image_512' % category.id"
                                                     t-att-alt="category.name"
                                                     class="product-img w-100 h-100"/>
                                            </div>
                                            <h6 t-out="category.name"/>
                                        </a>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
