<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="product_categories" name="Product Categories">
        <section class="featured_categories" data-snippet="product_categories" data-name="Product Categories">
            <t t-call="theme_voltro.product_categories_show">
                <t t-set="categories" t-value="[{'id': 0, 'name': 'Category Name', 'image_url': '/theme_voltro/static/src/snippets/gallery.jpg'}] * 6"/>
            </t>
        </section>
    </template>
    <template id="product_snippet_carousel_thumbnail"
              inherit_id="website.snippets"
              priority="8">
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
            <t t-snippet="theme_voltro.product_categories"
               t-thumbnail="/theme_voltro/static/src/snippets/gallery.jpg"/>
        </xpath>
    </template>

    <template id="product_categories_show" name="Product Categories Template">
        <div class="wrapper">
            <div class="container">
                <div class="section_left_heading w-100">
                    <div class="ft_wrapp">
                        <h3 class="pb-2">Featured Categories</h3>
                        <p>
                            Experience cutting-edge technology and
                            seamless performance
                            with our latest gadgets, designed to elevate
                            your everyday
                            life.
                        </p>
                    </div>
                    <div class="right_btn_wrapp">
                        <a href="/shop" class="btn btn-secondary">All
                            Product
                        </a>
                    </div>
                </div>
                <div class="featured_content">
                    <div class="owl-carousel horizontal" id="featured_product">
                        <t t-foreach="categories" t-as="category">
                            <div class="item">
                                <div class="fearured_product_card">
                                    <a href="#" class="block ">
                                        <div class="img_wrapper product-card"
                                             t-att-id="'product_%d' % category['id']">
                                            <t t-if="category.get('image_url')">
                                                <img t-att-src="category['image_url']" class="product-img w-100 h-100"/>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="category.get('image_1920')"
                                                      t-options="{'widget': 'image', 'preview_image': 'image_1920', 'class': 'product-img w-100 h-100'}"
                                                      class="h-100"/>
                                            </t>
                                        </div>
                                        <h6>
                                            <t t-esc="category['name']"/>
                                        </h6>
                                    </a>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>