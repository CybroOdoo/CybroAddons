<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="offer_product" name="Product Offer">
                <section class="offer_section">
                    <div class="wrapper">
                    <div class="container oe_structure o_editable">
                        <div class="offer_bg" style="position: relative;">
                            <img src="/theme_voltro/static/src/images/offer/offer_bg.png"
                                 class="img img-fluid o_bg_img_cover"
                                 alt="Offer Image"
                                 style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;"/>
                            <div class="content" style="position: relative; z-index: 1;">
                                <p class="p_top">Are you a gamer</p>
                                <h4>Ultrawide High-Refresh Monitor</h4>
                                <p class="p_bottom">34" Curved Monitor | 3K 165Hz
                                    Display | Stereo SoundBar
                                </p>
                                <a href="/shop" class="btn btn-primary product_offer_shop_button">SHOP NOW</a>
                            </div>
                        </div>
                    </div>
                    </div>
                </section>
    </template>
    <template id="offer_snippet_thumbnail" inherit_id="website.snippets" priority="8">
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
            <t t-snippet="theme_voltro.offer_product"
               t-thumbnail="/theme_voltro/static/src/snippets/offer.jpg"/>
        </xpath>
    </template>

</odoo>