<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Register the Voltro snippets under their own category -->
    <template id="snippets" inherit_id="website.snippets" name="Voltro Snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="voltro" t-snippet="website.s_snippet_group" string="Voltro"
               t-thumbnail="/theme_voltro/static/src/snippets/main_banner.jpg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_voltro.home_banner" string="Home Banner" group="voltro"/>
            <t t-snippet="theme_voltro.product_categories" string="Featured Categories" group="voltro"/>
            <t t-snippet="theme_voltro.offer_product" string="Offer Banner" group="voltro"/>
            <t t-snippet="theme_voltro.arrival_product" string="New Arrivals" group="voltro"/>
            <t t-snippet="theme_voltro.launches_banner" string="New Launches" group="voltro"/>
            <t t-snippet="theme_voltro.brand_logos" string="Brand Logos" group="voltro"/>
            <t t-snippet="theme_voltro.contact_us_banner" string="Contact Banner" group="voltro"/>
            <t t-snippet="theme_voltro.sub_banner" string="Page Banner" group="voltro"/>
            <t t-snippet="theme_voltro.services_banner" string="Services" group="voltro"/>
            <t t-snippet="theme_voltro.about_story" string="Our Story" group="voltro"/>
            <t t-snippet="theme_voltro.about_achievements" string="Achievements" group="voltro"/>
            <t t-snippet="theme_voltro.about_team" string="Team" group="voltro"/>
        </xpath>
    </template>
</odoo>
