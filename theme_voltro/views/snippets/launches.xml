<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="launches_banner" name="Launches Banner">
        <section class="launches">
            <div class="wrapper">
                <div class="container">
                    <div class="section_left_heading w-100">
                        <div class="ft_wrapp">
                            <h3 class="pb-2">New Launches</h3>
                            <p>Be the first to get the latest gadgets, launched this season and ready to ship.</p>
                        </div>
                        <div class="right_btn_wrapp">
                            <a href="/shop" class="btn btn-secondary">All Products</a>
                        </div>
                    </div>
                    <div class="row grid">
                        <div class="div1 grid-item">
                            <div class="img_wrapper">
                                <img src="/theme_voltro/static/src/images/launches/1 (2).png"
                                     alt=""/>
                                <div class="grid_info">
                                    <h6>Galaxy S24 Ultra</h6>
                                    <p>Titanium build, 200MP camera and a built-in S Pen.</p>
                                </div>
                            </div>
                        </div>
                        <div class="div2 grid-item">
                            <div class="img_wrapper">
                                <img src="/theme_voltro/static/src/images/launches/1 (3).png"
                                     alt=""/>
                                <div class="grid_info">
                                    <h6>Sky Mini Drone</h6>
                                    <p>Pocket-sized 4K drone with 34 minutes of flight time.</p>
                                </div>
                            </div>
                        </div>
                        <div class="div3 grid-item">
                            <div class="img_wrapper">
                                <img src="/theme_voltro/static/src/images/launches/1 (4).png"
                                     alt=""/>
                                <div class="grid_info">
                                    <h6>Sky Pro Drone</h6>
                                    <p>Tri-camera system for cinematic aerial shots.</p>
                                </div>
                            </div>
                        </div>
                        <div class="div4 grid-item">
                            <div class="img_wrapper">
                                <img src="/theme_voltro/static/src/images/launches/1 (1).png"
                                     alt=""/>
                                <div class="grid_info">
                                    <h6>Pro Camera Kit</h6>
                                    <p>Full-frame mirrorless body with a fast prime lens.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
