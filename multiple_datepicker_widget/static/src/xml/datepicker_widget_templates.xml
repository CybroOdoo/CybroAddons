<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Define the template for the DatePickerField component. -->
    <t t-name="multiple_datepicker_widget.DatePickerField">
        <t t-if="this.props.readonly">
            <span class="o_field_char" t-out="this.props.record.data[this.props.name] || ''"/>
        </t>
        <t t-else="">
            <input type="text"
                   class="input_datepicker o-autocomplete--input o_input"
                   t-ref="this.input"
                   t-att-placeholder="this.props.placeholder"
                   t-on-click="(ev) => this._onSelectDateField(ev)"/>
        </t>
    </t>
</templates>
