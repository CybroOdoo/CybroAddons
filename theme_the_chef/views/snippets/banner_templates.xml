<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="banner" name="Banner">
        <section class="banner_section_body banner">
            <div class="container">
                <div class="banner_contents">
                    <div class="row">
                        <div class="col-lg-6 col-12">
                            <div class="banner_left">
                                <h1>We Serve
                                    <br/>
                                    Delicious Foods!
                                </h1>
                                <a href="#" class="btn draw-border">Explore Menu</a>
                                <a href="#" class="btn btn-video">
                                    <i class="fa fa-play"/>
                                    Play video
                                </a>
                                <div class="service">
                                    <div class="s_c">
                                        <span class="fa fa-truck"/>
                                        <p>Fast Delivery</p>
                                    </div>
                                    <div class="s_c">
                                        <span class="fa fa-leaf"/>
                                        <p>Fresh Food</p>
                                    </div>
                                    <div class="s_c">
                                        <span class="fa fa-headphones"/>
                                        <p>24/7 Support</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-12">
                            <div class="banner_right">
                                <div id="bannerCarousel" class="s_carousel s_carousel_default carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                                    <div class="carousel-inner">
                                        <div class="carousel-item active" data-name="Slide">
                                            <div class="right_bg">
                                                <img src="/theme_the_chef/static/src/img/banner/hero-1.jpg" class="d-block w-100"/>
                                            </div>
                                        </div>
                                        <div class="carousel-item" data-name="Slide">
                                            <img src="/theme_the_chef/static/src/img/banner/hero-2.jpg" class="d-block w-100"/>
                                        </div>
                                        <div class="carousel-item" data-name="Slide">
                                            <img src="/theme_the_chef/static/src/img/banner/hero-3.jpg" class="d-block w-100"/>
                                        </div>
                                    </div>
                                    <!-- Controls -->
                                    <button class="carousel-control-prev o_not_editable" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Previous</span>
                                    </button>
                                    <button class="carousel-control-next o_not_editable" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Next</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>