<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="inside">
            <div t-if="props.product.is_bundle" style="color: #28a745; font-weight: bold; font-size: 10px; margin-top: 2px;">
                [PRODUCT PACK]
            </div>
        </xpath>
        <xpath expr="//article" position="inside">
            <div t-if="props.product.is_bundle" class="pos-bundle-ribbon">
                <div class="ribbon-text">Pack</div>
            </div>
        </xpath>
    </t>
</templates>
