<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('text-wrap')]" position="inside">
            <t t-if="this.line.product_id?.is_bundle and this.line.bundleDetails?.length">
                <div class="pos-bundle-details">
                    <t t-foreach="this.line.bundleDetails" t-as="item" t-key="item_index">
                        <div class="bundle-item">
                            <span class="item-name"><t t-out="item.name"/></span>
                            <span class="item-values">
                                <t t-out="item.qty"/> x <t t-out="item.uom || 'Units'"/> at <t t-out="item.formattedPrice"/> / <t t-out="item.uom || 'Units'"/>
                            </span>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>
