<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('text-wrap')]" position="inside">
            <t t-if="line.product_id.is_bundle and line.bundleDetails.length">
                <div class="pos-bundle-details">
                    <t t-foreach="line.bundleDetails" t-as="item" t-key="item_index">
                        <div class="bundle-item">
                            <span class="item-name"><t t-esc="item.name"/></span>
                            <span class="item-values">
                                <t t-esc="item.qty"/> x Units at <t t-esc="env.utils.formatCurrency(item.price)"/> / Units
                            </span>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>
