<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Editable component list, referenced by bundle_line_ids through tree_view_ref. -->
    <record id="product_bundle_line_list_view" model="ir.ui.view">
        <field name="name">product.bundle.line.list.advanced.product.pack</field>
        <field name="model">product.bundle.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="image_128" widget="image" options="{'size': [50, 50]}" string="Image"/>
                <field name="product_id" string="Product"/>
                <field name="quantity" string="Qty"/>
                <field name="price_unit" string="Unit Price" readonly="1"/>
                <field name="cost_unit" string="Unit Cost" readonly="1"/>
                <field name="subtotal_price" string="Subtotal Price" readonly="1"/>
                <field name="subtotal_cost" string="Subtotal Cost" readonly="1"/>
            </tree>
        </field>
    </record>
</odoo>
