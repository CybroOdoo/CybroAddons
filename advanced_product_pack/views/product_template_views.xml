<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Product Template Form Inheritance -->
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.advanced.product.pack</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_bundle"/>
                    <label for="is_bundle"/>
                </span>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Bundle Pack" invisible="not is_bundle">
                    <group>
                        <group>
                            <field name="calc_pack_price"/>
                        </group>
                        <group>
                            <field name="calc_pack_cost"/>
                        </group>
                    </group>
                    <field name="bundle_line_ids">
                        <list editable="bottom">
                            <field name="product_id" domain="[('id', '!=', parent.id)]"/>
                            <field name="quantity"/>
                            <field name="image_128" widget="image" options="{'size': [50, 50]}"/>
                            <field name="price_unit" column_invisible="True"/>
                            <field name="cost_unit" column_invisible="True"/>
                            <field name="subtotal_price" column_invisible="True"/>
                            <field name="subtotal_cost" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='variants']" position="replace">
                <page name="variants" string="Attributes &amp; Variants" groups="product.group_product_variant" invisible="type == 'combo'">
                    <field name="attribute_line_ids" widget="one2many" context="{'show_attribute': False}" force_save="1" invisible="is_bundle">
                        <list string="Variants" editable="bottom" decoration-info="value_count &lt;= 1">
                            <field name="value_count" column_invisible="True"/>
                            <field name="sequence" widget="handle"/>
                            <field name="attribute_id" readonly="id"/>
                            <field name="value_ids" widget="many2many_tags" options="{'no_create_edit': True, 'color_field': 'color'}" context="{'default_attribute_id': attribute_id, 'show_attribute': False}"/>
                            <button string="Configure" class="float-end btn-secondary"
                                type="object" name="action_open_attribute_values"
                                groups="product.group_product_variant"/>
                        </list>
                    </field>
                    <p class="opacity-50 oe_edit_only" invisible="is_bundle">
                        <strong>Warning</strong>: adding or deleting attributes
                        will delete and recreate existing variants and lead
                        to the loss of their possible customizations.
                    </p>
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 w-100" invisible="not is_bundle" style="min-height: 400px;">
                        <h1 class="fw-bold text-dark text-center" style="font-size: 3.5rem; opacity: 0.9;">
                            You cannot create variants of the Pack
                        </h1>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product Template Search Inheritance -->
    <record id="product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.view.search.inherit.advanced.product.pack</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <filter string="Product Pack" name="product_pack" domain="[('is_bundle', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Action for Product Pack -->
    <record id="product_template_action" model="ir.actions.act_window">
        <field name="name">Product Pack</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_bundle', '=', True)]</field>
        <field name="context">{'default_is_bundle': True, 'search_default_product_pack': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Product Pack
            </p>
            <p>
                Product packs allow you to group multiple products together and calculate their joint price and cost.
            </p>
        </field>
    </record>

    <!-- Menu for Product Pack -->
    <menuitem id="product_template_menu"
              name="Product Pack"
              action="product_template_action"
              parent="sale.product_menu_catalog"
              sequence="10"/>

</odoo>
