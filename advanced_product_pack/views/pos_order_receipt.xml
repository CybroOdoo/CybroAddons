<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="pos_orderline_receipt_information" inherit_id="point_of_sale.pos_orderline_receipt_information">
            <xpath expr="//div[@name='product-name']" position="after">
                <div t-if="line['bundle_details']" class="pos-bundle-details ms-3 mt-1 mb-1">
                    <t t-foreach="line['bundle_details']" t-as="item">
                        <div class="bundle-item mb-1">
                            <div class="item-name text-normal" t-out="item['name']"/>
                            <div class="item-values text-small ms-2" style="color: #555;">
                                <t t-out="item['qty']"/> x <t t-out="item['uom']"/> at <t t-out="item['formattedPrice']"/> / <t t-out="item['uom']"/>
                            </div>
                        </div>
                    </t>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
