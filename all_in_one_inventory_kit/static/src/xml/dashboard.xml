<?xml version="1.0" encoding="UTF-8"?>
<!--Dashboard template-->
<templates id="template" xml:space="preserve">
     <t t-name="all_in_one_inventory_kit.Dashboard">
         <div class="oh_dashboards"
             style="margin-top: 20px; overflow-y: scroll;vertical-align: middle;overflow-x: clip;max-height: -webkit-fill-available;">
            <div class="container-fluid o_pj_dashboard"
                 style="margin-left:4%;">
                <t t-call="all_in_one_inventory_kit.InventoryTiles"/>
                <t t-call="all_in_one_inventory_kit.ProductSaleBarGraph"/>
            </div>
        </div>
    </t>
    <t t-name="all_in_one_inventory_kit.InventoryTiles">
        <div class="container-fluid py-5" style="display:flex;" t-ref="this.set">
          </div>
        <div class="accounts-dashboard-wrap">
            <div class="row main-section" id="new">
            </div>
        </div>
    </t>
    <t t-name="all_in_one_inventory_kit.ProductSaleBarGraph">
        <div class="row mt-5 px-4" t-ref="this.graphs">
            <div class="year_to_date_graph_div col-sm-12 col-md-6 my-4">
                    <div class="chart-container card-shadow" id="tiles">
                        <div style="height: 20px; max-height: 20px;">
                            <h2>Top Moving Products</h2>
                            <div class="form-group col-2"
                                 id="top_product_button">
                                <select id="top_product_selection" t-on-change="(ev) => this.onclick_top_product_selection(ev.target.value)"
                                        class="btn btn-secondary">
                                    <option id="top_last_10_days"
                                            value="top_last_10_days"
                                            selected="selected">Last 10 Days</option>
                                    <option id="top_last_30_days"
                                            value="top_last_30_days">Last 30 Days</option>
                                    <option id="top_last_3_month"
                                            value="top_last_3_month">Last 3 Months</option>
                                    <option id="top_last_year"
                                            value="top_last_year">Last Year</option>
                                </select>
                            </div>
                            <button class="btn_info" id="top_product_info" t-on-click="this.onclick_top_product_info"
                                    title="Show Details">
                                <i class="oi oi-filled" data-icon="more_vert"/>
                            </button>
                            <table class="graph_details_table" t-ref="this.graph_details_table">
                                <tr>
                                    <th>Products</th>
                                    <th>Quantity Transferred</th>
                                </tr>
                            </table>
                        </div>
                        <hr/>
                        <div class="graph_canvas" style="margin-top: 30px;">
                            <canvas t-ref="this.canvaspie" height="500px"
                                    width="150px"/>
                        </div>
                    </div>
            </div>
            <div class="year_to_date_graph_div col-sm-12 col-md-6 my-4">
                <div class="chart-container card-shadow" id="tiles">
                    <div style="height: 20px; max-height: 20px;">
                        <h2>Product Categories</h2>
                        <button class="btn_info" id="pro_cate_info"  t-on-click="this.onclick_pro_cate_info"
                                title="Show Details">
                            <i class="oi oi-filled" data-icon="more_vert"/>
                        </button>
                        <table class="graph_details_table" t-ref="this.category_table">
                            <tr>
                                <th>Categories</th>
                                <th>Onhand Quantity</th>
                            </tr>
                        </table>
                    </div>
                    <hr/>
                    <div class="graph_canvas" style="margin-top: 30px;">
                        <canvas t-ref="this.product_category" height="500px"
                                width="150px"/>
                    </div>
                </div>
            </div>
            <div class="year_to_date_graph_div col-sm-12 col-md-6 my-4">
                    <div class="chart-container card-shadow" id="tiles">
                        <div style="height: 20px; max-height: 20px;"
                             class="d-flex justify-content-between align-items-center">
                            <h2>Product Moves By Category</h2>
                            <div class="form-group col-2"
                                 id="product_move_select">
                                <select t-ref="this.product_move_selection" t-on-change="(ev) => this.onclick_product_moves_selection(ev)"
                                        class="btn btn-secondary">
                                </select>
                            </div>
                            <button class="btn_info" id="product_move_info" t-on-click="this.onclick_product_move_info"
                                    title="Show Details">
                                <i class="oi oi-filled" data-icon="more_vert"/>
                            </button>
                            <table class="graph_details_table"
                                   t-ref="this.product_move_table">
                                <tr>
                                    <th>Products</th>
                                    <th>Quantity Done</th>
                                </tr>
                            </table>
                        </div>
                        <hr/>
                        <div class="graph_canvas" style="margin-top: 30px;">
                            <canvas t-ref="this.product_move_graph" height="500px"
                                    width="150px"/>
                        </div>
                    </div>
            </div>
            <div class="year_to_date_graph_div col-sm-12 col-md-6 my-4">
                    <div class="chart-container card-shadow" id="tiles">
                         <div style="height: 20px; max-height: 20px;"
                              class="d-flex justify-content-between align-items-center">
                             <h2>Stock Moves By Location</h2>
                             <div class="form-group col-2"
                                  id="stock_move_select">
                                <select id="stock_moves_selection" t-on-change="(ev) => this.onclick_stock_moves_selection(ev.target.value)"
                                        class="btn btn-secondary">
                                    <option id="last_10_days"
                                            value="last_10_days"
                                            selected="selected">Last 10 Days</option>
                                    <option id="this_month" value="this_month">This Month</option>
                                    <option id="last_3_month"
                                            value="last_3_month">Last 3 Months</option>
                                    <option id="last_year" value="last_year">Last Year</option>
                                </select>
                            </div>
                             <button class="btn_info" id="stock_move_info" t-on-click="this.onclick_stock_move_info"
                                     title="Show Details">
                                 <i class="oi oi-filled" data-icon="more_vert"/>
                             </button>
                             <table class="graph_details_table"
                                    t-ref="this.stock_move_table">
                                <tr>
                                    <th>Location</th>
                                    <th>Stock Moves Count</th>
                                </tr>
                            </table>
                         </div>
                        <hr/>
                        <div class="graph_canvas" style="margin-top: 30px;">
                            <canvas t-ref="this.stock_moves" height="500px"
                                    width="150px"/>
                        </div>
                    </div>
            </div>
            <div class="year_to_date_graph_div col-sm-12 col-md-6 my-4">
                <div class="chart-container card-shadow" id="tiles">
                     <div style="height: 20px; max-height: 20px;">
                        <h2>Operation Types</h2>
                         <button class="btn_info" t-on-click="this.onclick_operation_type_info"
                                 title="Show Details">
                             <i class="oi oi-filled" data-icon="more_vert"/>
                         </button>

                         <table class="graph_details_table"
                                t-ref="this.operation_type_table">
                            <tr>
                                <th>Operation Types</th>
                                <th>Transfer Count</th>
                            </tr>
                        </table>
                     </div>
                    <hr/>
                    <div class="graph_canvas" style="margin-top: 30px;">
                        <canvas t-ref="this.operation" height="500" width="150"></canvas>
                    </div>
                </div>
            </div>
            <div class="year_to_date_graph_div col-sm-12 col-md-6 my-4">
                <div class="chart-container card-shadow" id="tiles">
                    <div style="height: 20px; max-height: 20px">
                        <h2>Locations</h2>
                    </div>
                    <hr/>
                    <table style="margin-top: 30px;" class="table table-hover"
                          t-ref="this.location_table">
                         <thead><tr><th>
                             <h2>Location</h2>
                         </th>
                             <th>
                                 <h2 style="text-align: center;">On Hand Quantity</h2>
                             </th></tr></thead>
                        <tbody class="storage" />
                     </table>
                </div>
            </div>
        </div>
    </t>
</templates>
