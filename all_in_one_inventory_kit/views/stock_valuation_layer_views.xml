<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    Stock Valuation Layer  -->
        <record id="stock_valuation_layer_tree" model="ir.ui.view">
            <field name="name">stock.move.view.list.inherit.all.in.one.inventory.kit</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock_account.stock_move_view_list_valuation"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='quantity']" position="after">
                    <field name="cw_hide" column_invisible="True"/>
                    <field name="cw_qty_done" column_invisible="cw_hide == False"/>
                    <field name="cw_uom_id" options="{'no_create': True}" string="CW Uom" column_invisible="cw_hide == False"/>
                </xpath>
            </field>
        </record>
</odoo>
