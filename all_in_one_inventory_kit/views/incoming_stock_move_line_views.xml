<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Stock move line view form  -->
    <record id="incoming_stock_move_line_view_form" model="ir.ui.view">
        <field name="name">stock.move.line.view.form.inherit.all.in.one.inventory.kit</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <form string="Picking Order Lines" edit="0" create="0" duplicate="0" delete="0">
                <sheet>
                    <field name="move_line_image" widget="image"
                           class="oe_avatar" options="{'zoom': true}"/>
                    <group>
                        <group>
                            <h2>
                                <field name="picking_id"/>
                            </h2>
                            <br/>
                            <field name="create_date" string="Create Date"/>
                            <field name="scheduled_date"/>
                            <field name="date_done"
                                   string="Effective Date"/>
                            <field name="origin" string="Source Document"/>
                            <field name="picking_type_id"
                                   string="Operation Type"/>
                            <field name="code" string="Operation"/>
                            <field name="date_deadline"
                                   decoration-danger="has_deadline_issue == True"
                                   string="Deadline"
                                   invisible="has_deadline_issue == False"/>
                        </group>
                        <group class="mt-5">
                            <field name="product_id"/>

                            <field name="quantity" sum="Quantity Done"/>
                            <field name="location_id"
                                   string="Source Location"/>
                            <field name="location_dest_id"
                                   string="Destination Location"/>
                            <field name="state" string="Status"
                                   decoration-success="state == 'assigned' or state == 'done'  or state == 'confirmed'"
                                   decoration-info="state == 'draft'"
                                   decoration-warning="state == 'waiting' or state == 'partially_available'"
                                   widget="badge"/>
                            <field name="has_deadline_issue" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--    Incoming stock move line tree view-->
    <record id="incoming_stock_move_line_view_tree" model="ir.ui.view">
        <field name="name">stock.move.line.view.list.inherit.all.in.one.inventory.kit</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <list string="Picking Order Lines" create="false" edit="true"
                  delete="false">
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="scheduled_date"/>
                <field name="date_done" string="Effective Date"
                       optional="show"/>
                <field name="origin" string="Source Document"
                       optional="hide"/>
                <field name="picking_type_id" string="Operation Type"/>
                <field name="date_deadline"
                       decoration-danger="has_deadline_issue == True"
                       string="Deadline" optional="hide"
                       invisible="has_deadline_issue == False"/>

                <field name="quantity" sum="Quantity Done"
                       widget="monetary"/>
                <field name="location_id"
                       string="Source Location"/>
                <field name="location_dest_id"
                       string="Destination Location" optional="show"/>
                <field name="state" string="Status"
                       widget='badge' optional="show"
                       decoration-danger="state=='cancel'"
                       decoration-info="state== 'assigned'"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-warning="state not in ('draft','cancel','done','assigned')"/>
                <field name="has_deadline_issue" invisible="1"/>
            </list>
        </field>
    </record>
    <!--Incoming stock move line kanban view-->
    <record id="incoming_stock_move_line_view_kanban" model="ir.ui.view">
        <field name="name">stock.move.line.kanban.view.inherit.all.in.one.inventory.kit</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    class="o_kanban_small_column">
                <field name="id"/>
                <field name="picking_type_id"/>
                <field name="move_line_image" class="oe_avatar"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click ">
                            <div class="o_kanban_image me-1">
                                <field name="move_line_image"
                                       widget="image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="picking_id"/>
                                        </strong>
                                    </div>
                                </div>
                                <div name="product_lst_price"
                                     class="mt-1">
                                    Scheduled Date:
                                    <field name="scheduled_date"/>
                                </div>
                                Effective Date:
                                <field name="date_done"/>
                                <div>
                                    Quantity Done
                                    <field name="quantity"/>
                                    <field name="state" widget='badge'
                                           class="float-end"
                                           decoration-danger="state=='cancel'"
                                           decoration-info="state== 'assigned'"
                                           decoration-muted="state == 'draft'"
                                           decoration-success="state == 'done'"
                                           decoration-warning="state not in ('draft','cancel','done','assigned')"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- Incoming stock move line pivot view-->
    <record id="incoming_stock_move_line_view_pivot" model="ir.ui.view">
        <field name="name">stock.move.line.view.pivot.inherit.all.in.one.inventory.kit</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Pivot View Analysis" sample="1">
                <field name="state" type="row"/>
                <field name="picking_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>
    <!--Incoming stock move line graph view-->
    <record id="incoming_stock_move_line_view_graph" model="ir.ui.view">
        <field name="name">stock.move.line.view.graph.inherit.all.in.one.inventory.kit</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <graph string="Picking Orders Graph Analysis" sample="1">
                <field name="product_id"/>
            </graph>
        </field>
    </record>
    <!--Incoming stock move line calendar view-->
    <record id="incoming_stock_move_line_view_calender" model="ir.ui.view">
        <field name="name">stock.move.line.view.calender.inherit.all.in.one.inventory.kit</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <calendar string="Picking Orders" mode="month"
                      date_start="create_date"
                       color="product_id" event_limit="5">
                <field name="product_id"/>
                <field name="picking_id"/>
                <field name="scheduled_date"/>
            </calendar>
        </field>
    </record>
    <!-- Incoming stock move line search view-->
    <record id="incoming_stock_move_line_view_search" model="ir.ui.view">
        <field name="name">stock.move.line.search.incoming.custom</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="attributes">
                <attribute name="string">Search Picking Order Lines</attribute>
            </xpath>
            <xpath expr="//field[@name='picking_id']" position="attributes">
                <attribute name="string">Transfers</attribute>
            </xpath>
            <xpath expr="//filter[@name='todo']" position="attributes">
                <attribute name="domain">[('state', 'not in', ['done', 'draft', 'cancel'])]</attribute>
            </xpath>
        </field>
    </record>
    <!--Incoming stock move line action-->
    <record id="incoming_stock_move_line_action" model="ir.actions.act_window">
        <field name="name">Incoming Operation Lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar</field>
        <field name="domain">[('picking_id.picking_type_id.code', '=','incoming')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
                            (0, 0, {'view_mode': 'list', 'view_id': ref('incoming_stock_move_line_view_tree')}),
                            (0, 0, {'view_mode': 'kanban', 'view_id': ref('incoming_stock_move_line_view_kanban')}),
                            (0, 0, {'view_mode': 'form', 'view_id': ref('incoming_stock_move_line_view_form')}),
                            (0, 0, {'view_mode': 'pivot', 'view_id': ref('incoming_stock_move_line_view_pivot')}),
                            (0, 0, {'view_mode': 'graph', 'view_id': ref('incoming_stock_move_line_view_graph')}),
                                    (0, 0, {'view_mode': 'calendar', 'view_id': ref('incoming_stock_move_line_view_calender')})]"/>
        <field name="search_view_id"
               ref="incoming_stock_move_line_view_search"/>
    </record>
    <!--Incoming stock move line operation menu sub menu-->
    <menuitem id="menu_stock_move_in"
              name="Incoming Operation Lines"
              action="incoming_stock_move_line_action"
              parent="stock.menu_stock_warehouse_mgmt"
              groups="stock.group_stock_user"
              sequence="149"/>
</odoo>
