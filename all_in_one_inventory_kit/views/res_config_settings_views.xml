<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Res config settings view for Account (Invoice From Stock Picking) -->
    <record id="res_config_settings_view_form_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.all.in.one.inventory.kit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Invoice From Stock Picking" id="invoice_from_stock_picking_block">
                    <setting title="Journals" id="stock_picking_journals"
                             help="Journals which should apply for invoice creation from stock picking.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label string="Sales Journal"
                                       for="customer_journal_id"
                                       class="col-lg-3 o_light_label"/>
                                <field name="customer_journal_id"
                                       domain="[('type', '=', 'sale')]"/>
                            </div>
                            <div class="row mt8">
                                <label string="Purchase Journal"
                                       for="vendor_journal_id"
                                       class="col-lg-3 o_light_label"/>
                                <field name="vendor_journal_id"
                                       domain="[('type', '=', 'purchase')]"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Res config settings view for Stock (Inventory Dashboard) -->
    <record id="res_config_settings_view_form_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.all.in.one.inventory.kit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Dashboard" id="inventory_dashboard_settings">
                    <setting id="out_of_stock_setting" string="Out Of Stock"
                             help="Set your out of stock quantity">
                        <field name="out_of_stock"/>
                        <div invisible="not out_of_stock" class="mt8">
                            <label for="out_of_stock_quantity" string="Quantity:"/>
                            <field name="out_of_stock_quantity" class="oe_inline"/>
                        </div>
                    </setting>
                    <setting id="dead_stock_setting" string="Dead Stock"
                             help="Show dead stocks in dashboard">
                        <field name="dead_stock_bol"/>
                        <div invisible="not dead_stock_bol" class="mt8">
                            <field name="dead_stock" class="oe_inline"/>
                            <field name="dead_stock_type" class="oe_inline ms-2"/>
                            <span class="ms-1">Duration</span>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
