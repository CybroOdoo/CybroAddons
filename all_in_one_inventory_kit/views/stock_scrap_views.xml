<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_scrap_move_form_catch_weight" model="ir.ui.view">
        <field name="name">stock.scrap.move.form.catch.weight</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_scrap_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']/ancestor::div[hasclass('o_row')]" position="after">
                <field name="cw_hide" invisible="1"/>
                <label for="cw_qty_done" string="Catch Weight Quantity"
                       invisible="not cw_hide"/>
                <div class="o_row" invisible="not cw_hide">
                    <field name="cw_qty_done" readonly="1"/>
                    <field name="cw_uom_id" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
