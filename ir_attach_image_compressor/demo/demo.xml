<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="demo_compressor_rule_partner_png_jpeg" model="ir.image.compressor.rule">
            <field name="name">Partner Images (PNG - JPEG)</field>
            <field name="af_model_ids" eval="[(6, 0, [ref('base.model_res_partner')])]"/>
            <field name="source_format_ids" eval="[(6, 0, [ref('ir_attach_image_compressor.ir_image_compression_file_format_png')])]"/>
            <field name="quality">80</field>
            <field name="destination_format">JPEG</field>
            <field name="minimum_size">150</field>
            <field name="older_days">0</field>
            <field name="active">True</field>
