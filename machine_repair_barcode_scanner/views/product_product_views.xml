<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit product form view to add button to generate barcode-->
    <record id="product_variant_barcode_button_view" model="ir.ui.view">
        <field name="name">product.view.form.inherited.machine.repair.barcode.scanner
        </field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                            name="action_generate_barcode"
                            type="object"
                            string="Generate Barcode"
                            class="btn-primary"
                            invisible="barcode"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
