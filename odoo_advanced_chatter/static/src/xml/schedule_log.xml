<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Extend the extraActions sub-template to add Schedule Mail button next to Attach Files -->
    <t t-inherit="mail.Composer.extraActions" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Composer-mainActions')]" position="after">
            <button class="position-relative o-mail-ActionList-button btn btn-secondary btn-group-item rounded-circle o-px-1_5 py-1 o-inline border-0"
                    title="Schedule Mail"
                    aria-label="Schedule Mail"
                    type="button"
                    t-on-click="scheduleLogNote">
                <i class="fa fa-clock-o fa-fw"/>
            </button>
        </xpath>
    </t>
</templates>
