<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- added a checkbox in the Followers list -->
    <t t-name="mail.Follower" t-inherit="mail.Follower" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('o-mail-Follower-details')]" position="after">
             <input type="checkbox" 
                    class="form-check-input o-follow-checkbox ms-2" 
                    t-att-checked="state.selected ? 'checked' : undefined"
                    title="Send Notification"
                    t-on-click.stop="(ev) => this.check(ev, props.follower)"/>
        </xpath>
    </t>
</templates>
