<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Apply Page -->
    <record id="university_apply_page" model="theme.ir.ui.view">
        <field name="name">University Apply Page</field>
        <field name="key">theme_university.university_apply_page</field>
        <field name="arch" type="xml">
            <t t-name="theme_university.university_apply_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <!-- HERO -->
                        <section class="inner-hero">
                            <div class="inner-hero-bg"/>
                            <div class="inner-hero-shape inner-hero-shape-1"/>
                            <div class="inner-hero-shape inner-hero-shape-2"/>
                            <div class="container">
                                <div class="inner-hero-content">
                                    <div class="inner-breadcrumb o_editable">
                                        <a href="/">Home</a>
                                        <span class="sep">
                                            <i class="bi bi-chevron-right"/>
                                        </span>
                                        <span class="current">Apply Now</span>
                                    </div>
                                    <div class="row g-4 align-items-center">
                                        <div class="col-lg-7 reveal">
                                            <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                                 style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:#f5c842">
                                                <i class="bi bi-pencil-square"/>
                                                Fall 2026 Admissions
                                            </div>
                                            <h1 class="inner-hero-title o_editable">Begin Your Axion Journey</h1>
                                            <p class="inner-hero-subtitle o_editable">Whether you're an undergraduate
                                                freshman, a graduate student, a transfer, or an international applicant
                                                — your path to Axion starts here. Applications for Fall 2026 are now
                                                open.
                                            </p>
                                            <div class="inner-hero-meta">
                                                <div class="inner-hero-meta-item o_editable">
                                                    <i class="bi bi-calendar-check-fill"/>
                                                    Regular Deadline: Mar 1
                                                </div>
                                                <div class="inner-hero-meta-item o_editable">
                                                    <i class="bi bi-cash-coin"/>
                                                    $650M+ Aid Awarded
                                                </div>
                                                <div class="inner-hero-meta-item o_editable">
                                                    <i class="bi bi-people-fill"/>
                                                    48,000+ Students
                                                </div>
                                                <div class="inner-hero-meta-item o_editable">
                                                    <i class="bi bi-globe2"/>
                                                    130+ Countries
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-5 d-none d-lg-block reveal reveal-delay-2">
                                            <div class="row g-3">
                                                <div class="col-6">
                                                    <div class="highlight-card">
                                                        <div class="highlight-num o_editable">17%</div>
                                                        <div class="highlight-label o_editable">Acceptance Rate</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card">
                                                        <div class="highlight-num o_editable">$28K</div>
                                                        <div class="highlight-label o_editable">Avg. Grant Award</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card">
                                                        <div class="highlight-num o_editable">38%</div>
                                                        <div class="highlight-label o_editable">Need-Based Aid</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card">
                                                        <div class="highlight-num o_editable">98%</div>
                                                        <div class="highlight-label o_editable">Graduate Employment
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- MAIN CONTENT -->
                        <section class="section-pad" id="application-type">
                            <div class="container">
                                <div class="row g-5">
                                    <!-- Sidebar -->
                                    <div class="col-lg-3">
                                        <div class="side-nav">
                                            <div class="side-nav-title o_editable">Apply</div>
                                            <a href="#application-type" class="side-nav-link active">Application Types
                                            </a>
                                            <a href="#deadlines" class="side-nav-link">Key Deadlines</a>
                                            <a href="#requirements" class="side-nav-link">Requirements</a>
                                            <a href="#how-to-apply" class="side-nav-link">How to Apply</a>
                                            <a href="#financial-aid" class="side-nav-link">Financial Aid</a>
                                            <a href="#faq" class="side-nav-link">FAQs</a>
                                        </div>
                                        <!-- Deadline widget -->
                                        <div class="info-box accent mt-3">
                                            <div style="font-weight:700;color:var(--primary-dark);margin-bottom:.6rem"
                                                 class="o_editable">Fall 2026 Deadlines
                                            </div>
                                            <t t-set="admission_rounds"
                                               t-value="request.env['university.admission.round'].search([])"/>
                                            <t t-foreach="admission_rounds" t-as="adm_round">
                                                <div class="key-date-row" style="padding:.4rem 0">
                                                    <div class="key-date-pill"
                                                         t-attf-style="background:#{adm_round.is_binding and '#e8f0fe' or '#fce8e8'};color:#{adm_round.is_binding and '#1a3a6b' or '#c0392b'};font-size:.65rem">
                                                        <span t-field="adm_round.deadline_date_str"/>
                                                    </div>
                                                    <div>
                                                        <div class="key-date-title" style="font-size:.8rem">
                                                            <span t-field="adm_round.name"/>
                                                        </div>
                                                        <div class="key-date-sub">
                                                            <span t-field="adm_round.notes"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                            <a href="#how-to-apply" class="btn w-100 mt-3 rounded-pill fw-semibold"
                                               style="background:var(--primary);color:white;font-size:.82rem">
                                                <i class="bi bi-pencil-square me-1"/>
                                                Start Application
                                            </a>
                                        </div>
                                        <!-- Contact admissions -->
                                        <div class="info-box mt-3">
                                            <div style="font-weight:700;color:var(--primary-dark);margin-bottom:.5rem"
                                                 class="o_editable">Admissions Office
                                            </div>
                                            <div style="font-size:.82rem;line-height:1.9">
                                                <div class="o_editable">
                                                    <i class="bi bi-telephone-fill me-1" style="color:var(--primary)"/>
                                                    +1 (800) 123-4567
                                                </div>
                                                <div class="o_editable">
                                                    <i class="bi bi-envelope-fill me-1" style="color:var(--primary)"/>
                                                    admissions@axion.edu
                                                </div>
                                                <div class="o_editable">
                                                    <i class="bi bi-clock-fill me-1" style="color:var(--primary)"/>
                                                    Mon–Fri, 9 AM–5 PM
                                                </div>
                                            </div>
                                            <a href="#"
                                               class="btn btn-outline-primary w-100 mt-3 rounded-pill fw-semibold"
                                               style="font-size:.8rem">Schedule a Call
                                            </a>
                                        </div>
                                    </div>
                                    <!-- Content -->
                                    <div class="col-lg-9">
                                        <!-- Application Type Cards -->
                                        <div class="section-eyebrow mb-1 o_editable">Choose Your Path</div>
                                        <h3 class="section-title mb-4 o_editable">Which Application Is Right for You?
                                        </h3>
                                        <div class="row g-4 mb-5">
                                            <t t-set="app_types"
                                               t-value="request.env['university.application.type'].search([])"/>
                                            <t t-foreach="app_types" t-as="app_type">
                                                <div class="col-md-6 reveal">
                                                    <div class="side-nav h-100 overflow-hidden"
                                                         style="border-radius:var(--radius)">
                                                        <div class="card-body p-4">
                                                            <div class="d-flex align-items-center gap-3 mb-3">
                                                                <div t-attf-style="width:52px;height:52px;border-radius:14px;background:#{app_type.color_bg};display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#{app_type.color_text};flex-shrink:0">
                                                                    <i t-attf-class="bi #{app_type.icon_class}"/>
                                                                </div>
                                                                <div>
                                                                    <h5 class="fw-bold mb-0" style="font-size:1rem">
                                                                        <span t-field="app_type.name"/>
                                                                    </h5>
                                                                    <div style="font-size:.78rem;color:var(--text-muted)">
                                                                        <span t-field="app_type.target_audience"/>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <p class="text-muted mb-3" style="line-height:1.7">
                                                                <span t-field="app_type.description"/>
                                                            </p>
                                                            <ul class="list-unstyled mb-4"
                                                                style="font-size:.95rem;line-height:2">
                                                                <t t-foreach="app_type.requirement_ids" t-as="req">
                                                                    <li>
                                                                        <i class="bi bi-check-circle-fill me-2"
                                                                           style="color:#1a7a4a"/>
                                                                        <span t-field="req.name"/>
                                                                    </li>
                                                                </t>
                                                            </ul>
                                                            <a t-att-href="app_type.cta_url"
                                                               class="btn w-100 rounded-pill fw-semibold"
                                                               t-attf-style="background:#{app_type.color_text.startswith('var') and 'var(--accent)' or (app_type.color_text.startswith('#1a3a6b') and 'var(--primary)' or app_type.color_text)};color:#{app_type.color_text.startswith('var') and 'var(--primary-dark)' or 'white'};font-size:.85rem">
                                                                <span t-field="app_type.cta_text"/>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                        <!-- Key Deadlines -->
                                        <div id="deadlines" class="mb-5">
                                            <div class="section-eyebrow mb-1 o_editable">Important Dates</div>
                                            <h3 class="section-title mb-4 o_editable">Fall 2026 Application Deadlines
                                            </h3>
                                            <div class="degree-table reveal">
                                                <div class="degree-row-header">
                                                    <span>Round</span>
                                                    <span>Deadline</span>
                                                    <span>Decision By</span>
                                                    <span>Notes</span>
                                                </div>
                                                <t t-set="rounds"
                                                   t-value="request.env['university.admission.round'].search([])"/>
                                                <t t-foreach="rounds" t-as="adm_round">
                                                    <div class="degree-row">
                                                        <span class="fw-semibold">
                                                            <span t-field="adm_round.name"/>
                                                        </span>
                                                        <span>
                                                            <span class="key-date-pill d-inline"
                                                                  t-attf-style="background:#{adm_round.is_binding and '#e8f0fe' or '#fce8e8'};color:#{adm_round.is_binding and '#1a3a6b' or '#c0392b'};font-size:.72rem">
                                                                <span t-field="adm_round.deadline_date_str"/>
                                                            </span>
                                                        </span>
                                                        <span class="text-muted">
                                                            <span t-field="adm_round.decision_date_str"/>
                                                        </span>
                                                        <span class="text-muted">
                                                            <span t-field="adm_round.notes"/>
                                                        </span>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="info-box mt-3 reveal o_editable">
                                                <i class="bi bi-info-circle-fill me-2"/>
                                                <strong>Enrollment Deposit Deadline:</strong>
                                                May 1, 2026. A $500 non-refundable deposit confirms your place in the
                                                Class of 2030. Financial aid packages will be available in your
                                                applicant portal by April 1.
                                            </div>
                                        </div>
                                        <!-- Requirements -->
                                        <div id="requirements" class="mb-5">
                                            <div class="section-eyebrow mb-1 o_editable">What You'll Need</div>
                                            <h3 class="section-title mb-4 o_editable">Application Requirements</h3>
                                            <div class="row g-4">
                                                <t t-foreach="app_types" t-as="app_type">
                                                    <div class="col-md-6">
                                                        <div class="info-box h-100 reveal">
                                                            <h6 style="font-weight:700;margin-bottom:.75rem">
                                                                <i t-attf-class="bi #{app_type.icon_class} me-1"
                                                                   t-attf-style="color:#{app_type.color_text.startswith('var') and 'var(--accent)' or (app_type.color_text.startswith('#1a3a6b') and 'var(--primary)' or app_type.color_text)}"/>
                                                                <span t-field="app_type.name"/>
                                                                Requirements
                                                            </h6>
                                                            <ul class="list-unstyled mb-0"
                                                                style="font-size:.95rem;line-height:2.2">
                                                                <t t-foreach="app_type.requirement_ids" t-as="req">
                                                                    <li>
                                                                        <i class="bi bi-check-circle-fill me-2"
                                                                           style="color:#1a7a4a"/>
                                                                        <span t-field="req.name"/>
                                                                    </li>
                                                                </t>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                        <!-- How to Apply -->
                                        <div id="how-to-apply" class="mb-5">
                                            <div class="section-eyebrow mb-1 o_editable">Step-by-Step</div>
                                            <h3 class="section-title mb-4 o_editable">How to Apply</h3>
                                            <div class="d-flex flex-column gap-1 reveal">
                                                <div class="app-step">
                                                    <div class="app-step-num">1</div>
                                                    <div class="app-step-body">
                                                        <h6 class="o_editable">Create Your Applicant Account</h6>
                                                        <p class="o_editable">Visit the Axion Applicant Portal at <strong>
                                                            apply.axion.edu
                                                        </strong> and create a free account using your email address.
                                                            You can also begin via the Common Application at
                                                            commonapp.org.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="app-step-connector"/>
                                                <div class="app-step">
                                                    <div class="app-step-num">2</div>
                                                    <div class="app-step-body">
                                                        <h6 class="o_editable">Complete the Application Form</h6>
                                                        <p class="o_editable">Fill out personal information, academic
                                                            history, activities, and program choices. Save your progress
                                                            at any time — your application auto-saves every 2 minutes.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="app-step-connector"/>
                                                <div class="app-step">
                                                    <div class="app-step-num">3</div>
                                                    <div class="app-step-body">
                                                        <h6 class="o_editable">Write Your Personal Essay</h6>
                                                        <p class="o_editable">Respond to one of the Common App prompts
                                                            or Axion's supplemental essay question: <em>"Describe a
                                                                challenge that changed how you think. What did it teach
                                                                you?"
                                                            </em> (max 650 words).
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="app-step-connector"/>
                                                <div class="app-step">
                                                    <div class="app-step-num">4</div>
                                                    <div class="app-step-body">
                                                        <h6 class="o_editable">Request Recommendations &amp;amp;
                                                            Transcripts
                                                        </h6>
                                                        <p class="o_editable">Invite recommenders directly from your
                                                            portal — they'll receive a secure link. Request official
                                                            transcripts from your school's registrar or guidance office.
                                                            Allow 2–3 weeks for processing.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="app-step-connector"/>
                                                <div class="app-step">
                                                    <div class="app-step-num">5</div>
                                                    <div class="app-step-body">
                                                        <h6 class="o_editable">Submit &amp;amp; Pay the Application
                                                            Fee
                                                        </h6>
                                                        <p class="o_editable">Review your application carefully before
                                                            submitting. Pay the $75 fee by credit/debit card or request
                                                            a fee waiver if you qualify (Common App Waiver, NACAC
                                                            Waiver, or financial hardship).
                                                            <strong>Submissions cannot be edited after this point.
                                                            </strong>
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="app-step-connector"/>
                                                <div class="app-step">
                                                    <div class="app-step-num">6</div>
                                                    <div class="app-step-body">
                                                        <h6 class="o_editable">Track Your Application Status</h6>
                                                        <p class="o_editable">Log in to your portal at any time to see
                                                            which materials have been received, check for missing items,
                                                            and view interview invitations. Decisions are released on
                                                            the dates shown in the Deadlines section above.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="app-step-connector"/>
                                                <div class="app-step">
                                                    <div class="app-step-num"
                                                         style="background:var(--accent);color:var(--primary-dark)">7
                                                    </div>
                                                    <div class="app-step-body">
                                                        <h6 class="o_editable">Accept Your Offer &amp;amp; Pay Your
                                                            Deposit
                                                        </h6>
                                                        <p class="o_editable">If admitted, confirm your enrollment by
                                                            May 1 and pay the $500 enrollment deposit. You'll then gain
                                                            access to housing, orientation, and course registration
                                                            portals — your Axion journey officially begins!
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mt-4 reveal">
                                                <a href="/apply/form" class="btn rounded-pill px-5 fw-semibold"
                                                   style="background:var(--primary);color:white;font-size:.95rem;padding:.75rem 2rem">
                                                    <i class="bi bi-pencil-square me-2"/>Start Your Application Now
                                                </a>
                                            </div>
                                        </div>
                                        <!-- Financial Aid -->
                                        <div id="financial-aid" class="mb-5">
                                            <div class="section-eyebrow mb-1 o_editable">Funding Your Education</div>
                                            <h3 class="section-title mb-4 o_editable">Financial Aid &amp;amp;
                                                Scholarships
                                            </h3>
                                            <div class="row g-4">
                                                <div class="col-md-6 reveal">
                                                    <div class="wellness-card" style="border-top-color:var(--primary)">
                                                        <div class="wellness-card-icon">
                                                            <i class="bi bi-shield-fill-check"/>
                                                        </div>
                                                        <h5 class="wellness-card-title o_editable">Need-Based Aid</h5>
                                                        <p class="wellness-card-desc o_editable">Axion's Need-Blind
                                                            Admissions policy means your ability to pay is never a
                                                            factor in the admission decision. 38% of students receive
                                                            need-based grants averaging $28,000 per year. Submit the
                                                            FAFSA and CSS Profile to be considered.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 reveal reveal-delay-1">
                                                    <div class="wellness-card" style="border-top-color:var(--accent)">
                                                        <div class="wellness-card-icon"
                                                             style="background:rgba(232,160,32,.1);color:var(--accent)">
                                                            <i class="bi bi-trophy-fill"/>
                                                        </div>
                                                        <h5 class="wellness-card-title o_editable">Merit Scholarships
                                                        </h5>
                                                        <p class="wellness-card-desc o_editable">Axion awards over 500
                                                            merit-based scholarships annually ranging from $5,000 to
                                                            full tuition. No separate application required — all
                                                            admitted students are automatically considered based on
                                                            their academic profile.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 reveal">
                                                    <div class="wellness-card" style="border-top-color:#1a7a4a">
                                                        <div class="wellness-card-icon"
                                                             style="background:rgba(26,122,74,.1);color:#1a7a4a">
                                                            <i class="bi bi-briefcase-fill"/>
                                                        </div>
                                                        <h5 class="wellness-card-title o_editable">Work-Study &amp;amp;
                                                            Loans
                                                        </h5>
                                                        <p class="wellness-card-desc o_editable">Federal Work-Study
                                                            positions allow students to earn up to $3,500 per year on
                                                            campus. Federal Direct Loans are available at low fixed
                                                            rates for students who need additional funding beyond
                                                            grants.
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 reveal reveal-delay-1">
                                                    <div class="wellness-card" style="border-top-color:#6f42c1">
                                                        <div class="wellness-card-icon"
                                                             style="background:rgba(111,66,193,.08);color:#6f42c1">
                                                            <i class="bi bi-globe2"/>
                                                        </div>
                                                        <h5 class="wellness-card-title o_editable">International Aid
                                                        </h5>
                                                        <p class="wellness-card-desc o_editable">International students
                                                            are eligible for need-based grants on the same basis as
                                                            domestic students. Submit the CSS Profile and ISFAA
                                                            (International Student Financial Aid Application) with your
                                                            admissions application.
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="info-box success mt-4 reveal o_editable">
                                                <i class="bi bi-info-circle-fill me-2"/>
                                                <strong>Average net price for families earning under $75K:</strong>
                                                $0 — Axion covers 100% of demonstrated financial need for families with
                                                household incomes below $75,000 through grants, not loans.
                                            </div>
                                            <div class="mt-3 reveal">
                                                <a href="#"
                                                   class="btn btn-outline-primary rounded-pill px-4 fw-semibold"
                                                   style="font-size:.88rem"><i class="bi bi-calculator me-1"/>Estimate
                                                    Your Aid with Net Price Calculator
                                                </a>
                                            </div>
                                        </div>
                                        <!-- FAQs Section -->
                                        <div id="faq" class="mb-5">
                                            <div class="section-eyebrow mb-1 o_editable">Got Questions?</div>
                                            <h3 class="section-title mb-4 o_editable">Frequently Asked Questions</h3>
                                            <div class="accordion" id="accordionFaq">
                                                <t t-set="faqs" t-value="request.env['university.faq'].search([])"/>
                                                <t t-foreach="faqs" t-as="faq">
                                                    <div class="accordion-item mb-3"
                                                         style="border:1px solid rgba(var(--primary-rgb),.1);border-radius:var(--radius);overflow:hidden">
                                                        <h2 class="accordion-header" t-attf-id="heading-#{faq.id}">
                                                            <button class="accordion-button collapsed fw-semibold"
                                                                    type="button" data-bs-toggle="collapse"
                                                                    t-attf-data-bs-target="#collapse-#{faq.id}"
                                                                    aria-expanded="false"
                                                                    t-attf-aria-controls="collapse-#{faq.id}"
                                                                    style="font-family:'Inter',sans-serif;color:var(--primary-dark);background:transparent;box-shadow:none">
                                                                <span t-field="faq.question"/>
                                                            </button>
                                                        </h2>
                                                        <div t-attf-id="collapse-#{faq.id}"
                                                             class="accordion-collapse collapse"
                                                             t-attf-aria-labelledby="heading-#{faq.id}"
                                                             data-bs-parent="#accordionFaq">
                                                            <div class="accordion-body text-muted"
                                                                 style="font-family:'Inter',sans-serif;font-size:.95rem;line-height:1.7;background:rgba(var(--primary-rgb),.02)">
                                                                <span t-field="faq.answer"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- STATS BAND -->
                        <section style="background:var(--primary-dark);padding:3rem 0">
                            <div class="container">
                                <div class="row g-4 text-center">
                                    <div class="col-6 col-md-3 reveal">
                                        <div style="font-size:2.2rem;font-weight:800;color:var(--accent-light)"
                                             class="stat-num o_editable">17%
                                        </div>
                                        <div style="font-size:1rem;color:rgba(255,255,255,.55);margin-top:.25rem"
                                             class="o_editable">Acceptance Rate
                                        </div>
                                    </div>
