<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clubs &amp; Organizations -->
    <record id="university_clubs_orgs_page" model="theme.ir.ui.view">
        <field name="name">University Clubs &amp; Organizations Page</field>
        <field name="key">theme_university.university_clubs_orgs_page</field>
        <field name="arch" type="xml">
            <t t-name="theme_university.university_clubs_orgs_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <!-- HERO -->
                        <section class="inner-hero">
                            <div class="inner-hero-bg"/>
                            <div class="inner-hero-shape inner-hero-shape-1"/>
                            <div class="inner-hero-shape inner-hero-shape-2"/>
                            <div class="container">
                                <div class="inner-hero-content">
                                    <div class="inner-breadcrumb o_editable">
                                        <a href="/">Home</a>
                                        <span class="sep">
                                            <i class="bi bi-chevron-right"/>
                                        </span>
                                        <a href="/campus-life">Campus Life</a>
                                        <span class="sep">
                                            <i class="bi bi-chevron-right"/>
                                        </span>
                                        <span class="current">Clubs &amp; Organizations</span>
                                    </div>
                                    <div class="row g-4 align-items-center">
                                        <div class="col-lg-7 reveal">
                                            <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                                 style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:#f5c842">
                                                <i class="bi bi-people-fill"/>
                                                Community &amp; Connection
                                            </div>
                                            <h1 class="inner-hero-title o_editable">200+ Ways to Get Involved</h1>
                                            <p class="inner-hero-subtitle o_editable">From Model UN and robotics teams
                                                to salsa dancing and film-making guilds — there's a community at Axion
                                                for every passion, background, and ambition. Can't find what you're
                                                looking for? Start your own club.
                                            </p>
                                            <div class="inner-hero-meta o_editable">
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-collection-fill"/>
                                                    200+ Clubs
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-people-fill"/>
                                                    35,000 Members
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-globe2"/>
                                                    80 Cultural Orgs
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-plus-circle-fill"/>
                                                    Start Your Own
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-5 d-none d-lg-block reveal reveal-delay-2">
                                            <div class="row g-3">
                                                <div class="col-6">
                                                    <div class="highlight-card">
                                                        <div class="highlight-num o_editable">200+</div>
                                                        <div class="highlight-label o_editable">Registered
                                                            Organizations
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card">
                                                        <div class="highlight-num o_editable">80</div>
                                                        <div class="highlight-label o_editable">Cultural &amp;
                                                            International
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card">
                                                        <div class="highlight-num o_editable">45</div>
                                                        <div class="highlight-label o_editable">Academic &amp;
                                                            Professional
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card">
                                                        <div class="highlight-num o_editable">$2M+</div>
                                                        <div class="highlight-label o_editable">Annual Student Activity
                                                            Fund
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- CLUB CATEGORIES -->
                        <section class="section-pad">
                            <div class="container">
                                <div class="text-center mb-5 reveal">
                                    <div class="section-eyebrow o_editable">Explore by Type</div>
                                    <h2 class="section-title o_editable">Club Categories</h2>
                                    <p class="section-subtitle o_editable">Browse over 200 organizations grouped across
                                        6 categories — from STEM and arts to cultural identity and community service.
                                    </p>
                                </div>
                                <div class="row g-4">
                                    <div class="col-sm-6 col-lg-4 reveal reveal-delay-1">
                                        <div class="club-cat-card o_editable" style="border-bottom-color:#1a3a6b">
                                            <div class="club-cat-icon" style="background:#e8f0fe">
                                                <i class="bi bi-cpu-fill" style="color:#1a3a6b;font-size:1.3rem"/>
                                            </div>
                                            <h6>Academic &amp; Professional</h6>
                                            <p>Discipline-specific societies, honor societies, industry networks, and
                                                career development clubs for every major.
                                            </p>
                                            <span class="club-count-badge" style="background:#e8f0fe;color:#1a3a6b">45
                                                Organizations
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-lg-4 reveal reveal-delay-2">
                                        <div class="club-cat-card o_editable" style="border-bottom-color:#1a7a4a">
                                            <div class="club-cat-icon" style="background:#e6f4ea">
                                                <i class="bi bi-globe2" style="color:#1a7a4a;font-size:1.3rem"/>
                                            </div>
                                            <h6>Cultural &amp; International</h6>
                                            <p>80+ organizations celebrating the diversity of Axion's student body —
                                                from national cultural societies to language exchange clubs.
                                            </p>
                                            <span class="club-count-badge" style="background:#e6f4ea;color:#1a7a4a">80
                                                Organizations
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-lg-4 reveal reveal-delay-3">
                                        <div class="club-cat-card o_editable" style="border-bottom-color:#b45309">
                                            <div class="club-cat-icon" style="background:#fff8e1">
                                                <i class="bi bi-palette-fill" style="color:#b45309;font-size:1.3rem"/>
                                            </div>
                                            <h6>Arts, Media &amp; Performance</h6>
                                            <p>Orchestra, jazz band, theater company, photography guild, student
                                                newspaper, podcast collective, and film society.
                                            </p>
                                            <span class="club-count-badge" style="background:#fff8e1;color:#b45309">32
                                                Organizations
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-lg-4 reveal reveal-delay-1">
                                        <div class="club-cat-card o_editable" style="border-bottom-color:#c0392b">
                                            <div class="club-cat-icon" style="background:#fce8e8">
                                                <i class="bi bi-heart-fill" style="color:#c0392b;font-size:1.3rem"/>
                                            </div>
                                            <h6>Community Service &amp; Advocacy</h6>
                                            <p>Volunteer networks, environmental action groups, political organizations,
                                                and social justice advocacy clubs.
                                            </p>
                                            <span class="club-count-badge" style="background:#fce8e8;color:#c0392b">28
                                                Organizations
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-lg-4 reveal reveal-delay-2">
                                        <div class="club-cat-card o_editable" style="border-bottom-color:#6f42c1">
                                            <div class="club-cat-icon" style="background:#f3e8ff">
                                                <i class="bi bi-controller" style="color:#6f42c1;font-size:1.3rem"/>
                                            </div>
                                            <h6>Recreation &amp; Lifestyle</h6>
                                            <p>Hiking club, esports team, chess league, cooking society, yoga
                                                collective, board games society, and more.
                                            </p>
                                            <span class="club-count-badge" style="background:#f3e8ff;color:#6f42c1">22
                                                Organizations
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-lg-4 reveal reveal-delay-3">
                                        <div class="club-cat-card o_editable" style="border-bottom-color:#0277bd">
                                            <div class="club-cat-icon" style="background:#e0f7fa">
                                                <i class="bi bi-lightbulb-fill" style="color:#0277bd;font-size:1.3rem"/>
                                            </div>
                                            <h6>Entrepreneurship &amp; Innovation</h6>
                                            <p>Startup incubator teams, hackathon clubs, innovation challenge squads,
                                                and the Axion Ventures student fund.
                                            </p>
                                            <span class="club-count-badge" style="background:#e0f7fa;color:#0277bd">18
                                                Organizations
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- FEATURED CLUBS -->
                        <section class="section-pad">
                            <div class="container">
                                <div class="d-flex align-items-end justify-content-between mb-5 flex-wrap gap-3 reveal">
                                    <div>
                                        <div class="section-eyebrow o_editable">Spotlight</div>
                                        <h2 class="section-title mb-0 o_editable">Featured Student Organizations</h2>
                                    </div>
                                    <a href="#" class="btn btn-outline-primary rounded-pill px-4 fw-semibold"
                                       style="font-family:'Inter',sans-serif;font-size:.88rem">Browse All Clubs
                                    </a>
                                </div>
                                <div class="row g-4">
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-1">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#e8f0fe">
                                                <i class="bi bi-globe-americas" style="color:#1a3a6b"/>
                                            </div>
                                            <div class="program-category-pill pill-stem o_editable">Academic</div>
                                            <h5 class="fw-bold mb-2 o_editable">Axion Model United Nations</h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">One of the
                                                largest MUN clubs in the US. Competes at Harvard MUN, NYUMUN, and hosts
                                                the annual AxionMUN conference attended by 1,200+ delegates.
                                            </p>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">450
                                                    Members
                                                </span>
                                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">
                                                    National Awards
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-2">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#f3e8ff">
                                                <i class="bi bi-robot" style="color:#6f42c1"/>
                                            </div>
                                            <div class="program-category-pill pill-stem o_editable">Academic</div>
                                            <h5 class="fw-bold mb-2 o_editable">Axion Robotics Team</h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">Three-time
                                                national champions in collegiate robotics. Open to all students
                                                regardless of major. Runs weekly workshops on hardware and software
                                                engineering.
                                            </p>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <span class="program-tag" style="background:#f3e8ff;color:#6f42c1">200
                                                    Members
                                                </span>
                                                <span class="program-tag" style="background:#fce8e8;color:#c0392b">3×
                                                    National Champs
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-3">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#fff8e1">
                                                <i class="bi bi-briefcase-fill" style="color:#b45309"/>
                                            </div>
                                            <div class="program-category-pill pill-business o_editable">Business</div>
                                            <h5 class="fw-bold mb-2 o_editable">Axion Ventures Fund</h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">Student-run
                                                venture fund managing $500K in seed capital. Has invested in 18 student
                                                startups, 4 of which have raised follow-on funding from external VCs.
                                            </p>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <span class="program-tag" style="background:#fff8e1;color:#b45309">$500K
                                                    Fund
                                                </span>
                                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">18
                                                    Investments
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-1">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#e0f7fa">
                                                <i class="bi bi-music-note-beamed" style="color:#0277bd"/>
                                            </div>
                                            <div class="program-category-pill pill-arts o_editable">Arts &amp; Culture
                                            </div>
                                            <h5 class="fw-bold mb-2 o_editable">Axion Philharmonic Orchestra</h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">120-piece student
                                                orchestra. Performs four concerts per semester at the Axion Performing
                                                Arts Center. Auditions open at the start of each semester.
                                            </p>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <span class="program-tag" style="background:#e0f7fa;color:#0277bd">120
                                                    Members
                                                </span>
                                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4
                                                    Concerts/Sem
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-2">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#e6f4ea">
                                                <i class="bi bi-tree-fill" style="color:#1a7a4a"/>
                                            </div>
                                            <div class="program-category-pill pill-health o_editable">Service</div>
                                            <h5 class="fw-bold mb-2 o_editable">Axion Climate Action Network</h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">Student-led
                                                environmental advocacy group. Runs campus sustainability campaigns and
                                                partners with the CCSS research center on climate awareness events.
                                            </p>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">600
                                                    Members
                                                </span>
                                                <span class="program-tag" style="background:#e0f7fa;color:#0277bd">
                                                    Active Campaigns
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-3">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#fce8e8">
                                                <i class="bi bi-camera-fill" style="color:#c0392b"/>
                                            </div>
                                            <div class="program-category-pill pill-arts o_editable">Media</div>
                                            <h5 class="fw-bold mb-2 o_editable">The Axion Review (Student Paper)</h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">Award-winning
                                                student newspaper published weekly in print and daily online. Covers
                                                campus news, investigative journalism, opinion, arts, and sports.
                                            </p>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <span class="program-tag" style="background:#fce8e8;color:#c0392b">85
                                                    Staff
                                                </span>
                                                <span class="program-tag" style="background:#fff8e1;color:#b45309">SPJ
                                                    Award 2024
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- STUDENT GOVERNMENT + START A CLUB -->
                        <section class="section-pad" style="background:var(--bg-light)">
                            <div class="container">
                                <div class="row g-5">
                                    <div class="col-lg-6 reveal">
                                        <div class="section-eyebrow mb-2 o_editable">Your Voice</div>
                                        <h3 class="section-title o_editable">Student Government Association</h3>
                                        <p class="text-muted mb-3 o_editable"
                                           style="font-family:'Inter',sans-serif;line-height:1.8">The SGA is the
                                            official representative body of the student population, liaising between
                                            students and university administration. It allocates the $2M+ student
                                            activity budget, organizes campus-wide events, and advocates for student
                                            welfare.
                                        </p>
                                        <div class="d-flex flex-column gap-3">
                                            <div class="d-flex gap-3 align-items-start">
                                                <div style="width:36px;height:36px;border-radius:10px;background:#e8f0fe;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                    <i class="bi bi-people-fill" style="color:#1a3a6b"/>
                                                </div>
                                                <div class="o_editable"
                                                     style="font-family:'Inter',sans-serif;font-size:.85rem">
                                                    <strong>60 elected representatives</strong>
                                                    across all schools and class years, plus a 5-member executive
                                                    cabinet.
                                                </div>
                                            </div>
                                            <div class="d-flex gap-3 align-items-start">
                                                <div style="width:36px;height:36px;border-radius:10px;background:#e6f4ea;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                    <i class="bi bi-currency-dollar" style="color:#1a7a4a"/>
                                                </div>
                                                <div class="o_editable"
                                                     style="font-family:'Inter',sans-serif;font-size:.85rem">
                                                    <strong>$2M+ annual budget</strong>
                                                    allocated to clubs, campus events, services, and student welfare
                                                    initiatives each year.
                                                </div>
                                            </div>
                                            <div class="d-flex gap-3 align-items-start">
                                                <div style="width:36px;height:36px;border-radius:10px;background:#fff8e1;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                    <i class="bi bi-calendar-event" style="color:#b45309"/>
                                                </div>
                                                <div class="o_editable"
                                                     style="font-family:'Inter',sans-serif;font-size:.85rem">
                                                    <strong>Elections held each April</strong>
                                                    for the following academic year. Any registered student may run for
                                                    office.
                                                </div>
                                            </div>
                                        </div>
                                        <a href="#" class="btn rounded-pill px-4 mt-4 fw-semibold"
                                           style="background:var(--primary);color:white;font-family:'Inter',sans-serif;font-size:.88rem">
                                            Visit SGA Website
                                        </a>
                                    </div>
                                    <div class="col-lg-6 reveal reveal-delay-2">
                                        <div class="section-eyebrow mb-2 o_editable">New Idea?</div>
                                        <h3 class="section-title o_editable">Start Your Own Club</h3>
                                        <p class="text-muted mb-3 o_editable"
                                           style="font-family:'Inter',sans-serif;line-height:1.8">If you don't see a
                                            club that matches your passion, start one. Axion provides funding, meeting
                                            space, marketing support, and an administrative mentor to help any student
                                            launch a new organization.
                                        </p>
                                        <div class="d-flex flex-column gap-1">
                                            <div class="app-step">
                                                <div class="app-step-num" style="background:#1a7a4a">1</div>
                                                <div class="app-step-body">
                                                    <h6 class="o_editable">Form a Core Group</h6>
                                                    <p class="o_editable">Gather at least 10 interested students and
                                                        identify a faculty or staff advisor willing to sponsor the club.
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="app-step-connector"/>
                                            <div class="app-step">
                                                <div class="app-step-num" style="background:#1a7a4a">2</div>
                                                <div class="app-step-body">
                                                    <h6 class="o_editable">Submit a Club Charter</h6>
                                                    <p class="o_editable">Complete the New Organization Charter form via
                                                        the Student Life portal with your mission statement, officers,
                                                        and constitution.
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="app-step-connector"/>
                                            <div class="app-step">
                                                <div class="app-step-num" style="background:#1a7a4a">3</div>
                                                <div class="app-step-body">
                                                    <h6 class="o_editable">SGA Approval &amp; Funding</h6>
                                                    <p class="o_editable">The SGA reviews applications monthly. Approved
                                                        clubs receive an initial budget of up to $1,500 and a dedicated
                                                        space for meetings.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="#" class="btn rounded-pill px-4 mt-3 fw-semibold"
                                           style="background:#1a7a4a;color:white;font-family:'Inter',sans-serif;font-size:.88rem">
                                            Start a Club
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <!--    clubs-orgs-->
    <record id="university_clubs_orgs_page_link" model="theme.website.page">
        <field name="url">/clubs-orgs</field>
        <field name="view_id" ref="university_clubs_orgs_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>
