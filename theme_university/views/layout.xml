<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Head Assets Injection -->
    <template id="university_head_assets" inherit_id="website.layout" name="University Head Assets">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap"
                  rel="stylesheet"/>
            <link rel="stylesheet"
                  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
        </xpath>
    </template>
    <!-- Custom Header -->
    <template id="university_header" inherit_id="website.layout" name="University Header">
        <xpath expr="//header" position="replace">
            <header id="top" data-anchor="true" data-name="Header" class="site-header">
                <!-- TOP BAR -->
                <div class="topbar py-2">
                    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex gap-4">
                            <a href="tel:+18001234567"><i class="bi bi-telephone-fill me-1"/>+1 (800) 123-4567
                            </a>
                            <a href="mailto:admissions@Axion.edu"><i class="bi bi-envelope-fill me-1"/>
                                admissions@Axion.edu
                            </a>
                        </div>
                        <div class="d-flex align-items-center gap-4">
                            <a href="#" class="text-white opacity-50">
                                <i class="bi bi-facebook"/>
                            </a>
                            <a href="#" class="text-white opacity-50">
                                <i class="bi bi-instagram"/>
                            </a>
                            <a href="#" class="text-white opacity-50">
                                <i class="bi bi-linkedin"/>
                            </a>
                            <a href="#" class="text-white opacity-50">
                                <i class="bi bi-twitter-x"/>
                            </a>
                        </div>
                    </div>
                </div>
                <!-- NAVBAR -->
                <nav class="navbar navbar-expand-lg" id="mainNavbar">
                    <div class="container">
                        <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/">
                            <img src="/theme_university/static/src/img/logo.png" alt="Axion Logo" class="logo-img"
                                 width="200"/>
                        </a>
                        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                                data-bs-target="#top_menu_collapse">
                            <span class="navbar-toggler-icon"/>
                        </button>
                        <div class="collapse navbar-collapse" id="top_menu_collapse">
                            <t t-call="website.navbar_nav">
                                <t t-set="_nav_class" t-valuef="ms-auto mb-2 mb-lg-0 align-items-lg-center"/>
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-call="website.submenu">
                                        <t t-set="item_class" t-valuef="nav-item"/>
                                        <t t-set="link_class" t-valuef="nav-link"/>
                                    </t>
                                </t>
                            </t>
                            <ul class="navbar-nav align-items-lg-center gap-2 ms-lg-auto mt-3 mt-lg-0">
                                <t t-call="portal.placeholder_user_sign_in">
                                    <t t-set="_item_class" t-valuef="nav-item"/>
                                    <t t-set="_link_class" t-valuef="nav-link o_nav_account_link"/>
                                </t>
                                <t t-call="portal.user_dropdown">
                                    <t t-set="_icon" t-value="true"/>
                                    <t t-set="_user_name" t-value="true"/>
                                    <t t-set="_user_name_class" t-valuef="me-2 small"/>
                                    <t t-set="_item_class" t-valuef="nav-item dropdown"/>
                                    <t t-set="_link_class"
                                       t-valuef="nav-link o_nav_account_link d-flex align-items-center"/>
                                    <t t-set="_icon_class" t-valuef="me-2"/>
                                    <t t-set="_dropdown_menu_class" t-valuef="dropdown-menu-end"/>
                                </t>
                            </ul>
                            <a href="/apply" class="btn-apply ms-lg-3">Apply Now</a>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>
    </template>
    <!-- Custom Footer -->
    <template id="university_footer" inherit_id="website.layout" name="University Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo" data-name="Footer">
                <footer class="pt-5 pb-3">
                    <div class="container pt-5">
                        <div class="row g-4 mb-5">
                            <div class="col-lg-4">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <img src="/theme_university/static/src/img/logo-white.png" alt="Axion Logo"
                                         class="logo-img" width="200"/>
                                </div>
                                <p class="footer-desc mb-4">
                                    Empowering brilliant minds since 1892. A world-class research university dedicated
                                    to excellence,
                                    innovation, and global impact across every field of human endeavor.
                                </p>
                                <div class="footer-social d-flex gap-2">
                                    <a href="#" aria-label="Facebook">
                                        <i class="bi bi-facebook"/>
                                    </a>
                                    <a href="#" aria-label="X (Twitter)">
                                        <i class="bi bi-twitter-x"/>
                                    </a>
                                    <a href="#" aria-label="Instagram">
                                        <i class="bi bi-instagram"/>
                                    </a>
                                    <a href="#" aria-label="LinkedIn">
                                        <i class="bi bi-linkedin"/>
                                    </a>
                                    <a href="#" aria-label="YouTube">
                                        <i class="bi bi-youtube"/>
                                    </a>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-2 offset-lg-1">
                                <div class="footer-heading">Academics</div>
                                <a href="/academics" class="footer-link">Undergraduate</a>
                                <a href="/academics" class="footer-link">Graduate</a>
                                <a href="/academics" class="footer-link">Online Programs</a>
                                <a href="/research" class="footer-link">Research</a>
                                <a href="#" class="footer-link">Libraries</a>
                            </div>
                            <div class="col-sm-6 col-lg-2">
                                <div class="footer-heading">Campus Life</div>
                                <a href="/campus-life" class="footer-link">Housing &amp; Dining</a>
                                <a href="/campus-life" class="footer-link">Clubs &amp; Orgs</a>
                                <a href="/campus-life" class="footer-link">Athletics</a>
                                <a href="/campus-life" class="footer-link">Health &amp; Wellness</a>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="footer-heading">Contact Us</div>
                                <div class="footer-contact-item">
                                    <i class="bi bi-geo-alt-fill"/>
                                    <span>1 University Drive, Axion, CA 90210</span>
                                </div>
                                <div class="footer-contact-item">
                                    <i class="bi bi-telephone-fill"/>
                                    <span>+1 (800) 123-4567</span>
                                </div>
                                <div class="footer-contact-item">
                                    <i class="bi bi-envelope-fill"/>
                                    <span>info@Axion.edu</span>
                                </div>
                                <div class="footer-contact-item">
                                    <i class="bi bi-clock-fill"/>
                                    <span>Mon-Fri, 8:00 AM - 5:00 PM PST</span>
                                </div>
                            </div>
                        </div>
                        <!-- Newsletter block inside footer -->
                        <div class="footer-newsletter mb-4">
                            <div class="row align-items-center g-3">
                                <div class="col-lg-5">
                                    <h6>University Updates</h6>
                                    <p>Receive admissions dates, campus events, research highlights, and student life
                                        news in one place.
                                    </p>
                                </div>
                                <div class="col-lg-7 d-flex justify-content-lg-end">
                                    <t t-set="newsletter_list"
                                       t-value="request.env.ref('theme_university.mailing_list_university_news', raise_if_not_found=False)"/>
                                    <div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe"
                                         data-vxml="001"
                                         t-att-data-list-id="newsletter_list.id if newsletter_list else 0"
                                         data-name="Newsletter Form">
                                        <div class="js_subscribed_wrap d-none">
                                            <p class="text-success mt-2">
                                                <i class="fa fa-check-circle-o" role="img"/>
                                                You are subscribed to university updates.
                                            </p>
                                        </div>
                                        <div class="js_subscribe_wrap">
                                            <div class="input-group">
                                                <input type="email" name="email"
                                                       class="s_newsletter_subscribe_form_input js_subscribe_value form-control newsletter-input"
                                                       placeholder="Enter your university email address"/>
                                                <button class="js_subscribe_btn o_submit btn newsletter-btn">Join
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr class="footer-divider"/>
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span class="footer-bottom-text">&#169; 2026 Axion University. All rights reserved.</span>
                            <div class="d-flex gap-3">
                                <a href="#" class="footer-bottom-link">Privacy Policy</a>
                                <a href="#" class="footer-bottom-link">Terms of Use</a>
                                <a href="#" class="footer-bottom-link">Accessibility</a>
                                <a href="#" class="footer-bottom-link">Cookies</a>
                            </div>
                        </div>
                    </div>
                </footer>
                <a href="#" class="back-to-top" id="backToTop" aria-label="Back to top">
                    <i class="bi bi-chevron-up"/>
                </a>
            </div>
        </xpath>
    </template>
    <!-- Remove Brand Promotion -->
    <template id="university_no_branding" inherit_id="website.layout" name="University No Branding">
        <xpath expr="//t[@t-call='web.brand_promotion']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
