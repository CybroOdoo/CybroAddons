<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Campus Life -->
    <record id="university_campus_life_page" model="theme.ir.ui.view">
        <field name="name">University Campus Life Page</field>
        <field name="key">theme_university.university_campus_life_page</field>
        <field name="arch" type="xml">
            <t t-name="theme_university.university_campus_life_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <!-- INNER HERO -->
                        <section class="inner-hero">
                            <div class="inner-hero-bg"/>
                            <div class="inner-hero-shape inner-hero-shape-1"/>
                            <div class="inner-hero-shape inner-hero-shape-2"/>
                            <div class="container">
                                <div class="inner-hero-content">
                                    <div class="inner-breadcrumb o_editable">
                                        <a href="/">Home</a>
                                        <span class="sep">
                                            <i class="bi bi-chevron-right"/>
                                        </span>
                                        <span class="current">Campus Life</span>
                                    </div>
                                    <div class="row align-items-center g-5">
                                        <div class="col-lg-7 reveal">
                                            <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                                 style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:var(--accent-light)">
                                                <i class="bi bi-house-heart-fill me-1"/>
                                                Life at Axion
                                            </div>
                                            <h1 class="inner-hero-title o_editable">More Than a Degree —<br/>A Complete
                                                Experience
                                            </h1>
                                            <p class="inner-hero-subtitle o_editable">A 500-acre campus. 200+ student
                                                organizations. World-class athletic facilities, student residences, and
                                                a wellness center that puts your health first. Life at Axion is designed
                                                to challenge, inspire, and connect you.
                                            </p>
                                            <div class="inner-hero-meta o_editable">
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-people-fill"/>
                                                    48,000 Students
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-collection-fill"/>
                                                    200+ Clubs
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-trophy-fill"/>
                                                    NCAA Division I
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-geo-alt-fill"/>
                                                    500-Acre Campus
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-5 d-none d-lg-block reveal reveal-delay-2">
                                            <div class="row g-3">
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">200+</div>
                                                        <div class="highlight-label">Student Organizations</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">28</div>
                                                        <div class="highlight-label">NCAA Sports Teams</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">14</div>
                                                        <div class="highlight-label">Dining Locations</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">96%</div>
                                                        <div class="highlight-label">Student Satisfaction</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- QUICK NAV -->
                        <section class="section-pad" style="background:var(--bg-light)">
                            <div class="container">
                                <div class="text-center mb-5 reveal">
                                    <div class="section-eyebrow o_editable">Explore</div>
                                    <h2 class="section-title o_editable">Everything Campus Life Has to Offer</h2>
                                </div>
                                <div class="row g-4">
                                    <div class="col-sm-6 col-lg-3 reveal reveal-delay-1">
                                        <a href="/housing-dining" class="cl-nav-tile">
                                            <div class="cl-nav-tile-icon" style="background:#e8f0fe">
                                                <i class="bi bi-house-fill"
                                                   style="color:var(--primary);font-size:1.6rem"/>
                                            </div>
                                            <div class="o_editable">
                                                <div class="cl-nav-tile-label">Housing &amp; Dining</div>
                                                <div class="cl-nav-tile-sub">Residence halls, apartments, 14 dining
                                                    locations, and flexible meal plans.
                                                </div>
                                                <span class="mt-1"
                                                      style="font-family:'Inter',sans-serif;font-size:.78rem;font-weight:700;color:var(--primary)">
                                                    Explore
                                                    <i class="bi bi-arrow-right"/>
                                                </span>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-sm-6 col-lg-3 reveal reveal-delay-2">
                                        <a href="/clubs-orgs" class="cl-nav-tile">
                                            <div class="cl-nav-tile-icon" style="background:#e6f4ea">
                                                <i class="bi bi-people-fill"
                                                   style="color:var(--success);font-size:1.6rem"/>
                                            </div>
                                            <div class="o_editable">
                                                <div class="cl-nav-tile-label">Clubs &amp; Organizations</div>
                                                <div class="cl-nav-tile-sub">200+ student organizations across
                                                    academics, culture, arts, and service.
                                                </div>
                                                <span class="mt-1"
                                                      style="font-family:'Inter',sans-serif;font-size:.78rem;font-weight:700;color:var(--success)">
                                                    Explore
                                                    <i class="bi bi-arrow-right"/>
                                                </span>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-sm-6 col-lg-3 reveal reveal-delay-3">
                                        <a href="/athletics" class="cl-nav-tile">
                                            <div class="cl-nav-tile-icon" style="background:#fce8e8">
                                                <i class="bi bi-trophy-fill" style="color:#c0392b;font-size:1.6rem"/>
                                            </div>
                                            <div class="o_editable">
                                                <div class="cl-nav-tile-label">Athletics</div>
                                                <div class="cl-nav-tile-sub">28 NCAA Division I teams, intramural
                                                    sports, and state-of-the-art fitness centers.
                                                </div>
                                                <span class="mt-1"
                                                      style="font-family:'Inter',sans-serif;font-size:.78rem;font-weight:700;color:#c0392b">
                                                    Explore
                                                    <i class="bi bi-arrow-right"/>
                                                </span>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-sm-6 col-lg-3 reveal reveal-delay-4">
                                        <a href="/health-wellness" class="cl-nav-tile">
                                            <div class="cl-nav-tile-icon" style="background:#f3e8ff">
                                                <i class="bi bi-heart-pulse-fill"
                                                   style="color:#6f42c1;font-size:1.6rem"/>
                                            </div>
                                            <div class="o_editable">
                                                <div class="cl-nav-tile-label">Health &amp; Wellness</div>
                                                <div class="cl-nav-tile-sub">On-campus clinic, counseling services, and
                                                    wellness programs available to all students.
                                                </div>
                                                <span class="mt-1"
                                                      style="font-family:'Inter',sans-serif;font-size:.78rem;font-weight:700;color:#6f42c1">
                                                    Explore
                                                    <i class="bi bi-arrow-right"/>
                                                </span>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- CAMPUS GALLERY STRIP -->
                        <section class="section-pad">
                            <div class="container">
                                <div class="row align-items-center g-5">
                                    <div class="col-lg-5 reveal">
                                        <div class="section-eyebrow o_editable">Our Campus</div>
                                        <h2 class="section-title o_editable">500 Acres of Inspiration</h2>
                                        <p class="text-muted mb-4 o_editable"
                                           style="font-family:'Inter',sans-serif;line-height:1.8">
                                            From the tree-lined Engineering Plaza to the glass-walled Innovation Hub,
                                            every corner of campus is built to spark curiosity and foster community. Our
                                            facilities include a 50,000-seat stadium, a state-of-the-art performing arts
                                            center, and over 40 research buildings.
                                        </p>
                                        <div class="d-flex flex-column gap-3 o_editable">
                                            <div class="d-flex gap-3 align-items-center">
                                                <div style="width:38px;height:38px;border-radius:11px;background:#e8f0fe;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                    <i class="bi bi-building-fill" style="color:var(--primary)"/>
                                                </div>
                                                <div style="font-family:'Inter',sans-serif;font-size:.85rem">
                                                    <strong>120+ Academic Buildings</strong>
                                                    — labs, studios, clinics, and maker spaces all on one connected
                                                    campus.
                                                </div>
                                            </div>
                                            <div class="d-flex gap-3 align-items-center">
                                                <div style="width:38px;height:38px;border-radius:11px;background:#e6f4ea;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                    <i class="bi bi-tree-fill" style="color:var(--success)"/>
                                                </div>
                                                <div style="font-family:'Inter',sans-serif;font-size:.85rem">
                                                    <strong>40+ Green Spaces</strong>
                                                    — botanical gardens, outdoor study areas, and the iconic Axion Quad.
                                                </div>
                                            </div>
                                            <div class="d-flex gap-3 align-items-center">
                                                <div style="width:38px;height:38px;border-radius:11px;background:#fff8e1;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                    <i class="bi bi-wifi" style="color:#b45309"/>
                                                </div>
                                                <div style="font-family:'Inter',sans-serif;font-size:.85rem">
                                                    <strong>Full Campus Wi-Fi</strong>
                                                    — 10 Gbps fiber network across all buildings, dorms, and outdoor
                                                    zones.
                                                </div>
                                            </div>
                                        </div>
                                        <a href="#" class="btn rounded-pill px-4 mt-4 fw-semibold o_editable"
                                           style="background:var(--primary);color:white;font-family:'Inter',sans-serif;font-size:.88rem">
                                            <i class="bi bi-play-circle-fill me-1"/>
                                            Virtual Campus Tour
                                        </a>
                                    </div>
                                    <div class="col-lg-7 reveal reveal-delay-2">
                                        <div class="cl-photo-strip o_editable" style="height:380px">
                                            <div class="cl-photo-strip-item">
                                                <img src="/theme_university/static/src/img/gallery-main.jpg"
                                                     alt="Main Campus" style="height:380px"/>
                                                <div class="cl-photo-caption">
                                                    <i class="bi bi-camera-fill me-1"/>
                                                    Engineering Plaza
                                                </div>
                                            </div>
                                            <div class="d-flex flex-column gap-3" style="min-width:0">
                                                <div class="cl-photo-strip-item" style="height:182px">
                                                    <img src="/theme_university/static/src/img/gallery-library.jpg"
                                                         alt="Library" style="height:182px"/>
                                                    <div class="cl-photo-caption">
                                                        <i class="bi bi-camera-fill me-1"/>
                                                        Central Library
                                                    </div>
                                                </div>
                                                <div class="cl-photo-strip-item" style="height:182px">
                                                    <img src="/theme_university/static/src/img/gallery-events.jpg"
                                                         alt="Events" style="height:182px"/>
                                                    <div class="cl-photo-caption">
                                                        <i class="bi bi-camera-fill me-1"/>
                                                        Events Hub
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- STUDENT LIFE STATS -->
                        <section style="background:var(--primary-dark);padding:3rem 0">
                            <div class="container">
                                <div class="row g-4 text-center">
                                    <div class="col-6 col-md-3 reveal">
                                        <div style="font-size:2.2rem;font-weight:800;color:var(--accent-light)"
                                             class="stat-num o_editable">200+
                                        </div>
                                        <div style="font-family:'Inter',sans-serif;font-size:.8rem;color:rgba(255,255,255,.55);margin-top:.25rem"
                                             class="o_editable">Student Organizations
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 reveal reveal-delay-1">
                                        <div style="font-size:2.2rem;font-weight:800;color:var(--accent-light)"
                                             class="stat-num o_editable">28
                                        </div>
                                        <div style="font-family:'Inter',sans-serif;font-size:.8rem;color:rgba(255,255,255,.55);margin-top:.25rem"
                                             class="o_editable">NCAA Sports Teams
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 reveal reveal-delay-2">
                                        <div style="font-size:2.2rem;font-weight:800;color:var(--accent-light)"
                                             class="stat-num o_editable">14
                                        </div>
                                        <div style="font-family:'Inter',sans-serif;font-size:.8rem;color:rgba(255,255,255,.55);margin-top:.25rem"
                                             class="o_editable">Dining Locations
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 reveal reveal-delay-3">
                                        <div style="font-size:2.2rem;font-weight:800;color:var(--accent-light)"
                                             class="stat-num o_editable">12,000+
                                        </div>
                                        <div style="font-family:'Inter',sans-serif;font-size:.8rem;color:rgba(255,255,255,.55);margin-top:.25rem"
                                             class="o_editable">On-Campus Residents
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- TESTIMONIALS -->
                        <section class="section-pad" style="background:var(--bg-light)">
                            <div class="container">
                                <div class="text-center mb-5 reveal">
                                    <div class="section-eyebrow o_editable">Student Voices</div>
                                    <h2 class="section-title o_editable">What Students Say About Life at Axion</h2>
                                </div>
                                <div class="row g-4">
                                    <div class="col-md-4 reveal reveal-delay-1">
                                        <div class="testimonial-card h-100 o_editable">
                                            <div class="testimonial-stars">★★★★★</div>
                                            <p class="testimonial-text">"The campus feels like a small city — everything
                                                you need is right here. I've made lifelong friends through my debate
                                                club and intramural soccer team. Axion truly changed my life."
                                            </p>
                                            <div class="d-flex align-items-center gap-3 mt-4">
                                                <img src="/theme_university/static/src/img/avatar-sarah.jpg" alt="Sarah"
                                                     class="testimonial-avatar"/>
                                                <div>
                                                    <div class="testimonial-name">Sarah Mitchell</div>
                                                    <div class="testimonial-role">Junior, Computer Science</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 reveal reveal-delay-2">
                                        <div class="testimonial-card h-100 o_editable">
                                            <div class="testimonial-stars">★★★★★</div>
                                            <p class="testimonial-text">"I was worried about leaving home, but the
                                                residence halls, counseling center, and the sheer number of student
                                                events made this campus feel like family within the first two weeks."
                                            </p>
                                            <div class="d-flex align-items-center gap-3 mt-4">
                                                <img src="/theme_university/static/src/img/avatar-james.jpg" alt="James"
                                                     class="testimonial-avatar"/>
                                                <div>
                                                    <div class="testimonial-name">James Okonkwo</div>
                                                    <div class="testimonial-role">Sophomore, Business</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 reveal reveal-delay-3">
                                        <div class="testimonial-card h-100 o_editable">
                                            <div class="testimonial-stars">★★★★★</div>
                                            <p class="testimonial-text">"As an international student, I was nervous. The
                                                global clubs, cultural events, and welcoming community made settling in
                                                incredibly smooth. This campus is the most diverse I've ever
                                                experienced."
                                            </p>
                                            <div class="d-flex align-items-center gap-3 mt-4">
                                                <img src="/theme_university/static/src/img/avatar-priya.jpg" alt="Priya"
                                                     class="testimonial-avatar"/>
                                                <div>
                                                    <div class="testimonial-name">Priya Nair</div>
                                                    <div class="testimonial-role">Graduate Student, Biomedical</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- CTA -->
                        <section class="cta-section">
                            <div class="cta-bg-img"/>
                            <div class="cta-shape-1"/>
                            <div class="cta-shape-2"/>
                            <div class="container position-relative text-center reveal" style="z-index:2">
                                <div class="section-eyebrow d-inline-flex o_editable"
                                     style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.35);color:var(--accent-light)">
                                    Come See for Yourself
                                </div>
                                <h2 class="cta-title o_editable">Experience Axion Campus Life</h2>
                                <p class="cta-subtitle o_editable">Join us for an Open Day, book a personalized campus
                                    tour, or connect with a current student ambassador to get the real picture of life
                                    here.
                                </p>
                                <div class="d-flex flex-wrap justify-content-center gap-3 o_editable">
                                    <a href="#" class="btn-hero-primary">
                                        <i class="bi bi-calendar-event-fill"/>
                                        Book a Campus Visit
                                    </a>
                                    <a href="#" class="btn-hero-ghost">
                                        <i class="bi bi-play-circle-fill"/>
                                        Virtual Tour
                                    </a>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <!--    Campus life-->
    <record id="university_campus_life_page_link" model="theme.website.page">
        <field name="url">/campus-life</field>
        <field name="view_id" ref="university_campus_life_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>
