<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Research Centers Page-->
    <record id="university_research_centers_page" model="theme.ir.ui.view">
        <field name="name">University Research Centers Page</field>
        <field name="key">theme_university.university_research_centers_page</field>
        <field name="arch" type="xml">
            <!--Research Centers Page Template-->
            <t t-name="theme_university.university_research_centers_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <!-- INNER HERO -->
                        <section class="inner-hero">
                            <div class="inner-hero-bg"/>
                            <div class="inner-hero-shape inner-hero-shape-1"/>
                            <div class="inner-hero-shape inner-hero-shape-2"/>
                            <div class="container">
                                <div class="inner-hero-content">
                                    <div class="inner-breadcrumb o_editable">
                                        <a href="/">Home</a>
                                        <span class="sep">
                                            <i class="bi bi-chevron-right"/>
                                        </span>
                                        <a href="/academics">Academics</a>
                                        <span class="sep">
                                            <i class="bi bi-chevron-right"/>
                                        </span>
                                        <span class="current">Research Centers</span>
                                    </div>
                                    <div class="row g-4 align-items-center">
                                        <div class="col-lg-7 reveal">
                                            <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                                 style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:var(--accent-light)">
                                                <i class="bi bi-lightbulb-fill"/>
                                                Discovery &amp; Innovation
                                            </div>
                                            <h1 class="inner-hero-title o_editable">Research Centers &amp; Institutes
                                            </h1>
                                            <p class="inner-hero-subtitle o_editable">50+ interdisciplinary research
                                                centers tackling the world's most complex challenges — from climate
                                                change and pandemic preparedness to quantum computing and AI ethics.
                                                $400M in annual funding powers research that makes a global difference.
                                            </p>
                                            <div class="inner-hero-meta o_editable">
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-building"/>
                                                    50+ Centers
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-currency-dollar"/>
                                                    $400M Budget
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-journals"/>
                                                    12,000+ Publications/yr
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-patch-check-fill"/>
                                                    340+ Patents
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-5 d-none d-lg-block reveal reveal-delay-2">
                                            <div class="row g-3">
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">$400M</div>
                                                        <div class="highlight-label">Annual Research Budget</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">50+</div>
                                                        <div class="highlight-label">Research Centers</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">340+</div>
                                                        <div class="highlight-label">Patents Granted</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">2,400+</div>
                                                        <div class="highlight-label">Active Researchers</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- RESEARCH STATS STRIP -->
                        <section style="background:var(--primary-dark);padding:2rem 0">
                            <div class="container">
                                <div class="row g-3 text-center">
                                    <div class="col-6 col-md-3 reveal">
                                        <div style="font-size:2rem;font-weight:800;color:var(--accent-light)"
                                             class="o_editable">12K+
                                        </div>
                                        <div style="font-family:'Inter',sans-serif;font-size:1rem;color:rgba(255,255,255,.55)"
                                             class="o_editable">Peer-reviewed publications per year
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 reveal reveal-delay-1">
                                        <div style="font-size:2rem;font-weight:800;color:var(--accent-light)"
                                             class="o_editable">180+
                                        </div>
                                        <div style="font-family:'Inter',sans-serif;font-size:1rem;color:rgba(255,255,255,.55)"
                                             class="o_editable">Active industry partnerships
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 reveal reveal-delay-2">
                                        <div style="font-size:2rem;font-weight:800;color:var(--accent-light)"
                                             class="o_editable">$2.1B
                                        </div>
                                        <div style="font-family:'Inter',sans-serif;font-size:1rem;color:rgba(255,255,255,.55)"
                                             class="o_editable">External grants secured in 5 years
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3 reveal reveal-delay-3">
                                        <div style="font-size:2rem;font-weight:800;color:var(--accent-light)"
                                             class="o_editable">28
                                        </div>
                                        <div style="font-family:'Inter',sans-serif;font-size:1rem;color:rgba(255,255,255,.55)"
                                             class="o_editable">Nobel laureates among faculty &amp; alumni
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- FEATURED CENTERS -->
                        <section class="section-pad" id="centers">
                            <div class="container">
                                <div class="page-section-header text-center reveal">
                                    <div class="section-eyebrow o_editable">Our Institutes</div>
                                    <h2 class="section-title o_editable">Featured Research Centers</h2>
                                    <p class="section-subtitle o_editable">Each center brings together faculty, doctoral
                                        students, and industry partners to work on problems that matter to the world.
                                    </p>
                                </div>
                                <div class="row g-4">
                                    <!-- CAML -->
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-1">
                                        <div class="rc-card">
                                            <div class="rc-card-img">
                                                <img src="/theme_university/static/src/img/news-ai.jpg"
                                                     alt="AI Center"/>
                                            </div>
                                            <div class="rc-card-body">
                                                <span class="rc-tag" style="background:#e8f0fe;color:var(--primary)">
                                                    Artificial Intelligence
                                                </span>
                                                <h5 class="o_editable">Center for AI &amp; Machine Learning (CAML)</h5>
                                                <p class="o_editable">Pioneering research in deep learning,
                                                    reinforcement learning, AI ethics, and human-AI interaction. Partner
                                                    of Google DeepMind, Microsoft Research, and OpenAI.
                                                </p>
                                                <div class="d-flex flex-wrap gap-3 mb-3 o_editable">
                                                    <div class="rc-stat"><strong>$85M</strong>&#160;/yr budget
                                                    </div>
                                                    <div class="rc-stat"><strong>240</strong>&#160;researchers
                                                    </div>
                                                    <div class="rc-stat"><i class="bi bi-journals"
                                                                            style="color:var(--accent)"/>&#160;<strong>
                                                        1,200+</strong>&#160;papers
                                                    </div>
                                                </div>
                                                <a href="#" class="btn btn-sm rounded-pill px-3 fw-semibold o_editable"
                                                   style="background:var(--primary);color:white;font-family:'Inter',sans-serif;font-size:.76rem">
                                                    Visit Center
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- IBR -->
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-2">
                                        <div class="rc-card">
                                            <div class="rc-card-img">
                                                <img src="/theme_university/static/src/img/gallery-lab.jpg"
                                                     alt="Biomedical Research"/>
                                            </div>
                                            <div class="rc-card-body">
                                                <span class="rc-tag" style="background:#fce8e8;color:#c0392b">
                                                    Biomedical
                                                </span>
                                                <h5 class="o_editable">Institute for Biomedical Research (IBR)</h5>
                                                <p class="o_editable">Translational medicine, cancer biology, genomics,
                                                    and neuroscience research connecting bench science to clinical
                                                    application in our partner hospital network.
                                                </p>
                                                <div class="d-flex flex-wrap gap-3 mb-3 o_editable">
                                                    <div class="rc-stat"><strong>$120M</strong>&#160;/yr budget
                                                    </div>
                                                    <div class="rc-stat"><strong>380</strong>&#160;researchers
                                                    </div>
                                                    <div class="rc-stat"><i class="bi bi-journals"
                                                                            style="color:var(--accent)"/>&#160;<strong>
                                                        2,400+</strong>&#160;papers
                                                    </div>
                                                </div>
                                                <a href="#" class="btn btn-sm rounded-pill px-3 fw-semibold o_editable"
                                                   style="background:#c0392b;color:white;font-family:'Inter',sans-serif;font-size:.76rem">
                                                    Visit Center
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- CCSS -->
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-3">
                                        <div class="rc-card">
                                            <div class="rc-card-img">
                                                <img src="/theme_university/static/src/img/campus-life.jpg"
                                                     alt="Climate Science"/>
                                            </div>
                                            <div class="rc-card-body">
                                                <span class="rc-tag" style="background:#e6f4ea;color:var(--success)">
                                                    Climate &amp; Environment
                                                </span>
                                                <h5 class="o_editable">Center for Climate &amp; Sustainability Science
                                                    (CCSS)
                                                </h5>
                                                <p class="o_editable">Climate modelling, carbon capture, renewable
                                                    energy, and environmental policy research in partnership with the UN
                                                    Environment Programme and national governments.
                                                </p>
                                                <div class="d-flex flex-wrap gap-3 mb-3 o_editable">
                                                    <div class="rc-stat"><strong>$60M</strong>&#160;/yr budget
                                                    </div>
                                                    <div class="rc-stat"><strong>160</strong>&#160;researchers
                                                    </div>
                                                    <div class="rc-stat"><i class="bi bi-journals"
                                                                            style="color:var(--accent)"/>&#160;<strong>
                                                        980+</strong>&#160;papers
                                                    </div>
                                                </div>
                                                <a href="#" class="btn btn-sm rounded-pill px-3 fw-semibold o_editable"
                                                   style="background:var(--success);color:white;font-family:'Inter',sans-serif;font-size:.76rem">
                                                    Visit Center
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- IFI -->
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-1">
                                        <div class="rc-card">
                                            <div class="rc-card-img">
                                                <img src="/theme_university/static/src/img/gallery-library.jpg"
                                                     alt="Finance Research"/>
                                            </div>
                                            <div class="rc-card-body">
                                                <span class="rc-tag" style="background:#fff8e1;color:#b45309">Finance
                                                    &amp; Economics
                                                </span>
                                                <h5 class="o_editable">Institute for Financial Innovation (IFI)</h5>
                                                <p class="o_editable">Cutting-edge research in FinTech, cryptocurrency
                                                    regulation, behavioral economics, and global capital markets.
                                                    Advisory board includes former central bank governors.
                                                </p>
                                                <div class="d-flex flex-wrap gap-3 mb-3 o_editable">
                                                    <div class="rc-stat"><strong>$45M</strong>&#160;/yr budget
                                                    </div>
                                                    <div class="rc-stat"><strong>90</strong>&#160;researchers
                                                    </div>
                                                    <div class="rc-stat"><i class="bi bi-journals"
                                                                            style="color:var(--accent)"/>&#160;<strong>
                                                        640+</strong>&#160;papers
                                                    </div>
                                                </div>
                                                <a href="#" class="btn btn-sm rounded-pill px-3 fw-semibold o_editable"
                                                   style="background:#b45309;color:white;font-family:'Inter',sans-serif;font-size:.76rem">
                                                    Visit Center
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- CGH -->
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-2">
                                        <div class="rc-card">
                                            <div class="rc-card-img">
                                                <img src="/theme_university/static/src/img/news-students.jpg"
                                                     alt="Global Health"/>
                                            </div>
                                            <div class="rc-card-body">
                                                <span class="rc-tag" style="background:#f3e8ff;color:#6f42c1">Global
                                                    Health
                                                </span>
                                                <h5 class="o_editable">Center for Global Health (CGH)</h5>
                                                <p class="o_editable">Pandemic preparedness, infectious disease,
                                                    maternal health, and health systems research. Field sites in 35
                                                    countries across Africa, Asia, and Latin America.
                                                </p>
                                                <div class="d-flex flex-wrap gap-3 mb-3 o_editable">
                                                    <div class="rc-stat"><strong>$55M</strong>&#160;/yr budget
                                                    </div>
                                                    <div class="rc-stat"><strong>200</strong>&#160;researchers
                                                    </div>
                                                    <div class="rc-stat"><i class="bi bi-journals"
                                                                            style="color:var(--accent)"/>&#160;<strong>
                                                        1,800+</strong>&#160;papers
                                                    </div>
                                                </div>
                                                <a href="#" class="btn btn-sm rounded-pill px-3 fw-semibold o_editable"
                                                   style="background:#6f42c1;color:white;font-family:'Inter',sans-serif;font-size:.76rem">
                                                    Visit Center
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- IQC -->
                                    <div class="col-md-6 col-lg-4 reveal reveal-delay-3">
                                        <div class="rc-card">
                                            <div class="rc-card-img">
                                                <img src="/theme_university/static/src/img/news-research.jpg"
                                                     alt="Quantum Computing"/>
                                            </div>
                                            <div class="rc-card-body">
                                                <span class="rc-tag" style="background:#e0f7fa;color:#0277bd">Quantum
                                                    &amp; Physics
                                                </span>
                                                <h5 class="o_editable">Institute for Quantum Computing (IQC)</h5>
                                                <p class="o_editable">Superconducting qubits, quantum cryptography, and
                                                    quantum communication research. Operates a 127-qubit quantum
                                                    processor — one of six in the world accessible to university
                                                    researchers.
                                                </p>
                                                <div class="d-flex flex-wrap gap-3 mb-3 o_editable">
                                                    <div class="rc-stat"><strong>$35M</strong>&#160;/yr budget
                                                    </div>
                                                    <div class="rc-stat"><strong>110</strong>&#160;researchers
                                                    </div>
                                                    <div class="rc-stat"><i class="bi bi-journals"
                                                                            style="color:var(--accent)"/>&#160;<strong>
                                                        520+</strong>&#160;papers
                                                    </div>
                                                </div>
                                                <a href="#" class="btn btn-sm rounded-pill px-3 fw-semibold o_editable"
                                                   style="background:#0277bd;color:white;font-family:'Inter',sans-serif;font-size:.76rem">
                                                    Visit Center
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- RESEARCH INITIATIVES -->
                        <section class="section-pad" style="background:var(--bg-light)">
                            <div class="container">
                                <div class="row g-5 align-items-center">
                                    <div class="col-lg-5 reveal">
                                        <div class="section-eyebrow o_editable">Key Focus Areas</div>
                                        <h2 class="section-title o_editable">Current Research Initiatives</h2>
                                        <p class="text-muted mb-4 o_editable"
                                           style="font-family:'Inter',sans-serif;line-height:1.8">Our grand challenge
                                            initiatives bring together researchers from multiple disciplines to attack
                                            problems too complex for any single center.
                                        </p>
                                        <div class="d-flex flex-column gap-3">
                                            <div class="d-flex gap-3 align-items-start">
                                                <div style="width:38px;height:38px;border-radius:11px;background:#e8f0fe;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                    <i class="bi bi-cpu-fill" style="color:var(--primary)"/>
                                                </div>
                                                <div class="o_editable">
                                                    <h6 style="font-size:.92rem;margin-bottom:.15rem">Responsible AI
                                                        Initiative
                                                    </h6>
                                                    <p class="text-muted small mb-0"
                                                       style="font-family:'Inter',sans-serif;line-height:1.6">
                                                        Cross-disciplinary effort to develop AI systems that are fair,
                                                        explainable, and aligned with human values — in partnership with
                                                        the EU AI Office.
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-3 align-items-start">
                                                <div style="width:38px;height:38px;border-radius:11px;background:#e6f4ea;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                    <i class="bi bi-tree-fill" style="color:var(--success)"/>
                                                </div>
                                                <div class="o_editable">
                                                    <h6 style="font-size:.92rem;margin-bottom:.15rem">Net Zero Campus
                                                        &amp; Carbon Research
                                                    </h6>
                                                    <p class="text-muted small mb-0"
                                                       style="font-family:'Inter',sans-serif;line-height:1.6">Achieving
                                                        carbon neutrality by 2030 while producing research on carbon
                                                        capture, green building, and renewable microgrids adopted
                                                        globally.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-7 reveal reveal-delay-2">
                                        <div class="row g-3">
                                            <div class="col-6">
                                                <div class="highlight-card o_editable">
                                                    <i class="bi bi-patch-check-fill fs-2 mb-2"
                                                       style="color:var(--success)"/>
                                                    <div class="highlight-num">28</div>
                                                    <div class="highlight-label">Nobel Laureates (faculty &amp;
                                                        alumni)
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="highlight-card o_editable">
                                                    <i class="bi bi-building fs-2 mb-2" style="color:#0277bd"/>
                                                    <div class="highlight-num">180+</div>
                                                    <div class="highlight-label">Industry Partners</div>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="highlight-card o_editable">
                                                    <i class="bi bi-globe2 fs-2 mb-2" style="color:#b45309"/>
                                                    <div class="highlight-num">35</div>
                                                    <div class="highlight-label">Countries with Field Sites</div>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="highlight-card o_editable">
                                                    <i class="bi bi-journals fs-2 mb-2" style="color:#c0392b"/>
                                                    <div class="highlight-num">$2.1B</div>
                                                    <div class="highlight-label">Grants Secured (5 years)</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- COLLABORATION CTA -->
                        <section class="cta-section">
                            <div class="cta-bg-img"/>
                            <div class="cta-shape-1"/>
                            <div class="cta-shape-2"/>
                            <div class="container position-relative text-center reveal" style="z-index:2">
                                <div class="section-eyebrow d-inline-flex o_editable"
                                     style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.35);color:var(--accent-light)">
                                    Partner With Us
                                </div>
                                <h2 class="cta-title o_editable">Collaborate With Axion Research</h2>
                                <p class="cta-subtitle o_editable">Whether you're an industry leader, government agency,
                                    or NGO — our research centers are open to collaboration. Fund a fellowship, sponsor
                                    a lab, or co-investigate with our faculty.
                                </p>
                                <div class="d-flex flex-wrap justify-content-center gap-3 o_editable">
                                    <a href="#" class="btn-hero-primary">
                                        <i class="bi bi-people-fill"/>
                                        Explore Partnership
                                    </a>
                                    <a href="#" class="btn-hero-ghost">
                                        <i class="bi bi-journals"/>
                                        Browse Publications
                                    </a>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <!--Research center page link-->
    <record id="university_research_centers_page_link" model="theme.website.page">
        <field name="url">/research-centers</field>
        <field name="view_id" ref="university_research_centers_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>