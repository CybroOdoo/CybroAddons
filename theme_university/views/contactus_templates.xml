<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact Us Page Override -->
    <template id="university_contactus" inherit_id="website.contactus" name="Theme University Contact Us">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- HERO -->
                <section class="inner-hero">
                    <div class="inner-hero-bg"/>
                    <div class="inner-hero-shape inner-hero-shape-1"/>
                    <div class="inner-hero-shape inner-hero-shape-2"/>
                    <div class="container">
                        <div class="inner-hero-content text-center">
                            <div class="inner-breadcrumb justify-content-center">
                                <a href="/">Home</a>
                                <span class="sep">
                                    <i class="bi bi-chevron-right"/>
                                </span>
                                <span class="current o_editable">Contact Us</span>
                            </div>
                            <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                 style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:#f5c842">
                                <i class="bi bi-envelope-paper"/>
                                Get in Touch
                            </div>
                            <h1 class="inner-hero-title o_editable">We're Here to Help</h1>
                            <p class="inner-hero-subtitle o_editable">Have questions about admissions, campus tours, or
                                academic programs? Reach out to our team, and we'll get back to you as soon as possible.
                            </p>
                        </div>
                    </div>
                </section>
                <!-- CONTACT CONTENT -->
                <section class="section-pad">
                    <div class="container">
                        <div class="row g-5">
                            <!-- Contact Info -->
                            <div class="col-lg-5">
                                <div class="side-nav h-100 p-4 p-md-5">
                                    <h4 class="fw-bold mb-4" style="color:var(--primary-dark)">Contact Information</h4>
                                    <div class="d-flex mb-4">
                                        <div style="font-size:1.5rem;color:var(--primary);margin-right:1rem">
                                            <i class="bi bi-geo-alt-fill"/>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Main Campus</h6>
                                            <p class="text-muted mb-0"
                                               style="font-size:.9rem;font-family:'Inter',sans-serif">1200 Innovation
                                                Way<br/>Axion City, AC 90210
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex mb-4">
                                        <div style="font-size:1.5rem;color:var(--accent);margin-right:1rem">
                                            <i class="bi bi-telephone-fill"/>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Admissions Office</h6>
                                            <p class="text-muted mb-0"
                                               style="font-size:.9rem;font-family:'Inter',sans-serif">+1 (800) 555-0199
                                                <br/>Mon-Fri, 9am - 5pm EST
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex mb-4">
                                        <div style="font-size:1.5rem;color:#1a7a4a;margin-right:1rem">
                                            <i class="bi bi-envelope-fill"/>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Email Us</h6>
                                            <p class="text-muted mb-0"
                                               style="font-size:.9rem;font-family:'Inter',sans-serif">
                                                admissions@axion.edu<br/>info@axion.edu
                                            </p>
                                        </div>
                                    </div>
                                    <hr style="opacity:.1;margin:2rem 0"/>
                                    <h6 class="fw-bold mb-3">Connect With Us</h6>
                                    <div class="d-flex gap-3">
                                        <a href="#"
                                           style="width:40px;height:40px;border-radius:50%;background:rgba(26,58,107,.1);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:1.1rem;transition:all .2s ease">
                                            <i class="bi bi-facebook"/>
                                        </a>
                                        <a href="#"
                                           style="width:40px;height:40px;border-radius:50%;background:rgba(26,58,107,.1);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:1.1rem;transition:all .2s ease">
                                            <i class="bi bi-twitter-x"/>
                                        </a>
                                        <a href="#"
                                           style="width:40px;height:40px;border-radius:50%;background:rgba(26,58,107,.1);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:1.1rem;transition:all .2s ease">
                                            <i class="bi bi-instagram"/>
                                        </a>
                                        <a href="#"
                                           style="width:40px;height:40px;border-radius:50%;background:rgba(26,58,107,.1);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:1.1rem;transition:all .2s ease">
                                            <i class="bi bi-linkedin"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <!-- Form -->
                            <div class="col-lg-7">
                                <div class="p-lg-4">
                                    <h3 class="fw-bold mb-2">Send us a Message</h3>
                                    <p class="text-muted mb-4" style="font-family:'Inter',sans-serif">Fill out the form
                                        below and our team will get back to you within 24 hours.
                                    </p>
                                    <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                        <div class="container p-0">
                                            <form id="contactus_form" action="/website/form/" method="post"
                                                  enctype="multipart/form-data" class="o_mark_required" data-mark="*"
                                                  data-model_name="crm.lead" data-success-mode="redirect"
                                                  data-success-page="/contactus-thank-you" data-pre-fill="true">
                                                <div class="s_website_form_rows row s_col_no_bgcolor">
                                                    <div class="mb-4 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required"
                                                         data-type="char" data-name="Field">
                                                        <label class="s_website_form_label fw-bold mb-2"
                                                               style="font-size:.9rem;color:var(--primary-dark)"
                                                               for="contact1">
                                                            <span class="s_website_form_label_content">Your Name</span>
                                                            <span class="s_website_form_mark text-danger">*</span>
                                                        </label>
                                                        <input id="contact1" type="text"
                                                               class="form-control s_website_form_input"
                                                               style="padding:12px 15px;border-radius:8px;border:1px solid #e2e8f0"
                                                               name="contact_name" required="" data-fill-with="name"/>
                                                    </div>
                                                    <div class="mb-4 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required"
                                                         data-type="email" data-name="Field">
                                                        <label class="s_website_form_label fw-bold mb-2"
                                                               style="font-size:.9rem;color:var(--primary-dark)"
                                                               for="contact3">
                                                            <span class="s_website_form_label_content">Email Address
                                                            </span>
                                                            <span class="s_website_form_mark text-danger">*</span>
                                                        </label>
                                                        <input id="contact3" type="email"
                                                               class="form-control s_website_form_input"
                                                               style="padding:12px 15px;border-radius:8px;border:1px solid #e2e8f0"
                                                               name="email_from" required="" data-fill-with="email"/>
                                                    </div>
                                                    <div class="mb-4 col-lg-6 s_website_form_field s_website_form_custom"
                                                         data-type="char" data-name="Field">
                                                        <label class="s_website_form_label fw-bold mb-2"
                                                               style="font-size:.9rem;color:var(--primary-dark)"
                                                               for="contact2">
                                                            <span class="s_website_form_label_content">Phone Number
                                                            </span>
                                                        </label>
                                                        <input id="contact2" type="tel"
                                                               class="form-control s_website_form_input"
                                                               style="padding:12px 15px;border-radius:8px;border:1px solid #e2e8f0"
                                                               name="phone" data-fill-with="phone"/>
                                                    </div>
                                                    <div class="mb-4 col-lg-6 s_website_form_field s_website_form_custom"
                                                         data-type="char" data-name="Field">
                                                        <label class="s_website_form_label fw-bold mb-2"
                                                               style="font-size:.9rem;color:var(--primary-dark)"
                                                               for="contact4">
                                                            <span class="s_website_form_label_content">Company /
                                                                School
                                                            </span>
                                                        </label>
                                                        <input id="contact4" type="text"
                                                               class="form-control s_website_form_input"
                                                               style="padding:12px 15px;border-radius:8px;border:1px solid #e2e8f0"
                                                               name="partner_name"
                                                               data-fill-with="commercial_company_name"/>
                                                    </div>
                                                    <div class="mb-4 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                                         data-type="char" data-name="Field">
                                                        <label class="s_website_form_label fw-bold mb-2"
                                                               style="font-size:.9rem;color:var(--primary-dark)"
                                                               for="contact5">
                                                            <span class="s_website_form_label_content">Subject</span>
                                                            <span class="s_website_form_mark text-danger">*</span>
                                                        </label>
                                                        <input id="contact5" type="text"
                                                               class="form-control s_website_form_input"
                                                               style="padding:12px 15px;border-radius:8px;border:1px solid #e2e8f0"
                                                               name="Application_Subject" required=""/>
                                                    </div>
                                                    <div class="mb-4 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                         data-type="text" data-name="Field">
                                                        <label class="s_website_form_label fw-bold mb-2"
                                                               style="font-size:.9rem;color:var(--primary-dark)"
                                                               for="contact6">
                                                            <span class="s_website_form_label_content">Your Message
                                                            </span>
                                                            <span class="s_website_form_mark text-danger">*</span>
                                                        </label>
                                                        <textarea id="contact6"
                                                                  class="form-control s_website_form_input"
                                                                  style="padding:15px;border-radius:8px;border:1px solid #e2e8f0"
                                                                  name="description" required="" rows="6"/>
                                                    </div>
                                                    <div class="mb-4 col-12 s_website_form_field s_website_form_dnone">
                                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                                            <label class="col-form-label col-sm-auto s_website_form_label"
                                                                   style="width: 200px" for="contact7">
                                                                <span class="s_website_form_label_content">Email To
                                                                </span>
                                                            </label>
                                                            <div class="col-sm">
                                                                <input id="contact7" type="hidden"
                                                                       class="form-control s_website_form_input"
                                                                       name="email_to"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="mb-4 col-12 s_website_form_field s_website_form_dnone">
                                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                                            <div class="col-sm">
                                                                <input type="hidden"
                                                                       class="form-control s_website_form_input"
                                                                       name="tag_ids"
                                                                       t-att-value="env.ref('theme_university.tag_university_app', raise_if_not_found=False) and env.ref('theme_university.tag_university_app').id or ''"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="mb-4 col-12 s_website_form_field s_website_form_dnone">
                                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                                            <div class="col-sm">
                                                                <input type="hidden"
                                                                       class="form-control s_website_form_input"
                                                                       name="name" value="University Application Lead"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-12 s_website_form_submit s_website_form_no_submit_label mt-2"
                                                         data-name="Submit Button">
                                                        <a href="#" role="button"
                                                           class="btn btn-primary s_website_form_send w-100 py-3 rounded-pill fw-semibold"
                                                           style="font-family:'Inter',sans-serif;font-size:1rem;background:var(--primary);border:none;box-shadow:0 10px 20px rgba(26,58,107,.15)">
                                                            Send Message
                                                        </a>
                                                        <span id="s_website_form_result"/>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
