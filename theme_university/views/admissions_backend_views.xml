<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Admission Round Views -->
    <record id="view_university_admission_round_tree" model="ir.ui.view">
        <field name="name">university.admission.round.tree</field>
        <field name="model">university.admission.round</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="deadline_date_str"/>
                <field name="decision_date_str"/>
                <field name="is_binding"/>
                <field name="notes"/>
            </list>
        </field>
    </record>
    <!-- Admission Round Action -->
    <record id="action_university_admission_round" model="ir.actions.act_window">
        <field name="name">Admission Rounds</field>
        <field name="res_model">university.admission.round</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Admission Requirement Views -->
    <record id="view_university_admission_requirement_tree" model="ir.ui.view">
        <field name="name">university.admission.requirement.tree</field>
        <field name="model">university.admission.requirement</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <!-- Admission Requirement Action -->
    <record id="action_university_admission_requirement" model="ir.actions.act_window">
        <field name="name">Admission Requirements</field>
        <field name="res_model">university.admission.requirement</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Application Type Views -->
    <record id="view_university_application_type_tree" model="ir.ui.view">
        <field name="name">university.application.type.tree</field>
        <field name="model">university.application.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="target_audience"/>
                <field name="application_fee"/>
                <field name="cta_text"/>
            </list>
        </field>
    </record>
    <!-- Application Type Form View -->
    <record id="view_university_application_type_form" model="ir.ui.view">
        <field name="name">university.application.type.form</field>
        <field name="model">university.application.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="target_audience"/>
                            <field name="application_fee"/>
                            <field name="cta_text"/>
                            <field name="cta_url"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="icon_class"/>
                            <field name="color_bg"/>
                            <field name="color_text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Requirements">
                            <field name="requirement_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Application Type Action -->
    <record id="action_university_application_type" model="ir.actions.act_window">
        <field name="name">Application Types</field>
        <field name="res_model">university.application.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- FAQ Views -->
    <record id="view_university_faq_tree" model="ir.ui.view">
        <field name="name">university.faq.tree</field>
        <field name="model">university.faq</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="question"/>
            </list>
        </field>
    </record>
    <!-- FAQ Form View -->
    <record id="view_university_faq_form" model="ir.ui.view">
        <field name="name">university.faq.form</field>
        <field name="model">university.faq</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="question"/>
                        <field name="sequence"/>
                    </group>
                    <label for="answer"/>
                    <field name="answer" widget="html"/>
                </sheet>
            </form>
        </field>
    </record>
    <!-- FAQ Action -->
    <record id="action_university_faq" model="ir.actions.act_window">
        <field name="name">FAQs</field>
        <field name="res_model">university.faq</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Backend Menus -->
    <menuitem id="menu_university_admissions_parent"
              name="Admissions Configuration"
              parent="website.menu_website_global_configuration"
              sequence="90"/>
    <menuitem id="menu_university_admission_round"
              name="Admission Rounds"
              parent="menu_university_admissions_parent"
              action="action_university_admission_round"
              sequence="10"/>
    <menuitem id="menu_university_admission_requirement"
              name="Admission Requirements"
              parent="menu_university_admissions_parent"
              action="action_university_admission_requirement"
              sequence="20"/>
    <menuitem id="menu_university_application_type"
              name="Application Types"
              parent="menu_university_admissions_parent"
              action="action_university_application_type"
              sequence="30"/>
    <menuitem id="menu_university_faq"
              name="Admissions FAQs"
              parent="menu_university_admissions_parent"
              action="action_university_faq"
              sequence="40"/>
</odoo>
