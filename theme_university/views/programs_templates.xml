<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Undergraduate Page Template -->
    <template id="university_undergraduate_page" name="Undergraduate Programs">
        <t t-call="website.layout">
            <t t-set="title">Undergraduate Programs — Axion University</t>
            <div id="wrap" class="oe_structure">
                <!-- INNER HERO -->
                <section class="inner-hero" data-snippet="theme_university.university_inner_hero"
                         data-name="Inner Hero">
                    <div class="inner-hero-bg"/>
                    <div class="inner-hero-shape inner-hero-shape-1"/>
                    <div class="inner-hero-shape inner-hero-shape-2"/>
                    <div class="container">
                        <div class="inner-hero-content">
                            <div class="inner-breadcrumb">
                                <a href="/">Home</a>
                                <span class="sep">
                                    <i class="bi bi-chevron-right"/>
                                </span>
                                <a href="/academics">Academics</a>
                                <span class="sep">
                                    <i class="bi bi-chevron-right"/>
                                </span>
                                <span class="current o_editable">Undergraduate Programs</span>
                            </div>
                            <div class="row g-4 align-items-center">
                                <div class="col-lg-8 reveal">
                                    <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                         style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:#f5c842">
                                        <i class="bi bi-book-fill"/>
                                        Bachelor's Degrees
                                    </div>
                                    <h1 class="inner-hero-title o_editable">Undergraduate Programs</h1>
                                    <p class="inner-hero-subtitle o_editable">200+ bachelor's degree programs across
                                        science, engineering, business, arts, and health — each designed to equip you
                                        with the skills, network, and mindset to lead in any field.
                                    </p>
                                    <div class="inner-hero-meta o_editable">
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-calendar3"/>
                                            4-Year Programs
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-people-fill"/>
                                            32,000 Undergrads
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-briefcase-fill"/>
                                            98% Employment
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-cash-coin"/>
                                            Aid Available
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 d-none d-lg-block reveal">
                                    <div class="info-box accent">
                                        <div style="font-size:1rem;font-weight:700;color:var(--primary-dark);margin-bottom:.5rem"
                                             class="o_editable">
                                            <i class="bi bi-calendar-check-fill me-1" style="color:var(--accent)"/>
                                            Fall 2026 Admissions
                                        </div>
                                        <div class="key-date-row" style="padding:.5rem 0">
                                            <div class="key-date-pill"
                                                 style="background:#e8f0fe;color:#1a3a6b;font-size:.8rem">Jan 15
                                            </div>
                                            <div class="key-date-title o_editable" style="font-size:.9rem">Early
                                                Decision Deadline
                                            </div>
                                        </div>
                                        <div class="key-date-row" style="padding:.5rem 0">
                                            <div class="key-date-pill"
                                                 style="background:#fce8e8;color:#c0392b;font-size:.8rem">Mar 1
                                            </div>
                                            <div class="key-date-title o_editable" style="font-size:.9rem">Regular
                                                Decision Deadline
                                            </div>
                                        </div>
                                        <a href="/apply" class="btn w-100 mt-2 rounded-pill fw-semibold"
                                           style="background:var(--primary);color:white;font-family:'Inter',sans-serif;font-size:.95rem;padding: 13px 0;">
                                            Start Your Application
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- MAIN CONTENT -->
                <section class="section-pad" id="programs">
                    <div class="container">
                        <div class="row g-5">
                            <!-- Sidebar -->
                            <div class="col-lg-3">
                                <div class="side-nav">
                                    <div class="side-nav-title">On This Page</div>
                                    <a href="#engineering" class="side-nav-link active">Engineering &amp; Tech</a>
                                    <a href="#science" class="side-nav-link">Science &amp; Math</a>
                                    <a href="#business" class="side-nav-link">Business</a>
                                    <a href="#arts" class="side-nav-link">Arts &amp; Humanities</a>
                                    <a href="#health" class="side-nav-link">Health Sciences</a>
                                    <a href="#requirements" class="side-nav-link">Requirements</a>
                                    <a href="#apply" class="side-nav-link">How to Apply</a>
                                </div>
                                <div class="info-box mt-3"
                                     style="background:var(--primary-dark);border-left-color:var(--accent)">
                                    <div style="font-size:.9rem;font-weight:700;margin-bottom:.4rem" class="o_editable">
                                        Need Help Choosing?
                                    </div>
                                    <p style="font-family:'Inter',sans-serif;font-size:.9rem;margin-bottom:.75rem;line-height:1.6"
                                       class="o_editable">Our academic advisors help you find the right program match.
                                    </p>
                                    <a href="#" class="btn w-100 rounded-pill fw-semibold"
                                       style="background:var(--accent);color:var(--primary-dark);font-family:'Inter',sans-serif;font-size:.8rem">
                                        Book a Session
                                    </a>
                                </div>
                            </div>
                            <!-- Program Listings -->
                            <div class="col-lg-9">
                                <!-- Engineering -->
                                <div id="engineering" class="mb-5 reveal">
                                    <div class="degree-section-title o_editable">
                                        School of Engineering &amp; Technology
                                    </div>
                                    <div class="degree-table">
                                        <div class="degree-row degree-row-header">
                                            <div>Program</div>
                                            <div>Degree</div>
                                            <div>Duration</div>
                                            <div>Seats</div>
                                        </div>
                                        <div class="degree-row">
                                            <div class="degree-name o_editable">
                                                <i class="bi bi-dot" style="color:#1a3a6b"/>
                                                Computer Science &amp; AI
                                            </div>
                                            <div>
                                                <span class="degree-type-badge"
                                                      style="background:#e8f0fe;color:#1a3a6b">B.S.
                                                </span>
                                            </div>
                                            <div class="degree-meta">4 Years</div>
                                            <div class="degree-meta">180 Seats</div>
                                        </div>
                                        <div class="degree-row">
                                            <div class="degree-name o_editable">
                                                <i class="bi bi-dot" style="color:#1a3a6b"/>
                                                Electrical Engineering
                                            </div>
                                            <div>
                                                <span class="degree-type-badge"
                                                      style="background:#e8f0fe;color:#1a3a6b">B.S.
                                                </span>
                                            </div>
                                            <div class="degree-meta">4 Years</div>
                                            <div class="degree-meta">120 Seats</div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Requirements -->
                                <div id="requirements" class="mb-5 reveal">
                                    <div class="section-eyebrow mb-2 o_editable">Admission</div>
                                    <h3 class="section-title mb-4 o_editable">Entry Requirements</h3>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="info-box h-100">
                                                <h6 style="margin-bottom:.6rem" class="o_editable">Academic</h6>
                                                <ul class="list-unstyled mb-0 o_editable"
                                                    style="font-family:'Inter',sans-serif;font-size:.95rem;line-height:2">
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        High school diploma or equivalent
                                                    </li>
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        Minimum GPA of 3.0 (4.0 scale)
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
    <!-- Online Learning Page Template -->
    <template id="university_online_page" name="Online Learning">
        <t t-call="website.layout">
            <t t-set="title">Online Learning — Axion University</t>
            <div id="wrap" class="oe_structure">
                <!-- INNER HERO -->
                <section class="inner-hero" data-snippet="theme_university.university_inner_hero"
                         data-name="Inner Hero">
                    <div class="inner-hero-bg"/>
                    <div class="inner-hero-shape inner-hero-shape-1"/>
                    <div class="inner-hero-shape inner-hero-shape-2"/>
                    <div class="container">
                        <div class="inner-hero-content">
                            <div class="inner-breadcrumb">
                                <a href="/">Home</a>
                                <span class="sep">
                                    <i class="bi bi-chevron-right"/>
                                </span>
                                <a href="/academics">Academics</a>
                                <span class="sep">
                                    <i class="bi bi-chevron-right"/>
                                </span>
                                <span class="current o_editable">Online Learning</span>
                            </div>
                            <div class="row g-4 align-items-center">
                                <div class="col-lg-7 reveal">
                                    <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                         style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:#f5c842">
                                        <i class="bi bi-laptop-fill"/>
                                        Learn From Anywhere
                                    </div>
                                    <h1 class="inner-hero-title o_editable">Online Learning at Axion</h1>
                                    <p class="inner-hero-subtitle o_editable">Full degrees, certificates, and
                                        professional short courses — entirely online. The same world-class faculty, the
                                        same accreditation, delivered flexibly so you can study from anywhere in the
                                        world.
                                    </p>
                                    <div class="inner-hero-meta o_editable">
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-collection-fill"/>
                                            60+ Online Programs
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-globe2"/>
                                            180+ Countries
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-clock-fill"/>
                                            Flexible Scheduling
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
    <!-- Page Records -->
    <record id="university_undergraduate_page_record" model="website.page">
        <field name="name">Undergraduate Programs</field>
        <field name="url">/academics/undergraduate</field>
        <field name="view_id" ref="university_undergraduate_page"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>
    <record id="university_online_page_record" model="website.page">
        <field name="name">Online Learning</field>
        <field name="url">/academics/online-learning</field>
        <field name="view_id" ref="university_online_page"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>
</odoo>
