<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact -->
    <record id="university_contact_page" model="theme.ir.ui.view">
        <field name="name">University Contact Page</field>
        <field name="key">theme_university.university_contact_page</field>
        <field name="arch" type="xml">
            <t t-name="theme_university.university_contact_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure">
                        <div id="oe_structure_theme_university_contact_1" class="oe_structure oe_empty"/>
                        <section class="inner-hero">
                            <div class="inner-hero-bg"/>
                            <div class="inner-hero-shape inner-hero-shape-1"/>
                            <div class="inner-hero-shape inner-hero-shape-2"/>
                            <div class="container">
                                <div class="inner-hero-content">
                                    <div class="inner-breadcrumb o_editable">
                                        <a href="/">Home</a>
                                        <span class="sep">
                                            <i class="bi bi-chevron-right"/>
                                        </span>
                                        <span class="current">Contact</span>
                                    </div>
                                    <div class="row g-4 align-items-center">
                                        <div class="col-lg-7 reveal">
                                            <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                                 style="background:rgba(var(--accent-rgb),.15);border-color:rgba(var(--accent-rgb),.3);color:var(--accent-light)">
                                                <i class="bi bi-chat-dots-fill me-1"/>
                                                Admissions &amp; Support
                                            </div>
                                            <h1 class="inner-hero-title o_editable">Get in Touch with Axion</h1>
                                            <p class="inner-hero-subtitle o_editable">Questions about admissions, campus
                                                tours, or program options? Use the form below or contact the right team
                                                directly. We respond during business hours, Monday through Friday.
                                            </p>
                                            <div class="inner-hero-meta o_editable">
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-telephone-fill"/>
                                                    +1 (800) 123-4567
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-envelope-fill"/>
                                                    admissions@axion.edu
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-geo-alt-fill"/>
                                                    1 University Drive, Axion, CA
                                                </div>
                                                <div class="inner-hero-meta-item">
                                                    <i class="bi bi-clock-fill"/>
                                                    Mon-Fri 9 AM - 5 PM
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-5 d-none d-lg-block reveal reveal-delay-2">
                                            <div class="row g-3">
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">24h</div>
                                                        <div class="highlight-label">Typical Reply Time</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">4</div>
                                                        <div class="highlight-label">Admissions Teams</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">130+</div>
                                                        <div class="highlight-label">Countries Served</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="highlight-card o_editable">
                                                        <div class="highlight-num">7</div>
                                                        <div class="highlight-label">Days / Week Chat</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <div id="oe_structure_theme_university_contact_2" class="oe_structure oe_empty"/>
                        <section class="section-pad">
                            <div class="container">
                                <div class="row g-5">
                                    <div class="col-lg-5 reveal">
                                        <div class="section-eyebrow mb-2 o_editable">Direct Contacts</div>
                                        <h2 class="section-title o_editable">Reach Out Directly</h2>
                                        <p class="text-muted mb-4 o_editable"
                                           style="font-family:'Inter',sans-serif;line-height:1.8">Choose the team that
                                            matches your question. If you're not sure where to start, send one message
                                            and we'll route it internally.
                                        </p>
                                        <div class="info-box mb-3 o_editable">
                                            <h6 class="fw-bold mb-2" style="color:var(--primary-dark)">
                                                <i class="bi bi-geo-alt-fill me-1" style="color:var(--primary)"/>
                                                Campus Location
                                            </h6>
                                            <p class="mb-0" style="font-family:'Inter',sans-serif;line-height:1.8">1
                                                University Drive, Axion, CA 90210
                                            </p>
                                        </div>
                                        <div class="info-box mb-3 o_editable">
                                            <h6 class="fw-bold mb-2" style="color:var(--primary-dark)">
                                                <i class="bi bi-telephone-fill me-1" style="color:var(--primary)"/>
                                                Call Admissions
                                            </h6>
                                            <p class="mb-0" style="font-family:'Inter',sans-serif;line-height:1.8">+1
                                                (800) 123-4567
                                            </p>
                                        </div>
                                        <div class="info-box mb-3 o_editable">
                                            <h6 class="fw-bold mb-2" style="color:var(--primary-dark)">
                                                <i class="bi bi-envelope-fill me-1" style="color:var(--primary)"/>
                                                Email Inquiry
                                            </h6>
                                            <p class="mb-0" style="font-family:'Inter',sans-serif;line-height:1.8">
                                                admissions@axion.edu
                                            </p>
                                        </div>
                                        <div class="info-box accent o_editable">
                                            <h6 class="fw-bold mb-2" style="color:var(--primary-dark)">
                                                <i class="bi bi-clock-fill me-1" style="color:var(--accent)"/>
                                                Office Hours
                                            </h6>
                                            <p class="mb-0" style="font-family:'Inter',sans-serif;line-height:1.8">
                                                Monday to Friday, 9:00 AM to 5:00 PM PST. Campus tours are available by
                                                appointment.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-lg-7 reveal reveal-delay-1">
                                        <div class="section-eyebrow mb-2 o_editable">Send a Message</div>
                                        <h2 class="section-title o_editable">Contact Form</h2>
                                        <div class="s_website_form info-box theme-contact-form" data-vcss="001"
                                             data-snippet="s_website_form">
                                            <form action="/website/form/" method="post" enctype="multipart/form-data"
                                                  class="o_mark_required" data-mark="*" data-model_name="mail.mail">
                                                <input type="hidden" name="csrf_token"
                                                       t-att-value="request.csrf_token()"/>
                                                <div class="row g-3">
                                                    <div class="col-md-6 s_website_form_field s_website_form_required"
                                                         data-type="char" data-name="Field">
                                                        <label class="s_website_form_label fw-semibold"
                                                               for="u_contact_name">Full Name
                                                        </label>
                                                        <input id="u_contact_name" type="text"
                                                               class="form-control s_website_form_input rounded-3"
                                                               name="name" required="" data-fill-with="name"/>
                                                    </div>
                                                    <div class="col-md-6 s_website_form_field s_website_form_required"
                                                         data-type="email" data-name="Field">
                                                        <label class="s_website_form_label fw-semibold"
                                                               for="u_contact_email">Email Address
                                                        </label>
                                                        <input id="u_contact_email" type="email"
                                                               class="form-control s_website_form_input rounded-3"
                                                               name="email_from" required="" data-fill-with="email"/>
                                                    </div>
                                                    <div class="col-md-12 s_website_form_field" data-type="char"
                                                         data-name="Field">
                                                        <label class="s_website_form_label fw-semibold"
                                                               for="u_contact_subject">Subject
                                                        </label>
                                                        <input id="u_contact_subject" type="text"
                                                               class="form-control s_website_form_input rounded-3"
                                                               name="subject"/>
                                                    </div>
                                                    <div class="col-md-12 s_website_form_field s_website_form_required"
                                                         data-type="text" data-name="Field">
                                                        <label class="s_website_form_label fw-semibold"
                                                               for="u_contact_desc">Message
                                                        </label>
                                                        <textarea id="u_contact_desc"
                                                                  class="form-control s_website_form_input rounded-3"
                                                                  rows="5" name="description" required=""/>
                                                    </div>
                                                    <div class="col-md-12 s_website_form_field s_website_form_dnone">
                                                        <input type="hidden" class="s_website_form_input"
                                                               name="email_to" value="info@yourcompany.example.com"/>
                                                    </div>
                                                    <div class="col-md-12 s_website_form_submit"
                                                         data-name="Submit Button">
                                                        <a href="#" role="button"
                                                           class="btn theme-form-submit px-4 py-2 rounded-pill s_website_form_send">
                                                            <span>Send Message</span>
                                                        </a>
                                                        <span id="s_website_form_result"/>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <div id="oe_structure_theme_university_contact_3" class="oe_structure oe_empty"/>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <!-- Contact Page Link -->
    <record id="university_contact_page_link" model="theme.website.page">
        <field name="url">/contactus</field>
        <field name="view_id" ref="university_contact_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>
