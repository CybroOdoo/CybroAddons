<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Events Page -->
    <template id="university_events_index_hero" inherit_id="website_event.index" priority="20">
        <xpath expr="//t[@t-call='website_event.index_topbar']" position="before">
            <section class="inner-hero s_inner_page_hero theme-event-hero" data-name="Events Hero">
                <div class="inner-hero-bg"/>
                <div class="inner-hero-shape inner-hero-shape-1"/>
                <div class="inner-hero-shape inner-hero-shape-2"/>
                <div class="container">
                    <div class="inner-hero-content">
                        <div class="inner-breadcrumb">
                            <a href="/">Home</a>
                            <span class="sep">
                                <i class="bi bi-chevron-right"/>
                            </span>
                            <span class="current">Events</span>
                        </div>
                        <div class="row g-4 align-items-center">
                            <div class="col-lg-7 reveal">
                                <div class="section-eyebrow d-inline-flex mb-3"
                                     style="background:rgba(var(--accent-rgb),.15);border-color:rgba(var(--accent-rgb),.3);color:var(--accent-light)">
                                    <i class="bi bi-calendar-event-fill me-1"/>
                                    Native Odoo Events
                                </div>
                                <h1 class="inner-hero-title">Campus Events &amp; Calendar</h1>
                                <p class="inner-hero-subtitle">
                                    This page uses Odoo's native `/event` route and event records, with the university
                                    theme layered on top so the layout, colors, and cards stay consistent with the rest
                                    of the website.
                                </p>
                                <div class="inner-hero-meta">
                                    <div class="inner-hero-meta-item">
                                        <i class="bi bi-calendar3"/>
                                        Native event listings
                                    </div>
                                    <div class="inner-hero-meta-item">
                                        <i class="bi bi-funnel-fill"/>
                                        Standard filters and search
                                    </div>
                                    <div class="inner-hero-meta-item">
                                        <i class="bi bi-person-check-fill"/>
                                        Registration aware
                                    </div>
                                    <div class="inner-hero-meta-item">
                                        <i class="bi bi-globe2"/>
                                        Odoo event detail routes
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5 d-none d-lg-block reveal reveal-delay-2">
                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="highlight-card">
                                            <div class="highlight-num">/event</div>
                                            <div class="highlight-label">Native Route</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="highlight-card">
                                            <div class="highlight-num">100%</div>
                                            <div class="highlight-label">Native Data</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="highlight-card">
                                            <div class="highlight-num">Theme</div>
                                            <div class="highlight-label">Visual System</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="highlight-card">
                                            <div class="highlight-num">Odoo</div>
                                            <div class="highlight-label">Standard Features</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
    <!-- Events Page Topbar -->
    <template id="university_events_index_topbar" inherit_id="website_event.index_topbar" priority="20">
        <xpath expr="//div[hasclass('container') and hasclass('mt-3') and hasclass('mb-4')]" position="attributes">
            <attribute name="class">container mt-4 mb-5</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_wevent_index_topbar_filters')]" position="attributes">
            <attribute name="class">o_wevent_index_topbar_filters d-flex d-print-none align-items-center
                justify-content-end flex-wrap gap-2 w-100 theme-event-filters
            </attribute>
        </xpath>
        <xpath expr="//h2[hasclass('h4')]" position="replace">
            <div class="d-flex flex-column me-auto pe-sm-4">
                <div class="section-eyebrow mb-1">Campus Calendar</div>
                <h2 class="h4 my-0" style="color:var(--primary-dark)">Upcoming Events</h2>
            </div>
        </xpath>
    </template>
    <!-- Events List -->
    <template id="university_events_list" inherit_id="website_event.events_list" priority="20">
        <xpath expr="//article" position="replace">
            <article t-attf-class="h-100 event-card #{opt_events_list_cards and 'card'}" itemscope="itemscope"
                     itemtype="http://schema.org/Event">
                <div class="event-stripe" style="background:linear-gradient(90deg,var(--primary),var(--accent-light))"/>
                <div class="h-100 d-flex flex-column">
                    <header class="position-relative overflow-hidden"
                            style="min-height:220px;background:linear-gradient(135deg,var(--primary-dark),var(--primary))">
                        <t t-call="website.record_cover">
                            <t t-set="_record" t-value="event"/>
                            <meta itemprop="startDate" t-att-content="event.date_begin.isoformat()"/>
                            <div class="position-absolute top-0 start-0 end-0 bottom-0 p-4 d-flex align-items-end">
                                <div class="d-flex align-items-end gap-3 w-100">
                                    <div class="event-date-box shadow-sm"
                                         style="background:rgba(var(--accent-rgb),.14);color:var(--accent-light)">
                                        <span t-out="event.date_begin"
                                              t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'dd'}"
                                              class="event-day"/>
                                        <span t-out="event.date_begin"
                                              t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'MMM'}"
                                              class="event-mon"/>
                                    </div>
                                    <div class="text-white flex-grow-1">
                                        <span t-if="event.event_type_id" class="event-type-badge d-inline-flex"
                                              style="background:rgba(255,255,255,.14);color:#fff">
                                            <t t-out="event.event_type_id.sudo().name"/>
                                        </span>
                                        <small class="d-block mt-2 opacity-75" itemprop="description"
                                               t-out="event.subtitle"/>
                                    </div>
                                </div>
                            </div>
                            <small t-if="not event.event_registrations_open"
                                   class="position-absolute bottom-0 px-3 py-2 w-100 text-bg-light">
                                <t t-if="not event.event_registrations_started">
                                    Registrations not yet open
                                </t>
                                <t t-elif="event.event_registrations_sold_out">
                                    Sold Out
                                </t>
                                <t t-else="">
                                    Registrations Closed
                                </t>
                            </small>
                            <small t-if="event.is_participating"
                                   class="o_wevent_participating position-absolute bottom-0 px-3 py-2 w-100 text-bg-success">
                                <i class="fa fa-check me-2"/>Registered
                            </small>
                            <small t-if="not event.website_published"
                                   class="o_wevent_unpublished position-absolute bottom-0 px-3 py-2 w-100 text-bg-danger">
                                <i class="fa fa-ban me-2"/>Unpublished
                            </small>
                        </t>
                    </header>
                    <main t-attf-class="card-body position-relative d-flex flex-column gap-3 p-4 #{not opt_events_list_cards and 'bg-transparent'}"
                          style="color:var(--text)">
                        <div class="d-flex flex-wrap gap-1 small">
                            <t t-foreach="event.tag_ids.filtered(lambda tag: tag.category_id.website_id == website or not tag.category_id.website_id)"
                               t-as="tag">
                                <span t-if="tag.color" class="badge rounded-pill"
                                      style="background:rgba(var(--primary-rgb),.10);color:var(--primary)">
                                    <t t-out="tag.name"/>
                                </span>
                            </t>
                        </div>
                        <h5 t-attf-class="card-title my-0 #{(not event.website_published) and 'text-danger'}">
                            <span t-field="event.name" itemprop="name"/>
                        </h5>
                        <small class="opacity-75" itemprop="description" t-field="event.subtitle"/>
                        <t t-set="has_city_or_country"
                           t-value="event.address_id.sudo().city or event.address_id.sudo().country_id"/>
                        <div t-if="not event.address_id or has_city_or_country" class="d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill" style="color:var(--primary)"/>
                            <small t-if="event.address_id" class="fw-semibold" itemprop="location"
                                   t-out="event.address_id"
                                   t-options="{'widget': 'contact', 'fields': ['city'], 'no_marker': 'true'}"/>
                            <small t-else="" class="fw-semibold" itemprop="location">Online event</small>
                        </div>
                        <div class="mt-auto d-flex align-items-center justify-content-between gap-3 pt-2">
                            <small class="text-muted" style="font-family:'Inter',sans-serif">
                                <i class="bi bi-clock me-1"/>
                                <span t-out="event.date_begin"
                                      t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'LT'}"/>
                            </small>
                            <span class="fw-semibold" style="color:var(--primary)">
                                View event
                                <i class="bi bi-arrow-right"/>
                            </span>
                        </div>
                    </main>
                </div>
            </article>
        </xpath>
    </template>
</odoo>
