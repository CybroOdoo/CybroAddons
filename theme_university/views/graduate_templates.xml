<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Displays the Graduate Programs page with master's, PhD, funding, admissions, and application information. -->
    <template id="university_graduate_page" name="Graduate Programs">
        <t t-call="website.layout">
            <t t-set="title">Graduate Programs — Axion University</t>
            <div id="wrap" class="oe_structure">
                <!-- INNER HERO -->
                <section class="inner-hero" data-snippet="theme_university.university_inner_hero"
                         data-name="Inner Hero">
                    <div class="inner-hero-bg"/>
                    <div class="inner-hero-shape inner-hero-shape-1"/>
                    <div class="inner-hero-shape inner-hero-shape-2"/>
                    <div class="container">
                        <div class="inner-hero-content">
                            <div class="inner-breadcrumb">
                                <a href="/">Home</a>
                                <span class="sep">
                                    <i class="bi bi-chevron-right"/>
                                </span>
                                <a href="/academics">Academics</a>
                                <span class="sep">
                                    <i class="bi bi-chevron-right"/>
                                </span>
                                <span class="current o_editable">Graduate Programs</span>
                            </div>
                            <div class="row g-4 align-items-center">
                                <div class="col-lg-8 reveal">
                                    <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                         style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:#f5c842">
                                        <i class="bi bi-award-fill"/>
                                        Masters &amp; Doctoral
                                    </div>
                                    <h1 class="inner-hero-title o_editable">Graduate &amp; PhD Programs</h1>
                                    <p class="inner-hero-subtitle o_editable">80+ master's degrees and 40+ doctoral
                                        programs. Fully funded research positions, industry fellowships, and access to
                                        $400M in annual research funding — designed for scholars who want to push the
                                        boundaries of knowledge.
                                    </p>
                                    <div class="inner-hero-meta o_editable">
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-mortarboard-fill"/>
                                            120+ Programs
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-people-fill"/>
                                            16,000 Grad Students
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-currency-dollar"/>
                                            Funded Positions
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-journals"/>
                                            12,000+ Publications/yr
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 d-none d-lg-block reveal">
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="highlight-card">
                                                <div class="highlight-num">80+</div>
                                                <div class="highlight-label o_editable">Master's Programs</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="highlight-card">
                                                <div class="highlight-num">40+</div>
                                                <div class="highlight-label o_editable">PhD Programs</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="highlight-card">
                                                <div class="highlight-num">$28K</div>
                                                <div class="highlight-label o_editable">Avg Stipend / Year</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="highlight-card">
                                                <div class="highlight-num">95%</div>
                                                <div class="highlight-label o_editable">PhD Placement Rate</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- MASTERS -->
                <section class="section-pad" id="masters">
                    <div class="container">
                        <div class="row g-5">
                            <div class="col-lg-3">
                                <div class="side-nav">
                                    <div class="side-nav-title">On This Page</div>
                                    <a href="#masters" class="side-nav-link active">Master's Degrees</a>
                                    <a href="#phd" class="side-nav-link">PhD Programs</a>
                                    <a href="#funding" class="side-nav-link">Funding &amp; Aid</a>
                                    <a href="#requirements" class="side-nav-link">Requirements</a>
                                    <a href="#apply-grad" class="side-nav-link">How to Apply</a>
                                </div>
                                <div class="info-box mt-3"
                                     style="background:var(--primary-dark);border-left-color:var(--accent)">
                                    <div style="font-size:.9rem;font-weight:700;margin-bottom:.4rem" class="o_editable">
                                        <i class="bi bi-chat-dots-fill me-1"/>
                                        Talk to a Grad Advisor
                                    </div>
                                    <p style="font-family:'Inter',sans-serif;font-size:.9rem;margin-bottom:.75rem;line-height:1.6"
                                       class="o_editable">Schedule a 30-minute consultation with a program coordinator.
                                    </p>
                                    <a href="#" class="btn w-100 rounded-pill fw-semibold"
                                       style="background:var(--accent);color:var(--primary-dark);font-family:'Inter',sans-serif;font-size:.8rem">
                                        Book a Call
                                    </a>
                                </div>
                            </div>
                            <div class="col-lg-9">
                                <!-- Masters listing -->
                                <div class="mb-2 reveal">
                                    <div class="section-eyebrow mb-1 o_editable">Master's Degrees</div>
                                    <h3 class="section-title mb-4 o_editable">M.S. &amp; MBA Programs</h3>
                                </div>
                                <div class="row g-3 mb-5">
                                    <!-- Masters cards -->
                                    <div class="col-md-6 reveal">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#e8f0fe">
                                                <i class="bi bi-cpu" style="color:#1a3a6b"/>
                                            </div>
                                            <div class="program-category-pill pill-stem">STEM</div>
                                            <h5 class="fw-bold mb-2 o_editable">M.S. Computer Science</h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">Specializations
                                                in AI, machine learning, cybersecurity, and distributed systems.
                                                Industry-collaborative thesis options available.
                                            </p>
                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">2
                                                    Years
                                                </span>
                                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">
                                                    Thesis / Non-Thesis
                                                </span>
                                                <span class="program-tag" style="background:#f3e8ff;color:#6f42c1">
                                                    Spring &amp; Fall Entry
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 reveal">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#e8f0fe">
                                                <i class="bi bi-bar-chart-fill" style="color:#1a3a6b"/>
                                            </div>
                                            <div class="program-category-pill pill-stem">STEM</div>
                                            <h5 class="fw-bold mb-2 o_editable">M.S. Data Science</h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">Advanced
                                                statistics, machine learning, and data engineering. Capstone project
                                                with a partner company in your final semester.
                                            </p>
                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">1.5
                                                    Years
                                                </span>
                                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">
                                                    Industry Track
                                                </span>
                                                <span class="program-tag" style="background:#f3e8ff;color:#6f42c1">Fall
                                                    Entry
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 reveal">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#fff8e1">
                                                <i class="bi bi-graph-up-arrow" style="color:#b45309"/>
                                            </div>
                                            <div class="program-category-pill pill-business">Business</div>
                                            <h5 class="fw-bold mb-2 o_editable">Master of Business Administration
                                                (MBA)
                                            </h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">Full-time,
                                                part-time, and executive tracks. AACSB-accredited. Dual-degree options
                                                with Law and Engineering available.
                                            </p>
                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                <span class="program-tag" style="background:#fff8e1;color:#b45309">2
                                                    Years
                                                </span>
                                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">Full
                                                    / Part-time
                                                </span>
                                                <span class="program-tag" style="background:#f3e8ff;color:#6f42c1">
                                                    AACSB
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 reveal">
                                        <div class="program-card card h-100 p-4">
                                            <div class="program-icon-wrap" style="background:#fce8e8">
                                                <i class="bi bi-hospital" style="color:#c0392b"/>
                                            </div>
                                            <div class="program-category-pill pill-health">Health Sciences</div>
                                            <h5 class="fw-bold mb-2 o_editable">M.P.H. Public Health</h5>
                                            <p class="text-muted small mb-3 o_editable"
                                               style="font-family:'Inter',sans-serif;line-height:1.65">Epidemiology,
                                                health policy, global health, and biostatistics. Includes a 300-hour
                                                field placement at a global health organization.
                                            </p>
                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                <span class="program-tag" style="background:#fce8e8;color:#c0392b">2
                                                    Years
                                                </span>
                                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">300hr
                                                    Placement
                                                </span>
                                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">WHO
                                                    Recognized
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- PhD Section -->
                                <div id="phd" class="mb-5 reveal">
                                    <div class="section-eyebrow mb-1 o_editable">Doctoral</div>
                                    <h3 class="section-title mb-4 o_editable">PhD Programs</h3>
                                    <div class="degree-table">
                                        <div class="degree-row degree-row-header">
                                            <div>Program</div>
                                            <div>Degree</div>
                                            <div>Duration</div>
                                            <div>Funding</div>
                                        </div>
                                        <div class="degree-row">
                                            <div class="degree-name o_editable">
                                                <i class="bi bi-dot" style="color:#1a3a6b"/>
                                                Artificial Intelligence &amp; Machine Learning
                                            </div>
                                            <div>
                                                <span class="degree-type-badge"
                                                      style="background:#e8f0fe;color:#1a3a6b">Ph.D.
                                                </span>
                                            </div>
                                            <div class="degree-meta">4–5 Yrs</div>
                                            <div>
                                                <span class="degree-type-badge"
                                                      style="background:#e6f4ea;color:#1a7a4a">Fully Funded
                                                </span>
                                            </div>
                                        </div>
                                        <div class="degree-row">
                                            <div class="degree-name o_editable">
                                                <i class="bi bi-dot" style="color:#6f42c1"/>
                                                Computational Chemistry
                                            </div>
                                            <div>
                                                <span class="degree-type-badge"
                                                      style="background:#f3e8ff;color:#6f42c1">Ph.D.
                                                </span>
                                            </div>
                                            <div class="degree-meta">4–5 Yrs</div>
                                            <div>
                                                <span class="degree-type-badge"
                                                      style="background:#e6f4ea;color:#1a7a4a">Fully Funded
                                                </span>
                                            </div>
                                        </div>
                                        <div class="degree-row">
                                            <div class="degree-name o_editable">
                                                <i class="bi bi-dot" style="color:#b45309"/>
                                                Economics &amp; Public Policy
                                            </div>
                                            <div>
                                                <span class="degree-type-badge"
                                                      style="background:#fff8e1;color:#b45309">Ph.D.
                                                </span>
                                            </div>
                                            <div class="degree-meta">4–6 Yrs</div>
                                            <div>
                                                <span class="degree-type-badge"
                                                      style="background:#e6f4ea;color:#1a7a4a">Fully Funded
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Funding -->
                                <div id="funding" class="mb-5 reveal">
                                    <div class="section-eyebrow mb-1 o_editable">Financial Support</div>
                                    <h3 class="section-title mb-4 o_editable">Funding &amp; Assistantships</h3>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="highlight-card text-center">
                                                <i class="bi bi-cash-stack fs-2 mb-2" style="color:var(--accent)"/>
                                                <div class="highlight-num">$28K</div>
                                                <div class="highlight-label o_editable">Average Annual PhD Stipend</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="highlight-card text-center">
                                                <i class="bi bi-hospital fs-2 mb-2" style="color:#1a7a4a"/>
                                                <div class="highlight-num">Full</div>
                                                <div class="highlight-label o_editable">Health Insurance Coverage</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="highlight-card text-center">
                                                <i class="bi bi-building fs-2 mb-2" style="color:#0277bd"/>
                                                <div class="highlight-num">100%</div>
                                                <div class="highlight-label o_editable">Tuition Waiver for PhD</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Requirements -->
                                <div id="requirements" class="mb-5 reveal">
                                    <div class="section-eyebrow mb-1 o_editable">Admission</div>
                                    <h3 class="section-title mb-4 o_editable">Graduate Entry Requirements</h3>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="info-box h-100">
                                                <h6 style="margin-bottom:.6rem" class="o_editable">Master's
                                                    Requirements
                                                </h6>
                                                <ul class="list-unstyled mb-0 o_editable"
                                                    style="font-family:'Inter',sans-serif;font-size:.95rem;line-height:2">
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        Bachelor's degree with min. 3.0 GPA
                                                    </li>
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        GRE / GMAT (program-specific)
                                                    </li>
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        2 letters of recommendation
                                                    </li>
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        Statement of purpose (750 words)
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-box h-100">
                                                <h6 style="margin-bottom:.6rem" class="o_editable">PhD Requirements</h6>
                                                <ul class="list-unstyled mb-0 o_editable"
                                                    style="font-family:'Inter',sans-serif;font-size:.95rem;line-height:2">
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        Bachelor's or Master's with 3.5+ GPA
                                                    </li>
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        Research writing sample
                                                    </li>
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        3 letters of recommendation
                                                    </li>
                                                    <li>
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#1a7a4a"/>
                                                        Research proposal (1,000 words)
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Apply -->
                                <div id="apply-grad" class="reveal">
                                    <div class="section-eyebrow mb-1 o_editable">Process</div>
                                    <h3 class="section-title mb-4 o_editable">Graduate Application Steps</h3>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="app-step">
                                            <div class="app-step-num">1</div>
                                            <div class="app-step-body">
                                                <h6 class="o_editable">Identify a Faculty Supervisor (PhD only)</h6>
                                                <p class="o_editable">Browse faculty research profiles and reach out to
                                                    a potential supervisor whose work aligns with your interests before
                                                    applying.
                                                </p>
                                            </div>
                                        </div>
                                        <div class="app-step-connector"/>
                                        <div class="app-step">
                                            <div class="app-step-num">2</div>
                                            <div class="app-step-body">
                                                <h6 class="o_editable">Submit Online Application</h6>
                                                <p class="o_editable">Complete the Graduate Application at
                                                    apply.Axion.edu/graduate. Choose up to two programs.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
    <!-- Creates and publishes the Graduate Programs website page at /academics/graduate using the university_graduate_page template. -->
    <record id="university_graduate_page_record" model="website.page">
        <field name="name">Graduate Programs</field>
        <field name="url">/academics/graduate</field>
        <field name="view_id" ref="university_graduate_page"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>
</odoo>
