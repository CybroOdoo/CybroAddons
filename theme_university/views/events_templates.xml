<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Events page template displaying featured events, dynamic event listings, campus venues, and a call-to-action section. -->
    <template id="university_events_page" name="Events">
        <t t-call="website.layout">
            <t t-set="title">Events — Axion University</t>
            <div id="wrap" class="oe_structure">
                <!-- HERO -->
                <section class="inner-hero">
                    <div class="inner-hero-bg"/>
                    <div class="inner-hero-shape inner-hero-shape-1"/>
                    <div class="inner-hero-shape inner-hero-shape-2"/>
                    <div class="container">
                        <div class="inner-hero-content">
                            <div class="inner-breadcrumb">
                                <a href="/">Home</a>
                                <span class="sep">
                                    <i class="bi bi-chevron-right"/>
                                </span>
                                <span class="current o_editable">Events</span>
                            </div>
                            <div class="row g-4 align-items-center">
                                <div class="col-lg-7 reveal">
                                    <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                         style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:#f5c842">
                                        <i class="bi bi-calendar-event-fill"/>
                                        Upcoming at Axion
                                    </div>
                                    <h1 class="inner-hero-title o_editable">Events &amp; Campus Calendar</h1>
                                    <p class="inner-hero-subtitle o_editable">From Nobel lectures and startup pitch
                                        nights to cultural festivals and sports championships — something remarkable is
                                        always happening at Axion University.
                                    </p>
                                    <div class="inner-hero-meta o_editable">
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-calendar3"/>
                                            200+ Events / Year
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-geo-alt-fill"/>
                                            12 Campus Venues
                                        </div>
                                        <div class="inner-hero-meta-item">
                                            <i class="bi bi-people-fill"/>
                                            Open to All Students
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-5 d-none d-lg-block reveal reveal-delay-2">
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="highlight-card">
                                                <div class="highlight-num">200+</div>
                                                <div class="highlight-label o_editable">Annual Events</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="highlight-card">
                                                <div class="highlight-num">12</div>
                                                <div class="highlight-label o_editable">Major Venues</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="highlight-card">
                                                <div class="highlight-num">15K+</div>
                                                <div class="highlight-label o_editable">Annual Attendees</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="highlight-card">
                                                <div class="highlight-num">92%</div>
                                                <div class="highlight-label o_editable">Student Engagement</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- FEATURED EVENTS -->
                <section class="section-pad" style="background:var(--bg-light)">
                    <div class="container">
                        <div class="text-center mb-5 reveal">
                            <div class="section-eyebrow o_editable">Don't Miss These</div>
                            <h2 class="section-title o_editable">Featured Events</h2>
                            <p class="section-subtitle o_editable">Highlighted events from across campus this month —
                                mark your calendar.
                            </p>
                        </div>
                        <div class="row g-4">
                            <!-- Big feature card -->
                            <div class="col-lg-6 reveal">
                                <div class="event-card h-100">
                                    <div style="height:220px;background:linear-gradient(135deg,#0f2347,#1a3a6b);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden">
                                        <div class="text-center text-white position-relative" style="z-index:1">
                                            <i class="bi bi-mortarboard-fill"
                                               style="font-size:3.5rem;color:var(--accent-light)"/>
                                            <div style="font-family:'Inter',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;opacity:.7;margin-top:.5rem"
                                                 class="o_editable">Signature Event
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-4 flex-grow-1 d-flex flex-column">
                                        <div class="d-flex align-items-start gap-3 mb-3">
                                            <div class="event-date-box" style="background:#e8f0fe;color:#1a3a6b">
                                                <span class="event-day">14</span>
                                                <span class="event-mon">Jun</span>
                                            </div>
                                            <div>
                                                <span class="event-type-badge" style="background:#e8f0fe;color:#1a3a6b">
                                                    Academic
                                                </span>
                                                <h5 class="fw-bold mt-1 mb-1 o_editable" style="font-size:1.1rem">2025
                                                    Commencement Ceremony
                                                </h5>
                                                <div style="font-family:'Inter',sans-serif;font-size:.82rem;color:var(--text-muted)"
                                                     class="o_editable"><i class="bi bi-clock me-1"/>10:00 AM |<i
                                                        class="bi bi-geo-alt me-1"/>Axion Stadium
                                                </div>
                                            </div>
                                        </div>
                                        <p class="text-muted mb-3 o_editable"
                                           style="font-family:'Inter',sans-serif;font-size:.88rem;line-height:1.7">Join
                                            8,000+ graduates, families, and friends as the Class of 2025 celebrates
                                            their achievements.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <!-- Right two smaller featured cards -->
                            <div class="col-lg-6">
                                <div class="d-flex flex-column gap-4 h-100">
                                    <div class="event-card reveal reveal-delay-1">
                                        <div class="p-4">
                                            <div class="d-flex align-items-start gap-3">
                                                <div class="event-date-box" style="background:#fff8e1;color:#b45309">
                                                    <span class="event-day">20</span>
                                                    <span class="event-mon">Jun</span>
                                                </div>
                                                <div>
                                                    <span class="event-type-badge"
                                                          style="background:#fff8e1;color:#b45309">Innovation
                                                    </span>
                                                    <h5 class="fw-bold mt-1 mb-1 o_editable" style="font-size:1rem">
                                                        Axion Startup Pitch Night 2025
                                                    </h5>
                                                    <div style="font-family:'Inter',sans-serif;font-size:.82rem;color:var(--text-muted)"
                                                         class="o_editable"><i class="bi bi-clock me-1"/>6:30 PM |<i
                                                            class="bi bi-geo-alt me-1"/>Innovation Hub
                                                    </div>
                                                </div>
                                            </div>
                                            <p class="text-muted mt-2 mb-0 o_editable"
                                               style="font-family:'Inter',sans-serif;font-size:.88rem;line-height:1.7">
                                                Watch student founders pitch their ventures to Silicon Valley VCs for
                                                $100K in seed funding.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="event-card reveal reveal-delay-2">
                                        <div class="p-4">
                                            <div class="d-flex align-items-start gap-3">
                                                <div class="event-date-box" style="background:#e6f4ea;color:#1a7a4a">
                                                    <span class="event-day">25</span>
                                                    <span class="event-mon">Jun</span>
                                                </div>
                                                <div>
                                                    <span class="event-type-badge"
                                                          style="background:#e6f4ea;color:#1a7a4a">Science
                                                    </span>
                                                    <h5 class="fw-bold mt-1 mb-1 o_editable" style="font-size:1rem">
                                                        Global Climate Solutions Symposium
                                                    </h5>
                                                    <div style="font-family:'Inter',sans-serif;font-size:.82rem;color:var(--text-muted)"
                                                         class="o_editable"><i class="bi bi-clock me-1"/>9:00 AM |<i
                                                            class="bi bi-geo-alt me-1"/>Science Auditorium
                                                    </div>
                                                </div>
                                            </div>
                                            <p class="text-muted mt-2 mb-0 o_editable"
                                               style="font-family:'Inter',sans-serif;font-size:.88rem;line-height:1.7">A
                                                three-day conference hosting climate experts, policymakers, and
                                                engineers working on carbon capture.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- ALL UPCOMING EVENTS WITH SIDEBAR -->
                <section class="section-pad">
                    <div class="container">
                        <div class="row g-5">
                            <!-- Sidebar Filters -->
                            <div class="col-lg-3">
                                <div class="side-nav">
                                    <div class="side-nav-title">Categories</div>
                                    <a href="#" class="side-nav-link active">All Events</a>
                                    <a href="#" class="side-nav-link">Academic &amp; Lectures</a>
                                    <a href="#" class="side-nav-link">Arts &amp; Theater</a>
                                    <a href="#" class="side-nav-link">Athletics &amp; Sports</a>
                                    <a href="#" class="side-nav-link">Careers &amp; Networking</a>
                                    <a href="#" class="side-nav-link">Student Life &amp; Clubs</a>
                                </div>
                                <div class="info-box accent mt-3">
                                    <div style="font-weight:700;color:var(--primary-dark);margin-bottom:.5rem">Quick
                                        Search
                                    </div>
                                    <div class="input-group">
                                        <input type="text" class="form-control" placeholder="Search events..."
                                               style="font-family:'Inter',sans-serif;font-size:.88rem"/>
                                        <button class="btn btn-primary" type="button">
                                            <i class="bi bi-search"/>
                                        </button>
                                    </div>
                                </div>
                                <div class="info-box mt-3">
                                    <div style="font-weight:700;color:var(--primary-dark);margin-bottom:.5rem">Submit an
                                        Event
                                    </div>
                                    <p class="text-muted small mb-3"
                                       style="font-family:'Inter',sans-serif;line-height:1.6">Student clubs and
                                        departments can submit events to the calendar via the intranet portal.
                                    </p>
                                    <a href="#" class="btn btn-outline-primary w-100 rounded-pill fw-semibold"
                                       style="font-size:.82rem">Submit Event Form
                                    </a>
                                </div>
                            </div>
                            <!-- List of Events -->
                            <div class="col-lg-9">
                                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                                    <h4 class="fw-bold mb-0 o_editable">Upcoming Calendar</h4>
                                    <span style="font-family:'Inter',sans-serif;font-size:.85rem;color:var(--text-muted)">
                                        Showing
                                        <t t-esc="len(events)"/>
                                        Events
                                    </span>
                                </div>
                                <div class="d-flex flex-column gap-4">
                                    <t t-foreach="events" t-as="event">
                                        <div class="event-card reveal">
                                            <div class="p-4">
                                                <div class="d-flex flex-column flex-md-row align-items-start gap-4">
                                                    <div class="event-date-box"
                                                         style="background:#e8f0fe;color:#1a3a6b">
                                                        <span class="event-day">
                                                            <t t-esc="event.date_begin.strftime('%d')"/>
                                                        </span>
                                                        <span class="event-mon">
                                                            <t t-esc="event.date_begin.strftime('%b')"/>
                                                        </span>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <span class="event-type-badge"
                                                              style="background:#e8f0fe;color:#1a3a6b">
                                                            <t t-if="event.event_type_id"
                                                               t-esc="event.event_type_id.name"/>
                                                            <t t-else="">Event</t>
                                                        </span>
                                                        <h5 class="fw-bold mt-1 mb-1">
                                                            <a t-attf-href="/event/{{slug(event)}}"
                                                               style="text-decoration: none; color: inherit;">
                                                                <t t-esc="event.name"/>
                                                            </a>
                                                        </h5>
                                                        <div style="font-family:'Inter',sans-serif;font-size:.82rem;color:var(--text-muted);margin-bottom:.75rem">
                                                            <i class="bi bi-clock me-1"/>
                                                            <t t-esc="event.date_begin.strftime('%I:%M %p')"/>
                                                            |
                                                            <i class="bi bi-geo-alt me-1"/>
                                                            <t t-if="event.address_id" t-esc="event.address_id.name"/>
                                                            <t t-else="">Online</t>
                                                        </div>
                                                        <p class="text-muted small mb-0"
                                                           style="font-family:'Inter',sans-serif;line-height:1.7">
                                                            <t t-esc="event.subtitle or ''"/>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-if="not events">
                                        <!-- Event Row 1 -->
                                        <div class="event-card reveal">
                                            <div class="p-4">
                                                <div class="d-flex flex-column flex-md-row align-items-start gap-4">
                                                    <div class="event-date-box"
                                                         style="background:#e8f0fe;color:#1a3a6b">
                                                        <span class="event-day">28</span>
                                                        <span class="event-mon">Jun</span>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <span class="event-type-badge"
                                                              style="background:#e8f0fe;color:#1a3a6b">Arts &amp;
                                                            Culture
                                                        </span>
                                                        <h5 class="fw-bold mt-1 mb-1 o_editable">Annual Summer Symphony
                                                            on the Quad
                                                        </h5>
                                                        <div style="font-family:'Inter',sans-serif;font-size:.82rem;color:var(--text-muted);margin-bottom:.75rem"
                                                             class="o_editable"><i class="bi bi-clock me-1"/>7:30 PM |<i
                                                                class="bi bi-geo-alt me-1"/>Central Quad (Outdoor)
                                                        </div>
                                                        <p class="text-muted small mb-0 o_editable"
                                                           style="font-family:'Inter',sans-serif;line-height:1.7">The
                                                            Axion Philharmonic Orchestra presents an evening of
                                                            classical masterpieces under the stars. Free admission.
                                                            Bring blankets and lawn chairs.
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Event Row 2 -->
                                        <div class="event-card reveal">
                                            <div class="p-4">
                                                <div class="d-flex flex-column flex-md-row align-items-start gap-4">
                                                    <div class="event-date-box"
                                                         style="background:#fff8e1;color:#b45309">
                                                        <span class="event-day">02</span>
                                                        <span class="event-mon">Jul</span>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <span class="event-type-badge"
                                                              style="background:#fff8e1;color:#b45309">Career
                                                        </span>
                                                        <h5 class="fw-bold mt-1 mb-1 o_editable">STEM &amp; Tech Careers
                                                            Fair
                                                        </h5>
                                                        <div style="font-family:'Inter',sans-serif;font-size:.82rem;color:var(--text-muted);margin-bottom:.75rem"
                                                             class="o_editable"><i class="bi bi-clock me-1"/>11:00 AM –
                                                            4:00 PM |<i class="bi bi-geo-alt me-1"/>Student Union Grand
                                                            Ballroom
                                                        </div>
                                                        <p class="text-muted small mb-0 o_editable"
                                                           style="font-family:'Inter',sans-serif;line-height:1.7">
                                                            Connect with recruiter representatives from 80+ engineering,
                                                            biotechnology, and software companies. Open to
                                                            undergraduates and graduate students.
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Event Row 3 -->
                                        <div class="event-card reveal">
                                            <div class="p-4">
                                                <div class="d-flex flex-column flex-md-row align-items-start gap-4">
                                                    <div class="event-date-box"
                                                         style="background:#fce8e8;color:#c0392b">
                                                        <span class="event-day">05</span>
                                                        <span class="event-mon">Jul</span>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <span class="event-type-badge"
                                                              style="background:#fce8e8;color:#c0392b">Athletics
                                                        </span>
                                                        <h5 class="fw-bold mt-1 mb-1 o_editable">Axion Wildcats vs.
                                                            Metro State Basketball
                                                        </h5>
                                                        <div style="font-family:'Inter',sans-serif;font-size:.82rem;color:var(--text-muted);margin-bottom:.75rem"
                                                             class="o_editable"><i class="bi bi-clock me-1"/>2:00 PM |<i
                                                                class="bi bi-geo-alt me-1"/>Wildcats Arena
                                                        </div>
                                                        <p class="text-muted small mb-0 o_editable"
                                                           style="font-family:'Inter',sans-serif;line-height:1.7">Come
                                                            support the Wildcats in their final home game of the
                                                            conference qualifiers. Student tickets are free with Axion
                                                            Card.
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Event Row 4 -->
                                        <div class="event-card reveal">
                                            <div class="p-4">
                                                <div class="d-flex flex-column flex-md-row align-items-start gap-4">
                                                    <div class="event-date-box"
                                                         style="background:#f3e8ff;color:#6f42c1">
                                                        <span class="event-day">12</span>
                                                        <span class="event-mon">Jul</span>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <span class="event-type-badge"
                                                              style="background:#f3e8ff;color:#6f42c1">Academic
                                                        </span>
                                                        <h5 class="fw-bold mt-1 mb-1 o_editable">Eleanor Marsh Nobel
                                                            Lecture Series
                                                        </h5>
                                                        <div style="font-family:'Inter',sans-serif;font-size:.82rem;color:var(--text-muted);margin-bottom:.75rem"
                                                             class="o_editable"><i class="bi bi-clock me-1"/>4:00 PM |<i
                                                                class="bi bi-geo-alt me-1"/>Science Auditorium
                                                        </div>
                                                        <p class="text-muted small mb-0 o_editable"
                                                           style="font-family:'Inter',sans-serif;line-height:1.7">Guest
                                                            speaker Dr. Robert Vance, Nobel laureate in Physics,
                                                            discusses the future of quantum communications systems.
                                                            Registration required.
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- CAMPUS VENUES -->
                <section class="section-pad" style="background:var(--bg-light)">
                    <div class="container">
                        <div class="text-center mb-5 reveal">
                            <div class="section-eyebrow o_editable">Our Facilities</div>
                            <h2 class="section-title o_editable">Key Venues &amp; Locations</h2>
                            <p class="section-subtitle o_editable">Explore our state-of-the-art facilities hosting
                                events, exhibitions, and performances.
                            </p>
                        </div>
                        <div class="row g-4 reveal">
                            <div class="col-md-4">
                                <div class="side-nav p-4 h-100 text-center">
                                    <div style="font-size:2rem;color:var(--primary);margin-bottom:1rem">
                                        <i class="bi bi-building-fill"/>
                                    </div>
                                    <h6 class="fw-bold o_editable">Innovation Hub</h6>
                                    <p class="text-muted small mb-0 o_editable"
                                       style="font-family:'Inter',sans-serif;line-height:1.7">A 40,000 sq ft space
                                        designed to foster collaboration between researchers, students, startups, and
                                        industry sponsors.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="side-nav p-4 h-100 text-center">
                                    <div style="font-size:2rem;color:var(--accent);margin-bottom:1rem">
                                        <i class="bi bi-music-note-beamed"/>
                                    </div>
                                    <h6 class="fw-bold o_editable">Performing Arts Center</h6>
                                    <p class="text-muted small mb-0 o_editable"
                                       style="font-family:'Inter',sans-serif;line-height:1.7">A 1,200-seat acoustic
                                        concert hall, drama theater, and gallery hosting student and guest exhibitions.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="side-nav p-4 h-100 text-center">
                                    <div style="font-size:2rem;color:#1a7a4a;margin-bottom:1rem">
                                        <i class="bi bi-trophy-fill"/>
                                    </div>
                                    <h6 class="fw-bold o_editable">Wildcats Stadium</h6>
                                    <p class="text-muted small mb-0 o_editable"
                                       style="font-family:'Inter',sans-serif;line-height:1.7">Our 50,000-seat
                                        multi-sport stadium hosting football, soccer matches, track-and-field
                                        qualifiers, and major concerts.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- CTA -->
                <section class="cta-section">
                    <div class="cta-bg-img"
                         style="background-image: url('/theme_university/static/src/img/cta-bg.jpg')"/>
                    <div class="cta-shape-1"/>
                    <div class="cta-shape-2"/>
                    <div class="container position-relative text-center reveal" style="z-index:2">
                        <div class="section-eyebrow d-inline-flex"
                             style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.35);color:#f5c842">
                            Stay Updated
                        </div>
                        <h2 class="cta-title o_editable">Never Miss an Axion Event</h2>
                        <p class="cta-subtitle o_editable">Subscribe to our weekly newsletter or sync the Axion Academic
                            and Events Calendar with your Google or Outlook calendar.
                        </p>
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <a href="#" class="btn-hero-primary">
                                <i class="bi bi-envelope-fill"/>
                                Subscribe to Newsletter
                            </a>
                            <a href="#" class="btn-hero-ghost">
                                <i class="bi bi-calendar-check-fill"/>
                                Sync to Calendar
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
    <!-- Website page record for publishing the custom University Events page at /events. -->
    <record id="university_events_page_record" model="website.page">
        <field name="name">Events</field>
        <field name="url">/events</field>
        <field name="view_id" ref="university_events_page"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>
</odoo>
