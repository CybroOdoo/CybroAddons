<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Home Page -->
    <template id="university_home_page" name="University Home" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <!-- Hero Banner -->
                <t t-call="theme_university.s_hero_banner"/>
                <div class="oe_structure oe_empty"/>
                <!-- Ticker announcements -->
                <t t-call="theme_university.s_ticker_bar"/>
                <div class="oe_structure oe_empty"/>
                <!-- Programs grid -->
                <t t-call="theme_university.s_programs_section"/>
                <div class="oe_structure oe_empty"/>
                <!-- Why choose us legacy -->
                <t t-call="theme_university.s_why_choose_us"/>
                <div class="oe_structure oe_empty"/>
                <!-- Stats counters -->
                <t t-call="theme_university.s_stats_section"/>
                <div class="oe_structure oe_empty"/>
                <!-- Events list -->
                <t t-call="theme_university.s_events_section"/>
                <div class="oe_structure oe_empty"/>
                <!-- Student Testimonials -->
                <t t-call="theme_university.s_testimonials"/>
                <div class="oe_structure oe_empty"/>
                <!-- Research highlights -->
                <t t-call="theme_university.s_research_section"/>
                <div class="oe_structure oe_empty"/>
                <!-- Gallery Grid -->
                <t t-call="theme_university.s_gallery_section"/>
                <div class="oe_structure oe_empty"/>
                <!-- Admissions CTA banner -->
                <t t-call="theme_university.s_cta_section"/>
                <div class="oe_structure oe_empty"/>
                <!-- News articles -->
                <t t-call="theme_university.s_news_section"/>
                <div class="oe_structure oe_empty"/>
                <!-- Alumni corporate logos -->
                <t t-call="theme_university.s_logos_bar"/>
                <div class="oe_structure oe_empty"/>
            </div>
        </xpath>
    </template>
</odoo>
