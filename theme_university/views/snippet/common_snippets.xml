<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Split Hero -->
    <template id="s_split_hero" name="University Split Hero">
        <section class="section-pad bg-white s_split_hero" data-snippet="theme_university.s_split_hero"
                 data-name="Split Hero">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <div class="section-eyebrow o_editable">Empowerment</div>
                        <h2 class="section-title o_editable">Grow Your Potential with Expert Guidance</h2>
                        <p class="text-muted mb-4 o_editable">Our curriculum is designed to push you beyond conventional
                            limits, introducing real-world scenarios and direct mentorship.
                        </p>
                        <a href="/contactus" class="btn btn-primary rounded-pill px-4 py-2">Get Started Today</a>
                    </div>
                    <div class="col-lg-6">
                        <img src="/theme_university/static/src/img/hero-campus.jpg"
                             class="img-fluid rounded-4 shadow-lg w-100" style="max-height:400px;object-fit:cover;"
                             alt="Split Hero Image"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Accordion / FAQ Block -->
    <template id="s_faq_accordion" name="University FAQ Accordion">
        <section class="section-pad bg-light s_faq_accordion" data-snippet="theme_university.s_faq_accordion"
                 data-name="FAQ Accordion">
            <div class="container">
                <div class="section-header text-center">
                    <h2 class="section-title o_editable">Frequently Asked Questions</h2>
                    <p class="section-subtitle o_editable">Have questions? We have answers. If you don't find what you
                        need, feel free to contact us.
                    </p>
                </div>
                <div class="accordion max-w-700 mx-auto" id="universityFaq">
                    <div class="accordion-item border-0 mb-3 rounded-3 overflow-hidden shadow-sm">
                        <h2 class="accordion-header" id="faqHeading1">
                            <button class="accordion-button fw-bold text-dark bg-white" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="true"
                                    aria-controls="faqCollapse1">
                                What are the admission deadlines for Fall 2026?
                            </button>
                        </h2>
                        <div id="faqCollapse1" class="accordion-collapse collapse show" aria-labelledby="faqHeading1"
                             data-bs-parent="#universityFaq">
                            <div class="accordion-body bg-white text-muted">
                                Applications for Fall 2026 open on September 1st, 2025. The deadline for priority
                                scholarship consideration is January 15th, and general admission closes on March 1st.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border-0 mb-3 rounded-3 overflow-hidden shadow-sm">
                        <h2 class="accordion-header" id="faqHeading2">
                            <button class="accordion-button collapsed fw-bold text-dark bg-white" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false"
                                    aria-controls="faqCollapse2">
                                Do you offer online programs?
                            </button>
                        </h2>
                        <div id="faqCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHeading2"
                             data-bs-parent="#universityFaq">
                            <div class="accordion-body bg-white text-muted">
                                Yes, Axion University offers various fully online degree and certificate programs across
                                STEM, business, and humanities fields.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Pricing Table -->
    <template id="s_pricing_table" name="University Tuition Pricing">
        <section class="section-pad bg-white s_pricing_table" data-snippet="theme_university.s_pricing_table"
                 data-name="Tuition Pricing">
            <div class="container">
                <div class="section-header text-center">
                    <h2 class="section-title o_editable">Admissions &amp; Tuition Plans</h2>
                    <p class="section-subtitle o_editable">Investing in your education is the first step toward a bright
                        future.
                    </p>
                </div>
                <div class="row g-4 justify-content-center">
                    <div class="col-md-4">
                        <div class="card p-4 rounded-4 border-0 shadow-sm h-100 text-center">
                            <h5 class="fw-bold mb-3 o_editable">Undergraduate</h5>
                            <h2 class="fw-bold text-primary mb-3 o_editable">$15,500
                                <span class="fs-6 text-muted fw-normal">/ semester</span>
                            </h2>
                            <ul class="list-unstyled text-muted mb-4 lh-lg">
                                <li class="o_editable">Full-time enrollment</li>
                                <li class="o_editable">Access to library and labs</li>
                                <li class="o_editable">On-campus activities</li>
                            </ul>
                            <a href="/apply" class="btn btn-outline-primary mt-auto rounded-pill">Choose Plan</a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card p-4 rounded-4 border-primary border-2 shadow h-100 text-center position-relative">
                            <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-warning text-dark px-3 py-2">
                                Most Popular
                            </span>
                            <h5 class="fw-bold mb-3 o_editable">Graduate Studies</h5>
                            <h2 class="fw-bold text-primary mb-3 o_editable">$22,000
                                <span class="fs-6 text-muted fw-normal">/ semester</span>
                            </h2>
                            <ul class="list-unstyled text-muted mb-4 lh-lg">
                                <li class="o_editable">Advanced research seminars</li>
                                <li class="o_editable">1-on-1 advisor mentorship</li>
                                <li class="o_editable">Dedicated lab workbench</li>
                            </ul>
                            <a href="/apply" class="btn btn-primary mt-auto rounded-pill">Choose Plan</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Timeline / Process Steps -->
    <template id="s_timeline" name="University Admission Steps">
        <section class="section-pad bg-light s_timeline" data-snippet="theme_university.s_timeline"
                 data-name="Admission Process">
            <div class="container">
                <div class="section-header text-center">
                    <h2 class="section-title o_editable">How to Apply</h2>
                    <p class="section-subtitle o_editable">Follow our step-by-step admissions roadmap to finalize your
                        enrollment.
                    </p>
                </div>
                <div class="row g-4 justify-content-center">
                    <div class="col-md-3 text-center">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:60px;height:60px;font-size:1.5rem;font-weight:bold">1
                        </div>
                        <h6 class="fw-bold o_editable">Submit Application</h6>
                        <p class="small text-muted o_editable">Fill out the online portal application form with your
                            details.
                        </p>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:60px;height:60px;font-size:1.5rem;font-weight:bold">2
                        </div>
                        <h6 class="fw-bold o_editable">Upload Transcripts</h6>
                        <p class="small text-muted o_editable">Provide certified high school or university
                            transcripts.
                        </p>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:60px;height:60px;font-size:1.5rem;font-weight:bold">3
                        </div>
                        <h6 class="fw-bold o_editable">Personal Interview</h6>
                        <p class="small text-muted o_editable">Speak with our admissions coordinators to align your
                            goals.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Before / After Image Comparison -->
    <template id="s_before_after" name="Campus Transformation Comparison">
        <section class="section-pad bg-white s_before_after" data-snippet="theme_university.s_before_after"
                 data-name="Before/After Comparison">
            <div class="container">
                <div class="section-header text-center">
                    <h2 class="section-title o_editable">Campus Transformation</h2>
                    <p class="section-subtitle o_editable">Compare the historic 1892 quad building and our newly
                        designed modern architecture campus.
                    </p>
                </div>
                <div class="row g-4 justify-content-center">
                    <div class="col-md-6 text-center">
                        <h5 class="fw-bold mb-3 o_editable">Historic Campus</h5>
                        <img src="/theme_university/static/src/img/campus-life.jpg"
                             class="img-fluid rounded-4 shadow-sm w-100" style="height:300px;object-fit:cover;"
                             alt="Historic"/>
                    </div>
                    <div class="col-md-6 text-center">
                        <h5 class="fw-bold mb-3 o_editable">Modern Research Hub</h5>
                        <img src="/theme_university/static/src/img/hero-campus.jpg"
                             class="img-fluid rounded-4 shadow-sm w-100" style="height:300px;object-fit:cover;"
                             alt="Modern"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Embedded Video Block -->
    <template id="s_video_block" name="University Video Introduction">
        <section class="section-pad bg-light s_video_block" data-snippet="theme_university.s_video_block"
                 data-name="Video Introduction">
            <div class="container text-center">
                <div class="section-header">
                    <h2 class="section-title o_editable">Virtual Campus Tour Video</h2>
                    <p class="section-subtitle o_editable">Experience a walk through our classrooms, research
                        laboratories, and student facilities.
                    </p>
                </div>
                <div class="max-w-700 mx-auto shadow-lg rounded-4 overflow-hidden bg-dark position-relative"
                     style="aspect-ratio:16/9">
                    <iframe class="w-100 h-100" src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="University Tour"
                            frameborder="0" allowfullscreen="true"/>
                </div>
            </div>
        </section>
    </template>
    <!-- Breadcrumb Bar -->
    <template id="s_breadcrumb_bar" name="University Breadcrumb Bar">
        <section class="py-3 bg-light border-bottom s_breadcrumb_bar" data-snippet="theme_university.s_breadcrumb_bar"
                 data-name="Breadcrumb Bar">
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="/">Home</a>
                        </li>
                        <li class="breadcrumb-item active o_editable" aria-current="page">Admissions</li>
                    </ol>
                </nav>
            </div>
        </section>
    </template>
    <!-- Register Snippets in Panel -->
    <template id="s_common_snippets_register" inherit_id="website.snippets" name="Common University Snippets">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.s_split_hero" string="Split Hero"
               t-thumbnail="/theme_university/static/src/img/hero-campus.jpg" group="university_section"/>
            <t t-snippet="theme_university.s_faq_accordion" string="FAQ Accordion"
               t-thumbnail="/theme_university/static/src/img/logo-white.png" group="university_section"/>
            <t t-snippet="theme_university.s_pricing_table" string="Tuition Pricing"
               t-thumbnail="/theme_university/static/src/img/logo-white.png" group="university_section"/>
            <t t-snippet="theme_university.s_timeline" string="Admission Roadmap"
               t-thumbnail="/theme_university/static/src/img/logo-white.png" group="university_section"/>
            <t t-snippet="theme_university.s_before_after" string="Campus Comparison"
               t-thumbnail="/theme_university/static/src/img/campus-life.jpg" group="university_section"/>
            <t t-snippet="theme_university.s_video_block" string="Video Tour"
               t-thumbnail="/theme_university/static/src/img/hero-campus.jpg" group="university_section"/>
            <t t-snippet="theme_university.s_breadcrumb_bar" string="Breadcrumbs"
               t-thumbnail="/theme_university/static/src/img/logo-white.png" group="university_section"/>
        </xpath>
    </template>
</odoo>
