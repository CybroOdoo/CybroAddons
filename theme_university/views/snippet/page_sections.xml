<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inner Page Hero -->
    <template id="s_inner_page_hero" name="University Inner Page Hero">
        <section class="inner-hero s_inner_page_hero" data-snippet="theme_university.s_inner_page_hero"
                 data-name="Inner Page Hero">
            <div class="inner-hero-bg"/>
            <div class="inner-hero-shape inner-hero-shape-1"/>
            <div class="inner-hero-shape inner-hero-shape-2"/>
            <div class="container">
                <div class="inner-hero-content">
                    <div class="inner-breadcrumb o_editable">
                        <a href="/">Home</a>
                        <span class="sep">
                            <i class="bi bi-chevron-right"/>
                        </span>
                        <a href="#">University</a>
                        <span class="sep">
                            <i class="bi bi-chevron-right"/>
                        </span>
                        <span class="current">Page Overview</span>
                    </div>
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-7 reveal">
                            <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                 style="background:rgba(var(--accent-rgb),.15);border-color:rgba(var(--accent-rgb),.3);color:var(--accent-light)">
                                <i class="bi bi-stars me-1"/>
                                Academic Excellence
                            </div>
                            <h1 class="inner-hero-title o_editable">Shape Your Future at Axion University</h1>
                            <p class="inner-hero-subtitle o_editable">Founded in 1892, Axion University combines
                                world-class teaching, cutting-edge research, and a vibrant campus community to prepare
                                students for leadership in every field.
                            </p>
                            <div class="inner-hero-meta o_editable">
                                <div class="inner-hero-meta-item">
                                    <i class="bi bi-people-fill"/>
                                    48,000+ Students
                                </div>
                                <div class="inner-hero-meta-item">
                                    <i class="bi bi-book-fill"/>
                                    320+ Programs
                                </div>
                                <div class="inner-hero-meta-item">
                                    <i class="bi bi-globe2"/>
                                    130+ Countries
                                </div>
                                <div class="inner-hero-meta-item">
                                    <i class="bi bi-patch-check-fill"/>
                                    Top 50 Global Ranking
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5 d-none d-lg-block reveal reveal-delay-2">
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="highlight-card o_editable">
                                        <div class="highlight-num">1892</div>
                                        <div class="highlight-label">Founded</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="highlight-card o_editable">
                                        <div class="highlight-num">48K+</div>
                                        <div class="highlight-label">Enrolled Students</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="highlight-card o_editable">
                                        <div class="highlight-num">320+</div>
                                        <div class="highlight-label">Academic Programs</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="highlight-card o_editable">
                                        <div class="highlight-num">130+</div>
                                        <div class="highlight-label">Countries Represented</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Feature Grid -->
    <template id="s_feature_grid" name="University Feature Grid">
        <section class="section-pad s_feature_grid" data-snippet="theme_university.s_feature_grid"
                 data-name="Feature Grid">
            <div class="container">
                <div class="text-center mb-5 reveal">
                    <div class="section-eyebrow o_editable">Academic Excellence</div>
                    <h2 class="section-title o_editable">Why Students Choose Axion</h2>
                    <p class="section-subtitle o_editable">Use these cards for admissions highlights, student services,
                        research strengths, or any university story that needs a polished summary.
                    </p>
                </div>
                <div class="row g-4">
                    <div class="col-md-4 reveal reveal-delay-1">
                        <div class="highlight-card text-center h-100 o_editable">
                            <i class="bi bi-award-fill fs-2 mb-2" style="color:var(--primary)"/>
                            <h6 class="mb-2">World-Class Faculty</h6>
                            <p class="text-muted small mb-0" style="font-family:'Inter',sans-serif;line-height:1.7">
                                Learn from professors and researchers who combine academic rigor with real-world impact
                                across every discipline.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 reveal reveal-delay-2">
                        <div class="highlight-card text-center h-100 o_editable">
                            <i class="bi bi-people-fill fs-2 mb-2" style="color:var(--success)"/>
                            <h6 class="mb-2">Student Support</h6>
                            <p class="text-muted small mb-0" style="font-family:'Inter',sans-serif;line-height:1.7">
                                Advising, wellness, career coaching, and financial aid resources designed to help every
                                student thrive from day one.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 reveal reveal-delay-3">
                        <div class="highlight-card text-center h-100 o_editable">
                            <i class="bi bi-globe2 fs-2 mb-2" style="color:var(--info)"/>
                            <h6 class="mb-2">Global Outlook</h6>
                            <p class="text-muted small mb-0" style="font-family:'Inter',sans-serif;line-height:1.7">A
                                diverse campus community spanning 130+ countries, with international partnerships and
                                study opportunities around the world.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Stats Band -->
    <template id="s_stats_band" name="University Stats Band">
        <section class="s_stats_band" data-snippet="theme_university.s_stats_band" data-name="Stats Band"
                 style="background:var(--primary-dark);padding:3rem 0">
            <div class="container">
                <div class="row g-3 text-center">
                    <div class="col-6 col-md-3 reveal">
                        <div class="o_editable">
                            <div style="font-size:2rem;font-weight:800;color:var(--accent-light)" class="stat-num">
                                48,000+
                            </div>
                            <div style="font-family:'Inter',sans-serif;font-size:1rem;color:rgba(255,255,255,.55)">
                                Students
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 reveal reveal-delay-1">
                        <div class="o_editable">
                            <div style="font-size:2rem;font-weight:800;color:var(--accent-light)" class="stat-num">
                                2,400+
                            </div>
                            <div style="font-family:'Inter',sans-serif;font-size:1rem;color:rgba(255,255,255,.55)">
                                Researchers
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 reveal reveal-delay-2">
                        <div class="o_editable">
                            <div style="font-size:2rem;font-weight:800;color:var(--accent-light)" class="stat-num">
                                320+
                            </div>
                            <div style="font-family:'Inter',sans-serif;font-size:1rem;color:rgba(255,255,255,.55)">
                                Programs
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 reveal reveal-delay-3">
                        <div class="o_editable">
                            <div style="font-size:2rem;font-weight:800;color:var(--accent-light)" class="stat-num">
                                130+
                            </div>
                            <div style="font-family:'Inter',sans-serif;font-size:1rem;color:rgba(255,255,255,.55)">
                                Countries
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Gallery Strip -->
    <template id="s_gallery_strip" name="University Gallery Strip">
        <section class="section-pad s_gallery_strip" data-snippet="theme_university.s_gallery_strip"
                 data-name="Gallery Strip">
            <div class="container">
                <div class="text-center mb-5 reveal">
                    <div class="section-eyebrow o_editable">Campus Life</div>
                    <h2 class="section-title o_editable">Campus Gallery</h2>
                    <p class="section-subtitle o_editable">Showcase lecture halls, libraries, research labs, and student
                        spaces that define life at Axion University.
                    </p>
                </div>
                <div class="row g-3">
                    <div class="col-6 col-lg-3 reveal reveal-delay-1">
                        <img src="/theme_university/static/src/img/gallery-main.jpg"
                             class="img-fluid rounded-4 shadow-sm w-100" style="height:220px;object-fit:cover;"
                             alt="Gallery image one"/>
                    </div>
                    <div class="col-6 col-lg-3 reveal reveal-delay-2">
                        <img src="/theme_university/static/src/img/gallery-library.jpg"
                             class="img-fluid rounded-4 shadow-sm w-100" style="height:220px;object-fit:cover;"
                             alt="Gallery image two"/>
                    </div>
                    <div class="col-6 col-lg-3 reveal reveal-delay-3">
                        <img src="/theme_university/static/src/img/gallery-lab.jpg"
                             class="img-fluid rounded-4 shadow-sm w-100" style="height:220px;object-fit:cover;"
                             alt="Gallery image three"/>
                    </div>
                    <div class="col-6 col-lg-3 reveal reveal-delay-4">
                        <img src="/theme_university/static/src/img/gallery-sports.jpg"
                             class="img-fluid rounded-4 shadow-sm w-100" style="height:220px;object-fit:cover;"
                             alt="Gallery image four"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- CTA Band -->
    <template id="s_cta_band" name="University CTA Band">
        <section class="cta-section s_cta_band" data-snippet="theme_university.s_cta_band" data-name="CTA Band">
            <div class="cta-bg-img"/>
            <div class="cta-shape-1"/>
            <div class="cta-shape-2"/>
            <div class="container position-relative text-center reveal" style="z-index:2">
                <div class="section-eyebrow d-inline-flex o_editable"
                     style="background:rgba(var(--accent-rgb),.15);border-color:rgba(var(--accent-rgb),.35);color:var(--accent-light)">
                    Join Axion
                </div>
                <h2 class="cta-title o_editable">Join the Axion Community</h2>
                <p class="cta-subtitle o_editable">Whether you're a future student, researcher, partner, or donor, there
                    is a place for you in the Axion story. Let's shape the future together.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3 o_editable">
                    <a href="/apply" class="btn-hero-primary">
                        <i class="bi bi-pencil-square"/>
                        Apply for Fall 2026
                    </a>
                    <a href="/contactus" class="btn-hero-ghost">
                        <i class="bi bi-chat-dots-fill"/>
                        Contact Admissions
                    </a>
                </div>
            </div>
        </section>
    </template>
    <!-- Register in snippets panel -->
    <template id="s_page_sections_snippet" inherit_id="website.snippets" priority="24">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.s_inner_page_hero" string="Inner Page Hero"
               t-thumbnail="/theme_university/static/src/img/hero-campus.jpg" group="university_section"/>
            <t t-snippet="theme_university.s_feature_grid" string="Feature Grid"
               t-thumbnail="/theme_university/static/src/img/gallery-main.jpg" group="university_section"/>
            <t t-snippet="theme_university.s_stats_band" string="Stats Band"
               t-thumbnail="/theme_university/static/src/img/logo-white.png" group="university_section"/>
            <t t-snippet="theme_university.s_gallery_strip" string="Gallery Strip"
               t-thumbnail="/theme_university/static/src/img/gallery-library.jpg" group="university_section"/>
            <t t-snippet="theme_university.s_cta_band" string="CTA Band"
               t-thumbnail="/theme_university/static/src/img/cta-bg.jpg" group="university_section"/>
        </xpath>
    </template>
</odoo>
