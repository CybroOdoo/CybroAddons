<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template for Ticker Bar -->
    <template id="s_ticker_bar" name="University Ticker Bar">
        <section class="ticker-bar s_ticker_bar" data-snippet="theme_university.s_ticker_bar" data-name="Ticker Bar">
            <div class="container d-flex align-items-center gap-3 overflow-hidden ps-0">
                <span class="ticker-label">
                    <i class="bi bi-megaphone-fill me-1"/>Updates
                </span>
                <div class="ticker-text o_editable">
                    <span class="me-5">Applications for Fall 2026 are now open — Apply by March 1st for full scholarship
                        consideration
                    </span>
                    <span class="me-5">New $50M AI &amp; Robotics Research Center inaugurated in partnership with MIT
                    </span>
                    <span class="me-5">Annual Cultural Fest "Mosaic 2026" — Register before May 30th</span>
                    <span class="me-5">Axion ranked #3 for Student Experience in North America</span>
                </div>
            </div>
        </section>
    </template>
    <!-- Register in snippets panel -->
    <template id="s_ticker_bar_snippet" inherit_id="website.snippets" priority="17">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.s_ticker_bar"
               string="University Ticker"
               t-thumbnail="/theme_university/static/src/img/logo-white.png"
               group="university_section"/>
        </xpath>
    </template>
</odoo>
