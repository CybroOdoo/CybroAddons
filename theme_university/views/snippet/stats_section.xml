<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Snippet for Stats Section-->
    <template id="s_stats_section" name="University Stats Counters">
        <section class="stats-section s_stats_section" data-snippet="theme_university.s_stats_section"
                 data-name="Stats Counters">
            <div class="stats-shape-left"/>
            <div class="stats-shape-right"/>
            <div class="container position-relative" style="z-index:2">
                <div class="row g-4">
                    <div class="col-6 col-lg-3 reveal reveal-delay-1">
                        <div class="stat-box">
                            <i class="bi bi-people-fill stat-icon"/>
                            <span class="stat-num">48,000+</span>
                            <span class="stat-label o_editable">Enrolled Students</span>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3 reveal reveal-delay-2">
                        <div class="stat-box">
                            <i class="bi bi-person-badge-fill stat-icon"/>
                            <span class="stat-num">2,400+</span>
                            <span class="stat-label o_editable">Faculty Members</span>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3 reveal reveal-delay-3">
                        <div class="stat-box">
                            <i class="bi bi-book-fill stat-icon"/>
                            <span class="stat-num">320+</span>
                            <span class="stat-label o_editable">Degree Programs</span>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3 reveal reveal-delay-4">
                        <div class="stat-box">
                            <i class="bi bi-globe-americas stat-icon"/>
                            <span class="stat-num">250K+</span>
                            <span class="stat-label o_editable">Alumni Worldwide</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!--    Snippet for Stats Section-->
    <template id="s_stats_section_snippet" inherit_id="website.snippets" priority="20">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.s_stats_section"
               string="University Stats"
               t-thumbnail="/theme_university/static/src/img/logo-white.png"
               group="university_section"/>
        </xpath>
    </template>
</odoo>
