<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CTA Section -->
    <template id="s_cta_section" name="University Admissions CTA">
        <section class="cta-section s_cta_section" data-snippet="theme_university.s_cta_section"
                 data-name="Admissions CTA">
            <div class="cta-bg-img"/>
            <div class="cta-shape-1"/>
            <div class="cta-shape-2"/>
            <div class="container position-relative text-center reveal" style="z-index:2">
                <div class="section-eyebrow d-inline-flex o_editable"
                     style="background:rgba(var(--accent-rgb),.15);border-color:rgba(var(--accent-rgb),.35);color:var(--accent-light)">
                    Applications Open
                </div>
                <h2 class="cta-title o_editable">Ready to Begin Your Journey?</h2>
                <p class="cta-subtitle o_editable">
                    Join 48,000 students from around the world and become part of a legacy of excellence.
                    Fall 2026 applications are open now.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="/apply" class="btn-hero-primary">
                        <i class="bi bi-pencil-square"/>
                        Apply Now
                    </a>
                    <a href="#" class="btn-hero-ghost">
                        <i class="bi bi-download"/>
                        Download Prospectus
                    </a>
                    <a href="/contactus" class="btn-hero-ghost">
                        <i class="bi bi-chat-dots-fill"/>
                        Talk to Admissions
                    </a>
                </div>
                <div class="cta-deadline o_editable">
                    <i class="bi bi-calendar-check-fill"/>
                    Application Deadline: March 1, 2026
                    <span class="opacity-40 mx-2">|</span>
                    Scholarship Deadline: January 15, 2026
                </div>
            </div>
        </section>
    </template>
    <!-- CTA Snippets in Panel -->
    <template id="s_cta_section_snippet" inherit_id="website.snippets" priority="25">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.s_cta_section"
               string="University CTA"
               t-thumbnail="/theme_university/static/src/img/logo-white.png"
               group="university_section"/>
        </xpath>
    </template>
</odoo>
