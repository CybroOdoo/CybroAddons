<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Snippet for University Snippet Groups-->
    <template id="university_snippet_groups" inherit_id="website.snippets" name="University Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <t t-snippet="website.s_snippet_group"
               t-thumbnail="/theme_university/static/description/icon.png"
               string="Theme University"
               snippet-group="university_section"/>
        </xpath>
    </template>
</odoo>
