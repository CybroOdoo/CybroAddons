<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university research and impact section. -->
    <template id="university_research" name="University Research">
        <section class="research-section section-pad o_colored_level"
                 data-snippet="theme_university.university_research" data-name="Research &amp; Impact">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6 reveal">
                        <div class="section-eyebrow o_editable">Pushing Boundaries</div>
                        <h2 class="section-title o_editable">Leading Research That<br/>Changes the World
                        </h2>
                        <p class="mb-4 o_editable" style="font-family:'Inter',sans-serif;color:#6b7280;line-height:1.8">
                            Our researchers are at the forefront of discoveries reshaping medicine, technology, policy,
                            and the environment. With $400M in annual research funding, Axion is a global powerhouse of
                            innovation.
                        </p>
                        <div class="d-flex flex-column gap-3">
                            <a href="#" class="research-lab-card">
                                <div class="research-lab-icon"
                                     style="background:linear-gradient(135deg,#1a3a6b,#2352a0)">
                                    <i class="bi bi-robot text-white"/>
                                </div>
                                <div>
                                    <div class="fw-bold o_editable"
                                         style="font-family:'Inter',sans-serif;font-size:.95rem">Center for AI &amp;
                                        Robotics
                                    </div>
                                    <div class="small text-muted o_editable" style="font-family:'Inter',sans-serif">
                                        Next-gen autonomous systems for healthcare and logistics.
                                    </div>
                                </div>
                                <i class="bi bi-arrow-right arrow-icon"/>
                            </a>
                            <a href="#" class="research-lab-card">
                                <div class="research-lab-icon"
                                     style="background:linear-gradient(135deg,#1a7a4a,#2e9d63)">
                                    <i class="bi bi-tree text-white"/>
                                </div>
                                <div>
                                    <div class="fw-bold o_editable"
                                         style="font-family:'Inter',sans-serif;font-size:.95rem">Climate &amp;
                                        Sustainability Lab
                                    </div>
                                    <div class="small text-muted o_editable" style="font-family:'Inter',sans-serif">
                                        Carbon capture, renewable energy, and urban resilience.
                                    </div>
                                </div>
                                <i class="bi bi-arrow-right arrow-icon"/>
                            </a>
                            <a href="#" class="research-lab-card">
                                <div class="research-lab-icon"
                                     style="background:linear-gradient(135deg,#c0392b,#e74c3c)">
                                    <i class="bi bi-heart-pulse text-white"/>
                                </div>
                                <div>
                                    <div class="fw-bold o_editable"
                                         style="font-family:'Inter',sans-serif;font-size:.95rem">Biomedical Research
                                        Institute
                                    </div>
                                    <div class="small text-muted o_editable" style="font-family:'Inter',sans-serif">
                                        Treatments for cancer, neurological, and rare genetic diseases.
                                    </div>
                                </div>
                                <i class="bi bi-arrow-right arrow-icon"/>
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-6 reveal">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="research-stat-card"
                                     style="background:linear-gradient(135deg,#1a3a6b,#2352a0)">
                                    <i class="bi bi-journal-richtext fs-1 mb-4" style="color:rgba(232,160,32,.7)"/>
                                    <div class="research-stat-num text-white">1,200+</div>
                                    <div class="research-stat-label o_editable" style="color:rgba(255,255,255,.6)">
                                        Research Publications / Year
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="research-stat-card" style="background:white;box-shadow:var(--card-shadow)">
                                    <i class="bi bi-patch-check-fill fs-1 mb-4" style="color:#1a7a4a"/>
                                    <div class="research-stat-num" style="color:#0f2347">340+</div>
                                    <div class="research-stat-label text-muted o_editable">Patents Granted</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="research-stat-card" style="background:white;box-shadow:var(--card-shadow)">
                                    <i class="bi bi-currency-dollar fs-1 mb-4" style="color:#b45309"/>
                                    <div class="research-stat-num" style="color:#0f2347">$400M</div>
                                    <div class="research-stat-label text-muted o_editable">Annual Research Budget</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="research-stat-card"
                                     style="background:linear-gradient(135deg,#e8a020,#f5c842)">
                                    <i class="bi bi-people-fill fs-1 mb-4" style="color:rgba(15, 35, 71, 0.918)"/>
                                    <div class="research-stat-num" style="color:#0f2347">50+</div>
                                    <div class="research-stat-label o_editable" style="color:rgba(15,35,71,.6)">Active
                                        Research Centers
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university research and impact snippet in the Website Builder. -->
    <template id="university_research_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_research"
               string="Research &amp; Impact"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
