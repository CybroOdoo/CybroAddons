<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university testimonials section. -->
    <template id="university_testimonials" name="University Testimonials">
        <section class="testimonials-section section-pad o_colored_level" data-snippet="theme_university.university_testimonials" data-name="Testimonials">
            <div class="container">
                <div class="section-header text-center reveal">
                    <div class="section-eyebrow o_editable">Student Voices</div>
                    <h2 class="section-title o_editable">What Our Students Say</h2>
                    <p class="section-subtitle o_editable">Real stories from the Axion community around the world.</p>
                </div>
                <div class="row g-4 align-items-stretch">
                    <div class="col-md-4 reveal">
                        <div class="testimonial-card h-100">
                            <div class="d-flex gap-1 mb-3" style="color:#f59e0b">
                                <i class="bi bi-star-fill"/><i class="bi bi-star-fill"/><i class="bi bi-star-fill"/>
                                <i class="bi bi-star-fill"/><i class="bi bi-star-fill"/>
                            </div>
                            <p class="testimonial-quote o_editable">
                                "Axion transformed my career trajectory. The CS program gave me both theoretical depth and practical skills. I landed my dream role at Google before even graduating!"
                            </p>
                            <div class="d-flex align-items-center gap-3 mt-auto pt-2">
                                <img src="/theme_university/static/src/img/avatar-sarah.jpg" class="reviewer-img" alt="Sarah Mitchell" />
                                <div>
                                    <div class="reviewer-name o_editable">Sarah Mitchell</div>
                                    <div class="reviewer-role o_editable">CS Graduate, 2024 — Software Engineer, Google</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 reveal">
                        <div class="testimonial-card featured h-100">
                            <div class="d-flex gap-1 mb-3" style="color:#fbbf24">
                                <i class="bi bi-star-fill"/><i class="bi bi-star-fill"/><i class="bi bi-star-fill"/>
                                <i class="bi bi-star-fill"/><i class="bi bi-star-fill"/>
                            </div>
                            <p class="testimonial-quote o_editable">
                                "The international exchange program opened doors I never imagined. Studying in Tokyo for a semester, now working at the UN — it all started right here at Axion."
                            </p>
                            <div class="d-flex align-items-center gap-3 mt-auto pt-2">
                                <img src="/theme_university/static/src/img/avatar-james.jpg" class="reviewer-img" alt="James Okonkwo" />
                                <div>
                                    <div class="reviewer-name o_editable">James Okonkwo</div>
                                    <div class="reviewer-role o_editable">IR Graduate, 2023 — Policy Analyst, United Nations</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 reveal">
                        <div class="testimonial-card h-100">
                            <div class="d-flex gap-1 mb-3" style="color:#f59e0b">
                                <i class="bi bi-star-fill"/><i class="bi bi-star-fill"/><i class="bi bi-star-fill"/>
                                <i class="bi bi-star-fill"/><i class="bi bi-star-half"/>
                            </div>
                            <p class="testimonial-quote o_editable">
                                "The medical program is exceptional. The simulation labs and mentorship from world-class doctors made all the difference. I graduated fully prepared for real clinical challenges."
                            </p>
                            <div class="d-flex align-items-center gap-3 mt-auto pt-2">
                                <img src="/theme_university/static/src/img/avatar-priya.jpg" class="reviewer-img" alt="Dr Priya Sharma" />
                                <div>
                                    <div class="reviewer-name o_editable">Dr. Priya Sharma</div>
                                    <div class="reviewer-role o_editable">Medicine, 2022 — Resident Physician, Mayo Clinic</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university testimonials snippet in the Website Builder. -->
    <template id="university_testimonials_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_testimonials"
               string="Testimonials"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
