<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university inner hero banner section. -->
    <template id="university_inner_hero" name="University Inner Hero">
        <section class="inner-hero o_colored_level" data-snippet="theme_university.university_inner_hero"
                 data-name="Inner Hero">
            <div class="inner-hero-bg"/>
            <div class="inner-hero-shape inner-hero-shape-1"/>
            <div class="inner-hero-shape inner-hero-shape-2"/>
            <div class="container">
                <div class="inner-hero-content">
                    <div class="inner-breadcrumb">
                        <a href="/">Home</a>
                        <span class="sep">
                            <i class="bi bi-chevron-right"/>
                        </span>
                        <span class="current o_editable">Academics</span>
                    </div>
                    <div class="row align-items-center g-5">
                        <div class="col-lg-7 reveal">
                            <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                 style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:#f5c842">
                                <i class="bi bi-mortarboard-fill"/>
                                Academic Excellence
                            </div>
                            <h1 class="inner-hero-title o_editable">World-Class Education<br/>Across Every Discipline
                            </h1>
                            <p class="inner-hero-subtitle o_editable">Six schools and colleges. 320+ degree programs. A
                                faculty of Nobel laureates, industry leaders, and pioneering researchers — all united by
                                a single mission: to shape tomorrow's leaders.
                            </p>
                            <div class="inner-hero-meta o_editable">
                                <div class="inner-hero-meta-item">
                                    <i class="bi bi-book-fill"/>
                                    320+ Programs
                                </div>
                                <div class="inner-hero-meta-item">
                                    <i class="bi bi-person-badge-fill"/>
                                    2,400+ Faculty
                                </div>
                                <div class="inner-hero-meta-item">
                                    <i class="bi bi-award-fill"/>
                                    AACSB Accredited
                                </div>
                                <div class="inner-hero-meta-item">
                                    <i class="bi bi-globe2"/>
                                    130+ Countries
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5 d-none d-lg-block reveal">
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="highlight-card">
                                        <div class="highlight-num">6</div>
                                        <div class="highlight-label o_editable">Schools &amp; Colleges</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="highlight-card">
                                        <div class="highlight-num">98%</div>
                                        <div class="highlight-label o_editable">Graduate Employment</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="highlight-card">
                                        <div class="highlight-num">$400M</div>
                                        <div class="highlight-label o_editable">Research Funding</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="highlight-card">
                                        <div class="highlight-num">50+</div>
                                        <div class="highlight-label o_editable">Research Centers</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university inner hero snippet in the Website Builder. -->
    <template id="university_inner_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_inner_hero"
               string="Inner Hero"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
