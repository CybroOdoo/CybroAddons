<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university distinguished faculty section. -->
    <template id="university_faculty" name="University Distinguished Faculty">
        <section class="section-pad o_colored_level" style="background:var(--bg-light)"
                 data-snippet="theme_university.university_faculty" data-name="Distinguished Faculty">
            <div class="container">
                <div class="d-flex align-items-end justify-content-between mb-5 flex-wrap gap-3 reveal">
                    <div>
                        <div class="section-eyebrow o_editable">Meet Our Scholars</div>
                        <h2 class="section-title mb-0 o_editable">Distinguished Faculty</h2>
                    </div>
                    <a href="/faculty" class="btn btn-outline-primary rounded-pill px-4 fw-semibold"
                       style="font-family:'Inter',sans-serif;font-size:.88rem">View All Faculty
                    </a>
                </div>
                <div class="row g-4">
                    <div class="col-sm-6 col-lg-3 reveal">
                        <div class="faculty-card text-center p-4 bg-white rounded-3 shadow-sm h-100">
                            <img src="/theme_university/static/src/img/avatar-alan.jpg" alt="Dr. Alan Chen"
                                 class="faculty-avatar mb-3 rounded-circle"
                                 style="width:120px;height:120px;object-fit:cover"/>
                            <h6 class="faculty-name fw-bold o_editable">Dr. Alan Chen</h6>
                            <p class="faculty-title text-muted small o_editable">Professor of Artificial Intelligence
                            </p>
                            <span class="faculty-dept badge bg-light text-primary px-3 py-2 rounded-pill o_editable">
                                Engineering &amp; Tech
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3 reveal">
                        <div class="faculty-card text-center p-4 bg-white rounded-3 shadow-sm h-100">
                            <img src="/theme_university/static/src/img/avatar-priya.jpg" alt="Dr. Priya Sharma"
                                 class="faculty-avatar mb-3 rounded-circle"
                                 style="width:120px;height:120px;object-fit:cover"/>
                            <h6 class="faculty-name fw-bold o_editable">Dr. Priya Sharma</h6>
                            <p class="faculty-title text-muted small o_editable">Chair of Biomedical Research</p>
                            <span class="faculty-dept badge bg-light text-primary px-3 py-2 rounded-pill o_editable">
                                Health Sciences
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3 reveal">
                        <div class="faculty-card text-center p-4 bg-white rounded-3 shadow-sm h-100">
                            <img src="/theme_university/static/src/img/avatar-james.jpg" alt="Prof. James Okafor"
                                 class="faculty-avatar mb-3 rounded-circle"
                                 style="width:120px;height:120px;object-fit:cover"/>
                            <h6 class="faculty-name fw-bold o_editable">Prof. James Okafor</h6>
                            <p class="faculty-title text-muted small o_editable">Dean of Business Studies</p>
                            <span class="faculty-dept badge bg-light text-primary px-3 py-2 rounded-pill o_editable">
                                Business &amp; Economics
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3 reveal">
                        <div class="faculty-card text-center p-4 bg-white rounded-3 shadow-sm h-100">
                            <img src="/theme_university/static/src/img/avatar-nadia.jpg" alt="Dr. Nadia Al-Rashid"
                                 class="faculty-avatar mb-3 rounded-circle"
                                 style="width:120px;height:120px;object-fit:cover"/>
                            <h6 class="faculty-name fw-bold o_editable">Dr. Nadia Al-Rashid</h6>
                            <p class="faculty-title text-muted small o_editable">Professor of Climate Science</p>
                            <span class="faculty-dept badge bg-light text-primary px-3 py-2 rounded-pill o_editable">
                                Science &amp; Mathematics
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the faculty snippet in the Website Builder. -->
    <template id="university_faculty_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_faculty"
               string="Distinguished Faculty"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
