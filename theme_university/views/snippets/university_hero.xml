<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university hero banner section. -->
    <template id="university_hero" name="University Hero Banner">
        <section class="hero-section o_colored_level" data-snippet="theme_university.university_hero"
                 data-name="Hero Banner">
            <div class="hero-bg"/>
            <div class="hero-shape hero-shape-1"/>
            <div class="hero-shape hero-shape-2"/>
            <div class="hero-shape hero-shape-3"/>
            <div class="container position-relative" style="z-index:2">
                <div class="hero-inner">
                    <div class="row align-items-center g-5 w-100">
                        <div class="col-lg-12 text-lg-center reveal">
                            <div class="hero-eyebrow o_editable">
                                <i class="bi bi-stars"/>
                                Ranked #1 in Innovation — QS World 2025
                            </div>
                            <h1 class="hero-title o_editable">
                                Shape Your Future<br/>At
                                <span class="accent-line">Axion University</span>
                            </h1>
                            <p class="hero-desc o_editable">
                                Empowering brilliant minds with world-class education, cutting-edge research,
                                and a vibrant global campus community since 1892.
                            </p>
                            <div class="d-flex flex-wrap gap-3 justify-content-lg-center">
                                <a href="/apply" class="btn-hero-primary">
                                    <i class="bi bi-pencil-square"/>
                                    Apply for Fall 2026
                                </a>
                                <a href="#" class="btn-hero-ghost">
                                    <i class="bi bi-play-circle-fill"/>
                                    Virtual Campus Tour
                                </a>
                            </div>
                            <div class="hero-stats-row">
                                <div class="hero-stat-chip">
                                    <span class="stat-num" data-target="48000">48K+</span>
                                    <span class="stat-label o_editable">Students</span>
                                </div>
                                <div class="hero-stat-chip">
                                    <span class="stat-num" data-target="320">320+</span>
                                    <span class="stat-label o_editable">Programs</span>
                                </div>
                                <div class="hero-stat-chip">
                                    <span class="stat-num" data-target="98">98%</span>
                                    <span class="stat-label o_editable">Employment</span>
                                </div>
                                <div class="hero-stat-chip">
                                    <span class="stat-num" data-target="130">130+</span>
                                    <span class="stat-label o_editable">Years</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university hero banner snippet in the Website Builder. -->
    <template id="university_hero_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_hero"
               string="Hero Banner"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
