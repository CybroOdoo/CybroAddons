<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the Academic Calendar and Admission call-to-action snippet. -->
    <template id="university_calendar" name="University Calendar &amp; Admission">
        <section class="section-pad o_colored_level" data-snippet="theme_university.university_calendar"
                 data-name="Academic Calendar &amp; Admission">
            <div class="container">
                <div class="row g-5 align-items-start">
                    <div class="col-lg-5 reveal">
                        <div class="section-eyebrow o_editable">Academic Calendar</div>
                        <h2 class="section-title o_editable">Key Dates for 2025–26</h2>
                        <div class="mt-4">
                            <div class="key-date-row">
                                <div class="key-date-pill" style="background:#e8f0fe;color:#1a3a6b">
                                    <div style="font-size:.9rem;font-weight:900" class="o_editable">01</div>
                                    <div style="font-size:.65rem" class="o_editable">Sep</div>
                                </div>
                                <div>
                                    <div class="key-date-title o_editable">Fall Semester Begins</div>
                                    <div class="key-date-sub o_editable">Orientation week: Aug 26 – 30</div>
                                </div>
                            </div>
                            <div class="key-date-row">
                                <div class="key-date-pill" style="background:#fce8e8;color:#c0392b">
                                    <div style="font-size:.9rem;font-weight:900" class="o_editable">15</div>
                                    <div style="font-size:.65rem" class="o_editable">Jan</div>
                                </div>
                                <div>
                                    <div class="key-date-title o_editable">Scholarship Application Deadline</div>
                                    <div class="key-date-sub o_editable">All merit-based awards</div>
                                </div>
                            </div>
                            <div class="key-date-row">
                                <div class="key-date-pill" style="background:#e6f4ea;color:#1a7a4a">
                                    <div style="font-size:.9rem;font-weight:900" class="o_editable">01</div>
                                    <div style="font-size:.65rem" class="o_editable">Mar</div>
                                </div>
                                <div>
                                    <div class="key-date-title o_editable">Undergraduate Application Deadline</div>
                                    <div class="key-date-sub o_editable">Fall 2026 entry — Regular Decision</div>
                                </div>
                            </div>
                            <div class="key-date-row">
                                <div class="key-date-pill" style="background:#fff8e1;color:#b45309">
                                    <div style="font-size:.9rem;font-weight:900" class="o_editable">15</div>
                                    <div style="font-size:.65rem" class="o_editable">Jan</div>
                                </div>
                                <div>
                                    <div class="key-date-title o_editable">Spring Semester Begins</div>
                                    <div class="key-date-sub o_editable">Late registration closes Jan 20</div>
                                </div>
                            </div>
                            <div class="key-date-row">
                                <div class="key-date-pill" style="background:#f3e8ff;color:#6f42c1">
                                    <div style="font-size:.9rem;font-weight:900" class="o_editable">10</div>
                                    <div style="font-size:.65rem" class="o_editable">May</div>
                                </div>
                                <div>
                                    <div class="key-date-title o_editable">Commencement Ceremony</div>
                                    <div class="key-date-sub o_editable">Main Campus Amphitheater, 10 AM</div>
                                </div>
                            </div>
                        </div>
                        <a href="/calendar" class="btn rounded-pill px-4 mt-4 fw-semibold"
                           style="background:var(--primary);color:white;font-family:'Inter',sans-serif;font-size:.88rem">
                            Download Full Calendar
                        </a>
                    </div>
                    <div class="col-lg-7 reveal">
                        <div class="cta-section rounded-4 p-5 text-center text-white position-relative overflow-hidden"
                             style="background:var(--hero-gradient)">
                            <div style="position:absolute;inset:0;background:url('/theme_university/static/src/img/cta-bg.jpg') center/cover no-repeat;opacity:.06;border-radius:inherit"/>
                            <div style="position:relative;z-index:1">
                                <div class="section-eyebrow d-inline-flex mb-3 o_editable"
                                     style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.3);color:#f5c842">
                                    Applications Open
                                </div>
                                <h3 style="color:white;margin-bottom:.75rem" class="o_editable">Ready to Start Your
                                    Academic Journey?
                                </h3>
                                <p style="font-family:'Inter',sans-serif;font-size:.9rem;color:rgba(255,255,255,.7);margin-bottom:2rem;line-height:1.7"
                                   class="o_editable">
                                    Join a community of 48,000 scholars, innovators, and leaders. Fall 2026 applications
                                    are open — apply today and take the first step.
                                </p>
                                <div class="d-flex flex-wrap gap-3 justify-content-center">
                                    <a href="/apply" class="btn-hero-primary">
                                        <i class="bi bi-pencil-square"/>
                                        Apply Now
                                    </a>
                                    <a href="#" class="btn-hero-ghost">
                                        <i class="bi bi-download"/>
                                        Prospectus
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the Academic Calendar and Admission snippet in the Website Builder. -->
    <template id="university_calendar_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_calendar"
               string="Academic Calendar &amp; Admission"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
