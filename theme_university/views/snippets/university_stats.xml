<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university statistics counters section. -->
    <template id="university_stats" name="University Stats">
        <section class="stats-section o_colored_level" data-snippet="theme_university.university_stats"
                 data-name="Counters">
            <div class="stats-shape-left"/>
            <div class="stats-shape-right"/>
            <div class="container position-relative" style="z-index:2">
                <div class="row g-4">
                    <div class="col-6 col-lg-3">
                        <div class="stat-box">
                            <i class="bi bi-people-fill stat-icon"/>
                            <span class="stat-num" data-target="48000">48,000+</span>
                            <span class="stat-label o_editable">Enrolled Students</span>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="stat-box">
                            <i class="bi bi-person-badge-fill stat-icon"/>
                            <span class="stat-num" data-target="2400">2,400+</span>
                            <span class="stat-label o_editable">Faculty Members</span>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="stat-box">
                            <i class="bi bi-book-fill stat-icon"/>
                            <span class="stat-num" data-target="320">320+</span>
                            <span class="stat-label o_editable">Degree Programs</span>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="stat-box">
                            <i class="bi bi-globe-americas stat-icon"/>
                            <span class="stat-num" data-target="250000">250K+</span>
                            <span class="stat-label o_editable">Alumni Worldwide</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university statistics snippet in the Website Builder. -->
    <template id="university_stats_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_stats"
               string="Counters"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
