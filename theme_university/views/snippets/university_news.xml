<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university news and insights section. -->
    <template id="university_news" name="University News">
        <section class="news-section section-pad o_colored_level" data-snippet="theme_university.university_news"
                 data-name="News &amp; Insights">
            <div class="container">
                <div class="d-flex align-items-end justify-content-between mb-5 flex-wrap gap-3 reveal">
                    <div>
                        <div class="section-eyebrow o_editable">Latest Updates</div>
                        <h2 class="section-title mb-0 o_editable">News &amp; Insights</h2>
                    </div>
                    <a href="/news" class="btn btn-outline-primary rounded-pill px-4 fw-semibold"
                       style="font-family:'Inter',sans-serif;font-size:.88rem">All News
                    </a>
                </div>
                <div class="row g-4">
                    <!-- News 1 -->
                    <div class="col-md-6 col-lg-4 reveal">
                        <div class="news-card h-100">
                            <div class="news-img-wrap">
                                <img src="/theme_university/static/src/img/news-ai.jpg" alt="AI Lab" class="news-img"/>
                            </div>
                            <div class="card-body p-4">
                                <span class="news-category mb-2 d-inline-block"
                                      style="background:#e8f0fe;color:#1a3a6b">Technology
                                </span>
                                <h6 class="news-title o_editable">Axion Opens $50M AI Research Center in Partnership
                                    with MIT
                                </h6>
                                <p class="news-excerpt o_editable">The new center will focus on ethical AI, robotics,
                                    and human-computer interaction research at the frontier of machine intelligence.
                                </p>
                            </div>
                            <div class="news-meta">
                                <img src="/theme_university/static/src/img/avatar-alan.jpg" class="news-author-img"
                                     alt="Dr. Alan Foster"/>
                                <span class="small text-muted o_editable" style="font-family:'Inter',sans-serif">Dr.
                                    Alan Foster
                                </span>
                                <span class="small text-muted ms-auto" style="font-family:'Inter',sans-serif">May 20,
                                    2026
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- News 2 -->
                    <div class="col-md-6 col-lg-4 reveal">
                        <div class="news-card h-100">
                            <div class="news-img-wrap">
                                <img src="/theme_university/static/src/img/news-research.jpg" alt="Research"
                                     class="news-img"/>
                            </div>
                            <div class="card-body p-4">
                                <span class="news-category mb-2 d-inline-block"
                                      style="background:#e6f4ea;color:#1a7a4a">Research
                                </span>
                                <h6 class="news-title o_editable">Scientists Develop Breakthrough Blood Test for Early
                                    Cancer Detection
                                </h6>
                                <p class="news-excerpt o_editable">The new test detects 12 types of cancer with 94%
                                    accuracy from a single blood draw — a potential game-changer for early diagnosis.
                                </p>
                            </div>
                            <div class="news-meta">
                                <img src="/theme_university/static/src/img/avatar-nadia.jpg" class="news-author-img"
                                     alt="Prof. Nadia Chen"/>
                                <span class="small text-muted o_editable" style="font-family:'Inter',sans-serif">Prof.
                                    Nadia Chen
                                </span>
                                <span class="small text-muted ms-auto" style="font-family:'Inter',sans-serif">May 14,
                                    2026
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- News 3 -->
                    <div class="col-md-6 col-lg-4 reveal">
                        <div class="news-card h-100">
                            <div class="news-img-wrap">
                                <img src="/theme_university/static/src/img/news-students.jpg" alt="Students"
                                     class="news-img"/>
                            </div>
                            <div class="card-body p-4">
                                <span class="news-category mb-2 d-inline-block"
                                      style="background:#fff8e1;color:#b45309">Awards
                                </span>
                                <h6 class="news-title o_editable">Axion Ranked #3 Best University for Student Experience
                                    in North America
                                </h6>
                                <p class="news-excerpt o_editable">The Times Higher Education survey highlighted campus
                                    life, mental health support, and career placement services as standouts.
                                </p>
                            </div>
                            <div class="news-meta">
                                <img src="/theme_university/static/src/img/avatar-comm.jpg" class="news-author-img"
                                     alt="Communications"/>
                                <span class="small text-muted o_editable" style="font-family:'Inter',sans-serif">
                                    Communications
                                </span>
                                <span class="small text-muted ms-auto" style="font-family:'Inter',sans-serif">May 8,
                                    2026
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university news and insights snippet in the Website Builder. -->
    <template id="university_news_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_news"
               string="News &amp; Insights"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
