<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university announcement ticker section. -->
    <template id="university_ticker" name="University Ticker">
        <div class="ticker-bar" data-snippet="theme_university.university_ticker" data-name="Announcement Ticker">
            <div class="container d-flex align-items-center gap-3 overflow-hidden ps-0">
                <span class="ticker-label">
                    <i class="bi bi-megaphone-fill me-1"/>Updates
                </span>
                <div class="ticker-text o_editable">
                    <span class="me-5">Applications for Fall 2026 are now open — Apply by March 1st for full scholarship consideration</span>
                    <span class="me-5">New $50M AI &amp; Robotics Research Center inaugurated in partnership with MIT</span>
                    <span class="me-5">Annual Cultural Fest "Mosaic 2026" — Register before May 30th</span>
                    <span class="me-5">Axion ranked #3 for Student Experience in North America</span>
                </div>
            </div>
        </div>
    </template>
    <!-- Register the university announcement ticker snippet in the Website Builder. -->
    <template id="university_ticker_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_ticker"
               string="Announcement Ticker"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
