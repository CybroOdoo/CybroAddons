<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university schools and colleges section. -->
    <template id="university_schools" name="University Schools &amp; Colleges">
        <section class="section-pad o_colored_level" style="background:var(--bg-light)"
                 data-snippet="theme_university.university_schools" data-name="Schools &amp; Colleges">
            <div class="container">
                <div class="page-section-header text-center reveal">
                    <div class="section-eyebrow o_editable">Our Divisions</div>
                    <h2 class="section-title o_editable">Schools &amp; Colleges</h2>
                    <p class="section-subtitle o_editable">Each school is led by world-renowned faculty and designed to
                        deliver transformative education at the intersection of theory and practice.
                    </p>
                </div>
                <div class="row g-4">
                    <!-- Engineering -->
                    <div class="col-sm-6 col-lg-4 reveal">
                        <div class="school-card">
                            <div class="school-card-accent" style="background:linear-gradient(90deg,#1a3a6b,#2352a0)"/>
                            <div class="school-card-body">
                                <div class="school-icon" style="background:#e8f0fe">
                                    <i class="bi bi-cpu-fill" style="color:#1a3a6b"/>
                                </div>
                                <h5 class="o_editable">School of Engineering &amp; Technology</h5>
                                <p class="school-desc o_editable">Cutting-edge programs in computer science, AI,
                                    robotics, electrical engineering, and data science — backed by state-of-the-art labs
                                    and industry partnerships.
                                </p>
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="school-programs-pill o_editable"
                                          style="background:#e8f0fe;color:#1a3a6b">
                                        <i class="bi bi-collection-fill"/>
                                        52 Programs
                                    </span>
                                    <a href="/academics/undergraduate" class="btn btn-sm rounded-pill px-3 fw-semibold"
                                       style="background:var(--primary);color:white;font-family:'Inter',sans-serif;font-size:.75rem">
                                        Explore
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Science -->
                    <div class="col-sm-6 col-lg-4 reveal">
                        <div class="school-card">
                            <div class="school-card-accent" style="background:linear-gradient(90deg,#6f42c1,#9b59b6)"/>
                            <div class="school-card-body">
                                <div class="school-icon" style="background:#f3e8ff">
                                    <i class="bi bi-flask-fill" style="color:#6f42c1"/>
                                </div>
                                <h5 class="o_editable">College of Science &amp; Mathematics</h5>
                                <p class="school-desc o_editable">Rigorous foundations in biology, chemistry, physics,
                                    mathematics, and environmental science, combined with pioneering research
                                    opportunities from year one.
                                </p>
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="school-programs-pill o_editable"
                                          style="background:#f3e8ff;color:#6f42c1">
                                        <i class="bi bi-collection-fill"/>
                                        38 Programs
                                    </span>
                                    <a href="/academics/undergraduate" class="btn btn-sm rounded-pill px-3 fw-semibold"
                                       style="background:#6f42c1;color:white;font-family:'Inter',sans-serif;font-size:.75rem">
                                        Explore
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Business -->
                    <div class="col-sm-6 col-lg-4 reveal">
                        <div class="school-card">
                            <div class="school-card-accent" style="background:linear-gradient(90deg,#b45309,#e8a020)"/>
                            <div class="school-card-body">
                                <div class="school-icon" style="background:#fff8e1">
                                    <i class="bi bi-graph-up-arrow" style="color:#b45309"/>
                                </div>
                                <h5 class="o_editable">School of Business &amp; Economics</h5>
                                <p class="school-desc o_editable">AACSB-accredited programs in finance, marketing,
                                    entrepreneurship, and global economics — developed with Fortune 500 firms and
                                    leading investment banks.
                                </p>
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="school-programs-pill o_editable"
                                          style="background:#fff8e1;color:#b45309">
                                        <i class="bi bi-collection-fill"/>
                                        29 Programs
                                    </span>
                                    <a href="/academics/undergraduate" class="btn btn-sm rounded-pill px-3 fw-semibold"
                                       style="background:#b45309;color:white;font-family:'Inter',sans-serif;font-size:.75rem">
                                        Explore
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Arts -->
                    <div class="col-sm-6 col-lg-4 reveal">
                        <div class="school-card">
                            <div class="school-card-accent" style="background:linear-gradient(90deg,#0277bd,#0288d1)"/>
                            <div class="school-card-body">
                                <div class="school-icon" style="background:#e0f7fa">
                                    <i class="bi bi-palette-fill" style="color:#0277bd"/>
                                </div>
                                <h5 class="o_editable">College of Arts &amp; Humanities</h5>
                                <p class="school-desc o_editable">Architecture, fine arts, international relations,
                                    literature, and philosophy — programs designed to cultivate critical thinking and
                                    global cultural fluency.
                                </p>
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="school-programs-pill o_editable"
                                          style="background:#e0f7fa;color:#0277bd">
                                        <i class="bi bi-collection-fill"/>
                                        45 Programs
                                    </span>
                                    <a href="/academics/undergraduate" class="btn btn-sm rounded-pill px-3 fw-semibold"
                                       style="background:#0277bd;color:white;font-family:'Inter',sans-serif;font-size:.75rem">
                                        Explore
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Health -->
                    <div class="col-sm-6 col-lg-4 reveal">
                        <div class="school-card">
                            <div class="school-card-accent" style="background:linear-gradient(90deg,#c0392b,#e74c3c)"/>
                            <div class="school-card-body">
                                <div class="school-icon" style="background:#fce8e8">
                                    <i class="bi bi-heart-pulse-fill" style="color:#c0392b"/>
                                </div>
                                <h5 class="o_editable">School of Health Sciences</h5>
                                <p class="school-desc o_editable">Pre-medicine, nursing, public health, psychology, and
                                    biomedical research programs supported by our on-campus teaching hospital and
                                    clinical simulation centers.
                                </p>
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="school-programs-pill o_editable"
                                          style="background:#fce8e8;color:#c0392b">
                                        <i class="bi bi-collection-fill"/>
                                        34 Programs
                                    </span>
                                    <a href="/academics/undergraduate" class="btn btn-sm rounded-pill px-3 fw-semibold"
                                       style="background:#c0392b;color:white;font-family:'Inter',sans-serif;font-size:.75rem">
                                        Explore
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Graduate School -->
                    <div class="col-sm-6 col-lg-4 reveal">
                        <div class="school-card">
                            <div class="school-card-accent" style="background:linear-gradient(90deg,#1a7a4a,#27ae60)"/>
                            <div class="school-card-body">
                                <div class="school-icon" style="background:#e6f4ea">
                                    <i class="bi bi-mortarboard-fill" style="color:#1a7a4a"/>
                                </div>
                                <h5 class="o_editable">Graduate School of Advanced Studies</h5>
                                <p class="school-desc o_editable">80+ Masters, 40+ PhD programs, and professional
                                    doctorates across all disciplines. Fully funded research positions and merit-based
                                    fellowships available.
                                </p>
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="school-programs-pill o_editable"
                                          style="background:#e6f4ea;color:#1a7a4a">
                                        <i class="bi bi-collection-fill"/>
                                        122 Programs
                                    </span>
                                    <a href="/academics/graduate" class="btn btn-sm rounded-pill px-3 fw-semibold"
                                       style="background:#1a7a4a;color:white;font-family:'Inter',sans-serif;font-size:.75rem">
                                        Explore
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university schools and colleges snippet in the Website Builder. -->
    <template id="university_schools_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_schools"
               string="Schools &amp; Colleges"
               group="university_academics"/>
        </xpath>
    </template>
</odoo>
