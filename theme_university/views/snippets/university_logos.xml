<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university alumni logos section. -->
    <template id="university_logos" name="University Alumni Logos">
        <section class="logos-bar o_colored_level" data-snippet="theme_university.university_logos"
                 data-name="Alumni Logos">
            <div class="container">
                <p class="logos-label o_editable">Our graduates work at</p>
                <div class="logos-grid">
                    <a href="#" class="logo-item" title="Google">
                        <img src="/theme_university/static/src/img/logos/1.png" alt="Google"/>
                    </a>
                    <a href="#" class="logo-item" title="Microsoft">
                        <img src="/theme_university/static/src/img/logos/2.png" alt="Microsoft"/>
                    </a>
                    <a href="#" class="logo-item" title="Apple">
                        <img src="/theme_university/static/src/img/logos/3.png" alt="Apple"/>
                    </a>
                    <a href="#" class="logo-item" title="Amazon">
                        <img src="/theme_university/static/src/img/logos/4.png" alt="Amazon"/>
                    </a>
                    <a href="#" class="logo-item" title="Goldman Sachs">
                        <img src="/theme_university/static/src/img/logos/5.png" alt="Goldman Sachs"/>
                    </a>
                    <a href="#" class="logo-item" title="McKinsey">
                        <img src="/theme_university/static/src/img/logos/6.png" alt="McKinsey"/>
                    </a>
                    <a href="#" class="logo-item" title="Tesla">
                        <img src="/theme_university/static/src/img/logos/7.png" alt="Tesla"/>
                    </a>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university alumni logos snippet in the Website Builder. -->
    <template id="university_logos_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_logos"
               string="Alumni Logos"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
