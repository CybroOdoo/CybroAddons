<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        University Snippet Groups
        =========================
        Defines page-specific groups in the website builder sidebar.
        Editors can easily locate snippets related to the homepage, academics, or campus life.
    -->
    <template id="university_snippet_groups" inherit_id="website.snippets" name="University Snippet Groups">
        <xpath expr="//snippets[@id='snippet_groups']/*[last()]" position="after">
            <!-- 1. General Sections -->
            <t t-snippet="website.s_snippet_group"
               string="University General"
               snippet-group="university_general"/>
            <!-- 2. Academics Sections -->
            <t t-snippet="website.s_snippet_group"
               string="University Academics"
               snippet-group="university_academics"/>
            <!-- 3. Campus Life Sections -->
            <t t-snippet="website.s_snippet_group"
               string="University Campus Life"
               snippet-group="university_campus_life"/>
        </xpath>
    </template>
</odoo>
