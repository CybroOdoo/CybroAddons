<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university upcoming events section. -->
    <template id="university_events" name="University Events">
        <section class="events-section section-pad o_colored_level" data-snippet="theme_university.university_events"
                 data-name="Upcoming Events">
            <div class="container">
                <div class="d-flex align-items-end justify-content-between mb-5 flex-wrap gap-3 reveal">
                    <div>
                        <div class="section-eyebrow o_editable">What's On</div>
                        <h2 class="section-title mb-0 o_editable">Upcoming Events</h2>
                    </div>
                    <a href="/events" class="btn btn-outline-primary rounded-pill px-4 fw-semibold"
                       style="font-family:'Inter',sans-serif;font-size:.88rem">All Events
                    </a>
                </div>
                <div class="row g-4">
                    <!-- Event 1 -->
                    <div class="col-md-6 col-lg-4 reveal">
                        <div class="event-card h-100">
                            <div class="p-4">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="event-date-box" style="background:#e8f0fe;color:#1a3a6b">
                                        <span class="event-day">15</span>
                                        <span class="event-mon">Jun</span>
                                    </div>
                                    <div>
                                        <span class="event-type-badge" style="background:#e8f0fe;color:#1a3a6b">Open
                                            Day
                                        </span>
                                        <div class="d-flex align-items-center gap-1 text-muted mt-1"
                                             style="font-size:.8rem;font-family:'Inter',sans-serif">
                                            <i class="bi bi-clock"/>
                                            10:00 AM — 4:00 PM
                                        </div>
                                    </div>
                                </div>
                                <h6 class="fw-bold mb-2 o_editable">Annual Open Day &amp; Campus Tours</h6>
                                <p class="small text-muted mb-3 o_editable"
                                   style="font-family:'Inter',sans-serif;line-height:1.65">
                                    Explore our campus, meet faculty, attend info sessions, and discover life at Axion.
                                </p>
                                <div class="d-flex align-items-center gap-2 mb-4 small text-muted o_editable"
                                     style="font-family:'Inter',sans-serif">
                                    <i class="bi bi-geo-alt-fill" style="color:#1a3a6b"/>
                                    Main Campus, West Gate Entrance
                                </div>
                                <a href="#" class="btn btn-sm px-4 rounded-pill fw-semibold"
                                   style="background:linear-gradient(135deg,#1a3a6b,#2352a0);color:white;border:none;font-family:'Inter',sans-serif">
                                    Register Free
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- Event 2 -->
                    <div class="col-md-6 col-lg-4 reveal">
                        <div class="event-card h-100">
                            <div class="p-4">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="event-date-box" style="background:#e6f4ea;color:#1a7a4a">
                                        <span class="event-day">22</span>
                                        <span class="event-mon">Jun</span>
                                    </div>
                                    <div>
                                        <span class="event-type-badge" style="background:#e6f4ea;color:#1a7a4a">
                                            Research
                                        </span>
                                        <div class="d-flex align-items-center gap-1 text-muted mt-1"
                                             style="font-size:.8rem;font-family:'Inter',sans-serif">
                                            <i class="bi bi-clock"/>
                                            9:00 AM — 6:00 PM
                                        </div>
                                    </div>
                                </div>
                                <h6 class="fw-bold mb-2 o_editable">International Research Symposium 2026</h6>
                                <p class="small text-muted mb-3 o_editable"
                                   style="font-family:'Inter',sans-serif;line-height:1.65">
                                    Global researchers presenting breakthroughs in science, technology, and social
                                    sciences.
                                </p>
                                <div class="d-flex align-items-center gap-2 mb-4 small text-muted o_editable"
                                     style="font-family:'Inter',sans-serif">
                                    <i class="bi bi-geo-alt-fill" style="color:#1a7a4a"/>
                                    Innovation Hub, Building C
                                </div>
                                <a href="#" class="btn btn-sm px-4 rounded-pill fw-semibold"
                                   style="background:linear-gradient(135deg,#1a7a4a,#2e9d63);color:white;border:none;font-family:'Inter',sans-serif">
                                    Register Now
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- Event 3 -->
                    <div class="col-md-6 col-lg-4 reveal">
                        <div class="event-card h-100">
                            <div class="p-4">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="event-date-box" style="background:#fff8e1;color:#b45309">
                                        <span class="event-day">30</span>
                                        <span class="event-mon">Jun</span>
                                    </div>
                                    <div>
                                        <span class="event-type-badge" style="background:#fff8e1;color:#b45309">
                                            Cultural
                                        </span>
                                        <div class="d-flex align-items-center gap-1 text-muted mt-1"
                                             style="font-size:.8rem;font-family:'Inter',sans-serif">
                                            <i class="bi bi-clock"/>
                                            All Day Event
                                        </div>
                                    </div>
                                </div>
                                <h6 class="fw-bold mb-2 o_editable">Mosaic 2026 — Annual Cultural Festival</h6>
                                <p class="small text-muted mb-3 o_editable"
                                   style="font-family:'Inter',sans-serif;line-height:1.65">
                                    Celebrate diversity with music, art, food, and performances from 120+ world
                                    cultures.
                                </p>
                                <div class="d-flex align-items-center gap-2 mb-4 small text-muted o_editable"
                                     style="font-family:'Inter',sans-serif">
                                    <i class="bi bi-geo-alt-fill" style="color:#b45309"/>
                                    Central Quad &amp; Amphitheatre
                                </div>
                                <a href="#" class="btn btn-sm px-4 rounded-pill fw-semibold"
                                   style="background:linear-gradient(135deg,#e8a020,#f5c842);color:#0f2347;border:none;font-family:'Inter',sans-serif">
                                    Get Tickets
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university events snippet in the Website Builder. -->
    <template id="university_events_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_events"
               string="Upcoming Events"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
