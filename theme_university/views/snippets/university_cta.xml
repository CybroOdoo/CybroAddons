<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university admissions call-to-action section. -->
    <template id="university_cta" name="University CTA">
        <section class="cta-section o_colored_level" data-snippet="theme_university.university_cta"
                 data-name="Admissions CTA">
            <div class="cta-bg-img"/>
            <div class="cta-shape-1"/>
            <div class="cta-shape-2"/>
            <div class="container position-relative text-center reveal" style="z-index:2">
                <div class="section-eyebrow d-inline-flex o_editable"
                     style="background:rgba(232,160,32,.15);border-color:rgba(232,160,32,.35);color:#f5c842">
                    Applications Open
                </div>
                <h2 class="cta-title o_editable">Ready to Begin Your Journey?</h2>
                <p class="cta-subtitle o_editable">
                    Join 48,000 students from around the world and become part of a legacy of excellence. Fall 2026
                    applications are open now.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="/apply" class="btn-hero-primary">
                        <i class="bi bi-pencil-square"/>
                        Apply Now
                    </a>
                    <a href="#" class="btn-hero-ghost">
                        <i class="bi bi-download"/>
                        Download Prospectus
                    </a>
                    <a href="#" class="btn-hero-ghost">
                        <i class="bi bi-chat-dots-fill"/>
                        Talk to Admissions
                    </a>
                </div>
                <div class="cta-deadline o_editable">
                    <i class="bi bi-calendar-check-fill"/>
                    Application Deadline: March 1, 2026
                    <span class="opacity-40 mx-2">|</span>
                    Scholarship Deadline: January 15, 2026
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university admissions CTA snippet in the Website Builder. -->
    <template id="university_cta_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_cta"
               string="Admissions CTA"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
