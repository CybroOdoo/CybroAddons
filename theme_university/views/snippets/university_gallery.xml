<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university campus gallery section. -->
    <template id="university_gallery" name="University Gallery">
        <section class="gallery-section section-pad o_colored_level" data-snippet="theme_university.university_gallery"
                 data-name="Campus Gallery">
            <div class="container">
                <div class="section-header text-center reveal">
                    <div class="section-eyebrow o_editable">Life at Axion</div>
                    <h2 class="section-title o_editable">Experience Our Campus</h2>
                    <p class="section-subtitle o_editable">A 500-acre campus with world-class facilities, green spaces,
                        and vibrant social hubs.
                    </p>
                </div>
                <div class="row g-3 reveal">
                    <div class="col-md-8">
                        <div class="gallery-item" style="height:340px">
                            <img src="/theme_university/static/src/img/gallery-main.jpg" alt="Main Campus"
                                 class="gallery-img"/>
                            <div class="gallery-overlay">
                                <span class="gallery-caption o_editable"><i class="bi bi-camera-fill me-1"/>Main Campus
                                    — Engineering Plaza
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex flex-column gap-3">
                        <div class="gallery-item flex-fill" style="height:162px">
                            <img src="/theme_university/static/src/img/gallery-library.jpg" alt="Library"
                                 class="gallery-img"/>
                            <div class="gallery-overlay">
                                <span class="gallery-caption o_editable"><i class="bi bi-camera-fill me-1"/>Central
                                    Library
                                </span>
                            </div>
                        </div>
                        <div class="gallery-item flex-fill" style="height:162px">
                            <img src="/theme_university/static/src/img/gallery-lab.jpg" alt="Lab" class="gallery-img"/>
                            <div class="gallery-overlay">
                                <span class="gallery-caption o_editable"><i class="bi bi-camera-fill me-1"/>Science Labs
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="gallery-item" style="height:230px">
                            <img src="/theme_university/static/src/img/gallery-sports.jpg" alt="Athletics"
                                 class="gallery-img"/>
                            <div class="gallery-overlay">
                                <span class="gallery-caption o_editable"><i class="bi bi-camera-fill me-1"/>Athletics
                                    Complex
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="gallery-item" style="height:230px">
                            <img src="/theme_university/static/src/img/gallery-dorm.jpg" alt="Residence"
                                 class="gallery-img"/>
                            <div class="gallery-overlay">
                                <span class="gallery-caption o_editable"><i class="bi bi-camera-fill me-1"/>Student
                                    Residences
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="gallery-item" style="height:230px">
                            <img src="/theme_university/static/src/img/gallery-events.jpg" alt="Events"
                                 class="gallery-img"/>
                            <div class="gallery-overlay">
                                <span class="gallery-caption o_editable"><i class="bi bi-camera-fill me-1"/>Campus
                                    Events
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the campus gallery snippet in the Website Builder. -->
    <template id="university_gallery_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_gallery"
               string="Campus Gallery"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
