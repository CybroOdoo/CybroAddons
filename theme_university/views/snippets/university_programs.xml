<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university programs grid section. -->
    <template id="university_programs" name="University Programs Grid">
        <section class="programs-section section-pad o_colored_level"
                 data-snippet="theme_university.university_programs" data-name="Programs Grid">
            <div class="container">
                <div class="section-header text-center reveal">
                    <div class="section-eyebrow o_editable">Academic Excellence</div>
                    <h2 class="section-title o_editable">Explore Our Programs</h2>
                    <p class="section-subtitle o_editable">Choose from 320+ undergraduate, graduate, and professional
                        programs built to prepare you for tomorrow's challenges.
                    </p>
                </div>
                <!-- Filter tabs -->
                <div class="d-flex justify-content-center mb-5 reveal">
                    <ul class="nav gap-2 filter-tabs flex-wrap justify-content-center" id="programFilterTabs">
                        <li class="nav-item">
                            <button class="nav-link active" data-filter="all">
                                All Programs
                                <span class="tab-count">12</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-filter="stem">
                                STEM
                                <span class="tab-count">4</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-filter="business">
                                Business
                                <span class="tab-count">2</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-filter="arts">
                                Arts &amp; Humanities
                                <span class="tab-count">3</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-filter="health">
                                Health Sciences
                                <span class="tab-count">3</span>
                            </button>
                        </li>
                    </ul>
                </div>
                <!-- Programs count display -->
                <p class="program-filter-status text-center text-muted small mb-4"
                   style="font-family:'Inter',sans-serif">
                    Showing <strong id="programCount">12</strong> programs
                </p>
                <div class="row g-4" id="programGrid">
                    <!-- STEM -->
                    <div class="col-sm-6 col-lg-4 program-item" data-category="stem">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#e8f0fe">
                                <i class="bi bi-cpu" style="color:#1a3a6b"/>
                            </div>
                            <div class="program-category-pill" style="background:#e8f0fe;color:#1a3a6b">STEM</div>
                            <h5 class="fw-bold mb-2 o_editable">Computer Science &amp; AI</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Master algorithms, machine learning, and software engineering with industry-leading
                                faculty and world-class labs.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">120 Seats</span>
                                <span class="program-tag" style="background:#fff8e1;color:#b45309">Top Ranked</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#1a3a6b;border-color:#1a3a6b">Learn More
                            </a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4 program-item" data-category="stem">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#f3e8ff">
                                <i class="bi bi-eyedropper" style="color:#6f42c1"/>
                            </div>
                            <div class="program-category-pill" style="background:#f3e8ff;color:#6f42c1">STEM</div>
                            <h5 class="fw-bold mb-2 o_editable">Biotechnology &amp; Genetics</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Pioneer breakthroughs in genomics, synthetic biology, cell engineering, and therapeutic
                                development.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">90 Seats</span>
                                <span class="program-tag" style="background:#f3e8ff;color:#6f42c1">Research</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#6f42c1;border-color:#6f42c1">Learn More
                            </a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4 program-item" data-category="stem">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#e0f7fa">
                                <i class="bi bi-lightning-charge" style="color:#0277bd"/>
                            </div>
                            <div class="program-category-pill" style="background:#e0f7fa;color:#0277bd">STEM</div>
                            <h5 class="fw-bold mb-2 o_editable">Electrical Engineering</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Design circuits, embedded systems, and power infrastructure that drive modern technology
                                and energy solutions.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">110 Seats</span>
                                <span class="program-tag" style="background:#e0f7fa;color:#0277bd">IEEE Affiliated
                                </span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#0277bd;border-color:#0277bd">Learn More
                            </a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4 program-item" data-category="stem">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#e8f0fe">
                                <i class="bi bi-rocket-takeoff" style="color:#1a3a6b"/>
                            </div>
                            <div class="program-category-pill" style="background:#e8f0fe;color:#1a3a6b">STEM</div>
                            <h5 class="fw-bold mb-2 o_editable">Aerospace Engineering</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Explore aerodynamics, propulsion, and spacecraft design with access to our wind tunnels
                                and simulation labs.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">75 Seats</span>
                                <span class="program-tag" style="background:#fff8e1;color:#b45309">NASA Partner</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#1a3a6b;border-color:#1a3a6b">Learn More
                            </a>
                        </div>
                    </div>
                    <!-- BUSINESS -->
                    <div class="col-sm-6 col-lg-4 program-item" data-category="business">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#e6f4ea">
                                <i class="bi bi-graph-up-arrow" style="color:#1a7a4a"/>
                            </div>
                            <div class="program-category-pill" style="background:#e6f4ea;color:#1a7a4a">Business</div>
                            <h5 class="fw-bold mb-2 o_editable">Business Administration</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Develop leadership skills and business acumen with real-world case studies, mentorship,
                                and internship programs.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">200 Seats</span>
                                <span class="program-tag" style="background:#e0f7fa;color:#0277bd">AACSB</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#1a7a4a;border-color:#1a7a4a">Learn More
                            </a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4 program-item" data-category="business">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#fff8e1">
                                <i class="bi bi-currency-exchange" style="color:#b45309"/>
                            </div>
                            <div class="program-category-pill" style="background:#fff8e1;color:#b45309">Business</div>
                            <h5 class="fw-bold mb-2 o_editable">Finance &amp; Economics</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Analyze markets, manage portfolios, and shape monetary policy with training from Wall
                                Street practitioners.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">150 Seats</span>
                                <span class="program-tag" style="background:#fff8e1;color:#b45309">CFA Track</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#b45309;border-color:#b45309">Learn More
                            </a>
                        </div>
                    </div>
                    <!-- ARTS -->
                    <div class="col-sm-6 col-lg-4 program-item" data-category="arts">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#fff8e1">
                                <i class="bi bi-buildings" style="color:#b45309"/>
                            </div>
                            <div class="program-category-pill" style="background:#fff8e1;color:#b45309">Arts &amp;
                                Humanities
                            </div>
                            <h5 class="fw-bold mb-2 o_editable">Architecture &amp; Design</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Blend creativity with technical precision to design the spaces, cities, and environments
                                of the future.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">5 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">60 Seats</span>
                                <span class="program-tag" style="background:#fff8e1;color:#b45309">Studio-Based</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#b45309;border-color:#b45309">Learn More
                            </a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4 program-item" data-category="arts">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#e0f7fa">
                                <i class="bi bi-globe-americas" style="color:#0277bd"/>
                            </div>
                            <div class="program-category-pill" style="background:#e0f7fa;color:#0277bd">Arts &amp;
                                Humanities
                            </div>
                            <h5 class="fw-bold mb-2 o_editable">International Relations</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Understand global politics, diplomacy, and international law through a rich
                                multidisciplinary lens.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">100 Seats</span>
                                <span class="program-tag" style="background:#e0f7fa;color:#0277bd">Exchange</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#0277bd;border-color:#0277bd">Learn More
                            </a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4 program-item" data-category="arts">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#fce8e8">
                                <i class="bi bi-palette" style="color:#c0392b"/>
                            </div>
                            <div class="program-category-pill" style="background:#fce8e8;color:#c0392b">Arts &amp;
                                Humanities
                            </div>
                            <h5 class="fw-bold mb-2 o_editable">Fine Arts &amp; Media</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Express your vision through painting, digital media, film, and interactive design in our
                                creative studios.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">80 Seats</span>
                                <span class="program-tag" style="background:#fce8e8;color:#c0392b">Portfolio Entry
                                </span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#c0392b;border-color:#c0392b">Learn More
                            </a>
                        </div>
                    </div>
                    <!-- HEALTH -->
                    <div class="col-sm-6 col-lg-4 program-item" data-category="health">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#fce8e8">
                                <i class="bi bi-heart-pulse" style="color:#c0392b"/>
                            </div>
                            <div class="program-category-pill" style="background:#fce8e8;color:#c0392b">Health
                                Sciences
                            </div>
                            <h5 class="fw-bold mb-2 o_editable">Medicine &amp; Health Sciences</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Train with world-class clinicians in state-of-the-art simulation labs and our 1,200-bed
                                teaching hospital.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">5 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">80 Seats</span>
                                <span class="program-tag" style="background:#fce8e8;color:#c0392b">Competitive</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#c0392b;border-color:#c0392b">Learn More
                            </a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4 program-item" data-category="health">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#f3e8ff">
                                <i class="bi bi-diagram-3" style="color:#6f42c1"/>
                            </div>
                            <div class="program-category-pill" style="background:#f3e8ff;color:#6f42c1">Health
                                Sciences
                            </div>
                            <h5 class="fw-bold mb-2 o_editable">Psychology &amp; Neuroscience</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Explore the science of mind and behavior through clinical training, neuroimaging labs,
                                and cognitive research.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">130 Seats</span>
                                <span class="program-tag" style="background:#f3e8ff;color:#6f42c1">Research Led</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#6f42c1;border-color:#6f42c1">Learn More
                            </a>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4 program-item" data-category="health">
                        <div class="program-card card h-100 p-4">
                            <div class="program-icon-wrap" style="background:#e6f4ea">
                                <i class="bi bi-capsule" style="color:#1a7a4a"/>
                            </div>
                            <div class="program-category-pill" style="background:#e6f4ea;color:#1a7a4a">Health
                                Sciences
                            </div>
                            <h5 class="fw-bold mb-2 o_editable">Nursing &amp; Patient Care</h5>
                            <p class="text-muted small mb-3 o_editable"
                               style="font-family:'Inter',sans-serif;line-height:1.65">
                                Build clinical excellence, compassionate care skills, and leadership for modern
                                healthcare environments.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4 o_editable">
                                <span class="program-tag" style="background:#e8f0fe;color:#1a3a6b">4 Years</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">160 Seats</span>
                                <span class="program-tag" style="background:#e6f4ea;color:#1a7a4a">NCLEX Ready</span>
                            </div>
                            <a href="#" class="btn-prog mt-auto" style="color:#1a7a4a;border-color:#1a7a4a">Learn More
                            </a>
                        </div>
                    </div>
                </div>
                <!-- Empty state (hidden by default) -->
                <div class="program-empty d-none text-center py-5" id="programEmpty">
                    <div class="mb-3" style="font-size:3rem;opacity:.3">??</div>
                    <h5>No programs found</h5>
                    <p class="text-muted small" style="font-family:'Inter',sans-serif">Try selecting a different
                        category.
                    </p>
                </div>
                <div class="text-center mt-5 reveal">
                    <a href="/academics/undergraduate" class="btn btn-primary px-5 py-3 rounded-pill fw-semibold"
                       style="font-family:'Inter',sans-serif;background:linear-gradient(135deg,#1a3a6b,#2352a0);border:none">
                        View All 320+ Programs
                    </a>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university programs grid snippet in the Website Builder. -->
    <template id="university_programs_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_programs"
               string="Programs Grid"
               group="university_academics"/>
        </xpath>
    </template>
</odoo>
