<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university why choose us section. -->
    <template id="university_why_us" name="University Why Us">
        <section class="why-section section-pad o_colored_level" data-snippet="theme_university.university_why_us"
                 data-name="Why Choose Us">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-5 reveal">
                        <div class="why-image-wrap">
                            <div class="why-dots"/>
                            <img src="/theme_university/static/src/img/campus-life.jpg" alt="Campus Life"
                                 class="img-fluid"/>
                            <div class="why-badge-card">
                                <div class="why-badge-num">130+</div>
                                <div class="why-badge-label o_editable">Years of Excellence</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-7 reveal">
                        <div class="section-eyebrow o_editable">Why Axion?</div>
                        <h2 class="section-title o_editable">A Legacy of Academic<br/>Excellence &amp; Innovation
                        </h2>
                        <p class="mb-4 o_editable" style="font-family:'Inter',sans-serif;color:#6b7280;line-height:1.8">
                            At Axion University, we believe education is more than a degree — it's a transformation.
                            Our holistic approach combines rigorous academics, hands-on research, global exposure, and
                            powerful industry networks.
                        </p>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="feature-item d-flex gap-3">
                                    <div class="feature-icon" style="background:#e8f0fe">
                                        <i class="bi bi-award-fill" style="color:#1a3a6b"/>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-1 o_editable"
                                            style="font-family:'Inter',sans-serif;font-size:.95rem">World-Class Faculty
                                        </h6>
                                        <p class="mb-0 small text-muted o_editable"
                                           style="font-family:'Inter',sans-serif;line-height:1.6">2,400+ faculty
                                            including Nobel laureates and Fulbright scholars.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="feature-item d-flex gap-3">
                                    <div class="feature-icon" style="background:#e6f4ea">
                                        <i class="bi bi-briefcase-fill" style="color:#1a7a4a"/>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-1 o_editable"
                                            style="font-family:'Inter',sans-serif;font-size:.95rem">98% Career Placement
                                        </h6>
                                        <p class="mb-0 small text-muted o_editable"
                                           style="font-family:'Inter',sans-serif;line-height:1.6">500+ recruiting
                                            partners including Fortune 500 companies.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="feature-item d-flex gap-3">
                                    <div class="feature-icon" style="background:#fff8e1">
                                        <i class="bi bi-globe2" style="color:#b45309"/>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-1 o_editable"
                                            style="font-family:'Inter',sans-serif;font-size:.95rem">Global Network
                                        </h6>
                                        <p class="mb-0 small text-muted o_editable"
                                           style="font-family:'Inter',sans-serif;line-height:1.6">Partnerships with 200+
                                            universities across 60 countries.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="feature-item d-flex gap-3">
                                    <div class="feature-icon" style="background:#fce8e8">
                                        <i class="bi bi-bank2" style="color:#c0392b"/>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-1 o_editable"
                                            style="font-family:'Inter',sans-serif;font-size:.95rem">$120M+ Scholarships
                                        </h6>
                                        <p class="mb-0 small text-muted o_editable"
                                           style="font-family:'Inter',sans-serif;line-height:1.6">Financial aid awarded
                                            annually to deserving students.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university why choose us snippet in the Website Builder. -->
    <template id="university_why_us_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_why_us"
               string="Why Choose Us"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
