<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Render the university quick links band section. -->
    <template id="university_quick_links" name="University Quick Links Band">
        <section style="background:var(--primary-dark);padding:2.5rem 0"
                 data-snippet="theme_university.university_quick_links" data-name="Quick Links Band">
            <div class="container">
                <div class="row g-3 align-items-center text-center text-md-start">
                    <div class="col-md-3 col-6 reveal">
                        <a href="/academics/undergraduate"
                           class="d-flex flex-column flex-md-row align-items-center gap-2 text-decoration-none"
                           style="color:white">
                            <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                <i class="bi bi-book-fill" style="color:var(--accent-light)"/>
                            </div>
                            <div style="font-family:'Inter',sans-serif">
                                <div style="font-size:.7rem;color:rgba(255,255,255,.5);font-weight:700;letter-spacing:.05em;text-transform:uppercase"
                                     class="o_editable">Explore
                                </div>
                                <div style="font-size:.9rem;font-weight:700" class="o_editable">Undergraduate</div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3 col-6 reveal">
                        <a href="/academics/graduate"
                           class="d-flex flex-column flex-md-row align-items-center gap-2 text-decoration-none"
                           style="color:white">
                            <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                <i class="bi bi-award-fill" style="color:var(--accent-light)"/>
                            </div>
                            <div style="font-family:'Inter',sans-serif">
                                <div style="font-size:.7rem;color:rgba(255,255,255,.5);font-weight:700;letter-spacing:.05em;text-transform:uppercase"
                                     class="o_editable">Explore
                                </div>
                                <div style="font-size:.9rem;font-weight:700" class="o_editable">Graduate &amp; PhD</div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3 col-6 reveal">
                        <a href="/academics/online-learning"
                           class="d-flex flex-column flex-md-row align-items-center gap-2 text-decoration-none"
                           style="color:white">
                            <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                <i class="bi bi-laptop-fill" style="color:var(--accent-light)"/>
                            </div>
                            <div style="font-family:'Inter',sans-serif">
                                <div style="font-size:.7rem;color:rgba(255,255,255,.5);font-weight:700;letter-spacing:.05em;text-transform:uppercase"
                                     class="o_editable">Explore
                                </div>
                                <div style="font-size:.9rem;font-weight:700" class="o_editable">Online Learning</div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3 col-6 reveal">
                        <a href="/research"
                           class="d-flex flex-column flex-md-row align-items-center gap-2 text-decoration-none"
                           style="color:white">
                            <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                <i class="bi bi-microscope" style="color:var(--accent-light)"/>
                            </div>
                            <div style="font-family:'Inter',sans-serif">
                                <div style="font-size:.7rem;color:rgba(255,255,255,.5);font-weight:700;letter-spacing:.05em;text-transform:uppercase"
                                     class="o_editable">Explore
                                </div>
                                <div style="font-size:.9rem;font-weight:700" class="o_editable">Research Centers</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- Register the university quick links band snippet in the Website Builder. -->
    <template id="university_quick_links_snippet" inherit_id="website.snippets" priority="16">
        <xpath expr="//snippets[@id='snippet_structure']/*[last()]" position="after">
            <t t-snippet="theme_university.university_quick_links"
               string="Quick Links Band"
               group="university_general"/>
        </xpath>
    </template>
</odoo>
