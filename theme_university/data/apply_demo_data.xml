<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Admission Requirements -->
        <!-- Requirement: Common App -->
        <record id="req_common_app" model="university.admission.requirement">
            <field name="name">Completed Common App or Axion Portal</field>
            <field name="sequence">10</field>
        </record>
        <!-- Requirement: High School Transcript -->
        <record id="req_transcript_hs" model="university.admission.requirement">
            <field name="name">Official high school transcript</field>
            <field name="sequence">20</field>
        </record>
        <!-- Requirement: Test Scores -->
        <record id="req_test_scores" model="university.admission.requirement">
            <field name="name">SAT / ACT scores (optional)</field>
            <field name="sequence">30</field>
        </record>
        <!-- Requirement: Teacher Recommendations -->
        <record id="req_recommendation_teacher" model="university.admission.requirement">
            <field name="name">2 teacher recommendations</field>
            <field name="sequence">40</field>
        </record>
        <!-- Requirement: Counselor Recommendation -->
        <record id="req_recommendation_counselor" model="university.admission.requirement">
            <field name="name">School counselor recommendation</field>
            <field name="sequence">50</field>
        </record>
        <!-- Requirement: Personal Essay -->
        <record id="req_essay" model="university.admission.requirement">
            <field name="name">Personal essay (650 words)</field>
            <field name="sequence">60</field>
        </record>
        <!-- Requirement: Activities List -->
        <record id="req_activities" model="university.admission.requirement">
            <field name="name">Activities list</field>
            <field name="sequence">70</field>
        </record>
        <!-- Requirement: Application Fee / Waiver -->
        <record id="req_fee_waiver" model="university.admission.requirement">
            <field name="name">$75 application fee or fee waiver</field>
            <field name="sequence">80</field>
        </record>
        <!-- Requirement: Graduate Application -->
        <record id="req_grad_app" model="university.admission.requirement">
            <field name="name">Online graduate application</field>
            <field name="sequence">90</field>
        </record>
        <!-- Requirement: College Transcript -->
        <record id="req_transcript_college" model="university.admission.requirement">
            <field name="name">Bachelor's degree transcript (official)</field>
            <field name="sequence">100</field>
        </record>
        <!-- Requirement: Optional Test Scores -->
        <record id="req_test_scores_optional" model="university.admission.requirement">
            <field name="name">GRE scores (optional for most)</field>
            <field name="sequence">110</field>
        </record>
        <!-- Requirement: Graduate Recommendations -->
        <record id="req_recommendation_grad" model="university.admission.requirement">
            <field name="name">3 letters of recommendation</field>
            <field name="sequence">120</field>
        </record>
        <!-- Requirement: Statement of Purpose -->
        <record id="req_sop" model="university.admission.requirement">
            <field name="name">Statement of purpose (1–2 pages)</field>
            <field name="sequence">130</field>
        </record>
        <!-- Requirement: CV / Resume -->
        <record id="req_cv" model="university.admission.requirement">
            <field name="name">CV / résumé</field>
            <field name="sequence">140</field>
        </record>
        <!-- Requirement: Writing Sample -->
        <record id="req_writing_sample" model="university.admission.requirement">
            <field name="name">Writing sample (some programs)</field>
            <field name="sequence">150</field>
        </record>
        <!-- Requirement: Graduate Fee -->
        <record id="req_fee_grad" model="university.admission.requirement">
            <field name="name">$85 application fee</field>
            <field name="sequence">160</field>
        </record>
        <!-- Requirement: All College Transcripts -->
        <record id="req_transcript_all_college" model="university.admission.requirement">
            <field name="name">College transcripts (all institutions)</field>
            <field name="sequence">170</field>
        </record>
        <!-- Requirement: Transfer High School Transcript -->
        <record id="req_transcript_hs_transfer" model="university.admission.requirement">
            <field name="name">High school transcript</field>
            <field name="sequence">180</field>
        </record>
        <!-- Requirement: Dean's Report -->
        <record id="req_dean_report" model="university.admission.requirement">
            <field name="name">Dean's / registrar's report</field>
            <field name="sequence">190</field>
        </record>
        <!-- Requirement: Transfer Essay -->
        <record id="req_essay_transfer" model="university.admission.requirement">
            <field name="name">Transfer essay (500 words)</field>
            <field name="sequence">200</field>
        </record>
        <!-- Requirement: Academic Recommendation -->
        <record id="req_recommendation_academic" model="university.admission.requirement">
            <field name="name">1 academic recommendation</field>
            <field name="sequence">210</field>
        </record>
        <!-- Requirement: Minimum GPA -->
        <record id="req_gpa" model="university.admission.requirement">
            <field name="name">Min. GPA of 3.0 recommended</field>
            <field name="sequence">220</field>
        </record>
        <!-- Requirement: TOEFL / IELTS -->
        <record id="req_toefl" model="university.admission.requirement">
            <field name="name">TOEFL ≥ 100 or IELTS ≥ 7.0</field>
            <field name="sequence">230</field>
        </record>
        <!-- Requirement: Certified Translation -->
        <record id="req_translation" model="university.admission.requirement">
            <field name="name">Certified translated transcripts</field>
            <field name="sequence">240</field>
        </record>
        <!-- Requirement: Credential Evaluation -->
        <record id="req_eval" model="university.admission.requirement">
            <field name="name">Credential evaluation (WES or NACES)</field>
            <field name="sequence">250</field>
        </record>
        <!-- Requirement: Financial Support -->
        <record id="req_financial" model="university.admission.requirement">
            <field name="name">Financial support documentation</field>
            <field name="sequence">260</field>
        </record>
        <!-- Requirement: Passport Copy -->
        <record id="req_passport" model="university.admission.requirement">
            <field name="name">Passport copy</field>
            <field name="sequence">270</field>
        </record>
        <!-- Requirement: Visa Support -->
        <record id="req_visa" model="university.admission.requirement">
            <field name="name">Visa support from International Office</field>
            <field name="sequence">280</field>
        </record>
        <!-- Application Types -->
        <!-- Application Type: Freshman -->
        <record id="type_freshman" model="university.application.type">
            <field name="name">Freshman / First-Year</field>
            <field name="target_audience">High school seniors &amp; recent graduates</field>
            <field name="description">Apply for a bachelor's degree program if you have not yet enrolled in a college or university after high school. Axion considers your academics, character, and potential holistically.</field>
            <field name="icon_class">bi-mortarboard-fill</field>
            <field name="color_bg">#e8f0fe</field>
            <field name="color_text">#1a3a6b</field>
            <field name="application_fee">$75</field>
            <field name="requirement_ids" eval="[(6, 0, [ref('req_common_app'), ref('req_transcript_hs'), ref('req_test_scores'), ref('req_recommendation_teacher'), ref('req_recommendation_counselor'), ref('req_essay'), ref('req_activities'), ref('req_fee_waiver')])]"/>
            <field name="cta_text">Apply as Freshman</field>
            <field name="cta_url">#how-to-apply</field>
            <field name="sequence">10</field>
        </record>
        <!-- Application Type: Graduate -->
        <record id="type_graduate" model="university.application.type">
            <field name="name">Graduate (Master's &amp; PhD)</field>
            <field name="target_audience">Bachelor's degree holders</field>
            <field name="description">Advance your expertise with one of 120+ graduate programs. Most PhD applicants are considered for full funding including tuition waiver and annual stipend.</field>
            <field name="icon_class">bi-award-fill</field>
            <field name="color_bg">rgba(232,160,32,.1)</field>
            <field name="color_text">var(--accent)</field>
            <field name="application_fee">$85</field>
            <field name="requirement_ids" eval="[(6, 0, [ref('req_grad_app'), ref('req_transcript_college'), ref('req_test_scores_optional'), ref('req_recommendation_grad'), ref('req_sop'), ref('req_cv'), ref('req_writing_sample'), ref('req_fee_grad')])]"/>
            <field name="cta_text">Apply for Graduate</field>
            <field name="cta_url">#how-to-apply</field>
            <field name="sequence">20</field>
        </record>
        <!-- Application Type: Transfer -->
        <record id="type_transfer" model="university.application.type">
            <field name="name">Transfer Student</field>
            <field name="target_audience">Currently enrolled at another college</field>
            <field name="description">Transfer to Axion after completing coursework at another college or university. Axion accepts up to 60 transfer credits and has guaranteed transfer pathways from 30+ community colleges.</field>
            <field name="icon_class">bi-arrow-left-right</field>
            <field name="color_bg">rgba(26,122,74,.1)</field>
            <field name="color_text">#1a7a4a</field>
            <field name="application_fee">$75</field>
            <field name="requirement_ids" eval="[(6, 0, [ref('req_transcript_all_college'), ref('req_transcript_hs_transfer'), ref('req_dean_report'), ref('req_essay_transfer'), ref('req_recommendation_academic'), ref('req_gpa')])]"/>
            <field name="cta_text">Apply as Transfer</field>
            <field name="cta_url">#how-to-apply</field>
            <field name="sequence">30</field>
        </record>
        <!-- Application Type: International -->
        <record id="type_international" model="university.application.type">
            <field name="name">International Student</field>
            <field name="target_audience">Non-US citizens &amp; permanent residents</field>
            <field name="description">Axion welcomes students from 130+ countries. International students receive the same holistic review, and need-based financial aid is available regardless of citizenship.</field>
            <field name="icon_class">bi-globe2</field>
            <field name="color_bg">#f3e8ff</field>
            <field name="color_text">#6f42c1</field>
            <field name="application_fee">$75</field>
            <field name="requirement_ids" eval="[(6, 0, [ref('req_toefl'), ref('req_translation'), ref('req_eval'), ref('req_financial'), ref('req_passport'), ref('req_visa')])]"/>
            <field name="cta_text">Apply as International</field>
            <field name="cta_url">#how-to-apply</field>
            <field name="sequence">40</field>
        </record>
        <!-- Admission Rounds -->
        <!-- Admission Round: Early Decision I -->
        <record id="round_ed1" model="university.admission.round">
            <field name="name">Early Decision I</field>
            <field name="deadline_date_str">Nov 1, 2025</field>
            <field name="decision_date_str">Dec 15, 2025</field>
            <field name="notes">Binding — strongest signal of interest</field>
            <field name="is_binding">True</field>
            <field name="sequence">10</field>
        </record>
        <!-- Admission Round: Early Decision II -->
        <record id="round_ed2" model="university.admission.round">
            <field name="name">Early Decision II</field>
            <field name="deadline_date_str">Jan 15, 2026</field>
            <field name="decision_date_str">Feb 15, 2026</field>
            <field name="notes">Binding — second chance early option</field>
            <field name="is_binding">True</field>
            <field name="sequence">20</field>
        </record>
        <!-- Admission Round: Regular Decision -->
        <record id="round_rd" model="university.admission.round">
            <field name="name">Regular Decision</field>
            <field name="deadline_date_str">Mar 1, 2026</field>
            <field name="decision_date_str">Apr 1, 2026</field>
            <field name="notes">Non-binding; most applicants</field>
            <field name="is_binding">False</field>
            <field name="sequence">30</field>
        </record>
        <!-- Admission Round: Transfer -->
        <record id="round_transfer" model="university.admission.round">
            <field name="name">Transfer (Fall)</field>
            <field name="deadline_date_str">Apr 1, 2026</field>
            <field name="decision_date_str">May 15, 2026</field>
            <field name="notes">For students currently enrolled</field>
            <field name="is_binding">False</field>
            <field name="sequence">40</field>
        </record>
        <!-- Admission Round: Graduate -->
        <record id="round_graduate" model="university.admission.round">
            <field name="name">Graduate Programs</field>
            <field name="deadline_date_str">Varies</field>
            <field name="decision_date_str">Rolling</field>
            <field name="notes">Check individual program pages</field>
            <field name="is_binding">False</field>
            <field name="sequence">50</field>
        </record>
        <!-- Admissions FAQs -->
        <!-- FAQ: SAT/ACT Scores -->
        <record id="faq_1" model="university.faq">
            <field name="question">What are the average SAT/ACT scores for admitted students?</field>
            <field name="answer">&lt;p&gt;Axion is fully test-optional for Fall 2026. If you choose to submit scores, our middle 50% ranges are 1420-1540 for the SAT and 32-35 for the ACT. We super-score both tests.&lt;/p&gt;</field>
            <field name="sequence">10</field>
        </record>
        <!-- FAQ: Application Fee Waiver -->
        <record id="faq_2" model="university.faq">
            <field name="question">Can the application fee be waived?</field>
            <field name="answer">&lt;p&gt;Yes. Fee waivers are automatically granted if you apply through the Common Application and meet their financial eligibility criteria, or if you request a counselor waiver in the Axion Portal due to financial hardship.&lt;/p&gt;</field>
            <field name="sequence">20</field>
        </record>
        <!-- FAQ: Early Decision -->
        <record id="faq_3" model="university.faq">
            <field name="question">How do binding Early Decision rounds work?</field>
            <field name="answer">&lt;p&gt;If you apply Early Decision (I or II), you sign an agreement stating that if admitted to Axion, you will withdraw all other applications and enroll. Financial aid packages are sent alongside admissions decisions.&lt;/p&gt;</field>
            <field name="sequence">30</field>
        </record>
        <!-- FAQ: International Financial Aid -->
        <record id="faq_4" model="university.faq">
            <field name="question">Do you offer financial aid for international students?</field>
            <field name="answer">&lt;p&gt;Yes, international applicants are eligible for both need-based financial aid and merit scholarships on the same basis as domestic students. Submit the CSS Profile with your application.&lt;/p&gt;</field>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
