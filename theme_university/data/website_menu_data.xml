            <field name="sequence" type="int">20</field>
        </record>
        <!-- Athletics -->
        <record id="menu_athletics" model="website.menu">
            <field name="name">Athletics</field>
            <field name="url">/athletics</field>
            <field name="parent_id" ref="menu_campus_life"/>
            <field name="sequence" type="int">30</field>
        </record>
        <!-- Health &amp; Wellness -->
        <record id="menu_health_wellness" model="website.menu">
            <field name="name">Health &amp; Wellness</field>
            <field name="url">/health-wellness</field>
            <field name="parent_id" ref="menu_campus_life"/>
            <field name="sequence" type="int">40</field>
        </record>
        <!-- Menu for Research page -->
        <record id="menu_research" model="website.menu">
            <field name="name">Research</field>
            <field name="url">/research</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">40</field>
        </record>
