<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define the default website menus for the university theme. -->
    <data>
        <!-- Home is automatically managed by Odoo, but we'll ensure sequence is correct if needed -->
        <!-- Create the Academics website menu. -->
        <record id="simple_theme_menu_academics" model="theme.website.menu">
            <field name="name">Academics</field>
            <field name="url">/academics</field>
            <field name="sequence" type="int">20</field>
        </record>
        <!-- Create the Campus Life website menu. -->
        <record id="simple_theme_menu_campus_life" model="theme.website.menu">
            <field name="name">Campus Life</field>
            <field name="url">/campus-life</field>
            <field name="sequence" type="int">30</field>
        </record>
        <!-- Create the Research website menu. -->
        <record id="simple_theme_menu_research" model="theme.website.menu">
            <field name="name">Research</field>
            <field name="url">/research</field>
            <field name="sequence" type="int">40</field>
        </record>
        <!-- Create the About website menu. -->
        <record id="simple_theme_menu_about" model="theme.website.menu">
            <field name="name">About</field>
            <field name="url">/about</field>
            <field name="sequence" type="int">50</field>
        </record>
        <!-- Create the Events website menu. -->
        <record id="simple_theme_menu_events" model="theme.website.menu">
            <field name="name">Events</field>
            <field name="url">/events</field>
            <field name="sequence" type="int">60</field>
        </record>
        <!-- Remove native website_event menu -->
        <delete model="website.menu" search="[('url', '=', '/event')]"/>
    </data>
</odoo>
