<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Delete default Contact menu if present to prevent duplicate links -->
        <delete model="website.menu" search="[('url', 'in', ['/contactus', '/contact-us', '/contact'])]"/>
        <!-- Delete default Events menu if present to prevent duplicate links -->
        <delete model="website.menu" search="[('url', 'in', ['/event', '/events'])]"/>
        <!-- Menu for Academics page -->
        <record id="menu_academics" model="website.menu">
            <field name="name">Academics</field>
            <field name="url">/academics</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">20</field>
        </record>
        <!-- Sub-menus for Academics -->
        <record id="menu_undergraduate" model="website.menu">
            <field name="name">Undergraduate Programs</field>
            <field name="url">/undergraduate</field>
            <field name="parent_id" ref="menu_academics"/>
            <field name="sequence" type="int">10</field>
        </record>
        <!-- Graduate Programs -->
        <record id="menu_graduate" model="website.menu">
            <field name="name">Graduate Programs</field>
            <field name="url">/graduate</field>
            <field name="parent_id" ref="menu_academics"/>
            <field name="sequence" type="int">20</field>
        </record>
        <!-- Online Learning -->
        <record id="menu_online_learning" model="website.menu">
            <field name="name">Online Learning</field>
            <field name="url">/online-learning</field>
            <field name="parent_id" ref="menu_academics"/>
            <field name="sequence" type="int">30</field>
        </record>
        <!-- Research Centers -->
        <record id="menu_research_centers" model="website.menu">
            <field name="name">Research Centers</field>
            <field name="url">/research-centers</field>
            <field name="parent_id" ref="menu_academics"/>
            <field name="sequence" type="int">40</field>
        </record>
        <!-- Menu for Campus Life page -->
