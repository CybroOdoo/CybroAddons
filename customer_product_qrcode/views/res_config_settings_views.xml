<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Settings form view-->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.inherit.qr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <div id="setup_qrcode">
                    <block title="Setup QR Code" id="setup_qrcode_block">
                        <setting id="customer_product_prefix_setting"
                            string="Prefixes"
                            help="Set your unique customer and product QR prefixes.">
                            <div class="content-group">
                                <div class="mt16 row">
                                    <label for="customer_prefix"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="customer_prefix" class="oe_inline"/>
                                </div>
                                <div class="mt8 row">
                                    <label for="product_prefix"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="product_prefix" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
