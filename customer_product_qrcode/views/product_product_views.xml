<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Product form view-->
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form.qr.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_generate_qr" type="object" class="oe_stat_button"
                        icon="fa-qrcode">
                    <field name="qr_sequence" invisible="True"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Generate QR</span>
                    </div>
                </button>
            </div>
            <field name="categ_id" position="after">
                <field name="qr_sequence"/>
            </field>
        </field>
    </record>
</odoo>
