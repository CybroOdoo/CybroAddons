<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--        report template-->
        <template id="customer_qr_template">
            <t t-call="web.html_container">
                <t t-foreach="data" t-as="records">
                    <t t-foreach="records" t-as="record">
                        <t t-call="web.basic_layout">
                            <style>
                                .qr-badge-container {
                                    width: 100%;
                                    text-align: center;
                                    margin-top: 15px;
                                }
                                .qr-table {
                                    width: 300px;
                                    margin: 0 auto;
                                    border: 2px solid #222 !important;
                                    border-collapse: collapse !important;
                                    text-align: center;
                                    background: #fff;
                                }
                                .qr-header-cell {
                                    border: 2px solid #222 !important;
                                    border-bottom: 2px solid #222 !important;
                                    font-size: 18px;
                                    font-weight: 500;
                                    color: #111;
                                    padding: 10px 5px !important;
                                    text-align: center;
                                }
                                .qr-body-cell {
                                    border: 2px solid #222 !important;
                                    padding: 16px 12px 14px 12px !important;
                                    text-align: center;
                                }
                                .qr-image {
                                    width: 200px;
                                    height: 200px;
                                    display: block;
                                    margin: 0 auto 10px auto;
                                }
                                .qr-sequence {
                                    font-size: 18px;
                                    font-weight: 600;
                                    color: #111;
                                    margin-top: 8px;
                                    display: block;
                                    letter-spacing: 1px;
                                }
                            </style>
                            <div class="page">
                                <div class="qr-badge-container">
                                    <table class="qr-table">
                                        <tr>
                                            <td class="qr-header-cell">
                                                <span t-out="record.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="qr-body-cell">
                                                <img class="qr-image"
                                                    t-if="record.qr"
                                                    alt="QR Code"
                                                    t-att-src="image_data_uri(
                                                        record.qr
                                                    )"/>
                                                <span class="qr-sequence"
                                                    t-out="record.qr_sequence if record._name == 'product.product' else record.sequence"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
