<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit ODS Cached Organisation form view to show the Linked Welsh LHB field -->
    <record id="view_nhs_ods_organisation_form_inherit_uk_regions" model="ir.ui.view">
        <field name="name">nhs.ods.organisation.form.inherit.uk.regions</field>
        <field name="model">nhs.ods.organisation</field>
        <field name="inherit_id" ref="odoo_nhs_ods_sync.view_nhs_ods_organisation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='health_board_id']" position="after">
                <field name="welsh_lhb_id"/>
            </xpath>
        </field>
    </record>
</odoo>
