<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit user form view to manage permissions/restrictions for Welsh LHBs and regions -->
    <record id="view_users_form_inherit_uk_regions" model="ir.ui.view">

        <field name="name">res.users.form.inherit.uk.regions</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="odoo_nhs_trust_management.view_users_form_inherit_nhs_trust"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='nhs_allowed_health_board_ids']" position="after">
                <field name="nhs_allowed_welsh_lhb_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       help="Welsh LHBs this user may see trusts for. Empty = no Welsh access."/>
                <field name="nhs_allowed_region_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       help="Primarily for NI users. Add 'Northern Ireland' to grant access to all NI HSC Trusts."/>
            </xpath>
        </field>
    </record>
</odoo>
