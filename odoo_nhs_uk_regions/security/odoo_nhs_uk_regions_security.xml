<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Update NHS Trust user scoping rule to include Welsh LHB and Region -->
        <record id="odoo_nhs_trust_management.rule_nhs_trust_user_scoping" model="ir.rule">
            <field name="name">NHS Trust User Allowed Scope Only (UK Regions)</field>
            <field name="model_id" ref="odoo_nhs_trust_management.model_nhs_trust"/>
            <field name="groups" eval="[(4, ref('odoo_nhs_trust_management.group_nhs_trust_user'))]"/>
            <field name="domain_force">['|', '|', '|',
                '&amp;', ('health_system', '=', 'nhs_england'), ('icb_id', 'in', user.nhs_allowed_icb_ids.ids),
                '&amp;', ('health_system', '=', 'nhs_scotland'), ('health_board_id', 'in', user.nhs_allowed_health_board_ids.ids),
                '&amp;', ('health_system', '=', 'nhs_wales'), ('welsh_lhb_id', 'in', user.nhs_allowed_welsh_lhb_ids.ids),
                ('region_id', 'in', user.nhs_allowed_region_ids.ids)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Update NHS Trust state log user scoping rule -->
        <record id="odoo_nhs_trust_management.rule_nhs_trust_state_log_user_scoping" model="ir.rule">
            <field name="name">NHS Trust State Log User Allowed Scope Only (UK Regions)</field>
            <field name="model_id" ref="odoo_nhs_trust_management.model_nhs_trust_state_log"/>
            <field name="groups" eval="[(4, ref('odoo_nhs_trust_management.group_nhs_trust_user'))]"/>
            <field name="domain_force">['|', '|', '|',
                '&amp;', ('trust_id.health_system', '=', 'nhs_england'), ('trust_id.icb_id', 'in', user.nhs_allowed_icb_ids.ids),
                '&amp;', ('trust_id.health_system', '=', 'nhs_scotland'), ('trust_id.health_board_id', 'in', user.nhs_allowed_health_board_ids.ids),
                '&amp;', ('trust_id.health_system', '=', 'nhs_wales'), ('trust_id.welsh_lhb_id', 'in', user.nhs_allowed_welsh_lhb_ids.ids),
                ('trust_id.region_id', 'in', user.nhs_allowed_region_ids.ids)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
