<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the create gate pass wizard view. -->
    <record id="view_create_gate_pass_wizard_form" model="ir.ui.view">
        <field name="name">oil.gate.pass.create.wizard.form</field>
        <field name="model">oil.gate.pass.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Gate Pass">
                <group>
                    <group>
                        <field name="picking_id" readonly="1"/>
                        <field name="date"/>
                        <field name="gate_pass_type"/>
                        <field name="partner_id"/>
                        <field name="transporter_id"/>
                        <field name="sale_order_id"/>
                        <field name="purchase_order_id"/>
                    </group>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="vehicle_number"/>
                        <field name="driver_name"/>
                        <field name="gate_in_time"/>
                        <field name="gate_out_time"/>
                        <field name="security_check"/>
                    </group>
                </group>
                <notebook>
                    <page string="Products">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                            </list>
                        </field>
                    </page>
                    <page string="Measurements">
                        <group>
                            <group>
                                <field name="source_location_id"/>
                                <field name="destination_location_id"/>
                                <field name="density"/>
                                <field name="temperature"/>
                                <field name="pressure"/>
                            </group>
                            <group>
                                <field name="gross_qty"/>
                                <field name="net_qty"/>
                                <field name="loss_qty" readonly="1"/>
                                <field name="quantity" readonly="1"/>
                                <field name="uom_id" readonly="1"/>
                            </group>
                        </group>
                        <field name="remarks"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_gate_pass" type="object"
                            string="Create" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
