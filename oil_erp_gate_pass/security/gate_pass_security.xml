<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the gate pass security rules and groups. -->
    <record id="group_oil_gate_pass_user" model="res.groups">
        <field name="name">Gate Pass User</field>
        <field name="category_id"
               ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_oil_gate_pass_manager" model="res.groups">
        <field name="name">Gate Pass Manager</field>
        <field name="category_id"
               ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids"
               eval="[(4, ref('oil_erp_gate_pass.group_oil_gate_pass_user'))]"/>
    </record>
    <record id="oil_gate_pass_rule_company" model="ir.rule">
        <field name="name">Oil Gate Pass: multi-company</field>
        <field name="model_id" ref="model_oil_gate_pass"/>
        <field name="domain_force">['|', ('company_id', '=', False),
            ('company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>
