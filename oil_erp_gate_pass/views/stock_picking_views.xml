<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the stock picking views. -->
    <record id="view_picking_form_inherit_oil_gate_pass" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.oil.gate.pass</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_open_create_gate_pass_wizard" type="object"
                        string="Create Gate Pass" class="btn-primary"
                        invisible="state in ['draft', 'done', 'cancel'] or not is_oil_gas_transfer"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_gate_passes" type="object"
                        class="oe_stat_button" icon="fa-id-card-o"
                        invisible="gate_pass_count == 0">
                    <field name="gate_pass_count" widget="statinfo"
                           string="Gate Passes"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
