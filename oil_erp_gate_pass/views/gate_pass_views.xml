<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the gate pass views. -->
    <record id="view_oil_gate_pass_tree" model="ir.ui.view">
        <field name="name">oil.gate.pass.tree</field>
        <field name="model">oil.gate.pass</field>
        <field name="arch" type="xml">
            <list string="Gate Passes">
                <field name="name"/>
                <field name="date"/>
                <field name="gate_pass_type"/>
                <field name="partner_id"/>
                <field name="vehicle_number"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="state"/>
                <field name="security_check"/>
            </list>
        </field>
    </record>

    <record id="view_oil_gate_pass_form" model="ir.ui.view">
        <field name="name">oil.gate.pass.form</field>
        <field name="model">oil.gate.pass</field>
        <field name="arch" type="xml">
            <form string="Gate Pass">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start"
                            invisible="state != 'approved'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            invisible="state not in ['approved', 'in_progress']"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancel'"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,in_progress,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                invisible="not picking_id">
                            <field name="picking_id" widget="statinfo"
                                   string="Picking"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="gate_pass_type"/>
                            <field name="partner_id"/>
                            <field name="transporter_id"/>
                            <field name="picking_id"/>
                            <field name="sale_order_id"/>
                            <field name="purchase_order_id"/>
                        </group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="vehicle_number"/>
                            <field name="driver_name"/>
                            <field name="gate_in_time"/>
                            <field name="gate_out_time"/>
                            <field name="security_check"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Measurements">
                            <group>
                                <group>
                                    <field name="source_location_id"/>
                                    <field name="destination_location_id"/>
                                    <field name="density"/>
                                    <field name="temperature"/>
                                    <field name="pressure"/>
                                </group>
                                <group>
                                    <field name="gross_qty"/>
                                    <field name="net_qty"/>
                                    <field name="loss_qty" readonly="1"/>
                                    <field name="quantity" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                </group>
                            </group>
                            <field name="remarks"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_oil_gate_pass_search" model="ir.ui.view">
        <field name="name">oil.gate.pass.search</field>
        <field name="model">oil.gate.pass</field>
        <field name="arch" type="xml">
            <search string="Gate Passes">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_number"/>
                <field name="picking_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <filter name="security_checked" string="Security Checked"
                        domain="[('security_check', '=', True)]"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'gate_pass_type'}"/>
                    <filter name="group_partner" string="Partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oil_gate_pass" model="ir.actions.act_window">
        <field name="name">Gate Passes</field>
        <field name="res_model">oil.gate.pass</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_oil_gate_pass_search"/>
    </record>

    <menuitem
            id="menu_oil_gate_pass"
            name="Gate Pass"
            parent="oil_erp_base.menu_oil_config_midstream"
            groups="oil_erp_base.group_oil_user,oil_erp_base.group_oil_manager,oil_erp_base.group_oil_admin"
            action="action_oil_gate_pass"
            sequence="30"/>
</odoo>
