<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Adding invisible fields (product_config_mode,product_custom_attribute_value_ids and product_no_variant_attribute_value_ids
    ) after the product_template_id field in
    the purchase order form view.-->
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.purchase.product.configurator</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='product_template_id']"
                   position="after">
                <field name="product_config_mode" column_invisible="1"/>
                <field name="purchase_product_custom_attribute_value_ids" column_invisible="1">
                <list editable="bottom">
                    <field name="custom_product_template_attribute_value_id"/>
                    <field name="custom_value"/>
                </list>
            </field>
                <field name="product_no_variant_attribute_value_ids" column_invisible="1" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
