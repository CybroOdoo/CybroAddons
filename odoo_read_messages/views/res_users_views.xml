<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Res Users Form View to read messages -->
    <record id="res_users_view_form_inherit_read_messages" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.read.messages</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <field name="signature" position="after">
                <div class="mt-2">
                    <button name="action_read_messages"
                            string="Read Messages"
                            type="object"
                            class="btn-secondary"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
