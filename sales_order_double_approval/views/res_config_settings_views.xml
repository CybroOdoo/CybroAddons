<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Configure the minimum sales order amount that requires manager approval. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.form.view.inherit.sales.order.double.approval
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']//block[@id='pricing_setting_container']"
                   position="after">
                <block title="Sale Order Approval"
                       id="sale_order_approval_setting_container">
                    <setting id="so_min_amount"
                             help="Orders above this amount require approval when manager approval is enabled for their company. The threshold is converted from the selected currency to the order company's currency.">
                        <field name="so_min_amount_currency_id"/>
                        <field name="so_min_amount"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
