<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_aro_revision_wizard_form" model="ir.ui.view">
        <field name="name">oil.aro.revision.wizard.form</field>
        <field name="model">oil.aro.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Revise ARO Estimate">
                <sheet>
                    <group>
                        <group string="Revision Details">
                            <field name="obligation_id" readonly="1" options="{'no_create': True}"/>
                            <field name="reason" required="1"/>
                            <field name="description" placeholder="Explain the reason for this revision…" required="1"/>
                        </group>
                    </group>
                    <group string="Current Values">
                        <field name="currency_id" invisible="1"/>
                        <field name="old_future_cost" readonly="1"/>
                        <field name="old_discount_rate" readonly="1"/>
                        <field name="old_abandonment_date" readonly="1"/>
                        <field name="old_liability" readonly="1"/>
                    </group>
                    <group string="New Values (leave blank to keep current)">
                        <field name="new_future_cost" currency_field="currency_id"/>
                        <field name="new_discount_rate"/>
                        <field name="new_abandonment_date"/>
                    </group>
                    <group string="Preview of Change">
                        <field name="new_liability_preview" readonly="1" class="oe_inline"/>
                        <field name="delta_preview" readonly="1" class="oe_inline"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_revision" string="Apply Revision"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Optional: action is already defined in the wizard .py or can be added here -->
    <record id="action_aro_revision_wizard" model="ir.actions.act_window">
        <field name="name">Revise ARO Estimate</field>
        <field name="res_model">oil.aro.revision.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="oil_erp_aro.model_oil_aro_obligation"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>