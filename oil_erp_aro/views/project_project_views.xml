<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
    <!-- ═══════════════════════════════════════════════════════════
         FORM VIEW INHERITANCE (PROJECT ARO LINKAGE)
         ═══════════════════════════════════════════════════════════ -->
        <record id="view_project_project_form_aro" model="ir.ui.view">
            <field name="name">project.project.form.aro</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group string="ARO Linkage" invisible="not aro_obligation_id">
                        <group>
                            <field name="aro_obligation_id"/>
                            <field name="aro_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="aro_liability_balance" readonly="1"/>
                            <field name="aro_wip_total" readonly="1"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>