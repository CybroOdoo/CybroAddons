<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
    <!-- ═══════════════════════════════════════════════════════════
         FORM VIEW INHERITANCE (RESERVOIR ARO INFO)
         ═══════════════════════════════════════════════════════════ -->
        <record id="view_oil_reservoir_form_aro" model="ir.ui.view">
            <field name="name">oil.reservoir.form.aro</field>
            <field name="model">oil.reservoir</field>
            <field name="inherit_id" ref="oil_erp_reservoir.view_oil_reservoir_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="ARO &amp; Decommissioning" name="aro">
                        <group>
                            <group>
                                <field name="aro_required"/>
                                <field name="estimated_decom_cost_fv"/>
                                <field name="estimated_abandonment_date"/>
                            </group>
                            <group>
                                <field name="aro_count"/>
                                <field name="aro_current_liability" readonly="1"/>
                                <button name="action_view_aro" type="object"
                                        string="View ARO" class="oe_link"
                                        invisible="aro_count == 0"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>