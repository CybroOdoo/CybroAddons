<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         LIST VIEW
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_oil_aro_wip_list" model="ir.ui.view">
        <field name="name">oil.aro.wip.list</field>
        <field name="model">oil.aro.wip</field>
        <field name="arch" type="xml">
            <list string="Decommissioning WIP"
                  decoration-success="state == 'posted'"
                  decoration-muted="state == 'draft'">
                <field name="date"/>
                <field name="obligation_id"/>
                <field name="cost_type"/>
                <field name="description"/>
                <field name="source_partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="cost_center_id"/>
                <field name="decommissioning_plan_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         FORM VIEW
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_oil_aro_wip_form" model="ir.ui.view">
        <field name="name">oil.aro.wip.form</field>
        <field name="model">oil.aro.wip</field>
        <field name="arch" type="xml">
            <form string="WIP Cost Line">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                    <button name="action_post_wip" string="Post to WIP"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="obligation_id"/>
                            <field name="date"/>
                            <field name="cost_type"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="cost_center_id"/>
                            <field name="decommissioning_plan_id"/>
                            <field name="source_partner_id"/>
                            <field name="source_bill_id"/>
                        </group>
                    </group>
                    <group string="GL" invisible="state == 'draft'">
                        <field name="move_id" readonly="1"/>
                        <field name="posted_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ACTION
         ═══════════════════════════════════════════════════════════ -->
    <record id="action_oil_aro_wip" model="ir.actions.act_window">
        <field name="name">Decommissioning WIP</field>
        <field name="res_model">oil.aro.wip</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

</odoo>