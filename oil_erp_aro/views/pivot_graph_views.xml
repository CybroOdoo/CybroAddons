<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
    <!-- Pivot view for oil.aro.template -->
    <record id="view_oil_aro_template_pivot" model="ir.ui.view">
        <field name="name">oil.aro.template.pivot</field>
        <field name="model">oil.aro.template</field>
        <field name="arch" type="xml">
            <pivot string="Oil Aro Template Analysis">
            <field name="create_date" interval="month" type="row"/>
            <field name="discount_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view for oil.aro.template -->
    <record id="view_oil_aro_template_graph" model="ir.ui.view">
        <field name="name">oil.aro.template.graph</field>
        <field name="model">oil.aro.template</field>
        <field name="arch" type="xml">
            <graph string="Oil Aro Template Analysis" type="bar">
                <field name="create_date" interval="month"/>
            </graph>
        </field>
    </record>
    <!-- Pivot view for oil.aro.wip -->
    <record id="view_oil_aro_wip_pivot" model="ir.ui.view">
        <field name="name">oil.aro.wip.pivot</field>
        <field name="model">oil.aro.wip</field>
        <field name="arch" type="xml">
            <pivot string="Oil Aro Wip Analysis">
            <field name="create_date" interval="month" type="row"/>
            <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view for oil.aro.wip -->
    <record id="view_oil_aro_wip_graph" model="ir.ui.view">
        <field name="name">oil.aro.wip.graph</field>
        <field name="model">oil.aro.wip</field>
        <field name="arch" type="xml">
            <graph string="Oil Aro Wip Analysis" type="bar">
                <field name="create_date" interval="month"/>
            </graph>
        </field>
    </record>
    <!-- Pivot view for oil.aro.obligation -->
    <record id="view_oil_aro_obligation_pivot" model="ir.ui.view">
        <field name="name">oil.aro.obligation.pivot</field>
        <field name="model">oil.aro.obligation</field>
        <field name="arch" type="xml">
            <pivot string="Oil Aro Obligation Analysis">
            <field name="create_date" interval="month" type="row"/>
            <field name="future_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view for oil.aro.obligation -->
    <record id="view_oil_aro_obligation_graph" model="ir.ui.view">
        <field name="name">oil.aro.obligation.graph</field>
        <field name="model">oil.aro.obligation</field>
        <field name="arch" type="xml">
            <graph string="Oil Aro Obligation Analysis" type="bar">
                <field name="create_date" interval="month"/>
            </graph>
        </field>
    </record>
    </data>
</odoo>