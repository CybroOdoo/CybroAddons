<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_oil_bulk_schedule_template_form_aro" model="ir.ui.view">
        <field name="name">oil.bulk.schedule.template.form.aro</field>
        <field name="model">oil.bulk.schedule.template</field>
        <field name="inherit_id"
               ref="oil_erp_base.view_oil_bulk_schedule_template_form"/>
        <field name="arch" type="xml">
            <field name="target_model_name" position="after">
                <!-- Target 1: obligation creation -->
                <field name="aro_asset_kind"
                       invisible="target_model_name != 'oil.aro.obligation'"
                       required="target_model_name == 'oil.aro.obligation'"/>
                <field name="aro_template_id"
                       invisible="target_model_name != 'oil.aro.obligation'"
                       required="target_model_name == 'oil.aro.obligation'"/>
                <!-- Target 2: accretion posting -->
                <field name="aro_accretion_frequency"
                       invisible="target_model_name != 'oil.aro.accretion.line'"/>
                <field name="aro_posting_date"
                       invisible="target_model_name != 'oil.aro.accretion.line'"/>
                <!-- Shared reservoir scope filter -->
                <field name="aro_reservoir_ids"
                       widget="many2many_tags"
                       invisible="target_model_name not in ('oil.aro.obligation', 'oil.aro.accretion.line')"/>
            </field>
        </field>
    </record>
</odoo>
