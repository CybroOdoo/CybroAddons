<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         KANBAN VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_oil_aro_obligation_kanban" model="ir.ui.view">
        <field name="name">oil.aro.obligation.kanban</field>
        <field name="model">oil.aro.obligation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="asset_kind"/>
                <field name="current_liability_balance"/>
                <field name="priority_level"/>
                <field name="responsible_id"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="o_kanban_record_body mt4">
                                <div>Asset: <field name="asset_kind"/></div>
                                <div>Liability:
                                    <field name="current_liability_balance" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="priority_level" widget="label_selection"
                                           options="{'classes': {'critical': 'danger', 'high': 'warning', 'medium': 'info', 'low': 'default'}}"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="responsible_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_oil_aro_obligation_form" model="ir.ui.view">
        <field name="name">oil.aro.obligation.form</field>
        <field name="model">oil.aro.obligation</field>
        <field name="arch" type="xml">
            <form string="Asset Retirement Obligation">

                <!-- STATUS BAR -->
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,recognized,hold,executing,settled,closed"/>

                    <!-- WORKFLOW BUTTONS -->
                    <button name="action_recognize"
                            string="Recognize" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_start_executing"
                            string="Start Decommissioning" type="object"
                            class="btn-primary"
                            invisible="state != 'recognized'"/>

                    <button name="action_hold"
                            string="Hold" type="object"
                            class="btn-warning"
                            invisible="state not in ('recognized','executing')"/>

                    <button name="action_resume"
                            string="Resume" type="object"
                            class="btn-info"
                            invisible="state != 'hold'"/>

                    <button name="action_open_revision_wizard"
                            string="Revise Estimate" type="object"
                            invisible="state not in ('recognized','executing')"/>

                    <button name="action_open_settlement_wizard"
                            string="Settle" type="object"
                            class="btn-primary"
                            invisible="state != 'executing'"/>

                    <button name="action_close"
                            string="Close" type="object"
                            invisible="state != 'settled'"/>

                    <button name="action_cancel"
                            string="Cancel" type="object"
                            class="btn-danger"
                            invisible="state in ('settled','closed','cancelled')"
                            confirm="This will reverse all GL journals. Are you sure?"/>
                </header>

                <!-- TITLE -->
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <!-- =====================================================
                         SMART BUTTONS
                         ====================================================== -->
                    <div class="oe_button_box" name="button_box">

                        <!-- WIP -->
                        <button type="object"
                                name="action_view_wip"
                                class="oe_stat_button"
                                icon="fa-wrench"
                                invisible="state == 'draft'">
                            <field name="wip_count"
                                   string="WIP"
                                   widget="statinfo"/>
                        </button>

                        <!-- ACCRETION -->
                        <button type="object"
                                name="action_view_accretion"
                                class="oe_stat_button"
                                icon="fa-line-chart"
                                invisible="state == 'draft'">
                            <field name="accretion_count"
                                   string="Accretion"
                                   widget="statinfo"/>
                        </button>

                        <!-- REVISIONS -->
                        <button type="object"
                                name="action_view_revisions"
                                class="oe_stat_button"
                                icon="fa-history"
                                invisible="state == 'draft'">
                            <field name="revision_count"
                                   string="Revisions"
                                   widget="statinfo"/>
                        </button>

                        <!-- HSE INCIDENTS -->
                        <button type="object"
                                name="action_view_incidents"
                                class="oe_stat_button"
                                icon="fa-exclamation-triangle">
                            <field name="incident_count"
                                   string="Incidents"
                                   widget="statinfo"/>
                        </button>

                        <!-- JOURNALS -->
                        <button type="object"
                                name="action_view_journals"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="state == 'draft'">
                            <field name="journal_count"
                                   string="Journals"
                                   widget="statinfo"/>
                        </button>

                    </div>

                    <!-- MAIN FIELDS -->
                    <group>
                        <group string="Asset">
                            <field name="asset_kind"/>
                            <field name="reservoir_id"
                                   invisible="asset_kind != 'reservoir'"/>
                            <field name="lease_id"
                                   invisible="asset_kind != 'lease'"/>
                            <field name="equipment_id"
                                   invisible="asset_kind != 'equipment'"/>
                            <field name="pipeline_id"
                                   invisible="asset_kind != 'pipeline'"/>
                            <field name="description"/>
                        </group>
                        <group string="Company">
                            <field name="company_id"/>
                            <field name="currency_id"/>
                            <field name="responsible_id"/>
                            <field name="template_id"/>
                            <field name="jv_agreement_id"/>
                            <field name="environmental_obligation_type"/>
                        </group>
                    </group>

                    <group string="Financial Parameters">
                        <group>
                            <field name="current_cost"/>
                            <field name="inflation_rate"/>
                            <field name="future_cost"/>
                            <field name="discount_rate"/>
                            <field name="accretion_frequency"/>
                        </group>
                        <group>
                            <field name="decommissioning_plan_id"/>
                            <field name="recognition_date"/>
                            <field name="abandonment_date"/>
                            <field name="years_to_abandonment" readonly="1"/>
                            <field name="priority_level" readonly="1"/>
                        </group>
                    </group>

                    <!-- CURRENT BALANCES (readonly, set by accounting logic) -->
                    <group string="Current Balances" invisible="state == 'draft'">
                        <group>
                            <field name="initial_pv" readonly="1"/>
                            <field name="current_liability_balance" readonly="1"/>
                            <field name="accreted_to_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_accretion_date" readonly="1"/>
                            <field name="wip_total" readonly="1"/>
                            <field name="net_decom_cost" readonly="1"
                                   invisible="state not in ('executing','settled','closed')"/>
                        </group>
                    </group>

                    <!-- SETTLEMENT SUMMARY -->
                    <group string="Settlement Summary"
                           invisible="state not in ('settled','closed')">
                        <group>
                            <field name="settlement_date" readonly="1"/>
                            <field name="settlement_salvage" readonly="1"/>
                            <field name="settlement_variance" readonly="1"/>
                        </group>
                        <group>
                            <field name="settlement_move_id" readonly="1"/>
                            <field name="settlement_notes" readonly="1"/>
                        </group>
                    </group>

                    <!-- ACCOUNTING CONFIGURATION -->
                    <group string="Accounting" groups="account.group_account_manager">
                        <group>
                            <field name="journal_id"/>
                            <field name="aro_asset_account_id"/>
                            <field name="liability_account_id"/>
                            <field name="accretion_expense_account_id"/>
                        </group>
                        <group>
                            <field name="wip_account_id"/>
                            <field name="settlement_gain_account_id"/>
                            <field name="settlement_loss_account_id"/>
                            <field name="deferred_tax_asset_account_id"/>
                            <field name="deferred_tax_benefit_account_id"/>
                            <field name="analytic_account_id"/>
                            <field name="cost_center_id"/>
                        </group>
                    </group>

                    <!-- TABS -->
                    <notebook>
                        <!-- WIP TAB -->
                        <page string="Decommissioning WIP"
                               invisible="state not in ('executing','settled','closed')">
                            <field name="wip_line_ids" mode="list">
                                <list string="WIP Lines" editable="bottom"
                                      decoration-success="state == 'posted'"
                                      decoration-muted="state == 'draft'">
                                    <field name="date"/>
                                    <field name="cost_type"/>
                                    <field name="description"/>
                                    <field name="source_partner_id"/>
                                    <field name="source_bill_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                    <field name="cost_center_id"/>
                                    <field name="decommissioning_plan_id"/>
                                    <field name="state" readonly="1"/>
                                    <button name="action_post_wip" string="Post"
                                             type="object" icon="fa-check"
                                             invisible="state != 'draft'"/>
                                </list>
                            </field>
                        </page>

                        <!-- ACCRETION SCHEDULE TAB -->
                        <page string="Accretion Schedule"
                               invisible="state == 'draft'">
                            <field name="accretion_line_ids" mode="list">
                                <list string="Accretion Lines" create="false" delete="false">
                                    <field name="date"/>
                                    <field name="opening_balance"/>
                                    <field name="accretion_amount"/>
                                    <field name="closing_balance"/>
                                    <field name="move_id"/>
                                </list>
                            </field>
                        </page>

                        <!-- REVISIONS TAB -->
                        <page string="Revisions"
                               invisible="state == 'draft'">
                            <field name="revision_ids" mode="list">
                                <list string="Revisions" create="false">
                                    <field name="revision_date"/>
                                    <field name="reason"/>
                                    <field name="old_liability"/>
                                    <field name="new_liability"/>
                                    <field name="delta"/>
                                    <field name="move_id"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>

                        <!-- JV PARTNER SHARE TAB -->
                        <page string="JV Partner Share" invisible="not jv_agreement_id">
                            <field name="partner_share_ids" readonly="1">
                                <list string="Partner Shares">
                                    <field name="partner_id"/>
                                    <field name="working_interest"/>
                                    <field name="share_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- CHATTER -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_oil_aro_obligation_list" model="ir.ui.view">
        <field name="name">oil.aro.obligation.list</field>
        <field name="model">oil.aro.obligation</field>
        <field name="arch" type="xml">
            <list string="ARO Obligations"
                  decoration-success="state == 'settled'"
                  decoration-info="state == 'recognized'"
                  decoration-warning="state == 'executing'"
                  decoration-muted="state in ('closed','cancelled')">
                <field name="name"/>
                <field name="asset_kind"/>
                <field name="reservoir_id" optional="show"/>
                <field name="lease_id" optional="hide"/>
                <field name="equipment_id" optional="hide"/>
                <field name="pipeline_id" optional="hide"/>
                <field name="responsible_id" optional="show"/>
                <field name="future_cost"/>
                <field name="initial_pv"/>
                <field name="current_liability_balance"/>
                <field name="last_accretion_date" optional="show"/>
                <field name="abandonment_date"/>
                <field name="priority_level" widget="badge"
                       decoration-danger="priority_level == 'critical'"
                       decoration-warning="priority_level == 'high'"
                       decoration-info="priority_level == 'medium'"
                       decoration-muted="priority_level == 'low'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'settled'"
                       decoration-info="state == 'recognized'"
                       decoration-warning="state == 'executing'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_oil_aro_obligation_search" model="ir.ui.view">
        <field name="name">oil.aro.obligation.search</field>
        <field name="model">oil.aro.obligation</field>
        <field name="arch" type="xml">
            <search string="Search ARO Obligations">
                <field name="name"/>
                <field name="reservoir_id"/>
                <field name="lease_id"/>
                <field name="equipment_id"/>
                <field name="pipeline_id"/>
                <field name="responsible_id"/>
                <separator/>
                <filter string="My AROs" name="my_aros" domain="[('responsible_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="recognized" string="Recognized" domain="[('state','=','recognized')]"/>
                <filter name="hold" string="On Hold" domain="[('state','=','hold')]"/>
                <filter name="executing" string="Executing" domain="[('state','=','executing')]"/>
                <filter name="settled" string="Settled" domain="[('state','=','settled')]"/>
                <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Expiring within 12 Months" name="expiring_12m" domain="[('abandonment_date', '&lt;=', (context_today() + datetime.timedelta(days=365)).strftime('%Y-%m-%d')), ('state', 'in', ('recognized', 'executing', 'hold'))]"/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Asset Kind" name="group_asset_kind" context="{'group_by': 'asset_kind'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════════════════════ -->
    <record id="action_oil_aro_obligation" model="ir.actions.act_window">
        <field name="name">ARO Obligations</field>
        <field name="res_model">oil.aro.obligation</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_oil_aro_obligation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Asset Retirement Obligation
            </p>
            <p>
                Record future decommissioning liabilities per IAS 37.
                Recognize the ARO to post the initial GL entry, then
                accretion runs automatically each period.
            </p>
        </field>
    </record>

</odoo>