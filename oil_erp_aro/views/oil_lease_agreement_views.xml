<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
    <!-- ═══════════════════════════════════════════════════════════
         FORM VIEW INHERITANCE (LEASE AGREEMENT ARO INFO)
         ═══════════════════════════════════════════════════════════ -->
        <record id="view_oil_lease_agreement_form_aro" model="ir.ui.view">
            <field name="name">oil.lease.agreement.form.aro</field>
            <field name="model">oil.lease.agreement</field>
            <field name="inherit_id" ref="oil_erp_lease.oil_lease_agreement_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="ARO" name="aro">
                        <group>
                            <field name="aro_count" readonly="1"/>
                            <button name="action_view_aro" type="object"
                                    string="View ARO" class="oe_link"
                                    invisible="aro_count == 0"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>