<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_oil_aro_template_form" model="ir.ui.view">
        <field name="name">oil.aro.template.form</field>
        <field name="model">oil.aro.template</field>
        <field name="arch" type="xml">
            <form string="ARO Template">
                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </group>

                    <group string="Accounting">
                        <group>
                            <field name="journal_id"/>
                            <field name="aro_asset_account_id"/>
                            <field name="liability_account_id"/>
                            <field name="accretion_expense_account_id"/>
                        </group>

                        <group>
                            <field name="wip_account_id"/>
                            <field name="settlement_gain_account_id"/>
                            <field name="settlement_loss_account_id"/>
                            <field name="deferred_tax_asset_account_id"/>
                            <field name="deferred_tax_benefit_account_id"/>
                        </group>
                    </group>

                    <group string="Defaults">
                        <group>
                            <field name="discount_rate"/>
                            <field name="accretion_frequency"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_oil_aro_template_tree" model="ir.ui.view">
        <field name="name">oil.aro.template.tree</field>
        <field name="model">oil.aro.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="discount_rate"/>
                <field name="accretion_frequency"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════════════════════ -->

    <record id="action_oil_aro_template" model="ir.actions.act_window">
        <field name="name">ARO Templates</field>
        <field name="res_model">oil.aro.template</field>
        <field name="view_mode">list,form,pivot,graph</field>

    </record>

</odoo>