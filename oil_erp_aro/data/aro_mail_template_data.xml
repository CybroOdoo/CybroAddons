<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
    <!-- ═══════════════════════════════════════════════════════════
         MAIL TEMPLATE: ARO OBLIGATION RECOGNIZED
         ═══════════════════════════════════════════════════════════ -->
        <record id="mail_template_aro_recognized" model="mail.template">
            <field name="name">ARO: Obligation Recognized</field>
            <field name="model_id" ref="model_oil_aro_obligation"/>
            <field name="subject">ARO Recognized: {{ object.name }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>An Asset Retirement Obligation has been recognized:</p>
                    <ul>
                        <li>Reference: <strong t-out="object.name"/></li>
                        <li>Initial PV: <span t-out="object.initial_pv"/> <span t-out="object.currency_id.name"/></li>
                        <li>Abandonment Date: <span t-out="object.abandonment_date"/></li>
                    </ul>
                    <p>Accretion will run automatically each period.</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

    <!-- ═══════════════════════════════════════════════════════════
         MAIL TEMPLATE: ARO OBLIGATION SETTLED
         ═══════════════════════════════════════════════════════════ -->
        <record id="mail_template_aro_settled" model="mail.template">
            <field name="name">ARO: Obligation Settled</field>
            <field name="model_id" ref="model_oil_aro_obligation"/>
            <field name="subject">ARO Settled: {{ object.name }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>The following ARO has been settled:</p>
                    <ul>
                        <li>Reference: <strong t-out="object.name"/></li>
                        <li>Settlement Date: <span t-out="object.settlement_date"/></li>
                        <li>Settlement Variance: <span t-out="object.settlement_variance"/>
                            <span t-out="object.currency_id.name"/></li>
                    </ul>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>