<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="storage_dashboard.StorageDashboard">
        <div class="o_storage_dashboard h-100 overflow-auto p-3">
            <div class="card mb-3">
                <div class="card-header o_storage_system_header">
                    <h3 class="mb-0">System Monitor</h3>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <table class="table table-bordered mb-0">
                                <tbody>
                                    <tr t-foreach="this.systemRows" t-as="row" t-key="row_index">
                                        <th t-out="row[0]"/>
                                        <td t-out="row[1]"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-lg-6">
                            <table class="table table-bordered mb-0">
                                <tbody>
                                    <tr t-foreach="this.limitRows" t-as="row" t-key="row_index">
                                        <th t-out="row[0]"/>
                                        <td t-out="row[1]"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-xl-4">
                    <div class="card h-100">
                        <div class="card-header o_storage_database_header">
                            <h3 class="mb-0">Database Details</h3>
                        </div>
                        <div class="card-body">
                            <table class="table table-bordered mb-0">
                                <tbody>
                                    <tr t-foreach="this.databaseRows" t-as="row" t-key="row_index">
                                        <th t-out="row[0]"/>
                                        <td t-out="row[1]"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-xl-8">
                    <div class="card h-100">
                        <div class="card-header o_storage_chart_header">
                            <h3 class="mb-0">Model Size Chart</h3>
                        </div>
                        <div class="card-body o_storage_chart">
                            <canvas t-ref="this.chart.ref"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
