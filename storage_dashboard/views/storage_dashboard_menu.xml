<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client action of the storage dashboard -->
    <record id="action_storage_dashboard" model="ir.actions.client">
        <field name="name">Memory Usage</field>
        <field name="tag">storage_dashboard_tag</field>
    </record>
    <!-- Memory Usage menu in Settings, for the administrators -->
    <menuitem id="storage_dashboard_menu"
              name="Memory Usage"
              parent="base.menu_administration"
              action="action_storage_dashboard"
              groups="base.group_system"
              sequence="200"/>
</odoo>
