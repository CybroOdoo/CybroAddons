<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="login_layout" model="ir.ui.view">
        <field name="name">Theme Diwy Login Layout</field>
        <field name="inherit_id" ref="web.login_layout"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-call='web.frontend_layout']" position="inside">
                <t t-set="languages" t-value="[]"/>
            </xpath>
            <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
                <attribute name="class">mx-auto o_database_list border-0 bg-transparent</attribute>
                <attribute name="style">max-width: 380px;</attribute>
            </xpath>
            <xpath expr="//div[hasclass('card-body')]" position="attributes">
                <attribute name="class">card-body p-0 bg-transparent</attribute>
            </xpath>
            <xpath expr="//div[contains(@t-attf-class, 'text-center')]" position="replace"/>
            <xpath expr="//div[hasclass('border-top')]" position="replace"/>
        </field>
    </record>

    <record id="login" model="ir.ui.view">
        <field name="name">Theme Diwy Login</field>
        <field name="inherit_id" ref="web.login"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='password']" position="after">
                <a t-if="reset_password_enabled" t-attf-href="/web/reset_password?#{keep_query()}" class="float-end small" style="color: #563BFF; font-weight: 600;">Reset Password</a>
            </xpath>
            <xpath expr="//label[@for='login']" position="after">
                <a t-if="signup_enabled" t-attf-href="/web/signup?#{keep_query()}" class="float-end small" style="color: #563BFF; font-weight: 600;">Choose a user</a>
            </xpath>
        </field>
    </record>
</odoo>
