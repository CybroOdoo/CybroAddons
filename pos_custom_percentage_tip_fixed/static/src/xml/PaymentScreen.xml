<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_percentage_tip_fixed.PaymentScreenTip"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <!-- Shows the tip percentage in the payment screen -->
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <t t-if="pos.config.iface_tipproduct and pos.config.tip_product_id and pos.config.custom_tip_percentage">
                <button class="button btn btn-light py-3 text-start rounded-0 border-bottom"
                        t-on-click="customTipButton">
                    <i class="fa fa-percent me-2"/>
                    Tip (<t t-out="Tips.tip"/>)%
                </button>
            </t>
        </xpath>
    </t>
</templates>
