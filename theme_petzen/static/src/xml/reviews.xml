<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- approved customer review on the reviews page (same markup as the testimonial cards) -->
    <t t-name="theme_petzen.ApprovedReviewCard">
        <div class="testi-card pz-approved-review">
            <div class="testi-stars"><t t-esc="'★'.repeat(review.rating)"/><span t-if="review.rating &lt; 5" class="star-dim" t-esc="'★'.repeat(5 - review.rating)"/></div>
            <p class="testi-text">"<t t-esc="review.review"/>"</p>
            <div class="testi-author">
                <span class="testi-avatar testi-avatar-initials" t-esc="review.initials"/>
                <div>
                    <div class="testi-name" t-esc="review.name"/>
                    <div class="testi-pet" t-esc="review.customer_type"/>
                </div>
            </div>
        </div>
    </t>

</templates>
