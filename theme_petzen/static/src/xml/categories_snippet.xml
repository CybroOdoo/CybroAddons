<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- category tile of the Petzen Categories snippet -->
    <t t-name="theme_petzen.CategoriesSnippetCard">
        <a t-att-href="card.url" t-attf-class="cat-bento reveal in {{ large ? 'large' : '' }}">
            <img class="cat-bento-img" t-att-src="card.image" t-att-alt="card.name" loading="lazy"/>
            <span class="cat-bento-overlay"/>
            <span class="cat-bento-arrow"><iconify-icon icon="lucide:arrow-up-right" style="font-size:16px;color:#fff"/></span>
            <span class="cat-bento-content">
                <span class="cat-bento-emoji"><iconify-icon t-att-icon="card.icon"/></span>
                <span class="cat-bento-name" t-esc="card.name"/>
                <span class="cat-bento-count"><t t-esc="card.count"/> product<t t-if="card.count !== 1">s</t></span>
            </span>
        </a>
    </t>

</templates>
