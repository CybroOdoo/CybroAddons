<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- tabs of the Petzen Products snippet -->
    <t t-name="theme_petzen.ProductsSnippetTabs">
        <button type="button" class="tab-pill active" data-f="all">All Products</button>
        <t t-foreach="tabs" t-as="tab" t-key="tab.key">
            <button type="button" class="tab-pill" t-att-data-f="tab.key" t-esc="tab.name"/>
        </t>
    </t>

    <!-- product card of the "Petzen Products" snippet (look: .product-card, css/styles.css) -->
    <t t-name="theme_petzen.ProductsSnippetCard">
        <article class="product-card reveal in"
                 t-att-data-cat="product.key"
                 t-att-data-product-id="product.product_id or undefined"
                 t-att-data-template-id="product.template_id"
                 t-att-data-url="product.url">
            <div class="product-img-wrap">
                <span t-if="product.badge" t-attf-class="product-badge {{ product.is_new ? 'new-badge' : '' }}" t-esc="product.badge"/>
                <button t-if="wishlist" type="button"
                        t-attf-class="pq-wish pq-btn o_add_wishlist {{ product.in_wishlist ? 'pq-on o_in_wishlist' : '' }}"
                        t-att-disabled="product.in_wishlist"
                        t-att-data-product-template-id="product.template_id"
                        t-att-data-product-product-id="product.variant_id"
                        t-att-aria-label="product.in_wishlist ? 'Remove from wishlist' : 'Add to wishlist'"
                        t-att-aria-pressed="product.in_wishlist ? 'true' : 'false'">
                    <i t-attf-class="fa {{ product.in_wishlist ? 'fa-heart' : 'fa-heart-o' }}" aria-hidden="true"/>
                </button>
                <a t-att-href="product.url" tabindex="-1">
                    <img class="product-img" t-att-src="product.image" t-att-alt="product.name" loading="lazy"/>
                </a>
                <div class="product-quick">
                    <button type="button" class="pqv-btn"><iconify-icon icon="lucide:eye" style="font-size:14px"/> Quick View</button>
                </div>
            </div>
            <div class="product-body">
                <div class="product-tag" t-esc="product.tag"/>
                <h3 class="product-name"><a t-att-href="product.url" t-esc="product.name"/></h3>
                <div class="product-rating-row">
                    <span class="stars"><t t-esc="'★'.repeat(product.rating)"/><span t-if="product.rating &lt; 5" class="star-dim" t-esc="'★'.repeat(5 - product.rating)"/></span>
                    <span class="star-count">(<t t-esc="product.rating_count"/>)</span>
                </div>
                <div class="product-footer">
                    <div class="price-wrap">
                        <span class="product-price" t-esc="product.price"/>
                        <span t-if="product.price_old" class="product-price-old" t-esc="product.price_old"/>
                    </div>
                    <!-- Odoo's add to cart (website_sale.add_to_cart_snippet → cart service):
                         adds directly, or opens the variant / combo / optional products
                         configurator, exactly like the shop. No variant id for products with
                         several variants: the configurator lets the customer choose it. -->
                    <button t-if="product.can_add" type="button" class="add-btn s_add_to_cart_btn"
                            t-att-data-product-template-id="product.template_id"
                            t-att-data-product-variant-id="product.product_id or undefined"
                            t-att-data-product-type="product.product_type"><iconify-icon icon="lucide:shopping-bag" style="font-size:14px"/>Add</button>
                    <!-- cannot be added to the cart (e.g. zero price sales prevented) -->
                    <a t-else="" t-att-href="product.url" class="add-btn"><iconify-icon icon="lucide:eye" style="font-size:14px"/>View</a>
                </div>
            </div>
        </article>
    </t>

</templates>
