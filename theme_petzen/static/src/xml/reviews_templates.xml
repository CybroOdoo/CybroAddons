<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="theme_petzen.reviews_dynamic_content">
        <div class="testi-layout">
            <!-- Approved customer reviews from backend (petzen.review) -->
            <t t-if="reviews and reviews.length">
                <t t-foreach="reviews" t-as="review" t-key="review.id">
                    <div class="testi-card reveal in">
                        <div class="testi-stars">
                            <t t-esc="review.stars"/>
                            <span t-if="review.empty_stars" class="star-dim">
                                <t t-esc="review.empty_stars"/>
                            </span>
                        </div>
                        <p class="testi-text">"<t t-esc="review.review"/>"</p>
                        <div class="testi-author">
                            <span class="testi-avatar testi-avatar-initials">
                                <t t-esc="review.initials"/>
                            </span>
                            <div>
                                <div class="testi-name"><t t-esc="review.name"/></div>
                                <div class="testi-pet">Verified Customer</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
            <p t-else="" class="testi-empty">No reviews yet. Be the first to share your experience!</p>
        </div>
    </t>
</templates>
