<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- /contactus — design page around Odoo's default contact form (#contactus_form). -->
    <template id="contactus_petzen" inherit_id="website.contactus" name="Petzen Contact Us">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="pz-scope pz-page-contact">

  <!-- ══ BANNER ══ -->
  <section class="page-banner">
    <div class="page-banner-inner">
      <div class="page-banner-eyebrow">We'd Love to Hear From You</div>
      <h1 class="page-banner-title">Get in <span>Touch</span></h1>
      <p class="page-banner-sub">Have a question about an order, need pet care advice, or just want to say hello? Our team typically replies within a few hours.</p>
      <div class="page-banner-actions">
        <a href="tel:+15551234567" class="btn btn-primary btn-lg">
          <iconify-icon icon="lucide:phone" style="font-size:17px"></iconify-icon>
          Call Us Now
        </a>
        <a href="mailto:hello@petzen.com" class="btn btn-glass btn-lg">
          <iconify-icon icon="lucide:mail" style="font-size:17px"></iconify-icon>
          Send Email
        </a>
      </div>
    </div>
  </section>

  <!-- ══ INFO CARDS STRIP ══ -->
  <section class="section" style="padding-top: 56px; padding-bottom: 0;">
    <div class="ct-info-strip">

      <div class="ct-info-card reveal">
        <div class="ct-info-icon">
          <iconify-icon icon="lucide:map-pin"></iconify-icon>
        </div>
        <div>
          <div class="ct-info-label">Visit Us</div>
          <div class="ct-info-value">123 Pet Lane<br/>Beverly Hills, CA 90210</div>
        </div>
      </div>

      <div class="ct-info-card reveal" data-delay="0.07">
        <div class="ct-info-icon">
          <iconify-icon icon="lucide:phone"></iconify-icon>
        </div>
        <div>
          <div class="ct-info-label">Call Us</div>
          <div class="ct-info-value">
            <a href="tel:+15551234567">+1 (555) 123-4567</a><br/>
            <span style="font-size:12px;font-weight:400;color:var(--muted-foreground)">Mon–Sat · 9am–6pm</span>
          </div>
        </div>
      </div>

      <div class="ct-info-card reveal" data-delay="0.14">
        <div class="ct-info-icon">
          <iconify-icon icon="lucide:mail"></iconify-icon>
        </div>
        <div>
          <div class="ct-info-label">Email Us</div>
          <div class="ct-info-value">
            <a href="mailto:hello@petzen.com">hello@petzen.com</a><br/>
            <span style="font-size:12px;font-weight:400;color:var(--muted-foreground)">Reply within 24 hrs</span>
          </div>
        </div>
      </div>

      <div class="ct-info-card reveal" data-delay="0.21">
        <div class="ct-info-icon">
          <iconify-icon icon="lucide:clock"></iconify-icon>
        </div>
        <div>
          <div class="ct-info-label">Hours</div>
          <div class="ct-info-value">
            Mon to Fri: <br/>
             9am – 7pm<br/>

          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ══ MAIN: FORM + SIDEBAR ══ -->
  <section class="section" style="padding-top: 0;">
    <div class="ct-main">

      <!-- Contact form -->
      <div class="ct-form-card">
        <div class="ct-form-eyebrow">Send a Message</div>
        <h2 class="ct-form-title">How can we help?</h2>
        <p class="ct-form-sub">Fill in the form and one of our team members will get back to you as soon as possible.</p>

        <!-- Odoo's default "Contact us" form (website form builder, same fields as
             website.contactus) in the Petzen design: sends an email to the company
             and redirects to /contactus-thank-you; editable in the website editor. -->
        <section class="s_website_form pz-contact-form" data-vcss="001" data-snippet="s_website_form">
          <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data"
                class="o_mark_required" data-mark="*" data-model_name="mail.mail"
                data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
            <div class="s_website_form_rows ct-form-grid">

              <div class="ct-field s_website_form_field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                <label class="s_website_form_label" for="contact1">
                  <span class="s_website_form_label_content">Name</span>
                  <span class="s_website_form_mark"> *</span>
                </label>
                <input id="contact1" type="text" class="form-control ct-input s_website_form_input" name="name" required="" data-fill-with="name"/>
              </div>
              <div class="ct-field s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                <label class="s_website_form_label" for="contact2">
                  <span class="s_website_form_label_content">Phone Number</span>
                </label>
                <input id="contact2" type="tel" class="form-control ct-input s_website_form_input" name="phone" data-fill-with="phone"/>
              </div>

              <div class="ct-field s_website_form_field s_website_form_required s_website_form_model_required" data-type="email" data-name="Field">
                <label class="s_website_form_label" for="contact3">
                  <span class="s_website_form_label_content">Email</span>
                  <span class="s_website_form_mark"> *</span>
                </label>
                <input id="contact3" type="email" class="form-control ct-input s_website_form_input" name="email_from" required="" data-fill-with="email"/>
              </div>
              <div class="ct-field s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                <label class="s_website_form_label" for="contact4">
                  <span class="s_website_form_label_content">Company</span>
                </label>
                <input id="contact4" type="text" class="form-control ct-input s_website_form_input" name="company" data-fill-with="commercial_company_name"/>
              </div>

              <div class="ct-field full s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                <label class="s_website_form_label" for="contact5">
                  <span class="s_website_form_label_content">Subject</span>
                  <span class="s_website_form_mark"> *</span>
                </label>
                <input id="contact5" type="text" class="form-control ct-input s_website_form_input" name="subject" required=""/>
              </div>

              <div class="ct-field full s_website_form_field s_website_form_custom s_website_form_required" data-type="text" data-name="Field">
                <label class="s_website_form_label" for="contact6">
                  <span class="s_website_form_label_content">Question</span>
                  <span class="s_website_form_mark"> *</span>
                </label>
                <textarea id="contact6" class="form-control ct-input s_website_form_input" name="description" required="" rows="8"></textarea>
              </div>

              <div class="ct-field full s_website_form_field s_website_form_dnone">
                <label class="s_website_form_label" for="contact7">
                  <span class="s_website_form_label_content">Email To</span>
                </label>
                <input id="contact7" type="hidden" class="form-control s_website_form_input" name="email_to"/>
              </div>

              <div class="ct-field full s_website_form_submit s_website_form_no_submit_label" data-name="Submit Button">
                <div class="s_website_form_label"/>
                <a href="#" role="button" class="btn btn-primary ct-submit s_website_form_send">
                  <iconify-icon icon="lucide:send" style="font-size:16px"></iconify-icon>
                  Send Message
                </a>
                <span id="s_website_form_result"></span>
              </div>

            </div>
          </form>
        </section>
      </div>

      <!-- Right sidebar -->
      <div class="ct-right">

        <!-- Map placeholder -->
        <div class="ct-map reveal">
          <div class="ct-map-bg"/>
          <div class="ct-map-pin">
            <iconify-icon icon="lucide:map-pin" style="font-size:22px"></iconify-icon>
          </div>
          <div class="ct-map-label">123 Pet Lane, Beverly Hills</div>
        </div>

        <!-- FAQ -->
        <div class="ct-faq-card reveal" data-delay="0.08">
          <div class="ct-faq-head">
            <div class="ct-faq-head-label">Common Questions</div>
            <div class="ct-faq-head-title">Quick Answers</div>
          </div>

          <div class="ct-faq-item">
            <button class="ct-faq-q" type="button">
              How long does delivery take?
              <iconify-icon icon="lucide:plus" style="font-size:16px" class="faq-icon"></iconify-icon>
            </button>
            <div class="ct-faq-a">Standard shipping takes 5–7 business days. Express (1–2 days) and overnight options are available at checkout.</div>
          </div>

          <div class="ct-faq-item">
            <button class="ct-faq-q" type="button">
              What's your return policy?
              <iconify-icon icon="lucide:plus" style="font-size:16px" class="faq-icon"></iconify-icon>
            </button>
            <div class="ct-faq-a">We accept returns within 30 days of delivery, no questions asked. Items must be unused and in original packaging.</div>
          </div>

          <div class="ct-faq-item">
            <button class="ct-faq-q" type="button">
              Do you offer vet consultations?
              <iconify-icon icon="lucide:plus" style="font-size:16px" class="faq-icon"></iconify-icon>
            </button>
            <div class="ct-faq-a">Yes! Our licensed vets are available Mon–Fri for in-store consultations. Book a slot through our Services page.</div>
          </div>

          <div class="ct-faq-item">
            <button class="ct-faq-q" type="button">
              Can I track my order?
              <iconify-icon icon="lucide:plus" style="font-size:16px" class="faq-icon"></iconify-icon>
            </button>
            <div class="ct-faq-a">Absolutely. Once your order ships you'll receive a tracking link by email. You can also check your order history after logging in.</div>
          </div>
        </div>

        <!-- Social -->
        <div class="ct-social-card reveal" data-delay="0.16">
          <div class="ct-social-title">Find Us on Social</div>
          <div class="ct-social-sub">Follow along for pet care tips, new arrivals, and adorable content every day.</div>
          <div class="ct-social-btns">
            <a href="#" class="ct-social-btn">
              <iconify-icon icon="lucide:instagram" style="font-size:15px"></iconify-icon>
              Instagram
            </a>
            <a href="#" class="ct-social-btn">
              <iconify-icon icon="lucide:facebook" style="font-size:15px"></iconify-icon>
              Facebook
            </a>
            <a href="#" class="ct-social-btn">
              <iconify-icon icon="ri:twitter-x-fill" style="font-size:14px"></iconify-icon>
              Twitter / X
            </a>
            <a href="#" class="ct-social-btn">
              <iconify-icon icon="lucide:youtube" style="font-size:15px"></iconify-icon>
              YouTube
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <div class="oe_structure" id="petzen_contact_bottom"/>
            </div>
        </xpath>
    </template>
</odoo>
