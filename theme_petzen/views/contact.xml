<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- /contact — design page; the form creates a CRM lead (see controllers/main.py). -->
    <template id="contactus_petzen" inherit_id="website.contactus" name="Petzen Contact Us">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="pz-scope pz-page-contact">

                <!-- ══ BANNER ══ -->
                <section class="page-banner">
                    <div class="page-banner-inner">
                        <div class="page-banner-eyebrow">We'd Love to Hear From You</div>
                        <h1 class="page-banner-title">Get in
                            <span>Touch</span>
                        </h1>
                        <p class="page-banner-sub">Have a question about an order, need pet care advice, or just want to
                            say hello? Our team typically replies within a few hours.
                        </p>
                        <div class="page-banner-actions">
                            <a href="tel:+15551234567" class="btn btn-primary btn-lg">
                                <iconify-icon icon="lucide:phone" style="font-size:17px"></iconify-icon>
                                Call Us Now
                            </a>
                            <a href="mailto:hello@petzen.com" class="btn btn-glass btn-lg">
                                <iconify-icon icon="lucide:mail" style="font-size:17px"></iconify-icon>
                                Send Email
                            </a>
                        </div>
                    </div>
                </section>

                <!-- ══ INFO CARDS STRIP ══ -->
                <section class="section" style="padding-top: 56px; padding-bottom: 0;">
                    <div class="ct-info-strip">

                        <div class="ct-info-card reveal">
                            <div class="ct-info-icon">
                                <iconify-icon icon="lucide:map-pin"></iconify-icon>
                            </div>
                            <div>
                                <div class="ct-info-label">Visit Us</div>
                                <div class="ct-info-value">123 Pet Lane<br/>Beverly Hills, CA 90210
                                </div>
                            </div>
                        </div>

                        <div class="ct-info-card reveal" data-delay="0.07">
                            <div class="ct-info-icon">
                                <iconify-icon icon="lucide:phone"></iconify-icon>
                            </div>
                            <div>
                                <div class="ct-info-label">Call Us</div>
                                <div class="ct-info-value">
                                    <a href="tel:+15551234567">+1 (555) 123-4567</a>
                                    <br/>
                                    <span style="font-size:12px;font-weight:400;color:var(--muted-foreground)">Mon–Sat ·
                                        9am–6pm
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="ct-info-card reveal" data-delay="0.14">
                            <div class="ct-info-icon">
                                <iconify-icon icon="lucide:mail"></iconify-icon>
                            </div>
                            <div>
                                <div class="ct-info-label">Email Us</div>
                                <div class="ct-info-value">
                                    <a href="mailto:hello@petzen.com">hello@petzen.com</a>
                                    <br/>
                                    <span style="font-size:12px;font-weight:400;color:var(--muted-foreground)">Reply
                                        within 24 hrs
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="ct-info-card reveal" data-delay="0.21">
                            <div class="ct-info-icon">
                                <iconify-icon icon="lucide:clock"></iconify-icon>
                            </div>
                            <div>
                                <div class="ct-info-label">Hours</div>
                                <div class="ct-info-value">
                                    Mon to Fri:
                                    <br/>
                                    9am – 7pm
                                    <br/>

                                </div>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- ══ MAIN: FORM + SIDEBAR ══ -->
                <section class="section" style="padding-top: 0;">
                    <div class="ct-main">

                        <!-- Contact form -->
                        <div class="ct-form-card">
                            <div class="ct-form-eyebrow">Send a Message</div>
                            <h2 class="ct-form-title">How can we help?</h2>
                            <p class="ct-form-sub">Fill in the form and one of our team members will get back to you as
                                soon as possible.
                            </p>

                            <form id="contact-form">
                                <div class="ct-form-grid">

                                    <div class="ct-field">
                                        <label for="ct-first">First Name</label>
                                        <input type="text" id="ct-first" class="ct-input" placeholder="John"
                                               required="required"/>
                                    </div>
                                    <div class="ct-field">
                                        <label for="ct-last">Last Name</label>
                                        <input type="text" id="ct-last" class="ct-input" placeholder="Doe"
                                               required="required"/>
                                    </div>

                                    <div class="ct-field">
                                        <label for="ct-email">Email Address</label>
                                        <input type="email" id="ct-email" class="ct-input" placeholder="you@example.com"
                                               required="required"/>
                                    </div>
                                    <div class="ct-field">
                                        <label for="ct-phone">Phone (optional)</label>
                                        <input type="tel" id="ct-phone" class="ct-input"
                                               placeholder="+1 (555) 000-0000"/>
                                    </div>

                                    <div class="ct-field full">
                                        <label for="ct-dept">Department</label>
                                        <select id="ct-dept" class="ct-input">
                                            <option value="">Select a topic…</option>
                                            <option>Order Support</option>
                                            <option>Product Questions</option>
                                            <option>Grooming &amp; Services</option>
                                            <option>Returns &amp; Refunds</option>
                                            <option>Wholesale / Partnerships</option>
                                            <option>General Inquiry</option>
                                        </select>
                                    </div>

                                    <div class="ct-field full">
                                        <label for="ct-msg">Your Message</label>
                                        <textarea id="ct-msg" class="ct-input"
                                                  placeholder="Tell us what's on your mind…"
                                                  required="required"></textarea>
                                    </div>

                                    <button type="submit" class="ct-submit" id="ct-submit-btn">
                                        <iconify-icon icon="lucide:send" style="font-size:16px"></iconify-icon>
                                        Send Message
                                    </button>

                                </div>
                                <div id="ct-error-banner" class="ct-full-row">
                                    <iconify-icon icon="lucide:alert-circle" style="font-size:18px"></iconify-icon>
                                    <span id="ct-error-text"></span>
                                </div>
                            </form>

                            <!-- Success state -->
                            <div class="ct-success" id="ct-success">
                                <div class="ct-success-icon">
                                    <iconify-icon icon="lucide:check" style="font-size:32px;color:#fff"></iconify-icon>
                                </div>
                                <div class="ct-success-title">Message Sent!</div>
                                <p class="ct-success-sub">Thanks for reaching out. We'll reply to your email within 24
                                    hours.
                                </p>
                                <button type="button" class="btn btn-primary" id="ct-reset-btn" style="margin-top:8px">
                                    Send Another
                                </button>
                            </div>
                        </div>

                        <!-- Right sidebar -->
                        <div class="ct-right">

                            <!-- Map placeholder -->
                            <div class="ct-map reveal">
                                <div class="ct-map-bg"></div>
                                <div class="ct-map-pin">
                                    <iconify-icon icon="lucide:map-pin" style="font-size:22px"></iconify-icon>
                                </div>
                                <div class="ct-map-label">123 Pet Lane, Beverly Hills</div>
                            </div>

                            <!-- FAQ -->
                            <div class="ct-faq-card reveal" data-delay="0.08">
                                <div class="ct-faq-head">
                                    <div class="ct-faq-head-label">Common Questions</div>
                                    <div class="ct-faq-head-title">Quick Answers</div>
                                </div>

                                <div class="ct-faq-item">
                                    <button class="ct-faq-q" type="button">
                                        How long does delivery take?
                                        <iconify-icon icon="lucide:plus" style="font-size:16px"
                                                      class="faq-icon"></iconify-icon>
                                    </button>
                                    <div class="ct-faq-a">Standard shipping takes 5–7 business days. Express (1–2 days)
                                        and overnight options are available at checkout.
                                    </div>
                                </div>

                                <div class="ct-faq-item">
                                    <button class="ct-faq-q" type="button">
                                        What's your return policy?
                                        <iconify-icon icon="lucide:plus" style="font-size:16px"
                                                      class="faq-icon"></iconify-icon>
                                    </button>
                                    <div class="ct-faq-a">We accept returns within 30 days of delivery, no questions
                                        asked. Items must be unused and in original packaging.
                                    </div>
                                </div>

                                <div class="ct-faq-item">
                                    <button class="ct-faq-q" type="button">
                                        Do you offer vet consultations?
                                        <iconify-icon icon="lucide:plus" style="font-size:16px"
                                                      class="faq-icon"></iconify-icon>
                                    </button>
                                    <div class="ct-faq-a">Yes! Our licensed vets are available Mon–Fri for in-store
                                        consultations. Book a slot through our Services page.
                                    </div>
                                </div>

                                <div class="ct-faq-item">
                                    <button class="ct-faq-q" type="button">
                                        Can I track my order?
                                        <iconify-icon icon="lucide:plus" style="font-size:16px"
                                                      class="faq-icon"></iconify-icon>
                                    </button>
                                    <div class="ct-faq-a">Absolutely. Once your order ships you'll receive a tracking
                                        link by email. You can also check your order history after logging in.
                                    </div>
                                </div>
                            </div>

                            <!-- Social -->
                            <div class="ct-social-card reveal" data-delay="0.16">
                                <div class="ct-social-title">Find Us on Social</div>
                                <div class="ct-social-sub">Follow along for pet care tips, new arrivals, and adorable
                                    content every day.
                                </div>
                                <div class="ct-social-btns">
                                    <a href="#" class="ct-social-btn">
                                        <iconify-icon icon="lucide:instagram" style="font-size:15px"></iconify-icon>
                                        Instagram
                                    </a>
                                    <a href="#" class="ct-social-btn">
                                        <iconify-icon icon="lucide:facebook" style="font-size:15px"></iconify-icon>
                                        Facebook
                                    </a>
                                    <a href="#" class="ct-social-btn">
                                        <iconify-icon icon="ri:twitter-x-fill" style="font-size:14px"></iconify-icon>
                                        Twitter / X
                                    </a>
                                    <a href="#" class="ct-social-btn">
                                        <iconify-icon icon="lucide:youtube" style="font-size:15px"></iconify-icon>
                                        YouTube
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>
                <div class="oe_structure" id="oe_structure_petzen_contact_bottom"/>
            </div>
        </xpath>
    </template>
</odoo>
