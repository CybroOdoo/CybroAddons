<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- /services — services page -->
    <template id="services_page_template" name="Services">
        <t t-call="website.layout">
            <div id="wrap" class="pz-scope pz-page-services">

  <!-- ══ PAGE BANNER ══ -->
  <section class="page-banner">
<div class="page-banner-inner">
  <div class="page-banner-eyebrow">Expert Care</div>
  <h1 class="page-banner-title">Services for Your <span>Pet</span></h1>
  <p class="page-banner-sub">Certified professionals, premium treatments, and stress-free care — all under one roof.</p>
  <div class="page-banner-actions">
    <a href="/contactus" class="btn btn-primary btn-lg">Book a Service</a>
    <a href="#pricing" class="btn btn-glass btn-lg">View Pricing</a>
  </div>
</div>
  </section>

  <!-- ══ SERVICES SECTION ══ -->
  <section class="services-section" id="services">
<div class="section-header">
  <div>
    <div class="section-eyebrow">Care Services</div>
    <h2 class="section-title">Pamper Your Pet</h2>
    <p class="svc-subtitle">Expert care, under one roof — certified team, zero stress.</p>
  </div>
</div>
<div class="svc-cards">

  <div class="svc-card reveal">
    <div class="svc-card-top">
      <span class="svc-card-num">01</span>
      <span class="svc-card-icon"><iconify-icon icon="lucide:scissors" style="font-size:26px"></iconify-icon></span>
    </div>
    <h3 class="svc-card-name">Grooming &amp; Spa</h3>
    <p class="svc-card-desc">Full coat treatment, nail care and styling by certified groomers — your pet leaves looking their best.</p>
    <ul class="svc-card-features">
      <li>Full bath &amp; blow-dry</li>
      <li>Nail trimming &amp; filing</li>
      <li>Coat styling &amp; de-shed</li>
    </ul>
    <div class="svc-card-footer">
      <div class="svc-card-price">$29<span>/ session</span></div>
      <a href="/contactus" class="svc-card-btn">Book <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon></a>
    </div>
  </div>

  <div class="svc-card svc-card-dark reveal" data-delay="0.08">
    <div class="svc-card-top">
      <span class="svc-card-num">02</span>
      <span class="svc-card-icon"><iconify-icon icon="lucide:stethoscope" style="font-size:26px"></iconify-icon></span>
    </div>
    <h3 class="svc-card-name">Veterinary Care</h3>
    <p class="svc-card-desc">Routine check-ups, vaccinations and comprehensive health screening by licensed veterinarians.</p>
    <ul class="svc-card-features">
      <li>Health &amp; wellness exams</li>
      <li>Core vaccinations</li>
      <li>Parasite prevention</li>
    </ul>
    <div class="svc-card-footer">
      <div class="svc-card-price">$45<span>/ visit</span></div>
      <a href="/contactus" class="svc-card-btn">Book <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon></a>
    </div>
  </div>

  <div class="svc-card reveal" data-delay="0.16">
    <div class="svc-card-top">
      <span class="svc-card-num">03</span>
      <span class="svc-card-icon"><iconify-icon icon="lucide:graduation-cap" style="font-size:26px"></iconify-icon></span>
    </div>
    <h3 class="svc-card-name">Training &amp; Behavior</h3>
    <p class="svc-card-desc">One-on-one obedience and behavior coaching with our award-winning certified trainers.</p>
    <ul class="svc-card-features">
      <li>Basic &amp; advanced obedience</li>
      <li>Behaviour correction</li>
      <li>Puppy starter classes</li>
    </ul>
    <div class="svc-card-footer">
      <div class="svc-card-price">$60<span>/ class</span></div>
      <a href="/contactus" class="svc-card-btn">Book <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon></a>
    </div>
  </div>

</div>
  </section>

  <!-- ══ WHY CHOOSE US ══ -->
  <section class="section" id="pricing" style="background:var(--muted);">
<div class="section-header">
  <div>
    <div class="section-eyebrow">Why Petzen</div>
    <h2 class="section-title">Why Choose Us</h2>
  </div>
</div>
<div class="why-grid">

  <div class="why-card reveal">
    <div class="why-card-icon">
      <iconify-icon icon="lucide:award" style="font-size:24px"></iconify-icon>
    </div>
    <div class="why-card-title">Certified Team</div>
    <p class="why-card-desc">All groomers, vets and trainers are fully certified and insured — your pet is always in expert hands.</p>
  </div>

  <div class="why-card reveal" data-delay="0.07">
    <div class="why-card-icon">
      <iconify-icon icon="lucide:clock" style="font-size:24px"></iconify-icon>
    </div>
    <div class="why-card-title">Same-Day Booking</div>
    <p class="why-card-desc">Book online and get confirmed within the hour. Flexible slots available 7 days a week.</p>
  </div>

  <div class="why-card reveal" data-delay="0.14">
    <div class="why-card-icon">
      <iconify-icon icon="lucide:shield-check" style="font-size:24px"></iconify-icon>
    </div>
    <div class="why-card-title">100% Safe</div>
    <p class="why-card-desc">We use only pet-safe, hypoallergenic products — gentle on sensitive skin and coats.</p>
  </div>

  <div class="why-card reveal" data-delay="0.21">
    <div class="why-card-icon">
      <iconify-icon icon="lucide:smile" style="font-size:24px"></iconify-icon>
    </div>
    <div class="why-card-title">Happy Guarantee</div>
    <p class="why-card-desc">Not satisfied? We'll redo the service completely free — no questions asked.</p>
  </div>

</div>
  </section>

  <div class="oe_structure" id="petzen_services_bottom"/>
            </div>
        </t>
    </template>
</odoo>
