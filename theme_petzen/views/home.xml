<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Home page: every block is written inline inside the editable structure (a
         t-snippet-call would make the editor attribute each block to its snippet template
         and refuse to remove it). The markup mirrors views/snippets/s_*_snippet.xml, which
         feed the "Petzen Theme" panel used to add the blocks back. -->
    <template id="petzen_homepage" inherit_id="website.homepage" name="Petzen Homepage" priority="999">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty pz-scope pz-page-home">
                <!-- Preloader -->
                <div class="preloader" id="preloader">
                    <div class="pl-inner">
                        <span class="pl-logo">PETZEN
                            <i>.</i>
                        </span>
                        <div class="pl-track">
                            <div class="pl-fill"></div>
                        </div>
                    </div>
                </div>
                <section class="pz-scope s_petzen_hero hero" data-snippet="s_petzen_hero" data-name="Petzen Hero">
                    <div class="hero-mosaic" aria-hidden="true">
                        <img class="mosaic-img span2" src="/theme_petzen/static/src/img/photo-1587300003388-59208cc962cb.jpg" alt=""
                             loading="eager"/>
                        <img class="mosaic-img" src="/theme_petzen/static/src/img/photo-1514888286974-6c03e2ca1dba.jpg" alt=""
                             loading="eager"/>
                        <img class="mosaic-img" src="/theme_petzen/static/src/img/photo-1552728089-57bdde30beb3.jpg" alt=""
                             loading="eager"/>
                        <img class="mosaic-img" src="/theme_petzen/static/src/img/photo-1537151625747-768eb6cf92b2.jpg" alt=""
                             loading="lazy"/>
                        <img class="mosaic-img" src="/theme_petzen/static/src/img/photo-1425082661705-1834bfd09dca.jpg" alt=""
                             loading="lazy"/>
                        <img class="mosaic-img" src="/theme_petzen/static/src/img/photo-1589924691995-400dc9ecc119.jpg" alt=""
                             loading="lazy"/>
                        <img class="mosaic-img" src="/theme_petzen/static/src/img/photo-1583337130417-3346a1be7dee.jpg" alt=""
                             loading="lazy"/>
                        <img class="mosaic-img" src="/theme_petzen/static/src/img/photo-1552728089-57bdde30beb3.jpg" alt=""
                             loading="eager"/>
                        <img class="mosaic-img" src="/theme_petzen/static/src/img/photo-1537151625747-768eb6cf92b2.jpg" alt=""
                             loading="lazy"/>
                    </div>
                    <div class="hero-overlay" aria-hidden="true"/>
                    <div class="hero-content">
                        <div class="hero-badge">

                            #1 Trusted Pet Store &amp; Shelter
                        </div>
                        <h1 class="hero-title">Where Every Pet<br/>Finds Their <span class="accent">Perfect</span> Match
                        </h1>
                        <p class="hero-subtitle">Premium food, toys, accessories &amp; expert grooming — all
                            lovingly curated for your furry, feathered, and finned family.
                        </p>
                        <div class="hero-cta">
                            <a href="/shop" class="btn btn-primary btn-lg">
                                <iconify-icon icon="lucide:shopping-bag" style="font-size:17px"/>
                                Shop Now
                            </a>
                            <a href="/services" class="btn btn-glass btn-lg">
                                <iconify-icon icon="lucide:scissors" style="font-size:17px"/>
                                Our Services
                            </a>
                        </div>
                        <div class="hero-pill-stats">
                            <div class="hero-stat-item">
                                <div class="hero-stat-num" data-t="12">0</div>
                                <div class="hero-stat-label">Happy Owners (k+)</div>
                            </div>
                            <div class="hero-stat-item">
                                <div class="hero-stat-num" data-t="500">0</div>
                                <div class="hero-stat-label">Products</div>
                            </div>
                            <div class="hero-stat-item">
                                <div class="hero-stat-num">4.9★</div>
                                <div class="hero-stat-label">Avg Rating</div>
                            </div>
                            <div class="hero-stat-item">
                                <div class="hero-stat-num">48h</div>
                                <div class="hero-stat-label">Fast Delivery</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="pz-scope features-strip s_petzen_features" data-snippet="s_petzen_features"
                     data-name="Petzen Features">
                    <div class="features-strip-inner">
                        <div class="feature-item">
                            <span class="feature-icon-wrap">
                                <iconify-icon icon="lucide:truck" style="font-size:22px"></iconify-icon>
                            </span>
                            <div>
                                <div class="feature-title">Free Delivery</div>
                                <div class="feature-sub">On all orders over $49</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon-wrap">
                                <iconify-icon icon="lucide:shield-check" style="font-size:22px"></iconify-icon>
                            </span>
                            <div>
                                <div class="feature-title">Vet Approved</div>
                                <div class="feature-sub">100% certified products</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon-wrap">
                                <iconify-icon icon="lucide:refresh-ccw" style="font-size:22px"></iconify-icon>
                            </span>
                            <div>
                                <div class="feature-title">Easy Returns</div>
                                <div class="feature-sub">30-day hassle-free policy</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon-wrap">
                                <iconify-icon icon="lucide:headphones" style="font-size:22px"></iconify-icon>
                            </span>
                            <div>
                                <div class="feature-title">24/7 Pet Support</div>
                                <div class="feature-sub">Expert advice anytime</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="pz-scope section s_petzen_categories pz-dynamic-block"
                         data-snippet="s_petzen_categories" data-name="Petzen Categories"
                         data-pz-dynamic="categories" id="categories">
                    <div class="section-header">
                        <div>
                            <div class="section-eyebrow">Browse by Pet</div>
                            <h2 class="section-title">Shop by Category</h2>
                        </div>
                        <a href="/shop" class="see-all-link">View all
                            <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                        </a>
                    </div>
                    <div class="pz-dynamic-body o_not_editable"/>
                </section>

                <section class="pz-scope products-section s_petzen_products pz-dynamic-block"
                         data-snippet="s_petzen_products" data-name="Petzen Products"
                         data-pz-dynamic="products" data-limit="12">
                    <div class="section-header">
                        <div>
                            <div class="section-eyebrow">Best Sellers</div>
                            <h2 class="section-title">Top Picks This Week</h2>
                        </div>
                        <a href="/shop" class="see-all-link">View all products
                            <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                        </a>
                    </div>
                    <div class="pz-dynamic-body o_not_editable"/>
                </section>

                <section class="pz-scope split-promo s_petzen_promo" data-snippet="s_petzen_promo" data-name="Petzen Promo">
                    <div class="split-promo-inner">
                        <div class="split-promo-left">
                            <div>
                                <div class="split-promo-eyebrow">Adoption Program</div>
                                <h2 class="split-promo-title">Every Pet Deserves a Loving Home</h2>
                                <p class="split-promo-desc">Our process is simple, transparent, and focused on
                                    creating perfect matches between pets and families. 57 friends are waiting right
                                    now.
                                </p>
                                <ul class="split-promo-perks">
                                    <li class="perk-item">
                                        <span class="perk-check">
                                            <iconify-icon icon="lucide:check" style="font-size:12px;color:#fff"></iconify-icon>
                                        </span>
                                        Free adoption counseling
                                    </li>
                                    <li class="perk-item">
                                        <span class="perk-check">
                                            <iconify-icon icon="lucide:check" style="font-size:12px;color:#fff"></iconify-icon>
                                        </span>
                                        Health-checked &amp; vaccinated
                                    </li>
                                    <li class="perk-item">
                                        <span class="perk-check">
                                            <iconify-icon icon="lucide:check" style="font-size:12px;color:#fff"></iconify-icon>
                                        </span>
                                        30-day support guarantee
                                    </li>
                                </ul>
                            </div>
                            <a href="/shop" class="btn btn-primary btn-lg" style="align-self:flex-start;">Start Adopting
                                <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                            </a>
                        </div>
                        <div class="split-promo-right">
                            <img class="split-promo-img"
                                 src="/theme_petzen/static/src/img/photo-1544568100-847a948585b9.jpg"
                                 alt="Person hugging their adopted dog" loading="lazy"/>
                            <div class="split-promo-overlay">
                                <span class="overlay-emoji">
                                    <iconify-icon icon="lucide:paw-print"></iconify-icon>
                                </span>
                                <span class="overlay-title">1,200+ Adopted</span>
                                <span class="overlay-sub">and counting</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="pz-scope gallery-section s_petzen_gallery" data-snippet="s_petzen_gallery"
                         data-name="Petzen Gallery">
                    <div class="section-header">
                        <div>
                            <div class="section-eyebrow">Meet Our Friends</div>
                            <h2 class="section-title">Pets Looking for a Home</h2>
                        </div>
                        <a href="/shop" class="see-all-link">See all pets <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon></a>
                    </div>
                    <div class="gallery-grid">
                        <!-- 1. Buddy -->
                        <a href="/shop" class="gcard">
                            <img src="/theme_petzen/static/src/img/photo-1583511655857-d19b40a7a54e.jpg"
                                 alt="Buddy, Golden Retriever" loading="lazy"/>
                            <span class="gcard-fade"></span>
                            <span class="gcard-tag">
                                <iconify-icon icon="lucide:dog" style="font-size:12px"></iconify-icon>
                                Dog
                            </span>
                            <span class="gcard-info">
                                <span class="gcard-name">Buddy</span>
                                <span class="gcard-sub">Golden Retriever · 2 yrs</span>
                            </span>
                        </a>

                        <!-- 2. Luna -->
                        <a href="/shop" class="gcard">
                            <img src="/theme_petzen/static/src/img/photo-1573865526739-10659fec78a5.jpg"
                                 alt="Luna, Tabby Cat" loading="lazy"/>
                            <span class="gcard-fade"></span>
                            <span class="gcard-tag">
                                <iconify-icon icon="lucide:cat" style="font-size:12px"></iconify-icon>
                                Cat
                            </span>
                            <span class="gcard-info">
                                <span class="gcard-name">Luna</span>
                                <span class="gcard-sub">Tabby · 1 yr</span>
                            </span>
                        </a>

                        <!-- 3. Max -->
                        <a href="/shop" class="gcard">
                            <img src="/theme_petzen/static/src/img/photo-1552053831-71594a27632d.jpg"
                                 alt="Max, Corgi" loading="lazy"/>
                            <span class="gcard-fade"></span>
                            <span class="gcard-tag">
                                <iconify-icon icon="lucide:dog" style="font-size:12px"></iconify-icon>
                                Dog
                            </span>
                            <span class="gcard-info">
                                <span class="gcard-name">Max</span>
                                <span class="gcard-sub">Corgi · 3 yrs</span>
                            </span>
                        </a>

                        <!-- 4. Bella -->
                        <a href="/shop" class="gcard">
                            <img src="/theme_petzen/static/src/img/photo-1495360010541-f48722b34f7d.jpg"
                                 alt="Bella, Grey Kitten" loading="lazy"/>
                            <span class="gcard-fade"></span>
                            <span class="gcard-tag">
                                <iconify-icon icon="lucide:cat" style="font-size:12px"></iconify-icon>
                                Cat
                            </span>
                            <span class="gcard-info">
                                <span class="gcard-name">Bella</span>
                                <span class="gcard-sub">British Shorthair · 8 mo</span>
                            </span>
                        </a>

                        <!-- 5. Rocky -->
                        <a href="/shop" class="gcard">
                            <img src="/theme_petzen/static/src/img/photo-1561037404-61cd46aa615b.jpg"
                                 alt="Rocky &amp; friend" loading="lazy"/>
                            <span class="gcard-fade"></span>
                            <span class="gcard-tag">
                                <iconify-icon icon="lucide:dog" style="font-size:12px"></iconify-icon>
                                Dog
                            </span>
                            <span class="gcard-info">
                                <span class="gcard-name">Rocky</span>
                                <span class="gcard-sub">Beagle · 4 yrs</span>
                            </span>
                        </a>

                        <!-- 6. Milo -->
                        <a href="/shop" class="gcard">
                            <img src="/theme_petzen/static/src/img/photo-1518791841217-8f162f1e1131.jpg"
                                 alt="Milo, Orange Cat" loading="lazy"/>
                            <span class="gcard-fade"></span>
                            <span class="gcard-tag">
                                <iconify-icon icon="lucide:cat" style="font-size:12px"></iconify-icon>
                                Cat
                            </span>
                            <span class="gcard-info">
                                <span class="gcard-name">Milo</span>
                                <span class="gcard-sub">Orange Tabby · 2 yrs</span>
                            </span>
                        </a>

                        <!-- 7. Charlie -->
                        <a href="/shop" class="gcard">
                            <img src="/theme_petzen/static/src/img/photo-1477884213360-7e9d7dcc1e48.jpg"
                                 alt="Charlie, Puppy" loading="lazy"/>
                            <span class="gcard-fade"></span>
                            <span class="gcard-tag">
                                <iconify-icon icon="lucide:dog" style="font-size:12px"></iconify-icon>
                                Dog
                            </span>
                            <span class="gcard-info">
                                <span class="gcard-name">Charlie</span>
                                <span class="gcard-sub">Labrador Mix · 6 mo</span>
                            </span>
                        </a>

                        <!-- 8. Coco -->
                        <a href="/shop" class="gcard">
                            <img src="/theme_petzen/static/src/img/photo-1592194996308-7b43878e84a6.jpg"
                                 alt="Coco, White Cat" loading="lazy"/>
                            <span class="gcard-fade"></span>
                            <span class="gcard-tag">
                                <iconify-icon icon="lucide:cat" style="font-size:12px"></iconify-icon>
                                Cat
                            </span>
                            <span class="gcard-info">
                                <span class="gcard-name">Coco</span>
                                <span class="gcard-sub">Ragdoll · 1.5 yrs</span>
                            </span>
                        </a>
                    </div>
                </section>

                <section class="pz-scope services-section s_petzen_services" data-snippet="s_petzen_services"
                         data-name="Petzen Services">
                    <div class="section-header">
                        <div>
                            <div class="section-eyebrow">Care Services</div>
                            <h2 class="section-title">Pamper Your Pet</h2>
                            <p class="svc-subtitle">Expert care, under one roof — certified team, zero stress.</p>
                        </div>
                        <a href="/services" class="btn btn-dark btn-lg">Book a Service
                            <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                        </a>
                    </div>
                    <div class="svc-cards">
                        <!-- 1. Grooming & Spa -->
                        <div class="svc-card">
                            <div class="svc-card-top">
                                <span class="svc-card-num">01</span>
                                <span class="svc-card-icon">
                                    <iconify-icon icon="lucide:scissors" style="font-size:26px"></iconify-icon>
                                </span>
                            </div>
                            <h3 class="svc-card-name">Grooming &amp; Spa</h3>
                            <p class="svc-card-desc">Full coat treatment, nail care and styling by certified
                                groomers — your pet leaves looking their best.
                            </p>
                            <ul class="svc-card-features">
                                <li>Full bath &amp; blow-dry</li>
                                <li>Nail trimming &amp; filing</li>
                                <li>Coat styling &amp; de-shed</li>
                            </ul>
                            <div class="svc-card-footer">
                                <div class="svc-card-price">$29
                                    <span>/ session</span>
                                </div>
                                <a href="/services" class="svc-card-btn">Book
                                    <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon>
                                </a>
                            </div>
                        </div>

                        <!-- 2. Veterinary Care (Featured Dark Card) -->
                        <div class="svc-card svc-card-dark">
                            <div class="svc-card-top">
                                <span class="svc-card-num">02</span>
                                <span class="svc-card-icon">
                                    <iconify-icon icon="lucide:stethoscope" style="font-size:26px"></iconify-icon>
                                </span>
                            </div>
                            <h3 class="svc-card-name">Veterinary Care</h3>
                            <p class="svc-card-desc">Routine check-ups, vaccinations and comprehensive health
                                screening by licensed veterinarians.
                            </p>
                            <ul class="svc-card-features">
                                <li>Health &amp; wellness exams</li>
                                <li>Core vaccinations</li>
                                <li>Parasite prevention</li>
                            </ul>
                            <div class="svc-card-footer">
                                <div class="svc-card-price">$45
                                    <span>/ visit</span>
                                </div>
                                <a href="/services" class="svc-card-btn">Book
                                    <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon>
                                </a>
                            </div>
                        </div>

                        <!-- 3. Training & Behavior -->
                        <div class="svc-card">
                            <div class="svc-card-top">
                                <span class="svc-card-num">03</span>
                                <span class="svc-card-icon">
                                    <iconify-icon icon="lucide:graduation-cap" style="font-size:26px"></iconify-icon>
                                </span>
                            </div>
                            <h3 class="svc-card-name">Training &amp; Behavior</h3>
                            <p class="svc-card-desc">One-on-one obedience and behavior coaching with our
                                award-winning certified trainers.
                            </p>
                            <ul class="svc-card-features">
                                <li>Basic &amp; advanced obedience</li>
                                <li>Behavior correction</li>
                                <li>Puppy starter classes</li>
                            </ul>
                            <div class="svc-card-footer">
                                <div class="svc-card-price">$60
                                    <span>/ class</span>
                                </div>
                                <a href="/services" class="svc-card-btn">Book
                                    <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon>
                                </a>
                            </div>
                        </div>

                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
