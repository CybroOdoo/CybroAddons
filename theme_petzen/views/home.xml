<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════
         MAIN HOMEPAGE
         Every editable block is a direct child of an .oe_structure,
         so the website editor shows move / duplicate / delete.
         The ids of the .oe_structure areas must NOT contain "oe_structure": for
         such ids the editor saves the area in a separate view keyed
         "theme_petzen.<view>_<id>", which the theme upgrade deletes as an orphan
         (ir.module.module._theme_cleanup) and the page comes back empty. With
         other ids the edits are saved in the page view itself, which the upgrade
         keeps (arch_updated).
         ═══════════════════════════════════════════════════════════ -->
    <template id="petzen_homepage" inherit_id="website.homepage" name="Petzen Homepage" priority="999">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="pz-scope pz-page-home">

                <!-- ══ PRELOADER (not editable) ══ -->
                <div class="preloader" id="preloader">
                    <div class="pl-inner">
                        <span class="pl-logo">PETZEN<i>.</i></span>
                        <div class="pl-track"><div class="pl-fill"/></div>
                    </div>
                </div>

                <!-- ══════════ EDITABLE AREA 1: HERO, FEATURES, CATEGORIES, PRODUCTS ══════════ -->
                <div class="oe_structure" id="petzen_home_top">

                    <!-- ══ HERO — MOSAIC COLLAGE ══ -->
                    <section class="hero" id="home" data-name="Hero">
                        <div class="hero-mosaic" aria-hidden="true">
                            <img class="mosaic-img span2" src="https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=700&amp;q=80&amp;auto=format&amp;fit=crop" alt="" loading="eager" />
                            <img class="mosaic-img" src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt="" loading="eager" />
                            <img class="mosaic-img" src="https://images.unsplash.com/photo-1552728089-57bdde30beb3?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt="" loading="eager" />
                            <img class="mosaic-img" src="https://images.unsplash.com/photo-1537151625747-768eb6cf92b2?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt="" loading="lazy" />
                            <img class="mosaic-img" src="https://images.unsplash.com/photo-1425082661705-1834bfd09dca?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt="" loading="lazy" />
                            <img class="mosaic-img" src="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt="" loading="lazy" />
                            <img class="mosaic-img" src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt="" loading="lazy" />
                            <img class="mosaic-img" src="https://images.unsplash.com/photo-1552728089-57bdde30beb3?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt="" loading="eager" />
                            <img class="mosaic-img" src="https://images.unsplash.com/photo-1537151625747-768eb6cf92b2?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt="" loading="lazy" />
                        </div>
                        <div class="hero-overlay" aria-hidden="true"/>
                        <div class="hero-content">
                            <div class="hero-badge">
                                #1 Trusted Pet Store &amp; Shelter
                            </div>
                            <h1 class="hero-title">Where Every Pet<br/>Finds Their <span class="accent">Perfect</span> Match</h1>
                            <p class="hero-subtitle">Premium food, toys, accessories &amp; expert grooming — all lovingly curated for your furry, feathered, and finned family.</p>
                            <div class="hero-cta">
                                <a href="/shop" class="btn btn-primary btn-lg">
                                    <iconify-icon icon="lucide:shopping-bag" style="font-size:17px"></iconify-icon>
                                    Shop Now
                                </a>
                                <a href="/services" class="btn btn-glass btn-lg">
                                    <iconify-icon icon="lucide:scissors" style="font-size:17px"></iconify-icon>
                                    Our Services
                                </a>
                            </div>
                            <div class="hero-pill-stats">
                                <div class="hero-stat-item"><div class="hero-stat-num" data-t="12">0</div><div class="hero-stat-label">Happy Owners (k+)</div></div>
                                <div class="hero-stat-item"><div class="hero-stat-num" data-t="500">0</div><div class="hero-stat-label">Products</div></div>
                                <div class="hero-stat-item"><div class="hero-stat-num">4.9★</div><div class="hero-stat-label">Avg Rating</div></div>
                                <div class="hero-stat-item"><div class="hero-stat-num">48h</div><div class="hero-stat-label">Fast Delivery</div></div>
                            </div>
                        </div>
                    </section>

                    <!-- ══ FEATURE STRIP ══ -->
                    <section class="features-strip" data-name="Feature Strip">
                        <div class="features-strip-inner">
                            <div class="feature-item">
                                <span class="feature-icon-wrap"><iconify-icon icon="lucide:truck" style="font-size:22px"></iconify-icon></span>
                                <div><div class="feature-title">Free Delivery</div><div class="feature-sub">On all orders over $49</div></div>
                            </div>
                            <div class="feature-item">
                                <span class="feature-icon-wrap"><iconify-icon icon="lucide:shield-check" style="font-size:22px"></iconify-icon></span>
                                <div><div class="feature-title">Vet Approved</div><div class="feature-sub">100% certified products</div></div>
                            </div>
                            <div class="feature-item">
                                <span class="feature-icon-wrap"><iconify-icon icon="lucide:refresh-ccw" style="font-size:22px"></iconify-icon></span>
                                <div><div class="feature-title">Easy Returns</div><div class="feature-sub">30-day hassle-free policy</div></div>
                            </div>
                            <div class="feature-item">
                                <span class="feature-icon-wrap"><iconify-icon icon="lucide:headphones" style="font-size:22px"></iconify-icon></span>
                                <div><div class="feature-title">24/7 Pet Support</div><div class="feature-sub">Expert advice anytime</div></div>
                            </div>
                        </div>
                    </section>

                    <!-- ══ SHOP BY CATEGORY / PRODUCTS ══
                         Same markup as the dynamic snippets s_petzen_categories and
                         s_petzen_products (views/snippets/), written inline and not with
                         t-snippet-call: a t-call is branded with the called template, so the
                         editor could not move / remove it as a block of this page.
                         Their tiles / products are loaded in JS ("Pets Category" product
                         categories) and are not saved in the page; once removed they can
                         be dropped back from the blocks panel (Petzen group). -->
                    <section class="pz-scope section s_petzen_categories" data-snippet="s_petzen_categories"
                             data-name="Petzen Categories" data-limit="5">
                        <div class="section-header">
                            <div>
                                <div class="section-eyebrow">Browse by Pet</div>
                                <h2 class="section-title">Shop by Category</h2>
                            </div>
                            <a href="/shop" class="see-all-link">View all <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon></a>
                        </div>
                        <div class="categories-bento o_not_editable"/>
                        <p class="search-empty pz-categories-empty d-none o_not_editable">No categories found.</p>
                    </section>

                    <section class="pz-scope products-section s_petzen_products" data-snippet="s_petzen_products"
                             data-name="Petzen Products" data-limit="12">
                        <div class="section-header">
                            <div>
                                <div class="section-eyebrow">Best Sellers</div>
                                <h2 class="section-title">Top Picks This Week</h2>
                            </div>
                            <a href="/shop" class="see-all-link">View all products
                                <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                            </a>
                        </div>

                        <div class="products-tabs o_not_editable"/>

                        <div class="carousel-wrap o_not_editable">
                            <div class="carousel-outer">
                                <div class="products-row"/>
                            </div>
                            <button type="button" class="c-btn c-prev" aria-label="Previous">
                                <iconify-icon icon="lucide:chevron-left" style="font-size:20px"></iconify-icon>
                            </button>
                            <button type="button" class="c-btn c-next" aria-label="Next">
                                <iconify-icon icon="lucide:chevron-right" style="font-size:20px"></iconify-icon>
                            </button>
                            <div class="c-dots"/>
                        </div>
                        <p class="search-empty pz-products-empty d-none o_not_editable">No products found.</p>
                    </section>

                </div>
                <!-- ══════════ /EDITABLE AREA 1 ══════════ -->

                <!-- ══════════ EDITABLE AREA 2: ADOPTION, GALLERY, SERVICES ══════════ -->
                <div class="oe_structure" id="petzen_home_middle">

                    <!-- ══ SPLIT PROMO — ADOPTION ══ -->
                    <section class="split-promo" id="pets" data-name="Adoption Promo">
                        <div class="split-promo-inner">
                            <div class="split-promo-left">
                                <div>
                                    <div class="split-promo-eyebrow">Adoption Program</div>
                                    <h2 class="split-promo-title">Every Pet Deserves a Loving Home</h2>
                                    <p class="split-promo-desc">Our process is simple, transparent, and focused on creating perfect matches between pets and families. 57 friends are waiting right now.</p>
                                    <ul class="split-promo-perks">
                                        <li class="perk-item"><span class="perk-check"><iconify-icon icon="lucide:check" style="font-size:12px;color:#fff"></iconify-icon></span>Free adoption counseling</li>
                                        <li class="perk-item"><span class="perk-check"><iconify-icon icon="lucide:check" style="font-size:12px;color:#fff"></iconify-icon></span>Health-checked &amp; vaccinated</li>
                                        <li class="perk-item"><span class="perk-check"><iconify-icon icon="lucide:check" style="font-size:12px;color:#fff"></iconify-icon></span>30-day support guarantee</li>
                                    </ul>
                                </div>
                                <a href="/contact" class="btn btn-primary btn-lg" style="align-self:flex-start;">Start Adopting
                                    <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                                </a>
                            </div>
                            <div class="split-promo-right">
                                <img class="split-promo-img" src="https://images.unsplash.com/photo-1544568100-847a948585b9?w=900&amp;q=85&amp;auto=format&amp;fit=crop" alt="Person hugging their adopted dog" loading="lazy" />
                                <div class="split-promo-overlay">
                                    <span class="overlay-emoji"><iconify-icon icon="lucide:paw-print"></iconify-icon></span>
                                    <span class="overlay-title">1,200+ Adopted</span>
                                    <span class="overlay-sub">and counting</span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ══ ADOPTABLE PETS GALLERY ══ -->
                    <section class="gallery-section" data-name="Adoptable Pets">
                        <div class="section-header">
                            <div>
                                <div class="section-eyebrow">Meet Our Friends</div>
                                <h2 class="section-title">Pets Looking for a Home</h2>
                            </div>
                            <a href="/contact" class="see-all-link">See all pets <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon></a>
                        </div>
                        <div class="gallery-grid">
                            <a href="/contact" class="gcard reveal">
                                <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?w=600&amp;q=82&amp;auto=format&amp;fit=crop" alt="Buddy, Golden Retriever" loading="lazy" />
                                <span class="gcard-fade"></span>
                                <span class="gcard-tag"><iconify-icon icon="lucide:dog" style="font-size:12px"></iconify-icon> Dog</span>
                                <span class="gcard-info"><span class="gcard-name">Buddy</span><span class="gcard-sub">Golden Retriever · 2 yrs</span></span>
                            </a>
                            <a href="/contact" class="gcard reveal" data-delay="0.05">
                                <img src="https://images.unsplash.com/photo-1573865526739-10659fec78a5?w=600&amp;q=82&amp;auto=format&amp;fit=crop" alt="Luna, Tabby Cat" loading="lazy" />
                                <span class="gcard-fade"></span>
                                <span class="gcard-tag"><iconify-icon icon="lucide:cat" style="font-size:12px"></iconify-icon> Cat</span>
                                <span class="gcard-info"><span class="gcard-name">Luna</span><span class="gcard-sub">Tabby · 1 yr</span></span>
                            </a>
                            <a href="/contact" class="gcard reveal" data-delay="0.1">
                                <img src="https://images.unsplash.com/photo-1552053831-71594a27632d?w=600&amp;q=82&amp;auto=format&amp;fit=crop" alt="Max, Corgi" loading="lazy" />
                                <span class="gcard-fade"></span>
                                <span class="gcard-tag"><iconify-icon icon="lucide:dog" style="font-size:12px"></iconify-icon> Dog</span>
                                <span class="gcard-info"><span class="gcard-name">Max</span><span class="gcard-sub">Corgi · 3 yrs</span></span>
                            </a>
                            <a href="/contact" class="gcard reveal" data-delay="0.15">
                                <img src="https://images.unsplash.com/photo-1495360010541-f48722b34f7d?w=600&amp;q=82&amp;auto=format&amp;fit=crop" alt="Bella, Grey Kitten" loading="lazy" />
                                <span class="gcard-fade"></span>
                                <span class="gcard-tag"><iconify-icon icon="lucide:cat" style="font-size:12px"></iconify-icon> Cat</span>
                                <span class="gcard-info"><span class="gcard-name">Bella</span><span class="gcard-sub">British Shorthair · 8 mo</span></span>
                            </a>
                            <a href="/contact" class="gcard reveal">
                                <img src="https://images.unsplash.com/photo-1561037404-61cd46aa615b?w=600&amp;q=82&amp;auto=format&amp;fit=crop" alt="Rocky &amp; friend" loading="lazy" />
                                <span class="gcard-fade"></span>
                                <span class="gcard-tag"><iconify-icon icon="lucide:dog" style="font-size:12px"></iconify-icon> Dog</span>
                                <span class="gcard-info"><span class="gcard-name">Rocky</span><span class="gcard-sub">Beagle · 4 yrs</span></span>
                            </a>
                            <a href="/contact" class="gcard reveal" data-delay="0.05">
                                <img src="https://images.unsplash.com/photo-1518791841217-8f162f1e1131?w=600&amp;q=82&amp;auto=format&amp;fit=crop" alt="Milo, Orange Cat" loading="lazy" />
                                <span class="gcard-fade"></span>
                                <span class="gcard-tag"><iconify-icon icon="lucide:cat" style="font-size:12px"></iconify-icon> Cat</span>
                                <span class="gcard-info"><span class="gcard-name">Milo</span><span class="gcard-sub">Orange Tabby · 2 yrs</span></span>
                            </a>
                            <a href="/contact" class="gcard reveal" data-delay="0.1">
                                <img src="https://images.unsplash.com/photo-1477884213360-7e9d7dcc1e48?w=600&amp;q=82&amp;auto=format&amp;fit=crop" alt="Charlie, Puppy" loading="lazy" />
                                <span class="gcard-fade"></span>
                                <span class="gcard-tag"><iconify-icon icon="lucide:dog" style="font-size:12px"></iconify-icon> Dog</span>
                                <span class="gcard-info"><span class="gcard-name">Charlie</span><span class="gcard-sub">Labrador Mix · 6 mo</span></span>
                            </a>
                            <a href="/contact" class="gcard reveal" data-delay="0.15">
                                <img src="https://images.unsplash.com/photo-1592194996308-7b43878e84a6?w=600&amp;q=82&amp;auto=format&amp;fit=crop" alt="Coco, White Cat" loading="lazy" />
                                <span class="gcard-fade"></span>
                                <span class="gcard-tag"><iconify-icon icon="lucide:cat" style="font-size:12px"></iconify-icon> Cat</span>
                                <span class="gcard-info"><span class="gcard-name">Coco</span><span class="gcard-sub">Ragdoll · 1.5 yrs</span></span>
                            </a>
                        </div>
                    </section>

                    <!-- ══ SERVICES ══ -->
                    <section class="services-section" id="services" data-name="Services">
                        <div class="section-header">
                            <div>
                                <div class="section-eyebrow">Care Services</div>
                                <h2 class="section-title">Pamper Your Pet</h2>
                                <p class="svc-subtitle">Expert care, under one roof — certified team, zero stress.</p>
                            </div>
                            <a href="/services#booking" class="btn btn-dark btn-lg">Book a Service <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon></a>
                        </div>
                        <div class="svc-cards">

                            <div class="svc-card reveal">
                                <div class="svc-card-top">
                                    <span class="svc-card-num">01</span>
                                    <span class="svc-card-icon"><iconify-icon icon="lucide:scissors" style="font-size:26px"></iconify-icon></span>
                                </div>
                                <h3 class="svc-card-name">Grooming &amp; Spa</h3>
                                <p class="svc-card-desc">Full coat treatment, nail care and styling by certified groomers — your pet leaves looking their best.</p>
                                <ul class="svc-card-features">
                                    <li>Full bath &amp; blow-dry</li>
                                    <li>Nail trimming &amp; filing</li>
                                    <li>Coat styling &amp; de-shed</li>
                                </ul>
                                <div class="svc-card-footer">
                                    <div class="svc-card-price">$29<span>/ session</span></div>
                                    <a href="/services#booking" class="svc-card-btn">Book <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon></a>
                                </div>
                            </div>

                            <div class="svc-card svc-card-dark reveal" data-delay="0.08">
                                <div class="svc-card-top">
                                    <span class="svc-card-num">02</span>
                                    <span class="svc-card-icon"><iconify-icon icon="lucide:stethoscope" style="font-size:26px"></iconify-icon></span>
                                </div>
                                <h3 class="svc-card-name">Veterinary Care</h3>
                                <p class="svc-card-desc">Routine check-ups, vaccinations and comprehensive health screening by licensed veterinarians.</p>
                                <ul class="svc-card-features">
                                    <li>Health &amp; wellness exams</li>
                                    <li>Core vaccinations</li>
                                    <li>Parasite prevention</li>
                                </ul>
                                <div class="svc-card-footer">
                                    <div class="svc-card-price">$45<span>/ visit</span></div>
                                    <a href="/services#booking" class="svc-card-btn">Book <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon></a>
                                </div>
                            </div>

                            <div class="svc-card reveal" data-delay="0.16">
                                <div class="svc-card-top">
                                    <span class="svc-card-num">03</span>
                                    <span class="svc-card-icon"><iconify-icon icon="lucide:graduation-cap" style="font-size:26px"></iconify-icon></span>
                                </div>
                                <h3 class="svc-card-name">Training &amp; Behavior</h3>
                                <p class="svc-card-desc">One-on-one obedience and behavior coaching with our award-winning certified trainers.</p>
                                <ul class="svc-card-features">
                                    <li>Basic &amp; advanced obedience</li>
                                    <li>Behaviour correction</li>
                                    <li>Puppy starter classes</li>
                                </ul>
                                <div class="svc-card-footer">
                                    <div class="svc-card-price">$60<span>/ class</span></div>
                                    <a href="/services#booking" class="svc-card-btn">Book <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon></a>
                                </div>
                            </div>

                        </div>
                    </section>

                </div>
                <!-- ══════════ /EDITABLE AREA 2 ══════════ -->

                <!-- ══════════ EDITABLE AREA 3: FREE DROP ZONE ══════════ -->
                <div class="oe_structure" id="petzen_home_bottom"/>

            </div>
        </xpath>
    </template>

</odoo>
