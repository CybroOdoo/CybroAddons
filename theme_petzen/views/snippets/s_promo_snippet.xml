<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Snippet Petzen Promo -->
    <template id="s_petzen_promo" name="Petzen Promo">
        <section class="pz-scope split-promo s_petzen_promo" data-snippet="s_petzen_promo" data-name="Petzen Promo">
            <div class="split-promo-inner">
                <div class="split-promo-left">
                    <div>
                        <div class="split-promo-eyebrow">Adoption Program</div>
                        <h2 class="split-promo-title">Every Pet Deserves a Loving Home</h2>
                        <p class="split-promo-desc">Our process is simple, transparent, and focused on
                            creating perfect matches between pets and families. 57 friends are waiting right
                            now.
                        </p>
                        <ul class="split-promo-perks">
                            <li class="perk-item">
                                <span class="perk-check">
                                    <iconify-icon icon="lucide:check" style="font-size:12px;color:#fff"></iconify-icon>
                                </span>
                                Free adoption counseling
                            </li>
                            <li class="perk-item">
                                <span class="perk-check">
                                    <iconify-icon icon="lucide:check" style="font-size:12px;color:#fff"></iconify-icon>
                                </span>
                                Health-checked &amp; vaccinated
                            </li>
                            <li class="perk-item">
                                <span class="perk-check">
                                    <iconify-icon icon="lucide:check" style="font-size:12px;color:#fff"></iconify-icon>
                                </span>
                                30-day support guarantee
                            </li>
                        </ul>
                    </div>
                    <a href="/shop" class="btn btn-primary btn-lg" style="align-self:flex-start;">Start Adopting
                        <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                    </a>
                </div>
                <div class="split-promo-right">
                    <img class="split-promo-img"
                         src="https://images.unsplash.com/photo-1544568100-847a948585b9?w=900&amp;q=85&amp;auto=format&amp;fit=crop"
                         alt="Person hugging their adopted dog" loading="lazy"/>
                    <div class="split-promo-overlay">
                        <span class="overlay-emoji">
                            <iconify-icon icon="lucide:paw-print"></iconify-icon>
                        </span>
                        <span class="overlay-title">1,200+ Adopted</span>
                        <span class="overlay-sub">and counting</span>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
