<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Snippet Petzen Products
         Dynamic: the tabs and product cards are loaded by
         static/src/js/products_snippet.js from /petzen/snippet/products, i.e. the
         published products of the product categories flagged "Pets Category".
         data-limit = max number of products. The heading stays editable. -->
    <template id="s_petzen_products" name="Petzen Products">
        <section class="pz-scope products-section s_petzen_products" data-snippet="s_petzen_products"
                 data-name="Petzen Products" data-limit="12">
            <div class="section-header">
                <div>
                    <div class="section-eyebrow">Best Sellers</div>
                    <h2 class="section-title">Top Picks This Week</h2>
                </div>
                <a href="/shop" class="see-all-link">View all products
                    <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                </a>
            </div>

            <div class="products-tabs o_not_editable"/>

            <div class="carousel-wrap o_not_editable">
                <div class="carousel-outer">
                    <div class="products-row"/>
                </div>
                <button type="button" class="c-btn c-prev" aria-label="Previous">
                    <iconify-icon icon="lucide:chevron-left" style="font-size:20px"></iconify-icon>
                </button>
                <button type="button" class="c-btn c-next" aria-label="Next">
                    <iconify-icon icon="lucide:chevron-right" style="font-size:20px"></iconify-icon>
                </button>
                <div class="c-dots"/>
            </div>
            <p class="search-empty pz-products-empty d-none o_not_editable">No products found.</p>
        </section>
    </template>
</odoo>
