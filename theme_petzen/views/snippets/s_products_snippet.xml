<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Snippet Petzen Products: heading is editable, tabs and carousel are loaded live
         from /petzen/home/products by the PetzenProducts widget. -->
    <template id="s_petzen_products" name="Petzen Products">
        <section class="pz-scope products-section s_petzen_products pz-dynamic-block"
                 data-snippet="s_petzen_products" data-name="Petzen Products"
                 data-pz-dynamic="products" data-limit="12">
            <div class="section-header">
                <div>
                    <div class="section-eyebrow">Best Sellers</div>
                    <h2 class="section-title">Top Picks This Week</h2>
                </div>
                <a href="/shop" class="see-all-link">View all products
                    <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                </a>
            </div>
            <div class="pz-dynamic-body o_not_editable"/>
        </section>
    </template>
</odoo>
