<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Snippet Petzen Features -->
    <template id="s_petzen_features" name="Petzen Features">
        <section class="pz-scope features-strip s_petzen_features" data-snippet="s_petzen_features"
             data-name="Petzen Features">
            <div class="features-strip-inner">
                <div class="feature-item">
                    <span class="feature-icon-wrap">
                        <iconify-icon icon="lucide:truck" style="font-size:22px"></iconify-icon>
                    </span>
                    <div>
                        <div class="feature-title">Free Delivery</div>
                        <div class="feature-sub">On all orders over $49</div>
                    </div>
                </div>
                <div class="feature-item">
                    <span class="feature-icon-wrap">
                        <iconify-icon icon="lucide:shield-check" style="font-size:22px"></iconify-icon>
                    </span>
                    <div>
                        <div class="feature-title">Vet Approved</div>
                        <div class="feature-sub">100% certified products</div>
                    </div>
                </div>
                <div class="feature-item">
                    <span class="feature-icon-wrap">
                        <iconify-icon icon="lucide:refresh-ccw" style="font-size:22px"></iconify-icon>
                    </span>
                    <div>
                        <div class="feature-title">Easy Returns</div>
                        <div class="feature-sub">30-day hassle-free policy</div>
                    </div>
                </div>
                <div class="feature-item">
                    <span class="feature-icon-wrap">
                        <iconify-icon icon="lucide:headphones" style="font-size:22px"></iconify-icon>
                    </span>
                    <div>
                        <div class="feature-title">24/7 Pet Support</div>
                        <div class="feature-sub">Expert advice anytime</div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
