<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Snippet theme Petzen  -->
    <template id="petzen_snippets" inherit_id="website.snippets" name="Petzen Snippets">
        <xpath expr="//div[@id='snippet_structure']" position="after">
            <div id="petzen_panel" class="o_panel">
                <div class="o_panel_header">Petzen Theme</div>
                <div class="o_panel_body">
                    <t t-snippet="theme_petzen.s_petzen_hero" string="Petzen Hero"
                       t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                    <t t-snippet="theme_petzen.s_petzen_features" string="Petzen Features"
                       t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                    <t t-snippet="theme_petzen.s_petzen_categories" string="Petzen Categories"
                       t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                    <t t-snippet="theme_petzen.s_petzen_products" string="Petzen Products"
                       t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                    <t t-snippet="theme_petzen.s_petzen_promo" string="Petzen Promo"
                       t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                    <t t-snippet="theme_petzen.s_petzen_gallery" string="Petzen Gallery"
                       t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                    <t t-snippet="theme_petzen.s_petzen_services" string="Petzen Services"
                       t-thumbnail="/website/static/src/img/snippets_thumbs/s_banner.svg"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>