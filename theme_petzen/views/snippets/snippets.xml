<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Petzen building blocks (Odoo 18 snippet panel).
        Odoo 18 lists structure snippets by group: a "Petzen" group is added to the
        categories, and every block is registered in #snippet_structure with group="petzen".
    -->
    <template id="petzen_snippets" inherit_id="website.snippets" name="Petzen Snippets">
        <!-- first category of the Blocks panel -->
        <xpath expr="//snippets[@id='snippet_groups']/t[1]" position="before">
            <t snippet-group="petzen" t-snippet="website.s_snippet_group" string="Petzen"
               t-thumbnail="/theme_petzen/static/src/images/s_petzen.svg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_petzen.s_petzen_hero" string="Petzen Hero" group="petzen">
                <keywords>petzen, hero, banner, header, intro, mosaic, pets</keywords>
            </t>
            <t t-snippet="theme_petzen.s_petzen_categories" string="Petzen Categories" group="petzen">
                <keywords>petzen, categories, bento, shop, pets</keywords>
            </t>
            <t t-snippet="theme_petzen.s_petzen_products" string="Petzen Products" group="petzen">
                <keywords>petzen, products, carousel, best sellers, shop</keywords>
            </t>
            <t t-snippet="theme_petzen.s_petzen_promo" string="Petzen Promo" group="petzen">
                <keywords>petzen, promo, adoption, split, call to action</keywords>
            </t>
            <t t-snippet="theme_petzen.s_petzen_gallery" string="Petzen Gallery" group="petzen">
                <keywords>petzen, gallery, pets, adoption, images</keywords>
            </t>
            <t t-snippet="theme_petzen.s_petzen_services" string="Petzen Services" group="petzen">
                <keywords>petzen, services, pricing, grooming, vet, training</keywords>
            </t>
        </xpath>
    </template>

    <!-- Website editor options of the theme blocks:
         review cards (reviews page testimonials) can be dragged, moved, cloned and removed -->
    <template id="petzen_snippet_options" inherit_id="website.snippet_options" name="Petzen Snippet Options">
        <xpath expr="//div[@data-js='SnippetMove'][@data-name='move_horizontally_opt']" position="after">
            <div data-js="SnippetMove" data-selector=".testi-layout > .testi-card" data-name="petzen_testi_move_opt">
                <we-button class="fa fa-fw fa-angle-left" data-move-snippet="prev" data-no-preview="true"/>
                <we-button class="fa fa-fw fa-angle-right" data-move-snippet="next" data-no-preview="true"/>
            </div>
            <div data-selector=".testi-layout > .testi-card" data-drop-near=".testi-layout > .testi-card"/>
        </xpath>
    </template>
</odoo>
