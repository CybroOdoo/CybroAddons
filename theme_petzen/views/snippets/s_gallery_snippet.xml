                <a href="/shop" class="see-all-link">See all pets <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon></a>
            </div>
            <div class="gallery-grid">
                <!-- 1. Buddy -->
                <a href="/shop" class="gcard">
                    <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?w=600&amp;q=82&amp;auto=format&amp;fit=crop"
                         alt="Buddy, Golden Retriever" loading="lazy"/>
                    <span class="gcard-fade"></span>
                    <span class="gcard-tag">
                        <iconify-icon icon="lucide:dog" style="font-size:12px"></iconify-icon>
                        Dog
                    </span>
                    <span class="gcard-info">
                        <span class="gcard-name">Buddy</span>
                        <span class="gcard-sub">Golden Retriever · 2 yrs</span>
                    </span>
                </a>

                <!-- 2. Luna -->
                <a href="/shop" class="gcard">
                    <img src="https://images.unsplash.com/photo-1573865526739-10659fec78a5?w=600&amp;q=82&amp;auto=format&amp;fit=crop"
