<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Snippet Petzen Gallery -->
    <template id="s_petzen_gallery" name="Petzen Gallery">
        <section class="pz-scope gallery-section s_petzen_gallery" data-snippet="s_petzen_gallery"
                 data-name="Petzen Gallery">
            <div class="section-header">
                <div>
                    <div class="section-eyebrow">Meet Our Friends</div>
                    <h2 class="section-title">Pets Looking for a Home</h2>
