<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Snippet Petzen Services -->
    <template id="s_petzen_services" name="Petzen Services">
        <section class="pz-scope services-section s_petzen_services" data-snippet="s_petzen_services"
                 data-name="Petzen Services">
            <div class="section-header">
                <div>
                    <div class="section-eyebrow">Care Services</div>
                    <h2 class="section-title">Pamper Your Pet</h2>
                    <p class="svc-subtitle">Expert care, under one roof — certified team, zero stress.</p>
                </div>
                <a href="/services" class="btn btn-dark btn-lg">Book a Service
                    <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                </a>
            </div>
            <div class="svc-cards">
                <!-- 1. Grooming & Spa -->
                <div class="svc-card">
                    <div class="svc-card-top">
                        <span class="svc-card-num">01</span>
                        <span class="svc-card-icon">
                            <iconify-icon icon="lucide:scissors" style="font-size:26px"></iconify-icon>
                        </span>
                    </div>
                    <h3 class="svc-card-name">Grooming &amp; Spa</h3>
                    <p class="svc-card-desc">Full coat treatment, nail care and styling by certified
                        groomers — your pet leaves looking their best.
                    </p>
                    <ul class="svc-card-features">
                        <li>Full bath &amp; blow-dry</li>
                        <li>Nail trimming &amp; filing</li>
                        <li>Coat styling &amp; de-shed</li>
                    </ul>
                    <div class="svc-card-footer">
                        <div class="svc-card-price">$29
                            <span>/ session</span>
                        </div>
                        <a href="/services" class="svc-card-btn">Book
                            <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon>
                        </a>
                    </div>
                </div>

                <!-- 2. Veterinary Care (Featured Dark Card) -->
                <div class="svc-card svc-card-dark">
                    <div class="svc-card-top">
                        <span class="svc-card-num">02</span>
                        <span class="svc-card-icon">
                            <iconify-icon icon="lucide:stethoscope" style="font-size:26px"></iconify-icon>
                        </span>
                    </div>
                    <h3 class="svc-card-name">Veterinary Care</h3>
                    <p class="svc-card-desc">Routine check-ups, vaccinations and comprehensive health
                        screening by licensed veterinarians.
                    </p>
                    <ul class="svc-card-features">
                        <li>Health &amp; wellness exams</li>
                        <li>Core vaccinations</li>
                        <li>Parasite prevention</li>
                    </ul>
                    <div class="svc-card-footer">
                        <div class="svc-card-price">$45
                            <span>/ visit</span>
                        </div>
                        <a href="/services" class="svc-card-btn">Book
                            <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon>
                        </a>
                    </div>
                </div>

                <!-- 3. Training & Behavior -->
                <div class="svc-card">
                    <div class="svc-card-top">
                        <span class="svc-card-num">03</span>
                        <span class="svc-card-icon">
                            <iconify-icon icon="lucide:graduation-cap" style="font-size:26px"></iconify-icon>
                        </span>
                    </div>
                    <h3 class="svc-card-name">Training &amp; Behavior</h3>
                    <p class="svc-card-desc">One-on-one obedience and behavior coaching with our
                        award-winning certified trainers.
                    </p>
                    <ul class="svc-card-features">
                        <li>Basic &amp; advanced obedience</li>
                        <li>Behaviour correction</li>
                        <li>Puppy starter classes</li>
                    </ul>
                    <div class="svc-card-footer">
                        <div class="svc-card-price">$60
                            <span>/ class</span>
                        </div>
                        <a href="/services" class="svc-card-btn">Book
                            <iconify-icon icon="lucide:arrow-right" style="font-size:13px"></iconify-icon>
                        </a>
                    </div>
                </div>

            </div>
        </section>
    </template>
</odoo>
