<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--  Snippet Petzen Hero -->
    <template id="s_petzen_hero" name="Petzen Hero">
        <section class="pz-scope s_petzen_hero hero" data-snippet="s_petzen_hero" data-name="Petzen Hero">
            <div class="hero-mosaic" aria-hidden="true">
                <img class="mosaic-img span2" src="https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=700&amp;q=80&amp;auto=format&amp;fit=crop" alt=""
                     loading="eager"/>
                <img class="mosaic-img" src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt=""
                     loading="eager"/>
                <img class="mosaic-img" src="https://images.unsplash.com/photo-1552728089-57bdde30beb3?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt=""
                     loading="eager"/>
                <img class="mosaic-img" src="https://images.unsplash.com/photo-1537151625747-768eb6cf92b2?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt=""
                     loading="lazy"/>
                <img class="mosaic-img" src="https://images.unsplash.com/photo-1425082661705-1834bfd09dca?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt=""
                     loading="lazy"/>
                <img class="mosaic-img" src="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt=""
                     loading="lazy"/>
                <img class="mosaic-img" src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt=""
                     loading="lazy"/>
                <img class="mosaic-img" src="https://images.unsplash.com/photo-1552728089-57bdde30beb3?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt=""
                     loading="eager"/>
                <img class="mosaic-img" src="https://images.unsplash.com/photo-1537151625747-768eb6cf92b2?w=500&amp;q=80&amp;auto=format&amp;fit=crop" alt=""
                     loading="lazy"/>
            </div>
            <div class="hero-overlay" aria-hidden="true"/>
            <div class="hero-content">
                <div class="hero-badge">

                    #1 Trusted Pet Store &amp; Shelter
                </div>
                <h1 class="hero-title">Where Every Pet<br/>Finds Their <span class="accent">Perfect</span> Match
                </h1>
                <p class="hero-subtitle">Premium food, toys, accessories &amp; expert grooming — all
                    lovingly curated for your furry, feathered, and finned family.
                </p>
                <div class="hero-cta">
                    <a href="/shop" class="btn btn-primary btn-lg">
                        <iconify-icon icon="lucide:shopping-bag" style="font-size:17px"/>
                        Shop Now
                    </a>
                    <a href="/services" class="btn btn-glass btn-lg">
                        <iconify-icon icon="lucide:scissors" style="font-size:17px"/>
                        Our Services
                    </a>
                </div>
                <div class="hero-pill-stats">
                    <div class="hero-stat-item">
                        <div class="hero-stat-num" data-t="12">0</div>
                        <div class="hero-stat-label">Happy Owners (k+)</div>
                    </div>
                    <div class="hero-stat-item">
                        <div class="hero-stat-num" data-t="500">0</div>
                        <div class="hero-stat-label">Products</div>
                    </div>
                    <div class="hero-stat-item">
                        <div class="hero-stat-num">4.9★</div>
                        <div class="hero-stat-label">Avg Rating</div>
                    </div>
                    <div class="hero-stat-item">
                        <div class="hero-stat-num">48h</div>
                        <div class="hero-stat-label">Fast Delivery</div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
