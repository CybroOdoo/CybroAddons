<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Editor option that keeps the live Petzen blocks dynamic when the page is saved -->
    <template id="petzen_snippet_options" inherit_id="website.snippet_options" name="Petzen Snippet Options">
        <xpath expr="." position="inside">
            <div data-js="PetzenDynamicBlock" data-selector=".pz-dynamic-block"/>
        </xpath>
    </template>
</odoo>
