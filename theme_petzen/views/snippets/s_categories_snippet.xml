<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Petzen Categories ("Shop by Category")
         Dynamic: the tiles are loaded by static/src/js/categories_snippet.js from
         /petzen/snippet/categories (website._petzen_category_cards: "Pets Category"
         categories, image, product count, shop link). Also written inline on the home
         and shop pages (views/home.xml, views/shop.xml): keep them in sync.
         data-limit = max number of tiles. The heading stays editable. -->
    <template id="s_petzen_categories" name="Petzen Categories">
        <section class="pz-scope section s_petzen_categories" data-snippet="s_petzen_categories"
                 data-name="Petzen Categories" data-limit="5">
            <div class="section-header">
                <div>
                    <div class="section-eyebrow">Browse by Pet</div>
                    <h2 class="section-title">Shop by Category</h2>
                </div>
                <a href="/shop" class="see-all-link">View all <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon></a>
            </div>
            <div class="categories-bento o_not_editable"/>
            <p class="search-empty pz-categories-empty d-none o_not_editable">No categories found.</p>
        </section>
    </template>
</odoo>
