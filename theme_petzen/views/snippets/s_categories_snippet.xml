<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Snippet Petzen Categories: heading is editable, the tiles are loaded live from
         /petzen/home/categories by the PetzenCategories widget. -->
    <template id="s_petzen_categories" name="Petzen Categories">
        <section class="pz-scope section s_petzen_categories pz-dynamic-block"
                 data-snippet="s_petzen_categories" data-name="Petzen Categories"
                 data-pz-dynamic="categories" id="categories">
            <div class="section-header">
                <div>
                    <div class="section-eyebrow">Browse by Pet</div>
                    <h2 class="section-title">Shop by Category</h2>
                </div>
                <a href="/shop" class="see-all-link">View all
                    <iconify-icon icon="lucide:arrow-right" style="font-size:16px"></iconify-icon>
                </a>
            </div>
            <div class="pz-dynamic-body o_not_editable"/>
        </section>
    </template>
</odoo>
