<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- /reviews — customer reviews page: approved reviews (static/src/js/reviews.js) and the "Leave a Review" form. -->
    <template id="reviews_page_template" name="Reviews">
        <t t-call="website.layout">
            <!-- ══ PRELOADER ══ (outside the editable area) -->
            <div class="pz-scope preloader" id="preloader">
<div class="pl-inner">
  <span class="pl-logo">PETZEN<i>.</i></span>
  <div class="pl-track"><div class="pl-fill"/></div>
</div>
  </div>

            <!-- the whole page content is editable in the website editor (blocks can be
                 edited, moved, removed or added); approved reviews are loaded by JS -->
            <div id="wrap" class="oe_structure oe_empty pz-scope pz-page-reviews">

  <!-- ══ PAGE BANNER ══ -->
  <section class="page-banner" data-name="Banner">
<div class="page-banner-inner">
  <div class="page-banner-eyebrow">Customer Stories</div>
  <h1 class="page-banner-title">What Our <span>Community</span> Says</h1>
  <p class="page-banner-sub">Real reviews from real pet owners who found their perfect match at Petzen.</p>
  <div class="page-banner-actions">
    <a href="#reviews" class="btn btn-primary btn-lg">
      <iconify-icon icon="lucide:star" style="font-size:17px"></iconify-icon>
      Read Reviews
    </a>
    <a href="#leave-review" class="btn btn-glass btn-lg">
      <iconify-icon icon="lucide:pencil" style="font-size:17px"></iconify-icon>
      Leave a Review
    </a>
  </div>
</div>
  </section>

  <!-- ══ STATS ROW ══ -->
  <section class="reviews-stats" data-name="Stats">
<div class="features-strip-inner">
  <div class="feature-item">
    <span class="feature-icon-wrap"><iconify-icon icon="lucide:star" style="font-size:22px"></iconify-icon></span>
    <div>
      <div class="feature-title">4.9/5 Rating</div>
      <div class="feature-sub">Based on 2,400+ reviews</div>
    </div>
  </div>
  <div class="feature-item">
    <span class="feature-icon-wrap"><iconify-icon icon="lucide:users" style="font-size:22px"></iconify-icon></span>
    <div>
      <div class="feature-title">12,000+ Customers</div>
      <div class="feature-sub">Happy pet owners</div>
    </div>
  </div>
  <div class="feature-item">
    <span class="feature-icon-wrap"><iconify-icon icon="lucide:award" style="font-size:22px"></iconify-icon></span>
    <div>
      <div class="feature-title">#1 Rated</div>
      <div class="feature-sub">Pet store in the region</div>
    </div>
  </div>
  <div class="feature-item">
    <span class="feature-icon-wrap"><iconify-icon icon="lucide:thumbs-up" style="font-size:22px"></iconify-icon></span>
    <div>
      <div class="feature-title">98% Satisfied</div>
      <div class="feature-sub">Would recommend us</div>
    </div>
  </div>
</div>
  </section>

  <!-- ══ TESTIMONIALS ══ -->
  <!-- the section stays (oe_unremovable / oe_unmovable): only its cards can be removed -->
  <section class="testimonials-section reviews-page oe_unremovable oe_unmovable" id="reviews" data-name="Testimonials">
<div class="section-header">
  <div>
    <div class="section-eyebrow">Testimonials</div>
    <h2 class="section-title">Stories from Our Community</h2>
  </div>
</div>
<div class="testi-layout pz-approved-reviews">
  <!-- approved customer reviews (petzen.review) are added here by static/src/js/reviews.js -->

  <!-- 1 — FEATURED -->
  <div class="testi-card featured-testi reveal">
    <div class="testi-stars">★★★★★</div>
    <p class="testi-text">"Petzen transformed our family's life. We adopted Buddy, our Golden Retriever, and the whole experience was incredible from start to finish. The team was knowledgeable, caring, and genuinely passionate about finding the right match. Six months later, Buddy is the heart of our home."</p>
    <div class="testi-author">
      <img class="testi-avatar" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=120&amp;q=80&amp;auto=format&amp;fit=crop" alt="Sarah M." loading="lazy" />
      <div>
        <div class="testi-name">Sarah M.</div>
        <div class="testi-pet">Dog Owner</div>
      </div>
    </div>
  </div>

  <!-- 2 -->
  <div class="testi-card reveal" data-delay="0.06">
    <div class="testi-stars">★★★★★</div>
    <p class="testi-text">"The grooming service is exceptional. Luna comes back looking and smelling amazing every time. Highly recommend!"</p>
    <div class="testi-author">
      <img class="testi-avatar" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=120&amp;q=80&amp;auto=format&amp;fit=crop" alt="James K." loading="lazy" />
      <div>
        <div class="testi-name">James K.</div>
        <div class="testi-pet">Cat Dad</div>
      </div>
    </div>
  </div>

  <!-- 3 -->
  <div class="testi-card reveal" data-delay="0.12">
    <div class="testi-stars">★★★★★</div>
    <p class="testi-text">"Found everything I needed for my parrots in one place. Great product range and super fast delivery."</p>
    <div class="testi-author">
      <img class="testi-avatar" src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=120&amp;q=80&amp;auto=format&amp;fit=crop" alt="Priya S." loading="lazy" />
      <div>
        <div class="testi-name">Priya S.</div>
        <div class="testi-pet">Bird Lover</div>
      </div>
    </div>
  </div>

  <!-- 4 -->
  <div class="testi-card reveal" data-delay="0.06">
    <div class="testi-stars">★★★★★</div>
    <p class="testi-text">"The training program is world-class. My dog went from unruly to perfectly behaved in just 4 weeks."</p>
    <div class="testi-author">
      <img class="testi-avatar" src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=120&amp;q=80&amp;auto=format&amp;fit=crop" alt="Tom R." loading="lazy" />
      <div>
        <div class="testi-name">Tom R.</div>
        <div class="testi-pet">Dog Trainer</div>
      </div>
    </div>
  </div>

  <!-- 5 -->
  <div class="testi-card reveal" data-delay="0.12">
    <div class="testi-stars">★★★★★</div>
    <p class="testi-text">"As a first-time pet owner, the team walked me through everything. I never felt lost or overwhelmed."</p>
    <div class="testi-author">
      <img class="testi-avatar" src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=120&amp;q=80&amp;auto=format&amp;fit=crop" alt="Emily C." loading="lazy" />
      <div>
        <div class="testi-name">Emily C.</div>
        <div class="testi-pet">New Pet Owner</div>
      </div>
    </div>
  </div>

  <!-- 6 -->
  <div class="testi-card reveal" data-delay="0.18">
    <div class="testi-stars">★★★★★</div>
    <p class="testi-text">"Adopted Coco through Petzen. The adoption counseling was thorough and they made sure it was the right fit."</p>
    <div class="testi-author">
      <img class="testi-avatar" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=120&amp;q=80&amp;auto=format&amp;fit=crop" alt="David L." loading="lazy" />
      <div>
        <div class="testi-name">David L.</div>
        <div class="testi-pet">Cat Adopter</div>
      </div>
    </div>
  </div>

  <!-- 7 -->
  <div class="testi-card reveal" data-delay="0.12">
    <div class="testi-stars">★★★★★</div>
    <p class="testi-text">"Incredible selection of fish and aquatic supplies. The staff knowledge about aquarium setup is outstanding."</p>
    <div class="testi-author">
      <img class="testi-avatar" src="https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?w=120&amp;q=80&amp;auto=format&amp;fit=crop" alt="Maria G." loading="lazy" />
      <div>
        <div class="testi-name">Maria G.</div>
        <div class="testi-pet">Fish Keeper</div>
      </div>
    </div>
  </div>

  <!-- 8 -->
  <div class="testi-card reveal" data-delay="0.18">
    <div class="testi-stars">★★★★★</div>
    <p class="testi-text">"Vet care is top notch. Dr. Chen saved my dog's life last year. I trust Petzen with everything."</p>
    <div class="testi-author">
      <img class="testi-avatar" src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=120&amp;q=80&amp;auto=format&amp;fit=crop" alt="Alex W." loading="lazy" />
      <div>
        <div class="testi-name">Alex W.</div>
        <div class="testi-pet">Dog Dad</div>
      </div>
    </div>
  </div>

</div>
  </section>

  <!-- ══ LEAVE A REVIEW ══ -->
  <!-- the review form can't be removed / moved; its fields are not editable (o_not_editable) -->
  <section class="review-form-section oe_unremovable oe_unmovable" id="leave-review" data-name="Leave a Review">
<div class="section-header">
  <div>
    <div class="section-eyebrow">Share Your Experience</div>
    <h2 class="section-title">Leave a Review</h2>
  </div>
</div>
<div class="review-form-wrap reveal o_not_editable">
  <form id="review-form">
    <div class="booking-form-grid">

      <div class="booking-field">
        <label for="review-name">Your Name</label>
        <input type="text" id="review-name" name="name" placeholder="e.g. Sarah M." required="required" />
      </div>

      <div class="booking-field">
        <label for="review-email">Email Address</label>
        <input type="email" id="review-email" name="email" placeholder="you@example.com" required="required" />
      </div>

      <div class="booking-field full">
        <label for="review-customer-type">I am a…</label>
        <!-- options = petzen.review "Reviewer Type", loaded by static/src/js/reviews.js -->
        <select id="review-customer-type" name="customer_type"/>
      </div>

      <div class="booking-field full">
        <label>Rating</label>
        <div style="display:flex;gap:8px;align-items:center;" id="star-row">
          <button type="button" class="star-pick" data-v="1" style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;" aria-label="1 star">★</button>
          <button type="button" class="star-pick" data-v="2" style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;" aria-label="2 stars">★</button>
          <button type="button" class="star-pick" data-v="3" style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;" aria-label="3 stars">★</button>
          <button type="button" class="star-pick" data-v="4" style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;" aria-label="4 stars">★</button>
          <button type="button" class="star-pick" data-v="5" style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;" aria-label="5 stars">★</button>
        </div>
        <input type="hidden" id="star-val" name="rating" value="5" />
      </div>

      <div class="booking-field full">
        <label for="review-text">Your Review</label>
        <textarea id="review-text" name="review" placeholder="Tell us about your experience — what did you love? What stood out?" required="required"></textarea>
      </div>

      <div class="full" style="padding-top:6px;">
        <button type="submit" class="booking-submit">
          <iconify-icon icon="lucide:send" style="font-size:16px"></iconify-icon>
          Submit Review
        </button>
      </div>

    </div>
  </form>
  <div class="review-error-banner" id="review-error-banner">
    <iconify-icon icon="lucide:alert-circle" style="font-size:18px"></iconify-icon>
    <span id="review-error-text">Something went wrong. Please try again.</span>
  </div>
</div>
  </section>

            </div>
  <!-- ══ REVIEW SUCCESS MODAL ══ (outside the editable area) -->
  <div class="pz-scope review-modal-overlay" id="review-success-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
<div class="review-modal">
  <div class="review-modal-icon">
    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
  </div>
  <span class="review-modal-stars" id="modal-stars">★★★★★</span>
  <h3 class="review-modal-title" id="modal-title">Thank You!</h3>
  <p class="review-modal-sub">Your review has been submitted successfully and is pending approval. We truly appreciate you taking the time to share your experience with us.</p>
  <button type="button" class="review-modal-close" id="review-modal-close-btn">
    <iconify-icon icon="lucide:check" style="font-size:16px"></iconify-icon>
    Done
  </button>
</div>
  </div>

        </t>
    </template>
</odoo>
