<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--  Review template -->
    <template id="reviews_page_template" name="Reviews">
        <t t-call="website.layout">
            <div id="wrap" class="pz-scope pz-page-reviews">
                <!-- ══ PRELOADER ══ -->
                <div class="preloader" id="preloader">
                    <div class="pl-inner">
                        <span class="pl-logo">PETZEN
                            <i>.</i>
                        </span>
                        <div class="pl-track">
                            <div class="pl-fill"></div>
                        </div>
                    </div>
                </div>

                <!-- ══ PAGE BANNER ══ -->
                <section class="page-banner">
                    <div class="page-banner-inner">
                        <div class="page-banner-eyebrow">Customer Stories</div>
                        <h1 class="page-banner-title">What Our <span>Community</span> Says
                        </h1>
                        <p class="page-banner-sub">Real reviews from real pet owners who found their perfect match
                            at Petzen.
                        </p>
                        <div class="page-banner-actions">
                            <a href="#reviews" class="btn btn-primary btn-lg">
                                <iconify-icon icon="lucide:star" style="font-size:17px"></iconify-icon>
                                Read Reviews
                            </a>
                            <a href="#leave-review" class="btn btn-glass btn-lg">
                                <iconify-icon icon="lucide:pencil" style="font-size:17px"></iconify-icon>
                                Leave a Review
                            </a>
                        </div>
                    </div>
                </section>

                <!-- ══ STATS ROW ══ -->
                <section class="reviews-stats">
                    <div class="features-strip-inner">
                        <div class="feature-item">
                            <span class="feature-icon-wrap">
                                <iconify-icon icon="lucide:star" style="font-size:22px"></iconify-icon>
                            </span>
                            <div>
                                <div class="feature-title">4.9/5 Rating</div>
                                <div class="feature-sub">Based on 2,400+ reviews</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon-wrap">
                                <iconify-icon icon="lucide:users" style="font-size:22px"></iconify-icon>
                            </span>
                            <div>
                                <div class="feature-title">12,000+ Customers</div>
                                <div class="feature-sub">Happy pet owners</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon-wrap">
                                <iconify-icon icon="lucide:award" style="font-size:22px"></iconify-icon>
                            </span>
                            <div>
                                <div class="feature-title">#1 Rated</div>
                                <div class="feature-sub">Pet store in the region</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon-wrap">
                                <iconify-icon icon="lucide:thumbs-up" style="font-size:22px"></iconify-icon>
                            </span>
                            <div>
                                <div class="feature-title">98% Satisfied</div>
                                <div class="feature-sub">Would recommend us</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ══ TESTIMONIALS ══ -->
                <section class="testimonials-section reviews-page js_petzen_reviews" id="reviews">
                    <div class="section-header">
                        <div>
                            <div class="section-eyebrow">Testimonials</div>
                            <h2 class="section-title">Stories from Our Community</h2>
                        </div>
                    </div>
                </section>

                <!-- ══ LEAVE A REVIEW ══ -->
                <section class="review-form-section" id="leave-review">
                    <div class="section-header">
                        <div>
                            <div class="section-eyebrow">Share Your Experience</div>
                            <h2 class="section-title">Leave a Review</h2>
                        </div>
                    </div>
                    <div class="review-form-wrap reveal">
                        <form id="review-form">
                            <div class="booking-form-grid">

                                <div class="booking-field">
                                    <label for="review-name">Your Name</label>
                                    <input type="text" id="review-name" name="name" placeholder="e.g. Sarah M."
                                           required="required"/>
                                </div>

                                <div class="booking-field">
                                    <label for="review-email">Email Address</label>
                                    <input type="email" id="review-email" name="email" placeholder="you@example.com"
                                           required="required"/>
                                </div>

                                <div class="booking-field full">
                                    <label>Rating</label>
                                    <div style="display:flex;gap:8px;align-items:center;" id="star-row">
                                        <button type="button" class="star-pick" data-v="1"
                                                style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;"
                                                aria-label="1 star">★
                                        </button>
                                        <button type="button" class="star-pick" data-v="2"
                                                style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;"
                                                aria-label="2 stars">★
                                        </button>
                                        <button type="button" class="star-pick" data-v="3"
                                                style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;"
                                                aria-label="3 stars">★
                                        </button>
                                        <button type="button" class="star-pick" data-v="4"
                                                style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;"
                                                aria-label="4 stars">★
                                        </button>
                                        <button type="button" class="star-pick" data-v="5"
                                                style="font-size:28px;color:var(--border);background:none;border:none;cursor:pointer;padding:0;line-height:1;"
                                                aria-label="5 stars">★
                                        </button>
                                    </div>
                                    <input type="hidden" id="star-val" name="rating" value="5"/>
                                </div>

                                <div class="booking-field full">
                                    <label for="review-text">Your Review</label>
                                    <textarea id="review-text" name="review"
                                              placeholder="Tell us about your experience — what did you love? What stood out?"
                                              required="required"></textarea>
                                </div>

                                <div class="full" style="padding-top:6px;">
                                    <button type="submit" class="booking-submit">
                                        <iconify-icon icon="lucide:send" style="font-size:16px"></iconify-icon>
                                        Submit Review
                                    </button>
                                </div>

                            </div>
                        </form>
                        <div class="review-error-banner" id="review-error-banner">
                            <iconify-icon icon="lucide:alert-circle" style="font-size:18px"></iconify-icon>
                            <span id="review-error-text">Something went wrong. Please try again.</span>
                        </div>
                    </div>
                </section>

                <!-- ══ REVIEW SUCCESS MODAL ══ -->
                <div class="review-modal-overlay" id="review-success-modal" role="dialog" aria-modal="true"
                     aria-labelledby="modal-title">
                    <div class="review-modal">
                        <div class="review-modal-icon">
                            <svg viewBox="0 0 24 24">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        <span class="review-modal-stars" id="modal-stars">★★★★★</span>
                        <h3 class="review-modal-title" id="modal-title">Thank You!</h3>
                        <p class="review-modal-sub">Your review has been submitted successfully and is pending
                            approval. We truly appreciate you taking the time to share your experience with us.
                        </p>
                        <button type="button" class="review-modal-close" id="review-modal-close-btn">
                            <iconify-icon icon="lucide:check" style="font-size:16px"></iconify-icon>
                            Done
                        </button>
                    </div>
                </div>

                <div class="oe_structure" id="oe_structure_reviews_page_template_bottom"/>
            </div>
        </t>
    </template>
    <!--  Review website menu -->
    <record id="website_menu_reviews" model="theme.website.menu">
        <field name="name">Reviews</field>
        <field name="url">/reviews</field>
        <field name="parent_id" search="[('url', '=', ''), ('parent_id', '=', False)]"/>
        <field name="sequence">50</field>
    </record>

</odoo>
