<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- /about — About Us page of the theme (route in controllers/theme_petzen.py). -->
    <template id="about_page_template" name="About Us">
        <t t-call="website.layout">
            <div id="wrap" class="pz-scope pz-page-about">

  <!-- ══ PAGE BANNER ══ -->
  <section class="page-banner">
<div class="page-banner-inner">
  <div class="page-banner-eyebrow">Our Story</div>
  <h1 class="page-banner-title">Meet the Team <span>Behind Petzen</span></h1>
  <p class="page-banner-sub">Founded in 2019 with a simple belief: every pet deserves a loving home and exceptional care. Today we serve 12,000+ happy pet owners.</p>
  <div class="page-banner-actions">
    <a href="/contact" class="btn btn-primary btn-lg">Contact Us</a>
    <a href="/services" class="btn btn-glass btn-lg">Our Services</a>
  </div>
</div>
  </section>

  <!-- ══ OUR STORY ══ -->
  <section class="section">
<div class="about-story-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;">
  <div>
    <div class="section-eyebrow">Who We Are</div>
    <h2 class="section-title" style="margin-bottom:20px;">A Team That Truly Loves Animals</h2>
    <p style="color:var(--muted-foreground);line-height:1.8;margin-bottom:16px;">Petzen was born from a simple frustration: finding quality pet care shouldn't be this hard. Our founders, lifelong animal lovers, set out to create a one-stop destination where pets get the premium care they deserve and families find their perfect match.</p>
    <p style="color:var(--muted-foreground);line-height:1.8;margin-bottom:28px;">Today, with a team of 45+ certified professionals — vets, groomers, trainers, and adoption counselors — we've helped over 1,200 pets find forever homes and serve 12,000 happy pet owners every month.</p>
    <div style="display:flex;gap:40px;flex-wrap:wrap;">
      <div style="text-align:center;">
        <div style="font-family:var(--f-disp);font-size:36px;font-weight:900;color:var(--primary);">2019</div>
        <div style="font-size:13px;color:var(--muted-foreground);font-weight:500;">Founded</div>
      </div>
      <div style="text-align:center;">
        <div style="font-family:var(--f-disp);font-size:36px;font-weight:900;color:var(--primary);">45+</div>
        <div style="font-size:13px;color:var(--muted-foreground);font-weight:500;">Team Members</div>
      </div>
      <div style="text-align:center;">
        <div style="font-family:var(--f-disp);font-size:36px;font-weight:900;color:var(--primary);">12k+</div>
        <div style="font-size:13px;color:var(--muted-foreground);font-weight:500;">Happy Customers</div>
      </div>
    </div>
  </div>
  <div style="position:relative;">
    <img src="https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=700&amp;q=85&amp;auto=format&amp;fit=crop" alt="Team with dogs" style="width:100%;border-radius:24px;object-fit:cover;" loading="lazy" />
  </div>
</div>
  </section>

  <!-- ══ VALUES ══ -->
  <section class="section about-values-section" style="background:var(--muted);">
<div style="max-width:1080px;margin:0 auto;">
  <div class="section-header">
    <div>
      <div class="section-eyebrow">What Drives Us</div>
      <h2 class="section-title">Our Core Values</h2>
    </div>
  </div>
  <div class="about-values-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">

    <div class="svc-card reveal">
      <div class="svc-card-top">
        <span class="svc-card-num">01</span>
        <span class="svc-card-icon"><iconify-icon icon="lucide:heart" style="font-size:26px"></iconify-icon></span>
      </div>
      <h3 class="svc-card-name">Compassion First</h3>
      <p class="svc-card-desc">Every decision we make puts animal welfare and family happiness first.</p>
    </div>

    <div class="svc-card reveal" data-delay="0.1">
      <div class="svc-card-top">
        <span class="svc-card-num">02</span>
        <span class="svc-card-icon"><iconify-icon icon="lucide:shield-check" style="font-size:26px"></iconify-icon></span>
      </div>
      <h3 class="svc-card-name">Trust &amp; Transparency</h3>
      <p class="svc-card-desc">Clear processes, honest pricing, and no surprises ever.</p>
    </div>

    <div class="svc-card reveal" data-delay="0.2">
      <div class="svc-card-top">
        <span class="svc-card-num">03</span>
        <span class="svc-card-icon"><iconify-icon icon="lucide:leaf" style="font-size:26px"></iconify-icon></span>
      </div>
      <h3 class="svc-card-name">Sustainable Care</h3>
      <p class="svc-card-desc">Eco-friendly products, ethical sourcing, and a commitment to the planet.</p>
    </div>

  </div>
</div>
  </section>

  <!-- ══ TEAM ══ -->
  <section class="section">
<div class="section-header">
  <div>
    <div class="section-eyebrow">The People</div>
    <h2 class="section-title">Meet Our Team</h2>
  </div>
</div>
<div class="about-team-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;">

  <div class="reveal" style="background:#fff;border-radius:20px;padding:32px 24px;text-align:center;box-shadow:0 1px 3px rgba(26,18,8,.04),0 8px 24px rgba(26,18,8,.07);">
    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=160&amp;q=80&amp;auto=format&amp;fit=crop" alt="Dr. Sarah Chen" style="width:80px;height:80px;border-radius:50%;object-fit:cover;margin:0 auto 16px;" loading="lazy" />
    <div style="font-family:var(--f-disp);font-size:17px;font-weight:700;color:var(--foreground);">Dr. Sarah Chen</div>
    <div style="font-size:13px;color:var(--primary);font-weight:600;margin:4px 0 10px;">Head Veterinarian</div>
    <p style="font-size:13px;color:var(--muted-foreground);line-height:1.6;">Board-certified vet with 12 years of experience in small animal medicine.</p>
  </div>

  <div class="reveal" data-delay="0.08" style="background:#fff;border-radius:20px;padding:32px 24px;text-align:center;box-shadow:0 1px 3px rgba(26,18,8,.04),0 8px 24px rgba(26,18,8,.07);">
    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=160&amp;q=80&amp;auto=format&amp;fit=crop" alt="Marcus T." style="width:80px;height:80px;border-radius:50%;object-fit:cover;margin:0 auto 16px;" loading="lazy" />
    <div style="font-family:var(--f-disp);font-size:17px;font-weight:700;color:var(--foreground);">Marcus T.</div>
    <div style="font-size:13px;color:var(--primary);font-weight:600;margin:4px 0 10px;">Lead Trainer</div>
    <p style="font-size:13px;color:var(--muted-foreground);line-height:1.6;">Award-winning dog trainer specializing in positive reinforcement methods.</p>
  </div>

  <div class="reveal" data-delay="0.16" style="background:#fff;border-radius:20px;padding:32px 24px;text-align:center;box-shadow:0 1px 3px rgba(26,18,8,.04),0 8px 24px rgba(26,18,8,.07);">
    <img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=160&amp;q=80&amp;auto=format&amp;fit=crop" alt="Aisha P." style="width:80px;height:80px;border-radius:50%;object-fit:cover;margin:0 auto 16px;" loading="lazy" />
    <div style="font-family:var(--f-disp);font-size:17px;font-weight:700;color:var(--foreground);">Aisha P.</div>
    <div style="font-size:13px;color:var(--primary);font-weight:600;margin:4px 0 10px;">Adoption Counselor</div>
    <p style="font-size:13px;color:var(--muted-foreground);line-height:1.6;">Passionate advocate for animal welfare with 8 years in rescue coordination.</p>
  </div>

  <div class="reveal" data-delay="0.24" style="background:#fff;border-radius:20px;padding:32px 24px;text-align:center;box-shadow:0 1px 3px rgba(26,18,8,.04),0 8px 24px rgba(26,18,8,.07);">
    <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=160&amp;q=80&amp;auto=format&amp;fit=crop" alt="James R." style="width:80px;height:80px;border-radius:50%;object-fit:cover;margin:0 auto 16px;" loading="lazy" />
    <div style="font-family:var(--f-disp);font-size:17px;font-weight:700;color:var(--foreground);">James R.</div>
    <div style="font-size:13px;color:var(--primary);font-weight:600;margin:4px 0 10px;">Head Groomer</div>
    <p style="font-size:13px;color:var(--muted-foreground);line-height:1.6;">Certified master groomer with a gentle touch and an eye for style.</p>
  </div>

</div>
  </section>

  <div class="oe_structure" id="petzen_about_bottom"/>
            </div>
        </t>
    </template>
</odoo>
