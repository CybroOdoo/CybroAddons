<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Product category form: "Pets Category" flag (categories of the Petzen snippets)
         and image of the category tiles of the Petzen home page -->
    <record id="product_category_form_view" model="ir.ui.view">
        <field name="name">product.category.view.form.inherit.theme.petzen</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="is_pets_category"/>
                <field name="image_1920" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
            </xpath>
        </field>
    </record>

    <!-- Product category list: "Pets Category" column -->
    <record id="product_category_list_view" model="ir.ui.view">
        <field name="name">product.category.view.list.inherit.theme.petzen</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="is_pets_category" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
