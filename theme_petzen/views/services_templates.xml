<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="services_page_template" name="Services">
        <t t-call="website.layout">
            <div id="wrap" class="pz-scope pz-page-services">

      <!-- ══ PAGE BANNER ══ -->
      <section class="page-banner">
        <div class="page-banner-inner">
          <div class="page-banner-eyebrow">Expert Care</div>
          <h1 class="page-banner-title">Services for Your <span>Pet</span></h1>
          <p class="page-banner-sub">Certified professionals, premium treatments, and stress-free care — all under one roof.</p>
          <div class="page-banner-actions">
    <a href="#booking" class="btn btn-primary btn-lg">Book a Service</a>
    <a href="#pricing" class="btn btn-glass btn-lg">View Pricing</a>
          </div>
        </div>
      </section>

      <!-- ══ SERVICES SECTION ══ -->
      <section class="services-section" id="services">
        <div class="section-header">
          <div>
    <div class="section-eyebrow">Care Services</div>
    <h2 class="section-title">Pamper Your Pet</h2>
    <p class="svc-subtitle">Expert care, under one roof — certified team, zero stress.</p>
          </div>
        </div>
        <div class="svc-cards">

          <div class="svc-card reveal">
    <div class="svc-card-top">
      <span class="svc-card-num">01</span>
      <span class="svc-card-icon"><iconify-icon icon="lucide:scissors" style="font-size:26px"/></span>
    </div>
    <h3 class="svc-card-name">Grooming &amp; Spa</h3>
    <p class="svc-card-desc">Full coat treatment, nail care and styling by certified groomers — your pet leaves looking their best.</p>
    <ul class="svc-card-features">
      <li>Full bath &amp; blow-dry</li>
      <li>Nail trimming &amp; filing</li>
      <li>Coat styling &amp; de-shed</li>
    </ul>
    <div class="svc-card-footer">
      <div class="svc-card-price">$29<span>/ session</span></div>
      <a href="#booking" class="svc-card-btn" data-pz-service="grooming">Book <iconify-icon icon="lucide:arrow-right" style="font-size:13px"/></a>
    </div>
          </div>

          <div class="svc-card svc-card-dark reveal" data-delay="0.08">
    <div class="svc-card-top">
      <span class="svc-card-num">02</span>
      <span class="svc-card-icon"><iconify-icon icon="lucide:stethoscope" style="font-size:26px"/></span>
    </div>
    <h3 class="svc-card-name">Veterinary Care</h3>
    <p class="svc-card-desc">Routine check-ups, vaccinations and comprehensive health screening by licensed veterinarians.</p>
    <ul class="svc-card-features">
      <li>Health &amp; wellness exams</li>
      <li>Core vaccinations</li>
      <li>Parasite prevention</li>
    </ul>
    <div class="svc-card-footer">
      <div class="svc-card-price">$45<span>/ visit</span></div>
      <a href="#booking" class="svc-card-btn" data-pz-service="veterinary">Book <iconify-icon icon="lucide:arrow-right" style="font-size:13px"/></a>
    </div>
          </div>

          <div class="svc-card reveal" data-delay="0.16">
    <div class="svc-card-top">
      <span class="svc-card-num">03</span>
      <span class="svc-card-icon"><iconify-icon icon="lucide:graduation-cap" style="font-size:26px"/></span>
    </div>
    <h3 class="svc-card-name">Training &amp; Behavior</h3>
    <p class="svc-card-desc">One-on-one obedience and behavior coaching with our award-winning certified trainers.</p>
    <ul class="svc-card-features">
      <li>Basic &amp; advanced obedience</li>
      <li>Behavior correction</li>
      <li>Puppy starter classes</li>
    </ul>
    <div class="svc-card-footer">
      <div class="svc-card-price">$60<span>/ class</span></div>
      <a href="#booking" class="svc-card-btn" data-pz-service="training">Book <iconify-icon icon="lucide:arrow-right" style="font-size:13px"/></a>
    </div>
          </div>

        </div>
      </section>

      <!-- ══ WHY CHOOSE US ══ -->
      <section class="section" id="pricing" style="background:var(--muted);">
        <div class="section-header">
          <div>
    <div class="section-eyebrow">Why Petzen</div>
    <h2 class="section-title">Why Choose Us</h2>
          </div>
        </div>
        <div class="why-grid">

          <div class="why-card reveal">
    <div class="why-card-icon">
      <iconify-icon icon="lucide:award" style="font-size:24px"/>
    </div>
    <div class="why-card-title">Certified Team</div>
    <p class="why-card-desc">All groomers, vets and trainers are fully certified and insured — your pet is always in expert hands.</p>
          </div>

          <div class="why-card reveal" data-delay="0.07">
    <div class="why-card-icon">
      <iconify-icon icon="lucide:clock" style="font-size:24px"/>
    </div>
    <div class="why-card-title">Same-Day Booking</div>
    <p class="why-card-desc">Book online and get confirmed within the hour. Flexible slots available Monday to Saturday.</p>
          </div>

          <div class="why-card reveal" data-delay="0.14">
    <div class="why-card-icon">
      <iconify-icon icon="lucide:shield-check" style="font-size:24px"/>
    </div>
    <div class="why-card-title">100% Safe</div>
    <p class="why-card-desc">We use only pet-safe, hypoallergenic products — gentle on sensitive skin and coats.</p>
          </div>

          <div class="why-card reveal" data-delay="0.21">
    <div class="why-card-icon">
      <iconify-icon icon="lucide:smile" style="font-size:24px"/>
    </div>
    <div class="why-card-title">Happy Guarantee</div>
    <p class="why-card-desc">Not satisfied? We'll redo the service completely free — no questions asked.</p>
          </div>

        </div>
      </section>

      <!-- ══ BOOKING ══
           the form can't be removed / moved; its fields are not editable (o_not_editable).
           Sent to /petzen/booking (static/src/js/booking.js): creates a CRM lead. -->
      <section class="section booking-section oe_unremovable oe_unmovable" id="booking" data-name="Booking">
        <div class="section-header">
          <div>
    <div class="section-eyebrow">Book a Service</div>
    <h2 class="section-title">Request an Appointment</h2>
    <p class="svc-subtitle">Tell us what your pet needs: our team confirms your slot by email or phone.</p>
          </div>
        </div>
        <div class="o_not_editable">
          <form id="booking-form" class="booking-form">
    <div class="booking-field">
      <label for="booking-name">Your Name</label>
      <input type="text" id="booking-name" name="name" placeholder="e.g. Sarah M." required="required"/>
    </div>
    <div class="booking-field">
      <label for="booking-email">Email Address</label>
      <input type="email" id="booking-email" name="email" placeholder="you@example.com" required="required"/>
    </div>
    <div class="booking-field">
      <label for="booking-phone">Phone Number</label>
      <input type="tel" id="booking-phone" name="phone" placeholder="+1 (555) 123-4567"/>
    </div>
    <div class="booking-field">
      <label for="booking-date">Preferred Date</label>
      <input type="date" id="booking-date" name="date"/>
    </div>
    <div class="booking-field full">
      <label for="booking-service">Service</label>
      <select id="booking-service" name="service" required="required">
        <option value="grooming">Grooming &amp; Spa</option>
        <option value="veterinary">Veterinary Care</option>
        <option value="training">Training &amp; Behavior</option>
      </select>
    </div>
    <div class="booking-field full">
      <label for="booking-notes">About Your Pet</label>
      <textarea id="booking-notes" name="notes" placeholder="Breed, age, anything we should know…"/>
    </div>
    <!-- anti-spam: hidden from visitors, only filled in by bots -->
    <div class="pz-hp" aria-hidden="true">
      <label for="booking-website-url">Website</label>
      <input type="text" id="booking-website-url" name="website_url" tabindex="-1" autocomplete="off"/>
    </div>
    <button type="submit" class="booking-submit">Send Booking Request</button>
    <div class="review-error-banner full" id="booking-error-banner" role="alert">
      <iconify-icon icon="lucide:alert-circle" style="font-size:18px"/>
      <span id="booking-error-text"/>
    </div>
    <div class="booking-success full" id="booking-success" role="status">
      <iconify-icon icon="lucide:check-circle" style="font-size:18px"/>
      <span>Thank you! Your booking request has been sent. We will contact you shortly to confirm your slot.</span>
    </div>
          </form>
        </div>
      </section>

      <div class="oe_structure" id="oe_structure_services_page_template_bottom"/>
            </div>
        </t>
    </template>
</odoo>
