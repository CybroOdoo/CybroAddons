<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Menu entries of the design, as theme menus: website copies them once into
        each website's own main menu (Website > Menus / "Edit Menu" in the editor),
        next to Odoo's Home (10), Shop (20) and Contact us (60).
    -->
    <record id="theme_menu_services" model="theme.website.menu">
        <field name="name">Services</field>
        <field name="url">/services</field>
        <field name="sequence" type="int">30</field>
    </record>
    <record id="theme_menu_about" model="theme.website.menu">
        <field name="name">About</field>
        <field name="url">/about</field>
        <field name="sequence" type="int">40</field>
    </record>
    <record id="theme_menu_reviews" model="theme.website.menu">
        <field name="name">Reviews</field>
        <field name="url">/reviews</field>
        <field name="sequence" type="int">50</field>
    </record>
</odoo>
