<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Approve a review (list "Actions" menu) -->
    <record id="petzen_review_action_approve" model="ir.actions.server">
        <field name="name">Approve Review</field>
        <field name="model_id" ref="model_petzen_review"/>
        <field name="binding_model_id" ref="model_petzen_review"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_approve()</field>
    </record>

    <!-- Reject a review -->
    <record id="petzen_review_action_reject" model="ir.actions.server">
        <field name="name">Reject Review</field>
        <field name="model_id" ref="model_petzen_review"/>
        <field name="binding_model_id" ref="model_petzen_review"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_reject()</field>
    </record>
</odoo>
