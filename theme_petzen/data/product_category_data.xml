<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Parent Internal Category -->
    <record id="product_category_petzen" model="product.category">
        <field name="name">Petzen</field>
    </record>

    <!-- Child Internal Categories: default "Pets Categories" of the Petzen snippets
         (any other category can be flagged from Inventory/Sales > Product Categories) -->
    <record id="product_category_dog" model="product.category">
        <field name="name">Dog</field>
        <field name="parent_id" ref="product_category_petzen"/>
        <field name="is_pets_category" eval="True"/>
    </record>
    <record id="product_category_cat" model="product.category">
        <field name="name">Cat</field>
        <field name="parent_id" ref="product_category_petzen"/>
        <field name="is_pets_category" eval="True"/>
    </record>
    <record id="product_category_bird" model="product.category">
        <field name="name">Bird</field>
        <field name="parent_id" ref="product_category_petzen"/>
        <field name="is_pets_category" eval="True"/>
    </record>
    <record id="product_category_fish" model="product.category">
        <field name="name">Fish</field>
        <field name="parent_id" ref="product_category_petzen"/>
        <field name="is_pets_category" eval="True"/>
    </record>
    <record id="product_category_accessories" model="product.category">
        <field name="name">Accessories</field>
        <field name="parent_id" ref="product_category_petzen"/>
        <field name="is_pets_category" eval="True"/>
    </record>

    <!-- Parent eCommerce Category -->
    <record id="public_category_petzen" model="product.public.category">
        <field name="name">Petzen</field>
    </record>

    <!-- Child eCommerce Categories -->
    <record id="public_category_dog" model="product.public.category">
        <field name="name">Dog</field>
        <field name="parent_id" ref="public_category_petzen"/>
    </record>
    <record id="public_category_cat" model="product.public.category">
        <field name="name">Cat</field>
        <field name="parent_id" ref="public_category_petzen"/>
    </record>
    <record id="public_category_bird" model="product.public.category">
        <field name="name">Bird</field>
        <field name="parent_id" ref="public_category_petzen"/>
    </record>
    <record id="public_category_fish" model="product.public.category">
        <field name="name">Fish</field>
        <field name="parent_id" ref="public_category_petzen"/>
    </record>
    <record id="public_category_accessories" model="product.public.category">
        <field name="name">Accessories</field>
        <field name="parent_id" ref="public_category_petzen"/>
    </record>
</odoo>
