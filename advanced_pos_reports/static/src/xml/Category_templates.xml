<?xml version="1.0" encoding="UTF-8"?>
<!--Template for category summary button-->
<templates id="template" xml:space="preserve">
    <t t-name="advanced_pos_reports.CategorySummaryButton" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']/div/NoteButton"
               position="after">
            <t t-call="point_of_sale.controlButton"
                icon="'view_list'"
                btnText.translate="Category Summary"
                btnClasses="'btn-secondary '"
                onClick="() => this.onClickCategorySummary()"/>
        </xpath>
    </t>
</templates>
