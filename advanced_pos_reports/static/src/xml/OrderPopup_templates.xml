<?xml version="1.0" encoding="UTF-8"?>
<!--Template for order summary popup-->
<templates id="template" xml:space="preserve">
    <t t-name="advanced_pos_reports.OrderSummaryPopup">
        <Dialog size="'md'" title="this.props.title">
            <div class="popup order-summary-popup">
                <main class="body">
                    <div class="order-summary p-3">
                        <div class="form-check d-flex align-items-center mb-3">
                            <input type="checkbox" id="is_current_session"
                                   class="form-check-input me-2"
                                   style="width: 20px; height: 20px;"
                                   t-model.proxy="this.state.current_session"/>
                            <label for="is_current_session" class="form-check-label fw-bold">Current Session</label>
                        </div>
                        <div id="date_section" t-if="!this.state.current_session" class="mt-2">
                            <div class="row g-3">
                                <div class="col-6">
                                    <label for="start_date" class="form-label fw-bold">Start Date</label>
                                    <input type="date" id="start_date" class="form-control"
                                           t-model.proxy="this.state.start_date"/>
                                </div>
                                <div class="col-6">
                                    <label for="end_date" class="form-label fw-bold">End Date</label>
                                    <input type="date" id="end_date" class="form-control"
                                           t-model.proxy="this.state.end_date"/>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4">
                            <label for="order_status" class="form-label fw-bold">Status</label>
                            <select name="state" id="order_status" class="form-select" t-model.proxy="this.state.status">
                                <option value="">All Statuses</option>
                                <option value="draft">Ongoing</option>
                                <option value="paid">Paid</option>
                                <option value="done">Done</option>
                                <option value="invoiced">Invoiced</option>
                                <option value="cancel">Cancelled</option>
                            </select>
                        </div>
                    </div>
                </main>
                <footer class="footer modal-footer d-flex justify-content-end gap-2 mt-3">
                    <button class="btn btn-primary btn-lg" t-on-click="this.confirm">
                        Confirm
                    </button>
                    <button class="btn btn-secondary btn-lg" t-on-click="this.props.close">
                        Close
                    </button>
                </footer>
            </div>
        </Dialog>
    </t>
</templates>
