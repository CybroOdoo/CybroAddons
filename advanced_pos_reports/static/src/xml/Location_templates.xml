<?xml version="1.0" encoding="UTF-8"?>
<!--Template for location summary button-->
<templates id="template" xml:space="preserve">
    <t t-name="advanced_pos_reports.LocationSummaryButton" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']/div/NoteButton"
               position="after">
            <t t-call="point_of_sale.controlButton"
                icon="'place'"
                btnText.translate="Location Summary"
                btnClasses="'btn-secondary '"
                onClick="() => this.onClickLocationSummary()"/>
        </xpath>
    </t>
</templates>
