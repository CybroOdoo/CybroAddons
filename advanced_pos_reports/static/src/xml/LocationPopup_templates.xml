<?xml version="1.0" encoding="UTF-8"?>
<!--Template for location summary popup-->
<templates id="template" xml:space="preserve">
    <t t-name="advanced_pos_reports.LocationSummaryPopup">
        <Dialog size="'md'" title="this.props.title">
            <div class="popup">
                <main class="body">
                    <div class="order-summary text-center">
                        <div class="my-3">
                            <label class="form-label fw-bold mb-2">Locations</label>
                            <select class="form-select mx-auto"
                                    t-model.proxy="this.state.selected_value"
                                    style="width: 60%;">
                                <option value="">None</option>
                                <t t-foreach="this.locations" t-as="location" t-key="location.id">
                                    <option t-att-value="location.id">
                                        <t t-out="location.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                </main>
                <footer class="footer modal-footer d-flex justify-content-end gap-2">
                    <button class="button confirm highlight btn btn-primary" t-on-click="this.confirm">
                        Confirm
                    </button>
                    <button class="button cancel btn btn-secondary" t-on-click="this.props.close">
                        Cancel
                    </button>
                </footer>
            </div>
        </Dialog>
    </t>
</templates>

