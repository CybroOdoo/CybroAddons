<?xml version="1.0" encoding="UTF-8"?>
<!--Template for location summary receipt screen -->
<templates id="template" xml:space="preserve">
    <t t-name="advanced_pos_reports.LocationSummaryReceiptScreen">
        <Dialog size="'md'" title="this.props.title">
            <div>
                <div class="pos-receipt-container p-3 bg-white" t-ref="this.receiptRef">
                    <div class="pos-receipt bg-white">
                        <t t-if="this.props.data and this.props.data.company_logo">
                            <img class="pos-receipt-logo" t-att-src="this.props.data.company_logo"
                                 alt="Logo"/>
                            <br/>
                        </t>
                        <t t-else="">
                            <h2 class="pos-receipt-center-align text-center">
                                <t t-out="this.props.data?.company?.name || this.props.data?.models?.['res.company']?.getAll()?.[0]?.name || ''"/>
                            </h2>
                            <br/>
                        </t>
                        <div class="pos-receipt-contact text-center">
                            <t t-if="this.props.data?.company?.phone">
                                <div>Tel: <t t-out="this.props.data.company.phone"/></div>
                            </t>
                            <t t-if="this.props.data?.company?.email">
                                <div><t t-out="this.props.data.company.email"/></div>
                            </t>
                            <t t-if="this.props.data?.company?.website">
                                <div><t t-out="this.props.data.company.website"/></div>
                            </t>
                            <t t-if="this.props.data?.cashier?.name || this.props.data?.user?.name || this.props.data?.config?.current_user_id?.name">
                                <div class="cashier mt-2">
                                    <div>--------------------------------</div>
                                    <div>Served by <t t-out="this.props.data?.cashier?.name || this.props.data?.user?.name || this.props.data?.config?.current_user_id?.name"/></div>
                                </div>
                            </t>
                        </div>
                        <br/>
                        <h4 class="pos-receipt-center-align text-center">
                            Location Summary
                        </h4>
                        <section style="overflow:auto; max-height:400px;">
                            <table class="w-100 mt-2" style="font-size:14px !important; table-layout: fixed; word-break: break-word;">
                                <colgroup>
                                    <col style="width: 70%;"/>
                                    <col style="width: 30%;"/>
                                </colgroup>
                                <thead style="border-bottom: 2px solid black;">
                                    <tr>
                                        <th style="text-align: left;">Product</th>
                                        <th style="text-align: right;">Quantity</th>
                                    </tr>
                                </thead>
                                <tbody class="mt-1">
                                    <t t-set="total" t-value="0"/>
                                    <tr t-foreach="this.props.locations" t-as="loc"
                                        t-key="loc.product_id">
                                        <td style="text-align: left;">
                                            <t t-out="loc.product"/>
                                        </td>
                                        <td style="text-align: right;">
                                            <t t-out="loc.quantity"/>
                                        </td>
                                        <t t-set="total" t-value="total + loc.quantity"/>
                                    </tr>
                                    <tr style="border-top: 2px solid black;">
                                        <td style="text-align: left;"><strong>Total:</strong></td>
                                        <td style="text-align: right;">
                                            <strong><t t-out="total"/></strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </section>
                    </div>
                </div>
                <footer class="footer modal-footer d-flex flex-column gap-2 p-3">
                    <button class="btn btn-primary w-100" t-on-click="this.printSummary">
                        <i class="fa fa-print me-1"/> Print Location Summary
                    </button>
                    <button class="btn btn-secondary w-100" t-on-click="this.props.close">
                        Cancel
                    </button>
                </footer>
            </div>
        </Dialog>
    </t>
</templates>
