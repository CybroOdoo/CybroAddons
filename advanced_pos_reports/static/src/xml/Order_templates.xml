<?xml version="1.0" encoding="UTF-8"?>
<!--Template for order summary button-->
<templates id="template" xml:space="preserve">
    <t t-name="advanced_pos_reports.OrderSummaryButton" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']/div/NoteButton"
               position="after">
            <t t-call="point_of_sale.controlButton"
                icon="'shopping_cart'"
                btnText.translate="Order Summary"
                btnClasses="'btn-secondary '"
                onClick="() => this.onClickOrderSummary()"/>
        </xpath>
    </t>
</templates>
