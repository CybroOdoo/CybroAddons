<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    Template for ongoing session report-->
    <template id="report_pos_ongoing_session">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center">
                        <h2>Ongoing Sessions Report</h2>
                    </div>
                    <table class="table table-lg">
                        <tbody>
                            <tr>
                                <td>Report Date:</td>
                                <td style="text-align: right;">
                                    <t t-out="today"
                                       t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td>Report Time:</td>
                                <td style="text-align: right;">
                                    <t t-out="today"
                                       t-options='{"widget": "datetime",  "time_only": True}'/>
                                </td>
                            </tr>
                            <tr>
                                <td>Session(s):</td>
                                <td style="text-align: right;">
                                    <t t-foreach="sessions" t-as="session">
                                        <t t-out="session.name"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td>Status:</td>
                                <td style="text-align: right;">
                                    Opened
                                </td>
                            </tr>
                            <tr>
                                <td>Opening Balance:</td>
                                <td style="text-align: right;">
                                    <t t-out="opening_balance"
                                       t-options="{'widget': 'float', 'precision': currency_precision}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Sales Without Tax:</td>
                                <td style="text-align: right;">
                                    <t t-out="amount_total_without_tax"
                                       t-options="{'widget': 'float', 'precision': currency_precision}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Returns:</td>
                                <td style="text-align: right;">
                                    <t t-out="amount_return"
                                       t-options="{'widget': 'float', 'precision': currency_precision}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Total:</td>
                                <td style="text-align: right;">
                                    <t t-out="amount_total"
                                       t-options="{'widget': 'float', 'precision': currency_precision}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="text-center my-3">
                        <h3>Department Sales</h3>
                    </div>
                    <table class="table table-lg">
                        <tbody>
                            <t t-set="total" t-value="0"/>
                            <tr t-foreach='categories' t-as='category'>
                                <td>
                                    <t t-out="category['name']"/>
                                </td>
                                <td style="text-align: right;">
                                    <t t-out="category['amount']"
                                       t-options="{'widget': 'float', 'precision': currency_precision}"/>
                                </td>
                                <t t-set="total"
                                   t-value="total + category['amount']"/>
                            </tr>
                            <tr>
                                <td>Total</td>
                                <td style="text-align: right;">
                                    <t t-out="total"
                                       t-options="{'widget': 'float', 'precision': currency_precision}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="text-center my-3">
                        <h3>Payments</h3>
                    </div>
                    <table class="table table-sm">
                        <tbody>
                            <t t-set="total" t-value="0"/>
                            <tr t-foreach='payments' t-as='payment'>
                                <td>
                                    <t t-out="payment['name']"/>
                                </td>
                                <td style="text-align: right;">
                                    <t t-out="payment['total']"
                                       t-options="{'widget': 'float', 'precision': currency_precision}"/>
                                </td>
                                <t t-set="total"
                                   t-value="total + payment['total']"/>
                            </tr>
                            <tr>
                                <td>Total</td>
                                <td style="text-align: right;">
                                    <t t-out="total"
                                       t-options="{'widget': 'float', 'precision': currency_precision}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
