<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Session expiry time in the general settings. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.restrict.logins</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='feedback_motivate_setting']" position="after">
                <setting id="session_expire_time_setting"
                         string="Session Expire Time"
                         help="Minutes of inactivity after which a user session expires.">
                    <field name="session_expire_time"/> minutes
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
