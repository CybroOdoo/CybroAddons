<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extends the template to display a button for users to log out from other
     devices positioned after an alert message in the 'web.login' template. -->
    <template id="login_clear_session" name="Clear User Sessions"
              inherit_id="web.login">
        <xpath expr="//p[hasclass('alert-danger')]" position="after">
            <t t-if="logout_all">
                <input type="hidden" name="force_logout" id="force_logout" value="0"/>
                <div class="justify-content-between mt-2 d-flex small">
                    <button type="submit"
                            onclick="document.getElementById('force_logout').value='1';"
                            class="btn btn-link btn-sm w-100 text-center p-0">
                        Logout from other devices and log in.
                    </button>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
