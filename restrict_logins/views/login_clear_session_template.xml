<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds a button to log out from the other devices, after the alert
     message of the 'web.login' template. The button submits the login form,
     so the login and the password prove the ownership of the account. -->
    <template id="login_clear_session" name="Clear User Sessions"
              inherit_id="web.login">
        <xpath expr="//p[hasclass('alert-danger')]" position="after">
            <t t-if="logout_all">
                <div class="d-flex justify-content-center mt-2 small">
                    <button type="submit" formaction="/clear_all_sessions"
                            formmethod="post" class="btn btn-link">
                        Log out from other devices
                    </button>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
