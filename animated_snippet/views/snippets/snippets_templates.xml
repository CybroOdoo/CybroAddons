<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippets inherit  menu -->
    <template id="inherit_snippets" inherit_id="website.snippets">
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="animated_snippet" t-snippet="website.s_snippet_group" string="Animated Snippets" t-thumbnail="/animated_snippet/static/src/img/a_feature_thumb.svg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="animated_snippet.a_features" group="animated_snippet" string="Features" t-thumbnail="/animated_snippet/static/src/img/a_feature_thumb.svg">
