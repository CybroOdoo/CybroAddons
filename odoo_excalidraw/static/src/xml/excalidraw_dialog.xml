<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- QWeb template for displaying the Excalidraw dialog with save and discard actions -->
    <t t-name="odoo_excalidraw.ExcalidrawDialog">
        <Dialog title="'Excalidraw'" size="'xl'">
            <div class="o_excalidraw_dialog" style="height: 70vh; width: 100%; display: flex; flex-direction: column;">
                <div t-ref="excalidraw-root" style="flex: 1; width: 100%; min-height: 500px;"></div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onSave">Save &amp; Close</button>
                <button class="btn btn-secondary" t-on-click="props.close">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
