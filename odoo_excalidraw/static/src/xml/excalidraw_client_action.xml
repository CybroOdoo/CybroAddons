<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- QWeb template for rendering the Excalidraw canvas with download and attachment actions -->
    <t t-name="odoo_excalidraw.ExcalidrawClientAction">
        <div class="o_excalidraw_client_action" style="height: 100%; width: 100%; display: flex; flex-direction: column;">
             <div class="o_control_panel">
                <div class="o_cp_top">
                    <div class="o_cp_top_left">
                        <ol class="breadcrumb mb-0">
                        </ol>
                    </div>
                    <div class="o_cp_top_right">
                        <button class="btn btn-primary" style="margin-left: 52px; margin-top: 7px;" t-on-click="onDownload">Download</button>
                        <button class="btn btn-secondary" style="margin-left: 10px; margin-top: 7px;" t-on-click="onAttach">Attach</button>
                    </div>
                </div>
            </div>
            <div t-ref="excalidraw-root" style="flex: 1; width: 100%; height: 100%;"></div>
        </div>
    </t>
</templates>
