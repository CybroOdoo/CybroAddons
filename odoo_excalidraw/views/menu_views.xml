<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- XML configuration for adding the Excalidraw Sketch client action and menu in Manufacturing -->
    <record id="action_excalidraw_client" model="ir.actions.client">
        <field name="name">Sketch</field>
        <field name="tag">odoo_excalidraw.excalidraw_client_action</field>
    </record>
    <menuitem id="menu_mrp_excalidraw"
              name="Sketch"
              parent="mrp.menu_mrp_manufacturing"
              action="action_excalidraw_client"
              sequence="100"/>
</odoo>