<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_excalidraw_attach_wizard_form" model="ir.ui.view">
        <field name="name">excalidraw.attach.wizard.form</field>
        <field name="model">excalidraw.attach.wizard</field>
        <field name="arch" type="xml">
            <form string="Attach Sketch to Record">
                <sheet>
                    <group>
                        <field name="sketch_data" widget="image" options="{'size': [120, 120]}" readonly="1" class="d-block mx-auto mb-3"/>
                        <field name="attachment_type"/>
                        <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="model_name" invisible="1"/>
                        <field name="res_id" options="{'no_create': True, 'no_open': True}" invisible="not model_id"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_attach" string="Attach" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
