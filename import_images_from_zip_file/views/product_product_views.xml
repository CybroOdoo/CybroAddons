<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit the existing 'product.product' tree view to add a button for importing images -->
    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.view.tree.inherit.import.images.from.zip.file</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <header>
                <button name="action_open_import_image_wizard" string="Import image" type="object" display="always"/>
            </header>
        </field>
    </record>
</odoo>
