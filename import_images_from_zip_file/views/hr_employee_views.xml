<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit the existing 'hr.employee' tree view to add a button for importing images -->
    <record id="view_employee_tree" model="ir.ui.view">
        <field name="name">hr.employee.view.tree.inherit.import.images.from.zip.file</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <header>
                <button name="action_open_import_image_wizard" string="Import image" type="object" display="always"/>
            </header>
        </field>
    </record>
</odoo>
