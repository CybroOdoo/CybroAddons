<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit the existing 'hr.employee' tree view to add a button for importing images -->
    <record id="view_employee_tree" model="ir.ui.view">
        <field name="name">hr.employee.view.tree.inherit.import.images.from.zip.file</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
           <xpath expr="//tree" position="attributes">
               <attribute name="js_class">import_button_in_tree</attribute>
           </xpath>
        </field>
    </record>
</odoo>
