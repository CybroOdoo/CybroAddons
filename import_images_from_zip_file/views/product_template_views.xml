<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit the existing 'product.template' tree view from sale module to add an import image button -->
    <record id="sale_product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.view.tree.inherit.import.images.from.zip.file</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <header>
                <button name="action_open_import_image_wizard" string="Import image" type="object" display="always"/>
            </header>
        </field>
    </record>
    <record id="account_product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.view.tree.inherit.import.images.from.zip.file</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_view_tree"/>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_open_import_image_wizard" string="Import image" type="object"
                            display="always"/>
                </header>
            </list>
        </field>
    </record>
</odoo>
