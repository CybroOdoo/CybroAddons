<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit the existing 'product.template' tree view from sale module to add an import image button -->
    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.view.tree.inherit.import.images.from.zip.file</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="action_open_import_image_wizard"
                        string="Import Image"
                        type="object"
                        display="always"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
