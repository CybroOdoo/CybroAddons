<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Extends ListView buttons to add Import Images button -->
    <t t-name="import_images_from_zip_file.ListView.Buttons"
       t-inherit="web.ListView.Buttons"
       t-inherit-mode="primary"
       owl="1">

        <!-- Insert button after default "Create" button -->
        <xpath expr="//*[@class='btn btn-primary o_list_button_add']" position="after">
            <!-- Custom button with click handler -->
            <button type="button"
                    class="btn btn-secondary o_import_images_btn"
                    t-on-click="onClickImportImages">
                Import Images
            </button>
        </xpath>
    </t>
</templates>
