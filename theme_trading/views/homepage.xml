<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="homepage_banner" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="inside">
                <t t-call="theme_trading.s_banner"/>
                <t t-call="theme_trading.s_aboutus"/>
                <t t-call="theme_trading.s_testimonial"/>
                <t t-call="theme_trading.s_asset_classes"/>
                <t t-call="theme_trading.s_showcase"/>
                <t t-call="theme_trading.s_image_text"/>
                <t t-call="theme_trading.s_faq"/>
            <div id="homepage_content" class="oe_structure">
            </div>
        </xpath>
    </template>
</odoo>

