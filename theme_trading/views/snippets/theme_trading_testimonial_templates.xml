<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="s_testimonial" name="Trading Testimonial">
        <section
            class="s_image_gallery o_slideshow s_image_gallery_show_indicators s_image_gallery_indicators_rounded pt24 o_testimonial_snippet"
            data-vcss="001"
            data-columns="3"
            style="height: 500px; overflow: hidden;">

            <div class="container">
                <div class="carousel slide js_testimonial_carousel"
                     data-bs-ride="carousel"
                     style="margin: 0 12px;">

                    <div class="testimonial_carousel_heading text-center">
                        <h2><b>Testimonials</b></h2>
                    </div>

                    <br/>

                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top"
                                     src="/theme_trading/static/src/images/testimonial/michael.jpg"
                                     alt="Michael"/>
                                <div class="card-body">
                                    <h3 class="card-title">Michael</h3>
                                    <p class="card-text">
                                        "The trading company's service is excellent."
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top"
                                     src="/theme_trading/static/src/images/testimonial/rachel.jpg"
                                     alt="Rachel"/>
                                <div class="card-body">
                                    <h3 class="card-title">Rachel</h3>
                                    <p class="card-text">
                                        "Exceptional customer service and attention to detail."
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <div class="card text-bg-white h-100">
                                <img class="card-img-top"
                                     src="/theme_trading/static/src/images/testimonial/stella.jpg"
                                     alt="Stella"/>
                                <div class="card-body">
                                    <h3 class="card-title">Stella</h3>
                                    <p class="card-text">
                                        "Helped me grow my portfolio profitably."
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Controls -->
                    <button class="carousel-control-prev o_we_no_overlay js-carousel-prev"
                            type="button"
                            data-bs-slide="prev">
                        <span class="fa fa-chevron-left fa-2x text-white"/>
                    </button>

                    <button class="carousel-control-next o_we_no_overlay js-carousel-next"
                            type="button"
                            data-bs-slide="next">
                        <span class="fa fa-chevron-right fa-2x text-white"/>
                    </button>

                </div>
            </div>
        </section>
    </template>
</odoo>
