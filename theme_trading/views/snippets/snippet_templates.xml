<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Inherits the `website.snippets` template and inserts the various snippets inside a div with class `o_panel_body`-->
    <template id="trading_theme_aboutus_snippet" inherit_id="website.snippets"
              name="About US">
        <xpath expr="//snippets[@id='snippet_groups']"
               position="inside">
            <t snippet-group="about_us_group" t-snippet="theme_trading.s_aboutus"
               t-thumbnail="/theme_trading/static/src/images/snippets_thumbs/aboutus.jpg);"/>
            <t snippet-group="asset_classes_group" t-snippet="theme_trading.s_asset_classes"
               t-thumbnail="/theme_trading/static/src/images/snippets_thumbs/assets.jpg);"/>
            <t snippet-group="banner_group" t-snippet="theme_trading.s_banner"
               t-thumbnail="/theme_trading/static/src/images/snippets_thumbs/banner.jpg);"/>
            <t snippet-group="image_text_group" t-snippet="theme_trading.s_image_text"
               t-thumbnail="/theme_trading/static/src/images/snippets_thumbs/community.jpg);"/>
            <t snippet-group="testimonial_group" t-snippet="theme_trading.s_testimonial"
               t-thumbnail="/theme_trading/static/src/images/snippets_thumbs/testimonial.jpg);"/>
            <t snippet-group="faq_group" t-snippet="theme_trading.s_faq"
               t-thumbnail="/theme_trading/static/src/images/snippets_thumbs/faq.jpg);"/>
            <t snippet-group="showcase_group" t-snippet="theme_trading.s_showcase"
               t-thumbnail="/theme_trading/static/src/images/snippets_thumbs/features.jpg);"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
                <t t-snippet="theme_trading.s_aboutus" string="About Us" group="about_us_group"/>
                <t t-snippet="theme_trading.s_asset_classes" string="Asset" group="asset_classes_group"/>
                <t t-snippet="theme_trading.s_banner" string="Asset" group="banner_group"/>
                <t t-snippet="theme_trading.s_image_text" string="Asset" group="image_text_group"/>
                <t t-snippet="theme_trading.s_testimonial" string="Asset" group="testimonial_group"/>
                <t t-snippet="theme_trading.s_faq" string="Asset" group="faq_group"/>
                <t t-snippet="theme_trading.s_showcase" string="Asset" group="showcase_group"/>
        </xpath>
    </template>
</odoo>