<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Multi-company record rule for Product Planning -->
    <record id="meals_planning_multi_company" model="ir.access">
        <field name="name">multi company access for meals planning</field>
        <field name="model_id" ref="model_meals_planning"/>
        <field name="operation">crud</field>
        <field name="domain">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
