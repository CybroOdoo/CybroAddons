<?xml version="1.0" encoding="utf-8" ?>
<template>
    <t t-name="CustomDashBoard">
        <!-- Main dashboard container -->
        <div class="oh_dashboards" style="margin-top: 20px;" t-ref="abcd">
            <div class="container-fluid o_pj_dashboard"/>
            <!-- Dashboard cards: Ongoing contract, Invoiced, Expected -->
            <div class="crm_dash_cards row">
                <div class="col-sm-12 col-md-4">
                    <!-- Ongoing contract card -->
                    <div class="dashboard-card card-shadow my_lead">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-line-chart text-mauve"/>
                        </div>
                        <div class="dashboard-card__details">
                            <h4>Ongoing contract</h4>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12 col-md-4">
                    <!-- Total Invoiced amount -->
                    <div class="dashboard-card card-shadow my_lead">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-circle"/>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span>
                                    <t t-esc="this.state.total_invoiced_amount"/>
                                </span>
                            </h3>
                            <h4>Invoiced amount</h4>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12 col-md-4">
                    <!-- Expected amount -->
                    <div class="dashboard-card card-shadow my_lead">
                        <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                            <i class="fa fa-dropbox"/>
                        </div>
                        <div class="dashboard-card__details">
                            <h3>
                                <span>
                                    <t t-esc="this.state.expected_amount"/>
                                </span>
                            </h3>
                            <h4>Expected amount</h4>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Labour Contract chart with time period filter -->
            <div class="col-xs-12 col-sm-12 col-lg-12 col-md-12">
                <div class="row" style="margin:0px;">
                    <div class="col-6 col-sm-6 helpdesk inbox_tickets">
                        <div class="leads_month_pie_div half_chart chart-container card-shadow"
                             style="height: 528px;">
                            <h2>Labour Contract and Amount</h2>
                            <!-- Filter dropdown to select time period -->
                            <div class="form-group col-2" id="top_product_button">
                                <select name="period" id="filter_selection"
                                        selected="selected"
                                        t-on-change="onchange_selection"
                                        style="border-radius: 5px;border-color: currentColor;border-width: 2px;background: lightgrey;">
                                    <option id="daily" value="daily">Daily</option>
                                    <option id="daily" value="monthly">Monthly</option>
                                    <option id="yearly" value="yearly">Yearly</option>
                                    <option id="totally" value="totally">Totally</option>
                                </select>
                            </div>
                            <br/>
                            <!-- Labour contract chart canvas -->
                            <div class="graph_canvas">
                                <canvas class="labour_contract" id="labour_contract"
                                        style="width:586px;height:386px;"/>
                            </div>
                        </div>
                    </div>
                    <!-- Skill data table -->
                    <div class="col-6 col-sm-3 helpdesk inbox_tickets">
                        <div class="leads_month_pie_div half_chart chart-container card-shadow"
                             style="height: 528px;">
                            <h2>Skills</h2>
                            <hr/>
                            <div class="text-color">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th rowspan="14">Skill</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.state.skills" t-as="skill" t-key="skill['name']">
                                            <tr>
                                                <td>
                                                    <t t-esc="skill['name']"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <!-- Workers and their daily rate -->
                    <div class="col-6 col-sm-3 helpdesk inbox_tickets">
                        <div class="leads_month_pie_div half_chart chart-container card-shadow"
                             style="height: 528px;">
                            <h2>Available Workers</h2>
                            <hr/>
                            <div class="text-color">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th rowspan="14">
                                                <center>Workers</center>
                                            </th>
                                        </tr>
                                        <tr>
                                            <th rowspan="14">
                                                <center>Rate Per Day</center>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.state.workers" t-as="worker" t-key="worker['name']">
                                            <tr>
                                                <td>
                                                    <center>
                                                        <t t-esc="worker['name']"/>
                                                    </center>
                                                </td>
                                                <td>
                                                    <center>
                                                        <t t-esc="worker['rate']"/>
                                                    </center>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Graphs: Contracts by State & Customer -->
            <br/>
            <div class="col-xs-12 col-sm-12 col-lg-12 col-md-12">
                <div class="row" style="margin:0px;">
                    <div class="col-6 col-sm-6 helpdesk inbox_tickets">
                        <!-- Pie or bar chart of contracts by state -->
                        <div class="leads_month_pie_div half_chart chart-container card-shadow"
                             style="height: 528px;">
                            <h2>Contracts on the Basis of State</h2>
                            <div class="graph_canvas">
                                <canvas class="contract" width="130" height="80"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-6 helpdesk inbox_tickets">
                        <!-- Customer-based contract chart -->
                        <div class="leads_month_pie_div half_chart chart-container card-shadow"
                             style="height: 528px;">
                            <h2>Contracts on the Basis of Customer</h2>
                            <hr/>
                            <div class="graph_canvas">
                                <canvas class="customer_contract"
                                        style="margin-top: 132px;width: 586px;height: 106px;"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Worker availability chart and top customers list -->
            <br/>
            <div class="col-xs-12 col-sm-12 col-lg-12 col-md-12">
                <div class="row" style="margin:0px;">
                    <div class="col-6 col-sm-6 helpdesk inbox_tickets">
                        <!-- Worker availability bar chart -->
                        <div class="leads_month_pie_div half_chart chart-container card-shadow"
                             style="height: 528px;">
                            <h2>Workers Availability</h2>
                            <hr/>
                            <div class="graph_canvas">
                                <canvas class="worker_availability" width="330"
                                        id="worker_availability"
                                        height="375"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-6 helpdesk inbox_tickets">
                        <!-- Top 10 customers table -->
                        <div class="leads_month_pie_div half_chart chart-container card-shadow"
                             style="height: 528px;">
                            <h2>Top 10 Customers</h2>
                            <hr/>
                            <div class="text-color">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th rowspan="14">Customers</th>
                                        </tr>
                                        <tr>
                                            <th rowspan="14">Number of Contracts</th>
                                        </tr>
                                        <tr>
                                            <th rowspan="14">Mail Address</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.state.customers"
                                           t-as="customer" t-key="customer['name']">
                                            <tr>
                                                <td>
                                                    <t t-esc="customer['name']"/>
                                                </td>
                                                <td>
                                                    <center>
                                                        <t t-esc="customer['count']"/>
                                                    </center>
                                                </td>
                                                <td>
                                                    <t t-esc="customer['email']"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>
