<?xml version="1.0" encoding="utf-8"?>
<template>
    <!-- Dashboard Template for Labour Supply -->
    <t t-name="DashboardLabourSupply">
        <div class="container-fluid" style="overflow: auto; max-height: 100%;">
            <section class="dashboard_main_section" id="main_section_login">
                <div class="row">
                    <div class="col-sm-12 mb-4">
                        <div class="row">
                            <div class="col-12 col-sm-12 col-md-8">
                                <h2 class="section-header">Manpower Supply Management Dashboard
                                </h2>
                            </div>
                        </div>
                        <hr/>
                    </div>
                </div>
            </section>
            <section class="dashboard_card_section"
                     id="main_section_cards">
                <div class="crm_dash_cards row">
                    <div class="col-sm-12 col-md-4">
                        <div class="dashboard-card card-shadow my_lead">
                            <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                                <i class="fa fa-line-chart text-mauve"/>
                            </div>
                            <div class="dashboard-card__details">
                                <h3>
                                    <span>
                                        <t t-esc="this.state.labour_supply_details"/>
                                    </span>
                                </h3>
                                <h4>Ongoing contract</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4">
                        <div class="dashboard-card card-shadow opportunity">
                            <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                                <i class="fa fa-circle"/>
                            </div>
                            <div class="dashboard-card__details">
                                <h3>
                                    <span>
                                        <t t-esc="this.state.total_invoiced_amount"/>
                                    </span>
                                </h3>
                                <h4>Invoiced amount</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4">
                        <div class="dashboard-card card-shadow exp_revenue">
                            <div class="dashboard-card__icon-container bg-mauve-light d-flex justify-content-center align-items-center">
                                 <i class="fa fa-dropbox"/>
                            </div>
                            <div class="dashboard-card__details">
                                <h3>
                                    <span>
                                        <t t-esc="this.state.expected_amount"/>
                                    </span>
                                </h3>
                                <h4>Expected amount</h4>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row col-md-12">
                    <div class="col-md-5">
                        <div class="row" style="display:flex; padding: 20px;">
                            <div class="card-body" id="in_ex_body_hide">
                                <div class="leads_stages chart-container card-shadow">
                                    <h2>Labour Contract and Amount</h2>
                                     <div class="form-group col-2"
                                         id="top_product_button">
                                         <form class="form-group">
                                        <select name="period" id="filter_selection"
                                                selected="selected"
                                                t-model="state.period"
                                                style="border-radius: 5px;border-color: currentColor;border-width: 2px;background: lightgrey;">
                                            <option id="daily" value="daily">Daily
                                            </option>
                                            <option id="daily" value="monthly">Monthly
                                            </option>
                                            <option id="yearly" value="yearly">Yearly
                                            </option>
                                            <option id="totally" value="totally">Totally
                                            </option>
                                        </select>
                                         </form>
                                    </div>
                                    <br/>
                                    <hr/>
                                    <div class="graph_canvas">
                                        <canvas t-ref="labour_contract" width="200"
                                                height="120"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="top_country_revenue_div col-12 col-sm-12 col-md-3">
                            <div class="chart-container card-shadow">
                                <h3 class="h5">Skills</h3>
                                <hr/>
                                <table class="table table-hover"
                                       id="country_revenue_table">
                                    <thead>
                                        <tr>
                                            <th>Skill</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="this.state.skills">
                                            <t t-foreach="this.state.skills"
                                               t-as="skill" t-key="skill['name']">
                                                <tr>
                                                    <td>
                                                        <t t-esc="skill['name']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <div class="top_country_count_div col-12 col-sm-12 col-md-3">
                            <div class="chart-container card-shadow">
                                <h3 class="h5">Available Workers</h3>
                                <hr/>
                                <table class="table table-hover"
                                       id="country_count_table">
                                    <thead>
                                        <tr>
                                            <th>Workers</th>
                                            <th>Rate Per Day</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="this.state.workers">
                                            <t t-foreach="this.state.workers"
                                               t-as="worker" t-key="worker['name']">
                                                <tr>
                                                    <td>
                                                        <t t-esc="worker['name']"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="worker['rate']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <div class="col-md-6">
                        <div class="row" style="display:flex; padding: 20px;">
                            <div class="card-body" id="in_ex_body_hide">
                                <div class="leads_stages chart-container card-shadow">
                                    <h2>Contracts on the Basis of State</h2>
                                    <hr/>
                                    <div class="graph_canvas">
                                        <canvas t-ref="contract"
                                                width="200"
                                                height="120"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row" style="display:flex; padding: 20px;">
                            <div class="card-body" id="in_ex_body_hide">
                                <div class="leads_stages chart-container card-shadow">
                                    <h2>Contracts on the Basis of Customer</h2>
                                    <hr/>
                                    <div class="graph_canvas">
                                        <canvas t-ref="customer_contract"
                                                width="200"
                                                height="120"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row" style="display:flex; padding: 20px;">
                            <div class="card-body" id="in_ex_body_hide">
                                <div class="leads_campaign chart-container card-shadow">
                                    <h2>Workers Availability</h2>
                                    <hr/>
                                    <div class="graph_canvas">
                                        <canvas t-ref="worker_availability"
                                                width="200"
                                                height="120"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="top_country_count_div col-12 col-sm-12 col-md-6">
                            <div class="chart-container card-shadow">
                                <h3 class="h5">Top 10 Customers</h3>
                                <hr/>
                                <table class="table table-hover"
                                       id="country_count_table">
                                    <thead>
                                        <tr>
                                            <th>Customers</th>
                                            <th>Number of Contracts</th>
                                            <th>Mail Address</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                         <t t-if="this.state.customers">
                                            <t t-foreach="this.state.customers"
                                               t-as="customer" t-key="customer['name']">
                                                <tr>
                                                    <td>
                                                        <t t-esc="customer['name']"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="customer['count']"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="customer['email']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                </div>
            </section>
        </div>
    </t>
</template>
