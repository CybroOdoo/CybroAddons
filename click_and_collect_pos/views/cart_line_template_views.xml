<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited Template and Added Click & Collect Options in Cart -->
    <template id="click_and_collect" name="Click And Collect"
              inherit_id="website_sale.cart_lines_price">
        <xpath expr="//h6[@name='website_sale_cart_line_price']" position="after">
            <div class="text-center oe_inline click_and_collect_td mt-2">
                <div class="form-check d-inline-block">
                    <input type="checkbox" name="click_and_collect"
                           t-att-id="'is_click_and_collect_%s' % line.id"
                           t-att-checked="line.is_click_and_collect"
                           class="form-check-input clickandecollect"
                           t-att-data-id="line.id" />
                    <label class="form-check-label" t-att-for="'is_click_and_collect_%s' % line.id">
                        Click &amp; Collect
                    </label>
                </div>
                <div t-attf-class="text-center click_and_collect_td oe_session mt-1 #{not line.is_click_and_collect and 'd-none' or ''}">
                    <t t-set="get_pos_stores"
                       t-value="request.env['pos.config'].sudo().search([('company_id', '=', website.company_id.id)])"/>
                    <select class="form-select session_values"
                            name="pos_session" t-att-data-line-id="line.id">
                        <option t-if="len(get_pos_stores) != 1" value="select">Select Store</option>
                        <option t-foreach="get_pos_stores" t-as="store"
                                t-att-value="store.id"
                                t-att-selected="(line.pos_config_id and line.pos_config_id.id == store.id) or (not line.pos_config_id and len(get_pos_stores) == 1)"
                                t-key="store.id">
                            <t t-out="store.name"/><t t-if="store.city">, <t t-out="store.city"/></t>
                        </option>
                    </select>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
