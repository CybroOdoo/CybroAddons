<?xml version="1.0" encoding="UTF-8"?>
<!-- Inherit POS Navbar and add the Click & Collect button with a live badge -->
<templates id="template" xml:space="preserve">
    <t t-name="Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-leftheader')]" position="inside">
            <button class="sale-order-button btn btn-primary position-relative ms-2"
                    t-on-click="onClick"
                    title="Click &amp; Collect orders">
                <i class="fa fa-shopping-basket me-1"/>
                Click &amp; Collect
                <t t-if="collectState.pendingCount > 0">
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        <t t-esc="collectState.pendingCount"/>
                        <span class="visually-hidden">pending orders</span>
                    </span>
                </t>
            </button>
        </xpath>
    </t>
</templates>