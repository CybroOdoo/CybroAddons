<?xml version="1.0" encoding="UTF-8"?>
<!-- Inherit POS Navbar and add the Click & Collect button with a live badge -->
<templates id="template" xml:space="preserve">
    <t t-name="click_and_collect_pos.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-leftheader')]//OrderTabs" position="after">
            <button class="sale-order-button btn btn-primary position-relative d-flex align-items-center ms-2"
                    t-on-click="() => this.onClick()"
                    title="Click &amp; Collect orders">
                <i class="oi oi-fw me-1" data-icon="shopping_bag"/>
                <span t-if="!this.ui.isSmall">Click &amp; Collect</span>
                <t t-if="this.collectState.pendingCount > 0">
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        <t t-out="this.collectState.pendingCount"/>
                        <span class="visually-hidden">pending orders</span>
                    </span>
                </t>
            </button>
        </xpath>
    </t>
</templates>