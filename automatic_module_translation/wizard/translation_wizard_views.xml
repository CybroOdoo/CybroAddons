<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View of Automatic Translation Wizard -->
    <record id="view_automatic_translation_wizard_form" model="ir.ui.view">
        <field name="name">automatic.translation.wizard.form</field>
        <field name="model">automatic.translation.wizard</field>
        <field name="arch" type="xml">
            <form string="Translate Tool">
                <sheet>
                    <group>
                        <field name="language_id" widget="selection"/>
                        <field name="module_id" options="{'no_create': True}" />
                        <field name="overwrite_existing_terms" />
                    </group>
                    <p class="text-danger" style="font-size:12px;">
                        * Please be aware that as of right now, this tool only translates the custom terms found in the custom module, reports, and fields. It will not translate standard terms. Once the translation is finished, you may examine the revised words in the linked module by selecting the specific module that has to be translated.
                    </p>
                </sheet>
                <footer>
                    <button name="action_translate" string="TRANSLATE" type="object" class="btn-primary"/>
                    <button special="cancel" string="CANCEL" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for the Wizard -->
    <record id="action_automatic_translation_wizard" model="ir.actions.act_window">
        <field name="name">Automatic Translation Tool</field>
        <field name="res_model">automatic.translation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help">Automatically translate module using API.</field>
    </record>

    <!-- Menu Item (Under Settings > Translations) -->
    <menuitem id="menu_automatic_translation_wizard"
              name="Automatic Translation Tool"
              parent="base.menu_translation"
              action="action_automatic_translation_wizard"
              sequence="15"/>
</odoo>
