<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the Product Pricelist Item form view to add UoM selection -->
    <record id="product_pricelist_item_form_view_inherit_uom" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.uom</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='compute_price']" position="after">
                <field name="product_uom_id" invisible="product_tmpl_id == False"/>
            </xpath>
        </field>
    </record>
</odoo>
