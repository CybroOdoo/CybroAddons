<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated Authentication Page Template -->
    <template id="timeoff_auth_page_template">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-5 col-md-8">
                            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                                <div class="card-header bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
                                    <h4 class="mb-0 font-weight-bold">Time Off Access</h4>
                                    <p class="small mb-0 opacity-75">Verification Required</p>
                                </div>
                                <div class="card-body p-5" id="timeoff_auth_ui">
                                    <div class="text-center mb-4">
                                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                            <i class="fa fa-lock fa-3x text-primary"></i>
                                        </div>
                                        <h5 class="font-weight-bold">Secure Verification</h5>
                                        <p class="text-muted small">Please verify your identity to access your private leave records.</p>
                                    </div>

                                    <div id="email_section">
                                        <div class="mb-4">
                                            <label for="timeoff_email_id" class="form-label text-uppercase small font-weight-bold text-muted">Work Email Address</label>
                                            <div class="input-group shadow-sm" style="border-radius: 10px; overflow: hidden;">
                                                <span class="input-group-text bg-white border-end-0"><i class="fa fa-envelope-o text-muted"></i></span>
                                                <input type="email" id="timeoff_email_id" class="form-control border-start-0 ps-0" placeholder="mitchell@example.com" t-att-value="employee.work_email or ''" autocomplete="off" t-att-readonly="None" style="height: 50px;"/>
                                            </div>
                                        </div>
                                        <button type="button" id="btn_confirm_email" class="btn btn-primary w-100 shadow" style="height: 50px; border-radius: 10px; font-weight: 600; font-size: 1.1rem; background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
                                            Send One-Time Password
                                        </button>
                                    </div>
                                    
                                    <div id="otp_section" class="mt-4 d-none">
                                        <div class="mb-4 text-center">
                                            <p class="small text-success bg-success-light p-2 rounded" style="background: #ecfdf5; border: 1px solid #d1fae5;">
                                                <i class="fa fa-check-circle me-1"></i> A 6-digit code has been sent to your email.
                                            </p>
                                        </div>
                                        <div class="mb-4">
                                            <label for="timeoff_otp_code" class="form-label text-uppercase small font-weight-bold text-muted text-center d-block">Enter Verification Code</label>
                                            <input type="text" id="timeoff_otp_code" class="form-control text-center font-weight-bold" placeholder="······" style="height: 60px; font-size: 2rem; border-radius: 10px; letter-spacing: 0.5em;" maxlength="6" />
                                        </div>
                                        <button type="button" id="btn_authenticate" class="btn btn-success w-100 shadow" style="height: 50px; border-radius: 10px; font-weight: 600; font-size: 1.1rem; background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
                                            Verify &amp; Access Report
                                        </button>
                                        <button type="button" class="btn btn-link w-100 mt-3 small text-muted" onclick="location.reload();">Retry with different email</button>
                                    </div>
                                    
                                    <div id="auth_status_msg" class="mt-3 text-center d-none p-3 rounded small"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- No Data Page Template -->
    <template id="timeoff_no_data_template">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-6">
                            <div class="card shadow border-0 text-center p-5" style="border-radius: 20px;">
                                <div class="mb-4">
                                    <div class="rounded-circle bg-warning-light d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px; background: #fffbeb;">
                                        <i class="fa fa-folder-open-o fa-4x text-warning"></i>
                                    </div>
                                </div>
                                <h2 class="font-weight-bold mb-3">No Records Found</h2>
                                <p class="text-muted mb-5 px-4">
                                    We couldn't find any leave history or active allocations associated with your work email. 
                                    If you believe this is an error, please contact your HR department.
                                </p>
                                <div class="d-grid gap-2 col-md-8 mx-auto">
                                    <a href="/my/timeoff" class="btn btn-primary btn-lg shadow-sm" style="border-radius: 12px; font-weight: 600; background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
                                        <i class="fa fa-arrow-left me-2"></i> Back to Login
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
