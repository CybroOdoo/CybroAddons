<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add My Timeoff to Website Menu via Record (Official Way) -->
    <record id="menu_timeoff_report" model="website.menu">
        <field name="name">My Timeoff</field>
        <field name="url">/my/timeoff</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">80</field>
    </record>
</odoo>
