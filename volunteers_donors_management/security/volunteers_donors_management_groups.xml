<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- User Group Category -->
        <record id="volunteers_donors_management_category" model="ir.module.category">
            <field name="name">Volunteers Donors Management</field>
        </record>

        <!-- Privilege for the groups -->
        <record id="res_groups_privilege_volunteers_donors" model="res.groups.privilege">
            <field name="name">Volunteers and Donors</field>
            <field name="category_id" ref="volunteers_donors_management.volunteers_donors_management_category"/>
        </record>

        <!-- User Group -->
        <record id="volunteers_donors_management_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id"
                   ref="volunteers_donors_management.res_groups_privilege_volunteers_donors"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Grant menu/model access to internal users -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('volunteers_donors_management.volunteers_donors_management_user'))]"/>
        </record>
    </data>
</odoo>
