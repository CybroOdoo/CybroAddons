<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_equipments">
        <field name="name">Equipment</field>
        <field name="description">Access Levels</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_department_manager">
        <field name="name">Department Manager</field>
        <field name="category_id" ref="equipment_request_it_operations.module_equipments"/>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_hr_officer">
        <field name="name">HR Officer</field>
        <field name="category_id" ref="equipment_request_it_operations.module_equipments"/>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_stock_manager">
        <field name="name">Stock Manager</field>
        <field name="category_id" ref="equipment_request_it_operations.module_equipments"/>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_admin">
        <field name="name">Manager</field>
        <field name="category_id" ref="equipment_request_it_operations.module_equipments"/>
    </record>

    <!-- Equipment: Department Manager group -->
    <record id="equipment_request_it_operations_group_department_manager" model="res.groups">
        <field name="name">Department Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_department_manager"/>
    </record>
    <!-- Equipment: HR Officer group -->
    <record id="equipment_request_it_operations_group_hr_officer" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_hr_officer"/>
    </record>
    <!-- Equipment: Stock Manager group (needs Inventory user rights to create transfers) -->
    <record id="equipment_request_it_operations_group_stock_manager" model="res.groups">
        <field name="name">Stock Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_stock_manager"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <!-- Equipment: Manager group -->
    <record id="equipment_request_it_operations_group_admin" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_admin"/>
        <field name="implied_ids"
               eval="[(4, ref('equipment_request_it_operations_group_department_manager')),(4, ref('equipment_request_it_operations_group_stock_manager')), (4, ref('equipment_request_it_operations_group_hr_officer'))]"/>
    </record>
</odoo>