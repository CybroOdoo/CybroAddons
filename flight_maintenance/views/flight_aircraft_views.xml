<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extends the aircraft form with maintenance information. -->
    <record id="view_flight_aircraft_form_inherit_maintenance" model="ir.ui.view">
        <field name="name">flight.aircraft.form.inherit.maintenance</field>
        <field name="model">flight.aircraft</field>
        <field name="inherit_id" ref="flight_management.view_flight_aircraft_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_maintenance_requests" type="object" class="oe_stat_button"
                            icon="fa-wrench" invisible="maintenance_request_count == 0">
                        <field name="maintenance_request_count" widget="statinfo" string="Maintenance"/>
                    </button>
                </div>
            </xpath>

            <xpath expr="//field[@name='status']" position="after">
                <field name="maintenance_request_count" invisible="1"/>
                <field name="equipment_id" readonly="1"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Running Metrics">
                    <field name="airframe_hours_total" readonly="1"/>
                    <field name="engine_hours_total" readonly="1"/>
                    <field name="cycles_total" readonly="1"/>
                    <field name="fuel_used_total" readonly="1"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
