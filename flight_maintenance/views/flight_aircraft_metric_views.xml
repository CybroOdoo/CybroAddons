<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Defines the list view for aircraft metric entries. -->
    <record id="view_flight_aircraft_metric_list" model="ir.ui.view">
        <field name="name">flight.aircraft.metric.list</field>
        <field name="model">flight.aircraft.metric</field>
        <field name="arch" type="xml">
            <list string="Aircraft Metric Entries" editable="bottom">
                <field name="aircraft_id"/>
                <field name="metric_type"/>
                <field name="value"/>
                <field name="date"/>
                <field name="flight_id"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Defines the action for opening aircraft metrics. -->
    <record id="action_flight_aircraft_metric" model="ir.actions.act_window">
        <field name="name">Aircraft Metrics</field>
        <field name="res_model">flight.aircraft.metric</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
