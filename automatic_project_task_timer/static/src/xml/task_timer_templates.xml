<?xml version="1.0" encoding="UTF-8"?>
<!--Template for getting the timer widget.-->
<templates id="template" xml:space="preserve">
    <t t-name="automatic_project_task_timer.TimerWidget">
        <span t-out="this.durationFormatted"/>
    </t>

    <t t-name="TaskTimerTemplate">
        <TimerWidget t-if="this.props.readonly" value="this.state.duration" ongoing="this.ongoing"/>
        <input t-else="" t-att-id="this.props.id" t-ref="this.numpadDecimalRef" t-att-placeholder="this.props.placeholder" inputmode="numeric" class="o_input" />
    </t>
</templates>

