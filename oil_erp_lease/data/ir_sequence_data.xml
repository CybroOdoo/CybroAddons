<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file loads the ir sequence data. -->
    <data noupdate="1">
        <record id="seq_oil_lease_agreement" model="ir.sequence">
            <field name="name">Lease Agreement</field>
            <field name="code">oil.lease.agreement</field>
            <field name="prefix">LEASE/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="ir_cron_lease_expiry" model="ir.cron">
            <field name="name">Lease Expiry Check</field>
            <field name="model_id" ref="model_oil_lease_agreement"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_lease_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
