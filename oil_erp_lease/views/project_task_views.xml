<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add lease expiry warning to task form -->
    <record id="view_task_form_inherit_lease" model="ir.ui.view">
        <field name="name">project.task.form.inherit.lease</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning" role="alert"
                     invisible="not lease_expiry_warning">
                    <strong>Warning:</strong>
                    <field name="lease_expiry_warning" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>