<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file defines the oil reservoir views. -->
    <record id="view_oil_reservoir_form" model="ir.ui.view">
        <field name="name">oil.reservoir.form.view.inherit.oil_erp_lease</field>
        <field name="model">oil.reservoir</field>
        <field name="inherit_id" ref="oil_erp_reservoir.view_oil_reservoir_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location']" position="after">
                <field name="lease_id"/>
            </xpath>
        </field>
    </record>
</odoo>
