<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add lease field and expiry warning to project form -->
    <record id="edit_project_inherit_lease" model="ir.ui.view">
        <field name="name">project.project.form.inherit.lease</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!-- Lease expiry warning banner -->
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning" role="alert"
                     invisible="not lease_expiry_warning">
                    <strong>Warning:</strong>
                    <field name="lease_expiry_warning" nolabel="1"/>
                </div>
            </xpath>

            <!-- Add lease field after user_id -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="lease_id"/>
            </xpath>
        </field>
    </record>
</odoo>