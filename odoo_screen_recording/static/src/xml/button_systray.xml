<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!--   Adding button to start recording-->
    <t t-name="odoo_screen_recording.ScreenCaptureSystray">
            <div class="recordSystray.class" style="display:flex; align-items:center" t-on-click="this._onClick">
                        <i class="oi record" data-icon="videocam" id='capture_screen'
                           t-att-style="'color:' + (this.state.isRecording ? '#28a745' : 'black') + ';'"
                           aria-label="Record your screen"/>
            </div>
    </t>
</templates>
