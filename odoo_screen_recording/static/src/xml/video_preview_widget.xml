<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <!--    Creating widget to preview video-->
    <t t-name="VideoWidget">
        <div>
            <video width="320" height="240" controls="" t-key="this.videoSource">
                <source t-att-src="this.videoSource" type="video/mp4"/>
            </video>
        </div>
    </t>
</templates>
